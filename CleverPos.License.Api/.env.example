ADMIN_API_KEY=dev-admin-key
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5088
LICENSE_DB=Server=127.0.0.1;user id=root;password=Asd+12345678;database=cleverpos;charset=utf8mb4;default command timeout=1200;SslMode=none;AllowPublicKeyRetrieval=True
LICENSE_PRIVATE_KEY_XML=
