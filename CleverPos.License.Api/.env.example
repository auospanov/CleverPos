OWNER_GOOGLE_CLIENT_ID=
OWNER_GOOGLE_CLIENT_SECRET=
OWNER_APPLE_CLIENT_ID=
OWNER_TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_BOT_USERNAME=
OWNER_JWT_SIGNING_KEY=CHANGE-ME-OWNER-JWT-KEY-32CHARS-MIN
OWNER_CABINET_ORIGIN=https://dominium.kz
