@baseUrl = http://localhost:5088
@adminKey = dev-admin-key

### Create license
POST {{baseUrl}}/api/admin/licenses
Content-Type: application/json
X-Admin-Key: {{adminKey}}

{
  "companyName": "Local test",
  "maxActivations": 1
}

### List licenses
GET {{baseUrl}}/api/admin/licenses
X-Admin-Key: {{adminKey}}

### Clear computer
POST {{baseUrl}}/api/admin/licenses/PASTE_ID/clear-computer
X-Admin-Key: {{adminKey}}

### Mark current month paid
POST {{baseUrl}}/api/admin/licenses/PASTE_ID/payments
Content-Type: application/json
X-Admin-Key: {{adminKey}}

{
  "amount": 15000,
  "comment": "Оплата за месяц"
}

### Validate
POST {{baseUrl}}/api/licenses/validate
Content-Type: application/json

{
  "licenseKey": "PASTE_KEY",
  "computerId": "DEV-PC-1",
  "machineName": "DEV-PC"
}
