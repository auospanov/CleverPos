@page "/cabinet/login"
@model CleverPos.License.Api.Pages.Cabinet.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Вход в кабинет";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Кабинет владельца — CleverPos</title>
    <link rel="stylesheet" href="~/css/cabinet.css" />
    @if (!string.IsNullOrWhiteSpace(Model.AppleClientId))
    {
        <script src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js" async></script>
    }
</head>
<body>
    <div class="cabinet-login">
        <div class="cabinet-card">
            <p class="brand">CleverPos</p>
            <h1>Кабинет владельца</h1>
            <p class="sub">Вход через Google, Apple или Telegram</p>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert err">@Model.ErrorMessage</div>
            }
            <div id="auth-error" class="alert err" style="display:none"></div>

            @if (!string.IsNullOrWhiteSpace(Model.GoogleClientId))
            {
                <button type="button" class="btn google" id="google-signin-btn">Войти через Google</button>
            }
            else
            {
                <p class="hint">Google: задайте OwnerAuth:GoogleClientId и GoogleClientSecret</p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.AppleClientId))
            {
                <div class="divider">или</div>
                <button type="button" class="btn apple" id="apple-signin-btn">Войти через Apple</button>
            }

            @if (!string.IsNullOrWhiteSpace(Model.TelegramBotUsername))
            {
                <div class="divider">или</div>
                <script async src="https://telegram.org/js/telegram-widget.js?22"
                        data-telegram-login="@Model.TelegramBotUsername"
                        data-size="large"
                        data-onauth="onTelegramAuth(user)"
                        data-request-access="write"></script>
            }
        </div>
    </div>
    <script>
        function showErr(msg) {
            var el = document.getElementById('auth-error');
            el.style.display = 'block';
            el.textContent = msg || 'Ошибка входа';
        }

        async function postAuth(url, body) {
            var res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(body)
            });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok) {
                showErr(data.message || ('HTTP ' + res.status));
                return;
            }
            window.location.href = '/cabinet';
        }

        (function initGoogle() {
            var clientId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GoogleClientId ?? ""));
            var redirectUri = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GoogleRedirectUri ?? ""));
            var btn = document.getElementById('google-signin-btn');
            if (!clientId || !btn) return;
            btn.addEventListener('click', function () {
                var params = new URLSearchParams({
                    client_id: clientId,
                    redirect_uri: redirectUri,
                    response_type: 'code',
                    scope: 'openid email profile',
                    access_type: 'offline',
                    prompt: 'select_account',
                    state: 'google_signin'
                });
                window.location.href = 'https://accounts.google.com/o/oauth2/v2/auth?' + params.toString();
            });
        })();

        function onTelegramAuth(user) {
            postAuth('/api/owner/auth/telegram', {
                id: user.id,
                first_name: user.first_name,
                last_name: user.last_name,
                username: user.username,
                photo_url: user.photo_url,
                auth_date: user.auth_date,
                hash: user.hash
            });
        }

        (function initApple() {
            var clientId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppleClientId ?? ""));
            var redirectUri = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppleRedirectUri ?? ""));
            if (!clientId) return;

            function ready(fn) {
                if (window.AppleID && window.AppleID.auth) { fn(); return; }
                setTimeout(function () { ready(fn); }, 80);
            }

            ready(function () {
                AppleID.auth.init({
                    clientId: clientId,
                    scope: 'name email',
                    redirectURI: redirectUri,
                    usePopup: true
                });
                var btn = document.getElementById('apple-signin-btn');
                if (!btn) return;
                btn.addEventListener('click', async function () {
                    try {
                        var response = await AppleID.auth.signIn();
                        var idToken = response && response.authorization && response.authorization.id_token;
                        if (!idToken) {
                            showErr('Apple не вернул id_token');
                            return;
                        }
                        var email = response.user && response.user.email ? response.user.email : null;
                        var firstName = response.user && response.user.name ? response.user.name.firstName : null;
                        var lastName = response.user && response.user.name ? response.user.name.lastName : null;
                        if (email) localStorage.setItem('apple_email', email);
                        if (firstName || lastName) localStorage.setItem('apple_name', [firstName, lastName].filter(Boolean).join(' '));
                        postAuth('/api/owner/auth/apple', {
                            idToken: idToken,
                            email: email || localStorage.getItem('apple_email'),
                            firstName: firstName,
                            lastName: lastName,
                            name: localStorage.getItem('apple_name')
                        });
                    } catch (e) {
                        showErr((e && e.error) || (e && e.message) || 'Apple Sign In отменён');
                    }
                });
            });
        })();
    </script>
</body>
</html>
