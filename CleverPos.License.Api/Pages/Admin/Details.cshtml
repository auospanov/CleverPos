@page "/admin/details/{id:guid}"
@model CleverPos.License.Api.Pages.Admin.DetailsModel
@{
    ViewData["Title"] = "Лицензия";
    var license = Model.License!;
}
<div class="topbar">
    <div>
        <h1>@(string.IsNullOrWhiteSpace(license.CompanyName) ? "Лицензия" : license.CompanyName)</h1>
        <div class="sub mono">@license.LicenseKey</div>
    </div>
    <div class="row-actions">
        <form method="post" asp-page-handler="ClearComputer" asp-route-id="@license.Id">
            <button class="btn secondary" type="submit" onclick="return confirm('Очистить компьютер?');">Очистить ПК</button>
        </form>
        <form method="post" asp-page-handler="Toggle" asp-route-id="@license.Id" asp-route-isActive="@(!license.IsActive)">
            <button class="btn @(license.IsActive ? "danger" : "secondary")" type="submit">@(license.IsActive ? "Выключить" : "Включить")</button>
        </form>
        <a class="btn ghost" href="/admin">Назад</a>
    </div>
</div>

<div class="card" style="margin-bottom:16px">
    <h2 style="margin-top:0">Компьютер</h2>
    @if (license.Computers.Count == 0)
    {
        <p>Ещё не привязан. Первый успешный запрос кассы запишет идентификатор.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>ComputerId</th><th>Имя</th><th>Привязан</th><th>Последний запрос</th></tr>
            </thead>
            <tbody>
            @foreach (var pc in license.Computers)
            {
                <tr>
                    <td class="mono">@pc.ComputerId</td>
                    <td>@(pc.MachineName ?? "—")</td>
                    <td>@pc.ActivatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td>@pc.LastSeenAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="card" style="margin-bottom:16px">
    <h2 style="margin-top:0">Отметить оплату</h2>
    <form method="post" asp-page-handler="AddPayment" asp-route-id="@license.Id" class="form-grid">
        <div>
            <label>Год</label>
            <input asp-for="Year" type="number" />
        </div>
        <div>
            <label>Месяц</label>
            <input asp-for="Month" type="number" min="1" max="12" />
        </div>
        <div>
            <label>Сумма</label>
            <input asp-for="Amount" type="number" step="0.01" />
        </div>
        <div>
            <label>Комментарий</label>
            <input asp-for="Comment" />
        </div>
        <div class="full">
            <button class="btn" type="submit">Сохранить оплату</button>
        </div>
    </form>
</div>

<div class="card">
    <h2 style="margin-top:0">История оплат</h2>
    <table>
        <thead>
            <tr><th>Период</th><th>Сумма</th><th>Когда отмечено</th><th>Комментарий</th></tr>
        </thead>
        <tbody>
        @if (license.Payments.Count == 0)
        {
            <tr><td colspan="4">Оплат нет.</td></tr>
        }
        @foreach (var payment in license.Payments)
        {
            <tr>
                <td>@payment.Month.ToString("00")/@payment.Year</td>
                <td>@(payment.Amount?.ToString("0.##") ?? "—")</td>
                <td>@payment.PaidAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                <td>@(payment.Comment ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
