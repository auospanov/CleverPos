<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CleverPos.Finance</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastReport.Mono.Demo" Version="2024.2.9" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogicPOS.Data\LogicPOS.Data.csproj" />
    <ProjectReference Include="..\LogicPOS.Globalization\LogicPOS.Globalization.csproj" />
    <ProjectReference Include="..\LogicPOS.Modules\LogicPOS.Modules.csproj" />
    <ProjectReference Include="..\LogicPOS.Reporting\LogicPOS.Reporting.csproj" />
    <ProjectReference Include="..\LogicPOS.Settings\LogicPOS.Settings.csproj" />
    <ProjectReference Include="..\LogicPOS.Shared\LogicPOS.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FastReport.Mono">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\fastreport\FastReport.Mono.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Data.v23.2">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\xpo_23_2_6\DevExpress.Data.v23.2.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="DevExpress.Xpo.v23.2">
      <HintPath>$(MSBuildThisFileDirectory)..\libs\xpo_23_2_6\DevExpress.Xpo.v23.2.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>
