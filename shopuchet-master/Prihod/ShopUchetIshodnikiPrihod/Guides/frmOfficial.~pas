procedure TOfficialForm.tlRightsClick(Sender: TObject);
var
  AnItem: TdxTreeListNode;
  ANode: TdxTreeListNode;
  i : Integer;
  Cnt : integer;
begin
  edFM.Modified := True;  //иначе не вызоваетс€ Update

  with (Sender as TdxDBTreeList) do begin
    AnItem := FocusedNode;
    if AnItem <> nil then begin
      if AnItem.Values[0] = '1' then
       AnItem.Values[0] := '0'
      else if (AnItem.Values[0] = '0') or (AnItem.Values[0] = '') then
       AnItem.Values[0] := '1';

      // если есть детки, то проставл€ю им всем галочки
      if AnItem.HasChildren then begin
        AnItem.Expand(False);
        ANode := AnItem.GetFirstChild;
        for i := 0 to AnItem.Count - 1 do begin
          ANode.Values[0] := AnItem.Values[0];
          ANode := ANode.GetNextNode;
        end;

      // если это дочка, и галочка ставитс€, то надо родителю тоже поставить
      end else if (AnItem.Parent <> nil) and (AnItem.Values[0] = '1') then
        AnItem.Parent.Values[0] := '1'

      // если это дочка, и галочка убираетс€, то надо проверить а у всех ли дочек убрана галочка, если у всех, то галочку у родител€ надо тоже убрать
      else if (AnItem.Parent <> nil) and (AnItem.Values[0] = '0') then begin
        ANode := AnItem.Parent.GetFirstChild;
        Cnt := 0;
        for i := 0 to AnItem.Parent.Count - 1 do begin
          if ANode.Values[0] = '1' then
           Cnt := Cnt + 1;
          ANode := ANode.GetNextNode;
        end;
        if Cnt = 0 then
          AnItem.Parent.Values[ColumnByName('CheckCol').Index] := '0';  //везде поставил 0, а тут оставил такой вызов просто так
      end
    end;
  end;
end;

procedure TOfficialForm.edPasswordKeyPress(Sender: TObject; var Key: Char);
begin
  inherited;
  If not (Key in ['A'..'Z', 'a'..'z', '0'..'9', '-', '/', '=', '(', ')', '!', '+', #8]) Then
    Key := #0;
end;

procedure TOfficialForm.btAllClick(Sender: TObject);
var ANode: TdxTreeListNode;
begin
  edFM.Modified := True;  //иначе не вызоваетс€ Update
  spReadRights.First;
  ANode := tlRights.FocusedNode;
  while ANode <> nil do begin
    ANode.Values[0] := '1';
    if ANode.HasChildren then ANode.Expand(False);
    ANode := ANode.GetNextNode;
    if ANode = nil then Break;
  end;
end;

procedure TOfficialForm.btNoneClick(Sender: TObject);
var ANode: TdxTreeListNode;
begin
  edFM.Modified := True;  //иначе не вызоваетс€ Update
  spReadRights.First;
  ANode := tlRights.FocusedNode;
  while ANode <> nil do begin
    ANode.Values[0] := '0';
    if ANode.HasChildren then ANode.Expand(False);
    ANode := ANode.GetNextNode;
    if ANode = nil then Break;
  end;
  tlRights.FullCollapse;  //иначе почему-то весь раскрываетс€
end;

procedure TOfficialForm.edFIOEnter(Sender: TObject);
var n : integer;
    S : String;
begin
  inherited;
  //автоматом приведу “емеков јйдын јйдарович к виду “емеков ј.ј.
  if edFIO.Text = '' then begin
    S := Trim(edFM.Text) + ' ' + Trim(edNM.Text) + ' ' + Trim(edFT.Text);
    n := pos(' ', S);
    edFIO.Text := copy(S, 1, n);
    Delete(S, 1, n);

    n := pos(' ', S);
    edFIO.Text := edFIO.Text + copy(S, 1, 1) + '.';
    if n > 0 then begin
      Delete(S, 1, n);

      edFIO.Text := edFIO.Text + ' ' + copy(S, 1, 1) + '.';
    end;
  end;
end;

