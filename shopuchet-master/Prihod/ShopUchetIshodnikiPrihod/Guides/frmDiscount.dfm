  inherited spGetData: TpFIBStoredProc
    SQL.Strings = (
      'EXECUTE PROCEDURE G_GET_G_DISCOUNT (?G_DISCOUNT_)')
    StoredProcName = 'G_GET_G_DISCOUNT'
    Left = 126
    Top = 262
  end
  inherited spIns: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE G_INS_G_DISCOUNT (?G_PRODUCT_PAR_, ?G_PRODUCT_' +
        ', ?DATE_BEGIN_, ?DATE_END_, ?NAME_, ?SKIDKA_PROC_, ?SKIDKA_SUM_)')
    StoredProcName = 'G_INS_G_DISCOUNT'
    Left = 158
    Top = 262
  end
  inherited spUpd: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE G_UPD_G_DISCOUNT (?G_DISCOUNT_, ?G_PRODUCT_, ?' +
        'G_PRODUCT_PAR_, ?DATE_BEGIN_, ?DATE_END_, ?NAME_, ?PRICE_, ?SKID' +
        'KA_PROC_, ?SKIDKA_SUM_)')
    StoredProcName = 'G_UPD_G_DISCOUNT'
    Left = 190
    Top = 262
  end
  object dsRead: TDataSource
    DataSet = spRead
    Left = 535
    Top = 31
  end
  object spRead: TpFIBDataSet
    SelectSQL.Strings = (
      
        'WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODU' +
        'CT, 0) SORTT,'
      '                               T.G_PRODUCT,'
      '                               T.G_PRODUCT_PAR,'
      
        '                               DECODE(T.G_PRODUCT, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087 +
        #1087#1099#39', T.NAME) NAME,'
      
        '                               T.NAME PATH,       --'#1076#1083#1103' '#1089#1086#1088#1090#1080#1088#1086#1074 +
        #1082#1080
      '                               '#39'  '#39' LVL'
      '                          FROM G_PRODUCT T'
      
        '                         WHERE (T.G_PRODUCT_PAR IS NULL or T.g_p' +
        'roduct = -1)'
      '                        UNION ALL'
      
        '                        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODU' +
        'CT, 0) SORTT,'
      '                               T.G_PRODUCT,'
      '                               T.G_PRODUCT_PAR,'
      '                               GG.LVL||T.NAME NAME,'
      
        '                               GG.PATH||'#39' - '#39'||T.NAME,     --'#1044#1051#1071 +
        ' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '                               GG.LVL||'#39'  '#39' LVL'
      
        '                          FROM G_PRODUCT T INNER JOIN TREE GG ON' +
        ' GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '                         WHERE T.IS_CATEGORY = 1'
      '                        )'
      '    SELECT * FROM TREE ORDER BY 1, 5, 3')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 496
    Top = 32
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
end
