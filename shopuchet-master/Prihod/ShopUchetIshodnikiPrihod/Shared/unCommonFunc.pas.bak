begin
  Result := WS;
end;

function rk1048_2_WideString(const S: String): WideString;
var
  i: Integer;
begin
  Result := S;
  for i := 1 to Length(S) do
    case S[i] of
      #$8D: Result[i] := #$049A;
      #$8E: Result[i] := #$04BA;
      #$9D: Result[i] := #$049B;
      #$9E: Result[i] := #$04BB;
      #$A1: Result[i] := #$04B0;
      #$A2: Result[i] := #$04B1;
      #$A3: Result[i] := #$04D8;
      #$A5: Result[i] := #$04E8;
      #$AA: Result[i] := #$0492;
      #$AF: Result[i] := #$04AE;
      #$B2: Result[i] := #$0406;
      #$B3: Result[i] := #$0456;
      #$B4: Result[i] := #$04E9;
      #$BA: Result[i] := #$0493;
      #$BC: Result[i] := #$04D9;
      #$BD: Result[i] := #$04A2;
      #$BE: Result[i] := #$04A3;
      #$BF: Result[i] := #$04AF;
    else
      ; {Оставляем исходный символ без изменений}
    end; {case}

