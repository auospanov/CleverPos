      '1103368='
      '1103369=  if (G_PRIHOD_RASHOD_ in (0, 1, 2, 3, 4)) then begin'
      '1103370=    ERR_CODE = -20500;'
      
        '1103371=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1044#1072#1085#1085#1072#1103' '#1079#1072#1087 +
        #1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '1103372=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1103373=    EXIT;'
      '1103374=  end'
      '1103375='
      '1103376=  delete from G_PRIHOD_RASHOD g'
