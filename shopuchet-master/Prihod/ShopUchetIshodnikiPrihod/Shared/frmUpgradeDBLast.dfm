        '110242842=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '110242843=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110242844='
      
        '110242845=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '110242846=            END ELSE'
      
        '110242847=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110242848=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODU' +
        'CT_NAME_||'#39#39'.'#39#39';'
      '110242849=        END'
      
        '110242850=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110242851=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110242852='
      '110242853=    PNT_ = '#39#39'02b'#39#39';'
      '110242854=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '110242855=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110242856=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE)'
      
        '110242857=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_P' +
        'AR_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, ' +
        ':PRICE_,'
      
        '110242858=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_)'
      '110242859=        returning G_PRODUCT'
      '110242860=        into :G_PRODUCT_;'
      '110242861='
      
        '110242862=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
