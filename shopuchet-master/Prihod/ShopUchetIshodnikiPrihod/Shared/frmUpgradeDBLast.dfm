        'T_,'
      
        '110242431=                                          :G_PAYMENT_T' +
        'YPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110242432=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110242433=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110242434=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_'
