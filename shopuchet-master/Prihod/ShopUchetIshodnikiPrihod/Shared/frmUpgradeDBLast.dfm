      '11032463=               T.SUMM_FACT,'
      '11032464=               0,'
      '11032465=               0'
      '11032466=          FROM ZAKAZ T'
      
        '11032467=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '11032468=           AND T.IS_SPISANIE  = 1'
      
        '11032469=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
