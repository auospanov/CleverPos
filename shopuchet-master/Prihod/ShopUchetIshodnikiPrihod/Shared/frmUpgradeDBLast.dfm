        '|'#39#39')'#39#39', '#39#39', '#39#39')'
      
        '11032453=                        FROM ZAKAZ_DETAILS D, G_PRODUCT' +
        ' G'
      '11032454=                        WHERE D.G_PRODUCT = G.G_PRODUCT'
      '11032455=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '11032456=                          GROUP BY ZAKAZ) FROM 1 FOR 99' +
