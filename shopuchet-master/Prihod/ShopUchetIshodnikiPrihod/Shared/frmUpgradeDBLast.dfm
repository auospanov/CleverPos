        ' - '#39#39'||G_PRODUCT_NAME_||'#39#39'.'#39#39';'
      '110242805=        END'
      '110242806=    end'
      '110242807='
      
        '110242808=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110242809=    PNT_ = '#39#39'02b'#39#39';'
      
        '110242810=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110242811=        SELECT G.G_PRODUCT,'
      '110242812=               G.NAME'
      '110242813=          FROM G_PRODUCT G'
      '110242814=         WHERE G.BARCODE = TRIM(:BARCODE_)'
