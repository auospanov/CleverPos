      '110242865='
      
        '110242866=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110242867=    PNT_ = '#39#39'03'#39#39';'
      '110242868=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110242869=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110242870=                                       :AMOUNT_,'
      '110242871=                                       :SELF_PRICE_,'
      
        '110242872=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110242873=                                       0, --nds_,'
      '110242874=                                       0 --nds_summ_,'
      
        '110242875=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110242876=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110242877=          ERR_MSG  = '#39#39' PNT_ '#39#39'||PNT_||'#39#39' -> '#39#39'||ERR_M' +
        'SG;'
      '110242878=          EXIT;'
      '110242879=        END'
      '110242880=    END'
      '110242881='
      
        '110242882=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110242883=    PNT_ = '#39#39'04'#39#39';'
      '110242884=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110242885=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110242886=        FROM SKLAD_TMP T'
      '110242887=        INTO :CNT_;'
      '110242888='
      '110242889=      if (CNT_ > 0) then BEGIN'
      '110242890=        SELECT SUM(T.SUMM)'
      '110242891=          FROM SKLAD_TMP T'
      '110242892=          INTO :SUMM_;'
      '110242893='
      '110242894=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110242895=                                DATE_RECEIPT,'
      '110242896=                                TIME_RECEIPT,'
      '110242897=                                G_CLIENT,'
      '110242898=                                G_PAYMENT_TYPE,'
      '110242899=                                OSNOVANIE,'
      '110242900=                                NOTE,'
      '110242901=                                SUMM,'
      '110242902=                                SUMM_FACT,'
      '110242903=                                IS_PAYED_ALL,'
      '110242904=                                IS_VOZVRAT,'
      '110242905=                                G_TOCHKA)'
      '110242906=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110242907=                CURRENT_DATE,'
      '110242908=                CURRENT_TIME,'
      '110242909=                :G_CLIENT_,'
      '110242910=                1,'
      '110242911=                NULL,  --:OSNOVANIE_,'
      '110242912=                NULL,  -- :NOTE_,'
      '110242913=                :SUMM_,'
      '110242914=                :SUMM_,'
      
        '110242915=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110242916=                0,'
      '110242917=                :G_TOCHKA_)'
      '110242918=        RETURNING'
      '110242919=          SKLAD'
      '110242920=        INTO'
      '110242921=          :SKLAD_PARENT_;'
      '110242922='
      '110242923=        PNT_ = '#39#39'05'#39#39';'
      '110242924=        FOR SELECT SKLAD,'
      '110242925=                   G_PRODUCT,'
      '110242926=                   AMOUNT,'
      '110242927=                   PRICE,'
      '110242928=                   SUMM'
      '110242929=              FROM SKLAD_TMP'
      '110242930=             ORDER BY 1'
      '110242931=              INTO :SKLAD_TMP_,'
      '110242932=                   :RG_PRODUCT_,'
      '110242933=                   :RAMOUNT_,'
      '110242934=                   :RPRICE_,'
      '110242935=                   :RSUMM_'
      '110242936=        DO BEGIN'
      '110242937='
      '110242938=            UPDATE SKLAD SK'
      '110242939=               SET SK.IS_LAST = 0'
      '110242940=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110242941=               AND SK.IS_LAST = 1;'
      '110242942='
      '110242943=            INSERT INTO SKLAD'
      '110242944=            ('
      '110242945=             SKLAD,'
      '110242946=             SKLAD_PARENT,'
      '110242947=             DATE_RECEIPT,'
      '110242948=             G_CLIENT,'
      '110242949=             G_PRODUCT,'
      '110242950=             AMOUNT,'
      '110242951=             PRICE,'
      '110242952=             SUMM,'
      '110242953=             G_PAYMENT_TYPE,'
      '110242954=             OSNOVANIE,'
      '110242955=             NOTE,'
      '110242956=             NDS,'
      '110242957=             NDS_SUMM,'
      '110242958=             IS_LAST,'
      '110242959=             IS_VOZVRAT,'
      '110242960=             G_TOCHKA'
      '110242961=            ) VALUES ('
      '110242962=             :SKLAD_TMP_,'
      '110242963=             :SKLAD_PARENT_,'
      '110242964=             CURRENT_DATE,'
      '110242965=             :G_CLIENT_,'
      '110242966=             :RG_PRODUCT_,'
      '110242967=             :RAMOUNT_,'
      '110242968=             :RPRICE_,'
      '110242969=             :RSUMM_,'
      '110242970=             1,       --:G_PAYMENT_TYPE_,'
      '110242971=             NULL,    --:OSNOVANIE_,'
      '110242972=             NULL,    --:NOTE_,'
      '110242973=             0,       --:RNDS_,'
      '110242974=             0,       --:RNDS_SUMM_,'
      '110242975=             1,       --IS_LAST_'
      '110242976=             0,        --:IS_VOZVRAT_'
      '110242977=             :G_TOCHKA_'
      '110242978=            );'
      '110242979='
      
        '110242980=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110242981=            PNT_ = '#39#39'06'#39#39';'
      '110242982=            UPDATE LT_SKLAD_PRODUCT L'
      '110242983=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110242984=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110242985=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110242986='
      '110242987=            PNT_ = '#39#39'06a'#39#39';'
      '110242988=            IF (ROW_COUNT = 0) THEN'
      
        '110242989=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110242990=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110242991=        END'
      '110242992='
      '110242993=        PNT_ = '#39#39'07'#39#39';'
      
        '110242994=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110242995=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110242996=                                :SUMM_,'
      '110242997=                                CURRENT_DATE,'
      
        '110242998=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110242999=                                NULL,   --ZAKAZ_'
      '110243000=                                :SKLAD_PARENT_,'
      '110243001=                                1,'
      
        '110243002=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110243003=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110243004=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110243005=          EXIT;'
      '110243006=        END'
      '110243007='
      '110243008=        DELETE FROM SKLAD_TMP;'
      '110243009=      END'
      '110243010=    END'
      '110243011='
      
        '110243012=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110243013=    if (ERR_MSG_ IS NOT NULL) then'
      '110243014=      ERR_MSG = ERR_MSG_;'
      '110243015='
      '110243016=WHEN ANY DO BEGIN'
      '110243017=    Err_code = gdscode;'
      
        '110243018=    ERR_MSG = '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39#39'||gdscode||'#39 +
        #39' --> PNT_ '#39#39'||PNT_;'
      '110243019=  END'
      '110243020=END'
      '110243021='#39';'
      '110243022='
      
        '110243023=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAYAVKA_POSTA' +
        'VSHIK('
      '110243024=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110243025=  BEGIN_DATE_ DATE,'
      '110243026=  END_DATE_ DATE,'
      '110243027=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110243028=  DO_SKLAD_ INTEGER,'
      '110243029=  MODE_ INTEGER,'
      '110243030=  MODE_VYBOR_ INTEGER,'
      '110243031=  MODE_VAL_ INTEGER,'
      '110243032=  NEW_VAL_ NUMERIC(15,2),'
      '110243033=  ROUND_MODE_ INTEGER)'
      '110243034=RETURNS ('
      '110243035=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110243036=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '110243037=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110243038=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110243039=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110243040=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110243041=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '110243042=  ERR_CODE INTEGER,'
      '110243043=  ERR_MSG VARCHAR(1024))'
      '110243044=AS'
      '110243045=/*'
      
        '110243046='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057#1056 +
        #1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '110243047='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055#1054 +
        #1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '110243048=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055#1056 +
        #1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '110243049=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 - ' +
        #1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '110243050=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054 +
        #1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045' ' +
        #1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110243051=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '110243052=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067#1042 +
        #1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      '110243053=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' */'
      '110243054=DECLARE VARIABLE ROUND_ INTEGER;'
      '110243055=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '110243056=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      
        '110243057=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110243058=BEGIN'
      '110243059=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110243060='
      '110243061=  IF (G_TOCHKA_ IS NULL) THEN'
      '110243062=    SELECT ID'
      '110243063=      FROM CUR_PARAMS'
      '110243064=     WHERE CUR_PARAMS = 2'
      '110243065=      INTO :G_TOCHKA_;'
      '110243066='
      '110243067=  IF (ROUND_MODE_ = 0) THEN'
      '110243068=      ROUND_ = 0;'
      '110243069=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '110243070=      ROUND_ = -1;'
      '110243071=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '110243072=      ROUND_ = -2;'
      '110243073=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '110243074=      ROUND_ = -3;'
      '110243075='
      
        '110243076=  SQL_STR_ = '#39#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39#39';'
      '110243077='
      
        '110243078=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040' ' +
        #1053#1040' '#1057#1050#1051#1040#1044#1045
      '110243079=  IF (MODE_ = 0) THEN BEGIN'
      
        '110243080=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39#39';'
      '110243081=    IF (MODE_VAL_ = 0) THEN'
      '110243082=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110243083=    ELSE'
      
        '110243084=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110243085='
      '110243086=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110243087=  END'
      '110243088=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '110243089=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '110243090=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND(ABS(LT.AMOUNT)'#39#39';'
      '110243091=    IF (MODE_VAL_ = 0) THEN'
      '110243092=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110243093=    ELSE'
      
        '110243094=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110243095='
      '110243096=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110243097=  END'
      '110243098='
      
        '110243099=  SQL_STR_ = SQL_STR_ || '#39#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39#39'||'
      
        '110243100=            '#39#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39#39';'
      '110243101='
      '110243102=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '110243103=    SQL_STR_ = SQL_STR_ ||'#39#39'AND EXISTS (SELECT 1'#39#39'||'
      
        '110243104=                                        '#39#39' FROM SKLAD ' +
        'S'#39#39'||'
      
        '110243105=                                        '#39#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39#39'||'
      
        '110243106=                                        '#39#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39#39'||'
      
        '110243107=                                        '#39#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39#39';'
      '110243108=    IF (MODE_VYBOR_ = 2) THEN'
      
        '110243109=      SQL_STR_ = SQL_STR_ ||'#39#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39#39';'
      '110243110=    ELSE'
      
        '110243111=      SQL_STR_ = SQL_STR_ ||'#39#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' ' +
        #1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042 +
        #1057#1045#1043#1044#1040
      '110243112=    SQL_STR_ = SQL_STR_ ||'#39#39') '#39#39';'
      '110243113=  END ELSE BEGIN'
      
        '110243114=    SQL_STR_ = SQL_STR_ ||'#39#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39#39';  -' +
        '- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '110243115=  END'
      '110243116='
      '110243117=  IF (MODE_ = 0) THEN'
      
        '110243118=    SQL_STR_ = SQL_STR_ || '#39#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39#39';'
      '110243119=  ELSE IF (MODE_ = 1) THEN'
      '110243120=    SQL_STR_ = SQL_STR_ || '#39#39' AND LT.AMOUNT < 0'#39#39';'
      
        '110243121=  SQL_STR_ = SQL_STR_ || '#39#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39#39';'
      '110243122='
      '110243123=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '110243124=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '110243125=      FOR EXECUTE STATEMENT'
      
        '110243126=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110243127=          INTO :G_PRODUCT,'
      '110243128=               :CATEGORY_NAME,'
      '110243129=               :NAME,'
      '110243130=               :ARTICUL,'
      '110243131=               :AMOUNT_CUR,'
      '110243132=               :MIN_AMOUNT,'
      '110243133=               :AMOUNT_TO_ZAKAZ'
      '110243134=        DO BEGIN'
      
        '110243135=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_P' +
        'RODUCT, :G_TOCHKA_, 0)'
      '110243136=              RETURNING_VALUES :COST_PRICE_;'
      '110243137='
      
        '110243138=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, A' +
        'MOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110243139=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_P' +
        'RODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO_' +
        'ZAKAZ, 0, 0);'
      '110243140=        END'
      '110243141='
      '110243142=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110243143=                                      CURRENT_DATE,'
      '110243144=                                      CURRENT_TIME,'
      '110243145=                                      :G_CLIENT_,'
      '110243146=                                      1,'
      
        '110243147=                                      NULL, --:OSNOVAN' +
        'IE__,'
      '110243148=                                      NULL, --:NOTE__,'
      
        '110243149=                                      0, --:IS_VOZVRAT' +
        '_,'
      
        '110243150=                                      (SELECT SUM(S.SU' +
        'MM) FROM SKLAD_TMP S),'
      
        '110243151=                                      0, -- :SUMM_FACT' +
        '_'
      '110243152=                                      0, --:G_PRIHOD_,'
      
        '110243153=                                      0 --:SUMM_PRIHOD' +
        '_)'
      '110243154=                                      ,NULL --PAYMENTS'
      
        '110243155=                                     )RETURNING_VALUES' +
        ' :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110243156=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110243157=          ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39#39'||ERR_MSG;'
      '110243158=          EXIT;'
      '110243159=        END'
      '110243160=  END'
      '110243161=  ELSE BEGIN'
      '110243162=      FOR EXECUTE STATEMENT'
      
        '110243163=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110243164=      INTO :G_PRODUCT,'
      '110243165=           :CATEGORY_NAME,'
      '110243166=           :NAME,'
      '110243167=           :ARTICUL,'
      '110243168=           :AMOUNT_CUR,'
      '110243169=           :MIN_AMOUNT,'
      '110243170=           :AMOUNT_TO_ZAKAZ'
      '110243171=      DO SUSPEND;'
      '110243172=  END'
      '110243173=END'
      '110243174='#39';'
      '110243175='
      '110243176=EXECUTE STATEMENT '#39'ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '110243177=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110243178=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110243179=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110243180=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110243181=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110243182=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110243183=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110243184=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110243185=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '110243186=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED)'
      '110243187=RETURNS ('
      '110243188=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110243189=  ERR_CODE INTEGER,'
      '110243190=  ERR_MSG VARCHAR(1024))'
      '110243191=AS'
      
        '110243192=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062#1045 +
        #1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '110243193=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045#1057 +
        #1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '110243194=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040#1042 +
        #1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '110243195=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042#1053 +
        #1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '110243196='
      
        '110243197=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042 +
        #1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110243198=declare variable PROCNAME varchar(30) = '#39#39'PAY_ZAKAZ_NA' +
        '_REAL'#39#39';'
      '110243199=declare variable PNT_ varchar(5);'
      
        '110243200=declare variable SKLAD_ type of column SKLAD_PARENT.SK' +
        'LAD;'
      
        '110243201=declare variable G_PRODUCT_ type of column G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110243202=declare variable AMOUNT_ type of column ZAKAZ_NA_REAL.' +
        'AMOUNT_ALL;'
      
        '110243203=declare variable Z_SUMM_ type of column ZAKAZ_NA_REAL.' +
        'SUMM_PAYED;'
      
        '110243204=declare variable ZAKAZ_NA_REAL_ type of column ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110243205=declare variable ZAKAZ_DETAILS_ type of column ZAKAZ_D' +
        'ETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '110243206=declare variable PRICE_ type of column SKLAD.PRICE;'
      '110243207=declare variable NDS_ type of column SKLAD.NDS;'
      
        '110243208=declare variable NDS_SUMM_ type of column SKLAD.NDS_SU' +
        'MM;'
      '110243209=BEGIN'
      '110243210='
      '110243211=  IF (G_TOCHKA_ IS NULL) THEN'
      '110243212=    SELECT ID'
      '110243213=      FROM CUR_PARAMS'
      '110243214=     WHERE CUR_PARAMS = 2'
      '110243215=      INTO :G_TOCHKA_;'
      '110243216='
      
        '110243217=  --**************************************************' +
        '************************************************'
      
        '110243218=  --**************************************************' +
        '************************************************'
      '110243219=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110243220=  --**************************************************' +
        '************************************************'
      
        '110243221=  --**************************************************' +
        '************************************************'
      '110243222=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '110243223=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1055 +
        #1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '110243224=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '110243225=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110243226=            INTO :AMOUNT_,'
      '110243227=                 :G_PRODUCT_'
      '110243228=      DO BEGIN'
      '110243229=          UPDATE LT_SKLAD_PRODUCT L'
      '110243230=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110243231=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110243232=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110243233=      END'
      '110243234='
      '110243235=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '110243236=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E,'
      
        '110243237=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE)'
      
        '110243238=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '110243239=             NDS_SUMM, COST_PRICE'
      '110243240=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110243241='
      '110243242=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110243243=                                  :Z_DATE_,'
      '110243244=                                  :Z_TIME_,'
      '110243245=                                  :G_CLIENT_,'
      '110243246=                                  :G_PAYMENT_TYPE_,'
      '110243247=                                  :OSNOVANIE_,'
      
        '110243248=                                  :IS_SPISANIE_,   -- ' +
        ':IS_SPISANIE_'
      '110243249=                                  :NOTE_,'
      
        '110243250=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040 +
        #1050#1040#1047#1040
      
        '110243251=                                  :SUMM_FACT_,  -- '#1048' '#1057 +
        #1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '110243252=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 1, SUMM_FACT_, 0),'
      
        '110243253=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 2, SUMM_FACT_, 0),'
      '110243254=                                  0, --SUMM_BONUS_'
      '110243255=                                  0, --SUMM_BONUS_GOT_'
      
        '110243256=                                  null,         -- '#1057#1058#1040 +
        #1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '110243257=                                  0,            -- '#1057#1059#1052 +
        #1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '110243258=                                  0,    --BY_RECIPE'
      '110243259=                                  0     --IS_RESERVE'
      '110243260=                                  ,NULL  -- PAYMENTS_'
      '110243261=                                  )'
      '110243262=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110243263='
      '110243264=      if (ERR_CODE <> 0) then BEGIN'
      '110243265=        ERR_CODE = -20500;'
      '110243266=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110243267=        Exit;'
      '110243268=      END'
      '110243269='
      
        '110243270=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' '#1040 +
        #1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' ' +
        #1055#1054#1044' '#1056#1045#1040#1051
      
        '110243271=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044#1040 +
        ' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '110243272=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042#1045 +
        #1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '110243273=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059 +
        #1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '110243274=      UPDATE ZAKAZ'
      '110243275=         SET IS_SPISANIE = 2'
      '110243276=       WHERE ZAKAZ = :ZAKAZ_;'
      '110243277='
      
        '110243278=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110243279=      FOR SELECT T.AMOUNT,'
      '110243280=                 T.SUMM,'
      '110243281=                 T.G_PRODUCT,'
      '110243282=                 T.ZAKAZ_NA_REAL,'
      '110243283=                 T.ZAKAZ_DETAILS'
      '110243284=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110243285=            INTO :AMOUNT_,'
      '110243286=                 :Z_SUMM_,'
      '110243287=                 :G_PRODUCT_,'
      '110243288=                 :ZAKAZ_NA_REAL_,'
      '110243289=                 :ZAKAZ_DETAILS_'
      '110243290=      DO BEGIN'
      '110243291=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110243292=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOU' +
        'NT_,'
      
        '110243293=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110243294=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110243295=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110243296='
      
        '110243297=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ' +
        'ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '110243298=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110243299=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110243300=      END'
      '110243301=  END'
      '110243302=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110243303=  --**************************************************' +
        '************************************************'
      
        '110243304=  --**************************************************' +
        '************************************************'
      '110243305='
      
        '110243306=  --**************************************************' +
        '************************************************'
      
        '110243307=  --**************************************************' +
        '************************************************'
      '110243308=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110243309=  --**************************************************' +
        '************************************************'
      
        '110243310=  --**************************************************' +
        '************************************************'
      '110243311=  ELSE BEGIN'
      '110243312=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '110243313=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ZA' +
        'KAZ_DETAILS - ZAKAZ_REAL'
      
        '110243314=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110243315=      FOR SELECT T.AMOUNT,'
      '110243316=                 T.SUMM,'
      '110243317=                 T.G_PRODUCT,'
      '110243318=                 T.ZAKAZ_NA_REAL,'
      '110243319=                 T.ZAKAZ_DETAILS'
      '110243320=                 ,T.PRICE - T.DISCOUNT_TENGE'
      '110243321=                 ,T.NDS'
      '110243322=                 ,T.NDS_SUMM'
      '110243323=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110243324=            INTO :AMOUNT_,'
      '110243325=                 :Z_SUMM_,'
      '110243326=                 :G_PRODUCT_,'
      '110243327=                 :ZAKAZ_NA_REAL_,'
      '110243328=                 :ZAKAZ_DETAILS_'
      '110243329=                 ,:PRICE_'
      '110243330=                 ,:NDS_'
      '110243331=                 ,:NDS_SUMM_'
      '110243332=      DO BEGIN'
      
        '110243333=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUN' +
        'T, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110243334=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '110243335='
      
        '110243336=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110243337=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110243338='
      '110243339=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110243340=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :AMOUNT_,'
      
        '110243341=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110243342=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110243343=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110243344=      END'
      '110243345='
      '110243346=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110243347=                                  :Z_DATE_,'
      '110243348=                                  :Z_TIME_,'
      '110243349=                                  :G_CLIENT_,'
      '110243350=                                  :G_PAYMENT_TYPE_,'
      '110243351=                                  :OSNOVANIE_,'
      '110243352=                                  :NOTE_,'
      
        '110243353=                                  2,        --:IS_VOZV' +
        'RAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-' +
        #1050#1059
      '110243354=                                  :SUMM_,'
      '110243355=                                  :SUMM_FACT_,'
      
        '110243356=                                  NULL,     --:G_PRIHO' +
        'D_,'
      
        '110243357=                                  NULL      --:SUMM_PR' +
        'IHOD_'
      
        '110243358=                                  ,NULL     -- PAYMENT' +
        'S'
      
        '110243359=                                  ) RETURNING_VALUES :' +
        'SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110243360='
      '110243361=      if (ERR_CODE <> 0) then BEGIN'
      '110243362=        ERR_CODE = -20500;'
      '110243363=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110243364=        Exit;'
      '110243365=      END'
      '110243366=  END'
      '110243367=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110243368=  --**************************************************' +
        '************************************************'
      
        '110243369=  --**************************************************' +
        '************************************************'
      '110243370='
      '110243371=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110243372=END'
      '110243373='#39';'
      '110243374='
      '110243375=EXECUTE STATEMENT '#39'ALTER PROCEDURE R_UNIFICATION('
      '110243376=  MODE_ INTEGER)'
      '110243377=RETURNS ('
      '110243378=  COUNT_SPIS_ INTEGER,'
      '110243379=  COUNT_PRIH_ INTEGER,'
      '110243380=  ERR_CODE INTEGER,'
      '110243381=  ERR_MSG VARCHAR(1024))'
      '110243382=AS'
      
        '110243383=declare variable PROCNAME varchar(15) = '#39#39'R_UNIFICATIO' +
        'N'#39#39';'
      '110243384=declare variable PNT_ varchar(5);'
      
        '110243385=declare variable REVISION_ type of column REVISION.REV' +
        'ISION;'
      
        '110243386=declare variable G_PRODUCT_ type of column REVISION.G_' +
        'PRODUCT;'
      
        '110243387=declare variable AMOUNT_BD_ type of column REVISION.AM' +
        'OUNT_BD;'
      
        '110243388=declare variable AMOUNT_REAL_ type of column REVISION.' +
        'AMOUNT_REAL;'
      
        '110243389=declare variable PRICE_LAST_ type of column SKLAD.PRIC' +
        'E;'
      '110243390=declare variable ZAKAZ_ type of column ZAKAZ.ZAKAZ;'
      
        '110243391=declare variable SUMM_ type of column SKLAD_PARENT.SUM' +
        'M;'
      
        '110243392=declare variable SKLAD_ type of column SKLAD_PARENT.SK' +
        'LAD;'
      
        '110243393=declare variable G_TOCHKA_ type of column G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110243394=declare variable COST_PRICE_ type of column ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      '110243395=BEGIN'
      '110243396='
      '110243397=  COUNT_SPIS_ = 0;'
      '110243398=  COUNT_PRIH_ = 0;'
      '110243399='
      '110243400=  SELECT ID'
      '110243401=    FROM CUR_PARAMS'
      '110243402=   WHERE CUR_PARAMS = 2'
      '110243403=    INTO :G_TOCHKA_;'
      '110243404='
      
        '110243405=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_RE' +
        'AL'
      '110243406=      FROM REVISION'
      
        '110243407=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOU' +
        'NT_REAL_'
      '110243408=  DO BEGIN'
      
        '110243409=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2' +
        '))) THEN BEGIN'
      
        '110243410=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1)'
      '110243411=        RETURNING_VALUES :COST_PRICE_;'
      '110243412='
      
        '110243413=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_' +
        'PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110243414=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM)'
      
        '110243415=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMO' +
        'UNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '110243416='
      '110243417=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '110243418=    END'
      '110243419='
      
        '110243420=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1' +
        '))) then BEGIN'
      '110243421=      SELECT S.PRICE'
      '110243422=        FROM SKLAD S'
      '110243423=       WHERE S.IS_LAST = 1'
      '110243424=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110243425=         AND S.G_TOCHKA = :G_TOCHKA_'
      '110243426=        INTO :PRICE_LAST_;'
      '110243427='
      
        '110243428=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056 +
        #1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '110243429='
      
        '110243430=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110243431=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AM' +
        'OUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '110243432='
      '110243433=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '110243434=    END'
      '110243435='
      '110243436=    UPDATE REVISION R'
      '110243437=       SET R.IS_UNIFIED = 1'
      '110243438=     WHERE R.REVISION = :REVISION_;'
      '110243439=  END'
      '110243440='
      '110243441=  PNT_ = '#39#39'01'#39#39';'
      '110243442=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '110243443=    SELECT SUM(S.SUMM)'
      '110243444=      FROM ZAKAZ_DETAILS_TMP S'
      '110243445=      INTO :SUMM_;'
      '110243446='
      '110243447=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110243448=                                CURRENT_DATE, --:Z_DAT' +
        'E_,'
      
        '110243449=                                CURRENT_TIME, --:Z_TIM' +
        'E'
      
        '110243450=                                10,          --:G_CLIE' +
        'NT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '110243451=                                1,            --:G_PAY' +
        'MENT_TYPE_,'
      
        '110243452=                                NULL,         --:OSNOV' +
        'ANIE_,'
      
        '110243453=                                1,              --:IS_' +
        'SPISANIE_,'
      
        '110243454=                                NULL,           --:NOT' +
        'E_,'
      
        '110243455=                                :SUMM_,              -' +
        '-:SUMM_,'
      
        '110243456=                                :SUMM_,              -' +
        '-:SUMM_FACT_,'
      
        '110243457=                                0,              --SUMM' +
        '_BONUS_'
      
        '110243458=                                0,              --SUMM' +
        '_BONUS_GOT'
      
        '110243459=                                NULL,           --:G_P' +
        'RIHOD_,'
      '110243460=                                NULL,'
      '110243461=                                0,        -- BY_RECIPE'
      
        '110243462=                                0         -- IS_RESERV' +
        'E'
      '110243463=                                ,NULL  -- PAYMENTS_'
      '110243464=                                ,0     -- SUMM_CASH'
      '110243465=                                ,0     -- SUMM_NONCASH'
      
        '110243466=                                ) RETURNING_VALUES :ZA' +
        'KAZ_, :ERR_CODE, :ERR_MSG;'
      '110243467=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110243468=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110243469=      EXIT;'
      '110243470=    END'
      '110243471=  END'
      '110243472='
      '110243473=  PNT_ = '#39#39'02'#39#39';'
      '110243474=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '110243475=    SELECT SUM(S.SUMM)'
      '110243476=      FROM SKLAD_TMP S'
      '110243477=      INTO :SUMM_;'
      '110243478='
      '110243479=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110243480=                                CURRENT_DATE,   --:DAT' +
        'E_RECEIPT_,'
      '110243481=                                CURRENT_TIME,'
      
        '110243482=                                NULL,           --:G_C' +
        'LIENT_,'
      
        '110243483=                                1,              --:G_P' +
        'AYMENT_TYPE_,'
      
        '110243484=                                NULL,           --:OSN' +
        'OVANIE_,'
      
        '110243485=                                '#39#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39#39', ' +
        '          --:NOTE_,'
      
        '110243486=                                5,              --:IS_' +
        'VOZVRAT_,'
      '110243487=                                :SUMM_,'
      '110243488=                                :SUMM_,'
      
        '110243489=                                NULL,           --:G_P' +
        'RIHOD_,'
      
        '110243490=                                NULL            --:SUM' +
        'M_PRIHOD_'
      '110243491=                                ,NULL  --PAYMENTS'
      '110243492=                                )'
      '110243493=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110243494=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110243495=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110243496=      EXIT;'
      '110243497=    END'
      '110243498=  END'
      '110243499=END'
      '110243500='#39';'
      '110243501=END  --END_EXECUTE_BLOCK'
      '110243502=EXECUTE BLOCK AS BEGIN'
      '110243503='
      '110243504=EXECUTE STATEMENT '#39'ALTER PROCEDURE SYNC_DOWNLOAD('
      '110243505=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110243506=  UPLOAD_TABLE_TMP TYPE OF COLUMN UPLOAD_TABLE_TMP.UPL' +
        'OAD_TABLE_TMP,'
      '110243507=  MODE TYPE OF COLUMN UPLOAD_TABLE_TMP.MODE,'
      '110243508=  PARENT TYPE OF COLUMN UPLOAD_TABLE_TMP.PARENT,'
      '110243509=  DATE_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.DATE_OPER,'
      '110243510=  TIME_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.TIME_OPER,'
      '110243511=  G_CLIENT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_CLIENT,'
      
        '110243512=  G_PAYMENT_TYPE TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PAY' +
        'MENT_TYPE,'
      '110243513=  SUMM_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_ALL,'
      
        '110243514=  SUMM_FACT_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_F' +
        'ACT_ALL,'
      
        '110243515=  SUMM_PAY_BONUS TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'PAY_BONUS,'
      
        '110243516=  SUMM_BONUS_GOT TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'BONUS_GOT,'
      '110243517=  OSNOVANIE TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE,'
      '110243518=  NOTE TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE,'
      
        '110243519=  G_OFFICIAL TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICIA' +
        'L,'
      '110243520=  G_PRODUCT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT,'
      '110243521=  AMOUNT TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT,'
      '110243522=  PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE,'
      '110243523=  SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM,'
      
        '110243524=  DISCOUNT_PERC TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_PERC,'
      
        '110243525=  DISCOUNT_TENGE TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCO' +
        'UNT_TENGE,'
      
        '110243526=  DISCOUNT_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_SUMM,'
      '110243527=  NDS TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS,'
      '110243528=  NDS_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM,'
      
        '110243529=  COST_PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRIC' +
        'E,'
      '110243530=  BY_RECIPE TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE,'
      
        '110243531=  IS_RESERVE TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESERV' +
        'E,'
      '110243532=  PAYMENTS BLOB SUB_TYPE 1,'
      '110243533=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110243534=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110243535=  IS_LOAD_ INTEGER)'
      '110243536=RETURNS ('
      '110243537=  ERR_CODE INTEGER,'
      '110243538=  ERR_MSG VARCHAR(1024))'
      '110243539=AS'
      '110243540=/*'
      '110243541='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110243542='#1048#1044#1059' '#1055#1054' '#1042#1057#1045#1052' '#1055#1054#1054#1063#1045#1056#1045#1044#1053#1054', '#1055#1045#1056#1045#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1048#1055#1054#1052' '#1055#1056#1054#1062#1045#1057#1057#1040' '#1041#1059 +
        #1044#1059' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110243543='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1062#1048#1050#1051#1054#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059 +
        #1070' '#1058#1040#1041#1051#1048#1062#1059
      '110243544=*/'
      
        '110243545=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'SYNC_DOWNLOA' +
        'D'#39#39';'
      '110243546=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110243547=DECLARE VARIABLE MODE_ TYPE OF COLUMN UPLOAD_TABLE_TMP' +
        '.MODE;'
      
        '110243548=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110243549=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110243550=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110243551=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110243552=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110243553=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110243554=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '110243555=DECLARE VARIABLE BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RE' +
        'CIPE;'
      
        '110243556=DECLARE VARIABLE BY_RECIPE__ TYPE OF COLUMN ZAKAZ.BY_R' +
        'ECIPE;'
      
        '110243557=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '110243558=DECLARE VARIABLE IS_RESERVE__ TYPE OF COLUMN ZAKAZ.IS_' +
        'RESERVE;'
      
        '110243559=DECLARE VARIABLE PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZ' +
        'E 80;'
      
        '110243560=DECLARE VARIABLE PAYMENTS__ BLOB SUB_TYPE 1 SEGMENT SI' +
        'ZE 80;'
      
        '110243561=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.G_CLIENT;'
      
        '110243562=DECLARE VARIABLE G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_' +
        'PARENT.G_PAYMENT_TYPE;'
      
        '110243563=DECLARE VARIABLE OSNOVANIE_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.OSNOVANIE;'
      
        '110243564=DECLARE VARIABLE NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOT' +
        'E;'
      
        '110243565=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110243566=DECLARE VARIABLE SUMM_FACT_ALL_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM_FACT;'
      
        '110243567=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '110243568=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110243569=DECLARE VARIABLE PARENT_ TYPE OF COLUMN UPLOAD_TABLE_T' +
        'MP.PARENT;'
      
        '110243570=DECLARE VARIABLE PARENT_OLD_ TYPE OF COLUMN UPLOAD_TAB' +
        'LE_TMP.PARENT;'
      '110243571=DECLARE VARIABLE MODE_OLD_ INTEGER;'
      '110243572=DECLARE VARIABLE DATE_OPER__ DATE;'
      '110243573=DECLARE VARIABLE TIME_OPER__ TIME;'
      
        '110243574=DECLARE VARIABLE G_CLIENT__ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '110243575=DECLARE VARIABLE G_PAYMENT_TYPE__ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      
        '110243576=DECLARE VARIABLE OSNOVANIE__ TYPE OF COLUMN ZAKAZ.OSNO' +
        'VANIE;'
      '110243577=DECLARE VARIABLE NOTE__ TYPE OF COLUMN ZAKAZ.NOTE;'
      '110243578=DECLARE VARIABLE SUMM__ NUMERIC(15,2);'
      '110243579=DECLARE VARIABLE SUMM_FACT__ NUMERIC(15,2);'
      
        '110243580=DECLARE VARIABLE SUMM_CASH__ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '110243581=DECLARE VARIABLE SUMM_NONCASH__ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '110243582=DECLARE VARIABLE SUMM_PAY_BONUS__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '110243583=DECLARE VARIABLE SUMM_BONUS_GOT__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '110243584=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '110243585=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2' +
        ');'
      
        '110243586=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      '110243587=DECLARE VARIABLE DATE_OPER_ DATE;'
      '110243588=DECLARE VARIABLE TIME_OPER_ TIME;'
      
        '110243589=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '110243590=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110243591=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '110243592=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN ZAKAZ.G_OF' +
        'FICIAL;'
      
        '110243593=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110243594=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110243595=DECLARE VARIABLE IS_FIRST_TIME_ INTEGER = 0; /* '#1054#1041#1056#1040#1041#1040 +
        #1058#1067#1042#1040#1045#1058#1057#1071' '#1055#1045#1056#1042#1040#1071' '#1057#1058#1056#1054#1050#1040' 0, '#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1057#1058#1056#1054#1050#1048' = 1 */'
      '110243596=BEGIN'
      '110243597=  PNT_ = '#39#39'00'#39#39';'
      '110243598=  IF (IS_LOAD_ = 0) THEN BEGIN'
      '110243599=      SELECT 1'
      '110243600=        FROM G_PRODUCT G'
      '110243601=       WHERE G.G_PRODUCT = :G_PRODUCT'
      '110243602=       INTO :G_PRODUCT_;'
      '110243603='
      '110243604=      IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '110243605=        ERR_CODE = -20500;'
      
        '110243606=        ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072': '#1090#1086#1074#1072#1088' '#1089' '#1080#1076#1077#1085#1090#1080#1092#1080#1082#1072#1090#1086#1088#1086#1084' '#39 +
        #39'||G_PRODUCT||'#39#39' '#1086#1090#1089#1091#1090#1089#1090#1074#1091#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'.'#39#39';'
      '110243607=        Exit;'
      '110243608=      END'
      '110243609='
      
        '110243610=      INSERT INTO UPLOAD_TABLE_TMP (UPLOAD_TABLE_TMP, ' +
        'MODE, PARENT, DATE_OPER, TIME_OPER, G_CLIENT, G_PAYMENT_TYPE,'
      
        '110243611=                                    SUMM_ALL, SUMM_FAC' +
        'T_ALL, SUMM_PAY_BONUS, SUMM_BONUS_GOT, OSNOVANIE, NOTE, G_OFFICI' +
        'AL, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110243612=                                    DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RESERVE, P' +
        'AYMENTS)'
      
        '110243613=      VALUES (:UPLOAD_TABLE_TMP, :MODE, :PARENT, :DATE' +
        '_OPER, :TIME_OPER, DECODE(:G_CLIENT, 0, NULL, :G_CLIENT), :G_PAY' +
        'MENT_TYPE,'
      
        '110243614=              :SUMM_ALL, :SUMM_FACT_ALL, :SUMM_PAY_BON' +
        'US, :SUMM_BONUS_GOT, :OSNOVANIE, :NOTE, :G_OFFICIAL, :G_PRODUCT,' +
        ' :AMOUNT, :PRICE, :SUMM, :DISCOUNT_PERC,'
      
        '110243615=              :DISCOUNT_TENGE, :DISCOUNT_SUMM, :NDS, :' +
        'NDS_SUMM, :COST_PRICE, :BY_RECIPE, :IS_RESERVE, :PAYMENTS);'
      '110243616='
      '110243617=  END ELSE BEGIN'
      '110243618=      PNT_ = '#39#39'01'#39#39';'
      '110243619=      IF (G_TOCHKA_ IS NULL) THEN'
      '110243620=        SELECT ID'
      '110243621=          FROM CUR_PARAMS'
      '110243622=         WHERE CUR_PARAMS = 2'
      '110243623=          INTO :G_TOCHKA_;'
      '110243624='
      
        '110243625=      FOR SELECT MODE, PARENT, DATE_OPER, TIME_OPER, G' +
        '_CLIENT, G_PAYMENT_TYPE, SUMM_ALL, SUMM_FACT_ALL, SUMM_PAY_BONUS' +
        ', SUMM_BONUS_GOT, OSNOVANIE,'
      
        '110243626=                 NOTE, G_OFFICIAL, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      
        '110243627=                 NDS_SUMM, COST_PRICE, BY_RECIPE, IS_R' +
        'ESERVE, PAYMENTS'
      '110243628=          FROM UPLOAD_TABLE_TMP'
      
        '110243629=          WHERE MODE <> 6        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056 +
        #1040' '#1041#1059#1044#1059' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1054#1058#1044#1045#1051#1068#1053#1054', '#1058#1040#1052' '#1044#1056#1059#1043#1054#1049' '#1055#1056#1048#1053#1062#1048#1055
      '110243630=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110243631=          INTO :MODE_, :PARENT_, :DATE_OPER_, :TIME_OP' +
        'ER_, :G_CLIENT_, :G_PAYMENT_TYPE_, :SUMM_ALL_, :SUMM_FACT_ALL_, ' +
        ' :SUMM_PAY_BONUS_, :SUMM_BONUS_GOT_,'
      
        '110243632=               :OSNOVANIE_, :NOTE_, :G_OFFICIAL_, :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_PERC_, :DISCOUNT_T' +
        'ENGE_,'
      
        '110243633=               :DISCOUNT_SUMM_, :NDS_, :NDS_SUMM_, :CO' +
        'ST_PRICE_, :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_'
      '110243634=      DO BEGIN'
      '110243635=          -- '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110243636=          PNT_ = '#39#39'02'#39#39';'
      
        '110243637=          IF (PARENT_ <> PARENT_OLD_ AND IS_FIRST_TIME' +
        '_ = 1) THEN BEGIN'
      '110243638=            IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '110243639=              PNT_ = '#39#39'02a'#39#39';'
      '110243640=              EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110243641=                                          :DATE_OPER__' +
        ','
      
        '110243642=                                          :TIME_OPER__' +
        ','
      '110243643=                                          :G_CLIENT__,'
      
        '110243644=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110243645=                                          :OSNOVANIE__' +
        ','
      '110243646=                                          :NOTE__,'
      
        '110243647=                                          DECODE(:MODE' +
        '_OLD_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '110243648=                                          :SUMM__,'
      
        '110243649=                                          :SUMM_FACT__' +
        ','
      
        '110243650=                                          0, --:G_PRIH' +
        'OD_,'
      
        '110243651=                                          0 --:SUMM_PR' +
        'IHOD_)'
      
        '110243652=                                          ,:PAYMENTS__' +
        '  -- PAYMENTS'
      
        '110243653=                                         )RETURNING_VA' +
        'LUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110243654=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110243655=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090 +
        #1086#1074#1072#1088#1072' (01).'#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG)' +
        ' + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '110243656=                EXIT;'
      '110243657=              END'
      '110243658=            END'
      '110243659=            ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '110243660=              PNT_ = '#39#39'03'#39#39';'
      '110243661=              EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110243662=                                          :DATE_OPER__' +
        ','
      
        '110243663=                                          :TIME_OPER__' +
        ','
      '110243664=                                          :G_CLIENT__,'
      
        '110243665=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110243666=                                          :OSNOVANIE__' +
        ','
      
        '110243667=                                          DECODE(MODE_' +
        'OLD_,'
      
        '110243668=                                                 2, 0,' +
        '   -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '110243669=                                                 3, 1,' +
        '   -- '#1057#1055#1048#1057#1040#1053#1048#1045
      
        '110243670=                                                 5, 3)' +
        ',  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110243671=                                          :NOTE__,'
      '110243672=                                          :SUMM__,'
      
        '110243673=                                          :SUMM_FACT__' +
        ','
      
        '110243674=                                          :SUMM_CASH__' +
        ','
      
        '110243675=                                          :SUMM_NONCAS' +
        'H__,'
      
        '110243676=                                          :SUMM_PAY_BO' +
        'NUS__,'
      
        '110243677=                                          :SUMM_BONUS_' +
        'GOT__,'
      
        '110243678=                                          NULL,       ' +
        ' --:G_PRIHOD_,'
      
        '110243679=                                          NULL,       ' +
        ' --:SUMM_PRIHOD_'
      
        '110243680=                                          :BY_RECIPE__' +
        ','
      
        '110243681=                                          :IS_RESERVE_' +
        '_'
      '110243682=                                          ,:PAYMENTS__'
      '110243683=                                          )'
      
        '110243684=                                          RETURNING_VA' +
        'LUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110243685=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110243686=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077 +
        ' (02). '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3' +
        ' FOR CHAR_LENGTH(ERR_MSG));'
      '110243687=                EXIT;'
      '110243688=              END'
      '110243689='
      '110243690=              PNT_ = '#39#39'03a'#39#39';'
      '110243691=              UPDATE ZAKAZ Z'
      
        '110243692=              SET Z.G_OFFICIAL = DECODE(:G_OFFICIAL__,' +
        ' 0, NULL, NULL, NULL)'
      '110243693=              WHERE Z.ZAKAZ = :ZAKAZ_;'
      '110243694=            END'
      '110243695=          END'
      
        '110243696=          -- '#1050#1054#1053#1045#1062' '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055 +
        #1056#1048#1061#1054#1044#1040
      
        '110243697=          -- '#1053#1040#1063#1040#1051#1054' '#1042#1057#1058#1040#1042#1050#1048' '#1044#1045#1058#1040#1051#1045#1049' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1059' '#1048#1051#1048' '#1047#1040#1050 +
        #1040#1047#1059' '#1058#1054#1042#1040#1056#1040
      '110243698='
      '110243699=          PNT_ = '#39#39'03b'#39#39';'
      '110243700=          IF (MODE_ IN (0,1,4)) THEN'
      
        '110243701=              INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT,' +
        ' AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110243702=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_);'
      '110243703='
      '110243704=          ELSE IF (MODE_ IN (2,3,5)) THEN BEGIN'
      '110243705=              PNT_ = '#39#39'04'#39#39';'
      '110243706=              SELECT S.S_VALUE'
      '110243707=              FROM SYSTEM_SETUP S'
      '110243708=              WHERE S.SYSTEM_SETUP = 2'
      '110243709=              INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110243710='
      
        '110243711=              EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(' +
        ':G_PRODUCT_,'
      
        '110243712=                                                      ' +
        ':AMOUNT_,'
      
        '110243713=                                                      ' +
        ':PRICE_,'
      
        '110243714=                                                      ' +
        ':SUMM_,'
      
        '110243715=                                                      ' +
        ':DISCOUNT_PERC_,'
      
        '110243716=                                                      ' +
        ':DISCOUNT_TENGE_,'
      
        '110243717=                                                      ' +
        ':DISCOUNT_SUMM_,'
      
        '110243718=                                                      ' +
        ':NDS_,'
      
        '110243719=                                                      ' +
        ':NDS_SUMM_,'
      
        '110243720=                                                      ' +
        ':COST_PRICE_,'
      
        '110243721=                                                      ' +
        ':ALLOW_SELL_ABSENT_GOODS_,'
      
        '110243722=                                                      ' +
        '0,     --IS_SPISANIE_'
      
        '110243723=                                                      ' +
        '1,     -- NEW_LINE_SALE_'
      
        '110243724=                                                      ' +
        '0     --MODE_'
      
        '110243725=                                                      ' +
        ') RETURNING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '110243726=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110243727=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077 +
        ' (03). '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3' +
        ' FOR CHAR_LENGTH(ERR_MSG));'
      '110243728=                EXIT;'
      '110243729=              END'
      '110243730=          END'
      '110243731='
      '110243732=          PARENT_OLD_ = PARENT_;'
      '110243733=          DATE_OPER__ = DATE_OPER_;'
      '110243734=          TIME_OPER__ = TIME_OPER_;'
      '110243735=          G_CLIENT__  = G_CLIENT_;'
      '110243736=          G_PAYMENT_TYPE__ = G_PAYMENT_TYPE_;'
      '110243737=          OSNOVANIE__      = OSNOVANIE_;'
      '110243738=          NOTE__           = NOTE_;'
      '110243739=          SUMM__           = SUMM_ALL_;'
      '110243740=          SUMM_FACT__      = SUMM_FACT_ALL_;'
      '110243741=          SUMM_PAY_BONUS__ = SUMM_PAY_BONUS_;'
      '110243742=          SUMM_BONUS_GOT__ = SUMM_BONUS_GOT_;'
      '110243743=          G_OFFICIAL__     = G_OFFICIAL_;'
      '110243744=          BY_RECIPE__      = BY_RECIPE_;'
      '110243745=          IS_RESERVE__     = COALESCE(IS_RESERVE_, 0);'
      '110243746=          IS_FIRST_TIME_   = 1;'
      '110243747=          PAYMENTS__       = PAYMENTS_;'
      '110243748=          MODE_OLD_        = MODE_;'
      '110243749=      END'
      '110243750='
      
        '110243751=      -- '#1055#1054#1057#1051#1045' '#1054#1050#1054#1053#1063#1040#1053#1048#1071' '#1055#1056#1054#1061#1054#1044#1040' '#1055#1054' '#1042#1057#1045#1052' '#1047#1040#1055#1048#1057#1071#1052' '#1053#1045#1054#1041#1061 +
        #1054#1044#1048#1052#1054' '#1055#1056#1054#1042#1045#1057#1058#1048' '#1042#1057#1058#1040#1042#1050#1059' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110243752=      IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '110243753=          PNT_ = '#39#39'05'#39#39';'
      '110243754=          EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110243755=                                      :DATE_OPER__,'
      '110243756=                                      :TIME_OPER__,'
      '110243757=                                      :G_CLIENT__,'
      
        '110243758=                                      :G_PAYMENT_TYPE_' +
        '_,'
      '110243759=                                      :OSNOVANIE__,'
      '110243760=                                      :NOTE__,'
      
        '110243761=                                      DECODE(:MODE_OLD' +
        '_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '110243762=                                      :SUMM__,'
      '110243763=                                      :SUMM_FACT__,'
      '110243764=                                      0, --:G_PRIHOD_,'
      
        '110243765=                                      0 --:SUMM_PRIHOD' +
        '_)'
      '110243766=                                     ,:PAYMENTS__'
      
        '110243767=                                     )RETURNING_VALUES' +
        ' :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110243768=          IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110243769=            ERR_MSG  =  '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072 +
        #1088#1072' (04).'#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + ' +
        '3 FOR CHAR_LENGTH(ERR_MSG));'
      '110243770=            EXIT;'
      '110243771=          END'
      '110243772=      END'
      '110243773=      ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '110243774=          PNT_ = '#39#39'06'#39#39';'
      '110243775=          EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110243776=                                      :DATE_OPER__,'
      '110243777=                                      :TIME_OPER__,'
      '110243778=                                      :G_CLIENT__,'
      
        '110243779=                                      :G_PAYMENT_TYPE_' +
        '_,'
      '110243780=                                      :OSNOVANIE__,'
      
        '110243781=                                      DECODE(MODE_OLD_' +
        ', 2, 0, 3, 1),  --:IS_SPISANIE_,'
      '110243782=                                      :NOTE__,'
      '110243783=                                      :SUMM__,'
      '110243784=                                      :SUMM_FACT__,'
      '110243785=                                      :SUMM_CASH__,'
      '110243786=                                      :SUMM_NONCASH__,'
      
        '110243787=                                      :SUMM_PAY_BONUS_' +
        '_,'
      
        '110243788=                                      :SUMM_BONUS_GOT_' +
        '_,'
      
        '110243789=                                      NULL,        --:' +
        'G_PRIHOD_,'
      
        '110243790=                                      NULL,        --:' +
        'SUMM_PRIHOD_'
      '110243791=                                      :BY_RECIPE__,'
      '110243792=                                      :IS_RESERVE__'
      '110243793=                                      ,:PAYMENTS__'
      '110243794=                                      )'
      
        '110243795=                                      RETURNING_VALUES' +
        ' :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110243796=          IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110243797=            ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' (05' +
        '). '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3 FOR' +
        ' CHAR_LENGTH(ERR_MSG));'
      '110243798=            EXIT;'
      '110243799=          END'
      '110243800='
      '110243801=          UPDATE ZAKAZ Z'
      
        '110243802=          SET Z.G_OFFICIAL = DECODE(:G_OFFICIAL__, 0, ' +
        'NULL, NULL, NULL)'
      '110243803=          WHERE Z.ZAKAZ = :ZAKAZ_;'
      '110243804=      END'
      '110243805='
      '110243806=      -- '#1058#1045#1055#1045#1056#1068' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1070#1058' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110243807=      FOR SELECT DATE_OPER, NOTE, G_PRODUCT, AMOUNT'
      '110243808=          FROM UPLOAD_TABLE_TMP'
      '110243809=          WHERE MODE = 6'
      '110243810=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110243811=          INTO :DATE_OPER_, :NOTE_, :G_PRODUCT_, :AMOU' +
        'NT_'
      '110243812=      DO BEGIN'
      '110243813=        EXECUTE PROCEDURE DO_PRODUCT(:G_TOCHKA_,'
      '110243814=                                   :DATE_OPER_,'
      '110243815=                                   :G_PRODUCT_,'
      '110243816=                                   :AMOUNT_,'
      '110243817=                                   :NOTE_)'
      
        '110243818=                                   RETURNING_VALUES :S' +
        'KLAD_, :ERR_CODE, :ERR_MSG;'
      '110243819=      END'
      '110243820='
      
        '110243821=      DELETE FROM UPLOAD_TABLE_TMP WHERE UPLOAD_TABLE_' +
        'TMP = UPLOAD_TABLE_TMP;'
      '110243822=  END'
      '110243823='
      '110243824=WHEN ANY DO BEGIN'
      '110243825=    Err_code = -20500;'
      
        '110243826=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110243827=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110243828=  END'
      '110243829=end'
      '110243830='#39';'
      '110243831=END   --END_EXECUTE_BLOCK'
      '110250=EXECUTE BLOCK AS BEGIN'
      '110251=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_PRODUCT('
      '110252=  G_PRODUCT_PAR_ INTEGER,'
      '110253=  ARTICUL_ VARCHAR(30),'
      '110254=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110255=  BARCODE_ VARCHAR(30),'
      '110256=  NAME_ VARCHAR(500),'
      '110257=  G_UNIT_ INTEGER,'
      '110258=  PRICE_ NUMERIC(15,2),'
      '110259=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1102510=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1102511=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1102512=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102513=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102514=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1102515=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1102516=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102517=  IS_CATEGORY_ INTEGER)'
      '1102518=RETURNS ('
      '1102519=  G_PRODUCT_ INTEGER,'
      '1102520=  ERR_CODE INTEGER,'
      '1102521=  ERR_MSG VARCHAR(1024))'
      '1102522=AS'
      
        '1102523=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'G_INS_G_PRODUC' +
        'T'#39#39';'
      '1102524=DECLARE VARIABLE CNT_ INTEGER;'
      '1102525=DECLARE VARIABLE N INTEGER;'
      '1102526=DECLARE VARIABLE N_CURR_ INTEGER;'
      
        '1102527=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUMN' +
        ' LT_SKLAD_PRODUCT.AMOUNT;'
      '1102528=begin'
      
        '1102529=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053 +
        #1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1102530=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1102531=        SELECT COUNT(*)'
      '1102532=          FROM G_PRODUCT G'
      '1102533=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '1102534=           AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '1102535=          INTO :CNT_;'
      '1102536='
      '1102537=        IF (CNT_ > 0) THEN BEGIN'
      '1102538=          ERR_CODE = -20500;'
      
        '1102539=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39'||ARTICUL_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '1102540=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1102541=          EXIT;'
      '1102542=        END'
      '1102543=    end'
      '1102544='
      '1102545=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '1102546=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then b' +
        'egin'
      '1102547=        SELECT COUNT(*)'
      '1102548=          FROM G_PRODUCT G'
      
        '1102549=         WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NO' +
        'MENCLATUR_NUM_))'
      '1102550=           AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39#39#39
      '1102551=        INTO :CNT_;'
      '1102552=        IF (CNT_ > 0) THEN BEGIN'
      '1102553=          ERR_CODE = -20500;'
      
        '1102554=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||NOMENCLATUR_NUM_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39')' +
        ' RETURNING_VALUES (:ERR_MSG);'
      '1102555=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1102556=          EXIT;'
      '1102557=        END'
      '1102558=    end'
      '1102559='
      '1102560=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1102561=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1102562=        SELECT COUNT(*)'
      '1102563=          FROM G_PRODUCT G'
      '1102564=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_))'
      '1102565=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '1102566=          INTO :CNT_;'
      '1102567='
      '1102568=        IF (CNT_ = 0) then'
      '1102569=          SELECT COUNT(*)'
      '1102570=            FROM G_PRODUCT G, LT_BARCODE L'
      '1102571=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1102572=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1102573=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '1102574=            INTO :CNT_;'
      '1102575='
      '1102576=        IF (CNT_ > 0) THEN BEGIN'
      '1102577=          ERR_CODE = -20500;'
      
        '1102578=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086#1074#1072 +
        #1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39#39'||:BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1102579=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1102580=          EXIT;'
      '1102581=        END'
      '1102582=    end'
      '1102583='
      
        '1102584=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ART' +
        'ICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PRIC' +
        'E,'
      
        '1102585=                           IS_CATEGORY, PACK_AMOUNT, MF_' +
        'COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE)'
      
        '1102586=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_, :' +
        'ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRICE' +
        '_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1102587=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROSSC' +
        'ODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_)'
      '1102588=    RETURNING G_PRODUCT'
      '1102589=    INTO :G_PRODUCT_;'
      '1102590='
      '1102591=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1102592=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1102593=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, ' +
        'G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1102594=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PRO' +
        'DUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1102595='
      '1102596=        INSERT INTO LT_BARCODE'
      
        '1102597=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT_' +
        'BARCODE_TMP;'
      '1102598='
      
        '1102599=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103 +
        #1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '11025100=        INSERT into G_PRODUCT_IMAGE'
      
        '11025101=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYPE' +
        ' from G_PRODUCT_IMAGE_TMP;'
      '11025102='
      
        '11025103=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089#1090 +
        #1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '11025104=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091#1082 +
        #1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '11025105=        IF (is_kit_ > 0) THEN begin'
      '11025106=            INSERT INTO G_PRODUCT_KIT'
      
        '11025107=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP;'
      '11025108='
      '11025109=            if (is_kit_ = 1) then begin'
      
        '11025110=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE' +
        ')/K.amount)'
      '11025111=                  FROM G_PRODUCT_KIT K,'
      '11025112=                       LT_SKLAD_PRODUCT L'
      '11025113=                 WHERE K.g_product = :G_PRODUCT_'
      '11025114=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11025115=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11025116=                 GROUP BY K.G_PRODUCT'
      '11025117=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11025118='
      '11025119=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11025120=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_S' +
        'OSTAV_AMOUNT_, 0)'
      '11025121=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11025122=            end'
      '11025123=        END'
      '11025124=    END'
      '11025125=end'
      '11025126='#39';'
      '11025127=END --END_EXECUTE_BLOCK;'
      '110260=EXECUTE BLOCK AS BEGIN'
      
        '110261=EXECUTE STATEMENT '#39'CREATE OR ALTER PROCEDURE P_REP_INVOIC' +
        'E_PAY_TMP('
      '110262=  CURRENCY_ INTEGER,'
      
        '110263=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ INTEGE' +
        'R,'
      
        '110264=  AGREEMENT_IN_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARC' +
        'HAR(150),'
      '110265=  SUMM_IN_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      '110266=  AMOUNT_IN_ INTEGER,'
      
        '110267=  NDS_SUMM_IN_ /* TYPE OF COLUMN ZAKAZ_DETAILS.NDS_SUMM *' +
        '/ NUMERIC(15,2),'
      '110268=  DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE)'
      '110269=RETURNS ('
      '1102610=  NUM_ VARCHAR(500),'
      '1102611=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '1102612=  POSTAVSHIK_IDN_ VARCHAR(20),'
      '1102613=  POSTAVSHIK_IDN_SELF_ VARCHAR(20),'
      '1102614=  POSTAVSHIK_KPP_ VARCHAR(20),'
      '1102615=  ACCOUNT_ VARCHAR(50),'
      '1102616=  KBE_ VARCHAR(50),'
      '1102617=  BANK_ VARCHAR(1000),'
      '1102618=  BIK_ VARCHAR(20),'
      '1102619=  KNP_ VARCHAR(20),'
      '1102620=  POSTAVSHIK_ VARCHAR(1000),'
      '1102621=  POKUPATEL_ VARCHAR(1000),'
      '1102622=  AGREEMENT_ VARCHAR(500),'
      '1102623=  SUMM_ VARCHAR(100),'
      '1102624=  NDS_ VARCHAR(100),'
      '1102625=  VSEGO_NAIM_ VARCHAR(500),'
      '1102626=  VSEGO_K_OPLATE_ VARCHAR(500),'
      '1102627=  ISPOLNITEL_ VARCHAR(500),'
      '1102628=  ISPOLNITEL_APP_ VARCHAR(500),'
      '1102629=  RUKOVODITEL_ VARCHAR(500),'
      '1102630=  RUKOVODITEL_APP_ VARCHAR(500),'
      '1102631=  ROW_NUM VARCHAR(100),'
      '1102632=  ARTICUL VARCHAR(30),'
      '1102633=  NAME VARCHAR(500),'
      '1102634=  AMOUNT VARCHAR(500),'
      '1102635=  SHORT_NAME VARCHAR(1000),'
      '1102636=  PRICE VARCHAR(500),'
      '1102637=  SUMM VARCHAR(500),'
      '1102638=  ERR_CODE INTEGER,'
      '1102639=  ERR_MSG VARCHAR(1024))'
      '1102640=AS'
      '1102641=BEGIN'
      '1102642=  SUSPEND;'
      '1102643=END'
      '1102644='#39';'
      '1102645='
      '1102646=EXECUTE STATEMENT '#39'CREATE PROCEDURE P_REP_KASSIR('
      '1102647=  DATE_BEGIN_ DATE,'
      '1102648=  DATE_END_ DATE,'
      
        '1102649=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTEG' +
        'ER)'
      '1102650=RETURNS ('
      '1102651=  PERIOD_ VARCHAR(40),'
      '1102652=  IN_SUMM_ /* TYPE OF MY_NUMERIC */ NUMERIC(15,2),'
      '1102653=  OUT_SUMM_ /* TYPE OF MY_NUMERIC */ NUMERIC(15,2),'
      '1102654=  ROWCOL INTEGER,'
      '1102655=  Z_DATE VARCHAR(40),'
      
        '1102656=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1102657=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      '1102658=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1102659=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUMER' +
        'IC(15,2),'
      
        '1102660=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(1' +
        '5,2))'
      '1102661=AS'
      '1102662=BEGIN'
      '1102663=  SUSPEND;'
      '1102664=END'
      '1102665='#39';'
      '1102666='
      '1102667='
      '1102668='
      
        '1102669=EXECUTE STATEMENT '#39'CREATE GLOBAL TEMPORARY TABLE P_REP_K' +
        'ASSIR_TABLE ('
      '1102670=    SORT_COL INTEGER NOT NULL,'
      '1102671=    ROW_COL INTEGER,'
      '1102672=    Z_DATE_STR VR_50,'
      '1102673=    Z_DATE DATE,'
      '1102674=    ARTICUL DM_ARTICUL,'
      '1102675=    BARCODE DM_ARTICUL,'
      '1102676=    NAME DM_VARCHAR_250,'
      '1102677=    AMOUNT NUMERIC_NULL,'
      '1102678=    SUMM NUMERIC_NULL)'
      '1102679= ON COMMIT DELETE ROWS;'#39';'
      '1102680='
      '1102681='
      '1102682='
      '1102683=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1102684=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1102685=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102686=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1102687=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102688=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102689=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1102690=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102691=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102692=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102693=  SELF_PRICE_ NUMERIC(15,2),'
      '1102694=  AMOUNT_ NUMERIC(15,2),'
      '1102695=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1102696=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1102697=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102698=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102699=  IS_THIS_LAST_ INTEGER,'
      '11026100=  UPDATE_IF_EXIST_ INTEGER)'
      '11026101=RETURNS ('
      '11026102=  ERR_CODE INTEGER,'
      '11026103=  ERR_MSG VARCHAR(1024))'
      '11026104=AS'
      
        '11026105=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'G_IMPORT_G_PR' +
        'ODUCT'#39#39';'
      '11026106=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11026107=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '11026108=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11026109=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11026110=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11026111=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11026112=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      '11026113=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11026114=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11026115=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11026116=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11026117=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11026118=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11026119=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11026120=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11026121=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11026122=BEGIN'
      '11026123=    ERR_MSG = '#39#39#39#39';'
      '11026124='
      '11026125=    SELECT ID'
      '11026126=      FROM CUR_PARAMS'
      '11026127=    WHERE CUR_PARAMS = 2'
      '11026128=      INTO :G_TOCHKA_;'
      '11026129='
      '11026130=    SELECT G.G_UNIT'
      '11026131=      FROM G_UNIT G'
      
        '11026132=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11026133=      INTO :G_UNIT_;'
      '11026134=    if (ROW_COUNT = 0) then'
      '11026135=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11026136='
      '11026137=    PNT_ = '#39#39'02'#39#39';'
      
        '11026138=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11026139=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11026140=        SELECT G.G_PRODUCT,'
      '11026141=               G.NAME'
      '11026142=          FROM G_PRODUCT G'
      
        '11026143=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11026144=           AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '11026145=          INTO :G_PRODUCT_,'
      '11026146=               :G_PRODUCT_NAME_;'
      '11026147='
      
        '11026148=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11026149=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11026150=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11026151=              UPDATE G_PRODUCT G'
      '11026152=                 SET G.NAME = :NAME_,'
      '11026153=                     G.G_UNIT = :G_UNIT_,'
      '11026154=                     G.PRICE  = :PRICE_,'
      '11026155=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11026156=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11026157=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11026158=                     G.PLACE = :PLACE_,'
      
        '11026159=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11026160=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11026161=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11026162=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11026163='
      
        '11026164=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '11026165=            END ELSE'
      
        '11026166=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11026167=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODUCT_N' +
        'AME_||'#39#39'.'#39#39';'
      '11026168=        END'
      '11026169=    END ELSE'
      
        '11026170=      EXECUTE PROCEDURE get_free_articul RETURNING_VALU' +
        'ES (:ARTICUL_);'
      '11026171='
      
        '11026172=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052',' +
        ' '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11026173=    PNT_ = '#39#39'02a'#39#39';'
      
        '11026174=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11026175=        SELECT G.G_PRODUCT,'
      '11026176=               G.NAME'
      '11026177=          FROM G_PRODUCT G'
      
        '11026178=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_NU' +
        'M_)'
      '11026179=           AND TRIM(G.nomenclatur_num) <> '#39#39#39#39
      '11026180=          INTO :G_PRODUCT_,'
      '11026181=               :G_PRODUCT_NAME_;'
      '11026182='
      
        '11026183=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11026184=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11026185=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11026186=              UPDATE G_PRODUCT G'
      '11026187=                 SET G.NAME = :NAME_,'
      '11026188=                     G.G_UNIT = :G_UNIT_,'
      '11026189=                     G.PRICE  = :PRICE_,'
      '11026190=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11026191=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11026192=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11026193=                     G.PLACE = :PLACE_,'
      
        '11026194=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11026195=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11026196=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11026197=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11026198='
      
        '11026199=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.' +
        #39#39';'
      '11026200=            END ELSE'
      
        '11026201=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11026202=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' ' +
        '- '#39#39'||G_PRODUCT_NAME_||'#39#39'.'#39#39';'
      '11026203=        END'
      '11026204=    end'
      '11026205='
      
        '11026206=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11026207=    PNT_ = '#39#39'02b'#39#39';'
      
        '11026208=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11026209=        SELECT G.G_PRODUCT,'
      '11026210=               G.NAME'
      '11026211=          FROM G_PRODUCT G'
      '11026212=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11026213=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '11026214=          INTO :G_PRODUCT_,'
      '11026215=               :G_PRODUCT_NAME_;'
      '11026216='
      '11026217=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11026218=          SELECT G.G_PRODUCT,'
      '11026219=                 G.NAME'
      '11026220=            FROM G_PRODUCT G, LT_BARCODE L'
      '11026221=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11026222=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11026223=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '11026224=            INTO :G_PRODUCT_,'
      '11026225=                 :G_PRODUCT_NAME_;'
      '11026226='
      
        '11026227=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11026228=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11026229=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11026230=              UPDATE G_PRODUCT G'
      '11026231=                 SET G.NAME = :NAME_,'
      '11026232=                     G.G_UNIT = :G_UNIT_,'
      '11026233=                     G.PRICE  = :PRICE_,'
      '11026234=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11026235=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11026236=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11026237=                     G.PLACE = :PLACE_,'
      
        '11026238=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11026239=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11026240=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11026241=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11026242='
      
        '11026243=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        #39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '11026244=            END ELSE'
      
        '11026245=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11026246=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODUC' +
        'T_NAME_||'#39#39'.'#39#39';'
      '11026247=        END'
      '11026248=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN'
      
        '11026249=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RETU' +
        'RNING_VALUES (:BARCODE_);'
      '11026250='
      '11026251=    PNT_ = '#39#39'02b'#39#39';'
      '11026252=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '11026253=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR' +
        ', ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME' +
        '_PRICE,'
      
        '11026254=                               IS_CATEGORY, PACK_AMOUNT' +
        ', MF_COUNTRY, NOTE, PLACE)'
      
        '11026255=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PA' +
        'R_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :' +
        'PRICE_,'
      
        '11026256=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_C' +
        'OUNTRY_, :NOTE_, :PLACE_)'
      '11026257=        returning G_PRODUCT'
      '11026258=        into :G_PRODUCT_;'
      '11026259='
      
        '11026260=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11026261=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, 0, :G_TOCHKA_);'
      '11026262=    end'
      '11026263='
      
        '11026264=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045#1051 +
        #1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11026265=    PNT_ = '#39#39'03'#39#39';'
      '11026266=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '11026267=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '11026268=                                       :AMOUNT_,'
      '11026269=                                       :SELF_PRICE_,'
      
        '11026270=                                       :AMOUNT_ * :SELF' +
        '_PRICE_,'
      '11026271=                                       0, --nds_,'
      '11026272=                                       0 --nds_summ_,'
      
        '11026273=                                       ) RETURNING_VALU' +
        'ES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '11026274=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11026275=          ERR_MSG  = '#39#39' PNT_ '#39#39'||PNT_||'#39#39' -> '#39#39'||ERR_MS' +
        'G;'
      '11026276=          EXIT;'
      '11026277=        END'
      '11026278=    END'
      '11026279='
      
        '11026280=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' ' +
        #1047#1040#1055#1048#1057#1068
      '11026281=    PNT_ = '#39#39'04'#39#39';'
      '11026282=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '11026283=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061#1054 +
        #1044
      '11026284=        FROM SKLAD_TMP T'
      '11026285=        INTO :CNT_;'
      '11026286='
      '11026287=      if (CNT_ > 0) then BEGIN'
      '11026288=        SELECT SUM(T.SUMM)'
      '11026289=          FROM SKLAD_TMP T'
      '11026290=          INTO :SUMM_;'
      '11026291='
      '11026292=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '11026293=                                DATE_RECEIPT,'
      '11026294=                                TIME_RECEIPT,'
      '11026295=                                G_CLIENT,'
      '11026296=                                G_PAYMENT_TYPE,'
      '11026297=                                OSNOVANIE,'
      '11026298=                                NOTE,'
      '11026299=                                SUMM,'
      '11026300=                                SUMM_FACT,'
      '11026301=                                IS_PAYED_ALL,'
      '11026302=                                IS_VOZVRAT,'
      '11026303=                                G_TOCHKA)'
      '11026304=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11026305=                CURRENT_DATE,'
      '11026306=                CURRENT_TIME,'
      '11026307=                :G_CLIENT_,'
      '11026308=                1,'
      '11026309=                NULL,  --:OSNOVANIE_,'
      '11026310=                NULL,  -- :NOTE_,'
      '11026311=                :SUMM_,'
      '11026312=                :SUMM_,'
      
        '11026313=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040 +
        ' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11026314=                0,'
      '11026315=                :G_TOCHKA_)'
      '11026316=        RETURNING'
      '11026317=          SKLAD'
      '11026318=        INTO'
      '11026319=          :SKLAD_PARENT_;'
      '11026320='
      '11026321=        PNT_ = '#39#39'05'#39#39';'
      '11026322=        FOR SELECT SKLAD,'
      '11026323=                   G_PRODUCT,'
      '11026324=                   AMOUNT,'
      '11026325=                   PRICE,'
      '11026326=                   SUMM'
      '11026327=              FROM SKLAD_TMP'
      '11026328=             ORDER BY 1'
      '11026329=              INTO :SKLAD_TMP_,'
      '11026330=                   :RG_PRODUCT_,'
      '11026331=                   :RAMOUNT_,'
      '11026332=                   :RPRICE_,'
      '11026333=                   :RSUMM_'
      '11026334=        DO BEGIN'
      '11026335='
      '11026336=            UPDATE SKLAD SK'
      '11026337=               SET SK.IS_LAST = 0'
      '11026338=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11026339=               AND SK.IS_LAST = 1;'
      '11026340='
      '11026341=            INSERT INTO SKLAD'
      '11026342=            ('
      '11026343=             SKLAD,'
      '11026344=             SKLAD_PARENT,'
      '11026345=             DATE_RECEIPT,'
      '11026346=             G_CLIENT,'
      '11026347=             G_PRODUCT,'
      '11026348=             AMOUNT,'
      '11026349=             PRICE,'
      '11026350=             SUMM,'
      '11026351=             G_PAYMENT_TYPE,'
      '11026352=             OSNOVANIE,'
      '11026353=             NOTE,'
      '11026354=             NDS,'
      '11026355=             NDS_SUMM,'
      '11026356=             IS_LAST,'
      '11026357=             IS_VOZVRAT,'
      '11026358=             G_TOCHKA'
      '11026359=            ) VALUES ('
      '11026360=             :SKLAD_TMP_,'
      '11026361=             :SKLAD_PARENT_,'
      '11026362=             CURRENT_DATE,'
      '11026363=             :G_CLIENT_,'
      '11026364=             :RG_PRODUCT_,'
      '11026365=             :RAMOUNT_,'
      '11026366=             :RPRICE_,'
      '11026367=             :RSUMM_,'
      '11026368=             1,       --:G_PAYMENT_TYPE_,'
      '11026369=             NULL,    --:OSNOVANIE_,'
      '11026370=             NULL,    --:NOTE_,'
      '11026371=             0,       --:RNDS_,'
      '11026372=             0,       --:RNDS_SUMM_,'
      '11026373=             1,       --IS_LAST_'
      '11026374=             0,        --:IS_VOZVRAT_'
      '11026375=             :G_TOCHKA_'
      '11026376=            );'
      '11026377='
      
        '11026378=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11026379=            PNT_ = '#39#39'06'#39#39';'
      '11026380=            UPDATE LT_SKLAD_PRODUCT L'
      '11026381=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11026382=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11026383=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11026384='
      '11026385=            PNT_ = '#39#39'06a'#39#39';'
      '11026386=            IF (ROW_COUNT = 0) THEN'
      
        '11026387=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11026388=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11026389=        END'
      '11026390='
      '11026391=        PNT_ = '#39#39'07'#39#39';'
      
        '11026392=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_' +
        ' => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11026393=                                2,    --:G_PRIHOD_RASHO' +
        'D_,'
      '11026394=                                :SUMM_,'
      '11026395=                                CURRENT_DATE,'
      
        '11026396=                                NULL,   --NOTE_ => :NOT' +
        'E_,'
      '11026397=                                NULL,   --ZAKAZ_'
      '11026398=                                :SKLAD_PARENT_,'
      '11026399=                                1,'
      
        '11026400=                                :G_TOCHKA_) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11026401=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11026402=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39 +
        #39'||ERR_MSG;'
      '11026403=          EXIT;'
      '11026404=        END'
      '11026405='
      '11026406=        DELETE FROM SKLAD_TMP;'
      '11026407=      END'
      '11026408=    END'
      '11026409='
      
        '11026410=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054#1069 +
        #1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '11026411=    if (ERR_MSG_ IS NOT NULL) then'
      '11026412=      ERR_MSG = ERR_MSG_;'
      '11026413='
      '11026414=WHEN ANY DO BEGIN'
      '11026415=    Err_code = gdscode;'
      
        '11026416=    ERR_MSG = '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39#39'||gdscode||'#39#39 +
        ' --> PNT_ '#39#39'||PNT_;'
      '11026417=  END'
      '11026418=END'
      '11026419='#39';'
      '11026420='
      '11026421=EXECUTE STATEMENT '#39'ALTER PROCEDURE INV_GET_INVOICE_PAY('
      '11026422=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '11026423=  ZAKAZ_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ)'
      '11026424=RETURNS ('
      '11026425=  INIT_DATE_ TYPE OF COLUMN INVOICE_PAY.INIT_DATE,'
      '11026426=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '11026427=  POSTAVSHIK_ TYPE OF COLUMN INVOICE_PAY.POSTAVSHIK,'
      '11026428=  IDN_ TYPE OF COLUMN INVOICE_PAY.IDN,'
      '11026429=  ADDRESS_ TYPE OF COLUMN INVOICE_PAY.ADDRESS,'
      '11026430=  IIK_ TYPE OF COLUMN INVOICE_PAY.IIK,'
      '11026431=  BANK_NAME_ TYPE OF COLUMN INVOICE_PAY.BANK_NAME,'
      '11026432=  BIK_ TYPE OF COLUMN INVOICE_PAY.BIK,'
      '11026433=  KBE_ TYPE OF COLUMN INVOICE_PAY.KBE,'
      '11026434=  KNP_ TYPE OF COLUMN INVOICE_PAY.KNP,'
      '11026435=  G_CLIENT_ID_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11026436=  G_CLIENT_ TYPE OF COLUMN INVOICE_PAY.G_CLIENT,'
      '11026437=  IDN_CLIENT_ TYPE OF COLUMN INVOICE_PAY.IDN_CLIENT,'
      
        '11026438=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE_PAY.ADDRESS' +
        '_POKUPATEL,'
      '11026439=  AGREEMENT_ TYPE OF COLUMN INVOICE_PAY.AGREEMENT,'
      '11026440=  G_OFFICIAL_ TYPE OF COLUMN INVOICE_PAY.G_OFFICIAL,'
      '11026441=  NUM_ TYPE OF COLUMN INVOICE_PAY.NUM,'
      '11026442=  ZAKAZ_SAVED_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ,'
      '11026443=  ERR_CODE INTEGER,'
      '11026444=  ERR_MSG VARCHAR(1024))'
      '11026445=AS'
      
        '11026446=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INV_GET_INVO' +
        'ICE_PAY'#39#39';'
      '11026447=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11026448=BEGIN'
      '11026449=  SELECT'
      '11026450=    t.INIT_DATE,'
      '11026451=    T.G_FIRM,'
      '11026452=    t.POSTAVSHIK,'
      '11026453=    t.IDN,'
      '11026454=    t.ADDRESS,'
      '11026455=    t.IIK,'
      '11026456=    t.BANK_NAME,'
      '11026457=    t.BIK,'
      '11026458=    t.KBE,'
      '11026459=    t.KNP,'
      '11026460=    t.G_CLIENT,'
      '11026461=    t.IDN_CLIENT,'
      '11026462=    t.ADDRESS_POKUPATEL,'
      '11026463=    t.AGREEMENT,'
      '11026464=    t.G_OFFICIAL,'
      '11026465=    t.ZAKAZ,'
      '11026466=    t.NUM,'
      '11026467=    G.g_client'
      
        '11026468=  FROM invoice_pay t LEFT OUTER JOIN g_address G ON T.a' +
        'ddress_pokupatel = G.g_address'
      '11026469=  WHERE t.invoice_pay = :invoice_pay_'
      '11026470=  INTO'
      '11026471=    INIT_DATE_,'
      '11026472=    G_FIRM_,'
      '11026473=    POSTAVSHIK_,'
      '11026474=    IDN_,'
      '11026475=    ADDRESS_,'
      '11026476=    IIK_,'
      '11026477=    BANK_NAME_,'
      '11026478=    BIK_,'
      '11026479=    KBE_,'
      '11026480=    KNP_,'
      '11026481=    G_CLIENT_,'
      '11026482=    IDN_CLIENT_,'
      '11026483=    ADDRESS_POKUPATEL_,'
      '11026484=    AGREEMENT_,'
      '11026485=    G_OFFICIAL_,'
      '11026486=    ZAKAZ_SAVED_,'
      '11026487=    NUM_,'
      '11026488=    G_CLIENT_ID_;'
      '11026489='
      '11026490=  IF (ROW_COUNT = 0) then BEGIN'
      
        '11026491=    --*************************************************' +
        '*'
      
        '11026492=    -- '#1047#1053#1040#1063#1048#1058' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1040' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055 +
        #1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '11026493=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '11026494=    SELECT'
      '11026495=      G.g_firm_rekvizit,'
      '11026496=      G.NAME,'
      '11026497=      G.IDN,'
      '11026498=      AD.G_ADDRESS,'
      '11026499=      AC.G_ACCOUNT,'
      '11026500=      AC.NAME,'
      '11026501=      AC.BIK,'
      '11026502=      G.KBE'
      '11026503=    FROM G_FIRM_REKVIZIT g LEFT OUTER JOIN'
      '11026504=         (SELECT A.G_ACCOUNT,'
      '11026505=                 A.ACCOUNT,'
      '11026506=                 A.G_FIRM_REKVIZIT,'
      '11026507=                 A.G_BANK,'
      '11026508=                 B.BIK, B.NAME'
      '11026509=            FROM G_FIRM_ACCOUNT A,'
      '11026510=                 G_BANK B'
      '11026511=           WHERE A.G_BANK = B.G_BANK'
      
        '11026512=             AND A.IS_DEFAULT = 1) AC ON G.G_FIRM_REKVI' +
        'ZIT = AC.G_FIRM_REKVIZIT'
      '11026513=         LEFT OUTER JOIN (SELECT *'
      '11026514=                            FROM G_FIRM_ADDRESS F'
      
        '11026515=                           WHERE F.IS_DEFAULT = 1) AD O' +
        'N G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT'
      '11026516=    WHERE G.IS_DEFAULT = 1'
      '11026517=    INTO'
      '11026518=      :g_firm_,'
      '11026519=      :POSTAVSHIK_,'
      '11026520=      :IDN_,'
      '11026521=      :ADDRESS_,'
      '11026522=      :IIK_,'
      '11026523=      :BANK_NAME_,'
      '11026524=      :BIK_,'
      '11026525=      :KBE_;'
      '11026526='
      '11026527=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '11026528=    SELECT'
      '11026529=      Z.Z_DATE,'
      
        '11026530=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39#39#39')), ' +
        '0, C.NAME, c.name_FULL),'
      '11026531=      C.IDN,'
      '11026532=      C.g_client,'
      '11026533=      C.name,'
      '11026534=      AD.G_ADDRESS,'
      '11026535=      Z.OSNOVANIE'
      '11026536=    FROM ZAKAZ Z,'
      '11026537=         G_CLIENT C LEFT OUTER JOIN'
      '11026538=         (SELECT *'
      '11026539=            FROM G_ADDRESS G'
      
        '11026540=           WHERE G.IS_DEFAULT = 1) AD ON C.G_CLIENT = A' +
        'D.G_CLIENT'
      '11026541=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '11026542=     AND Z.G_CLIENT = C.G_CLIENT'
      '11026543=    INTO'
      '11026544=      :INIT_DATE_,'
      '11026545=      :G_CLIENT_,'
      '11026546=      :IDN_CLIENT_,'
      '11026547=      :G_CLIENT_ID_,'
      '11026548=      :g_client_,'
      '11026549=      :ADDRESS_POKUPATEL_,'
      '11026550=      :AGREEMENT_;'
      '11026551='
      
        '11026552=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054#1041 +
        #1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '11026553=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054' '#1056 +
        #1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '11026554=    PNT_ = '#39#39'05'#39#39';'
      '11026555=    SELECT C.id'
      '11026556=      FROM cur_params C'
      '11026557=     WHERE C.cur_params = 1'
      '11026558=    INTO :G_OFFICIAL_;'
      '11026559='
      '11026560=    IF (ROW_COUNT = 0) then BEGIN'
      '11026561=        SELECT MIN(O.G_OFFICIAL)'
      '11026562=          FROM G_OFFICIAL O'
      '11026563=          INTO :G_OFFICIAL_;'
      '11026564=        IF (ROW_COUNT = 0) then BEGIN'
      '11026565=            Err_Code = -20500;'
      
        '11026566=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1057 +
        #1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '11026567=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11026568=            EXIT;'
      '11026569=        END'
      '11026570=    END'
      '11026571='
      
        '11026572=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059', '#1057#1053#1040#1063#1040#1051#1040' '#1057 +
        #1044#1045#1051#1040#1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '11026573=    --select substring('#39#39'0000000000'#39#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '11026574=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VARC' +
        'HAR(20)) -- NVL '#1055#1054#1057#1058#1040#1042#1048#1051
      '11026575=      FROM INVOICE_PAY P'
      '11026576=    INTO :NUM_;'
      '11026577='
      
        '11026578=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059' '#1042 +
        #1054#1054#1041#1065#1045' '#1053#1045#1058
      '11026579=      NUM_ = '#39#39'1'#39#39';'
      '11026580=  END'
      '11026581=END'
      '11026582='#39';'
      '11026583='
      
        '11026584=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_INVOICE_PAY_TM' +
        'P('
      '11026585=  CURRENCY_ INTEGER,'
      '11026586=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11026587=  AGREEMENT_IN_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11026588=  SUMM_IN_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11026589=  AMOUNT_IN_ INTEGER,'
      '11026590=  NDS_SUMM_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS_SUMM,'
      '11026591=  DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE)'
      '11026592=RETURNS ('
      '11026593=  NUM_ VARCHAR(500),'
      '11026594=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '11026595=  POSTAVSHIK_IDN_ VARCHAR(20),'
      '11026596=  POSTAVSHIK_IDN_SELF_ VARCHAR(20),'
      '11026597=  POSTAVSHIK_KPP_ VARCHAR(20),'
      '11026598=  ACCOUNT_ VARCHAR(50),'
      '11026599=  KBE_ VARCHAR(50),'
      '11026600=  BANK_ VARCHAR(1000),'
      '11026601=  BIK_ VARCHAR(20),'
      '11026602=  KNP_ VARCHAR(20),'
      '11026603=  POSTAVSHIK_ VARCHAR(1000),'
      '11026604=  POKUPATEL_ VARCHAR(1000),'
      '11026605=  AGREEMENT_ VARCHAR(500),'
      '11026606=  SUMM_ VARCHAR(100),'
      '11026607=  NDS_ VARCHAR(100),'
      '11026608=  VSEGO_NAIM_ VARCHAR(500),'
      '11026609=  VSEGO_K_OPLATE_ VARCHAR(500),'
      '11026610=  ISPOLNITEL_ VARCHAR(500),'
      '11026611=  ISPOLNITEL_APP_ VARCHAR(500),'
      '11026612=  RUKOVODITEL_ VARCHAR(500),'
      '11026613=  RUKOVODITEL_APP_ VARCHAR(500),'
      '11026614=  ROW_NUM VARCHAR(100),'
      '11026615=  ARTICUL VARCHAR(30),'
      '11026616=  NAME VARCHAR(500),'
      '11026617=  AMOUNT VARCHAR(500),'
      '11026618=  SHORT_NAME VARCHAR(1000),'
      '11026619=  PRICE VARCHAR(500),'
      '11026620=  SUMM VARCHAR(500),'
      '11026621=  ERR_CODE INTEGER,'
      '11026622=  ERR_MSG VARCHAR(1024))'
      '11026623=AS'
      
        '11026624=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_INVOICE' +
        '_PAY'#39#39';'
      '11026625=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11026626=DECLARE VARIABLE IS_PAY_NDS_ TYPE OF COLUMN G_FIRM_REKV' +
        'IZIT.IS_NDS;'
      
        '11026627=DECLARE VARIABLE NOL_VMESTO_NDS_ TYPE OF COLUMN G_FIRM_' +
        'REKVIZIT.NOL_VMESTO_BEZ;'
      '11026628=DECLARE VARIABLE I INTEGER = 1;'
      '11026629=DECLARE VARIABLE VAL_STR_ VARCHAR(20);'
      '11026630=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      
        '11026631=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'g_official;'
      '11026632=BEGIN'
      '11026633='
      '11026634=  -- '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059
      
        '11026635=  SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VARCHA' +
        'R(20)) -- NVL '#1055#1054#1057#1058#1040#1042#1048#1051
      '11026636=    FROM INVOICE_PAY P'
      '11026637=    INTO :NUM_;'
      
        '11026638=  if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059' '#1042#1054#1054 +
        #1041#1065#1045' '#1053#1045#1058
      '11026639=    NUM_ = '#39#39'1'#39#39';'
      '11026640='
      '11026641=  -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '11026642=  SELECT G.name'
      
        '11026643=         ,DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, '#39#39#1041#1048#1053#39#39')||' +
        #39#39': '#39#39'||G.IDN'
      '11026644=         ,G.IDN'
      '11026645=         ,G.KPP'
      '11026646=         ,AC.ACCOUNT'
      '11026647=         ,G.kbe'
      '11026648=         ,AC.NAME'
      '11026649=         ,AC.BIK'
      '11026650=         ,'#39#39#39#39'        --'#1050#1053#1055
      
        '11026651=         ,DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, '#39#39#1041#1048#1053#39#39')||' +
        #39#39': '#39#39'||G.IDN||'#39#39', '#39#39'||G.name||'#39#39', '#39#39'||COALESCE(AD.ADDRESS, '#39#39#39#39 +
        ')'
      
        '11026652=         ,DECODE(char_length(TRIM(GC.idn)), 0, '#39#39#39#39', '#39#39 +
        #1048#1048#1053'/'#1041#1048#1053': '#39#39'||GC.idn||'#39#39', '#39#39')||GC.name||COALESCE('#39#39', '#39#39'||ADC.ADDR' +
        'ESS, '#39#39#39#39')'
      
        '11026653=         ,COALESCE(TRIM(:AGREEMENT_IN_), '#39#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072 +
        #39#39')'
      '11026654=         ,G.IS_NDS'
      '11026655=         ,G.NOL_VMESTO_BEZ'
      
        '11026656=         ,'#39#39#1057#1095#1077#1090' '#1085#1072' '#1086#1087#1083#1072#1090#1091' '#8470#39#39'||:NUM_||'#39#39' '#1086#1090' '#39#39'||EXTRAC' +
        'T(DAY FROM :DATE_)||'#39#39' '#39#39'||'
      
        '11026657=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(EX' +
        'TRACT(MONTH FROM :DATE_), 1))||'#39#39' '#39#39'||EXTRACT(YEAR FROM :DATE_)|' +
        '|'#39#39' '#1075'.'#39#39
      '11026658=  FROM G_FIRM_REKVIZIT g'
      '11026659=         LEFT OUTER JOIN (SELECT A.G_ACCOUNT,'
      '11026660=                                 A.ACCOUNT,'
      '11026661=                                 A.G_FIRM_REKVIZIT,'
      '11026662=                                 A.G_BANK,'
      '11026663=                                 B.BIK, B.NAME'
      '11026664=                            FROM G_FIRM_ACCOUNT A,'
      '11026665=                                 G_BANK B'
      '11026666=                           WHERE A.G_BANK = B.G_BANK'
      
        '11026667=                             AND A.IS_DEFAULT = 1) AC O' +
        'N G.G_FIRM_REKVIZIT = AC.G_FIRM_REKVIZIT'
      
        '11026668=         LEFT OUTER JOIN (SELECT F.g_firm_rekvizit, F.a' +
        'ddress'
      '11026669=                            FROM G_FIRM_ADDRESS F'
      
        '11026670=                           WHERE F.IS_DEFAULT = 1) AD O' +
        'N G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT,'
      
        '11026671=       G_CLIENT GC LEFT OUTER JOIN (SELECT GGG.g_client' +
        ', GGG.address'
      
        '11026672=                                      FROM G_ADDRESS GG' +
        'G'
      
        '11026673=                                     WHERE GGG.IS_DEFAU' +
        'LT = 1) ADC ON GC.G_CLIENT = ADC.G_CLIENT'
      '11026674=    WHERE G.IS_DEFAULT = 1'
      '11026675=      AND GC.g_client = :G_CLIENT_'
      '11026676=   INTO :POSTAVSHIK_NAME_,'
      '11026677=        :POSTAVSHIK_IDN_,'
      '11026678=        :POSTAVSHIK_IDN_SELF_,'
      '11026679=        :POSTAVSHIK_KPP_,'
      '11026680=        :ACCOUNT_,'
      '11026681=        :KBE_,'
      '11026682=        :BANK_,'
      '11026683=        :BIK_,'
      '11026684=        :KNP_,'
      '11026685=        :POSTAVSHIK_,'
      '11026686=        :POKUPATEL_,'
      '11026687=        :AGREEMENT_,'
      '11026688=        :IS_PAY_NDS_,'
      '11026689=        :NOL_VMESTO_NDS_,'
      '11026690=        :NUM_;'
      '11026691='
      
        '11026692=  --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054#1041#1067' ' +
        #1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      '11026693=  PNT_ = '#39#39'05'#39#39';'
      '11026694=  SELECT C.id'
      '11026695=    FROM cur_params C'
      '11026696=   WHERE C.cur_params = 1'
      '11026697=  INTO :G_OFFICIAL_;'
      '11026698='
      '11026699=  IF (ROW_COUNT = 0) then BEGIN'
      '11026700=      SELECT MIN(O.G_OFFICIAL)'
      '11026701=        FROM G_OFFICIAL O'
      '11026702=        INTO :G_OFFICIAL_;'
      '11026703=      IF (ROW_COUNT = 0) then BEGIN'
      '11026704=          Err_Code = -20500;'
      
        '11026705=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1057#1087#1088 +
        #1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      
        '11026706=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39 +
        #39'||ERR_MSG;'
      '11026707=          EXIT;'
      '11026708=      END'
      '11026709=  END'
      '11026710='
      '11026711=  SELECT '#39#39'/'#39#39'||O.FIO_DOC||'#39#39'/'#39#39','
      '11026712=         A.name'
      '11026713=    FROM G_OFFICIAL O, G_APPOINTMENT A'
      '11026714=   WHERE O.g_official = :G_OFFICIAL_'
      '11026715=     AND O.G_APPOINTMENT = A.G_APPOINTMENT'
      '11026716=    INTO :ISPOLNITEL_'
      '11026717=         ,:ISPOLNITEL_APP_;'
      '11026718='
      '11026719=  SELECT '#39#39'/'#39#39'||G.FIO_DOC||'#39#39'/'#39#39','
      '11026720=         A.NAME'
      '11026721=    FROM G_OFFICIAL G,'
      '11026722=         G_APPOINTMENT A'
      '11026723=    WHERE G.IS_RUKOVODITEL = 1'
      '11026724=    AND G.G_APPOINTMENT = A.G_APPOINTMENT'
      '11026725=  INTO :RUKOVODITEL_,'
      '11026726=       :RUKOVODITEL_APP_;'
      '11026727='
      '11026728=  -- '#1053#1048#1046#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      '11026729=  SELECT CAST(:summ_in_ AS VARCHAR(20)),'
      
        '11026730=         '#39#39#1042#1089#1077#1075#1086' '#1082' '#1086#1087#1083#1072#1090#1077': '#39#39'||(SELECT CURR_STR from CU' +
        'RRENCYSTR(:summ_in_, :CURRENCY_))'
      '11026731=    FROM RDB$DATABASE'
      '11026732=  INTO :SUMM_,'
      '11026733=       :VSEGO_K_OPLATE_;'
      '11026734='
      
        '11026735=  -- '#1042#1054' '#1060#1056#1040#1047#1045' '#1042#1057#1045#1043#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1049' '#1045#1057#1058#1068' '#1042#1040#1051#1070#1058#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1055 +
        #1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1050#1051#1054#1053#1071#1058#1068
      '11026736=  if (CURRENCY_ = 0) then'
      '11026737=    CURR_STR_ = '#39#39' '#1090#1077#1085#1075#1077#39#39';'
      '11026738=  else begin'
      '11026739=      SELECT CAST(TRUNC(:summ_in_) AS VARCHAR(20))'
      '11026740=        FROM RDB$DATABASE'
      '11026741=      INTO :VAL_STR_;'
      '11026742='
      
        '11026743=      i = cast(substring(VAL_STR_ from CHAR_LENGTH(VAL_' +
        'STR_) for 1) as int);'
      '11026744='
      '11026745=      if (i=1) then begin'
      '11026746=        if (CURRENCY_ = 1) then'
      '11026747=          CURR_STR_ = '#39#39' '#1088#1091#1073#1083#1100#39#39';'
      '11026748=        else'
      '11026749=          CURR_STR_ = '#39#39' '#1075#1088#1080#1074#1085#1072#39#39';'
      '11026750='
      '11026751=      end ELSE if ((i=2) or (I=3)) then begin'
      '11026752=        if (CURRENCY_ = 1) then'
      '11026753=          CURR_STR_ = '#39#39' '#1088#1091#1073#1083#1103#39#39';'
      '11026754=        ELSE'
      '11026755=          CURR_STR_ = '#39#39' '#1075#1088#1080#1074#1085#1099#39#39';'
      '11026756=      END ELSE BEGIN'
      '11026757=        if (CURRENCY_ = 1) then'
      '11026758=          CURR_STR_ = '#39#39' '#1088#1091#1073#1083#1077#1081#39#39';'
      '11026759=        ELSE'
      '11026760=          CURR_STR_ = '#39#39' '#1075#1088#1080#1074#1077#1085#39#39';'
      '11026761=      end'
      '11026762=  end'
      '11026763='
      
        '11026764=  SELECT '#39#39#1042#1089#1077#1075#1086' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1081' '#39#39'||:AMOUNT_IN_||'#39#39', '#1085#1072' '#1089 +
        #1091#1084#1084#1091' '#39#39'||CAST(:SUMM_IN_ AS VARCHAR(20))||:CURR_STR_,'
      '11026765=         DECODE(:IS_PAY_NDS_,'
      
        '11026766=                0, DECODE(:NOL_VMESTO_NDS_, 0, '#39#39#1041#1077#1079' '#1053#1044 +
        #1057#39#39', '#39#39'0,00'#39#39'),  -- '#1055#1048#1057#1040#1058#1068' "0" '#1048#1051#1048' "'#1041#1077#1079' '#1053#1044#1057'"'
      '11026767=                CAST(:NDS_SUMM_IN_ AS VARCHAR(20))'
      '11026768=               )'
      '11026769=    FROM RDB$DATABASE'
      '11026770=  INTO :VSEGO_NAIM_,'
      '11026771=       :NDS_;'
      '11026772='
      
        '11026773=  -- '#1042' '#1048#1058#1054#1043#1045' '#1042' '#1045#1050#1057#1045#1051#1045' '#1042#1057#1045' '#1062#1048#1060#1056#1067' '#1042#1067#1042#1054#1044#1071#1058#1057#1071' '#1057' '#1044#1045#1057#1071#1058#1048#1063#1053#1067#1052' ' +
        #1056#1040#1047#1044#1045#1051#1048#1058#1045#1051#1045#1052' '#1058#1054#1063#1050#1040', '#1040' '#1053#1045' '#1047#1040#1055#1071#1058#1040#1071'. '#1053#1045' '#1047#1053#1040#1051' '#1063#1058#1054' '#1055#1056#1048#1044#1059#1052#1040#1058#1068' '#1048' '#1055#1054#1058#1054#1052#1059 +
        ' '#1055#1054#1057#1058#1040#1042#1048#1051' '#1058#1059#1058' '#1058#1059#1055#1054' '#1047#1040#1052#1045#1053#1059
      '11026774=  SUMM_ = REPLACE(SUMM_, '#39#39'.'#39#39', '#39#39','#39#39');'
      '11026775=  VSEGO_NAIM_ = REPLACE(VSEGO_NAIM_, '#39#39'.'#39#39', '#39#39','#39#39');'
      '11026776='
      '11026777=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      '11026778=  I = 1;'
      '11026779=  FOR'
      '11026780=    SELECT :I,'
      '11026781=           G.NAME,'
      '11026782=           G.ARTICUL,'
      '11026783=           ZD.AMOUNT,'
      '11026784=           U.SHORT_NAME,'
      
        '11026785=           REPLACE(CAST(ZD.PRICE - ZD.DISCOUNT_TENGE AS' +
        ' VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '11026786=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39#39'.'#39#39',' +
        ' '#39#39','#39#39')'
      '11026787=      FROM ZAKAZ_DETAILS_TMP ZD,'
      '11026788=           G_PRODUCT G,'
      '11026789=           G_UNIT U'
      '11026790=     WHERE ZD.G_PRODUCT = G.G_PRODUCT'
      '11026791=       AND G.G_UNIT = U.G_UNIT'
      '11026792=   ORDER BY G.NAME, ZD.ZAKAZ_DETAILS'
      '11026793=    INTO :ROW_NUM,'
      '11026794=        :NAME,'
      '11026795=        :ARTICUL,'
      '11026796=        :AMOUNT,'
      '11026797=        :SHORT_NAME,'
      '11026798=        :PRICE,'
      '11026799=        :SUMM'
      '11026800=  DO BEGIN'
      '11026801=    I = I + 1;'
      '11026802=    SUSPEND;'
      '11026803=  END'
      '11026804='
      '11026805=WHEN ANY DO BEGIN'
      '11026806=    Err_code = -20500;'
      
        '11026807=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11026808=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11026809=  END'
      '11026810=end'
      '11026811='#39';'
      '11026812=END  --END_EXECUTE_BLOCK'
      '11026813=EXECUTE BLOCK AS BEGIN'
      '11026814='
      '11026815=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_KASSIR('
      '11026816=  DATE_BEGIN_ DATE,'
      '11026817=  DATE_END_ DATE,'
      '11026818=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11026819=RETURNS ('
      '11026820=  PERIOD_ VARCHAR(40),'
      '11026821=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '11026822=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '11026823=  ROWCOL INTEGER,'
      '11026824=  Z_DATE VARCHAR(40),'
      '11026825=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11026826=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11026827=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11026828=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11026829=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '11026830=AS'
      '11026831=/*'
      
        '11026832='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071', ' +
        #1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '11026833=*/'
      '11026834=DECLARE VARIABLE SORT_COL INTEGER;'
      '11026835=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '11026836=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '11026837=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      '11026838=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = 0;'
      '11026839=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = 0;'
      
        '11026840=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NULL ' +
        '= 0;'
      
        '11026841=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NULL ' +
        '= 0;'
      '11026842=BEGIN'
      
        '11026843=  PERIOD_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_' +
        '), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '11026844=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39 +
        #39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXTR' +
        'ACT(YEAR FROM DATE_END_);'
      '11026845='
      '11026846=  SELECT S."INPUT"'
      '11026847=    FROM kassa_state S'
      '11026848=   WHERE S.k_date = :DATE_BEGIN_'
      '11026849=     AND S.g_tochka = :G_TOCHKA_'
      '11026850=    INTO :IN_SUMM_;'
      '11026851='
      '11026852=  IF (ROW_COUNT = 0) THEN'
      '11026853=    SELECT S."OUTPUT"'
      '11026854=      FROM kassa_state S'
      '11026855=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '11026856=                         FROM KASSA_STATE ST'
      '11026857=                        WHERE ST.k_date < :DATE_BEGIN_'
      '11026858=                         AND ST.g_tochka = :G_TOCHKA_)'
      '11026859=      AND S.g_tochka = :G_TOCHKA_'
      '11026860=      INTO :IN_SUMM_;'
      '11026861='
      '11026862=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '11026863='
      '11026864=  SELECT S."OUTPUT"'
      '11026865=    FROM kassa_state S'
      '11026866=   WHERE S.k_date = :DATE_END_'
      '11026867=     AND S.g_tochka = :G_TOCHKA_'
      '11026868=    INTO :OUT_SUMM_;'
      '11026869='
      '11026870=  IF (ROW_COUNT = 0) THEN'
      '11026871=    SELECT S."OUTPUT"'
      '11026872=      FROM kassa_state S'
      '11026873=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '11026874=                         FROM KASSA_STATE ST'
      '11026875=                        WHERE ST.k_date < :DATE_END_'
      '11026876=                         AND ST.g_tochka = :G_TOCHKA_)'
      '11026877=      AND S.g_tochka = :G_TOCHKA_'
      '11026878=      INTO :OUT_SUMM_;'
      '11026879='
      '11026880=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '11026881='
