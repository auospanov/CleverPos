        '110391003=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIPT' +
        '_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_PA' +
        'YMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '110391004=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054#1057 +
