      '110242382=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110242383=             AND K.SUMM = 0'
      '110242384=          UNION'
      '110242385=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110242386=            FROM KASSA_BEZNAL K'
