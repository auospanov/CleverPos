      '11032470=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '11032471=        INTO :ZAKAZ,'
      '11032472=             :Z_NUM,'
      '11032473=             :G_TOCHKA,'
      '11032474=             :Z_DATE,'
      '11032475=             :Z_TIME,'
      '11032476=             :G_CLIENT,'
      '11032477=             :OSNOVANIE,'
      '11032478=             :NOTE,'
      '11032479=             :CLIENT_NAME,'
      '11032480=             :DETAILS_STR,'
      '11032481=             :IS_SPISANIE,'
      '11032482=             :IS_PAYED_ALL,'
      '11032483=             :INVOICE_PAY,'
      '11032484=             :INVOICE,'
      '11032485=             :WAYBILL,'
      '11032486=             :SUM_ZAKAZ,'
      '11032487=             :SUM_FACT,'
      '11032488=             :SUMM_PAY_BONUS,'
      '11032489=             :SUMM_BONUS_GOT'
      '11032490=      DO'
      '11032491=        suspend;'
      '11032492='
      '11032493=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11032494=  END ELSE BEGIN'
      '11032495=      FOR'
      '11032496=        SELECT T.SKLAD,'
      
        '11032497=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11032498=               T.G_TOCHKA,'
      '11032499=               T.DATE_RECEIPT,'
      '11032500=               T.TIME_RECEIPT,'
      '11032501=               T.G_CLIENT,'
      '11032502=               T.OSNOVANIE,'
      '11032503=               T.NOTE,'
      '11032504=               gc.name,'
      '11032505=               SUBSTRING((SELECT'
      
        '11032506=                            LIST(G.NAME||'#39#39'('#39#39'||D.AMOUN' +
        'T||'#39#39')'#39#39', '#39#39', '#39#39')'
      '11032507=                            FROM SKLAD D, G_PRODUCT G'
      
        '11032508=                           WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '11032509=                             AND D.SKLAD_PARENT = T.SKL' +
        'AD'
      
        '11032510=                            GROUP BY SKLAD_PARENT) FROM' +
        ' 1 FOR 999) DETAILS_STR,'
      '11032511=               T.SUMM,'
      '11032512=               T.IS_VOZVRAT,'
      '11032513=               W.WAYBILL'
      
        '11032514=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL W' +
        ' ON T.SKLAD = W.ZAKAZ,'
      '11032515=               G_TOCHKA GC'
      
        '11032516=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '11032517=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032518=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '11032519=           AND T.IS_VOZVRAT = 3'
      '11032520=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '11032521=        INTO :ZAKAZ,'
      '11032522=             :Z_NUM,'
      '11032523=             :G_TOCHKA,'
      '11032524=             :Z_DATE,'
      '11032525=             :Z_TIME,'
      '11032526=             :G_CLIENT,'
      '11032527=             :OSNOVANIE,'
      '11032528=             :NOTE,'
      '11032529=             :CLIENT_NAME,'
      '11032530=             :DETAILS_STR,'
      '11032531=             :SUM_ZAKAZ,'
      '11032532=             :IS_SPISANIE,'
      '11032533=             :WAYBILL'
      '11032534=      DO'
      '11032535=        suspend;'
      '11032536=  END'
      '11032537=end'
      '11032538='#39';'
