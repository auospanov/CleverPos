        #1058#1068#1048
      '110242406=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110242407=    SELECT K.KASSA'
      '110242408=      FROM KASSA K'
      '110242409=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110242410=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110242411=      INTO :KASSA_POP_;'
      '110242412=  ELSE'
