      '110241706='
      '110241707=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '110241708=            AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + ' +
