        'EIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' '#1055 +
        #1054#1057#1051#1045#1044#1053#1071#1071
      '110242255=              UPDATE SKLAD SK'
      '110242256=                 SET SK.IS_LAST = 0'
      '110242257=               WHERE SK.SKLAD = :SKLAD_;'
      '110242258='
      '110242259=               UPDATE SKLAD SK'
      '110242260=                 SET SK.IS_LAST = 1'
      '110242261=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242262=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110242263=                                   FROM SKLAD SS'
      
