      '110391027=               AND SK.IS_LAST = 1'
      '110391028=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110391029=              INTO :DATE_LAST_;'
      '110391030='
      
        '110391031=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110391032=              UPDATE SKLAD SK'
      '110391033=                 SET SK.IS_LAST = 0'
      '110391034=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110391035=                 AND SK.IS_LAST = 1'
      '110391036=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
