        'ATE_END_'
      '110261158=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '110261159=         AND K.g_tochka = :G_TOCHKA_'
      '110261160=        GROUP BY 2, 3'
      '110261161=        UNION ALL'
      '110261162=        SELECT CAST(K.action_date AS VARCHAR(10)),'
      '110261163=             K.action_date,'
      '110261164=             '#39#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1086#1084#39#39' name'
      '110261165=             ,SUM(K.summ)'
      '110261166=        FROM KASSA k'
      '110261167=        WHERE K.G_PRIHOD_RASHOD = 1'
      
        '110261168=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '110261169=         AND K.action_date <> (SELECT Z_DATE FROM ZAKA' +
        'Z WHERE ZAKAZ = K.zakaz)'
      '110261170=         AND K.g_tochka = :G_TOCHKA_'
      '110261171=        GROUP BY 2, 3'
      '110261172=        INTO :date_str,'
      '110261173=           :Z_DATE,'
      '110261174=           :NAME,'
      '110261175=           :SUMM'
      '110261176=  DO BEGIN'
      '110261177=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110261178=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110261179=      VALUES (21, 1, '#39#39#1055#1088#1080#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1074' '#1082#1072#1089#1089#1091#39#39');'
      '110261180=      FIRST_ITER = 1;'
      '110261181=    END'
      '110261182='
      
        '110261183=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '110261184=      VALUES (22, 10, :DATE_STR, :z_date, :NAME, :SUMM' +
        ');'
      '110261185='
      '110261186=    SUMM_PRIHOD_ = SUMM_PRIHOD_ + SUMM;'
      '110261187=  END'
      '110261188='
      '110261189=  IF (FIRST_ITER = 1) THEN'
      
        '110261190=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, SUMM)'
      
        '110261191=    VALUES (23, 2, '#39#39#1048#1090#1086#1075#1086' '#1087#1088#1080#1093#1086#1076' '#1076#1077#1085#1077#1075#39#39', :SUMM_PRIHO' +
        'D_);'
      '110261192=  SUMM_PRIHOD_ALL_ = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD_;'
      '110261193='
      '110261194=  -- '#1056#1040#1057#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1048#1047' '#1050#1040#1057#1057#1067
      '110261195=  FIRST_ITER = 0;'
      '110261196=  SUMM_RASHOD_ = 0;'
      
        '110261197=  FOR SELECT lpad(EXTRACT(DAY FROM K.action_date), 2, ' +
        #39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39#39'0'#39#39')' +
        '||'#39#39'.'#39#39'||EXTRACT(YEAR FROM K.action_date),--CAST(K.action_date A' +
        'S VARCHAR(10)),'
      '110261198=             K.action_date,'
      '110261199=             G.name'
      '110261200=             ,SUM(K.summ)'
      '110261201=        FROM KASSA k, g_prihod_rashod G'
      
        '110261202=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110261203=         AND K.ACTION = 1'
      
        '110261204=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '110261205=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '110261206=         AND K.g_tochka = :G_TOCHKA_'
      '110261207=        GROUP BY 2, 3'
      '110261208=        UNION ALL'
      '110261209=        SELECT CAST(K.action_date AS VARCHAR(10)),'
      '110261210=             K.action_date,'
      '110261211=             '#39#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1091'/'#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39#39' name'
      '110261212=             ,SUM(K.summ)'
      '110261213=        FROM KASSA k'
      '110261214=        WHERE K.G_PRIHOD_RASHOD in (2,3)'
      
        '110261215=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '110261216=         AND K.action_date <> (SELECT DATE_RECEIPT FRO' +
        'M SKLAD_PARENT WHERE SKLAD = K.sklad)'
      '110261217=         AND K.g_tochka = :G_TOCHKA_'
      '110261218=        GROUP BY 2, 3'
      '110261219=        INTO :date_str,'
      '110261220=           :Z_DATE,'
      '110261221=           :NAME,'
      '110261222=           :SUMM'
      '110261223=  DO BEGIN'
      '110261224=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110261225=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110261226=      VALUES (24, 1, '#39#39#1056#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1080#1079' '#1082#1072#1089#1089#1099#39#39');'
      '110261227=      FIRST_ITER = 1;'
      '110261228=    END'
      '110261229='
      
        '110261230=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '110261231=      VALUES (25, 10, :DATE_STR, :z_date, :NAME, :SUMM' +
        ');'
      '110261232='
      '110261233=    SUMM_RASHOD_ = SUMM_RASHOD_ + SUMM;'
      '110261234=  END'
      '110261235='
      '110261236=  IF (FIRST_ITER = 1) THEN'
      
        '110261237=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, SUMM)'
      
        '110261238=    VALUES (26, 2, '#39#39#1048#1090#1086#1075#1086' '#1088#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075#39#39', :SUMM_RASHO' +
        'D_);'
      '110261239=  SUMM_RASHOD_ALL_ = SUMM_RASHOD_ALL_ + SUMM_RASHOD_;'
      '110261240='
      '110261241=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '110261242=  VALUES(27, 1);'
      '110261243='
      
        '110261244=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110261245=  VALUES (28, 3, '#39#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' '#1085#1072' '#1089#1091#1084#1084#1091#39 +
        #39', :SUMM_PRIHOD_ALL_);'
      '110261246='
      
        '110261247=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110261248=  VALUES (29, 3, '#39#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1085#1072' '#1089#1091#1084#1084#1091#39#39', :SU' +
        'MM_RASHOD_ALL_);'
      '110261249='
      '110261250=  FOR SELECT SORT_COL'
      '110261251=            ,ROW_COL'
      '110261252=            ,Z_DATE'
      '110261253=            ,Z_DATE_STR'
      '110261254=            ,ARTICUL'
      '110261255=            ,BARCODE'
      '110261256=            ,NAME'
      '110261257=            ,AMOUNT'
      '110261258=            ,SUMM'
      '110261259=        FROM P_REP_KASSIR_TABLE'
      '110261260=    ORDER BY 1, 3, 7'
      '110261261=    INTO :SORT_COL,'
      '110261262=        :ROWCOL,'
      '110261263=        :Z_DATE_LOC,'
      '110261264=        :Z_DATE,'
      '110261265=        :ARTICUL,'
      '110261266=        :BARCODE,'
      '110261267=        :NAME,'
      '110261268=        :AMOUNT,'
      '110261269=        :SUMM'
      '110261270=  DO'
      '110261271=    suspend;'
      '110261272=end'
      '110261273='#39';'
      '110261274=END  --END_EXECUTE_BLOCK'
      '110270=EXECUTE BLOCK AS BEGIN'
      
        '110271=EXECUTE STATEMENT '#39'CREATE OR ALTER PROCEDURE P_REP_KASSIR' +
        '('
      '110272=  DATE_BEGIN_ DATE,'
      '110273=  DATE_END_ DATE,'
      
        '110274=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTEGE' +
        'R)'
      '110275=RETURNS ('
      '110276=  PERIOD_ VARCHAR(40),'
      '110277=  IN_SUMM_ /* TYPE OF MY_NUMERIC */ NUMERIC(15,2),'
      '110278=  OUT_SUMM_ /* TYPE OF MY_NUMERIC */ NUMERIC(15,2),'
      '110279=  ROWCOL INTEGER,'
      '1102710=  Z_DATE VARCHAR(40),'
      
        '1102711=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1102712=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      '1102713=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1102714=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUMER' +
        'IC(15,2),'
      
        '1102715=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(1' +
        '5,2))'
      '1102716=AS'
      '1102717=BEGIN'
      '1102718=  SUSPEND;'
      '1102719=END'
      '1102720='#39';'
      '1102721='
      '1102722='
      '1102723=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_KASSIR('
      '1102724=  DATE_BEGIN_ DATE,'
      '1102725=  DATE_END_ DATE,'
      '1102726=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102727=RETURNS ('
      '1102728=  PERIOD_ VARCHAR(40),'
      '1102729=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '1102730=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '1102731=  ROWCOL INTEGER,'
      '1102732=  Z_DATE VARCHAR(40),'
      '1102733=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102734=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102735=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102736=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102737=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '1102738=AS'
      '1102739=/*'
      
        '1102740='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071', '#1042 +
        #1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '1102741=*/'
      '1102742=DECLARE VARIABLE SORT_COL INTEGER;'
      '1102743=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '1102744=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '1102745=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      '1102746=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = 0;'
      '1102747=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = 0;'
      
        '1102748=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NULL =' +
        ' 0;'
      
        '1102749=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NULL =' +
        ' 0;'
      '1102750=BEGIN'
      
        '1102751=  PERIOD_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_)' +
        ', 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '1102752=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39 +
        '.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXTRA' +
        'CT(YEAR FROM DATE_END_);'
      '1102753='
      '1102754=  SELECT S."INPUT"'
      '1102755=    FROM kassa_state S'
      '1102756=   WHERE S.k_date = :DATE_BEGIN_'
      '1102757=     AND S.g_tochka = :G_TOCHKA_'
      '1102758=    INTO :IN_SUMM_;'
      '1102759='
      '1102760=  IF (ROW_COUNT = 0) THEN'
      '1102761=    SELECT S."OUTPUT"'
      '1102762=      FROM kassa_state S'
      '1102763=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102764=                         FROM KASSA_STATE ST'
      '1102765=                        WHERE ST.k_date < :DATE_BEGIN_'
      '1102766=                         AND ST.g_tochka = :G_TOCHKA_)'
      '1102767=      AND S.g_tochka = :G_TOCHKA_'
      '1102768=      INTO :IN_SUMM_;'
      '1102769='
      '1102770=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '1102771='
      '1102772=  SELECT S."OUTPUT"'
      '1102773=    FROM kassa_state S'
      '1102774=   WHERE S.k_date = :DATE_END_'
      '1102775=     AND S.g_tochka = :G_TOCHKA_'
      '1102776=    INTO :OUT_SUMM_;'
      '1102777='
      '1102778=  IF (ROW_COUNT = 0) THEN'
      '1102779=    SELECT S."OUTPUT"'
      '1102780=      FROM kassa_state S'
      '1102781=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102782=                         FROM KASSA_STATE ST'
      '1102783=                        WHERE ST.k_date < :DATE_END_'
      '1102784=                         AND ST.g_tochka = :G_TOCHKA_)'
      '1102785=      AND S.g_tochka = :G_TOCHKA_'
      '1102786=      INTO :OUT_SUMM_;'
      '1102787='
      '1102788=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '1102789='
      '1102790=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '1102791=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39#39'0'#39#39')|' +
        '|'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXT' +
        'RACT(YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_STR'
      '1102792=           ,Z.Z_DATE'
      '1102793=           ,GP.ARTICUL'
      '1102794=           ,GP.BARCODE'
      '1102795=           ,GP.NAME'
      '1102796=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '1102797=           ,SUM(ZD.summ)    SUMM'
      '1102798=      FROM ZAKAZ Z'
      '1102799=           ,ZAKAZ_DETAILS ZD'
      '11027100=           ,G_PRODUCT GP'
      '11027101=     WHERE Z.is_spisanie in (0, 2)'
      '11027102=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11027103=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11027104=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      '11027105=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11027106=       AND Z.G_TOCHKA = :G_TOCHKA_'
      '11027107=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NAME'
      '11027108=      INTO :date_str,'
      '11027109=           :Z_DATE,'
      '11027110=           :ARTICUL,'
      '11027111=           :BARCODE,'
      '11027112=           :NAME,'
      '11027113=           :AMOUNT,'
      '11027114=           :SUMM'
      '11027115=  DO BEGIN'
      '11027116=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '11027117=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR)'
      '11027118=      VALUES (1, 1, '#39#39#1055#1088#1086#1076#1072#1078#1072#39#39');'
      '11027119=      FIRST_ITER = 1;'
      '11027120=    END'
      '11027121='
      
        '11027122=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '11027123=      VALUES (2, 2, :DATE_STR, :z_date,  :ARTICUL, :BAR' +
        'CODE, :NAME, :AMOUNT, :SUMM);'
      '11027124=  END'
      '11027125='
      '11027126=  IF (first_iter > 0) THEN BEGIN'
      
        '11027127=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '11027128=        VALUES (3, 3, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39#39', (SELECT SUM(Z.s' +
        'umm_cash)'
      '11027129=                                         FROM ZAKAZ Z'
      
        '11027130=                                        WHERE Z.z_date ' +
        'BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11027131=                                          AND Z.G_TOCHK' +
        'A = :G_TOCHKA_'
      
        '11027132=                                          AND Z.is_spis' +
        'anie in (0, 2))'
      '11027133=               )'
      '11027134=      RETURNING'
      '11027135=        SUMM'
      '11027136=      INTO'
      '11027137=        :SUMM_PRIHOD_ALL_;'
      '11027138='
      
        '11027139=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '11027140=        VALUES (4, 3, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39#39', (SELECT SUM(' +
        'Z.summ_noncash)'
      
        '11027141=                                            FROM ZAKAZ ' +
        'Z'
      
        '11027142=                                           WHERE Z.z_da' +
        'te BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11027143=                                             AND Z.G_TO' +
        'CHKA = :G_TOCHKA_'
      
        '11027144=                                             AND Z.is_s' +
        'pisanie in (0, 2))'
      '11027145=               );'
      '11027146='
      
        '11027147=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ')'
      '11027148=      VALUES(5, 1);'
      '11027149=  END'
      '11027150='
      '11027151=  -- '#1055#1056#1048#1061#1054#1044
      '11027152=  FIRST_ITER = 0;'
      
        '11027153=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2, ' +
        #39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39#39'0'#39#39 +
        ')||'#39#39'.'#39#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt' +
        ' AS VARCHAR(10)) DATE_STR'
      '11027154=           ,S.date_receipt'
      '11027155=           ,GP.ARTICUL'
      '11027156=           ,GP.BARCODE'
      '11027157=           ,GP.NAME'
      '11027158=           ,SUM(SD.AMOUNT)  AMOUNT'
      '11027159=           ,SUM(SD.summ)    SUMM'
      '11027160=      FROM SKLAD_PARENT S'
      '11027161=           ,SKLAD SD'
      '11027162=           ,G_PRODUCT GP'
      '11027163=     WHERE S.is_vozvrat = 0'
      '11027164=       AND S.sklad = SD.sklad_parent'
      '11027165=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '11027166=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11027167=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '11027168=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '11027169=     GROUP BY S.date_receipt, GP.articul, GP.barcode, G' +
        'P.NAME'
      '11027170=     INTO :date_str,'
      '11027171=           :Z_DATE,'
      '11027172=           :ARTICUL,'
      '11027173=           :BARCODE,'
      '11027174=           :NAME,'
      '11027175=           :AMOUNT,'
      '11027176=           :SUMM'
      '11027177=  DO BEGIN'
      '11027178=    IF (FIRST_ITER = 0) THEN BEGIN'
      
