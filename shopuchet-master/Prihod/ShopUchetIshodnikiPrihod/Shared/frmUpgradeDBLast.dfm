        ' THEN BEGIN'
      '110242334=                      PNT_ = '#39#39'010'#39#39';'
      
        '110242335=                      EXECUTE PROCEDURE K_UPD_KASSA(:K' +
        'ASSA_,'
      
        '110242336=                                                    1,' +
