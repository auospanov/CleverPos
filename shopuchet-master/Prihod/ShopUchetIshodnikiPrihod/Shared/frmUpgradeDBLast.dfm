        '0)'
      '110242487=RETURNS ('
      '110242488=  ERR_CODE INTEGER,'
      '110242489=  ERR_MSG VARCHAR(1024))'
      '110242490=AS'
      
        '110242491=declare variable PROCNAME varchar(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110242492=declare variable PNT_ varchar(5);'
      '110242493=declare variable G_PRODUCT_ integer;'
      
        '110242494=declare variable AMOUNT_CUR_ type of column SKLAD.AMOU' +
        'NT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '110242495=declare variable AMOUNT_CUR_SKLAD_ type of column SKLA' +
        'D.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      
        '110242496=declare variable SKLAD_PARENT_ type of column SKLAD_PA' +
        'RENT.SKLAD; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1055#1056#1048#1061#1054#1044#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' ' +
        #1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044' */'
      
        '110242497=declare variable AMOUNT_OLD_ type of column SKLAD.AMOU' +
        'NT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      '110242498=begin'
      '110242499=  PNT_ = '#39#39'01'#39#39';'
      '110242500=  UPDATE sklad_TMP'
      '110242501=  SET'
      '110242502=    AMOUNT = :AMOUNT_,'
      '110242503=    PRICE = :PRICE_,'
      '110242504=    SUMM = :SUMM_,'
      '110242505=    NDS = :NDS_,'
      '110242506=    NDS_SUMM = :NDS_SUMM_'
      '110242507=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110242508=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '110242509=  WHERE'
      '110242510=    sklad = :sklad_'
      '110242511=  RETURNING'
      '110242512=    SKLAD_PARENT'
      '110242513=  INTO'
      '110242514=    SKLAD_PARENT_;'
      '110242515='
      
        '110242516=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054#1043 +
        #1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1053#1054' '#1069#1058#1040' '#1055#1056#1054#1042#1045#1056#1050#1040' '#1053#1059#1046#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058#1057#1071' '#1059#1046 +
        #1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044', '#1054' '#1063#1045#1052' '#1057#1042#1048#1044#1045#1058#1045#1051#1068#1057#1058#1042#1059#1045#1058' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1049' SKLAD_PA' +
        'RENT_'
      
        '110242517=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SKL' +
        'AD_PARENT_, 0) <> 0)) then BEGIN'
      '110242518=      SELECT L.G_PRODUCT,'
      '110242519=             L.AMOUNT'
      '110242520=        FROM SKLAD S,'
      '110242521=             LT_SKLAD_PRODUCT L'
      '110242522=       WHERE S.SKLAD = :SKLAD_'
      '110242523=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '110242524=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110242525=        INTO :G_PRODUCT_,'
      '110242526=             :AMOUNT_CUR_;'
      '110242527='
      
        '110242528=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1055#1056#1048#1061#1054#1044', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110242529=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1055#1056#1048#1061#1054#1044', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 40, '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068', '#1063#1043#1054#1041#1067' '#1053#1045' '#1059#1064#1051#1054' '#1042 +
        ' '#1052#1048#1053#1059#1057
      
        '110242530=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051 +
        #1054', '#1047#1040#1058#1045#1052' '#1045#1057#1051#1048' '#1057#1058#1040#1056#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1041#1054#1051#1068#1064#1045' '#1053#1054#1042#1054#1043#1054' - '#1047#1053#1040#1063#1048#1058' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040 +
        #1056#1040' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1054#1057#1068','
      '110242531=      -- '#1053#1040#1044#1054' '#1057#1044#1045#1051#1040#1058#1068' '#1063#1058#1054#1041#1067' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1057#1068' '#1053#1045' '#1042' '#1052#1048#1053#1059#1057
      '110242532=      SELECT SUM(AMOUNT)'
      '110242533=        FROM SKLAD T'
      '110242534=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110242535=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '110242536=        INTO :AMOUNT_OLD_;'
      '110242537='
      '110242538=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045
      '110242539=      SELECT SUM(AMOUNT)'
      '110242540=        FROM SKLAD_TMP T'
      '110242541=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110242542=       INTO :AMOUNT_CUR_SKLAD_;'
      '110242543='
      
        '110242544=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD_' +
        ') THEN BEGIN'
      
        '110242545=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_CU' +
        'R_SKLAD_)) < 0) THEN BEGIN'
      '110242546=            ERR_CODE = -20500;'
      
        '110242547=            ERR_MSG = '#39#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086 +
        #1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39#39'||ASCII_CHAR(10)||'
      
        '110242548=                      '#39#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'.'#39#39';'
      
        '110242549=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110242550=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110242551=            EXIT;'
      '110242552=          END'
      '110242553=      END'
      '110242554=  END'
      '110242555=end'
      '110242556='#39';'
      '110242557='
      '110242558='
      '110242559=EXECUTE STATEMENT '#39'ALTER PROCEDURE DO_PRODUCT('
      '110242560=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110242561=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '110242562=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110242563=  AMOUNT_ INTEGER,'
      '110242564=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '110242565=RETURNS ('
      '110242566=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '110242567=  ERR_CODE INTEGER,'
      '110242568=  ERR_MSG VARCHAR(1024))'
      '110242569=AS'
      '110242570=/*'
      
        '110242571='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055 +
        #1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '110242572='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '110242573=*/'
      
        '110242574=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'DO_PRODUCT'#39 +
        #39';'
      '110242575=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110242576=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042 +
        #1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '110242577=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT;'
      
        '110242578=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '110242579=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067 +
        ' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '110242580=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110242581=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110242582=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ' = 0;'
      
        '110242583=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '110242584=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      '110242585=BEGIN'
      '110242586=  PNT_ = '#39#39'00'#39#39';'
      '110242587='
      '110242588=  IF (G_TOCHKA_ IS NULL) THEN'
      '110242589=    SELECT ID'
      '110242590=      FROM CUR_PARAMS'
      '110242591=     WHERE CUR_PARAMS = 2'
      '110242592=      INTO :G_TOCHKA_;'
      '110242593='
      '110242594=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '110242595=  SELECT P.S_VALUE'
      '110242596=    FROM SYSTEM_SETUP P'
      '110242597=   WHERE P.SYSTEM_SETUP = 2'
      '110242598=    INTO :CAN_SELL_;'
      '110242599='
      '110242600=  SELECT MAX(G.NAME)'
      '110242601=    FROM G_PRODUCT G,'
      '110242602=         G_PRODUCT_KIT K'
      '110242603=   WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '110242604=     AND K.G_PRODUCT = :G_PRODUCT_'
      
        '110242605=     AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PRODU' +
        'CT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCHKA_' +
        '), 0) < (K.AMOUNT * :AMOUNT_)'
      '110242606=    INTO :NAME_;'
      '110242607='
      '110242608=  IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEGIN'
      '110242609=    ERR_CODE = -20500;'
      
        '110242610=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1089#1090#1072#1090#1086#1082' ' +
        #1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39#39'||NAME_||'#39#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1089#1086#1073 +
        #1088#1072#1090#1100' '#1087#1088#1086#1076#1091#1082#1090'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110242611=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110242612=    EXIT;'
      '110242613=  END'
      '110242614='
      '110242615=  PNT_ = '#39#39'01'#39#39';'
      '110242616=  -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '110242617=  INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIVAL_' +
        'TYPE, PARENT_ID, NOTE, G_TOCHKA)'
      
        '110242618=  VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0, 1' +
        ', :OTHER_, :NOTE_, :G_TOCHKA_)'
      '110242619=  RETURNING OTHER'
      '110242620=  INTO :OTHER_;'
      '110242621='
      '110242622=  FOR SELECT K.G_PRODUCT_ITEM'
      '110242623=            ,K.AMOUNT*:AMOUNT_'
      '110242624=            ,K.amount'
      '110242625=            ,G.G_PRODUCT'
      '110242626=        FROM G_PRODUCT_KIT K'
      '110242627=            ,G_PRODUCT G'
      '110242628=       WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110242629=         AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '110242630=        INTO :ITEM_'
      '110242631=            ,:AMOUNT_NEED_'
      '110242632=            ,:AMOUNT_NEED_ONE_'
      '110242633=            ,:G_PRODUCT_KIT_'
      '110242634=  DO BEGIN'
      
        '110242635=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_K' +
        'IT_, NULL, 1)'
      '110242636=      RETURNING_VALUES :SELF_PRICE_;'
      '110242637='
      '110242638=    UPDATE LT_SKLAD_PRODUCT L'
      '110242639=       SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110242640=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110242641=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110242642='
      '110242643=    IF (ROW_COUNT = 0) THEN'
      
        '110242644=      INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(GEN_' +
        'LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G_TOC' +
        'HKA_);'
      '110242645='
      
        '110242646=    INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHER, G' +
        '_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110242647=    VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_, :G_' +
        'PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110242648='
      
        '110242649=    COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*SELF_' +
        'PRICE_;'
      '110242650=  END'
      '110242651='
      '110242652='
      
        '110242653=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063#1040#1051#1045' ' +
        #1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110242654=  PNT_ = '#39#39'02'#39#39';'
      
        '110242655=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM)'
      
        '110242656=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :AM' +
        'OUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110242657='
      '110242658=  EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110242659=                              :DATE_,'
      '110242660=                              CURRENT_TIME,'
      '110242661=                              NULL, --:G_CLIENT__,'
      
        '110242662=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110242663=                              NULL, --:OSNOVANIE__,'
      '110242664=                              :NOTE_,'
      '110242665=                              4, --:IS_VOZVRAT_,'
      '110242666=                              :AMOUNT_*:COST_PRICE_,'
      '110242667=                              :AMOUNT_*:COST_PRICE_,'
      '110242668=                              0, --:G_PRIHOD_,'
      '110242669=                              0 --:SUMM_PRIHOD_)'
      '110242670=                              ,NULL     --PAYMENTS_'
      
        '110242671=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110242672=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110242673=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110242674=      EXIT;'
      '110242675=  END'
      '110242676='
      '110242677=  UPDATE OTHER O'
      '110242678=    SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110242679=  WHERE O.OTHER = :OTHER_;'
      '110242680=END'
      '110242681='#39';'
      '110242682=END  --END_EXECUTE_BLOCK'
      '110242683=EXECUTE BLOCK AS BEGIN'
      '110242684='
      '110242685=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '110242686=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
