      '110391009='
      '110391010=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110391011=        UPDATE LT_SKLAD_PRODUCT L'
