      '110391095=            END'
      '110391096=        END'
      '110391097='
      
        '110391098=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048' ' +
        'IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068 +
        ' IS_LAST = 0'
      '110391099=        PNT_ = '#39#39'08'#39#39';'
      
        '110391100=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (I' +
        'S_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110391101=            SELECT MAX(SK.DATE_RECEIPT)'
      '110391102=              FROM SKLAD SK'
      '110391103=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
