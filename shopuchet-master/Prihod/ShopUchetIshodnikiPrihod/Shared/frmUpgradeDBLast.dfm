      '1103356='
      '1103357='
      
        '1103358=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_DEL_G_PRIHOD_RASHOD' +
        '('
      
        '1103359=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIH' +
        'OD_RASHOD)'
      '1103360=RETURNS ('
      '1103361=  ERR_CODE INTEGER,'
      '1103362=  ERR_MSG VARCHAR(1024))'
      '1103363=AS'
      '1103364=DECLARE VARIABLE PROCNAME VARCHAR(30);'
