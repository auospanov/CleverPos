      '11028276=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11028277=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11028278=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '11028279=  NOTIFY_SKIDKA_ INTEGER,'
      '11028280=  NOTIFY_DR_ INTEGER,'
      '11028281=  ERR_CODE INTEGER,'
      '11028282=  ERR_MSG VARCHAR(1024))'
      '11028283=AS'
      '11028284=begin'
      '11028285=    SELECT'
      
        '11028286=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE, ' +
        'SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '11028287=      ,P.G_PROMOTION'
      '11028288=      ,P.NAME'
      '11028289=      ,notify_dr'
      '11028290=      ,notify_skidka'
      
        '11028291=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T.' +
        'g_promotion = P.g_promotion'
      '11028292=    WHERE T.G_CLIENT = :G_CLIENT_'
      '11028293=    INTO'
      
        '11028294=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_,' +
        ' :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :DT' +
        '_, :NAME_FULL_'
      '11028295=      ,:G_PROMOTION_'
      '11028296=      ,:G_PROMOTION_STR_'
      '11028297=      ,:NOTIFY_DR_'
      '11028298=      ,:NOTIFY_SKIDKA_'
      '11028299=      ;'
      '11028300='
      '11028301=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '11028302=    FROM G_DISCONT_CARD'
      '11028303=    WHERE G_CLIENT = :G_CLIENT_'
      '11028304=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '11028305=end'
      '11028306='#39';'
      '11028307='
      '11028308=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_CLIENT('
      '11028309=  G_CLIENT_PARENT_ INTEGER,'
      '11028310=  G_CONTRAGENT_ INTEGER,'
      '11028311=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11028312=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11028313=  IDN_ VARCHAR(12),'
      '11028314=  KBE_ VARCHAR(5),'
      '11028315=  SKIDKA_ NUMERIC(15,2),'
      '11028316=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11028317=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11028318=  BY_DEFAULT_ INTEGER,'
      '11028319=  IS_SUPPLIER_ INTEGER,'
      '11028320=  IS_CATEGORY_ INTEGER,'
      '11028321=  IS_BEZNAL_ INTEGER,'
      '11028322=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11028323=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11028324=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11028325=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11028326=  NOTIFY_SKIDKA_ INTEGER,'
      '11028327=  NOTIFY_DR_ INTEGER)'
      '11028328=RETURNS ('
      '11028329=  G_CLIENT_ INTEGER,'
      '11028330=  ERR_CODE INTEGER,'
      '11028331=  ERR_MSG VARCHAR(1024))'
      '11028332=AS'
      '11028333=DECLARE VARIABLE CNT_ INTEGER;'
      '11028334=begin'
      
        '11028335=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1' +
        ', '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11028336=    if (BY_DEFAULT_ = 1) then'
      '11028337=      UPDATE g_client'
      '11028338=         SET BY_DEFAULT = 0'
      '11028339=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11028340='
      
        '11028341=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G_' +
        'CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '11028342=                          IS_CATEGORY, IS_BEZNAL, PHONE' +
        ', NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR)'
      
        '11028343=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_,' +
        ' :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_, ' +
        ':BY_DEFAULT_,'
      
        '11028344=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE_' +
        ', :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR_' +
        ')'
      '11028345=    returning G_CLIENT'
      '11028346=    into :G_CLIENT_;'
      '11028347='
      '11028348=    if (IS_CATEGORY_ = 0) then BEGIN'
      '11028349=        IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11028350=            SELECT COUNT(*)'
      '11028351=              FROM G_DISCONT_CARD'
      '11028352=             WHERE BARCODE = :BARCODE_'
      
        '11028353=             AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040 +
        #1049#1058#1048' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11028354=             INTO :CNT_;'
      '11028355='
      '11028356=            IF (CNT_ > 0) THEN BEGIN'
      '11028357=              ERR_CODE = -20500;'
      
        '11028358=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39 +
        #39') RETURNING_VALUES (:ERR_MSG);'
      '11028359=              EXIT;'
      '11028360=            END'
      '11028361=        END'
      '11028362='
      
        '11028363=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11028364=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, 0, 0);'
      '11028365=    END'
      '11028366=end'
      '11028367='#39';'
      '11028368='
      '11028369=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_CLIENT('
      '11028370=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11028371=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      '11028372=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '11028373=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11028374=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11028375=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '11028376=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '11028377=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '11028378=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11028379=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11028380=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '11028381=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '11028382=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '11028383=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '11028384=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11028385=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11028386=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11028387=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11028388=  NOTIFY_SKIDKA_ INTEGER,'
      '11028389=  NOTIFY_DR_ INTEGER)'
      '11028390=RETURNS ('
      '11028391=  ERR_CODE INTEGER,'
      '11028392=  ERR_MSG VARCHAR(1024))'
      '11028393=AS'
      '11028394=DECLARE VARIABLE CNT_ INTEGER;'
      '11028395=BEGIN'
      
        '11028396=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1, ' +
        #1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11028397=  if (BY_DEFAULT_ = 1) then'
      '11028398=    UPDATE g_client'
      '11028399=       SET BY_DEFAULT = 0'
      '11028400=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11028401='
      '11028402=  UPDATE g_client'
      '11028403=  SET'
      
        '11028404=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CLIE' +
        'NT_PARENT),'
      
        '11028405=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTRAG' +
        'ENT),'
      '11028406=   NAME = COALESCE(:NAME_, NAME),'
      '11028407=   IDN  = COALESCE(:IDN_, IDN),'
      '11028408=   KBE  = COALESCE(:KBE_, KBE),'
      '11028409=   PHONE = COALESCE(:PHONE_, PHONE),'
      '11028410=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '11028411=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      '11028412=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER),'
      '11028413=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '11028414=   ,DT    = COALESCE(:DT_, DT)'
      '11028415=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '11028416=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '11028417=   ,G_PROMOTION = :G_PROMOTION_'
      '11028418=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '11028419=   ,NOTIFY_DR = :NOTIFY_DR_'
      '11028420=  WHERE'
      '11028421=    g_client = :g_client_;'
      '11028422='
      '11028423=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '11028424=    IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11028425=        SELECT COUNT(*)'
      '11028426=          FROM G_DISCONT_CARD'
      '11028427=         WHERE BARCODE = :BARCODE_'
      
        '11028428=         AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040#1049#1058#1048' ' +
        #1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11028429=         INTO :CNT_;'
      '11028430='
      '11028431=        IF (CNT_ > 0) THEN BEGIN'
      '11028432=          ERR_CODE = -20500;'
      
        '11028433=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1050#1072#1088 +
        #1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11028434=          EXIT;'
      '11028435=        END'
      '11028436=    END'
      '11028437='
      '11028438=    UPDATE G_DISCONT_CARD G'
      '11028439=    SET G.BARCODE = :BARCODE_,'
      '11028440=        G.N_PERCENT = :N_PERCENT_,'
      '11028441=        G.summ = COALESCE(G.summ, 0),'
      '11028442=        G.summ_all = COALESCE(G.summ_all, 0)'
      '11028443=    WHERE G.G_CLIENT = :g_client_;'
      '11028444='
      '11028445=    if (ROW_COUNT = 0) then'
      
        '11028446=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_CLI' +
        'ENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11028447=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIENT_' +
        ', :BARCODE_, :N_PERCENT_, 0, (select Coalesce(sum(SUMM_FACT), 0)' +
        ' from zakaz where g_client = :g_client_));'
      '11028448=  END'
      '11028449=end'
      '11028450='#39';'
      '11028451='
      '11028452=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD('
      '11028453=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '11028454=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      
        '11028455=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIP' +
        'T,'
      '11028456=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '11028457=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '11028458=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '11028459=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '11028460=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '11028461=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11028462=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11028463=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11028464=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11028465=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11028466=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY = 0)'
      '11028467=RETURNS ('
      '11028468=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11028469=  ERR_CODE INTEGER,'
      '11028470=  ERR_MSG VARCHAR(1024))'
      '11028471=AS'
      '11028472=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '11028473=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042#1040 +
        #1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '11028474=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '11028475=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '11028476=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050 +
        #1048
      
        '11028477=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' '#1057 +
        #1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '11028478=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050#1040 +
        #1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047#1044 +
        #1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '11028479=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059#1044 +
        #1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM ' +
        #1041#1059#1044#1059
      '11028480=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '11028481=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047#1053 +
        #1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048' ' +
        #1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '11028482=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD'#39#39';'
      '11028483=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11028484=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11028485=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11028486=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11028487=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11028488=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '11028489=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM = 0;'
      
        '11028490=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      '11028491=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11028492=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIH' +
        'OD_RASHOD.G_PRIHOD_RASHOD;'
      
        '11028493=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11028494=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '11028495=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11028496=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11028497=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11028498=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11028499=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11028500=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11028501=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.P' +
        'RICE_CURRENCY;'
      
        '11028502=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKLA' +
        'D.SUMM_CURRENCY;'
      
        '11028503=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11028504=BEGIN'
      '11028505='
      '11028506=  PNT_ = '#39#39'00'#39#39';'
      '11028507=  IS_THIS_LAST_ = 0;'
      '11028508='
      '11028509=  IF (G_TOCHKA_ IS NULL) THEN'
      '11028510=    SELECT ID'
      '11028511=      FROM CUR_PARAMS'
      '11028512=     WHERE CUR_PARAMS = 2'
      '11028513=      INTO :G_TOCHKA_;'
      '11028514='
      '11028515=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11028516=  SELECT ID'
      '11028517=    FROM CUR_PARAMS'
      '11028518=   WHERE CUR_PARAMS = 1'
      '11028519=    INTO :G_OFFICIAL_;'
      '11028520='
      '11028521=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '11028522=                            DATE_RECEIPT,'
      '11028523=                            TIME_RECEIPT,'
      '11028524=                            G_CLIENT,'
      '11028525=                            G_PAYMENT_TYPE,'
      '11028526=                            OSNOVANIE,'
      '11028527=                            NOTE,'
      '11028528=                            SUMM,'
      '11028529=                            SUMM_FACT,'
      '11028530=                            SUMM_CURRENCY,'
      '11028531=                            IS_PAYED_ALL,'
      '11028532=                            IS_VOZVRAT,'
      '11028533=                            G_TOCHKA'
      '11028534=                            ,G_OFFICIAL)'
      '11028535=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11028536=          :DATE_RECEIPT_,'
      '11028537=          :TIME_RECEIPT_,'
      '11028538=          :G_CLIENT_,'
      '11028539=          :G_PAYMENT_TYPE_,'
      '11028540=          :OSNOVANIE_,'
      '11028541=          :NOTE_,'
      '11028542=          :SUMM_,'
      '11028543=          :SUMM_FACT_,'
      '11028544=          :SUMM_CURRENCY_,'
      
        '11028545=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PAY' +
        'ED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055 +
        #1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11028546=          :IS_VOZVRAT_,'
      '11028547=          :G_TOCHKA_'
      '11028548=          ,:G_OFFICIAL_)'
      '11028549=  RETURNING'
      '11028550=    SKLAD'
      '11028551=  INTO'
      '11028552=    :SKLAD_;'
      '11028553='
      '11028554=  PNT_ = '#39#39'01'#39#39';'
      '11028555=  FOR SELECT SKLAD,'
      '11028556=             G_PRODUCT,'
      '11028557=             AMOUNT,'
      '11028558=             PRICE,'
      '11028559=             SUMM,'
      '11028560=             NDS,'
      '11028561=             NDS_SUMM'
      '11028562=             ,PRICE_CURRENCY'
      '11028563=             ,SUMM_CURRENCY'
      '11028564=        FROM SKLAD_TMP'
      '11028565=      ORDER BY 1'
      '11028566=      INTO :SKLAD_TMP_,'
      '11028567=           :RG_PRODUCT_,'
      '11028568=           :RAMOUNT_,'
      '11028569=           :RPRICE_,'
      '11028570=           :RSUMM_,'
      '11028571=           :RNDS_,'
      '11028572=           :RNDS_SUMM_'
      '11028573=           ,:PRICE_CURRENCY_'
      '11028574=           ,:SUMM_CURRENCY_TMP_'
      '11028575=  DO BEGIN'
      '11028576=    if (IS_VOZVRAT_ IN (0,4)) then BEGIN'
      
        '11028577=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '11028578=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068#1064 +
        #1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '11028579=      IS_THIS_LAST_ = 0;'
      '11028580=      SELECT MAX(SK.DATE_RECEIPT)'
      '11028581=        FROM SKLAD SK'
      '11028582=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11028583=         AND SK.IS_LAST = 1'
      '11028584=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '11028585=        INTO :DATE_LAST_;'
      '11028586='
      
        '11028587=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (D' +
        'ATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11028588=        UPDATE SKLAD SK'
      '11028589=           SET SK.IS_LAST = 0'
      '11028590=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11028591=           AND SK.IS_LAST = 1'
      '11028592=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '11028593='
      '11028594=        IS_THIS_LAST_ = 1;'
      '11028595=      END'
      '11028596=    END'
      '11028597='
      '11028598=    INSERT INTO SKLAD'
      '11028599=    ('
      '11028600=     SKLAD,'
      '11028601=     SKLAD_PARENT,'
      '11028602=     DATE_RECEIPT,'
      '11028603=     G_CLIENT,'
      '11028604=     G_PRODUCT,'
      '11028605=     AMOUNT,'
      '11028606=     PRICE,'
      '11028607=     SUMM,'
      '11028608=     G_PAYMENT_TYPE,'
      '11028609=     OSNOVANIE,'
      '11028610=     NOTE,'
      '11028611=     NDS,'
      '11028612=     NDS_SUMM,'
      '11028613=     IS_LAST,'
      '11028614=     IS_VOZVRAT,'
      '11028615=     G_TOCHKA'
      '11028616=     ,PRICE_CURRENCY'
      '11028617=     ,SUMM_CURRENCY'
      '11028618=    ) VALUES ('
      '11028619=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '11028620=     :SKLAD_,'
      '11028621=     :DATE_RECEIPT_,'
      '11028622=     :G_CLIENT_,'
      '11028623=     :RG_PRODUCT_,'
      '11028624=     :RAMOUNT_,'
      '11028625=     :RPRICE_,'
      '11028626=     :RSUMM_,'
      '11028627=     :G_PAYMENT_TYPE_,'
      '11028628=     :OSNOVANIE_,'
      '11028629=     :NOTE_,'
      '11028630=     :RNDS_,'
      '11028631=     :RNDS_SUMM_,'
      
        '11028632=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057#1051 +
        #1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054#1064 +
        #1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044#1045 +
        #1058' 0'
      '11028633=     :IS_VOZVRAT_,'
      '11028634=     :G_TOCHKA_'
      '11028635=     ,:PRICE_CURRENCY_'
      '11028636=     ,:SUMM_CURRENCY_TMP_'
      '11028637=    );'
      '11028638='
      
        '11028639=    -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '11028640=    PNT_ = '#39#39'02'#39#39';'
      '11028641=    UPDATE LT_SKLAD_PRODUCT L'
      '11028642=       SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11028643=     WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11028644=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '11028645='
      '11028646=    IF (ROW_COUNT = 0) THEN'
      
        '11028647=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, G' +
        '_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(GEN_L' +
        'T_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11028648=  END'
      '11028649=  ----------------------------------------'
      '11028650='
      
        '11028651=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058#1042 +
        ', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', '#1048 +
        ' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '11028652=  PNT_ = '#39#39'05'#39#39';'
      
        '11028653=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BEG' +
        'IN'
      '11028654=      IF (:IS_VOZVRAT_ = 1) THEN'
      '11028655=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11028656=      ELSE'
      '11028657=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '11028658='
      
        '11028659=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063#1058 +
        #1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053' ' +
        #1055#1051#1040#1058#1045#1046
      '11028660=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '11028661=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11028662=                                        :G_PRIHOD_RASHO' +
        'D_,'
      '11028663=                                        :SUMM_FACT_,'
      '11028664=                                        :DATE_RECEIPT_,'
      
        '11028665=                                        NULL,   --NOTE_' +
        ' => :NOTE_,'
      
        '11028666=                                        NULL,   --ZAKAZ' +
        '_'
      '11028667=                                        :SKLAD_,'
      
        '11028668=                                        :G_PAYMENT_TYPE' +
        '_,'
      
        '11028669=                                        :G_TOCHKA_) RET' +
        'URNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11028670=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11028671=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11028672=            EXIT;'
      '11028673=          END'
      '11028674=      END ELSE BEGIN'
      '11028675=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '11028676=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '11028677=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) T' +
        'HEN'
      
        '11028678=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR POS' +
        '_TILDA_ - 1);'
      '11028679=            ELSE'
      
        '11028680=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CHA' +
        'R_LENGTH(PAYMENTS_) - 1);'
      '11028681='
      '11028682=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '11028683=                RETURNING_VALUES :PAYMENT_ID_, :PAYMENT' +
        '_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11028684='
      
        '11028685=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (POS' +
        'ITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '11028686='
      '11028687=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11028688=                EXECUTE PROCEDURE K_INS_KASSA(1,     --' +
        ' ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11028689=                                              :G_PRIHOD' +
        '_RASHOD_,'
      
        '11028690=                                              :PAYMENT_' +
        'SUMM_,'
      
        '11028691=                                              :PAYMENT_' +
        'DATE_,'
      
        '11028692=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11028693=                                              NULL,   -' +
        '-ZAKAZ_'
      '11028694=                                              :SKLAD_,'
      
        '11028695=                                              :PAYMENT_' +
        'TYPE_,'
      
        '11028696=                                              :G_TOCHKA' +
        '_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11028697=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11028698=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PN' +
        'T_||'#39#39' '#39#39'||ERR_MSG;'
      '11028699=                  EXIT;'
      '11028700=                END'
      '11028701=            END'
      '11028702=          END'
      '11028703=      END'
      '11028704=  END'
      '11028705='
      '11028706=  DELETE FROM SKLAD_TMP;'
      '11028707='
      
        '11028708=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054 +
        #1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '11028709=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11028710=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ => ' +
        ':ACTION_'
      '11028711=                                  G_PRIHOD_,'
      '11028712=                                  :SUMM_PRIHOD_,'
      '11028713=                                  :DATE_RECEIPT_,'
      
        '11028714=                                  NULL,   --NOTE_ => :N' +
        'OTE_,'
      '11028715=                                  NULL,   --:ZAKAZ_,'
      '11028716=                                  :SKLAD_,'
      '11028717=                                  :G_PAYMENT_TYPE_,'
      
        '11028718=                                  :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11028719=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11028720=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||E' +
        'RR_MSG;'
      '11028721=      EXIT;'
      '11028722=    END'
      '11028723=  END'
      '11028724=end'
      '11028725='#39';'
      '11028726='
      
        '11028727=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_PARENT_LI' +
        'ST('
      '11028728=  DATE_BEGIN_ DATE,'
      '11028729=  DATE_END_ DATE,'
      '11028730=  IS_VOZVRAT_ INTEGER)'
      '11028731=RETURNS ('
      '11028732=  SKLAD TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      
        '11028733=  DATE_RECEIPT TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT' +
        ','
      '11028734=  G_CLIENT TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      '11028735=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '11028736=  G_PAYMENT_TYPE TYPE OF COLUMN SKLAD_PARENT.G_PAYMENT_' +
        'TYPE,'
      '11028737=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '11028738=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '11028739=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '11028740=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11028741=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11028742=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_ALL' +
        ','
      '11028743=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '11028744=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11028745=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11028746=  DETAILS_STR VARCHAR(1000))'
      '11028747=AS'
      '11028748=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11028749=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11028750=BEGIN'
      '11028751='
      '11028752=  SELECT ID'
      '11028753=    FROM CUR_PARAMS'
      '11028754=   WHERE CUR_PARAMS = 2'
      '11028755=    INTO :G_TOCHKA_;'
      '11028756='
      '11028757=  SELECT COUNT(*)'
      '11028758=    FROM SKLAD_PARENT T'
      
        '11028759=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11028760=     AND ((T.IS_VOZVRAT = :IS_VOZVRAT_ AND :IS_VOZVRAT_' +
        ' <> 1)'
      
        '11028761=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ =' +
        ' 1))'
      '11028762=     AND T.G_TOCHKA = :G_TOCHKA_'
      '11028763=    INTO CNT_;'
      '11028764='
      '11028765=  if (CNT_ = 0) then'
      '11028766=    SELECT MAX(T.DATE_RECEIPT)'
      '11028767=      FROM SKLAD_PARENT T'
      '11028768=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '11028769=       AND ((T.IS_VOZVRAT = :IS_VOZVRAT_ AND :IS_VOZVRA' +
        'T_ <> 1)'
      
        '11028770=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ =' +
        ' 1))'
      '11028771=       AND T.G_TOCHKA = :G_TOCHKA_'
      '11028772=      INTO :DATE_BEGIN_;'
      '11028773='
      '11028774=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '11028775=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '11028776=      FOR'
      '11028777=        SELECT T.SKLAD,'
      '11028778=               T.DATE_RECEIPT,'
      '11028779=               T.G_CLIENT,'
      '11028780=               GC.NAME,'
      '11028781=               T.G_PAYMENT_TYPE,'
      '11028782=               PT.NAME,'
      
        '11028783=               SUBSTRING((SELECT LIST(G.NAME||'#39#39'('#39#39'||D.' +
        'AMOUNT||'#39#39')'#39#39', '#39#39', '#39#39')'
      '11028784=                            FROM SKLAD D, G_PRODUCT G'
      
        '11028785=                           WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '11028786=                             AND D.SKLAD_PARENT = T.SKL' +
        'AD'
      
        '11028787=                           GROUP BY SKLAD_PARENT) FROM ' +
        '1 FOR 999) DETAILS_STR,'
      '11028788=               T.OSNOVANIE,'
      '11028789=               T.NOTE,'
      '11028790=               T.SUMM,'
      '11028791=               T.SUMM_FACT,'
      '11028792=               T.IS_PAYED_ALL,'
      '11028793=               T.IS_VOZVRAT,'
      '11028794=               T.g_official,'
      
        '11028795=               COALESCE(GO.fio_doc, GO.FM||'#39#39' '#39#39'||GO.nm' +
        ')'
      '11028796=          FROM SKLAD_PARENT T'
      
        '11028797=                    LEFT OUTER JOIN G_CLIENT GC ON T.G_' +
        'CLIENT = GC.G_CLIENT'
      
        '11028798=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT O' +
        'N T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '11028799=                    LEFT OUTER JOIN G_OFFICIAL GO ON T.' +
        'g_official = GO.G_OFFICIAL'
      
        '11028800=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVRAT' +
        '_ = 0)'
      
        '11028801=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRA' +
        'T_ = 1))'
      '11028802=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '11028803=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '11028804=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '11028805=        INTO :SKLAD,'
      '11028806=             :DATE_RECEIPT,'
      '11028807=             :G_CLIENT,'
      '11028808=             :CLIENT_NAME,'
      '11028809=             :G_PAYMENT_TYPE,'
      '11028810=             :PAYMENT_NAME,'
      '11028811=             :DETAILS_STR,'
      '11028812=             :OSNOVANIE,'
      '11028813=             :NOTE,'
      '11028814=             :SUMM,'
      '11028815=             :SUMM_FACT,'
      '11028816=             :IS_PAYED_ALL,'
      '11028817=             :IS_VOZVRAT,'
      '11028818=             :G_OFFICIAL,'
      '11028819=             :G_OFFICIAL_FIO'
      '11028820=      DO'
      '11028821=        suspend;'
      '11028822='
      
        '11028823=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1047#1044#1045#1057#1068' '#1044#1040#1053#1053#1067#1049' '#1057#1050#1051#1040#1044' '#1057#1058#1054#1048#1058' '#1050 +
        #1040#1050' '#1050#1051#1048#1045#1053#1058', '#1040' '#1042' G_TOCHKA '#1057#1058#1054#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '11028824=  END ELSE BEGIN'
      '11028825=      FOR'
      '11028826=        SELECT T.SKLAD,'
      '11028827=               T.DATE_RECEIPT,'
      '11028828=               T.G_TOCHKA,'
      '11028829=               G.NAME,'
      
        '11028830=               SUBSTRING((SELECT LIST(G.NAME||'#39#39'('#39#39'||D.' +
        'AMOUNT||'#39#39')'#39#39', '#39#39', '#39#39')'
      '11028831=                            FROM SKLAD D, G_PRODUCT G'
      
        '11028832=                           WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '11028833=                             AND D.SKLAD_PARENT = T.SKL' +
        'AD'
      
        '11028834=                           GROUP BY SKLAD_PARENT) FROM ' +
        '1 FOR 999) DETAILS_STR,'
      '11028835=               T.OSNOVANIE,'
      '11028836=               T.NOTE,'
      '11028837=               T.SUMM'
      
        '11028838=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHKA ' +
        'G ON T.G_CLIENT = G.G_TOCHKA'
      '11028839=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '11028840=           AND T.IS_VOZVRAT = 3'
      
        '11028841=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '11028842=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '11028843=        INTO :SKLAD,'
      '11028844=             :DATE_RECEIPT,'
      '11028845=             :G_CLIENT,'
      '11028846=             :CLIENT_NAME,'
      '11028847=             :DETAILS_STR,'
      '11028848=             :OSNOVANIE,'
      '11028849=             :NOTE,'
      '11028850=             :SUMM'
      '11028851=      DO'
      '11028852=        suspend;'
      '11028853=  END'
      '11028854=end'
      '11028855='#39';'
      '11028856=END  --END_EXECUTE_BLOCK'
      '110290=EXECUTE BLOCK AS BEGIN'
      '110291=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_TOVS_BY_DATE('
      '110292=  DATE_ DATE)'
      '110293=RETURNS ('
      '110294=  TOVAR_ VARCHAR(1500))'
      '110295=AS'
      '110296=/*'
      '110297='#1090#1086#1074#1072#1088#1099' '#1087#1086' '#1076#1072#1090#1072#1084
      '110298=*/'
      '110299=BEGIN'
      '1102910='
      '1102911=  SELECT SUBSTRING((SELECT'
      
        '1102912=                      LIST(G.NAME||'#39#39'('#39#39'||D.AMOUNT||'#39#39')'#39 +
        #39', '#39#39', '#39#39')'
      
        '1102913=                    FROM ZAKAZ Z, ZAKAZ_DETAILS D, G_PRO' +
        'DUCT G'
      '1102914=                    WHERE D.G_PRODUCT = G.G_PRODUCT'
      '1102915=                      AND D.ZAKAZ = Z.ZAKAZ'
      
        '1102916=                      AND Z.z_date = :DATE_) FROM 1 FOR ' +
        '1500)'
      '1102917=    FROM RDB$DATABASE'
      '1102918=    INTO TOVAR_;'
      '1102919='
      '1102920=  SUSPEND;'
      '1102921=end'
      '1102922='#39';'
      '1102923='
      '1102924=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_LIST('
      '1102925=  DATE_BEGIN_ DATE,'
      '1102926=  DATE_END_ DATE,'
      '1102927=  IS_SPISANIE_ INTEGER)'
      '1102928=RETURNS ('
      '1102929=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102930=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102931=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1102932=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102933=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102934=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1102935=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102936=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102937=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102938=  DETAILS_STR VARCHAR(3000),'
      '1102939=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102940=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1102941=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '1102942=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '1102943=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1102944=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102945=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102946=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102947=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102948=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1102949=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '1102950=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102951=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102952=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102953=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC)'
      '1102954=AS'
      '1102955=/*'
      '1102956=IS_SPISANIE_'
      '1102957=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102958=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102959=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102960=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' '#1055 +
        #1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102961='
      '1102962======='
      '1102963=*/'
      '1102964=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1102965=BEGIN'
      '1102966='
      '1102967=  if (IS_SPISANIE_ <> 3) then BEGIN'
      '1102968=      SELECT COUNT(*)'
      '1102969=        FROM ZAKAZ T'
      
        '1102970=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '1102971=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      '1102972=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '1102973=        INTO CNT_;'
      '1102974='
      '1102975=      if (CNT_ = 0) then'
      '1102976=        SELECT MAX(T.Z_DATE)'
      '1102977=          FROM ZAKAZ T'
      '1102978=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '1102979=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '1102980=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1102981=          INTO :DATE_BEGIN_;'
      '1102982='
      '1102983=  END ELSE BEGIN'
      '1102984=      SELECT COUNT(*)'
      '1102985=        FROM SKLAD_PARENT T'
      
        '1102986=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '1102987=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS WHE' +
        'RE CUR_PARAMS = 2)'
      '1102988=        INTO CNT_;'
      '1102989='
      '1102990=      if (CNT_ = 0) then'
      '1102991=        SELECT MAX(T.DATE_RECEIPT)'
      '1102992=          FROM SKLAD_PARENT T'
      '1102993=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1102994=           AND T.IS_VOZVRAT = 3'
      
        '1102995=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1102996=          INTO :DATE_BEGIN_;'
      '1102997=  END'
      '1102998='
      '1102999=  -- '#1055#1056#1054#1044#1040#1046#1048
      '11029100=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '11029101=      FOR'
      '11029102=        SELECT T.ZAKAZ,'
      
        '11029103=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11029104=               T.G_TOCHKA,'
      '11029105=               T.Z_DATE,'
      '11029106=               T.Z_TIME,'
      '11029107=               T.G_CLIENT,'
      '11029108=               T.OSNOVANIE,'
      '11029109=               T.NOTE,'
      '11029110=               gc.name,'
      
        '11029111=               /*SUBSTRING((SELECT LIST(NAME||'#39#39'('#39#39'||AM' +
        'OUNT||'#39#39')'#39#39', '#39#39', '#39#39')'
      
        '11029112=                            FROM (SELECT G.name, SUM(D.' +
        'amount) AMOUNT'
      
        '11029113=                                    FROM ZAKAZ Z, ZAKAZ' +
        '_DETAILS D, G_PRODUCT G'
      
        '11029114=                                   WHERE D.G_PRODUCT = ' +
        'G.G_PRODUCT'
      
        '11029115=                                     AND D.ZAKAZ = Z.ZA' +
        'KAZ'
      
        '11029116=                                     AND Z.ZAKAZ = T.ZA' +
        'KAZ'
      '11029117=                                   GROUP BY G.name)'
      
        '11029118=                          ) FROM 1 FOR 1500)*/'#39#39' '#39#39' DET' +
        'AILS_STR,'
      '11029119=               T.IS_SPISANIE,'
      
        '11029120=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_ALL' +
        ','
      '11029121=               IP.INVOICE_PAY,'
      '11029122=               I.INVOICE,'
      '11029123=               W.WAYBILL,'
      '11029124=               T.SUMM,'
      '11029125=               T.SUMM_FACT,'
      '11029126=               COALESCE(t.SUMM_BONUS, 0),'
      '11029127=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '11029128=               COALESCE(T.BY_RECIPE, 0)'
      '11029129=               ,IS_RESERVE'
      '11029130=               ,T.SUMM_CASH'
      '11029131=               ,T.SUMM_NONCASH'
      '11029132=               ,O.g_official'
      '11029133=               ,COALESCE(O.fio_doc, O.FM||'#39#39' '#39#39'||O.nm)'
      '11029134=          FROM ZAKAZ T'
      
        '11029135=                    LEFT OUTER JOIN G_CLIENT GC ON T.G_' +
        'CLIENT = GC.G_CLIENT'
      
        '11029136=                    LEFT OUTER JOIN INVOICE_PAY IP ON T' +
        '.ZAKAZ = IP.ZAKAZ'
      
        '11029137=                    LEFT OUTER JOIN INVOICE I ON T.ZAKA' +
        'Z = I.ZAKAZ'
      
        '11029138=                    LEFT OUTER JOIN WAYBILL W ON T.ZAKA' +
        'Z = W.ZAKAZ'
      
        '11029139=                    LEFT OUTER JOIN G_OFFICIAL O ON T.g' +
        '_official = O.g_official'
      
        '11029140=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11029141=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISANI' +
        'E_ = 0) or (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS_SPISANIE_ <> 0' +
        '))'
      
        '11029142=           AND T.G_TOCHKA = 1--(SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '11029143=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '11029144=        INTO :ZAKAZ,'
      '11029145=             :Z_NUM,'
      '11029146=             :G_TOCHKA,'
      '11029147=             :Z_DATE,'
      '11029148=             :Z_TIME,'
      '11029149=             :G_CLIENT,'
      '11029150=             :OSNOVANIE,'
      '11029151=             :NOTE,'
      '11029152=             :CLIENT_NAME,'
      '11029153=             :DETAILS_STR,'
      '11029154=             :IS_SPISANIE,'
      '11029155=             :IS_PAYED_ALL,'
      '11029156=             :INVOICE_PAY,'
      '11029157=             :INVOICE,'
      '11029158=             :WAYBILL,'
      '11029159=             :SUM_ZAKAZ,'
      '11029160=             :SUM_FACT,'
      '11029161=             :SUMM_PAY_BONUS,'
      '11029162=             :SUMM_BONUS_GOT,'
      '11029163=             :BY_RECIPE'
      '11029164=             ,:IS_RESERVE'
      '11029165=             ,:summ_cash'
      '11029166=             ,:SUMM_NONCASH'
      '11029167=             ,:G_OFFICIAL'
      '11029168=             ,:G_OFFICIAL_FIO'
      '11029169=      DO'
      '11029170=        suspend;'
      '11029171='
      '11029172=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '11029173=  END ELSE IF (IS_SPISANIE_ = 1) THEN BEGIN'
      '11029174=      FOR'
      '11029175=        SELECT T.ZAKAZ,'
      
        '11029176=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11029177=               T.G_TOCHKA,'
      '11029178=               T.Z_DATE,'
      '11029179=               T.Z_TIME,'
      '11029180=               T.G_CLIENT,'
      '11029181=               T.OSNOVANIE,'
      '11029182=               T.NOTE,'
      '11029183=               NULL,'
      '11029184=               SUBSTRING((SELECT'
      
        '11029185=                          LIST(G.NAME||'#39#39'('#39#39'||D.AMOUNT|' +
        '|'#39#39')'#39#39', '#39#39', '#39#39')'
      
        '11029186=                        FROM ZAKAZ_DETAILS D, G_PRODUCT' +
        ' G'
      '11029187=                        WHERE D.G_PRODUCT = G.G_PRODUCT'
      '11029188=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '11029189=                          GROUP BY ZAKAZ) FROM 1 FOR 99' +
        '9) DETAILS_STR,'
      '11029190=               T.IS_SPISANIE,'
      '11029191=               0,'
      '11029192=               NULL,'
      '11029193=               NULL,'
      '11029194=               NULL,'
      '11029195=               T.SUMM,'
      '11029196=               T.SUMM_FACT,'
      '11029197=               0,'
      '11029198=               0'
      '11029199=          FROM ZAKAZ T'
      
        '11029200=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '11029201=           AND T.IS_SPISANIE  = 1'
      
        '11029202=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11029203=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '11029204=        INTO :ZAKAZ,'
      '11029205=             :Z_NUM,'
      '11029206=             :G_TOCHKA,'
      '11029207=             :Z_DATE,'
      '11029208=             :Z_TIME,'
      '11029209=             :G_CLIENT,'
      '11029210=             :OSNOVANIE,'
      '11029211=             :NOTE,'
      '11029212=             :CLIENT_NAME,'
      '11029213=             :DETAILS_STR,'
      '11029214=             :IS_SPISANIE,'
      '11029215=             :IS_PAYED_ALL,'
      '11029216=             :INVOICE_PAY,'
      '11029217=             :INVOICE,'
      '11029218=             :WAYBILL,'
      '11029219=             :SUM_ZAKAZ,'
      '11029220=             :SUM_FACT,'
      '11029221=             :SUMM_PAY_BONUS,'
      '11029222=             :SUMM_BONUS_GOT'
      '11029223=      DO'
      '11029224=        suspend;'
      '11029225='
      '11029226=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11029227=  END ELSE BEGIN'
      '11029228=      FOR'
      '11029229=        SELECT T.SKLAD,'
      
        '11029230=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11029231=               T.G_TOCHKA,'
      '11029232=               T.DATE_RECEIPT,'
      '11029233=               T.TIME_RECEIPT,'
      '11029234=               T.G_CLIENT,'
      '11029235=               T.OSNOVANIE,'
      '11029236=               T.NOTE,'
      '11029237=               gc.name,'
      '11029238=               SUBSTRING((SELECT'
      
        '11029239=                            LIST(G.NAME||'#39#39'('#39#39'||D.AMOUN' +
        'T||'#39#39')'#39#39', '#39#39', '#39#39')'
      '11029240=                            FROM SKLAD D, G_PRODUCT G'
      
        '11029241=                           WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '11029242=                             AND D.SKLAD_PARENT = T.SKL' +
        'AD'
      
        '11029243=                            GROUP BY SKLAD_PARENT) FROM' +
        ' 1 FOR 999) DETAILS_STR,'
      '11029244=               T.SUMM,'
      '11029245=               T.IS_VOZVRAT,'
      '11029246=               W.WAYBILL'
      
        '11029247=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL W' +
        ' ON T.SKLAD = W.ZAKAZ,'
      '11029248=               G_TOCHKA GC'
      
        '11029249=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '11029250=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11029251=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '11029252=           AND T.IS_VOZVRAT = 3'
      '11029253=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '11029254=        INTO :ZAKAZ,'
      '11029255=             :Z_NUM,'
      '11029256=             :G_TOCHKA,'
      '11029257=             :Z_DATE,'
      '11029258=             :Z_TIME,'
      '11029259=             :G_CLIENT,'
      '11029260=             :OSNOVANIE,'
      '11029261=             :NOTE,'
      '11029262=             :CLIENT_NAME,'
      '11029263=             :DETAILS_STR,'
      '11029264=             :SUM_ZAKAZ,'
      '11029265=             :IS_SPISANIE,'
      '11029266=             :WAYBILL'
      '11029267=      DO'
      '11029268=        suspend;'
      '11029269=  END'
      '11029270=end'
      '11029271='#39';'
      '11029272=END  --END_EXECUTE_BLOCK'
      '110300=EXECUTE BLOCK AS BEGIN'
      
        '110301=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_NA_REAL_LIS' +
        'T('
      '110302=  MODE_ INTEGER)'
      '110303=RETURNS ('
      
        '110304=  ZAKAZ_NA_REAL TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA_REA' +
        'L,'
      '110305=  G_CLIENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_CLIENT,'
      '110306=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110307=  ZAKAZ_NUM TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVANIE,'
      '110308=  ZAKAZ_DATE TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_DATE,'
      
        '110309=  ZAKAZ_REAL_PARENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKA' +
        'Z_REAL_PARENT,'
      '1103010=  G_PRODUCT TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '1103011=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1103012=  PRICE TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      '1103013=  AMOUNT_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1103014=  SUMM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      
        '1103015=  AMOUNT_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PAYED' +
        ','
      '1103016=  SUMM_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '1103017=  AMOUNT_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_RE' +
        'TURNED,'
      '1103018=  SUMM_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1103019=  AMOUNT_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PAYED,'
      '1103020=  SUMM_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '1103021=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.IS_PAYED_ALL' +
        ','
      '1103022=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1103023=  PRODCAT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1103024=  AM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1103025=  SU_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL)'
      '1103026=AS'
      '1103027=begin'
      '1103028=  FOR SELECT Z.ZAKAZ_NA_REAL,'
      '1103029=             ZP.G_CLIENT,'
      '1103030=             C.NAME,'
      '1103031=             ZP.ZAKAZ_DATE,'
      '1103032=             Z.G_PRODUCT,'
      '1103033=             P.NAME,'
      '1103034=             Z.PRICE,'
      '1103035=             Z.AMOUNT_ALL,'
      '1103036=             Z.SUMM_ALL,'
      '1103037=             Z.AMOUNT_PAYED,'
      '1103038=             Z.SUMM_PAYED,'
      '1103039=             COALESCE(Z.AMOUNT_RETURNED, 0),'
      '1103040=             COALESCE(Z.SUMM_RETURNED, 0),'
      
        '1103041=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE(Z.' +
        'AMOUNT_RETURNED, 0),'
      
        '1103042=             Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.SUMM' +
        '_RETURNED, 0),'
      '1103043=             Z.IS_PAYED_ALL,'
      '1103044=             P.G_PRODUCT_PAR,'
      '1103045=             CAT.NAME,'
      '1103046=             ZP.ZAKAZ_REAL_PARENT,'
      '1103047=             ZP.OSNOVANIE,'
      '1103048=             ZT.AM_ALL,'
      '1103049=             ZT.SU_ALL'
      
        '1103050=        FROM ZAKAZ_REAL_PARENT ZP, ZAKAZ_NA_REAL Z, G_CL' +
        'IENT C, G_PRODUCT P, g_product CAT/*(select -1 g_product, '#39#39#1041#1077#1079' ' +
        #1075#1088#1091#1087#1087#1099#39#39' NAME FROM RDB$DATABASE'
      
        '1103051=                                                        ' +
        '                      UNION ALL'
      
        '1103052=                                                        ' +
        '                      SELECT g_product,  NAME FROM G_PRODUCT WHE' +
        'RE IS_CATEGORY = 1) CAT*/,'
      
        '1103053=             (SELECT SUM(ZZ.AMOUNT_ALL - ZZ.amount_payed' +
        ' - ZZ.amount_returned) AM_ALL,'
      
        '1103054=                     SUM(ZZ.SUMM_ALL - ZZ.summ_payed - Z' +
        'Z.summ_returned) SU_ALL,'
      '1103055=                     ZPP.G_CLIENT,'
      '1103056=                     ZPP.OSNOVANIE'
      '1103057=                FROM ZAKAZ_REAL_PARENT ZPP,'
      '1103058=                     ZAKAZ_NA_REAL ZZ'
      
        '1103059=               WHERE ZPP.ZAKAZ_REAL_PARENT = ZZ.ZAKAZ_RE' +
        'AL_PARENT'
      '1103060=               GROUP BY ZPP.G_CLIENT, ZPP.OSNOVANIE) ZT'
      
        '1103061=       WHERE ZP.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1103062=         AND ZP.G_CLIENT = C.G_CLIENT'
      '1103063=         AND ZP.ZAKAZ_REAL_PARENT = Z.ZAKAZ_REAL_PARENT'
      '1103064=         AND Z.G_PRODUCT = P.G_PRODUCT'
      '1103065=         AND P.G_PRODUCT_par = CAT.G_PRODUCT'
      '1103066=         AND ZP.G_CLIENT = ZT.G_CLIENT'
      '1103067=         AND ZP.OSNOVANIE = ZT.OSNOVANIE'
      '1103068=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      '1103069=         AND ((Z.IS_PAYED_ALL = 0 AND :MODE_ = 0)'
      '1103070=              OR'
      
        '1103071=              (Z.IS_PAYED_ALL = 1 AND Z.AMOUNT_PAYED > 0' +
        ' AND :MODE_ = 1)'
      '1103072=              OR'
      
        '1103073=              (COALESCE(Z.AMOUNT_RETURNED, 0) > 0 AND :M' +
        'ODE_ = 2)'
      '1103074=              OR'
      '1103075=              :MODE_ = 3)'
      '1103076=       ORDER BY C.NAME, ZP.ZAKAZ_DATE'
      '1103077=      INTO :ZAKAZ_NA_REAL,'
      '1103078=           :G_CLIENT,'
      '1103079=           :CLIENT_NAME,'
      '1103080=           :ZAKAZ_DATE,'
      '1103081=           :G_PRODUCT,'
      '1103082=           :PRODUCT_NAME,'
      '1103083=           :PRICE,'
      '1103084=           :AMOUNT_ALL,'
      '1103085=           :SUMM_ALL,'
      '1103086=           :AMOUNT_PAYED,'
      '1103087=           :SUMM_PAYED,'
      '1103088=           :AMOUNT_RETURNED,'
      '1103089=           :SUMM_RETURNED,'
      '1103090=           :AMOUNT_LEFT,'
      '1103091=           :SUMM_LEFT,'
      '1103092=           :IS_PAYED_ALL,'
      '1103093=           :G_PRODUCT_PAR,'
      '1103094=           :PRODCAT_NAME,'
      '1103095=           :ZAKAZ_REAL_PARENT,'
      '1103096=           :ZAKAZ_NUM,'
      '1103097=           :AM_ALL,'
      '1103098=           :SU_ALL'
      '1103099=  DO'
      '11030100=    suspend;'
      '11030101=end'
      '11030102='#39';'
      '11030103='
      '11030104=EXECUTE STATEMENT '#39'ALTER PROCEDURE RECALC_SELF_PRICES('
      '11030105=  DATE_ DATE)'
      '11030106=AS'
      '11030107=/*'
      
        '11030108='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048', '#1063#1058#1054#1041#1067' '#1055#1045#1056#1045#1057#1063#1048 +
        #1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1067#1045' '#1062#1045#1053#1067' '#1055#1054' '#1040#1050#1058#1059#1040#1051#1068#1053#1067#1052' '#1047#1053#1040#1063#1045#1053#1048#1071#1052'.'
      
        '11030109='#1069#1058#1054' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1052#1040#1043#1040#1047#1048#1053#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1055#1056#1054#1044#1040#1070#1058' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1047#1040#1050 +
        #1040#1047'. '#1058#1054' '#1045#1057#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1054#1060#1054#1056#1052#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059', '#1040' '#1055#1054#1058#1054#1052' '#1050#1059#1055#1048#1051#1048' '#1058#1054#1042#1040#1056' '#1048' '#1054#1060#1054 +
        #1056#1052#1048#1051#1048' '#1055#1056#1048#1061#1054#1044','
      
        '11030110='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1046#1045' '#1054#1058' '#1069#1058#1054#1043#1054' '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071',' +
        ' '#1045#1045' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054'.'
      '11030111='#1055#1056#1048' '#1056#1040#1057#1063#1045#1058#1045' '#1041#1059#1044#1059' '#1054#1058#1058#1040#1051#1050#1048#1042#1040#1058#1068#1057#1071' '#1054#1058' '#1044#1040#1058#1067' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11030112=*/'
      
        '11030113=declare variable FORMULA_ type of column SYSTEM_SETUP.S' +
        '_VALUE;'
      
        '11030114=declare variable G_PRODUCT_ type of column ZAKAZ_DETAIL' +
        'S.G_PRODUCT;'
      
        '11030115=declare variable G_TOCHKA_ type of column G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11030116=declare variable PRICE_ type of column ZAKAZ_DETAILS.CO' +
        'ST_PRICE;'
      '11030117=BEGIN'
      '11030118=  IF (G_TOCHKA_ IS NULL) THEN'
      '11030119=    SELECT ID'
      '11030120=      FROM CUR_PARAMS'
      '11030121=     WHERE CUR_PARAMS = 2'
      '11030122=      INTO :G_TOCHKA_;'
      '11030123='
      '11030124=  SELECT S.S_VALUE'
      '11030125=    FROM SYSTEM_SETUP S'
      '11030126=   WHERE S.SYSTEM_SETUP = 1'
      '11030127=    INTO :FORMULA_;'
      '11030128='
      '11030129=  FOR SELECT T.G_PRODUCT'
      '11030130=        FROM ZAKAZ_DETAILS_TMP T'
      '11030131=       GROUP BY T.G_PRODUCT'
      '11030132=        INTO :G_PRODUCT_'
      '11030133=  DO BEGIN'
      '11030134=    IF (FORMULA_ = 1) THEN'
      '11030135=        SELECT S.PRICE'
      '11030136=          FROM SKLAD S'
      '11030137=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '11030138=                            FROM SKLAD SS'
      
        '11030139=                           WHERE SS.G_TOCHKA = :G_TOCHK' +
        'A_'
      
        '11030140=                             AND SS.G_PRODUCT = :G_PROD' +
        'UCT_'
      
        '11030141=                             AND SS.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '11030142=                             AND SS.DATE_RECEIPT = (SEL' +
        'ECT MAX(SSS.DATE_RECEIPT) FROM SKLAD SSS'
      
        '11030143=                                                     WH' +
        'ERE SSS.DATE_RECEIPT <= :DATE_'
      
        '11030144=                                                       ' +
        'AND SSS.G_TOCHKA = :G_TOCHKA_'
      
        '11030145=                                                       ' +
        'AND SSS.G_PRODUCT = :G_PRODUCT_'
      
        '11030146=                                                       ' +
        'AND SSS.IS_VOZVRAT IN (0, 3, 4))'
      '11030147=                         )'
      '11030148=          INTO :PRICE_;'
      '11030149=    ELSE'
      
        '11030150=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT' +
        '), 2)'
      '11030151=        FROM (SELECT S.AMOUNT, S.PRICE'
      '11030152=                FROM SKLAD_PARENT SP,'
      '11030153=                     SKLAD S'
      '11030154=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '11030155=                 AND SP.DATE_RECEIPT <= :DATE_'
      '11030156=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '11030157=                 AND S.G_PRODUCT = :G_PRODUCT_'
      '11030158=                 AND SP.IS_VOZVRAT IN (0, 3, 4)'
      
        '11030159=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO ' +
        '5) T'
      '11030160=        INTO :PRICE_;'
      '11030161='
      '11030162=    UPDATE ZAKAZ_DETAILS_TMP M'
      '11030163=       SET M.COST_PRICE = :PRICE_'
      '11030164=     WHERE M.G_PRODUCT = :G_PRODUCT_;'
      '11030165=  END'
      '11030166=END'
      '11030167='#39';'
      '11030168=END  --END_EXECUTE_BLOCK'
      '110310=EXECUTE BLOCK'
      '110312=AS'
      '110313=  declare variable FORMULA_ TYPE OF MY_NUMERIC;'
      '110314=  declare variable ZAKAZ_DETAILS_ INTEGER;'
      '110315=  declare variable Z_DATE_ DATE;'
      '110316=  declare variable G_TOCHKA_ INTEGER;'
      '110317=  declare variable G_PRODUCT_ INTEGER;'
      '110318=  declare variable COST_PRICE_ TYPE OF MY_NUMERIC;'
      '110319=BEGIN'
      
        '1103110=  SELECT S_VALUE FROM SYSTEM_SETUP S WHERE S.SYSTEM_SETU' +
        'P = 1 INTO :FORMULA_;'
      '1103111=  FOR SELECT ZD.ZAKAZ_DETAILS,'
      '1103112=             Z.Z_DATE,'
      '1103113=             Z.G_TOCHKA,'
      '1103114=             ZD.G_PRODUCT'
      '1103115=        FROM ZAKAZ_DETAILS ZD,'
      '1103116=             ZAKAZ Z'
      '1103117=       WHERE Z.ZAKAZ = ZD.ZAKAZ'
      '1103118=         AND ZD.COST_PRICE = 0'
      '1103119=       ORDER BY ZAKAZ_DETAILS'
      '1103120=        INTO :ZAKAZ_DETAILS_,'
      '1103121=             :Z_DATE_,'
      '1103122=             :G_TOCHKA_,'
      '1103123=             :G_PRODUCT_'
      '1103124=  DO BEGIN'
      '1103125=    IF (FORMULA_ = 0) THEN BEGIN'
      
        '1103126=        SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUN' +
        'T), 2)'
      '1103127=        FROM (SELECT S.AMOUNT, S.PRICE'
      '1103128=                FROM SKLAD_PARENT SP,'
      '1103129=                     SKLAD S'
      '1103130=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '1103131=                 AND SP.DATE_RECEIPT <= :Z_DATE_'
      '1103132=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '1103133=                 AND S.G_PRODUCT = :G_PRODUCT_'
      '1103134=                 AND SP.IS_VOZVRAT IN (0, 3)'
      
        '1103135=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO 5' +
        ') T'
      '1103136=          INTO :COST_PRICE_;'
      '1103137=    END ELSE BEGIN'
      '1103138=        SELECT S.PRICE'
      '1103139=          FROM SKLAD S'
      '1103140=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1103141=                            FROM SKLAD SS'
      
        '1103142=                           WHERE SS.G_TOCHKA = :G_TOCHKA' +
        '_'
      
        '1103143=                             AND SS.G_PRODUCT = :G_PRODU' +
        'CT_'
      
        '1103144=                             AND SS.DATE_RECEIPT = (SELE' +
        'CT MAX(SSS.DATE_RECEIPT)'
      
        '1103145=                                                      FR' +
        'OM SKLAD SSS'
      
        '1103146=                                                     WHE' +
        'RE SSS.G_TOCHKA = :G_TOCHKA_'
      
        '1103147=                                                       A' +
        'ND SSS.G_PRODUCT = :G_PRODUCT_'
      
        '1103148=                                                       A' +
        'ND SSS.DATE_RECEIPT <= :Z_DATE_)'
      '1103149=                         )'
      '1103150=          INTO :COST_PRICE_;'
      '1103151=    END'
      '1103152='
      '1103153=    UPDATE ZAKAZ_DETAILS ZD'
      '1103154=       SET ZD.COST_PRICE = :COST_PRICE_'
      '1103155=     WHERE ZD.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1103156=  END'
      '1103157=END  --END_EXECUTE_BLOCK'
      '110320=EXECUTE BLOCK AS BEGIN'
      '110321=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_CLIENT('
      '110322=  G_CLIENT_ INTEGER)'
      '110323=RETURNS ('
      '110324=  G_CLIENT_PARENT_ INTEGER,'
      '110325=  G_CONTRAGENT_ INTEGER,'
      '110326=  NAME_ VARCHAR(500),'
      
        '110327=  NAME_FULL_ /* TYPE OF COLUMN G_CLIENT.NAME_FULL */ VARC' +
        'HAR(250),'
      '110328=  IDN_ VARCHAR(12),'
      '110329=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50),'
      '1103210=  KBE_ VARCHAR(5),'
      '1103211=  SKIDKA_ NUMERIC(15,2),'
      '1103212=  BY_DEFAULT_ INTEGER,'
      '1103213=  IS_BEZNAL_ INTEGER,'
      
        '1103214=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '1103215=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      
        '1103216=  SUMM_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM */ NUMERIC' +
        '(15,2),'
      
        '1103217=  SUMM_ALL_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL */' +
        ' NUMERIC(15,2),'
      '1103218=  NOTE_ /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200),'
      '1103219=  DT_ /* TYPE OF COLUMN G_CLIENT.DT */ DATE,'
      
        '1103220=  G_PROMOTION_ /* TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ' */ INTEGER,'
      
        '1103221=  G_PROMOTION_STR_ /* TYPE OF COLUMN G_PROMOTION.NAME */' +
        ' VARCHAR(150),'
      '1103222=  NOTIFY_SKIDKA_ INTEGER,'
      '1103223=  NOTIFY_DR_ INTEGER,'
      '1103224=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '1103225=  ERR_CODE INTEGER,'
      '1103226=  ERR_MSG VARCHAR(1024))'
      '1103227=AS'
      '1103228=BEGIN'
      '1103229=  SUSPEND;'
      '1103230=END'
      '1103231='#39';'
      '1103232='
      '1103233=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_CLIENT('
      '1103234=  G_CLIENT_PARENT_ INTEGER,'
      '1103235=  G_CONTRAGENT_ INTEGER,'
      '1103236=  NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHAR(250),'
      
        '1103237=  NAME_FULL_ /* TYPE OF COLUMN G_CLIENT.NAME_FULL */ VAR' +
        'CHAR(250),'
      '1103238=  IDN_ VARCHAR(12),'
      '1103239=  KBE_ VARCHAR(5),'
      '1103240=  SKIDKA_ NUMERIC(15,2),'
      
        '1103241=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
        ','
      '1103242=  DT_ /* TYPE OF COLUMN G_CLIENT.DT */ DATE,'
      '1103243=  BY_DEFAULT_ INTEGER,'
      '1103244=  IS_SUPPLIER_ INTEGER,'
      '1103245=  IS_CATEGORY_ INTEGER,'
      '1103246=  IS_BEZNAL_ INTEGER,'
      
        '1103247=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '1103248=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      '1103249=  NOTE_ /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200),'
      
        '1103250=  G_PROMOTION_ /* TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ' */ INTEGER,'
      '1103251=  NOTIFY_SKIDKA_ INTEGER,'
      '1103252=  NOTIFY_DR_ INTEGER,'
      '1103253=  IS_PAYING_ONLY_MASTER_ INTEGER)'
      '1103254=RETURNS ('
      '1103255=  G_CLIENT_ INTEGER,'
      '1103256=  ERR_CODE INTEGER,'
      '1103257=  ERR_MSG VARCHAR(1024))'
      '1103258=AS'
      '1103259=BEGIN'
      '1103260=  SUSPEND;'
      '1103261=END'
      '1103262='#39';'
      '1103263='
      '1103264=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_CLIENT('
      
        '1103265=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ INTEG' +
        'ER,'
      
        '1103266=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT */ INTEGER,'
      
        '1103267=  G_CONTRAGENT_ /* TYPE OF COLUMN G_CLIENT.G_CONTRAGENT ' +
        '*/ INTEGER,'
      '1103268=  NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHAR(250),'
      
        '1103269=  NAME_FULL_ /* TYPE OF COLUMN G_CLIENT.NAME_FULL */ VAR' +
        'CHAR(250),'
      '1103270=  IDN_ /* TYPE OF COLUMN G_CLIENT.IDN */ VARCHAR(12),'
      '1103271=  KBE_ /* TYPE OF COLUMN G_CLIENT.KBE */ VARCHAR(5),'
      
        '1103272=  SKIDKA_ /* TYPE OF COLUMN G_CLIENT.SKIDKA */ NUMERIC(1' +
        '5,2),'
      
        '1103273=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
        ','
      '1103274=  DT_ /* TYPE OF COLUMN G_CLIENT.DT */ DATE,'
      
        '1103275=  IS_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.IS_SUPPLIER */' +
        ' INTEGER,'
      
        '1103276=  BY_DEFAULT_ /* TYPE OF COLUMN G_CLIENT.BY_DEFAULT */ I' +
        'NTEGER,'
      
        '1103277=  IS_CATEGORY_ /* TYPE OF COLUMN G_CLIENT.IS_CATEGORY */' +
        ' INTEGER,'
      
        '1103278=  IS_BEZNAL_ /* TYPE OF COLUMN G_CLIENT.IS_BEZNAL */ INT' +
        'EGER,'
      
        '1103279=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '1103280=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      '1103281=  NOTE_ /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200),'
      
        '1103282=  G_PROMOTION_ /* TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ' */ INTEGER,'
      '1103283=  NOTIFY_SKIDKA_ INTEGER,'
      '1103284=  NOTIFY_DR_ INTEGER,'
      '1103285=  IS_PAYING_ONLY_MASTER_ INTEGER)'
      '1103286=RETURNS ('
      '1103287=  ERR_CODE INTEGER,'
      '1103288=  ERR_MSG VARCHAR(1024))'
      '1103289=AS'
      '1103290=BEGIN'
      '1103291=  SUSPEND;'
      '1103292=END'
      '1103293='#39';'
      '1103294='
      '1103295='
      '1103296=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_CLIENT('
      '1103297=  G_CLIENT_ INTEGER)'
      '1103298=RETURNS ('
      '1103299=  G_CLIENT_PARENT_ INTEGER,'
      '11032100=  G_CONTRAGENT_ INTEGER,'
      '11032101=  NAME_ VARCHAR(500),'
      '11032102=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11032103=  IDN_ VARCHAR(12),'
      '11032104=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11032105=  KBE_ VARCHAR(5),'
      '11032106=  SKIDKA_ NUMERIC(15,2),'
      '11032107=  BY_DEFAULT_ INTEGER,'
      '11032108=  IS_BEZNAL_ INTEGER,'
      '11032109=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11032110=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11032111=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '11032112=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '11032113=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11032114=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11032115=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11032116=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '11032117=  NOTIFY_SKIDKA_ INTEGER,'
      '11032118=  NOTIFY_DR_ INTEGER,'
      '11032119=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '11032120=  ERR_CODE INTEGER,'
      '11032121=  ERR_MSG VARCHAR(1024))'
      '11032122=AS'
      '11032123=begin'
      '11032124=    SELECT'
      
        '11032125=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE, ' +
        'SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '11032126=      ,P.G_PROMOTION'
      '11032127=      ,P.NAME'
      '11032128=      ,notify_dr'
      '11032129=      ,notify_skidka'
      
        '11032130=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T.' +
        'g_promotion = P.g_promotion'
      '11032131=    WHERE T.G_CLIENT = :G_CLIENT_'
      '11032132=    INTO'
      
        '11032133=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_,' +
        ' :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :DT' +
        '_, :NAME_FULL_'
      '11032134=      ,:G_PROMOTION_'
      '11032135=      ,:G_PROMOTION_STR_'
      '11032136=      ,:NOTIFY_DR_'
      '11032137=      ,:NOTIFY_SKIDKA_'
      '11032138=      ;'
      '11032139='
      '11032140=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '11032141=    FROM G_DISCONT_CARD'
      '11032142=    WHERE G_CLIENT = :G_CLIENT_'
      '11032143=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '11032144=end'
      '11032145='#39';'
      '11032146='
      '11032147=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_CLIENT('
      '11032148=  G_CLIENT_PARENT_ INTEGER,'
      '11032149=  G_CONTRAGENT_ INTEGER,'
      '11032150=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11032151=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11032152=  IDN_ VARCHAR(12),'
      '11032153=  KBE_ VARCHAR(5),'
      '11032154=  SKIDKA_ NUMERIC(15,2),'
      '11032155=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11032156=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11032157=  BY_DEFAULT_ INTEGER,'
      '11032158=  IS_SUPPLIER_ INTEGER,'
      '11032159=  IS_CATEGORY_ INTEGER,'
      '11032160=  IS_BEZNAL_ INTEGER,'
      '11032161=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11032162=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11032163=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11032164=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11032165=  NOTIFY_SKIDKA_ INTEGER,'
      '11032166=  NOTIFY_DR_ INTEGER,'
      '11032167=  IS_PAYING_ONLY_MASTER_ INTEGER)'
      '11032168=RETURNS ('
      '11032169=  G_CLIENT_ INTEGER,'
      '11032170=  ERR_CODE INTEGER,'
      '11032171=  ERR_MSG VARCHAR(1024))'
      '11032172=AS'
      '11032173=declare variable CNT_ integer;'
      '11032174=begin'
      
        '11032175=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1' +
        ', '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11032176=    if (BY_DEFAULT_ = 1) then'
      '11032177=      UPDATE g_client'
      '11032178=         SET BY_DEFAULT = 0'
      '11032179=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11032180='
      
        '11032181=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G_' +
        'CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '11032182=                          IS_CATEGORY, IS_BEZNAL, PHONE' +
        ', NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR)'
      
        '11032183=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_,' +
        ' :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_, ' +
        ':BY_DEFAULT_,'
      
        '11032184=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE_' +
        ', :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR_' +
        ')'
      '11032185=    returning G_CLIENT'
      '11032186=    into :G_CLIENT_;'
      '11032187='
      '11032188=    if (IS_CATEGORY_ = 0) then BEGIN'
      '11032189=        IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11032190=            SELECT COUNT(*)'
      '11032191=              FROM G_DISCONT_CARD'
      '11032192=             WHERE BARCODE = :BARCODE_'
      
        '11032193=             AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040 +
        #1049#1058#1048' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11032194=             INTO :CNT_;'
      '11032195='
      '11032196=            IF (CNT_ > 0) THEN BEGIN'
      '11032197=              ERR_CODE = -20500;'
      
        '11032198=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39 +
        #39') RETURNING_VALUES (:ERR_MSG);'
      '11032199=              EXIT;'
      '11032200=            END'
      '11032201=        END'
      '11032202='
      
        '11032203=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11032204=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, 0, 0);'
      '11032205=    END'
      '11032206=end'
      '11032207='#39';'
      '11032208='
      '11032209=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_CLIENT('
      '11032210=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11032211=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      '11032212=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '11032213=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11032214=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11032215=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '11032216=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '11032217=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '11032218=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11032219=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11032220=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '11032221=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '11032222=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '11032223=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '11032224=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11032225=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11032226=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11032227=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11032228=  NOTIFY_SKIDKA_ INTEGER,'
      '11032229=  NOTIFY_DR_ INTEGER,'
      '11032230=  IS_PAYING_ONLY_MASTER_ INTEGER)'
      '11032231=RETURNS ('
      '11032232=  ERR_CODE INTEGER,'
      '11032233=  ERR_MSG VARCHAR(1024))'
      '11032234=AS'
      '11032235=declare variable CNT_ integer;'
      '11032236=BEGIN'
      
        '11032237=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1, ' +
        #1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11032238=  if (BY_DEFAULT_ = 1) then'
      '11032239=    UPDATE g_client'
      '11032240=       SET BY_DEFAULT = 0'
      '11032241=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11032242='
      '11032243=  UPDATE g_client'
      '11032244=  SET'
      
        '11032245=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CLIE' +
        'NT_PARENT),'
      
        '11032246=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTRAG' +
        'ENT),'
      '11032247=   NAME = COALESCE(:NAME_, NAME),'
      '11032248=   IDN  = COALESCE(:IDN_, IDN),'
      '11032249=   KBE  = COALESCE(:KBE_, KBE),'
      '11032250=   PHONE = COALESCE(:PHONE_, PHONE),'
      '11032251=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '11032252=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      '11032253=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER),'
      '11032254=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '11032255=   ,DT    = COALESCE(:DT_, DT)'
      '11032256=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '11032257=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '11032258=   ,G_PROMOTION = :G_PROMOTION_'
      '11032259=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '11032260=   ,NOTIFY_DR = :NOTIFY_DR_'
      '11032261=  WHERE'
      '11032262=    g_client = :g_client_;'
      '11032263='
      '11032264=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '11032265=    IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11032266=        SELECT COUNT(*)'
      '11032267=          FROM G_DISCONT_CARD'
      '11032268=         WHERE BARCODE = :BARCODE_'
      
        '11032269=         AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040#1049#1058#1048' ' +
        #1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11032270=         INTO :CNT_;'
      '11032271='
      '11032272=        IF (CNT_ > 0) THEN BEGIN'
      '11032273=          ERR_CODE = -20500;'
      
        '11032274=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1050#1072#1088 +
        #1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11032275=          EXIT;'
      '11032276=        END'
      '11032277=    END'
      '11032278='
      '11032279=    UPDATE G_DISCONT_CARD G'
      '11032280=    SET G.BARCODE = :BARCODE_,'
      '11032281=        G.N_PERCENT = :N_PERCENT_,'
      '11032282=        G.summ = COALESCE(G.summ, 0),'
      '11032283=        G.summ_all = COALESCE(G.summ_all, 0)'
      '11032284=    WHERE G.G_CLIENT = :g_client_;'
      '11032285='
      '11032286=    if (ROW_COUNT = 0) then'
      
        '11032287=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_CLI' +
        'ENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11032288=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIENT_' +
        ', :BARCODE_, :N_PERCENT_, 0, (select Coalesce(sum(SUMM_FACT), 0)' +
        ' from zakaz where g_client = :g_client_));'
      '11032289=  END'
      '11032290=end'
      '11032291='#39';'
      '11032292='
      '11032293=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_LIST('
      '11032294=  DATE_BEGIN_ DATE,'
      '11032295=  DATE_END_ DATE,'
      '11032296=  IS_SPISANIE_ INTEGER)'
      '11032297=RETURNS ('
      '11032298=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11032299=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11032300=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '11032301=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11032302=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11032303=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11032304=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11032305=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '11032306=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11032307=  DETAILS_STR VARCHAR(3000),'
      '11032308=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11032309=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '11032310=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '11032311=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '11032312=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '11032313=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11032314=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11032315=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11032316=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11032317=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11032318=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '11032319=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11032320=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11032321=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11032322=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC)'
      '11032323=AS'
      '11032324=/*'
      '11032325=IS_SPISANIE_'
      '11032326=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11032327=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11032328=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11032329=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11032330=*/'
      '11032331=declare variable CNT_ integer = 0;'
      '11032332=BEGIN'
      '11032333='
      '11032334=  if (IS_SPISANIE_ <> 3) then BEGIN'
      '11032335=      SELECT COUNT(*)'
      '11032336=        FROM ZAKAZ T'
      
        '11032337=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '11032338=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHE' +
        'RE CUR_PARAMS = 2)'
      '11032339=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '11032340=        INTO CNT_;'
      '11032341='
      '11032342=      if (CNT_ = 0) then'
      '11032343=        SELECT MAX(T.Z_DATE)'
      '11032344=          FROM ZAKAZ T'
      '11032345=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '11032346=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '11032347=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032348=          INTO :DATE_BEGIN_;'
      '11032349='
      '11032350=  END ELSE BEGIN'
      '11032351=      SELECT COUNT(*)'
      '11032352=        FROM SKLAD_PARENT T'
      
        '11032353=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '11032354=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11032355=        INTO CNT_;'
      '11032356='
      '11032357=      if (CNT_ = 0) then'
      '11032358=        SELECT MAX(T.DATE_RECEIPT)'
      '11032359=          FROM SKLAD_PARENT T'
      '11032360=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '11032361=           AND T.IS_VOZVRAT = 3'
      
        '11032362=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032363=          INTO :DATE_BEGIN_;'
      '11032364=  END'
      '11032365='
      '11032366=  -- '#1055#1056#1054#1044#1040#1046#1048
      '11032367=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '11032368=      FOR'
      '11032369=        SELECT T.ZAKAZ,'
      
        '11032370=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11032371=               T.G_TOCHKA,'
      '11032372=               T.Z_DATE,'
      '11032373=               T.Z_TIME,'
      '11032374=               T.G_CLIENT,'
      '11032375=               T.OSNOVANIE,'
      '11032376=               T.NOTE,'
      '11032377=               gc.name,'
      
        '11032378=               /*SUBSTRING((SELECT LIST(NAME||'#39#39'('#39#39'||AM' +
        'OUNT||'#39#39')'#39#39', '#39#39', '#39#39')'
      
        '11032379=                            FROM (SELECT G.name, SUM(D.' +
        'amount) AMOUNT'
      
        '11032380=                                    FROM ZAKAZ Z, ZAKAZ' +
        '_DETAILS D, G_PRODUCT G'
      
        '11032381=                                   WHERE D.G_PRODUCT = ' +
        'G.G_PRODUCT'
      
        '11032382=                                     AND D.ZAKAZ = Z.ZA' +
        'KAZ'
      
        '11032383=                                     AND Z.ZAKAZ = T.ZA' +
        'KAZ'
      '11032384=                                   GROUP BY G.name)'
      
        '11032385=                          ) FROM 1 FOR 1500)*/'#39#39' '#39#39' DET' +
        'AILS_STR,'
      '11032386=               T.IS_SPISANIE,'
      
        '11032387=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_ALL' +
        ','
      '11032388=               IP.INVOICE_PAY,'
      '11032389=               I.INVOICE,'
      '11032390=               W.WAYBILL,'
      '11032391=               T.SUMM,'
      '11032392=               T.SUMM_FACT,'
      '11032393=               COALESCE(t.SUMM_BONUS, 0),'
      '11032394=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '11032395=               COALESCE(T.BY_RECIPE, 0)'
      '11032396=               ,IS_RESERVE'
      '11032397=               ,T.SUMM_CASH'
      '11032398=               ,T.SUMM_NONCASH'
      '11032399=               ,O.g_official'
      '11032400=               ,COALESCE(O.fio_doc, O.FM||'#39#39' '#39#39'||O.nm)'
      '11032401=          FROM ZAKAZ T'
      
        '11032402=                    LEFT OUTER JOIN G_CLIENT GC ON T.G_' +
        'CLIENT = GC.G_CLIENT'
      
        '11032403=                    LEFT OUTER JOIN INVOICE_PAY IP ON T' +
        '.ZAKAZ = IP.ZAKAZ'
      
        '11032404=                    LEFT OUTER JOIN INVOICE I ON T.ZAKA' +
        'Z = I.ZAKAZ'
      
        '11032405=                    LEFT OUTER JOIN WAYBILL W ON T.ZAKA' +
        'Z = W.ZAKAZ'
      
        '11032406=                    LEFT OUTER JOIN G_OFFICIAL O ON T.g' +
        '_official = O.g_official'
      
        '11032407=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11032408=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISANI' +
        'E_ = 0) or (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS_SPISANIE_ <> 0' +
        '))'
      
        '11032409=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032410=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '11032411=        INTO :ZAKAZ,'
      '11032412=             :Z_NUM,'
      '11032413=             :G_TOCHKA,'
      '11032414=             :Z_DATE,'
      '11032415=             :Z_TIME,'
      '11032416=             :G_CLIENT,'
      '11032417=             :OSNOVANIE,'
      '11032418=             :NOTE,'
      '11032419=             :CLIENT_NAME,'
      '11032420=             :DETAILS_STR,'
      '11032421=             :IS_SPISANIE,'
      '11032422=             :IS_PAYED_ALL,'
      '11032423=             :INVOICE_PAY,'
      '11032424=             :INVOICE,'
      '11032425=             :WAYBILL,'
      '11032426=             :SUM_ZAKAZ,'
      '11032427=             :SUM_FACT,'
      '11032428=             :SUMM_PAY_BONUS,'
      '11032429=             :SUMM_BONUS_GOT,'
      '11032430=             :BY_RECIPE'
      '11032431=             ,:IS_RESERVE'
      '11032432=             ,:summ_cash'
      '11032433=             ,:SUMM_NONCASH'
      '11032434=             ,:G_OFFICIAL'
      '11032435=             ,:G_OFFICIAL_FIO'
      '11032436=      DO'
      '11032437=        suspend;'
      '11032438='
      '11032439=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '11032440=  END ELSE IF (IS_SPISANIE_ = 1) THEN BEGIN'
      '11032441=      FOR'
      '11032442=        SELECT T.ZAKAZ,'
      
        '11032443=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11032444=               T.G_TOCHKA,'
      '11032445=               T.Z_DATE,'
      '11032446=               T.Z_TIME,'
      '11032447=               T.G_CLIENT,'
      '11032448=               T.OSNOVANIE,'
      '11032449=               T.NOTE,'
      '11032450=               NULL,'
      '11032451=               SUBSTRING((SELECT'
      
