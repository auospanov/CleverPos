        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '110391143=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110391144=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '110391145='
      
        '110391146=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' ' +
        #1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '110391147=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053#1054 +
        #1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '110391148=      IF (IS_VOZVRAT_ = 0) THEN'
      '110391149=        G_PRIHOD_RASHOD_ = 2;'
      '110391150=      ELSE'
      '110391151=        G_PRIHOD_RASHOD_ = 3;'
      '110391152='
      '110391153=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110391154=            PNT_ = '#39#39'09'#39#39';'
      '110391155=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110391156=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110391157=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110391158=            ELSE'
      
        '110391159=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110391160='
      '110391161=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110391162=                RETURNING_VALUES :KASSA_, :PAYMENT_DAT' +
        'E_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110391163='
      
        '110391164=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110391165=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THEN'
      
        '110391166=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110391167=                                              :G_PRIHO' +
        'D_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110391168=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110391169=                                              :PAYMENT' +
        '_DATE_,'
      
        '110391170=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110391171=                                              NULL,   ' +
        '--ZAKAZ_'
      
        '110391172=                                              :SKLAD_P' +
        'ARENT_,'
      
        '110391173=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110391174=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110391175='
      
        '110391176=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058 +
        #1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '110391177=            ELSE BEGIN'
      
        '110391178=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048 +
        #1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '110391179=                SELECT 1'
      '110391180=                  FROM KASSA K'
      '110391181=                 WHERE K.KASSA = :KASSA_'
      '110391182=                UNION ALL'
      '110391183=                SELECT 2'
      '110391184=                  FROM KASSA_BEZNAL KB'
      '110391185=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110391186=                 INTO :PAYMENT_TYPE_OLD_;'
      '110391187='
      
        '110391188=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110391189=                      PNT_ = '#39#39'010'#39#39';'
      
        '110391190=                      EXECUTE PROCEDURE K_UPD_KASSA(:K' +
        'ASSA_,'
      
        '110391191=                                                    1,' +
        '     -- ACTION_'
      
        '110391192=                                                    :G' +
        '_PRIHOD_RASHOD_,'
      
        '110391193=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110391194=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110391195=                                                    NU' +
        'LL,   --NOTE_'
      
        '110391196=                                                    NU' +
        'LL,  --ZAKAZ'
      
        '110391197=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110391198=                                                    :P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110391199='
      
        '110391200=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040 +
        #1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110391201=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040 +
        #1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110391202=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110391203=                      PNT_ = '#39#39'011'#39#39';'
      
        '110391204=                      EXECUTE PROCEDURE K_DEL_KASSA(:K' +
        'ASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG' +
        ');'
      '110391205=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391206=                        ERR_MSG = PROCNAME||'#39#39' -> PNT_' +
        ' '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110391207=                        EXIT;'
      '110391208=                      END'
      '110391209='
      
        '110391210=                      EXECUTE PROCEDURE K_INS_KASSA(1,' +
        '     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110391211=                                                    :G' +
        '_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110391212=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110391213=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110391214=                                                    NU' +
        'LL,   --NOTE_ => :NOTE_,'
      
        '110391215=                                                    NU' +
        'LL,   --ZAKAZ_'
      
        '110391216=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110391217=                                                    :P' +
        'AYMENT_TYPE_,'
      
        '110391218=                                                    :G' +
        '_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110391219=                END'
      '110391220=            END'
      '110391221=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391222=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110391223=              EXIT;'
      '110391224=            END'
      '110391225='
      
        '110391226=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~'#39#39'; ' +
        '  -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '110391227=      END'
      '110391228='
      
        '110391229=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059#1044 +
        #1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '110391230=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110391231=            FROM KASSA K'
      '110391232=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110391233=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA||'#39#39'~'#39#39
      '110391234=           UNION'
      '110391235=          SELECT KASSA, 1 PAYMENT_TYPE'
      '110391236=            FROM KASSA K'
      '110391237=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110391238=             AND K.SUMM = 0'
      '110391239=          UNION'
      '110391240=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110391241=            FROM KASSA_BEZNAL K'
      '110391242=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110391243=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA_BEZNAL||'#39#39'~'#39#39
      '110391244=          UNION'
      '110391245=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110391246=            FROM KASSA_BEZNAL K'
      '110391247=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110391248=             AND K.SUMM = 0'
      '110391249=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110391250=      DO BEGIN'
      '110391251=        PNT_ = '#39#39'011A'#39#39';'
      
        '110391252=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYMEN' +
        'T_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110391253=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391254=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110391255=          EXIT;'
      '110391256=        END'
      '110391257=      END'
      '110391258=  END'
      '110391259='
      
        '110391260=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      '110391261=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110391262=    SELECT K.KASSA'
      '110391263=      FROM KASSA K'
      '110391264=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110391265=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110391266=      INTO :KASSA_POP_;'
      '110391267=  ELSE'
      '110391268=    SELECT K.KASSA_BEZNAL'
      '110391269=      FROM KASSA_BEZNAL K'
      '110391270=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110391271=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110391272=       INTO :KASSA_POP_;'
      '110391273='
      
        '110391274=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '110391275=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEGI' +
        'N'
      '110391276=      PNT_ = '#39#39'012'#39#39';'
      '110391277=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      '110391278=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_,'
      
        '110391279=                                          1,     -- AC' +
        'TION_'
      '110391280=                                          :G_PRIHOD_,'
      
        '110391281=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110391282=                                          :DATE_RECEIP' +
        'T_,'
      
        '110391283=                                          NULL,   --NO' +
        'TE_'
      '110391284=                                          NULL,'
      
        '110391285=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110391286=                                          :G_PAYMENT_T' +
        'YPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110391287=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110391288=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110391289=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_'
      '110391290=                                          :G_PRIHOD_,'
      
        '110391291=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110391292=                                          :DATE_RECEIP' +
        'T_,'
      
        '110391293=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      '110391294=                                          NULL,'
      
        '110391295=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110391296=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110391297=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110391298=      END'
      '110391299=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391300=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110391301=        EXIT;'
      '110391302=      END'
      '110391303='
      
        '110391304=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048 +
        #1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110391305=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048 +
        #1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110391306=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110391307=        PNT_ = '#39#39'013'#39#39';'
      
        '110391308=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110391309=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391310=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110391311=          EXIT;'
      '110391312=        END'
      '110391313=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110391314=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '110391315=                                          :G_PRIHOD_,'
      
        '110391316=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110391317=                                          :DATE_RECEIP' +
        'T_,'
      
        '110391318=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110391319=                                          NULL,   --ZA' +
        'KAZ_'
      
        '110391320=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110391321=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110391322=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110391323=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391324=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110391325=              EXIT;'
      '110391326=            END'
      '110391327=        END'
      '110391328=  END'
      '110391329=end'
      '110391330='#39';'
      '110391331='
      '110391332=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD_TMP1('
      '110391333=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110391334=  OLD_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110391335=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110391336=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110391337=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '110391338=  OLD_PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '110391339=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '110391340=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110391341=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110391342=  CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC,'
      
        '110391343=  OLD_CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHAR' +
        'GE_ROZN_PROC,'
      
        '110391344=  CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OP' +
        'T_PROC,'
      
        '110391345=  OLD_CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARG' +
        'E_OPT_PROC,'
      '110391346=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      '110391347=  OLD_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      '110391348=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      '110391349=  OLD_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '110391350=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110391351=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0)'
      '110391352=RETURNS ('
      '110391353=  ERR_CODE INTEGER,'
      '110391354=  ERR_MSG VARCHAR(1024))'
      '110391355=AS'
      
        '110391356=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110391357=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110391358=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLAD' +
        '.PRICE;'
      '110391359=BEGIN'
      
        '110391360=  -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1048#1051#1057#1071' '#1058#1054#1042#1040#1056', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040#1049#1058#1048' '#1057#1053#1054#1042#1040' '#1045#1043#1054' '#1047#1040#1050 +
        #1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1062#1045#1053#1059' '#1054#1055#1058
      '110391361=  PNT_ = '#39#39'01'#39#39';'
      '110391362=  IF (G_PRODUCT_ <> OLD_G_PRODUCT_) THEN BEGIN'
      '110391363=      SELECT S.PRICE'
      '110391364=        FROM SKLAD S'
      
        '110391365=       WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110391366=         AND S.IS_LAST = 1'
      '110391367=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110391368=        INTO :LAST_SELF_PRICE_;'
      '110391369='
      '110391370=      PRICE_ = COALESCE(LAST_SELF_PRICE_, 0);'
      '110391371=  END'
      '110391372='
      
        '110391373=  -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1058#1054' '#1052#1045#1053#1071#1070' '#1062 +
        #1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048
      
        '110391374=  IF (CHARGE_PRICE_ROZN_ <> OLD_CHARGE_PRICE_ROZN_ OR ' +
        'PRICE_ <> OLD_PRICE_) THEN'
      
        '110391375=    PRICE_ROZN_ = PRICE_ * CHARGE_PRICE_ROZN_/100 + PR' +
        'ICE_;'
      
        '110391376=  -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058',' +
        ' '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '110391377=  ELSE IF (PRICE_ROZN_ <> OLD_PRICE_ROZN_) THEN'
      
        '110391378=    CHARGE_PRICE_ROZN_ = ROUND((PRICE_ROZN_/PRICE_ - 1' +
        ')*100, 2);'
      '110391379='
      
        '110391380=  -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040#1062#1045#1053#1050#1040' '#1054#1055#1058' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048#1047' , '#1047#1053#1040#1063#1048#1058' '#1062#1045#1053#1040' '#1054#1055#1058#1040' '#1053#1045' '#1052#1045#1053#1071#1051#1040#1057#1068', '#1041#1059#1044#1059' '#1045#1045' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '110391381=  IF (CHARGE_PRICE_OPT_ <> OLD_CHARGE_PRICE_OPT_ OR PR' +
        'ICE_ <> OLD_PRICE_ ) THEN'
      
        '110391382=    PRICE_OPT_ = PRICE_ * CHARGE_PRICE_OPT_/100 + PRIC' +
        'E_;'
      '110391383='
      
        '110391384=  -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1054#1055#1058#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054 +
        #1062#1045#1053#1058' '#1054#1055#1058#1040', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '110391385=  ELSE IF (PRICE_OPT_ <> OLD_PRICE_OPT_) THEN'
      
        '110391386=    CHARGE_PRICE_OPT_ = ROUND((PRICE_OPT_/PRICE_ - 1)*' +
        '100, 2);'
      '110391387='
      '110391388=  UPDATE SKLAD_TMP T'
      '110391389=  SET'
      '110391390=    G_PRODUCT = :G_PRODUCT_,'
      '110391391=    AMOUNT = :AMOUNT_,'
      '110391392=    PRICE = :PRICE_,'
      '110391393=    SUMM = :AMOUNT_ * :PRICE_,'
      '110391394=    NDS = :NDS_,'
      '110391395=    NDS_SUMM = :NDS_SUMM_'
      '110391396=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110391397=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '110391398=    ,T.CHARGE_ROZN_PROC = :CHARGE_PRICE_ROZN_'
      '110391399=    ,T.PRICE_ROZN = :PRICE_ROZN_'
      '110391400=    ,T.CHARGE_OPT_PROC = :CHARGE_PRICE_OPT_'
      '110391401=    ,T.PRICE_OPT = :PRICE_OPT_'
      '110391402=  WHERE'
      '110391403=    SKLAD = :SKLAD_;'
      '110391404=END'
      '110391405='#39';'
      '110391406='
      '110391407='
      '110391408=EXECUTE STATEMENT '#39'ALTER PROCEDURE DO_PRODUCT('
      '110391409=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110391410=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '110391411=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110391412=  AMOUNT_ INTEGER,'
      '110391413=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '110391414=RETURNS ('
      '110391415=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '110391416=  ERR_CODE INTEGER,'
      '110391417=  ERR_MSG VARCHAR(1024))'
      '110391418=AS'
      '110391419=/*'
      
        '110391420='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055 +
        #1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '110391421='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '110391422=*/'
      
        '110391423=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'DO_PRODUCT'#39 +
        #39';'
      '110391424=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110391425=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042 +
        #1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '110391426=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT;'
      
        '110391427=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '110391428=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067 +
        ' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '110391429=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110391430=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110391431=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ' = 0;'
      
        '110391432=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '110391433=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      '110391434=BEGIN'
      '110391435=  PNT_ = '#39#39'00'#39#39';'
      '110391436='
      '110391437=  IF (G_TOCHKA_ IS NULL) THEN'
      '110391438=    SELECT ID'
      '110391439=      FROM CUR_PARAMS'
      '110391440=     WHERE CUR_PARAMS = 2'
      '110391441=      INTO :G_TOCHKA_;'
      '110391442='
      '110391443=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '110391444=  SELECT P.S_VALUE'
      '110391445=    FROM SYSTEM_SETUP P'
      '110391446=   WHERE P.SYSTEM_SETUP = 2'
      '110391447=    INTO :CAN_SELL_;'
      '110391448='
      '110391449=  SELECT MAX(G.NAME)'
      '110391450=    FROM G_PRODUCT G,'
      '110391451=         G_PRODUCT_KIT K'
      '110391452=   WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '110391453=     AND K.G_PRODUCT = :G_PRODUCT_'
      
        '110391454=     AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PRODU' +
        'CT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCHKA_' +
        '), 0) < (K.AMOUNT * :AMOUNT_)'
      '110391455=    INTO :NAME_;'
      '110391456='
      '110391457=  IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEGIN'
      '110391458=    ERR_CODE = -20500;'
      
        '110391459=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1089#1090#1072#1090#1086#1082' ' +
        #1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39#39'||NAME_||'#39#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1089#1086#1073 +
        #1088#1072#1090#1100' '#1087#1088#1086#1076#1091#1082#1090'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110391460=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110391461=    EXIT;'
      '110391462=  END'
      '110391463='
      '110391464=  PNT_ = '#39#39'01'#39#39';'
      '110391465=  -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '110391466=  INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIVAL_' +
        'TYPE, PARENT_ID, NOTE, G_TOCHKA)'
      
        '110391467=  VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0, 1' +
        ', :OTHER_, :NOTE_, :G_TOCHKA_)'
      '110391468=  RETURNING OTHER'
      '110391469=  INTO :OTHER_;'
      '110391470='
      '110391471=  FOR SELECT K.G_PRODUCT_ITEM'
      '110391472=            ,K.AMOUNT*:AMOUNT_'
      '110391473=            ,K.amount'
      '110391474=            ,G.G_PRODUCT'
      '110391475=        FROM G_PRODUCT_KIT K'
      '110391476=            ,G_PRODUCT G'
      '110391477=       WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110391478=         AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '110391479=        INTO :ITEM_'
      '110391480=            ,:AMOUNT_NEED_'
      '110391481=            ,:AMOUNT_NEED_ONE_'
      '110391482=            ,:G_PRODUCT_KIT_'
      '110391483=  DO BEGIN'
      
        '110391484=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_K' +
        'IT_, NULL, 1)'
      '110391485=      RETURNING_VALUES :SELF_PRICE_;'
      '110391486='
      '110391487=    UPDATE LT_SKLAD_PRODUCT L'
      '110391488=       SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110391489=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110391490=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110391491='
      '110391492=    IF (ROW_COUNT = 0) THEN'
      
        '110391493=      INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(GEN_' +
        'LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G_TOC' +
        'HKA_);'
      '110391494='
      
        '110391495=    INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHER, G' +
        '_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110391496=    VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_, :G_' +
        'PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110391497='
      
        '110391498=    COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*SELF_' +
        'PRICE_;'
      '110391499=  END'
      '110391500='
      '110391501='
      
        '110391502=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063#1040#1051#1045' ' +
        #1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110391503=  PNT_ = '#39#39'02'#39#39';'
      
        '110391504=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM)'
      
        '110391505=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :AM' +
        'OUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110391506='
      '110391507=  EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110391508=                              :DATE_,'
      '110391509=                              CURRENT_TIME,'
      '110391510=                              NULL, --:G_CLIENT__,'
      
        '110391511=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110391512=                              NULL, --:OSNOVANIE__,'
      '110391513=                              :NOTE_,'
      '110391514=                              4, --:IS_VOZVRAT_,'
      '110391515=                              :AMOUNT_*:COST_PRICE_,'
      '110391516=                              :AMOUNT_*:COST_PRICE_,'
      '110391517=                              0, --:G_PRIHOD_,'
      '110391518=                              0 --:SUMM_PRIHOD_)'
      '110391519=                              ,NULL     --PAYMENTS_'
      
        '110391520=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110391521=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391522=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110391523=      EXIT;'
      '110391524=  END'
      '110391525='
      '110391526=  UPDATE OTHER O'
      '110391527=    SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110391528=  WHERE O.OTHER = :OTHER_;'
      '110391529=END'
      '110391530='#39';'
      '110391531='
      
        '110391532=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAYAVKA_POSTA' +
        'VSHIK('
      '110391533=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110391534=  BEGIN_DATE_ DATE,'
      '110391535=  END_DATE_ DATE,'
      '110391536=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110391537=  DO_SKLAD_ INTEGER,'
      '110391538=  MODE_ INTEGER,'
      '110391539=  MODE_VYBOR_ INTEGER,'
      '110391540=  MODE_VAL_ INTEGER,'
      '110391541=  NEW_VAL_ NUMERIC(15,2),'
      '110391542=  ROUND_MODE_ INTEGER)'
      '110391543=RETURNS ('
      '110391544=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110391545=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '110391546=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110391547=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110391548=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110391549=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110391550=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '110391551=  ERR_CODE INTEGER,'
      '110391552=  ERR_MSG VARCHAR(1024))'
      '110391553=AS'
      '110391554=/*'
      
        '110391555='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057#1056 +
        #1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '110391556='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055#1054 +
        #1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '110391557=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055#1056 +
        #1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '110391558=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 - ' +
        #1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '110391559=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054 +
        #1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045' ' +
        #1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110391560=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '110391561=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067#1042 +
        #1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      '110391562=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' */'
      '110391563=DECLARE VARIABLE ROUND_ INTEGER;'
      '110391564=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '110391565=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      
        '110391566=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110391567=BEGIN'
      '110391568=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110391569='
      '110391570=  IF (G_TOCHKA_ IS NULL) THEN'
      '110391571=    SELECT ID'
      '110391572=      FROM CUR_PARAMS'
      '110391573=     WHERE CUR_PARAMS = 2'
      '110391574=      INTO :G_TOCHKA_;'
      '110391575='
      '110391576=  IF (ROUND_MODE_ = 0) THEN'
      '110391577=      ROUND_ = 0;'
      '110391578=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '110391579=      ROUND_ = -1;'
      '110391580=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '110391581=      ROUND_ = -2;'
      '110391582=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '110391583=      ROUND_ = -3;'
      '110391584='
      
        '110391585=  SQL_STR_ = '#39#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39#39';'
      '110391586='
      
        '110391587=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040' ' +
        #1053#1040' '#1057#1050#1051#1040#1044#1045
      '110391588=  IF (MODE_ = 0) THEN BEGIN'
      
        '110391589=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39#39';'
      '110391590=    IF (MODE_VAL_ = 0) THEN'
      '110391591=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110391592=    ELSE'
      
        '110391593=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110391594='
      '110391595=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110391596=  END'
      '110391597=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '110391598=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '110391599=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND(ABS(LT.AMOUNT)'#39#39';'
      '110391600=    IF (MODE_VAL_ = 0) THEN'
      '110391601=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110391602=    ELSE'
      
        '110391603=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110391604='
      '110391605=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110391606=  END'
      '110391607='
      
        '110391608=  SQL_STR_ = SQL_STR_ || '#39#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39#39'||'
      
        '110391609=            '#39#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39#39';'
      '110391610='
      '110391611=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '110391612=    SQL_STR_ = SQL_STR_ ||'#39#39'AND EXISTS (SELECT 1'#39#39'||'
      
        '110391613=                                        '#39#39' FROM SKLAD ' +
        'S'#39#39'||'
      
        '110391614=                                        '#39#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39#39'||'
      
        '110391615=                                        '#39#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39#39'||'
      
        '110391616=                                        '#39#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39#39';'
      '110391617=    IF (MODE_VYBOR_ = 2) THEN'
      
        '110391618=      SQL_STR_ = SQL_STR_ ||'#39#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39#39';'
      '110391619=    ELSE'
      
        '110391620=      SQL_STR_ = SQL_STR_ ||'#39#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' ' +
        #1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042 +
        #1057#1045#1043#1044#1040
      '110391621=    SQL_STR_ = SQL_STR_ ||'#39#39') '#39#39';'
      '110391622=  END ELSE BEGIN'
      
        '110391623=    SQL_STR_ = SQL_STR_ ||'#39#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39#39';  -' +
        '- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '110391624=  END'
      '110391625='
      '110391626=  IF (MODE_ = 0) THEN'
      
        '110391627=    SQL_STR_ = SQL_STR_ || '#39#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39#39';'
      '110391628=  ELSE IF (MODE_ = 1) THEN'
      '110391629=    SQL_STR_ = SQL_STR_ || '#39#39' AND LT.AMOUNT < 0'#39#39';'
      
        '110391630=  SQL_STR_ = SQL_STR_ || '#39#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39#39';'
      '110391631='
      '110391632=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '110391633=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '110391634=      FOR EXECUTE STATEMENT'
      
        '110391635=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110391636=          INTO :G_PRODUCT,'
      '110391637=               :CATEGORY_NAME,'
      '110391638=               :NAME,'
      '110391639=               :ARTICUL,'
      '110391640=               :AMOUNT_CUR,'
      '110391641=               :MIN_AMOUNT,'
      '110391642=               :AMOUNT_TO_ZAKAZ'
      '110391643=        DO BEGIN'
      
        '110391644=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_P' +
        'RODUCT, :G_TOCHKA_, 0)'
      '110391645=              RETURNING_VALUES :COST_PRICE_;'
      '110391646='
      
        '110391647=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, A' +
        'MOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110391648=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_P' +
        'RODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO_' +
        'ZAKAZ, 0, 0);'
      '110391649=        END'
      '110391650='
      '110391651=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110391652=                                      CURRENT_DATE,'
      '110391653=                                      CURRENT_TIME,'
      '110391654=                                      :G_CLIENT_,'
      '110391655=                                      1,'
      
        '110391656=                                      NULL, --:OSNOVAN' +
        'IE__,'
      '110391657=                                      NULL, --:NOTE__,'
      
        '110391658=                                      0, --:IS_VOZVRAT' +
        '_,'
      
        '110391659=                                      (SELECT SUM(S.SU' +
        'MM) FROM SKLAD_TMP S),'
      
        '110391660=                                      0, -- :SUMM_FACT' +
        '_'
      '110391661=                                      0, --:G_PRIHOD_,'
      
        '110391662=                                      0 --:SUMM_PRIHOD' +
        '_)'
      '110391663=                                      ,NULL --PAYMENTS'
      
        '110391664=                                     )RETURNING_VALUES' +
        ' :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110391665=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110391666=          ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39#39'||ERR_MSG;'
      '110391667=          EXIT;'
      '110391668=        END'
      '110391669=  END'
      '110391670=  ELSE BEGIN'
      '110391671=      FOR EXECUTE STATEMENT'
      
        '110391672=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110391673=      INTO :G_PRODUCT,'
      '110391674=           :CATEGORY_NAME,'
      '110391675=           :NAME,'
      '110391676=           :ARTICUL,'
      '110391677=           :AMOUNT_CUR,'
      '110391678=           :MIN_AMOUNT,'
      '110391679=           :AMOUNT_TO_ZAKAZ'
      '110391680=      DO SUSPEND;'
      '110391681=  END'
      '110391682=END'
      '110391683='#39';'
      '110391684=END  --END_EXECUTE_BLOCK'
      '110391685=EXECUTE BLOCK AS BEGIN'
      '110391686='
      '110391687=EXECUTE STATEMENT '#39'ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '110391688=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110391689=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110391690=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110391691=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110391692=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110391693=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110391694=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110391695=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110391696=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '110391697=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED)'
      '110391698=RETURNS ('
      '110391699=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110391700=  ERR_CODE INTEGER,'
      '110391701=  ERR_MSG VARCHAR(1024))'
      '110391702=AS'
      
        '110391703=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062#1045 +
        #1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '110391704=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045#1057 +
        #1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '110391705=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040#1042 +
        #1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '110391706=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042#1053 +
        #1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '110391707='
      
        '110391708=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042 +
        #1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110391709=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'PAY_ZAKAZ_NA' +
        '_REAL'#39#39';'
      '110391710=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110391711=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110391712=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110391713=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'AMOUNT_ALL;'
      
        '110391714=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'SUMM_PAYED;'
      
        '110391715=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110391716=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '110391717=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110391718=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110391719=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      '110391720=BEGIN'
      '110391721='
      '110391722=  IF (G_TOCHKA_ IS NULL) THEN'
      '110391723=    SELECT ID'
      '110391724=      FROM CUR_PARAMS'
      '110391725=     WHERE CUR_PARAMS = 2'
      '110391726=      INTO :G_TOCHKA_;'
      '110391727='
      
        '110391728=  --**************************************************' +
        '************************************************'
      
        '110391729=  --**************************************************' +
        '************************************************'
      '110391730=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110391731=  --**************************************************' +
        '************************************************'
      
        '110391732=  --**************************************************' +
        '************************************************'
      '110391733=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '110391734=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1055 +
        #1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '110391735=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '110391736=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110391737=            INTO :AMOUNT_,'
      '110391738=                 :G_PRODUCT_'
      '110391739=      DO BEGIN'
      '110391740=          UPDATE LT_SKLAD_PRODUCT L'
      '110391741=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110391742=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110391743=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110391744=      END'
      '110391745='
      '110391746=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '110391747=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E,'
      
        '110391748=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE)'
      
        '110391749=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '110391750=             NDS_SUMM, COST_PRICE'
      '110391751=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110391752='
      '110391753=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110391754=                                  :Z_DATE_,'
      '110391755=                                  :Z_TIME_,'
      '110391756=                                  :G_CLIENT_,'
      '110391757=                                  :G_PAYMENT_TYPE_,'
      '110391758=                                  :OSNOVANIE_,'
      
        '110391759=                                  :IS_SPISANIE_,   -- ' +
        ':IS_SPISANIE_'
      '110391760=                                  :NOTE_,'
      
        '110391761=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040 +
        #1050#1040#1047#1040
      
        '110391762=                                  :SUMM_FACT_,  -- '#1048' '#1057 +
        #1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '110391763=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 1, SUMM_FACT_, 0),'
      
        '110391764=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 2, SUMM_FACT_, 0),'
      '110391765=                                  0, --SUMM_BONUS_'
      '110391766=                                  0, --SUMM_BONUS_GOT_'
      
        '110391767=                                  null,         -- '#1057#1058#1040 +
        #1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '110391768=                                  0,            -- '#1057#1059#1052 +
        #1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '110391769=                                  0,    --BY_RECIPE'
      '110391770=                                  0     --IS_RESERVE'
      '110391771=                                  ,NULL  -- PAYMENTS_'
      '110391772=                                  )'
      '110391773=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110391774='
      '110391775=      if (ERR_CODE <> 0) then BEGIN'
      '110391776=        ERR_CODE = -20500;'
      '110391777=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110391778=        Exit;'
      '110391779=      END'
      '110391780='
      
        '110391781=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' '#1040 +
        #1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' ' +
        #1055#1054#1044' '#1056#1045#1040#1051
      
        '110391782=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044#1040 +
        ' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '110391783=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042#1045 +
        #1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '110391784=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059 +
        #1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '110391785=      UPDATE ZAKAZ'
      '110391786=         SET IS_SPISANIE = 2'
      '110391787=       WHERE ZAKAZ = :ZAKAZ_;'
      '110391788='
      
        '110391789=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110391790=      FOR SELECT T.AMOUNT,'
      '110391791=                 T.SUMM,'
      '110391792=                 T.G_PRODUCT,'
      '110391793=                 T.ZAKAZ_NA_REAL,'
      '110391794=                 T.ZAKAZ_DETAILS'
      '110391795=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110391796=            INTO :AMOUNT_,'
      '110391797=                 :Z_SUMM_,'
      '110391798=                 :G_PRODUCT_,'
      '110391799=                 :ZAKAZ_NA_REAL_,'
      '110391800=                 :ZAKAZ_DETAILS_'
      '110391801=      DO BEGIN'
      '110391802=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110391803=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOU' +
        'NT_,'
      
        '110391804=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110391805=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110391806=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110391807='
      
        '110391808=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ' +
        'ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '110391809=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110391810=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110391811=      END'
      '110391812=  END'
      '110391813=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110391814=  --**************************************************' +
        '************************************************'
      
        '110391815=  --**************************************************' +
        '************************************************'
      '110391816='
      
        '110391817=  --**************************************************' +
        '************************************************'
      
        '110391818=  --**************************************************' +
        '************************************************'
      '110391819=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110391820=  --**************************************************' +
        '************************************************'
      
        '110391821=  --**************************************************' +
        '************************************************'
      '110391822=  ELSE BEGIN'
      '110391823=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '110391824=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ZA' +
        'KAZ_DETAILS - ZAKAZ_REAL'
      
        '110391825=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110391826=      FOR SELECT T.AMOUNT,'
      '110391827=                 T.SUMM,'
      '110391828=                 T.G_PRODUCT,'
      '110391829=                 T.ZAKAZ_NA_REAL,'
      '110391830=                 T.ZAKAZ_DETAILS'
      '110391831=                 ,T.PRICE'
      '110391832=                 ,T.NDS'
      '110391833=                 ,T.NDS_SUMM'
      '110391834=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110391835=            INTO :AMOUNT_,'
      '110391836=                 :Z_SUMM_,'
      '110391837=                 :G_PRODUCT_,'
      '110391838=                 :ZAKAZ_NA_REAL_,'
      '110391839=                 :ZAKAZ_DETAILS_'
      '110391840=                 ,:PRICE_'
      '110391841=                 ,:NDS_'
      '110391842=                 ,:NDS_SUMM_'
      '110391843=      DO BEGIN'
      
        '110391844=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUN' +
        'T, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110391845=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '110391846='
      
        '110391847=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110391848=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110391849='
      '110391850=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110391851=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :AMOUNT_,'
      
        '110391852=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110391853=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110391854=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110391855=      END'
      '110391856='
      '110391857=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110391858=                                  :Z_DATE_,'
      '110391859=                                  :Z_TIME_,'
      '110391860=                                  :G_CLIENT_,'
      '110391861=                                  :G_PAYMENT_TYPE_,'
      '110391862=                                  :OSNOVANIE_,'
      '110391863=                                  :NOTE_,'
      
        '110391864=                                  2,        --:IS_VOZV' +
        'RAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-' +
        #1050#1059
      '110391865=                                  :SUMM_,'
      '110391866=                                  :SUMM_FACT_,'
      
        '110391867=                                  NULL,     --:G_PRIHO' +
        'D_,'
      
        '110391868=                                  NULL      --:SUMM_PR' +
        'IHOD_'
      
        '110391869=                                  ,NULL     -- PAYMENT' +
        'S'
      
        '110391870=                                  ) RETURNING_VALUES :' +
        'SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110391871='
      '110391872=      if (ERR_CODE <> 0) then BEGIN'
      '110391873=        ERR_CODE = -20500;'
      '110391874=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110391875=        Exit;'
      '110391876=      END'
      '110391877=  END'
      '110391878=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110391879=  --**************************************************' +
        '************************************************'
      
        '110391880=  --**************************************************' +
        '************************************************'
      '110391881='
      '110391882=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110391883=END'
      '110391884='#39';'
      '110391885='
      '110391886=EXECUTE STATEMENT '#39'ALTER PROCEDURE R_UNIFICATION('
      '110391887=  MODE_ INTEGER)'
      '110391888=RETURNS ('
      '110391889=  COUNT_SPIS_ INTEGER,'
      '110391890=  COUNT_PRIH_ INTEGER,'
      '110391891=  ERR_CODE INTEGER,'
      '110391892=  ERR_MSG VARCHAR(1024))'
      '110391893=AS'
      
        '110391894=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'R_UNIFICATIO' +
        'N'#39#39';'
      '110391895=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110391896=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REV' +
        'ISION;'
      
        '110391897=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_' +
        'PRODUCT;'
      
        '110391898=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AM' +
        'OUNT_BD;'
      
        '110391899=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.' +
        'AMOUNT_REAL;'
      
        '110391900=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      '110391901=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110391902=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110391903=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110391904=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110391905=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      '110391906=BEGIN'
      '110391907='
      '110391908=  COUNT_SPIS_ = 0;'
      '110391909=  COUNT_PRIH_ = 0;'
      '110391910='
      '110391911=  SELECT ID'
      '110391912=    FROM CUR_PARAMS'
      '110391913=   WHERE CUR_PARAMS = 2'
      '110391914=    INTO :G_TOCHKA_;'
      '110391915='
      
        '110391916=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_RE' +
        'AL'
      '110391917=      FROM REVISION'
      
        '110391918=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOU' +
        'NT_REAL_'
      '110391919=  DO BEGIN'
      
        '110391920=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2' +
        '))) THEN BEGIN'
      
        '110391921=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1)'
      '110391922=        RETURNING_VALUES :COST_PRICE_;'
      '110391923='
      
        '110391924=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_' +
        'PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110391925=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM)'
      
        '110391926=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMO' +
        'UNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '110391927='
      '110391928=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '110391929=    END'
      '110391930='
      
        '110391931=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1' +
        '))) then BEGIN'
      '110391932=      SELECT S.PRICE'
      '110391933=        FROM SKLAD S'
      '110391934=       WHERE S.IS_LAST = 1'
      '110391935=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110391936=         AND S.G_TOCHKA = :G_TOCHKA_'
      '110391937=        INTO :PRICE_LAST_;'
      '110391938='
      
        '110391939=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056 +
        #1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '110391940='
      
        '110391941=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110391942=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AM' +
        'OUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '110391943='
      '110391944=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '110391945=    END'
      '110391946='
      '110391947=    UPDATE REVISION R'
      '110391948=       SET R.IS_UNIFIED = 1'
      '110391949=     WHERE R.REVISION = :REVISION_;'
      '110391950=  END'
      '110391951='
      '110391952=  PNT_ = '#39#39'01'#39#39';'
      '110391953=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '110391954=    SELECT SUM(S.SUMM)'
      '110391955=      FROM ZAKAZ_DETAILS_TMP S'
      '110391956=      INTO :SUMM_;'
      '110391957='
      '110391958=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110391959=                                CURRENT_DATE, --:Z_DAT' +
        'E_,'
      
        '110391960=                                CURRENT_TIME, --:Z_TIM' +
        'E'
      
        '110391961=                                10,          --:G_CLIE' +
        'NT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '110391962=                                1,            --:G_PAY' +
        'MENT_TYPE_,'
      
        '110391963=                                NULL,         --:OSNOV' +
        'ANIE_,'
      
        '110391964=                                1,              --:IS_' +
        'SPISANIE_,'
      
        '110391965=                                NULL,           --:NOT' +
        'E_,'
      
        '110391966=                                :SUMM_,              -' +
        '-:SUMM_,'
      
        '110391967=                                :SUMM_,              -' +
        '-:SUMM_FACT_,'
      
        '110391968=                                0,              --SUMM' +
        '_BONUS_'
      
        '110391969=                                0,              --SUMM' +
        '_BONUS_GOT'
      
        '110391970=                                NULL,           --:G_P' +
        'RIHOD_,'
      '110391971=                                NULL,'
      '110391972=                                0,        -- BY_RECIPE'
      
        '110391973=                                0         -- IS_RESERV' +
        'E'
      '110391974=                                ,NULL  -- PAYMENTS_'
      '110391975=                                ,0     -- SUMM_CASH'
      '110391976=                                ,0     -- SUMM_NONCASH'
      
        '110391977=                                ) RETURNING_VALUES :ZA' +
        'KAZ_, :ERR_CODE, :ERR_MSG;'
      '110391978=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110391979=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110391980=      EXIT;'
      '110391981=    END'
      '110391982=  END'
      '110391983='
      '110391984=  PNT_ = '#39#39'02'#39#39';'
      '110391985=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '110391986=    SELECT SUM(S.SUMM)'
      '110391987=      FROM SKLAD_TMP S'
      '110391988=      INTO :SUMM_;'
      '110391989='
      '110391990=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110391991=                                CURRENT_DATE,   --:DAT' +
        'E_RECEIPT_,'
      '110391992=                                CURRENT_TIME,'
      
        '110391993=                                NULL,           --:G_C' +
        'LIENT_,'
      
        '110391994=                                1,              --:G_P' +
        'AYMENT_TYPE_,'
      
        '110391995=                                NULL,           --:OSN' +
        'OVANIE_,'
      
        '110391996=                                '#39#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39#39', ' +
        '          --:NOTE_,'
      
        '110391997=                                5,              --:IS_' +
        'VOZVRAT_,'
      '110391998=                                :SUMM_,'
      '110391999=                                :SUMM_,'
      
        '110392000=                                NULL,           --:G_P' +
        'RIHOD_,'
      
        '110392001=                                NULL            --:SUM' +
        'M_PRIHOD_'
      '110392002=                                ,NULL  --PAYMENTS'
      '110392003=                                )'
      '110392004=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110392005=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110392006=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110392007=      EXIT;'
      '110392008=    END'
      '110392009=  END'
      '110392010=END'
      '110392011='#39';'
      '110392012='
      '110392013=EXECUTE STATEMENT '#39'ALTER PROCEDURE SYNC_DOWNLOAD('
      '110392014=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110392015=  UPLOAD_TABLE_TMP TYPE OF COLUMN UPLOAD_TABLE_TMP.UPL' +
        'OAD_TABLE_TMP,'
      '110392016=  MODE TYPE OF COLUMN UPLOAD_TABLE_TMP.MODE,'
      '110392017=  PARENT TYPE OF COLUMN UPLOAD_TABLE_TMP.PARENT,'
      '110392018=  DATE_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.DATE_OPER,'
      '110392019=  TIME_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.TIME_OPER,'
      '110392020=  G_CLIENT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_CLIENT,'
      
        '110392021=  G_PAYMENT_TYPE TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PAY' +
        'MENT_TYPE,'
      '110392022=  SUMM_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_ALL,'
      
        '110392023=  SUMM_FACT_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_F' +
        'ACT_ALL,'
      
        '110392024=  SUMM_PAY_BONUS TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'PAY_BONUS,'
      
        '110392025=  SUMM_BONUS_GOT TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'BONUS_GOT,'
      '110392026=  OSNOVANIE TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE,'
      '110392027=  NOTE TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE,'
      
        '110392028=  G_OFFICIAL TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICIA' +
        'L,'
      '110392029=  G_PRODUCT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT,'
      '110392030=  AMOUNT TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT,'
      '110392031=  PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE,'
      '110392032=  SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM,'
      
        '110392033=  DISCOUNT_PERC TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_PERC,'
      
        '110392034=  DISCOUNT_TENGE TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCO' +
        'UNT_TENGE,'
      
        '110392035=  DISCOUNT_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_SUMM,'
      '110392036=  NDS TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS,'
      '110392037=  NDS_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM,'
      
        '110392038=  COST_PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRIC' +
        'E,'
      '110392039=  BY_RECIPE TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE,'
      
        '110392040=  IS_RESERVE TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESERV' +
        'E,'
      '110392041=  PAYMENTS BLOB SUB_TYPE 1,'
      '110392042=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110392043=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110392044=  IS_LOAD_ INTEGER)'
      '110392045=RETURNS ('
      '110392046=  ERR_CODE INTEGER,'
      '110392047=  ERR_MSG VARCHAR(1024))'
      '110392048=AS'
      '110392049=/*'
      '110392050='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110392051='#1048#1044#1059' '#1055#1054' '#1042#1057#1045#1052' '#1055#1054#1054#1063#1045#1056#1045#1044#1053#1054', '#1055#1045#1056#1045#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1048#1055#1054#1052' '#1055#1056#1054#1062#1045#1057#1057#1040' '#1041#1059 +
        #1044#1059' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110392052='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1062#1048#1050#1051#1054#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059 +
        #1070' '#1058#1040#1041#1051#1048#1062#1059
      '110392053=*/'
      
        '110392054=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'SYNC_DOWNLOA' +
        'D'#39#39';'
      '110392055=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110392056=DECLARE VARIABLE MODE_ TYPE OF COLUMN UPLOAD_TABLE_TMP' +
        '.MODE;'
      
        '110392057=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110392058=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110392059=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110392060=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110392061=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110392062=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110392063=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '110392064=DECLARE VARIABLE BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RE' +
        'CIPE;'
      
        '110392065=DECLARE VARIABLE BY_RECIPE__ TYPE OF COLUMN ZAKAZ.BY_R' +
        'ECIPE;'
      
        '110392066=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '110392067=DECLARE VARIABLE IS_RESERVE__ TYPE OF COLUMN ZAKAZ.IS_' +
        'RESERVE;'
      
        '110392068=DECLARE VARIABLE PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZ' +
        'E 80;'
      
        '110392069=DECLARE VARIABLE PAYMENTS__ BLOB SUB_TYPE 1 SEGMENT SI' +
        'ZE 80;'
      
        '110392070=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.G_CLIENT;'
      
        '110392071=DECLARE VARIABLE G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_' +
        'PARENT.G_PAYMENT_TYPE;'
      
        '110392072=DECLARE VARIABLE OSNOVANIE_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.OSNOVANIE;'
      
        '110392073=DECLARE VARIABLE NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOT' +
        'E;'
      
        '110392074=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110392075=DECLARE VARIABLE SUMM_FACT_ALL_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM_FACT;'
      
        '110392076=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '110392077=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110392078=DECLARE VARIABLE PARENT_ TYPE OF COLUMN UPLOAD_TABLE_T' +
        'MP.PARENT;'
      
        '110392079=DECLARE VARIABLE PARENT_OLD_ TYPE OF COLUMN UPLOAD_TAB' +
        'LE_TMP.PARENT;'
      '110392080=DECLARE VARIABLE MODE_OLD_ INTEGER;'
      '110392081=DECLARE VARIABLE DATE_OPER__ DATE;'
      '110392082=DECLARE VARIABLE TIME_OPER__ TIME;'
      
        '110392083=DECLARE VARIABLE G_CLIENT__ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '110392084=DECLARE VARIABLE G_PAYMENT_TYPE__ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      
        '110392085=DECLARE VARIABLE OSNOVANIE__ TYPE OF COLUMN ZAKAZ.OSNO' +
        'VANIE;'
      '110392086=DECLARE VARIABLE NOTE__ TYPE OF COLUMN ZAKAZ.NOTE;'
      '110392087=DECLARE VARIABLE SUMM__ NUMERIC(15,2);'
      '110392088=DECLARE VARIABLE SUMM_FACT__ NUMERIC(15,2);'
      
        '110392089=DECLARE VARIABLE SUMM_CASH__ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '110392090=DECLARE VARIABLE SUMM_NONCASH__ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '110392091=DECLARE VARIABLE SUMM_PAY_BONUS__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '110392092=DECLARE VARIABLE SUMM_BONUS_GOT__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '110392093=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '110392094=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2' +
        ');'
      
        '110392095=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      '110392096=DECLARE VARIABLE DATE_OPER_ DATE;'
      '110392097=DECLARE VARIABLE TIME_OPER_ TIME;'
      
        '110392098=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '110392099=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110392100=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '110392101=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN ZAKAZ.G_OF' +
        'FICIAL;'
      
        '110392102=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110392103=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110392104=DECLARE VARIABLE IS_FIRST_TIME_ INTEGER = 0; /* '#1054#1041#1056#1040#1041#1040 +
        #1058#1067#1042#1040#1045#1058#1057#1071' '#1055#1045#1056#1042#1040#1071' '#1057#1058#1056#1054#1050#1040' 0, '#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1057#1058#1056#1054#1050#1048' = 1 */'
      '110392105=BEGIN'
      '110392106=  PNT_ = '#39#39'00'#39#39';'
      '110392107=  IF (IS_LOAD_ = 0) THEN BEGIN'
      '110392108=      SELECT 1'
      '110392109=        FROM G_PRODUCT G'
      '110392110=       WHERE G.G_PRODUCT = :G_PRODUCT'
      '110392111=       INTO :G_PRODUCT_;'
      '110392112='
      '110392113=      IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '110392114=        ERR_CODE = -20500;'
      
        '110392115=        ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072': '#1090#1086#1074#1072#1088' '#1089' '#1080#1076#1077#1085#1090#1080#1092#1080#1082#1072#1090#1086#1088#1086#1084' '#39 +
        #39'||G_PRODUCT||'#39#39' '#1086#1090#1089#1091#1090#1089#1090#1074#1091#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'.'#39#39';'
      '110392116=        Exit;'
      '110392117=      END'
      '110392118='
      
        '110392119=      INSERT INTO UPLOAD_TABLE_TMP (UPLOAD_TABLE_TMP, ' +
        'MODE, PARENT, DATE_OPER, TIME_OPER, G_CLIENT, G_PAYMENT_TYPE,'
      
        '110392120=                                    SUMM_ALL, SUMM_FAC' +
        'T_ALL, SUMM_PAY_BONUS, SUMM_BONUS_GOT, OSNOVANIE, NOTE, G_OFFICI' +
        'AL, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110392121=                                    DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RESERVE, P' +
        'AYMENTS)'
      
        '110392122=      VALUES (:UPLOAD_TABLE_TMP, :MODE, :PARENT, :DATE' +
        '_OPER, :TIME_OPER, DECODE(:G_CLIENT, 0, NULL, :G_CLIENT), :G_PAY' +
        'MENT_TYPE,'
      
        '110392123=              :SUMM_ALL, :SUMM_FACT_ALL, :SUMM_PAY_BON' +
        'US, :SUMM_BONUS_GOT, :OSNOVANIE, :NOTE, :G_OFFICIAL, :G_PRODUCT,' +
        ' :AMOUNT, :PRICE, :SUMM, :DISCOUNT_PERC,'
      
        '110392124=              :DISCOUNT_TENGE, :DISCOUNT_SUMM, :NDS, :' +
        'NDS_SUMM, :COST_PRICE, :BY_RECIPE, :IS_RESERVE, :PAYMENTS);'
      '110392125='
      '110392126=  END ELSE BEGIN'
      '110392127=      PNT_ = '#39#39'01'#39#39';'
      '110392128=      IF (G_TOCHKA_ IS NULL) THEN'
      '110392129=        SELECT ID'
      '110392130=          FROM CUR_PARAMS'
      '110392131=         WHERE CUR_PARAMS = 2'
      '110392132=          INTO :G_TOCHKA_;'
      '110392133='
      
        '110392134=      FOR SELECT MODE, PARENT, DATE_OPER, TIME_OPER, G' +
        '_CLIENT, G_PAYMENT_TYPE, SUMM_ALL, SUMM_FACT_ALL, SUMM_PAY_BONUS' +
        ', SUMM_BONUS_GOT, OSNOVANIE,'
      
        '110392135=                 NOTE, G_OFFICIAL, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      
        '110392136=                 NDS_SUMM, COST_PRICE, BY_RECIPE, IS_R' +
        'ESERVE, PAYMENTS'
      '110392137=          FROM UPLOAD_TABLE_TMP'
      
        '110392138=          WHERE MODE <> 6        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056 +
        #1040' '#1041#1059#1044#1059' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1054#1058#1044#1045#1051#1068#1053#1054', '#1058#1040#1052' '#1044#1056#1059#1043#1054#1049' '#1055#1056#1048#1053#1062#1048#1055
      '110392139=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110392140=          INTO :MODE_, :PARENT_, :DATE_OPER_, :TIME_OP' +
        'ER_, :G_CLIENT_, :G_PAYMENT_TYPE_, :SUMM_ALL_, :SUMM_FACT_ALL_, ' +
        ' :SUMM_PAY_BONUS_, :SUMM_BONUS_GOT_,'
      
        '110392141=               :OSNOVANIE_, :NOTE_, :G_OFFICIAL_, :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_PERC_, :DISCOUNT_T' +
        'ENGE_,'
      
        '110392142=               :DISCOUNT_SUMM_, :NDS_, :NDS_SUMM_, :CO' +
        'ST_PRICE_, :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_'
      '110392143=      DO BEGIN'
      '110392144=          -- '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110392145=          PNT_ = '#39#39'02'#39#39';'
      
        '110392146=          IF (PARENT_ <> PARENT_OLD_ AND IS_FIRST_TIME' +
        '_ = 1) THEN BEGIN'
      '110392147=            IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '110392148=              PNT_ = '#39#39'02a'#39#39';'
      '110392149=              EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110392150=                                          :DATE_OPER__' +
        ','
      
        '110392151=                                          :TIME_OPER__' +
        ','
      '110392152=                                          :G_CLIENT__,'
      
        '110392153=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110392154=                                          :OSNOVANIE__' +
        ','
      '110392155=                                          :NOTE__,'
      
        '110392156=                                          DECODE(:MODE' +
        '_OLD_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '110392157=                                          :SUMM__,'
      
        '110392158=                                          :SUMM_FACT__' +
        ','
      
        '110392159=                                          0, --:G_PRIH' +
        'OD_,'
      
        '110392160=                                          0 --:SUMM_PR' +
        'IHOD_)'
      
        '110392161=                                          ,:PAYMENTS__' +
        '  -- PAYMENTS'
      
        '110392162=                                         )RETURNING_VA' +
        'LUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110392163=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110392164=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090 +
        #1086#1074#1072#1088#1072' (01).'#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG)' +
        ' + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '110392165=                EXIT;'
      '110392166=              END'
      '110392167=            END'
      '110392168=            ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '110392169=              PNT_ = '#39#39'03'#39#39';'
      '110392170=              EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110392171=                                          :DATE_OPER__' +
        ','
      
        '110392172=                                          :TIME_OPER__' +
        ','
      '110392173=                                          :G_CLIENT__,'
      
        '110392174=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110392175=                                          :OSNOVANIE__' +
        ','
      
        '110392176=                                          DECODE(MODE_' +
        'OLD_,'
      
        '110392177=                                                 2, 0,' +
        '   -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '110392178=                                                 3, 1,' +
        '   -- '#1057#1055#1048#1057#1040#1053#1048#1045
      
        '110392179=                                                 5, 3)' +
        ',  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110392180=                                          :NOTE__,'
      '110392181=                                          :SUMM__,'
      
        '110392182=                                          :SUMM_FACT__' +
        ','
      
