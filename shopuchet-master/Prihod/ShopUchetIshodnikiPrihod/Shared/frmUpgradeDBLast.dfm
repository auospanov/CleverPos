      '11039975=             T.AMOUNT,'
      '11039976=             T.IS_LAST,'
      '11039977=             T.DATE_RECEIPT'
      '11039978=             ,S.PRICE_CURRENCY'
      '11039979=             ,S.SUMM_CURRENCY'
      
        '11039980=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLAD,' +
        ' AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT = :' +
        'SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
