      '1103390=  ACTION_ TYPE OF COLUMN G_PRIHOD_RASHOD.DO_ACTION,'
      '1103391=  NAME_ TYPE OF COLUMN G_PRIHOD_RASHOD.NAME)'
      '1103392=RETURNS ('
      '1103393=  ERR_CODE INTEGER,'
      '1103394=  ERR_MSG VARCHAR(1024))'
