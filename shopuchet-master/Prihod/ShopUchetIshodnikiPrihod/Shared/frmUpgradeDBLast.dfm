      '11039308=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD_TMP1('
      '11039309=  SKLAD_ TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '11039310=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD.SKLAD_PARENT)'
      '11039311=RETURNS ('
      '11039312=  ERR_CODE INTEGER,'
      '11039313=  ERR_MSG VARCHAR(1024))'
      '11039314=AS'
      
        '11039315=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1048' '#1055#1056#1048' '#1054#1044#1048#1053#1054#1063#1053#1054#1052' '#1059#1044#1040#1051#1045#1053#1048#1048' '#1044#1045#1058#1040#1051#1048',' +
        ' '#1048' '#1055#1056#1048' '#1054#1063#1048#1057#1058#1050#1045' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067','
      '11039316='#1050#1054#1043#1044#1040' '#1047#1040#1050#1056#1067#1042#1040#1045#1058#1057#1071' '#1054#1050#1053#1054' "'#1055#1056#1048#1061#1054#1044' '#1053#1040#1050#1051#1040#1044#1053#1040#1071'"*/'
      
        '11039317=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD_TMP' +
        #39#39';'
      '11039318=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11039319=DECLARE VARIABLE G_PRODUCT_ INTEGER;'
      
        '11039320=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN SKLAD.AMOUN' +
        'T = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '11039321=DECLARE VARIABLE AMOUNT_CUR_SKLAD_ TYPE OF COLUMN SKLAD' +
        '.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      
        '11039322=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOUN' +
        'T = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      '11039323=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ INTEGER;'
      '11039324=BEGIN'
      '11039325='
      '11039326=  DELETE FROM SKLAD_TMP'
      '11039327=  WHERE SKLAD = COALESCE(:sklad_, sklad)'
      '11039328=    AND SKLAD_PARENT = :SKLAD_PARENT_;'
      '11039329='
      '11039330=  SELECT S.S_VALUE'
      '11039331=    FROM SYSTEM_SETUP S'
      '11039332=   WHERE S.SYSTEM_SETUP = 2'
      '11039333=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11039334='
      
        '11039335=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054#1043#1045 +
        ' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1053#1054' '#1069#1058#1040' '#1055#1056#1054#1042#1045#1056#1050#1040' '#1053#1059#1046#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058#1057#1071' '#1059#1046#1045 +
        ' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044', '#1054' '#1063#1045#1052' '#1057#1042#1048#1044#1045#1058#1045#1051#1068#1057#1058#1042#1059#1045#1058' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1049' SKLAD_PAR' +
        'ENT_'
      
        '11039336=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SKLA' +
        'D_PARENT_, 0) <> 0)) then BEGIN'
      '11039337=      SELECT L.G_PRODUCT,'
      '11039338=             L.AMOUNT'
      '11039339=        FROM SKLAD S,'
      '11039340=             LT_SKLAD_PRODUCT L'
      '11039341=       WHERE S.SKLAD = :SKLAD_'
      '11039342=         AND S.G_PRODUCT = L.G_PRODUCT'
      '11039343=         AND S.G_TOCHKA = L.G_TOCHKA'
      '11039344=        INTO :G_PRODUCT_,'
      '11039345=             :AMOUNT_CUR_;'
      '11039346='
      
        '11039347=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056 +
        #1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1055#1056#1048#1061#1054#1044', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '11039348=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1055#1056#1048#1061#1054#1044', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 40, '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068', '#1063#1043#1054#1041#1067' '#1053#1045' '#1059#1064#1051#1054' '#1042' ' +
        #1052#1048#1053#1059#1057
      
        '11039349=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051#1054 +
        ', '#1047#1040#1058#1045#1052' '#1045#1057#1051#1048' '#1057#1058#1040#1056#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1041#1054#1051#1068#1064#1045' '#1053#1054#1042#1054#1043#1054' - '#1047#1053#1040#1063#1048#1058' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056 +
        #1040' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1054#1057#1068','
      '11039350=      -- '#1053#1040#1044#1054' '#1057#1044#1045#1051#1040#1058#1068' '#1063#1058#1054#1041#1067' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1057#1068' '#1053#1045' '#1042' '#1052#1048#1053#1059#1057
      '11039351=      SELECT SUM(AMOUNT)'
      '11039352=        FROM SKLAD T'
      '11039353=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11039354=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '11039355=        INTO :AMOUNT_OLD_;'
      '11039356='
      '11039357=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045
      '11039358=      SELECT SUM(AMOUNT)'
      '11039359=        FROM SKLAD_TMP T'
      '11039360=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11039361=       INTO :AMOUNT_CUR_SKLAD_;'
      '11039362='
      
        '11039363=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD_)' +
        ' THEN BEGIN'
      
        '11039364=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_CUR' +
        '_SKLAD_)) < 0) THEN BEGIN'
      '11039365=            ERR_CODE = -20500;'
      
        '11039366=            ERR_MSG = '#39#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074 +
        #1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39#39'||ASCII_CHAR(10)||'
      
        '11039367=                      '#39#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088 +
        #1072#1084#1084#1099'.'#39#39';'
      
        '11039368=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR' +
        '_MSG) RETURNING_VALUES (:ERR_MSG);'
      '11039369=            ERR_MSG = PROCNAME||ERR_MSG;'
      '11039370=            EXIT;'
      '11039371=          END'
      '11039372=      END'
      '11039373=  END'
      '11039374=end'
      '11039375='#39';'
      '11039376='
      '11039377=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SKLAD('
      '11039378=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11039379=  MODE_ INTEGER)'
      '11039380=RETURNS ('
      '11039381=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '11039382=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      
        '11039383=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIP' +
        'T,'
      '11039384=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '11039385=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMENT' +
        '_TYPE,'
      '11039386=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '11039387=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '11039388=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11039389=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11039390=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY,'
      
        '11039391=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_AL' +
        'L,'
      '11039392=  CNT_T_ INTEGER,'
      
        '11039393=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11039394=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11039395=  HAVERIGHT_ INTEGER,'
      '11039396=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11039397=  ERR_CODE INTEGER,'
      '11039398=  ERR_MSG VARCHAR(1024))'
      '11039399=AS'
      '11039400=/*'
      
        '11039401=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083#1077 +
        #1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '11039402=*/'
      
        '11039403=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFIC' +
        'IAL.G_OFFICIAL;'
      '11039404=DECLARE VARIABLE CNT_ INTEGER;'
      '11039405=begin'
      
        '11039406=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080' ' +
        'INS '#1080' '#1087#1088#1080' UPD'
      '11039407=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '11039408=  /*CNT_T_ = 0;'
      '11039409=  SELECT COUNT(*)'
      '11039410=    FROM (SELECT S.SKLAD'
      '11039411=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '11039412=    INTO :CNT_T_; */'
      '11039413='
      
        '11039414=  -- '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1087#1088#1086#1074#1077#1088#1103#1090#1100' - '#1074#1076#1088#1091#1075' '#1101#1090#1086#1090' '#1087#1088#1080#1093#1086#1076' '#1091#1078#1077' '#1082#1090#1086'-' +
        #1090#1086' '#1088#1077#1076#1072#1082#1090#1080#1088#1091#1077#1090
      '11039415=  SELECT COUNT(*)'
      '11039416=    FROM SKLAD_TMP S'
      '11039417=   WHERE S.sklad_parent = :SKLAD_'
      '11039418=    INTO :CNT_;'
      '11039419='
      '11039420=  IF (CNT_ > 0) THEN begin'
      '11039421=    ERR_CODE = -20500;'
      
        '11039422=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1044#1072#1085#1085#1072#1103' '#1085#1072 +
        #1082#1083#1072#1076#1085#1072#1103' '#1087#1088#1080#1093#1086#1076#1072' '#1091#1078#1077' '#1088#1077#1076#1072#1082#1090#1080#1088#1091#1077#1090#1089#1103'! '#1053#1077#1083#1100#1079#1103' '#1088#1077#1076#1072#1082#1090#1080#1088#1086#1074#1072#1090#1100' '#1087#1072#1088#1072#1083#1083#1077#1083 +
        #1100#1085#1086'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '11039423=    EXIT;'
      '11039424=  END'
      '11039425='
      '11039426=  SELECT'
      '11039427=    T.DATE_RECEIPT,'
      '11039428=    T.TIME_RECEIPT,'
      '11039429=    T.G_CLIENT,'
      '11039430=    T.G_PAYMENT_TYPE,'
      '11039431=    T.OSNOVANIE,'
      '11039432=    T.NOTE,'
      '11039433=    T.SUMM,'
      '11039434=    T.SUMM_FACT,'
      '11039435=    T.IS_PAYED_ALL'
      '11039436=    ,T.SUMM_CURRENCY'
      '11039437=  FROM SKLAD_PARENT T'
      '11039438=  WHERE T.SKLAD = :SKLAD_'
      '11039439=  INTO'
      '11039440=    :DATE_RECEIPT_,'
      '11039441=    :TIME_RECEIPT_,'
      '11039442=    :G_CLIENT_,'
      '11039443=    :G_PAYMENT_TYPE_,'
      '11039444=    :OSNOVANIE_,'
      '11039445=    :NOTE_,'
      '11039446=    :SUMM_,'
      '11039447=    :SUMM_FACT_,'
      '11039448=    :IS_PAYED_ALL_'
      '11039449=    ,:SUMM_CURRENCY_;'
      '11039450='
      '11039451=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '11039452=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRIC' +
        'E, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY,'
      '11039453=                         SUMM_CURRENCY,'
      
        '11039454=                         charge_ROZN_proc, PRICE_ROZN, ' +
        'charge_opt_proc, PRICE_OPT)'
      
        '11039455=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_TM' +
        'P, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKLA' +
        'D_, PRICE_CURRENCY,'
      '11039456=                SUMM_CURRENCY,'
      '11039457=                ROUND((G.PRICE/S.PRICE - 1)*100, 2),'
      '11039458=                G.PRICE,'
      
        '11039459=                ROUND((G.volume_price/S.PRICE - 1)*100,' +
        ' 2),'
      '11039460=                G.VOLUME_PRICE'
      '11039461=    FROM SKLAD S, G_PRODUCT G'
      '11039462=   WHERE SKLAD_PARENT = :SKLAD_'
      '11039463=     AND S.g_product = G.g_product'
      '11039464=   ORDER BY SKLAD;'
      '11039465='
      '11039466=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '11039467=  SELECT K.G_PRIHOD_RASHOD,'
      '11039468=         K.SUMM'
      
        '11039469=    FROM (select * from KASSA union all select * from k' +
        'assa_beznal) K'
      '11039470=   WHERE K.SKLAD = :SKLAD_'
      '11039471=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '11039472=    INTO :G_PRIHOD_,'
      '11039473=         :SUMM_PRIHOD_;'
      '11039474='
      
        '11039475=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNIN' +
        'G_VALUES :PAYMENTS_;'
      '11039476='
      
        '11039477=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' '#1045 +
        #1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044 +
        #1040#1058#1067
      
        '11039478=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044#1059 +
        ' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053#1040 +
        ' 0, '#1058#1054' '#1061#1045#1056
      '11039479=  HaveRight_ = 1;'
      '11039480=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '11039481=    SELECT ID'
      '11039482=      FROM CUR_PARAMS'
      '11039483=     WHERE CUR_PARAMS = 1'
      '11039484=      INTO :G_OFFICIAL_CUR_;'
      '11039485='
      
        '11039486=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080#1094 +
        #1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' '#1074 +
        #1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '11039487=      HaveRight_ = 1;'
      '11039488=    else'
      
        '11039489=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICIA' +
        'L_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '11039490=  END'
      '11039491=end'
      '11039492='#39';'
      '11039493='
      '11039494=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD('
      '11039495=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '11039496=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      
        '11039497=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIP' +
        'T,'
      '11039498=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '11039499=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '11039500=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '11039501=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '11039502=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '11039503=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11039504=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11039505=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11039506=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11039507=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11039508=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY = 0,'
      
        '11039509=  SKLAD_NAKL_ID_ TYPE OF COLUMN SKLAD.SKLAD_PARENT = NU' +
        'LL)'
      '11039510=RETURNS ('
      '11039511=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11039512=  ERR_CODE INTEGER,'
      '11039513=  ERR_MSG VARCHAR(1024))'
      '11039514=AS'
      '11039515=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '11039516=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042#1040 +
        #1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '11039517=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '11039518=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '11039519=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050 +
        #1048
      
        '11039520=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' '#1057 +
        #1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '11039521=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050#1040 +
        #1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047#1044 +
        #1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '11039522=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059#1044 +
        #1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM ' +
        #1041#1059#1044#1059
      '11039523=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '11039524=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047#1053 +
        #1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048' ' +
        #1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '11039525=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD'#39#39';'
      '11039526=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11039527=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11039528=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11039529=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11039530=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11039531=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '11039532=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM = 0;'
      
        '11039533=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      '11039534=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11039535=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIH' +
        'OD_RASHOD.G_PRIHOD_RASHOD;'
      
        '11039536=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11039537=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '11039538=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11039539=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11039540=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11039541=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11039542=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11039543=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11039544=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.P' +
        'RICE_CURRENCY;'
      
        '11039545=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKLA' +
        'D.SUMM_CURRENCY;'
      
        '11039546=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11039547=BEGIN'
      '11039548='
      '11039549=  PNT_ = '#39#39'00'#39#39';'
      '11039550=  IS_THIS_LAST_ = 0;'
      '11039551='
      '11039552=  IF (G_TOCHKA_ IS NULL) THEN'
      '11039553=    SELECT ID'
      '11039554=      FROM CUR_PARAMS'
      '11039555=     WHERE CUR_PARAMS = 2'
      '11039556=      INTO :G_TOCHKA_;'
      '11039557='
      '11039558=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11039559=  SELECT ID'
      '11039560=    FROM CUR_PARAMS'
      '11039561=   WHERE CUR_PARAMS = 1'
      '11039562=    INTO :G_OFFICIAL_;'
      '11039563='
      '11039564=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '11039565=                            DATE_RECEIPT,'
      '11039566=                            TIME_RECEIPT,'
      '11039567=                            G_CLIENT,'
      '11039568=                            G_PAYMENT_TYPE,'
      '11039569=                            OSNOVANIE,'
      '11039570=                            NOTE,'
      '11039571=                            SUMM,'
      '11039572=                            SUMM_FACT,'
      '11039573=                            SUMM_CURRENCY,'
      '11039574=                            IS_PAYED_ALL,'
      '11039575=                            IS_VOZVRAT,'
      '11039576=                            G_TOCHKA'
      '11039577=                            ,G_OFFICIAL)'
      '11039578=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11039579=          :DATE_RECEIPT_,'
      '11039580=          :TIME_RECEIPT_,'
      '11039581=          :G_CLIENT_,'
      '11039582=          :G_PAYMENT_TYPE_,'
      '11039583=          :OSNOVANIE_,'
      '11039584=          :NOTE_,'
      '11039585=          :SUMM_,'
      '11039586=          :SUMM_FACT_,'
      '11039587=          :SUMM_CURRENCY_,'
      
        '11039588=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PAY' +
        'ED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055 +
        #1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11039589=          :IS_VOZVRAT_,'
      '11039590=          :G_TOCHKA_'
      '11039591=          ,:G_OFFICIAL_)'
      '11039592=  RETURNING'
      '11039593=    SKLAD'
      '11039594=  INTO'
      '11039595=    :SKLAD_;'
      '11039596='
      '11039597=  PNT_ = '#39#39'01'#39#39';'
      '11039598=  FOR SELECT SKLAD,'
      '11039599=             G_PRODUCT,'
      '11039600=             AMOUNT,'
      '11039601=             PRICE,'
      '11039602=             SUMM,'
      '11039603=             NDS,'
      '11039604=             NDS_SUMM'
      '11039605=             ,PRICE_CURRENCY'
      '11039606=             ,SUMM_CURRENCY'
      '11039607=        FROM SKLAD_TMP'
      
        '11039608=       WHERE SKLAD_PARENT = COALESCE(:SKLAD_NAKL_ID_, S' +
        'KLAD_PARENT)'
      '11039609=      ORDER BY 1'
      '11039610=      INTO :SKLAD_TMP_,'
      '11039611=           :RG_PRODUCT_,'
      '11039612=           :RAMOUNT_,'
      '11039613=           :RPRICE_,'
      '11039614=           :RSUMM_,'
      '11039615=           :RNDS_,'
      '11039616=           :RNDS_SUMM_'
      '11039617=           ,:PRICE_CURRENCY_'
      '11039618=           ,:SUMM_CURRENCY_TMP_'
      '11039619=  DO BEGIN'
      '11039620=    if (IS_VOZVRAT_ IN (0,4)) then BEGIN'
      
        '11039621=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '11039622=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068#1064 +
        #1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '11039623=      IS_THIS_LAST_ = 0;'
      '11039624=      SELECT MAX(SK.DATE_RECEIPT)'
      '11039625=        FROM SKLAD SK'
      '11039626=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11039627=         AND SK.IS_LAST = 1'
      '11039628=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '11039629=        INTO :DATE_LAST_;'
      '11039630='
      
        '11039631=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (D' +
        'ATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11039632=        UPDATE SKLAD SK'
      '11039633=           SET SK.IS_LAST = 0'
      '11039634=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11039635=           AND SK.IS_LAST = 1'
      '11039636=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '11039637='
      '11039638=        IS_THIS_LAST_ = 1;'
      '11039639=      END'
      '11039640=    END'
      '11039641='
      '11039642=    INSERT INTO SKLAD'
      '11039643=    ('
      '11039644=     SKLAD,'
      '11039645=     SKLAD_PARENT,'
      '11039646=     DATE_RECEIPT,'
      '11039647=     G_CLIENT,'
      '11039648=     G_PRODUCT,'
      '11039649=     AMOUNT,'
      '11039650=     PRICE,'
      '11039651=     SUMM,'
      '11039652=     G_PAYMENT_TYPE,'
      '11039653=     OSNOVANIE,'
      '11039654=     NOTE,'
      '11039655=     NDS,'
      '11039656=     NDS_SUMM,'
      '11039657=     IS_LAST,'
      '11039658=     IS_VOZVRAT,'
      '11039659=     G_TOCHKA'
      '11039660=     ,PRICE_CURRENCY'
      '11039661=     ,SUMM_CURRENCY'
      '11039662=    ) VALUES ('
      '11039663=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '11039664=     :SKLAD_,'
      '11039665=     :DATE_RECEIPT_,'
      '11039666=     :G_CLIENT_,'
      '11039667=     :RG_PRODUCT_,'
      '11039668=     :RAMOUNT_,'
      '11039669=     :RPRICE_,'
      '11039670=     :RSUMM_,'
      '11039671=     :G_PAYMENT_TYPE_,'
      '11039672=     :OSNOVANIE_,'
      '11039673=     :NOTE_,'
      '11039674=     :RNDS_,'
      '11039675=     :RNDS_SUMM_,'
      
        '11039676=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057#1051 +
        #1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054#1064 +
        #1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044#1045 +
        #1058' 0'
      '11039677=     :IS_VOZVRAT_,'
      '11039678=     :G_TOCHKA_'
      '11039679=     ,:PRICE_CURRENCY_'
      '11039680=     ,:SUMM_CURRENCY_TMP_'
      '11039681=    );'
      '11039682='
      
        '11039683=    -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '11039684=    PNT_ = '#39#39'02'#39#39';'
      '11039685=    UPDATE LT_SKLAD_PRODUCT L'
      '11039686=       SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11039687=     WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11039688=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '11039689='
      '11039690=    IF (ROW_COUNT = 0) THEN'
      
        '11039691=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, G' +
        '_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(GEN_L' +
        'T_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11039692=  END'
      '11039693=  ----------------------------------------'
      '11039694='
      
        '11039695=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058#1042 +
        ', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', '#1048 +
        ' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '11039696=  PNT_ = '#39#39'05'#39#39';'
      
        '11039697=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BEG' +
        'IN'
      '11039698=      IF (:IS_VOZVRAT_ = 1) THEN'
      '11039699=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11039700=      ELSE'
      '11039701=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '11039702='
      
        '11039703=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063#1058 +
        #1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053' ' +
        #1055#1051#1040#1058#1045#1046
      '11039704=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '11039705=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11039706=                                        :G_PRIHOD_RASHO' +
        'D_,'
      '11039707=                                        :SUMM_FACT_,'
      '11039708=                                        :DATE_RECEIPT_,'
      
        '11039709=                                        NULL,   --NOTE_' +
        ' => :NOTE_,'
      
        '11039710=                                        NULL,   --ZAKAZ' +
        '_'
      '11039711=                                        :SKLAD_,'
      
        '11039712=                                        :G_PAYMENT_TYPE' +
        '_,'
      
        '11039713=                                        :G_TOCHKA_) RET' +
        'URNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11039714=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11039715=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11039716=            EXIT;'
      '11039717=          END'
      '11039718=      END ELSE BEGIN'
      '11039719=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '11039720=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '11039721=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) T' +
        'HEN'
      
        '11039722=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR POS' +
        '_TILDA_ - 1);'
      '11039723=            ELSE'
      
        '11039724=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CHA' +
        'R_LENGTH(PAYMENTS_) - 1);'
      '11039725='
      '11039726=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '11039727=                RETURNING_VALUES :PAYMENT_ID_, :PAYMENT' +
        '_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11039728='
      
        '11039729=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (POS' +
        'ITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '11039730='
      '11039731=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11039732=                EXECUTE PROCEDURE K_INS_KASSA(1,     --' +
        ' ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11039733=                                              :G_PRIHOD' +
        '_RASHOD_,'
      
        '11039734=                                              :PAYMENT_' +
        'SUMM_,'
      
        '11039735=                                              :PAYMENT_' +
        'DATE_,'
      
        '11039736=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11039737=                                              NULL,   -' +
        '-ZAKAZ_'
      '11039738=                                              :SKLAD_,'
      
        '11039739=                                              :PAYMENT_' +
        'TYPE_,'
      
        '11039740=                                              :G_TOCHKA' +
        '_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11039741=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11039742=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PN' +
        'T_||'#39#39' '#39#39'||ERR_MSG;'
      '11039743=                  EXIT;'
      '11039744=                END'
      '11039745=            END'
      '11039746=          END'
      '11039747=      END'
      '11039748=  END'
      '11039749='
      
        '11039750=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054 +
        #1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '11039751=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11039752=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ => ' +
        ':ACTION_'
      '11039753=                                  G_PRIHOD_,'
      '11039754=                                  :SUMM_PRIHOD_,'
      '11039755=                                  :DATE_RECEIPT_,'
      
        '11039756=                                  NULL,   --NOTE_ => :N' +
        'OTE_,'
      '11039757=                                  NULL,   --:ZAKAZ_,'
      '11039758=                                  :SKLAD_,'
      '11039759=                                  :G_PAYMENT_TYPE_,'
      
        '11039760=                                  :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11039761=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11039762=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||E' +
        'RR_MSG;'
      '11039763=      EXIT;'
      '11039764=    END'
      '11039765=  END'
      '11039766=end'
      '11039767='#39';'
      '11039768='
      '11039769=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD_TMP1('
      '11039770=  SKLAD_ TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '11039771=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '11039772=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD.SKLAD_PARENT)'
      '11039773=AS'
      
        '11039774=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD_TM' +
        'P'#39#39';'
      
        '11039775=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '11039776=DECLARE VARIABLE PRICE_ROZN_LOC_ TYPE OF COLUMN G_PRODU' +
        'CT.PRICE;'
      
        '11039777=DECLARE VARIABLE PRICE_OPT_LOC_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      
        '11039778=DECLARE VARIABLE CHARGE_ROZN_PROC_ TYPE OF MY_NUMERIC =' +
        ' 0;'
      
        '11039779=DECLARE VARIABLE CHARGE_OPT_PROC_ TYPE OF MY_NUMERIC = ' +
        '0;'
      '11039780=BEGIN'
      '11039781='
      '11039782=  -- '#1042#1067#1063#1048#1057#1051#1071#1070' '#1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1057#1059#1052#1052#1059
      '11039783=  SELECT S.PRICE'
      '11039784=    FROM SKLAD S'
      
        '11039785=   WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHERE ' +
        'CUR_PARAMS = 2)'
      '11039786=     AND S.IS_LAST = 1'
      '11039787=     AND S.G_PRODUCT = :G_PRODUCT_'
      '11039788=    INTO :LAST_SELF_PRICE_;'
      '11039789='
      '11039790=  SELECT G.price,'
      '11039791=         G.volume_price'
      '11039792=    FROM G_PRODUCT G'
      '11039793=   WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11039794=    INTO :PRICE_ROZN_LOC_,'
      '11039795=         :PRICE_OPT_LOC_;'
      '11039796='
      '11039797=  IF (COALESCE(LAST_SELF_PRICE_, 0) > 0) THEN BEGIN'
      
        '11039798=    CHARGE_ROZN_PROC_ = ROUND((PRICE_ROZN_LOC_/LAST_SEL' +
        'F_PRICE_ - 1)*100, 2);'
      
        '11039799=    CHARGE_OPT_PROC_  = ROUND((PRICE_OPT_LOC_/LAST_SELF' +
        '_PRICE_ - 1)*100, 2);'
      '11039800=  END'
      '11039801='
      
        '11039802=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, PRICE, AMOUN' +
        'T, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PRICE_OPT,'
      '11039803=                         SKLAD_PARENT)'
      
        '11039804=  VALUES (:SKLAD_, :G_PRODUCT_, COALESCE(:LAST_SELF_PRI' +
        'CE_, 0), 1, :CHARGE_ROZN_PROC_, :PRICE_ROZN_LOC_, :CHARGE_OPT_PR' +
        'OC_, :PRICE_OPT_LOC_,'
      '11039805=          :SKLAD_PARENT_);'
      '11039806=END'
      '11039807='#39';'
      '11039808=END  --END_EXECUTE_BLOCK'
      '11039809=EXECUTE BLOCK AS BEGIN'
      '11039810='
      '11039811=EXECUTE STATEMENT '#39'ALTER PROCEDURE PROCEDURE_UPDATE2'
      '11039812=AS'
      
        '11039813=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1056#1045#1044#1053#1040#1047#1053#1040#1063#1045#1053#1040' '#1044#1051#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1062#1045#1053' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045 +
        ' '#1058#1054#1042#1040#1056#1040'.'
      
        '11039814='#1057#1070#1044#1040' '#1055#1054#1057#1058#1059#1055#1040#1045#1058' ID '#1058#1054#1051#1068#1050#1054' '#1063#1058#1054' '#1057#1054#1047#1044#1040#1053#1053#1054#1043#1054' '#1048#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1053#1054#1043#1054 +
        ' '#1055#1056#1048#1061#1054#1044#1040'*/'
      
        '11039815=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'PROCEDURE_UPD' +
        'ATE2'#39#39';'
      '11039816=DECLARE VARIABLE PRICE_ MY_NUMERIC;'
      '11039817=DECLARE VARIABLE PRICE_OPT_ MY_NUMERIC;'
      
        '11039818=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      '11039819=BEGIN'
      '11039820=  FOR SELECT S.price_rozn,'
      '11039821=             S.price_opt,'
      '11039822=             S.g_product'
      '11039823=        FROM sklad_TMP S,'
      '11039824=             g_product P'
      '11039825=       WHERE S.g_product = P.g_product'
      
        '11039826=         AND (S.price_rozn <> P.PRICE OR S.price_opt <>' +
        ' P.volume_price)'
      '11039827=        INTO :PRICE_,'
      '11039828=             :PRICE_OPT_,'
      '11039829=             :G_PRODUCT_'
      '11039830=  DO BEGIN'
      '11039831=    UPDATE G_PRODUCT G'
      '11039832=       SET G.price = :PRICE_,'
      '11039833=           G.VOLUME_PRICE = :PRICE_OPT_'
      '11039834=     WHERE G.g_product = :G_PRODUCT_;'
      '11039835=  END'
      '11039836=END'
      '11039837='#39';'
      '11039838='
      '11039839=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD('
      '11039840=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11039841=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '11039842=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIP' +
        'T,'
      '11039843=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '11039844=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '11039845=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '11039846=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '11039847=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11039848=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '11039849=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11039850=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11039851=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11039852=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '11039853=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY = 0)'
      '11039854=RETURNS ('
      '11039855=  ERR_CODE INTEGER,'
      '11039856=  ERR_MSG VARCHAR(1024))'
      '11039857=AS'
      '11039858=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'UPD_SKLAD'#39#39';'
      '11039859=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11039860=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA;'
      '11039861=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11039862=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '11039863=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      '11039864=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '11039865=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOUN' +
        'T;'
      
        '11039866=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLAD' +
        '.DATE_RECEIPT;'
      '11039867=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '11039868=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '11039869=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '11039870=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '11039871=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      
        '11039872=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN SKL' +
        'AD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '11039873=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLAD.' +
        'G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058' ' +
        '*/'
      
        '11039874=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11039875=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '11039876=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11039877=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11039878=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11039879=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11039880=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      
        '11039881=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      '11039882=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11039883=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11039884=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '11039885=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.P' +
        'RICE_CURRENCY;'
      
        '11039886=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKLA' +
        'D.SUMM_CURRENCY;'
      '11039887=DECLARE VARIABLE PROD_NAME_ERROR_ VARCHAR(1024);'
      '11039888=BEGIN'
      '11039889='
      
        '11039890=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1070' - '#1055#1054#1057#1051#1045' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1051#1048' '#1052#1048#1053#1059#1057#1054#1042' '#1055#1054' '#1057#1050#1051#1040#1044#1059
      '11039891=  IF (ALLOW_SELL_ABSENT_GOODS_ = 1) THEN BEGIN'
      '11039892=        SELECT SUBSTRING(GG.NAME FROM 1 FOR 100)'
      
        '11039893=          FROM (SELECT L.AMOUNT - (S.AMOUNT - ST.AMOUNT' +
        ') AMOUNT,       -- '#1058#1045#1050#1059#1065#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1052#1048#1053#1059#1057' '#1056#1040#1047#1053#1048#1062#1040' '#1057#1058#1040#1056#1054#1043#1054' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1040' '#1048' '#1053#1054#1042#1054#1043#1054
      '11039894=                       ST.G_PRODUCT'
      
        '11039895=                  FROM (SELECT SUM(AMOUNT) AMOUNT, G_PR' +
        'ODUCT FROM SKLAD_TMP WHERE SKLAD_PARENT = :SKLAD_PARENT_ GROUP B' +
        'Y G_PRODUCT) ST,'
      '11039896=                       sklad S,'
      '11039897=                       LT_SKLAD_PRODUCT L'
      '11039898=                 WHERE S.sklad_parent = 30023'
      '11039899=                   AND S.g_product = ST.G_PRODUCT'
      '11039900=                   AND L.G_PRODUCT = ST.G_PRODUCT) TT,'
      '11039901=                G_PRODUCT GG'
      '11039902=         WHERE TT.AMOUNT < 0'
      '11039903=           AND TT.G_PRODUCT = GG.G_PRODUCT'
      
        '11039904=          ROWS 1 TO 1       -- '#1063#1058#1054#1041#1067' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1055#1045 +
        #1056#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1053#1040#1060#1048#1043' '#1054#1057#1058#1040#1051#1068#1053#1067#1045
      '11039905=          INTO :PROD_NAME_ERROR_;'
      '11039906='
      '11039907=        IF (PROD_NAME_ERROR_ IS NOT NULL) THEN BEGIN'
      '11039908=          ERR_CODE = -20500;'
      
        '11039909=          ERR_MSG = '#39#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088 +
        #1072' '#39#39'||PROD_NAME_ERROR_||ASCII_CHAR(10)||'
      
        '11039910=                    '#39#39#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'. '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077 +
        #1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39';'
      
        '11039911=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_M' +
        'SG) RETURNING_VALUES (:ERR_MSG);'
      '11039912=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11039913=          EXIT;'
      '11039914=        END'
      '11039915=  END'
      '11039916=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1052#1048#1053#1059#1057#1054#1042#1067#1061' '#1058#1054#1042#1040#1056#1054#1042
      '11039917='
      '11039918=  IS_THIS_LAST_ = 0;'
      '11039919='
      '11039920=  SELECT S.G_TOCHKA,'
      '11039921=         S.IS_VOZVRAT,'
      '11039922=         S.G_PAYMENT_TYPE'
      '11039923=    FROM SKLAD_parent S'
      '11039924=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '11039925=    INTO :G_TOCHKA_,'
      '11039926=         :IS_VOZVRAT_,'
      '11039927=         :G_PAYMENT_TYPE_OLD_;'
      '11039928='
      '11039929=  PNT_ = '#39#39'00'#39#39';'
      '11039930=  UPDATE SKLAD_PARENT'
      '11039931=  SET'
      
        '11039932=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEIPT' +
        '),'
      
        '11039933=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEIPT' +
        '),'
      
        '11039934=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYMEN' +
        'T_TYPE),'
      '11039935=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '11039936=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '11039937=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '11039938=   SUMM      = :SUMM_,'
      '11039939=   SUMM_FACT = :SUMM_FACT_,'
      '11039940=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '11039941=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0)  -' +
        '- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057 +
        #1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11039942=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '11039943='
      
        '11039944=  -----------------------------------------------------' +
        '--------'
      '11039945=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040
      '11039946=  PNT_ = '#39#39'02'#39#39';'
      '11039947=  FOR SELECT SKLAD'
      '11039948=        FROM SKLAD S'
      '11039949=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '11039950=         AND NOT EXISTS (SELECT 1'
      '11039951=                           FROM SKLAD_TMP T'
      '11039952=                        WHERE T.SKLAD = S.SKLAD'
      
        '11039953=                          AND T.sklad_parent = :SKLAD_P' +
        'ARENT_)'
      '11039954=  INTO :SKLAD_'
      '11039955=  DO BEGIN'
      
        '11039956=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL_ONE(:SKLAD_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11039957=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11039958=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||E' +
        'RR_MSG;'
      '11039959=      EXIT;'
      '11039960=    END'
      '11039961=  END'
      '11039962='
      
        '11039963=  -----------------------------------------------------' +
        '--------'
      
        '11039964=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044#1054#1041 +
        #1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '11039965=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '11039966=  PNT_ = '#39#39'03'#39#39';'
      '11039967=  FOR SELECT S.SKLAD,'
      '11039968=             S.G_PRODUCT,'
      '11039969=             S.AMOUNT,'
      '11039970=             S.PRICE,'
      '11039971=             S.SUMM,'
      '11039972=             S.NDS,'
      '11039973=             S.NDS_SUMM,'
