        '_UHOD_SKL_;'
      '110241788='
      '110241789=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '110241790=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '110241791=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD,' +
