      '110241722=            SUMM_PRIHOD_    = 0;'
      '110241723=            AMOUNT_UHOD_    = 0;'
      '110241724=            SUMM_UHOD_      = 0;'
      '110241725=            AMOUNT_SPISANO_ = 0;'
      '110241726=            SUMM_SPISANO_   = 0;'
      '110241727=            AMOUNT_VOZVRAT_ = 0;'
      '110241728=            SUMM_VOZVRAT_   = 0;'
