      '1102358='#39';'
      '1102359='
      '1102360='
      
        '1102364=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP' +
        '('
      
        '1102365=  G_PRODUCT_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT */ INTEGER,'
      
        '1102366=  AMOUNT_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ ' +
        'NUMERIC(15,2),'
      
        '1102367=  PRICE_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NU' +
        'MERIC(15,2),'
      
        '1102368=  SUMM_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUME' +
        'RIC(15,2),'
      '1102369=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1102370=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1102371=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1102372=  NDS_ /* TYPE OF COLUMN SKLAD.NDS */ NUMERIC(15,2),'
      
        '1102373=  NDS_SUMM_ /* TYPE OF COLUMN SKLAD.NDS_SUMM */ NUMERIC(' +
        '15,2),'
      
        '1102374=  COST_PRICE_ /* TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ' */ NUMERIC(15,2),'
      '1102375=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1102376=  IS_SPISANIE_ INTEGER,'
      '1102377=  NEW_LINE_SALE_ INTEGER = 0,'
      '1102378=  MODE_ INTEGER = 0)'
      '1102379=RETURNS ('
      
        '1102380=  ZAKAZ_DETAILS_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS */ INTEGER,'
      '1102381=  ERR_CODE INTEGER,'
      '1102382=  ERR_MSG VARCHAR(1024))'
      '1102383=AS'
      '1102384=BEGIN'
      '1102385=  SUSPEND;'
      '1102386=END'
      '1102387='#39';'
      '1102388='
      '1102389=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAKAZ_NA_REAL('
      
        '1102390=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ INTEG' +
        'ER,'
      
        '1102391=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT */ INTEGER,'
      '1102392=  DATE_BEGIN_ DATE,'
      '1102393=  DATE_END_ DATE,'
      '1102394=  G_CATEGORY_ VARCHAR(1000),'
      '1102395=  G_PRODUCT_ VARCHAR(1000),'
      '1102396=  MODE_ INTEGER,'
      '1102397=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '1102398=RETURNS ('
      
        '1102399=  ZAKAZ_DATE /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE' +
        '.ZAKAZ_DATE */ DATE,'
      
        '1102400=  NAME /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.NAME ' +
        '*/ VARCHAR(500),'
      
        '11023101=  ARTICUL /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.A' +
        'RTICUL */ VARCHAR(30),'
      
        '11023102=  PRICE /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.PRI' +
        'CE */ NUMERIC(15,2),'
      
        '11023103=  AMOUNT_ALL /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABL' +
        'E.AMOUNT_ALL */ NUMERIC(15,2),'
      
        '11023104=  SUMM_ALL /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.' +
        'SUMM_ALL */ NUMERIC(15,2),'
      
        '11023105=  AMOUNT_PAYED /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TA' +
        'BLE.AMOUNT_PAYED */ NUMERIC(15,2),'
      
        '11023106=  SUMM_PAYED /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABL' +
        'E.SUMM_PAYED */ NUMERIC(15,2),'
      
        '11023107=  AMOUNT_RETURNED /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL' +
        '_TABLE.AMOUNT_RETURNED */ NUMERIC(15,2),'
      
        '11023108=  SUMM_RETURNED /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_T' +
        'ABLE.SUMM_RETURNED */ NUMERIC(15,2),'
      
        '11023109=  AMOUNT_LEFT /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TAB' +
        'LE.AMOUNT_LEFT */ NUMERIC(15,2),'
      
        '11023110=  SUMM_LEFT /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE' +
        '.SUMM_LEFT */ NUMERIC(15,2),'
      
        '11023111=  IS_HEAD /* TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.I' +
        'S_HEAD */ INTEGER)'
      '11023112=AS'
      '11023113=BEGIN'
      '11023114=  SUSPEND;'
      '11023115=END'
      '11023116='#39';'
      '11023117='
      '11023118=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '11023119=RETURNS ('
      '11023120=  SKLAD /* TYPE OF COLUMN SKLAD_TMP.SKLAD */ INTEGER,'
      
        '11023121=  G_PRODUCT /* TYPE OF COLUMN SKLAD_TMP.G_PRODUCT */ IN' +
        'TEGER,'
      
        '11023122=  AMOUNT /* TYPE OF COLUMN SKLAD_TMP.AMOUNT */ NUMERIC(' +
        '15,2),'
      
        '11023123=  PRICE /* TYPE OF COLUMN SKLAD_TMP.PRICE */ NUMERIC(15' +
        ',2),'
      
        '11023124=  SUMM /* TYPE OF COLUMN SKLAD_TMP.SUMM */ NUMERIC(15,2' +
        '),'
      '11023125=  NDS /* TYPE OF COLUMN SKLAD_TMP.NDS */ NUMERIC(15,2),'
      
        '11023126=  NDS_SUMM /* TYPE OF COLUMN SKLAD_TMP.NDS_SUMM */ NUME' +
        'RIC(15,2),'
      
        '11023127=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '11023128=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11023129=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NU' +
        'MERIC(15,2))'
      '11023130=AS'
      '11023131=BEGIN'
      '11023132=  SUSPEND;'
      '11023133=END'
      '11023134='#39';'
      '11023135='
      '11023136='
      '11023140=EXECUTE STATEMENT '#39'ALTER PROCEDURE IMPORT_DOWNLOAD('
      '11023141=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11023142=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11023143=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11023144=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11023145=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11023146=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11023147=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11023148=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11023149=RETURNS ('
      '11023150=  ERR_CODE INTEGER,'
      '11023151=  ERR_MSG VARCHAR(1024))'
      '11023152=AS'
      '11023153=/*'
      
        '11023154='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059' '#1044 +
        #1040#1053#1053#1067#1061
      
        '11023155='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054' '#1055 +
        #1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '11023156='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '11023157=*/'
      
        '11023158=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'IMPORT_DOWNLO' +
        'AD'#39#39';'
      '11023159=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11023160=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.BARCODE;'
      
        '11023161=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.ARTICUL;'
      
        '11023162=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TMP.' +
        'AMOUNT;'
      
        '11023163=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP.P' +
        'RICE;'
      
        '11023164=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.DISCOUNT;'
      '11023165=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '11023166=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11023167=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2)' +
        ';'
      
        '11023168=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      '11023169=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11023170=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.ZAKAZ_DETAILS;'
      
        '11023171=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      '11023172=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11023173=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      
        '11023174=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      '11023175=BEGIN'
      '11023176='
      '11023177=  PNT_ = '#39#39'00'#39#39';'
      '11023178=  CLRF = ascii_char( 10 );'
      '11023179='
      '11023180=  SELECT S.S_VALUE'
      '11023181=    FROM SYSTEM_SETUP S'
      '11023182=   WHERE S.SYSTEM_SETUP = 2'
      '11023183=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11023184='
      '11023185=  PNT_ = '#39#39'01'#39#39';'
      '11023186=  SELECT G.nds_value'
      '11023187=    FROM G_FIRM_REKVIZIT G'
      '11023188=   WHERE G.is_default = 1'
      '11023189=    INTO :NDS_;'
      '11023190='
      '11023191=  PNT_ = '#39#39'02'#39#39';'
      
        '11023192=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '11023193=        FROM IMPORT_TBL_TMP'
      
        '11023194=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_, :' +
        'DISCOUNT_'
      '11023195=  DO BEGIN'
      '11023196=    SELECT G_PRODUCT'
      '11023197=      FROM ('
      '11023198=            SELECT P.G_PRODUCT'
      '11023199=              FROM G_PRODUCT P'
      
        '11023200=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(COAL' +
        'ESCE(P.BARCODE, '#39#39#39#39')) <> '#39#39#39#39')'
      
        '11023201=                OR (P.ARTICUL = :ARTICUL_ and TRIM(COAL' +
        'ESCE(P.ARTICUL, '#39#39#39#39')) <> '#39#39#39#39')'
      '11023202=            UNION'
      '11023203=            SELECT LT.G_PRODUCT'
      '11023204=              FROM LT_BARCODE LT'
      
        '11023205=             WHERE LT.BARCODE = :BARCODE_ and TRIM(COAL' +
        'ESCE(LT.BARCODE, '#39#39#39#39')) <> '#39#39#39#39
      '11023206=           )'
      '11023207=      INTO :G_PRODUCT_;'
      '11023208='
      '11023209=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      
        '11023210=      ERR_MSG = '#39#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39#39 +
        '||BARCODE_||'#39#39', '#1072#1088#1090#1080#1082#1091#1083' '#39#39'||ARTICUL_;'
      '11023211=      Exit;'
      '11023212=    END'
      '11023213='
      '11023214=    PNT_ = '#39#39'03'#39#39';'
      '11023215=    DISCOUNT_PERC_ = DISCOUNT_ * 100 / PRICE_;'
      
        '11023216=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, ' +
        ':G_TOCHKA_, 1)'
      '11023217=      RETURNING_VALUES :COST_PRICE_;'
      '11023218='
      '11023219=    PNT_ = '#39#39'04'#39#39';'
      
        '11023220=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PRODUC' +
        'T_,'
      '11023221=                                              :AMOUNT_,'
      '11023222=                                              :PRICE_,'
      
        '11023223=                                              :AMOUNT_ ' +
        '* (:PRICE_ - :DISCOUNT_),'
      
        '11023224=                                              :DISCOUNT' +
        '_PERC_,'
      
        '11023225=                                              :DISCOUNT' +
        '_,'
      
        '11023226=                                              :AMOUNT_ ' +
        '* :DISCOUNT_,'
      '11023227=                                              :NDS_,'
      
        '11023228=                                              SUMM_ * N' +
        'DS_ / (100 + NDS_),'
      
        '11023229=                                              :COST_PRI' +
        'CE_,'
      
        '11023230=                                              :ALLOW_SE' +
        'LL_ABSENT_GOODS_,'
      
        '11023231=                                              0,     --' +
        'IS_SPISANIE_'
      
        '11023232=                                              1,     --' +
        ' NEW_LINE_SALE_'
      
        '11023233=                                              0     --M' +
        'ODE_'
      
        '11023234=                                              ) RETURNI' +
        'NG_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '11023235=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11023236=      ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE ' +
        '= '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39',' +
        ' ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11023237=      EXIT;'
      '11023238=    END'
      '11023239='
      '11023240=    G_PRODUCT_ = NULL;'
      '11023241=  END'
      '11023242='
      '11023243=  PNT_ = '#39#39'05'#39#39';'
      '11023244=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '11023245=  if (G_PAYMENT_TYPE_ = 1) then'
      '11023246=    SUMM_CASH_ = summ_fact_;'
      '11023247=  ELSE'
      '11023248=    SUMM_NONCASH_ = summ_fact_;'
      '11023249='
      '11023250=  PNT_ = '#39#39'06'#39#39';'
      '11023251=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '11023252=                              :Z_DATE_,'
      '11023253=                              :Z_TIME_,'
      '11023254=                              :G_CLIENT_,'
      '11023255=                              :G_PAYMENT_TYPE_,'
      '11023256=                              NULL, --:OSNOVANIE_,'
      '11023257=                              0,  -- IS_SPISANIE'
      '11023258=                              :NOTE_,'
      '11023259=                              :SUMM_,'
      '11023260=                              :SUMM_FACT_,'
      '11023261=                              :SUMM_CASH_,'
      '11023262=                              :SUMM_NONCASH_,'
      
        '11023263=                              0,    --:SUMM_PAY_BONUS__' +
        ','
      
        '11023264=                              0,    --:SUMM_BONUS_GOT__' +
        ','
      
        '11023265=                              NULL,        --:G_PRIHOD_' +
        ','
      
        '11023266=                              NULL,        --:SUMM_PRIH' +
        'OD_'
      '11023267=                              0,    -- :BY_RECIPE__,'
      '11023268=                              0,    -- IS_RESERVE__'
      '11023269=                              NULL -- :PAYMENTS__'
      '11023270=                              )'
      
        '11023271=                              RETURNING_VALUES :ZAKAZ_,' +
        ' :ERR_CODE, :ERR_MSG;'
      '11023272=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11023273=    ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE =' +
        ' '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ' +
        'ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11023274=    EXIT;'
      '11023275=  END'
      '11023276='
      '11023277=  DELETE FROM import_tbl_tmp;'
      '11023278='
      '11023279=WHEN ANY DO BEGIN'
      '11023280=    ERR_CODE = gdscode;'
      
        '11023281=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||gds' +
        'code;'
      '11023282=  END'
      '11023283=end'
      '11023284='#39';'
      '11023285='
      
        '11023286=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ_DETAILS_TM' +
        'P('
      
        '11023287=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT' +
        ','
      '11023288=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11023289=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11023290=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '11023291=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '11023292=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '11023293=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '11023294=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '11023295=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '11023296=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '11023297=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '11023298=  IS_SPISANIE_ INTEGER,'
      '11023299=  NEW_LINE_SALE_ INTEGER = 0,'
      '11023300=  MODE_ INTEGER = 0)'
      '11023301=RETURNS ('
      
        '11023302=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '11023303=  ERR_CODE INTEGER,'
      '11023304=  ERR_MSG VARCHAR(1024))'
      '11023305=AS'
      '11023306=/*'
      
        '11023307=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048#1058 +
        #1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '11023308=*/'
      
        '11023309=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39#39';'
      
        '11023310=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0;'
      
        '11023311=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.AMOUNT = 0;'
      
        '11023312=DECLARE VARIABLE ZAKAZ_ INTEGER = 0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID ' +
        #1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047#1040#1050#1040#1047' */'
      
        '11023313=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' */'
      
        '11023314=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '11023315=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.Z_TYPE = 0;'
      
        '11023316=DECLARE VARIABLE AMOUNT__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.AMOUNT;'
      
        '11023317=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.PRICE;'
      
        '11023318=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.cost_price;'
      
        '11023319=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '11023320=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KI' +
        'T;'
      
        '11023321=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051 +
        #1048#1062#1045' */'
      '11023322=BEGIN'
      '11023323='
      
        '11023324=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070#1058 +
        ' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '11023325=  SELECT T.ZAKAZ, T.Z_TYPE'
      '11023326=    FROM ZAKAZ_DETAILS_TMP T'
      '11023327=   WHERE T.ZAKAZ IS NOT NULL'
      
        '11023328=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089#1090 +
        #1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072' ' +
        'MULTIPLE ROWS IN SINGLETON SELECT'
      '11023329=    INTO :ZAKAZ_, :Z_TYPE_;'
      '11023330='
      
        '11023331=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051#1045 +
        #1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11023332=           ,G.IS_KIT'
      '11023333=           ,K.AMOUNT * :AMOUNT_'
      '11023334=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '11023335=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRIC' +
        'E)'
      
        '11023336=           ,(SELECT * FROM GET_LAST_SELF_PRICE(K.G_PROD' +
        'UCT_ITEM, NULL, 1)) COST_PRICE'
      
        '11023337=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K ' +
        'ON G.G_PRODUCT = K.G_PRODUCT'
      '11023338=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11023339=       AND IS_KIT = 1'
      '11023340=    UNION'
      
        '11023341=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054#1044 +
        #1040#1046
      '11023342=           ,G.IS_KIT'
      '11023343=           ,:AMOUNT_'
      '11023344=           ,:PRICE_'
      '11023345=           ,0'
      '11023346=           ,:COST_PRICE_'
      '11023347=      FROM G_PRODUCT G'
      '11023348=     WHERE G_PRODUCT = :G_PRODUCT_'
      '11023349=       AND IS_KIT <> 1'
      '11023350=      INTO :G_PRODUCT_'
      '11023351=           ,:IS_KIT_'
      '11023352=           ,:AMOUNT_'
      '11023353=           ,:PRICE__'
      '11023354=           ,:SOSTAV_PRICE_'
      '11023355=           ,:COST_PRICE__'
      '11023356=  DO BEGIN'
      
        '11023357=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090#1089 +
        #1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083#1077 +
        #1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '11023358=      IF (IS_KIT_ = 1) THEN BEGIN'
      '11023359=        IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '11023360=          PRICE__ = COST_PRICE__;'
      '11023361='
      
        '11023362=        END ELSE IF (Discount_perc_ <> 0) THEN BEGIN   ' +
        '   -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '11023363=          DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PERC_/10' +
        '0;'
      '11023364='
      '11023365='
      
        '11023366=        END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN BEGI' +
        'N   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '11023367=          DISCOUNT_PERC_ = PRICE_ * 100 / SOSTAV_PRICE_' +
        ';'
      '11023368=          DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_;'
      '11023369=        END'
      '11023370='
      '11023371=        DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT_;'
      '11023372=        SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOUNT_;'
      '11023373=        NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '11023374=      END'
      '11023375='
      
        '11023376=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045#1057 +
        #1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '11023377=      IF (NEW_LINE_SALE_ = 0) THEN'
      '11023378=          SELECT ZD.zakaz_details'
      '11023379=            FROM zakaz_details_tmp ZD'
      '11023380=           WHERE ZD.G_PRODUCT = :g_product_'
      '11023381=             AND ZD.PRICE = :PRICE__'
      '11023382=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '11023383=            INTO :ZAKAZ_DTLS_TMP_;'
      '11023384='
      '11023385='
      '11023386=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '11023387=        UPDATE ZAKAZ_DETAILS_TMP P'
      '11023388=           SET P.amount = P.amount + :amount_'
      
        '11023389=               ,P.summ = (P.price - P.discount_TENGE) *' +
        ' (P.amount + :AMOUNT_)'
      
        '11023390=               ,P.discount_summ = P.discount_TENGE * (P' +
        '.amount + :AMOUNT_)'
      '11023391=               ,P.NDS = :NDS_'
      '11023392=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '11023393=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '11023394='
      '11023395=      ELSE BEGIN'
      '11023396=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '11023397=          ('
      '11023398=           ZAKAZ_DETAILS,'
      '11023399=           ZAKAZ,'
      '11023400=           G_PRODUCT,'
      '11023401=           AMOUNT,'
      '11023402=           PRICE,'
      '11023403=           SUMM,'
      '11023404=           DISCOUNT_PERC,'
      '11023405=           DISCOUNT_TENGE,'
      '11023406=           DISCOUNT_SUMM,'
      '11023407=           NDS,'
      '11023408=           NDS_SUMM,'
      '11023409=           COST_PRICE'
      '11023410=          ) VALUES ('
      '11023411=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '11023412=           :ZAKAZ_,'
      '11023413=           :G_PRODUCT_,'
      '11023414=           :AMOUNT_,'
      '11023415=           :PRICE__,'
      '11023416=           :SUMM_,'
      '11023417=           :DISCOUNT_PERC_,'
      '11023418=           :DISCOUNT_TENGE_,'
      '11023419=           :DISCOUNT_SUMM_,'
      '11023420=           :NDS_,'
      '11023421=           :NDS_SUMM_,'
      '11023422=           :COST_PRICE__'
      '11023423=          )'
      '11023424=          RETURNING'
      '11023425=            ZAKAZ_DETAILS'
      '11023426=          INTO'
      '11023427=            :ZAKAZ_DETAILS_;'
      '11023428=      END'
      '11023429='
      '11023430=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11023431=      SELECT AMOUNT - AMOUNT_RESERVE'
      '11023432=        FROM LT_SKLAD_PRODUCT L'
      '11023433=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '11023434=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11023435=       INTO :AMOUNT_CUR_;'
      '11023436='
      
        '11023437=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048 +
        #1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '11023438=      if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      
        '11023439=          -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '11023440=          -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056 +
        #1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '11023441=          -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '11023442=          -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' ' +
        #1041#1067#1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050 +
        #1054#1051#1068#1050#1054
      
        '11023443=          -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042 +
        #1040#1058#1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11023444=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '11023445=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '11023446=              SELECT SUM(AMOUNT)'
      '11023447=                FROM ZAKAZ_DETAILS T'
      '11023448=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11023449=                 AND T.ZAKAZ = :ZAKAZ_'
      '11023450=                INTO :AMOUNT_OLD_;'
      '11023451=            ELSE'
      '11023452=              SELECT SUM(AMOUNT)'
      '11023453=                FROM SKLAD T'
      '11023454=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11023455=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '11023456=                INTO :AMOUNT_OLD_;'
      '11023457=          END'
      '11023458='
      '11023459=          -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '11023460=          SELECT SUM(AMOUNT)'
      '11023461=            FROM ZAKAZ_DETAILS_TMP T'
      '11023462=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11023463=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '11023464='
      
        '11023465=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ' +
        '_, 0);'
      '11023466=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '11023467='
      
        '11023468=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COAL' +
        'ESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '11023469=            SELECT NAME'
      '11023470=            FROM G_PRODUCT'
      '11023471=            WHERE G_PRODUCT = :G_PRODUCT_'
      '11023472=            INTO :PRODUCT_NAME_;'
      '11023473='
      '11023474=            ERR_CODE = -20500;'
      
        '11023475=            ERR_MSG = '#39#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39#39'||PRODUCT_' +
        'NAME_||'#39#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39#39'||ASCII_CHAR(10)||'
      
        '11023476=                      '#39#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39#39';'
      
        '11023477=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR' +
        '_MSG) RETURNING_VALUES (:ERR_MSG);'
      '11023478=            ERR_MSG = PROCNAME||ERR_MSG;'
      '11023479=            EXIT;'
      '11023480=          END'
      '11023481=      END'
      '11023482=  END'
      '11023483=end'
      '11023484='#39';'
      '11023485='
      '11023486=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAKAZ_NA_REAL('
      '11023487=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11023488=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARENT' +
        ','
      '11023489=  DATE_BEGIN_ DATE,'
      '11023490=  DATE_END_ DATE,'
      '11023491=  G_CATEGORY_ VARCHAR(1000),'
      '11023492=  G_PRODUCT_ VARCHAR(1000),'
      '11023493=  MODE_ INTEGER,'
      '11023494=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '11023495=RETURNS ('
      
        '11023496=  ZAKAZ_DATE TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.Z' +
        'AKAZ_DATE,'
      '11023497=  NAME TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.NAME,'
      
        '11023498=  ARTICUL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.ARTI' +
        'CUL,'
      '11023499=  PRICE TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.PRICE,'
      
        '11023500=  AMOUNT_ALL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.A' +
        'MOUNT_ALL,'
      
        '11023501=  SUMM_ALL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.SUM' +
        'M_ALL,'
      
        '11023502=  AMOUNT_PAYED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE' +
        '.AMOUNT_PAYED,'
      
        '11023503=  SUMM_PAYED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.S' +
        'UMM_PAYED,'
      
        '11023504=  AMOUNT_RETURNED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TA' +
        'BLE.AMOUNT_RETURNED,'
      
        '11023505=  SUMM_RETURNED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABL' +
        'E.SUMM_RETURNED,'
      
        '11023506=  AMOUNT_LEFT TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.' +
        'AMOUNT_LEFT,'
      
        '11023507=  SUMM_LEFT TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.SU' +
        'MM_LEFT,'
      
        '11023508=  IS_HEAD TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.IS_H' +
        'EAD)'
      '11023509=AS'
      
        '11023510=DECLARE VARIABLE G_CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '11023511=DECLARE VARIABLE G_CLIENT_NAME_OLD_ TYPE OF COLUMN G_CL' +
        'IENT.NAME;'
      '11023512=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '11023513=DECLARE VARIABLE SUMM_IT_ NUMERIC(15,2) = 0;'
      '11023514=DECLARE VARIABLE SUMM_ALL_ NUMERIC(15,2) = 0;'
      '11023515=DECLARE VARIABLE SUMM_PAYED_ NUMERIC(15,2) = 0;'
      '11023516=DECLARE VARIABLE SUMM_PAYED_IT_ NUMERIC(15,2) = 0;'
      '11023517=DECLARE VARIABLE SUMM_PAYED_ALL_ NUMERIC(15,2) = 0;'
      '11023518=DECLARE VARIABLE SUMM_RETURNED_ NUMERIC(15,2) = 0;'
      '11023519=DECLARE VARIABLE SUMM_RETURNED_IT_ NUMERIC(15,2) = 0;'
      '11023520=DECLARE VARIABLE SUMM_RETURNED_ALL_ NUMERIC(15,2) = 0;'
      '11023521=DECLARE VARIABLE SUMM_LEFT_ NUMERIC(15,2) = 0;'
      '11023522=DECLARE VARIABLE SUMM_LEFT_IT_ NUMERIC(15,2) = 0;'
      '11023523=DECLARE VARIABLE SUMM_LEFT_ALL_ NUMERIC(15,2) = 0;'
      
        '11023524=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN P_REP_ZAKAZ_NA_' +
        'REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023525=DECLARE VARIABLE AMOUNT_IT_ TYPE OF COLUMN P_REP_ZAKAZ_' +
        'NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023526=DECLARE VARIABLE AMOUNT_ALL_ TYPE OF COLUMN P_REP_ZAKAZ' +
        '_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023527=DECLARE VARIABLE AMOUNT_PAYED_ TYPE OF COLUMN P_REP_ZAK' +
        'AZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023528=DECLARE VARIABLE AMOUNT_PAYED_IT_ TYPE OF COLUMN P_REP_' +
        'ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023529=DECLARE VARIABLE AMOUNT_PAYED_ALL_ TYPE OF COLUMN P_REP' +
        '_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023530=DECLARE VARIABLE AMOUNT_RETURNED_ TYPE OF COLUMN P_REP_' +
        'ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023531=DECLARE VARIABLE AMOUNT_RETURNED_IT_ TYPE OF COLUMN P_R' +
        'EP_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023532=DECLARE VARIABLE AMOUNT_RETURNED_ALL_ TYPE OF COLUMN P_' +
        'REP_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023533=DECLARE VARIABLE AMOUNT_LEFT_ TYPE OF COLUMN P_REP_ZAKA' +
        'Z_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023534=DECLARE VARIABLE AMOUNT_LEFT_IT_ TYPE OF COLUMN P_REP_Z' +
        'AKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023535=DECLARE VARIABLE AMOUNT_LEFT_ALL_ TYPE OF COLUMN P_REP_' +
        'ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '11023536=DECLARE VARIABLE ZAKAZ_DATE_ TYPE OF COLUMN ZAKAZ_REAL_' +
        'PARENT.ZAKAZ_DATE;'
      '11023537=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11023538=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTI' +
        'CUL;'
      
        '11023539=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_NA_REAL.PR' +
        'ICE;'
      '11023540=BEGIN'
      '11023541=  DELETE FROM P_REP_ZAKAZ_NA_REAL_TABLE;'
      '11023542=  G_CLIENT_NAME_OLD_ = '#39#39#39#39';'
      '11023543='
      '11023544=  FOR SELECT TRIM(G.NAME),'
      '11023545=             ZP.ZAKAZ_DATE,'
      '11023546=             P.NAME,'
      '11023547=             P.ARTICUL,'
      '11023548=             Z.PRICE,'
      '11023549=             Z.AMOUNT_ALL,'
      '11023550=             Z.SUMM_ALL,'
      '11023551=             Z.AMOUNT_PAYED,'
      '11023552=             Z.SUMM_PAYED,'
      '11023553=             COALESCE(Z.AMOUNT_RETURNED, 0),'
      '11023554=             COALESCE(Z.SUMM_RETURNED, 0),'
      
        '11023555=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE(Z' +
        '.AMOUNT_RETURNED, 0),'
      
        '11023556=             Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.SUM' +
        'M_RETURNED, 0)'
      '11023557=        FROM ZAKAZ_REAL_PARENT ZP,'
      '11023558=             ZAKAZ_NA_REAL Z,'
      '11023559=             G_CLIENT G,'
      '11023560=             G_PRODUCT P'
      
        '11023561=       WHERE ZP.ZAKAZ_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '11023562=         AND ZP.G_CLIENT = G.G_CLIENT'
      '11023563=         AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PARENT'
      '11023564=         AND Z.G_PRODUCT = P.G_PRODUCT'
      
        '11023565=         AND ZP.G_CLIENT = COALESCE(:G_CLIENT_, ZP.G_CL' +
        'IENT)'
      
        '11023566=         AND G.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, G.G_CLIENT_PARENT)'
      
        '11023567=         AND (((Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESC' +
        'E(Z.AMOUNT_RETURNED, 0)) > 0 AND :MODE_ = 0)'
      '11023568=              OR'
      '11023569=              (Z.AMOUNT_PAYED > 0 AND :MODE_ = 1)'
      '11023570=              OR'
      
        '11023571=              (COALESCE(Z.AMOUNT_RETURNED, 0) > 0 AND :' +
        'MODE_ = 2)'
      '11023572=              OR'
      '11023573=              :MODE_ = 3)'
      
        '11023574=         AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||P.G_PRODU' +
        'CT_PAR||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL) or :G_CATEGORY_ IS N' +
        'ULL)'
      
        '11023575=         AND ((:G_PRODUCT_ CONTAINING '#39#39'~'#39#39'||P.G_PRODUC' +
        'T||'#39#39'~'#39#39' AND :G_PRODUCT_ IS NOT NULL) or :G_PRODUCT_ IS NULL)'
      
        '11023576=         AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||ZP.G_TOCH' +
        'KA||'#39#39'-'#39#39
      '11023577=       ORDER BY G.NAME, ZP.ZAKAZ_DATE, P.NAME'
      
        '11023578=        INTO :G_CLIENT_NAME_, :ZAKAZ_DATE_, :NAME_, :AR' +
        'TICUL_, :PRICE_, :AMOUNT_, :SUMM_, :AMOUNT_PAYED_, :SUMM_PAYED_,' +
        ' :AMOUNT_RETURNED_, :SUMM_RETURNED_, :AMOUNT_LEFT_, :SUMM_LEFT_'
      '11023579=  DO BEGIN'
      '11023580=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050
      
        '11023581=      IF (G_CLIENT_NAME_ <> G_CLIENT_NAME_OLD_) THEN BE' +
        'GIN'
      
        '11023582=          -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1055#1045#1056 +
        #1042#1067#1049' '#1050#1051#1048#1045#1053#1058
      '11023583=          IF (G_CLIENT_NAME_OLD_ <> '#39#39#39#39') THEN BEGIN'
      
        '11023584=              INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_' +
        'REP_ZAKAZ_NA_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAYE' +
        'D, SUMM_PAYED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED,' +
        ' SUMM_RETURNED)'
      
        '11023585=              VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1' +
        '), '#39#39#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059#39#39', :AMOUNT_IT_, :SUMM_IT_, :AMOUNT_PAYED_I' +
        'T_, :SUMM_PAYED_IT_, :AMOUNT_LEFT_IT_, :SUMM_LEFT_IT_, 2, :AMOUN' +
        'T_RETURNED_IT_, :SUMM_RETURNED_IT_);'
      '11023586='
      '11023587=              SUMM_ALL_ = SUMM_ALL_ + SUMM_IT_;'
      
        '11023588=              SUMM_PAYED_ALL_  = SUMM_PAYED_ALL_ + SUMM' +
        '_PAYED_IT_;'
      
        '11023589=              SUMM_RETURNED_ALL_  = SUMM_RETURNED_ALL_ ' +
        '+ SUMM_RETURNED_IT_;'
      
        '11023590=              SUMM_LEFT_ALL_   = SUMM_LEFT_ALL_ + SUMM_' +
        'LEFT_IT_;'
      
        '11023591=              AMOUNT_ALL_      = AMOUNT_ALL_ + AMOUNT_I' +
        'T_;'
      
        '11023592=              AMOUNT_PAYED_ALL_ = AMOUNT_PAYED_ALL_ + A' +
        'MOUNT_PAYED_IT_;'
      
        '11023593=              AMOUNT_RETURNED_ALL_ = AMOUNT_RETURNED_AL' +
        'L_ + AMOUNT_RETURNED_IT_;'
      
        '11023594=              AMOUNT_LEFT_ALL_  = AMOUNT_LEFT_ALL_ + AM' +
        'OUNT_LEFT_IT_;'
      '11023595='
      '11023596=              SUMM_IT_ = 0;'
      '11023597=              SUMM_PAYED_IT_  = 0;'
      '11023598=              SUMM_RETURNED_IT_ = 0;'
      '11023599=              SUMM_LEFT_IT_   = 0;'
      '11023600=              AMOUNT_IT_      = 0;'
      '11023601=              AMOUNT_PAYED_IT_ = 0;'
      '11023602=              AMOUNT_RETURNED_IT_ = 0;'
      '11023603=              AMOUNT_LEFT_IT_  = 0;'
      '11023604=          END'
      '11023605='
      
        '11023606=          INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_' +
        'ZAKAZ_NA_REAL_TABLE, NAME, IS_HEAD)'
      
        '11023607=          VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), :' +
        'G_CLIENT_NAME_, 1);'
      '11023608='
      '11023609=          G_CLIENT_NAME_OLD_ = G_CLIENT_NAME_;'
      '11023610=      END'
      '11023611='
      
        '11023612=      INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZAKA' +
        'Z_NA_REAL_TABLE, ZAKAZ_DATE, NAME, ARTICUL, PRICE, AMOUNT_ALL, S' +
        'UMM_ALL, AMOUNT_PAYED,'
      
        '11023613=                                       SUMM_PAYED, AMOU' +
        'NT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_RETURNED)'
      
        '11023614=      VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_DATE_, :NAME_, :ARTICUL_, :PRICE_, :AMOUNT_, :SUMM_, :AMOUNT_P' +
        'AYED_, :SUMM_PAYED_, :AMOUNT_LEFT_, :SUMM_LEFT_, 0, :AMOUNT_RETU' +
        'RNED_, :SUMM_RETURNED_);'
      '11023615='
      '11023616=      SUMM_IT_ = SUMM_IT_ + SUMM_;'
      '11023617=      SUMM_PAYED_IT_  = SUMM_PAYED_IT_ + SUMM_PAYED_;'
      
        '11023618=      SUMM_RETURNED_IT_  = SUMM_RETURNED_IT_ + SUMM_RET' +
        'URNED_;'
      '11023619=      SUMM_LEFT_IT_   = SUMM_LEFT_IT_ + SUMM_LEFT_;'
      '11023620=      AMOUNT_IT_      = AMOUNT_IT_ + AMOUNT_;'
      
        '11023621=      AMOUNT_PAYED_IT_ = AMOUNT_PAYED_IT_ + AMOUNT_PAYE' +
        'D_;'
      
        '11023622=      AMOUNT_RETURNED_IT_ = AMOUNT_RETURNED_IT_ + AMOUN' +
        'T_RETURNED_;'
      
        '11023623=      AMOUNT_LEFT_IT_  = AMOUNT_LEFT_IT_ + AMOUNT_LEFT_' +
        ';'
      '11023624=  END'
      '11023625='
      '11023626=  SUMM_ALL_ = SUMM_ALL_ + SUMM_IT_;'
      '11023627=  SUMM_PAYED_ALL_  = SUMM_PAYED_ALL_ + SUMM_PAYED_IT_;'
      
        '11023628=  SUMM_RETURNED_ALL_  = SUMM_RETURNED_ALL_ + SUMM_RETUR' +
        'NED_IT_;'
      '11023629=  SUMM_LEFT_ALL_   = SUMM_LEFT_ALL_ + SUMM_LEFT_IT_;'
      '11023630=  AMOUNT_ALL_      = AMOUNT_ALL_ + AMOUNT_IT_;'
      
        '11023631=  AMOUNT_PAYED_ALL_ = AMOUNT_PAYED_ALL_ + AMOUNT_PAYED_' +
        'IT_;'
      
        '11023632=  AMOUNT_RETURNED_ALL_ = AMOUNT_RETURNED_ALL_ + AMOUNT_' +
        'RETURNED_IT_;'
      
        '11023633=  AMOUNT_LEFT_ALL_  = AMOUNT_LEFT_ALL_ + AMOUNT_LEFT_IT' +
        '_;'
      '11023634='
      
        '11023635=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1045#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' ' +
        #1054#1058#1063#1045#1058' '#1053#1045' '#1055#1054' '#1050#1054#1053#1050#1056#1045#1058#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1058'.'#1050'. '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' '#1048' '#1057#1051#1045#1044' '#1057#1058#1056#1054#1063#1050#1040' '#1048#1058#1054#1043#1054' '#1041#1059#1044#1059#1058' '#1056#1040#1042#1053#1067
      '11023636=  IF (G_CLIENT_ IS NULL) THEN'
      
        '11023637=      INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZAKA' +
        'Z_NA_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAYED, SUMM_' +
        'PAYED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_RE' +
        'TURNED)'
      
        '11023638=      VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), '#39#39#1048#1058#1054 +
        #1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059#39#39', :AMOUNT_IT_, :SUMM_IT_, :AMOUNT_PAYED_IT_, :SUM' +
        'M_PAYED_IT_, :AMOUNT_LEFT_IT_, :SUMM_LEFT_IT_, 2, :AMOUNT_RETURN' +
        'ED_IT_, :SUMM_RETURNED_IT_);'
      '11023639='
      '11023640=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '11023641=  INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZAKAZ_NA' +
        '_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAYED, SUMM_PAYE' +
        'D, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_RETURN' +
        'ED)'
      
        '11023642=  VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), '#39#39#1048#1058#1054#1043#1054#39#39 +
        ', :AMOUNT_ALL_, :SUMM_ALL_, :AMOUNT_PAYED_ALL_, :SUMM_PAYED_ALL_' +
        ', :AMOUNT_LEFT_ALL_, :SUMM_LEFT_ALL_, 1, :AMOUNT_RETURNED_ALL_, ' +
        ':SUMM_RETURNED_ALL_);'
      '11023643='
      '11023644=  FOR SELECT ZAKAZ_DATE,'
      '11023645=             NAME,'
      '11023646=             ARTICUL,'
      '11023647=             PRICE,'
      '11023648=             AMOUNT_ALL,'
      '11023649=             SUMM_ALL,'
      '11023650=             AMOUNT_PAYED,'
      '11023651=             SUMM_PAYED,'
      '11023652=             AMOUNT_RETURNED,'
      '11023653=             SUMM_RETURNED,'
      '11023654=             AMOUNT_LEFT,'
      '11023655=             SUMM_LEFT,'
      '11023656=             IS_HEAD'
      '11023657=      FROM P_REP_ZAKAZ_NA_REAL_TABLE'
      '11023658=      ORDER BY P_REP_ZAKAZ_NA_REAL_TABLE'
      
        '11023659=      INTO :ZAKAZ_DATE, :NAME, :ARTICUL, :PRICE, :AMOUN' +
        'T_ALL, :SUMM_ALL, :AMOUNT_PAYED, :SUMM_PAYED, :AMOUNT_RETURNED, ' +
        ':SUMM_RETURNED,'
      '11023660=           :AMOUNT_LEFT, :SUMM_LEFT, :IS_HEAD'
      '11023661=  DO'
      '11023662=    SUSPEND;'
      '11023663=end'
      '11023664='#39';'
      '11023665='
      '11023666=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '11023667=RETURNS ('
      '11023668=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '11023669=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '11023670=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '11023671=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '11023672=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '11023673=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '11023674=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '11023675=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11023676=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11023677=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE)'
      '11023678=AS'
      '11023679=begin'
      '11023680=  FOR'
      
        '11023681=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.S' +
        'UMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.PRICE'
      '11023682=    FROM SKLAD_TMP T,'
      '11023683=         G_PRODUCT P'
      '11023684=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11023685=    ORDER BY T.sklad'
      
        '11023686=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :N' +
        'DS, :NDS_SUMM, :NAME, :BARCODE, :PRODUCT_PRICE'
      '11023687=  DO'
      '11023688=    suspend;'
      '11023689=end'
      '11023690='#39';'
      '11023691='
      '11023692=EXECUTE STATEMENT '#39'ALTER PROCEDURE SYNC_DOWNLOAD('
      '11023693=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '11023694=  UPLOAD_TABLE_TMP TYPE OF COLUMN UPLOAD_TABLE_TMP.UPLO' +
        'AD_TABLE_TMP,'
      '11023695=  MODE TYPE OF COLUMN UPLOAD_TABLE_TMP.MODE,'
      '11023696=  PARENT TYPE OF COLUMN UPLOAD_TABLE_TMP.PARENT,'
      '11023697=  DATE_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.DATE_OPER,'
      '11023698=  TIME_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.TIME_OPER,'
      '11023699=  G_CLIENT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_CLIENT,'
      
        '11023700=  G_PAYMENT_TYPE TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PAYM' +
        'ENT_TYPE,'
      '11023701=  SUMM_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_ALL,'
      
        '11023702=  SUMM_FACT_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_FA' +
        'CT_ALL,'
      
        '11023703=  SUMM_PAY_BONUS TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_P' +
        'AY_BONUS,'
      
        '11023704=  SUMM_BONUS_GOT TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_B' +
        'ONUS_GOT,'
      '11023705=  OSNOVANIE TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE,'
      '11023706=  NOTE TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE,'
      
        '11023707=  G_OFFICIAL TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICIAL' +
        ','
      '11023708=  G_PRODUCT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT,'
      '11023709=  AMOUNT TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT,'
      '11023710=  PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE,'
      '11023711=  SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM,'
      
        '11023712=  DISCOUNT_PERC TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOUN' +
        'T_PERC,'
      
        '11023713=  DISCOUNT_TENGE TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_TENGE,'
      
        '11023714=  DISCOUNT_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOUN' +
        'T_SUMM,'
      '11023715=  NDS TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS,'
      '11023716=  NDS_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM,'
      
        '11023717=  COST_PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRICE' +
        ','
      '11023718=  BY_RECIPE TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE,'
      
        '11023719=  IS_RESERVE TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESERVE' +
        ','
      '11023720=  PAYMENTS BLOB SUB_TYPE 1,'
      '11023721=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11023722=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11023723=  IS_LOAD_ INTEGER)'
      '11023724=RETURNS ('
      '11023725=  ERR_CODE INTEGER,'
      '11023726=  ERR_MSG VARCHAR(1024))'
      '11023727=AS'
      '11023728=/*'
      '11023729='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '11023730='#1048#1044#1059' '#1055#1054' '#1042#1057#1045#1052' '#1055#1054#1054#1063#1045#1056#1045#1044#1053#1054', '#1055#1045#1056#1045#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1048#1055#1054#1052' '#1055#1056#1054#1062#1045#1057#1057#1040' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '11023731='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1062#1048#1050#1051#1054#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070 +
        ' '#1058#1040#1041#1051#1048#1062#1059
      '11023732=*/'
      
        '11023733=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'SYNC_DOWNLOAD' +
        #39#39';'
      '11023734=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11023735=DECLARE VARIABLE MODE_ TYPE OF COLUMN UPLOAD_TABLE_TMP.' +
        'MODE;'
      
        '11023736=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      '11023737=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '11023738=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '11023739=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '11023740=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '11023741=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUM' +
        'M;'
      
        '11023742=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '11023743=DECLARE VARIABLE BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_REC' +
        'IPE;'
      
        '11023744=DECLARE VARIABLE BY_RECIPE__ TYPE OF COLUMN ZAKAZ.BY_RE' +
        'CIPE;'
      
        '11023745=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RE' +
        'SERVE;'
      
        '11023746=DECLARE VARIABLE IS_RESERVE__ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '11023747=DECLARE VARIABLE PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '11023748=DECLARE VARIABLE PAYMENTS__ BLOB SUB_TYPE 1 SEGMENT SIZ' +
        'E 80;'
      
        '11023749=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.' +
        'G_CLIENT;'
      
        '11023750=DECLARE VARIABLE G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.G_PAYMENT_TYPE;'
      
        '11023751=DECLARE VARIABLE OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.OSNOVANIE;'
      
        '11023752=DECLARE VARIABLE NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE' +
        ';'
      
        '11023753=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM;'
      
        '11023754=DECLARE VARIABLE SUMM_FACT_ALL_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SUMM_FACT;'
      
        '11023755=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS;'
      
        '11023756=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS_GOT;'
      
        '11023757=DECLARE VARIABLE PARENT_ TYPE OF COLUMN UPLOAD_TABLE_TM' +
        'P.PARENT;'
      
        '11023758=DECLARE VARIABLE PARENT_OLD_ TYPE OF COLUMN UPLOAD_TABL' +
        'E_TMP.PARENT;'
      '11023759=DECLARE VARIABLE MODE_OLD_ INTEGER;'
      '11023760=DECLARE VARIABLE DATE_OPER__ DATE;'
      '11023761=DECLARE VARIABLE TIME_OPER__ TIME;'
      
        '11023762=DECLARE VARIABLE G_CLIENT__ TYPE OF COLUMN G_CLIENT.G_C' +
        'LIENT;'
      
        '11023763=DECLARE VARIABLE G_PAYMENT_TYPE__ TYPE OF COLUMN G_PAYM' +
        'ENT_TYPE.G_PAYMENT_TYPE;'
      
        '11023764=DECLARE VARIABLE OSNOVANIE__ TYPE OF COLUMN ZAKAZ.OSNOV' +
        'ANIE;'
      '11023765=DECLARE VARIABLE NOTE__ TYPE OF COLUMN ZAKAZ.NOTE;'
      '11023766=DECLARE VARIABLE SUMM__ NUMERIC(15,2);'
      '11023767=DECLARE VARIABLE SUMM_FACT__ NUMERIC(15,2);'
      
        '11023768=DECLARE VARIABLE SUMM_CASH__ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      
        '11023769=DECLARE VARIABLE SUMM_NONCASH__ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '11023770=DECLARE VARIABLE SUMM_PAY_BONUS__ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '11023771=DECLARE VARIABLE SUMM_BONUS_GOT__ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '11023772=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      
        '11023773=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2)' +
        ';'
      
        '11023774=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.ZAKAZ_DETAILS;'
      '11023775=DECLARE VARIABLE DATE_OPER_ DATE;'
      '11023776=DECLARE VARIABLE TIME_OPER_ TIME;'
      
        '11023777=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '11023778=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11023779=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      
        '11023780=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN ZAKAZ.G_OFF' +
        'ICIAL;'
      
        '11023781=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PARE' +
        'NT;'
      '11023782=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11023783=DECLARE VARIABLE IS_FIRST_TIME_ INTEGER = 0; /* '#1054#1041#1056#1040#1041#1040#1058 +
        #1067#1042#1040#1045#1058#1057#1071' '#1055#1045#1056#1042#1040#1071' '#1057#1058#1056#1054#1050#1040' 0, '#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1057#1058#1056#1054#1050#1048' = 1 */'
      '11023784=BEGIN'
      '11023785=  PNT_ = '#39#39'00'#39#39';'
      '11023786=  IF (IS_LOAD_ = 0) THEN BEGIN'
      '11023787=      SELECT 1'
      '11023788=        FROM G_PRODUCT G'
      '11023789=       WHERE G.G_PRODUCT = :G_PRODUCT'
      '11023790=       INTO :G_PRODUCT_;'
      '11023791='
      '11023792=      IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '11023793=        ERR_CODE = -20500;'
      
        '11023794=        ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072': '#1090#1086#1074#1072#1088' '#1089' '#1080#1076#1077#1085#1090#1080#1092#1080#1082#1072#1090#1086#1088#1086#1084' '#39#39 +
        '||G_PRODUCT||'#39#39' '#1086#1090#1089#1091#1090#1089#1090#1074#1091#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'.'#39#39';'
      '11023795=        Exit;'
      '11023796=      END'
      '11023797='
      
        '11023798=      INSERT INTO UPLOAD_TABLE_TMP (UPLOAD_TABLE_TMP, M' +
        'ODE, PARENT, DATE_OPER, TIME_OPER, G_CLIENT, G_PAYMENT_TYPE,'
      
        '11023799=                                    SUMM_ALL, SUMM_FACT' +
        '_ALL, SUMM_PAY_BONUS, SUMM_BONUS_GOT, OSNOVANIE, NOTE, G_OFFICIA' +
        'L, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '11023800=                                    DISCOUNT_TENGE, DIS' +
        'COUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RESERVE, PA' +
        'YMENTS)'
      
        '11023801=      VALUES (:UPLOAD_TABLE_TMP, :MODE, :PARENT, :DATE_' +
        'OPER, :TIME_OPER, DECODE(:G_CLIENT, 0, NULL, :G_CLIENT), :G_PAYM' +
        'ENT_TYPE,'
      
        '11023802=              :SUMM_ALL, :SUMM_FACT_ALL, :SUMM_PAY_BONU' +
        'S, :SUMM_BONUS_GOT, :OSNOVANIE, :NOTE, :G_OFFICIAL, :G_PRODUCT, ' +
        ':AMOUNT, :PRICE, :SUMM, :DISCOUNT_PERC,'
      
        '11023803=              :DISCOUNT_TENGE, :DISCOUNT_SUMM, :NDS, :N' +
        'DS_SUMM, :COST_PRICE, :BY_RECIPE, :IS_RESERVE, :PAYMENTS);'
      '11023804='
      '11023805=  END ELSE BEGIN'
      '11023806=      PNT_ = '#39#39'01'#39#39';'
      '11023807=      IF (G_TOCHKA_ IS NULL) THEN'
      '11023808=        SELECT ID'
      '11023809=          FROM CUR_PARAMS'
      '11023810=         WHERE CUR_PARAMS = 2'
      '11023811=          INTO :G_TOCHKA_;'
      '11023812='
      
        '11023813=      FOR SELECT MODE, PARENT, DATE_OPER, TIME_OPER, G_' +
        'CLIENT, G_PAYMENT_TYPE, SUMM_ALL, SUMM_FACT_ALL, SUMM_PAY_BONUS,' +
        ' SUMM_BONUS_GOT, OSNOVANIE,'
      
        '11023814=                 NOTE, G_OFFICIAL, G_PRODUCT, AMOUNT, P' +
        'RICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      
        '11023815=                 NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RE' +
        'SERVE, PAYMENTS'
      '11023816=          FROM UPLOAD_TABLE_TMP'
      
        '11023817=          WHERE MODE <> 6        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040 +
        ' '#1041#1059#1044#1059' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1054#1058#1044#1045#1051#1068#1053#1054', '#1058#1040#1052' '#1044#1056#1059#1043#1054#1049' '#1055#1056#1048#1053#1062#1048#1055
      '11023818=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '11023819=          INTO :MODE_, :PARENT_, :DATE_OPER_, :TIME_OPE' +
        'R_, :G_CLIENT_, :G_PAYMENT_TYPE_, :SUMM_ALL_, :SUMM_FACT_ALL_,  ' +
        ':SUMM_PAY_BONUS_, :SUMM_BONUS_GOT_,'
      
        '11023820=               :OSNOVANIE_, :NOTE_, :G_OFFICIAL_, :G_PR' +
        'ODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_PERC_, :DISCOUNT_TE' +
        'NGE_,'
      
        '11023821=               :DISCOUNT_SUMM_, :NDS_, :NDS_SUMM_, :COS' +
        'T_PRICE_, :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_'
      '11023822=      DO BEGIN'
      '11023823=          -- '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '11023824=          PNT_ = '#39#39'02'#39#39';'
      
        '11023825=          IF (PARENT_ <> PARENT_OLD_ AND IS_FIRST_TIME_' +
        ' = 1) THEN BEGIN'
      '11023826=            IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '11023827=              PNT_ = '#39#39'02a'#39#39';'
      '11023828=              EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '11023829=                                          :DATE_OPER__,'
      '11023830=                                          :TIME_OPER__,'
      '11023831=                                          :G_CLIENT__,'
      
        '11023832=                                          :G_PAYMENT_TY' +
        'PE__,'
      '11023833=                                          :OSNOVANIE__,'
      '11023834=                                          :NOTE__,'
      
        '11023835=                                          DECODE(:MODE_' +
        'OLD_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '11023836=                                          :SUMM__,'
      '11023837=                                          :SUMM_FACT__,'
      
        '11023838=                                          0, --:G_PRIHO' +
        'D_,'
      
        '11023839=                                          0 --:SUMM_PRI' +
        'HOD_)'
      
        '11023840=                                          ,:PAYMENTS__ ' +
        ' -- PAYMENTS'
      
        '11023841=                                         )RETURNING_VAL' +
        'UES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '11023842=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11023843=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090#1086 +
        #1074#1072#1088#1072' (01).'#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) ' +
        '+ 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11023844=                EXIT;'
      '11023845=              END'
      '11023846=            END'
