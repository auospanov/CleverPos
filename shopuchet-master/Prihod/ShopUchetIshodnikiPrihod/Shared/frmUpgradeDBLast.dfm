      '110241800=           DECODE(T.IS_HEAD,'
      '110241801=                  0, T.NAME,'
      '110241802=                  1, T.NAME,'
      '110241803=                  2, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39','
      '110241804=                  3, '#39#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39#39'),'
      '110241805=           G.ARTICUL,'
