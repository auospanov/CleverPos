        '11024691=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY,'
      
        '11024692=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_AL' +
        'L,'
      '11024693=  CNT_T_ INTEGER,'
      
        '11024694=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11024695=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11024696=  HAVERIGHT_ INTEGER,'
      '11024697=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11024698=  ERR_CODE INTEGER,'
      '11024699=  ERR_MSG VARCHAR(1024))'
      '11024700=AS'
      '11024701=/*'
      
        '11024702=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083#1077 +
        #1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '11024703=*/'
      
        '11024704=declare variable G_OFFICIAL_CUR_ type of column G_OFFIC' +
        'IAL.G_OFFICIAL;'
      '11024705=begin'
      
        '11024706=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080' ' +
        'INS '#1080' '#1087#1088#1080' UPD'
      '11024707=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '11024708=  CNT_T_ = 0;'
      '11024709=  SELECT COUNT(*)'
      '11024710=    FROM (SELECT S.SKLAD'
      '11024711=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '11024712=    INTO :CNT_T_;'
      '11024713='
      '11024714=  SELECT'
      '11024715=    T.DATE_RECEIPT,'
      '11024716=    T.TIME_RECEIPT,'
      '11024717=    T.G_CLIENT,'
      '11024718=    T.G_PAYMENT_TYPE,'
      '11024719=    T.OSNOVANIE,'
      '11024720=    T.NOTE,'
      '11024721=    T.SUMM,'
      '11024722=    T.SUMM_FACT,'
      '11024723=    T.IS_PAYED_ALL'
      '11024724=    ,T.SUMM_CURRENCY'
      '11024725=  FROM SKLAD_PARENT T'
      '11024726=  WHERE T.SKLAD = :SKLAD_'
      '11024727=  INTO'
      '11024728=    :DATE_RECEIPT_,'
      '11024729=    :TIME_RECEIPT_,'
      '11024730=    :G_CLIENT_,'
      '11024731=    :G_PAYMENT_TYPE_,'
      '11024732=    :OSNOVANIE_,'
      '11024733=    :NOTE_,'
      '11024734=    :SUMM_,'
      '11024735=    :SUMM_FACT_,'
      '11024736=    :IS_PAYED_ALL_'
      '11024737=    ,:SUMM_CURRENCY_;'
      '11024738='
      '11024739=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '11024740=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRIC' +
        'E, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURRE' +
        'NCY)'
      
        '11024741=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_TM' +
        'P, 1)), G_PRODUCT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, :SKLAD_, ' +
        'PRICE_CURRENCY, SUMM_CURRENCY'
      '11024742=    FROM SKLAD'
      '11024743=   WHERE SKLAD_PARENT = :SKLAD_'
      '11024744=   ORDER BY SKLAD;'
      '11024745='
      '11024746=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '11024747=  SELECT K.G_PRIHOD_RASHOD,'
      '11024748=         K.SUMM'
      
        '11024749=    FROM (select * from KASSA union all select * from k' +
        'assa_beznal) K'
      '11024750=   WHERE K.SKLAD = :SKLAD_'
      '11024751=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '11024752=    INTO :G_PRIHOD_,'
      '11024753=         :SUMM_PRIHOD_;'
      '11024754='
      
        '11024755=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNIN' +
        'G_VALUES :PAYMENTS_;'
      '11024756='
      
        '11024757=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' '#1045 +
        #1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044 +
        #1040#1058#1067
      
        '11024758=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044#1059 +
        ' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053#1040 +
        ' 0, '#1058#1054' '#1061#1045#1056
      '11024759=  HaveRight_ = 1;'
      '11024760=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '11024761=    SELECT ID'
      '11024762=      FROM CUR_PARAMS'
      '11024763=     WHERE CUR_PARAMS = 1'
      '11024764=      INTO :G_OFFICIAL_CUR_;'
      '11024765='
      
        '11024766=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080#1094 +
        #1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' '#1074 +
        #1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '11024767=      HaveRight_ = 1;'
      '11024768=    else'
      
        '11024769=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICIA' +
        'L_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '11024770=  END'
      '11024771=end'
      '11024772='#39';'
      '11024773='
      '11024774=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SKLAD_TMP('
      '11024775=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '11024776=RETURNS ('
      '11024777=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11024778=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '11024779=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '11024780=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '11024781=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '11024782=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '11024783=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '11024784=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '11024785=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '11024786=  ERR_CODE INTEGER,'
      '11024787=  ERR_MSG VARCHAR(1024))'
      '11024788=AS'
      '11024789=begin'
      '11024790=  SELECT'
      '11024791=    T.G_PRODUCT,'
      '11024792=    T.AMOUNT,'
      '11024793=    T.PRICE,'
      '11024794=    T.SUMM,'
      '11024795=    T.PRICE_CURRENCY,'
      '11024796=    T.SUMM_CURRENCY,'
      '11024797=    T.NDS,'
      '11024798=    T.NDS_SUMM,'
      '11024799=    P.NAME'
      
        '11024800=  FROM SKLAD_TMP T LEFT OUTER JOIN G_PRODUCT P ON T.G_P' +
        'RODUCT = P.G_PRODUCT'
      '11024801=  WHERE T.SKLAD = :SKLAD_'
      '11024802=  INTO'
      '11024803=    :G_PRODUCT_,'
      '11024804=    :AMOUNT_,'
      '11024805=    :PRICE_,'
      '11024806=    :SUMM_,'
      '11024807=    :PRICE_CURRENCY_,'
      '11024808=    :SUMM_CURRENCY_,'
      '11024809=    :NDS_,'
      '11024810=    :NDS_SUMM_,'
      '11024811=    :G_PROD_NAME_;'
      '11024812=end'
      '11024813='#39';'
      '11024814=END  --END_EXECUTE_BLOCK'
      '11024815=EXECUTE BLOCK AS BEGIN'
      '11024816='
      '11024817=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD('
      '11024818=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '11024819=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      
        '11024820=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIP' +
        'T,'
      '11024821=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '11024822=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '11024823=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '11024824=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '11024825=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '11024826=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11024827=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11024828=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11024829=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11024830=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11024831=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY = 0)'
      '11024832=RETURNS ('
      '11024833=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11024834=  ERR_CODE INTEGER,'
      '11024835=  ERR_MSG VARCHAR(1024))'
      '11024836=AS'
      '11024837=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '11024838=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042#1040 +
        #1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '11024839=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '11024840=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '11024841=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050 +
        #1048
      
        '11024842=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' '#1057 +
        #1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '11024843=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050#1040 +
        #1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047#1044 +
        #1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '11024844=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059#1044 +
        #1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM ' +
        #1041#1059#1044#1059
      '11024845=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '11024846=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047#1053 +
        #1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048' ' +
        #1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '11024847=declare variable PROCNAME varchar(255) = '#39#39'INS_SKLAD'#39#39';'
      '11024848=declare variable PNT_ varchar(5);'
      
        '11024849=declare variable RG_PRODUCT_ type of column SKLAD.G_PRO' +
        'DUCT;'
      
        '11024850=declare variable RAMOUNT_ type of column SKLAD.AMOUNT =' +
        ' 0;'
      '11024851=declare variable RPRICE_ numeric(15,2) = 0;'
      '11024852=declare variable RSUMM_ numeric(15,2) = 0;'
      '11024853=declare variable RNDS_ numeric(15,2) = 0;'
      
        '11024854=declare variable RNDS_SUMM_ type of column SKLAD.NDS_SU' +
        'MM = 0;'
      
        '11024855=declare variable SKLAD_TMP_ type of column SKLAD.SKLAD ' +
        '= 0;'
      '11024856=declare variable KASSA_ type of column KASSA.KASSA;'
      
        '11024857=declare variable G_PRIHOD_RASHOD_ type of column G_PRIH' +
        'OD_RASHOD.G_PRIHOD_RASHOD;'
      
        '11024858=declare variable DATE_LAST_ type of column SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11024859=declare variable IS_THIS_LAST_ integer; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '11024860=declare variable PAYMENT_ID_ type of column KASSA.KASSA' +
        ';'
      
        '11024861=declare variable PAYMENT_DATE_ type of column KASSA.ACT' +
        'ION_DATE;'
      
        '11024862=declare variable PAYMENT_SUMM_ type of column KASSA.SUM' +
        'M;'
      
        '11024863=declare variable PAYMENT_TYPE_ type of column G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11024864=declare variable STR_ varchar(500);'
      '11024865=declare variable POS_TILDA_ integer;'
      
        '11024866=declare variable PRICE_CURRENCY_ type of column SKLAD.P' +
        'RICE_CURRENCY;'
      
        '11024867=declare variable SUMM_CURRENCY_TMP_ type of column SKLA' +
        'D.SUMM_CURRENCY;'
      '11024868=BEGIN'
      '11024869='
      '11024870=  PNT_ = '#39#39'00'#39#39';'
      '11024871=  IS_THIS_LAST_ = 0;'
      '11024872='
      '11024873=  IF (G_TOCHKA_ IS NULL) THEN'
      '11024874=    SELECT ID'
      '11024875=      FROM CUR_PARAMS'
      '11024876=     WHERE CUR_PARAMS = 2'
      '11024877=      INTO :G_TOCHKA_;'
      '11024878='
      '11024879=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '11024880=                            DATE_RECEIPT,'
      '11024881=                            TIME_RECEIPT,'
      '11024882=                            G_CLIENT,'
      '11024883=                            G_PAYMENT_TYPE,'
      '11024884=                            OSNOVANIE,'
      '11024885=                            NOTE,'
      '11024886=                            SUMM,'
      '11024887=                            SUMM_FACT,'
      '11024888=                            SUMM_CURRENCY,'
      '11024889=                            IS_PAYED_ALL,'
      '11024890=                            IS_VOZVRAT,'
      '11024891=                            G_TOCHKA)'
      '11024892=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11024893=          :DATE_RECEIPT_,'
      '11024894=          :TIME_RECEIPT_,'
      '11024895=          :G_CLIENT_,'
      '11024896=          :G_PAYMENT_TYPE_,'
      '11024897=          :OSNOVANIE_,'
      '11024898=          :NOTE_,'
      '11024899=          :SUMM_,'
      '11024900=          :SUMM_FACT_,'
      '11024901=          :SUMM_CURRENCY_,'
      
        '11024902=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PAY' +
        'ED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055 +
        #1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11024903=          :IS_VOZVRAT_,'
      '11024904=          :G_TOCHKA_)'
      '11024905=  RETURNING'
      '11024906=    SKLAD'
      '11024907=  INTO'
      '11024908=    :SKLAD_;'
      '11024909='
      '11024910=  PNT_ = '#39#39'01'#39#39';'
      '11024911=  FOR SELECT SKLAD,'
      '11024912=             G_PRODUCT,'
      '11024913=             AMOUNT,'
      '11024914=             PRICE,'
      '11024915=             SUMM,'
      '11024916=             NDS,'
      '11024917=             NDS_SUMM'
      '11024918=             ,PRICE_CURRENCY'
      '11024919=             ,SUMM_CURRENCY'
      '11024920=        FROM SKLAD_TMP'
      '11024921=      ORDER BY 1'
      '11024922=      INTO :SKLAD_TMP_,'
      '11024923=           :RG_PRODUCT_,'
      '11024924=           :RAMOUNT_,'
      '11024925=           :RPRICE_,'
      '11024926=           :RSUMM_,'
      '11024927=           :RNDS_,'
      '11024928=           :RNDS_SUMM_'
      '11024929=           ,:PRICE_CURRENCY_'
      '11024930=           ,:SUMM_CURRENCY_TMP_'
      '11024931=  DO BEGIN'
      '11024932=    if (IS_VOZVRAT_ IN (0,4)) then BEGIN'
      
        '11024933=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '11024934=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068#1064 +
        #1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '11024935=      IS_THIS_LAST_ = 0;'
      '11024936=      SELECT MAX(SK.DATE_RECEIPT)'
      '11024937=        FROM SKLAD SK'
      '11024938=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11024939=         AND SK.IS_LAST = 1'
      '11024940=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '11024941=        INTO :DATE_LAST_;'
      '11024942='
      
        '11024943=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (D' +
        'ATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11024944=        UPDATE SKLAD SK'
      '11024945=           SET SK.IS_LAST = 0'
      '11024946=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11024947=           AND SK.IS_LAST = 1'
      '11024948=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '11024949='
      '11024950=        IS_THIS_LAST_ = 1;'
      '11024951=      END'
      '11024952=    END'
      '11024953='
      '11024954=    INSERT INTO SKLAD'
      '11024955=    ('
      '11024956=     SKLAD,'
      '11024957=     SKLAD_PARENT,'
      '11024958=     DATE_RECEIPT,'
      '11024959=     G_CLIENT,'
      '11024960=     G_PRODUCT,'
      '11024961=     AMOUNT,'
      '11024962=     PRICE,'
      '11024963=     SUMM,'
      '11024964=     G_PAYMENT_TYPE,'
      '11024965=     OSNOVANIE,'
      '11024966=     NOTE,'
      '11024967=     NDS,'
      '11024968=     NDS_SUMM,'
      '11024969=     IS_LAST,'
      '11024970=     IS_VOZVRAT,'
      '11024971=     G_TOCHKA'
      '11024972=     ,PRICE_CURRENCY'
      '11024973=     ,SUMM_CURRENCY'
      '11024974=    ) VALUES ('
      '11024975=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '11024976=     :SKLAD_,'
      '11024977=     :DATE_RECEIPT_,'
      '11024978=     :G_CLIENT_,'
      '11024979=     :RG_PRODUCT_,'
      '11024980=     :RAMOUNT_,'
      '11024981=     :RPRICE_,'
      '11024982=     :RSUMM_,'
      '11024983=     :G_PAYMENT_TYPE_,'
      '11024984=     :OSNOVANIE_,'
      '11024985=     :NOTE_,'
      '11024986=     :RNDS_,'
      '11024987=     :RNDS_SUMM_,'
      
        '11024988=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057#1051 +
        #1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054#1064 +
        #1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044#1045 +
        #1058' 0'
      '11024989=     :IS_VOZVRAT_,'
      '11024990=     :G_TOCHKA_'
      '11024991=     ,:PRICE_CURRENCY_'
      '11024992=     ,:SUMM_CURRENCY_TMP_'
      '11024993=    );'
      '11024994='
      
        '11024995=    -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '11024996=    PNT_ = '#39#39'02'#39#39';'
      '11024997=    UPDATE LT_SKLAD_PRODUCT L'
      '11024998=       SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11024999=     WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110241000=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110241001='
      '110241002=    IF (ROW_COUNT = 0) THEN'
      
        '110241003=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, ' +
        'G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(GEN_' +
        'LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110241004=  END'
      '110241005=  ----------------------------------------'
      '110241006='
      
        '110241007=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110241008=  PNT_ = '#39#39'05'#39#39';'
      
        '110241009=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110241010=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110241011=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110241012=      ELSE'
      '110241013=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110241014='
      
        '110241015=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110241016=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110241017=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110241018=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110241019=                                        :SUMM_FACT_,'
      
        '110241020=                                        :DATE_RECEIPT_' +
        ','
      
        '110241021=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110241022=                                        NULL,   --ZAKA' +
        'Z_'
      '110241023=                                        :SKLAD_,'
      
        '110241024=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110241025=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110241026=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110241027=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110241028=            EXIT;'
      '110241029=          END'
      '110241030=      END ELSE BEGIN'
      '110241031=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110241032=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110241033=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110241034=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110241035=            ELSE'
      
        '110241036=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110241037='
      '110241038=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110241039=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110241040='
      
        '110241041=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110241042='
      '110241043=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110241044=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110241045=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110241046=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110241047=                                              :PAYMENT' +
        '_DATE_,'
      
        '110241048=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110241049=                                              NULL,   ' +
        '--ZAKAZ_'
      '110241050=                                              :SKLAD_,'
      
        '110241051=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110241052=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110241053=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110241054=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110241055=                  EXIT;'
      '110241056=                END'
      '110241057=            END'
      '110241058=          END'
      '110241059=      END'
      '110241060=  END'
      '110241061='
      '110241062=  DELETE FROM SKLAD_TMP;'
      '110241063='
      
        '110241064=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110241065=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110241066=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110241067=                                  G_PRIHOD_,'
      '110241068=                                  :SUMM_PRIHOD_,'
      '110241069=                                  :DATE_RECEIPT_,'
      
        '110241070=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110241071=                                  NULL,   --:ZAKAZ_,'
      '110241072=                                  :SKLAD_,'
      '110241073=                                  :G_PAYMENT_TYPE_,'
      
        '110241074=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110241075=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110241076=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110241077=      EXIT;'
      '110241078=    END'
      '110241079=  END'
      '110241080=end'
      '110241081='#39';'
      '110241082='
      '110241083=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD_TMP('
      '110241084=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110241085=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110241086=  PRICE_ NUMERIC(15,2),'
      '110241087=  SUMM_ NUMERIC(15,2),'
      '110241088=  NDS_ NUMERIC(15,2),'
      '110241089=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110241090=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110241091=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0)'
      '110241092=RETURNS ('
      '110241093=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110241094=  ERR_CODE INTEGER,'
      '110241095=  ERR_MSG VARCHAR(1024))'
      '110241096=AS'
      
        '110241097=declare variable PROCNAME varchar(255) = '#39#39'INS_SKLAD_T' +
        'MP'#39#39';'
      '110241098=begin'
      
        '110241099=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY)'
      
        '110241100=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :AM' +
        'OUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110241101=    ,:PRICE_CURRENCY_'
      '110241102=    ,:SUMM_CURRENCY_)'
      '110241103=  RETURNING SKLAD'
      '110241104=  INTO :SKLAD_;'
      '110241105=end'
      '110241106='#39';'
      '110241107='
      
        '110241108=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_HISTORY' +
        '('
      '110241109=  G_PRODUCT_ARR_ VARCHAR(1000),'
      '110241110=  DATE_BEGIN_ DATE,'
      '110241111=  DATE_END_ DATE,'
      '110241112=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110241113=RETURNS ('
      '110241114=  ROW INTEGER,'
      '110241115=  DATE_ACT DATE,'
      '110241116=  OPER VARCHAR(500),'
      '110241117=  PRICE_PRIHOD NUMERIC(15,2),'
      '110241118=  AMOUNT_PRIHOD NUMERIC(15,2),'
      '110241119=  SUMM_PRIHOD NUMERIC(15,2),'
      '110241120=  PRICE_UHOD NUMERIC(15,2),'
      '110241121=  AMOUNT_UHOD NUMERIC(15,2),'
      '110241122=  SUMM_UHOD NUMERIC(15,2),'
      '110241123=  ERR_CODE INTEGER,'
      '110241124=  ERR_MSG VARCHAR(1024))'
      '110241125=AS'
      
        '110241126=declare variable PROCNAME varchar(30) = '#39#39'P_REP_TOVAR_' +
        'MOVE'#39#39';'
      '110241127=declare variable PNT_ varchar(5);'
      
        '110241128=declare variable G_PRODUCT_ type of column G_PRODUCT.G' +
        '_PRODUCT;'
      '110241129=declare variable DATE_SORT date;'
      '110241130=BEGIN'
      '110241131='
      '110241132=  FOR SELECT F.G_PRODUCT'
      '110241133=        FROM G_PRODUCT F'
      
        '110241134=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39#39'~'#39#39'||F.G_PRO' +
        'DUCT||'#39#39'~'#39#39
      '110241135=       AND EXISTS (SELECT 1'
      '110241136=                     FROM SKLAD SS'
      
        '110241137=                    WHERE SS.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      '110241138=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '110241139=                      AND :G_TOCHKA_ARR_ CONTAINING '#39#39 +
        '-'#39#39'||SS.G_TOCHKA||'#39#39'-'#39#39
      '110241140=                   UNION ALL'
      '110241141=                   SELECT 1'
      '110241142=                     FROM ZAKAZ ZZ,'
      '110241143=                          ZAKAZ_DETAILS ZZD'
      '110241144=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '110241145=                      AND ZZ.IS_RESERVE = 0'
      
        '110241146=                      AND ZZ.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      '110241147=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      
        '110241148=                      AND :G_TOCHKA_ARR_ CONTAINING '#39#39 +
        '-'#39#39'||ZZ.G_TOCHKA||'#39#39'-'#39#39
      '110241149=                   UNION ALL'
      '110241150=                   SELECT 1'
      '110241151=                     FROM OTHER ZZ,'
      '110241152=                          OTHER_DETAILS ZZD'
