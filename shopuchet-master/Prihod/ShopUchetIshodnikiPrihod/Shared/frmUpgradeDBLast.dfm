        'IL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '110391022=        PNT_ = '#39#39'05'#39#39';'
      '110391023=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '110391024=            SELECT MAX(SK.DATE_RECEIPT)'
      '110391025=              FROM SKLAD SK'
