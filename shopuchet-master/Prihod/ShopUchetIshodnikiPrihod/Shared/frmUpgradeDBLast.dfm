      '110391039=                 SET SK.IS_LAST = 1'
      '110391040=               WHERE SK.SKLAD = :SKLAD_;'
      '110391041=            END'
      '110391042=        END'
      '110391043='
      
        '110391044=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110391045=    END ELSE BEGIN'
      '110391046=        PNT_ = '#39#39'06'#39#39';'
      '110391047=        UPDATE SKLAD S'
      '110391048=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '110391049=               S.G_CLIENT = :G_CLIENT_,'
      '110391050=               S.AMOUNT   = :AMOUNT_,'
      '110391051=               S.PRICE    = :PRICE_,'
      '110391052=               S.SUMM     = :SUMM_ONE_,'
      '110391053=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110391054=               S.NDS      = :NDS_,'
      '110391055=               S.NDS_SUMM = :NDS_SUMM_,'
      '110391056=               S.OSNOVANIE = :OSNOVANIE_,'
      '110391057=               S.NOTE      = :NOTE_'
      '110391058=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110391059=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP_'
      '110391060=         WHERE S.SKLAD = :SKLAD_;'
      '110391061='
      '110391062=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110391063=        if (AMOUNT_OLD_ > AMOUNT_) then'
      '110391064=          UPDATE LT_SKLAD_PRODUCT L'
      
        '110391065=             SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD_ -' +
        ' :AMOUNT_)'
      '110391066=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110391067=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110391068='
      '110391069=        ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '110391070=          UPDATE LT_SKLAD_PRODUCT L'
      
        '110391071=             SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ - :AM' +
        'OUNT_OLD_)'
      '110391072=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110391073=             AND L.G_TOCHKA = :G_TOCHKA_;'
