      '110242231=              UPDATE SKLAD SK'
      '110242232=                 SET SK.IS_LAST = 0'
      '110242233=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242234=                 AND SK.IS_LAST = 1'
      '110242235=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110242236='
      '110242237=              UPDATE SKLAD SK'
      '110242238=                 SET SK.IS_LAST = 1'
      '110242239=               WHERE SK.SKLAD = :SKLAD_;'
      '110242240=            END'
      '110242241=        END'
      '110242242='
      
        '110242243=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048' ' +
        'IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068 +
