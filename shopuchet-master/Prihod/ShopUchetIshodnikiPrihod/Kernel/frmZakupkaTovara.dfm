    SelectSQL.Strings = (
      'SELECT S.PRICE, S.PRICE_CURRENCY'
      'FROM SKLAD S'
      'WHERE S.G_TOCHKA = :G_TOCHKA_'
      ' AND S.IS_LAST = 1'
      ' AND S.G_PRODUCT = :G_PRODUCT_')
    Transaction = tranRead
