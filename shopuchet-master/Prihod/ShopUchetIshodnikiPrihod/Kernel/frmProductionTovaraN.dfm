  inherited spIns: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE DO_PRODUCT (?G_TOCHKA_, ?DATE_, ?G_PRODUCT_, ?' +
        'AMOUNT_, ?NOTE_)')
