  inherited spIns: TpFIBStoredProc
    SQL.Strings = (
      'begin'
      '  -- Call the procedure'
      '  ins_sklad(date_receipt_ => :date_receipt_,'
      '            g_client_ => :g_client_,'
      '            g_payment_type_ => :g_payment_type_,'
      '            osnovanie_ => :osnovanie_,'
      '            sklad_ => :sklad_,'
      '            err_code => :err_code,'
      '            err_msg => :err_msg);'
      'end;')
    Left = 40
    Top = 352
  end
  inherited spUpd: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE UPD_SKLAD (?SKLAD_, ?DATE_RECEIPT_, ?G_CLIENT_' +
        ', ?AMOUNT_, ?PRICE_, ?SUMM_, ?G_PAYMENT_TYPE_, ?OSNOVANIE_, ?NOT' +
        'E_, ?NDS_, ?NDS_SUMM_, ?ALLOW_SELL_ABSENT_GOODS_)')
    StoredProcName = 'UPD_SKLAD'
    Left = 72
    Top = 352
  end
