  object spReadProd: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT'
      '        T.G_PRODUCT,'
      '        T.G_PRODUCT_PAR,'
      '        T.ARTICUL,'
      '        T.NOMENCLATUR_NUM,'
      '        T.BARCODE,'
      '        T.NAME,'
      
        '        T.PRICE, --Z.PRICE + Z.DISCOUNT_TENGE,  -- '#1061#1047' '#1047#1040#1063#1045#1052' '#1058#1040#1050' ' +
        #1057#1044#1045#1051#1040#1051', 23.05.2016'
      '        T.VOLUME_PRICE,'
      '        T.IS_CATEGORY,'
      '        T.IS_ACTIVE,'
      '        T.PLACE, '
      
        '        (Z.AMOUNT_ALL - COALESCE(Z.AMOUNT_PAYED, 0) - COALESCE(Z' +
        '.AMOUNT_RETURNED, 0)) AMOUNT,'
      '        Z.DISCOUNT_PERC SKIDKA_PROC,'
      '        Z.DISCOUNT_TENGE SKIDKA_SUM,'
      '        Z.ZAKAZ_NA_REAL,'
      '        ZP.OSNOVANIE'
      '    FROM G_PRODUCT T,'
      '         ZAKAZ_REAL_PARENT ZP,'
      '         ZAKAZ_NA_REAL Z,'
      '         (SELECT DISTINCT(SS.G_PRODUCT)'
      '          FROM (WITH RECURSIVE TREE'
      '                AS (SELECT G.G_PRODUCT'
      '                      FROM G_PRODUCT G'
      
        '                     WHERE G.G_PRODUCT = DECODE(:G_PRODUCT_PAR_,' +
        ' -1, G.G_PRODUCT, :G_PRODUCT_PAR_)'
      '                       AND G.IS_CATEGORY = 1'
      '                    UNION ALL'
      '                    SELECT G.G_PRODUCT'
      
        '                      FROM G_PRODUCT G INNER JOIN TREE PRIOR ON ' +
        'PRIOR.G_PRODUCT = G.G_PRODUCT_PAR'
      '                     WHERE G.IS_CATEGORY = 1'
      '                  )'
      '               SELECT * FROM TREE) SS) S1'
      '    WHERE T.G_PRODUCT_PAR = S1.G_PRODUCT'
      '    AND T.IS_CATEGORY = 0'
      '    AND T.G_PRODUCT = Z.G_PRODUCT'
      '    AND Z.IS_PAYED_ALL = 0   -- '#1058#1054#1051#1068#1050#1054' '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1045
      '    AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PARENT'
      '    AND ZP.G_CLIENT = :G_CLIENT_'
      '    AND ZP.G_TOCHKA = :G_tochka_'
      '    ORDER BY T.NAME'
      ' '
      ' '
      ' ')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 288
    Top = 152
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
