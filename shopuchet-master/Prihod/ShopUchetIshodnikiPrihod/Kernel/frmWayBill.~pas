    edTransp: TdxEdit;
    lbTtn: TLabel;
    Label14: TLabel;
    spOtpuskAgree: TpFIBDataSet;
    dsOtpuskAgree: TDataSource;
    Label15: TLabel;
    leOtpustil: TdxLookupEdit;
    spOtpustil: TpFIBDataSet;
    dsOtpustil: TDataSource;
    edPoluchatel: TdxEdit;
