    Label4: TLabel;
    Shape7: TShape;
    edIDN: TdxEdit;
    Shape8: TShape;
    Label5: TLabel;
    Shape9: TShape;
    Shape10: TShape;
    Shape11: TShape;
    Shape12: TShape;
    Shape27: TShape;
    Shape28: TShape;
    Shape29: TShape;
    dsIspolnitel: TDataSource;
    Label13: TLabel;
    leIspolnitel: TdxLookupEdit;
    aPrint: TAction;
    BitBtn1: TBitBtn;
    Shape31: TShape;
    Shape32: TShape;
    Shape33: TShape;
    Shape34: TShape;
    Label19: TLabel;
    edTTN: TdxEdit;
    leOtpuskAgree: TdxLookupEdit;
    Shape30: TShape;
