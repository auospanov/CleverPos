    Top = 207
  end
  object spRead: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT * FROM G_READ_G_PRODCAT_LIST')
    Filter = 'g_product <> -1'
    Transaction = tranRead
    Database = MainDM.dbMain
    Filtered = True
    Left = 208
    Top = 232
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object dsRead: TDataSource
    DataSet = spRead
    Left = 240
    Top = 232
  end
  object spReadTovar: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT G_PRODUCT, '
      
        '       NAME||DECODE(CHAR_LENGTH(TRIM(ARTICUL)), 0, '#39#39', '#39' | '#39'||TR' +
        'IM(ARTICUL)) ART_NAME,'
      '       NAME '
      'FROM G_PRODUCT WHERE G_PRODUCT_PAR = ?G_PRODUCT_PAR_'
      'AND IS_CATEGORY = 0'
      '')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 136
    Top = 256
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object dsReadTovar: TDataSource
    DataSet = spReadTovar
    Left = 168
    Top = 256
  end
  object spReadTochka: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT * FROM G_TOCHKA_READ')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 312
    Top = 16
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object dsReadTochka: TDataSource
    DataSet = spReadTochka
    Left = 343
    Top = 16
  end
