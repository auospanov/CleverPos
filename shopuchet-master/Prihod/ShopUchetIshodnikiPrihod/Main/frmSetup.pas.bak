    Label5: TLabel;
    Shape9: TShape;
    Shape10: TShape;
    spUpd: TpFIBStoredProc;
    spGetData: TpFIBStoredProc;
    tranRead: TpFIBTransaction;
    tranWrite: TpFIBTransaction;
    GroupBox2: TGroupBox;
    cbPrinters: TComboBox;
    cbBillWidth: TComboBox;
