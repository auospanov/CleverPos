    Shape15: TShape;
    peAutoRefresh: TdxPickEdit;
    petbButtonsStyle: TdxPickEdit;
    Shape4: TShape;
    Shape16: TShape;
    ts2: TcxTabSheet;
    Label13: TLabel;
    Shape26: TShape;
    Label14: TLabel;
    Shape27: TShape;
    peMenuFont: TdxPickEdit;
    Shape28: TShape;
    seMenuFontSize: TdxSpinEdit;
    Shape29: TShape;
    mTestMenuFont: TdxMemo;
    Shape30: TShape;
    Label11: TLabel;
    Shape21: TShape;
    peGridFont: TdxPickEdit;
    Shape22: TShape;
    Label12: TLabel;
    Shape23: TShape;
    seGridFontSize: TdxSpinEdit;
    Shape24: TShape;
    mTestGridFont: TdxMemo;
    Shape25: TShape;
    Label15: TLabel;
    Shape31: TShape;
    pePopupFormBorderStyle: TdxPickEdit;
    Shape32: TShape;
    Label16: TLabel;
    Shape33: TShape;
    pePopupFlatBorder: TdxPickEdit;
    Shape34: TShape;
    tsCommon: TcxTabSheet;
    GroupBox1: TGroupBox;
    Label3: TLabel;
    Shape5: TShape;
    cbBackupPeriod: TComboBox;
    Shape6: TShape;
    rbDoBackupOnStart: TRadioButton;
    rbDoBackupOnExit: TRadioButton;
    ceCanSellNol: TdxCheckEdit;
