<TfrxReport Version="5.4.6" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.AllowEdit="False" PreviewOptions.Buttons="3569" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="42142,4011544329" ReportOptions.Description.Text="" ReportOptions.LastChange="44823,7303428935" ScriptLanguage="PascalScript" ScriptText.Text="procedure m_PriceOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;price_bold&#62; = 1 then&#13;&#10;    m_Price.font.style := fsbold;&#13;&#10;  m_Price.font.size := &#60;price_size&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure m_SloganOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;slogan_bold&#62; = 1 then&#13;&#10;    m_Slogan.font.style := fsbold;&#13;&#10;  m_Slogan.font.size := &#60;slogan_size&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure m_NameOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;name_bold&#62; = 1 then&#13;&#10;    m_Name.font.style := fsbold;&#13;&#10;  m_Name.font.size := &#60;name_size&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure m_ArticulOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;articul_bold&#62; = 1 then&#13;&#10;    m_Articul.font.style := fsbold;&#13;&#10;  m_Articul.font.size := &#60;articul_size&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  if &#60;name_t&#62; = null then&#13;&#10;    m_Name.Visible := False;&#13;&#10;  if (&#60;slogan&#62; = null) then&#13;&#10;    m_Slogan.Visible := False;&#13;&#10;  if (&#60;articul&#62; = null) then&#13;&#10;    m_Articul.Visible := False;&#13;&#10;  if &#60;barcode&#62; = null then&#13;&#10;    BarCode13.Visible := False&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    if&#60;bar_type&#62; = 1 then&#13;&#10;      BarCode13.BarType := bcCodeEAN8&#13;&#10;    else&#13;&#10;      if &#60;bar_type&#62; = 2 then&#13;&#10;        BarCode13.BarType := bcCodeUPC_A&#13;&#10;      else&#13;&#10;        BarCode13.BarType := bcCodeEAN13;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if (&#60;PriceDiscount&#62; = null) or (&#60;PriceDiscount&#62; = '') then&#13;&#10;    if (&#60;price&#62; = null) or (&#60;price&#62; = '') then&#13;&#10;      m_price.text := ''&#13;&#10;    else&#13;&#10;      m_price.text := 'Цена [price]'&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    m_Price.text := 'Цена &#60;strike&#62;[price]&#60;/strike&#62; [PriceDiscount]';&#13;&#10;  end;&#13;&#10;end.">
