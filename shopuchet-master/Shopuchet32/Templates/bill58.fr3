<TfrxReport Version="5.4.6" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.AllowEdit="False" PreviewOptions.Buttons="3569" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="42299,7827454051" ReportOptions.Description.Text="" ReportOptions.LastChange="44925,7799293403" ScriptLanguage="PascalScript" ScriptText.Text="var t : double;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;frxDBDataset1.&#34;DISCOUNT&#34;&#62; = '0.00' ) then begin&#13;&#10;     ChildDiscount.Visible := false;&#13;&#10;  end else begin&#13;&#10;     ChildDiscount.Visible := true;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Footer1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset1.&#34;SUMM_SERVICE_&#34;&#62; = '0.00' then&#13;&#10;    ChildService.Visible := False;&#13;&#10;&#13;&#10;  if (&#60;frxDBDataset1.&#34;SUMM_POLUCH_&#34;&#62; &#60;&#62; '0.00') or (&#60;frxDBDataset1.&#34;SUMM_NONCASH_&#34;&#62; &#60;&#62; '0.00') then begin&#13;&#10;    if &#60;frxDBDataset1.&#34;SUMM_POLUCH_&#34;&#62; = '0.00' then begin&#13;&#10;      ChildCash.Visible := False;&#13;&#10;      ChildSdacha.Visible := False;&#13;&#10;    end;&#13;&#10;&#13;&#10;    if &#60;frxDBDataset1.&#34;SUMM_NONCASH_&#34;&#62; = '0.00' then begin&#13;&#10;      ChildNonCash.Visible := False;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if &#60;frxDBDataset1.&#34;SUMM_BONUS_&#34;&#62; = '0.00' then&#13;&#10;    ChildOplataBonusami.Visible := False;&#13;&#10;&#13;&#10;  if &#60;frxDBDataset1.&#34;SUMM_NDS_&#34;&#62; = '0.00' then&#13;&#10;    ChildNDS.Visible := False;&#13;&#10;&#13;&#10;  if ((&#60;frxDBDataset1.&#34;BONUS_STR_&#34;&#62; = '') and (&#60;frxDBDataset1.&#34;BONUSALL_STR_&#34;&#62; = '')) then&#13;&#10;  begin&#13;&#10;    ChildBonus.Visible := False;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if &#60;frxDBDataset1.&#34;DELIVERY_ADDRESS_&#34;&#62; = '' then begin&#13;&#10;    ChildDeliveryAddress.Visible := False;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if (&#60;print_barcode&#62; = '0') or (&#60;frxDBDataset1.&#34;BILL_BARCODE_&#34;&#62; = '') then&#13;&#10;    ChildBarcode.Visible := False;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;&#13;&#10;end.">
