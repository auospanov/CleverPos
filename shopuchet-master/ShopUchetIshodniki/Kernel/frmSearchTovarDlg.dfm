  object spSearchTov: TpFIBDataSet
    SelectSQL.Strings = (
      'select G.g_product,'
      '       G.name,'
      '       G.articul,'
      '       G.barcode,'
      '       G.NOMENCLATUR_NUM,'
      '       g.g_product_par,'
      
        '       COALESCE(P.AMOUNT, 0) - COALESCE(P.AMOUNT_RESERVE, 0) AMO' +
        'UNT,'
      '       g.price,'
      '       g.volume_price,'
      '       G.PLACE,'
      '       g.is_kit,'
      '       G.is_marked,'
      '       G.is_weight,'
      '       g.VES_GRAMM,'
      '       g.VES_GRAMM_PRICE'
      
        '  from g_product G left outer join (SELECT G_PRODUCT, AMOUNT, AM' +
        'OUNT_RESERVE FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_) ' +
        ' P ON G.G_PRODUCT = P.G_PRODUCT'
      'where G.is_active = 1 and g.is_category = 0'
      
        'order by G.name, G.g_product --g.g_product_par, G.name, G.g_prod' +
        'uct')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 16
    Top = 88
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
