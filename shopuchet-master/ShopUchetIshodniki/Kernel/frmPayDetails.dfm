  object dsPaymentType: TDataSource
    DataSet = spPaymentType
    Left = 199
    Top = 73
  end
  object spPaymentType: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT * FROM G_READ_G_PAYMENT_TYPE_LIST')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 232
    Top = 73
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object spSertificates: TpFIBDataSet
    SelectSQL.Strings = (
      
        'SELECT S.SERTIFICATE, S.SERTIFICATE_NUM||'#39'  ('#39'||CAST(S.SUMM-S.SU' +
        'MM_PAYED AS MY_NUMERIC)||'#39')'#39' NUM, S.SUMM-S.SUMM_PAYED OSTATOK, S' +
        '.SERTIFICATE_NUM'
      '            ,COALESCE(S.CLIENT_U, S.CLIENT_B) CLIENT'
      '  FROM SERTIFICATE S'
      ' WHERE S.SUMM > S.SUMM_PAYED'
      '     AND S.DATE_END >= CURRENT_DATE'
      '     AND S.CANCELED = 0'
      '   --AND COALESCE(S.CLIENT_U, S.CLIENT_B) = :G_CLIENT_')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 204
    Top = 105
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object dsSertificates: TDataSource
    DataSet = spSertificates
    Left = 236
    Top = 105
  end
  object tranRead: TpFIBTransaction
    DefaultDatabase = MainDM.dbMain
    TRParams.Strings = (
      'read'
      'nowait'
      'rec_version'
      'read_committed')
    TPBMode = tpbDefault
    Left = 24
    Top = 193
  end
end
