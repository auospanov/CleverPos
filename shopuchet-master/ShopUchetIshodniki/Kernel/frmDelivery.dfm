      'EXECUTE PROCEDURE DELIVERY_GET (?DELIVERY_)')
    StoredProcName = 'DELIVERY_GET'
    Left = 22
    Top = 340
  end
  inherited spIns: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE DELIVERY_INS (?G_CLIENT_, ?DOSTAVSHIK_, ?DELIV' +
        'ERY_DATE_, ?ADDRESS_, ?PRICE_, ?NOTE_, ?STATUS_, ?ZAKAZ_, ?SKLAD' +
        '_, ?TOVAR_DELIVERY_DATE_)')
    StoredProcName = 'DELIVERY_INS'
    Left = 54
    Top = 340
  end
  inherited spUpd: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE DELIVERY_UPD (?DELIVERY_, ?G_CLIENT_, ?DOSTAVS' +
        'HIK_, ?DELIVERY_DATE_, ?ADDRESS_, ?PRICE_, ?NOTE_, ?STATUS_, ?ZA' +
        'KAZ_, ?SKLAD_, ?TOVAR_DELIVERY_DATE_)')
    StoredProcName = 'DELIVERY_UPD'
    Left = 86
    Top = 340
  end
  object spClient: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT * FROM G_READ_G_CLIENT_LIST(?G_CLIENT_PARENT_)')
    Filter = 'is_supplier = 0'
    Transaction = tranRead
    Database = MainDM.dbMain
    Filtered = True
    Left = 232
    Top = 32
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object dsPostavshik: TDataSource
    DataSet = spClient
    Left = 263
    Top = 32
  end
  object spZakaz: TpFIBDataSet
    SelectSQL.Strings = (
      
        'SELECT Z.ZAKAZ ||'#39' '#1086#1090' '#39'||lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') ' +
        '||'
      '       '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') ||'
      
        '       '#39'.'#39' || extract(year from Z.Z_DATE) NUM, Z.G_CLIENT, Z.Zak' +
        'az'
      '  FROM ZAKAZ Z'
      'WHERE Z.IS_SPISANIE = 0'
      'ORDER BY Z_DATE DESC, ZAKAZ DESC')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 352
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object dsZakaz: TDataSource
    DataSet = spZakaz
    Left = 383
  end
  object spPrihod: TpFIBDataSet
    SelectSQL.Strings = (
      
        'SELECT Z.SKLAD ||'#39' '#1086#1090' '#39'||lpad(extract(day from Z.DATE_RECEIPT),2' +
        ','#39'0'#39') ||'
      '       '#39'.'#39' || lpad(extract(month from Z.DATE_RECEIPT),2,'#39'0'#39') ||'
      '       '#39'.'#39' || extract(year from Z.DATE_RECEIPT)||'
      '       DECODE(Z.G_CLIENT, NULL, '#39#39', '#39' '#39'||G.NAME) NUM,'
      '       Z.SKLAD'
      
        '  FROM SKLAD_PARENT Z LEFT OUTER JOIN G_CLIENT G ON Z.G_CLIENT =' +
        ' G.G_CLIENT'
      'WHERE Z.IS_VOZVRAT = 0'
      'ORDER BY Z.DATE_RECEIPT DESC, Z.SKLAD DESC')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 304
    Top = 56
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
  object dsPrihod: TDataSource
    DataSet = spPrihod
    Left = 335
    Top = 56
  end
end
