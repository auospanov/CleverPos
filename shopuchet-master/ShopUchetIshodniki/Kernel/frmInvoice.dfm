  object spGetNum: TpFIBDataSet
    SelectSQL.Strings = (
      
        'SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VARCHAR(20)) as N' +
        'um'
      '      FROM INVOICE P'
      
        '     WHERE EXTRACT(YEAR FROM P.INIT_DATE) = EXTRACT(YEAR FROM CA' +
        'ST(:INIT_DATE_ AS DATE))'
      '       AND ((SELECT * FROM IS_NUMERIC(P.NUM)) <> -999)')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 504
    Top = 32
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
