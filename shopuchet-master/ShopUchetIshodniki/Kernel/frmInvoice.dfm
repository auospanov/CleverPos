  inherited spGetData: TpFIBStoredProc
    SQL.Strings = (
      'EXECUTE PROCEDURE INV_GET_INVOICE (?INVOICE_, ?ZAKAZ_)')
    StoredProcName = 'INV_GET_INVOICE'
    Left = 96
    Top = 632
  end
  inherited spIns: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE INV_INS_INVOICE (?NUM_, ?INIT_DATE_, ?G_FIRM_,' +
        ' ?POSTAVSHIK_, ?IDN_, ?ADDRESS_, ?IIK_, ?AGREEMENT_, ?G_PAYMENT_' +
        'TYPE_, ?PUNKT_NAZNACHENIYA_, ?DOVERENNOST_, ?SPOSOB_OTPRAVKI_, ?' +
        'NAKLADNAYA_, ?GRUZOOTPRAVITEL_, ?GRUZOPOLUCHATEL_, ?ADDRESS_POLU' +
        'CHATELYA_, ?G_CLIENT_, ?CLIENT_NAME_, ?IDN_CLIENT_, ?ADDRESS_POK' +
        'UPATEL_, ?IIK_CLIENT_, ?G_OFFICIAL_RUKOVOD_, ?G_OFFICIAL_GB_, ?G' +
        '_OFFICIAL_, ?ZAKAZ_)')
    StoredProcName = 'INV_INS_INVOICE'
    Left = 128
    Top = 632
  end
  inherited spUpd: TpFIBStoredProc
    SQL.Strings = (
      
        'EXECUTE PROCEDURE INV_UPD_INVOICE (?INVOICE_, ?NUM_, ?INIT_DATE_' +
        ', ?G_FIRM_, ?POSTAVSHIK_, ?IDN_, ?ADDRESS_, ?IIK_, ?AGREEMENT_, ' +
        '?G_PAYMENT_TYPE_, ?PUNKT_NAZNACHENIYA_, ?DOVERENNOST_, ?SPOSOB_O' +
        'TPRAVKI_, ?NAKLADNAYA_, ?GRUZOOTPRAVITEL_, ?GRUZOPOLUCHATEL_, ?A' +
        'DDRESS_POLUCHATELYA_, ?G_CLIENT_, ?CLIENT_NAME_, ?IDN_CLIENT_, ?' +
        'ADDRESS_POKUPATEL_, ?IIK_CLIENT_, ?G_OFFICIAL_RUKOVOD_, ?G_OFFIC' +
        'IAL_GB_, ?G_OFFICIAL_, ?ZAKAZ_)')
    StoredProcName = 'INV_UPD_INVOICE'
    Left = 160
    Top = 632
  end
