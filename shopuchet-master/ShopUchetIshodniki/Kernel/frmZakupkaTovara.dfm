  object spGetLastPrice: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT S.PRICE, S.PRICE_CURRENCY'
      'FROM SKLAD S'
      'WHERE S.G_TOCHKA = :G_TOCHKA_'
      '         AND S.g_product = :G_PRODUCT_'
      '         AND S.date_receipt = (SELECT MAX(DD.DATE_RECEIPT)'
      '                               FROM SKLAD DD'
      '                               WHERE DD.g_product = :G_PRODUCT_'
      '                               AND DD.G_TOCHKA = :G_TOCHKA_)'
      'ORDER BY S.SKLAD DESC'
      'ROWS 1 TO 1')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 232
    Top = 152
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
