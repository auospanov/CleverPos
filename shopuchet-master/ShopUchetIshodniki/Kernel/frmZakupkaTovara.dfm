  object spRead: TpFIBDataSet
    SelectSQL.Strings = (
      
        'WITH DOPBAR AS (SELECT LIST(B.BARCODE) BARCODE_DOP, B.G_PRODUCT ' +
        'FROM LT_BARCODE B GROUP BY B.G_PRODUCT)'
      'SELECT T.G_PRODUCT,'
      '        T.ARTICUL,'
      '        T.BARCODE,'
      '        T.NOMENCLATUR_NUM,'
      '        T.NAME,'
      '        T.PRICE,'
      '        T.VOLUME_PRICE,'
      '        COALESCE(P.AMOUNT, 0) AMOUNT'
      '        ,T.NOTE'
      '        ,T.PLACE'
      '        ,T.CROSSCODE'
      '        ,T.IS_MARKED'
      '        ,T.BRAND'
      '        ,T.VES_GRAMM'
      '        ,DB.BARCODE_DOP'
      
        'FROM G_PRODUCT T LEFT OUTER JOIN LT_SKLAD_PRODUCT P ON T.G_PRODU' +
        'CT = P.G_PRODUCT AND P.G_TOCHKA = :G_TOCHKA_'
      
        '                 LEFT OUTER JOIN DOPBAR DB ON T.G_PRODUCT = DB.G' +
        '_PRODUCT'
      
        'WHERE T.G_PRODUCT_PAR = DECODE(CAST(:G_PRODUCT_PAR_ AS BIGINT), ' +
        '-1, T.G_PRODUCT_PAR, CAST(:G_PRODUCT_PAR_ AS BIGINT))'
      ' AND T.IS_CATEGORY = 0'
      ' AND T.IS_ACTIVE = 1'
      'ORDER BY 5'
      ''
      '/*SELECT'
      '        T.G_PRODUCT,'
      '        T.ARTICUL,'
      '        T.BARCODE,'
      '        T.NOMENCLATUR_NUM,'
      '        T.NAME,'
      '        T.PRICE,'
      '        T.VOLUME_PRICE,'
      '        COALESCE(P.AMOUNT, 0) AMOUNT'
      '        ,T.NOTE'
      '        ,T.PLACE'
      '        ,T.CROSSCODE'
      '        ,T.IS_MARKED'
      '        ,T.BRAND'
      '        ,T.VES_GRAMM'
      '    FROM (SELECT G_PRODUCT,'
      '                 G_PRODUCT_PAR,'
      '                 ARTICUL,'
      '                 BARCODE,'
      '                 NOMENCLATUR_NUM,'
      '                 NAME,'
      '                 PRICE,'
      '                 VOLUME_PRICE,'
      '                 NOTE,'
      '                 PLACE,'
      '                 CROSSCODE,'
      '                 IS_MARKED,'
      '                 BRAND,'
      '                 VES_GRAMM'
      '            FROM G_PRODUCT'
      '           WHERE IS_CATEGORY = 0'
      '             AND IS_ACTIVE = 1'
      '             --AND IS_KIT <> 1'
      '          UNION ALL'
      '          SELECT T1.G_PRODUCT,'
      '                 T1.G_PRODUCT_PAR,'
      '                 T1.ARTICUL,'
      '                 B.BARCODE,'
      '                 T1.NOMENCLATUR_NUM,'
      '                 T1.NAME||'#39' ('#1076#1086#1087'.'#1096#1090#1088#1080#1093#1082#1086#1076')'#39','
      '                 T1.PRICE,'
      '                 T1.VOLUME_PRICE,'
      '                 T1.NOTE,'
      '                 PLACE,'
      '                 CROSSCODE,'
      '                 T1.IS_MARKED,'
      '                 T1.BRAND,'
      '                 T1.VES_GRAMM'
      '            FROM G_PRODUCT T1, LT_BARCODE B'
      '           WHERE IS_CATEGORY = 0'
      '             AND IS_ACTIVE = 1'
      '             --AND IS_KIT <> 1'
      
        '             AND B.G_PRODUCT = T1.G_PRODUCT) T LEFT OUTER JOIN (' +
        'SELECT * FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_)  P O' +
        'N T.G_PRODUCT = P.G_PRODUCT'
      
        '    WHERE T.G_PRODUCT_PAR = DECODE(CAST(:G_PRODUCT_PAR_ AS BIGIN' +
        'T), -1, T.G_PRODUCT_PAR, CAST(:G_PRODUCT_PAR_ AS BIGINT))'
      '    ORDER BY 5'
      '*/')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 288
    Top = 152
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
