  object spRead: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT'
      '        T.G_PRODUCT,'
      '        T.ARTICUL,'
      '        T.BARCODE,'
      '        T.NAME,'
      '        T.PRICE,'
      '        T.VOLUME_PRICE,'
      '        COALESCE(P.AMOUNT, 0) AMOUNT'
      '        ,T.NOTE'
      '    FROM (SELECT G_PRODUCT,'
      '                 G_PRODUCT_PAR,'
      '                 ARTICUL,'
      '                 BARCODE,'
      '                 NAME,'
      '                 PRICE,'
      '                 VOLUME_PRICE,'
      '                 NOTE'
      '            FROM G_PRODUCT'
      '           WHERE IS_CATEGORY = 0'
      '             AND IS_ACTIVE = 1'
      '             AND IS_KIT <> 1'
      '          UNION ALL'
      '          SELECT T1.G_PRODUCT,'
      '                 T1.G_PRODUCT_PAR,'
      '                 T1.ARTICUL,'
      '                 B.BARCODE,'
      '                 T1.NAME||'#39' ('#1076#1086#1087'.'#1096#1090#1088#1080#1093#1082#1086#1076')'#39','
      '                 T1.PRICE,'
      '                 T1.VOLUME_PRICE,'
      '                 T1.NOTE'
      '            FROM G_PRODUCT T1, LT_BARCODE B'
      '           WHERE IS_CATEGORY = 0'
      '             AND IS_ACTIVE = 1'
      '             AND IS_KIT <> 1'
      
        '             AND B.G_PRODUCT = T1.G_PRODUCT) T LEFT OUTER JOIN (' +
        'SELECT * FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_)  P O' +
        'N T.G_PRODUCT = P.G_PRODUCT'
      
        '    WHERE T.G_PRODUCT_PAR = DECODE(:G_PRODUCT_PAR_, -1, T.G_PROD' +
        'UCT_PAR, :G_PRODUCT_PAR_)'
      '    ORDER BY 5'
      ' '
      ' '
      ' '
      ' ')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 288
    Top = 152
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
