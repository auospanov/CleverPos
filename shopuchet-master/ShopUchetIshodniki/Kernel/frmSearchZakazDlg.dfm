  object spSearchZakaz: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT Z.ZAKAZ,'
      '       Z.Z_DATE,'
      '       Z.Z_TIME,'
      '       G.NAME,'
      '       Z.SUMM,'
      '       GP.NAME PAY_NAME,'
      '       Z.NOTE'
      '  FROM ZAKAZ Z, G_CLIENT G, G_PAYMENT_TYPE GP'
      'WHERE Z.G_TOCHKA = :G_TOCHKA_'
      'AND G.G_CLIENT = Z.G_CLIENT'
      'AND Z.G_PAYMENT_TYPE = GP.G_PAYMENT_TYPE'
      
        'AND (Z.ZAKAZ LIKE '#39'%'#39'||:Z_NUM_||'#39'%'#39' OR Z.NOTE LIKE '#39'%'#39'||:Z_NUM_|' +
        '|'#39'%'#39')'
      'ORDER BY Z.G_TOCHKA, Z.Z_TIME, Z.ZAKAZ')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 40
    Top = 136
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
