      '110242328=                SELECT 2'
      '110242329=                  FROM KASSA_BEZNAL KB'
      '110242330=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110242331=                 INTO :PAYMENT_TYPE_OLD_;'
      '110242332='
      
