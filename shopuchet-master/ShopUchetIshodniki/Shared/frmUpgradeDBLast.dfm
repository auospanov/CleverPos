      '1102122054=        SELECT 15 COL,'
      '1102122055=               '#39#1054#1060#1054#1056#1052#1051#1045#1053#1053#1067#1045' '#1063#1045#1050#1048#39' STR,'
      '1102122056=               '#39'******'#39' AMOUNT,'
      '1102122057=               '#39'******'#39' SUMM'
      '1102122058=          FROM RDB$DATABASE'
      '1102122059=        UNION'
      '1102122060=        SELECT 16 COL,'
      '1102122061=               '#39'  '#1055#1056#1054#1044#1040#1046#1040#39' STR,'
      
        '1102122062=               '#39'*'#39'||(:PRODAZHI_CASH_AMOUNT_ + :PRODAZ' +
        'HI_NONCASH_AMOUNT_) AMOUNT,'
      
        '1102122063=               '#39'='#39'||(:PRODAZHI_CASH_SUMM_ + :PRODAZHI' +
        '_NONCASH_SUMM_) SUMM'
      '1102122064=          FROM RDB$DATABASE'
