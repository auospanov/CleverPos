        #1090', '#1091#1089#1083#1091#1075'): '#39'||COALESCE(TRIM(I.AGREEMENT), '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39'),'
      
        '110682076=         '#39#1059#1089#1083#1086#1074#1080#1103' '#1086#1087#1083#1072#1090#1099' '#1087#1086' '#1076#1086#1075#1086#1074#1086#1088#1091' ('#1082#1086#1085#1090#1088#1072#1082#1090#1091'): '#39'||G' +
        'P.NAME,'
      
