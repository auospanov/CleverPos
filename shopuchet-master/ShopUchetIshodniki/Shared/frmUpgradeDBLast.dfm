        'T_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '1102015321='
      '1102015322=    -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '1102015323=    AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + AMOUNT_' +
        'PRIHOD_;'
      
        '1102015324=    SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUMM_PRIH' +
        'OD_;'
      
        '1102015325=    AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMOUNT_UH' +
        'OD_;'
      '1102015326=    SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_UHOD_;'
      
        '1102015327=    AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ + AMOUN' +
        'T_SPISANO_;'
      
        '1102015328=    SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + SUMM_SP' +
        'ISANO_;'
      
        '1102015329=    AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ + AMOUN' +
        'T_VOZVRAT_;'
      
        '1102015330=    SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + SUMM_VO' +
        'ZVRAT_;'
      
        '1102015331=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ +' +
        ' AMOUNT_PRIHOD_SKL_;'
      
        '1102015332=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + S' +
        'UMM_PRIHOD_SKL_;'
      
        '1102015333=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + A' +
        'MOUNT_UHOD_SKL_;'
      
        '1102015334=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUM' +
        'M_UHOD_SKL_;'
      '1102015335='
      '1102015336=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '1102015337=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1102015338=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHO' +
        'D_SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1102015339=    VALUES'
      
        '1102015340=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AM' +
        'OUNT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UH' +
        'OD_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVR' +
        'AT_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIH' +
        'OD_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '1102015341='
      
        '1102015342=    STR_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102015343=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102015344='
      '1102015345=  FOR'
      '1102015346=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '1102015347=           DECODE(T.IS_HEAD,'
      '1102015348=                  0, T.NAME,'
      '1102015349=                  1, T.NAME,'
      '1102015350=                  2, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39','
      '1102015351=                  3, '#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39'),'
      '1102015352=           G.ARTICUL,'
      '1102015353=           G.BARCODE,'
      '1102015354=           G.PRICE,'
      '1102015355=           T.AMOUNT_IN,'
      '1102015356=           T.AMOUNT_PRIHOD,'
      '1102015357=           T.SUMM_PRIHOD,'
      '1102015358=           T.AMOUNT_UHOD,'
      '1102015359=           T.SUMM_UHOD,'
      '1102015360=           T.AMOUNT_SPISANO,'
      '1102015361=           T.SUMM_SPISANO,'
      '1102015362=           T.AMOUNT_VOZVRAT,'
      '1102015363=           T.SUMM_VOZVRAT,'
      '1102015364=           T.AMOUNT_PRIHOD_SKL,'
      '1102015365=           T.SUMM_PRIHOD_SKL,'
      '1102015366=           T.AMOUNT_UHOD_SKL,'
      '1102015367=           T.SUMM_UHOD_SKL,'
      '1102015368=           T.AMOUNT_OUT,'
      '1102015369=           T.IS_HEAD'
      
        '1102015370=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1102015371=     ORDER BY 1'
      '1102015372=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1102015373=       :NAME,'
      '1102015374=       :ARTICUL,'
      '1102015375=       :BARCODE,'
      '1102015376=       :PRICE,'
      '1102015377=       :AMOUNT_IN,'
      '1102015378=       :AMOUNT_PRIHOD,'
      '1102015379=       :SUMM_PRIHOD,'
      '1102015380=       :AMOUNT_UHOD,'
      '1102015381=       :SUMM_UHOD,'
      '1102015382=       :AMOUNT_SPISANO,'
      '1102015383=       :SUMM_SPISANO,'
      '1102015384=       :AMOUNT_VOZVRAT,'
      '1102015385=       :SUMM_VOZVRAT,'
      '1102015386=       :AMOUNT_PRIHOD_SKL,'
      '1102015387=       :SUMM_PRIHOD_SKL,'
      '1102015388=       :AMOUNT_UHOD_SKL,'
      '1102015389=       :SUMM_UHOD_SKL,'
      '1102015390=       :AMOUNT_OUT,'
      '1102015391=       :IS_HEAD'
      '1102015392=  DO SUSPEND;'
      '1102015393='
      '1102015394=WHEN ANY DO BEGIN'
      '1102015395=    Err_code = -20500;'
      
        '1102015396=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102015397=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102015398=  END'
      '1102015399=end'
      '1102015400=;'
      '1102015401='
      '1102015402=ALTER PROCEDURE SYNC_DOWNLOAD'
      '1102015403=RETURNS ('
      '1102015404=  ERR_CODE INTEGER,'
      '1102015405=  ERR_MSG VARCHAR(1024),'
      '1102015406=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '1102015407=AS'
      '1102015408=/*'
      '1102015409='#1060#1048#1053#1040#1051' 07.02.2019'
      '1102015410=*/'
      
        '1102015411=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_DOWNLOA' +
        'D'#39';'
      '1102015412=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102015413=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '1102015414=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
      '1102015415=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '1102015416=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '1102015417=DECLARE VARIABLE POS_ INTEGER = 0;'
      '1102015418=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '1102015419=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '1102015420=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '1102015421=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGM' +
        'ENT SIZE 80 = '#39#39';'
      '1102015422=DECLARE VARIABLE ID_STR_ VARCHAR(50);'
      '1102015423=DECLARE VARIABLE STR_ VARCHAR(100);'
      
        '1102015424=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102015425=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102015426=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PROD' +
        'UCT.AMOUNT;'
      
        '1102015427=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT_RESERVE;'
      '1102015428=BEGIN'
      '1102015429=  PNT_ = '#39'00'#39';'
      '1102015430=  ERR_CODE = 0;'
      '1102015431=  ERR_MSG = '#39#39';'
      '1102015432=  ERR_BODY = '#39#39';'
      '1102015433='
      '1102015434=  FOR SELECT L.ID,'
      '1102015435=             L.SQLSTMT'
      '1102015436=        FROM LOGS L'
      '1102015437=       WHERE L.USR = '#39'REPLICAT'#39
      '1102015438=         AND L.DAT IS NULL'
      '1102015439=         AND L.IS_TRANSFERED = 0'
      '1102015440=        ORDER BY L.ID'
      '1102015441=        INTO :LOGS_ID_,'
      '1102015442=             :SQL_'
      '1102015443=  DO BEGIN'
      '1102015444=    BEGIN'
      '1102015445=        SQLCODE_ = 0;'
      '1102015446='
      
        '1102015447=        -- '#1057#1054#1041#1048#1056#1040#1070' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1053#1040#1044#1054' '#1055#1045#1056#1045 +
        #1057#1063#1048#1058#1067#1042#1040#1058#1068
      
        '1102015448=        IF (POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN SQL_) > 0' +
        ') THEN BEGIN'
      
        '1102015449=          ID_STR_ = SUBSTRING(SQL_ FROM 18 FOR CHAR_L' +
        'ENGTH(SQL_) - 17);'
      '1102015450='
      
        '1102015451=          IF (POSITION(ID_STR_ IN PRODUCT_ID_ARR_) = ' +
        '0) THEN'
      
        '1102015452=            PRODUCT_ID_ARR_ = PRODUCT_ID_ARR_ || '#39'~'#39' ' +
        '|| ID_STR_;'
      '1102015453=        END'
      '1102015454=        ELSE BEGIN'
      '1102015455=            EXECUTE STATEMENT SQL_;'
      '1102015456='
      
        '1102015457=            IF (POSITION('#39'EXECUTE PROCEDURE K_RECALC_' +
        'KASSA'#39' IN SQL_) > 0) THEN BEGIN'
      '1102015458=              IF (ERR_CODE <> 0) THEN BEGIN'
      '1102015459=                SQLCODE_ = ERR_CODE;'
      '1102015460=                IF (ERR_BODY = '#39#39') THEN'
      
        '1102015461=                  ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084 +
        #1077#1085#1077#1085#1080#1081'.'#39';'
      '1102015462=                ERR_BODY = ERR_BODY ||'#39
      
        '1102015463=                '#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||ERR_CODE||'#39'. '#1044 +
        #1077#1090#1072#1083#1080': '#39'||ERR_MSG;'
      '1102015464='
      '1102015465=                ERR_CODE = 0;'
      '1102015466=                ERR_MSG = '#39#39';'
      '1102015467=              END'
      '1102015468=            END'
      '1102015469=        END'
      '1102015470='
      '1102015471=    WHEN ANY DO'
      '1102015472=        BEGIN'
      '1102015473=            SQLCODE_ = GDSCODE;'
      '1102015474=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102015475=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102015476=            ERR_BODY = ERR_BODY ||'#39
      '1102015477='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102015478=        END'
      '1102015479=    END'
      '1102015480='
      
        '1102015481=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102015482=    UPDATE LOGS L'
      
        '1102015483=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102015484=           L.ERR_CODE = :SQLCODE_'
      '1102015485=     WHERE L.ID = :LOGS_ID_;'
      '1102015486=  END'
      '1102015487='
      '1102015488=  POS_ = 0;'
      '1102015489=  FOR SELECT L.ID,'
      '1102015490=             L.SQLSTMT,'
      '1102015491=             L.DAT,'
      '1102015492=             L.RR'
      '1102015493=        FROM LOGS L'
      '1102015494=       WHERE L.USR = '#39'REPLICAT'#39
      '1102015495=         AND L.DAT IS NOT NULL'
      '1102015496=         AND L.IS_TRANSFERED = 0'
      '1102015497=        ORDER BY L.ID'
      '1102015498=        INTO :LOGS_ID_,'
      '1102015499=             :SQL_,'
      '1102015500=             :DAT_,'
      '1102015501=             :IDX_'
      '1102015502=  DO BEGIN'
      '1102015503=    POS_ = POSITION('#39'.'#39', SQL_);'
      '1102015504=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '1102015505=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR P' +
        'OS_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_' +
        ' - 1)||'#39' = :DAT_'#39'||'
      
        '1102015506=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ +' +
        ' 1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '1102015507='
      '1102015508=    BEGIN'
      '1102015509=        SQLCODE_ = 0;'
      '1102015510=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '1102015511=    WHEN ANY DO'
      '1102015512=        BEGIN'
      '1102015513=            SQLCODE_ = GDSCODE;'
      '1102015514=            ERR_BODY = ERR_BODY ||'#39
      '1102015515='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102015516=        END'
      '1102015517=    END'
      '1102015518='
      
        '1102015519=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102015520='
      '1102015521=    UPDATE LOGS L'
      
        '1102015522=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102015523=           L.ERR_CODE = :SQLCODE_'
      '1102015524=     WHERE L.ID = :LOGS_ID_;'
      '1102015525=  END'
      '1102015526='
      '1102015527='
      '1102015528=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      '1102015529=  POS_ = 1;'
      '1102015530=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '1102015531=    BEGIN'
      
        '1102015532=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ F' +
        'ROM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '1102015533='
      '1102015534=        WHILE (POS_ > 0) DO BEGIN'
      '1102015535=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '1102015536='
      '1102015537=            IF (POS_ > 0) THEN'
      
        '1102015538=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1' +
        ' FOR POS_ - 1);'
      '1102015539=            ELSE'
      '1102015540=              STR_ = PRODUCT_ID_ARR_;'
      '1102015541='
      
        '1102015542=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 F' +
        'OR POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '1102015543=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSI' +
        'TION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN ST' +
        'R_)) AS BIGINT);'
      '1102015544='
      
        '1102015545=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_' +
        'ARR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '1102015546='
      '1102015547=            select ('
      '1102015548=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102015549=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s, sklad_parent sp'
      '1102015550=                    where sp.SKLAD = s.SKLAD_PARENT'
      '1102015551=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '1102015552=                      and s.g_product = :G_PRODUCT_'
      
        '1102015553=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077 +
        ' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102015554='
      '1102015555=                   -'
      '1102015556=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102015557=                   (select COALESCE(sum(zr.AMOUNT_ALL' +
        '), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102015558=                    where zr.g_product = :G_PRODUCT_ ' +
        'and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102015559=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZA' +
        'KAZ_REAL_PARENT)'
      '1102015560='
      '1102015561=                   -'
      '1102015562=                   -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102015563=                   (select COALESCE(sum(zd.amount), 0' +
        ') from zakaz_details zd, zakaz z'
      
        '1102015564=                    where zd.g_product = :G_PRODUCT_ ' +
        'and Z.G_TOCHKA = :G_TOCHKA_'
      '1102015565=                    and zd.zakaz = z.zakaz'
      
        '1102015566=                    and z.IS_RESERVE = 0      -- '#1085#1077' '#1074 +
        #1099#1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081 +
        #1076#1077#1090' '#1085#1080#1078#1077
      
        '1102015567=                    and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095 +
        #1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' ' +
        #1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102015568=                    and not (z.IS_SPISANIE = 0 and z.' +
        'NOT_MINUS_OSTATOK = 1)'
      '1102015569=                   )'
      '1102015570='
      '1102015571=                   -'
      '1102015572=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102015573=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat =' +
        ' 3'
      '1102015574=                    and S.g_client = :G_TOCHKA_)'
      '1102015575='
      '1102015576=                   -'
      '1102015577=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102015578=                   (select COALESCE(sum(od.amount), 0' +
        ') from other_details od, other o'
      
        '1102015579=                    where od.g_product = :G_PRODUCT_ ' +
        'and o.G_TOCHKA = :G_TOCHKA_'
      '1102015580=                    and od.other = o.other)'
      '1102015581=                   ) amount,'
      '1102015582='
      
        '1102015583=                   (SELECT COALESCE(sum(ZD.amount), 0' +
        ') FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102015584=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AN' +
        'D Z.IS_RESERVE = 1'
      
        '1102015585=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.' +
        'G_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102015586=            from rdb$database'
      '1102015587=            INTO :AMOUNT_,'
      '1102015588=                 :AMOUNT_RESERVE_;'
      '1102015589='
      '1102015590=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102015591=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :' +
        'G_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102015592=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_' +
        'TOCHKA = CD.G_TOCHKA)'
      '1102015593=            WHEN MATCHED THEN'
      
        '1102015594=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.A' +
        'MOUNT_RESERVE = :AMOUNT_RESERVE_'
      '1102015595=            WHEN NOT MATCHED THEN'
      
        '1102015596=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, ' +
        'AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102015597=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, ' +
        ' 1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102015598=        END'
      '1102015599=    WHEN ANY DO'
      '1102015600=        BEGIN'
      '1102015601=            SQLCODE_ = GDSCODE;'
      '1102015602=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102015603=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102015604=            ERR_BODY = ERR_BODY ||'#39
      
        '1102015605=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102015606=        END'
      '1102015607=    END'
      '1102015608=  END'
      '1102015609=END'
      '1102015610=;'
      '1102015611='
      '1102015612=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD('
      '1102015613=  OBJECT_TYPE_ INTEGER,'
      '1102015614=  LOAD_TYPE_ INTEGER = 0,'
      '1102015615=  OPER_ INTEGER = 0)'
      '1102015616=RETURNS ('
      '1102015617=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '1102015618=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102015619=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102015620=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102015621=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102015622=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102015623=  CLIENT_ID TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102015624=  IDN TYPE OF COLUMN G_CLIENT.IDN,'
      '1102015625=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102015626=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '1102015627=  SUMM_ALL TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102015628=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102015629=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102015630=  SUMM_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1102015631=  SUMM_SERT MY_NUMERIC,'
      '1102015632=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102015633=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102015634=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102015635=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102015636=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102015637=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102015638=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1102015639=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1102015640=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_A' +
        'PP,'
      '1102015641=  PARENT_ID TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1102015642=  ITEM_ID TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DETAILS,'
      '1102015643=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1102015644=  G_TOCHKA TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102015645=  RTYPE TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '1102015646=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE)'
      '1102015647=AS'
      '1102015648=/*'
      
        '1102015649=OPER_      : '#1058#1048#1055' '#1054#1055#1045#1056#1040#1062#1048#1048', 1 - '#1042#1057#1058#1040#1042#1050#1040', 2 - '#1048#1047#1052#1045#1053#1045#1053#1048#1045 +
        ', 3 - '#1059#1044#1040#1051#1045#1053#1048#1045
      
        '1102015650=LOAD_TYPE_ : '#1058#1048#1055' '#1042#1067#1043#1056#1059#1047#1050#1048'  0 - '#1054#1041#1067#1063#1053#1040#1071', 1 - '#1044#1051#1071' '#1052#1054#1041#1048#1051 +
        #1050#1048
      '1102015651=*/'
      '1102015652=BEGIN'
      '1102015653='
      
        '1102015654=-- G_PRODUCT, '#1058#1054#1051#1068#1050#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1071', '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1054 +
        #1050#1040' '#1055#1054#1057#1067#1051#1040#1058#1068' '#1042' '#1052#1054#1041#1048#1051#1050#1059' '#1053#1045' '#1041#1059#1044#1059
      '1102015655=  IF (OBJECT_TYPE_ = 4) THEN BEGIN'
      '1102015656=    FOR SELECT TT.ARTICUL'
      '1102015657=              ,TT.BARCODE'
      '1102015658=              ,TT.NOMENCLATUR_NUM'
      '1102015659=              ,TT.NAME'
      '1102015660=              ,TT.PRICE'
      '1102015661=              ,TT.SYNC_EXT_APP'
      '1102015662=              ,TT.G_PRODUCT_PAR'
      '1102015663=              ,TT.IS_CATEGORY'
      '1102015664=              ,TT.G_PRODUCT'
      '1102015665=          FROM ('
      
        '1102015666=                WITH RECURSIVE TREE AS (SELECT T.G_PR' +
        'ODUCT,'
      '1102015667=                               T.G_PRODUCT_PAR,'
      '1102015668=                               T.NAME,'
      '1102015669=                               1 LVL'
      '1102015670=                          FROM G_PRODUCT T'
      
        '1102015671=                         WHERE T.G_PRODUCT_PAR IS NUL' +
        'L'
      '1102015672=                           AND T.IS_CATEGORY = 1'
      '1102015673=                           AND T.IS_ACTIVE = 1'
      '1102015674=                        UNION ALL'
      '1102015675=                        SELECT T.G_PRODUCT,'
      '1102015676=                               T.G_PRODUCT_PAR,'
      '1102015677=                               T.NAME,'
      '1102015678=                               GG.LVL + 1'
      
        '1102015679=                          FROM G_PRODUCT T INNER JOIN' +
        ' TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '1102015680=                         WHERE T.IS_CATEGORY = 1'
      '1102015681=                           AND T.IS_ACTIVE = 1'
      '1102015682=                       )'
      
        '1102015683=                SELECT AP.OPER, TR.G_PRODUCT, '#39#39' ARTI' +
        'CUL, '#39#39' BARCODE, '#39#39' NOMENCLATUR_NUM, TR.NAME, 0 PRICE, AP.SYNC_E' +
        'XT_APP, TR.G_PRODUCT_PAR, 1 IS_CATEGORY, TR.LVL'
      '1102015684=                FROM TREE TR,'
      '1102015685=                     SYNC_EXT_APP AP'
      '1102015686=                WHERE TR.G_PRODUCT = AP.ID'
      '1102015687=                AND AP.IS_LOADING = 1'
      '1102015688=                AND AP.OBJECT_TYPE = 4'
      
        '1102015689=                AND AP.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051 +
        #1045#1053#1048#1071
      '1102015690=                AND :OPER_ <> 3'
      '1102015691=                UNION ALL'
      '1102015692=                SELECT S.OPER'
      '1102015693=                      ,P.G_PRODUCT'
      '1102015694=                      ,P.ARTICUL'
      '1102015695=                      ,P.BARCODE'
      '1102015696=                      ,P.NOMENCLATUR_NUM'
      '1102015697=                      ,P.NAME'
      '1102015698=                      ,P.PRICE'
      '1102015699=                      ,S.SYNC_EXT_APP'
      '1102015700=                      ,P.G_PRODUCT_PAR'
      '1102015701=                      ,P.IS_CATEGORY'
      '1102015702=                      ,10000 LVL'
      '1102015703=                 FROM SYNC_EXT_APP S'
      '1102015704=                      ,G_PRODUCT P'
      '1102015705=                WHERE S.IS_LOADING = 1'
      
        '1102015706=                  AND ((S.IS_LOADED = 0 AND :LOAD_TYP' +
        'E_ = 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '1102015707=                  AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1102015708=                  AND S.OBJECT_TYPE = 4'
      '1102015709=                  AND S.ID = P.G_PRODUCT'
      '1102015710=                  AND P.IS_CATEGORY = 0'
      
        '1102015711=                  AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040 +
        #1051#1045#1053#1048#1071
      '1102015712=                  AND :OPER_ <> 3'
      '1102015713=                UNION ALL'
      '1102015714=                SELECT S.OPER'
      '1102015715=                      ,S.ID G_PRODUCT'
      '1102015716=                      ,'#39#39' ARTICUL'
      '1102015717=                      ,'#39#39' BARCODE'
      '1102015718=                      ,'#39#39' NOMENCLATUR_NUM'
      '1102015719=                      ,'#39#39' NAME'
      '1102015720=                      ,0PRICE'
      '1102015721=                      ,S.SYNC_EXT_APP'
      '1102015722=                      ,0 G_PRODUCT_PAR'
      '1102015723=                      ,0 IS_CATEGORY'
      '1102015724=                      ,10000 LVL'
      '1102015725=                 FROM SYNC_EXT_APP S'
      '1102015726=                WHERE S.IS_LOADING = 1'
      
        '1102015727=                  AND ((S.IS_LOADED = 0 AND :LOAD_TYP' +
        'E_ = 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '1102015728=                  AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1102015729=                  AND S.OBJECT_TYPE = 4'
      '1102015730=                  AND S.OPER = 3        -- '#1059#1044#1040#1051#1045#1053#1048#1071
      '1102015731=                  AND :OPER_ = 3'
      '1102015732=                ORDER BY 11) TT'
      '1102015733=         INTO :ARTICUL,'
      '1102015734=              :BARCODE,'
      '1102015735=              :NOMENCLATUR_NUM,'
      '1102015736=              :TOVAR_NAME,'
      '1102015737=              :PRICE,'
      '1102015738=              :SYNC_EXT_APP,'
      '1102015739=              :PARENT_ID,'
      '1102015740=              :IS_CATEGORY,'
      '1102015741=              :G_PRODUCT'
      '1102015742=    DO'
      '1102015743=        SUSPEND;'
      '1102015744=  END'
      '1102015745=  ELSE BEGIN'
      '1102015746=      FOR SELECT S.OPER'
      
        '1102015747=                  ,(CASE WHEN Z.REC_ID IS NOT NULL TH' +
        'EN Z.REC_ID ELSE Z.ZAKAZ END) ID'
      '1102015748=                  ,Z.Z_DATE'
      '1102015749=                  ,Z.Z_TIME'
      '1102015750=                  ,C.G_CLIENT ID'
      '1102015751=                  ,C.IDN'
      '1102015752=                  ,C.NAME CLIENT_NAME'
      '1102015753=                  ,G.NAME SKLAD_NAME'
      '1102015754=                  ,Z.SUMM SUMM_ALL'
      '1102015755=                  ,Z.SUMM_CASH'
      '1102015756=                  ,Z.SUMM_NONCASH'
      '1102015757=                  ,Z.SUMM_BONUS'
      '1102015758=                  ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1102015759=                  ,P.ARTICUL'
      '1102015760=                  ,P.BARCODE'
      '1102015761=                  ,P.NOMENCLATUR_NUM'
      '1102015762=                  ,P.NAME'
      '1102015763=                  ,ZD.AMOUNT'
      '1102015764=                  ,ZD.PRICE - ZD.DISCOUNT_TENGE PRICE'
      '1102015765=                  ,ZD.SUMM'
      '1102015766=                  ,S.SYNC_EXT_APP'
      '1102015767=                  ,Z.OSNOVANIE'
      '1102015768=                  ,Z.NOTE'
      '1102015769=                  ,NULL PARENT_ID'
      '1102015770=                  ,NULL IS_CATEGORY'
      '1102015771=                  ,Z.G_TOCHKA'
      '1102015772=                  ,Z.IS_SPISANIE RTYPE'
      '1102015773=                  ,ZD.ZAKAZ_DETAILS  ITEM_ID'
      '1102015774=                  ,ZD.G_PRODUCT'
      '1102015775=                  ,ZD.COST_PRICE'
      '1102015776=             FROM SYNC_EXT_APP S'
      '1102015777=                  ,ZAKAZ Z'
      '1102015778=                  ,ZAKAZ_DETAILS ZD'
      '1102015779=                  ,G_TOCHKA G'
      '1102015780=                  ,G_CLIENT C'
      '1102015781=                  ,G_PRODUCT P'
      '1102015782=            WHERE S.IS_LOADING = 1'
      
        '1102015783=              AND ((S.IS_LOADED = 0 AND :LOAD_TYPE_ =' +
        ' 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '1102015784=              AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1102015785=              AND S.OBJECT_TYPE = 1'
      
        '1102015786=              AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048 +
        #1071
      '1102015787=              AND :OPER_ <> 3'
      '1102015788=              AND S.ID = Z.ZAKAZ'
      '1102015789=              AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102015790=              AND Z.G_TOCHKA = G.G_TOCHKA'
      '1102015791=              AND Z.G_CLIENT = C.G_CLIENT'
      '1102015792=              AND ZD.G_PRODUCT = P.G_PRODUCT'
      '1102015793=            UNION ALL'
      '1102015794=            SELECT S.OPER'
      
        '1102015795=                   ,S.ID          -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1047 +
