      '110202967=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '110202968=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110202969=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
