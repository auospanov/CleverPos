      '110164104=ALTER PROCEDURE G_INS_G_CLIENT('
      '110164105=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110164106=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT,'
      '110164107=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110164108=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110164109=  IDN_ VARCHAR(12),'
      '110164110=  KBE_ VARCHAR(5),'
      '110164111=  SKIDKA_ NUMERIC(15,2),'
      '110164112=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '110164113=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110164114=  BY_DEFAULT_ INTEGER,'
      '110164115=  IS_SUPPLIER_ INTEGER,'
      '110164116=  IS_CATEGORY_ INTEGER,'
      '110164117=  IS_BEZNAL_ INTEGER,'
      '110164118=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110164119=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110164120=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110164121=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110164122=  NOTIFY_SKIDKA_ INTEGER,'
      '110164123=  NOTIFY_DR_ INTEGER,'
      '110164124=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '110164125=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110164126=  SUMM_BONUS_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      
        '110164127=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONU' +
        'S_PAY_SUMM,'
      
        '110164128=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110164129=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110164130=RETURNS ('
      '110164131=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110164132=  ERR_CODE INTEGER,'
      '110164133=  ERR_MSG VARCHAR(1024))'
      '110164134=AS'
      '110164135=DECLARE VARIABLE CNT_ INTEGER;'
      '110164136=begin'
      
        '110164137=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = ' +
        '1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '110164138=    if (BY_DEFAULT_ = 1) then'
      '110164139=      UPDATE g_client'
      '110164140=         SET BY_DEFAULT = 0'
      '110164141=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '110164142='
      
        '110164143=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G' +
        '_CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '110164144=                          IS_CATEGORY, IS_BEZNAL, PHON' +
        'E, NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR, M' +
        'AX_BONUS_PAY_SUMM)'
      
        '110164145=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_' +
        ', :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_,' +
        ' :BY_DEFAULT_,'
      
        '110164146=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE' +
        '_, :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR' +
        '_, :MAX_BONUS_PAY_SUMM_)'
      '110164147=    returning G_CLIENT'
      '110164148=    into :G_CLIENT_;'
      '110164149='
      '110164150=    if (IS_CATEGORY_ = 0) then BEGIN'
      '110164151=        IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '110164152=            IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '110164153=                         FROM G_DISCONT_CARD'
      '110164154=                        WHERE BARCODE = :BARCODE_'
      
        '110164155=                          AND G_CLIENT <> :G_CLIENT_))' +
        ' THEN BEGIN'
      '110164156=              ERR_CODE = -20500;'
      
        '110164157=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '110164158=              EXIT;'
      '110164159=            END'
      '110164160=        END'
      '110164161='
      
        '110164162=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_' +
        'CLIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '110164163=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIE' +
        'NT_, :BARCODE_, :N_PERCENT_, :SUMM_BONUS_ALL_, 0);'
      '110164164=    END'
      '110164165='
      '110164166=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110164167=    EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_C' +
        'LIENT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '110164168=end'
      '110164169=;'
      '110164170='
      '110164171=ALTER PROCEDURE G_UPD_G_CLIENT('
      '110164172=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110164173=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      '110164174=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '110164175=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110164176=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110164177=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '110164178=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '110164179=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '110164180=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '110164181=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110164182=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '110164183=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '110164184=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '110164185=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '110164186=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110164187=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110164188=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110164189=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110164190=  NOTIFY_SKIDKA_ INTEGER,'
      '110164191=  NOTIFY_DR_ INTEGER,'
      '110164192=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '110164193=  G_CLIENT_PROMO_ INTEGER,'
      '110164194=  SUMM_BONUS_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      
        '110164195=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONU' +
        'S_PAY_SUMM,'
      
        '110164196=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110164197=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110164198=RETURNS ('
      '110164199=  ERR_CODE INTEGER,'
      '110164200=  ERR_MSG VARCHAR(1024))'
      '110164201=AS'
      '110164202=DECLARE VARIABLE CNT_ INTEGER;'
      '110164203=BEGIN'
      
        '110164204=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1,' +
        ' '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '110164205=  if (BY_DEFAULT_ = 1) then'
      '110164206=    UPDATE g_client'
      '110164207=       SET BY_DEFAULT = 0'
      '110164208=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '110164209='
      '110164210=  UPDATE g_client'
      '110164211=  SET'
      
        '110164212=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CLI' +
        'ENT_PARENT),'
      
        '110164213=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTRA' +
        'GENT),'
      '110164214=   NAME = COALESCE(:NAME_, NAME),'
      '110164215=   IDN  = COALESCE(:IDN_, IDN),'
      '110164216=   KBE  = COALESCE(:KBE_, KBE),'
      '110164217=   PHONE = COALESCE(:PHONE_, PHONE),'
      '110164218=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '110164219=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      '110164220=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER),'
      '110164221=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '110164222=   ,DT    = :DT_ --COALESCE(:DT_, DT)'
      '110164223=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '110164224=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '110164225=   ,G_PROMOTION = :G_PROMOTION_'
      '110164226=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '110164227=   ,NOTIFY_DR = :NOTIFY_DR_'
      '110164228=   ,MAX_BONUS_PAY_SUMM = :MAX_BONUS_PAY_SUMM_'
      '110164229=  WHERE'
      '110164230=    g_client = :g_client_;'
      '110164231='
      '110164232=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '110164233=    IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '110164234=        IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '110164235=                     FROM G_DISCONT_CARD'
      '110164236=                    WHERE BARCODE = :BARCODE_'
      
        '110164237=                      AND G_CLIENT <> :G_CLIENT_)) THE' +
        'N BEGIN'
      '110164238=          ERR_CODE = -20500;'
      
        '110164239=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1050#1072#1088 +
        #1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '110164240=          EXIT;'
      '110164241=        END'
      '110164242=    END'
      '110164243='
      '110164244=    UPDATE G_DISCONT_CARD G'
      '110164245=    SET G.BARCODE = :BARCODE_,'
      '110164246=        G.N_PERCENT = :N_PERCENT_,'
      '110164247=        G.summ = :SUMM_BONUS_ALL_,'
      '110164248=        G.summ_all = COALESCE(G.summ_all, 0)'
      '110164249=    WHERE G.G_CLIENT = :g_client_;'
      '110164250='
      '110164251=    if (ROW_COUNT = 0) then'
      
        '110164252=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_CL' +
        'IENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '110164253=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIENT' +
        '_, :BARCODE_, :N_PERCENT_, :SUMM_BONUS_ALL_, (select Coalesce(su' +
        'm(SUMM_FACT), 0) from zakaz where g_client = :g_client_));'
      '110164254=  END'
      '110164255='
      '110164256=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110164257=  EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_CLI' +
        'ENT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '110164258=end'
      '110164259=;'
      '110164260='
      '110164261=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110164262=RETURNS ('
      '110164263=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110164264=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '110164265=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '110164266=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '110164267=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '110164268=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110164269=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110164270=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '110164271=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '110164272=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110164273=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110164274=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110164275=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110164276=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZ' +
        'N_PROC,'
      '110164277=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '110164278=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_' +
        'PROC,'
      '110164279=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '110164280=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_SA' +
        'LE_PRICE,'
      '110164281=  MARK_CODE TYPE OF COLUMN SKLAD_TMP.MARK_CODE)'
      '110164282=AS'
      '110164283=begin'
      '110164284=  FOR'
      
        '110164285=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.' +
        'SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '110164286=           ,PRICE_CURRENCY'
      '110164287=           ,SUMM_CURRENCY'
      '110164288=           ,CHARGE_ROZN_PROC'
      '110164289=           ,PRICE_ROZN'
      '110164290=           ,CHARGE_OPT_PROC'
      '110164291=           ,PRICE_OPT'
      '110164292=           ,CHANGE_SALE_PRICE'
      '110164293=           ,MARK_CODE'
      '110164294=    FROM SKLAD_TMP T,'
      '110164295=         G_PRODUCT P'
      '110164296=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110164297=    ORDER BY T.sklad'
      
        '110164298=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :' +
        'NDS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '110164299=      ,:PRICE_CURRENCY'
      '110164300=      ,:SUMM_CURRENCY'
      '110164301=      ,:CHARGE_ROZN_PROC'
      '110164302=       ,:PRICE_ROZN'
      '110164303=       ,:CHARGE_OPT_PROC'
      '110164304=       ,:PRICE_OPT'
      '110164305=       ,:CHANGE_SALE_PRICE'
      '110164306=       ,:MARK_CODE'
      '110164307=  DO'
      '110164308=    suspend;'
      '110164309=end'
      '110164310=;'
      '110164311='
      '110164312='
      
