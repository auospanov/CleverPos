      '110261083='
      '110261084=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110261085=  FIRST_ITER = 0;'
      
        '110261086=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39#39'0'#39#39 +
        ')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||E' +
        'XTRACT(YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_S' +
        'TR'
      '110261087=           ,Z.Z_DATE'
      '110261088=           ,GP.ARTICUL'
      '110261089=           ,GP.BARCODE'
      '110261090=           ,GP.NAME'
      '110261091=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '110261092=           ,SUM(ZD.summ)    SUMM'
      '110261093=      FROM ZAKAZ Z'
      '110261094=           ,ZAKAZ_DETAILS ZD'
      '110261095=           ,G_PRODUCT GP'
      '110261096=     WHERE Z.is_spisanie = 4'
      '110261097=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110261098=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110261099=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110261100=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      '110261101=       AND Z.G_TOCHKA = :G_TOCHKA_'
      
        '110261102=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NAM' +
