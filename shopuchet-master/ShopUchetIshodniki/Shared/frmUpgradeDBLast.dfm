        '110206811=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110206812=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110206813=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110206814=                  EXIT;'
      '110206815=                END'
      '110206816=            END'
      '110206817='
      '110206818=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110206819=        END ELSE BEGIN'
      '110206820=            PNT_ = '#39'06'#39';'
      
        '110206821=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110206822=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110206823=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110206824=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110206825=                ELSE'
      
        '110206826=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110206827='
      
