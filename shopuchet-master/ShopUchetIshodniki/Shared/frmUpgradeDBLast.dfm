      '1101580='
      '1101581=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '1101582=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101583=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101584=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '1101585=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101586=  PREFIX_ VARCHAR(2))'
      '1101587=RETURNS ('
      '1101588=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101589=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT' +
        '_PAR,'
      '11015810=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11015811=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11015812=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11015813=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11015814=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '11015815=  ERR_CODE INTEGER,'
      '11015816=  ERR_MSG VARCHAR(1024))'
      '11015817=AS'
      '11015818=/*'
      '11015819='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '11015820=*/'
      
        '11015821=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PRODUC' +
        'T_BY_BARCODE'#39';'
      '11015822=BEGIN'
