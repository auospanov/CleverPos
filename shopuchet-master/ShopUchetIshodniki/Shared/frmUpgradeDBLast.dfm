        'UMM_PRIHOD_SKL_;'
      
        '1101322362=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + A' +
        'MOUNT_UHOD_SKL_;'
      
        '1101322363=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUM' +
        'M_UHOD_SKL_;'
      '1101322364='
      '1101322365=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '1101322366=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1101322367=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHO' +
        'D_SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1101322368=    VALUES'
      
