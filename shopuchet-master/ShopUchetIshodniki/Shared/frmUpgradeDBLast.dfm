        '1102283454=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1102283455=                IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGI' +
        'N'
      '1102283456=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102283457=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
