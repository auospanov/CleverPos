        #1042#1050#1059
      '1102283374=            PNT_ = '#39'023'#39';'
      '1102283375=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102283376=                UPDATE LT_SKLAD_PRODUCT L'
      
