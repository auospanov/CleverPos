      '1101131286=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101131287=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PR' +
        'ICE,'
      '1101131288=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT)'
      '1101131289=AS'
      '1101131290=begin'
      '1101131291='
      '1101131292=  FOR'
      '1101131293=    SELECT T.ZAKAZ_DETAILS,'
      '1101131294=           T.ZAKAZ,'
      '1101131295=           T.G_PRODUCT,'
      '1101131296=           T.AMOUNT,'
      '1101131297=           T.PRICE,'
      '1101131298=           T.SUMM,'
      '1101131299=           T.DISCOUNT_PERC,'
      '1101131300=           T.DISCOUNT_SUMM,'
      '1101131301=           T.NDS,'
      '1101131302=           T.NDS_SUMM,'
      '1101131303=           P.NAME PRODUCT_NAME'
      '1101131304=           ,P.BARCODE'
      '1101131305=           ,P.ARTICUL'
      '1101131306=           ,P.PRICE'
      '1101131307=           ,P.IS_KIT'
      '1101131308=           ,T.COST_PRICE'
      '1101131309=      FROM ZAKAZ_DETAILS_TMP T,'
      '1101131310=           G_PRODUCT P'
      '1101131311=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101131312=    ORDER BY t.ZAKAZ_DETAILS'
      '1101131313=    INTO :ZAKAZ_DETAILS,'
      '1101131314=          :ZAKAZ,'
      '1101131315=          :G_PRODUCT,'
      '1101131316=          :AMOUNT,'
      '1101131317=          :PRICE,'
      '1101131318=          :SUMM,'
      '1101131319=          :DISCOUNT_PERC,'
      '1101131320=          :DISCOUNT_SUMM,'
      '1101131321=          :NDS,'
      '1101131322=          :NDS_SUMM,'
      '1101131323=          :PRODUCT_NAME'
      '1101131324=          ,:BARCODE'
      '1101131325=          ,:ARTICUL'
      '1101131326=          ,:PRODUCT_PRICE'
      '1101131327=          ,:IS_KIT'
      '1101131328=          ,:COST_PRICE'
      '1101131329=  DO'
      '1101131330=    suspend;'
      '1101131331=end'
      '1101131332=;'
      '1101131333='
      '1101131334=ALTER PROCEDURE UPD_SKLAD('
      '1101131335=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101131336=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1101131337=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1101131338=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1101131339=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1101131340=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101131341=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101131342=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101131343=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1101131344=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101131345=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101131346=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1101131347=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1101131348=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0)'
      '1101131349=RETURNS ('
      '1101131350=  ERR_CODE INTEGER,'
      '1101131351=  ERR_MSG VARCHAR(1024))'
      '1101131352=AS'
      
        '1101131353=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1101131354=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1101131355=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101131356=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101131357=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1101131358=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101131359=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101131360=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1101131361=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1101131362=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1101131363=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101131364=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1101131365=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101131366=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1101131367=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101131368=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1101131369=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1101131370=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101131371=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1101131372=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101131373=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101131374=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101131375=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101131376=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101131377=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101131378=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101131379=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101131380=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101131381=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101131382=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101131383=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1101131384=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1101131385=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1101131386=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      '1101131387=BEGIN'
      '1101131388='
      '1101131389=  IS_THIS_LAST_ = 0;'
      '1101131390='
      '1101131391=  SELECT S.G_TOCHKA,'
      '1101131392=         S.IS_VOZVRAT,'
      '1101131393=         S.G_PAYMENT_TYPE'
      '1101131394=         ,S.is_expected'
      '1101131395=    FROM SKLAD_parent S'
      '1101131396=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1101131397=    INTO :G_TOCHKA_,'
      '1101131398=         :IS_VOZVRAT_,'
      '1101131399=         :G_PAYMENT_TYPE_OLD_'
      '1101131400=         ,:IS_EXPECTED_OLD_;'
      '1101131401='
      '1101131402=  PNT_ = '#39'00'#39';'
      '1101131403=  UPDATE SKLAD_PARENT'
      '1101131404=  SET'
      
        '1101131405=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1101131406=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1101131407=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1101131408=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1101131409=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101131410=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101131411=   SUMM      = :SUMM_,'
      '1101131412=   SUMM_FACT = :SUMM_FACT_,'
      '1101131413=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1101131414=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0) ' +
        ' -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054 +
        ' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101131415=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '1101131416=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1101131417='
      
        '1101131418=  ---------------------------------------------------' +
        '----------'
      
        '1101131419=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1101131420=  PNT_ = '#39'02'#39';'
      '1101131421=  FOR SELECT SKLAD'
      '1101131422=        FROM SKLAD S'
      '1101131423=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101131424=         AND NOT EXISTS (SELECT 1'
      '1101131425=                           FROM SKLAD_TMP T'
      '1101131426=                        WHERE T.SKLAD = S.SKLAD)'
      '1101131427=  INTO :SKLAD_'
      '1101131428=  DO BEGIN'
      
        '1101131429=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101131430=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101131431=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101131432=      EXIT;'
      '1101131433=    END'
      '1101131434=  END'
      '1101131435='
      
        '1101131436=  ---------------------------------------------------' +
        '----------'
      
        '1101131437=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1101131438=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1101131439=  PNT_ = '#39'03'#39';'
      '1101131440=  FOR SELECT S.SKLAD,'
      '1101131441=             S.G_PRODUCT,'
      '1101131442=             S.AMOUNT,'
      '1101131443=             S.PRICE,'
      '1101131444=             S.SUMM,'
      '1101131445=             S.NDS,'
      '1101131446=             S.NDS_SUMM,'
      '1101131447=             T.SKLAD,'
      '1101131448=             T.AMOUNT,'
      '1101131449=             T.IS_LAST,'
      '1101131450=             T.DATE_RECEIPT'
      '1101131451=             ,S.PRICE_CURRENCY'
      '1101131452=             ,S.SUMM_CURRENCY'
      '1101131453=             ,S.PRICE_ROZN'
      
        '1101131454=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1101131455=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1101131456=  INTO :SKLAD_,'
      '1101131457=       :G_PRODUCT_,'
      '1101131458=       :AMOUNT_,'
      '1101131459=       :PRICE_,'
      '1101131460=       :SUMM_ONE_,'
      '1101131461=       :NDS_,'
      '1101131462=       :NDS_SUMM_,'
      '1101131463=       :SKLAD_OLD_,'
      '1101131464=       :AMOUNT_OLD_,'
      '1101131465=       :IS_THIS_LAST_,'
      '1101131466=       :DATE_RECEIPT_OLD_'
      '1101131467=       ,:PRICE_CURRENCY_'
      '1101131468=       ,:SUMM_CURRENCY_TMP_'
      '1101131469=       ,:SALE_PRICE_'
      '1101131470=       ,:SALE_PRICE_CUR_'
      '1101131471=  DO BEGIN'
      
        '1101131472=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101131473=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1101131474=        PNT_ = '#39'04'#39';'
      
        '1101131475=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1101131476=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1101131477=                          ,PRICE_CURRENCY'
      '1101131478=                          ,SUMM_CURRENCY)'
      
        '1101131479=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1101131480=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101131481=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1101131482=               ,:PRICE_CURRENCY_'
      '1101131483=               ,:SUMM_CURRENCY_TMP_'
      '1101131484=               );'
      '1101131485='
      
        '1101131486=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1101131487=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1101131488=            UPDATE LT_SKLAD_PRODUCT L'
      '1101131489=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101131490=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101131491=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101131492='
      '1101131493=            IF (ROW_COUNT = 0) THEN'
      
        '1101131494=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_);'
      '1101131495=        END'
      '1101131496='
      
        '1101131497=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101131498=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
