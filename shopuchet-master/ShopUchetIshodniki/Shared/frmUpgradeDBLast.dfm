      '110223635=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110223636='
      
        '110223637=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086 +
        #1084' '#39'||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110223638='
      
