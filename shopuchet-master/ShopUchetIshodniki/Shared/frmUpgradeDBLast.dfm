        'EGER,'
      '110245=  AMOUNT_ INTEGER,'
      '110246=  NOTE_ /* TYPE OF COLUMN OTHER.NOTE */ BLOB SUB_TYPE 1)'
      '110247=RETURNS ('
      '110248=  SKLAD_ /* TYPE OF COLUMN OTHER.OTHER */ INTEGER,'
      '110249=  ERR_CODE INTEGER,'
      '1102410=  ERR_MSG VARCHAR(1024))'
      '1102411=AS'
      '1102412=BEGIN'
      '1102413=  SUSPEND;'
      '1102414=END'
      '1102415='#39';'
      '1102416='
      '1102417=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '1102418=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR */ INTEGER,'
      
        '1102419=  ARTICUL_ /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '1102420=  NOMENCLATUR_NUM_ /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '1102421=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '1102422=  NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '1102423=  NAME_G_UNIT_ /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(' +
        '50),'
      
        '1102424=  PRICE_ /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      
        '1102425=  VOLUME_PRICE_ /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ' */ NUMERIC(15,2),'
      
        '1102426=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ INTEG' +
        'ER,'
      '1102427=  SELF_PRICE_ NUMERIC(15,2),'
      '1102428=  AMOUNT_ NUMERIC(15,2),'
      
        '1102429=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT *' +
        '/ NUMERIC(15,2),'
      
        '1102430=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */ ' +
        'VARCHAR(150),'
      
