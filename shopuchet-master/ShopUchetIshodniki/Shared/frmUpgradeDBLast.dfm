      '110240600='
      '110240601=      PNT_ = '#39'02'#39';'
      
        '110240602=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
