      '1102016086=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102016087=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1102016088=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1102016089=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1102016090=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1102016091=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      '1102016092=BEGIN'
      '1102016093='
      '1102016094=  IS_THIS_LAST_ = 0;'
      '1102016095='
      '1102016096=  SELECT S.G_TOCHKA,'
      '1102016097=         S.IS_VOZVRAT,'
      '1102016098=         S.G_PAYMENT_TYPE'
      '1102016099=         ,S.is_expected'
      '1102016100=    FROM SKLAD_parent S'
      '1102016101=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1102016102=    INTO :G_TOCHKA_,'
      '1102016103=         :IS_VOZVRAT_,'
      '1102016104=         :G_PAYMENT_TYPE_OLD_'
      '1102016105=         ,:IS_EXPECTED_OLD_;'
      '1102016106='
      '1102016107=  PNT_ = '#39'00'#39';'
      '1102016108=  UPDATE SKLAD_PARENT'
      '1102016109=  SET'
      
        '1102016110=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1102016111=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1102016112=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1102016113=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1102016114=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102016115=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102016116=   SUMM      = :SUMM_,'
      '1102016117=   SUMM_FACT = :SUMM_FACT_,'
      '1102016118=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1102016119=   IS_PAYED_ALL  = CASE WHEN :SUMM_ <= :SUMM_FACT_ TH' +
        'EN 1 ELSE 0 END,  --IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, ' +
        '1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050 +
        #1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102016120=   IS_EXPECTED  = :IS_EXPECTED_'
      '1102016121=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1102016122='
      
        '1102016123=  ---------------------------------------------------' +
        '----------'
      
        '1102016124=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1102016125=  PNT_ = '#39'02'#39';'
      '1102016126=  FOR SELECT SKLAD'
      '1102016127=        FROM SKLAD S'
      '1102016128=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1102016129=         AND NOT EXISTS (SELECT 1'
      '1102016130=                           FROM SKLAD_TMP T'
      '1102016131=                        WHERE T.SKLAD = S.SKLAD)'
      '1102016132=  INTO :SKLAD_'
      '1102016133=  DO BEGIN'
      
        '1102016134=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1102016135=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102016136=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102016137=      EXIT;'
      '1102016138=    END'
      '1102016139=  END'
      '1102016140='
      
        '1102016141=  ---------------------------------------------------' +
        '----------'
      
        '1102016142=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1102016143=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1102016144=  PNT_ = '#39'03'#39';'
      '1102016145=  FOR SELECT S.SKLAD,'
      '1102016146=             S.G_PRODUCT,'
      '1102016147=             S.AMOUNT,'
      '1102016148=             S.PRICE,'
      '1102016149=             S.SUMM,'
      '1102016150=             S.NDS,'
      '1102016151=             S.NDS_SUMM,'
      '1102016152=             T.SKLAD,'
      '1102016153=             T.AMOUNT,'
      '1102016154=             T.IS_LAST,'
      '1102016155=             T.DATE_RECEIPT'
      '1102016156=             ,S.PRICE_CURRENCY'
      '1102016157=             ,S.SUMM_CURRENCY'
      '1102016158=             ,S.PRICE_ROZN'
      
        '1102016159=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1102016160=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1102016161=  INTO :SKLAD_,'
      '1102016162=       :G_PRODUCT_,'
      '1102016163=       :AMOUNT_,'
      '1102016164=       :PRICE_,'
      '1102016165=       :SUMM_ONE_,'
      '1102016166=       :NDS_,'
      '1102016167=       :NDS_SUMM_,'
      '1102016168=       :SKLAD_OLD_,'
      '1102016169=       :AMOUNT_OLD_,'
      '1102016170=       :IS_THIS_LAST_,'
      '1102016171=       :DATE_RECEIPT_OLD_'
      '1102016172=       ,:PRICE_CURRENCY_'
      '1102016173=       ,:SUMM_CURRENCY_TMP_'
      '1102016174=       ,:SALE_PRICE_'
      '1102016175=       ,:SALE_PRICE_CUR_'
      '1102016176=  DO BEGIN'
      
        '1102016177=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102016178=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1102016179=        PNT_ = '#39'04'#39';'
      
        '1102016180=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1102016181=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1102016182=                          ,PRICE_CURRENCY'
      '1102016183=                          ,SUMM_CURRENCY)'
      
        '1102016184=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1102016185=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102016186=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1102016187=               ,:PRICE_CURRENCY_'
      '1102016188=               ,:SUMM_CURRENCY_TMP_'
      '1102016189=               );'
      '1102016190='
      
        '1102016191=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1102016192=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1102016193=            UPDATE LT_SKLAD_PRODUCT L'
      '1102016194=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102016195=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102016196=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102016197=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102016198='
      '1102016199=            IF (ROW_COUNT = 0) THEN'
      
        '1102016200=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102016201=        END'
      '1102016202='
      
        '1102016203=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102016204=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1102016205=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1102016206=        PNT_ = '#39'05'#39';'
      '1102016207=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1102016208=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102016209=              FROM SKLAD SK'
      '1102016210=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102016211=               AND SK.IS_LAST = 1'
      '1102016212=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102016213=              INTO :DATE_LAST_;'
      '1102016214='
      
        '1102016215=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102016216=              UPDATE SKLAD SK'
      '1102016217=                 SET SK.IS_LAST = 0'
      '1102016218=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102016219=                 AND SK.IS_LAST = 1'
      '1102016220=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102016221='
      '1102016222=              UPDATE SKLAD SK'
      '1102016223=                 SET SK.IS_LAST = 1'
      '1102016224=               WHERE SK.SKLAD = :SKLAD_;'
      '1102016225=            END'
      '1102016226=        END'
      
        '1102016227=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102016228=    END ELSE BEGIN'
      '1102016229=        PNT_ = '#39'06'#39';'
      '1102016230=        UPDATE SKLAD S'
      '1102016231=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1102016232=               S.G_CLIENT = :G_CLIENT_,'
      '1102016233=               S.AMOUNT   = :AMOUNT_,'
      '1102016234=               S.PRICE    = :PRICE_,'
      '1102016235=               S.SUMM     = :SUMM_ONE_,'
      '1102016236=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102016237=               S.NDS      = :NDS_,'
      '1102016238=               S.NDS_SUMM = :NDS_SUMM_,'
      '1102016239=               S.OSNOVANIE = :OSNOVANIE_,'
      '1102016240=               S.NOTE      = :NOTE_'
      '1102016241=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1102016242=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1102016243=         WHERE S.SKLAD = :SKLAD_;'
      '1102016244='
      '1102016245=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102016246=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_ AND IS_EX' +
        'PECTED_ = 0) THEN BEGIN'
      '1102016247=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1102016248=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102016249=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_),'
      
        '1102016250=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102016251=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102016252=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102016253='
      '1102016254=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1102016255=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102016256=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_),'
      
        '1102016257=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102016258=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102016259=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102016260=        END'
      
        '1102016261=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1102016262=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1102016263=            UPDATE LT_SKLAD_PRODUCT L'
      '1102016264=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102016265=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102016266=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102016267=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102016268='
      '1102016269=            IF (ROW_COUNT = 0) THEN'
      
        '1102016270=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102016271=        END'
      
        '1102016272=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1102016273=        ELSE IF (IS_EXPECTED_OLD_ = 0 AND IS_EXPECTED' +
        '_ = 1) THEN BEGIN'
      '1102016274=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1102016275=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_,'
      
        '1102016276=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102016277=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102016278=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102016279=        END'
      '1102016280='
      
        '1102016281=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1102016282=        PNT_ = '#39'07'#39';'
      
        '1102016283=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102016284=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102016285=              FROM SKLAD SK'
      '1102016286=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102016287=               AND SK.IS_LAST = 1'
      '1102016288=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102016289=              INTO :DATE_LAST_;'
      '1102016290='
      
        '1102016291=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102016292=              UPDATE SKLAD SK'
      '1102016293=                 SET SK.IS_LAST = 0'
      '1102016294=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102016295=                 AND SK.IS_LAST = 1'
      '1102016296=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102016297='
      '1102016298=              UPDATE SKLAD SK'
      '1102016299=                 SET SK.IS_LAST = 1'
      '1102016300=               WHERE SK.SKLAD = :SKLAD_;'
      '1102016301=            END'
      '1102016302=        END'
      '1102016303='
      
        '1102016304=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1102016305=        PNT_ = '#39'08'#39';'
      
        '1102016306=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102016307=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102016308=              FROM SKLAD SK'
      '1102016309=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102016310=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1102016311=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102016312=               AND SK.is_vozvrat IN (0,4)'
      '1102016313=              INTO :DATE_LAST_;'
      '1102016314='
      
        '1102016315=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102016316=              UPDATE SKLAD SK'
      '1102016317=                 SET SK.IS_LAST = 0'
      '1102016318=               WHERE SK.SKLAD = :SKLAD_;'
      '1102016319='
      '1102016320=               UPDATE SKLAD SK'
      '1102016321=                 SET SK.IS_LAST = 1'
      '1102016322=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102016323=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1102016324=                                   FROM SKLAD SS'
      
        '1102016325=                                  WHERE SS.G_PRODUCT ' +
        '= SK.G_PRODUCT'
      
        '1102016326=                                    AND SS.DATE_RECEI' +
        'PT = :DATE_LAST_'
      
        '1102016327=                                    AND SS.G_TOCHKA =' +
        ' :G_TOCHKA_'
      
        '1102016328=                                    AND SS.is_vozvrat' +
        ' IN (0,4));'
      '1102016329='
      '1102016330=            END'
      
        '1102016331=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054 +
        #1052' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' ' +
        #1053#1048#1052'.'
      
        '1102016332=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059 +
        #1044#1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '1102016333=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THI' +
        'S_LAST_ = 1)) THEN BEGIN'
      '1102016334=              UPDATE SKLAD SK'
      '1102016335=                 SET SK.IS_LAST = 1'
      '1102016336=               WHERE SK.SKLAD = :SKLAD_;'
      '1102016337=            END'
      '1102016338=        END'
      '1102016339=    END'
      '1102016340='
      
        '1102016341=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '1102016342=      UPDATE G_PRODUCT G'
      '1102016343=         SET G.PRICE = :SALE_PRICE_'
      '1102016344=       WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102016345=  END'
      '1102016346='
      
