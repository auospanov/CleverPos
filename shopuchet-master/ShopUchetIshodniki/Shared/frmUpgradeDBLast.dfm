      '1108069='
      '1108070=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      
        '1108071=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      
        '1108072=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT */ BIGINT,'
      
        '1108073=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT,'
      '1108074=  DATE_BEGIN_ DATE,'
      '1108075=  DATE_END_ DATE,'
      '1108076=  TIME_BEGIN_ TIME,'
      '1108077=  TIME_END_ TIME,'
      '1108078=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1108079=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1108080=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1108081=RETURNS ('
      
        '1108082=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUMER' +
        'IC(18,5),'
      
        '1108083=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERIC' +
        '(15,2),'
      
        '1108084=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(1' +
        '5,2),'
      
        '1108085=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE */ NUMERIC(15,2),'
      
        '1108086=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM */ NUMERIC(15,2),'
      
        '1108087=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHAR' +
        '(250),'
      
        '1108088=  PAYMENT_NAME /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME */ ' +
        'VARCHAR(256),'
      
        '1108089=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR' +
        '(250),'
      
        '1108090=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1108091=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '1108092=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      '1108093=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '1108094=  Z_DATE BLOB SUB_TYPE 1,'
      '1108095=  ROW INTEGER,'
      '1108096=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '1108097=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50)' +
        ','
      '1108098=  ERR_CODE INTEGER,'
      '1108099=  ERR_MSG VARCHAR(1024))'
      '11080100=AS'
      '11080101=BEGIN'
      '11080102=  SUSPEND;'
      '11080103=END'
      '11080104=;'
      '11080105='
      '11080106='
      
        '11080107=/******************************************************' +
        '************************/'
      
        '11080108=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11080109=/******************************************************' +
        '************************/'
      '11080110=ALTER PROCEDURE G_READ_G_DISCOUNT_LIST('
      '11080111=  IS_ALL_ INTEGER)'
      '11080112=RETURNS ('
      '11080113=  G_DISCOUNT TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11080114=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11080115=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11080116=  G_PRODUCT_PAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11080117=  DATE_BEGIN DATE,'
      '11080118=  DATE_END DATE,'
      '11080119=  NAME VARCHAR(1024),'
      '11080120=  PRICE NUMERIC(15,2),'
      '11080121=  SKIDKA_PROC NUMERIC(15,2),'
      '11080122=  SKIDKA_SUM NUMERIC(15,2),'
      '11080123=  IS_CONST INTEGER,'
      '11080124=  TOCHKA_NAME TYPE OF COLUMN G_TOCHKA.NAME)'
      '11080125=AS'
      '11080126=begin'
      '11080127=    FOR'
      '11080128=      SELECT GD.G_DISCOUNT, GD.G_PRODUCT, GP.NAME,'
      '11080129=             GD.DATE_BEGIN,'
      '11080130=             GD.DATE_END,'
      
        '11080131=             CASE WHEN GD.DATE_END IS NULL THEN 1 ELSE ' +
        '0 END IS_CONST,'
      
        '11080132=             GD.NAME, GD.PRICE, GD.SKIDKA_PROC, GD.SKID' +
        'KA_SUM,'
      
        '11080133=             CASE WHEN GD.G_TOCHKA IS NULL THEN '#39#1042#1089#1077' '#1090#1086 +
        #1095#1082#1080#39' ELSE T.NAME END'
      '11080134=             ,PAR.NAME'
      
        '11080135=      FROM G_DISCOUNT GD LEFT OUTER JOIN G_TOCHKA T ON ' +
        'GD.G_TOCHKA = T.G_TOCHKA,'
      '11080136=           G_PRODUCT GP,'
      '11080137=           G_PRODUCT PAR'
      '11080138=      WHERE GD.G_PRODUCT = GP.G_PRODUCT'
      '11080139=        AND GP.G_PRODUCT_PAR = PAR.G_PRODUCT'
      '11080140=        AND ('
      '11080141=             (('
      '11080142=                ('
      
        '11080143=                  /*GD.DATE_BEGIN <= CURRENT_DATE      ' +
        ' -- '#1042#1067#1043#1056#1059#1046#1040#1070#1058#1057#1071' '#1057' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1052' '#1055#1045#1056#1048#1054#1044#1054#1052
      '11080144=                  AND'
      '11080145=                  */GD.DATE_END >= CURRENT_DATE'
      '11080146=                  AND GD.DATE_BEGIN IS NOT NULL'
      '11080147=                  AND GD.DATE_END IS NOT NULL'
      '11080148=                )'
      '11080149=              OR'
      '11080150=                ('
      
        '11080151=                 GD.DATE_BEGIN IS NULL AND GD.DATE_END ' +
        'IS NULL  -- '#1040' '#1058#1040#1050#1046#1045' '#1055#1054#1057#1058#1054#1071#1053#1053#1067#1045' '#1057#1050#1048#1044#1050#1048
      '11080152=                )'
      '11080153=              )'
      '11080154=              AND :IS_ALL_ = 1)'
      '11080155=             OR'
      
        '11080156=             (:IS_ALL_ = 0)                            ' +
        '         -- '#1051#1048#1041#1054' '#1042#1057#1045
      '11080157=            )'
      
        '11080158=      INTO :G_DISCOUNT, :G_PRODUCT, :G_PRODUCT_NAME, :D' +
        'ATE_BEGIN, :DATE_END, :IS_CONST, :NAME, :PRICE, :SKIDKA_PROC, :S' +
        'KIDKA_SUM,'
      '11080159=           :TOCHKA_NAME'
      '11080160=           ,:G_PRODUCT_PAR_NAME'
      '11080161=    DO'
      '11080162=      SUSPEND;'
      '11080163=end'
      '11080164=;'
      '11080165='
      '11080166=ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      '11080167=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11080168=  CURRENCY_ INTEGER)'
      '11080169=RETURNS ('
      '11080170=  NUMBER_STR_ VARCHAR(200),'
      '11080171=  ROW_NUM INTEGER,'
      '11080172=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11080173=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11080174=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11080175=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11080176=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11080177=  AMOUNT MY_NUMERIC_5,'
      '11080178=  PRICE_N VARCHAR(50),'
      '11080179=  SUMM_N VARCHAR(50),'
      '11080180=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '11080181=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '11080182=  SUMM_VSEGO_ VARCHAR(50),'
      '11080183=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11080184=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11080185=  SUMM_STR_ VARCHAR(500),'
      '11080186=  ERR_CODE NUMERIC(15,2),'
      '11080187=  ERR_MSG VARCHAR(1024))'
      '11080188=AS'
      '11080189=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '11080190=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD_W' +
        'AYBILL'#39';'
      '11080191=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11080192=DECLARE VARIABLE I INTEGER = 1;'
      
        '11080193=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11080194=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      '11080195=BEGIN'
      '11080196='
      
        '11080197=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.sklad||'#39' '#1086#1090' '#39'||lpad(EXTRACT(D' +
        'AY FROM P.date_receipt), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P' +
        '.date_receipt), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.date_receipt),'
      '11080198=         G.name,'
      '11080199=         P.IS_VOZVRAT'
      
        '11080200=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON P' +
        '.g_client = G.G_CLIENT'
      '11080201=   WHERE P.sklad = :sklad_parent_'
      '11080202=    INTO :NUMBER_STR_,'
      '11080203=         :POSTAVSHIK_NAME_,'
      '11080204=         :IS_VOZVRAT_;'
      '11080205='
      
        '11080206=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058#1068' ' +
        #1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      '11080207=  IF (IS_VOZVRAT_ = 3) THEN'
      '11080208=    SELECT G.NAME'
      '11080209=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '11080210=     WHERE P.SKLAD = :sklad_parent_'
      '11080211=       AND P.G_TOCHKA = G.G_TOCHKA'
      '11080212=      INTO :POSTAVSHIK_NAME_;'
      '11080213='
      
        '11080214=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '11080215=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39')'
      
        '11080216=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ)' +
        ', :CURRENCY_))'
      '11080217=    FROM SKLAD S'
      '11080218=   WHERE S.sklad_parent = :sklad_parent_'
      '11080219=   GROUP BY S.sklad_parent'
      '11080220=    INTO :AMOUNT_VSEGO_,'
      '11080221=         :SUMM_VSEGO_,'
      '11080222=         :summ_str_;'
      '11080223='
      '11080224=  SELECT NAME'
      '11080225=    FROM CUR_PARAMS'
      '11080226=   WHERE CUR_PARAMS = 1'
      '11080227=    INTO :G_OFFICIAL_FM_;'
      '11080228='
      '11080229=  FOR SELECT :I,'
      '11080230=             G.name,'
      '11080231=             G.ARTICUL,'
      '11080232=             G.BARCODE,'
      '11080233=             G.NOMENCLATUR_NUM,'
      '11080234=             U.short_name,'
      
        '11080235=             S.amount,    --REPLACE(CAST(S.amount AS VA' +
        'RCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '11080236=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.'#39',' +
        ' '#39','#39'),'
      
        '11080237=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39', ' +
        #39','#39'),'
      '11080238=             G.PRICE'
      '11080239=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '11080240=       WHERE S.sklad_parent = :sklad_parent_'
      '11080241=         AND S.g_product = G.g_product'
      '11080242=         AND G.g_unit = U.g_unit'
      '11080243=        INTO :ROW_NUM,'
      '11080244=            :NAME,'
      '11080245=            :ARTICUL,'
      '11080246=            :BARCODE,'
      '11080247=            :NOMENCLATUR_NUM,'
      '11080248=            :SHORT_NAME,'
      '11080249=            :AMOUNT,'
      '11080250=            :PRICE_N,'
      '11080251=            :SUMM_N,'
      '11080252=            :PRICE'
      '11080253=  DO BEGIN'
      '11080254=    I = I + 1;'
      '11080255=    SUSPEND;'
      '11080256=  END'
      '11080257=WHEN ANY DO BEGIN'
      '11080258=    Err_code = -20500;'
      
        '11080259=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11080260=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11080261=  END'
      '11080262=end'
      '11080263=;'
      '11080264='
      '11080265=ALTER PROCEDURE P_REP_PRODAZHA_WAYBILL('
      '11080266=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11080267=  CURRENCY_ INTEGER)'
      '11080268=RETURNS ('
      '11080269=  NUMBER_STR_ VARCHAR(200),'
      '11080270=  ROW_NUM INTEGER,'
      '11080271=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11080272=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11080273=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11080274=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11080275=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11080276=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11080277=  AMOUNT MY_NUMERIC_5,'
      '11080278=  PRICE_N VARCHAR(50),'
      '11080279=  SUMM_N VARCHAR(50),'
      '11080280=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '11080281=  SUMM_VSEGO_ VARCHAR(50),'
      '11080282=  NDS_SUMM_ VARCHAR(50),'
      '11080283=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11080284=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11080285=  SUMM_STR_ VARCHAR(500),'
      '11080286=  NDS_SUMM_STR_ VARCHAR(500),'
      '11080287=  ERR_CODE NUMERIC(15,2),'
      '11080288=  ERR_MSG VARCHAR(1024))'
      '11080289=AS'
      '11080290=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '11080291=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRODAZHA' +
        '_WAYBILL'#39';'
      '11080292=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11080293=DECLARE VARIABLE I INTEGER = 1;'
      
        '11080294=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11080295=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS_' +
        'SUMM;'
      '11080296=BEGIN'
      '11080297='
      
        '11080298=  SELECT decode(P.is_spisanie, 1, '#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39', '#39#1053#1072#1082#1083#1072#1076#1085 +
        #1072#1103' '#8470#39'||P.ZAKAZ)||'#39' '#1086#1090' '#39'||lpad(EXTRACT(DAY FROM P.z_date), 2, '#39'0'#39 +
        ')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39'.'#39'||EXTRACT(Y' +
        'EAR FROM P.z_date),'
      '11080299=         G.name'
      '11080300=    FROM ZAKAZ P,'
      '11080301=         G_CLIENT G'
      '11080302=   WHERE P.ZAKAZ = :ZAKAZ_'
      '11080303=     AND P.g_client = G.G_CLIENT'
      '11080304=    INTO :NUMBER_STR_,'
      '11080305=         :CLIENT_NAME_;'
      '11080306='
      
        '11080307=  SELECT SUM(S.amount)--REPLACE(CAST(SUM(S.amount) AS V' +
        'ARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '11080308=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39')'
      
        '11080309=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ)' +
        ', :CURRENCY_))'
      
        '11080310=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(50)),' +
        ' '#39'.'#39', '#39','#39')'
      '11080311=         ,SUM(S.nds_summ)'
      '11080312=    FROM ZAKAZ_DETAILS S'
      '11080313=   WHERE S.ZAKAZ = :ZAKAZ_'
      '11080314=   GROUP BY S.ZAKAZ'
      '11080315=    INTO :AMOUNT_VSEGO_,'
      '11080316=         :SUMM_VSEGO_,'
      '11080317=         :summ_str_,'
      '11080318=         :NDS_SUMM_,'
      '11080319=         :NDS_;'
      '11080320='
      '11080321=  if (NDS_ > 0) then'
      
        '11080322=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENCYS' +
        'TR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '11080323='
      '11080324=  SELECT NAME'
      '11080325=    FROM CUR_PARAMS'
      '11080326=   WHERE CUR_PARAMS = 1'
      '11080327=    INTO :G_OFFICIAL_FM_;'
      '11080328='
      '11080329=  FOR SELECT :I,'
      '11080330=             C.NAME,'
      '11080331=             G.name,'
      '11080332=             G.ARTICUL,'
      '11080333=             G.BARCODE,'
      '11080334=             G.NOMENCLATUR_NUM,'
      '11080335=             U.short_name,'
      
        '11080336=             S.amount,--REPLACE(CAST(S.amount AS VARCHA' +
        'R(10)), '#39'.'#39', '#39','#39'),'
      
        '11080337=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.'#39',' +
        ' '#39','#39'),'
      
        '11080338=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39', ' +
        #39','#39')'
      
        '11080339=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, G_' +
        'PRODUCT C'
      '11080340=       WHERE S.ZAKAZ = :ZAKAZ_'
      '11080341=         AND S.g_product = G.g_product'
      '11080342=         AND G.g_unit = U.g_unit'
      '11080343=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '11080344=        INTO :ROW_NUM,'
      '11080345=            :CATEGORY_NAME,'
      '11080346=            :NAME,'
      '11080347=            :ARTICUL,'
      '11080348=            :BARCODE,'
      '11080349=            :NOMENCLATUR_NUM,'
      '11080350=            :SHORT_NAME,'
      '11080351=            :AMOUNT,'
      '11080352=            :PRICE_N,'
      '11080353=            :SUMM_N'
      '11080354=  DO BEGIN'
      '11080355=    I = I + 1;'
      '11080356=    SUSPEND;'
      '11080357=  END'
      '11080358=WHEN ANY DO BEGIN'
      '11080359=    Err_code = -20500;'
      
        '11080360=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11080361=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11080362=  END'
      '11080363=end'
      '11080364=;'
      '11080365='
      '11080366=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '11080367=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11080368=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARENT' +
        ','
      '11080369=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11080370=  DATE_BEGIN_ DATE,'
      '11080371=  DATE_END_ DATE,'
      '11080372=  TIME_BEGIN_ TIME,'
      '11080373=  TIME_END_ TIME,'
      '11080374=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11080375=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11080376=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11080377=RETURNS ('
      '11080378=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11080379=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11080380=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '11080381=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'TENGE,'
      
        '11080382=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_S' +
        'UMM,'
      '11080383=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11080384=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '11080385=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11080386=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11080387=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11080388=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11080389=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11080390=  Z_DATE BLOB SUB_TYPE 1,'
      '11080391=  ROW INTEGER,'
      '11080392=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '11080393=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11080394=  ERR_CODE INTEGER,'
      '11080395=  ERR_MSG VARCHAR(1024))'
      '11080396=AS'
      
        '11080397=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_L' +
        'IST'#39';'
      '11080398=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11080399=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '11080400=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE 8' +
        '0;'
      
        '11080401=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTI' +
        'CUL;'
      
        '11080402=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BARC' +
        'ODE;'
      
        '11080403=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PROD' +
        'UCT.BARCODE;'
      
        '11080404=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '11080405=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11080406=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.NAME;'
      
        '11080407=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.N' +
        'AME;'
      
        '11080408=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '11080409=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M = 0;'
      
        '11080410=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11080411=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '11080412=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11080413=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM = 0;'
      
        '11080414=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11080415=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '11080416=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '11080417=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.P' +
        'ATH = '#39#39';'
      '11080418=DECLARE VARIABLE I INTEGER = 1;'
      '11080419=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      '11080420=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAME;'
      '11080421=BEGIN'
      '11080422=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '11080423=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '11080424='
      
        '11080425=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') || ' +
        #39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extrac' +
        't(year from Z.Z_DATE),'
      '11080426=             Z.Z_TIME,'
      '11080427=             GP.ARTICUL,'
      '11080428=             GP.BARCODE,'
      '11080429=             GP.NOMENCLATUR_NUM,'
      '11080430=             GP.NAME,'
      '11080431=             ZD.AMOUNT,'
      '11080432=             ZD.PRICE,'
      '11080433=             ZD.DISCOUNT_TENGE,'
      '11080434=             ZD.SUMM,'
      '11080435=             ZD.DISCOUNT_SUMM,'
      '11080436=             GC.NAME,'
      '11080437=             P.NAME,'
      '11080438=             TR.PATH,'
      '11080439=             Z.NOTE,'
      '11080440=             U.SHORT_NAME'
      '11080441=      FROM ZAKAZ Z,'
      '11080442=           ZAKAZ_DETAILS ZD,'
      '11080443=           G_CLIENT GC,'
      '11080444=           G_PAYMENT_TYPE P,'
      '11080445=           G_PRODUCT GP,'
      '11080446=           G_UNIT U,'
      '11080447=           P_REP_TREE TR'
      
        '11080448=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '11080449=       AND Z.IS_SPISANIE IN (0,2)'
      '11080450=       AND Z.IS_RESERVE = 0'
      '11080451=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11080452=       AND Z.G_CLIENT = GC.G_CLIENT'
      '11080453=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11080454=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11080455=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '11080456=       AND GP.G_UNIT = U.G_UNIT'
      '11080457=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11080458=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(Z' +
        '.G_CLIENT, 1))'
      
        '11080459=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT_' +
        ', GC.G_CLIENT_PARENT)'
      
        '11080460=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '11080461=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_ AND :TIME_BEGIN_ IS NULL)'
      '11080462=            OR'
      
        '11080463=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGIN' +
        '_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN_' +
        ' IS NOT NULL)'
      '11080464=           )/*'
      
        '11080465=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_EN' +
        'D_ AND :TIME_BEGIN_ IS NOT NULL)'
      '11080466=            OR'
      '11080467=            :TIME_BEGIN_ IS NULL)*/'
      
        '11080468=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11080469=             OR'
      '11080470=             (:G_CATEGORY_ IS NULL)'
      '11080471=           )'
      
        '11080472=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT||' +
        #39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11080473=             OR'
      '11080474=            (:G_PRODUCT_ IS NULL)'
      '11080475=           )'
      '11080476=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '11080477=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :NO' +
        'MENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '11080478=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, :C' +
        'LIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_'
      '11080479=  DO BEGIN'
      '11080480=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '11080481=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11080482=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11080483=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "D' +
        'ATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '11080484=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_,' +
        ' :DISCOUNT_SUMM_ROLL_, 1);'
      '11080485='
      '11080486=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11080487=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11080488=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + D' +
        'ISCOUNT_SUMM_ROLL_;'
      '11080489=            SUMM_ROLL_ = 0;'
      '11080490=            DISCOUNT_SUMM_ROLL_ = 0;'
      '11080491=            I = I + 1;'
      '11080492=        END'
      '11080493='
      '11080494=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11080495=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE"' +
        ', ROW)'
      '11080496=        VALUES (:I, :PATH_, 1);'
      '11080497=        I = I + 1;'
      '11080498=    END'
      '11080499='
      
        '11080500=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "T' +
        'IME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, DI' +
        'SCOUNT, SUMM,'
      
        '11080501=                                         DISCOUNT_SUMM,' +
        ' CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME)'
      
        '11080502=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE' +
        '_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT' +
        '_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '11080503=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0, :' +
        'UNIT_NAME_);'
      '11080504='
      '11080505=    I = I + 1;'
      '11080506=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '11080507=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOUN' +
        'T_SUMM_;'
      '11080508=    LAST_PATH_ = PATH_;'
      '11080509=  END'
      '11080510='
      '11080511=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11080512=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11080513=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOUNT' +
        '_SUMM_ROLL_, 1);'
      '11080514='
      '11080515=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11080516=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11080517=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_SU' +
        'MM_ROLL_;'
      '11080518='
      
        '11080519=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11080520=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL_,' +
        ' 2);'
      '11080521='
      
        '11080522=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCLA' +
        'TUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CLI' +
        'ENT_NAME,'
      '11080523=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME'
      '11080524=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '11080525=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOMEN' +
        'CLATUR_NUM, :TOVAR_NAME,'
      
        '11080526=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :DI' +
        'SCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      '11080527=           :NOTE, :UNIT_NAME'
      '11080528=  do suspend;'
      '11080529='
      '11080530=WHEN ANY DO BEGIN'
      '11080531=    Err_code = -20500;'
      
        '11080532=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11080533=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11080534=  END'
      '11080535=end'
      '11080536=;'
      
        '11080537=UPDATE SYSTEM_SETUP SET S_VALUE = 11080 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11080538=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11080539=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110810=CREATE PROCEDURE P_REP_OSTATOK_TOVAROV('
      '110811=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110812=  INCLUDE_NOL_ INTEGER,'
      '110813=  INCLUDE_FEW_ INTEGER,'
      '110814=  SORT_BY_NAME_ INTEGER,'
      
        '110815=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGINT' +
        ','
      '110816=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110817=RETURNS ('
      '110818=  PERIOD_ VARCHAR(40),'
      '110819=  ROW_NUM VARCHAR(15),'
      '1108110=  ARTICUL VARCHAR(1000),'
      '1108111=  BARCODE VARCHAR(30),'
      
        '1108112=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      '1108113=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1108114=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50)' +
        ','
      
        '1108115=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15,' +
        '2),'
      
        '1108116=  VOLUME_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE ' +
        '*/ NUMERIC(15,2),'
      
        '1108117=  AMOUNT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT */ NU' +
        'MERIC(18,5),'
      
        '1108118=  AMOUNT_RESERVE /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE */ NUMERIC(18,5),'
      '1108119=  SUMM /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2),'
      
        '1108120=  PRICE_SELF /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(15' +
        ',2),'
      
        '1108121=  SUMM_SELF /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2' +
        '),'
      '1108122=  TOVAR_NAME VARCHAR(250),'
      
        '1108123=  CROSSCODE /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ BLO' +
        'B SUB_TYPE 1 SEGMENT SIZE 16384,'
      '1108124=  NOTE /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300),'
      
        '1108125=  IS_CATEGORY /* TYPE OF COLUMN G_PRODUCT.IS_CATEGORY */' +
        ' INTEGER,'
      '1108126=  ERR_CODE INTEGER,'
      '1108127=  ERR_MSG VARCHAR(1024))'
      '1108128=AS'
      '1108129=BEGIN'
      '1108130=  SUSPEND;'
      '1108131=END'
      '1108132=;'
      '1108133='
      '1108134='
      
        '1108135=/*******************************************************' +
        '***********************/'
      
        '1108136=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1108137=/*******************************************************' +
        '***********************/'
      '1108138=ALTER PROCEDURE G_READ_G_DISCOUNT_LIST('
      '1108139=  IS_ALL_ INTEGER)'
      '1108140=RETURNS ('
      '1108141=  G_DISCOUNT TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '1108142=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1108143=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1108144=  G_PRODUCT_PAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1108145=  DATE_BEGIN DATE,'
      '1108146=  DATE_END DATE,'
      '1108147=  NAME VARCHAR(1024),'
      '1108148=  PRICE NUMERIC(15,2),'
      '1108149=  SKIDKA_PROC NUMERIC(15,2),'
      '1108150=  SKIDKA_SUM NUMERIC(15,2),'
      '1108151=  IS_CONST INTEGER,'
      '1108152=  TOCHKA_NAME TYPE OF COLUMN G_TOCHKA.NAME)'
      '1108153=AS'
      '1108154=BEGIN'
      '1108155='
      '1108156=    FOR'
      '1108157=      SELECT GD.G_DISCOUNT, GD.G_PRODUCT, GP.NAME,'
      '1108158=             GD.DATE_BEGIN,'
      '1108159=             GD.DATE_END,'
      
        '1108160=             CASE WHEN GD.DATE_END IS NULL THEN 1 ELSE 0' +
        ' END IS_CONST,'
      
        '1108161=             GD.NAME, GD.PRICE, GD.SKIDKA_PROC, GD.SKIDK' +
        'A_SUM,'
      
        '1108162=             CASE WHEN GD.G_TOCHKA IS NULL THEN '#39#1042#1089#1077' '#1090#1086#1095 +
        #1082#1080#39' ELSE T.NAME END'
      '1108163=             ,PAR.NAME'
      
        '1108164=      FROM G_DISCOUNT GD LEFT OUTER JOIN G_TOCHKA T ON G' +
        'D.G_TOCHKA = T.G_TOCHKA,'
      '1108165=           G_PRODUCT GP,'
      '1108166=           G_PRODUCT PAR'
      
        '1108167=      WHERE GD.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHE' +
        'RE CUR_PARAMS = 2)'
      '1108168=        AND GD.G_PRODUCT = GP.G_PRODUCT'
      '1108169=        AND GP.G_PRODUCT_PAR = PAR.G_PRODUCT'
      '1108170=        AND ('
      '1108171=             (('
      '1108172=                ('
      
        '1108173=                  /*GD.DATE_BEGIN <= CURRENT_DATE       ' +
        '-- '#1042#1067#1043#1056#1059#1046#1040#1070#1058#1057#1071' '#1057' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1052' '#1055#1045#1056#1048#1054#1044#1054#1052
      '1108174=                  AND'
      '1108175=                  */GD.DATE_END >= CURRENT_DATE'
      '1108176=                  AND GD.DATE_BEGIN IS NOT NULL'
      '1108177=                  AND GD.DATE_END IS NOT NULL'
      '1108178=                )'
      '1108179=              OR'
      '1108180=                ('
      
        '1108181=                 GD.DATE_BEGIN IS NULL AND GD.DATE_END I' +
        'S NULL  -- '#1040' '#1058#1040#1050#1046#1045' '#1055#1054#1057#1058#1054#1071#1053#1053#1067#1045' '#1057#1050#1048#1044#1050#1048
      '1108182=                )'
      '1108183=              )'
      '1108184=              AND :IS_ALL_ = 1)'
      '1108185=             OR'
      
        '1108186=             (:IS_ALL_ = 0)                             ' +
        '        -- '#1051#1048#1041#1054' '#1042#1057#1045
      '1108187=            )'
      
        '1108188=      INTO :G_DISCOUNT, :G_PRODUCT, :G_PRODUCT_NAME, :DA' +
        'TE_BEGIN, :DATE_END, :IS_CONST, :NAME, :PRICE, :SKIDKA_PROC, :SK' +
        'IDKA_SUM,'
      '1108189=           :TOCHKA_NAME'
      '1108190=           ,:G_PRODUCT_PAR_NAME'
      '1108191=    DO'
      '1108192=      SUSPEND;'
      '1108193=end'
      '1108194=;'
      '1108195='
      '1108196=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1108197=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1108198=  INCLUDE_NOL_ INTEGER,'
      '1108199=  INCLUDE_FEW_ INTEGER,'
      '11081100=  SORT_BY_NAME_ INTEGER,'
      '11081101=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11081102=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '11081103=RETURNS ('
      '11081104=  PERIOD_ VARCHAR(40),'
      '11081105=  ROW_NUM VARCHAR(15),'
      '11081106=  ARTICUL VARCHAR(1000),'
      '11081107=  BARCODE VARCHAR(30),'
      
        '11081108=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11081109=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11081110=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11081111=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11081112=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11081113=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '11081114=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        '_RESERVE,'
      '11081115=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '11081116=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '11081117=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '11081118=  TOVAR_NAME VARCHAR(250),'
      '11081119=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11081120=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11081121=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '11081122=  ERR_CODE INTEGER,'
      '11081123=  ERR_MSG VARCHAR(1024))'
      '11081124=AS'
      
        '11081125=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_LI' +
        'ST'#39';'
      '11081126=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11081127=DECLARE VARIABLE I INTEGER = 1;'
      '11081128=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11081129=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11081130=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11081131=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11081132=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11081133=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11081134=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11081135=BEGIN'
      '11081136='
      
        '11081137=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11081138=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11081139='
      '11081140=  SELECT S.S_VALUE'
      '11081141=    FROM SYSTEM_SETUP S'
      '11081142=   WHERE S.SYSTEM_SETUP = 1'
      '11081143=    INTO :FORMULA_;'
      '11081144='
      '11081145=  FOR SELECT GP.PATH,'
      '11081146=             GP.G_PRODUCT'
      '11081147=        FROM P_REP_TREE GP'
      '11081148=       WHERE EXISTS (SELECT 1'
      '11081149=                       FROM G_PRODUCT'
      '11081150=                      WHERE IS_CATEGORY = 0'
      
        '11081151=                        AND G_PRODUCT_PAR = GP.G_PRODUC' +
        'T'
      '11081152=                    )'
      
        '11081153=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11081154=              OR'
      '11081155=              (:G_CATEGORY_ is NULL)'
      '11081156=             )'
      '11081157=       ORDER BY 1, 2'
      '11081158=       INTO :PATH_NAME_,'
      '11081159=            :G_PRODUCT_'
      '11081160=  DO BEGIN'
      
        '11081161=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057 +
        ' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054
      
        '11081162=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068 +
        ' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '11081163=      SELECT COUNT(G.G_PRODUCT)'
      
        '11081164=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL' +
        '.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11081165=                                          WHERE :G_TOCH' +
        'KA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT) ' +
        'L ON G.G_PRODUCT = L.G_PRODUCT'
      '11081166=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11081167=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11081168=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (CO' +
        'ALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11081169=              OR'
      
        '11081170=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_' +
        ', 0) = 1)'
      '11081171=              or'
      
        '11081172=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_' +
        ', 0) = 1))'
      '11081173=             )'
      '11081174=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11081175=         AND ((EXISTS (SELECT 1'
      '11081176=                       FROM SKLAD S'
      '11081177=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '11081178=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '11081179=                        AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11081180=              OR'
      '11081181=              COALESCE(:G_CLIENT_, 0) = 0)'
      '11081182=        INTO :CNT_;'
      '11081183='
      '11081184=      IF (CNT_ > 0) THEN BEGIN'
      
        '11081185=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE' +
        '_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '11081186=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), ' +
        ':PATH_NAME_, 1);'
      '11081187='
      
        '11081188=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE,'
      '11081189=                                              ARTICUL,'
      '11081190=                                              BARCODE,'
      
        '11081191=                                              NOMENCLAT' +
        'UR_NUM,'
      '11081192=                                              NAME,'
      
        '11081193=                                              UNIT_NAME' +
        ','
      '11081194=                                              PRICE,'
      
        '11081195=                                              VOLUME_PR' +
        'ICE,'
      '11081196=                                              AMOUNT,'
      
        '11081197=                                              AMOUNT_RE' +
        'SERVE,'
      '11081198=                                              SUMM,'
      
        '11081199=                                              PRICE_SEL' +
        'F,'
      '11081200=                                              SORT_COL,'
      
        '11081201=                                              IS_CATEGO' +
        'RY,'
      '11081202=                                              NOTE,'
      
        '11081203=                                              CROSSCODE' +
        ')'
      '11081204=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),'
      '11081205=                 G.ARTICUL,'
      '11081206=                 G.BARCODE,'
      '11081207=                 G.NOMENCLATUR_NUM,'
      '11081208=                 G.NAME,'
      '11081209=                 U.SHORT_NAME,'
      '11081210=                 G.PRICE,'
      '11081211=                 G.VOLUME_PRICE,'
      '11081212=                 COALESCE(S.AMOUNT, 0),'
      '11081213=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      '11081214=                 COALESCE(S.AMOUNT, 0) * G.PRICE,'
      '11081215=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '11081216=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1053 +
        #1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '11081217=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 '#1047 +
        #1040#1050#1059#1055#1054#1050
      '11081218=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '11081219=                  DECODE(:FORMULA_,'
      '11081220=                         0,'
      
        '11081221=                         (SELECT ROUND(SUM(T.AMOUNT * T' +
        '.PRICE)/SUM(T.AMOUNT), 2)'
      
        '11081222=                            FROM (SELECT S.AMOUNT, S.PR' +
        'ICE'
      
        '11081223=                                    FROM SKLAD_PARENT S' +
        'P,'
      '11081224=                                         SKLAD S'
      
        '11081225=                                   WHERE :G_TOCHKA_ARR_' +
        ' CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '11081226=                                     AND SP.DATE_RECEIP' +
        'T <= CURRENT_DATE'
      
        '11081227=                                     AND SP.SKLAD = S.S' +
        'KLAD_PARENT'
      
        '11081228=                                     AND S.G_PRODUCT = ' +
        'G.G_PRODUCT'
      
        '11081229=                                     AND SP.IS_VOZVRAT ' +
        'IN (0, 3, 4)'
      
        '11081230=                                    ORDER BY S.DATE_REC' +
        'EIPT DESC ROWS 1 TO 5) T),'
      '11081231=                         1,'
      '11081232=                         (SELECT S.PRICE'
      '11081233=                            FROM SKLAD S'
      
        '11081234=                           WHERE S.SKLAD = (SELECT MAX(' +
        'SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST ' +
        '= 1'
      
        '11081235=                                              FROM SKLA' +
        'D SS'
      
        '11081236=                                             WHERE :G_T' +
        'OCHKA_ARR_ CONTAINING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39
      
        '11081237=                                               AND SS.G' +
        '_PRODUCT = G.G_PRODUCT'
      
        '11081238=                                               AND SS.I' +
        'S_LAST = 1)'
      '11081239=                         ))), 0) spr,'
      
        '11081240=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, 1' +
        ', G.NAME),'
      '11081241=                 0'
      '11081242=                 ,G.NOTE'
      
        '11081243=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSSC' +
        'ODE'
      
        '11081244=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U O' +
        'N G.G_UNIT = U.G_UNIT'
      
        '11081245=                             LEFT OUTER JOIN (SELECT SU' +
        'M(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.G' +
        '_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11081246=                                              WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODU' +
        'CT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '11081247=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11081248=             AND G.IS_CATEGORY = 0'
      '11081249=             AND G.is_active = 1'
      '11081250=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11081251=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND' +
        ' (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11081252=                  OR'
      
        '11081253=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE_' +
        'NOL_, 0) = 1)'
      '11081254=                  or'
      
        '11081255=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE_' +
        'FEW_, 0) = 1))'
      '11081256=                 )'
      '11081257=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11081258=             AND ((EXISTS (SELECT 1'
      '11081259=                           FROM SKLAD S'
      '11081260=                          WHERE S.G_CLIENT = :G_CLIENT_'
      
        '11081261=                            AND S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11081262=                            AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11081263=                  OR'
      '11081264=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '11081265=           ORDER BY 13;'
      '11081266=      END'
      '11081267=  END'
      '11081268='
      
        '11081269=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_D' +
        'ATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0)' +
        '||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '11081270='
      
        '11081271=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CRO' +
        'SSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AMOU' +
        'NT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '11081272=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '11081273=      FROM P_REP_PRICE_LIST_TABLE'
      
        '11081274=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_N' +
        'UM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE, ' +
        ':AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_CA' +
        'TEGORY, :TOVAR_NAME'
      '11081275=  DO BEGIN'
      '11081276=    I = I + 1;'
      '11081277=    SUSPEND;'
      '11081278=  END'
      '11081279=WHEN ANY DO BEGIN'
      '11081280=    Err_code = -20500;'
      
        '11081281=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11081282=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11081283=  END'
      '11081284=end'
      '11081285=;'
      
        '11081286=UPDATE SYSTEM_SETUP SET S_VALUE = 11081 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11081287=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11081288=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110820=CREATE GENERATOR GEN_REVISION;'
      '110821=SET GENERATOR GEN_REVISION TO 10022;'
      '110822='
      
        '110823=/********************************************************' +
        '**********************/'
      
        '110824=/****                      Altering stored procedures    ' +
        '                  ****/'
      
        '110825=/********************************************************' +
        '**********************/'
      '110826='
      '110827=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '110828=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110829=  INCLUDE_NOL_ INTEGER,'
      '1108210=  INCLUDE_FEW_ INTEGER,'
      '1108211=  SORT_BY_NAME_ INTEGER,'
      '1108212=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1108213=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1108214=RETURNS ('
      '1108215=  PERIOD_ VARCHAR(40),'
      '1108216=  ROW_NUM VARCHAR(15),'
      '1108217=  ARTICUL VARCHAR(1000),'
      '1108218=  BARCODE VARCHAR(30),'
      
        '1108219=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_N' +
        'UM,'
      '1108220=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1108221=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1108222=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1108223=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1108224=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1108225=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT_' +
        'RESERVE,'
      '1108226=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1108227=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1108228=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1108229=  TOVAR_NAME VARCHAR(250),'
      '1108230=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1108231=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1108232=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1108233=  ERR_CODE INTEGER,'
      '1108234=  ERR_MSG VARCHAR(1024))'
      '1108235=AS'
      
        '1108236=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_LIS' +
        'T'#39';'
      '1108237=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1108238=DECLARE VARIABLE I INTEGER = 1;'
      '1108239=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1108240=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '1108241=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /*' +
        ' '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1108242=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E;'
      
        '1108243=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '1108244=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S_' +
        'VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048',' +
        ' 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1108245=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAME' +
        '; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045#1058 +
        ' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040#1056 +
        #1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1108246=BEGIN'
      '1108247='
      
        '1108248=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_L' +
        'IST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1108249=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1108250='
      '1108251=  SELECT S.S_VALUE'
      '1108252=    FROM SYSTEM_SETUP S'
      '1108253=   WHERE S.SYSTEM_SETUP = 1'
      '1108254=    INTO :FORMULA_;'
      '1108255='
      '1108256=  FOR SELECT GP.PATH,'
      '1108257=             GP.G_PRODUCT'
      '1108258=        FROM P_REP_TREE GP'
      '1108259=       WHERE EXISTS (SELECT 1'
      '1108260=                       FROM G_PRODUCT'
      '1108261=                      WHERE IS_CATEGORY = 0'
      '1108262=                        AND G_PRODUCT_PAR = GP.G_PRODUCT'
      '1108263=                    )'
      
        '1108264=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1108265=              OR'
      '1108266=              (:G_CATEGORY_ is NULL)'
      '1108267=             )'
      '1108268=       ORDER BY 1, 2'
      '1108269=       INTO :PATH_NAME_,'
      '1108270=            :G_PRODUCT_'
      '1108271=  DO BEGIN'
      
        '1108272=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' ' +
        #1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045#1057 +
        #1058#1042#1054
      
        '1108273=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' ' +
        #1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1108274=      SELECT COUNT(G.G_PRODUCT)'
      
        '1108275=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL.' +
        'AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1108276=                                          WHERE :G_TOCHK' +
        'A_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT) L' +
        ' ON G.G_PRODUCT = L.G_PRODUCT'
      '1108277=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1108278=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1108279=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (COA' +
        'LESCE(:INCLUDE_FEW_, 0) = 0))'
      '1108280=              OR'
      
        '1108281=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_,' +
        ' 0) = 1)'
      '1108282=              or'
      
        '1108283=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_,' +
        ' 0) = 1))'
      '1108284=             )'
      '1108285=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1108286=         AND ((EXISTS (SELECT 1'
      '1108287=                       FROM SKLAD S'
      '1108288=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1108289=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1108290=                        AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1108291=              OR'
      '1108292=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1108293=        INTO :CNT_;'
      '1108294='
      '1108295=      IF (CNT_ > 0) THEN BEGIN'
      
        '1108296=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE_' +
        'LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1108297=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), :' +
        'PATH_NAME_, 1);'
      '1108298='
      
        '1108299=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE,'
      '11082100=                                              ARTICUL,'
      '11082101=                                              BARCODE,'
      
        '11082102=                                              NOMENCLAT' +
        'UR_NUM,'
      '11082103=                                              NAME,'
      
        '11082104=                                              UNIT_NAME' +
        ','
      '11082105=                                              PRICE,'
      
        '11082106=                                              VOLUME_PR' +
        'ICE,'
      '11082107=                                              AMOUNT,'
      
        '11082108=                                              AMOUNT_RE' +
        'SERVE,'
      '11082109=                                              SUMM,'
      
        '11082110=                                              PRICE_SEL' +
        'F,'
      '11082111=                                              SORT_COL,'
      
        '11082112=                                              IS_CATEGO' +
        'RY,'
      '11082113=                                              NOTE,'
      
        '11082114=                                              CROSSCODE' +
        ')'
      '11082115=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),'
      '11082116=                 G.ARTICUL,'
      '11082117=                 G.BARCODE,'
      '11082118=                 G.NOMENCLATUR_NUM,'
      '11082119=                 G.NAME,'
      '11082120=                 U.SHORT_NAME,'
      '11082121=                 G.PRICE,'
      '11082122=                 G.VOLUME_PRICE,'
      '11082123=                 COALESCE(S.AMOUNT, 0),'
      '11082124=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      '11082125=                 COALESCE(S.AMOUNT, 0) * G.PRICE,'
      '11082126=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '11082127=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1053 +
        #1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '11082128=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 '#1047 +
        #1040#1050#1059#1055#1054#1050
      '11082129=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '11082130=                  DECODE(:FORMULA_,'
      '11082131=                         0,'
      
        '11082132=                         (SELECT ROUND(SUM(T.AMOUNT * T' +
        '.PRICE)/SUM(T.AMOUNT), 2)'
      
        '11082133=                            FROM (SELECT S.AMOUNT, S.PR' +
        'ICE'
      
        '11082134=                                    FROM SKLAD_PARENT S' +
        'P,'
      '11082135=                                         SKLAD S'
      
        '11082136=                                   WHERE :G_TOCHKA_ARR_' +
        ' CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '11082137=                                     AND SP.DATE_RECEIP' +
        'T <= CURRENT_DATE'
      
        '11082138=                                     AND SP.SKLAD = S.S' +
        'KLAD_PARENT'
      
        '11082139=                                     AND S.G_PRODUCT = ' +
        'G.G_PRODUCT'
      
        '11082140=                                     AND SP.IS_VOZVRAT ' +
        'IN (0, 3, 4)'
      
        '11082141=                                    ORDER BY S.DATE_REC' +
        'EIPT DESC ROWS 1 TO 5) T),'
      '11082142=                         1,'
      '11082143=                         (SELECT S.PRICE'
      '11082144=                            FROM SKLAD S'
      
        '11082145=                           WHERE S.SKLAD = (SELECT MAX(' +
        'SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST ' +
        '= 1'
      
        '11082146=                                              FROM SKLA' +
        'D SS'
      
        '11082147=                                             WHERE :G_T' +
        'OCHKA_ARR_ CONTAINING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39
      
        '11082148=                                               AND SS.G' +
        '_PRODUCT = G.G_PRODUCT'
      
        '11082149=                                               AND SS.I' +
        'S_LAST = 1)'
      '11082150=                         ))), 0) spr,'
      
        '11082151=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, 1' +
        ', G.NAME),'
      '11082152=                 0'
      '11082153=                 ,G.NOTE'
      
        '11082154=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSSC' +
        'ODE'
      
        '11082155=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U O' +
        'N G.G_UNIT = U.G_UNIT'
      
        '11082156=                             LEFT OUTER JOIN (SELECT SU' +
        'M(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.G' +
        '_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11082157=                                              WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODU' +
        'CT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '11082158=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11082159=             AND G.IS_CATEGORY = 0'
      '11082160=             AND G.is_active = 1'
      '11082161=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11082162=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND' +
        ' (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11082163=                  OR'
      
        '11082164=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE_' +
        'NOL_, 0) = 1)'
      '11082165=                  or'
      
        '11082166=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE_' +
        'FEW_, 0) = 1))'
      '11082167=                 )'
      '11082168=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11082169=             AND ((EXISTS (SELECT 1'
      '11082170=                           FROM SKLAD S'
      '11082171=                          WHERE S.G_CLIENT = :G_CLIENT_'
      
        '11082172=                            AND S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11082173=                            AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11082174=                  OR'
      '11082175=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '11082176=           ORDER BY 13;'
      '11082177=      END'
      '11082178=  END'
      '11082179='
      
        '11082180=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_D' +
        'ATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0)' +
        '||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '11082181='
      
        '11082182=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CRO' +
        'SSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AMOU' +
        'NT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '11082183=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '11082184=      FROM P_REP_PRICE_LIST_TABLE'
      
        '11082185=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_N' +
        'UM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE, ' +
        ':AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_CA' +
        'TEGORY, :TOVAR_NAME'
      '11082186=  DO BEGIN'
      '11082187=    I = I + 1;'
      '11082188=    SUSPEND;'
      '11082189=  END'
      '11082190=WHEN ANY DO BEGIN'
      '11082191=    Err_code = -20500;'
      
        '11082192=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11082193=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11082194=  END'
      '11082195=end'
      '11082196=;'
      '11082197='
      '11082198=ALTER PROCEDURE R_FILL_REVISION('
      '11082199=  G_PRODUCT_PAR_ BLOB SUB_TYPE 1,'
      '11082200=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11082201=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11082202=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11082203=  TYPE_ INTEGER)'
      '11082204=RETURNS ('
      '11082205=  ERR_CODE INTEGER,'
      '11082206=  ERR_MSG VARCHAR(1024))'
      '11082207=AS'
      
        '11082208=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_PRO' +
        'DUCT.AMOUNT;'
      
        '11082209=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN LT_SKLAD_PR' +
        'ODUCT.G_PRODUCT;'
      '11082210=DECLARE VARIABLE I INTEGER = 1;'
      '11082211=BEGIN'
      '11082212='
      '11082213=  IF (G_TOCHKA_ IS NULL) THEN'
      '11082214=    SELECT ID'
      '11082215=      FROM CUR_PARAMS'
      '11082216=     WHERE CUR_PARAMS = 2'
      '11082217=      INTO :G_TOCHKA_;'
      '11082218='
      '11082219=  DELETE FROM REVISION R WHERE R.G_TOCHKA = :G_TOCHKA_;'
      '11082220='
      '11082221=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1041#1044
      '11082222=  IF (COALESCE(SKLAD_, 0) = 0) THEN BEGIN'
      '11082223=      FOR SELECT G.G_PRODUCT,'
      '11082224=                 COALESCE(LT.AMOUNT, 0)'
      
        '11082225=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G_' +
        'PRODUCT, AMOUNT'
      
        '11082226=                                                FROM LT' +
        '_SKLAD_PRODUCT'
      
        '11082227=                                               WHERE G_' +
        'TOCHKA = :G_TOCHKA_) LT ON G.g_product = LT.g_product'
      '11082228=           WHERE G.IS_ACTIVE = 1'
      '11082229=             AND G.IS_KIT <> 1'
      
        '11082230=             AND ((:G_PRODUCT_PAR_ CONTAINING '#39'~'#39'||G.G_' +
        'PRODUCT_PAR||'#39'~'#39' AND :G_PRODUCT_PAR_ IS NOT NULL)'
      '11082231=                  OR'
      '11082232=                  (:G_PRODUCT_PAR_ IS NULL)'
      '11082233=                 )'
      
        '11082234=             AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||G.G_PROD' +
        'UCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11082235=                  OR'
      '11082236=                  (:G_PRODUCT_ IS NULL)'
      '11082237=                 )'
      '11082238=             AND G.IS_CATEGORY = 0'
      '11082239=          /*UNION ALL'
      '11082240=          SELECT G.G_PRODUCT,'
      '11082241=                 COALESCE(LT.AMOUNT, 0)'
      '11082242=            FROM G_PRODUCT G,'
      '11082243=                 LT_SKLAD_PRODUCT LT'
      '11082244=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      
        '11082245=             AND G.G_PRODUCT_PAR IN (SELECT GG.G_PRODUC' +
        'T'
      '11082246=                                      FROM G_PRODUCT GG'
      
        '11082247=                                     WHERE :G_PRODUCT_P' +
        'AR_ CONTAINING '#39'~'#39'||GG.G_PRODUCT_PAR||'#39'~'#39
      
        '11082248=                                       AND GG.IS_CATEGO' +
        'RY = 1'
      
        '11082249=                                       and gg.G_PRODUCT' +
        '_PAR is not null)'
      '11082250=             AND G.IS_CATEGORY = 0'
      '11082251=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) > 0'
      '11082252=             AND LT.G_TOCHKA = :G_TOCHKA_'
      '11082253=          UNION ALL'
      '11082254=          SELECT G.G_PRODUCT,'
      '11082255=                 COALESCE(LT.AMOUNT, 0)'
      '11082256=            FROM G_PRODUCT G,'
      '11082257=                 LT_SKLAD_PRODUCT LT'
      '11082258=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      '11082259=             AND G.IS_CATEGORY = 0'
      '11082260=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0'
      '11082261=             AND LT.G_TOCHKA = :G_TOCHKA_'
      
        '11082262=          /*UNION ALL              '#1061#1059#1049' '#1047#1053#1040#1045#1058' '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054 +
        ' '#1053#1059#1046#1053#1054'  11.02.2016'
      '11082263=          SELECT G.G_PRODUCT,'
      '11082264=                 COALESCE(LT.AMOUNT, 0)'
      
        '11082265=            FROM G_PRODUCT G LEFT OUTER JOIN LT_SKLAD_P' +
        'RODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT'
      
        '11082266=           WHERE G.G_PRODUCT_PAR IN (SELECT GG.G_PRODUC' +
        'T'
      '11082267=                                      FROM G_PRODUCT GG'
      
        '11082268=                                     WHERE GG.IS_CATEGO' +
        'RY = 1'
      
        '11082269=                                       and gg.G_PRODUCT' +
        '_PAR is not null)'
      '11082270=             AND G.IS_CATEGORY = 0'
      '11082271=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0 */'
      '11082272=          ORDER BY 1'
      '11082273=          INTO :G_PRODUCT__,'
      '11082274=               :AMOUNT_BD_'
      '11082275=      DO BEGIN'
      '11082276='
      
        '11082277=        INSERT INTO REVISION (REVISION, SKLAD, G_PRODUC' +
        'T, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '11082278=        VALUES (GEN_ID(GEN_REVISION, 1), NULL, :G_PRODU' +
        'CT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      '11082279='
      '11082280=        I = I + 1;'
      '11082281=      END'
      '11082282='
      '11082283=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11082284=  END ELSE BEGIN'
      '11082285=      FOR SELECT SS.G_PRODUCT,'
      '11082286=                 SS.AMOUNT'
      '11082287=            FROM SKLAD_PARENT S, SKLAD SS'
      '11082288=           WHERE S.SKLAD = :SKLAD_'
      '11082289=             AND S.SKLAD = SS.SKLAD_PARENT'
      
        '11082290=             AND S.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '11082291=          ORDER BY 1'
      '11082292=          INTO :G_PRODUCT__,'
      '11082293=               :AMOUNT_BD_'
      '11082294=      DO BEGIN'
      '11082295='
      
        '11082296=        INSERT INTO REVISION (REVISION, SKLAD, G_PRODUC' +
        'T, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '11082297=        VALUES (GEN_ID(GEN_REVISION, 1), NULL, :G_PRODU' +
        'CT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      '11082298='
      '11082299=        I = I + 1;'
      '11082300=      END'
      '11082301=  END'
      '11082302=END'
      '11082303=;'
      '11082304='
      '11082305=ALTER PROCEDURE R_UNIFICATION('
      '11082306=  MODE_ INTEGER)'
      '11082307=RETURNS ('
      '11082308=  COUNT_SPIS_ INTEGER,'
      '11082309=  COUNT_PRIH_ INTEGER,'
      '11082310=  ERR_CODE INTEGER,'
      '11082311=  ERR_MSG VARCHAR(1024))'
      '11082312=AS'
      
        '11082313=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATION'#39 +
        ';'
      '11082314=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11082315=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REVI' +
        'SION;'
      
        '11082316=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_P' +
        'RODUCT;'
      
        '11082317=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AMO' +
        'UNT_BD;'
      
        '11082318=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_REAL;'
      
        '11082319=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRICE' +
        ';'
      '11082320=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11082321=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11082322=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKL' +
        'AD;'
      
        '11082323=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11082324=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      '11082325=BEGIN'
      '11082326='
      '11082327=  COUNT_SPIS_ = 0;'
      '11082328=  COUNT_PRIH_ = 0;'
      '11082329='
      '11082330=  SELECT ID'
      '11082331=    FROM CUR_PARAMS'
      '11082332=   WHERE CUR_PARAMS = 2'
      '11082333=    INTO :G_TOCHKA_;'
      '11082334='
      
        '11082335=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REA' +
        'L'
      '11082336=      FROM REVISION'
      '11082337=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '11082338=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOUN' +
        'T_REAL_'
      '11082339=  DO BEGIN'
      
        '11082340=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2)' +
        ')) THEN BEGIN'
      
        '11082341=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1)'
      '11082342=        RETURNING_VALUES :COST_PRICE_;'
      '11082343='
      
        '11082344=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_P' +
        'RODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '11082345=                                     DISCOUNT_SUMM, NDS' +
        ', NDS_SUMM)'
      
        '11082346=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, ' +
        ':AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMOU' +
        'NT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '11082347='
      '11082348=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '11082349=    END'
      '11082350='
      
        '11082351=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1)' +
        ')) then BEGIN'
      '11082352=      SELECT S.PRICE'
      '11082353=        FROM SKLAD S'
      '11082354=       WHERE S.IS_LAST = 1'
      '11082355=         AND S.G_PRODUCT = :G_PRODUCT_'
      '11082356=         AND S.G_TOCHKA = :G_TOCHKA_'
      '11082357=        INTO :PRICE_LAST_;'
      '11082358='
      
        '11082359=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056#1059 +
        #1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '11082360='
      
        '11082361=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, NDS, NDS_SUMM)'
      
        '11082362=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, ' +
        ':AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AMO' +
        'UNT_BD_) * :PRICE_LAST_, 0, 0);'
      '11082363='
      '11082364=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '11082365=    END'
      '11082366='
      '11082367=    UPDATE REVISION R'
      '11082368=       SET R.IS_UNIFIED = 1'
      '11082369=     WHERE R.REVISION = :REVISION_;'
      '11082370=  END'
      '11082371='
      '11082372=  PNT_ = '#39'01'#39';'
      '11082373=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '11082374=    SELECT SUM(S.SUMM)'
      '11082375=      FROM ZAKAZ_DETAILS_TMP S'
      '11082376=      INTO :SUMM_;'
      '11082377='
      '11082378=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '11082379=                                CURRENT_DATE, --:Z_DATE' +
        '_,'
      '11082380=                                CURRENT_TIME, --:Z_TIME'
      
        '11082381=                                10,          --:G_CLIEN' +
        'T_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '11082382=                                1,            --:G_PAYM' +
        'ENT_TYPE_,'
      
        '11082383=                                NULL,         --:OSNOVA' +
        'NIE_,'
      
        '11082384=                                1,              --:IS_S' +
        'PISANIE_,'
      
        '11082385=                                NULL,           --:NOTE' +
        '_,'
      
        '11082386=                                :SUMM_,              --' +
        ':SUMM_,'
      
        '11082387=                                :SUMM_,              --' +
        ':SUMM_FACT_,'
      
        '11082388=                                0,              --SUMM_' +
        'BONUS_'
      
        '11082389=                                0,              --SUMM_' +
        'BONUS_GOT'
      
        '11082390=                                NULL,           --:G_PR' +
        'IHOD_,'
      '11082391=                                NULL,'
      '11082392=                                0,        -- BY_RECIPE'
      '11082393=                                0         -- IS_RESERVE'
      '11082394=                                ,NULL  -- PAYMENTS_'
      '11082395=                                ,0     -- SUMM_CASH'
      '11082396=                                ,0     -- SUMM_NONCASH'
      
        '11082397=                                ) RETURNING_VALUES :ZAK' +
        'AZ_, :ERR_CODE, :ERR_MSG;'
      '11082398=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11082399=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11082400=      EXIT;'
      '11082401=    END'
      '11082402=  END'
      '11082403='
      '11082404=  PNT_ = '#39'02'#39';'
      '11082405=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '11082406=    SELECT SUM(S.SUMM)'
      '11082407=      FROM SKLAD_TMP S'
      '11082408=      INTO :SUMM_;'
      '11082409='
      '11082410=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '11082411=                                CURRENT_DATE,   --:DATE' +
        '_RECEIPT_,'
      '11082412=                                CURRENT_TIME,'
      
        '11082413=                                NULL,           --:G_CL' +
        'IENT_,'
      
        '11082414=                                1,              --:G_PA' +
        'YMENT_TYPE_,'
      
        '11082415=                                NULL,           --:OSNO' +
        'VANIE_,'
      
        '11082416=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',    ' +
        '       --:NOTE_,'
      
        '11082417=                                5,              --:IS_V' +
        'OZVRAT_,'
      '11082418=                                :SUMM_,'
      '11082419=                                :SUMM_,'
      
        '11082420=                                NULL,           --:G_PR' +
        'IHOD_,'
      
        '11082421=                                NULL            --:SUMM' +
        '_PRIHOD_'
      '11082422=                                ,NULL  --PAYMENTS'
      '11082423=                                )'
      '11082424=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '11082425=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11082426=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11082427=      EXIT;'
      '11082428=    END'
      '11082429=  END'
      '11082430=END'
      '11082431=;'
      
        '11082432=UPDATE SYSTEM_SETUP SET S_VALUE = 11082 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11082433=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11082434=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '110830=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER NOTE TYPE VARCHA' +
        'R(300);'
      
        '110831=UPDATE SYSTEM_SETUP SET S_VALUE = 11082 WHERE SYSTEM_SETU' +
        'P = 3;'
      
        '110832=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB$' +
        'DESCRIPTION=NULL;'
      '110833=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110840=ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '110841=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110842=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110843=  MODE_ INTEGER)'
      '110844=RETURNS ('
      '110845=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '110846=AS'
      '110847=/*'
      
        '110848=11.04.2019 '#1047#1053#1040#1052#1045#1053#1040#1058#1045#1051#1068#1053#1067#1049' '#1044#1045#1053#1068', '#1056#1045#1064#1048#1051' '#1058#1045#1055#1045#1056#1068' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1055#1054 +
        ' IS_LAST, '#1040' '#1055#1054' MAX DATE_RECEIPT'
      '110849=*/'
      
        '1108410=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S_' +
        'VALUE;'
      '1108411=BEGIN'
      '1108412=  IF (G_TOCHKA_ IS NULL) THEN'
      '1108413=    SELECT ID'
      '1108414=      FROM CUR_PARAMS'
      '1108415=     WHERE CUR_PARAMS = 2'
      '1108416=      INTO :G_TOCHKA_;'
      '1108417='
      '1108418=  if (COALESCE(MODE_, 0) = 0) then'
      '1108419=      SELECT S.price'
      '1108420=        FROM SKLAD S'
      '1108421=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1108422=         AND S.g_product = :G_PRODUCT_'
      '1108423=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '1108424=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECEIP' +
        'T)'
      '1108425=                                 FROM SKLAD DD'
      
        '1108426=                                WHERE DD.g_product = :G_' +
        'PRODUCT_'
      
        '1108427=                                  AND DD.G_TOCHKA = :G_T' +
        'OCHKA_'
      
        '1108428=                                  AND DD.IS_VOZVRAT IN (' +
        '0, 4)'
      '1108429=                                )'
      '1108430=        ORDER BY 1 DESC'
      '1108431=        ROWS 1 TO 1'
      '1108432=        INTO :PRICE_;'
      '1108433=      /*SELECT S.PRICE'
      '1108434=        FROM SKLAD S'
      '1108435=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1108436=         AND S.IS_LAST = 1'
      '1108437=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1108438=        INTO :PRICE_;*/'
      '1108439='
      
        '1108440=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047#1040#1042 +
        #1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '1108441=  ELSE BEGIN'
      '1108442=    SELECT S.S_VALUE'
      '1108443=      FROM SYSTEM_SETUP S'
      '1108444=     WHERE S.SYSTEM_SETUP = 1'
      '1108445=      INTO :FORMULA_;'
      '1108446='
      '1108447=    IF (FORMULA_ = 1) THEN BEGIN'
      '1108448=      SELECT S.price'
      '1108449=        FROM SKLAD S'
      '1108450=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1108451=         AND S.g_product = :G_PRODUCT_'
      '1108452=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '1108453=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECEIP' +
        'T)'
      '1108454=                                 FROM SKLAD DD'
      
        '1108455=                                WHERE DD.g_product = :G_' +
        'PRODUCT_'
      
        '1108456=                                  AND DD.G_TOCHKA = :G_T' +
        'OCHKA_'
      
        '1108457=                                  AND DD.IS_VOZVRAT IN (' +
        '0, 4)'
      '1108458=                                )'
      '1108459=        ORDER BY 1 DESC'
      '1108460=        ROWS 1 TO 1'
      '1108461=        INTO :PRICE_;'
      '1108462=      /*SELECT S.PRICE'
      '1108463=        FROM SKLAD S'
      '1108464=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1108465=         AND S.IS_LAST = 1'
      '1108466=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1108467=        INTO :PRICE_;*/'
      '1108468='
      
        '1108469=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045#1058' ' +
        #1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048'"' +
        ' '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '1108470=      IF (ROW_COUNT = 0) THEN'
      '1108471=        SELECT S.PRICE'
      '1108472=          FROM SKLAD S'
      '1108473=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1108474=                            FROM SKLAD SS'
      
        '1108475=                           WHERE /*SS.G_TOCHKA = :G_TOCH' +
        'KA_'
      
        '1108476=                             AND */SS.G_PRODUCT = :G_PRO' +
        'DUCT_'
      
        '1108477=                             AND SS.DATE_RECEIPT = (SELE' +
        'CT MAX(SSS.DATE_RECEIPT)'
      
        '1108478=                                                      FR' +
        'OM SKLAD SSS'
      
        '1108479=                                                     WHE' +
        'RE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '1108480=                                                       A' +
        'ND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '1108481=                                                       A' +
        'ND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '1108482=                                                   )'
      
        '1108483=                             AND SS.IS_VOZVRAT IN (0, 4)' +
        ' --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '1108484=                         )'
      '1108485=          INTO :PRICE_;'
      '1108486=    END ELSE BEGIN'
      
        '1108487=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT)' +
        ', 2)'
      '1108488=        FROM (SELECT S.AMOUNT, S.PRICE'
      '1108489=                FROM SKLAD_PARENT SP,'
      '1108490=                     SKLAD S'
      '1108491=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '1108492=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '1108493=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '1108494=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '1108495=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.IS' +
        '_VOZVRAT IN (0, 3, 4)'
      
        '1108496=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO 5' +
        ') T'
      '1108497=        INTO :PRICE_;'
      '1108498='
      
        '1108499=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045#1058' ' +
        #1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048'" '#1042 +
        ' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '11084100=      IF (PRICE_ IS NULL) THEN'
      
        '11084101=        SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOU' +
        'NT), 2)'
      '11084102=        FROM (SELECT S.AMOUNT, S.PRICE'
      '11084103=                FROM SKLAD_PARENT SP,'
      '11084104=                     SKLAD S'
      '11084105=               WHERE SP.DATE_RECEIPT <= CURRENT_DATE'
      '11084106=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '11084107=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '11084108=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.I' +
        'S_VOZVRAT IN (0, 3, 4)'
      
        '11084109=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO ' +
        '5) T'
      '11084110=          INTO :PRICE_;'
      '11084111=    END'
      '11084112=  END'
      '11084113='
      '11084114=  PRICE_ = COALESCE(:PRICE_, 0);'
      '11084115=  SUSPEND;'
      '11084116=END'
      '11084117=;'
      '11084118='
      '11084119=ALTER PROCEDURE R_UNIFICATION('
      '11084120=  MODE_ INTEGER)'
      '11084121=RETURNS ('
      '11084122=  COUNT_SPIS_ INTEGER,'
      '11084123=  COUNT_PRIH_ INTEGER,'
      '11084124=  ERR_CODE INTEGER,'
      '11084125=  ERR_MSG VARCHAR(1024))'
      '11084126=AS'
      
        '11084127=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATION'#39 +
        ';'
      '11084128=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11084129=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REVI' +
        'SION;'
      
        '11084130=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_P' +
        'RODUCT;'
      
        '11084131=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AMO' +
        'UNT_BD;'
      
        '11084132=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_REAL;'
      
        '11084133=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRICE' +
        ';'
      '11084134=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11084135=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11084136=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKL' +
        'AD;'
      
        '11084137=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11084138=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      '11084139=BEGIN'
      '11084140='
      '11084141=  COUNT_SPIS_ = 0;'
      '11084142=  COUNT_PRIH_ = 0;'
      '11084143='
      '11084144=  SELECT ID'
      '11084145=    FROM CUR_PARAMS'
      '11084146=   WHERE CUR_PARAMS = 2'
      '11084147=    INTO :G_TOCHKA_;'
      '11084148='
      
        '11084149=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REA' +
        'L'
      '11084150=      FROM REVISION'
      '11084151=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '11084152=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOUN' +
        'T_REAL_'
      '11084153=  DO BEGIN'
      
        '11084154=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2)' +
        ')) THEN BEGIN'
      
        '11084155=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1)'
      '11084156=        RETURNING_VALUES :COST_PRICE_;'
      '11084157='
      
        '11084158=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_P' +
        'RODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '11084159=                                     DISCOUNT_SUMM, NDS' +
        ', NDS_SUMM)'
      
        '11084160=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, ' +
        ':AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMOU' +
        'NT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '11084161='
      '11084162=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '11084163=    END'
      '11084164='
      
        '11084165=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1)' +
        ')) then BEGIN'
      '11084166=      SELECT S.price'
      '11084167=        FROM SKLAD S'
      '11084168=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '11084169=         AND S.g_product = :G_PRODUCT_'
      '11084170=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '11084171=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECEI' +
        'PT)'
      '11084172=                                 FROM SKLAD DD'
      
        '11084173=                                WHERE DD.g_product = :G' +
        '_PRODUCT_'
      
        '11084174=                                  AND DD.G_TOCHKA = :G_' +
        'TOCHKA_'
      
        '11084175=                                  AND DD.IS_VOZVRAT IN ' +
        '(0, 4)'
      '11084176=                                )'
      '11084177=        ORDER BY s.sklad DESC'
      '11084178=        ROWS 1 TO 1'
      '11084179=        INTO :PRICE_LAST_;'
      '11084180='
      '11084181=    /* SELECT S.PRICE'
      '11084182=        FROM SKLAD S'
      '11084183=       WHERE S.IS_LAST = 1'
      '11084184=         AND S.G_PRODUCT = :G_PRODUCT_'
      '11084185=         AND S.G_TOCHKA = :G_TOCHKA_'
      '11084186=        INTO :PRICE_LAST_; */'
      '11084187='
      
        '11084188=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056#1059 +
        #1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '11084189='
      
        '11084190=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, NDS, NDS_SUMM)'
      
        '11084191=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, ' +
        ':AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AMO' +
        'UNT_BD_) * :PRICE_LAST_, 0, 0);'
      '11084192='
      '11084193=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '11084194=    END'
      '11084195='
      '11084196=    UPDATE REVISION R'
      '11084197=       SET R.IS_UNIFIED = 1'
      '11084198=     WHERE R.REVISION = :REVISION_;'
      '11084199=  END'
      '11084200='
      '11084201=  PNT_ = '#39'01'#39';'
      '11084202=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '11084203=    SELECT SUM(S.SUMM)'
      '11084204=      FROM ZAKAZ_DETAILS_TMP S'
      '11084205=      INTO :SUMM_;'
      '11084206='
      '11084207=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '11084208=                                CURRENT_DATE, --:Z_DATE' +
        '_,'
      '11084209=                                CURRENT_TIME, --:Z_TIME'
      
        '11084210=                                10,          --:G_CLIEN' +
        'T_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '11084211=                                1,            --:G_PAYM' +
        'ENT_TYPE_,'
      
        '11084212=                                NULL,         --:OSNOVA' +
        'NIE_,'
      
        '11084213=                                1,              --:IS_S' +
        'PISANIE_,'
      
        '11084214=                                NULL,           --:NOTE' +
        '_,'
      
        '11084215=                                :SUMM_,              --' +
        ':SUMM_,'
      
        '11084216=                                :SUMM_,              --' +
        ':SUMM_FACT_,'
      
        '11084217=                                0,              --SUMM_' +
        'BONUS_'
      
        '11084218=                                0,              --SUMM_' +
        'BONUS_GOT'
      
        '11084219=                                NULL,           --:G_PR' +
        'IHOD_,'
      '11084220=                                NULL,'
      '11084221=                                0,        -- BY_RECIPE'
      '11084222=                                0         -- IS_RESERVE'
      '11084223=                                ,NULL  -- PAYMENTS_'
      '11084224=                                ,0     -- SUMM_CASH'
      '11084225=                                ,0     -- SUMM_NONCASH'
      
        '11084226=                                ) RETURNING_VALUES :ZAK' +
        'AZ_, :ERR_CODE, :ERR_MSG;'
      '11084227=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11084228=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11084229=      EXIT;'
      '11084230=    END'
      '11084231=  END'
      '11084232='
      '11084233=  PNT_ = '#39'02'#39';'
      '11084234=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '11084235=    SELECT SUM(S.SUMM)'
      '11084236=      FROM SKLAD_TMP S'
      '11084237=      INTO :SUMM_;'
      '11084238='
      '11084239=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '11084240=                                CURRENT_DATE,   --:DATE' +
        '_RECEIPT_,'
      '11084241=                                CURRENT_TIME,'
      
        '11084242=                                NULL,           --:G_CL' +
        'IENT_,'
      
        '11084243=                                1,              --:G_PA' +
        'YMENT_TYPE_,'
      
        '11084244=                                NULL,           --:OSNO' +
        'VANIE_,'
      
        '11084245=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',    ' +
        '       --:NOTE_,'
      
        '11084246=                                5,              --:IS_V' +
        'OZVRAT_,'
      '11084247=                                :SUMM_,'
      '11084248=                                :SUMM_,'
      
        '11084249=                                NULL,           --:G_PR' +
        'IHOD_,'
      
        '11084250=                                NULL            --:SUMM' +
        '_PRIHOD_'
      '11084251=                                ,NULL  --PAYMENTS'
      '11084252=                                )'
      '11084253=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '11084254=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11084255=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11084256=      EXIT;'
      '11084257=    END'
      '11084258=  END'
      '11084259=END'
      '11084260=;'
      
        '11084261=UPDATE SYSTEM_SETUP SET S_VALUE = 11084 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11084262=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11084263=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110850=ALTER PROCEDURE DEL_ZAKAZ('
      '110851=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110852=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0,'
      '110853=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110854=RETURNS ('
      '110855=  ERR_CODE INTEGER,'
      '110856=  ERR_MSG VARCHAR(1024))'
      '110857=AS'
      '110858=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '110859=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1108510=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '1108511=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUMM;'
      
        '1108512=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_BONUS;'
      
        '1108513=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_BONUS_GOT;'
      
        '1108514=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLI' +
        'ENT;'
      
        '1108515=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFF' +
        'ICIAL.DO_NOT_SALES_COMM;'
      
        '1108516=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICIA' +
        'L.FM;'
      
        '1108517=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN ' +
        'SYSTEM_SETUP.S_VALUE;'
      
        '1108518=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM;'
      
        '1108519=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRODUC' +
        'T.SALES_COMM;'
      
        '1108520=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '1108521=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G' +
        '_OFFICIAL;'
      
        '1108522=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA' +
        ';'
      '1108523=BEGIN'
      
        '1108524=  --****************************************************' +
        '************'
      '1108525=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1108526=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1108527=      SELECT Z.SUMM,'
      '1108528=             Z.SUMM_BONUS,'
      '1108529=             Z.SUMM_BONUS_GOT,'
      '1108530=             Z.G_CLIENT,'
      '1108531=             Z.G_OFFICIAL,'
      '1108532=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '1108533=             G.FM'
      '1108534=             ,Z.G_TOCHKA'
      
        '1108535=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z.G' +
        '_OFFICIAL = G.G_OFFICIAL'
      '1108536=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1108537=        INTO :SUMM_ZAKAZ_,'
      '1108538=             :SUMM_PAY_BONUS_,'
      '1108539=             :SUMM_BONUS_GOT_,'
      '1108540=             :G_CLIENT_,'
      '1108541=             :G_OFFICIAL_,'
      '1108542=             :DO_NOT_SALES_COMM_,'
      '1108543=             :OFFICIAL_NAME_'
      '1108544=             ,:G_TOCHKA_;'
      '1108545='
      
        '1108546=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' '#1055#1056#1054 +
        #1044#1040#1042#1062#1059
      
        '1108547=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0) T' +
        'HEN'
      '1108548=        SELECT SUM(ZD.SALES_COMM)'
      '1108549=          FROM ZAKAZ_DETAILS ZD'
      '1108550=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1108551=          INTO :SALES_COMM_OLD_;'
      '1108552='
      '1108553=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1108554=      PNT_ = '#39'01'#39';'
      
        '1108555=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETURN' +
        'ING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1108556=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1108557=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '1108558=        EXIT;'
      '1108559=      END'
      '1108560='
      '1108561=      -------------------------------------'
      '1108562=      PNT_ = '#39'02'#39';'
      '1108563=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '1108564=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063 +
        #1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071 +
        ' '#1055#1054#1044#1056#1071#1044
      '1108565=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '1108566=      FOR SELECT S.KASSA'
      '1108567=            FROM KASSA S'
      '1108568=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1108569=            INTO :KASSA_'
      '1108570=      DO BEGIN'
      
        '1108571=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1108572=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1108573=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '1108574=            EXIT;'
      '1108575=          END'
      '1108576=      END'
      '1108577='
      '1108578=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '1108579=      PNT_ = '#39'03'#39';'
      '1108580=      FOR SELECT S.KASSA_BEZNAL'
      '1108581=            FROM KASSA_BEZNAL S'
      '1108582=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1108583=            INTO :KASSA_'
      '1108584=      DO BEGIN'
      
        '1108585=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1108586=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1108587=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '1108588=            EXIT;'
      '1108589=          END'
      '1108590=      END'
      '1108591=      -------------------------------------'
      '1108592='
      
        '1108593=      --================================================' +
        '================='
      '1108594=      -- '#1041#1051#1054#1050' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040
      
        '1108595=      --================================================' +
        '================='
      '1108596=      PNT_ = '#39'03.1'#39';'
      
        '1108597=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0 AN' +
        'D SALES_COMM_OLD_ > 0) THEN BEGIN'
      '1108598=            KASSA_ = NULL;'
      '1108599='
      '11085100=            SELECT S.S_VALUE'
      '11085101=              FROM SYSTEM_SETUP S'
      '11085102=             WHERE S.SYSTEM_SETUP = 4'
      '11085103=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '11085104='
      '11085105=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11085106=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11085107=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11085108='
      
        '11085109=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040 +
        #1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11085110=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11085111=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DEC' +
        'ODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FR' +
        'OM CURRENT_DATE)));'
      '11085112='
      '11085113=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11085114=            ELSE'
      
        '11085115=               ACTION_DATE_ZP_ = Current_date - EXTRACT' +
        '(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - E' +
        'XTRACT(DAY FROM current_date) + 32);'
      '11085116='
      '11085117=            SELECT K.KASSA, K.SUMM'
      '11085118=            FROM KASSA K'
      '11085119=            WHERE K.G_PRIHOD_RASHOD = -1'
      '11085120=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '11085121=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '11085122=             AND K.G_TOCHKA = :G_TOCHKA_'
      '11085123=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '11085124='
      '11085125=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '11085126=                EXECUTE PROCEDURE K_INS_KASSA(1,     --' +
        ' ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11085127=                                              -1,     -' +
        '-:G_PRIHOD_RASHOD_,'
      
        '11085128=                                              -:SALES_C' +
        'OMM_OLD_,'
      
        '11085129=                                              :ACTION_D' +
        'ATE_ZP_,'
      
        '11085130=                                              :OFFICIAL' +
        '_NAME_,'
      
        '11085131=                                              NULL,    ' +
        ' --:ZAKAZ_,'
      
        '11085132=                                              NULL,    ' +
        ' --:SKLAD_,'
      '11085133=                                              1,'
      
        '11085134=                                              (SELECT I' +
        'D FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '11085135=                                              :G_OFFICI' +
        'AL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11085136=            END ELSE'
      '11085137=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '11085138=                                              1,     --' +
        ' ACTION_'
      
        '11085139=                                              -1,     -' +
        '-:G_PRIHOD_RASHOD_,'
      
        '11085140=                                              :SALES_CO' +
        'MM_SUMM_ITER_ - :SALES_COMM_OLD_,'
      
        '11085141=                                              :ACTION_D' +
        'ATE_ZP_,'
      
        '11085142=                                              :OFFICIAL' +
        '_NAME_,   --NOTE_'
      '11085143=                                              NULL,'
      '11085144=                                              NULL,'
      '11085145=                                              1,'
      
        '11085146=                                              G_OFFICIA' +
        'L_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '11085147='
      '11085148=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11085149=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11085150=              EXIT;'
      '11085151=            END'
      '11085152=      END'
      '11085153=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '11085154=      --===============================================' +
        '=================='
      '11085155='
      
        '11085156=      -- '#1045#1057#1051#1048' '#1050#1040#1050#1040#1071'-'#1058#1054' '#1063#1040#1057#1058#1068' '#1041#1067#1051#1040' '#1054#1055#1051#1040#1063#1045#1053#1040' '#1041#1054#1053#1059#1057#1040#1052#1048' - '#1042 +
        #1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1048#1061', '#1058#1054' '#1045#1057#1058#1068' '#1047#1040#1050#1048#1044#1067#1042#1040#1070' '#1050#1051#1048#1045#1053#1058#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1053#1040' '#1053#1040#1050#1054#1055#1051#1045#1053#1048 +
        #1071
      '11085157=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '11085158=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054 +
        #1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '11085159=      UPDATE G_DISCONT_CARD G'
      
        '11085160=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_, ' +
        '0) - :SUMM_BONUS_GOT_,'
      
        '11085161=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0), ' +
        '0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '11085162=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '11085163='
      '11085164=      PNT_ = '#39'04'#39';'
      '11085165=      UPDATE INVOICE I'
      '11085166=         SET I.ZAKAZ = NULL'
      '11085167=       WHERE I.ZAKAZ = :zakaz_;'
      '11085168='
      '11085169=      UPDATE INVOICE_PAY I'
      '11085170=         SET I.ZAKAZ = NULL'
      '11085171=       WHERE I.ZAKAZ = :zakaz_;'
      '11085172='
      '11085173=      UPDATE WAYBILL W'
      '11085174=         SET W.ZAKAZ = NULL'
      '11085175=       WHERE W.ZAKAZ = :zakaz_;'
      '11085176=      --********************************************'
      '11085177='
      '11085178=      PNT_ = '#39'015'#39';'
      '11085179=      DELETE FROM zakaz'
      '11085180=      WHERE zakaz = :zakaz_;'
      '11085181='
      '11085182=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '11085183=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      
        '11085184=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_' +
        'TYPE, ID, OPER)'
      
        '11085185=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ_' +
        ', 3);'
      '11085186=  END'
      '11085187=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '11085188=  --***************************************************' +
        '*************************'
      '11085189=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11085190=  ELSE BEGIN'
      '11085191=    PNT_ = '#39'20'#39';'
      
        '11085192=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '11085193=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11085194=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11085195=      EXIT;'
      '11085196=    END'
      '11085197=  END'
      '11085198='
      '11085199=when sqlcode -530 DO'
      '11085200=  begin'
      '11085201=    ERR_CODE = -20500;'
      
        '11085202=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' '#1079 +
        #1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11085203=    ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '11085204=  end'
      '11085205=end'
      '11085206=;'
      '11085207='
      '11085208=ALTER PROCEDURE G_GET_G_PRODUCT_SALEMODE('
      '11085209=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11085210=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11085211=RETURNS ('
      '11085212=  NAME_ VARCHAR(500),'
      '11085213=  PRICE_ NUMERIC(15,2),'
      '11085214=  ROZN_PRICE_ NUMERIC(15,2),'
      '11085215=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11085216=  AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '11085217=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11085218=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11085219=  SKIDKA_SUMM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11085220=  ERR_CODE INTEGER,'
      '11085221=  ERR_MSG VARCHAR(1024))'
      '11085222=AS'
      '11085223=BEGIN'
      '11085224=    SELECT'
      '11085225=        t.NAME,'
      '11085226=        t.PRICE,'
      '11085227=        T.price,'
      '11085228=        t.VOLUME_PRICE,'
      '11085229=        t.PACK_AMOUNT'
      
        '11085230=        ,COALESCE(P.AMOUNT, 0) - COALESCE(P.AMOUNT_RESE' +
        'RVE, 0) AMOUNT'
      '11085231=        ,COALESCE(PP.SKIDKA_PROC, 0)'
      '11085232=        ,COALESCE(PP.SKIDKA_SUM, 0)'
      '11085233=    FROM G_PRODUCT T'
      
        '11085234=         LEFT OUTER JOIN (SELECT G_PRODUCT, AMOUNT, AMO' +
        'UNT_RESERVE FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_)  ' +
        'P ON T.G_PRODUCT = P.G_PRODUCT'
      
        '11085235=         LEFT OUTER JOIN (SELECT G_PRODUCT, D.SKIDKA_PR' +
        'OC, D.SKIDKA_SUM'
      
        '11085236=                                        FROM G_DISCOUNT' +
        ' D'
      
        '11085237=                                        WHERE ((D.DATE_' +
        'BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '11085238=                                                AND D.D' +
        'ATE_END >= CURRENT_TIMESTAMP'
      
        '11085239=                                                AND D.D' +
        'ATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      '11085240=                                              )'
      '11085241=                                              OR'
      
        '11085242=                                              (D.DATE_B' +
        'EGIN IS NULL AND D.DATE_END IS NULL))'
      
        '11085243=                                        AND COALESCE(D.' +
        'G_TOCHKA, :G_TOCHKA_) = :G_TOCHKA_'
      
        '11085244=                                     ) PP ON T.G_PRODUC' +
        'T = PP.G_PRODUCT'
      '11085245=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11085246=    INTO'
      '11085247=        :NAME_,'
      '11085248=        :PRICE_,'
      '11085249=        :ROZN_PRICE_,'
      '11085250=        :VOLUME_PRICE_,'
      '11085251=        :PACK_AMOUNT_,'
      '11085252=        :AMOUNT_,'
      '11085253=        :SKIDKA_PROC_,'
      '11085254=        :SKIDKA_SUMM_;'
      '11085255=end'
      '11085256=;'
      
        '11085257=UPDATE SYSTEM_SETUP SET S_VALUE = 11085 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11085258=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11085259=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110860=ALTER PROCEDURE G_READ_G_DISCOUNT_LIST('
      '110861=  IS_ALL_ INTEGER)'
      '110862=RETURNS ('
      '110863=  G_DISCOUNT TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '110864=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110865=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110866=  G_PRODUCT_PAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110867=  DATE_BEGIN DATE,'
      '110868=  DATE_END DATE,'
      '110869=  NAME VARCHAR(1024),'
      '1108610=  PRICE NUMERIC(15,2),'
      '1108611=  SKIDKA_PROC NUMERIC(15,2),'
      '1108612=  SKIDKA_SUM NUMERIC(15,2),'
      '1108613=  IS_CONST INTEGER,'
      '1108614=  TOCHKA_NAME TYPE OF COLUMN G_TOCHKA.NAME)'
      '1108615=AS'
      '1108616=BEGIN'
      '1108617='
      '1108618=    FOR'
      '1108619=      SELECT GD.G_DISCOUNT, GD.G_PRODUCT, GP.NAME,'
      '1108620=             GD.DATE_BEGIN,'
      '1108621=             GD.DATE_END,'
      
        '1108622=             CASE WHEN GD.DATE_END IS NULL THEN 1 ELSE 0' +
        ' END IS_CONST,'
      
        '1108623=             GD.NAME, GD.PRICE, GD.SKIDKA_PROC, GD.SKIDK' +
        'A_SUM,'
      
        '1108624=             CASE WHEN GD.G_TOCHKA IS NULL THEN '#39#1042#1089#1077' '#1090#1086#1095 +
        #1082#1080#39' ELSE T.NAME END'
      '1108625=             ,PAR.NAME'
      
        '1108626=      FROM G_DISCOUNT GD LEFT OUTER JOIN G_TOCHKA T ON G' +
        'D.G_TOCHKA = T.G_TOCHKA,'
      '1108627=           G_PRODUCT GP,'
      '1108628=           G_PRODUCT PAR'
      
        '1108629=      WHERE ((GD.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2) AND GD.G_TOCHKA IS NOT NULL)'
      '1108630=             OR'
      '1108631=             GD.G_TOCHKA IS NULL'
      '1108632=            )'
      '1108633=        AND GD.G_PRODUCT = GP.G_PRODUCT'
      '1108634=        AND GP.G_PRODUCT_PAR = PAR.G_PRODUCT'
      '1108635=        AND ('
      '1108636=             (('
      '1108637=                ('
      
        '1108638=                  /*GD.DATE_BEGIN <= CURRENT_DATE       ' +
        '-- '#1042#1067#1043#1056#1059#1046#1040#1070#1058#1057#1071' '#1057' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1052' '#1055#1045#1056#1048#1054#1044#1054#1052
      '1108639=                  AND'
      '1108640=                  */GD.DATE_END >= CURRENT_DATE'
      '1108641=                  AND GD.DATE_BEGIN IS NOT NULL'
      '1108642=                  AND GD.DATE_END IS NOT NULL'
      '1108643=                )'
      '1108644=              OR'
      '1108645=                ('
      
        '1108646=                 GD.DATE_BEGIN IS NULL AND GD.DATE_END I' +
        'S NULL  -- '#1040' '#1058#1040#1050#1046#1045' '#1055#1054#1057#1058#1054#1071#1053#1053#1067#1045' '#1057#1050#1048#1044#1050#1048
      '1108647=                )'
      '1108648=              )'
      '1108649=              AND :IS_ALL_ = 1)'
      '1108650=             OR'
      
        '1108651=             (:IS_ALL_ = 0)                             ' +
        '        -- '#1051#1048#1041#1054' '#1042#1057#1045
      '1108652=            )'
      
        '1108653=      INTO :G_DISCOUNT, :G_PRODUCT, :G_PRODUCT_NAME, :DA' +
        'TE_BEGIN, :DATE_END, :IS_CONST, :NAME, :PRICE, :SKIDKA_PROC, :SK' +
        'IDKA_SUM,'
      '1108654=           :TOCHKA_NAME'
      '1108655=           ,:G_PRODUCT_PAR_NAME'
      '1108656=    DO'
      '1108657=      SUSPEND;'
      '1108658=end'
      '1108659=;'
      
        '1108660=UPDATE SYSTEM_SETUP SET S_VALUE = 11086 WHERE SYSTEM_SET' +
        'UP = 3;'
      
        '1108661=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1108662=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110870=ALTER PROCEDURE P_REP_BILL('
      '110871=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '110872=  SUMM_DANO_ NUMERIC(15,2),'
      '110873=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110874=  CURRENCY_ INTEGER,'
      '110875=  MODE_ INTEGER,'
      '110876=  PRINT_SLOGAN_ VARCHAR(80),'
      '110877=  DECIMAL_ INTEGER)'
      '110878=RETURNS ('
      '110879=  FIRM_NAME_ VARCHAR(600),'
      '1108710=  IDN_STR_ VARCHAR(30),'
      '1108711=  FIRM_IDN_ VARCHAR(50),'
      '1108712=  FIRM_ADDRESS_ VARCHAR(550),'
      '1108713=  NUM_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1108714=  DATE_ VARCHAR(100),'
      '1108715=  PAYMENT_TYPE_ VARCHAR(100),'
      '1108716=  G_CLIENT_NAME_ VARCHAR(300),'
      '1108717=  G_OFFICIAL_FM_ VARCHAR(300),'
      '1108718=  SUMM_VSEGO_ VARCHAR(50),'
      '1108719=  SUMM_VSEGO_N_ VARCHAR(50),'
      '1108720=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1108721=  ROW_NUM INTEGER,'
      '1108722=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      '1108723=  NAME_ART VARCHAR(1000),'
      '1108724=  AMOUNT VARCHAR(50),'
      
        '1108725=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      '1108726=  PRICE VARCHAR(50),'
      '1108727=  PRICE_N VARCHAR(50),'
      '1108728=  SUMM VARCHAR(50),'
      '1108729=  SUMM_N VARCHAR(50),'
      '1108730=  SUMM_POLUCH_ VARCHAR(50),'
      '1108731=  SUMM_SDACH_ VARCHAR(50),'
      '1108732=  SUMM_STR_ VARCHAR(200),'
      '1108733=  SLOGAN_ VARCHAR(80),'
      '1108734=  SUMM_SKIDKA_ VARCHAR(50),'
      '1108735=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '1108736=  ERR_CODE NUMERIC(15,2),'
      '1108737=  ERR_MSG VARCHAR(1024))'
      '1108738=AS'
      '1108739=BEGIN'
      '1108740=  SUSPEND;'
      '1108741=END'
      '1108742=;'
      '1108743='
      '1108744='
      
        '1108745=/*******************************************************' +
        '***********************/'
      
        '1108746=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1108747=/*******************************************************' +
        '***********************/'
      '1108748=ALTER PROCEDURE P_REP_BILL('
      '1108749=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1108750=  SUMM_DANO_ NUMERIC(15,2),'
      '1108751=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1108752=  CURRENCY_ INTEGER,'
      '1108753=  MODE_ INTEGER,'
      '1108754=  PRINT_SLOGAN_ VARCHAR(80),'
      '1108755=  DECIMAL_ INTEGER)'
      '1108756=RETURNS ('
      '1108757=  FIRM_NAME_ VARCHAR(600),'
      '1108758=  IDN_STR_ VARCHAR(30),'
      '1108759=  FIRM_IDN_ VARCHAR(50),'
      '1108760=  FIRM_ADDRESS_ VARCHAR(550),'
      '1108761=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1108762=  DATE_ VARCHAR(100),'
      '1108763=  PAYMENT_TYPE_ VARCHAR(100),'
      '1108764=  G_CLIENT_NAME_ VARCHAR(300),'
      '1108765=  G_OFFICIAL_FM_ VARCHAR(300),'
      '1108766=  SUMM_VSEGO_ VARCHAR(50),'
      '1108767=  SUMM_VSEGO_N_ VARCHAR(50),'
      '1108768=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1108769=  ROW_NUM INTEGER,'
      '1108770=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1108771=  NAME_ART VARCHAR(1000),'
      '1108772=  AMOUNT VARCHAR(50),'
      '1108773=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1108774=  PRICE VARCHAR(50),'
      '1108775=  PRICE_N VARCHAR(50),'
      '1108776=  SUMM VARCHAR(50),'
      '1108777=  SUMM_N VARCHAR(50),'
      '1108778=  SUMM_POLUCH_ VARCHAR(50),'
      '1108779=  SUMM_SDACH_ VARCHAR(50),'
      '1108780=  SUMM_STR_ VARCHAR(200),'
      '1108781=  SLOGAN_ VARCHAR(80),'
      '1108782=  SUMM_SKIDKA_ VARCHAR(50),'
      '1108783=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1108784=  ERR_CODE NUMERIC(15,2),'
      '1108785=  ERR_MSG VARCHAR(1024))'
      '1108786=AS'
      '1108787=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '1108788=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '1108789=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1108790=DECLARE VARIABLE I INTEGER = 1;'
      
        '1108791=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_' +
        'REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1108792=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '1108793=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.AMOUNT;'
      
        '1108794=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_NONCASH;'
      
        '1108795=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CA' +
        'SH;'
      '1108796=BEGIN'
      '1108797=  SLOGAN_ = PRINT_SLOGAN_;'
      '1108798='
      '1108799=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '11087100=  SELECT z.ZAKAZ'
      '11087101=         ,P.NAME'
      
        '11087102=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR ' +
        'FROM Z.Z_DATE)||'#39'  '#39'||EXTRACT(HOUR FROM Z.Z_TIME)||'#39':'#39'||EXTRACT(' +
        'MINUTE FROM Z.Z_TIME)'
      '11087103=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '11087104=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COALE' +
        'SCE(O.NM, '#39#39')'
      '11087105=         ,Z.summ_noncash'
      '11087106=         ,Z.summ_cash'
      '11087107=         ,Z.NOTE'
      
        '11087108=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_OF' +
        'FICIAL = O.G_OFFICIAL,'
      '11087109=         G_CLIENT G,'
      '11087110=         G_PAYMENT_TYPE P'
      '11087111=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11087112=     AND Z.G_CLIENT = G.G_CLIENT'
      '11087113=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11087114=    INTO :NUM_'
      '11087115=        ,:PAYMENT_TYPE_'
      '11087116=        ,:DATE_'
      '11087117=        ,:G_CLIENT_NAME_'
      '11087118=        ,:G_OFFICIAL_FM_'
      '11087119=        ,:SUMM_NONCASH_'
      '11087120=        ,:SUMM_CASH_'
      '11087121=        ,:NOTE_'
      '11087122=        ;'
      '11087123='
      '11087124=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '11087125=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '11087126='
      '11087127=  SELECT R.G_FIRM_REKVIZIT,'
      '11087128=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '11087129=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088#1075 +
        '.: '#39'||COALESCE(R.IDN, '#39#39')'
      '11087130=    FROM G_FIRM_REKVIZIT R'
      '11087131=   WHERE R.is_default = 1'
      '11087132=    INTO :G_FIRM_REKVIZIT_,'
      '11087133=         :FIRM_NAME_,'
      '11087134=         :FIRM_IDN_;'
      '11087135='
      '11087136=  SELECT SUM(ZD.AMOUNT),'
      '11087137=         CAST(SUM(ZD.DISCOUNT_SUMM) AS VARCHAR(100)),'
      
        '11087138=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2)' +
        ' AS VARCHAR(100)),'
      '11087139=         CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '11087140=  FROM ZAKAZ_DETAILS ZD'
      '11087141=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '11087142=  INTO :AMOUNT_VSEGO_NUM_,'
      '11087143=       :SUMM_SKIDKA_,'
      '11087144=       :SUMM_VSEGO_,'
      '11087145=       :SUMM_VSEGO_N_;'
      '11087146='
      '11087147=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '11087148=    FROM G_FIRM_ADDRESS R'
      '11087149=   WHERE R.IS_DEFAULT = 1'
      '11087150=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '11087151=    INTO :FIRM_ADDRESS_;'
      '11087152='
      
        '11087153=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048#1053 +
        #1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '11087154=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39')' +
        ';'
      '11087155=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '11087156=    IF (CURRENCY_ = 0) THEN'
      '11087157=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '11087158=    ELSE'
      '11087159=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '11087160=  END'
      '11087161='
      '11087162=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '11087163='
      
        '11087164=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(1' +
        '00));'
      
        '11087165=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHAR' +
        '(100));'
      '11087166='
      '11087167=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '11087168=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '11087169=  INTO :SUMM_STR_;'
      '11087170='
      '11087171=  FOR'
      '11087172=    SELECT :I,'
      '11087173=           G.NAME,'
      
        '11087174=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39', '#39 +
        #39'),'
      '11087175=           ZD.AMOUNT,'
      '11087176=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '11087177=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) AS' +
        ' VARCHAR(100))'
      '11087178=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '11087179=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE,' +
        ' 0) AS VARCHAR(100))'
      '11087180=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '11087181=      FROM ZAKAZ Z,'
      '11087182=           ZAKAZ_DETAILS ZD,'
      '11087183=           G_PRODUCT G,'
      '11087184=           G_UNIT U'
      '11087185=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '11087186=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11087187=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11087188=       AND G.G_UNIT = U.G_UNIT'
      '11087189=     ORDER BY ZD.zakaz_details'
      '11087190=    INTO :ROW_NUM,'
      '11087191=        :NAME,'
      '11087192=        :NAME_ART,'
      '11087193=        :AMOUNT_NUM_,'
      '11087194=        :PRICE,'
      '11087195=        :SUMM'
      '11087196=        ,:SHORT_NAME'
      '11087197=        ,:PRICE_N'
      '11087198=        ,:SUMM_N'
      '11087199=  DO BEGIN'
      '11087200=    I = I + 1;'
      '11087201='
      
        '11087202=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' '#1055 +
        #1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '11087203=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '11087204=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FOR' +
        ' POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '11087205=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '11087206=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '11087207=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '11087208=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN PRICE)-1);'
      '11087209=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '11087210=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE_N)-1);'
      '11087211=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '11087212=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSITI' +
        'ON('#39'.00'#39' IN SUMM)-1);'
      '11087213=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '11087214=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM_N)-1);'
      '11087215=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '11087216=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '11087217=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '11087218=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FOR' +
        ' POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '11087219='
      '11087220=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '11087221=    IF (DECIMAL_ = 2) THEN BEGIN'
      '11087222=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '11087223=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,2));'
      '11087224=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '11087225=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '11087226=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,3));'
      '11087227=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '11087228=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '11087229=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,4));'
      '11087230=    END ELSE BEGIN'
      '11087231=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '11087232=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,5));'
      '11087233=    END'
      '11087234='
      
        '11087235=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT' +
        ') > 0) then'
      
        '11087236=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POSI' +
        'TION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '11087237='
      
        '11087238=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT' +
        '_VSEGO_) > 0) then'
      
        '11087239=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 F' +
        'OR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '11087240='
      '11087241=    SUSPEND;'
      '11087242=  END'
      '11087243=WHEN ANY DO BEGIN'
      '11087244=    Err_code = -20500;'
      
        '11087245=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11087246=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11087247=  END'
      '11087248=end'
      '11087249=;'
      
        '11087250=UPDATE SYSTEM_SETUP SET S_VALUE = 11087 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11087251=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11087252=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110880=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110881=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110882=  INCLUDE_NOL_ INTEGER,'
      '110883=  INCLUDE_FEW_ INTEGER,'
      '110884=  SORT_BY_NAME_ INTEGER,'
      
        '110885=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGINT' +
        ','
      '110886=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110887=RETURNS ('
      '110888=  PERIOD_ VARCHAR(40),'
      '110889=  ROW_NUM VARCHAR(15),'
      '1108810=  ARTICUL VARCHAR(1000),'
      '1108811=  BARCODE VARCHAR(30),'
      
        '1108812=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      '1108813=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1108814=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50)' +
        ','
      
        '1108815=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15,' +
        '2),'
      
        '1108816=  VOLUME_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE ' +
        '*/ NUMERIC(15,2),'
      
        '1108817=  SKIDKA_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE ' +
        '*/ NUMERIC(15,2),'
      
        '1108818=  AMOUNT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT */ NU' +
        'MERIC(18,5),'
      
        '1108819=  AMOUNT_RESERVE /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE */ NUMERIC(18,5),'
      '1108820=  SUMM /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2),'
      
        '1108821=  PRICE_SELF /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(15' +
        ',2),'
      
        '1108822=  SUMM_SELF /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2' +
        '),'
      '1108823=  TOVAR_NAME VARCHAR(250),'
      
        '1108824=  CROSSCODE /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ BLO' +
        'B SUB_TYPE 1 SEGMENT SIZE 16384,'
      '1108825=  NOTE /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300),'
      
        '1108826=  IS_CATEGORY /* TYPE OF COLUMN G_PRODUCT.IS_CATEGORY */' +
        ' INTEGER,'
      '1108827=  ERR_CODE INTEGER,'
      '1108828=  ERR_MSG VARCHAR(1024))'
      '1108829=AS'
      '1108830=BEGIN'
      '1108831=  SUSPEND;'
      '1108832=END'
      '1108833=;'
      '1108834='
      '1108835='
      
        '1108836=/*******************************************************' +
        '***********************/'
      
        '1108837=/****                           Altering tables         ' +
        '                   ****/'
      
        '1108838=/*******************************************************' +
        '***********************/'
      '1108839='
      '1108840=ALTER TABLE P_REP_PRICE_LIST_TABLE'
      '1108841=  ADD PLACE DM_VARCHAR_250;'
      '1108842='
      '1108843='
      
        '1108844=/*******************************************************' +
        '***********************/'
      
        '1108845=/****                      Updating column positions    ' +
        '                   ****/'
      
        '1108846=/*******************************************************' +
        '***********************/'
      
        '1108847=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN P_REP_PR' +
        'ICE_LIST_TABLE POSITION 1;'
      '1108848='
      
        '1108849=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN ARTICUL ' +
        'POSITION 2;'
      '1108850='
      
        '1108851=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN BARCODE ' +
        'POSITION 3;'
      '1108852='
      
        '1108853=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN NOMENCLA' +
        'TUR_NUM POSITION 4;'
      '1108854='
      
        '1108855=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN NAME POS' +
        'ITION 5;'
      '1108856='
      
        '1108857=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN UNIT_NAM' +
        'E POSITION 6;'
      '1108858='
      
        '1108859=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN PRICE PO' +
        'SITION 7;'
      '1108860='
      
        '1108861=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN VOLUME_P' +
        'RICE POSITION 8;'
      '1108862='
      
        '1108863=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN SKIDKA_P' +
        'RICE POSITION 9;'
      '1108864='
      
        '1108865=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN AMOUNT P' +
        'OSITION 10;'
      '1108866='
      
        '1108867=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN AMOUNT_R' +
        'ESERVE POSITION 11;'
      '1108868='
      
        '1108869=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN SUMM POS' +
        'ITION 12;'
      '1108870='
      
        '1108871=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN PRICE_SE' +
        'LF POSITION 13;'
      '1108872='
      
        '1108873=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN SUMM_SEL' +
        'F POSITION 14;'
