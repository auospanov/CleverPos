        'ONCASH_SUMM_) SUMM'
      '1102122070=          FROM RDB$DATABASE'
      '1102122071=        UNION'
      '1102122072=        SELECT 18 COL,'
      '1102122073=               '#39'  '#1042#1053#1045#1057#1045#1053#1048#1045#39' STR,'
      '1102122074=               '#39'*'#39'||:VNESENIE_AMOUNT_ AMOUNT,'
      '1102122075=               '#39'='#39'||:VNESENIE_SUMM_ SUMM'
      '1102122076=          FROM RDB$DATABASE'
      '1102122077=        UNION'
      '1102122078=        SELECT 19 COL,'
      '1102122079=               '#39'  '#1048#1047#1066#1071#1058#1048#1045#39' STR,'
      '1102122080=               '#39'*'#39'||:IZYATIE_AMOUNT_ AMOUNT,'
      '1102122081=               '#39'='#39'||:IZYATIE_SUMM_ SUMM'
      '1102122082=          FROM RDB$DATABASE'
