        '_'
      '110752624=                         AND SK.IS_LAST = 1'
      '110752625=                         AND SK.G_TOCHKA = :G_CLIENT_;'
      '110752626='
      '110752627=                      UPDATE SKLAD SK'
      '110752628=                         SET SK.IS_LAST = 1'
      
        '110752629=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
