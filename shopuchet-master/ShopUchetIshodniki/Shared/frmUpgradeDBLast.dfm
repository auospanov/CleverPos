        '110236248=/*****************************************************' +
        '*************************/'
      
        '110236249=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110236250=/*****************************************************' +
        '*************************/'
      '110236251=ALTER PROCEDURE G_NONCASH_PAY_TYPE_GET('
      
        '110236252=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE)'
      '110236253=RETURNS ('
      '110236254=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110236255=  IS_ACTIVE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_ACTI' +
        'VE,'
      
        '110236256=  IS_TIS_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_TI' +
        'S_TYPE)'
      '110236257=AS'
      '110236258=BEGIN'
      '110236259=  SELECT NAME,'
      '110236260=         IS_ACTIVE,'
      '110236261=         IS_TIS_TYPE'
      '110236262=    FROM G_NONCASH_PAY_TYPE'
      '110236263=  WHERE (G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_)'
      '110236264=  INTO :NAME_,'
      '110236265=       :IS_ACTIVE_,'
      '110236266=       :IS_TIS_TYPE_;'
      '110236267=END'
      '110236268=;'
      '110236269='
      '110236270=ALTER PROCEDURE G_NONCASH_PAY_TYPE_INS('
      '110236271=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110236272=  IS_TIS_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_TI' +
        'S_TYPE = 0)'
      '110236273=RETURNS ('
      
        '110236274=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE)'
      '110236275=AS'
      '110236276=BEGIN'
      '110236277=  INSERT INTO G_NONCASH_PAY_TYPE ('
      '110236278=    G_NONCASH_PAY_TYPE,'
      '110236279=    NAME, IS_TIS_TYPE)'
      '110236280=  VALUES ('
      '110236281=    GEN_ID(GEN_G_NONCASH_PAY_TYPE, 1),'
      '110236282=    :NAME_, :IS_TIS_TYPE_'
      '110236283=  )'
      '110236284=  RETURNING'
      '110236285=    G_NONCASH_PAY_TYPE'
      '110236286=  INTO'
      '110236287=    :G_NONCASH_PAY_TYPE_;'
      '110236288=END'
      '110236289=;'
      '110236290='
      '110236291=ALTER PROCEDURE G_NONCASH_PAY_TYPE_READ'
      '110236292=RETURNS ('
      
        '110236293=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE,'
      '110236294=  NAME TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110236295=  IS_ACTIVE TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_ACTIV' +
        'E,'
      
        '110236296=  IS_TIS_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_TIS' +
        '_TYPE)'
      '110236297=AS'
      '110236298=BEGIN'
      '110236299=  FOR SELECT G_NONCASH_PAY_TYPE,'
      '110236300=             NAME,'
      '110236301=             IS_ACTIVE,'
      '110236302=             IS_TIS_TYPE'
      '110236303=      FROM G_NONCASH_PAY_TYPE'
      '110236304=      WHERE IS_ACTIVE = 1'
      '110236305=      INTO :G_NONCASH_PAY_TYPE,'
      '110236306=           :NAME,'
      '110236307=           :IS_ACTIVE,'
      '110236308=           :IS_TIS_TYPE'
      '110236309=  DO'
      '110236310=  BEGIN'
      '110236311=    SUSPEND;'
      '110236312=  END'
      '110236313=END'
      '110236314=;'
      '110236315='
      '110236316=ALTER PROCEDURE G_NONCASH_PAY_TYPE_UPD('
      
        '110236317=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      '110236318=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110236319=  IS_TIS_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_TI' +
        'S_TYPE)'
      '110236320=AS'
      '110236321=BEGIN'
      '110236322=  UPDATE G_NONCASH_PAY_TYPE'
      '110236323=  SET NAME = :NAME_, IS_TIS_TYPE = :IS_TIS_TYPE_'
      '110236324=  WHERE (G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_);'
      '110236325=END'
      '110236326=;'
      '110236327='
      '110236328=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '110236329=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      '110236330=  IS_SUPPLIER_ INTEGER = null)'
      '110236331=RETURNS ('
      '110236332=  G_CLIENT TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110236333=  G_CLIENT_PARENT TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      
        '110236334=  G_CONTRAGENT TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGEN' +
        'T,'
      '110236335=  NAME VARCHAR(500),'
      '110236336=  RNN VARCHAR(12),'
      '110236337=  IDN VARCHAR(12),'
      '110236338=  KBE VARCHAR(5),'
      '110236339=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '110236340=  SKIDKA NUMERIC(15,2),'
      '110236341=  IS_SUPPLIER INTEGER,'
      '110236342=  BY_DEFAULT INTEGER,'
      '110236343=  IS_BEZNAL INTEGER,'
      '110236344=  IS_SUPPLIER_STR VARCHAR(50),'
      
        '110236345=  SUPPL_AGENT_NAME TYPE OF COLUMN G_CONTRAGENT.SHORT_N' +
        'AME,'
      
        '110236346=  G_DISCONT_CARD TYPE OF COLUMN G_DISCONT_CARD.G_DISCO' +
        'NT_CARD,'
      '110236347=  BARCODE TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110236348=  N_PERCENT TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110236349=  SUMM TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110236350=  SUMM_ALL TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110236351=  NOTE TYPE OF COLUMN G_CLIENT.NOTE,'
      '110236352=  SUMM_DOLG TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110236353=  NAME_WITH_DOLG VARCHAR(500),'
      '110236354=  G_PROMOTION_STR TYPE OF COLUMN G_PROMOTION.NAME,'
      
        '110236355=  MAX_BONUS_PAY_SUMM TYPE OF COLUMN G_CLIENT.MAX_BONUS' +
        '_PAY_SUMM,'
      '110236356=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110236357=  NAME_PHONE_ VARCHAR(550))'
      '110236358=AS'
      '110236359=begin'
      '110236360=  FOR'
      '110236361=    SELECT T.g_client,'
      '110236362=           T.g_client_parent,'
      '110236363=           T.g_contragent,'
      '110236364=           T.name,'
      '110236365=           T.rnn,'
      '110236366=           T.idn,'
      '110236367=           T.KBE,'
      '110236368=           T.PHONE,'
      '110236369=           T.SKIDKA,'
      '110236370=           T.is_supplier,'
      '110236371=           T.BY_DEFAULT,'
      '110236372=           T.IS_BEZNAL,'
      '110236373=           CASE T.is_supplier'
      '110236374=             WHEN 0 THEN '#39#1050#1083#1080#1077#1085#1090#39
      '110236375=             WHEN 1 THEN '#39#1055#1086#1089#1090#1072#1074#1097#1080#1082#39
      '110236376=           END IS_SUPPLIER_STR,'
      '110236377=           GC.SHORT_NAME,'
      '110236378=           COALESCE(D.G_DISCONT_CARD, 0),'
      '110236379=           D.BARCODE,'
      '110236380=           D.N_PERCENT,'
      '110236381=           D.SUMM,'
      '110236382=           D.SUMM_ALL,'
      '110236383=           T.NOTE'
      '110236384=           ,COALESCE(Z.SUMM_DOLG, 0)'
      
        '110236385=           ,T.name || COALESCE('#39' ('#1044#1054#1051#1043' '#39' || Z.SUMM_DOL' +
        'G || '#39')'#39', '#39#39') NAME_WITH_DOLG'
      '110236386=           ,P.NAME NAME_PROMO'
      '110236387=           ,T.MAX_BONUS_PAY_SUMM'
      '110236388=           ,GA.ADDRESS'
      
        '110236389=           ,(CASE WHEN T.NAME IS NULL THEN '#39#39' ELSE T.N' +
        'AME END)||(CASE WHEN T.PHONE IS NULL THEN '#39#39' ELSE '#39' ('#39'||T.PHONE|' +
        '|'#39')'#39' END) NAME_PHONE'
      
        '110236390=    FROM g_client t LEFT OUTER JOIN G_DISCONT_CARD D O' +
        'N T.G_CLIENT = D.G_CLIENT'
      
        '110236391=                    LEFT OUTER JOIN (SELECT SUM(SUMM -' +
        ' SUMM_FACT - SUMM_BONUS) SUMM_DOLG ,G_CLIENT FROM ZAKAZ WHERE IS' +
        '_PAYED_ALL = 0 GROUP BY G_CLIENT) Z ON T.G_CLIENT = Z.G_CLIENT'
      
        '110236392=                    LEFT OUTER JOIN G_PROMOTION P ON T' +
        '.g_promotion = P.g_promotion'
      
        '110236393=                    LEFT OUTER JOIN G_ADDRESS GA ON T.' +
        'G_CLIENT = GA.G_CLIENT AND GA.IS_DEFAULT = 1'
      '110236394=         ,G_CONTRAGENT GC'
      
        '110236395=    WHERE T.G_CLIENT_PARENT = COALESCE(:G_CLIENT_PAREN' +
        'T_, T.G_CLIENT_PARENT)  -- '#1048#1053#1054#1043#1044#1040' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      '110236396=     AND T.IS_CATEGORY = 0'
      '110236397=     AND T.G_CONTRAGENT = GC.G_CONTRAGENT'
      
        '110236398=     AND T.is_supplier = COALESCE(:IS_SUPPLIER_, T.IS_' +
        'SUPPLIER)'
      
        '110236399=     AND COALESCE(:G_CLIENT_PARENT_, 0) <> -1000      ' +
        '         -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110236400=   UNION ALL'
      '110236401=    SELECT T.G_TOCHKA g_client,'
      '110236402=           0 g_client_parent,'
      '110236403=           0 g_contragent,'
      '110236404=           T.name,'
      '110236405=           '#39#39' rnn,'
      '110236406=           '#39#39' idn,'
      '110236407=           '#39#39' KBE,'
      '110236408=           '#39#39' PHONE,'
      '110236409=           0 SKIDKA,'
      '110236410=           0 is_supplier,'
      '110236411=           0 BY_DEFAULT,'
      '110236412=           0 IS_BEZNAL,'
      '110236413=           '#39#1057#1082#1083#1072#1076#39' IS_SUPPLIER_STR,'
      '110236414=           '#39#39' SHORT_NAME,'
      '110236415=           0,'
      '110236416=           '#39#39' BARCODE,'
      '110236417=           0 N_PERCENT,'
      '110236418=           0 SUMM,'
      '110236419=           0 SUMM_ALL,'
      '110236420=           '#39#39' NOTE'
      '110236421=           ,0 SUMM_DOLG'
      '110236422=           ,'#39#39' NAME_WITH_DOLG'
      '110236423=           ,'#39#39' NAME_PROMO'
      '110236424=           ,0 MAX_BONUS_PAY_SUMM'
      '110236425=           ,'#39#39' ADDRESS'
      '110236426=           ,T.NAME NAME_PHONE'
      '110236427=    FROM G_TOCHKA T'
      
        '110236428=   WHERE T.G_TOCHKA <> (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      
        '110236429=     AND COALESCE(:G_CLIENT_PARENT_, 0) = -1000       ' +
        '        -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110236430=   ORDER BY 4'
      
        '110236431=    into :G_CLIENT, :G_CLIENT_PARENT, :G_CONTRAGENT, :' +
        'NAME, :RNN, :IDN, :KBE, :PHONE, :SKIDKA, :IS_SUPPLIER, :BY_DEFAU' +
        'LT,'
      
        '110236432=         :IS_BEZNAL, :IS_SUPPLIER_STR, :SUPPL_AGENT_NA' +
        'ME,'
      '110236433=         :G_DISCONT_CARD,'
      '110236434=         :BARCODE,'
      '110236435=         :N_PERCENT,'
      '110236436=         :SUMM,'
      '110236437=         :SUMM_ALL, :NOTE'
      '110236438=         ,:SUMM_DOLG'
      '110236439=         ,:NAME_WITH_DOLG'
      '110236440=         ,:G_PROMOTION_STR'
      '110236441=         ,:MAX_BONUS_PAY_SUMM'
      '110236442=         ,:ADDRESS'
      '110236443=         ,:NAME_PHONE_'
      '110236444=  DO'
      '110236445=    suspend;'
      '110236446=end'
      '110236447=;'
      '110236448='
      '110236449=ALTER PROCEDURE P_REP_BILL('
      '110236450=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110236451=  SUMM_DANO_ NUMERIC(15,2),'
      '110236452=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110236453=  CURRENCY_ INTEGER,'
      '110236454=  MODE_ INTEGER,'
      '110236455=  PRINT_SLOGAN_ VARCHAR(80),'
      '110236456=  DECIMAL_ INTEGER,'
      '110236457=  BONUS_ NUMERIC(15,2),'
      '110236458=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110236459=  BONUS_ALL_ NUMERIC(15,2) = 0)'
      '110236460=RETURNS ('
      '110236461=  FIRM_NAME_ VARCHAR(600),'
      '110236462=  IDN_STR_ VARCHAR(30),'
      '110236463=  FIRM_IDN_ VARCHAR(50),'
      '110236464=  FIRM_ADDRESS_ VARCHAR(550),'
      '110236465=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110236466=  DATE_ VARCHAR(100),'
      '110236467=  PAYMENT_TYPE_ VARCHAR(100),'
      '110236468=  G_CLIENT_NAME_ VARCHAR(300),'
      '110236469=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110236470=  SUMM_VSEGO_ VARCHAR(50),'
      '110236471=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110236472=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110236473=  ROW_NUM INTEGER,'
      '110236474=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110236475=  NAME_ART VARCHAR(1000),'
      '110236476=  AMOUNT VARCHAR(50),'
      '110236477=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110236478=  PRICE VARCHAR(50),'
      '110236479=  PRICE_N VARCHAR(50),'
      '110236480=  SUMM VARCHAR(50),'
      '110236481=  SUMM_N VARCHAR(50),'
      '110236482=  SUMM_POLUCH_ VARCHAR(50),'
      '110236483=  SUMM_SDACH_ VARCHAR(50),'
      '110236484=  SUMM_STR_ VARCHAR(200),'
      '110236485=  SLOGAN_ VARCHAR(80),'
      '110236486=  SUMM_SKIDKA_ VARCHAR(50),'
      '110236487=  SUMM_SERVICE_ VARCHAR(50),'
      '110236488=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110236489=  BONUS_STR_ VARCHAR(100),'
      '110236490=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110236491=  ERR_CODE NUMERIC(15,2),'
      '110236492=  ERR_MSG VARCHAR(1024),'
      '110236493=  NAME_MARKER VARCHAR(1000),'
      '110236494=  BONUSALL_STR_ VARCHAR(100))'
      '110236495=AS'
      '110236496=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '110236497=declare variable PROCNAME varchar(30) = '#39'P_REP_BILL'#39';'
      '110236498=declare variable PNT_ varchar(5);'
      '110236499=declare variable I integer = 1;'
      
        '110236500=declare variable G_FIRM_REKVIZIT_ type of column G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110236501=declare variable AMOUNT_NUM_ type of column ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110236502=declare variable AMOUNT_VSEGO_NUM_ type of column ZAKA' +
        'Z_DETAILS.AMOUNT;'
      
        '110236503=declare variable SUMM_NONCASH_ type of column ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110236504=declare variable SUMM_CASH_ type of column ZAKAZ.SUMM_' +
        'CASH;'
      
        '110236505=declare variable SERVICE_SUMM_ type of column ZAKAZ_DE' +
        'TAILS.SUMM;'
      '110236506=BEGIN'
      '110236507=  SLOGAN_ = PRINT_SLOGAN_;'
      '110236508=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '110236509=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '110236510=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_' +
        ';'
      '110236511=  END'
      '110236512='
      '110236513=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110236514=  SELECT z.ZAKAZ'
      '110236515=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '110236516=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')' +
        '||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '110236517=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '110236518=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COAL' +
        'ESCE(O.NM, '#39#39')'
      '110236519=         ,Z.summ_noncash'
      '110236520=         ,Z.summ_cash'
      '110236521=         ,Z.NOTE'
      
        '110236522=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '110236523=         G_CLIENT G,'
      '110236524=         G_PAYMENT_TYPE P'
      '110236525=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110236526=     AND Z.G_CLIENT = G.G_CLIENT'
      '110236527=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110236528=    INTO :NUM_'
      '110236529=        ,:PAYMENT_TYPE_'
      '110236530=        ,:DATE_'
      '110236531=        ,:G_CLIENT_NAME_'
      '110236532=        ,:G_OFFICIAL_FM_'
      '110236533=        ,:SUMM_NONCASH_'
      '110236534=        ,:SUMM_CASH_'
      '110236535=        ,:NOTE_'
      '110236536=        ;'
      '110236537='
      '110236538=  --'#1041#1054#1053#1059#1057#1067' '#1042' '#1063#1045#1050#1045
      '110236539=  IF (BONUS_ > 0) THEN'
      '110236540=  BEGIN'
      
        '110236541=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_, 2) AS VARCHAR(100));'
      '110236542=  END'
      '110236543='
      '110236544=  if (BONUS_ALL_ > 0) then'
      '110236545=  BEGIN'
      
        '110236546=    BONUSALL_STR_ = '#39#1053#1072#1082#1086#1087#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUN' +
        'D(BONUS_ALL_, 2) AS VARCHAR(100));'
      '110236547=  END'
      '110236548='
      '110236549=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110236550=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110236551=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110236552='
      '110236553=  SELECT R.G_FIRM_REKVIZIT,'
      '110236554=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110236555=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110236556=    FROM G_FIRM_REKVIZIT R'
      '110236557=   WHERE R.is_default = 1'
      '110236558=    INTO :G_FIRM_REKVIZIT_,'
      '110236559=         :FIRM_NAME_,'
      '110236560=         :FIRM_IDN_;'
      '110236561='
      '110236562=  SELECT ZD.SUMM'
      '110236563=    FROM ZAKAZ_DETAILS ZD'
      '110236564=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110236565=    AND ZD.G_PRODUCT = -2'
      '110236566=    INTO :SERVICE_SUMM_;'
      '110236567=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110236568='
      '110236569=  SELECT SUM(ZD.AMOUNT),'
      
        '110236570=         CAST(ROUND(SUM((CASE WHEN ZD.DISCOUNT_SUMM>0 ' +
        'THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)),'
      
        '110236571=         CAST(ROUND(SUM(ZD.SUMM + (CASE WHEN ZD.DISCOU' +
        'NT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50))' +
        ','
      
        '110236572=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110236573=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '110236574=  FROM ZAKAZ_DETAILS ZD'
      '110236575=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110236576=    AND ZD.G_PRODUCT <> -2'
      '110236577=  INTO :AMOUNT_VSEGO_NUM_,'
      '110236578=       :SUMM_SKIDKA_,'
      '110236579=       :SUMM_VSEGO_,'
      '110236580=       :SUMM_VSEGO_N_,'
      '110236581=       :SUMM_SERVICE_;'
      '110236582='
      '110236583=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110236584=    FROM G_FIRM_ADDRESS R'
      '110236585=   WHERE R.IS_DEFAULT = 1'
      '110236586=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110236587=    INTO :FIRM_ADDRESS_;'
      '110236588='
      
        '110236589=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110236590=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110236591=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110236592=    IF (CURRENCY_ = 0) THEN'
      '110236593=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110236594=    ELSE'
      '110236595=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110236596=  END'
      '110236597='
      '110236598=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110236599='
      
        '110236600=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110236601=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110236602='
      '110236603=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110236604=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110236605=  INTO :SUMM_STR_;'
      '110236606='
      '110236607=  FOR'
      '110236608=    SELECT :I,'
      '110236609=           G.NAME,'
      
        '110236610=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.MA' +
        'RK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||Z' +
        'D.MARK_CODE END),'
      
        '110236611=           (CASE WHEN (G.ARTICUL is null) or (G.ARTICU' +
        'L = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '110236612=           ZD.AMOUNT,'
      
        '110236613=           CAST(ROUND(ZD.PRICE - (CASE WHEN ZD.DISCOUN' +
        'T_SUMM<0 THEN ZD.DISCOUNT_SUMM else 0 END)/ZD.AMOUNT, 2) AS VARC' +
        'HAR(100)),'
      
        '110236614=           CAST(ROUND(ZD.SUMM + (CASE WHEN ZD.DISCOUNT' +
        '_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END) , 2) AS VARCHAR(100))'
      '110236615=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110236616=           ,CAST(ZD.PRICE - COALESCE((CASE WHEN ZD.DIS' +
        'COUNT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END), 0) AS VARCHAR(10' +
        '0))'
      '110236617=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110236618=      FROM ZAKAZ Z,'
      '110236619=           ZAKAZ_DETAILS ZD,'
      '110236620=           G_PRODUCT G,'
      '110236621=           G_UNIT U'
      '110236622=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110236623=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110236624=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110236625=       AND G.G_UNIT = U.G_UNIT'
      '110236626=       AND G.G_PRODUCT <> -2'
      '110236627=     ORDER BY ZD.zakaz_details'
      '110236628=    INTO :ROW_NUM,'
      '110236629=        :NAME,'
      '110236630=        :NAME_MARKER,'
      '110236631=        :NAME_ART,'
      '110236632=        :AMOUNT_NUM_,'
      '110236633=        :PRICE,'
      '110236634=        :SUMM'
      '110236635=        ,:SHORT_NAME'
      '110236636=        ,:PRICE_N'
      '110236637=        ,:SUMM_N'
      '110236638='
      '110236639=  DO BEGIN'
      '110236640=    I = I + 1;'
      '110236641='
      
        '110236642=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110236643=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110236644=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110236645=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110236646=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110236647=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110236648=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110236649=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110236650=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110236651=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110236652=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110236653=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110236654=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110236655=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110236656=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110236657=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110236658=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110236659=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110236660=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110236661=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110236662=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110236663=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110236664=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);'
      '110236665='
      '110236666=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110236667=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110236668=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110236669=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110236670=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110236671=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110236672=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110236673=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110236674=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110236675=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110236676=    END ELSE BEGIN'
      '110236677=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110236678=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110236679=    END'
      '110236680='
      
        '110236681=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110236682=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110236683='
      
        '110236684=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110236685=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110236686='
      '110236687=    SUSPEND;'
      '110236688=  END'
      '110236689=WHEN ANY DO BEGIN'
      '110236690=    Err_code = -20500;'
      
        '110236691=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110236692=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110236693=  END'
      '110236694=end'
      '110236695=;'
      '110236696='
      '110236697=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '110236698=  DATE_BEGIN_ DATE,'
      '110236699=  DATE_END_ DATE,'
      '110236700=  IS_SPISANIE_ INTEGER,'
      '110236701=  SALE_OF_GOODS_ INTEGER)'
      '110236702=RETURNS ('
      '110236703=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110236704=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110236705=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110236706=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110236707=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110236708=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110236709=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110236710=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '110236711=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110236712=  DETAILS_STR VARCHAR(3000),'
      '110236713=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110236714=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110236715=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '110236716=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '110236717=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '110236718=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110236719=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110236720=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110236721=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110236722=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110236723=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110236724=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110236725=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110236726=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110236727=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110236728=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      
        '110236729=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE,'
      
        '110236730=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PAY' +
        '_TYPE.NAME,'
      '110236731=  BONUSALL TYPE OF COLUMN G_DISCONT_CARD.SUMM)'
      '110236732=AS'
      '110236733=/*'
      '110236734=IS_SPISANIE_'
      '110236735=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110236736=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110236737=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110236738=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110236739=*/'
      '110236740=declare variable CNT_ integer = 0;'
      
        '110236741=declare variable G_OFFICIAL_LOCAL_ type of column G_OF' +
        'FICIAL.G_OFFICIAL;'
      
        '110236742=declare variable G_OFFICIAL_APPOINT_ type of column G_' +
        'OFFICIAL.IS_ISPOLNITEL;'
      '110236743=BEGIN'
      '110236744=  sale_of_goods_ = COALESCE(sale_of_goods_, 0);'
      '110236745=  if (sale_of_goods_ = 0) then'
      '110236746=  begin'
      '110236747=    G_OFFICIAL_LOCAL_ = 0;'
      '110236748=    G_OFFICIAL_APPOINT_ = 0;'
      '110236749=  end'
      '110236750=  else'
      '110236751=  begin'
      '110236752=      SELECT G.G_OFFICIAL,'
      '110236753=             G.IS_RUKOVODITEL + G.IS_GLAVBUH'
      '110236754=        FROM CUR_PARAMS C,'
      '110236755=             G_OFFICIAL G'
      '110236756=       WHERE C.ID = G.G_OFFICIAL'
      '110236757=         AND C.CUR_PARAMS = 1'
      '110236758=        INTO :G_OFFICIAL_LOCAL_,'
      '110236759=             :G_OFFICIAL_APPOINT_;'
      '110236760=  end'
      '110236761='
      '110236762='
      '110236763=  G_OFFICIAL_LOCAL_ = COALESCE(G_OFFICIAL_LOCAL_, 0);'
      
        '110236764=  G_OFFICIAL_APPOINT_ = COALESCE(G_OFFICIAL_APPOINT_, ' +
        '0);'
      '110236765='
      '110236766=  IF (IS_SPISANIE_ <> 3) THEN'
      '110236767=  BEGIN'
      '110236768=      SELECT COUNT(*)'
      '110236769=        FROM ZAKAZ T'
      
        '110236770=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      
        '110236771=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '110236772=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '110236773=        INTO CNT_;'
      '110236774='
      '110236775=      if (CNT_ = 0) then'
      '110236776=        SELECT MAX(T.Z_DATE)'
      '110236777=          FROM ZAKAZ T'
      '110236778=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '110236779=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '110236780=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110236781=          INTO :DATE_BEGIN_;'
      '110236782='
      '110236783=  END ELSE'
      '110236784=  BEGIN'
      '110236785=      SELECT COUNT(*)'
      '110236786=        FROM SKLAD_PARENT T'
      
        '110236787=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110236788=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110236789=        INTO CNT_;'
      '110236790='
      '110236791=      if (CNT_ = 0) then'
      '110236792=        SELECT MAX(T.DATE_RECEIPT)'
      '110236793=          FROM SKLAD_PARENT T'
      '110236794=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '110236795=           AND T.IS_VOZVRAT = 3'
      
        '110236796=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110236797=          INTO :DATE_BEGIN_;'
      '110236798=  END'
      '110236799='
      '110236800=  -- '#1055#1056#1054#1044#1040#1046#1048
      '110236801=  IF (IS_SPISANIE_ IN (0,2,4)) THEN'
      '110236802=  BEGIN'
      '110236803=      FOR'
      '110236804=        SELECT T.ZAKAZ,'
      
        '110236805=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042 +
        #1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '110236806=               T.G_TOCHKA,'
      '110236807=               T.Z_DATE,'
      '110236808=               T.Z_TIME,'
      '110236809=               T.G_CLIENT,'
      '110236810=               T.OSNOVANIE,'
      '110236811=               T.NOTE,'
      '110236812=               gc.name,'
      
        '110236813=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AMO' +
        'UNT||'#39')'#39', '#39', '#39')'
      
        '110236814=                            FROM (SELECT G.name, SUM(D' +
        '.amount) AMOUNT'
      
        '110236815=                                    FROM ZAKAZ Z, ZAKA' +
        'Z_DETAILS D, G_PRODUCT G'
      
        '110236816=                                   WHERE D.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110236817=                                     AND D.ZAKAZ = Z.Z' +
        'AKAZ'
      
        '110236818=                                     AND Z.ZAKAZ = T.Z' +
        'AKAZ'
      '110236819=                                   GROUP BY G.name)'
      
        '110236820=                          ) FROM 1 FOR 1500)*/'#39' '#39' DETA' +
        'ILS_STR,'
      '110236821=               T.IS_SPISANIE,'
      
        '110236822=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_AL' +
        'L,'
      '110236823=               IP.INVOICE_PAY,'
      '110236824=               I.INVOICE,'
      '110236825=               W.WAYBILL,'
      '110236826=               T.SUMM,'
      '110236827=               T.SUMM_FACT,'
      '110236828=               COALESCE(t.SUMM_BONUS, 0),'
      '110236829=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '110236830=               COALESCE(T.BY_RECIPE, 0)'
      '110236831=               ,IS_RESERVE'
      '110236832=               ,T.SUMM_CASH'
      '110236833=               ,T.SUMM_NONCASH'
      '110236834=               ,O.g_official'
      '110236835=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '110236836=               ,T.DELIVERY_ADDRESS'
      '110236837=               ,GN.G_NONCASH_PAY_TYPE'
      '110236838=               ,GN.NAME'
      '110236839=               ,GD.SUMM'
      '110236840=          FROM ZAKAZ T'
      
        '110236841=                    LEFT OUTER JOIN G_CLIENT GC ON T.G' +
        '_CLIENT = GC.G_CLIENT'
      
        '110236842=                    LEFT OUTER JOIN INVOICE_PAY IP ON ' +
        'T.ZAKAZ = IP.ZAKAZ'
      
        '110236843=                    LEFT OUTER JOIN INVOICE I ON T.ZAK' +
        'AZ = I.ZAKAZ'
      
        '110236844=                    LEFT OUTER JOIN WAYBILL W ON T.ZAK' +
        'AZ = W.ZAKAZ'
      
        '110236845=                    LEFT OUTER JOIN G_OFFICIAL O ON T.' +
        'g_official = O.g_official'
      
        '110236846=                    LEFT OUTER JOIN G_NONCASH_PAY_TYPE' +
        ' GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '110236847=                    LEFT OUTER JOIN G_DISCONT_CARD GD ' +
        'ON T.G_CLIENT = GD.G_CLIENT'
      
        '110236848=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110236849=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISAN' +
        'IE_ = 0'
      '110236850=                 AND'
      
