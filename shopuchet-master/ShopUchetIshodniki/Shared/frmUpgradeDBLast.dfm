        'T_TYPE_ = 1)) THEN BEGIN'
      '1102013757=      PNT_ = '#39'01'#39';'
      
        '1102013758=      -- '#1045#1057#1051#1048' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040', '#1058#1054' '#1059#1044#1040#1051#1071#1070' '#1057#1058#1040#1056#1059#1070' '#1047#1040#1055#1048#1057 +
