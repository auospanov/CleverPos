        '11068929=      EXECUTE PROCEDURE get_free_articul RETURNING_VALU' +
        'ES (:ARTICUL_);'
      '11068930='
      
        '11068931=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052',' +
        ' '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11068932=    PNT_ = '#39'02a'#39';'
      
        '11068933=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11068934=        SELECT G.G_PRODUCT,'
      '11068935=               G.NAME'
      '11068936=          FROM G_PRODUCT G'
      
