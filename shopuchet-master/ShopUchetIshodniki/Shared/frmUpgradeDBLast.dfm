      '1102011277='
      '1102011278=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '1102011279=      PNT_ = '#39'03'#39';'
      '1102011280=      FOR SELECT S.KASSA_BEZNAL'
