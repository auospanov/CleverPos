      '110112211='
      
        '110112212=/*****************************************************' +
        '*************************/'
      
        '110112213=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110112214=/*****************************************************' +
        '*************************/'
      '110112215=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110112216=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110112217=RETURNS ('
      
        '110112218=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110112219=  ARTICUL_ VARCHAR(30),'
      '110112220=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110112221=  BARCODE_ VARCHAR(30),'
      '110112222=  NAME_ VARCHAR(500),'
      '110112223=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110112224=  PRICE_ NUMERIC(15,2),'
      '110112225=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110112226=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110112227=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110112228=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110112229=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110112230=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110112231=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110112232=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110112233=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110112234=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110112235=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110112236=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      '110112237=  ERR_CODE INTEGER,'
      '110112238=  ERR_MSG VARCHAR(1024))'
      '110112239=AS'
      '110112240=begin'
      '110112241=    SELECT'
      '110112242=        G_PRODUCT_PAR,'
      '110112243=        ARTICUL,'
      '110112244=        NOMENCLATUR_NUM,'
      '110112245=        BARCODE,'
      '110112246=        NAME,'
      '110112247=        G_UNIT,'
      '110112248=        PRICE,'
      '110112249=        VOLUME_PRICE,'
      '110112250=        PACK_AMOUNT,'
      '110112251=        MF_COUNTRY,'
      '110112252=        NOTE,'
      '110112253=        CROSSCODE,'
      '110112254=        IS_KIT,'
      '110112255=        MIN_AMOUNT,'
      '110112256=        PLACE,'
      '110112257=        SALES_COMM,'
      '110112258=        KOD_TNVD,'
      '110112259=        FAST_TOVAR,'
      '110112260=        DO_NOT_SHOW_RMK'
      '110112261=    FROM G_PRODUCT T'
      '110112262=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110112263=    INTO'
      '110112264=        :G_PRODUCT_PAR_,'
      '110112265=        :ARTICUL_,'
      '110112266=        :NOMENCLATUR_NUM_,'
      '110112267=        :BARCODE_,'
      '110112268=        :NAME_,'
      '110112269=        :G_UNIT_,'
      '110112270=        :PRICE_,'
      '110112271=        :VOLUME_PRICE_,'
      '110112272=        :PACK_AMOUNT_,'
      '110112273=        :MF_COUNTRY_,'
      '110112274=        :NOTE_,'
      '110112275=        :CROSSCODE_,'
      '110112276=        :IS_KIT_,'
      '110112277=        :MIN_AMOUNT_,'
      '110112278=        :PLACE_,'
      '110112279=        :SALES_COMM_,'
      '110112280=        :KOD_TNVD_,'
      '110112281=        :FAST_TOVAR_,'
      '110112282=        :DO_NOT_SHOW_RMK_;'
      '110112283='
      '110112284=    INSERT INTO LT_BARCODE_TMP'
      
        '110112285=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110112286='
      '110112287=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110112288=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110112289='
      '110112290=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '110112291=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '110112292=end'
      '110112293=;'
      '110112294='
      '110112295=ALTER PROCEDURE G_INS_G_PRODUCT_CAT('
      
        '110112296=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110112297=  NAME_ VARCHAR(500),'
      '110112298=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      
        '110112299=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      '110112300=  IS_CATEGORY_ INTEGER)'
      '110112301=RETURNS ('
      '110112302=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110112303=  ERR_CODE INTEGER,'
      '110112304=  ERR_MSG VARCHAR(1024))'
      '110112305=AS'
      '110112306=begin'
      
        '110112307=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, N' +
        'AME, IS_CATEGORY, IS_KIT, DO_NOT_SHOW_RMK)'
      
        '110112308=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :NAME_, :IS_CATEGORY_, :IS_KIT_, :DO_NOT_SHOW_RMK_)'
      '110112309=    RETURNING G_PRODUCT'
      '110112310=    INTO :G_PRODUCT_;'
      '110112311=end'
      '110112312=;'
      '110112313='
      '110112314=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110112315=  TYPE_ INTEGER = 0,'
      
        '110112316=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R = NULL,'
      '110112317=  IS_RMK_ INTEGER = 0)'
      '110112318=RETURNS ('
      '110112319=  SORT_COL DM_BIGINT,'
      '110112320=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110112321=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '110112322=  NAME VARCHAR(500))'
      '110112323=AS'
      '110112324=DECLARE VARIABLE LVL_ INTEGER;'
      '110112325=BEGIN'
      '110112326='
      '110112327=  IF (COALESCE(TYPE_, 0) = 0) THEN'
      '110112328=      FOR'
      '110112329=        SELECT'
      '110112330=            DECODE(T.G_PRODUCT, -1, 0, 1) SORT_COL,'
      '110112331=            T.G_PRODUCT,'
      '110112332=            T.G_PRODUCT_PAR,'
      '110112333=            T.NAME,'
      '110112334=            0'
      '110112335=        FROM G_PRODUCT T'
      '110112336=        WHERE T.IS_CATEGORY = 1'
      
        '110112337=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110112338=               OR'
      '110112339=               (:IS_RMK_ = 0)'
      '110112340=              )'
      '110112341=        ORDER BY 1, T.NAME'
      '110112342=        INTO'
      '110112343=            :SORT_COL,'
      '110112344=            :G_PRODUCT,'
      '110112345=            :G_PRODUCT_PAR,'
      '110112346=            :NAME,'
      '110112347=            :LVL_'
      '110112348=      DO'
      '110112349=        suspend;'
      '110112350='
      
        '110112351=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059 +
        #1063#1040#1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '110112352=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054 +
        #1044#1048#1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '110112353=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' ' +
        #1056#1054#1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '110112354=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048 +
        #1046#1045' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '110112355=  ELSE'
      '110112356=    FOR WITH RECURSIVE TREE AS ('
      
        '110112357=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110112358=               T.G_PRODUCT,'
      '110112359=               T.G_PRODUCT_PAR,'
      '110112360=               T.NAME,'
      '110112361=               1 LVL'
      '110112362=          FROM G_PRODUCT T'
      
        '110112363=         WHERE (((T.G_PRODUCT_PAR IS NULL or T.g_produ' +
        'ct = -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '110112364=               OR'
      '110112365=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_))'
      
        '110112366=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110112367=               OR'
      '110112368=               (:IS_RMK_ = 0)'
      '110112369=              )'
      '110112370=        UNION ALL'
      
        '110112371=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110112372=               T.G_PRODUCT,'
      '110112373=               T.G_PRODUCT_PAR,'
      '110112374=               T.NAME,'
      '110112375=               GG.LVL + 1 LVL'
      
        '110112376=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_' +
        'PRODUCT = T.G_PRODUCT_PAR'
      '110112377=         WHERE T.IS_CATEGORY = 1'
      
        '110112378=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110112379=               OR'
      '110112380=               (:IS_RMK_ = 0)'
      '110112381=              )'
      '110112382=        )'
      '110112383=        SELECT * FROM TREE ORDER BY 1, 5, 4'
      '110112384=        INTO :SORT_COL,'
      '110112385=            :G_PRODUCT,'
      '110112386=            :G_PRODUCT_PAR,'
      '110112387=            :NAME,'
      '110112388=            :LVL_'
      '110112389=    DO'
      '110112390=        suspend;'
      '110112391='
      '110112392=    /*'
      
        '110112393=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT,' +
        ' -1, T.G_PRODUCT, 0) SORTT,'
      '110112394=                               T.G_PRODUCT,'
      '110112395=                               T.G_PRODUCT_PAR,'
      
        '110112396=                               DECODE(T.G_PRODUCT, -1,' +
        ' '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '110112397=                               T.NAME PATH,       --'#1076#1083 +
        #1103' '#1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '110112398=                               1 LVL'
      '110112399=                          FROM G_PRODUCT T'
      
        '110112400=                         WHERE (T.G_PRODUCT_PAR IS NUL' +
        'L or T.g_product = -1)'
      '110112401=                        UNION ALL'
      
        '110112402=                        SELECT DECODE(T.G_PRODUCT, -1,' +
        ' T.G_PRODUCT, 0) SORTT,'
      '110112403=                               T.G_PRODUCT,'
      '110112404=                               T.G_PRODUCT_PAR,'
      '110112405=                               GG.LVL||T.NAME NAME,'
      
        '110112406=                               GG.PATH||'#39' - '#39'||T.NAME,' +
        '     --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '110112407=                               GG.LVL + 1 LVL'
      
        '110112408=                          FROM G_PRODUCT T INNER JOIN ' +
        'TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '110112409=                         WHERE T.IS_CATEGORY = 1'
      '110112410=                        )'
      '110112411=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '110112412=    */'
      '110112413=END'
      '110112414=;'
      '110112415='
      '110112416=ALTER PROCEDURE G_UPD_G_PRODUCT_CAT('
      '110112417=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110112418=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110112419=  NAME_ VARCHAR(500),'
      '110112420=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      
        '110112421=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      '110112422=  IS_CATEGORY_ INTEGER)'
      '110112423=RETURNS ('
      '110112424=  ERR_CODE INTEGER,'
      '110112425=  ERR_MSG VARCHAR(1024))'
      '110112426=AS'
      '110112427=begin'
      '110112428=    UPDATE G_PRODUCT G'
      '110112429=       SET G.g_product_par = :G_PRODUCT_PAR_'
      '110112430=           ,G.name = :name_'
      '110112431=           ,G.DO_NOT_SHOW_RMK = :DO_NOT_SHOW_RMK_'
      '110112432=     WHERE G.g_product = :G_PRODUCT_;'
      '110112433=end'
      '110112434=;'
      
        '110112435=UPDATE SYSTEM_SETUP SET S_VALUE = 110112 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110112436=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110112437=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101130=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1101131=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '1101132=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '1101133=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT,'
      
        '1101134=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ' */ BIGINT,'
      '1101135=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '1101136=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '1101137=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERI' +
        'C(15,2),'
      
        '1101138=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T)'
      '1101139=RETURNS ('
      '11011310=  ERR_CODE INTEGER,'
      '11011311=  ERR_MSG VARCHAR(1024))'
      '11011312=AS'
      '11011313=BEGIN'
      '11011314=  SUSPEND;'
      '11011315=END'
      '11011316=;'
      '11011317='
      '11011318=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      
        '11011319=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(30),'
      
        '11011320=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT)'
      '11011321=RETURNS ('
      '11011322=  SKLAD_ /* TYPE OF COLUMN SKLAD.SKLAD */ BIGINT,'
      '11011323=  ERR_CODE INTEGER,'
      '11011324=  ERR_MSG VARCHAR(1024))'
      '11011325=AS'
      '11011326=BEGIN'
      '11011327=  SUSPEND;'
      '11011328=END'
      '11011329=;'
      '11011330='
      '11011331='
      
        '11011332=/******************************************************' +
        '************************/'
      
        '11011333=/****            Altering stored procedures (with empty' +
        ' bodies)            ****/'
      
        '11011334=/******************************************************' +
        '************************/'
      '11011335=ALTER PROCEDURE DO_PRODUCT('
      
        '11011336=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT,'
      
        '11011337=  DATE_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT */ ' +
        'DATE,'
      
        '11011338=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ B' +
        'IGINT,'
      '11011339=  AMOUNT_ INTEGER,'
      
        '11011340=  NOTE_ /* TYPE OF COLUMN OTHER.NOTE */ BLOB SUB_TYPE 1' +
        ')'
      '11011341=RETURNS ('
      '11011342=  SKLAD_ /* TYPE OF COLUMN OTHER.OTHER */ BIGINT,'
      
        '11011343=  COST_PRICE_ /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(1' +
        '5,2),'
      '11011344=  ERR_CODE INTEGER,'
      '11011345=  ERR_MSG VARCHAR(1024))'
      '11011346=AS'
      '11011347=BEGIN'
      '11011348=  SUSPEND;'
      '11011349=END'
      '11011350=;'
      '11011351='
      '11011352=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      
        '11011353=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(30),'
      
        '11011354=  ARTICUL_ /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '11011355=  NOMER_ /* TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM */' +
        ' VARCHAR(150),'
      
        '11011356=  NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250' +
        '),'
      '11011357=  PREFIX_ VARCHAR(2))'
      '11011358=RETURNS ('
      
        '11011359=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ B' +
        'IGINT,'
      
        '11011360=  G_PRODUCT_CATEGORY_ /* TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT_PAR */ BIGINT,'
      
        '11011361=  PRICE_ /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(1' +
        '5,2),'
      
        '11011362=  VOLUME_PRICE_ /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRIC' +
        'E */ NUMERIC(15,2),'
      
        '11011363=  AMOUNT_ /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUM' +
        'ERIC(18,5),'
      
        '11011364=  IS_KIT_ /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER' +
        ','
      '11011365=  ERR_CODE INTEGER,'
      '11011366=  ERR_MSG VARCHAR(1024))'
      '11011367=AS'
      '11011368=BEGIN'
      '11011369=  SUSPEND;'
      '11011370=END'
      '11011371=;'
      '11011372='
      '11011373=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '11011374=  G_PRODUCT_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PROD' +
        'UCT */ BIGINT,'
      
        '11011375=  AMOUNT_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */' +
        ' NUMERIC(18,5),'
      
        '11011376=  PRICE_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ N' +
        'UMERIC(15,2),'
      
        '11011377=  SUMM_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUM' +
        'ERIC(15,2),'
      '11011378=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '11011379=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '11011380=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '11011381=  NDS_ /* TYPE OF COLUMN SKLAD.NDS */ NUMERIC(15,2),'
      
        '11011382=  NDS_SUMM_ /* TYPE OF COLUMN SKLAD.NDS_SUMM */ NUMERIC' +
        '(15,2),'
      
        '11011383=  COST_PRICE_ /* TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRIC' +
        'E */ NUMERIC(15,2),'
      '11011384=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '11011385=  IS_SPISANIE_ INTEGER,'
      '11011386=  NEW_LINE_SALE_ INTEGER = 0,'
      '11011387=  MODE_ INTEGER = 0,'
      '11011388=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '11011389=  DO_PRODUCT_IN_SALE_ INTEGER = 0)'
      '11011390=RETURNS ('
      
        '11011391=  ZAKAZ_DETAILS_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZA' +
        'KAZ_DETAILS */ BIGINT,'
      '11011392=  ERR_CODE INTEGER,'
      '11011393=  ERR_MSG VARCHAR(1024))'
      '11011394=AS'
      '11011395=BEGIN'
      '11011396=  SUSPEND;'
      '11011397=END'
      '11011398=;'
      '11011399='
      '110113100=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '110113101=RETURNS ('
      
        '110113102=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZA' +
        'KAZ_DETAILS */ BIGINT,'
      
        '110113103=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ B' +
        'IGINT,'
      
        '110113104=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PROD' +
        'UCT */ BIGINT,'
      
        '110113105=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */' +
        ' NUMERIC(18,5),'
      
        '110113106=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ N' +
        'UMERIC(15,2),'
      
        '110113107=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUM' +
        'ERIC(15,2),'
      
        '110113108=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_PERC */ NUMERIC(15,2),'
      
        '110113109=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_SUMM */ NUMERIC(15,2),'
      
        '110113110=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMER' +
        'IC(15,2),'
      
        '110113111=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUM' +
        'M */ NUMERIC(15,2),'
      
        '110113112=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VAR' +
        'CHAR(250),'
      
        '110113113=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(30),'
      
        '110113114=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110113115=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ N' +
        'UMERIC(15,2),'
      
        '110113116=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_' +
        'PRICE */ NUMERIC(15,2),'
      
        '110113117=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER' +
        ')'
      '110113118=AS'
      '110113119=BEGIN'
      '110113120=  SUSPEND;'
      '110113121=END'
      '110113122=;'
      '110113123='
      '110113124='
      
        '110113125=/*****************************************************' +
        '*************************/'
      
        '110113126=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110113127=/*****************************************************' +
        '*************************/'
      '110113128=ALTER PROCEDURE DO_PRODUCT('
      '110113129=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110113130=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '110113131=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110113132=  AMOUNT_ INTEGER,'
      '110113133=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '110113134=RETURNS ('
      '110113135=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '110113136=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '110113137=  ERR_CODE INTEGER,'
      '110113138=  ERR_MSG VARCHAR(1024))'
      '110113139=AS'
      '110113140=/*'
      
        '110113141='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055 +
        #1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '110113142='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '110113143=*/'
      '110113144=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39';'
      '110113145=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110113146=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042 +
        #1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '110113147=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT;'
      
        '110113148=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '110113149=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067 +
        ' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '110113150=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110113151=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110113152=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '110113153=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      '110113154=BEGIN'
      '110113155=  PNT_ = '#39'00'#39';'
      '110113156=  COST_PRICE_ = 0;'
      '110113157='
      '110113158=  IF (G_TOCHKA_ IS NULL) THEN'
      '110113159=    SELECT ID'
      '110113160=      FROM CUR_PARAMS'
      '110113161=     WHERE CUR_PARAMS = 2'
      '110113162=      INTO :G_TOCHKA_;'
      '110113163='
      '110113164=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '110113165=  SELECT P.S_VALUE'
      '110113166=    FROM SYSTEM_SETUP P'
      '110113167=   WHERE P.SYSTEM_SETUP = 2'
      '110113168=    INTO :CAN_SELL_;'
      '110113169='
      '110113170=  SELECT MAX(G.NAME)'
      '110113171=    FROM G_PRODUCT G,'
      '110113172=         G_PRODUCT_KIT K'
      '110113173=   WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '110113174=     AND K.G_PRODUCT = :G_PRODUCT_'
      
        '110113175=     AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PRODU' +
        'CT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCHKA_' +
        '), 0) < (K.AMOUNT * :AMOUNT_)'
      '110113176=    INTO :NAME_;'
      '110113177='
      '110113178=  IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEGIN'
      '110113179=    ERR_CODE = -20500;'
      
        '110113180=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072#1090#1086#1082' '#1089 +
        #1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087#1088#1086#1080#1079#1074 +
        #1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110113181=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110113182=    EXIT;'
      '110113183=  END'
      '110113184='
      '110113185=  PNT_ = '#39'01'#39';'
      '110113186=  -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '110113187=  INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIVAL_' +
        'TYPE, PARENT_ID, NOTE, G_TOCHKA)'
      
        '110113188=  VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0, 1' +
        ', :OTHER_, :NOTE_, :G_TOCHKA_)'
      '110113189=  RETURNING OTHER'
      '110113190=  INTO :OTHER_;'
      '110113191='
      '110113192=  FOR SELECT K.G_PRODUCT_ITEM'
      '110113193=            ,K.AMOUNT*:AMOUNT_'
      '110113194=            ,K.amount'
      '110113195=            ,G.G_PRODUCT'
      '110113196=        FROM G_PRODUCT_KIT K'
      '110113197=            ,G_PRODUCT G'
      '110113198=       WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110113199=         AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '110113200=        INTO :ITEM_'
      '110113201=            ,:AMOUNT_NEED_'
      '110113202=            ,:AMOUNT_NEED_ONE_'
      '110113203=            ,:G_PRODUCT_KIT_'
      '110113204=  DO BEGIN'
      
        '110113205=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_K' +
        'IT_, NULL, 1)'
      '110113206=      RETURNING_VALUES :SELF_PRICE_;'
      '110113207='
      '110113208=    UPDATE LT_SKLAD_PRODUCT L'
      '110113209=       SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110113210=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110113211=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110113212='
      '110113213=    IF (ROW_COUNT = 0) THEN'
      
        '110113214=      INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(GEN_' +
        'LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G_TOC' +
        'HKA_);'
      '110113215='
      
        '110113216=    INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHER, G' +
        '_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110113217=    VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_, :G_' +
        'PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110113218='
      
        '110113219=    COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*SELF_' +
        'PRICE_;'
      '110113220=  END'
      '110113221='
      '110113222='
      
        '110113223=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063#1040#1051#1045' ' +
        #1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110113224=  PNT_ = '#39'02'#39';'
      
        '110113225=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM)'
      
        '110113226=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :AM' +
        'OUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110113227='
      '110113228=  EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110113229=                              :DATE_,'
      '110113230=                              CURRENT_TIME,'
      '110113231=                              NULL, --:G_CLIENT__,'
      
        '110113232=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110113233=                              NULL, --:OSNOVANIE__,'
      '110113234=                              :NOTE_,'
      '110113235=                              4, --:IS_VOZVRAT_,'
      '110113236=                              :AMOUNT_*:COST_PRICE_,'
      '110113237=                              :AMOUNT_*:COST_PRICE_,'
      '110113238=                              0, --:G_PRIHOD_,'
      '110113239=                              0 --:SUMM_PRIHOD_)'
      '110113240=                              ,NULL     --PAYMENTS_'
      
        '110113241=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110113242=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110113243=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110113244=      EXIT;'
      '110113245=  END'
      '110113246='
      '110113247=  UPDATE OTHER O'
      '110113248=    SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110113249=  WHERE O.OTHER = :OTHER_;'
      '110113250=END'
      '110113251=;'
      '110113252='
      '110113253=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '110113254=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110113255=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110113256=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '110113257=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110113258=  PREFIX_ VARCHAR(2))'
      '110113259=RETURNS ('
      '110113260=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110113261=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT_PAR,'
      '110113262=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110113263=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110113264=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110113265=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110113266=  ERR_CODE INTEGER,'
      '110113267=  ERR_MSG VARCHAR(1024))'
      '110113268=AS'
      '110113269=/*'
      '110113270='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '110113271=*/'
      
        '110113272=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PRODU' +
        'CT_BY_BARCODE'#39';'
      '110113273=BEGIN'
      '110113274='
      '110113275=  IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '110113276=    ERR_CODE = -20500;'
      
        '110113277=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093#1082#1086#1076' ' +
        #1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110113278=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110113279=    EXIT;'
      '110113280=  END'
      '110113281='
      
        '110113282=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) TH' +
        'EN BEGIN'
      '110113283=        SELECT T.G_PRODUCT_PAR,'
      '110113284=               T.G_PRODUCT,'
      '110113285=               T.PRICE,'
      '110113286=               T.VOLUME_PRICE,'
      '110113287=               T.IS_KIT'
      '110113288=          FROM G_PRODUCT T'
      
        '110113289=          WHERE SUBSTRING(T.BARCODE FROM 3 FOR 5) = SU' +
        'BSTRING(:BARCODE_ FROM 3 FOR 5)'
      '110113290=            AND T.IS_ACTIVE = 1'
      '110113291=          INTO :G_PRODUCT_CATEGORY_,'
      '110113292=               :G_PRODUCT_,'
      '110113293=               :PRICE_,'
      '110113294=               :VOLUME_PRICE_,'
      '110113295=               :IS_KIT_;'
      '110113296='
      
        '110113297=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM 8' +
        ' FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '110113298=    END ELSE'
      '110113299=        SELECT T.G_PRODUCT_PAR,'
      '110113300=               T.G_PRODUCT,'
      '110113301=               T.PRICE,'
      '110113302=               T.VOLUME_PRICE,'
      '110113303=               T.IS_KIT'
      '110113304=          FROM G_PRODUCT T'
      '110113305=          WHERE T.BARCODE = :BARCODE_'
      '110113306=            AND T.IS_ACTIVE = 1'
      '110113307=          INTO :G_PRODUCT_CATEGORY_,'
      '110113308=               :G_PRODUCT_,'
      '110113309=               :PRICE_,'
      '110113310=               :VOLUME_PRICE_,'
      '110113311=               :IS_KIT_;'
      '110113312='
      '110113313=    if (ROW_COUNT = 0) then BEGIN'
      
        '110113314=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' '#1044 +
        #1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '110113315=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) ' +
        'THEN'
      '110113316=          SELECT T.G_PRODUCT_PAR,'
      '110113317=                 T.G_PRODUCT,'
      '110113318=                 T.PRICE,'
      '110113319=                 T.VOLUME_PRICE,'
      '110113320=                 T.IS_KIT'
      '110113321=            FROM G_PRODUCT T, LT_BARCODE D'
      '110113322=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110113323=              AND T.IS_ACTIVE = 1'
      
        '110113324=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) = ' +
        'SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '110113325=            INTO'
      '110113326=                :G_PRODUCT_CATEGORY_,'
      '110113327=                :G_PRODUCT_,'
      '110113328=                :PRICE_,'
      '110113329=                :VOLUME_PRICE_,'
      '110113330=                :IS_KIT_;'
      '110113331=      ELSE'
      '110113332=          SELECT T.G_PRODUCT_PAR,'
      '110113333=                 T.G_PRODUCT,'
      '110113334=                 T.PRICE,'
      '110113335=                 T.VOLUME_PRICE,'
      '110113336=                 T.IS_KIT'
      '110113337=            FROM G_PRODUCT T, LT_BARCODE D'
      '110113338=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110113339=              AND T.IS_ACTIVE = 1'
      '110113340=              AND D.BARCODE = :BARCODE_'
      '110113341=            INTO'
      '110113342=                :G_PRODUCT_CATEGORY_,'
      '110113343=                :G_PRODUCT_,'
      '110113344=                :PRICE_,'
      '110113345=                :VOLUME_PRICE_,'
      '110113346=                :IS_KIT_;'
      '110113347='
      '110113348=      if (ROW_COUNT = 0) then BEGIN'
      '110113349=          ERR_CODE = -20500;'
      
        '110113350=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110113351=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110113352=          EXIT;'
      '110113353=      END'
      '110113354=    END'
      '110113355='
      
        '110113356=  /*END ELSE if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) the' +
        'n BEGIN'
      '110113357=    SELECT T.G_PRODUCT_PAR,'
      '110113358=        T.G_PRODUCT,'
      '110113359=        T.PRICE,'
      '110113360=        T.VOLUME_PRICE'
      '110113361=    FROM G_PRODUCT T'
      '110113362=    WHERE T.ARTICUL = :ARTICUL_'
      '110113363=    INTO'
      '110113364=        G_PRODUCT_CATEGORY_,'
      '110113365=        :G_PRODUCT_,'
      '110113366=        :PRICE_,'
      '110113367=        :VOLUME_PRICE_;'
      '110113368='
      '110113369=    if (ROW_COUNT = 0) then BEGIN'
      '110113370=      ERR_CODE = -20500;'
      
        '110113371=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:ERR_MS' +
        'G);'
      '110113372=      ERR_MSG = PROCNAME||ERR_MSG;'
      '110113373=      EXIT;'
      '110113374=    END'
      '110113375='
      
        '110113376=  END ELSE if (CHAR_LENGTH(TRIM(:NOMER_)) > 0) then BE' +
        'GIN'
      '110113377=    SELECT T.G_PRODUCT_PAR,'
      '110113378=        T.G_PRODUCT,'
      '110113379=        T.PRICE,'
      '110113380=        T.VOLUME_PRICE'
      '110113381=    FROM G_PRODUCT T'
      '110113382=    WHERE T.NOMENCLATUR_NUM = :NOMER_'
      '110113383=    INTO'
      '110113384=        G_PRODUCT_CATEGORY_,'
      '110113385=        :G_PRODUCT_,'
      '110113386=        :PRICE_,'
      '110113387=        :VOLUME_PRICE_;'
      '110113388='
      '110113389=    if (ROW_COUNT = 0) then BEGIN'
      '110113390=      ERR_CODE = -20500;'
      
        '110113391=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083#1072#1090#1091#1088#1085#1099#1084' '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMER_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '110113392=      ERR_MSG = PROCNAME||ERR_MSG;'
      '110113393=      EXIT;'
      '110113394=    END'
      '110113395='
      
        '110113396=  END ELSE if (CHAR_LENGTH(TRIM(:NAME_)) > 0) then BEG' +
        'IN'
      
        '110113397=      --'#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MAX '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042#1044#1056#1059#1043' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1057' '#1058#1040#1050#1048#1052' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1052
      '110113398=      EXECUTE STATEMENT'
      
        '110113399=      '#39'SELECT G_PRODUCT, G_PRODUCT_PAR, PRICE FROM G_P' +
        'RODUCT '#39'||'
      '110113400=      '#39' WHERE G_PRODUCT = '#39'||'
      
        '110113401=                  '#39'(SELECT MAX(G_PRODUCT) FROM G_PRODU' +
        'CT '#39'||'
      
        '110113402=                  '#39' WHERE UPPER(NAME) LIKE '#39#39'%'#39'||:NAME' +
        '_||'#39'%'#39#39')'#39
      
        '110113403=      INTO :G_PRODUCT_, :G_PRODUCT_CATEGORY_, :PRICE_ ' +
        ';'
      '110113404=      if (G_PRODUCT_ = 0) then BEGIN'
      '110113405=          ERR_CODE = -20500;'
      
        '110113406=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1077#1084' "'#39'||NAME_||'#39'" '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '110113407=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110113408=          EXIT;'
      '110113409=      END'
      '110113410=  END  */'
      '110113411=end'
      '110113412=;'
      '110113413='
      '110113414=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110113415=  TYPE_ INTEGER = 0,'
      
        '110113416=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R = NULL,'
      '110113417=  IS_RMK_ INTEGER = 0)'
      '110113418=RETURNS ('
      '110113419=  SORT_COL DM_BIGINT,'
      '110113420=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110113421=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '110113422=  NAME VARCHAR(500))'
      '110113423=AS'
      '110113424=DECLARE VARIABLE LVL_ INTEGER;'
      '110113425=BEGIN'
      '110113426='
      '110113427=  IF (COALESCE(TYPE_, 0) = 0) THEN'
      '110113428=      FOR'
      '110113429=        SELECT'
      '110113430=            DECODE(T.G_PRODUCT, -1, 0, 1) SORT_COL,'
      '110113431=            T.G_PRODUCT,'
      '110113432=            T.G_PRODUCT_PAR,'
      '110113433=            T.NAME,'
      '110113434=            0'
      '110113435=        FROM G_PRODUCT T'
      '110113436=        WHERE T.IS_CATEGORY = 1'
      
        '110113437=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110113438=               OR'
      '110113439=               (:IS_RMK_ = 0)'
      '110113440=              )'
      '110113441=        ORDER BY 1, T.NAME'
      '110113442=        INTO'
      '110113443=            :SORT_COL,'
      '110113444=            :G_PRODUCT,'
      '110113445=            :G_PRODUCT_PAR,'
      '110113446=            :NAME,'
      '110113447=            :LVL_'
      '110113448=      DO'
      '110113449=        suspend;'
      '110113450='
      
        '110113451=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059 +
        #1063#1040#1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '110113452=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054 +
        #1044#1048#1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '110113453=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' ' +
        #1056#1054#1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '110113454=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048 +
        #1046#1045' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '110113455=  ELSE'
      
        '110113456=    FOR SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110113457=           T.G_PRODUCT,'
      '110113458=           T.G_PRODUCT_PAR,'
      '110113459=           T.NAME,'
      '110113460=           1 LVL'
      '110113461=      FROM G_PRODUCT T'
      
        '110113462=     WHERE ((T.G_PRODUCT_PAR IS NULL AND :G_PRODUCT_PA' +
        'R_ IS NULL AND T.G_PRODUCT <> -1)'
      '110113463=           OR'
      '110113464=           (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_))'
      '110113465=      AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1)'
      '110113466=           OR'
      '110113467=           (:IS_RMK_ = 0)'
      '110113468=          )'
      '110113469=     ORDER BY T.NAME'
      '110113470=    INTO :SORT_COL,'
      '110113471=            :G_PRODUCT,'
      '110113472=            :G_PRODUCT_PAR,'
      '110113473=            :NAME,'
      '110113474=            :LVL_'
      '110113475=    DO'
      '110113476=        suspend;'
      '110113477=    /*'
      
        '110113478=    '#1050#1054#1056#1054#1063#1045' '#1055#1054#1057#1054#1042#1045#1065#1040#1051#1048#1057#1068' '#1058#1040#1050' '#1057' '#1056#1059#1057#1051#1040#1053#1054#1052' '#1048' '#1055#1054#1044#1059#1052#1040#1051#1048', '#1063#1058#1054 +
        ' '#1044#1054#1063#1045#1056#1053#1048#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048' '#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1054#1050#1040#1047#1067#1042#1040#1058#1068', '#1056#1040#1042#1053#1054' '#1050#1040#1050' '#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1070' "' +
        #1042#1057#1045' '#1058#1054#1042#1040#1056#1067'"'
      '110113479=    FOR WITH RECURSIVE TREE AS ('
      
        '110113480=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110113481=               T.G_PRODUCT,'
      '110113482=               T.G_PRODUCT_PAR,'
      '110113483=               T.NAME,'
      '110113484=               1 LVL'
      '110113485=          FROM G_PRODUCT T'
      
        '110113486=         WHERE (((T.G_PRODUCT_PAR IS NULL or T.g_produ' +
        'ct = -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '110113487=               OR'
      '110113488=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_))'
      
        '110113489=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110113490=               OR'
      '110113491=               (:IS_RMK_ = 0)'
      '110113492=              )'
      '110113493=        UNION ALL'
      
        '110113494=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110113495=               T.G_PRODUCT,'
      '110113496=               T.G_PRODUCT_PAR,'
      '110113497=               T.NAME,'
      '110113498=               GG.LVL + 1 LVL'
      
        '110113499=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_' +
        'PRODUCT = T.G_PRODUCT_PAR'
      '110113500=         WHERE T.IS_CATEGORY = 1'
      
        '110113501=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110113502=               OR'
      '110113503=               (:IS_RMK_ = 0)'
      '110113504=              )'
      '110113505=        )'
      '110113506=        SELECT * FROM TREE ORDER BY 1, 5, 4'
      '110113507=        INTO :SORT_COL,'
      '110113508=            :G_PRODUCT,'
      '110113509=            :G_PRODUCT_PAR,'
      '110113510=            :NAME,'
      '110113511=            :LVL_'
      '110113512=    DO'
      '110113513=        suspend;'
      '110113514=    */'
      '110113515='
      '110113516='
      '110113517=    /*'
      
        '110113518=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT,' +
        ' -1, T.G_PRODUCT, 0) SORTT,'
      '110113519=                               T.G_PRODUCT,'
      '110113520=                               T.G_PRODUCT_PAR,'
      
        '110113521=                               DECODE(T.G_PRODUCT, -1,' +
        ' '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '110113522=                               T.NAME PATH,       --'#1076#1083 +
        #1103' '#1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '110113523=                               1 LVL'
      '110113524=                          FROM G_PRODUCT T'
      
        '110113525=                         WHERE (T.G_PRODUCT_PAR IS NUL' +
        'L or T.g_product = -1)'
      '110113526=                        UNION ALL'
      
        '110113527=                        SELECT DECODE(T.G_PRODUCT, -1,' +
        ' T.G_PRODUCT, 0) SORTT,'
      '110113528=                               T.G_PRODUCT,'
      '110113529=                               T.G_PRODUCT_PAR,'
      '110113530=                               GG.LVL||T.NAME NAME,'
      
        '110113531=                               GG.PATH||'#39' - '#39'||T.NAME,' +
        '     --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '110113532=                               GG.LVL + 1 LVL'
      
        '110113533=                          FROM G_PRODUCT T INNER JOIN ' +
        'TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '110113534=                         WHERE T.IS_CATEGORY = 1'
      '110113535=                        )'
      '110113536=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '110113537=    */'
      '110113538=END'
      '110113539=;'
      '110113540='
      '110113541=ALTER PROCEDURE INS_SKLAD_TMP('
      '110113542=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110113543=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110113544=  PRICE_ NUMERIC(15,2),'
      '110113545=  SUMM_ NUMERIC(15,2),'
      '110113546=  NDS_ NUMERIC(15,2),'
      '110113547=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110113548=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110113549=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0,'
      
        '110113550=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC = 0,'
      '110113551=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0,'
      
        '110113552=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC = 0,'
      '110113553=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0)'
      '110113554=RETURNS ('
      '110113555=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110113556=  ERR_CODE INTEGER,'
      '110113557=  ERR_MSG VARCHAR(1024))'
      '110113558=AS'
      
        '110113559=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110113560=BEGIN'
      '110113561=  SELECT T.SKLAD'
      '110113562=    FROM SKLAD_TMP T'
      '110113563=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110113564=     AND T.PRICE = :PRICE_'
      '110113565=    INTO :SKLAD_;'
      '110113566='
      '110113567=  IF (SKLAD_ IS NOT NULL) THEN'
      '110113568=    UPDATE SKLAD_TMP T'
      '110113569=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110113570=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110113571=     WHERE T.SKLAD = :SKLAD_;'
      '110113572='
      '110113573=  ELSE BEGIN'
      '110113574=      IF (PRICE_ = 0) THEN BEGIN'
      '110113575=        CHARGE_ROZN_PROC_ = 0;'
      '110113576=        CHARGE_OPT_PROC_ = 0;'
      '110113577=      END ELSE BEGIN'
      
        '110113578=        CHARGE_ROZN_PROC_ = ROUND((:PRICE_ROZN_ - :PRI' +
        'CE_) * 100 / :PRICE_, 2);'
      
        '110113579=        CHARGE_OPT_PROC_ = ROUND((:PRICE_OPT_ - :PRICE' +
        '_) * 100 / :PRICE_, 2);'
      '110113580=      END'
      '110113581='
      
        '110113582=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '110113583=                            CHARGE_ROZN_PROC,'
      '110113584=                            PRICE_ROZN,'
      '110113585=                            CHARGE_OPT_PROC,'
      '110113586=                            PRICE_OPT)'
      
        '110113587=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110113588=        ,:PRICE_CURRENCY_'
      '110113589=        ,:SUMM_CURRENCY_'
      '110113590=        ,:CHARGE_ROZN_PROC_'
      '110113591=        ,:PRICE_ROZN_'
      '110113592=        ,:CHARGE_OPT_PROC_'
      '110113593=        ,:PRICE_OPT_)'
      '110113594=      RETURNING SKLAD'
      '110113595=      INTO :SKLAD_;'
      '110113596=  END'
      '110113597=end'
      '110113598=;'
      '110113599='
      '110113600=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '110113601=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110113602=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110113603=RETURNS ('
      '110113604=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110113605=  ERR_CODE INTEGER,'
      '110113606=  ERR_MSG VARCHAR(1024))'
      '110113607=AS'
      '110113608=/*'
      '110113609='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '110113610=*/'
      
        '110113611=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110113612=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110113613=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '110113614=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110113615=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '110113616=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT.' +
        'PRICE;'
      
        '110113617=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      '110113618=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110113619=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110113620=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110113621=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110113622=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      '110113623=BEGIN'
      '110113624='
      '110113625=  PNT_ = '#39'01'#39';'
      
        '110113626=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCOD' +
        'E_, NULL, NULL, NULL, NULL)'
      
        '110113627=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGOR' +
        'Y_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :ERR_CODE,' +
        ' :ERR_MSG;'
      '110113628='
      '110113629=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110113630=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110113631=    EXIT;'
      '110113632=  END'
      '110113633='
      '110113634=  PNT_ = '#39'02'#39';'
      
        '110113635=  EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, :' +
        'G_TOCHKA_, 0)'
      '110113636=      RETURNING_VALUES :PRICE_;'
      '110113637='
      '110113638=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110113639=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110113640=    EXIT;'
      '110113641=  END'
      '110113642='
      '110113643=  AMOUNT_ = 1;'
      '110113644='
      '110113645=  SELECT T.SKLAD'
      '110113646=    FROM SKLAD_TMP T'
      '110113647=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110113648=     AND T.PRICE = :PRICE_'
      '110113649=    INTO :SKLAD_;'
      '110113650='
      '110113651=  IF (SKLAD_ IS NOT NULL) THEN'
      '110113652=    UPDATE SKLAD_TMP T'
      '110113653=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110113654=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110113655=     WHERE T.SKLAD = :SKLAD_;'
      '110113656='
      '110113657=  ELSE'
      
        '110113658=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PRI' +
        'CE_OPT)'
      
        '110113659=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_,'
      
        '110113660=             DECODE(:PRICE_, 0, 0, ROUND((:SALE_PRICE_' +
        '/:PRICE_ - 1)*100, 2)),'
      '110113661=             :SALE_PRICE_,'
      
        '110113662=             DECODE(:PRICE_, 0, 0, ROUND((:VOLUME_PRIC' +
        'E_/:PRICE_ - 1)*100, 2)),'
      '110113663=             :VOLUME_PRICE_)'
      '110113664=      RETURNING SKLAD'
      '110113665=      INTO :SKLAD_;'
      '110113666=end'
      '110113667=;'
      '110113668='
      '110113669=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '110113670=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110113671=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110113672=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110113673=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110113674=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110113675=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110113676=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110113677=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110113678=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110113679=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110113680=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110113681=  IS_SPISANIE_ INTEGER,'
      '110113682=  NEW_LINE_SALE_ INTEGER = 0,'
      '110113683=  MODE_ INTEGER = 0,'
      '110113684=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '110113685=  DO_PRODUCT_IN_SALE_ INTEGER = 0)'
      '110113686=RETURNS ('
      
        '110113687=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110113688=  ERR_CODE INTEGER,'
      '110113689=  ERR_MSG VARCHAR(1024))'
      '110113690=AS'
      '110113691=/*'
      
        '110113692=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048 +
        #1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '110113693=*/'
      
        '110113694=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39';'
      '110113695=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '110113696=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110113697=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      
        '110113698=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110113699=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110113700=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110113701=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110113702=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110113703=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110113704=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '110113705=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110113706=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' */'
      
        '110113707=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' ' +
        #1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '110113708=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      '110113709=BEGIN'
      '110113710='
      
        '110113711=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110113712=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110113713=    FROM ZAKAZ_DETAILS_TMP T'
      '110113714=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110113715=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110113716=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110113717='
      
        '110113718=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110113719=           ,G.IS_KIT'
      '110113720=           ,K.AMOUNT * :AMOUNT_'
      '110113721=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110113722=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      '110113723=           ,(CASE'
      
        '110113724=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE' +
        '_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * ' +
        'FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '110113725=             ELSE K.PRICE'
      '110113726=           END) COST_PRICE'
      
        '110113727=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_L' +
        'AST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '110113728=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE ' +
        'G_PRODUCT = :G_PRODUCT_) CNT'
      
        '110113729=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110113730=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110113731=       AND G.IS_KIT = 1'
      '110113732=    UNION'
      
        '110113733=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110113734=           ,G.IS_KIT'
      '110113735=           ,:AMOUNT_'
      '110113736=           ,:PRICE_'
      '110113737=           ,0'
      '110113738=           ,:COST_PRICE_'
      '110113739=           ,0'
      '110113740=      FROM G_PRODUCT G'
      '110113741=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110113742=       AND G.IS_KIT <> 1'
      '110113743=      INTO :G_PRODUCT_'
      '110113744=           ,:IS_KIT_'
      '110113745=           ,:AMOUNT_'
      '110113746=           ,:PRICE__'
      '110113747=           ,:SOSTAV_PRICE_'
      '110113748=           ,:COST_PRICE__'
      '110113749=           ,:SOSTAV_COUNT_'
      '110113750=  DO BEGIN'
      '110113751=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110113752='
      
        '110113753=      --==============================================' +
        '============='
      '110113754=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110113755=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110113756=        FROM LT_SKLAD_PRODUCT L'
      '110113757=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110113758=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110113759=       INTO :AMOUNT_CUR_;'
      '110113760='
      
        '110113761=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110113762=      IF (ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      
        '110113763=          -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110113764=          -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', ' +
        #1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110113765=          -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' ' +
        #1050#1054#1051#1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110113766=          -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' '#1041#1067#1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057 +
        #1050#1054#1051#1068#1050#1054
      
        '110113767=          -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054 +
        #1042#1040#1058#1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110113768=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110113769=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110113770=              SELECT SUM(AMOUNT)'
      '110113771=                FROM ZAKAZ_DETAILS T'
      '110113772=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110113773=                 AND T.ZAKAZ = :ZAKAZ_'
      '110113774=                INTO :AMOUNT_OLD_;'
      '110113775=            ELSE'
      '110113776=              SELECT SUM(AMOUNT)'
      '110113777=                FROM SKLAD T'
      '110113778=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110113779=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '110113780=                INTO :AMOUNT_OLD_;'
      '110113781=          END'
      '110113782='
      '110113783=          -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110113784=          SELECT SUM(AMOUNT)'
      '110113785=            FROM ZAKAZ_DETAILS_TMP T'
      '110113786=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110113787=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '110113788='
      
        '110113789=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKA' +
        'Z_, 0) + :AMOUNT_;'
      
        '110113790=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0)' +
        ';'
      '110113791='
      
        '110113792=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COA' +
        'LESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110113793='
      
        '110113794=            -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056 +
        #1054#1048#1047#1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110113795=            IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = ' +
        '1) THEN BEGIN'
      '110113796=                PNT_ = '#39'01'#39';'
      
        '110113797=                EXECUTE PROCEDURE DO_PRODUCT((SELECT I' +
        'D FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '110113798=                                             CURRENT_D' +
        'ATE,'
      
        '110113799=                                             :G_PRODUC' +
        'T_,'
      
        '110113800=                                             ABS(AMOUN' +
        'T_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:A' +
        'MOUNT_,'
      
        '110113801=                                             '#39#1055#1088#1086#1080#1079#1074#1086#1076 +
        #1089#1090#1074#1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110113802=                                             )'
      
        '110113803=                    RETURNING_VALUES :SKLAD_, :COST_PR' +
        'ICE__, :ERR_CODE, :ERR_MSG;'
      '110113804=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110113805=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110113806=                  EXIT;'
      '110113807=                END'
      '110113808=            END'
      '110113809=            ELSE BEGIN'
      '110113810=                SELECT NAME'
      '110113811=                FROM G_PRODUCT'
      '110113812=                WHERE G_PRODUCT = :G_PRODUCT_'
      '110113813=                INTO :PRODUCT_NAME_;'
      '110113814='
      '110113815=                ERR_CODE = -20500;'
      
        '110113816=                ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODU' +
        'CT_NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110113817=                          '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089 +
        #1090#1072#1090#1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110113818=                EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE' +
        ', ERR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110113819=                ERR_MSG = PROCNAME||ERR_MSG;'
      '110113820=                EXIT;'
      '110113821=            END'
      '110113822=          END'
      '110113823=      END'
      '110113824=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110113825=      --==============================================' +
        '============='
      '110113826='
      
        '110113827=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110113828=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110113829=        IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '110113830=            PRICE__ = SOSTAV_PRICE_;'
      '110113831=        END ELSE BEGIN'
      '110113832=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110113833=              PRICE__ = COST_PRICE__;'
      '110113834='
      
        '110113835=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110113836=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110113837='
      '110113838='
      
        '110113839=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110113840=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110113841=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110113842=            END'
      '110113843='
      
        '110113844=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110113845=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110113846=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110113847=        END'
      '110113848=      END'
      '110113849='
      
        '110113850=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '110113851=      IF (NEW_LINE_SALE_ = 0) THEN'
      '110113852=          SELECT ZD.zakaz_details'
      '110113853=            FROM zakaz_details_tmp ZD'
      '110113854=           WHERE ZD.G_PRODUCT = :g_product_'
      '110113855=             AND ZD.PRICE = :PRICE__'
      '110113856=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110113857=            INTO :ZAKAZ_DTLS_TMP_;'
      '110113858='
      '110113859='
      '110113860=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110113861=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110113862=           SET P.amount = P.amount + :amount_'
      
        '110113863=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110113864=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110113865=               ,P.NDS = :NDS_'
      '110113866=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110113867=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110113868='
      '110113869=      ELSE BEGIN'
      '110113870=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110113871=          ('
      '110113872=           ZAKAZ_DETAILS,'
      '110113873=           ZAKAZ,'
      '110113874=           G_PRODUCT,'
      '110113875=           AMOUNT,'
      '110113876=           PRICE,'
      '110113877=           SUMM,'
      '110113878=           DISCOUNT_PERC,'
      '110113879=           DISCOUNT_TENGE,'
      '110113880=           DISCOUNT_SUMM,'
      '110113881=           NDS,'
      '110113882=           NDS_SUMM,'
      '110113883=           COST_PRICE'
      '110113884=          ) VALUES ('
      '110113885=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110113886=           :ZAKAZ_,'
      '110113887=           :G_PRODUCT_,'
      '110113888=           :AMOUNT_,'
      '110113889=           :PRICE__,'
      '110113890=           :SUMM_,'
      '110113891=           :DISCOUNT_PERC_,'
      '110113892=           :DISCOUNT_TENGE_,'
      '110113893=           :DISCOUNT_SUMM_,'
      '110113894=           :NDS_,'
      '110113895=           :NDS_SUMM_,'
      '110113896=           :COST_PRICE__'
      '110113897=          )'
      '110113898=          RETURNING'
      '110113899=            ZAKAZ_DETAILS'
      '110113900=          INTO'
      '110113901=            :ZAKAZ_DETAILS_;'
      '110113902=      END'
      '110113903=  END'
      '110113904=end'
      '110113905=;'
      '110113906='
      '110113907=ALTER PROCEDURE P_REP_TOVAR_HISTORY('
      '110113908=  G_PRODUCT_ARR_ BLOB SUB_TYPE 1,'
      '110113909=  DATE_BEGIN_ DATE,'
      '110113910=  DATE_END_ DATE,'
      '110113911=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110113912=RETURNS ('
      '110113913=  ROW INTEGER,'
      '110113914=  DATE_ACT DATE,'
      '110113915=  OPER VARCHAR(500),'
      '110113916=  PRICE_PRIHOD NUMERIC(15,2),'
      '110113917=  AMOUNT_PRIHOD MY_NUMERIC_5,'
      '110113918=  SUMM_PRIHOD NUMERIC(15,2),'
      '110113919=  PRICE_UHOD NUMERIC(15,2),'
      '110113920=  AMOUNT_UHOD MY_NUMERIC_5,'
      '110113921=  SUMM_UHOD NUMERIC(15,2),'
      '110113922=  ERR_CODE INTEGER,'
      '110113923=  ERR_MSG VARCHAR(1024))'
      '110113924=AS'
      
        '110113925=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_M' +
        'OVE'#39';'
      '110113926=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110113927=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '110113928=DECLARE VARIABLE DATE_SORT DATE;'
      '110113929=BEGIN'
      '110113930='
      '110113931=  FOR SELECT F.G_PRODUCT'
      '110113932=        FROM G_PRODUCT F'
      
        '110113933=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39'~'#39'||F.G_PRODU' +
        'CT||'#39'~'#39
      '110113934=       AND EXISTS (SELECT 1'
      '110113935=                     FROM SKLAD SS'
      
        '110113936=                    WHERE SS.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      '110113937=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '110113938=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||SS.G_TOCHKA||'#39'-'#39
      '110113939=                   UNION ALL'
      '110113940=                   SELECT 1'
      '110113941=                     FROM SKLAD SS'
      
        '110113942=                    WHERE SS.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      '110113943=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '110113944=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||SS.G_CLIENT||'#39'-'#39
      '110113945=                   UNION ALL'
      '110113946=                   SELECT 1'
      '110113947=                     FROM ZAKAZ ZZ,'
      '110113948=                          ZAKAZ_DETAILS ZZD'
      '110113949=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '110113950=                      AND ZZ.IS_RESERVE = 0'
      
        '110113951=                      AND ZZ.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      '110113952=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      '110113953=                      AND ZZ.IS_SPISANIE <> 2'
      
        '110113954=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||ZZ.G_TOCHKA||'#39'-'#39
      '110113955=                   UNION ALL'
      '110113956=                   SELECT 1'
      '110113957=                     FROM ZAKAZ_REAL_PARENT Z,'
      '110113958=                          ZAKAZ_NA_REAL D'
      
        '110113959=                    WHERE Z.ZAKAZ_REAL_PARENT = D.ZAKA' +
        'Z_REAL_PARENT'
      
        '110113960=                      AND Z.ZAKAZ_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '110113961=                      AND D.G_PRODUCT = F.G_PRODUCT'
      
        '110113962=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||Z.G_TOCHKA||'#39'-'#39
      '110113963=                   UNION ALL'
      '110113964=                   SELECT 1'
      '110113965=                     FROM OTHER ZZ,'
      '110113966=                          OTHER_DETAILS ZZD'
      '110113967=                    WHERE ZZ.OTHER = ZZD.OTHER'
      
        '110113968=                      AND ZZ.OP_DATE BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '110113969=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      
        '110113970=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||ZZ.G_TOCHKA||'#39'-'#39
      '110113971=                   )'
      '110113972=       ORDER BY F.NAME'
      '110113973=       INTO :G_PRODUCT_'
      '110113974=  DO BEGIN'
      '110113975=      FOR SELECT -2,'
      '110113976=                 CAST('#39'01.01.1985'#39' AS DATE) DATE_SORT,'
      '110113977=                 NULL,'
      '110113978=                 NAME,'
      '110113979=                 NULL,'
      '110113980=                 NULL,'
      '110113981=                 NULL,'
      '110113982=                 NULL,'
      '110113983=                 NULL,'
      '110113984=                 NULL'
      '110113985=            FROM G_PRODUCT G'
      '110113986=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110113987=          UNION ALL'
      '110113988=          SELECT -1,'
      '110113989=                 CAST('#39'01.01.1990'#39' AS DATE) DATE_SORT,'
      '110113990=                 NULL,'
      '110113991=                 '#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1085#1072#1095#1072#1083#1086#39','
      '110113992=                 NULL,'
      
        '110113993=                 (select (select sum(amount) from lt_s' +
        'klad_product where g_product = G.G_PRODUCT'
      
        '110113994=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||g_tochka||'#39'-'#39')'
      '110113995=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '110113996=                       (select COALESCE(sum(zr.AMOUNT_' +
        'ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110113997=                        where zr.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '110113998=                        and zr.ZAKAZ_REAL_PARENT = zrp' +
        '.ZAKAZ_REAL_PARENT'
      
        '110113999=                        and zrp.ZAKAZ_DATE >= :DATE_BE' +
        'GIN_)'
      '1101131000=                       +'
      
        '1101131001=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1101131002=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1101131003=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      
        '1101131004=                        and z.IS_SPISANIE <> 2)   -- ' +
        #1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072 +
        ' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      '1101131005=                       +'
      
        '1101131006=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1101131007=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1101131008=                       +'
      
        '1101131009=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1101131010=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1101131011=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1101131012=                       -'
      
        '1101131013=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_' +
        'ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101131014=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_)'
      '1101131015=                       -'
      
        '1101131016=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1101131017=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1101131018=                  from rdb$database) PRICE,'
      '1101131019=                 NULL,'
      '1101131020=                 NULL,'
      '1101131021=                 NULL,'
      '1101131022=                 NULL'
      '1101131023=            FROM G_PRODUCT G'
      '1101131024=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1101131025=          UNION ALL'
      '1101131026=          SELECT SP.IS_VOZVRAT,'
      '1101131027=                 SP.DATE_RECEIPT DATE_SORT,'
      '1101131028=                 SP.DATE_RECEIPT DATE_ACT,'
      '1101131029=                 DECODE(SP.IS_VOZVRAT,'
      
        '1101131030=                        0, '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072', '#1087#1086#1089#1090#1072 +
        #1074#1097#1080#1082' '#39'||SUBSTRING(COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39') FROM 1 FOR 300),'
      
        '1101131031=                        1, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39'|' +
        '|COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39'),'
      
        '1101131032=                        2, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39'|' +
        '|COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39'),'
      
        '1101131033=                        5, '#39#1042#1099#1088#1072#1074#1085#1080#1074#1072#1085#1080#1077' '#1086#1089#1090#1072#1090#1082#1086#1074' ('#1088#1077 +
        #1074#1080#1079#1080#1103')'#39'),'
      '1101131034=                 S.PRICE,'
      '1101131035=                 S.AMOUNT,'
      '1101131036=                 S.SUMM,'
      '1101131037=                 NULL,'
      '1101131038=                 NULL,'
      '1101131039=                 NULL'
      
        '1101131040=            FROM SKLAD_PARENT SP LEFT OUTER JOIN G_CL' +
        'IENT C ON SP.G_CLIENT = C.G_CLIENT,'
      '1101131041=                 SKLAD S,'
      '1101131042=                 G_PRODUCT G'
      
        '1101131043=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_' +
        'TOCHKA||'#39'-'#39
      
        '1101131044=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_' +
        ' AND :DATE_END_'
      '1101131045=             AND SP.SKLAD = S.SKLAD_PARENT'
      '1101131046=             AND S.G_PRODUCT = G.G_PRODUCT'
      '1101131047=             AND G.G_PRODUCT = :G_PRODUCT_'
      '1101131048=             AND SP.IS_VOZVRAT NOT IN (2, 3, 4)'
      '1101131049=          UNION ALL'
      '1101131050=          SELECT SP.IS_VOZVRAT,'
