        #1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056 +
        #1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
