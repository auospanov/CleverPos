      '1106016923=;'
      '1106016924='
      '1106016925=ALTER PROCEDURE G_INS_G_CONTRAGENT('
      '1106016926=  NAME_ TYPE OF COLUMN G_CONTRAGENT.NAME,'
      '1106016927=  SHORT_NAME_ TYPE OF COLUMN G_CONTRAGENT.SHORT_NAME)'
      '1106016928=RETURNS ('
      
        '1106016929=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAG' +
        'ENT,'
      '1106016930=  ERR_CODE INTEGER,'
      '1106016931=  ERR_MSG VARCHAR(1024))'
