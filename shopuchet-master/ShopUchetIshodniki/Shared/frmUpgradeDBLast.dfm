        ','
      '1102016041=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102016042=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102016043=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
