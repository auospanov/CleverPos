        'IS_EXPECTED = 1)) SUMM_PRIHOD_SKL,'
      
        '1102015086=               -- '#1059#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1059#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1044#1056'. '#1057#1050 +
        #1051#1040#1044' '#1048' '#1059#1061#1054#1044' '#1050#1054#1052#1055#1051#1045#1050#1058#1059#1070#1065#1048#1061' '#1055#1056#1048' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1045', '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1059
      '1102015087=               (SELECT COALESCE(SUM(AMOUNT), 0)'
      
