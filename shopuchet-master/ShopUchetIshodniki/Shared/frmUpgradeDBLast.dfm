        '1101323285=                        EXECUTE PROCEDURE K_DEL_KASSA' +
        '(:KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_' +
        'MSG);'
      
        '1101323286=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1101323287=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101323288=                          EXIT;'
      '1101323289=                        END'
      '1101323290='
      '1101323291=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '1101323292=                           EXECUTE PROCEDURE K_INS_KA' +
        'SSA(0,     -- ACTION_ => :ACTION_'
      
        '1101323293=                                                     ' +
        '     1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101323294=                                                     ' +
