        '1102251886=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TO' +
        'CHKA||'#39'-'#39
      '1102251887=           AND K.G_PRIHOD_RASHOD in (1, -5)'
      '1102251888=           AND :MODE_ = 0'
      '1102251889=        UNION ALL'
      '1102251890=        SELECT 3 ROW,'
      
        '1102251891=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1082#1083#1080#1077#1085#1090#1086#1084' '#39'||S.SKLAD||'#39' '#1086#1090 +
        ' '#39'||lpad(EXTRACT(DAY FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpad(EX' +
        'TRACT(MONTH FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FRO' +
        'M S.DATE_RECEIPT) str,'
      '1102251892=               S.SKLAD ID,'
