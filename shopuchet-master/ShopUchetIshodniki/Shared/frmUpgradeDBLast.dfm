      '1102254002=ALTER PROCEDURE UPSERT_SKLAD_EXT_LOAD('
      '1102254003=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1102254004=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1102254005=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102254006=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102254007=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102254008=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102254009=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102254010=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1102254011=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102254012=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      '1102254013=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102254014=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102254015=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102254016=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102254017=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102254018=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102254019=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102254020=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL)'
      '1102254021=RETURNS ('
      '1102254022=  ERR_CODE INTEGER,'
      '1102254023=  ERR_MSG VARCHAR(1024))'
      '1102254024=AS'
      
        '1102254025=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1055#1056#1048#1061#1054#1044#1040' '#1048#1047' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071' ' +
        '- '#1052#1054#1041#1048#1051#1050#1048' '#1048#1051#1048' '#1057#1040#1049#1058#1040
      
        '1102254026=-- '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1058#1040#1050#1054#1049' ID - '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1054' '#1054#1041#1053 +
        #1054#1042#1051#1071#1070', '#1053#1045#1058' - '#1058#1040#1050' '#1042#1057#1058#1040#1042#1051#1071#1070
      
        '1102254027=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPSERT_SKLA' +
        'D_EXT_LOAD'#39';'
      
        '1102254028=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD = NULL;'
      '1102254029=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102254030=BEGIN'
      '1102254031='
      '1102254032=  PNT_ = '#39'00'#39';'
      '1102254033='
      '1102254034=  SELECT SP.SKLAD'
      '1102254035=    FROM SKLAD_PARENT SP'
      '1102254036=   WHERE SP.REC_ID = :REC_ID_'
      '1102254037=    INTO :SKLAD_PARENT_;'
      '1102254038='
      '1102254039=  IF (SKLAD_PARENT_ IS NULL) THEN BEGIN'
      '1102254040='
      '1102254041=    PNT_ = '#39'01'#39';'
      
        '1102254042=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_, :DATE_REC' +
        'EIPT_, :TIME_RECEIPT_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_' +
        ','
      
        '1102254043=        :NOTE_, :IS_VOZVRAT_, :SUMM_, :SUMM_FACT_, NU' +
        'LL /*:G_PRIHOD_*/, 0 /*:SUMM_PRIHOD_*/, :PAYMENTS_, :SUMM_CURREN' +
        'CY_, :IS_EXPECTED_,'
      
        '1102254044=        :UPLOAD_TO_EXT_APP_, :USER_ID_, :LOG_BODY_, :' +
        'G_OFFICIAL_, :REC_ID_)'
      
        '1102254045=        RETURNING_VALUES :SKLAD_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102254046='
      '1102254047=  END'
      '1102254048=  ELSE BEGIN'
      '1102254049='
      '1102254050=    PNT_ = '#39'02'#39';'
      
        '1102254051=    EXECUTE PROCEDURE UPD_SKLAD(:SKLAD_PARENT_, :DATE' +
        '_RECEIPT_, :TIME_RECEIPT_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVA' +
        'NIE_,'
      
        '1102254052=        :NOTE_, :SUMM_, :SUMM_FACT_, NULL /*:G_PRIHOD' +
        '_*/, 0 /*:SUMM_PRIHOD_*/, :PAYMENTS_, :SUMM_CURRENCY_, :IS_EXPEC' +
        'TED_,'
      '1102254053=        :UPLOAD_TO_EXT_APP_, :USER_ID_, :LOG_BODY_)'
      '1102254054=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102254055='
      '1102254056=    DELETE FROM SKLAD_TMP;'
      '1102254057='
      '1102254058=  END'
      '1102254059='
      '1102254060=  IF (:ERR_CODE <> 0) THEN'
      
        '1102254061=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102254062=END'
      '1102254063=;'
      '1102254064='
