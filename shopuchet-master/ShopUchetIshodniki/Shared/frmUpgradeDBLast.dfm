      '1102283571=                END'
      '1102283572='
      
        '1102283573=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1102283574=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1102283575=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1102283576=                      FROM SKLAD SK'
      '1102283577=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102283578=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1102283579=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1102283580=                       AND SK.is_vozvrat IN (0,3,4)'
      '1102283581=                      INTO :DATE_LAST_;'
      '1102283582='
      
        '1102283583=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102283584=                      UPDATE SKLAD SK'
      '1102283585=                         SET SK.IS_LAST = 0'
      
        '1102283586=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1102283587='
      '1102283588=                       UPDATE SKLAD SK'
      '1102283589=                         SET SK.IS_LAST = 1'
      
        '1102283590=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1102283591=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1102283592=                                           FROM SKLAD' +
        ' SS'
      
        '1102283593=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1102283594=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1102283595=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1102283596=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1102283597=                    END'
      '1102283598=                END*/'
      '1102283599=            END'
      '1102283600=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1102283601=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1102283602='
      '1102283603=      UPDATE SKLAD_PARENT'
      '1102283604=      SET'
      
        '1102283605=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1102283606=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1102283607=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102283608=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102283609=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102283610=       SUMM      = :SUMM_,'
      '1102283611=       SUMM_FACT = :SUMM_FACT_,'
      '1102283612=       IS_EXPECTED = :NOT_MINUS_OSTATOK_'
      '1102283613=      WHERE SKLAD  = :ZAKAZ_;'
      '1102283614=  END'
      '1102283615='
      '1102283616=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102283617='
      '1102283618=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102283619=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 2, :SUMM_, :LOG_BODY_, 0);'
      '1102283620='
      '1102283621=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102283622=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102283623=END'
      '1102283624=;'
      '1102283625='
