      '110402734=        INTO :G_TOCHKA_OLD_,'
      '110402735=             :G_TOCHKA_;'
      '110402736='
      
        '110402737=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063 +
        #1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040#1044 +
        #1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110402738=      PNT_ = '#39#39'021'#39#39';'
      '110402739=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '110402740=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, ' +
        'NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110402741=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402742=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110402743=            EXIT;'
      '110402744=          END'
      '110402745='
      '110402746=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110402747=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110402748=                FROM ZAKAZ_DETAILS_TMP Z'
      '110402749=              INTO :G_PRODUCT_,'
      '110402750=                  :Z_AMOUNT_,'
      '110402751=                  :PRICE_,'
      '110402752=                  :SUMMM_'
      '110402753=          DO BEGIN'
      '110402754=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '110402755=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '110402756=            IS_THIS_LAST_ = 0;'
      '110402757=            SELECT MAX(SK.DATE_RECEIPT)'
      '110402758=                FROM SKLAD SK'
      '110402759=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110402760=                 AND SK.IS_LAST = 1'
      '110402761=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '110402762=                INTO :DATE_LAST_;'
      '110402763='
      
        '110402764=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALESC' +
        'E(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110402765=                UPDATE SKLAD SK'
      '110402766=                   SET SK.IS_LAST = 0'
      '110402767=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110402768=                   AND SK.IS_LAST = 1'
      '110402769=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '110402770='
      '110402771=                IS_THIS_LAST_ = 1;'
      '110402772=            END'
      '110402773='
      '110402774='
      '110402775=            INSERT INTO SKLAD'
      '110402776=            ('
      '110402777=             SKLAD,'
      '110402778=             SKLAD_PARENT,'
      '110402779=             DATE_RECEIPT,'
      '110402780=             G_CLIENT,'
      '110402781=             G_PRODUCT,'
      '110402782=             AMOUNT,'
      '110402783=             PRICE,'
      '110402784=             SUMM,'
      '110402785=             G_PAYMENT_TYPE,'
      '110402786=             OSNOVANIE,'
      '110402787=             NOTE,'
      '110402788=             NDS,'
      '110402789=             NDS_SUMM,'
      '110402790=             IS_LAST,'
      '110402791=             IS_VOZVRAT,'
      '110402792=             G_TOCHKA'
      '110402793=            ) VALUES ('
      '110402794=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '110402795=             :ZAKAZ_,'
      '110402796=             :Z_DATE_,'
      '110402797=             :G_TOCHKA_,'
      '110402798=             :G_PRODUCT_,'
      '110402799=             :Z_AMOUNT_,'
      '110402800=             :PRICE_,'
      '110402801=             :SUMMM_,'
      '110402802=             :G_PAYMENT_TYPE_,'
      '110402803=             :OSNOVANIE_,'
      '110402804=             :NOTE_,'
      '110402805=             0,  --:RNDS_,'
      '110402806=             0,  --:RNDS_SUMM_,'
      
        '110402807=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048 +
        ' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050 +
        #1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057 +
        #1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '110402808=             3,  --:IS_VOZVRAT_,'
      '110402809=             :G_CLIENT_'
      '110402810=            );'
      '110402811='
      
        '110402812=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110402813=            PNT_ = '#39#39'023'#39#39';'
      '110402814=            UPDATE LT_SKLAD_PRODUCT L'
      '110402815=               SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '110402816=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402817=               AND L.G_TOCHKA = :G_CLIENT_;'
      '110402818='
      '110402819=            IF (ROW_COUNT = 0) THEN'
      
        '110402820=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD' +
        '_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110402821=          END'
      '110402822=      END'
      '110402823=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '110402824=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '110402825=      ELSE BEGIN'
      
        '110402826=          --------------------------------------------' +
        '-----------------'
      
        '110402827=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071 +
        ' '#1055#1056#1048#1061#1054#1044#1040
      '110402828=          PNT_ = '#39#39'025'#39#39';'
      '110402829=          FOR SELECT SKLAD,'
      '110402830=                     AMOUNT,'
      '110402831=                     G_PRODUCT'
      '110402832=                FROM SKLAD S'
      '110402833=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '110402834=                 AND NOT EXISTS (SELECT 1'
      
        '110402835=                                   FROM ZAKAZ_DETAILS_' +
        'TMP T'
      
        '110402836=                                  WHERE T.ZAKAZ_DETAIL' +
        'S = S.SKLAD)'
      '110402837=          INTO :SKLAD_,'
      '110402838=               :Z_AMOUNT_,'
      '110402839=               :G_PRODUCT_'
      '110402840=          DO BEGIN'
      
        '110402841=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110402842=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402843=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110402844=              EXIT;'
      '110402845=            END'
      '110402846=          END'
      '110402847='
      '110402848=          PNT_ = '#39#39'030'#39#39';'
      '110402849=          FOR SELECT S.ZAKAZ_DETAILS,'
      '110402850=                     S.G_PRODUCT,'
      '110402851=                     S.AMOUNT,'
      '110402852=                     S.PRICE,'
      '110402853=                     S.SUMM,'
      '110402854=                     T.SKLAD,'
      '110402855=                     T.AMOUNT,'
      '110402856=                     T.IS_LAST,'
      '110402857=                     T.DATE_RECEIPT'
      
        '110402858=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER JO' +
        'IN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE' +
        ' SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '110402859=                INTO :ZAKAZ_DETAILS_,'
      '110402860=                     :G_PRODUCT_,'
      '110402861=                     :Z_AMOUNT_,'
      '110402862=                     :PRICE_,'
      '110402863=                     :SUMMM_,'
      '110402864=                     :SKLAD_OLD_,'
      '110402865=                     :AMOUNT_OLD_,'
      '110402866=                     :IS_THIS_LAST_,'
      '110402867=                     :DATE_RECEIPT_OLD_'
      '110402868=          DO BEGIN'
      
        '110402869=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067 +
        #1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110402870=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '110402871=                INSERT INTO SKLAD (SKLAD, SKLAD_PARENT' +
        ', DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYM' +
        'ENT_TYPE, NDS, NDS_SUMM,'
      
        '110402872=                                  IS_LAST, NOTE, OSNOV' +
        'ANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '110402873=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :Z' +
        'AKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, :' +
        'SUMMM_, 1, 0, 0,'
      
        '110402874=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047 +
        #1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '110402875=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_CL' +
        'IENT_'
      '110402876=                       )'
      '110402877=                RETURNING'
      '110402878=                  SKLAD'
      '110402879=                INTO'
      '110402880=                  :SKLAD_;'
      '110402881='
      
        '110402882=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055 +
        #1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110402883=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110402884=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT' +
        '_'
      '110402885=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402886=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110402887='
      
        '110402888=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055 +
        #1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110402889=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110402890=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT' +
        '_'
      '110402891=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402892=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '110402893='
      '110402894=                IF (ROW_COUNT = 0) THEN'
      
        '110402895=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_S' +
        'KLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110402896='
      
        '110402897=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054#1053 +
        ' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049 +
        #1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110402898=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053 +
        #1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051 +
        #1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '110402899=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SK' +
        'LAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '110402900=                SELECT MAX(SK.DATE_RECEIPT)'
      '110402901=                  FROM SKLAD SK'
      '110402902=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110402903=                   AND SK.IS_LAST = 1'
      '110402904=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '110402905=                  INTO :DATE_LAST_;'
      '110402906='
      
        '110402907=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ >' +
        '= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058 +
        #1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110402908=                  UPDATE SKLAD SK'
      '110402909=                     SET SK.IS_LAST = 0'
      '110402910=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110402911=                     AND SK.IS_LAST = 1'
      '110402912=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '110402913='
      '110402914=                  UPDATE SKLAD SK'
      '110402915=                     SET SK.IS_LAST = 1'
      '110402916=                   WHERE SK.SKLAD = :SKLAD_;'
      '110402917=                END'
      '110402918='
      
        '110402919=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041 +
        #1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110402920=            END ELSE BEGIN'
      '110402921=                UPDATE SKLAD S'
      '110402922=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '110402923=                       S.AMOUNT   = :Z_AMOUNT_,'
      '110402924=                       S.PRICE    = :PRICE_,'
      '110402925=                       S.SUMM     = :SUMMM_,'
      '110402926=                       S.OSNOVANIE = :OSNOVANIE_,'
      '110402927=                       S.NOTE      = :NOTE_'
      '110402928=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '110402929='
      '110402930='
      
        '110402931=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN BEGI' +
        'N'
      
        '110402932=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110402933=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110402934=                     SET L.AMOUNT = L.AMOUNT + (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110402935=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402936=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110402937='
      
        '110402938=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110402939=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110402940=                     SET L.AMOUNT = L.AMOUNT - (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110402941=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402942=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110402943='
      
        '110402944=                END ELSE if (Z_AMOUNT_ > AMOUNT_OLD_) ' +
        'THEN BEGIN'
      
        '110402945=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110402946=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110402947=                     SET L.AMOUNT = L.AMOUNT - (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110402948=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402949=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110402950='
      
        '110402951=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110402952=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110402953=                     SET L.AMOUNT = L.AMOUNT + (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110402954=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402955=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110402956=                END'
      '110402957='
      
        '110402958=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059 +
        ' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054 +
        ' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '110402959=                IF ((Z_DATE_ > DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0)) THEN BEGIN'
      '110402960=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110402961=                      FROM SKLAD SK'
      '110402962=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110402963=                       AND SK.IS_LAST = 1'
      '110402964=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110402965=                      INTO :DATE_LAST_;'
      '110402966='
      
        '110402967=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044 +
        #1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110402968=                      UPDATE SKLAD SK'
      '110402969=                         SET SK.IS_LAST = 0'
      
        '110402970=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      '110402971=                         AND SK.IS_LAST = 1'
      '110402972=                         AND SK.G_TOCHKA = :G_CLIENT_;'
      '110402973='
      '110402974=                      UPDATE SKLAD SK'
      '110402975=                         SET SK.IS_LAST = 1'
      
        '110402976=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110402977=                    END'
      '110402978=                END'
      '110402979='
      
        '110402980=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059 +
        ' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055 +
        #1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '110402981=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 1)) THEN BEGIN'
      '110402982=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110402983=                      FROM SKLAD SK'
      '110402984=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110402985=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '110402986=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110402987=                       AND SK.is_vozvrat IN (0,3,4)'
      '110402988=                      INTO :DATE_LAST_;'
      '110402989='
      
        '110402990=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110402991=                      UPDATE SKLAD SK'
      '110402992=                         SET SK.IS_LAST = 0'
      
        '110402993=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110402994='
      '110402995=                       UPDATE SKLAD SK'
      '110402996=                         SET SK.IS_LAST = 1'
      
        '110402997=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      
        '110402998=                         AND SK.SKLAD = (SELECT MAX(SS' +
        '.SKLAD)'
      
        '110402999=                                           FROM SKLAD ' +
        'SS'
      
        '110403000=                                          WHERE SS.G_P' +
        'RODUCT = SK.G_PRODUCT'
      
        '110403001=                                            AND SS.DAT' +
        'E_RECEIPT = :DATE_LAST_'
      
        '110403002=                                            AND SS.G_T' +
        'OCHKA = :G_CLIENT_'
      
        '110403003=                                            AND SS.is_' +
        'vozvrat IN (0,3,4));'
      '110403004=                    END'
      '110403005=                END'
      '110403006=            END'
      '110403007=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '110403008=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '110403009='
      '110403010=      UPDATE SKLAD_PARENT'
      '110403011=      SET'
      
        '110403012=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110403013=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      
        '110403014=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),    ' +
        '   -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110403015=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110403016=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110403017=       SUMM      = :SUMM_,'
      '110403018=       SUMM_FACT = :SUMM_FACT_'
      '110403019=      WHERE SKLAD  = :ZAKAZ_;'
      '110403020=  END'
      '110403021='
      '110403022=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110403023=END'
      '110403024='#39';'
      '110403025=END  --END_EXECUTE_BLOCK'
      '110403026=EXECUTE BLOCK AS BEGIN'
      '110403027='
      
        '110403028=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        '_REAL('
      '110403029=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110403030=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110403031=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110403032=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110403033=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110403034=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110403035=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110403036=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110403037=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110403038=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT)'
      '110403039=RETURNS ('
      '110403040=  ERR_CODE INTEGER,'
      '110403041=  ERR_MSG VARCHAR(1024))'
      '110403042=AS'
      '110403043=/*'
      
        '110403044='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'-'#1054#1055#1051#1040#1058#1059' '#1047#1040 +
        ' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051
      '110403045='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1060#1054#1056#1052#1045' TOplataTovaraRealNForm'
      '110403046='
      
        '110403047=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1040#1055#1044#1045#1049#1058' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058 +
        #1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110403048=*/'
      
        '110403049=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL_REAL'#39#39';'
      '110403050=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110403051=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110403052=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110403053=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      
        '110403054=DECLARE VARIABLE Z_G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.G_PRODUCT;'
      
        '110403055=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '110403056=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '110403057=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      '110403058=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110403059=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110403060=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110403061=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110403062=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110403063=BEGIN'
      
        '110403064=  --**************************************************' +
        '************************************************'
      
        '110403065=  --**************************************************' +
        '************************************************'
      '110403066=  --  '#1040#1055#1044#1045#1049#1058' '#1054#1041#1067#1063#1053#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1047#1040' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403067=  --**************************************************' +
        '************************************************'
      
        '110403068=  --**************************************************' +
        '************************************************'
      '110403069=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110403070=      SELECT Z.G_PAYMENT_TYPE'
      '110403071=        FROM ZAKAZ Z'
      '110403072=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110403073=        INTO :G_PAYMENT_TYPE_OLD_;'
      '110403074='
      '110403075=      PNT_ = '#39#39'01a'#39#39';'
      '110403076=      UPDATE zakaz'
      '110403077=      SET'
      '110403078=       Z_DATE = :Z_DATE_,'
      '110403079=       Z_TIME = :Z_TIME_,'
      '110403080=       G_CLIENT = :G_CLIENT_,'
      '110403081=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110403082=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110403083=       NOTE = COALESCE(:NOTE_, NOTE),'
      '110403084=       SUMM = :SUMM_,'
      '110403085=       SUMM_FACT = :SUMM_FACT_'
      '110403086=      WHERE'
      '110403087=        zakaz = :zakaz_;'
      '110403088='
      '110403089=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '110403090=      PNT_ = '#39#39'02a'#39#39';'
      
        '110403091=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110403092=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110403093=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110403094=        EXIT;'
      '110403095=      END'
      '110403096='
      '110403097=      PNT_ = '#39#39'03a'#39#39';'
      '110403098=      DELETE from zakaz_DETAILS z'
      '110403099=      WHERE z.zakaz = :zakaz_;'
      '110403100=      FOR SELECT G_PRODUCT,'
      '110403101=                 AMOUNT,'
      '110403102=                 SUMM,'
      '110403103=                 ZAKAZ_NA_REAL,'
      '110403104=                 ZAKAZ_DETAILS'
      '110403105=            FROM ZAKAZ_DETAILS_TMP_REAL'
      '110403106=      INTO :Z_G_PRODUCT_,'
      '110403107=           :Z_AMOUNT_,'
      '110403108=           :Z_SUMM_,'
      '110403109=           :ZAKAZ_NA_REAL_,'
      '110403110=           :ZAKAZ_DETAILS_'
      '110403111=      DO BEGIN'
      '110403112=        PNT_ = '#39#39'04a'#39#39';'
      
        '110403113=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE' +
        ', DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '110403114=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE'
      '110403115=          FROM ZAKAZ_DETAILS_TMP_REAL Z'
      '110403116=         WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      
        '110403117=           AND Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;   --' +
        #1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1054#1043#1059#1058' '#1055#1054#1042#1058#1054#1056#1071#1058#1068#1057#1071' :ZAKAZ_NA_REAL_, '#1058#1054' '#1045#1057#1058#1068' '#1055#1054' '#1054#1044#1053#1054#1052#1059' ' +
        ':ZAKAZ_NA_REAL_ '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' :ZAKAZ_DETAILS_'
      '110403118='
      '110403119=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110403120=        PNT_ = '#39#39'05a'#39#39';'
      '110403121=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110403122=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :Z_AM' +
        'OUNT_,'
      
        '110403123=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110403124=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, Z' +
        'R.AMOUNT_PAYED + :Z_AMOUNT_, 1, 0)'
      '110403125=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110403126='
      
        '110403127=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ' +
        'ZAKAZ_DETAILS - ZAKAZ_REAL, '#1053#1054' '#1058'.'#1050'. ZAKAZ_DETAILS '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1057' ' +
        'ID ZAKAZ_REAL ('#1042#1067#1064#1045' '#1047#1040#1055#1054#1051#1053#1071#1045#1058#1057#1071' ZAKAZ_DETAILS_TMP),'
      
        '110403128=        -- '#1058#1054' '#1058#1059#1058' '#1054#1041#1045' '#1050#1054#1051#1054#1053#1050#1048' '#1041#1059#1044#1059#1058' '#1055#1054#1061#1054#1046#1048' '#1044#1056#1059#1043' '#1053#1040' '#1044#1056#1059 +
        #1043#1040
      '110403129=        PNT_ = '#39#39'06a'#39#39';'
      
        '110403130=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110403131=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110403132=      END'
      '110403133='
      '110403134=      ----------------------------------------'
      
        '110403135=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058#1068 +
        ' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '110403136=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048' ' +
        #1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '110403137=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048 +
        #1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110403138=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '110403139=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047 +
        #1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068 +
        ' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '110403140=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042 +
        #1045#1053#1053#1054')'
      
        '110403141=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110403142=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '110403143=      if (G_PAYMENT_TYPE_OLD_ = 1) then'
      '110403144=          SELECT S.KASSA,'
      '110403145=                 S.G_TOCHKA'
      '110403146=            FROM KASSA S'
      '110403147=           WHERE S.ZAKAZ = :ZAKAZ_'
      
        '110403148=             AND S.G_PRIHOD_RASHOD = 1     -- '#1055#1056#1054#1044#1040#1046#1040' ' +
        #1058#1054#1042#1040#1056#1040
      '110403149=            INTO :KASSA_,'
      '110403150=                 :G_TOCHKA_;'
      '110403151=      ELSE'
      '110403152=          SELECT S.KASSA_BEZNAL,'
      '110403153=                 S.G_TOCHKA'
      '110403154=            FROM KASSA_BEZNAL S'
      '110403155=           WHERE S.ZAKAZ = :ZAKAZ_'
      '110403156=             AND S.G_PRIHOD_RASHOD = 1'
      '110403157=            INTO :KASSA_,'
      '110403158=                 :G_TOCHKA_;'
      '110403159='
      
        '110403160=        -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' ' +
        #1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '110403161=        IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THE' +
        'N BEGIN'
      '110403162=          PNT_ = '#39#39'05'#39#39';'
      '110403163=          EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110403164=                                        0,     -- ACTI' +
        'ON_'
      
        '110403165=                                        1,     --:G_PR' +
        'IHOD_RASHOD_,'
      '110403166=                                        :SUMM_FACT_,'
      '110403167=                                        :Z_DATE_,'
      
        '110403168=                                        NULL,   --NOTE' +
        '_'
      '110403169=                                        :ZAKAZ_,'
      '110403170=                                        NULL,'
      
        '110403171=                                        :G_PAYMENT_TYP' +
        'E_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110403172=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110403173=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110403174=            EXIT;'
      '110403175=          END'
      '110403176='
      
        '110403177=        -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110403178=        -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110403179=        END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_' +
        'TYPE_) THEN BEGIN'
      '110403180=            PNT_ = '#39#39'07'#39#39';'
      
        '110403181=            EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110403182=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110403183=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110403184=              EXIT;'
      '110403185=            END'
      '110403186='
      
        '110403187=            EXECUTE PROCEDURE K_INS_KASSA(0,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110403188=                                          1,     -- G_' +
        'PRIHOD_RASHOD_'
      '110403189=                                          :SUMM_FACT_,'
      '110403190=                                          :Z_DATE_,'
      
        '110403191=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110403192=                                          :ZAKAZ_,   -' +
        '-ZAKAZ_'
      '110403193=                                          NULL,'
      
        '110403194=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110403195=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110403196=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110403197=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110403198=              EXIT;'
      '110403199=            END'
      '110403200=        END'
      '110403201=      ----------------------------------------'
      '110403202=  END'
      '110403203=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403204=  --**************************************************' +
        '************************************************'
      
        '110403205=  --**************************************************' +
        '************************************************'
      '110403206='
      
        '110403207=  --**************************************************' +
        '************************************************'
      
        '110403208=  --**************************************************' +
        '************************************************'
      '110403209=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403210=  --**************************************************' +
        '************************************************'
      
        '110403211=  --**************************************************' +
        '************************************************'
      '110403212=  ELSE BEGIN'
      '110403213=      UPDATE SKLAD_PARENT'
      '110403214=      SET'
      
        '110403215=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110403216=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      
        '110403217=       G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_P' +
        'AYMENT_TYPE),'
      '110403218=       G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110403219=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110403220=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110403221=       SUMM = :SUMM_,'
      '110403222=       SUMM_FACT = :SUMM_FACT_'
      '110403223=      WHERE SKLAD  = :ZAKAZ_'
      '110403224=      RETURNING G_TOCHKA'
      '110403225=      INTO :G_TOCHKA_;'
      '110403226='
      '110403227=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '110403228=      PNT_ = '#39#39'02'#39#39';'
      
        '110403229=      EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, NULL' +
        ') RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110403230=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110403231=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110403232=        EXIT;'
      '110403233=      END'
      '110403234='
      '110403235=      PNT_ = '#39#39'03'#39#39';'
      '110403236=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '110403237=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ZA' +
        'KAZ_DETAILS - ZAKAZ_REAL'
      
        '110403238=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110403239=      FOR SELECT T.AMOUNT,'
      '110403240=                 T.SUMM,'
      '110403241=                 T.G_PRODUCT,'
      '110403242=                 T.ZAKAZ_NA_REAL,'
      '110403243=                 T.ZAKAZ_DETAILS'
      '110403244=                 ,T.PRICE'
      '110403245=                 ,T.NDS'
      '110403246=                 ,T.NDS_SUMM'
      '110403247=                 ,T.DISCOUNT_TENGE'
      '110403248=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110403249=            INTO :Z_AMOUNT_,'
      '110403250=                 :Z_SUMM_,'
      '110403251=                 :Z_G_PRODUCT_,'
      '110403252=                 :ZAKAZ_NA_REAL_,'
      '110403253=                 :ZAKAZ_DETAILS_'
      '110403254=                 ,:PRICE_'
      '110403255=                 ,:NDS_'
      '110403256=                 ,:NDS_SUMM_'
      '110403257=                 ,:DISCOUNT_TENGE_'
      '110403258=      DO BEGIN'
      
        '110403259=        INSERT INTO SKLAD(SKLAD, G_PRODUCT, DATE_RECEI' +
        'PT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, IS_VOZVRAT'
      
        '110403260=                         ,G_CLIENT, G_PAYMENT_TYPE, OS' +
        'NOVANIE, NOTE, G_TOCHKA)'
      
        '110403261=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :Z_G_PRODUC' +
        'T_, :Z_DATE_, :Z_AMOUNT_, :PRICE_ - :DISCOUNT_TENGE_, :Z_SUMM_, ' +
        ':NDS_, :NDS_SUMM_, :ZAKAZ_, 2'
      
        '110403262=                         ,:G_CLIENT_, :G_PAYMENT_TYPE_' +
        ', :OSNOVANIE_, :NOTE_, :G_TOCHKA_);'
      '110403263='
      
        '110403264=        UPDATE LT_SKLAD_PRODUCT L       -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1050#1054 +
        #1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110403265=           SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '110403266=         WHERE L.G_PRODUCT = :Z_G_PRODUCT_'
      '110403267=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110403268='
      
        '110403269=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110403270=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110403271='
      '110403272=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110403273=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :Z_AMOUNT_,'
      
        '110403274=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110403275=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':Z_AMOUNT_, 1, 0)'
      '110403276=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110403277=      END'
      '110403278=  END'
      '110403279=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403280=  --**************************************************' +
        '************************************************'
      
        '110403281=  --**************************************************' +
        '************************************************'
      '110403282='
      '110403283=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110403284=END'
      '110403285='#39';'
      '110403286='
      '110403287='
      '110403288=EXECUTE STATEMENT '#39'ALTER PROCEDURE DO_PRODUCT('
      '110403289=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110403290=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '110403291=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110403292=  AMOUNT_ INTEGER,'
      '110403293=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '110403294=RETURNS ('
      '110403295=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '110403296=  ERR_CODE INTEGER,'
      '110403297=  ERR_MSG VARCHAR(1024))'
      '110403298=AS'
      '110403299=/*'
      
        '110403300='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055 +
        #1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '110403301='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '110403302=*/'
      
        '110403303=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'DO_PRODUCT'#39 +
        #39';'
      '110403304=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110403305=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042 +
        #1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '110403306=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT;'
      
        '110403307=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '110403308=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067 +
        ' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '110403309=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110403310=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110403311=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ' = 0;'
      
        '110403312=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '110403313=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      '110403314=BEGIN'
      '110403315=  PNT_ = '#39#39'00'#39#39';'
      '110403316='
      '110403317=  IF (G_TOCHKA_ IS NULL) THEN'
      '110403318=    SELECT ID'
      '110403319=      FROM CUR_PARAMS'
      '110403320=     WHERE CUR_PARAMS = 2'
      '110403321=      INTO :G_TOCHKA_;'
      '110403322='
      '110403323=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '110403324=  SELECT P.S_VALUE'
      '110403325=    FROM SYSTEM_SETUP P'
      '110403326=   WHERE P.SYSTEM_SETUP = 2'
      '110403327=    INTO :CAN_SELL_;'
      '110403328='
      '110403329=  SELECT MAX(G.NAME)'
      '110403330=    FROM G_PRODUCT G,'
      '110403331=         G_PRODUCT_KIT K'
      '110403332=   WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '110403333=     AND K.G_PRODUCT = :G_PRODUCT_'
      
        '110403334=     AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PRODU' +
        'CT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCHKA_' +
        '), 0) < (K.AMOUNT * :AMOUNT_)'
      '110403335=    INTO :NAME_;'
      '110403336='
      '110403337=  IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEGIN'
      '110403338=    ERR_CODE = -20500;'
      
        '110403339=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1089#1090#1072#1090#1086#1082' ' +
        #1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39#39'||NAME_||'#39#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1089#1086#1073 +
        #1088#1072#1090#1100' '#1087#1088#1086#1076#1091#1082#1090'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110403340=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110403341=    EXIT;'
      '110403342=  END'
      '110403343='
      '110403344=  PNT_ = '#39#39'01'#39#39';'
      '110403345=  -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '110403346=  INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIVAL_' +
        'TYPE, PARENT_ID, NOTE, G_TOCHKA)'
      
        '110403347=  VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0, 1' +
        ', :OTHER_, :NOTE_, :G_TOCHKA_)'
      '110403348=  RETURNING OTHER'
      '110403349=  INTO :OTHER_;'
      '110403350='
      '110403351=  FOR SELECT K.G_PRODUCT_ITEM'
      '110403352=            ,K.AMOUNT*:AMOUNT_'
      '110403353=            ,K.amount'
      '110403354=            ,G.G_PRODUCT'
      '110403355=        FROM G_PRODUCT_KIT K'
      '110403356=            ,G_PRODUCT G'
      '110403357=       WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110403358=         AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '110403359=        INTO :ITEM_'
      '110403360=            ,:AMOUNT_NEED_'
      '110403361=            ,:AMOUNT_NEED_ONE_'
      '110403362=            ,:G_PRODUCT_KIT_'
      '110403363=  DO BEGIN'
      
        '110403364=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_K' +
        'IT_, NULL, 1)'
      '110403365=      RETURNING_VALUES :SELF_PRICE_;'
      '110403366='
      '110403367=    UPDATE LT_SKLAD_PRODUCT L'
      '110403368=       SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110403369=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110403370=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110403371='
      '110403372=    IF (ROW_COUNT = 0) THEN'
      
        '110403373=      INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(GEN_' +
        'LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G_TOC' +
        'HKA_);'
      '110403374='
      
        '110403375=    INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHER, G' +
        '_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110403376=    VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_, :G_' +
        'PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110403377='
      
        '110403378=    COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*SELF_' +
        'PRICE_;'
      '110403379=  END'
      '110403380='
      '110403381='
      
        '110403382=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063#1040#1051#1045' ' +
        #1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110403383=  PNT_ = '#39#39'02'#39#39';'
      
        '110403384=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM)'
      
        '110403385=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :AM' +
        'OUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110403386='
      '110403387=  EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110403388=                              :DATE_,'
      '110403389=                              CURRENT_TIME,'
      '110403390=                              NULL, --:G_CLIENT__,'
      
        '110403391=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110403392=                              NULL, --:OSNOVANIE__,'
      '110403393=                              :NOTE_,'
      '110403394=                              4, --:IS_VOZVRAT_,'
      '110403395=                              :AMOUNT_*:COST_PRICE_,'
      '110403396=                              :AMOUNT_*:COST_PRICE_,'
      '110403397=                              0, --:G_PRIHOD_,'
      '110403398=                              0 --:SUMM_PRIHOD_)'
      '110403399=                              ,NULL     --PAYMENTS_'
      
        '110403400=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110403401=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110403402=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110403403=      EXIT;'
      '110403404=  END'
      '110403405='
      '110403406=  UPDATE OTHER O'
      '110403407=    SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110403408=  WHERE O.OTHER = :OTHER_;'
      '110403409=END'
      '110403410='#39';'
      '110403411='
      '110403412=EXECUTE STATEMENT '#39'ALTER PROCEDURE IMPORT_DOWNLOAD('
      '110403413=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110403414=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110403415=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110403416=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110403417=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110403418=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110403419=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110403420=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110403421=RETURNS ('
      '110403422=  ERR_CODE INTEGER,'
      '110403423=  ERR_MSG VARCHAR(1024))'
      '110403424=AS'
      '110403425=/*'
      
        '110403426='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059' ' +
        #1044#1040#1053#1053#1067#1061
      
        '110403427='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054' ' +
        #1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '110403428='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '110403429=*/'
      
        '110403430=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'IMPORT_DOWNL' +
        'OAD'#39#39';'
      '110403431=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110403432=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.BARCODE;'
      
        '110403433=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.ARTICUL;'
      
        '110403434=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.AMOUNT;'
      
        '110403435=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP.' +
        'PRICE;'
      
        '110403436=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.PRICE;'
      
        '110403437=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.DISCOUNT;'
      '110403438=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '110403439=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110403440=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2' +
        ');'
      
        '110403441=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '110403442=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '110403443=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.ZAKAZ_DETAILS;'
      
        '110403444=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      '110403445=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110403446=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      
        '110403447=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110403448=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NONC' +
        'ASH;'
      '110403449=BEGIN'
      '110403450='
      '110403451=  PNT_ = '#39#39'00'#39#39';'
      '110403452=  CLRF = ascii_char( 10 );'
      '110403453='
      '110403454=  SELECT S.S_VALUE'
      '110403455=    FROM SYSTEM_SETUP S'
      '110403456=   WHERE S.SYSTEM_SETUP = 2'
      '110403457=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110403458='
      '110403459=  PNT_ = '#39#39'01'#39#39';'
      '110403460=  SELECT G.nds_value'
      '110403461=    FROM G_FIRM_REKVIZIT G'
      '110403462=   WHERE G.is_default = 1'
      '110403463=    INTO :NDS_;'
      '110403464='
      '110403465=  PNT_ = '#39#39'02'#39#39';'
      
        '110403466=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39#39#39')), ARTICUL, A' +
        'MOUNT, PRICE, DISCOUNT'
      '110403467=        FROM IMPORT_TBL_TMP'
      
        '110403468=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_, ' +
        ':DISCOUNT_'
      '110403469=  DO BEGIN'
      '110403470=    SELECT G_PRODUCT,'
      '110403471=           PRICE'
      '110403472=      FROM ('
      '110403473=            SELECT P.G_PRODUCT, P.price'
      '110403474=              FROM G_PRODUCT P'
      
        '110403475=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(COA' +
        'LESCE(P.BARCODE, '#39#39#39#39')) <> '#39#39#39#39')'
      
        '110403476=                OR (P.ARTICUL = :ARTICUL_ and TRIM(COA' +
        'LESCE(P.ARTICUL, '#39#39#39#39')) <> '#39#39#39#39')'
      '110403477=            UNION'
      '110403478=            SELECT LT.G_PRODUCT, P.PRICE'
      '110403479=              FROM LT_BARCODE LT, g_product P'
      
        '110403480=             WHERE LT.BARCODE = :BARCODE_ and TRIM(COA' +
        'LESCE(LT.BARCODE, '#39#39#39#39')) <> '#39#39#39#39
      '110403481=               AND LT.g_product = P.g_product'
      '110403482=           )'
      '110403483=      INTO :G_PRODUCT_,'
      '110403484=           :PRICE_OUR_;'
      '110403485='
      '110403486=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '110403487=      ERR_CODE = -20500;'
      
        '110403488=      ERR_MSG = '#39#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        #39'||BARCODE_||'#39#39', '#1072#1088#1090#1080#1082#1091#1083' '#39#39'||ARTICUL_;'
      '110403489=      Exit;'
      '110403490=    END'
      '110403491='
      '110403492=    PNT_ = '#39#39'03'#39#39';'
      
        '110403493=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / P' +
        'RICE_;'
      
        '110403494=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_,' +
        ' :G_TOCHKA_, 1)'
      '110403495=      RETURNING_VALUES :COST_PRICE_;'
      '110403496='
      '110403497=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '110403498=    IF (price_ IS NULL) THEN'
      '110403499=      PRICE_ = PRICE_OUR_;'
      '110403500='
      '110403501=    PNT_ = '#39#39'04'#39#39';'
      
        '110403502=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PRODU' +
        'CT_,'
      
        '110403503=                                              :AMOUNT_' +
        ','
      '110403504=                                              :PRICE_,'
      
        '110403505=                                              :AMOUNT_' +
        ' * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '110403506=                                              :DISCOUN' +
        'T_PERC_,'
      
        '110403507=                                              :DISCOUN' +
        'T_,'
      
        '110403508=                                              :AMOUNT_' +
        ' * :DISCOUNT_,'
      '110403509=                                              :NDS_,'
      
        '110403510=                                              SUMM_ * ' +
        'NDS_ / (100 + NDS_),'
      
        '110403511=                                              :COST_PR' +
        'ICE_,'
      
        '110403512=                                              :ALLOW_S' +
        'ELL_ABSENT_GOODS_,'
      
        '110403513=                                              0,     -' +
        '-IS_SPISANIE_'
      
        '110403514=                                              1,     -' +
        '- NEW_LINE_SALE_'
      
        '110403515=                                              0     --' +
        'MODE_'
      
        '110403516=                                              ) RETURN' +
        'ING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '110403517=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110403518=      ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39 +
        ', ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '110403519=      EXIT;'
      '110403520=    END'
      '110403521='
      '110403522=    G_PRODUCT_ = NULL;'
      '110403523=  END'
      '110403524='
      '110403525=  PNT_ = '#39#39'05'#39#39';'
      '110403526=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '110403527=    SELECT SUM(T.summ)'
      '110403528=      FROM ZAKAZ_DETAILS_TMP T'
      '110403529=      INTO :SUMM_;'
      '110403530=    SUMM_FACT_ = SUMM_;'
      '110403531=  END'
      '110403532='
      '110403533=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '110403534=  if (G_PAYMENT_TYPE_ = 1) then'
      '110403535=    SUMM_CASH_ = summ_fact_;'
      '110403536=  ELSE'
      '110403537=    SUMM_NONCASH_ = summ_fact_;'
      '110403538='
      '110403539=  PNT_ = '#39#39'06'#39#39';'
      '110403540=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '110403541=    G_CLIENT_ = 10;'
      '110403542='
      '110403543=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110403544=                              :Z_DATE_,'
      '110403545=                              :Z_TIME_,'
      '110403546=                              :G_CLIENT_,'
      '110403547=                              :G_PAYMENT_TYPE_,'
      '110403548=                              '#39#39#39#39', --:OSNOVANIE_,'
      '110403549=                              0,  -- IS_SPISANIE'
      
        '110403550=                              '#39#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39#39'||:NO' +
        'TE_,'
      '110403551=                              :SUMM_,'
      '110403552=                              :SUMM_FACT_,'
      '110403553=                              :SUMM_CASH_,'
      '110403554=                              :SUMM_NONCASH_,'
      
        '110403555=                              0,    --:SUMM_PAY_BONUS_' +
        '_,'
      
        '110403556=                              0,    --:SUMM_BONUS_GOT_' +
        '_,'
      
        '110403557=                              NULL,        --:G_PRIHOD' +
        '_,'
      
        '110403558=                              NULL,        --:SUMM_PRI' +
        'HOD_'
      '110403559=                              0,    -- :BY_RECIPE__,'
      '110403560=                              0,    -- IS_RESERVE__'
      '110403561=                              NULL -- :PAYMENTS__'
      '110403562=                              )'
      
        '110403563=                              RETURNING_VALUES :ZAKAZ_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110403564=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110403565=    ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39',' +
        ' ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '110403566=    EXIT;'
      '110403567=  END'
      '110403568='
      '110403569=  DELETE FROM import_tbl_tmp;'
      '110403570='
      '110403571=WHEN ANY DO BEGIN'
      '110403572=    ERR_CODE = gdscode;'
      
        '110403573=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||gd' +
        'scode;'
      '110403574=  END'
      '110403575=end'
      '110403576='#39';'
      '110403577='
      
        '110403578=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAYAVKA_POSTA' +
        'VSHIK('
      '110403579=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110403580=  BEGIN_DATE_ DATE,'
      '110403581=  END_DATE_ DATE,'
      '110403582=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110403583=  DO_SKLAD_ INTEGER,'
      '110403584=  MODE_ INTEGER,'
      '110403585=  MODE_VYBOR_ INTEGER,'
      '110403586=  MODE_VAL_ INTEGER,'
      '110403587=  NEW_VAL_ NUMERIC(15,2),'
      '110403588=  ROUND_MODE_ INTEGER)'
      '110403589=RETURNS ('
      '110403590=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110403591=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '110403592=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110403593=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110403594=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110403595=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110403596=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '110403597=  ERR_CODE INTEGER,'
      '110403598=  ERR_MSG VARCHAR(1024))'
      '110403599=AS'
      '110403600=/*'
      
        '110403601='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057#1056 +
        #1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '110403602='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055#1054 +
        #1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '110403603=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055#1056 +
        #1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '110403604=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 - ' +
        #1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '110403605=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054 +
        #1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045' ' +
        #1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110403606=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '110403607=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067#1042 +
        #1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      '110403608=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' */'
      '110403609=DECLARE VARIABLE ROUND_ INTEGER;'
      '110403610=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '110403611=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      
        '110403612=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110403613=BEGIN'
      '110403614=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110403615='
      '110403616=  IF (G_TOCHKA_ IS NULL) THEN'
      '110403617=    SELECT ID'
      '110403618=      FROM CUR_PARAMS'
      '110403619=     WHERE CUR_PARAMS = 2'
      '110403620=      INTO :G_TOCHKA_;'
      '110403621='
      '110403622=  IF (ROUND_MODE_ = 0) THEN'
      '110403623=      ROUND_ = 0;'
      '110403624=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '110403625=      ROUND_ = -1;'
      '110403626=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '110403627=      ROUND_ = -2;'
      '110403628=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '110403629=      ROUND_ = -3;'
      '110403630='
      
        '110403631=  SQL_STR_ = '#39#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39#39';'
      '110403632='
      
        '110403633=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040' ' +
        #1053#1040' '#1057#1050#1051#1040#1044#1045
      '110403634=  IF (MODE_ = 0) THEN BEGIN'
      
        '110403635=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39#39';'
      '110403636=    IF (MODE_VAL_ = 0) THEN'
      '110403637=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110403638=    ELSE'
      
        '110403639=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110403640='
      '110403641=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110403642=  END'
      '110403643=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '110403644=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '110403645=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND(ABS(LT.AMOUNT)'#39#39';'
      '110403646=    IF (MODE_VAL_ = 0) THEN'
      '110403647=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110403648=    ELSE'
      
        '110403649=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110403650='
      '110403651=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110403652=  END'
      '110403653='
      
        '110403654=  SQL_STR_ = SQL_STR_ || '#39#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39#39'||'
      
        '110403655=            '#39#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39#39';'
      '110403656='
      '110403657=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '110403658=    SQL_STR_ = SQL_STR_ ||'#39#39'AND EXISTS (SELECT 1'#39#39'||'
      
        '110403659=                                        '#39#39' FROM SKLAD ' +
        'S'#39#39'||'
      
        '110403660=                                        '#39#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39#39'||'
      
        '110403661=                                        '#39#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39#39'||'
      
        '110403662=                                        '#39#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39#39';'
      '110403663=    IF (MODE_VYBOR_ = 2) THEN'
      
        '110403664=      SQL_STR_ = SQL_STR_ ||'#39#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39#39';'
      '110403665=    ELSE'
      
        '110403666=      SQL_STR_ = SQL_STR_ ||'#39#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' ' +
        #1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042 +
        #1057#1045#1043#1044#1040
      '110403667=    SQL_STR_ = SQL_STR_ ||'#39#39') '#39#39';'
      '110403668=  END ELSE BEGIN'
      
        '110403669=    SQL_STR_ = SQL_STR_ ||'#39#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39#39';  -' +
        '- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '110403670=  END'
      '110403671='
      '110403672=  IF (MODE_ = 0) THEN'
      
        '110403673=    SQL_STR_ = SQL_STR_ || '#39#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39#39';'
      '110403674=  ELSE IF (MODE_ = 1) THEN'
      '110403675=    SQL_STR_ = SQL_STR_ || '#39#39' AND LT.AMOUNT < 0'#39#39';'
      
        '110403676=  SQL_STR_ = SQL_STR_ || '#39#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39#39';'
      '110403677='
      '110403678=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '110403679=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '110403680=      FOR EXECUTE STATEMENT'
      
        '110403681=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110403682=          INTO :G_PRODUCT,'
      '110403683=               :CATEGORY_NAME,'
      '110403684=               :NAME,'
      '110403685=               :ARTICUL,'
      '110403686=               :AMOUNT_CUR,'
      '110403687=               :MIN_AMOUNT,'
      '110403688=               :AMOUNT_TO_ZAKAZ'
      '110403689=        DO BEGIN'
      
        '110403690=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_P' +
        'RODUCT, :G_TOCHKA_, 0)'
      '110403691=              RETURNING_VALUES :COST_PRICE_;'
      '110403692='
      
        '110403693=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, A' +
        'MOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110403694=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_P' +
        'RODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO_' +
        'ZAKAZ, 0, 0);'
      '110403695=        END'
      '110403696='
      '110403697=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110403698=                                      CURRENT_DATE,'
      '110403699=                                      CURRENT_TIME,'
      '110403700=                                      :G_CLIENT_,'
      '110403701=                                      1,'
      
        '110403702=                                      NULL, --:OSNOVAN' +
        'IE__,'
      '110403703=                                      NULL, --:NOTE__,'
      
        '110403704=                                      0, --:IS_VOZVRAT' +
        '_,'
      
        '110403705=                                      (SELECT SUM(S.SU' +
        'MM) FROM SKLAD_TMP S),'
      
        '110403706=                                      0, -- :SUMM_FACT' +
        '_'
      '110403707=                                      0, --:G_PRIHOD_,'
      
        '110403708=                                      0 --:SUMM_PRIHOD' +
        '_)'
      '110403709=                                      ,NULL --PAYMENTS'
      
        '110403710=                                     )RETURNING_VALUES' +
        ' :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110403711=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110403712=          ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39#39'||ERR_MSG;'
      '110403713=          EXIT;'
      '110403714=        END'
      '110403715=  END'
      '110403716=  ELSE BEGIN'
      '110403717=      FOR EXECUTE STATEMENT'
      
        '110403718=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110403719=      INTO :G_PRODUCT,'
      '110403720=           :CATEGORY_NAME,'
      '110403721=           :NAME,'
      '110403722=           :ARTICUL,'
      '110403723=           :AMOUNT_CUR,'
      '110403724=           :MIN_AMOUNT,'
      '110403725=           :AMOUNT_TO_ZAKAZ'
      '110403726=      DO SUSPEND;'
      '110403727=  END'
      '110403728=END'
      '110403729='#39';'
      '110403730='
      '110403731=EXECUTE STATEMENT '#39'ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '110403732=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110403733=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110403734=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110403735=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110403736=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110403737=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110403738=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110403739=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110403740=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '110403741=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED)'
      '110403742=RETURNS ('
      '110403743=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110403744=  ERR_CODE INTEGER,'
      '110403745=  ERR_MSG VARCHAR(1024))'
      '110403746=AS'
      
        '110403747=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062#1045 +
        #1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '110403748=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045#1057 +
        #1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '110403749=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040#1042 +
        #1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '110403750=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042#1053 +
        #1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '110403751='
      
        '110403752=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042 +
        #1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403753=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'PAY_ZAKAZ_NA' +
        '_REAL'#39#39';'
      '110403754=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110403755=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110403756=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110403757=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'AMOUNT_ALL;'
      
        '110403758=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'SUMM_PAYED;'
      
        '110403759=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110403760=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '110403761=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110403762=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110403763=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      '110403764=BEGIN'
      '110403765='
      '110403766=  IF (G_TOCHKA_ IS NULL) THEN'
      '110403767=    SELECT ID'
      '110403768=      FROM CUR_PARAMS'
      '110403769=     WHERE CUR_PARAMS = 2'
      '110403770=      INTO :G_TOCHKA_;'
      '110403771='
      
        '110403772=  --**************************************************' +
        '************************************************'
      
        '110403773=  --**************************************************' +
        '************************************************'
      '110403774=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403775=  --**************************************************' +
        '************************************************'
      
        '110403776=  --**************************************************' +
        '************************************************'
      '110403777=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '110403778=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1055 +
        #1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '110403779=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '110403780=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110403781=            INTO :AMOUNT_,'
      '110403782=                 :G_PRODUCT_'
      '110403783=      DO BEGIN'
      '110403784=          UPDATE LT_SKLAD_PRODUCT L'
      '110403785=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110403786=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110403787=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110403788=      END'
      '110403789='
      '110403790=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '110403791=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E,'
      
        '110403792=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE)'
      
        '110403793=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '110403794=             NDS_SUMM, COST_PRICE'
      '110403795=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110403796='
      '110403797=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110403798=                                  :Z_DATE_,'
      '110403799=                                  :Z_TIME_,'
      '110403800=                                  :G_CLIENT_,'
      '110403801=                                  :G_PAYMENT_TYPE_,'
      '110403802=                                  :OSNOVANIE_,'
      
        '110403803=                                  :IS_SPISANIE_,   -- ' +
        ':IS_SPISANIE_'
      '110403804=                                  :NOTE_,'
      
        '110403805=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040 +
        #1050#1040#1047#1040
      
        '110403806=                                  :SUMM_FACT_,  -- '#1048' '#1057 +
        #1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '110403807=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 1, SUMM_FACT_, 0),'
      
        '110403808=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 2, SUMM_FACT_, 0),'
      '110403809=                                  0, --SUMM_BONUS_'
      '110403810=                                  0, --SUMM_BONUS_GOT_'
      
        '110403811=                                  null,         -- '#1057#1058#1040 +
        #1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '110403812=                                  0,            -- '#1057#1059#1052 +
        #1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '110403813=                                  0,    --BY_RECIPE'
      '110403814=                                  0     --IS_RESERVE'
      '110403815=                                  ,NULL  -- PAYMENTS_'
      '110403816=                                  )'
      '110403817=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110403818='
      '110403819=      if (ERR_CODE <> 0) then BEGIN'
      '110403820=        ERR_CODE = -20500;'
      '110403821=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110403822=        Exit;'
      '110403823=      END'
      '110403824='
      
        '110403825=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' '#1040 +
        #1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' ' +
        #1055#1054#1044' '#1056#1045#1040#1051
      
        '110403826=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044#1040 +
        ' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '110403827=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042#1045 +
        #1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '110403828=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059 +
        #1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '110403829=      UPDATE ZAKAZ'
      '110403830=         SET IS_SPISANIE = 2'
      '110403831=       WHERE ZAKAZ = :ZAKAZ_;'
      '110403832='
      
        '110403833=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110403834=      FOR SELECT T.AMOUNT,'
      '110403835=                 T.SUMM,'
      '110403836=                 T.G_PRODUCT,'
      '110403837=                 T.ZAKAZ_NA_REAL,'
      '110403838=                 T.ZAKAZ_DETAILS'
      '110403839=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110403840=            INTO :AMOUNT_,'
      '110403841=                 :Z_SUMM_,'
      '110403842=                 :G_PRODUCT_,'
      '110403843=                 :ZAKAZ_NA_REAL_,'
      '110403844=                 :ZAKAZ_DETAILS_'
      '110403845=      DO BEGIN'
      '110403846=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110403847=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOU' +
        'NT_,'
      
        '110403848=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110403849=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110403850=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110403851='
      
        '110403852=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ' +
        'ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '110403853=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110403854=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110403855=      END'
      '110403856=  END'
      '110403857=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403858=  --**************************************************' +
        '************************************************'
      
        '110403859=  --**************************************************' +
        '************************************************'
      '110403860='
      
        '110403861=  --**************************************************' +
        '************************************************'
      
        '110403862=  --**************************************************' +
        '************************************************'
      '110403863=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403864=  --**************************************************' +
        '************************************************'
      
        '110403865=  --**************************************************' +
        '************************************************'
      '110403866=  ELSE BEGIN'
      '110403867=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '110403868=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ZA' +
        'KAZ_DETAILS - ZAKAZ_REAL'
      
        '110403869=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110403870=      FOR SELECT T.AMOUNT,'
      '110403871=                 T.SUMM,'
      '110403872=                 T.G_PRODUCT,'
      '110403873=                 T.ZAKAZ_NA_REAL,'
      '110403874=                 T.ZAKAZ_DETAILS'
      '110403875=                 ,T.PRICE'
      '110403876=                 ,T.NDS'
      '110403877=                 ,T.NDS_SUMM'
      '110403878=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110403879=            INTO :AMOUNT_,'
      '110403880=                 :Z_SUMM_,'
      '110403881=                 :G_PRODUCT_,'
      '110403882=                 :ZAKAZ_NA_REAL_,'
      '110403883=                 :ZAKAZ_DETAILS_'
      '110403884=                 ,:PRICE_'
      '110403885=                 ,:NDS_'
      '110403886=                 ,:NDS_SUMM_'
      '110403887=      DO BEGIN'
      
        '110403888=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUN' +
        'T, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110403889=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '110403890='
      
        '110403891=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110403892=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110403893='
      '110403894=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110403895=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :AMOUNT_,'
      
        '110403896=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110403897=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110403898=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110403899=      END'
      '110403900='
      '110403901=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110403902=                                  :Z_DATE_,'
      '110403903=                                  :Z_TIME_,'
      '110403904=                                  :G_CLIENT_,'
      '110403905=                                  :G_PAYMENT_TYPE_,'
      '110403906=                                  :OSNOVANIE_,'
      '110403907=                                  :NOTE_,'
      
        '110403908=                                  2,        --:IS_VOZV' +
        'RAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-' +
        #1050#1059
      '110403909=                                  :SUMM_,'
      '110403910=                                  :SUMM_FACT_,'
      
        '110403911=                                  NULL,     --:G_PRIHO' +
        'D_,'
      
        '110403912=                                  NULL      --:SUMM_PR' +
        'IHOD_'
      
        '110403913=                                  ,NULL     -- PAYMENT' +
        'S'
      
        '110403914=                                  ) RETURNING_VALUES :' +
        'SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110403915='
      '110403916=      if (ERR_CODE <> 0) then BEGIN'
      '110403917=        ERR_CODE = -20500;'
      '110403918=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110403919=        Exit;'
      '110403920=      END'
      '110403921=  END'
      '110403922=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110403923=  --**************************************************' +
        '************************************************'
      
        '110403924=  --**************************************************' +
        '************************************************'
      '110403925='
      '110403926=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110403927=END'
      '110403928='#39';'
      '110403929=END  --END_EXECUTE_BLOCK'
      '110403930=EXECUTE BLOCK AS BEGIN'
      '110403931='
      '110403932=EXECUTE STATEMENT '#39'ALTER PROCEDURE R_UNIFICATION('
      '110403933=  MODE_ INTEGER)'
      '110403934=RETURNS ('
      '110403935=  COUNT_SPIS_ INTEGER,'
      '110403936=  COUNT_PRIH_ INTEGER,'
      '110403937=  ERR_CODE INTEGER,'
      '110403938=  ERR_MSG VARCHAR(1024))'
      '110403939=AS'
      
        '110403940=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'R_UNIFICATIO' +
        'N'#39#39';'
      '110403941=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110403942=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REV' +
        'ISION;'
      
        '110403943=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_' +
        'PRODUCT;'
      
        '110403944=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AM' +
        'OUNT_BD;'
      
        '110403945=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.' +
        'AMOUNT_REAL;'
      
        '110403946=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      '110403947=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110403948=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110403949=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110403950=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110403951=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      '110403952=BEGIN'
      '110403953='
      '110403954=  COUNT_SPIS_ = 0;'
      '110403955=  COUNT_PRIH_ = 0;'
      '110403956='
      '110403957=  SELECT ID'
      '110403958=    FROM CUR_PARAMS'
      '110403959=   WHERE CUR_PARAMS = 2'
      '110403960=    INTO :G_TOCHKA_;'
      '110403961='
      
        '110403962=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_RE' +
        'AL'
      '110403963=      FROM REVISION'
      
        '110403964=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOU' +
        'NT_REAL_'
      '110403965=  DO BEGIN'
      
        '110403966=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2' +
        '))) THEN BEGIN'
      
        '110403967=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1)'
      '110403968=        RETURNING_VALUES :COST_PRICE_;'
      '110403969='
      
        '110403970=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_' +
        'PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110403971=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM)'
      
        '110403972=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMO' +
        'UNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '110403973='
      '110403974=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '110403975=    END'
      '110403976='
      
        '110403977=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1' +
        '))) then BEGIN'
      '110403978=      SELECT S.PRICE'
      '110403979=        FROM SKLAD S'
      '110403980=       WHERE S.IS_LAST = 1'
      '110403981=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110403982=         AND S.G_TOCHKA = :G_TOCHKA_'
      '110403983=        INTO :PRICE_LAST_;'
      '110403984='
      
        '110403985=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056 +
        #1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '110403986='
      
        '110403987=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110403988=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AM' +
        'OUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '110403989='
      '110403990=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '110403991=    END'
      '110403992='
      '110403993=    UPDATE REVISION R'
      '110403994=       SET R.IS_UNIFIED = 1'
      '110403995=     WHERE R.REVISION = :REVISION_;'
      '110403996=  END'
      '110403997='
      '110403998=  PNT_ = '#39#39'01'#39#39';'
      '110403999=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '110404000=    SELECT SUM(S.SUMM)'
      '110404001=      FROM ZAKAZ_DETAILS_TMP S'
      '110404002=      INTO :SUMM_;'
      '110404003='
      '110404004=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110404005=                                CURRENT_DATE, --:Z_DAT' +
        'E_,'
      
        '110404006=                                CURRENT_TIME, --:Z_TIM' +
        'E'
      
        '110404007=                                10,          --:G_CLIE' +
        'NT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '110404008=                                1,            --:G_PAY' +
        'MENT_TYPE_,'
      
        '110404009=                                NULL,         --:OSNOV' +
        'ANIE_,'
      
        '110404010=                                1,              --:IS_' +
        'SPISANIE_,'
      
        '110404011=                                NULL,           --:NOT' +
        'E_,'
      
        '110404012=                                :SUMM_,              -' +
        '-:SUMM_,'
      
        '110404013=                                :SUMM_,              -' +
        '-:SUMM_FACT_,'
      
        '110404014=                                0,              --SUMM' +
        '_BONUS_'
      
        '110404015=                                0,              --SUMM' +
        '_BONUS_GOT'
      
        '110404016=                                NULL,           --:G_P' +
        'RIHOD_,'
      '110404017=                                NULL,'
      '110404018=                                0,        -- BY_RECIPE'
      
        '110404019=                                0         -- IS_RESERV' +
        'E'
      '110404020=                                ,NULL  -- PAYMENTS_'
      '110404021=                                ,0     -- SUMM_CASH'
      '110404022=                                ,0     -- SUMM_NONCASH'
      
        '110404023=                                ) RETURNING_VALUES :ZA' +
        'KAZ_, :ERR_CODE, :ERR_MSG;'
      '110404024=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110404025=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110404026=      EXIT;'
      '110404027=    END'
      '110404028=  END'
      '110404029='
      '110404030=  PNT_ = '#39#39'02'#39#39';'
      '110404031=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '110404032=    SELECT SUM(S.SUMM)'
      '110404033=      FROM SKLAD_TMP S'
      '110404034=      INTO :SUMM_;'
      '110404035='
      '110404036=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110404037=                                CURRENT_DATE,   --:DAT' +
        'E_RECEIPT_,'
      '110404038=                                CURRENT_TIME,'
      
        '110404039=                                NULL,           --:G_C' +
        'LIENT_,'
      
        '110404040=                                1,              --:G_P' +
        'AYMENT_TYPE_,'
      
        '110404041=                                NULL,           --:OSN' +
        'OVANIE_,'
      
        '110404042=                                '#39#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39#39', ' +
        '          --:NOTE_,'
      
        '110404043=                                5,              --:IS_' +
        'VOZVRAT_,'
      '110404044=                                :SUMM_,'
      '110404045=                                :SUMM_,'
      
        '110404046=                                NULL,           --:G_P' +
        'RIHOD_,'
      
        '110404047=                                NULL            --:SUM' +
        'M_PRIHOD_'
      '110404048=                                ,NULL  --PAYMENTS'
      '110404049=                                )'
      '110404050=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110404051=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110404052=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110404053=      EXIT;'
      '110404054=    END'
      '110404055=  END'
      '110404056=END'
      '110404057='#39';'
      '110404058='
      '110404059=EXECUTE STATEMENT '#39'ALTER PROCEDURE SYNC_DOWNLOAD('
      '110404060=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110404061=  UPLOAD_TABLE_TMP TYPE OF COLUMN UPLOAD_TABLE_TMP.UPL' +
        'OAD_TABLE_TMP,'
      '110404062=  MODE TYPE OF COLUMN UPLOAD_TABLE_TMP.MODE,'
      '110404063=  PARENT TYPE OF COLUMN UPLOAD_TABLE_TMP.PARENT,'
      '110404064=  DATE_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.DATE_OPER,'
      '110404065=  TIME_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.TIME_OPER,'
      '110404066=  G_CLIENT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_CLIENT,'
      
        '110404067=  G_PAYMENT_TYPE TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PAY' +
        'MENT_TYPE,'
      '110404068=  SUMM_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_ALL,'
      
        '110404069=  SUMM_FACT_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_F' +
        'ACT_ALL,'
      
        '110404070=  SUMM_PAY_BONUS TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'PAY_BONUS,'
      
        '110404071=  SUMM_BONUS_GOT TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'BONUS_GOT,'
      '110404072=  OSNOVANIE TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE,'
      '110404073=  NOTE TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE,'
      
        '110404074=  G_OFFICIAL TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICIA' +
        'L,'
      '110404075=  G_PRODUCT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT,'
      '110404076=  AMOUNT TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT,'
      '110404077=  PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE,'
      '110404078=  SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM,'
      
        '110404079=  DISCOUNT_PERC TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_PERC,'
      
        '110404080=  DISCOUNT_TENGE TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCO' +
        'UNT_TENGE,'
      
        '110404081=  DISCOUNT_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_SUMM,'
      '110404082=  NDS TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS,'
      '110404083=  NDS_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM,'
      
        '110404084=  COST_PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRIC' +
        'E,'
      '110404085=  BY_RECIPE TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE,'
      
        '110404086=  IS_RESERVE TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESERV' +
        'E,'
      '110404087=  PAYMENTS BLOB SUB_TYPE 1,'
      '110404088=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110404089=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110404090=  IS_LOAD_ INTEGER)'
      '110404091=RETURNS ('
      '110404092=  ERR_CODE INTEGER,'
      '110404093=  ERR_MSG VARCHAR(1024))'
      '110404094=AS'
      '110404095=/*'
      '110404096='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110404097='#1048#1044#1059' '#1055#1054' '#1042#1057#1045#1052' '#1055#1054#1054#1063#1045#1056#1045#1044#1053#1054', '#1055#1045#1056#1045#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1048#1055#1054#1052' '#1055#1056#1054#1062#1045#1057#1057#1040' '#1041#1059 +
        #1044#1059' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110404098='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1062#1048#1050#1051#1054#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059 +
        #1070' '#1058#1040#1041#1051#1048#1062#1059
      '110404099=*/'
      
        '110404100=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'SYNC_DOWNLOA' +
        'D'#39#39';'
      '110404101=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110404102=DECLARE VARIABLE MODE_ TYPE OF COLUMN UPLOAD_TABLE_TMP' +
        '.MODE;'
      
        '110404103=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110404104=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110404105=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110404106=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110404107=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110404108=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110404109=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '110404110=DECLARE VARIABLE BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RE' +
        'CIPE;'
      
        '110404111=DECLARE VARIABLE BY_RECIPE__ TYPE OF COLUMN ZAKAZ.BY_R' +
        'ECIPE;'
      
        '110404112=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '110404113=DECLARE VARIABLE IS_RESERVE__ TYPE OF COLUMN ZAKAZ.IS_' +
        'RESERVE;'
      
        '110404114=DECLARE VARIABLE PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZ' +
        'E 80;'
      
        '110404115=DECLARE VARIABLE PAYMENTS__ BLOB SUB_TYPE 1 SEGMENT SI' +
        'ZE 80;'
      
        '110404116=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.G_CLIENT;'
      
        '110404117=DECLARE VARIABLE G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_' +
        'PARENT.G_PAYMENT_TYPE;'
      
        '110404118=DECLARE VARIABLE OSNOVANIE_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.OSNOVANIE;'
      
        '110404119=DECLARE VARIABLE NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOT' +
        'E;'
      
        '110404120=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110404121=DECLARE VARIABLE SUMM_FACT_ALL_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM_FACT;'
      
        '110404122=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '110404123=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110404124=DECLARE VARIABLE PARENT_ TYPE OF COLUMN UPLOAD_TABLE_T' +
        'MP.PARENT;'
      
        '110404125=DECLARE VARIABLE PARENT_OLD_ TYPE OF COLUMN UPLOAD_TAB' +
        'LE_TMP.PARENT;'
      '110404126=DECLARE VARIABLE MODE_OLD_ INTEGER;'
      '110404127=DECLARE VARIABLE DATE_OPER__ DATE;'
      '110404128=DECLARE VARIABLE TIME_OPER__ TIME;'
      
        '110404129=DECLARE VARIABLE G_CLIENT__ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '110404130=DECLARE VARIABLE G_PAYMENT_TYPE__ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      
        '110404131=DECLARE VARIABLE OSNOVANIE__ TYPE OF COLUMN ZAKAZ.OSNO' +
        'VANIE;'
      '110404132=DECLARE VARIABLE NOTE__ TYPE OF COLUMN ZAKAZ.NOTE;'
      '110404133=DECLARE VARIABLE SUMM__ NUMERIC(15,2);'
      '110404134=DECLARE VARIABLE SUMM_FACT__ NUMERIC(15,2);'
      
        '110404135=DECLARE VARIABLE SUMM_CASH__ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '110404136=DECLARE VARIABLE SUMM_NONCASH__ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '110404137=DECLARE VARIABLE SUMM_PAY_BONUS__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '110404138=DECLARE VARIABLE SUMM_BONUS_GOT__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '110404139=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '110404140=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2' +
        ');'
      
        '110404141=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      '110404142=DECLARE VARIABLE DATE_OPER_ DATE;'
      '110404143=DECLARE VARIABLE TIME_OPER_ TIME;'
      
        '110404144=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '110404145=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110404146=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '110404147=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN ZAKAZ.G_OF' +
        'FICIAL;'
      
        '110404148=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110404149=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110404150=DECLARE VARIABLE IS_FIRST_TIME_ INTEGER = 0; /* '#1054#1041#1056#1040#1041#1040 +
        #1058#1067#1042#1040#1045#1058#1057#1071' '#1055#1045#1056#1042#1040#1071' '#1057#1058#1056#1054#1050#1040' 0, '#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1057#1058#1056#1054#1050#1048' = 1 */'
      '110404151=BEGIN'
      '110404152=  PNT_ = '#39#39'00'#39#39';'
      '110404153=  IF (IS_LOAD_ = 0) THEN BEGIN'
      '110404154=      SELECT 1'
      '110404155=        FROM G_PRODUCT G'
      '110404156=       WHERE G.G_PRODUCT = :G_PRODUCT'
      '110404157=       INTO :G_PRODUCT_;'
      '110404158='
      '110404159=      IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '110404160=        ERR_CODE = -20500;'
      
        '110404161=        ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072': '#1090#1086#1074#1072#1088' '#1089' '#1080#1076#1077#1085#1090#1080#1092#1080#1082#1072#1090#1086#1088#1086#1084' '#39 +
        #39'||G_PRODUCT||'#39#39' '#1086#1090#1089#1091#1090#1089#1090#1074#1091#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'.'#39#39';'
      '110404162=        Exit;'
      '110404163=      END'
      '110404164='
      
        '110404165=      INSERT INTO UPLOAD_TABLE_TMP (UPLOAD_TABLE_TMP, ' +
        'MODE, PARENT, DATE_OPER, TIME_OPER, G_CLIENT, G_PAYMENT_TYPE,'
      
        '110404166=                                    SUMM_ALL, SUMM_FAC' +
        'T_ALL, SUMM_PAY_BONUS, SUMM_BONUS_GOT, OSNOVANIE, NOTE, G_OFFICI' +
        'AL, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110404167=                                    DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RESERVE, P' +
        'AYMENTS)'
      
        '110404168=      VALUES (:UPLOAD_TABLE_TMP, :MODE, :PARENT, :DATE' +
        '_OPER, :TIME_OPER, DECODE(:G_CLIENT, 0, NULL, :G_CLIENT), :G_PAY' +
        'MENT_TYPE,'
      
        '110404169=              :SUMM_ALL, :SUMM_FACT_ALL, :SUMM_PAY_BON' +
        'US, :SUMM_BONUS_GOT, :OSNOVANIE, :NOTE, :G_OFFICIAL, :G_PRODUCT,' +
        ' :AMOUNT, :PRICE, :SUMM, :DISCOUNT_PERC,'
      
        '110404170=              :DISCOUNT_TENGE, :DISCOUNT_SUMM, :NDS, :' +
        'NDS_SUMM, :COST_PRICE, :BY_RECIPE, :IS_RESERVE, :PAYMENTS);'
      '110404171='
      '110404172=  END ELSE BEGIN'
      '110404173=      PNT_ = '#39#39'01'#39#39';'
      '110404174=      IF (G_TOCHKA_ IS NULL) THEN'
      '110404175=        SELECT ID'
      '110404176=          FROM CUR_PARAMS'
      '110404177=         WHERE CUR_PARAMS = 2'
      '110404178=          INTO :G_TOCHKA_;'
      '110404179='
      
        '110404180=      FOR SELECT MODE, PARENT, DATE_OPER, TIME_OPER, G' +
        '_CLIENT, G_PAYMENT_TYPE, SUMM_ALL, SUMM_FACT_ALL, SUMM_PAY_BONUS' +
        ', SUMM_BONUS_GOT, OSNOVANIE,'
      
        '110404181=                 NOTE, G_OFFICIAL, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      
        '110404182=                 NDS_SUMM, COST_PRICE, BY_RECIPE, IS_R' +
        'ESERVE, PAYMENTS'
      '110404183=          FROM UPLOAD_TABLE_TMP'
      
        '110404184=          WHERE MODE <> 6        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056 +
        #1040' '#1041#1059#1044#1059' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1054#1058#1044#1045#1051#1068#1053#1054', '#1058#1040#1052' '#1044#1056#1059#1043#1054#1049' '#1055#1056#1048#1053#1062#1048#1055
      '110404185=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110404186=          INTO :MODE_, :PARENT_, :DATE_OPER_, :TIME_OP' +
        'ER_, :G_CLIENT_, :G_PAYMENT_TYPE_, :SUMM_ALL_, :SUMM_FACT_ALL_, ' +
        ' :SUMM_PAY_BONUS_, :SUMM_BONUS_GOT_,'
      
        '110404187=               :OSNOVANIE_, :NOTE_, :G_OFFICIAL_, :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_PERC_, :DISCOUNT_T' +
        'ENGE_,'
      
        '110404188=               :DISCOUNT_SUMM_, :NDS_, :NDS_SUMM_, :CO' +
        'ST_PRICE_, :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_'
      '110404189=      DO BEGIN'
      '110404190=          -- '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110404191=          PNT_ = '#39#39'02'#39#39';'
      
        '110404192=          IF (PARENT_ <> PARENT_OLD_ AND IS_FIRST_TIME' +
        '_ = 1) THEN BEGIN'
      '110404193=            IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '110404194=              PNT_ = '#39#39'02a'#39#39';'
      '110404195=              EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110404196=                                          :DATE_OPER__' +
        ','
      
        '110404197=                                          :TIME_OPER__' +
        ','
      '110404198=                                          :G_CLIENT__,'
      
        '110404199=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110404200=                                          :OSNOVANIE__' +
        ','
      '110404201=                                          :NOTE__,'
      
        '110404202=                                          DECODE(:MODE' +
        '_OLD_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '110404203=                                          :SUMM__,'
      
        '110404204=                                          :SUMM_FACT__' +
        ','
      
        '110404205=                                          0, --:G_PRIH' +
        'OD_,'
      
        '110404206=                                          0 --:SUMM_PR' +
        'IHOD_)'
      
        '110404207=                                          ,:PAYMENTS__' +
        '  -- PAYMENTS'
      
        '110404208=                                         )RETURNING_VA' +
        'LUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110404209=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110404210=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090 +
        #1086#1074#1072#1088#1072' (01).'#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG)' +
        ' + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '110404211=                EXIT;'
      '110404212=              END'
      '110404213=            END'
      '110404214=            ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '110404215=              PNT_ = '#39#39'03'#39#39';'
      '110404216=              EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110404217=                                          :DATE_OPER__' +
        ','
      
        '110404218=                                          :TIME_OPER__' +
        ','
      '110404219=                                          :G_CLIENT__,'
      
        '110404220=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110404221=                                          :OSNOVANIE__' +
        ','
      
        '110404222=                                          DECODE(MODE_' +
        'OLD_,'
      
        '110404223=                                                 2, 0,' +
        '   -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '110404224=                                                 3, 1,' +
        '   -- '#1057#1055#1048#1057#1040#1053#1048#1045
      
        '110404225=                                                 5, 3)' +
        ',  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110404226=                                          :NOTE__,'
      '110404227=                                          :SUMM__,'
      
