        ' '#1042#1056#1071#1044' '#1051#1048' '#1058#1040#1050#1054#1045' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068
      '110231936=  -- '#1056#1040#1057#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1048#1047' '#1050#1040#1057#1057#1067
      '110231937=  FIRST_ITER = 0;'
