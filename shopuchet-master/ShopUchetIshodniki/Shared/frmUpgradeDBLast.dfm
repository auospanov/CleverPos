      '1101210=ALTER TRIGGER LT_SKLAD_PRODUCT_BU0'
      '1101211=AS'
      '1101212=declare variable G_NAME_  TYPE OF COLUMN G_PRODUCT.NAME;'
      '1101213=declare variable CNT_     INTEGER;'
      
        '1101214=declare variable T_NAME_  TYPE OF COLUMN G_TOCHKA.NAME =' +
        ' '#39#39';'
      '1101215=begin'
      
        '1101216=  IF (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39') IS NO' +
        'T NULL) THEN EXIT;'
      
        '1101217=  if (((NEW.AMOUNT - NEW.AMOUNT_RESERVE) < 0) AND (SELEC' +
        'T S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) then BE' +
        'GIN'
      '1101218=    SELECT G.NAME'
      '1101219=      FROM G_PRODUCT G'
      '11012110=     WHERE G.G_PRODUCT = NEW.G_PRODUCT'
      '11012111=      INTO :G_NAME_;'
      '11012112='
      '11012113=    if ((SELECT COUNT(*) FROM G_TOCHKA) > 1) then'
      '11012114=      SELECT '#39' '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||G.NAME||'#39'"'#39
      '11012115=        FROM G_TOCHKA G'
      '11012116=       WHERE G.G_TOCHKA = NEW.G_TOCHKA'
      '11012117=        INTO :T_NAME_;'
      '11012118='
      
        '11012119=    --'#39'/Q\'#39' - '#1041#1059#1044#1059' '#1042' '#1044#1045#1051#1068#1060#1071#1061' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1050#1040#1050' '#1050#1054#1053#1045#1062' '#1057#1054#1054 +
        #1041#1065#1045#1053#1048#1071', '#1048' '#1042#1057#1045' '#1063#1058#1054' '#1044#1040#1051#1068#1064#1045' - '#1042#1067#1056#1045#1047#1040#1058#1068', '#1040' '#1058#1054' FIREBIRD '#1057#1040#1052' '#1044#1054#1041#1040#1042#1051#1071#1045#1058
      '11012120=    -- '#1055#1054#1058#1054#1052' '#1043#1044#1045' '#1048' '#1042' '#1050#1040#1050#1054#1052' '#1058#1056#1048#1043#1043#1045#1056#1045' '#1055#1056#1054#1048#1047#1054#1064#1051#1040' '#1054#1064#1048#1041#1050#1040
      
        '11012121=    EXCEPTION NOL_EXCEPTION '#39'/R\'#1042' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1086 +
        #1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||G_NAME_||'#39'"'#39'||T_NAME_||'#39' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!' +
        ' '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'./Q\'#39';'
      '11012122=  END'
      '11012123=end'
      '11012124=;'
      '11012125='
      '11012126=ALTER TRIGGER PRODUCT_AMOUNT_AI0'
      '11012127=AS'
      
        '11012128=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054 +
        #1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040 +
        ', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '11012129=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050' ' +
        #1055#1056#1048#1052#1045#1056#1059' '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1057#1058#1040#1050#1040#1053#1040' (5 '#1064#1058') '#1048' '#1050#1056#1067#1064#1050#1048' (4 '#1064#1058'),' +
        ' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '11012130=  -- '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' = 4'
      
        '11012131=  -- '#1053#1040#1042#1045#1057#1048#1051' '#1053#1040' '#1058#1056#1048#1043#1043#1045#1056', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1053#1054#1043#1054' '#1043#1044#1045' '#1053#1040#1044#1054' '#1069#1058#1054' ' +
        #1044#1045#1051#1040#1058#1068' - '#1055#1056#1048#1061#1054#1044', '#1055#1056#1054#1044#1040#1046#1048', '#1056#1045#1044#1040#1050#1058#1048#1056#1042#1054#1040#1053#1048#1045' '#1055#1056#1048#1061#1054#1044#1054#1042'/'#1055#1056#1054#1044#1040#1046
      
        '11012132=DECLARE VARIABLE G_PRODUCT_SOSTAV_  TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT;'
      
        '11012133=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11012134=DECLARE VARIABLE CNT_ INTEGER;'
      '11012135=BEGIN'
      
        '11012136=  IF (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39') IS N' +
        'OT NULL) THEN EXIT;'
      '11012137=  FOR SELECT K.G_PRODUCT'
      '11012138=        FROM G_PRODUCT_KIT K, G_PRODUCT G'
      '11012139=       WHERE K.G_PRODUCT_ITEM = NEW.g_product'
      '11012140=         AND K.g_product = G.g_product'
      '11012141=         AND G.is_kit = 1'
      
        '11012142=         AND (SELECT COUNT(1)               -- '#1042#1057#1045' '#1057#1054#1057#1058 +
        #1040#1042#1051#1071#1070#1065#1048#1045' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1048#1061' '#1052#1054#1046#1045#1058' '#1053#1045' '#1041#1067#1058#1068' '#1045#1057#1051#1048' '#1057#1050#1051#1040#1044' '#1053#1054#1042#1067 +
        #1049', '#1058#1054#1043#1044' '#1042' LT_SKLAD_PRODUCT '#1058#1059#1055#1054' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049
      '11012143=                FROM G_PRODUCT_KIT KK'
      '11012144=               WHERE KK.g_product = K.G_PRODUCT'
      
        '11012145=                 AND NOT EXISTS (SELECT 1 FROM LT_SKLAD' +
        '_PRODUCT L WHERE L.G_TOCHKA = NEW.g_tochka AND L.G_PRODUCT = KK.' +
        'G_PRODUCT_ITEM)) = 0'
      '11012146=       INTO :G_PRODUCT_SOSTAV_'
      '11012147=  DO BEGIN'
      '11012148=    SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE)/K.amount)'
      '11012149=      FROM G_PRODUCT_KIT K,'
      '11012150=           LT_SKLAD_PRODUCT L'
      '11012151=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '11012152=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '11012153=       AND L.G_TOCHKA = NEW.g_tochka'
      '11012154=     GROUP BY K.G_PRODUCT'
      '11012155=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11012156='
      '11012157=    UPDATE LT_SKLAD_PRODUCT L'
      '11012158=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '11012159=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_'
      '11012160=       AND L.G_TOCHKA = NEW.g_tochka;'
      '11012161='
      '11012162=    IF (ROW_COUNT = 0) THEN'
      
        '11012163=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, G' +
        '_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11012164=      VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODU' +
        'CT_SOSTAV_, :G_PRODUCT_SOSTAV_AMOUNT_, 0, NEW.G_TOCHKA);'
      '11012165=  END'
      '11012166=end'
      '11012167=;'
      '11012168='
      '11012169=ALTER TRIGGER PRODUCT_AMOUNT_BI0'
      '11012170=AS'
      
        '11012171=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054 +
        #1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040 +
