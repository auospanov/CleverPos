      '11042728=  ----------------------------------------'
      '11042729=  ----------------------------------------'
      '11042730=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11042731=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
