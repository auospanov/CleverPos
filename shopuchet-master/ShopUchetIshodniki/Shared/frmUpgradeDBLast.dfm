      '110237927=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      
        '110237928=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIG' +
        'INT,'
      
        '110237929=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT */ BIGINT,'
      
        '110237930=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL ' +
        '*/ BIGINT,'
      '110237931=  DATE_BEGIN_ DATE,'
      '110237932=  DATE_END_ DATE,'
      '110237933=  TIME_BEGIN_ TIME,'
      '110237934=  TIME_END_ TIME,'
      '110237935=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110237936=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110237937=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '110237938=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ B' +
        'IGINT = 0)'
      '110237939=RETURNS ('
      
        '110237940=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUM' +
        'ERIC(18,5),'
      
        '110237941=  AMOUNT_VES /* TYPE OF COLUMN G_PRODUCT.VES_GRAMM */ ' +
        'NUMERIC(15,2),'
      
        '110237942=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMER' +
        'IC(15,2),'
      
        '110237943=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC' +
        '(15,2),'
      
        '110237944=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCO' +
        'UNT_TENGE */ NUMERIC(15,2),'
      
        '110237945=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOU' +
        'NT_SUMM */ NUMERIC(15,2),'
      
        '110237946=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCH' +
        'AR(250),'
      
        '110237947=  PAYMENT_NAME /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME *' +
        '/ VARCHAR(256),'
      
        '110237948=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCH' +
        'AR(250),'
      
        '110237949=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110237950=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(150),'
      
        '110237951=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLA' +
        'TUR_NUM */ VARCHAR(150),'
      
        '110237952=  BRAND /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(1' +
        '50),'
      '110237953=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '110237954=  Z_DATE BLOB SUB_TYPE 1,'
      '110237955=  ROW INTEGER,'
      '110237956=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '110237957=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(5' +
        '0),'
      
        '110237958=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMER' +
        'IC(15,2),'
      
        '110237959=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */' +
        ' NUMERIC(15,2),'
      
        '110237960=  OFFICIAL_NAME /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC *' +
        '/ VARCHAR(150),'
      '110237961=  ERR_CODE INTEGER,'
      '110237962=  ERR_MSG VARCHAR(1024))'
      '110237963=AS'
      '110237964=BEGIN'
      '110237965=  SUSPEND;'
      '110237966=END'
      '110237967=;'
      '110237968='
      '110237969=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      
        '110237970=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIG' +
        'INT,'
      '110237971=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '110237972=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '110237973=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT' +
        ','
      
