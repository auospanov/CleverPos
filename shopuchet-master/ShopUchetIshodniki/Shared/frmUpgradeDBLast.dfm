      '11053895=END'
      '11053896='#39';'
      '11053897='
      '11053898='
      '11053899=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_ZAKAZ('
      '11053900=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11053901=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '11053902=RETURNS ('
      '11053903=  ERR_CODE INTEGER,'
      '11053904=  ERR_MSG VARCHAR(1024))'
      '11053905=AS'
      '11053906=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_ZAKAZ'#39#39';'
      '11053907=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11053908=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '11053909=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUMM;'
      
        '11053910=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS;'
      
        '11053911=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS_GOT;'
      
        '11053912=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CL' +
        'IENT;'
      
        '11053913=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11053914=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11053915=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11053916=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM;'
      
        '11053917=DECLARE VARIABLE SALES_COMM_OLD_       TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM;'
      
        '11053918=DECLARE VARIABLE ACTION_DATE_ZP_       TYPE OF COLUMN K' +
        'ASSA.ACTION_DATE;'
      
        '11053919=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11053920=BEGIN'
      '11053921=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '11053922=      SELECT Z.SUMM,'
      '11053923=             Z.SUMM_BONUS,'
      '11053924=             Z.SUMM_BONUS_GOT,'
      '11053925=             Z.G_CLIENT,'
      '11053926=             Z.G_OFFICIAL,'
      '11053927=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '11053928=             G.FM'
      
        '11053929=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z.' +
        'G_OFFICIAL = G.G_OFFICIAL'
      '11053930=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '11053931=        INTO :SUMM_ZAKAZ_,'
      '11053932=             :SUMM_PAY_BONUS_,'
      '11053933=             :SUMM_BONUS_GOT_,'
      '11053934=             :G_CLIENT_,'
      '11053935=             :G_OFFICIAL_,'
      '11053936=             :DO_NOT_SALES_COMM_,'
      '11053937=             :OFFICIAL_NAME_;'
      '11053938='
      
        '11053939=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      '11053940=        SELECT SUM(ZD.SALES_COMM)'
      '11053941=          FROM ZAKAZ_DETAILS ZD'
      '11053942=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '11053943=          INTO :SALES_COMM_OLD_;'
      '11053944='
      '11053945=      PNT_ = '#39#39'01'#39#39';'
      
        '11053946=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETUR' +
        'NING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11053947=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11053948=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'|' +
        '|ERR_MSG;'
      '11053949=        EXIT;'
      '11053950=      END'
      '11053951='
      '11053952=      PNT_ = '#39#39'02'#39#39';'
      '11053953=      FOR SELECT S.KASSA'
      '11053954=            FROM KASSA S'
      '11053955=           WHERE S.ZAKAZ = :ZAKAZ_'
      '11053956=            INTO :KASSA_'
      '11053957=      DO BEGIN'
      
        '11053958=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11053959=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11053960=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11053961=            EXIT;'
      '11053962=          END'
      '11053963=      END'
      '11053964='
      '11053965=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '11053966=      PNT_ = '#39#39'03'#39#39';'
      '11053967=      FOR SELECT S.KASSA_BEZNAL'
      '11053968=            FROM KASSA_BEZNAL S'
      '11053969=           WHERE S.ZAKAZ = :ZAKAZ_'
      '11053970=            INTO :KASSA_'
      '11053971=      DO BEGIN'
      
        '11053972=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11053973=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11053974=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11053975=            EXIT;'
      '11053976=          END'
      '11053977=      END'
      '11053978=      PNT_ = '#39#39'03.1'#39#39';'
      
        '11053979=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0 A' +
        'ND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '11053980=            KASSA_ = NULL;'
      '11053981='
      '11053982=            SELECT S.S_VALUE'
      '11053983=              FROM SYSTEM_SETUP S'
      '11053984=             WHERE S.SYSTEM_SETUP = 4'
      '11053985=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '11053986='
      '11053987=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11053988=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11053989=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11053990='
      
        '11053991=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040 +
        #1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11053992=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11053993=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DEC' +
        'ODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FR' +
        'OM CURRENT_DATE)));'
      '11053994='
      '11053995=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11053996=            ELSE'
      
        '11053997=               ACTION_DATE_ZP_ = Current_date - EXTRACT' +
        '(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - E' +
        'XTRACT(DAY FROM current_date) + 32);'
      '11053998='
      '11053999=            SELECT K.KASSA, K.SUMM'
      '110531000=            FROM KASSA K'
      '110531001=            WHERE K.G_PRIHOD_RASHOD = -1'
      '110531002=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110531003=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110531004=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110531005='
      '110531006=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '110531007=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110531008=                                              -1,     ' +
        '--:G_PRIHOD_RASHOD_,'
      
        '110531009=                                              -:SALES_' +
        'COMM_OLD_,'
      
        '110531010=                                              :ACTION_' +
        'DATE_ZP_,'
      
        '110531011=                                              :OFFICIA' +
        'L_NAME_,'
      
        '110531012=                                              NULL,   ' +
        '  --:ZAKAZ_,'
      
        '110531013=                                              NULL,   ' +
        '  --:SKLAD_,'
      '110531014=                                              1,'
      
        '110531015=                                              (SELECT ' +
        'ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '110531016=                                              :G_OFFIC' +
        'IAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110531017=            END ELSE'
      '110531018=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110531019=                                              1,     -' +
        '- ACTION_'
      
        '110531020=                                              -1,     ' +
        '--:G_PRIHOD_RASHOD_,'
      
        '110531021=                                              :SALES_C' +
        'OMM_SUMM_ITER_ - :SALES_COMM_OLD_,'
      
        '110531022=                                              :ACTION_' +
        'DATE_ZP_,'
      
        '110531023=                                              :OFFICIA' +
        'L_NAME_,   --NOTE_'
      '110531024=                                              NULL,'
      '110531025=                                              NULL,'
      '110531026=                                              1,'
      
        '110531027=                                              G_OFFICI' +
        'AL_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110531028='
      '110531029=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110531030=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110531031=              EXIT;'
      '110531032=            END'
      '110531033=      END'
      '110531034=      UPDATE G_DISCONT_CARD G'
      
        '110531035=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_,' +
        ' 0) - :SUMM_BONUS_GOT_,'
      
        '110531036=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0),' +
        ' 0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '110531037=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '110531038='
      '110531039=      PNT_ = '#39#39'04'#39#39';'
      '110531040=      UPDATE INVOICE I'
      '110531041=         SET I.ZAKAZ = NULL'
      '110531042=       WHERE I.ZAKAZ = :zakaz_;'
      '110531043='
      '110531044=      UPDATE INVOICE_PAY I'
      '110531045=         SET I.ZAKAZ = NULL'
      '110531046=       WHERE I.ZAKAZ = :zakaz_;'
      '110531047='
      '110531048=      UPDATE WAYBILL W'
      '110531049=         SET W.ZAKAZ = NULL'
      '110531050=       WHERE W.ZAKAZ = :zakaz_;'
      '110531051=      --********************************************'
      '110531052='
      '110531053=      PNT_ = '#39#39'015'#39#39';'
      '110531054=      DELETE FROM zakaz'
      '110531055=      WHERE zakaz = :zakaz_;'
      '110531056=  END'
      '110531057=  ELSE BEGIN'
      '110531058=    PNT_ = '#39#39'20'#39#39';'
      
        '110531059=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL) RETURNI' +
        'NG_VALUES (:ERR_CODE, :ERR_MSG);'
      '110531060=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110531061=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110531062=      EXIT;'
      '110531063=    END'
      '110531064=  END'
      '110531065='
      '110531066=when sqlcode -530 DO'
      '110531067=  begin'
      '110531068=    ERR_CODE = -20500;'
      
        '110531069=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '110531070=    ERR_MSG = PROCNAME||'#39#39' PNT_ = '#39#39'||PNT_||ERR_MSG;'
      '110531071=  end'
      '110531072=end'
      '110531073='#39';'
      '110531074='
      '110531075=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_OFFICIAL('
      '110531076=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '110531077=RETURNS ('
      '110531078=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110531079=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110531080=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110531081=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110531082=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110531083=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110531084=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110531085=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110531086=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110531087=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110531088=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110531089=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110531090=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110531091=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110531092=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110531093=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110531094=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110531095=  RIGHTS_ARR_ VARCHAR(1000),'
      
        '110531096=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.DO_NOT_' +
        'SALES_COMM,'
      '110531097=  ERR_CODE INTEGER,'
      '110531098=  ERR_MSG VARCHAR(1024))'
      '110531099=AS'
      
        '110531100=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      '110531101=begin'
      
        '110531102=    select FM, NM, FT, FIO_DOC, RNN, IDN, DT, G_ID_KIN' +
        'D, ID_NUM, ID_DATE, ID_ISSUER, G_APPOINTMENT,'
      
        '110531103=           IS_RUKOVODITEL, IS_GLAVBUH, IS_ISPOLNITEL, ' +
        'PASS, G_TOCHKA, DO_NOT_SALES_COMM'
      '110531104=    from G_OFFICIAL'
      '110531105=    where G_OFFICIAL = :G_OFFICIAL_'
      
        '110531106=    into :FM_, :NM_, :FT_, :FIO_DOC_, :RNN_, :IDN_, :D' +
        'T_, :G_ID_KIND_, :ID_NUM_, :ID_DATE_, :ID_ISSUER_, :G_APPOINTMEN' +
        'T_,'
      
        '110531107=         :IS_RUKOVODITEL_, :IS_GLAVBUH_, :IS_ISPOLNITE' +
        'L_, :PASSWORD_, :G_TOCHKA_, :DO_NOT_SALES_COMM_;'
      '110531108='
      '110531109=    -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1052#1040#1057#1057#1048#1042' '#1055#1056#1040#1042
      '110531110=    FOR SELECT RIGHTS_ITEM'
      '110531111=        FROM G_OFFICIAL_RIGHT'
      '110531112=       WHERE G_OFFICIAL = :G_OFFICIAL_'
      '110531113=        INTO :RIGHTS_ITEM_'
      '110531114=    DO BEGIN'
      '110531115=      if (RIGHTS_ARR_ IS NULL) then'
      
        '110531116=        RIGHTS_ARR_ = '#39#39'-'#39#39'||CAST(RIGHTS_ITEM_ AS VARC' +
        'HAR(5))||'#39#39'-'#39#39';'
      '110531117=      ELSE'
      
        '110531118=        RIGHTS_ARR_ = RIGHTS_ARR_||CAST(RIGHTS_ITEM_ A' +
        'S VARCHAR(5))||'#39#39'-'#39#39';'
      '110531119=    END'
      '110531120=end'
      '110531121='#39';'
      '110531122='
      '110531123=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_PRODUCT('
      '110531124=  G_PRODUCT_ INTEGER)'
      '110531125=RETURNS ('
      '110531126=  G_PRODUCT_PAR_ INTEGER,'
      '110531127=  ARTICUL_ VARCHAR(30),'
      '110531128=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110531129=  BARCODE_ VARCHAR(30),'
      '110531130=  NAME_ VARCHAR(500),'
      '110531131=  G_UNIT_ INTEGER,'
      '110531132=  PRICE_ NUMERIC(15,2),'
      '110531133=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110531134=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110531135=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110531136=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110531137=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110531138=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110531139=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110531140=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110531141=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110531142=  ERR_CODE INTEGER,'
      '110531143=  ERR_MSG VARCHAR(1024))'
      '110531144=AS'
      '110531145=begin'
      '110531146=    SELECT'
      '110531147=        G_PRODUCT_PAR,'
      '110531148=        ARTICUL,'
      '110531149=        NOMENCLATUR_NUM,'
      '110531150=        BARCODE,'
      '110531151=        NAME,'
      '110531152=        G_UNIT,'
      '110531153=        PRICE,'
      '110531154=        VOLUME_PRICE,'
      '110531155=        PACK_AMOUNT,'
      '110531156=        MF_COUNTRY,'
      '110531157=        NOTE,'
      '110531158=        CROSSCODE,'
      '110531159=        IS_KIT,'
      '110531160=        MIN_AMOUNT,'
      '110531161=        PLACE,'
      '110531162=        SALES_COMM'
      '110531163=    FROM G_PRODUCT T'
      '110531164=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110531165=    INTO'
      '110531166=        :G_PRODUCT_PAR_,'
      '110531167=        :ARTICUL_,'
      '110531168=        :NOMENCLATUR_NUM_,'
      '110531169=        :BARCODE_,'
      '110531170=        :NAME_,'
      '110531171=        :G_UNIT_,'
      '110531172=        :PRICE_,'
      '110531173=        :VOLUME_PRICE_,'
      '110531174=        :PACK_AMOUNT_,'
      '110531175=        :MF_COUNTRY_,'
      '110531176=        :NOTE_,'
      '110531177=        :CROSSCODE_,'
      '110531178=        :IS_KIT_,'
      '110531179=        :MIN_AMOUNT_,'
      '110531180=        :PLACE_,'
      '110531181=        :SALES_COMM_;'
      '110531182='
      '110531183=    INSERT INTO LT_BARCODE_TMP'
      
        '110531184=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110531185='
      '110531186=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110531187=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110531188='
      '110531189=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '110531190=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '110531191=end'
      '110531192='#39';'
      '110531193='
      '110531194=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_OFFICIAL('
      '110531195=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110531196=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110531197=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110531198=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110531199=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110531200=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110531201=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110531202=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110531203=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110531204=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110531205=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110531206=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110531207=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110531208=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110531209=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110531210=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110531211=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110531212=  RIGHTS_ARR_ VARCHAR(500),'
      
        '110531213=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.DO_NOT_' +
        'SALES_COMM)'
      '110531214=RETURNS ('
      '110531215=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110531216=  ERR_CODE INTEGER,'
      '110531217=  ERR_MSG VARCHAR(1024))'
      '110531218=AS'
      
        '110531219=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110531220=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110531221=begin'
      '110531222='
      
        '110531223=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110531224=      UPDATE G_OFFICIAL G'
      '110531225=         SET G.IS_ISPOLNITEL = 0;'
      '110531226='
      
        '110531227=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110531228=      UPDATE G_OFFICIAL G'
      '110531229=         SET G.IS_RUKOVODITEL = 0;'
      '110531230='
      
        '110531231=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110531232=      UPDATE G_OFFICIAL G'
      '110531233=         SET G.IS_GLAVBUH = 0;'
      '110531234='
      
        '110531235=    insert into G_OFFICIAL (G_OFFICIAL, FM, NM, FT, FI' +
        'O_DOC, RNN, IDN, DT, G_ID_KIND, ID_NUM, ID_DATE, ID_ISSUER,'
      
        '110531236=                            G_APPOINTMENT, IS_RUKOVODI' +
        'TEL, IS_GLAVBUH, IS_ISPOLNITEL, PASS, G_TOCHKA, DO_NOT_SALES_COM' +
        'M)'
      
        '110531237=    values (GEN_ID(GEN_G_OFFICIAL, 1), :FM_, :NM_, :FT' +
        '_, :FIO_DOC_, :RNN_, :IDN_, :DT_, :G_ID_KIND_, :ID_NUM_, :ID_DAT' +
        'E_, :ID_ISSUER_,'
      
        '110531238=            :G_APPOINTMENT_, :IS_RUKOVODITEL_, :IS_GLA' +
        'VBUH_, :IS_ISPOLNITEL_, :PASSWORD_, :G_TOCHKA_, :DO_NOT_SALES_CO' +
        'MM_)'
      '110531239=    returning G_OFFICIAL'
      '110531240=    into :G_OFFICIAL_;'
      '110531241='
      '110531242=    FOR SELECT T.RIGHTS_ITEM'
      '110531243=        FROM RIGHTS_ITEM T'
      '110531244=       WHERE T.IS_CATEGORY = 0'
      
        '110531245=         AND :RIGHTS_ARR_ CONTAINING '#39#39'-'#39#39'||T.RIGHTS_I' +
        'TEM||'#39#39'-'#39#39
      '110531246=        INTO :RIGHTS_ITEM_'
      '110531247=    DO BEGIN'
      
        '110531248=      INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT, ' +
        'RIGHTS_ITEM, G_OFFICIAL)'
      
        '110531249=      VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGHTS' +
        '_ITEM_, :G_OFFICIAL_);'
      '110531250=    END'
      '110531251='
      
        '110531252=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110531253=    SELECT COUNT(G.G_OFFICIAL)'
      '110531254=      FROM G_OFFICIAL G'
      '110531255=     WHERE EXISTS (SELECT 1'
      '110531256=                     FROM G_OFFICIAL_RIGHT R'
      '110531257=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110531258=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110531259=    INTO :CNT_;'
      '110531260='
      '110531261=    IF (:CNT_ = 0) THEN BEGIN'
      '110531262=      ERR_CODE = -20500;'
      
        '110531263=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1086#1073#1093#1086 +
        #1076#1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087 +
        #1088#1072#1074#1072'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '110531264=      EXIT;'
      '110531265=    END'
      '110531266=end'
      '110531267='#39';'
      '110531268='
      '110531269=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_PRODUCT('
      '110531270=  G_PRODUCT_PAR_ INTEGER,'
      '110531271=  ARTICUL_ VARCHAR(30),'
      '110531272=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110531273=  BARCODE_ VARCHAR(30),'
      '110531274=  NAME_ VARCHAR(500),'
      '110531275=  G_UNIT_ INTEGER,'
      '110531276=  PRICE_ NUMERIC(15,2),'
      '110531277=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110531278=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110531279=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110531280=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110531281=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110531282=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110531283=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110531284=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110531285=  IS_CATEGORY_ INTEGER,'
      '110531286=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '110531287=RETURNS ('
      '110531288=  G_PRODUCT_ INTEGER,'
      '110531289=  ERR_CODE INTEGER,'
      '110531290=  ERR_MSG VARCHAR(1024))'
      '110531291=AS'
      
        '110531292=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'G_INS_G_PROD' +
        'UCT'#39#39';'
      '110531293=DECLARE VARIABLE CNT_ INTEGER;'
      '110531294=DECLARE VARIABLE N INTEGER;'
      '110531295=DECLARE VARIABLE N_CURR_ INTEGER;'
      
        '110531296=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110531297=begin'
      
        '110531298=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110531299=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '110531300=        SELECT COUNT(*)'
      '110531301=          FROM G_PRODUCT G'
      
        '110531302=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110531303=           AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '110531304=          INTO :CNT_;'
      '110531305='
      '110531306=        IF (CNT_ > 0) THEN BEGIN'
      '110531307=          ERR_CODE = -20500;'
      
        '110531308=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39'||ARTICUL_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110531309=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110531310=          EXIT;'
      '110531311=        END'
      '110531312=    end'
      '110531313='
      '110531314=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '110531315=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then' +
        ' begin'
      '110531316=        SELECT COUNT(*)'
      '110531317=          FROM G_PRODUCT G'
      
        '110531318=         WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:' +
        'NOMENCLATUR_NUM_))'
      '110531319=           AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39#39#39
      '110531320=        INTO :CNT_;'
      '110531321=        IF (CNT_ > 0) THEN BEGIN'
      '110531322=          ERR_CODE = -20500;'
      
        '110531323=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||NOMENCLATUR_NUM_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39 +
        #39') RETURNING_VALUES (:ERR_MSG);'
      '110531324=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110531325=          EXIT;'
      '110531326=        END'
      '110531327=    end'
      '110531328='
      '110531329=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110531330=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110531331=        SELECT COUNT(*)'
      '110531332=          FROM G_PRODUCT G'
      
        '110531333=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110531334=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '110531335=          INTO :CNT_;'
      '110531336='
      '110531337=        IF (CNT_ = 0) then'
      '110531338=          SELECT COUNT(*)'
      '110531339=            FROM G_PRODUCT G, LT_BARCODE L'
      '110531340=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110531341=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110531342=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '110531343=            INTO :CNT_;'
      '110531344='
      '110531345=        IF (CNT_ > 0) THEN BEGIN'
      '110531346=          ERR_CODE = -20500;'
      
        '110531347=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39#39'||:BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING' +
        '_VALUES (:ERR_MSG);'
      '110531348=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110531349=          EXIT;'
      '110531350=        END'
      '110531351=    end'
      '110531352='
      
        '110531353=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PR' +
        'ICE,'
      
        '110531354=                           IS_CATEGORY, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COM' +
        'M)'
      
        '110531355=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRI' +
        'CE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '110531356=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROS' +
        'SCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_)'
      '110531357=    RETURNING G_PRODUCT'
      '110531358=    INTO :G_PRODUCT_;'
      '110531359='
      '110531360=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '110531361=    if (:IS_CATEGORY_ = 0) then begin'
      
        '110531362=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110531363=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '110531364='
      '110531365=        INSERT INTO LT_BARCODE'
      
        '110531366=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110531367='
      
        '110531368=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090 +
        #1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '110531369=        INSERT into G_PRODUCT_IMAGE'
      
        '110531370=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYP' +
        'E from G_PRODUCT_IMAGE_TMP;'
      '110531371='
      
        '110531372=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089 +
        #1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '110531373=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091 +
        #1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '110531374=        IF (is_kit_ > 0) THEN begin'
      '110531375=            INSERT INTO G_PRODUCT_KIT'
      
        '110531376=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP;'
      '110531377='
      '110531378=            if (is_kit_ = 1) then begin'
      
        '110531379=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110531380=                  FROM G_PRODUCT_KIT K,'
      '110531381=                       LT_SKLAD_PRODUCT L'
      '110531382=                 WHERE K.g_product = :G_PRODUCT_'
      '110531383=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110531384=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110531385=                 GROUP BY K.G_PRODUCT'
      '110531386=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110531387='
      '110531388=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110531389=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_' +
        'SOSTAV_AMOUNT_, 0)'
      '110531390=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110531391=            end'
      '110531392=        END'
      '110531393=    END'
      '110531394=end'
      '110531395='#39';'
      '110531396='
      '110531397=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_OFFICIAL('
      '110531398=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110531399=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110531400=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110531401=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110531402=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110531403=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110531404=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110531405=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110531406=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110531407=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110531408=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110531409=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110531410=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110531411=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110531412=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110531413=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110531414=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110531415=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110531416=  RIGHTS_ARR_ VARCHAR(500),'
      
        '110531417=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.G_OFFIC' +
        'IAL)'
      '110531418=RETURNS ('
      '110531419=  ERR_CODE INTEGER,'
      '110531420=  ERR_MSG VARCHAR(1024))'
      '110531421=AS'
      
        '110531422=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110531423=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110531424=begin'
      
        '110531425=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110531426=      UPDATE G_OFFICIAL G'
      '110531427=         SET G.IS_ISPOLNITEL = 0;'
      '110531428='
      
        '110531429=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110531430=      UPDATE G_OFFICIAL G'
      '110531431=         SET G.IS_RUKOVODITEL = 0;'
      '110531432='
      
        '110531433=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110531434=      UPDATE G_OFFICIAL G'
      '110531435=         SET G.IS_GLAVBUH = 0;'
      '110531436='
      '110531437=    update G_OFFICIAL'
      '110531438=    set FM = :FM_,'
      '110531439=        NM = :NM_,'
      '110531440=        FT = :FT_,'
      '110531441=        FIO_DOC = :FIO_DOC_,'
      '110531442=        RNN = :RNN_,'
      '110531443=        IDN = :IDN_,'
      '110531444=        DT = :DT_,'
      '110531445=        G_ID_KIND = :G_ID_KIND_,'
      '110531446=        ID_NUM = :ID_NUM_,'
      '110531447=        ID_DATE = :ID_DATE_,'
      '110531448=        ID_ISSUER = :ID_ISSUER_,'
      '110531449=        G_APPOINTMENT = :G_APPOINTMENT_,'
      '110531450=        IS_RUKOVODITEL = :IS_RUKOVODITEL_,'
      '110531451=        IS_GLAVBUH = :IS_GLAVBUH_,'
      '110531452=        IS_ISPOLNITEL = :IS_ISPOLNITEL_,'
      '110531453=        PASS = :PASSWORD_,'
      '110531454=        G_TOCHKA = :G_TOCHKA_,'
      '110531455=        DO_NOT_SALES_COMM = :DO_NOT_SALES_COMM_'
      '110531456=    where (G_OFFICIAL = :G_OFFICIAL_);'
      '110531457='
      
        '110531458=    DELETE FROM G_OFFICIAL_RIGHT WHERE G_OFFICIAL = :G' +
        '_OFFICIAL_;'
      '110531459=    FOR SELECT T.RIGHTS_ITEM'
      '110531460=        FROM RIGHTS_ITEM T'
      '110531461=       WHERE T.IS_CATEGORY = 0'
      
        '110531462=         AND :RIGHTS_ARR_ CONTAINING '#39#39'-'#39#39'||T.RIGHTS_I' +
        'TEM||'#39#39'-'#39#39
      '110531463=        INTO :RIGHTS_ITEM_'
      '110531464=    DO BEGIN'
      
        '110531465=        INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT' +
        ', RIGHTS_ITEM, G_OFFICIAL)'
      
        '110531466=        VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGH' +
        'TS_ITEM_, :G_OFFICIAL_);'
      '110531467=    END'
      '110531468='
      
        '110531469=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110531470=    SELECT COUNT(G.G_OFFICIAL)'
      '110531471=      FROM G_OFFICIAL G'
      '110531472=     WHERE EXISTS (SELECT 1'
      '110531473=                     FROM G_OFFICIAL_RIGHT R'
      '110531474=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110531475=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110531476=    INTO :CNT_;'
      '110531477='
      '110531478=    IF (:CNT_ = 0) THEN BEGIN'
      '110531479=      ERR_CODE = -20500;'
      
        '110531480=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1086#1073#1093#1086 +
        #1076#1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087 +
        #1088#1072#1074#1072'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '110531481=      EXIT;'
      '110531482=    END'
      '110531483=end'
      '110531484='#39';'
      '110531485='
      '110531486=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110531487=  G_PRODUCT_ INTEGER,'
      '110531488=  G_PRODUCT_PAR_ INTEGER,'
      '110531489=  ARTICUL_ VARCHAR(30),'
      '110531490=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110531491=  BARCODE_ VARCHAR(30),'
      '110531492=  NAME_ VARCHAR(500),'
      '110531493=  G_UNIT_ INTEGER,'
      '110531494=  PRICE_ NUMERIC(15,2),'
      '110531495=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110531496=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110531497=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110531498=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110531499=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110531500=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110531501=  IS_CATEGORY_ INTEGER,'
      '110531502=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110531503=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110531504=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '110531505=RETURNS ('
      '110531506=  ERR_CODE INTEGER,'
      '110531507=  ERR_MSG VARCHAR(1024))'
      '110531508=AS'
      
        '110531509=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'G_UPD_G_PROD' +
        'UCT'#39#39';'
      '110531510=DECLARE VARIABLE N_CURR_ INTEGER;'
      '110531511=DECLARE VARIABLE N INTEGER;'
      '110531512=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110531513=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110531514=begin'
      
        '110531515=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110531516=    SELECT COUNT(*)'
      '110531517=      FROM G_PRODUCT G'
      '110531518=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '110531519=       AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '110531520=       AND TRIM(:ARTICUL_) <> '#39#39#39#39
      '110531521=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110531522=      INTO :CNT_;'
      '110531523='
      '110531524=    IF (CNT_ > 0) THEN BEGIN'
      '110531525=      ERR_CODE = -20500;'
      
        '110531526=      ERR_MSG  = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39'||ARTICUL_||'#39#39' ' +
        #1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39';'
      '110531527=      EXIT;'
      '110531528=    END'
      '110531529='
      '110531530=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110531531=    SELECT COUNT(*)'
      '110531532=      FROM G_PRODUCT G'
      
        '110531533=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOME' +
        'NCLATUR_NUM_))'
      '110531534=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39#39#39
      '110531535=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39#39#39
      '110531536=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110531537=    INTO :CNT_;'
      '110531538=    IF (CNT_ > 0) THEN BEGIN'
      '110531539=      ERR_CODE = -20500;'
      
        '110531540=      ERR_MSG  = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||NOMENC' +
        'LATUR_NUM_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39';'
      '110531541=      EXIT;'
      '110531542=    END'
      '110531543='
      '110531544=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110531545=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110531546=        SELECT COUNT(*)'
      '110531547=          FROM G_PRODUCT G'
      
        '110531548=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110531549=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '110531550=           AND TRIM(:BARCODE_) <> '#39#39#39#39
      '110531551=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '110531552=          INTO :CNT_;'
      '110531553='
      '110531554=        IF (CNT_ = 0) then'
      '110531555=          SELECT COUNT(*)'
      '110531556=            FROM G_PRODUCT G, LT_BARCODE L'
      '110531557=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110531558=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110531559=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '110531560=            INTO :CNT_;'
      '110531561='
      '110531562=        IF (CNT_ > 0) THEN BEGIN'
      '110531563=          ERR_CODE = -20500;'
      
        '110531564=          ERR_MSG  = '#39#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39#39'||:BARCOD' +
        'E_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39';'
      '110531565=          EXIT;'
      '110531566=        END'
      '110531567=    END'
      '110531568='
      '110531569=    update G_PRODUCT'
      '110531570=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110531571=        ARTICUL = :ARTICUL_,'
      '110531572=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110531573=        BARCODE = :BARCODE_,'
      '110531574=        NAME = :NAME_,'
      '110531575=        G_UNIT = :G_UNIT_,'
      '110531576=        PRICE = :PRICE_,'
      '110531577=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110531578=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110531579=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110531580=        NOTE         = :NOTE_,'
      '110531581=        CROSSCODE    = :CROSSCODE_,'
      '110531582=        IS_KIT       = :IS_KIT_,'
      '110531583=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110531584=        PLACE        = :PLACE_,'
      '110531585=        SALES_COMM   = :SALES_COMM_'
      '110531586=    where (G_PRODUCT = :G_PRODUCT_);'
      '110531587='
      '110531588=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110531589=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110531590='
      '110531591=        INSERT INTO LT_BARCODE'
      
        '110531592=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110531593='
      '110531594=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110531595=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110531596=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110531597='
      
        '110531598=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE);'
      '110531599='
      '110531600=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110531601=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110531602=            INSERT INTO G_PRODUCT_KIT'
      
        '110531603=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110531604=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110531605=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110531606=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110531607='
      
        '110531608=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110531609=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110531610='
      '110531611=            UPDATE G_PRODUCT_KIT G'
      
        '110531612=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110531613=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110531614=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110531615=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110531616='
      
        '110531617=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110531618=            if (is_kit_ = 1) then begin'
      '110531619=                SELECT MIN(L.AMOUNT)'
      '110531620=                  FROM G_PRODUCT_KIT K,'
      '110531621=                       LT_SKLAD_PRODUCT L'
      '110531622=                 WHERE K.g_product = :G_PRODUCT_'
      '110531623=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110531624=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110531625=                 GROUP BY K.G_PRODUCT'
      '110531626=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110531627='
      '110531628=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110531629=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110531630=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110531631=            end'
      '110531632=        END'
      '110531633=    END'
      '110531634=end'
      '110531635='#39';'
      '110531636=END  --END_EXECUTE_BLOCK'
      '110531637=EXECUTE BLOCK AS BEGIN'
      '110531638='
      '110531639=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '110531640=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110531641=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '110531642=RETURNS ('
      '110531643=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110531644=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110531645=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110531646=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110531647=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110531648=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110531649=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110531650=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110531651=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110531652=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110531653=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110531654=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110531655=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110531656=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110531657=  CNT_Z_ INTEGER,'
      
        '110531658=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110531659=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110531660=  HAVERIGHT_ INTEGER,'
      '110531661=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110531662=  ERR_CODE INTEGER,'
      '110531663=  ERR_MSG VARCHAR(1024))'
      '110531664=AS'
      '110531665=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      
        '110531666=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110531667=begin'
      '110531668='
      '110531669=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110531670=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '110531671=          SELECT'
      '110531672=            T.G_TOCHKA,'
      '110531673=            T.Z_DATE,'
      '110531674=            T.Z_TIME,'
      '110531675=            T.G_CLIENT,'
      '110531676=            T.G_PAYMENT_TYPE,'
      '110531677=            T.OSNOVANIE,'
      '110531678=            T.NOTE,'
      '110531679=            T.SUMM,'
      '110531680=            T.SUMM_FACT,'
      '110531681=            T.SUMM_BONUS,'
      '110531682=            T.summ_bonus_got,'
      '110531683=            T.IS_PAYED_ALL,'
      '110531684=            COALESCE(T.BY_RECIPE, 0)'
      '110531685=            ,IS_RESERVE'
      '110531686=          FROM ZAKAZ T'
      '110531687=          WHERE T.ZAKAZ = :ZAKAZ_'
      '110531688=          INTO'
      '110531689=            :G_TOCHKA_,'
      '110531690=            :Z_DATE_,'
      '110531691=            :Z_TIME_,'
      '110531692=            :G_CLIENT_,'
      '110531693=            :G_PAYMENT_TYPE_,'
      '110531694=            :OSNOVANIE_,'
      '110531695=            :NOTE_,'
      '110531696=            :SUMM_,'
      '110531697=            :SUMM_FACT_,'
      '110531698=            :SUMM_PAY_BONUS_,'
      '110531699=            :SUMM_GOT_BONUS_,'
      '110531700=            :IS_PAYED_ALL_,'
      '110531701=            :BY_RECIPE_,'
      '110531702=            :IS_RESERVE_;'
      '110531703='
      '110531704=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '110531705=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS,' +
        ' ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_' +
        'TENGE,'
      
        '110531706=                                        DISCOUNT_SUMM,' +
        ' NDS, NDS_SUMM, COST_PRICE)'
      
        '110531707=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AM' +
        'OUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110531708=                   DISCOUNT_SUMM, NDS, NDS_SUMM, COST_' +
        'PRICE'
      '110531709=              FROM ZAKAZ_DETAILS'
      '110531710=             WHERE ZAKAZ = :ZAKAZ_'
      '110531711=             ORDER BY 1;'
      '110531712='
      '110531713=          -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110531714=          SELECT K.G_PRIHOD_RASHOD,'
      '110531715=                 K.SUMM'
      
        '110531716=            FROM (SELECT * FROM KASSA UNION SELECT * F' +
        'ROM KASSA_BEZNAL) K'
      '110531717=           WHERE K.ZAKAZ = :ZAKAZ_'
      '110531718=             AND K.G_PRIHOD_RASHOD <> 1'
      '110531719=            INTO :G_PRIHOD_,'
      '110531720=                 :SUMM_PRIHOD_;'
      '110531721=      END'
      '110531722='
      
        '110531723=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RET' +
        'URNING_VALUES :PAYMENTS_;'
      '110531724=  END'
      '110531725=  ELSE BEGIN'
      '110531726=    SELECT'
      '110531727=        T.G_CLIENT,'
      '110531728=        T.DATE_RECEIPT,'
      '110531729=        T.TIME_RECEIPT,'
      '110531730=        T.G_TOCHKA,'
      '110531731=        T.G_PAYMENT_TYPE,'
      '110531732=        T.OSNOVANIE,'
      '110531733=        T.NOTE,'
      '110531734=        T.SUMM,'
      '110531735=        T.SUMM_FACT,'
      '110531736=        0,'
      '110531737=        0,'
      '110531738=        0'
      '110531739=      FROM SKLAD_PARENT T'
      '110531740=      WHERE T.SKLAD = :ZAKAZ_'
      '110531741=      INTO'
      '110531742=        :G_TOCHKA_,'
      '110531743=        :Z_DATE_,'
      '110531744=        :Z_TIME_,'
      '110531745=        :G_CLIENT_,'
      '110531746=        :G_PAYMENT_TYPE_,'
      '110531747=        :OSNOVANIE_,'
      '110531748=        :NOTE_,'
      '110531749=        :SUMM_,'
      '110531750=        :SUMM_FACT_,'
      '110531751=        :SUMM_PAY_BONUS_,'
      '110531752=        :IS_PAYED_ALL_,'
      '110531753=        :BY_RECIPE_;'
      '110531754='
      
        '110531755=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '110531756=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '110531757=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE,' +
        ' SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047#1040 +
        #1055#1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '110531758=        FROM SKLAD'
      '110531759=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '110531760=      ORDER BY 1;'
      '110531761=  END'
      '110531762='
      '110531763=  HaveRight_ = 1;'
      '110531764=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '110531765=    SELECT ID'
      '110531766=      FROM CUR_PARAMS'
      '110531767=     WHERE CUR_PARAMS = 1'
      '110531768=      INTO :G_OFFICIAL_CUR_;'
      '110531769='
      
        '110531770=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110531771=      HaveRight_ = 1;'
      '110531772=    else'
      
        '110531773=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110531774=  END'
      '110531775=end'
      '110531776='#39';'
      '110531777='
      '110531778=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ('
      '110531779=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110531780=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110531781=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110531782=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110531783=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110531784=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110531785=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110531786=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110531787=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110531788=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110531789=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110531790=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110531791=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110531792=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110531793=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110531794=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110531795=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110531796=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110531797=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110531798=  IS_MEBEL_ INTEGER = 0,'
      
        '110531799=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110531800=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      '110531801=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '110531802=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL)'
      '110531803=RETURNS ('
      '110531804=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110531805=  ERR_CODE INTEGER,'
      '110531806=  ERR_MSG VARCHAR(1024))'
      '110531807=AS'
      '110531808=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'INS_ZAKAZ'#39#39';'
      '110531809=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110531810=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110531811=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110531812=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110531813=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110531814=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110531815=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110531816=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110531817=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110531818=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110531819=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110531820=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110531821=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110531822=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '110531823=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      
        '110531824=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110531825=DECLARE VARIABLE CNT_ INTEGER;'
      '110531826=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110531827=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110531828=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110531829=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110531830=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110531831=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110531832=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110531833=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110531834=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110531835=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110531836=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110531837=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110531838=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110531839=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110531840=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      '110531841=BEGIN'
      '110531842='
      '110531843=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110531844=  IF (CNT_ = 0) THEN BEGIN'
      '110531845=    ERR_CODE = -20500;'
      
        '110531846=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '110531847=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ 00 '#39#39'||ERR_MSG;'
      '110531848=    EXIT;'
      '110531849=  END'
      '110531850='
      '110531851=  IF (G_TOCHKA_ IS NULL) THEN'
      '110531852=    SELECT ID'
      '110531853=      FROM CUR_PARAMS'
      '110531854=     WHERE CUR_PARAMS = 2'
      '110531855=      INTO :G_TOCHKA_;'
      '110531856='
      '110531857=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110531858=      PNT_ = '#39#39'01'#39#39';'
      '110531859=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN'
      '110531860=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110531861=      ELSE'
      '110531862=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110531863='
      '110531864=      SELECT ID,'
      '110531865=             G.DO_NOT_SALES_COMM,'
      '110531866=             G.FM||'#39#39' '#39#39'||G.NM'
      '110531867=        FROM CUR_PARAMS, G_OFFICIAL G'
      '110531868=       WHERE CUR_PARAMS = 1'
      '110531869=         AND ID = G.G_OFFICIAL'
      '110531870=        INTO :G_OFFICIAL_,'
      '110531871=             :DO_NOT_SALES_COMM_,'
      '110531872=             :OFFICIAL_NAME_;'
      '110531873='
      '110531874=      INSERT INTO ZAKAZ'
      '110531875=      ('
      '110531876=       ZAKAZ,'
      '110531877=       G_TOCHKA,'
      '110531878=       Z_DATE,'
      '110531879=       Z_TIME,'
      '110531880=       G_CLIENT,'
      '110531881=       G_PAYMENT_TYPE,'
      '110531882=       OSNOVANIE,'
      '110531883=       IS_SPISANIE,'
      '110531884=       NOTE,'
      '110531885=       SUMM,'
      '110531886=       SUMM_FACT,'
      '110531887=       SUMM_BONUS,'
      '110531888=       IS_PAYED_ALL'
      '110531889=       ,G_OFFICIAL'
      '110531890=       ,BY_RECIPE'
      '110531891=       ,SUMM_BONUS_GOT'
      '110531892=       ,IS_RESERVE'
      '110531893=       ,SUMM_CASH'
      '110531894=       ,SUMM_NONCASH'
      '110531895=      ) VALUES ('
      '110531896=       GEN_ID(GEN_ZAKAZ, 1),'
      '110531897=       :G_TOCHKA_,'
      '110531898=       :Z_DATE_,'
      '110531899=       :Z_TIME_,'
      '110531900=       :G_CLIENT_,'
      '110531901=       :G_PAYMENT_TYPE_,'
      '110531902=       :OSNOVANIE_,'
      '110531903=       :IS_SPISANIE_,'
      '110531904=       :NOTE_,'
      '110531905=       :SUMM_,'
      '110531906=       :SUMM_FACT_1_,'
      '110531907=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110531908=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)'
      '110531909=       ,:G_OFFICIAL_'
      '110531910=       ,:BY_RECIPE_'
      '110531911=       ,:SUMM_BONUS_GOT_'
      '110531912=       ,:IS_RESERVE_'
      '110531913=       ,COALESCE(:SUMM_CASH_, 0)'
      '110531914=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110531915=      )'
      '110531916=      RETURNING'
      '110531917=        ZAKAZ'
      '110531918=      INTO'
      '110531919=        :ZAKAZ_;'
      '110531920='
      '110531921=      PNT_ = '#39#39'02'#39#39';'
      
        '110531922=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110531923=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM'
      '110531924=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110531925=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110531926=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110531927=              :G_PRODUCT,'
      '110531928=              :AMOUNT,'
      '110531929=              :PRICE,'
      '110531930=              :SUMM,'
      '110531931=              :DISCOUNT_PERC,'
      '110531932=              :DISCOUNT_TENGE,'
      '110531933=              :DISCOUNT_SUMM,'
      '110531934=              :NDS,'
      '110531935=              :NDS_SUMM,'
      '110531936=              :COST_PRICE,'
      '110531937=              :SALES_COMM_'
      '110531938=      DO BEGIN'
      
        '110531939=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '110531940=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/1' +
        '00;'
      
        '110531941=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110531942=        END'
      '110531943='
      '110531944=        INSERT INTO ZAKAZ_DETAILS'
      '110531945=        VALUES('
      '110531946=          :ZAKAZ_DETAILS_TMP_,'
      '110531947=          :ZAKAZ_,'
      '110531948=          :G_PRODUCT,'
      '110531949=          :AMOUNT,'
      '110531950=          :PRICE,'
      '110531951=          :SUMM,'
      '110531952=          :DISCOUNT_PERC,'
      '110531953=          :DISCOUNT_TENGE,'
      '110531954=          :DISCOUNT_SUMM,'
      '110531955=          :NDS,'
      '110531956=          :NDS_SUMM,'
      '110531957=          :COST_PRICE,'
      '110531958=          :SALES_COMM_SUMM_ITER_'
      '110531959=        );'
      '110531960='
      '110531961=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '110531962=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '110531963=            UPDATE LT_SKLAD_PRODUCT L'
      '110531964=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110531965=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110531966=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110531967='
      '110531968=            PNT_ = '#39#39'04'#39#39';'
      
        '110531969=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE F' +
        'ROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110531970=              Err_Code = -20500;'
      
        '110531971=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRO' +
        'DUCT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080 +
        ' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110531972=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110531973=              EXIT;'
      '110531974=            END ELSE if (ROW_COUNT = 0) then'
      
        '110531975=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110531976=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110531977=        END'
      '110531978='
      '110531979=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110531980=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110531981=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110531982=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :AMOUNT'
      '110531983=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110531984=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110531985=      END'
      '110531986='
      '110531987=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110531988=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110531989=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110531990=                PNT_ = '#39#39'05'#39#39';'
      
        '110531991=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110531992=                                              1,     -' +
        '- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110531993=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110531994=                                              :Z_DATE_' +
        ','
      
        '110531995=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110531996=                                              ZAKAZ_, ' +
        '  --ZAKAZ_'
      '110531997=                                              NULL,'
      
        '110531998=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110531999=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110532000=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532001=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110532002=                  EXIT;'
      '110532003=                END'
      '110532004=            END'
      '110532005='
      '110532006=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110532007=        END ELSE BEGIN'
      '110532008=            PNT_ = '#39#39'06'#39#39';'
      
        '110532009=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110532010=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENT' +
        'S_);'
      
        '110532011=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110532012=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110532013=                ELSE'
      
        '110532014=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110532015='
      
        '110532016=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110532017=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110532018='
      
        '110532019=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110532020='
      '110532021=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110532022=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110532023=                                                  1,  ' +
        '   --:G_PRIHOD_RASHOD_,'
      
        '110532024=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110532025=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110532026=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110532027=                                                  :ZAK' +
        'AZ_,'
      
        '110532028=                                                  NULL' +
        ',     --:SKLAD_,'
      
        '110532029=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110532030=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110532031=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532032=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110532033=                      EXIT;'
      '110532034=                    END'
      '110532035=                END'
      '110532036=            END'
      '110532037=        END'
      '110532038=      END'
      '110532039='
      '110532040=      UPDATE G_DISCONT_CARD D'
      
        '110532041=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0) ' +
        '+ :SUMM_BONUS_GOT_,'
      '110532042=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110532043=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110532044='
      '110532045=      PNT_ = '#39#39'07'#39#39';'
      
        '110532046=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COM' +
        'M_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN B' +
        'EGIN'
      '110532047=        SELECT S.S_VALUE'
      '110532048=          FROM SYSTEM_SETUP S'
      '110532049=         WHERE S.SYSTEM_SETUP = 4'
      '110532050=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '110532051='
      '110532052=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110532053=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110532054='
      '110532055=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '110532056=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE' +
        '(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM ' +
        'CURRENT_DATE)));'
      '110532057='
      '110532058=        ELSE'
      
        '110532059=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DA' +
        'Y FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTR' +
        'ACT(DAY FROM current_date) + 32);'
      '110532060='
      '110532061=        KASSA_ = NULL;'
      '110532062=        SELECT K.KASSA, K.SUMM'
      '110532063=        FROM KASSA K'
      '110532064=        WHERE K.G_PRIHOD_RASHOD = -1'
      '110532065=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110532066=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110532067=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110532068='
      '110532069=        IF (KASSA_ IS NULL) THEN'
      
        '110532070=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110532071=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110532072=                                          :SALES_COMM_' +
        'SUMM_ALL_,'
      
        '110532073=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110532074=                                          :OFFICIAL_NA' +
        'ME_,'
      
        '110532075=                                          NULL,     --' +
        ':ZAKAZ_,'
      
        '110532076=                                          NULL,     --' +
        ':SKLAD_,'
      '110532077=                                          1,'
      '110532078=                                          :G_TOCHKA_,'
      '110532079=                                          :G_OFFICIAL_'
      
        '110532080=                                          ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110532081=        ELSE'
      '110532082=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110532083=                                          1,     -- AC' +
        'TION_'
      
        '110532084=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110532085=                                          :SALES_COMM_' +
        'SUMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '110532086=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110532087=                                          :OFFICIAL_NA' +
        'ME_,   --NOTE_'
      '110532088=                                          NULL,'
      '110532089=                                          NULL,'
      
        '110532090=                                          :PAYMENT_TYP' +
        'E_,'
      '110532091=                                          :G_OFFICIAL_'
      
        '110532092=                                          ) RETURNING_' +
        'VALUES :ERR_CODE, :ERR_MSG;'
      '110532093='
      '110532094=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532095=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110532096=          EXIT;'
      '110532097=        END'
      '110532098=      END'
      '110532099=  END'
      '110532100=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '110532101=      PNT_ = '#39#39'25'#39#39';'
      
        '110532102=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
        'A)'
      
        '110532103=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLI' +
        'ENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA' +
        '_)'
      '110532104=      RETURNING ZAKAZ_REAL_PARENT'
      '110532105=      INTO :ZAKAZ_REAL_PARENT_;'
      '110532106='
      
        '110532107=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCO' +
        'UNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '110532108=            FROM ZAKAZ_DETAILS_TMP Z'
      '110532109=          INTO :G_PRODUCT,'
      '110532110=              :AMOUNT,'
      '110532111=              :PRICE,'
      '110532112=              :SUMM,'
      '110532113=              :DISCOUNT_PERC,'
      '110532114=              :DISCOUNT_TENGE,'
      '110532115=              :DISCOUNT_SUMM,'
      '110532116=              :NDS,'
      '110532117=              :NDS_SUMM'
      '110532118=      DO BEGIN'
      '110532119=          UPDATE LT_SKLAD_PRODUCT L'
      '110532120=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110532121=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '110532122=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110532123='
      
        '110532124=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FRO' +
        'M SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110532125=            Err_Code = -20500;'
      
        '110532126=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODU' +
        'CT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087 +
        #1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110532127=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532128=            EXIT;'
      '110532129=          END ELSE if (ROW_COUNT = 0) then'
      
        '110532130=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRO' +
        'DUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110532131=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :' +
        'G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110532132='
      
        '110532133=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZA' +
        'KAZ_REAL_PARENT,'
      '110532134=                                     G_PRODUCT,'
      '110532135=                                     PRICE,'
      
        '110532136=                                     AMOUNT_ALL, SUMM_' +
        'ALL,'
      
        '110532137=                                     AMOUNT_PAYED, SUM' +
        'M_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_S' +
        'UMM, NDS,'
      '110532138=                                     NDS_SUMM)'
      
        '110532139=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ' +
        '_REAL_PARENT_,'
      '110532140=                  :G_PRODUCT,'
      
        '110532141=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040 +
        #1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '110532142=                  :AMOUNT, :SUMM,'
      '110532143=                  0, --AMOUNT_PAYED,'
      '110532144=                  0, --SUMM_PAYED,'
      '110532145=                  0, --IS_PAYED_ALL,'
      '110532146=                  :DISCOUNT_PERC,'
      '110532147=                  :DISCOUNT_TENGE,'
      '110532148=                  :DISCOUNT_SUMM,'
      '110532149=                  :NDS,'
      '110532150=                  :NDS_SUMM)'
      '110532151=          RETURNING ZAKAZ_NA_REAL'
      '110532152=          INTO :ZAKAZ_;'
      '110532153=      END'
      '110532154=  END'
      '110532155=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '110532156=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, T' +
        'IME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SU' +
        'MM_FACT,'
      
        '110532157=                                IS_PAYED_ALL, IS_VOZVR' +
        'AT, G_TOCHKA)'
      
        '110532158=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_' +
        ', :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SU' +
        'MM_FACT_,'
      '110532159=              1, 3, :G_CLIENT_)'
      '110532160=      RETURNING SKLAD'
      '110532161=      INTO :SKLAD_;'
      '110532162='
      '110532163=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110532164=            FROM ZAKAZ_DETAILS_TMP Z'
      '110532165=          INTO :G_PRODUCT,'
      '110532166=              :AMOUNT,'
      '110532167=              :PRICE,'
      '110532168=              :SUMM'
      '110532169=      DO BEGIN'
      '110532170=        UPDATE LT_SKLAD_PRODUCT L'
      '110532171=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110532172=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110532173=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110532174='
      '110532175=        INSERT INTO SKLAD'
      '110532176=        ('
      '110532177=         SKLAD,'
      '110532178=         SKLAD_PARENT,'
      '110532179=         DATE_RECEIPT,'
      '110532180=         G_CLIENT,'
      '110532181=         G_PRODUCT,'
      '110532182=         AMOUNT,'
      '110532183=         PRICE,'
      '110532184=         SUMM,'
      '110532185=         G_PAYMENT_TYPE,'
      '110532186=         OSNOVANIE,'
      '110532187=         NOTE,'
      '110532188=         NDS,'
      '110532189=         NDS_SUMM,'
      '110532190=         IS_LAST,'
      '110532191=         IS_VOZVRAT,'
      '110532192=         G_TOCHKA'
      '110532193=        ) VALUES ('
      '110532194=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '110532195=         :SKLAD_,'
      '110532196=         :Z_DATE_,'
      '110532197=         :G_TOCHKA_,'
      '110532198=         :G_PRODUCT,'
      '110532199=         :AMOUNT,'
      '110532200=         :PRICE,'
      '110532201=         :SUMM,'
      '110532202=         :G_PAYMENT_TYPE_,'
      '110532203=         :OSNOVANIE_,'
      '110532204=         :NOTE_,'
      '110532205=         0,  --:RNDS_,'
      '110532206=         0,  --:RNDS_SUMM_,'
      '110532207=         DECODE(:IS_THIS_LAST_, 1, 1, 0),'
      '110532208=         3,  --:IS_VOZVRAT_,'
      '110532209=         :G_CLIENT_'
      '110532210=        );'
      '110532211='
      '110532212=        PNT_ = '#39#39'02'#39#39';'
      '110532213=        UPDATE LT_SKLAD_PRODUCT L'
      '110532214=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '110532215=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110532216=           AND L.G_TOCHKA = :G_CLIENT_;'
      '110532217='
      '110532218=        IF (ROW_COUNT = 0) THEN'
      
        '110532219=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '110532220=      END'
      '110532221=  END'
      '110532222='
      '110532223=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110532224='
      '110532225=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110532226=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =>' +
        ' :ACTION_'
      '110532227=                                  G_PRIHOD_,'
      '110532228=                                  :SUMM_PRIHOD_,'
      '110532229=                                  :Z_DATE_,'
      
        '110532230=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110532231=                                  :ZAKAZ_,'
      '110532232=                                  NULL,'
      '110532233=                                  :G_PAYMENT_TYPE_,'
      
        '110532234=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110532235=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532236=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110532237=      EXIT;'
      '110532238=    END'
      '110532239=  END'
      '110532240='
      '110532241=  IF (IS_MEBEL_ = 1) THEN'
      
        '110532242=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS' +
        ', ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '110532243=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, ' +
        ':ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '110532244=end'
      '110532245='#39';'
      '110532246='
      
        '110532247=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ_DETAILS_T' +
        'MP('
      
        '110532248=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110532249=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110532250=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110532251=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110532252=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110532253=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110532254=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110532255=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110532256=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110532257=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110532258=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110532259=  IS_SPISANIE_ INTEGER,'
      '110532260=  NEW_LINE_SALE_ INTEGER = 0,'
      '110532261=  MODE_ INTEGER = 0)'
      '110532262=RETURNS ('
      
        '110532263=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110532264=  ERR_CODE INTEGER,'
      '110532265=  ERR_MSG VARCHAR(1024))'
      '110532266=AS'
      
        '110532267=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39#39';'
      
        '110532268=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110532269=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      '110532270=DECLARE VARIABLE ZAKAZ_ INTEGER = 0;'
      
        '110532271=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110532272=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110532273=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110532274=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110532275=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110532276=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE;'
      
        '110532277=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110532278=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      '110532279=BEGIN'
      '110532280='
      '110532281=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110532282=    FROM ZAKAZ_DETAILS_TMP T'
      '110532283=   WHERE T.ZAKAZ IS NOT NULL'
      '110532284=    ROWS 1 TO 1'
      '110532285=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110532286='
      '110532287=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT'
      '110532288=           ,G.IS_KIT'
      '110532289=           ,K.AMOUNT * :AMOUNT_'
      '110532290=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110532291=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      
        '110532292=           ,(SELECT * FROM GET_LAST_SELF_PRICE(K.G_PRO' +
        'DUCT_ITEM, NULL, 1)) COST_PRICE'
      
        '110532293=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110532294=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110532295=       AND IS_KIT = 1'
      '110532296=    UNION'
      '110532297=    SELECT :G_PRODUCT_'
      '110532298=           ,G.IS_KIT'
      '110532299=           ,:AMOUNT_'
      '110532300=           ,:PRICE_'
      '110532301=           ,0'
      '110532302=           ,:COST_PRICE_'
      '110532303=      FROM G_PRODUCT G'
      '110532304=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110532305=       AND IS_KIT <> 1'
      '110532306=      INTO :G_PRODUCT_'
      '110532307=           ,:IS_KIT_'
      '110532308=           ,:AMOUNT_'
      '110532309=           ,:PRICE__'
      '110532310=           ,:SOSTAV_PRICE_'
      '110532311=           ,:COST_PRICE__'
      '110532312=  DO BEGIN'
      '110532313=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110532314=        IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110532315=          PRICE__ = COST_PRICE__;'
      '110532316='
      
        '110532317=        END ELSE IF (Discount_perc_ <> 0) THEN BEGIN  ' +
        '    -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110532318=          DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PERC_/1' +
        '00;'
      '110532319='
      '110532320='
      
        '110532321=        END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN BEG' +
        'IN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110532322=          DISCOUNT_PERC_ = PRICE_ * 100 / SOSTAV_PRICE' +
        '_;'
      '110532323=          DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_;'
      '110532324=        END'
      '110532325='
      '110532326=        DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT_;'
      '110532327=        SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOUNT_;'
      '110532328=        NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110532329=      END'
      '110532330='
      '110532331=      IF (NEW_LINE_SALE_ = 0) THEN'
      '110532332=          SELECT ZD.zakaz_details'
      '110532333=            FROM zakaz_details_tmp ZD'
      '110532334=           WHERE ZD.G_PRODUCT = :g_product_'
      '110532335=             AND ZD.PRICE = :PRICE__'
      '110532336=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110532337=            INTO :ZAKAZ_DTLS_TMP_;'
      '110532338='
      '110532339='
      '110532340=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110532341=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110532342=           SET P.amount = P.amount + :amount_'
      
        '110532343=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110532344=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110532345=               ,P.NDS = :NDS_'
      '110532346=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110532347=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110532348='
      '110532349=      ELSE BEGIN'
      '110532350=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110532351=          ('
      '110532352=           ZAKAZ_DETAILS,'
      '110532353=           ZAKAZ,'
      '110532354=           G_PRODUCT,'
      '110532355=           AMOUNT,'
      '110532356=           PRICE,'
      '110532357=           SUMM,'
      '110532358=           DISCOUNT_PERC,'
      '110532359=           DISCOUNT_TENGE,'
      '110532360=           DISCOUNT_SUMM,'
      '110532361=           NDS,'
      '110532362=           NDS_SUMM,'
      '110532363=           COST_PRICE'
      '110532364=          ) VALUES ('
      '110532365=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110532366=           :ZAKAZ_,'
      '110532367=           :G_PRODUCT_,'
      '110532368=           :AMOUNT_,'
      '110532369=           :PRICE__,'
      '110532370=           :SUMM_,'
      '110532371=           :DISCOUNT_PERC_,'
      '110532372=           :DISCOUNT_TENGE_,'
      '110532373=           :DISCOUNT_SUMM_,'
      '110532374=           :NDS_,'
      '110532375=           :NDS_SUMM_,'
      '110532376=           :COST_PRICE__'
      '110532377=          )'
      '110532378=          RETURNING'
      '110532379=            ZAKAZ_DETAILS'
      '110532380=          INTO'
      '110532381=            :ZAKAZ_DETAILS_;'
      '110532382=      END'
      '110532383='
      '110532384=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110532385=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110532386=        FROM LT_SKLAD_PRODUCT L'
      '110532387=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110532388=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110532389=       INTO :AMOUNT_CUR_;'
      '110532390='
      '110532391=      if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '110532392=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110532393=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110532394=              SELECT SUM(AMOUNT)'
      '110532395=                FROM ZAKAZ_DETAILS T'
      '110532396=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110532397=                 AND T.ZAKAZ = :ZAKAZ_'
      '110532398=                INTO :AMOUNT_OLD_;'
      '110532399=            ELSE'
      '110532400=              SELECT SUM(AMOUNT)'
      '110532401=                FROM SKLAD T'
      '110532402=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110532403=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '110532404=                INTO :AMOUNT_OLD_;'
      '110532405=          END'
      '110532406='
      '110532407=          SELECT SUM(AMOUNT)'
      '110532408=            FROM ZAKAZ_DETAILS_TMP T'
      '110532409=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110532410=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '110532411='
      
        '110532412=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKA' +
        'Z_, 0);'
      
        '110532413=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0)' +
        ';'
      '110532414='
      
        '110532415=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COA' +
        'LESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110532416=            SELECT NAME'
      '110532417=            FROM G_PRODUCT'
      '110532418=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110532419=            INTO :PRODUCT_NAME_;'
      '110532420='
      '110532421=            ERR_CODE = -20500;'
      
        '110532422=            ERR_MSG = '#39#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39#39'||PRODUCT' +
        '_NAME_||'#39#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39#39'||ASCII_CHAR(10)||'
      
        '110532423=                      '#39#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39#39';'
      
        '110532424=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110532425=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110532426=            EXIT;'
      '110532427=          END'
      '110532428=      END'
      '110532429=  END'
      '110532430=end'
      '110532431='#39';'
      '110532432='
      '110532433=EXECUTE STATEMENT '#39'ALTER PROCEDURE K_GET_KASSA('
      '110532434=  KASSA_ TYPE OF COLUMN KASSA.KASSA)'
      '110532435=RETURNS ('
      '110532436=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '110532437=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      
        '110532438=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASHO' +
        'D,'
      '110532439=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '110532440=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110532441=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '110532442=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '110532443=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '110532444=  HAVERIGHT_TO_CHANGE_OLD_ INTEGER,'
      '110532445=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110532446=  ERR_CODE INTEGER,'
      '110532447=  ERR_MSG VARCHAR(1024))'
      '110532448=AS'
      
        '110532449=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110532450=BEGIN'
      '110532451='
      
        '110532452=  select "ACTION", G_PRIHOD_RASHOD, SUMM, ACTION_DATE,' +
        ' NOTE, ZAKAZ, SKLAD, 1 PAYMENT_TYPE, G_OFFICIAL'
      '110532453=    from KASSA'
      '110532454=   WHERE KASSA = :KASSA_'
      '110532455=  UNION ALL'
      
        '110532456=  select "ACTION", G_PRIHOD_RASHOD, SUMM, ACTION_DATE,' +
        ' NOTE, ZAKAZ, SKLAD, 2 PAYMENT_TYPE, G_OFFICIAL'
      '110532457=    from KASSA_BEZNAL'
      '110532458=   WHERE KASSA_BEZNAL = :KASSA_'
      
        '110532459=    into :ACTION_, :G_PRIHOD_RASHOD_, :SUMM_, :ACTION_' +
        'DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_PAYMENT_TYPE_, :G_OFFICIAL_;'
      '110532460='
      '110532461=  HAVERIGHT_TO_CHANGE_OLD_ = 1;'
      '110532462=  IF (ACTION_DATE_ < CURRENT_DATE) THEN BEGIN'
      '110532463=    SELECT ID'
      '110532464=      FROM CUR_PARAMS'
      '110532465=     WHERE CUR_PARAMS = 1'
      '110532466=      INTO :G_OFFICIAL_CUR_;'
      '110532467='
      '110532468=    if (G_OFFICIAL_CUR_ IS NULL) then'
      '110532469=      HAVERIGHT_TO_CHANGE_OLD_ = 1;'
      '110532470=    else'
      
        '110532471=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 102) RETURNING_VALUES(:HAVERIGHT_TO_CHANGE_OLD_);'
      '110532472=  END'
      '110532473=end'
      '110532474='#39';'
      '110532475=END  --END_EXECUTE_BLOCK'
      '110532476=EXECUTE BLOCK AS BEGIN'
      '110532477='
      '110532478=EXECUTE STATEMENT '#39'ALTER PROCEDURE K_INS_KASSA('
      '110532479=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '110532480=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASHO' +
        'D,'
      '110532481=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '110532482=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110532483=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '110532484=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '110532485=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '110532486=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110532487=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110532488=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL)'
      '110532489=RETURNS ('
      '110532490=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '110532491=  ERR_CODE INTEGER,'
      '110532492=  ERR_MSG VARCHAR(1024))'
      '110532493=AS'
      '110532494=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '110532495=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110532496=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '110532497=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '110532498=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '110532499=begin'
      '110532500=  PROCNAME = '#39#39'K_INS_KASSA'#39#39';'
      '110532501='
      '110532502=  IF (G_TOCHKA_ IS NULL) THEN'
      '110532503=    SELECT ID'
      '110532504=      FROM CUR_PARAMS'
      '110532505=     WHERE CUR_PARAMS = 2'
      '110532506=      INTO :G_TOCHKA_;'
      '110532507='
      
        '110532508=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT' +
        '_TYPE_ = 1)) THEN BEGIN'
      
        '110532509=      insert into KASSA (KASSA, "ACTION", G_PRIHOD_RAS' +
        'HOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, G_OFFICIAL' +
        ')'
      
        '110532510=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIHO' +
        'D_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_T' +
        'OCHKA_, :G_OFFICIAL_)'
      '110532511=      returning KASSA'
      '110532512=      into :KASSA_;'
      '110532513='
      '110532514=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '110532515=      PNT_ = '#39#39'02'#39#39';'
      '110532516=      IF (:ACTION_ = 0) THEN'
      '110532517=        CREDIT_ = SUMM_;'
      '110532518=      ELSE'
      '110532519=        DEBET_ = SUMM_;'
      '110532520='
      '110532521=      UPDATE KASSA_STATE K'
      
        '110532522=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE' +
        '(:DEBET_, 0),'
      
        '110532523=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALES' +
        'CE(:CREDIT_, 0),'
      
        '110532524=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALES' +
        'CE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) ' +
        '+ COALESCE(:CREDIT_, 0))'
      '110532525=       WHERE K.K_DATE = :ACTION_DATE_'
      '110532526=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '110532527='
      '110532528=      IF (ROW_COUNT = 0) THEN BEGIN'
      '110532529=        PNT_ = '#39#39'03'#39#39';'
      '110532530=        BEGIN'
      '110532531=            SELECT K.OUTPUT'
      '110532532=              FROM KASSA_STATE K'
      '110532533=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '110532534=                                 FROM KASSA_STATE S'
      
        '110532535=                                WHERE S.K_DATE < :ACTI' +
        'ON_DATE_'
      
        '110532536=                                  AND S.G_TOCHKA = :G_' +
        'TOCHKA_)'
      '110532537=               AND K.G_TOCHKA = :G_TOCHKA_'
      '110532538=            INTO :INPUT_;'
      '110532539='
      '110532540=            if (ROW_COUNT = 0) then'
      
        '110532541=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055 +
        #1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '110532542=        WHEN ANY DO'
      '110532543=          BEGIN'
      '110532544=            Err_Code = -20500;'
      
        '110532545=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39 +
        #1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_M' +
        'SG);'
      
        '110532546=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532547=            EXIT;'
      '110532548=          END'
      '110532549=        END'
      '110532550='
      '110532551=        INSERT INTO KASSA_STATE'
      
        '110532552=          (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, ' +
        'OUTPUT, G_TOCHKA)'
      '110532553=        VALUES'
      
        '110532554=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, ' +
        'COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0' +
        '), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDI' +
        'T_,0), :G_TOCHKA_);'
      '110532555=      END'
      '110532556='
      '110532557=      PNT_ = '#39#39'04'#39#39';'
      
        '110532558=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_, ' +
        ':G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110532559=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532560=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110532561=        EXIT;'
      '110532562=      END'
      '110532563=  END'
      '110532564=  ELSE BEGIN'
      
        '110532565=      insert into KASSA_BEZNAL (KASSA_BEZNAL, "ACTION"' +
        ', G_PRIHOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCH' +
        'KA, G_OFFICIAL)'
      
        '110532566=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIHO' +
        'D_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_T' +
        'OCHKA_, :G_OFFICIAL_)'
      '110532567=      returning KASSA_BEZNAL'
      '110532568=      into :KASSA_;'
      '110532569='
      '110532570=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '110532571=      PNT_ = '#39#39'02A'#39#39';'
      '110532572=      IF (:ACTION_ = 0) THEN'
      '110532573=        CREDIT_ = SUMM_;'
      '110532574=      ELSE'
      '110532575=        DEBET_ = SUMM_;'
      '110532576='
      '110532577=      UPDATE KASSA_BEZNAL_STATE K'
      
        '110532578=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE' +
        '(:DEBET_, 0),'
      
        '110532579=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALES' +
        'CE(:CREDIT_, 0),'
      
        '110532580=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALES' +
        'CE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) ' +
        '+ COALESCE(:CREDIT_, 0))'
      '110532581=       WHERE K.K_DATE = :ACTION_DATE_;'
      '110532582='
      '110532583=      IF (ROW_COUNT = 0) THEN BEGIN'
      '110532584=        -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '110532585=        PNT_ = '#39#39'03A'#39#39';'
      '110532586=        BEGIN'
      '110532587=            SELECT K.OUTPUT'
      '110532588=              FROM KASSA_BEZNAL_STATE K'
      '110532589=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      
        '110532590=                                 FROM KASSA_BEZNAL_STA' +
        'TE S'
      
        '110532591=                                WHERE S.K_DATE < :ACTI' +
        'ON_DATE_)'
      '110532592=            INTO :INPUT_;'
      '110532593='
      '110532594=            if (ROW_COUNT = 0) then'
      
        '110532595=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055 +
        #1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '110532596=        WHEN ANY DO'
      '110532597=          BEGIN'
      '110532598=            Err_Code = -20500;'
      
        '110532599=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39 +
        #1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_M' +
        'SG);'
      
        '110532600=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532601=            EXIT;'
      '110532602=          END'
      '110532603=        END'
      '110532604='
      '110532605=        INSERT INTO KASSA_BEZNAL_STATE'
      
        '110532606=          (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, C' +
        'REDIT, OUTPUT)'
      '110532607=        VALUES'
      
        '110532608=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, ' +
        'COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0' +
        '), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDI' +
        'T_,0));'
      '110532609=      END'
      '110532610='
      '110532611=      PNT_ = '#39#39'04A'#39#39';'
      
        '110532612=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION_' +
        'DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110532613=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532614=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110532615=        EXIT;'
      '110532616=      END'
      '110532617=  END'
      '110532618=end'
      '110532619='#39';'
      '110532620='
      '110532621=EXECUTE STATEMENT '#39'ALTER PROCEDURE K_UPD_KASSA('
      '110532622=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '110532623=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '110532624=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASHO' +
        'D,'
      '110532625=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '110532626=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110532627=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '110532628=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '110532629=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '110532630=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110532631=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL)'
      '110532632=RETURNS ('
      '110532633=  ERR_CODE INTEGER,'
      '110532634=  ERR_MSG VARCHAR(1024))'
      '110532635=AS'
      
        '110532636=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'K_UPD_KASSA'#39 +
        #39';'
      '110532637=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110532638=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '110532639=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '110532640=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '110532641=DECLARE VARIABLE SUMM_OLD_ NUMERIC(15,2) = 0;'
      
        '110532642=DECLARE VARIABLE KASSA_NEW_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '110532643=DECLARE VARIABLE ACTION_DATE_OLD_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '110532644=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110532645=BEGIN'
      
        '110532646=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT' +
        '_TYPE_ = 1)) THEN BEGIN'
      '110532647=      PNT_ = '#39#39'01'#39#39';'
      '110532648=      SELECT L.ACTION_DATE,'
      '110532649=             L.SUMM,'
      '110532650=             L.G_TOCHKA'
      '110532651=        FROM KASSA L'
      '110532652=       WHERE L.KASSA = :KASSA_'
      '110532653=        INTO :ACTION_DATE_OLD_,'
      '110532654=             :SUMM_OLD_,'
      '110532655=             :G_TOCHKA_;'
      '110532656='
      
        '110532657=      IF ((SUMM_OLD_ <> SUMM_) or (ACTION_DATE_OLD_ <>' +
        ' ACTION_DATE_)) THEN BEGIN'
      
        '110532658=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_PA' +
        'YMENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110532659=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532660=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532661=            EXIT;'
      '110532662=          END'
      '110532663='
      '110532664=          PNT_ = '#39#39'02'#39#39';'
      '110532665=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '110532666=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110532667=                                        :SUMM_,'
      '110532668=                                        :ACTION_DATE_,'
      '110532669=                                        :NOTE_,'
      '110532670=                                        :ZAKAZ_,'
      '110532671=                                        :SKLAD_,'
      
        '110532672=                                        :G_PAYMENT_TYP' +
        'E_,'
      '110532673=                                        :G_TOCHKA_,'
      '110532674=                                        :G_OFFICIAL_'
      
        '110532675=                                        ) RETURNING_VA' +
        'LUES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '110532676=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532677=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532678=            EXIT;'
      '110532679=          END'
      '110532680='
      '110532681=          UPDATE KASSA SS'
      '110532682=             SET SS.KASSA = :KASSA_'
      '110532683=           WHERE SS.KASSA = :KASSA_NEW_;'
      '110532684='
      
        '110532685=          EXECUTE procedure K_RECALC_KASSA(:ACTION_DAT' +
        'E_, :G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110532686=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532687=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532688=            EXIT;'
      '110532689=          END'
      '110532690=      END'
      '110532691=      UPDATE KASSA'
      '110532692=         SET ACTION = :ACTION_,'
      '110532693=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '110532694=             SUMM = :SUMM_,'
      '110532695=             ACTION_DATE = :ACTION_DATE_,'
      '110532696=             NOTE = :NOTE_'
      '110532697=      WHERE KASSA = :KASSA_;'
      '110532698=  END'
      '110532699=  ELSE BEGIN'
      '110532700=      PNT_ = '#39#39'01A'#39#39';'
      '110532701=      SELECT L.ACTION_DATE,'
      '110532702=             L.SUMM,'
      '110532703=             L.G_TOCHKA'
      '110532704=        FROM KASSA_BEZNAL L'
      '110532705=       WHERE L.KASSA_BEZNAL = :KASSA_'
      '110532706=        INTO :ACTION_DATE_OLD_,'
      '110532707=             :SUMM_OLD_,'
      '110532708=             :G_TOCHKA_;'
      '110532709='
      
        '110532710=      IF ((SUMM_OLD_ <> SUMM_) or (ACTION_DATE_OLD_ <>' +
        ' ACTION_DATE_)) THEN BEGIN'
      
        '110532711=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_PA' +
        'YMENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110532712=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532713=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532714=            EXIT;'
      '110532715=          END'
      '110532716='
      '110532717=          PNT_ = '#39#39'02A'#39#39';'
      '110532718=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '110532719=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110532720=                                        :SUMM_,'
      '110532721=                                        :ACTION_DATE_,'
      '110532722=                                        :NOTE_,'
      '110532723=                                        :ZAKAZ_,'
      '110532724=                                        :SKLAD_,'
      
        '110532725=                                        :G_PAYMENT_TYP' +
        'E_,'
      '110532726=                                        :G_TOCHKA_,'
      
        '110532727=                                        :G_OFFICIAL_) ' +
        'RETURNING_VALUES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '110532728=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532729=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532730=            EXIT;'
      '110532731=          END'
      '110532732=          UPDATE KASSA_BEZNAL SS'
      '110532733=             SET SS.KASSA_BEZNAL = :KASSA_'
      '110532734=           WHERE SS.KASSA_BEZNAL = :KASSA_NEW_;'
      '110532735='
      
        '110532736=          EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACT' +
        'ION_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110532737=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110532738=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110532739=            EXIT;'
      '110532740=          END'
      '110532741=      END'
      '110532742=      UPDATE KASSA_BEZNAL'
      '110532743=         SET ACTION = :ACTION_,'
      '110532744=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '110532745=             SUMM = :SUMM_,'
      '110532746=             ACTION_DATE = :ACTION_DATE_,'
      '110532747=             NOTE = :NOTE_'
      '110532748=      WHERE KASSA_BEZNAL = :KASSA_;'
      '110532749=  END'
      '110532750=end'
      '110532751='#39';'
      '110532752='
      
        '110532753=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_OFFICIAL_SALA' +
        'RY('
      '110532754=  DATE_BEGIN_ DATE,'
      '110532755=  DATE_END_ DATE,'
      '110532756=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110532757=  MODE_ INTEGER)'
      '110532758=RETURNS ('
      '110532759=  ROW_SORT INTEGER,'
      '110532760=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110532761=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110532762=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110532763=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '110532764=  SALES_COMM TYPE OF COLUMN ZAKAZ_DETAILS.SALES_COMM,'
      '110532765=  SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM,'
      
        '110532766=  SALES_COMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAILS.SALES_C' +
        'OMM,'
      '110532767=  ERR_CODE INTEGER,'
      '110532768=  ERR_MSG VARCHAR(1024))'
      '110532769=AS'
      '110532770=/*'
      '110532771=MODE_: 0 - '#1044#1045#1058#1040#1051#1068#1053#1054', 1 - '#1055#1054' '#1043#1056#1059#1055#1055#1040#1052' '#1058#1054#1042#1040#1056#1054#1042
      '110532772=*/'
      
        '110532773=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_OFFICI' +
        'AL_SALARY'#39#39';'
      '110532774=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110532775=BEGIN'
      '110532776='
      '110532777=  SUMM_ALL_ = 0;'
      '110532778=  SALES_COMM_ALL_ = 0;'
      '110532779='
      '110532780=  IF (MODE_ = 1) THEN BEGIN'
      
        '110532781=    DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_' +
        'TABLE = P_REP_PROFIT_TABLE;'
      '110532782=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110532783=  END'
      '110532784='
      '110532785=  FOR SELECT   1 ROW_SORT,'
      '110532786=               Z.Z_DATE,'
      '110532787=               G.NAME,'
      '110532788=               ZD.AMOUNT,'
      '110532789=               ZD.SUMM,'
      '110532790=               ZD.SALES_COMM'
      '110532791=          FROM ZAKAZ Z,'
      '110532792=               ZAKAZ_DETAILS ZD,'
      '110532793=               G_PRODUCT G'
      
        '110532794=         WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110532795=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110532796=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110532797=           AND ZD.SALES_COMM > 0'
      '110532798=           AND Z.G_OFFICIAL = :G_OFFICIAL_'
      '110532799=           AND :MODE_ = 0'
      '110532800=        UNION ALL'
      '110532801=        SELECT 2 ROW_SORT,'
      '110532802=               Z.Z_DATE,'
      '110532803=               TR.PATH,'
      '110532804=               SUM(ZD.AMOUNT),'
      '110532805=               SUM(ZD.SUMM),'
      '110532806=               SUM(ZD.SALES_COMM)'
      '110532807=          FROM ZAKAZ Z,'
      '110532808=               ZAKAZ_DETAILS ZD,'
      '110532809=               G_PRODUCT G,'
      '110532810=               P_REP_TREE TR'
      
        '110532811=         WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110532812=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110532813=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110532814=           AND ZD.SALES_COMM > 0'
      '110532815=           AND Z.G_OFFICIAL = :G_OFFICIAL_'
      '110532816=           AND G.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110532817=           AND :MODE_ = 1'
      '110532818=          GROUP BY Z.Z_DATE, TR.PATH'
      '110532819=        UNION ALL'
      '110532820=        SELECT 3 ROW_SORT,'
      '110532821=               K.ACTION_DATE Z_DATE,'
      '110532822=               '#39#39#1042#1099#1087#1083#1072#1090#1072' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1091#39#39','
      '110532823=               NULL AMOUNT,'
      '110532824=               NULL SUMM,'
      '110532825=               K.SUMM SALES_COMM'
      '110532826=          FROM KASSA K'
      
        '110532827=         WHERE K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110532828=           AND K.G_PRIHOD_RASHOD = -1'
      '110532829=           AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110532830=        ORDER BY 1, 2'
      '110532831=       INTO :ROW_SORT,'
      '110532832=            :Z_DATE,'
      '110532833=            :NAME,'
      '110532834=            :AMOUNT,'
      '110532835=            :SUMM,'
      '110532836=            :SALES_COMM'
      '110532837=  DO BEGIN'
      '110532838=    IF (ROW_SORT <> 3) THEN'
      '110532839=      SUMM_ALL_ = SUMM_ALL_ + SALES_COMM;'
      '110532840=    ELSE'
      '110532841=      SALES_COMM_ALL_ = SALES_COMM_ALL_ + SALES_COMM;'
      '110532842='
      '110532843=    SUSPEND;'
      '110532844=  END'
      '110532845=WHEN ANY DO BEGIN'
      '110532846=    Err_code = -20500;'
      
        '110532847=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'!'#39#39') RETURNING_VALUES (:ERR_MS' +
        'G);'
      
        '110532848=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110532849=  END'
      '110532850=end'
      '110532851='#39';'
      '110532852='
      '110532853=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT('
      '110532854=  DATE_BEGIN_ DATE,'
      '110532855=  DATE_END_ DATE,'
      '110532856=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110532857=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110532858=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110532859=RETURNS ('
      '110532860=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110532861=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110532862=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
      '110532863=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110532864=  SUMM_ALL_ NUMERIC(15,2),'
      '110532865=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110532866=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110532867=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110532868=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110532869=  PROFIT_ALL_ NUMERIC(15,2),'
      '110532870=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110532871=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      '110532872=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '110532873=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '110532874=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '110532875=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '110532876=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT' +
        '_NAME,'
      
        '110532877=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_P' +
        'AYMENT_TYPE,'
      
        '110532878=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYME' +
        'NT_NAME,'
      
        '110532879=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANI' +
        'E,'
      
        '110532880=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUC' +
        'T,'
      
        '110532881=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PR' +
        'ODUCT_PAR,'
      
        '110532882=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110532883=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110532884=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110532885=  AMOUNT MY_NUMERIC_5,'
      '110532886=  PRICE NUMERIC(15,2),'
      '110532887=  SUMM NUMERIC(15,2),'
      '110532888=  DISCOUNT_PERC NUMERIC(15,2),'
      '110532889=  DISCOUNT_SUMM NUMERIC(15,2),'
      '110532890=  NDS NUMERIC(15,2),'
      '110532891=  NDS_SUMM NUMERIC(15,2),'
      '110532892=  PRICE_SELF NUMERIC(15,2),'
      '110532893=  SUM_SELF NUMERIC(15,2),'
      '110532894=  PROFIT NUMERIC(15,2),'
      '110532895=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110532896=  ERR_CODE INTEGER,'
      '110532897=  ERR_MSG VARCHAR(1024))'
      '110532898=AS'
      
        '110532899=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT' +
        #39#39';'
      '110532900=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110532901=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110532902=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110532903=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110532904=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110532905=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110532906=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '110532907=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '110532908=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '110532909=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '110532910=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110532911=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110532912=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110532913=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110532914=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110532915=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110532916=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110532917=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110532918=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110532919=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110532920=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110532921=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110532922=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110532923=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110532924=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110532925=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110532926=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110532927=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110532928=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110532929=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110532930=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110532931=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110532932=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110532933=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110532934=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110532935=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110532936=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110532937=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110532938=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110532939=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110532940=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110532941=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110532942=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110532943=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      '110532944=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0;'
      '110532945=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;'
      '110532946=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110532947=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      '110532948=BEGIN'
      
        '110532949=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110532950=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110532951='
      '110532952=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110532953=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110532954=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110532955='
      '110532956=  FOR SELECT GP.PATH,'
      '110532957=             GP.G_PRODUCT'
      '110532958=       FROM P_REP_TREE GP'
      '110532959=      WHERE EXISTS (SELECT 1'
      
        '110532960=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110532961=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '110532962=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110532963=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110532964=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110532965=                       AND Z.IS_SPISANIE = 0'
      '110532966=                       AND Z.is_reserve = 0'
      
        '110532967=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110532968=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110532969=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110532970=                       )'
      '110532971=      ORDER BY 1, 2'
      '110532972=  INTO :RECCAT_NAME_,'
      '110532973=       :RECCAT_PRODUCT_'
      '110532974=  DO BEGIN'
      '110532975=    insert into p_rep_profit_table'
      '110532976=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110532977=    values'
      
        '110532978=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110532979='
      '110532980=    FOR SELECT Z.ZAKAZ,'
      '110532981=               Z.G_TOCHKA,'
      '110532982=               Z.Z_DATE,'
      '110532983=               Z.G_CLIENT,'
      '110532984=               C.NAME CLIENT_NAME,'
      '110532985=               Z.G_PAYMENT_TYPE,'
      '110532986=               P.NAME PAYMENT_NAME,'
      '110532987=               Z.OSNOVANIE,'
      '110532988=               G.G_PRODUCT,'
      '110532989=               G.G_PRODUCT_PAR,'
      '110532990=               G.NAME TOVAR_NAME,'
      '110532991=               ZD.AMOUNT,'
      '110532992=               ZD.PRICE,'
      '110532993=               ZD.SUMM,'
      '110532994=               ZD.DISCOUNT_PERC,'
      '110532995=               ZD.DISCOUNT_SUMM,'
      '110532996=               ZD.NDS,'
      '110532997=               ZD.NDS_SUMM,'
      '110532998=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110532999=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110533000=               ZAKAZ_DETAILS ZD,'
      '110533001=               G_PRODUCT G,'
      '110533002=               G_PAYMENT_TYPE P'
      
        '110533003=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TO' +
        'CHKA||'#39#39'-'#39#39
      '110533004=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110533005=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110533006=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110533007=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_'
      '110533008=           AND Z.IS_SPISANIE = 0'
      '110533009=           AND Z.IS_RESERVE = 0'
      
        '110533010=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110533011=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110533012=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110533013=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110533014=    INTO :REC_ZAKAZ_,'
      '110533015=        :REC_G_TOCHKA_,'
      '110533016=        :REC_Z_DATE_,'
      '110533017=        :REC_G_CLIENT_,'
      '110533018=        :REC_CLIENT_NAME_,'
      '110533019=        :REC_G_PAYMENT_TYPE_,'
      '110533020=        :REC_PAYMENT_NAME_,'
      '110533021=        :REC_OSNOVANIE_,'
      '110533022=        :REC_G_PRODUCT_,'
      '110533023=        :REC_G_PRODUCT_PAR_,'
      '110533024=        :REC_TOVAR_NAME_,'
      '110533025=        :REC_AMOUNT_,'
      '110533026=        :REC_PRICE_,'
      '110533027=        :REC_SUMM_,'
      '110533028=        :REC_DISCOUNT_PERC_,'
      '110533029=        :REC_DISCOUNT_SUMM_,'
      '110533030=        :REC_NDS_,'
      '110533031=        :REC_NDS_SUMM_,'
      '110533032=        :REC_PRICE_SELF_'
      '110533033=    DO BEGIN'
      '110533034=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110533035=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110533036='
      '110533037=      insert into p_rep_profit_table'
      
        '110533038=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110533039=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110533040=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110533041=      values'
      '110533042=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110533043=        :REC_ZAKAZ_,'
      '110533044=        :REC_g_tochka_,'
      
        '110533045=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110533046=         :REC_osnovanie_,'
      '110533047=         :REC_g_product_,'
      '110533048=         :REC_g_product_par_,'
      '110533049=         :REC_tovar_name_,'
      '110533050=         :REC_amount_,'
      '110533051=         :REC_price_,'
      '110533052=         :REC_summ_,'
      '110533053=         :REC_discount_perc_,'
      '110533054=         :REC_discount_summ_,'
      
        '110533055=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110533056='
      
        '110533057=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110533058=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110533059=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110533060=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110533061=    END'
      '110533062='
      '110533063=    insert into p_rep_profit_table'
      
        '110533064=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110533065=    values'
      
        '110533066=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :' +
        'SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110533067='
      '110533068=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110533069=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110533070=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110533071=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110533072='
      '110533073=    SUM_ZAKAZ_ = 0;'
      '110533074=    SUM_COST_  = 0;'
      '110533075=    NDS_SUMM_  = 0;'
      '110533076=    PROFIT_    = 0;'
      '110533077=  END'
      '110533078='
      
        '110533079=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110533080=      insert into p_rep_profit_table'
      
        '110533081=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110533082=      values'
      
        '110533083=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :P' +
        'ROFIT_ALL_, 3);'
      '110533084='
      '110533085=  SELECT COUNT(*)'
      
        '110533086=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110533087=          UNION ALL'
      
        '110533088=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110533089=         G_PRIHOD_RASHOD G'
      
        '110533090=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||' +
        #39#39'-'#39#39
      '110533091=    AND K.ACTION = 1'
      
        '110533092=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110533093=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110533094=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '110533095=  INTO :CNT_;'
      '110533096='
      '110533097=  IF (CNT_ > 0) THEN BEGIN'
      '110533098=    SUM_COST_  = 0;'
      '110533099=    PROFIT_    = 0;'
      '110533100=    INSERT INTO P_REP_PROFIT_TABLE'
      '110533101=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110533102=    VALUES'
      
        '110533103=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39#39',' +
        ' 1);'
      '110533104='
      '110533105=    FOR SELECT K.ACTION_DATE,'
      '110533106=               K.SUMM,'
      
        '110533107=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, '#39 +
        #39' ('#39#39'||K.NOTE||'#39#39')'#39#39', '#39#39#39#39')'
      
        '110533108=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '110533109=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||' +
        'G_TOCHKA||'#39#39'-'#39#39
      '110533110=              UNION ALL'
      
        '110533111=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, ' +
        'SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM kas' +
        'sa_beznal'
      
        '110533112=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||' +
        'G_TOCHKA||'#39#39'-'#39#39') k,'
      '110533113=              G_PRIHOD_RASHOD G'
      '110533114=        WHERE K.ACTION = 1'
      
        '110533115=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110533116=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110533117=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '110533118=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110533119=    INTO :ACTION_DATE_,'
      '110533120=         :SUMM_,'
      '110533121=         :ACTION_NAME_'
      '110533122=    DO BEGIN'
      '110533123=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110533124=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110533125=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110533126=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110533127=        VALUES'
      
        '110533128=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, 0,'
      
        '110533129=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALES' +
        'CE(:SUMM_, 0), 0);'
      '110533130='
      '110533131=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110533132=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110533133=    END'
      '110533134='
      '110533135=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110533136=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110533137=    insert into p_rep_profit_table'
      
        '110533138=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110533139=    values'
      
        '110533140=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110533141=  END'
      '110533142=  SELECT COUNT(*)'
      
        '110533143=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110533144=          UNION ALL'
      
        '110533145=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110533146=         G_PRIHOD_RASHOD G'
      
        '110533147=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||' +
        #39#39'-'#39#39
      '110533148=    AND K.ACTION = 0'
      
        '110533149=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110533150=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110533151=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '110533152=  INTO :CNT_;'
      '110533153='
      '110533154=  IF (CNT_ > 0) THEN BEGIN'
      '110533155=    PRIHOD_ALL_  = 0;'
      '110533156=    PRIHOD_ALL_NAL_  = 0;'
      '110533157=    PRIHOD_ALL_BEZNAL_  = 0;'
      '110533158=    PROFIT_     = 0;'
      '110533159='
      '110533160=    INSERT INTO P_REP_PROFIT_TABLE'
      '110533161=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110533162=    VALUES'
      
        '110533163=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39#39',' +
        ' 1);'
      '110533164='
      '110533165=    FOR SELECT K.ACTION_DATE,'
      '110533166=               K.NAL,'
      '110533167=               K.BEZNAL,'
      '110533168=               G.NAME'
      
        '110533169=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 ' +
        'BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110533170=               UNION ALL'
      
        '110533171=               SELECT kassa_BEZNAL KASSA, ACTION_DATE,' +
        ' 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kass' +
        'a_beznal) K,'
      '110533172=              G_PRIHOD_RASHOD G'
      
        '110533173=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOC' +
        'HKA||'#39#39'-'#39#39
      '110533174=          AND K.ACTION = 0'
      
        '110533175=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110533176=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110533177=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '110533178=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110533179=    INTO :ACTION_DATE_,'
      '110533180=         :SUMM_NAL_,'
      '110533181=         :SUMM_BEZNAL_,'
      '110533182=         :ACTION_NAME_'
      '110533183=    DO BEGIN'
      '110533184=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110533185=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110533186=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110533187=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110533188=        VALUES'
      
        '110533189=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '110533190=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '110533191='
      '110533192=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110533193=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM' +
        '_BEZNAL_;'
      
        '110533194=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_B' +
        'EZNAL_;'
      
        '110533195=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZ' +
        'NAL_;'
      '110533196=    END'
      '110533197='
      '110533198=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110533199=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110533200=    insert into p_rep_profit_table'
      
        '110533201=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110533202=    values'
      
        '110533203=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110533204=  END'
      '110533205='
      '110533206=  SELECT COUNT(*)'
      '110533207=    FROM ZAKAZ Z'
      
        '110533208=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      '110533209=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110533210=     AND Z.IS_SPISANIE = 1'
      
        '110533211=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110533212=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110533213=  INTO :CNT_;'
      '110533214='
      '110533215=  IF (CNT_ > 0) THEN BEGIN'
      '110533216=      SUM_ZAKAZ_ = 0;'
      '110533217=      SUM_COST_  = 0;'
      '110533218=      PROFIT_    = 0;'
      '110533219='
      '110533220=      insert into p_rep_profit_table'
      '110533221=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110533222=      values'
      
        '110533223=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39#39', 1);'
      '110533224='
      '110533225=      FOR SELECT Z.ZAKAZ,'
      '110533226=                 Z.G_TOCHKA,'
      '110533227=                 Z.Z_DATE,'
      '110533228=                 Z.G_CLIENT,'
      '110533229=                 '#39#39#39#39' CLIENT_NAME,'
      '110533230=                 Z.G_PAYMENT_TYPE,'
      '110533231=                 '#39#39#39#39' PAYMENT_NAME,'
      '110533232=                 Z.OSNOVANIE,'
      '110533233=                 G.G_PRODUCT,'
      '110533234=                 G.G_PRODUCT_PAR,'
      '110533235=                 G.NAME TOVAR_NAME,'
      '110533236=                 ZD.AMOUNT,'
      '110533237=                 ZD.PRICE,'
      '110533238=                 ZD.SUMM,'
      '110533239=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '110533240=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '110533241=                 0 NDS, --ZD.NDS,'
      '110533242=                 0 NDS_SUMM'
      
        '110533243=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT ' +
        'G'
      
        '110533244=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_' +
        'TOCHKA||'#39#39'-'#39#39
      '110533245=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110533246=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110533247=             AND Z.IS_SPISANIE = 1                    ' +
        '-- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '110533248=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110533249=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '110533250=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G' +
        '_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059 +
        #1057#1058#1067#1052
      
        '110533251=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALE' +
        'SCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110533252=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS'
      '110533253=      INTO :REC_ZAKAZ_,'
      '110533254=            :REC_G_TOCHKA_,'
      '110533255=            :REC_Z_DATE_,'
      '110533256=            :REC_G_CLIENT_,'
      '110533257=            :REC_CLIENT_NAME_,'
      '110533258=            :REC_G_PAYMENT_TYPE_,'
      '110533259=            :REC_PAYMENT_NAME_,'
      '110533260=            :REC_OSNOVANIE_,'
      '110533261=            :REC_G_PRODUCT_,'
      '110533262=            :REC_G_PRODUCT_PAR_,'
      '110533263=            :REC_TOVAR_NAME_,'
      '110533264=            :REC_AMOUNT_,'
      '110533265=            :REC_PRICE_,'
      '110533266=            :REC_SUMM_,'
      '110533267=            :REC_DISCOUNT_PERC_,'
      '110533268=            :REC_DISCOUNT_SUMM_,'
      '110533269=            :REC_NDS_,'
      '110533270=            :REC_NDS_SUMM_'
      '110533271=      DO BEGIN'
      '110533272=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '110533273=        REC_profit_   = -REC_SUMM_;'
      '110533274='
      '110533275=        insert into p_rep_profit_table'
      
        '110533276=          (p_rep_profit_table, zakaz, g_tochka, z_date' +
        ', g_client, client_name, g_payment_type, payment_name,'
      
        '110533277=           osnovanie, g_product, g_product_par, tovar_' +
        'name, amount, price, summ, discount_perc, discount_summ,'
      
        '110533278=           nds, nds_summ, price_self, sum_self, profit' +
        ', is_head)'
      '110533279=        values'
      
        '110533280=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAK' +
        'AZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '110533281=         :REC_osnovanie_, :REC_g_product_, :REC_g_prod' +
        'uct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_pe' +
        'rc_, :REC_discount_summ_,'
      
        '110533282=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_' +
        'SUM_COST_, :REC_profit_, 0);'
      '110533283='
      
        '110533284=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST' +
        '_, 0);'
      
        '110533285=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, ' +
        '0);'
      '110533286=      END'
      '110533287='
      '110533288=      insert into p_rep_profit_table'
      
        '110533289=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110533290=      values'
      
        '110533291=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39',' +
        ' 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110533292='
      '110533293=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110533294=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110533295=  END'
      '110533296=  SELECT COUNT(*)'
      '110533297=    FROM SKLAD S'
      
        '110533298=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      
        '110533299=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110533300=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110533301=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110533302=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110533303=  INTO :CNT_;'
      '110533304='
      '110533305=  IF (CNT_ > 0) THEN BEGIN'
      '110533306=    SUM_ZAKAZ_ = 0;'
      '110533307=    PROFIT_    = 0;'
      '110533308=    SUM_COST_  = 0;'
      '110533309='
      '110533310=    insert into p_rep_profit_table'
      '110533311=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110533312=    values'
      
        '110533313=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054 +
        #1042#1040#1056#1040#39#39', 1);'
      '110533314='
      '110533315=    FOR SELECT S.DATE_RECEIPT,'
      '110533316=               S.G_PRODUCT,'
      '110533317=               G.NAME TOVAR_NAME,'
      '110533318=               S.AMOUNT,'
      '110533319=               S.PRICE,'
      '110533320=               S.SUMM,'
      '110533321=               SP.G_TOCHKA'
      '110533322=         FROM SKLAD_PARENT SP,'
      '110533323=              SKLAD S,'
      '110533324=              G_PRODUCT G'
      
        '110533325=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TO' +
        'CHKA||'#39#39'-'#39#39
      
        '110533326=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110533327=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110533328=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110533329=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110533330=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110533331=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110533332=        ORDER BY 1'
      '110533333=    INTO :V_DATE_RECEIPT_,'
      '110533334=         :V_G_PRODUCT_,'
      '110533335=         :V_TOVAR_NAME_,'
      '110533336=         :V_AMOUNT_,'
      '110533337=         :V_PRICE_,'
      '110533338=         :V_SUMM_,'
      '110533339=         :REC_G_TOCHKA_'
      '110533340=    DO BEGIN'
      '110533341=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;'
      '110533342='
      '110533343='
      '110533344=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110533345=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110533346=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110533347=         NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT, ' +
        'IS_HEAD)'
      '110533348=      VALUES'
      
        '110533349=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, 0 /*:REC_PRIC' +
        'E_SELF_*/, 0/*:REC_SUM_COST_*/,'
      
        '110533350=         0, 0, 0, 0, :V_PRICE_, :V_SUMM_, :REC_profit_' +
        ', 0);'
      '110533351='
      '110533352=      SUM_COST_ = 0;'
      '110533353=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '110533354=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110533355=    END'
      '110533356='
      '110533357='
      '110533358=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_COST_;'
      '110533359=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '110533360=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110533361='
      '110533362=    insert into p_rep_profit_table'
      
        '110533363=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110533364=    values'
      
        '110533365=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :' +
        'SUM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '110533366=  END'
      '110533367='
      '110533368=  SELECT COUNT(*)'
      '110533369=    FROM ZAKAZ S'
      
        '110533370=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      '110533371=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110533372=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))'
      
        '110533373=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110533374=     AND S.IS_SPISANIE = 2'
      '110533375=  INTO :CNT_;'
      '110533376='
      '110533377=  IF (CNT_ > 0) THEN BEGIN'
      '110533378=      insert into p_rep_profit_table'
      '110533379=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110533380=      values'
      
        '110533381=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '110533382='
      '110533383=      SUM_ZAKAZ_ = 0;'
      '110533384=      SUM_COST_  = 0;'
      '110533385=      NDS_SUMM_  = 0;'
      '110533386=      PROFIT_    = 0;'
      '110533387=      FOR SELECT GP.NAME,'
      '110533388=                 GP.G_PRODUCT'
      '110533389=           FROM G_PRODUCT GP'
      '110533390=          WHERE IS_CATEGORY = 1'
      '110533391=            AND EXISTS (SELECT 1'
      
        '110533392=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110533393=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '110533394=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110533395=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110533396=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110533397=                           AND Z.IS_SPISANIE = 2'
      '110533398=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110533399=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110533400=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058 +
        ' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110533401=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110533402=                           )'
      '110533403=          ORDER BY 1'
      '110533404=      INTO :RECCAT_NAME_,'
      '110533405=           :RECCAT_PRODUCT_'
      '110533406=      DO BEGIN'
      '110533407=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110533408=        insert into p_rep_profit_table'
      '110533409=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110533410=        values'
      
        '110533411=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110533412='
      '110533413=        FOR SELECT Z.ZAKAZ,'
      '110533414=                   Z.G_TOCHKA,'
      '110533415=                   Z.Z_DATE,'
      '110533416=                   Z.G_CLIENT,'
      '110533417=                   C.NAME CLIENT_NAME,'
      '110533418=                   Z.G_PAYMENT_TYPE,'
      '110533419=                   P.NAME PAYMENT_NAME,'
      '110533420=                   Z.OSNOVANIE,'
      '110533421=                   G.G_PRODUCT,'
      '110533422=                   G.G_PRODUCT_PAR,'
      '110533423=                   G.NAME TOVAR_NAME,'
      '110533424=                   ZD.AMOUNT,'
      '110533425=                   ZD.PRICE,'
      '110533426=                   ZD.SUMM,'
      '110533427=                   ZD.DISCOUNT_PERC,'
      '110533428=                   ZD.DISCOUNT_SUMM,'
      '110533429=                   ZD.NDS,'
      '110533430=                   ZD.NDS_SUMM,'
      '110533431=                   ZD.COST_PRICE'
      
        '110533432=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110533433=                   ZAKAZ_DETAILS ZD,'
      '110533434=                   G_PRODUCT G,'
      '110533435=                   G_PAYMENT_TYPE P'
      
        '110533436=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.' +
        'G_TOCHKA||'#39#39'-'#39#39
      '110533437=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110533438=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110533439=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110533440=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_'
      '110533441=               AND Z.IS_SPISANIE = 2'
      
        '110533442=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110533443=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110533444=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110533445=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110533446=        INTO :REC_ZAKAZ_,'
      '110533447=            :REC_G_TOCHKA_,'
      '110533448=            :REC_Z_DATE_,'
      '110533449=            :REC_G_CLIENT_,'
      '110533450=            :REC_CLIENT_NAME_,'
      '110533451=            :REC_G_PAYMENT_TYPE_,'
      '110533452=            :REC_PAYMENT_NAME_,'
      '110533453=            :REC_OSNOVANIE_,'
      '110533454=            :REC_G_PRODUCT_,'
      '110533455=            :REC_G_PRODUCT_PAR_,'
      '110533456=            :REC_TOVAR_NAME_,'
      '110533457=            :REC_AMOUNT_,'
      '110533458=            :REC_PRICE_,'
      '110533459=            :REC_SUMM_,'
      '110533460=            :REC_DISCOUNT_PERC_,'
      '110533461=            :REC_DISCOUNT_SUMM_,'
      '110533462=            :REC_NDS_,'
      '110533463=            :REC_NDS_SUMM_,'
      '110533464=            :REC_PRICE_SELF_'
      '110533465=        DO BEGIN'
      
        '110533466=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF' +
        '_;'
      
        '110533467=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - ' +
        'REC_NDS_SUMM_;'
      '110533468='
      '110533469=          insert into p_rep_profit_table'
      
        '110533470=            (p_rep_profit_table, zakaz, g_tochka, z_da' +
        'te, g_client, client_name, g_payment_type, payment_name,'
      
        '110533471=             osnovanie, g_product, g_product_par, tova' +
        'r_name, amount, price, summ, discount_perc, discount_summ,'
      
        '110533472=             nds, nds_summ, price_self, sum_self, prof' +
        'it, is_head)'
      '110533473=          values'
      '110533474=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110533475=            :REC_ZAKAZ_,'
      '110533476=            :REC_g_tochka_,'
      
        '110533477=            :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      '110533478=             :REC_osnovanie_,'
      '110533479=             :REC_g_product_,'
      '110533480=             :REC_g_product_par_,'
      '110533481=             :REC_tovar_name_,'
      '110533482=             :REC_amount_,'
      '110533483=             :REC_price_,'
      '110533484=             :REC_summ_,'
      '110533485=             :REC_discount_perc_,'
      '110533486=             :REC_discount_summ_,'
      
        '110533487=             :REC_nds_, :REC_nds_summ_, :REC_price_sel' +
        'f_, :REC_SUM_COST_, :REC_profit_, 0);'
      '110533488='
      
        '110533489=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_' +
        ', 0);'
      
        '110533490=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_CO' +
        'ST_, 0);'
      
        '110533491=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SU' +
        'MM_, 0);'
      
        '110533492=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_,' +
        ' 0);'
      '110533493=        END'
      '110533494='
      '110533495=        insert into p_rep_profit_table'
      
        '110533496=          (p_rep_profit_table, tovar_name, summ, sum_s' +
        'elf, NDS_SUMM, profit, is_head)'
      '110533497=        values'
      
        '110533498=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39 +
        #39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110533499='
      
        '110533500=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_' +
        ';'
      '110533501=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '110533502=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '110533503=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '110533504='
      '110533505=        SUM_ZAKAZ_ = 0;'
      '110533506=        SUM_COST_  = 0;'
      '110533507=        NDS_SUMM_  = 0;'
      '110533508=        PROFIT_    = 0;'
      '110533509=      END'
      '110533510='
      '110533511=      insert into p_rep_profit_table'
      
        '110533512=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110533513=      values'
      
        '110533514=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_S' +
        'UMM_REAL_, :PROFIT_REAL_, 2);'
      '110533515='
      
        '110533516=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL' +
        '_;'
      
        '110533517=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL' +
        '_;'
      '110533518=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '110533519=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '110533520=  END'
      '110533521='
      '110533522=  insert into p_rep_profit_table'
      '110533523=    (p_rep_profit_table, is_head)'
      '110533524=  values'
      '110533525=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110533526='
      '110533527=  insert into p_rep_profit_table'
      
        '110533528=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110533529=  values'
      
        '110533530=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFI' +
        'T_ALL_, 1);'
      '110533531='
      '110533532=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110533533=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110533534=         SUM(Z.SUMM_BONUS)'
      '110533535=    FROM ZAKAZ Z'
      
        '110533536=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      '110533537=     AND Z.IS_SPISANIE not in (1, 4)'
      '110533538=     AND Z.IS_RESERVE = 0'
      '110533539=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110533540=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110533541=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110533542=    INTO :SUMM_CASH_ALL_,'
      '110533543=         :SUMM_NONCASH_ALL_,'
      '110533544=         :SUMM_BONUS_ALL_;'
      '110533545='
      '110533546=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '110533547=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '110533548=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110533549='
      '110533550=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110533551='
      
        '110533552=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '110533553=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110533554='
      '110533555=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110533556=    SELECT G.NAME'
      '110533557=      FROM G_CLIENT G'
      '110533558=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110533559=    INTO :CLIENT_NAME_;'
      '110533560=  ELSE'
      '110533561=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110533562='
      '110533563=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110533564=    SELECT G.NAME'
      '110533565=      FROM G_PAYMENT_TYPE G'
      '110533566=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110533567=    INTO :PAYMENT_NAME_;'
      '110533568=  ELSE'
      '110533569=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110533570='
      '110533571=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110533572=        P.ZAKAZ,'
      '110533573=        P.G_TOCHKA,'
      '110533574=        P.Z_DATE,'
      '110533575=        P.G_CLIENT,'
      '110533576=        P.CLIENT_NAME,'
      '110533577=        P.G_PAYMENT_TYPE,'
      '110533578=        P.PAYMENT_NAME,'
      '110533579=        P.OSNOVANIE,'
      '110533580=        P.G_PRODUCT,'
      '110533581=        P.G_PRODUCT_PAR,'
      '110533582=        P.TOVAR_NAME,'
      '110533583=        G.ARTICUL,'
      '110533584=        G.NOMENCLATUR_NUM,'
      '110533585=        P.AMOUNT,'
      '110533586=        P.PRICE,'
      '110533587=        P.SUMM,'
      '110533588=        P.DISCOUNT_PERC,'
      '110533589=        P.DISCOUNT_SUMM,'
      '110533590=        P.NDS,'
      '110533591=        P.NDS_SUMM,'
      '110533592=        P.PRICE_SELF,'
      '110533593=        P.SUM_SELF,'
      '110533594=        P.PROFIT,'
      '110533595=        P.IS_HEAD'
      
        '110533596=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110533597=    ORDER BY 1'
      '110533598=  INTO :P_REP_PROFIT_TABLE,'
      '110533599=       :ZAKAZ,'
      '110533600=       :G_TOCHKA,'
      '110533601=       :Z_DATE,'
      '110533602=       :G_CLIENT,'
      '110533603=       :CLIENT_NAME,'
      '110533604=       :G_PAYMENT_TYPE,'
      '110533605=       :PAYMENT_NAME,'
      '110533606=       :OSNOVANIE,'
      '110533607=       :G_PRODUCT,'
      '110533608=       :G_PRODUCT_PAR,'
      '110533609=       :TOVAR_NAME,'
      '110533610=       :ARTICUL,'
      '110533611=       :NOMENCLATUR_NUM,'
      '110533612=       :AMOUNT,'
      '110533613=       :PRICE,'
      '110533614=       :SUMM,'
      '110533615=       :DISCOUNT_PERC,'
      '110533616=       :DISCOUNT_SUMM,'
      '110533617=       :NDS,'
      '110533618=       :NDS_SUMM,'
      '110533619=       :PRICE_SELF,'
      '110533620=       :SUM_SELF,'
      '110533621=       :PROFIT,'
      '110533622=       :IS_HEAD'
      '110533623=  DO'
      '110533624=    suspend;'
      '110533625='
      '110533626=WHEN ANY DO BEGIN'
      '110533627=    Err_code = -20500;'
      
        '110533628=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110533629=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110533630=  END'
      '110533631=end'
      '110533632='#39';'
      '110533633=END  --END_EXECUTE_BLOCK'
      '110533634=EXECUTE BLOCK AS BEGIN'
      '110533635='
      '110533636=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '110533637=  G_CATEGORY_ VARCHAR(1000),'
      '110533638=  G_PRODUCT_ VARCHAR(1000),'
      '110533639=  DATE_BEGIN_ DATE,'
      '110533640=  DATE_END_ DATE,'
      '110533641=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110533642=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110533643=RETURNS ('
      '110533644=  DATE_BEGIN_OUT_ DATE,'
      '110533645=  DATE_END_OUT_ DATE,'
      '110533646=  STR_ VARCHAR(500),'
      '110533647=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '110533648=  NAME VARCHAR(1000),'
      '110533649=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110533650=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110533651=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110533652=  AMOUNT_IN MY_NUMERIC_5,'
      
        '110533653=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        ','
      '110533654=  SUMM_PRIHOD NUMERIC(15,2),'
      '110533655=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110533656=  SUMM_UHOD NUMERIC(15,2),'
      
        '110533657=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '110533658=  SUMM_SPISANO NUMERIC(15,2),'
      
        '110533659=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '110533660=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '110533661=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT,'
      '110533662=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '110533663=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '110533664=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '110533665=  AMOUNT_OUT MY_NUMERIC_5,'
      '110533666=  IS_HEAD INTEGER,'
      '110533667=  ERR_CODE INTEGER,'
      '110533668=  ERR_MSG VARCHAR(1024))'
      '110533669=AS'
      
        '110533670=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_TOVAR_' +
        'MOVE'#39#39';'
      '110533671=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110533672=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKLA' +
        'D_PRODUCT.AMOUNT = 0;'
      '110533673=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '110533674=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT = 0;'
      '110533675=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '110533676=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '110533677=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '110533678=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '110533679=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '110533680=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '110533681=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '110533682=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '110533683=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '110533684=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT;'
      
        '110533685=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110533686=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '110533687=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '110533688=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '110533689=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '110533690=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110533691=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '110533692=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110533693=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '110533694=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN' +
        ' LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '110533695=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) = ' +
        '0;'
      
        '110533696=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '110533697=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '110533698=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '110533699=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '110533700=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '110533701=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '110533702=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110533703=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '110533704=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110533705=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '110533706=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUMN' +
        ' LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '110533707=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) = ' +
        '0;'
      
        '110533708=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '110533709=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0;'
      '110533710=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '110533711=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39#39#39';'
      '110533712=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110533713=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '110533714=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      '110533715=BEGIN'
      '110533716='
      '110533717=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '110533718=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110533719='
      '110533720=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '110533721=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '110533722=               (select (select amount from lt_sklad_pr' +
        'oduct where g_product = G.G_PRODUCT'
      
        '110533723=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '110533724=                       +'
      
        '110533725=                       (select COALESCE(sum(zd.amount)' +
        ', 0) from zakaz_details zd, zakaz z'
      
        '110533726=                        where zd.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110533727=                        and zd.zakaz = z.zakaz and z.z' +
        '_date >= :DATE_BEGIN_)'
      '110533728=                       +'
      
        '110533729=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110533730=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '110533731=                       +'
      
        '110533732=                       (select COALESCE(sum(od.amount)' +
        ', 0) from other_details od, other o'
      
        '110533733=                        where od.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '110533734=                        and od.other = o.other and o.o' +
        'p_date >= :DATE_BEGIN_)'
      '110533735=                       -'
      
        '110533736=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '110533737=                        and s.is_vozvrat <> 3 and s.da' +
        'te_receipt >= :DATE_BEGIN_)'
      '110533738=                       -'
      
        '110533739=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110533740=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '110533741=                  from rdb$database) AMOUNT_OUT,'
      '110533742=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110533743=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '110533744=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110533745=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110533746=                   AND S.IS_VOZVRAT = 0'
      
        '110533747=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD,'
      '110533748=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '110533749=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110533750=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110533751=                   AND S.IS_VOZVRAT = 0'
      
        '110533752=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD,'
      '110533753=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '110533754=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '110533755=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110533756=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110533757=                   AND Z.IS_SPISANIE IN (0, 2)'
      '110533758=                   AND Z.IS_RESERVE = 0'
      
        '110533759=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_UHOD,'
      '110533760=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '110533761=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110533762=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110533763=                   AND Z.IS_SPISANIE IN (0, 2)'
      '110533764=                   AND Z.IS_RESERVE = 0'
      
        '110533765=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_UHOD,'
      '110533766=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '110533767=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '110533768=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110533769=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110533770=                   AND Z.IS_SPISANIE = 1'
      
        '110533771=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_SPISANO,'
      '110533772=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '110533773=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110533774=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110533775=                   AND Z.IS_SPISANIE = 1'
      
        '110533776=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_SPISANO,'
      '110533777=               -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110533778=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '110533779=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110533780=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110533781=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '110533782=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_VOZVRAT,'
      '110533783=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '110533784=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110533785=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110533786=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '110533787=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_VOZVRAT,'
      '110533788=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      '110533789=                  FROM SKLAD S'
      '110533790=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '110533791=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110533792=                   AND S.IS_VOZVRAT IN (3, 4, 5)'
      
        '110533793=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD_SKL,'
      '110533794=               (SELECT COALESCE(SUM(S.SUMM),0)'
      '110533795=                  FROM SKLAD S'
      '110533796=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '110533797=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110533798=                   AND S.IS_VOZVRAT IN (3, 4)'
      
        '110533799=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD_SKL,'
      '110533800=               (SELECT COALESCE(SUM(AMOUNT), 0)'
      
        '110533801=                  FROM (SELECT COALESCE(S.AMOUNT, 0) A' +
        'MOUNT'
      '110533802=                          FROM SKLAD S'
      
        '110533803=                         WHERE S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110533804=                           AND S.DATE_RECEIPT BETWEEN ' +
        ':DATE_BEGIN_ AND :DATE_END_'
      '110533805=                           AND S.IS_VOZVRAT = 3'
      
        '110533806=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||S.G_CLIENT||'#39#39'-'#39#39
      '110533807=                        UNION ALL'
      
        '110533808=                        SELECT COALESCE(D.AMOUNT, 0) A' +
        'MOUNT'
      
        '110533809=                          FROM OTHER O, OTHER_DETAILS ' +
        'D'
      '110533810=                         WHERE O.OTHER = D.OTHER'
      
        '110533811=                           AND O.OP_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '110533812=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||O.G_TOCHKA||'#39#39'-'#39#39
      
        '110533813=                           AND D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '110533814=                        UNION ALL'
      
        '110533815=                        SELECT COALESCE(D.AMOUNT, 0) A' +
        'MOUNT'
      
        '110533816=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'D'
      '110533817=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '110533818=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110533819=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110533820=                           AND D.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110533821=                           AND Z.IS_SPISANIE = 4)) AMO' +
