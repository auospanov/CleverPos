        #1048#1053' '#1055#1051#1040#1058#1045#1046
      '110206798=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110206799=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110206800=                PNT_ = '#39'05'#39';'
      
        '110206801=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110206802=                                              1,     -' +
