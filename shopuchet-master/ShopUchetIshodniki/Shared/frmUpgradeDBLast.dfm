        'T,'
      '110241339=                 NULL,'
      '110241340=                 '#39#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1082#1086#1085#1077#1094#39#39','
      
        '110241341=                 (select (select amount from lt_sklad_' +
