      '11021675=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '11021676=RETURNS ('
      
        '11021677=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS */ BIGINT,'
      
        '11021678=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ BI' +
        'GINT,'
      
        '11021679=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT */ BIGINT,'
      
        '11021680=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '11021681=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11021682=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUME' +
        'RIC(15,2),'
      
        '11021683=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC */ NUMERIC(15,2),'
      
        '11021684=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE */ NUMERIC(15,2),'
      
        '11021685=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_SUMM */ NUMERIC(15,2),'
      
        '11021686=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMERI' +
        'C(15,2),'
      
        '11021687=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM' +
        ' */ NUMERIC(15,2),'
      
        '11021688=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '11021689=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11021690=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11021691=  NOMENCLATUR /* TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_N' +
        'UM */ VARCHAR(150),'
      
        '11021692=  BRAND /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(15' +
        '0),'
      
        '11021693=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11021694=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_P' +
        'RICE */ NUMERIC(15,2),'
      '11021695=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER,'
      '11021696=  IS_MARKED INTEGER,'
      
        '11021697=  MARK_CODE /* TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE *' +
        '/ VARCHAR(100),'
      
        '11021698=  SUM_TO_CHARGE_BONUS /* TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.SUMM */ NUMERIC(15,2),'
      
        '11021699=  ORIGINAL_KIT_ID /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.O' +
        'RIGINAL_KIT_ID */ BIGINT,'
      
        '110216100=  ORIGINAL_KIT_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.ORIGINAL_KIT_PRICE */ NUMERIC(15,2),'
      
        '110216101=  VES_GRAMM /* TYPE OF COLUMN G_PRODUCT.VES_GRAMM */ N' +
        'UMERIC(15,2),'
      
        '110216102=  VES_GRAMM_PRICE /* TYPE OF COLUMN G_PRODUCT.VES_GRAM' +
        'M_PRICE */ NUMERIC(15,2))'
      '110216103=AS'
      '110216104=BEGIN'
      '110216105=  SUSPEND;'
      '110216106=END'
      '110216107=;'
      '110216108='
      '110216109='
      
        '110216110=/*****************************************************' +
        '*************************/'
      
        '110216111=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110216112=/*****************************************************' +
        '*************************/'
      '110216113=ALTER PROCEDURE G_NONCASH_PAY_TYPE_READ'
      '110216114=RETURNS ('
      
        '110216115=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE,'
      '110216116=  NAME TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110216117=  IS_ACTIVE TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_ACTIV' +
        'E)'
      '110216118=AS'
      '110216119=BEGIN'
      '110216120=  FOR SELECT G_NONCASH_PAY_TYPE,'
      '110216121=             NAME,'
      '110216122=             IS_ACTIVE'
      '110216123=      FROM G_NONCASH_PAY_TYPE'
      '110216124=      WHERE IS_ACTIVE = 1'
      '110216125=      INTO :G_NONCASH_PAY_TYPE,'
      '110216126=           :NAME,'
      '110216127=           :IS_ACTIVE'
      '110216128=  DO'
      '110216129=  BEGIN'
      '110216130=    SUSPEND;'
      '110216131=  END'
      '110216132=END'
      '110216133=;'
      '110216134='
      '110216135=ALTER PROCEDURE P_REP_AKT_SVERKI('
      '110216136=  DATE_BEGIN_ DATE,'
      '110216137=  DATE_END_ DATE,'
      '110216138=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110216139=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110216140=  CLIENT_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110216141=  CLIENT_DIR_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      
        '110216142=  G_FIRM_IN_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_FIRM_REK' +
        'VIZIT,'
      '110216143=  FIRM_NAME_IN_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '110216144=  G_OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110216145=  CURRENCY_ INTEGER)'
      '110216146=RETURNS ('
      '110216147=  STR1_ VARCHAR(500),'
      '110216148=  STR2_ VARCHAR(700),'
      '110216149=  STR3_ VARCHAR(500),'
      '110216150=  STR3_DOWN_ VARCHAR(500),'
      '110216151=  STR4_ VARCHAR(500),'
      '110216152=  STR5_ VARCHAR(500),'
      '110216153=  STR_SALDO_IN_ VARCHAR(50),'
      '110216154=  STR_SALDO_OUT_ VARCHAR(50),'
      '110216155=  STR_OT1_ VARCHAR(500),'
      '110216156=  STR_OT2_ VARCHAR(500),'
      '110216157=  DEBET_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110216158=  DEBET_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110216159=  CREDIT_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110216160=  CREDIT_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110216161=  DEBET_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110216162=  CREDIT_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110216163=  FIRM_NAME_OUT_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '110216164=  CLIENT_NAME_OUT_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110216165=  STR_TEXT VARCHAR(100),'
      '110216166=  OPER_DATE TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '110216167=  SUMM_DEBET TYPE OF COLUMN SKLAD.SUMM,'
      '110216168=  SUMM_CREDIT TYPE OF COLUMN SKLAD.SUMM,'
      '110216169=  SUMM_DEBET_CONTR TYPE OF COLUMN SKLAD.SUMM,'
      '110216170=  SUMM_CREDIT_CONTR TYPE OF COLUMN SKLAD.SUMM)'
      '110216171=AS'
      
        '110216172=DECLARE VARIABLE IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.' +
        'IS_SUPPLIER;'
      '110216173=DECLARE VARIABLE ID TYPE OF COLUMN CUR_PARAMS.ID;'
      '110216174=DECLARE VARIABLE ROW INTEGER;'
      '110216175=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '110216176=DECLARE VARIABLE SUMM_IN_DEBET_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM;'
      
        '110216177=DECLARE VARIABLE SUMM_IN_CREDIT_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '110216178=DECLARE VARIABLE SUMM_IN_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM;'
      
        '110216179=DECLARE VARIABLE SUMM_OUT_DEBET_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '110216180=DECLARE VARIABLE SUMM_OUT_CREDIT_ TYPE OF COLUMN SKLAD' +
        '_PARENT.SUMM;'
      
        '110216181=DECLARE VARIABLE SUMM_OUT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110216182=DECLARE VARIABLE SUMM_OUT_1 TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      
        '110216183=DECLARE VARIABLE SUMM_OUT_2 TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      '110216184=DECLARE VARIABLE CURR_STR_ VARCHAR(5);'
      '110216185=DECLARE VARIABLE SORT_ROW DATE;'
      '110216186=BEGIN'
      '110216187=  CLRF = ascii_char( 10 );'
      '110216188='
      '110216189=  if (CURRENCY_ = 0) then'
      '110216190=    CURR_STR_ = '#39' KZT'#39';'
      '110216191=  else if (CURRENCY_ = 1) then'
      '110216192=    CURR_STR_ = '#39' '#1088#1091#1073'.'#39';'
      '110216193=  else if (CURRENCY_ = 2) then'
      '110216194=    CURR_STR_ = '#39' '#1075#1088#1085'.'#39';'
      '110216195=  else if (CURRENCY_ = 3) then'
      '110216196=    CURR_STR_ = '#39' '#1089#1091#1084#39';'
      '110216197=  else if (CURRENCY_ = 4) then'
      '110216198=    CURR_STR_ = '#39' '#1089#1086#1084#39';'
      '110216199=  else if (CURRENCY_ = 5) then'
      '110216200=    CURR_STR_ = '#39' '#1076#1088#1072#1084#39';'
      '110216201='
      '110216202=  IF (G_OFFICIAL_NAME_ IS NULL) THEN BEGIN'
      '110216203=      SELECT J.FIO_DOC'
      '110216204=        FROM G_OFFICIAL J'
      '110216205=       WHERE J.IS_RUKOVODITEL = 1'
      '110216206=        INTO G_OFFICIAL_NAME_;'
      '110216207='
      '110216208=      if (G_OFFICIAL_NAME_ IS NULL) then'
      '110216209=        SELECT J.FIO_DOC'
      '110216210=          FROM G_OFFICIAL J'
      
        '110216211=         WHERE J.G_OFFICIAL = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 1)'
      '110216212=         INTO G_OFFICIAL_NAME_;'
      '110216213=  END'
      '110216214='
      '110216215=  CLIENT_NAME_OUT_  = CLIENT_NAME_IN_;'
      '110216216=  FIRM_NAME_OUT_    = FIRM_NAME_IN_;'
      '110216217='
      
        '110216218=  if (TRIM(G_OFFICIAL_NAME_) IS NULL or TRIM(G_OFFICIA' +
        'L_NAME_) = '#39#39') then'
      '110216219=    G_OFFICIAL_NAME_ = '#39'________________'#39';'
      '110216220='
      
        '110216221=  if (TRIM(CLIENT_DIR_NAME_IN_) IS NULL or TRIM(CLIENT' +
        '_DIR_NAME_IN_) = '#39#39') then'
      '110216222=    CLIENT_DIR_NAME_IN_ = '#39'________________'#39';'
      '110216223='
      
        '110216224=  STR1_ = '#39#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1079#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRA' +
        'CT(DAY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM ' +
        'DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'
      
        '110216225=          '#39' '#1087#1086' '#39'||lpad(EXTRACT(DAY FROM DATE_END_), 2,' +
        ' '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EX' +
        'TRACT(YEAR FROM DATE_END_)||clrf||'
      '110216226=          '#39' '#1084#1077#1078#1076#1091' '#39'||FIRM_NAME_OUT_||clrf||'
      '110216227=          '#39' '#1080' '#39'||CLIENT_NAME_OUT_;'
      '110216228='
      
        '110216229=  STR2_ = '#39#1052#1099', '#1085#1080#1078#1077#1087#1086#1076#1087#1080#1089#1072#1074#1096#1080#1077#1089#1103', ________________ '#39'||' +
        'FIRM_NAME_OUT_||'#39' '#39'||G_OFFICIAL_NAME_||'#39', '#1089' '#1086#1076#1085#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '110216230=          '#39#1080' ________________ '#39'||CLIENT_NAME_OUT_||'#39' '#39 +
        '||CLIENT_DIR_NAME_IN_||'#39', '#1089' '#1076#1088#1091#1075#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '110216231=          '#39#1089#1086#1089#1090#1072#1074#1080#1083#1080' '#1085#1072#1089#1090#1086#1103#1097#1080#1081' '#1072#1082#1090' '#1089#1074#1077#1088#1082#1080' '#1074' '#1090#1086#1084', '#1095#1090#1086' '#1089 +
        #1086#1089#1090#1086#1103#1085#1080#1077' '#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1087#1086' '#1076#1072#1085#1085#1099#1084' '#1091#1095#1077#1090#1072' '#1089#1083#1077#1076#1091#1102#1097#1077#1077':'#39';'
      '110216232='
      
        '110216233=  STR3_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_||'#39','#39'||CURR_STR_' +
        ';'
      '110216234=  STR3_DOWN_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_;'
      
        '110216235=  STR4_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||CLIENT_NAME_OUT_||'#39','#39'||CURR_ST' +
        'R_;'
      '110216236='
      
        '110216237=  STR_SALDO_IN_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1085#1072#1095#1072#1083#1086' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110216238=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_BEGIN_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DAT' +
        'E_BEGIN_)||'#39' '#1075'.'#39';'
      '110216239='
      
        '110216240=  STR_SALDO_OUT_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1082#1086#1085#1077#1094' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_END_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110216241=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_END_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DATE_' +
        'END_)||'#39' '#1075'.'#39';'
      '110216242='
      '110216243=  STR_OT1_ = '#39#1054#1090' '#39'||FIRM_NAME_OUT_;'
      '110216244=  STR_OT2_ = '#39#1054#1090' '#39'||CLIENT_NAME_OUT_;'
      '110216245='
      '110216246=  SELECT IS_SUPPLIER'
      '110216247=    FROM G_CLIENT G'
      '110216248=   WHERE G.G_CLIENT = :G_CLIENT_'
      '110216249=    INTO :IS_SUPPLIER_;'
      '110216250='
      '110216251=  DEBET_IN_   = 0;'
      '110216252=  DEBET_OUT_  = 0;'
      '110216253=  CREDIT_IN_  = 0;'
      '110216254=  CREDIT_OUT_ = 0;'
      '110216255='
      
        '110216256=  STR5_ = '#39#1085#1072' '#39'||LPAD(EXTRACT(DAY FROM CURRENT_DATE), ' +
        '2, '#39'0'#39')||'#39'.'#39'||LPAD(EXTRACT(MONTH FROM CURRENT_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110216257='
      
        '110216258=  --**************************************************' +
        '*****************'
      '110216259=  -- '#1055#1054#1057#1058#1040#1042#1065#1048#1050
      
        '110216260=  --**************************************************' +
        '*****************'
      '110216261=  IF (IS_SUPPLIER_ = 1) THEN BEGIN'
      '110216262=    ----------------------'
      '110216263=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110216264=    SELECT SUM(S.SUMM)'
      '110216265=      FROM SKLAD_PARENT S'
      '110216266=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216267=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110216268=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216269=    GROUP BY S.G_CLIENT'
      '110216270=      INTO :SUMM_IN_DEBET_;'
      '110216271='
      '110216272=    SELECT SUM(K.SUMM)'
      '110216273=      FROM SKLAD_PARENT S,'
      
        '110216274=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216275=             from KASSA'
      
        '110216276=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216277=              AND ZAKAZ IS NULL'
      '110216278=           union all'
      
        '110216279=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216280=             from kassa_beznal'
      
        '110216281=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216282=              AND ZAKAZ IS NULL) K'
      '110216283=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216284=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216285=       AND K.SKLAD = S.SKLAD'
      '110216286=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110216287=       AND K.G_PRIHOD_RASHOD = 2'
      '110216288=    GROUP BY S.G_CLIENT'
      '110216289=      INTO :SUMM_IN_CREDIT_;'
      '110216290='
      
        '110216291=    SELECT :SUMM_IN_DEBET_ + SUM(S.SUMM)              ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110216292=      FROM ZAKAZ S'
      '110216293=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216294=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110216295=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216296=    GROUP BY S.G_CLIENT'
      '110216297=      INTO :SUMM_IN_DEBET_;'
      '110216298='
      
        '110216299=    SELECT :SUMM_IN_CREDIT_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110216300=      FROM ZAKAZ S,'
      '110216301=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110216302=             from KASSA'
      
        '110216303=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216304=              AND SKLAD IS NULL'
      '110216305=           union all'
      '110216306=           select ZAKAZ, SUMM, ACTION_DATE'
      '110216307=             from kassa_beznal'
      
        '110216308=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216309=              AND SKLAD IS NULL) K'
      '110216310=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216311=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216312=       AND K.zakaz = S.ZAKAZ'
      '110216313=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110216314=    GROUP BY S.G_CLIENT'
      '110216315=      INTO :SUMM_IN_CREDIT_;'
      '110216316='
      '110216317=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110216318='
      '110216319=    ----------------------'
      '110216320=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110216321=    SELECT SUM(S.SUMM)'
      '110216322=      FROM SKLAD_PARENT S'
      '110216323=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216324=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110216325=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216326=    GROUP BY S.G_CLIENT'
      '110216327=      INTO :SUMM_OUT_DEBET_;'
      '110216328='
      '110216329=    SELECT SUM(K.SUMM)'
      '110216330=      FROM SKLAD_PARENT S,'
      
        '110216331=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216332=             from KASSA'
      
        '110216333=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216334=              AND ZAKAZ IS NULL'
      '110216335=           union all'
      
        '110216336=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216337=             from kassa_beznal'
      
        '110216338=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216339=              AND ZAKAZ IS NULL) K'
      '110216340=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216341=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216342=       AND K.SKLAD = S.SKLAD'
      '110216343=       AND K.ACTION_DATE <= :DATE_END_'
      '110216344=       AND K.G_PRIHOD_RASHOD = 2'
      '110216345=    GROUP BY S.G_CLIENT'
      '110216346=      INTO :SUMM_OUT_CREDIT_;'
      '110216347='
      
        '110216348=    SELECT :SUMM_OUT_CREDIT_ +SUM(S.SUMM)             ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110216349=      FROM ZAKAZ S'
      '110216350=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216351=       AND S.Z_DATE <= :DATE_END_'
      
        '110216352=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216353=    GROUP BY S.G_CLIENT'
      '110216354=      INTO :SUMM_OUT_CREDIT_;'
      '110216355='
      
        '110216356=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110216357=      FROM ZAKAZ S,'
      '110216358=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110216359=             from KASSA'
      
        '110216360=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216361=              AND SKLAD IS NULL'
      '110216362=           union all'
      '110216363=           select ZAKAZ, SUMM, ACTION_DATE'
      '110216364=             from kassa_beznal'
      
        '110216365=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216366=              AND SKLAD IS NULL) K'
      '110216367=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216368=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216369=       AND K.zakaz = S.ZAKAZ'
      '110216370=       AND K.ACTION_DATE <= :DATE_END_'
      '110216371=    GROUP BY S.G_CLIENT'
      '110216372=      INTO :SUMM_OUT_DEBET_;'
      '110216373='
      '110216374=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110216375=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110216376=    -------------------------'
      '110216377='
      '110216378=    if (COALESCE(SUMM_IN_, 0) < 0) then'
      '110216379=      DEBET_IN_ = SUMM_IN_;'
      '110216380=    ELSE'
      '110216381=      CREDIT_IN_ = SUMM_IN_;'
      '110216382='
      '110216383=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110216384=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110216385='
      '110216386=    if (COALESCE(SUMM_OUT_, 0) < 0) then'
      '110216387=      DEBET_OUT_ = ABS(SUMM_OUT_);'
      '110216388=    ELSE'
      '110216389=      CREDIT_OUT_ = SUMM_OUT_;'
      '110216390='
      '110216391=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110216392=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110216393='
      '110216394=        if (DEBET_OUT_ > 0) then'
      
        '110216395=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110216396=        else'
      
        '110216397=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110216398=    end else'
      '110216399=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110216400='
      '110216401=    FOR SELECT 1 ROW,'
      
        '110216402=               '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1058#1052#1047' '#39'||S.SKLAD||'#39' '#1086#1090' '#39'||S.' +
        'DATE_RECEIPT str,'
      '110216403=               S.SKLAD ID,'
      '110216404=               S.DATE_RECEIPT OPER_DATE,'
      '110216405=               NULL SUMM_DEBET,'
      '110216406=               S.SUMM SUMM_CREDIT,'
      '110216407=               S.DATE_RECEIPT SORT_ROW'
      '110216408=          FROM SKLAD_PARENT S'
      '110216409=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216410=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110216411=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110216412=        UNION ALL'
      '110216413=        SELECT 2 ROW,'
      
        '110216414=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' '#1086#1090' '#39'||SP' +
        'P.DATE_RECEIPT STR,'
      '110216415=               K.SKLAD ID,'
      '110216416=               K.ACTION_DATE OPER_DATE,'
      '110216417=               K.SUMM SUMM_DEBET,'
      '110216418=               NULL SUMM_CREDIT,'
      '110216419=               K.ACTION_DATE SORT_ROW'
      
        '110216420=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110216421=                  from KASSA'
      
        '110216422=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110216423=                union all'
      
        '110216424=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110216425=                  from kassa_beznal'
      
        '110216426=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110216427=               SKLAD_PARENT SPP'
      '110216428=         WHERE K.ZAKAZ IS NULL'
      '110216429=           AND K.SKLAD = SPP.SKLAD'
      
        '110216430=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110216431=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110216432=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110216433=           AND K.G_PRIHOD_RASHOD = 2'
      '110216434=        UNION ALL'
      '110216435=        SELECT 3 ROW,'
      
        '110216436=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#39'||Z.ZAKAZ||'#39' '#1086 +
        #1090' '#39'||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT' +
        '(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE)' +
        ' str,'
      '110216437=               Z.ZAKAZ ID,'
      '110216438=               Z.Z_DATE OPER_DATE,'
      '110216439=               Z.SUMM SUMM_DEBET,'
      '110216440=               NULL SUMM_CREDIT,'
      '110216441=               Z.Z_DATE SORT_ROW'
      '110216442=          FROM ZAKAZ Z'
      '110216443=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110216444=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110216445=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110216446=        UNION ALL'
      '110216447=        SELECT 4 ROW,'
      
        '110216448=               '#39#1054#1087#1083#1072#1090#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' '#39 +
        '||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(M' +
        'ONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE)' +
        ' STR,'
      '110216449=               K.ZAKAZ ID,'
      '110216450=               K.ACTION_DATE OPER_DATE,'
      '110216451=               NULL SUMM_DEBET,'
      '110216452=               K.SUMM SUMM_CREDIT,'
      '110216453=               K.ACTION_DATE SORT_ROW'
      
        '110216454=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA'
      '110216455=                  from KASSA'
      
        '110216456=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110216457=                union all'
      
        '110216458=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA'
      '110216459=                  from kassa_beznal'
      
        '110216460=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '110216461=               zakaz zz'
      '110216462=         WHERE K.sklad IS NULL'
      '110216463=           AND K.zakaz = zz.ZAKAZ'
      
        '110216464=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110216465=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110216466=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110216467=        UNION ALL'
      '110216468=        SELECT 5 ROW,'
      '110216469=               NULL STR,'
      '110216470=               NULL ID,'
      '110216471=               NULL OPER_DATE,'
      '110216472=               NULL SUMM_DEBET,'
      '110216473=               NULL SUMM_CREDIT,'
      
        '110216474=               '#39'31.12.2199'#39' SORT_ROW    -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072 +
        #1103' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110216475=          FROM RDB$DATABASE'
      '110216476=        ORDER BY 7, 3, 1'
      '110216477=        INTO :ROW,'
      '110216478=             :STR_TEXT,'
      '110216479=             :ID,'
      '110216480=             :OPER_DATE,'
      '110216481=             :SUMM_DEBET,'
      '110216482=             :SUMM_CREDIT,'
      '110216483=             :SORT_ROW'
      '110216484=    DO BEGIN'
      '110216485=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110216486=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110216487=      SUSPEND;'
      '110216488=    END'
      '110216489=  END'
      '110216490='
      
        '110216491=  --**************************************************' +
        '*************'
      '110216492=  -- '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068
      
        '110216493=  -- 12.12.2021 '#1058#1045#1055#1045#1056#1068' '#1041#1059#1044#1059' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1055#1054' '#1057#1063#1045#1058' '#1060#1040#1050#1058#1059#1056#1040#1052',' +
        ' '#1050#1054#1058#1054#1056#1067#1045' '#1041#1067#1051#1048' '#1042#1067#1055#1048#1057#1040#1053#1067', '#1063#1058#1054#1041#1067' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040#1047#1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '110216494=  --**************************************************' +
        '*************'
      '110216495=  ELSE BEGIN'
      '110216496=    ----------------------'
      '110216497=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110216498=    SELECT SUM(S.SUMM)'
      '110216499=      FROM ZAKAZ S, INVOICE I'
      '110216500=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216501=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110216502=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216503=       AND S.is_spisanie <> 1'
      '110216504=       AND S.ZAKAZ = I.ZAKAZ'
      
        '110216505=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_FI' +
        'RM, :G_FIRM_IN_)'
      '110216506=    GROUP BY S.G_CLIENT'
      '110216507=      INTO :SUMM_IN_DEBET_;'
      '110216508='
      '110216509=    SELECT SUM(K.SUMM)'
      '110216510=      FROM ZAKAZ S,'
      '110216511=           INVOICE I,'
      
        '110216512=          (select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216513=             from KASSA'
      
        '110216514=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216515=              AND SKLAD IS NULL'
      '110216516=           union all'
      
        '110216517=           select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216518=             from kassa_beznal'
      
        '110216519=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216520=              AND SKLAD IS NULL'
      '110216521=           union all'
      
        '110216522=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110216523=             from zakaz Z'
      
        '110216524=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216525=              AND Z.summ_bonus > 0) K'
      '110216526=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216527=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216528=       AND K.zakaz = S.ZAKAZ'
      '110216529=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110216530=       AND S.is_spisanie <> 1'
      '110216531=       AND K.G_PRIHOD_RASHOD = 1'
      '110216532=       AND S.ZAKAZ = I.ZAKAZ'
      
        '110216533=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_FI' +
        'RM, :G_FIRM_IN_)'
      '110216534=    GROUP BY S.G_CLIENT'
      '110216535=      INTO :SUMM_IN_CREDIT_;'
      '110216536='
      
        '110216537=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040#1047 +
        #1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '110216538=    SELECT :SUMM_IN_DEBET_ + SUM(K.SUMM)              ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110216539=      FROM SKLAD_PARENT S,'
      
        '110216540=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216541=             from KASSA'
      
        '110216542=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216543=              AND ZAKAZ IS NULL'
      '110216544=           union all'
      
        '110216545=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110216546=             from kassa_beznal'
      
        '110216547=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216548=              AND ZAKAZ IS NULL) K'
      '110216549=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216550=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216551=       AND K.SKLAD = S.SKLAD'
      '110216552=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110216553=       AND K.G_PRIHOD_RASHOD = 3'
      '110216554=    GROUP BY S.G_CLIENT'
      '110216555=      INTO :SUMM_IN_DEBET_;'
      '110216556='
      
        '110216557=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040#1047 +
        #1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '110216558=    SELECT :SUMM_IN_CREDIT_ + SUM(S.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110216559=      FROM SKLAD_PARENT S'
      '110216560=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216561=       AND S.IS_VOZVRAT = 1'
      '110216562=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110216563=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216564=    GROUP BY S.G_CLIENT'
      '110216565=      INTO :SUMM_IN_CREDIT_;'
      '110216566='
      '110216567=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110216568='
      '110216569=    ----------------------'
      '110216570=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110216571=    SELECT SUM(S.SUMM)'
      '110216572=      FROM ZAKAZ S, INVOICE I'
      '110216573=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216574=       AND S.Z_DATE <= :DATE_END_'
      
        '110216575=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216576=       AND S.is_spisanie <> 1'
      '110216577=       AND S.ZAKAZ = I.ZAKAZ'
      
        '110216578=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_FI' +
        'RM, :G_FIRM_IN_)'
      '110216579=    GROUP BY S.G_CLIENT'
      '110216580=      INTO :SUMM_OUT_DEBET_;'
      '110216581='
      '110216582=    SELECT SUM(K.SUMM)'
      '110216583=      FROM ZAKAZ S, INVOICE I,'
      
        '110216584=          (select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110216585=             from KASSA'
      
        '110216586=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216587=              AND SKLAD IS NULL'
      '110216588=           union all'
      
        '110216589=           select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110216590=             from kassa_beznal'
      
        '110216591=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216592=              AND SKLAD IS NULL'
      '110216593=           union all'
      
        '110216594=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110216595=             from zakaz Z'
      
        '110216596=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216597=              AND Z.summ_bonus > 0) K'
      '110216598=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216599=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216600=       AND K.zakaz = S.ZAKAZ'
      '110216601=       AND K.ACTION_DATE <= :DATE_END_'
      '110216602=       AND K.G_PRIHOD_RASHOD in (1, -5)'
      '110216603=       AND S.ZAKAZ = I.ZAKAZ'
      
        '110216604=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_FI' +
        'RM, :G_FIRM_IN_)'
      '110216605=    GROUP BY S.G_CLIENT'
      '110216606=      INTO :SUMM_OUT_CREDIT_;'
      '110216607='
      
        '110216608=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040#1047 +
        #1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '110216609=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110216610=      FROM SKLAD_PARENT S,'
      
        '110216611=          (select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110216612=             from KASSA'
      
        '110216613=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216614=              AND ZAKAZ IS NULL'
      '110216615=           union all'
      
        '110216616=           select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110216617=             from kassa_beznal'
      
        '110216618=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110216619=              AND ZAKAZ IS NULL) K'
      '110216620=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216621=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216622=       AND K.SKLAD = S.SKLAD'
      '110216623=       AND K.ACTION_DATE <= :DATE_END_'
      '110216624=       AND K.G_PRIHOD_RASHOD = 3'
      '110216625=    GROUP BY S.G_CLIENT'
      '110216626=      INTO :SUMM_OUT_DEBET_;'
      '110216627='
      
        '110216628=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040#1047 +
        #1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '110216629=    SELECT :SUMM_OUT_CREDIT_ + SUM(S.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110216630=      FROM SKLAD_PARENT S'
      '110216631=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110216632=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110216633=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110216634=    GROUP BY S.G_CLIENT'
      '110216635=      INTO :SUMM_OUT_CREDIT_;'
      '110216636='
      '110216637=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110216638=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110216639=    -------------------------'
      '110216640='
      '110216641=    IF (COALESCE(SUMM_IN_, 0) > 0) then'
      '110216642=      DEBET_IN_ = SUMM_IN_;'
      '110216643=    ELSE'
      '110216644=      CREDIT_IN_ = SUMM_IN_;'
      '110216645='
      '110216646=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110216647=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110216648='
      '110216649=    if (COALESCE(SUMM_OUT_, 0) > 0) then'
      '110216650=      DEBET_OUT_ = SUMM_OUT_;'
      '110216651=    ELSE'
      '110216652=      CREDIT_OUT_ = ABS(SUMM_OUT_);'
      '110216653='
      '110216654=    --------------------'
      '110216655=    -- '#1047#1040#1044#1054#1051#1046#1045#1053#1053#1054#1057#1058#1068
      '110216656=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110216657=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110216658='
      '110216659=        if (DEBET_OUT_ > 0) then'
      
        '110216660=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110216661=        else'
      
        '110216662=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110216663=    end else'
      '110216664=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110216665='
      '110216666=    FOR SELECT 1 ROW,'
      
        '110216667=               '#39#1055#1088#1086#1076#1072#1078#1072', '#1085#1072#1082#1083#1072#1076#1085#1072#1103' '#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39'|' +
        '|lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MON' +
        'TH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE) str' +
        ','
      '110216668=               Z.ZAKAZ ID,'
      '110216669=               Z.Z_DATE OPER_DATE,'
      '110216670=               Z.SUMM SUMM_DEBET,'
      '110216671=               NULL SUMM_CREDIT,'
      '110216672=               Z.Z_DATE SORT_ROW'
      '110216673=          FROM ZAKAZ Z, INVOICE I'
      '110216674=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110216675=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110216676=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110216677=           AND Z.ZAKAZ = I.ZAKAZ'
      
        '110216678=           AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.' +
        'G_FIRM, :G_FIRM_IN_)'
      '110216679=        UNION ALL'
      '110216680=        SELECT 2 ROW,'
      
        '110216681=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1085#1072#1082#1083#1072#1076#1085#1091#1102' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(' +
        'MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE' +
        ') STR,'
      '110216682=               K.ZAKAZ ID,'
      '110216683=               K.ACTION_DATE OPER_DATE,'
      '110216684=               NULL SUMM_DEBET,'
      '110216685=               K.SUMM SUMM_CREDIT,'
      '110216686=               K.ACTION_DATE SORT_ROW'
      
        '110216687=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA, G_PRIHOD_RASHOD'
      '110216688=                  from KASSA'
      
        '110216689=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110216690=                union all'
      
        '110216691=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA, G_PRIHOD_RASHOD'
      '110216692=                  from kassa_beznal'
      
        '110216693=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110216694=                union all'
      
        '110216695=                select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z' +
        '_date ACTION_DATE, NULL SKLAD, NULL KASSA, 1 G_PRIHOD_RASHOD'
      '110216696=                  from zakaz Z'
      
        '110216697=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110216698=                   AND Z.summ_bonus > 0) K,'
      '110216699=               zakaz zz,'
      '110216700=               INVOICE I'
      '110216701=         WHERE K.sklad IS NULL'
      '110216702=           AND K.zakaz = zz.ZAKAZ'
      
        '110216703=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110216704=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110216705=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110216706=           AND K.G_PRIHOD_RASHOD in (1, -5)'
      '110216707=           AND ZZ.ZAKAZ = I.ZAKAZ'
      
        '110216708=           AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.' +
        'G_FIRM, :G_FIRM_IN_)'
      '110216709=        UNION ALL'
      '110216710=        SELECT 3 ROW,'
      
        '110216711=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1082#1083#1080#1077#1085#1090#1086#1084' '#39'||S.SKLAD||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXT' +
        'RACT(MONTH FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM' +
        ' S.DATE_RECEIPT) str,'
      '110216712=               S.SKLAD ID,'
      '110216713=               S.DATE_RECEIPT OPER_DATE,'
      '110216714=               NULL SUMM_DEBET,'
      '110216715=               S.SUMM SUMM_CREDIT,'
      '110216716=               S.DATE_RECEIPT SORT_ROW'
      '110216717=          FROM SKLAD_PARENT S'
      '110216718=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110216719=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110216720=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110216721=        UNION ALL'
      '110216722=        SELECT 4 ROW,'
      
        '110216723=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' ' +
        #1086#1090' '#39'||lpad(EXTRACT(DAY FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpa' +
        'd(EXTRACT(MONTH FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM SPP.DATE_RECEIPT) STR,'
      '110216724=               K.SKLAD ID,'
      '110216725=               K.ACTION_DATE OPER_DATE,'
      '110216726=               K.SUMM SUMM_DEBET,'
      '110216727=               NULL SUMM_CREDIT,'
      '110216728=               K.ACTION_DATE SORT_ROW'
      
        '110216729=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110216730=                  from KASSA'
      
        '110216731=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110216732=                union all'
      
        '110216733=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110216734=                  from kassa_beznal'
      
        '110216735=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110216736=               SKLAD_PARENT SPP'
      '110216737=         WHERE K.ZAKAZ IS NULL'
      '110216738=           AND K.SKLAD = SPP.SKLAD'
      
        '110216739=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110216740=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110216741=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110216742=           AND K.G_PRIHOD_RASHOD = 3'
      '110216743=        UNION ALL'
      '110216744=        SELECT 5 ROW,'
      '110216745=               NULL STR,'
      '110216746=               NULL ID,'
      '110216747=               NULL OPER_DATE,'
      '110216748=               NULL SUMM_DEBET,'
      '110216749=               NULL SUMM_CREDIT,'
      
        '110216750=               '#39'31.12.2199'#39' SORT_ROW  -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072#1103' ' +
        #1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110216751=          FROM RDB$DATABASE'
      '110216752=        ORDER BY 7, 3, 1'
      '110216753=        INTO :ROW,'
      '110216754=             :STR_TEXT,'
      '110216755=             :ID,'
      '110216756=             :OPER_DATE,'
      '110216757=             :SUMM_DEBET,'
      '110216758=             :SUMM_CREDIT,'
      '110216759=             :SORT_ROW'
      '110216760=    DO BEGIN'
      '110216761=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110216762=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110216763='
      '110216764=      SUSPEND;'
      '110216765=    END'
      '110216766=  END'
      '110216767='
      '110216768=END'
      '110216769=;'
      '110216770='
      '110216771=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110216772=RETURNS ('
      '110216773=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110216774=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '110216775=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '110216776=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '110216777=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '110216778=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110216779=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110216780=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '110216781=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '110216782=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110216783=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110216784=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110216785=  NOMENCLATUR TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM' +
        ','
      '110216786=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110216787=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110216788=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZ' +
        'N_PROC,'
      '110216789=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '110216790=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_' +
        'PROC,'
      '110216791=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '110216792=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_SA' +
        'LE_PRICE,'
      '110216793=  IS_MARKED TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110216794=  MARK_CODE TYPE OF COLUMN SKLAD_TMP.MARK_CODE,'
      '110216795=  VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '110216796=  VES_GRAMM_PRICE TYPE OF COLUMN G_PRODUCT.VES_GRAMM_P' +
        'RICE)'
      '110216797=AS'
      '110216798=BEGIN'
      '110216799=  FOR'
      
        '110216800=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.' +
        'SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.NOMENCL' +
        'ATUR_NUM, P.BRAND, P.PRICE'
      '110216801=           ,PRICE_CURRENCY'
      '110216802=           ,SUMM_CURRENCY'
      '110216803=           ,CHARGE_ROZN_PROC'
      '110216804=           ,PRICE_ROZN'
      '110216805=           ,CHARGE_OPT_PROC'
      '110216806=           ,PRICE_OPT'
      '110216807=           ,CHANGE_SALE_PRICE'
      '110216808=           ,P.IS_MARKED'
      '110216809=           ,MARK_CODE'
      '110216810=           ,P.VES_GRAMM * T.AMOUNT'
      
        '110216811=           ,COALESCE(P.VES_GRAMM, 0, T.SUMM / (P.VES_G' +
        'RAMM * T.AMOUNT))'
      '110216812=    FROM SKLAD_TMP T,'
      '110216813=         G_PRODUCT P'
      '110216814=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110216815=    ORDER BY T.sklad'
      
        '110216816=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :' +
        'NDS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :NOMENCLATUR,' +
        ' :BRAND, :SALE_PRICE'
      '110216817=      ,:PRICE_CURRENCY'
      '110216818=      ,:SUMM_CURRENCY'
      '110216819=      ,:CHARGE_ROZN_PROC'
      '110216820=       ,:PRICE_ROZN'
      '110216821=       ,:CHARGE_OPT_PROC'
      '110216822=       ,:PRICE_OPT'
      '110216823=       ,:CHANGE_SALE_PRICE'
      '110216824=       ,:IS_MARKED'
      '110216825=       ,:MARK_CODE'
      '110216826=       ,:VES_GRAMM'
      '110216827=       ,:VES_GRAMM_PRICE'
      '110216828=  DO'
      '110216829=    suspend;'
      '110216830=end'
      '110216831=;'
      '110216832='
      '110216833=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '110216834=RETURNS ('
      
        '110216835=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '110216836=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '110216837=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT' +
        ','
      '110216838=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110216839=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110216840=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110216841=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_PERC,'
      
        '110216842=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_TENGE,'
      
        '110216843=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_SUMM,'
      '110216844=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '110216845=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '110216846=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110216847=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110216848=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110216849=  NOMENCLATUR TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM' +
        ','
      '110216850=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110216851=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110216852=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PRI' +
        'CE,'
      '110216853=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110216854=  IS_MARKED INTEGER,'
      '110216855=  MARK_CODE TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE,'
      
        '110216856=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TMP' +
        '.SUMM,'
      
        '110216857=  ORIGINAL_KIT_ID TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ORI' +
        'GINAL_KIT_ID,'
      
        '110216858=  ORIGINAL_KIT_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.' +
        'ORIGINAL_KIT_PRICE,'
      '110216859=  VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '110216860=  VES_GRAMM_PRICE TYPE OF COLUMN G_PRODUCT.VES_GRAMM_P' +
        'RICE)'
      '110216861=AS'
      '110216862=begin'
      '110216863='
      '110216864=  FOR'
      '110216865=    SELECT T.ZAKAZ_DETAILS,'
      '110216866=           T.ZAKAZ,'
      '110216867=           T.G_PRODUCT,'
      '110216868=           T.AMOUNT,'
      '110216869=           T.PRICE,'
      '110216870=           T.SUMM,'
      '110216871=           T.DISCOUNT_PERC,'
      '110216872=           T.DISCOUNT_TENGE,'
      '110216873=           T.DISCOUNT_SUMM,'
      '110216874=           T.NDS,'
      '110216875=           T.NDS_SUMM,'
      '110216876=           P.NAME PRODUCT_NAME'
      '110216877=           ,P.BARCODE'
      '110216878=           ,P.ARTICUL'
      '110216879=           ,P.NOMENCLATUR_NUM'
      '110216880=           ,P.BRAND'
      '110216881=           ,P.PRICE'
      '110216882=           ,P.IS_KIT'
      
        '110216883=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_TM' +
        'P TM, G_PRODUCT GP'
      
        '110216884=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.DO' +
        '_NOT_CHARGE_BONUS = 0)'
      '110216885=           ,T.COST_PRICE'
      '110216886=           ,P.IS_MARKED'
      '110216887=           ,T.MARK_CODE'
      '110216888=           ,T.ORIGINAL_KIT_ID'
      '110216889=           ,T.ORIGINAL_KIT_PRICE'
      '110216890=           ,P.BRAND'
      '110216891=           ,P.VES_GRAMM * T.AMOUNT'
      '110216892=           ,T.VES_GRAMM_PRICE'
