        '1102503775=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055 +
        #1054' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1102503776=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1102503777=                SELECT K.KASSA'
      '1102503778=                FROM KASSA K'
      '1102503779=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1102503780=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1102503781=                 INTO :KASSA_POP_;'
      '1102503782=            ELSE'
