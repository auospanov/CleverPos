        'T */ BIGINT,'
      
        '1106354=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ N' +
        'UMERIC(18,5),'
      
        '1106355=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NUM' +
        'ERIC(15,2),'
      
        '1106356=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUMER' +
        'IC(15,2),'
      
        '1106357=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
