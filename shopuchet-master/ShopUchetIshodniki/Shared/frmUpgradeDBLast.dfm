        #1082#1083#1080#1077#1085#1090' '#39'||SUBSTRING(COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39') FROM 1 FOR 300' +
        '),'
      '110248245=                 S.PRICE,'
