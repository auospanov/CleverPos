      '1101824390=                      ,10000 LVL'
      '1101824391=                 FROM SYNC_EXT_APP S'
      '1101824392=                WHERE S.IS_LOADING = 1'
      
        '1101824393=                  AND ((S.IS_LOADED = 0 AND :LOAD_TYP' +
        'E_ = 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '1101824394=                  AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1101824395=                  AND S.OBJECT_TYPE = 4'
      '1101824396=                  AND S.OPER = 3        -- '#1059#1044#1040#1051#1045#1053#1048#1071
      '1101824397=                  AND :OPER_ = 3'
      '1101824398=                ORDER BY 11) TT'
      '1101824399=         INTO :ARTICUL,'
      '1101824400=              :BARCODE,'
      '1101824401=              :NOMENCLATUR_NUM,'
      '1101824402=              :TOVAR_NAME,'
