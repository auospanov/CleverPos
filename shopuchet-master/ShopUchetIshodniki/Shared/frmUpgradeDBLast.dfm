        #1053#1048#1071
      '1102011377=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '1102011378=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' ' +
        #1055#1054#1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '1102011379=      UPDATE G_DISCONT_CARD G'
      
        '1102011380=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_' +
        ', 0) - :SUMM_BONUS_GOT_,'
      
        '1102011381=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0)' +
        ', 0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '1102011382=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '1102011383='
      '1102011384=      PNT_ = '#39'04'#39';'
      '1102011385=      UPDATE INVOICE I'
      '1102011386=         SET I.ZAKAZ = NULL'
      '1102011387=       WHERE I.ZAKAZ = :zakaz_;'
      '1102011388='
      '1102011389=      UPDATE INVOICE_PAY I'
      '1102011390=         SET I.ZAKAZ = NULL'
      '1102011391=       WHERE I.ZAKAZ = :zakaz_;'
      '1102011392='
      '1102011393=      UPDATE WAYBILL W'
      '1102011394=         SET W.ZAKAZ = NULL'
      '1102011395=       WHERE W.ZAKAZ = :zakaz_;'
      '1102011396=      --********************************************'
      '1102011397='
      '1102011398=      PNT_ = '#39'015'#39';'
      '1102011399=      DELETE FROM zakaz'
      '1102011400=      WHERE zakaz = :zakaz_;'
      '1102011401='
      '1102011402=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1102011403=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN BEGIN'
      '1102011404=        UPDATE SYNC_EXT_APP AP'
      '1102011405=           SET AP.OPER = 3,'
      '1102011406=               AP.ID = COALESCE(:REC_ID_, :ZAKAZ_)'
      '1102011407=         WHERE AP.OBJECT_TYPE = 1'
      '1102011408=           AND AP.ID = :ZAKAZ_'
      '1102011409=           AND AP.IS_LOADING = 0;'
      '1102011410='
      '1102011411=        IF (ROW_COUNT = 0) THEN'
      
        '1102011412=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, O' +
        'BJECT_TYPE, ID, OPER)'
      
        '1102011413=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, C' +
        'OALESCE(:REC_ID_, :ZAKAZ_), 3);'
      '1102011414=      END'
      '1102011415=  END'
      '1102011416=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '1102011417=  --*************************************************' +
        '***************************'
      '1102011418=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102011419=  ELSE BEGIN'
      '1102011420=    SELECT SP.DATE_RECEIPT,'
      '1102011421=           SP.SUMM'
      '1102011422=      FROM SKLAD_PARENT SP'
      '1102011423=     WHERE SP.SKLAD = :ZAKAZ_'
      '1102011424=      INTO :Z_DATE_,'
      '1102011425=           :SUMM_ZAKAZ_;'
      '1102011426='
      '1102011427=    PNT_ = '#39'20'#39';'
      
        '1102011428=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL, :UPLOA' +
        'D_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102011429=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102011430=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102011431=      EXIT;'
      '1102011432=    END'
      '1102011433=  END'
      '1102011434='
      '1102011435=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102011436=  EXECUTE PROCEDURE LOG_OPER_INS(IS_SPISANIE_, :USER_' +
        'ID_, :ZAKAZ_, :Z_DATE_, 3, :SUMM_ZAKAZ_, :LOG_BODY_, 0);'
      '1102011437='
      '1102011438=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102011439=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM_OLD_,' +
        ' :LOG_BODY_KASSA_, 1);'
      '1102011440='
      '1102011441=when any DO'
      '1102011442=  begin'
      '1102011443=    IF (sqlcode = -530) THEN BEGIN'
      '1102011444=        ERR_CODE = -20500;'
      
        '1102011445=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072 +
        #1085#1085#1086#1081' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNIN' +
        'G_VALUES (:ERR_MSG);'
      
        '1102011446=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG' +
        ';'
      '1102011447=    END'
      '1102011448=    ELSE BEGIN'
      '1102011449=        ERR_CODE = -9999;'
      
        '1102011450=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073 +
        #1082#1072' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1087#1088#1086#1076#1072#1078#1080'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102011451=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG' +
        ';'
      '1102011452=    END'
      '1102011453=  end'
      '1102011454=end'
      '1102011455=;'
      '1102011456='
      '1102011457=ALTER PROCEDURE G_GET_G_DISCOUNT_BY_PRODUCT('
      '1102011458=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '1102011459=RETURNS ('
      '1102011460=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1102011461=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1102011462=  IS_HAVE_SKIDKA_ VARCHAR(10),'
      '1102011463=  ERR_CODE INTEGER,'
      '1102011464=  ERR_MSG VARCHAR(1024))'
      '1102011465=AS'
      
        '1102011466=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102011467=BEGIN'
      '1102011468=    SELECT ID'
      '1102011469=      FROM CUR_PARAMS'
      '1102011470=     WHERE CUR_PARAMS = 2'
      '1102011471=      INTO :G_TOCHKA_;'
      '1102011472='
      '1102011473=    SELECT D.SKIDKA_PROC, D.SKIDKA_SUM, '#39#1045#1057#1058#1068#39
      '1102011474=    FROM G_DISCOUNT D'
      '1102011475=    WHERE D.G_PRODUCT = :G_PRODUCT_'
      
        '1102011476=      AND ((D.DATE_BEGIN <= CURRENT_DATE  -- '#1058#1054#1051#1068#1050#1054' '#1040 +
        #1050#1058#1048#1042#1053#1067#1045
      '1102011477=            AND D.DATE_END >= CURRENT_DATE'
      '1102011478=            AND D.IS_CONST = 0'
      '1102011479=            )'
      '1102011480=            OR'
      '1102011481=            (D.IS_CONST = 1)'
      '1102011482=          )'
      
        '1102011483=      AND COALESCE(D.G_TOCHKA, :G_TOCHKA_) = :G_TOCHK' +
        'A_'
      
        '1102011484=    INTO :SKIDKA_PROC_, :SKIDKA_SUM_, :IS_HAVE_SKIDKA' +
        '_;'
      '1102011485='
      '1102011486=    if (IS_HAVE_SKIDKA_ IS NULL) then'
      '1102011487=      IS_HAVE_SKIDKA_ = '#39#1053#1045#1058#39';'
      '1102011488=end'
      '1102011489=;'
      '1102011490='
      '1102011491=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1102011492=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102011493=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM,'
      '1102011494=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102011495=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102011496=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1102011497=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1102011498=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1102011499=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102011500=  SELF_PRICE_ NUMERIC(15,2),'
      '1102011501=  AMOUNT_ MY_NUMERIC_5,'
      '1102011502=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1102011503=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1102011504=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102011505=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102011506=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1102011507=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1102011508=  CATEGORY_NAME_ VARCHAR(1000),'
      '1102011509=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102011510=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102011511=  IS_THIS_LAST_ INTEGER,'
      '1102011512=  UPDATE_IF_EXIST_ INTEGER,'
      '1102011513=  DO_SEARCH_CATEGORY_ INTEGER,'
      '1102011514=  BARCODE_IS_MAIN_ INTEGER,'
      '1102011515=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102011516=RETURNS ('
      '1102011517=  ERR_CODE INTEGER,'
      '1102011518=  ERR_MSG VARCHAR(1024))'
      '1102011519=AS'
      
        '1102011520=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_P' +
        'RODUCT'#39';'
      '1102011521=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102011522=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102011523=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT_PAR = NULL;'
      
        '1102011524=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1102011525=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT' +
        ';'
      
        '1102011526=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT = 0;'
      
        '1102011527=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1102011528=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD;'
      
        '1102011529=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102011530=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM_CURRENCY;'
      '1102011531=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1102011532=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102011533=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      
        '1102011534=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1102011535=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1102011536=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1102011537=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1102011538=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1102011539=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1102011540=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1102011541=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102011542=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1102011543=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1102011544=BEGIN'
      '1102011545=    ERR_MSG = '#39#39';'
      '1102011546=    PNT_ = '#39'00'#39';'
      '1102011547='
      
        '1102011548=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044 +
        #1045#1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '1102011549=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS889' +
        '88~98888~"'
      
        '1102011550=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' ' +
        #1053#1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '1102011551=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '1102011552=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39 +
        '~'#39');'
      '1102011553=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '1102011554=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '1102011555=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '1102011556=    END ELSE'
      '1102011557=        CROSSCODE_ = NULL;'
      '1102011558='
      
        '1102011559=    -------------------------------------------------' +
        '-----------------'
      
        '1102011560=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058#1040#1050 +
        #1054#1049' '#1053#1045#1058
      
        '1102011561=    -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~'#1052#1103 +
        #1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '1102011562=    -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '1102011563=    -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053#1054' ' +
        #1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      '1102011564=    IF (DO_SEARCH_CATEGORY_ = 1) THEN BEGIN'
      
        '1102011565=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BE' +
        'GIN'
      '1102011566=            G_PRODUCT_PAR_ = NULL;'
      
        '1102011567=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAM' +
        'E_);'
      '1102011568=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '1102011569=              STR_ = CATEGORY_NAME_;'
      '1102011570=              CATEGORY_NAME_ = '#39#39';'
      '1102011571=            END ELSE'
      
        '1102011572=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1102011573='
      '1102011574=            SELECT G_PRODUCT'
      '1102011575=              FROM G_PRODUCT G'
      '1102011576=             WHERE G.NAME = :STR_'
      '1102011577=               AND G.IS_CATEGORY = 1'
      
        '1102011578=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1102011579=                   OR'
      
        '1102011580=                   (G.G_PRODUCT_PAR IS NULL AND :G_PR' +
        'ODUCT_PAR_PREV_ IS NULL))'
      '1102011581=              INTO G_PRODUCT_PAR_;'
      '1102011582=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1102011583=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1102011584=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1102011585=                RETURNING G_PRODUCT'
      '1102011586=                INTO :G_PRODUCT_PAR_;'
      '1102011587='
      '1102011588=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1102011589=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1102011590=        END'
      '1102011591=    END'
      
        '1102011592=    -------------------------------------------------' +
        '-----------------'
      '1102011593='
      '1102011594=    PNT_ = '#39'01'#39';'
      '1102011595=    SELECT ID'
      '1102011596=      FROM CUR_PARAMS'
      '1102011597=    WHERE CUR_PARAMS = 2'
      '1102011598=      INTO :G_TOCHKA_;'
      '1102011599='
      '1102011600=    SELECT G.G_UNIT'
      '1102011601=      FROM G_UNIT G'
      
        '1102011602=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAM' +
        'E_G_UNIT_))'
      '1102011603=      INTO :G_UNIT_;'
      '1102011604=    if (ROW_COUNT = 0) then'
      '1102011605=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1102011606='
      '1102011607=    PNT_ = '#39'02'#39';'
      
        '1102011608=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1102011609=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1102011610=        SELECT G.G_PRODUCT,'
      '1102011611=               G.NAME'
      '1102011612=          FROM G_PRODUCT G'
      
        '1102011613=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1102011614=           AND TRIM(G.ARTICUL) <> '#39#39
      '1102011615=           AND G.IS_ACTIVE = 1'
      '1102011616=          INTO :G_PRODUCT_,'
      '1102011617=               :G_PRODUCT_NAME_;'
      '1102011618='
      '1102011619=        PNT_ = '#39'02.1'#39';'
      
        '1102011620=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1102011621=        IF (COALESCE(G_PRODUCT_, 0) <> 0) THEN BEGIN'
      '1102011622=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1102011623=              IF (BARCODE_IS_MAIN_ = 0) THEN BEGIN'
      '1102011624=                  UPDATE G_PRODUCT G'
      '1102011625=                     SET G.NAME = :NAME_,'
      '1102011626=                         G.G_UNIT = :G_UNIT_,'
      
        '1102011627=                         G.PRICE  = DECODE(:PRICE_, -' +
        '999, G.PRICE, :PRICE_),'
      
        '1102011628=                         G.VOLUME_PRICE = DECODE(:VOL' +
        'UME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '1102011629=                         G.PACK_AMOUNT = DECODE(:PACK' +
        '_AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '1102011630=                         G.barcode         = DECODE(C' +
        'HAR_LENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '1102011631=                         G.MF_COUNTRY  = DECODE(CHAR_' +
        'LENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '1102011632=                         G.PLACE = DECODE(CHAR_LENGTH' +
        '(:PLACE_), 0, G.PLACE, :PLACE_),'
      
        '1102011633=                         G.nomenclatur_num = DECODE(C' +
        'HAR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATU' +
        'R_NUM_),'
      
        '1102011634=                         G.KOD_TNVD        = DECODE(C' +
        'HAR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '1102011635=                         G.CROSSCODE      = COALESCE(' +
        ':CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0,' +
        ' G.CROSSCODE, :CROSSCODE_),'
      
        '1102011636=                         G.BRAND          = DECODE(CH' +
        'AR_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '1102011637=                         G.G_PRODUCT_PAR  = COALESCE(' +
        ':G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '1102011638=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102011639='
      
        '1102011640=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083 +
        #1086#1084' '#39'||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1102011641='
      
        '1102011642=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051 +
        #1048
      '1102011643=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102011644=                      INSERT INTO SYNC_EXT_APP (SYNC_' +
        'EXT_APP, OBJECT_TYPE, ID, OPER)'
      
        '1102011645=                      SELECT GEN_ID(GEN_SYNC_EXT_APP,' +
        ' 1), 4, :G_PRODUCT_, 2'
      '1102011646=                        FROM RDB$DATABASE'
      
        '1102011647=                       WHERE NOT EXISTS (SELECT 1 FRO' +
        'M SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUC' +
        'T_ AND AP.IS_LOADING = 0);'
      '1102011648=              END'
      '1102011649=              ELSE'
      '1102011650=                G_PRODUCT_ = 0;'
      '1102011651=            END ELSE'
      
        '1102011652=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1102011653=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAM' +
        'E_||'#39'.'#39';'
      '1102011654=        END'
      '1102011655=    END ELSE'
      
        '1102011656=      EXECUTE PROCEDURE get_free_articul RETURNING_VA' +
        'LUES (:ARTICUL_);'
      '1102011657='
      
        '1102011658=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1102011659=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '1102011660=    PNT_ = '#39'02a'#39';'
      
        '1102011661=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '1102011662=        SELECT G.G_PRODUCT,'
      '1102011663=               G.NAME'
      '1102011664=          FROM G_PRODUCT G'
      
        '1102011665=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_' +
        'NUM_)'
      '1102011666=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '1102011667=           AND G.IS_ACTIVE = 1'
      '1102011668=          INTO :G_PRODUCT_,'
      '1102011669=               :G_PRODUCT_NAME_;'
      '1102011670='
      
        '1102011671=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1102011672=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1102011673=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1102011674=              UPDATE G_PRODUCT G'
      '1102011675=                 SET G.NAME = :NAME_,'
      '1102011676=                     G.G_UNIT = :G_UNIT_,'
      '1102011677=                     G.PRICE  = :PRICE_,'
      '1102011678=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1102011679=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1102011680=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1102011681=                     G.PLACE = :PLACE_,'
      
        '1102011682=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1102011683=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1102011684=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1102011685=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1102011686=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1102011687=                     ,G.BRAND          = :BRAND_'
      '1102011688=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102011689='
      
        '1102011690=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1102011691=            END ELSE'
      
        '1102011692=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1102011693=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1102011694=        END'
      '1102011695=    end'
      '1102011696=    */'
      '1102011697='
      
        '1102011698=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1102011699=    PNT_ = '#39'02.2'#39';'
      
        '1102011700=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1102011701=        SELECT G.G_PRODUCT,'
      '1102011702=               G.NAME'
      '1102011703=          FROM G_PRODUCT G'
      '1102011704=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1102011705=           AND TRIM(G.BARCODE) <> '#39#39
      '1102011706=           AND G.IS_ACTIVE = 1'
      '1102011707=          INTO :G_PRODUCT_,'
      '1102011708=               :G_PRODUCT_NAME_;'
      '1102011709='
      '1102011710=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1102011711=          SELECT G.G_PRODUCT,'
      '1102011712=                 G.NAME'
      '1102011713=            FROM G_PRODUCT G, LT_BARCODE L'
      '1102011714=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1102011715=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1102011716=             AND TRIM(L.BARCODE) <> '#39#39
      '1102011717=            INTO :G_PRODUCT_,'
      '1102011718=                 :G_PRODUCT_NAME_;'
      '1102011719='
      
        '1102011720=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1102011721=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1102011722=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1102011723=              IF (BARCODE_IS_MAIN_ = 1) THEN BEGIN'
      '1102011724=                  UPDATE G_PRODUCT G'
      '1102011725=                     SET G.NAME = :NAME_,'
      '1102011726=                         G.G_UNIT = :G_UNIT_,'
      
        '1102011727=                         G.PRICE  = DECODE(:PRICE_, -' +
        '999, G.PRICE, :PRICE_),'
      
        '1102011728=                         G.VOLUME_PRICE = DECODE(:VOL' +
        'UME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '1102011729=                         G.PACK_AMOUNT = DECODE(:PACK' +
        '_AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '1102011730=                         G.articul         = DECODE(C' +
        'HAR_LENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '1102011731=                         G.MF_COUNTRY  = DECODE(CHAR_' +
        'LENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '1102011732=                         G.PLACE = DECODE(CHAR_LENGTH' +
        '(:PLACE_), 0, G.PLACE, :PLACE_),'
      
        '1102011733=                         G.nomenclatur_num = DECODE(C' +
        'HAR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATU' +
        'R_NUM_),'
      
        '1102011734=                         G.KOD_TNVD        = DECODE(C' +
        'HAR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '1102011735=                         G.CROSSCODE      = COALESCE(' +
        ':CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0,' +
        ' G.CROSSCODE, :CROSSCODE_),'
      
        '1102011736=                         G.BRAND          = DECODE(CH' +
        'AR_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '1102011737=                         G.G_PRODUCT_PAR  = COALESCE(' +
        ':G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '1102011738=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102011739='
      
        '1102011740=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086 +
        #1076#1086#1084' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1102011741='
      
        '1102011742=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051 +
        #1048
      '1102011743=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102011744=                      INSERT INTO SYNC_EXT_APP (SYNC_' +
        'EXT_APP, OBJECT_TYPE, ID, OPER)'
      
        '1102011745=                      SELECT GEN_ID(GEN_SYNC_EXT_APP,' +
        ' 1), 4, :G_PRODUCT_, 2'
      '1102011746=                        FROM RDB$DATABASE'
      
        '1102011747=                       WHERE NOT EXISTS (SELECT 1 FRO' +
        'M SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUC' +
        'T_ AND AP.IS_LOADING = 0);'
      '1102011748=              END'
      '1102011749=              ELSE'
      '1102011750=                G_PRODUCT_ = 0;'
      '1102011751=            END ELSE'
      
        '1102011752=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1102011753=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1102011754=        END'
      
        '1102011755=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1102011756=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1102011757='
      
        '1102011758=    --===============================================' +
        '=========='
      '1102011759=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '1102011760=    --===============================================' +
        '=========='
      '1102011761=    PNT_ = '#39'02b'#39';'
      '1102011762=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '1102011763='
      '1102011764=        IF (PRICE_ = -999) THEN'
      '1102011765=          PRICE_ = 0;'
      '1102011766=        IF (VOLUME_PRICE_ = -999) THEN'
      '1102011767=          VOLUME_PRICE_ = 0;'
      '1102011768=        IF (PACK_AMOUNT_ = -999) THEN'
      '1102011769=          PACK_AMOUNT_ = 0;'
      '1102011770='
      
        '1102011771=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1102011772=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '1102011773=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1102011774=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '1102011775=        RETURNING G_PRODUCT'
      '1102011776=        INTO :G_PRODUCT_;'
      '1102011777='
      
        '1102011778=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102011779=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102011780='
      '1102011781=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1102011782=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102011783=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, O' +
        'BJECT_TYPE, ID, OPER)'
      
        '1102011784=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :' +
        'G_PRODUCT_, 1);'
      '1102011785=    end'
      '1102011786='
      
        '1102011787=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102011788=    PNT_ = '#39'03'#39';'
      '1102011789=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1102011790=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1102011791=                                       :AMOUNT_,'
      '1102011792=                                       :SELF_PRICE_,'
      
        '1102011793=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1102011794=                                       0, --nds_,'
      '1102011795=                                       0 --nds_summ_,'
      
        '1102011796=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1102011797=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1102011798=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1102011799=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1102011800=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1102011801=          EXIT;'
      '1102011802=        END'
      '1102011803=    END'
      '1102011804='
      
        '1102011805=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1102011806=    PNT_ = '#39'04'#39';'
      '1102011807=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1102011808=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1102011809=        FROM SKLAD_TMP T'
      '1102011810=        INTO :CNT_;'
      '1102011811='
      '1102011812=      if (CNT_ > 0) then BEGIN'
      '1102011813=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1102011814=          FROM SKLAD_TMP T'
      '1102011815=          INTO :SUMM_, :SUMM_UE_;'
      '1102011816='
      '1102011817=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1102011818=                                DATE_RECEIPT,'
      '1102011819=                                TIME_RECEIPT,'
      '1102011820=                                G_CLIENT,'
      '1102011821=                                G_PAYMENT_TYPE,'
      '1102011822=                                OSNOVANIE,'
      '1102011823=                                NOTE,'
      '1102011824=                                SUMM,'
      '1102011825=                                SUMM_FACT,'
      '1102011826=                                SUMM_CURRENCY,'
      '1102011827=                                IS_PAYED_ALL,'
      '1102011828=                                IS_VOZVRAT,'
      '1102011829=                                G_TOCHKA)'
      '1102011830=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1102011831=                CURRENT_DATE,'
      '1102011832=                CURRENT_TIME,'
      '1102011833=                :G_CLIENT_,'
      '1102011834=                1,'
      '1102011835=                NULL,  --:OSNOVANIE_,'
      '1102011836=                NULL,  -- :NOTE_,'
      '1102011837=                :SUMM_,'
      '1102011838=                :SUMM_,'
      '1102011839=                :SUMM_UE_,'
      
        '1102011840=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1102011841=                0,'
      '1102011842=                :G_TOCHKA_)'
      '1102011843=        RETURNING'
      '1102011844=          SKLAD'
      '1102011845=        INTO'
      '1102011846=          :SKLAD_PARENT_;'
      '1102011847='
      '1102011848=        PNT_ = '#39'05'#39';'
      '1102011849=        FOR SELECT SKLAD,'
      '1102011850=                   G_PRODUCT,'
      '1102011851=                   AMOUNT,'
      '1102011852=                   PRICE,'
      '1102011853=                   SUMM'
      '1102011854=                   ,PRICE_CURRENCY'
      '1102011855=                   ,SUMM_CURRENCY'
      '1102011856=              FROM SKLAD_TMP'
      '1102011857=             ORDER BY 1'
      '1102011858=              INTO :SKLAD_TMP_,'
      '1102011859=                   :RG_PRODUCT_,'
      '1102011860=                   :RAMOUNT_,'
      '1102011861=                   :RPRICE_,'
      '1102011862=                   :RSUMM_'
      '1102011863=                   ,:RPRICE_UE_'
      '1102011864=                   ,:RSUMM_UE_'
      '1102011865=        DO BEGIN'
      '1102011866='
      '1102011867=            UPDATE SKLAD SK'
      '1102011868=               SET SK.IS_LAST = 0'
      '1102011869=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1102011870=               AND SK.IS_LAST = 1;'
      '1102011871='
      '1102011872=            INSERT INTO SKLAD'
      '1102011873=            ('
      '1102011874=             SKLAD,'
      '1102011875=             SKLAD_PARENT,'
      '1102011876=             DATE_RECEIPT,'
      '1102011877=             G_CLIENT,'
      '1102011878=             G_PRODUCT,'
      '1102011879=             AMOUNT,'
      '1102011880=             PRICE,'
      '1102011881=             SUMM,'
      '1102011882=             G_PAYMENT_TYPE,'
      '1102011883=             OSNOVANIE,'
      '1102011884=             NOTE,'
      '1102011885=             NDS,'
      '1102011886=             NDS_SUMM,'
      '1102011887=             IS_LAST,'
      '1102011888=             IS_VOZVRAT,'
      '1102011889=             G_TOCHKA'
      '1102011890=             ,PRICE_CURRENCY'
      '1102011891=             ,SUMM_CURRENCY'
      '1102011892=            ) VALUES ('
      '1102011893=             :SKLAD_TMP_,'
      '1102011894=             :SKLAD_PARENT_,'
      '1102011895=             CURRENT_DATE,'
      '1102011896=             :G_CLIENT_,'
      '1102011897=             :RG_PRODUCT_,'
      '1102011898=             :RAMOUNT_,'
      '1102011899=             :RPRICE_,'
      '1102011900=             :RSUMM_,'
      '1102011901=             1,       --:G_PAYMENT_TYPE_,'
      '1102011902=             NULL,    --:OSNOVANIE_,'
      '1102011903=             NULL,    --:NOTE_,'
      '1102011904=             0,       --:RNDS_,'
      '1102011905=             0,       --:RNDS_SUMM_,'
      '1102011906=             1,       --IS_LAST_'
      '1102011907=             0,        --:IS_VOZVRAT_'
      '1102011908=             :G_TOCHKA_'
      '1102011909=             ,:RPRICE_UE_'
      '1102011910=             ,:RSUMM_UE_'
      '1102011911=            );'
      '1102011912='
      
        '1102011913=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1102011914=            PNT_ = '#39'06'#39';'
      '1102011915=            UPDATE LT_SKLAD_PRODUCT L'
      '1102011916=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      
        '1102011917=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102011918=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1102011919=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102011920='
      '1102011921=            PNT_ = '#39'06a'#39';'
      '1102011922=            IF (ROW_COUNT = 0) THEN'
      
        '1102011923=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EX' +
        'PORT)'
      
        '1102011924=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102011925=        END'
      '1102011926='
      '1102011927=        PNT_ = '#39'07'#39';'
      
        '1102011928=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102011929=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1102011930=                                :SUMM_,'
      '1102011931=                                CURRENT_DATE,'
      
