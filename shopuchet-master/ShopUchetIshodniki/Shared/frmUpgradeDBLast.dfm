        '11017081=  PRICE_SELF /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(1' +
        '5,2),'
      
        '11017082=  SUMM_SELF /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,' +
        '2),'
      '11017083=  TOVAR_NAME VARCHAR(250),'
      
        '11017084=  CROSSCODE /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ BL' +
        'OB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '11017085=  NOTE /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300)' +
        ','
      
