      '1106017414=ALTER PROCEDURE G_READ_G_FIRM_ACCOUNT_LIST('
      
        '1106017415=  G_FIRM_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_FIRM_REKVI' +
        'ZIT)'
      '1106017416=RETURNS ('
      '1106017417=  G_ACCOUNT TYPE OF COLUMN G_FIRM_ACCOUNT.G_ACCOUNT,'
      '1106017418=  ACCOUNT TYPE OF COLUMN G_FIRM_ACCOUNT.ACCOUNT,'
      
        '1106017419=  G_FIRM_REKVIZIT TYPE OF COLUMN G_FIRM_ACCOUNT.G_FIR' +
        'M_REKVIZIT,'
      '1106017420=  G_BANK TYPE OF COLUMN G_FIRM_ACCOUNT.G_BANK,'
      
        '1106017421=  IS_DEFAULT TYPE OF COLUMN G_FIRM_ACCOUNT.IS_DEFAULT' +
        ','
      '1106017422=  BIK TYPE OF COLUMN G_BANK.BIK,'
      '1106017423=  NAME TYPE OF COLUMN G_BANK.NAME,'
      '1106017424=  ACC_BIK VARCHAR(200))'
      '1106017425=AS'
      '1106017426=begin'
      '1106017427=  IF (G_FIRM_ is null) THEN'
      '1106017428=    G_FIRM_ = 0;'
      '1106017429='
      '1106017430=  FOR'
      
        '1106017431=    select T.G_ACCOUNT, T.ACCOUNT, T.G_FIRM_REKVIZIT,' +
        ' T.G_BANK, T.IS_DEFAULT,'
      
        '1106017432=           G.BIK, G.NAME, T.ACCOUNT||'#39' '#1074' '#39'||G.NAME||'#39 +
        ', '#1041#1048#1050':'#39'||G.BIK'
      '1106017433=    from G_FIRM_ACCOUNT t,'
      '1106017434=         g_bank g'
      '1106017435=     WHERE T.G_BANK = G.G_BANK'
      
        '1106017436=       AND T.g_firm_rekvizit = DECODE(:g_firm_, 0, T.' +
        'g_firm_rekvizit, :G_FIRM_)'
      '1106017437=     order by 1'
      
        '1106017438=    into :G_ACCOUNT, :ACCOUNT, :G_FIRM_REKVIZIT, :G_B' +
        'ANK, :IS_DEFAULT,'
      '1106017439=         :BIK, :NAME, :ACC_BIK'
      '1106017440=  DO'
      '1106017441=    suspend;'
      '1106017442=end'
      '1106017443=;'
      '1106017444='
      '1106017445=ALTER PROCEDURE G_READ_G_FIRM_ADDRESS_LIST('
      
        '1106017446=  G_FIRM_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_FIRM_REKVI' +
        'ZIT)'
      '1106017447=RETURNS ('
      '1106017448=  G_ADDRESS TYPE OF COLUMN G_FIRM_ADDRESS.G_ADDRESS,'
      
        '1106017449=  G_ADDRESS_TYPE TYPE OF COLUMN G_FIRM_ADDRESS.G_ADDR' +
        'ESS_TYPE,'
      
        '1106017450=  G_FIRM_REKVIZIT TYPE OF COLUMN G_FIRM_ADDRESS.G_FIR' +
        'M_REKVIZIT,'
      '1106017451=  ADDRESS TYPE OF COLUMN G_FIRM_ADDRESS.ADDRESS,'
      '1106017452=  PHONE TYPE OF COLUMN G_FIRM_ADDRESS.PHONE,'
      '1106017453=  FAX TYPE OF COLUMN G_FIRM_ADDRESS.FAX,'
      
        '1106017454=  IS_DEFAULT TYPE OF COLUMN G_FIRM_ADDRESS.IS_DEFAULT' +
        ','
      
        '1106017455=  ADDRESS_TYPE_STR TYPE OF COLUMN G_ADDRESS_TYPE.NAME' +
        ')'
      '1106017456=AS'
      '1106017457=begin'
      '1106017458=  IF (G_FIRM_ is null) THEN'
      '1106017459=    G_FIRM_ = 0;'
      '1106017460='
      '1106017461=  FOR'
      
        '1106017462=    select t.G_ADDRESS, t.G_ADDRESS_TYPE, t.G_FIRM_RE' +
        'KVIZIT, t.ADDRESS, t.PHONE, t.FAX, t.IS_DEFAULT,'
      '1106017463=           g.NAME'
      '1106017464=    from G_FIRM_ADDRESS t,'
      '1106017465=         g_address_type g'
      '1106017466=     WHERE T.G_ADDRESS_TYPE = G.G_ADDRESS_TYPE'
      
        '1106017467=       AND T.g_firm_rekvizit = DECODE(:g_firm_, 0, T.' +
        'g_firm_rekvizit, :G_FIRM_)'
      
        '1106017468=    into :G_ADDRESS, :G_ADDRESS_TYPE, :G_FIRM_REKVIZI' +
        'T, :ADDRESS, :PHONE, :FAX, :IS_DEFAULT,'
      '1106017469=         :ADDRESS_TYPE_STR'
      '1106017470=  DO'
      '1106017471=    suspend;'
      '1106017472=end'
      '1106017473=;'
      '1106017474='
      '1106017475=ALTER PROCEDURE G_READ_G_OFFICIAL_LIST'
      '1106017476=RETURNS ('
      '1106017477=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106017478=  FM TYPE OF COLUMN G_OFFICIAL.FM,'
      '1106017479=  NM TYPE OF COLUMN G_OFFICIAL.NM,'
      '1106017480=  FT TYPE OF COLUMN G_OFFICIAL.FT,'
      '1106017481=  FIO VARCHAR(200),'
      '1106017482=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106017483=  RNN TYPE OF COLUMN G_OFFICIAL.RNN,'
      '1106017484=  IDN TYPE OF COLUMN G_OFFICIAL.IDN,'
      '1106017485=  DT TYPE OF COLUMN G_OFFICIAL.DT,'
      '1106017486=  G_ID_KIND TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '1106017487=  ID_NUM TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '1106017488=  ID_DATE TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '1106017489=  ID_ISSUER TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '1106017490=  G_APPOINTMENT TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '1106017491=  IS_RUKOVODITEL TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '1106017492=  IS_GLAVBUH TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      '1106017493=  APP_NAME TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '1106017494=  PASS TYPE OF COLUMN G_OFFICIAL.PASS)'
      '1106017495=AS'
      '1106017496=begin'
      '1106017497=    FOR'
      '1106017498=    SELECT t.G_OFFICIAL,'
      '1106017499=           T.FM,'
      '1106017500=           T.NM,'
      '1106017501=           T.FT,'
      '1106017502=           T.FM||'#39' '#39'||T.NM||'#39' '#39'||T.FT,'
      
        '1106017503=           DECODE(CHAR_LENGTH(T.FIO_DOC), 0, T.FM||'#39' ' +
        #39'||T.NM||'#39' '#39'||T.FT, T.FIO_DOC),'
      '1106017504=           T.RNN,'
      '1106017505=           T.IDN,'
      '1106017506=           T.DT,'
      '1106017507=           T.G_ID_KIND,'
      '1106017508=           T.ID_NUM,'
      '1106017509=           T.ID_DATE,'
      '1106017510=           T.ID_ISSUER,'
      '1106017511=           T.G_APPOINTMENT,'
      '1106017512=           T.IS_RUKOVODITEL,'
      '1106017513=           T.IS_GLAVBUH,'
      '1106017514=           G.NAME APP_NAME'
      '1106017515=           ,T.PASS'
      
        '1106017516=      FROM g_OFFICIAL t LEFT OUTER JOIN G_APPOINTMENT' +
        ' G ON T.G_APPOINTMENT = G.G_APPOINTMENT'
      '1106017517=     WHERE T.G_APPOINTMENT = G.G_APPOINTMENT'
      '1106017518=    ORDER BY T.G_OFFICIAL, T.FM, T.NM, T.FT'
      '1106017519=    INTO :G_OFFICIAL,'
      '1106017520=        :FM,'
      '1106017521=        :NM,'
      '1106017522=        :FT,'
      '1106017523=        :FIO,'
      '1106017524=        :FIO_DOC,'
      '1106017525=        :RNN,'
      '1106017526=        :IDN,'
      '1106017527=        :DT,'
      '1106017528=        :G_ID_KIND,'
      '1106017529=        :ID_NUM,'
      '1106017530=        :ID_DATE,'
      '1106017531=        :ID_ISSUER,'
      '1106017532=        :G_APPOINTMENT,'
      '1106017533=        :IS_RUKOVODITEL,'
      '1106017534=        :IS_GLAVBUH,'
      '1106017535=        :APP_NAME'
      '1106017536=        ,:PASS'
      '1106017537=    DO'
      '1106017538=      SUSPEND;'
      '1106017539=end'
      '1106017540=;'
      '1106017541='
      '1106017542=ALTER PROCEDURE G_READ_G_OFFICIAL_RIGHTS('
      '1106017543=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '1106017544=RETURNS ('
      
        '1106017545=  RIGHTS_ITEM TYPE OF COLUMN G_OFFICIAL_RIGHT.RIGHTS_' +
        'ITEM)'
      '1106017546=AS'
      
        '1106017547=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICI' +
        'AL.G_OFFICIAL;'
      '1106017548=BEGIN'
      '1106017549=  if (G_OFFICIAL_ IS NULL) then'
      '1106017550=    SELECT ID'
      '1106017551=      FROM CUR_PARAMS'
      '1106017552=     WHERE CUR_PARAMS = 1'
      '1106017553=      INTO :G_OFFICIAL__;'
      '1106017554=  ELSE'
      '1106017555=    G_OFFICIAL__ = G_OFFICIAL_;'
      '1106017556='
      '1106017557=  FOR SELECT RIGHTS_ITEM'
      '1106017558=        FROM G_OFFICIAL_RIGHT'
      '1106017559=       WHERE G_OFFICIAL = :G_OFFICIAL__'
      '1106017560=        INTO :RIGHTS_ITEM'
      '1106017561=  DO SUSPEND;'
      '1106017562=end'
      '1106017563=;'
      '1106017564='
