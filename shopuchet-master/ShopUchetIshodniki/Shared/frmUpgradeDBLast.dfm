      '1102491306=  END'
      '1102491307=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102491308=  ----------------------------------------'
      '1102491309=  ----------------------------------------'
      '1102491310=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1102491311=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1102491312=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102491313=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102491314=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1102491315=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102491316=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102491317=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102491318=      RETURNING SKLAD'
      '1102491319=      INTO :ZAKAZ_;'
      '1102491320='
      '1102491321=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102491322=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102491323=          INTO :G_PRODUCT,'
      '1102491324=              :AMOUNT,'
      '1102491325=              :PRICE,'
      '1102491326=              :SUMM'
      '1102491327=      DO BEGIN'
      '1102491328=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102491329=        UPDATE LT_SKLAD_PRODUCT L'
      '1102491330=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1102491331=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102491332=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102491333=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102491334='
      '1102491335=        IF (ROW_COUNT = 0) THEN'
      
        '1102491336=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102491337=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102491338='
      '1102491339=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102491340=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1102491341=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1102491342=        SELECT MAX(SK.DATE_RECEIPT)'
      '1102491343=            FROM SKLAD SK'
      '1102491344=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102491345=             AND SK.IS_LAST = 1'
      '1102491346=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1102491347=            INTO :DATE_LAST_;'
      '1102491348='
      
        '1102491349=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102491350=            UPDATE SKLAD SK'
      '1102491351=               SET SK.IS_LAST = 0'
      '1102491352=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102491353=               AND SK.IS_LAST = 1'
      '1102491354=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102491355='
      '1102491356=            IS_THIS_LAST_ = 1;'
      '1102491357=        END */'
      '1102491358='
      '1102491359='
      '1102491360=        INSERT INTO SKLAD'
      '1102491361=        ('
      '1102491362=         SKLAD,'
      '1102491363=         SKLAD_PARENT,'
      '1102491364=         DATE_RECEIPT,'
      '1102491365=         G_CLIENT,'
      '1102491366=         G_PRODUCT,'
      '1102491367=         AMOUNT,'
      '1102491368=         PRICE,'
      '1102491369=         SUMM,'
      '1102491370=         G_PAYMENT_TYPE,'
      '1102491371=         OSNOVANIE,'
      '1102491372=         NOTE,'
      '1102491373=         NDS,'
      '1102491374=         NDS_SUMM,'
      '1102491375=         IS_LAST,'
      '1102491376=         IS_VOZVRAT,'
      '1102491377=         G_TOCHKA'
      '1102491378=        ) VALUES ('
      '1102491379=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102491380=         :ZAKAZ_,'
      '1102491381=         :Z_DATE_,'
      '1102491382=         :G_TOCHKA_,'
      '1102491383=         :G_PRODUCT,'
      '1102491384=         :AMOUNT,'
      '1102491385=         :PRICE,'
      '1102491386=         :SUMM,'
      '1102491387=         :G_PAYMENT_TYPE_,'
      '1102491388=         :OSNOVANIE_,'
      '1102491389=         :NOTE_,'
      '1102491390=         0,  --:RNDS_,'
      '1102491391=         0,  --:RNDS_SUMM_,'
      
        '1102491392=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102491393=         3,  --:IS_VOZVRAT_,'
      '1102491394=         :G_CLIENT_'
      '1102491395=        );'
      '1102491396='
      
        '1102491397=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102491398=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102491399=        PNT_ = '#39'02'#39';'
      '1102491400=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102491401=            UPDATE LT_SKLAD_PRODUCT L'
      '1102491402=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102491403=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102491404=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102491405=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102491406='
      '1102491407=            IF (ROW_COUNT = 0) THEN'
      
        '1102491408=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102491409=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102491410=        END'
      '1102491411=      END'
      '1102491412=  END'
      '1102491413='
      '1102491414=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102491415='
      
        '1102491416=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102491417=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102491418=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102491419=                                  G_PRIHOD_,'
      '1102491420=                                  :SUMM_PRIHOD_,'
      '1102491421=                                  :Z_DATE_,'
      
        '1102491422=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102491423=                                  :ZAKAZ_,'
      '1102491424=                                  NULL,'
      '1102491425=                                  :G_PAYMENT_TYPE_,'
      '1102491426=                                  :G_TOCHKA_,'
      '1102491427=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102491428=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102491429=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102491430=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102491431=      EXIT;'
      '1102491432=    END'
      '1102491433=  END'
      '1102491434='
      
        '1102491435=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102491436=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102491437=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102491438=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102491439='
      '1102491440=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102491441=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102491442='
      '1102491443=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102491444=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102491445=end'
      '1102491446=;'
      '1102491447='
      '1102491448=ALTER PROCEDURE LOG_INIT'
      '1102491449=AS'
      '1102491450=DECLARE VARIABLE TN VARCHAR(64);'
      '1102491451=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '1102491452=DECLARE VARIABLE FN VARCHAR(64);'
      '1102491453=DECLARE VARIABLE TP INTEGER;'
      
        '1102491454=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102491455=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102491456=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102491457=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80; /* VARCHAR(30000); */'
      '1102491458=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '1102491459=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '1102491460=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '1102491461=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000) */'
      
        '1102491462=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      
        '1102491463=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      '1102491464=DECLARE VARIABLE ANZ INTEGER;'
      '1102491465=DECLARE VARIABLE L INTEGER;'
      '1102491466=DECLARE VARIABLE P INTEGER;'
      '1102491467=DECLARE VARIABLE S INTEGER;'
      '1102491468=DECLARE VARIABLE FT CHAR(1);'
      '1102491469=DECLARE VARIABLE CRLF VARCHAR(10);'
      '1102491470=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '1102491471=BEGIN'
      '1102491472=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '1102491473='
      '1102491474=  TN_ALT='#39#39';'
      '1102491475=  TRGI='#39#39';'
      '1102491476=  TRGU='#39#39';'
      '1102491477=  TRGD='#39#39';'
      '1102491478=  TRGIX='#39#39';'
      '1102491479=  TRGUX='#39#39';'
      '1102491480=  TRGDX='#39#39';'
      '1102491481=  SQLF='#39#39';'
      '1102491482=  SQLV='#39#39';'
      '1102491483=  SQLU='#39#39';'
      '1102491484=  FT='#39#39';'
      '1102491485='
      '1102491486=  FOR SELECT R.RDB$RELATION_NAME,'
      '1102491487=            R.RDB$FIELD_NAME,'
      '1102491488=            F.RDB$FIELD_TYPE,'
      '1102491489=            F.RDB$FIELD_LENGTH,'
      '1102491490=            F.RDB$FIELD_PRECISION,'
      '1102491491=            F.RDB$FIELD_SCALE'
      '1102491492=        FROM RDB$RELATION_FIELDS R,'
      '1102491493=             RDB$FIELDS F'
      '1102491494=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1102491495=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '1102491496=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '1102491497=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39 +
        ', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '1102491498=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1102491499=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1102491500=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1102491501=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1102491502=                                         '#39'RIGHTS_ITEM' +
        #39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1102491503=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PRO' +
        'DUCT_FILL'#39','
      
        '1102491504=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39','#39'REVISION_TMP'#39','#39'UPLOAD_T' +
        'ABLE_TMP'#39','
      
        '1102491505=                                         '#39'KASPI_CITY'#39 +
        ','#39'KASPI_POINT'#39')'
      '1102491506=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '1102491507=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '1102491508=              OR'
      
        '1102491509=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD' +
        '_SUB_TYPE <> 0)'
      '1102491510=             )'
      
        '1102491511=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSIT' +
        'ION'
      '1102491512=        INTO :TN,:FN,:TP,:L,:P,:S'
      '1102491513=  DO BEGIN'
      '1102491514=    TN=TRIM(TN);'
      '1102491515=    FN=TRIM(FN);'
      '1102491516=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '1102491517=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '1102491518=      EXECUTE STATEMENT TRGI;'
      '1102491519=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '1102491520=      EXECUTE STATEMENT TRGU;'
      '1102491521=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '1102491522=      EXECUTE STATEMENT TRGD;'
      '1102491523='
      '1102491524=      SQLF='#39#39';'
      '1102491525=      SQLV='#39#39';'
      '1102491526=      SQLU='#39#39';'
      '1102491527=    END'
      '1102491528=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '1102491529=      ID_COLUMN = FN;'
      '1102491530='
      '1102491531=    S=-S;'
      
        '1102491532=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp' +
        '=27)) then'
      '1102491533=      ft='#39'N'#39';   --numerisch'
      '1102491534=    else'
      '1102491535=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '1102491536=        ft='#39'Z'#39';   --zeit'
      '1102491537=      else'
      '1102491538=        ft='#39'T'#39';'
      '1102491539='
      '1102491540=    IF (SQLF='#39#39') THEN'
      '1102491541=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '1102491542=    ELSE'
      '1102491543=      SQLF=SQLF||'#39','#39'||FN;'
      '1102491544='
      '1102491545=    if (ft='#39'N'#39') then begin'
      '1102491546=      IF (SQLV='#39#39') THEN'
      
        '1102491547=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102491548=      ELSE'
      
        '1102491549=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102491550='
      '1102491551=      IF (SQLU='#39#39') THEN'
      
        '1102491552=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UP' +
        'DATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102491553=      ELSE'
      
        '1102491554=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'|' +
        '|FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102491555=    end'
      '1102491556=    else'
      '1102491557=      if (ft='#39'Z'#39') then begin'
      '1102491558=        IF (SQLV='#39#39') THEN'
      
        '1102491559=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||r' +
        'eplace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102491560=        ELSE'
      
        '1102491561=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||r' +
        'eplace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102491562='
      '1102491563=        IF (SQLU='#39#39') THEN'
      
        '1102491564=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39 +
        'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRI' +
        'M(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39 +
        #39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102491565=        ELSE'
      
        '1102491566=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39',' +
        #39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39 +
        #39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF' +
        ';'
      '1102491567=    end'
      '1102491568=    else begin'
      '1102491569=      IF (SQLV='#39#39') THEN'
      
        '1102491570=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||rep' +
        'lace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CR' +
        'LF;'
      '1102491571=      ELSE'
      
        '1102491572=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||rep' +
        'lace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CR' +
        'LF;'
      '1102491573='
      '1102491574=      IF (SQLU='#39#39') THEN'
      
        '1102491575=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UP' +
        'DATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39 +
        #39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102491576=      ELSE'
      
        '1102491577=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'|' +
        '|FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102491578=    end'
      '1102491579=    SELECT COUNT(*)'
      '1102491580=      FROM RDB$TRIGGERS'
      '1102491581=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGI'#39
      '1102491582=      INTO :ANZ;'
      '1102491583='
      '1102491584=    IF (ANZ>0) THEN'
      '1102491585=      TRGIX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGI'#39';'
      '1102491586=    ELSE'
      '1102491587=      TRGIX='#39#39';'
      '1102491588='
      
        '1102491589=    TRGI='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGI FOR '#39'||TN||'#39' A' +
        'CTIVE AFTER INSERT POSITION 255 AS '#39'||CRLF||'
      
        '1102491590=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SE' +
        'GMENT SIZE 80;'#39'||CRLF||'
      '1102491591=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '1102491592=         '#39'BEGIN'#39'||CRLF||'
      
        '1102491593=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39 +
        'REPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39' ||CRLF;'
      '1102491594='
      '1102491595=    IF (TN = '#39'LT_SKLAD_PRODUCT'#39') THEN BEGIN'
      '1102491596='
      
