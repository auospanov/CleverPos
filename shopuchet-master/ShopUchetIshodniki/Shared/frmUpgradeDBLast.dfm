        'DUCT.SALES_COMM;'
      
        '1101852318=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101852319=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1101852320=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1101852321=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101852322=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1101852323=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1101852324=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1101852325=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1101852326=BEGIN'
      '1101852327='
      '1101852328=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101852329=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101852330=      SELECT Z.G_PAYMENT_TYPE,'
      '1101852331=             Z.G_TOCHKA,'
      '1101852332=             Z.SUMM,'
      '1101852333=             Z.SUMM_BONUS,'
      '1101852334=             Z.SUMM_BONUS_GOT,'
      '1101852335=             z.g_client,'
      '1101852336=             Z.G_OFFICIAL,'
      '1101852337=             G.DO_NOT_SALES_COMM,'
      '1101852338=             G.FM||'#39' '#39'||G.NM'
      
        '1101852339=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101852340=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101852341=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1101852342=             :G_TOCHKA_,'
      '1101852343=             :SUMM_OLD_,'
      '1101852344=             :SUMM_BONUS_OLD_,'
      '1101852345=             :SUMM_BONUS_GOT_OLD_,'
      '1101852346=             :g_client_old_,'
      '1101852347=             :G_OFFICIAL_,'
      '1101852348=             :DO_NOT_SALES_COMM_,'
      '1101852349=             :OFFICIAL_NAME_;'
      '1101852350='
      
        '1101852351=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101852352=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1101852353=        SELECT SUM(ZD.SALES_COMM)'
      '1101852354=          FROM ZAKAZ_DETAILS ZD'
      '1101852355=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101852356=          INTO :SALES_COMM_OLD_;'
      '1101852357='
      '1101852358=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101852359=      PNT_ = '#39'02'#39';'
      
        '1101852360=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101852361=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101852362=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101852363=        EXIT;'
      '1101852364=      END'
      '1101852365='
      
        '1101852366=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101852367=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101852368=      ELSE'
      '1101852369=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101852370='
      '1101852371=      PNT_ = '#39'01'#39';'
      '1101852372=      UPDATE zakaz'
      '1101852373=      SET'
      '1101852374=       G_TOCHKA = :G_TOCHKA_,'
      '1101852375=       Z_DATE = :Z_DATE_,'
      '1101852376=       Z_TIME = :Z_TIME_,'
      '1101852377=       G_CLIENT = :G_CLIENT_,'
      '1101852378=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101852379=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101852380=       NOTE = COALESCE(:NOTE_, NOTE),'
      
        '1101852381=       DELIVERY_ADDRESS = COALESCE(:ADDRESS_, DELIVER' +
        'Y_ADDRESS),'
      '1101852382=       SUMM = :SUMM_,'
      '1101852383=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1101852384=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101852385=       ,BY_RECIPE = :BY_RECIPE_'
      '1101852386=       ,IS_RESERVE = :IS_RESERVE_'
      '1101852387=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1101852388=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1101852389=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1101852390=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1101852391=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1101852392=      WHERE'
      '1101852393=        zakaz = :zakaz_;'
      '1101852394='
      
        '1101852395=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1101852396=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1101852397=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1101852398=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1101852399=          UPDATE G_DISCONT_CARD D'
      '1101852400=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1101852401=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1101852402=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1101852403='
      
        '1101852404=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1101852405=          SUMM_OLD_           = 0;'
      '1101852406=      END'
      '1101852407=      UPDATE G_DISCONT_CARD D'
      
        '1101852408=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1101852409=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1101852410=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1101852411='
      '1101852412=      PNT_ = '#39'03'#39';'
      '1101852413=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1101852414=                 T.G_PRODUCT,'
      '1101852415=                 T.AMOUNT,'
      '1101852416=                 T.SUMM,'
      '1101852417=                 G.SALES_COMM'
      '1101852418=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1101852419=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1101852420=      INTO :ZAKAZ_DETAILS_,'
      '1101852421=           :G_PRODUCT_,'
      '1101852422=           :Z_AMOUNT_,'
      '1101852423=           :DETAILS_SUMM_,'
      '1101852424=           :SALES_COMM_'
      '1101852425=      DO BEGIN'
      
        '1101852426=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101852427=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1101852428=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1101852429=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101852430=        END'
      '1101852431='
      
        '1101852432=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101852433=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1101852434=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101852435=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1101852436=          FROM ZAKAZ_DETAILS_TMP Z'
      '1101852437=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1101852438='
      '1101852439=        -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1101852440=        IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1101852441=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' ' +
        #1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1101852442=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN'
      '1101852443=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101852444=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1101852445=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1101852446=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101852447=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101852448='
      '1101852449=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101852450=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101852451=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101852452=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :Z_AMOUNT_'
      '1101852453=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101852454=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101852455=        END'
      '1101852456=      END'
      '1101852457='
      '1101852458=      ----------------------------------------'
      
        '1101852459=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101852460=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1101852461=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1101852462=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101852463=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101852464=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1101852465=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101852466=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101852467=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1101852468=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1101852469=                PNT_ = '#39'04'#39';'
      
        '1101852470=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101852471=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101852472=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101852473=                ELSE'
      
        '1101852474=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101852475='
      
        '1101852476=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101852477=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101852478='
      
        '1101852479=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101852480='
      '1101852481=                PNT_ = '#39'05'#39';'
      
        '1101852482=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN BEGIN'
      
        '1101852483=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101852484=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101852485=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101852486=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101852487=                                                  NUL' +
