      '110239799=ALTER TABLE LOGS ALTER COLUMN ID POSITION 1;'
      '110239800='
      '110239801=ALTER TABLE LOGS ALTER COLUMN ID_ORIGINAL POSITION 2;'
      '110239802='
      '110239803=ALTER TABLE LOGS ALTER COLUMN SQLSTMT POSITION 3;'
      '110239804='
