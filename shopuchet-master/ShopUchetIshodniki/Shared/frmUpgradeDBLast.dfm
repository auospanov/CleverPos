      '110752641=                      INTO :DATE_LAST_;'
      '110752642='
      
        '110752643=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110752644=                      UPDATE SKLAD SK'
      '110752645=                         SET SK.IS_LAST = 0'
      
        '110752646=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110752647='
      '110752648=                       UPDATE SKLAD SK'
      '110752649=                         SET SK.IS_LAST = 1'
      
        '110752650=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      
        '110752651=                         AND SK.SKLAD = (SELECT MAX(SS' +
        '.SKLAD)'
      
        '110752652=                                           FROM SKLAD ' +
        'SS'
      
        '110752653=                                          WHERE SS.G_P' +
        'RODUCT = SK.G_PRODUCT'
      
        '110752654=                                            AND SS.DAT' +
        'E_RECEIPT = :DATE_LAST_'
      
        '110752655=                                            AND SS.G_T' +
        'OCHKA = :G_CLIENT_'
      
        '110752656=                                            AND SS.is_' +
        'vozvrat IN (0,3,4));'
      '110752657=                    END'
      '110752658=                END'
      '110752659=            END'
      '110752660=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '110752661=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '110752662='
      '110752663=      UPDATE SKLAD_PARENT'
      '110752664=      SET'
      
        '110752665=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110752666=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      
        '110752667=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),    ' +
        '   -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110752668=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110752669=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110752670=       SUMM      = :SUMM_,'
      '110752671=       SUMM_FACT = :SUMM_FACT_'
      '110752672=      WHERE SKLAD  = :ZAKAZ_;'
      '110752673=  END'
      '110752674='
      '110752675=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110752676=END'
      '110752677=;'
      
        '110752678=UPDATE SYSTEM_SETUP SET S_VALUE = 11075 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '110752679=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110752680=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '110760=UPDATE SYSTEM_SETUP SET S_VALUE = 11075 WHERE SYSTEM_SETU' +
        'P = 3;'
      
        '110761=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB$' +
        'DESCRIPTION=NULL;'
      '110762=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110770=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '110771=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110772=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_N' +
        'UM,'
      '110773=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110774=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110775=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110776=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110777=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110778=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110779=  SELF_PRICE_ NUMERIC(15,2),'
      '1107710=  AMOUNT_ MY_NUMERIC_5,'
      '1107711=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1107712=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1107713=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1107714=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1107715=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1107716=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1107717=  CATEGORY_NAME_ VARCHAR(1000),'
      '1107718=  IS_THIS_LAST_ INTEGER,'
      '1107719=  UPDATE_IF_EXIST_ INTEGER)'
      '1107720=RETURNS ('
      '1107721=  ERR_CODE INTEGER,'
      '1107722=  ERR_MSG VARCHAR(1024))'
      '1107723=AS'
      
        '1107724=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PROD' +
        'UCT'#39';'
      '1107725=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1107726=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1107727=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT_PAR;'
      
        '1107728=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT_PAR;'
      '1107729=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '1107730=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT = 0;'
      
        '1107731=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '1107732=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.SKLAD;'
      '1107733=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM;'
      
        '1107734=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM_CURRENCY;'
      '1107735=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1107736=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1107737=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD =' +
        ' 0;'
      
        '1107738=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      
        '1107739=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT = ' +
        '0;'
      '1107740=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1107741=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1107742=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1107743=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1107744=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1107745=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOC' +
        'HKA;'
      '1107746=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1107747=DECLARE VARIABLE STR_      TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '1107748=BEGIN'
      '1107749=    ERR_MSG = '#39#39';'
      '1107750='
      '1107751=    SELECT ID'
      '1107752=      FROM CUR_PARAMS'
      '1107753=    WHERE CUR_PARAMS = 2'
      '1107754=      INTO :G_TOCHKA_;'
      '1107755='
      '1107756=    SELECT G.G_UNIT'
      '1107757=      FROM G_UNIT G'
      
        '1107758=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_G' +
        '_UNIT_))'
      '1107759=      INTO :G_UNIT_;'
      '1107760=    if (ROW_COUNT = 0) then'
      '1107761=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1107762='
      '1107763=    PNT_ = '#39'02'#39';'
      
        '1107764=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053 +
        #1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1107765=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1107766=        SELECT G.G_PRODUCT,'
      '1107767=               G.NAME'
      '1107768=          FROM G_PRODUCT G'
      '1107769=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '1107770=           AND TRIM(G.ARTICUL) <> '#39#39
      '1107771=          INTO :G_PRODUCT_,'
      '1107772=               :G_PRODUCT_NAME_;'
      '1107773='
      
        '1107774=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042#1048 +
        #1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1107775=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1107776=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1107777=              UPDATE G_PRODUCT G'
      '1107778=                 SET G.NAME = :NAME_,'
      '1107779=                     G.G_UNIT = :G_UNIT_,'
      '1107780=                     G.PRICE  = :PRICE_,'
      '1107781=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1107782=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1107783=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1107784=                     G.PLACE = :PLACE_,'
      
        '1107785=                     G.articul         = DECODE(CHAR_LEN' +
        'GTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1107786=                     G.nomenclatur_num = DECODE(CHAR_LEN' +
        'GTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclatu' +
        'r_num),'
      
        '1107787=                     G.barcode         = DECODE(CHAR_LEN' +
        'GTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1107788=                     G.KOD_TNVD        = DECODE(CHAR_LEN' +
        'GTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1107789=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1107790='
      
        '1107791=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||U' +
        'PPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1107792=            END ELSE'
      
        '1107793=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CLI' +
        'ENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042#1067 +
        #1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1107794=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||UP' +
        'PER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME_|' +
        '|'#39'.'#39';'
      '1107795=        END'
      '1107796=    END ELSE'
      
        '1107797=      EXECUTE PROCEDURE get_free_articul RETURNING_VALUE' +
        'S (:ARTICUL_);'
      '1107798='
      
        '1107799=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052', ' +
        #1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11077100=    PNT_ = '#39'02a'#39';'
      
        '11077101=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11077102=        SELECT G.G_PRODUCT,'
      '11077103=               G.NAME'
      '11077104=          FROM G_PRODUCT G'
      
        '11077105=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_NU' +
        'M_)'
      '11077106=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '11077107=          INTO :G_PRODUCT_,'
      '11077108=               :G_PRODUCT_NAME_;'
      '11077109='
      
        '11077110=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11077111=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11077112=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11077113=              UPDATE G_PRODUCT G'
      '11077114=                 SET G.NAME = :NAME_,'
      '11077115=                     G.G_UNIT = :G_UNIT_,'
      '11077116=                     G.PRICE  = :PRICE_,'
      '11077117=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11077118=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11077119=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11077120=                     G.PLACE = :PLACE_,'
      
        '11077121=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11077122=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11077123=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11077124=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11077125=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11077126='
      
        '11077127=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077 +
        #1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11077128=            END ELSE'
      
        '11077129=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11077130=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39 +
        '||G_PRODUCT_NAME_||'#39'.'#39';'
      '11077131=        END'
      '11077132=    end'
      '11077133='
      
        '11077134=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11077135=    PNT_ = '#39'02b'#39';'
      
        '11077136=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11077137=        SELECT G.G_PRODUCT,'
      '11077138=               G.NAME'
      '11077139=          FROM G_PRODUCT G'
      '11077140=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11077141=           AND TRIM(G.BARCODE) <> '#39#39
      '11077142=          INTO :G_PRODUCT_,'
      '11077143=               :G_PRODUCT_NAME_;'
      '11077144='
      '11077145=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11077146=          SELECT G.G_PRODUCT,'
      '11077147=                 G.NAME'
      '11077148=            FROM G_PRODUCT G, LT_BARCODE L'
      '11077149=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11077150=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11077151=             AND TRIM(L.BARCODE) <> '#39#39
      '11077152=            INTO :G_PRODUCT_,'
      '11077153=                 :G_PRODUCT_NAME_;'
      '11077154='
      
        '11077155=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11077156=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11077157=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11077158=              UPDATE G_PRODUCT G'
      '11077159=                 SET G.NAME = :NAME_,'
      '11077160=                     G.G_UNIT = :G_UNIT_,'
      '11077161=                     G.PRICE  = :PRICE_,'
      '11077162=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11077163=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11077164=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11077165=                     G.PLACE = :PLACE_,'
      
        '11077166=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11077167=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11077168=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11077169=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11077170=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11077171='
      
        '11077172=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'|' +
        '|UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11077173=            END ELSE'
      
        '11077174=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11077175=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NA' +
        'ME_||'#39'.'#39';'
      '11077176=        END'
      '11077177=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN'
      
        '11077178=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RETU' +
        'RNING_VALUES (:BARCODE_);'
      '11077179='
      
        '11077180=    --=================================================' +
        '========'
      '11077181=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '11077182=    --=================================================' +
        '========'
      '11077183=    PNT_ = '#39'02b'#39';'
      '11077184=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '11077185='
      
        '11077186=        -----------------------------------------------' +
        '-------------------'
      
        '11077187=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058 +
        #1040#1050#1054#1049' '#1053#1045#1058
      
        '11077188=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~' +
        #1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '11077189=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '11077190=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053 +
        #1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '11077191=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEGI' +
        'N'
      '11077192=            G_PRODUCT_PAR_ = NULL;'
      
        '11077193=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME_' +
        ');'
      '11077194=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '11077195=              STR_ = CATEGORY_NAME_;'
      '11077196=              CATEGORY_NAME_ = '#39#39';'
      '11077197=            END ELSE'
      
        '11077198=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '11077199='
      '11077200=            SELECT G_PRODUCT'
      '11077201=              FROM G_PRODUCT G'
      '11077202=             WHERE G.NAME = :STR_'
      '11077203=               AND G.IS_CATEGORY = 1'
      
        '11077204=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_P' +
        'REV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '11077205=                   OR'
      '11077206=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '11077207=              INTO G_PRODUCT_PAR_;'
      '11077208=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '11077209=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PRO' +
        'DUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '11077210=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PR' +
        'ODUCT_PAR_PREV_, :STR_, 1, 0)'
      '11077211=                RETURNING G_PRODUCT'
      '11077212=                INTO :G_PRODUCT_PAR_;'
      '11077213='
      '11077214=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '11077215=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_NA' +
        'ME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '11077216=        END'
      
        '11077217=        -----------------------------------------------' +
        '-------------------'
      '11077218='
      
        '11077219=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR' +
        ', ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME' +
        '_PRICE,'
      
        '11077220=                               IS_CATEGORY, PACK_AMOUNT' +
        ', MF_COUNTRY, NOTE, PLACE, KOD_TNVD)'
      
        '11077221=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_P' +
        'RODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME' +
        '_, :G_UNIT_, :PRICE_,'
      
        '11077222=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_C' +
        'OUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_)'
      '11077223=        RETURNING G_PRODUCT'
      '11077224=        INTO :G_PRODUCT_;'
      '11077225='
      
        '11077226=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11077227=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, 0, :G_TOCHKA_);'
      '11077228=    end'
      '11077229='
      
        '11077230=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045#1051 +
        #1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11077231=    PNT_ = '#39'03'#39';'
      '11077232=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '11077233=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '11077234=                                       :AMOUNT_,'
      '11077235=                                       :SELF_PRICE_,'
      
        '11077236=                                       :AMOUNT_ * :SELF' +
        '_PRICE_,'
      '11077237=                                       0, --nds_,'
      '11077238=                                       0 --nds_summ_,'
      '11077239=                                       ,:SELF_PRICE_UE_'
      
        '11077240=                                       ,:AMOUNT_ * :SEL' +
        'F_PRICE_UE_'
      
        '11077241=                                       ) RETURNING_VALU' +
        'ES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '11077242=        IF (ERR_CODE <> 0) THEN BEGIN'
      '11077243=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '11077244=          EXIT;'
      '11077245=        END'
      '11077246=    END'
      '11077247='
      
        '11077248=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' ' +
        #1047#1040#1055#1048#1057#1068
      '11077249=    PNT_ = '#39'04'#39';'
      '11077250=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '11077251=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061#1054 +
        #1044
      '11077252=        FROM SKLAD_TMP T'
      '11077253=        INTO :CNT_;'
      '11077254='
      '11077255=      if (CNT_ > 0) then BEGIN'
      '11077256=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '11077257=          FROM SKLAD_TMP T'
      '11077258=          INTO :SUMM_, :SUMM_UE_;'
      '11077259='
      '11077260=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '11077261=                                DATE_RECEIPT,'
      '11077262=                                TIME_RECEIPT,'
      '11077263=                                G_CLIENT,'
      '11077264=                                G_PAYMENT_TYPE,'
      '11077265=                                OSNOVANIE,'
      '11077266=                                NOTE,'
      '11077267=                                SUMM,'
      '11077268=                                SUMM_FACT,'
      '11077269=                                SUMM_CURRENCY,'
      '11077270=                                IS_PAYED_ALL,'
      '11077271=                                IS_VOZVRAT,'
      '11077272=                                G_TOCHKA)'
      '11077273=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11077274=                CURRENT_DATE,'
      '11077275=                CURRENT_TIME,'
      '11077276=                :G_CLIENT_,'
      '11077277=                1,'
      '11077278=                NULL,  --:OSNOVANIE_,'
      '11077279=                NULL,  -- :NOTE_,'
      '11077280=                :SUMM_,'
      '11077281=                :SUMM_,'
      '11077282=                :SUMM_UE_,'
      
        '11077283=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040 +
        ' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11077284=                0,'
      '11077285=                :G_TOCHKA_)'
      '11077286=        RETURNING'
      '11077287=          SKLAD'
      '11077288=        INTO'
      '11077289=          :SKLAD_PARENT_;'
      '11077290='
      '11077291=        PNT_ = '#39'05'#39';'
      '11077292=        FOR SELECT SKLAD,'
      '11077293=                   G_PRODUCT,'
      '11077294=                   AMOUNT,'
      '11077295=                   PRICE,'
      '11077296=                   SUMM'
      '11077297=                   ,PRICE_CURRENCY'
      '11077298=                   ,SUMM_CURRENCY'
      '11077299=              FROM SKLAD_TMP'
      '11077300=             ORDER BY 1'
      '11077301=              INTO :SKLAD_TMP_,'
      '11077302=                   :RG_PRODUCT_,'
      '11077303=                   :RAMOUNT_,'
      '11077304=                   :RPRICE_,'
      '11077305=                   :RSUMM_'
      '11077306=                   ,:RPRICE_UE_'
      '11077307=                   ,:RSUMM_UE_'
      '11077308=        DO BEGIN'
      '11077309='
      '11077310=            UPDATE SKLAD SK'
      '11077311=               SET SK.IS_LAST = 0'
      '11077312=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11077313=               AND SK.IS_LAST = 1;'
      '11077314='
      '11077315=            INSERT INTO SKLAD'
      '11077316=            ('
      '11077317=             SKLAD,'
      '11077318=             SKLAD_PARENT,'
      '11077319=             DATE_RECEIPT,'
      '11077320=             G_CLIENT,'
      '11077321=             G_PRODUCT,'
      '11077322=             AMOUNT,'
      '11077323=             PRICE,'
      '11077324=             SUMM,'
      '11077325=             G_PAYMENT_TYPE,'
      '11077326=             OSNOVANIE,'
      '11077327=             NOTE,'
      '11077328=             NDS,'
      '11077329=             NDS_SUMM,'
      '11077330=             IS_LAST,'
      '11077331=             IS_VOZVRAT,'
      '11077332=             G_TOCHKA'
      '11077333=             ,PRICE_CURRENCY'
      '11077334=             ,SUMM_CURRENCY'
      '11077335=            ) VALUES ('
      '11077336=             :SKLAD_TMP_,'
      '11077337=             :SKLAD_PARENT_,'
      '11077338=             CURRENT_DATE,'
      '11077339=             :G_CLIENT_,'
      '11077340=             :RG_PRODUCT_,'
      '11077341=             :RAMOUNT_,'
      '11077342=             :RPRICE_,'
      '11077343=             :RSUMM_,'
      '11077344=             1,       --:G_PAYMENT_TYPE_,'
      '11077345=             NULL,    --:OSNOVANIE_,'
      '11077346=             NULL,    --:NOTE_,'
      '11077347=             0,       --:RNDS_,'
      '11077348=             0,       --:RNDS_SUMM_,'
      '11077349=             1,       --IS_LAST_'
      '11077350=             0,        --:IS_VOZVRAT_'
      '11077351=             :G_TOCHKA_'
      '11077352=             ,:RPRICE_UE_'
      '11077353=             ,:RSUMM_UE_'
      '11077354=            );'
      '11077355='
      
        '11077356=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11077357=            PNT_ = '#39'06'#39';'
      '11077358=            UPDATE LT_SKLAD_PRODUCT L'
      '11077359=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11077360=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11077361=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11077362='
      '11077363=            PNT_ = '#39'06a'#39';'
      '11077364=            IF (ROW_COUNT = 0) THEN'
      
        '11077365=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11077366=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11077367=        END'
      '11077368='
      '11077369=        PNT_ = '#39'07'#39';'
      
        '11077370=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_' +
        ' => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11077371=                                2,    --:G_PRIHOD_RASHO' +
        'D_,'
      '11077372=                                :SUMM_,'
      '11077373=                                CURRENT_DATE,'
      
        '11077374=                                NULL,   --NOTE_ => :NOT' +
        'E_,'
      '11077375=                                NULL,   --ZAKAZ_'
      '11077376=                                :SKLAD_PARENT_,'
      '11077377=                                1,'
      
        '11077378=                                :G_TOCHKA_) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11077379=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11077380=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11077381=          EXIT;'
      '11077382=        END'
      '11077383='
      '11077384=        DELETE FROM SKLAD_TMP;'
      '11077385=      END'
      '11077386=    END'
      '11077387='
      
        '11077388=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054#1069 +
        #1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '11077389=    if (ERR_MSG_ IS NOT NULL) then'
      '11077390=      ERR_MSG = ERR_MSG_;'
      '11077391='
      '11077392=WHEN ANY DO BEGIN'
      '11077393=    Err_code = gdscode;'
      
        '11077394=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' --' +
        '> PNT_ '#39'||PNT_;'
      '11077395=  END'
      '11077396=END'
      '11077397=;'
      '11077398='
      '11077399=ALTER PROCEDURE READ_SKLAD_PARENT_LIST('
      '11077400=  DATE_BEGIN_ DATE,'
      '11077401=  DATE_END_ DATE,'
      '11077402=  IS_VOZVRAT_ INTEGER)'
      '11077403=RETURNS ('
      '11077404=  SKLAD TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      
        '11077405=  DATE_RECEIPT TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT' +
        ','
      '11077406=  G_CLIENT TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      '11077407=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '11077408=  G_PAYMENT_TYPE TYPE OF COLUMN SKLAD_PARENT.G_PAYMENT_' +
        'TYPE,'
      '11077409=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '11077410=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '11077411=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '11077412=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11077413=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11077414=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_ALL' +
        ','
      '11077415=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '11077416=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11077417=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11077418=  DETAILS_STR VARCHAR(1000))'
      '11077419=AS'
      '11077420=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11077421=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11077422=BEGIN'
      '11077423='
      '11077424=  SELECT ID'
      '11077425=    FROM CUR_PARAMS'
      '11077426=   WHERE CUR_PARAMS = 2'
      '11077427=    INTO :G_TOCHKA_;'
      '11077428='
      '11077429=  SELECT COUNT(*)'
      '11077430=    FROM SKLAD_PARENT T'
      
        '11077431=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11077432=     AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :IS_VO' +
        'ZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '11077433=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ =' +
        ' 1))'
      '11077434=     AND T.G_TOCHKA = :G_TOCHKA_'
      '11077435=    INTO CNT_;'
      '11077436='
      '11077437=  if (CNT_ = 0) then'
      '11077438=    SELECT MAX(T.DATE_RECEIPT)'
      '11077439=      FROM SKLAD_PARENT T'
      '11077440=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '11077441=       AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :IS_' +
        'VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '11077442=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ =' +
        ' 1))'
      '11077443=       AND T.G_TOCHKA = :G_TOCHKA_'
      '11077444=      INTO :DATE_BEGIN_;'
      '11077445='
      '11077446=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '11077447=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '11077448=      FOR'
      '11077449=        SELECT T.SKLAD,'
      '11077450=               T.DATE_RECEIPT,'
      '11077451=               T.G_CLIENT,'
      '11077452=               GC.NAME,'
      '11077453=               T.G_PAYMENT_TYPE,'
      '11077454=               PT.NAME,'
      
        '11077455=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||D.' +
        'AMOUNT||'#39')'#39', '#39', '#39')'
      '11077456=                            FROM SKLAD D, G_PRODUCT G'
      
        '11077457=                           WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '11077458=                             AND D.SKLAD_PARENT = T.SKL' +
        'AD'
      
        '11077459=                           GROUP BY SKLAD_PARENT) FROM ' +
        '1 FOR 999) DETAILS_STR,*/'
      '11077460=               T.OSNOVANIE,'
      '11077461=               T.NOTE,'
      '11077462=               T.SUMM,'
      '11077463=               T.SUMM_FACT,'
      '11077464=               T.IS_PAYED_ALL,'
      '11077465=               T.IS_VOZVRAT,'
      '11077466=               T.g_official,'
      '11077467=               COALESCE(GO.fio_doc, GO.FM||'#39' '#39'||GO.nm)'
      '11077468=          FROM SKLAD_PARENT T'
      
        '11077469=                    LEFT OUTER JOIN G_CLIENT GC ON T.G_' +
        'CLIENT = GC.G_CLIENT'
      
        '11077470=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT O' +
        'N T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '11077471=                    LEFT OUTER JOIN G_OFFICIAL GO ON T.' +
        'g_official = GO.G_OFFICIAL'
      
        '11077472=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVRAT' +
        '_ = 0)'
      
        '11077473=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRA' +
        'T_ = 1))'
      '11077474=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '11077475=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '11077476=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '11077477=        INTO :SKLAD,'
      '11077478=             :DATE_RECEIPT,'
      '11077479=             :G_CLIENT,'
      '11077480=             :CLIENT_NAME,'
      '11077481=             :G_PAYMENT_TYPE,'
      '11077482=             :PAYMENT_NAME,'
      '11077483=             --:DETAILS_STR,'
      '11077484=             :OSNOVANIE,'
      '11077485=             :NOTE,'
      '11077486=             :SUMM,'
      '11077487=             :SUMM_FACT,'
      '11077488=             :IS_PAYED_ALL,'
      '11077489=             :IS_VOZVRAT,'
      '11077490=             :G_OFFICIAL,'
      '11077491=             :G_OFFICIAL_FIO'
      '11077492=      DO'
      '11077493=        suspend;'
      '11077494='
      
        '11077495=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1047#1044#1045#1057#1068' '#1044#1040#1053#1053#1067#1049' '#1057#1050#1051#1040#1044' '#1057#1058#1054#1048#1058' '#1050 +
        #1040#1050' '#1050#1051#1048#1045#1053#1058', '#1040' '#1042' G_TOCHKA '#1057#1058#1054#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '11077496=  END ELSE BEGIN'
      '11077497=      FOR'
      '11077498=        SELECT T.SKLAD,'
      '11077499=               T.DATE_RECEIPT,'
      '11077500=               T.G_TOCHKA,'
      '11077501=               G.NAME,'
      
        '11077502=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||D.' +
        'AMOUNT||'#39')'#39', '#39', '#39')'
      '11077503=                            FROM SKLAD D, G_PRODUCT G'
      
        '11077504=                           WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '11077505=                             AND D.SKLAD_PARENT = T.SKL' +
        'AD'
      
        '11077506=                           GROUP BY SKLAD_PARENT) FROM ' +
        '1 FOR 999) DETAILS_STR, */'
      '11077507=               T.OSNOVANIE,'
      '11077508=               T.NOTE,'
      '11077509=               T.SUMM'
      
        '11077510=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHKA ' +
        'G ON T.G_CLIENT = G.G_TOCHKA'
      '11077511=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '11077512=           AND T.IS_VOZVRAT = 3'
      
        '11077513=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '11077514=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '11077515=        INTO :SKLAD,'
      '11077516=             :DATE_RECEIPT,'
      '11077517=             :G_CLIENT,'
      '11077518=             :CLIENT_NAME,'
      '11077519=             --:DETAILS_STR,'
      '11077520=             :OSNOVANIE,'
      '11077521=             :NOTE,'
      '11077522=             :SUMM'
      '11077523=      DO'
      '11077524=        suspend;'
      '11077525=  END'
      '11077526=end'
      '11077527=;'
      
        '11077528=UPDATE SYSTEM_SETUP SET S_VALUE = 11077 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11077529=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11077530=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
