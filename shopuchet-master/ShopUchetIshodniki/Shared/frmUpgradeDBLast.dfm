        '*************************/'
      '110605908=ALTER PROCEDURE C_FILL_CUR_PARAMS('
      '110605909=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '110605910=RETURNS ('
      '110605911=  G_TOCHKA_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110605912=  TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA.NAME)'
      '110605913=AS'
      '110605914=DECLARE VARIABLE NAME_ VARCHAR(250);'
      
        '110605915=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL; /* '#1063#1058#1054#1041#1067' '#1042#1057#1058#1040#1042#1048#1051#1057#1071' NULL, '#1040' '#1058#1054' '#1057' '#1045#1050#1047#1045' G_OFFICIAL_ =' +
        ' 0 */'
      '110605916=BEGIN'
      '110605917='
      '110605918=  SELECT G.G_OFFICIAL,'
      '110605919=         COALESCE(G.FM, '#39#39')||'#39' '#39'||COALESCE(G.NM, '#39#39'),'
      '110605920=         G.G_TOCHKA'
      '110605921=    FROM G_OFFICIAL G'
      '110605922=   WHERE G.G_OFFICIAL = :G_OFFICIAL_'
      '110605923=    INTO G_OFFICIAL__,'
      '110605924=         :NAME_,'
      '110605925=         :G_TOCHKA_;'
      '110605926='
      
        '110605927=  IF (G_TOCHKA_ IS NULL) THEN    --'#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045#1049' ' +
        #1053#1045#1058', '#1048#1051#1048' '#1054#1053' '#1054#1044#1048#1053', '#1058#1054' '#1054#1053' '#1053#1045' '#1042#1067#1041#1048#1056#1040#1045#1058#1057#1071', '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1057#1050#1051#1040#1044' '#1055#1056#1048#1044 +
        #1045#1058#1057#1071' '#1042#1067#1041#1048#1056#1040#1058#1068' '#1057#1040#1052#1067#1049' '#1055#1045#1056#1042#1067#1049
      '110605928=    SELECT G_TOCHKA,'
      '110605929=           NAME'
      '110605930=      FROM G_TOCHKA'
      '110605931=     WHERE G_TOCHKA = (SELECT MIN(G_TOCHKA)'
      '110605932=                         FROM G_TOCHKA)'
      '110605933=      INTO :G_TOCHKA_,'
      '110605934=           :TOCHKA_NAME_;'
      '110605935=  ELSE'
      '110605936=    SELECT G_TOCHKA,'
      '110605937=           NAME'
      '110605938=      FROM G_TOCHKA'
      '110605939=     WHERE G_TOCHKA = :G_TOCHKA_'
      '110605940=      INTO :G_TOCHKA_,'
      '110605941=           :TOCHKA_NAME_;'
      '110605942='
      '110605943=  INSERT INTO CUR_PARAMS (CUR_PARAMS, ID, NAME)'
      '110605944=  VALUES (1, :G_OFFICIAL__, :NAME_);'
      '110605945='
      '110605946=  INSERT INTO CUR_PARAMS (CUR_PARAMS, ID, NAME)'
      '110605947=  VALUES (2, :G_TOCHKA_, :TOCHKA_NAME_);'
      '110605948=end'
      '110605949=;'
      '110605950='
      '110605951=ALTER PROCEDURE CLEAR_BASE('
      '110605952=  MODE_ INTEGER = 0)'
      '110605953=AS'
      '110605954=/*'
      '110605955=mode_'
      '110605956=0 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077
      '110605957=1 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1087#1088#1086#1076#1072#1078#1080' '#1080' '#1087#1088#1086#1076#1072#1078#1080
      '110605958=2 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077', '#1082#1088#1086#1084#1077' '#1090#1086#1074#1072#1088#1086#1074
      '110605959=*/'
      '110605960=BEGIN'
      '110605961=  delete from LT_ZAKAZ_REAL;'
      '110605962=  delete from REVISION;'
      '110605963='
      '110605964=  delete from kassa;'
      '110605965=  delete from kassa_state;'
      '110605966='
      '110605967=  delete from kassa_beznal;'
      '110605968=  delete from kassa_beznal_state;'
      '110605969='
      '110605970=  delete from waybill;'
      '110605971=  delete from invoice;'
      '110605972=  delete from INVOICE_PAY;'
      '110605973=  delete from docs;'
      '110605974=  delete from other_details;'
      '110605975=  delete from other;'
      '110605976='
      '110605977=  delete from zakaz_details;'
      '110605978=  delete from zakaz;'
      '110605979='
      '110605980=  delete from zakaz_na_real;'
      '110605981=  delete from ZAKAZ_real_parent;'
      '110605982='
      '110605983=  delete from sklad;'
      '110605984=  delete from sklad_parent;'
      '110605985='
      '110605986=  update lt_sklad_product l'
      '110605987=     set l.AMOUNT = 0,'
      '110605988=         l.AMOUNT_RESERVE = 0;'
      '110605989='
      '110605990=  IF (MODE_ IN (0, 2)) THEN BEGIN'
      '110605991=    delete from g_address;'
      '110605992=    delete from g_account;'
      '110605993=    delete from G_DISCONT_CARD;'
      '110605994=    delete from DELIVERY;'
      
        '110605995=    delete from g_client c where c.G_CLIENT not in (9,' +
        '10);'
      '110605996=    delete from g_discount;'
      
        '110605997=    delete from g_prihod_rashod where g_prihod_rashod ' +
        'not in (0,1,2,3,4);'
      '110605998=    delete from g_firm_address;'
      '110605999=    delete from g_firm_account;'
      '110606000=    delete from g_firm_rekvizit;'
      '110606001='
      '110606002=    IF (mode_ = 0) THEN begin'
      '110606003=      delete from G_PRODUCT_IMAGE;'
      '110606004=      delete from G_PRODUCT_KIT;'
      '110606005=      delete from LT_BARCODE;'
      '110606006=      delete from LT_SKLAD_PRODUCT;'
      '110606007=      delete from G_PRODUCT g where g.IS_CATEGORY = 0;'
      
        '110606008=      delete from G_PRODUCT g where g.IS_CATEGORY = 1 ' +
        'and g.G_PRODUCT_PAR is not null;'
      '110606009=      delete from G_PRODUCT g where g.IS_CATEGORY = 1;'
      '110606010=    end'
      '110606011=  END'
      '110606012=END'
      '110606013=;'
      '110606014='
      '110606015=ALTER PROCEDURE DO_UPDATE('
      '110606016=  ID_ DM_BIGINT,'
      '110606017=  TABLE_NAME_ VR_50,'
      '110606018=  ERR_CODE INTEGER,'
      '110606019=  ERR_MSG VARCHAR(1024))'
      '110606020=AS'
      
        '110606021=-- '#1044#1045#1051#1040#1070' '#1061#1054#1051#1054#1057#1058#1054#1049' '#1040#1055#1044#1045#1049#1058' '#1058#1040#1041#1051#1048#1062#1067' '#1044#1051#1071' '#1057#1054#1047#1044#1040#1053#1048#1071' '#1041#1051#1054#1050#1048#1056#1054#1042 +
        #1050#1048', '#1057#1054#1047#1044#1040#1051' '#1059#1053#1048#1042#1045#1056#1057#1040#1051#1068#1053#1059#1070' '#1055#1056#1054#1062#1045#1044#1059#1056#1059
      
        '110606022=-- '#1058'.'#1050'. '#1042' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1058#1040#1041#1051#1048#1062#1040#1061', '#1053#1040#1055#1056#1048#1052#1045#1056' SKLAD_PARENT, ' +
        #1053#1040#1047#1042#1040#1053#1048#1045' '#1058#1040#1041#1051#1048#1062#1067' '#1053#1045' '#1057#1054#1042#1055#1040#1044#1040#1045#1058' '#1057' '#1053#1040#1047#1042#1040#1053#1048#1045#1052' '#1050#1054#1051#1054#1053#1050#1048' PRIMARY,'
      '110606023=-- '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '110606024=DECLARE VARIABLE ID_COL_ VARCHAR(50);'
      '110606025=begin'
      '110606026='
      '110606027=  if (UPPER(TABLE_NAME_) = '#39'SKLAD_PARENT'#39') then'
      '110606028=    ID_COL_ = '#39'SKLAD'#39';'
      '110606029=  ELSE'
      '110606030=    ID_COL_ = TABLE_NAME_;'
      '110606031='
      '110606032=  EXECUTE STATEMENT'
      '110606033=  '#39'UPDATE '#39'||:TABLE_NAME_||'
      '110606034=  '#39' SET '#39'||ID_COL_||'#39' = '#39'||:ID_||'
      '110606035=  '#39' WHERE '#39'||ID_COL_||'#39' = '#39'||:ID_;'
      '110606036=end'
      '110606037=;'
      '110606038='
      '110606039=ALTER PROCEDURE DOCS_READ('
      '110606040=  DOC_TYPE_ TYPE OF COLUMN DOCS.DOC_TYPE,'
      '110606041=  IS_ALL_ INTEGER,'
      '110606042=  BEGIN_DATE_ DATE,'
      '110606043=  END_DATE_ DATE)'
      '110606044=RETURNS ('
      '110606045=  DOCS TYPE OF COLUMN DOCS.DOCS,'
      '110606046=  NUM TYPE OF COLUMN DOCS.NUM,'
      '110606047=  DOCS_DATE TYPE OF COLUMN DOCS.DOCS_DATE,'
      '110606048=  G_FIRM TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      
        '110606049=  G_FIRM_ADDRESS TYPE OF COLUMN G_FIRM_ADDRESS.ADDRESS' +
        ','
      
        '110606050=  G_FIRM_ACCOUNT TYPE OF COLUMN G_FIRM_ACCOUNT.ACCOUNT' +
        ','
      '110606051=  G_CLIENT TYPE OF COLUMN G_CLIENT.NAME,'
      '110606052=  G_CLIENT_ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110606053=  G_CLIENT_ACCOUNT TYPE OF COLUMN G_ACCOUNT.ACCOUNT,'
      '110606054=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110606055=  NOTE TYPE OF COLUMN DOCS.NOTE,'
      '110606056=  PARAM1 TYPE OF COLUMN DOCS.PARAM1,'
      '110606057=  PARAM2 TYPE OF COLUMN DOCS.PARAM2,'
      '110606058=  PARAM3 TYPE OF COLUMN DOCS.PARAM3,'
      '110606059=  PARAM4 TYPE OF COLUMN DOCS.PARAM4,'
      '110606060=  PARAM5 TYPE OF COLUMN DOCS.PARAM5,'
      '110606061=  DOC_TYPE TYPE OF COLUMN DOCS.DOC_TYPE,'
      '110606062=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '110606063=AS'
      '110606064=begin'
      '110606065=  for select D.docs,'
      '110606066=             D.num,'
      '110606067=             D.DOCS_DATE,'
      '110606068=             F.name,'
      '110606069=             FD.address,'
      '110606070=             FA.account,'
      '110606071=             C.name,'
      '110606072=             GD.address,'
      '110606073=             GA.account,'
      '110606074=             O.fio_doc,'
      '110606075=             D.note,'
      '110606076=             D.param1,'
      '110606077=             D.param2,'
      '110606078=             D.param3,'
      '110606079=             D.param4,'
      '110606080=             D.param5,'
      '110606081=             D.DOC_TYPE,'
      '110606082=             D.ZAKAZ'
      '110606083=      FROM docs D'
      
        '110606084=           LEFT OUTER JOIN G_FIRM_ADDRESS FD ON FD.g_a' +
        'ddress = D.g_firm_address'
      
        '110606085=           LEFT outer JOIN G_FIRM_ACCOUNT FA ON FA.g_a' +
        'ccount = D.g_firm_account'
      
        '110606086=           LEFT outer JOIN G_ADDRESS GD ON GD.g_addres' +
        's = D.g_client_address'
      
        '110606087=           LEFT outer JOIN G_ACCOUNT GA ON GA.g_accoun' +
        't = D.g_client_account'
      
        '110606088=           LEFT outer JOIN G_OFFICIAL O ON O.g_officia' +
        'l = D.g_official,'
      '110606089=           G_FIRM_REKVIZIT F,'
      '110606090=           g_client C'
      '110606091=     WHERE (:IS_ALL_ = 1'
      '110606092=            OR'
      
        '110606093=            (D.DOCS_DATE BETWEEN :BEGIN_DATE_ AND :END' +
        '_DATE_))'
      '110606094=       AND D.doc_type = :DOC_TYPE_'
      '110606095=       AND D.g_firm = F.g_firm_rekvizit'
      '110606096=       AND D.G_CLIENT = C.g_client'
      '110606097=      into :docs,'
      '110606098=           :num,'
      '110606099=           :DOCS_DATE,'
      '110606100=           :g_firm,'
      '110606101=           :g_firm_address,'
      '110606102=           :g_firm_account,'
      '110606103=           :g_client,'
      '110606104=           :g_client_address,'
      '110606105=           :g_client_account,'
      '110606106=           :g_official,'
      '110606107=           :note,'
      '110606108=           :param1,'
      '110606109=           :param2,'
      '110606110=           :param3,'
      '110606111=           :param4,'
      '110606112=           :param5,'
      '110606113=           :DOC_TYPE,'
      '110606114=           :ZAKAZ'
      '110606115=  do'
      '110606116=  begin'
      '110606117=    suspend;'
      '110606118=  end'
      '110606119=end'
      '110606120=;'
      '110606121='
      '110606122=ALTER PROCEDURE G_DEL_G_BANK('
      '110606123=  G_BANK_ TYPE OF COLUMN G_BANK.G_BANK)'
      '110606124=RETURNS ('
      '110606125=  ERR_CODE INTEGER,'
      '110606126=  ERR_MSG VARCHAR(1024))'
      '110606127=AS'
      '110606128=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '110606129=begin'
      '110606130=  PROCNAME = '#39'G_DEL_G_BANK'#39';'
      '110606131='
      '110606132=  delete from G_BANK g'
      '110606133=    where g.G_BANK = :G_BANK_;'
      '110606134='
      '110606135=when sqlcode -530 DO'
      '110606136=  begin'
      '110606137=    ERR_CODE = -20500;'
      
        '110606138=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1075#1086 +
        ' '#1073#1072#1085#1082#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
