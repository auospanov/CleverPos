      '110192457=          SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110192458=      END'
      '110192459=    END'
      '110192460='
      
        '110192461=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION, ' +
        'G_OFFICIAL,'
      '110192462=      ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110192463=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAMP' +
        ', 3, :USER_ID_, 13, :G_PRODUCT_CAT_,'
      '110192464=        '#39#1043#1088#1091#1087#1087#1072' '#1090#1086#1074#1072#1088#1086#1074' '#39'||:CATEGORY_NAME_,'
      
        '110192465=        '#39#1043#1088#1091#1087#1087#1072' '#1090#1086#1074#1072#1088#1086#1074' '#39'||:CATEGORY_NAME_ || '#39' (ID'#39' |' +
        '| :G_PRODUCT_CAT_ || '#39')'#39');'
      '110192466='
      '110192467=    DELETE FROM G_PRODUCT C'
      '110192468=     WHERE G_PRODUCT = :G_PRODUCT_CAT_;'
      '110192469='
      
        '110192470=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110192471=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110192472=        UPDATE SYNC_EXT_APP AP'
      '110192473=           SET AP.OPER = 3'
      '110192474=         WHERE AP.OBJECT_TYPE = 4'
      '110192475=           AND AP.ID = :G_PRODUCT_CAT_'
      '110192476=           AND AP.IS_LOADING = 0;'
      '110192477='
      '110192478=        IF (ROW_COUNT = 0) THEN'
      
        '110192479=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110192480=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G' +
        '_PRODUCT_CAT_, 3);'
      '110192481=    END'
      '110192482='
      '110192483=    SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110192484=  END'
      '110192485='
      '110192486=  IF (FAIL_CNT_ = 0) THEN'
      
        '110192487=    LOG_ = '#39#1059#1076#1072#1083#1077#1085#1086' '#1091#1089#1087#1077#1096#1085#1086': '#39' || SUCCESS_CNT_ || '#39' '#1079#1072 +
        #1087#1080#1089#1077#1081'(-'#1080').'#39';'
      '110192488=  ELSE'
      
        '110192489=    LOG_ = '#39#1059#1076#1072#1083#1077#1085#1086' '#1091#1089#1087#1077#1096#1085#1086': '#39' || SUCCESS_CNT_ || '#39' '#1079#1072 +
        #1087#1080#1089#1077#1081'(-'#1080').'#39'||CRLF||'
      
        '110192490=        '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080': '#39' || FAIL_CNT_ || '#39' '#1079#1072#1087#1080 +
        #1089#1077#1081'(-'#1080').'#39'||CRLF||CRLF||'
      
        '110192491=        '#39#1057#1083#1077#1076#1091#1102#1097#1080#1077' '#1090#1086#1074#1072#1088#1099' '#1091#1076#1072#1083#1080#1090#1100' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#1054#1085#1080' '#1073#1099#1083#1080 +
        ' '#1087#1077#1088#1077#1085#1077#1089#1077#1085#1099' '#1074' '#1075#1088#1091#1087#1087#1091' "'#1041#1077#1079' '#1075#1088#1091#1087#1087#1099'".'#39'||CRLF||'#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090#1077 +
        ' '#1080#1093' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1086#1074' '#1090#1086#1074#1072#1088#1086#1074'.'#39'||CRLF||'
      '110192492=        '#39'==========================='#39'||CRLF||LOG_;'
      '110192493='
      '110192494=WHEN ANY DO BEGIN'
      '110192495=    ERR_CODE = -20500;'
      
        '110192496=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073#1082#1072' '#1087#1088 +
        #1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1075#1088#1091#1087#1099#1099'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110192497=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110192498=  END'
      '110192499=END'
      '110192500=;'
      '110192501='
      '110192502=ALTER PROCEDURE P_REP_BILL('
      '110192503=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110192504=  SUMM_DANO_ NUMERIC(15,2),'
      '110192505=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110192506=  CURRENCY_ INTEGER,'
      '110192507=  MODE_ INTEGER,'
      '110192508=  PRINT_SLOGAN_ VARCHAR(80),'
      '110192509=  DECIMAL_ INTEGER,'
      '110192510=  BONUS_ NUMERIC(15,2),'
      '110192511=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS)'
      '110192512=RETURNS ('
      '110192513=  FIRM_NAME_ VARCHAR(600),'
      '110192514=  IDN_STR_ VARCHAR(30),'
      '110192515=  FIRM_IDN_ VARCHAR(50),'
      '110192516=  FIRM_ADDRESS_ VARCHAR(550),'
      '110192517=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110192518=  DATE_ VARCHAR(100),'
      '110192519=  PAYMENT_TYPE_ VARCHAR(100),'
      '110192520=  G_CLIENT_NAME_ VARCHAR(300),'
      '110192521=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110192522=  SUMM_VSEGO_ VARCHAR(50),'
      '110192523=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110192524=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110192525=  ROW_NUM INTEGER,'
      '110192526=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110192527=  NAME_ART VARCHAR(1000),'
      '110192528=  AMOUNT VARCHAR(50),'
      '110192529=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110192530=  PRICE VARCHAR(50),'
      '110192531=  PRICE_N VARCHAR(50),'
      '110192532=  SUMM VARCHAR(50),'
      '110192533=  SUMM_N VARCHAR(50),'
      '110192534=  SUMM_POLUCH_ VARCHAR(50),'
      '110192535=  SUMM_SDACH_ VARCHAR(50),'
      '110192536=  SUMM_STR_ VARCHAR(200),'
      '110192537=  SLOGAN_ VARCHAR(80),'
      '110192538=  SUMM_SKIDKA_ VARCHAR(50),'
      '110192539=  SUMM_SERVICE_ VARCHAR(50),'
      '110192540=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110192541=  BONUS_STR_ VARCHAR(100),'
      '110192542=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110192543=  ERR_CODE NUMERIC(15,2),'
      '110192544=  ERR_MSG VARCHAR(1024))'
      '110192545=AS'
      '110192546=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '110192547=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '110192548=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110192549=DECLARE VARIABLE I INTEGER = 1;'
      
        '110192550=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110192551=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110192552=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.AMOUNT;'
      
        '110192553=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110192554=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      
        '110192555=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.SUMM;'
      '110192556=BEGIN'
      '110192557=  SLOGAN_ = PRINT_SLOGAN_;'
      '110192558='
      '110192559=  IF (BONUS_ > 0) THEN BEGIN'
      
        '110192560=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_, 2) AS VARCHAR(100));'
      '110192561=  END'
      '110192562='
      '110192563=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '110192564=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_' +
        ';'
      '110192565=  END'
      '110192566='
      '110192567=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110192568=  SELECT z.ZAKAZ'
      '110192569=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '110192570=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')' +
        '||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '110192571=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '110192572=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COAL' +
        'ESCE(O.NM, '#39#39')'
      '110192573=         ,Z.summ_noncash'
      '110192574=         ,Z.summ_cash'
      '110192575=         ,Z.NOTE'
      
        '110192576=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '110192577=         G_CLIENT G,'
      '110192578=         G_PAYMENT_TYPE P'
      '110192579=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110192580=     AND Z.G_CLIENT = G.G_CLIENT'
      '110192581=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110192582=    INTO :NUM_'
      '110192583=        ,:PAYMENT_TYPE_'
      '110192584=        ,:DATE_'
      '110192585=        ,:G_CLIENT_NAME_'
      '110192586=        ,:G_OFFICIAL_FM_'
      '110192587=        ,:SUMM_NONCASH_'
      '110192588=        ,:SUMM_CASH_'
      '110192589=        ,:NOTE_'
      '110192590=        ;'
      '110192591='
      '110192592=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110192593=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110192594='
      '110192595=  SELECT R.G_FIRM_REKVIZIT,'
      '110192596=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110192597=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110192598=    FROM G_FIRM_REKVIZIT R'
      '110192599=   WHERE R.is_default = 1'
      '110192600=    INTO :G_FIRM_REKVIZIT_,'
      '110192601=         :FIRM_NAME_,'
      '110192602=         :FIRM_IDN_;'
      '110192603='
      '110192604=  SELECT ZD.SUMM'
      '110192605=    FROM ZAKAZ_DETAILS ZD'
      '110192606=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110192607=    AND ZD.G_PRODUCT = -2'
      '110192608=    INTO :SERVICE_SUMM_;'
      '110192609=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110192610='
      '110192611=  SELECT SUM(ZD.AMOUNT),'
      
        '110192612=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCH' +
        'AR(50)),'
      
        '110192613=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2' +
        ') AS VARCHAR(50)),'
      
        '110192614=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110192615=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '110192616=  FROM ZAKAZ_DETAILS ZD'
      '110192617=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110192618=    AND ZD.G_PRODUCT <> -2'
      '110192619=  INTO :AMOUNT_VSEGO_NUM_,'
      '110192620=       :SUMM_SKIDKA_,'
      '110192621=       :SUMM_VSEGO_,'
      '110192622=       :SUMM_VSEGO_N_,'
      '110192623=       :SUMM_SERVICE_;'
      '110192624='
      '110192625=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110192626=    FROM G_FIRM_ADDRESS R'
      '110192627=   WHERE R.IS_DEFAULT = 1'
      '110192628=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110192629=    INTO :FIRM_ADDRESS_;'
      '110192630='
      
        '110192631=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110192632=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110192633=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110192634=    IF (CURRENCY_ = 0) THEN'
      '110192635=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110192636=    ELSE'
      '110192637=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110192638=  END'
      '110192639='
      '110192640=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110192641='
      
        '110192642=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110192643=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110192644='
      '110192645=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110192646=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110192647=  INTO :SUMM_STR_;'
      '110192648='
      '110192649=  FOR'
      '110192650=    SELECT :I,'
      '110192651=           G.NAME,'
      
        '110192652=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39', ' +
        #39#39'),'
      '110192653=           ZD.AMOUNT,'
      '110192654=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '110192655=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) A' +
        'S VARCHAR(100))'
      '110192656=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110192657=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE' +
        ', 0) AS VARCHAR(100))'
      '110192658=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110192659=      FROM ZAKAZ Z,'
      '110192660=           ZAKAZ_DETAILS ZD,'
      '110192661=           G_PRODUCT G,'
      '110192662=           G_UNIT U'
      '110192663=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110192664=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110192665=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110192666=       AND G.G_UNIT = U.G_UNIT'
      '110192667=       AND G.G_PRODUCT <> -2'
      '110192668=     ORDER BY ZD.zakaz_details'
      '110192669=    INTO :ROW_NUM,'
      '110192670=        :NAME,'
      '110192671=        :NAME_ART,'
      '110192672=        :AMOUNT_NUM_,'
      '110192673=        :PRICE,'
      '110192674=        :SUMM'
      '110192675=        ,:SHORT_NAME'
      '110192676=        ,:PRICE_N'
      '110192677=        ,:SUMM_N'
      '110192678=  DO BEGIN'
      '110192679=    I = I + 1;'
      '110192680='
      
        '110192681=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110192682=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110192683=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110192684=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110192685=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110192686=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110192687=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110192688=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110192689=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110192690=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110192691=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110192692=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110192693=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110192694=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110192695=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110192696=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110192697=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110192698=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110192699=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110192700=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110192701=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110192702=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110192703=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);'
      '110192704='
      '110192705=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110192706=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110192707=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110192708=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110192709=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110192710=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110192711=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110192712=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110192713=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110192714=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110192715=    END ELSE BEGIN'
      '110192716=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110192717=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110192718=    END'
      '110192719='
      
        '110192720=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110192721=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110192722='
      
        '110192723=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110192724=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110192725='
      '110192726=    SUSPEND;'
      '110192727=  END'
      '110192728=WHEN ANY DO BEGIN'
      '110192729=    Err_code = -20500;'
      
        '110192730=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110192731=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110192732=  END'
      '110192733=end'
      '110192734=;'
      '110192735='
      '110192736='
      
        '110192737=UPDATE SYSTEM_SETUP SET S_VALUE = 110192 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110192738=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110192739=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101930='
      '1101931=CREATE PROCEDURE R_EDIT_REVISION('
      
        '1101932=  AMOUNT_REAL_ /* TYPE OF COLUMN REVISION.AMOUNT_REAL */' +
        ' NUMERIC(18,5),'
      
        '1101933=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT,'
      
        '1101934=  DATETIME_ /* TYPE OF COLUMN REVISION.DATETIME_CREATED ' +
        '*/ TIMESTAMP,'
      
        '1101935=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T,'
      
        '1101936=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150) = '#39#39')'
      '1101937=RETURNS ('
      
        '1101938=  REVISION_ /* TYPE OF COLUMN REVISION.REVISION */ BIGIN' +
        'T,'
      '1101939=  ERR_CODE INTEGER,'
      '11019310=  ERR_MSG VARCHAR(1024))'
      '11019311=AS'
      '11019312=BEGIN'
      '11019313=  SUSPEND;'
      '11019314=END'
      '11019315=;'
      '11019316='
      '11019317=CREATE PROCEDURE R_INS_REVISION('
      
        '11019318=  REVISION_PARENT_ /* TYPE OF COLUMN REVISION_PARENT.RE' +
        'VISION_PARENT */ BIGINT,'
      
        '11019319=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ B' +
        'IGINT)'
      '11019320=RETURNS ('
      
        '11019321=  REVISION_ /* TYPE OF COLUMN REVISION.REVISION */ BIGI' +
        'NT,'
      '11019322=  ERR_CODE INTEGER,'
      '11019323=  ERR_MSG VARCHAR(1024))'
      '11019324=AS'
      '11019325=BEGIN'
      '11019326=  SUSPEND;'
      '11019327=END'
      '11019328=;'
      '11019329='
      '11019330=CREATE PROCEDURE R_MADE_REVISION('
      
        '11019331=  DATE_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.DATE_BE' +
        'GIN */ DATE,'
      
        '11019332=  TIME_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.TIME_BE' +
        'GIN */ TIME,'
      
        '11019333=  DATE_END_ /* TYPE OF COLUMN REVISION_PARENT.DATE_END ' +
        '*/ DATE,'
      
        '11019334=  TIME_END_ /* TYPE OF COLUMN REVISION_PARENT.TIME_END ' +
        '*/ TIME,'
      
        '11019335=  NOTE_ /* TYPE OF COLUMN REVISION_PARENT.NOTE */ VARCH' +
        'AR(250),'
      
        '11019336=  G_TOCHKA_ /* TYPE OF COLUMN REVISION_PARENT.G_TOCHKA ' +
        '*/ BIGINT,'
      
        '11019337=  REVISION_PARENT_ /* TYPE OF COLUMN REVISION_PARENT.RE' +
        'VISION_PARENT */ BIGINT)'
      '11019338=RETURNS ('
      '11019339=  COUNT_SPIS_ INTEGER,'
      '11019340=  COUNT_PRIH_ INTEGER,'
      
        '11019341=  REVISION_PARENT_OUT_ /* TYPE OF COLUMN REVISION_PAREN' +
        'T.REVISION_PARENT */ BIGINT,'
      '11019342=  ERR_CODE INTEGER,'
      '11019343=  ERR_MSG VARCHAR(1024))'
      '11019344=AS'
      '11019345=BEGIN'
      '11019346=  SUSPEND;'
      '11019347=END'
      '11019348=;'
      '11019349='
      '11019350=CREATE PROCEDURE REVISION_PARENT_DEL('
      
        '11019351=  REVISION_PARENT_ /* TYPE OF COLUMN REVISION_PARENT.RE' +
        'VISION_PARENT */ BIGINT)'
      '11019352=AS'
      '11019353=BEGIN'
      '11019354=  EXIT;'
      '11019355=END'
      '11019356=;'
      '11019357='
      '11019358=CREATE PROCEDURE REVISION_PARENT_GET('
      
        '11019359=  REVISION_PARENT_ /* TYPE OF COLUMN REVISION_PARENT.RE' +
        'VISION_PARENT */ BIGINT)'
      '11019360=RETURNS ('
      
        '11019361=  DATE_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.DATE_BE' +
        'GIN */ DATE,'
      
        '11019362=  TIME_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.TIME_BE' +
        'GIN */ TIME,'
      
        '11019363=  DATE_END_ /* TYPE OF COLUMN REVISION_PARENT.DATE_END ' +
        '*/ DATE,'
      
        '11019364=  TIME_END_ /* TYPE OF COLUMN REVISION_PARENT.TIME_END ' +
        '*/ TIME,'
      
        '11019365=  NOTE_ /* TYPE OF COLUMN REVISION_PARENT.NOTE */ VARCH' +
        'AR(250),'
      
        '11019366=  G_TOCHKA_ /* TYPE OF COLUMN REVISION_PARENT.G_TOCHKA ' +
        '*/ BIGINT,'
      
        '11019367=  IS_MADE_ /* TYPE OF COLUMN REVISION_PARENT.IS_MADE */' +
        ' SMALLINT)'
      '11019368=AS'
      '11019369=BEGIN'
      '11019370=  SUSPEND;'
      '11019371=END'
      '11019372=;'
      '11019373='
      '11019374=CREATE PROCEDURE REVISION_PARENT_INS('
      
        '11019375=  DATE_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.DATE_BE' +
        'GIN */ DATE,'
      
        '11019376=  TIME_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.TIME_BE' +
        'GIN */ TIME,'
      
        '11019377=  DATE_END_ /* TYPE OF COLUMN REVISION_PARENT.DATE_END ' +
        '*/ DATE,'
      
        '11019378=  TIME_END_ /* TYPE OF COLUMN REVISION_PARENT.TIME_END ' +
        '*/ TIME,'
      
        '11019379=  NOTE_ /* TYPE OF COLUMN REVISION_PARENT.NOTE */ VARCH' +
        'AR(250),'
      
        '11019380=  G_TOCHKA_ /* TYPE OF COLUMN REVISION_PARENT.G_TOCHKA ' +
        '*/ BIGINT,'
      
        '11019381=  IS_MADE_ /* TYPE OF COLUMN REVISION_PARENT.IS_MADE */' +
        ' SMALLINT)'
      '11019382=RETURNS ('
      
        '11019383=  REVISION_PARENT_ /* TYPE OF COLUMN REVISION_PARENT.RE' +
        'VISION_PARENT */ BIGINT,'
      '11019384=  ERR_CODE INTEGER,'
      '11019385=  ERR_MSG VARCHAR(1024))'
      '11019386=AS'
      '11019387=BEGIN'
      '11019388=  SUSPEND;'
      '11019389=END'
      '11019390=;'
      '11019391='
      '11019392=CREATE PROCEDURE REVISION_PARENT_READ('
      
        '11019393=  DATE_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.DATE_BE' +
        'GIN */ DATE,'
      
        '11019394=  DATE_END_ /* TYPE OF COLUMN REVISION_PARENT.DATE_END ' +
        '*/ DATE,'
      
        '11019395=  G_TOCHKA_ /* TYPE OF COLUMN REVISION_PARENT.G_TOCHKA ' +
        '*/ BIGINT)'
      '11019396=RETURNS ('
      
        '11019397=  REVISION_PARENT /* TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT */ BIGINT,'
      '11019398=  DATE_BEGIN TIMESTAMP,'
      '11019399=  DATE_END TIMESTAMP,'
      
        '110193100=  NOTE /* TYPE OF COLUMN REVISION_PARENT.NOTE */ VARCH' +
        'AR(250),'
      
        '110193101=  G_TOCHKA /* TYPE OF COLUMN REVISION_PARENT.G_TOCHKA ' +
        '*/ BIGINT,'
      
        '110193102=  IS_MADE /* TYPE OF COLUMN REVISION_PARENT.IS_MADE */' +
        ' SMALLINT,'
      '110193103=  IS_MADE_STR VARCHAR(5))'
      '110193104=AS'
      '110193105=BEGIN'
      '110193106=  SUSPEND;'
      '110193107=END'
      '110193108=;'
      '110193109='
      '110193110=CREATE PROCEDURE REVISION_PARENT_UPD('
      
        '110193111=  REVISION_PARENT_ /* TYPE OF COLUMN REVISION_PARENT.R' +
        'EVISION_PARENT */ BIGINT,'
      
        '110193112=  DATE_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.DATE_B' +
        'EGIN */ DATE,'
      
        '110193113=  TIME_BEGIN_ /* TYPE OF COLUMN REVISION_PARENT.TIME_B' +
        'EGIN */ TIME,'
      
        '110193114=  DATE_END_ /* TYPE OF COLUMN REVISION_PARENT.DATE_END' +
        ' */ DATE,'
      
        '110193115=  TIME_END_ /* TYPE OF COLUMN REVISION_PARENT.TIME_END' +
        ' */ TIME,'
      
        '110193116=  NOTE_ /* TYPE OF COLUMN REVISION_PARENT.NOTE */ VARC' +
        'HAR(250),'
      
        '110193117=  G_TOCHKA_ /* TYPE OF COLUMN REVISION_PARENT.G_TOCHKA' +
        ' */ BIGINT,'
      
        '110193118=  IS_MADE_ /* TYPE OF COLUMN REVISION_PARENT.IS_MADE *' +
        '/ SMALLINT)'
      '110193119=AS'
      '110193120=BEGIN'
      '110193121=  EXIT;'
      '110193122=END'
      '110193123=;'
      '110193124='
      '110193125='
      
        '110193126=/*****************************************************' +
        '*************************/'
      
        '110193127=/****                   Creating generators (sequences' +
        ')                    ****/'
      
        '110193128=/*****************************************************' +
        '*************************/'
      '110193129='
      '110193130=CREATE GENERATOR GEN_REVISION_PARENT;'
      '110193131='
      '110193132='
      
        '110193133=/*****************************************************' +
        '*************************/'
      
        '110193134=/****              Creating tables (without computed f' +
        'ields)               ****/'
      
        '110193135=/*****************************************************' +
        '*************************/'
      '110193136=CREATE TABLE REVISION_PARENT ('
      '110193137=    REVISION_PARENT DM_BIGINT NOT NULL,'
      '110193138=    DATE_BEGIN DATE,'
      '110193139=    TIME_BEGIN TIME,'
      '110193140=    DATE_END DATE,'
      '110193141=    TIME_END TIME,'
      '110193142=    NOTE DM_VARCHAR_250,'
      '110193143=    G_TOCHKA DM_BIGINT,'
      '110193144=    IS_MADE DM_SMALLINT DEFAULT 0);'
      '110193145='
      '110193146=CREATE GLOBAL TEMPORARY TABLE REVISION_TMP ('
      '110193147=    REVISION DM_BIGINT NOT NULL,'
      '110193148=    G_PRODUCT DM_BIGINT,'
      '110193149=    AMOUNT_BD MY_NUMERIC_5 DEFAULT 0,'
      '110193150=    AMOUNT_REAL MY_NUMERIC_5 DEFAULT 0,'
      '110193151=    REVISION_PARENT DM_BIGINT,'
      '110193152=    DATETIME_CREATED TIMESTAMP)'
      '110193153= ON COMMIT PRESERVE ROWS;'
      '110193154='
      '110193155='
      
        '110193156=/*****************************************************' +
        '*************************/'
      
        '110193157=/****                           Altering tables       ' +
        '                     ****/'
      
        '110193158=/*****************************************************' +
        '*************************/'
      '110193159=ALTER TABLE REVISION'
      '110193160=  ADD REVISION_PARENT DM_BIGINT;'
      '110193161='
      '110193162=ALTER TABLE REVISION'
      '110193163=  ADD DATETIME_CREATED TIMESTAMP;'
      '110193164='
      '110193165='
      
        '110193166=/*****************************************************' +
        '*************************/'
      
        '110193167=/****                   Creating primary key constrain' +
        'ts                   ****/'
      
        '110193168=/*****************************************************' +
        '*************************/'
      '110193169=RECONNECT;'
      '110193170='
      
        '110193171=ALTER TABLE REVISION_PARENT ADD CONSTRAINT PK_REVISION' +
        '_PARENT PRIMARY KEY (REVISION_PARENT);'
      '110193172='
      
        '110193173=ALTER TABLE REVISION_TMP ADD CONSTRAINT PK_REVISION_TM' +
        'P PRIMARY KEY (REVISION);'
      '110193174='
      '110193175='
      
        '110193176=/*****************************************************' +
        '*************************/'
      
        '110193177=/****                   Creating foreign key constrain' +
        'ts                   ****/'
      
        '110193178=/*****************************************************' +
        '*************************/'
      '110193179=RECONNECT;'
      '110193180='
      
        '110193181=ALTER TABLE REVISION ADD CONSTRAINT FK_REVISION_3 FORE' +
        'IGN KEY (REVISION_PARENT) REFERENCES REVISION_PARENT (REVISION_P' +
        'ARENT);'
      '110193182='
      
        '110193183=ALTER TABLE REVISION_PARENT ADD CONSTRAINT FK_REVISION' +
        '_PARENT_1 FOREIGN KEY (G_TOCHKA) REFERENCES G_TOCHKA (G_TOCHKA);'
      '110193184='
      '110193185='
      
        '110193186=/*****************************************************' +
        '*************************/'
      
        '110193187=/****                      Updating column positions  ' +
        '                     ****/'
      
        '110193188=/*****************************************************' +
        '*************************/'
      '110193189=ALTER TABLE REVISION ALTER COLUMN REVISION POSITION 1;'
      '110193190='
      '110193191=ALTER TABLE REVISION ALTER COLUMN SKLAD POSITION 2;'
      '110193192='
      
        '110193193=ALTER TABLE REVISION ALTER COLUMN G_PRODUCT POSITION 3' +
        ';'
      '110193194='
      
        '110193195=ALTER TABLE REVISION ALTER COLUMN AMOUNT_BD POSITION 4' +
        ';'
      '110193196='
      
        '110193197=ALTER TABLE REVISION ALTER COLUMN AMOUNT_REAL POSITION' +
        ' 5;'
      '110193198='
      
        '110193199=ALTER TABLE REVISION ALTER COLUMN IS_UNIFIED POSITION ' +
        '6;'
      '110193200='
      '110193201=ALTER TABLE REVISION ALTER COLUMN G_TOCHKA POSITION 7;'
      '110193202='
      
        '110193203=ALTER TABLE REVISION ALTER COLUMN REVISION_PARENT POSI' +
        'TION 8;'
      '110193204='
      
        '110193205=ALTER TABLE REVISION ALTER COLUMN DATETIME_CREATED POS' +
        'ITION 9;'
      '110193206='
      '110193207='
      
        '110193208=/*****************************************************' +
        '*************************/'
      
        '110193209=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110193210=/*****************************************************' +
        '*************************/'
      '110193211='
      '110193212=ALTER PROCEDURE R_EDIT_REVISION('
      '110193213=  AMOUNT_REAL_ TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '110193214=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110193215=  DATETIME_ TYPE OF COLUMN REVISION.DATETIME_CREATED,'
      '110193216=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110193217=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE = '#39#39')'
      '110193218=RETURNS ('
      '110193219=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '110193220=  ERR_CODE INTEGER,'
      '110193221=  ERR_MSG VARCHAR(1024))'
      '110193222=AS'
      
        '110193223=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'R_EDIT_REVISI' +
        'ON'#39';'
      '110193224=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110193225=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_PR' +
        'ODUCT.AMOUNT;'
      '110193226=DECLARE VARIABLE I INTEGER = 1;'
      '110193227=BEGIN'
      '110193228=  PNT_ = '#39'00'#39';'
      '110193229=  IF (BARCODE_ <> '#39#39') THEN BEGIN'
      '110193230=    SELECT G.G_PRODUCT'
      '110193231=      FROM G_PRODUCT G'
      '110193232=     WHERE G.BARCODE = :BARCODE_'
      '110193233=      INTO :G_PRODUCT_;'
      '110193234='
      '110193235=    IF (G_PRODUCT_ IS NULL) THEN'
      '110193236=        SELECT G.G_PRODUCT'
      '110193237=          FROM LT_BARCODE G'
      '110193238=         WHERE G.BARCODE = :BARCODE_'
      '110193239=          INTO :G_PRODUCT_;'
      '110193240='
      '110193241=    IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '110193242=      ERR_CODE = -20500;'
      
        '110193243=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        #1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' "'#39' ||BARCODE_||'#39'" '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      '110193244=      EXIT;'
      '110193245=    END'
      '110193246=  END'
      '110193247='
      '110193248=  PNT_ = '#39'01'#39';'
      '110193249=  SELECT LT.AMOUNT + LT.AMOUNT_RESERVE'
      '110193250=    FROM LT_SKLAD_PRODUCT LT'
      '110193251=   WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110193252=     AND LT.G_TOCHKA = :G_TOCHKA_'
      '110193253=    INTO :AMOUNT_BD_;'
      '110193254='
      '110193255=  AMOUNT_BD_ = COALESCE(AMOUNT_BD_, 0);'
      '110193256='
      
        '110193257=  -- '#1045#1057#1051#1048' '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1042#1040#1053#1040' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070 +
        ' 1 ('#1045#1057#1051#1048' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045')'
      '110193258=  -- '#1045#1057#1051#1048' '#1053#1045' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1064#1045#1044#1064#1045#1045' '#1050#1054#1051'-'#1042#1054
      '110193259=  PNT_ = '#39'02'#39';'
      '110193260=  UPDATE REVISION_TMP R'
      
        '110193261=     SET R.AMOUNT_REAL = DECODE(:BARCODE_, '#39#39', :AMOUNT' +
        '_REAL_, R.AMOUNT_REAL + 1)'
      '110193262=   WHERE R.G_PRODUCT = :G_PRODUCT_'
      '110193263=  RETURNING'
      '110193264=    REVISION'
      '110193265=  INTO'
      '110193266=    :REVISION_;'
      '110193267='
      '110193268=  PNT_ = '#39'03'#39';'
      '110193269=  IF (ROW_COUNT = 0) THEN'
      
        '110193270=      INSERT INTO REVISION_TMP (REVISION, G_PRODUCT, A' +
        'MOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '110193271=      VALUES (GEN_ID(GEN_REVISION, 1), :G_PRODUCT_, :A' +
        'MOUNT_BD_, :AMOUNT_REAL_, :DATETIME_)'
      '110193272=      RETURNING'
      '110193273=        REVISION'
      '110193274=      INTO'
      '110193275=        :REVISION_;'
      '110193276='
      '110193277=WHEN ANY DO BEGIN'
      '110193278=    Err_code = -20500;'
      
        '110193279=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1042#1057 +
        #1058#1040#1042#1050#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110193280=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110193281=  END'
      '110193282=END'
      '110193283=;'
      '110193284='
      '110193285=ALTER PROCEDURE R_INS_REVISION('
      
        '110193286=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT,'
      '110193287=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110193288=RETURNS ('
      '110193289=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '110193290=  ERR_CODE INTEGER,'
      '110193291=  ERR_MSG VARCHAR(1024))'
      '110193292=AS'
      
        '110193293=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_PR' +
        'ODUCT.AMOUNT;'
      '110193294=DECLARE VARIABLE I INTEGER = 1;'
      '110193295=BEGIN'
      '110193296='
      
        '110193297=  INSERT INTO REVISION (REVISION, SKLAD, G_PRODUCT, AM' +
        'OUNT_BD, AMOUNT_REAL)'
      
        '110193298=  VALUES (GEN_ID(GEN_REVISION, 1), NULL, :G_PRODUCT_, ' +
        ':AMOUNT_BD_, 0)'
      '110193299=  RETURNING'
      '110193300=    REVISION'
      '110193301=  INTO'
      '110193302=    :REVISION_;'
      '110193303='
      '110193304=END'
      '110193305=;'
      '110193306='
      '110193307=ALTER PROCEDURE R_MADE_REVISION('
      
        '110193308=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEGI' +
        'N,'
      
        '110193309=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEGI' +
        'N,'
      '110193310=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '110193311=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '110193312=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '110193313=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '110193314=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT)'
      '110193315=RETURNS ('
      '110193316=  COUNT_SPIS_ INTEGER,'
      '110193317=  COUNT_PRIH_ INTEGER,'
      
        '110193318=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT.' +
        'REVISION_PARENT,'
      '110193319=  ERR_CODE INTEGER,'
      '110193320=  ERR_MSG VARCHAR(1024))'
      '110193321=AS'
      
        '110193322=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVISI' +
        'ON'#39';'
      '110193323=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110193324=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REV' +
        'ISION;'
      
        '110193325=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_' +
        'PRODUCT;'
      
        '110193326=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AM' +
        'OUNT_BD;'
      
        '110193327=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.' +
        'AMOUNT_REAL;'
      
        '110193328=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      '110193329=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110193330=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110193331=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110193332=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '110193333=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REVI' +
        'SION.DATETIME_CREATED;'
      
        '110193334=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.AMOUNT;'
      '110193335=BEGIN'
      '110193336='
      '110193337=  COUNT_SPIS_ = 0;'
      '110193338=  COUNT_PRIH_ = 0;'
      '110193339='
      '110193340=  PNT_ = '#39'00'#39';'
      '110193341=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '110193342=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGIN' +
        '_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '110193343=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :E' +
        'RR_MSG;'
      '110193344='
      '110193345=     IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110193346=       ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '110193347=       EXIT;'
      '110193348=     END'
      '110193349=  END'
      '110193350='
      '110193351=  PNT_ = '#39'01'#39';'
      
        '110193352=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_RE' +
        'AL, DATETIME_CREATED'
      '110193353=      FROM REVISION_TMP'
      '110193354=      --WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '110193355=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOU' +
        'NT_REAL_, :DATETIME_CREATED_'
      '110193356=  DO BEGIN'
      '110193357=    /*SELECT SUM(ZD.AMOUNT)'
      '110193358=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '110193359=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ AS' +
        ' DATE) AND CURRENT_DATE'
      
        '110193360=       AND Z.Z_TIME >= CAST(:DATETIME_CREATED_ AS TIME' +
        ')'
      '110193361=       AND Z.Z_TIME <= CURRENT_TIME'
      '110193362=       AND Z.IS_SPISANIE IN (0, 1)'
      '110193363=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110193364=      INTO :AMOUNT_SALED_;*/'
      '110193365='
      '110193366=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '110193367=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1)'
      '110193368=        RETURNING_VALUES :COST_PRICE_;'
      '110193369='
      
        '110193370=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_' +
        'PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110193371=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM)'
      
        '110193372=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/, :COST_PRICE_,' +
        ' :COST_PRICE_ * (:AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*' +
        '/), 0, 0, 0, 0, 0);'
      '110193373='
      '110193374=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '110193375=    END'
      '110193376='
      '110193377=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      '110193378=      SELECT S.price'
      '110193379=        FROM SKLAD S'
      '110193380=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '110193381=         AND S.g_product = :G_PRODUCT_'
      '110193382=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '110193383=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECE' +
        'IPT)'
      '110193384=                                 FROM SKLAD DD'
      
        '110193385=                                WHERE DD.g_product = :' +
        'G_PRODUCT_'
      
        '110193386=                                  AND DD.G_TOCHKA = :G' +
        '_TOCHKA_'
      
        '110193387=                                  AND DD.IS_VOZVRAT IN' +
        ' (0, 4)'
      '110193388=                                )'
      '110193389=        ORDER BY s.sklad DESC'
      '110193390=        ROWS 1 TO 1'
      '110193391=        INTO :PRICE_LAST_;'
      '110193392='
      
        '110193393=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056 +
        #1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '110193394='
      
        '110193395=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110193396=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/, :PRICE_LAST_,' +
        ' (:AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/) * :PRICE_LAS' +
        'T_, 0, 0);'
      '110193397='
      '110193398=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '110193399=    END'
      '110193400=  END'
      '110193401='
      '110193402=  PNT_ = '#39'01A'#39';'
      '110193403=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '110193404=    SELECT SUM(S.SUMM)'
      '110193405=      FROM ZAKAZ_DETAILS_TMP S'
      '110193406=      INTO :SUMM_;'
      '110193407='
      '110193408=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110193409=                                CURRENT_DATE, --:Z_DAT' +
        'E_,'
      
        '110193410=                                CURRENT_TIME, --:Z_TIM' +
        'E'
      
        '110193411=                                10,          --:G_CLIE' +
        'NT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '110193412=                                1,            --:G_PAY' +
        'MENT_TYPE_,'
      
        '110193413=                                NULL,         --:OSNOV' +
        'ANIE_,'
      
        '110193414=                                1,              --:IS_' +
        'SPISANIE_,'
      
        '110193415=                                NULL,           --:NOT' +
        'E_,'
      
        '110193416=                                :SUMM_,              -' +
        '-:SUMM_,'
      
        '110193417=                                :SUMM_,              -' +
        '-:SUMM_FACT_,'
      
        '110193418=                                0,              --SUMM' +
        '_BONUS_'
      
        '110193419=                                0,              --SUMM' +
        '_BONUS_GOT'
      
        '110193420=                                NULL,           --:G_P' +
        'RIHOD_,'
      '110193421=                                NULL,'
      '110193422=                                0,        -- BY_RECIPE'
      
        '110193423=                                0         -- IS_RESERV' +
        'E'
      '110193424=                                ,NULL  -- PAYMENTS_'
      '110193425=                                ,0     -- SUMM_CASH'
      '110193426=                                ,0     -- SUMM_NONCASH'
      
        '110193427=                                ) RETURNING_VALUES :ZA' +
        'KAZ_, :ERR_CODE, :ERR_MSG;'
      '110193428=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110193429=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110193430=      EXIT;'
      '110193431=    END'
      '110193432=  END'
      '110193433='
      '110193434=  PNT_ = '#39'02'#39';'
      '110193435=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '110193436=    SELECT SUM(S.SUMM)'
      '110193437=      FROM SKLAD_TMP S'
      '110193438=      INTO :SUMM_;'
      '110193439='
      '110193440=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110193441=                                CURRENT_DATE,   --:DAT' +
        'E_RECEIPT_,'
      '110193442=                                CURRENT_TIME,'
      
        '110193443=                                NULL,           --:G_C' +
        'LIENT_,'
      
        '110193444=                                1,              --:G_P' +
        'AYMENT_TYPE_,'
      
        '110193445=                                NULL,           --:OSN' +
        'OVANIE_,'
      
        '110193446=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',   ' +
        '        --:NOTE_,'
      
        '110193447=                                5,              --:IS_' +
        'VOZVRAT_,'
      '110193448=                                :SUMM_,'
      '110193449=                                :SUMM_,'
      
        '110193450=                                NULL,           --:G_P' +
        'RIHOD_,'
      
        '110193451=                                NULL            --:SUM' +
        'M_PRIHOD_'
      '110193452=                                ,NULL  --PAYMENTS'
      '110193453=                                )'
      '110193454=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110193455=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110193456=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110193457=      EXIT;'
      '110193458=    END'
      '110193459=  END'
      '110193460='
      '110193461=  UPDATE REVISION_PARENT RP'
      '110193462=     SET RP.IS_MADE = 1,'
      '110193463=         RP.DATE_END = :DATE_END_,'
      '110193464=         RP.TIME_END = :TIME_END_'
      '110193465=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '110193466='
      '110193467=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '110193468=END'
      '110193469=;'
      '110193470='
      '110193471=ALTER PROCEDURE REVISION_PARENT_DEL('
      
        '110193472=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT)'
      '110193473=AS'
      '110193474=BEGIN'
      '110193475=  IF (REVISION_PARENT_ <> 0) THEN BEGIN'
      '110193476=      DELETE FROM REVISION R'
      '110193477=      WHERE R.REVISION_PARENT = :REVISION_PARENT_;'
      '110193478='
      '110193479=      DELETE FROM REVISION_PARENT'
      '110193480=      WHERE (REVISION_PARENT = :REVISION_PARENT_);'
      '110193481=  END'
      '110193482=  ELSE'
      '110193483=    DELETE FROM REVISION_TMP;'
      '110193484=END'
      '110193485=;'
      '110193486='
      '110193487=ALTER PROCEDURE REVISION_PARENT_GET('
      
        '110193488=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT)'
      '110193489=RETURNS ('
      
        '110193490=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEGI' +
        'N,'
      
        '110193491=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEGI' +
        'N,'
      '110193492=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '110193493=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '110193494=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '110193495=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '110193496=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE)'
      '110193497=AS'
      '110193498=BEGIN'
      
        '110193499=  SELECT DATE_BEGIN, TIME_BEGIN, DATE_END, TIME_END, N' +
        'OTE, G_TOCHKA, IS_MADE'
      '110193500=  FROM REVISION_PARENT'
      '110193501=  WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '110193502=  INTO :DATE_BEGIN_, :TIME_BEGIN_, :DATE_END_, :TIME_E' +
        'ND_, :NOTE_, :G_TOCHKA_, :IS_MADE_;'
      '110193503='
      
        '110193504=  INSERT INTO REVISION_TMP (REVISION, G_PRODUCT, AMOUN' +
        'T_BD, AMOUNT_REAL, REVISION_PARENT, DATETIME_CREATED)'
      
        '110193505=  SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, ' +
        'REVISION_PARENT, DATETIME_CREATED'
      '110193506=  FROM REVISION'
      '110193507=  WHERE REVISION_PARENT = :REVISION_PARENT_;'
      '110193508=END'
      '110193509=;'
      '110193510='
      '110193511=ALTER PROCEDURE REVISION_PARENT_INS('
      
        '110193512=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEGI' +
        'N,'
      
        '110193513=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEGI' +
        'N,'
      '110193514=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '110193515=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '110193516=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '110193517=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '110193518=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE)'
      '110193519=RETURNS ('
      
        '110193520=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT,'
      '110193521=  ERR_CODE INTEGER,'
      '110193522=  ERR_MSG VARCHAR(1024))'
      '110193523=AS'
      '110193524=BEGIN'
      '110193525=  INSERT INTO REVISION_PARENT ('
      '110193526=    REVISION_PARENT,'
      '110193527=    DATE_BEGIN,'
      '110193528=    TIME_BEGIN,'
      '110193529=    DATE_END,'
      '110193530=    TIME_END,'
      '110193531=    NOTE,'
      '110193532=    G_TOCHKA,'
      '110193533=    IS_MADE)'
      '110193534=  VALUES ('
      '110193535=    GEN_ID(GEN_REVISION_PARENT, 1),'
      '110193536=    :DATE_BEGIN_, --CURRENT_DATE,'
      '110193537=    :TIME_BEGIN_, --CURRENT_TIME,'
      '110193538=    :DATE_END_,'
      '110193539=    :TIME_END_,'
      '110193540=    :NOTE_,'
      '110193541=    :G_TOCHKA_,'
      '110193542=    :IS_MADE_)'
      '110193543=  RETURNING REVISION_PARENT'
      '110193544=  INTO :REVISION_PARENT_;'
      '110193545='
      
        '110193546=  INSERT INTO REVISION (REVISION, G_PRODUCT, AMOUNT_BD' +
        ', AMOUNT_REAL, REVISION_PARENT, DATETIME_CREATED)'
      
        '110193547=  SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, ' +
        ':REVISION_PARENT_, DATETIME_CREATED'
      '110193548=  FROM REVISION_TMP;'
      '110193549=END'
      '110193550=;'
      '110193551='
      '110193552=ALTER PROCEDURE REVISION_PARENT_READ('
      
        '110193553=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEGI' +
        'N,'
      '110193554=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '110193555=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA)'
      '110193556=RETURNS ('
      
        '110193557=  REVISION_PARENT TYPE OF COLUMN REVISION_PARENT.REVIS' +
        'ION_PARENT,'
      '110193558=  DATE_BEGIN TIMESTAMP,'
      '110193559=  DATE_END TIMESTAMP,'
      '110193560=  NOTE TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '110193561=  G_TOCHKA TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '110193562=  IS_MADE TYPE OF COLUMN REVISION_PARENT.IS_MADE,'
      '110193563=  IS_MADE_STR VARCHAR(5))'
      '110193564=AS'
      '110193565=BEGIN'
      '110193566=  FOR SELECT REVISION_PARENT,'
      '110193567=             DATE_BEGIN + TIME_BEGIN,'
      '110193568=             DATE_END + TIME_END,'
      '110193569=             NOTE,'
      '110193570=             G_TOCHKA,'
      '110193571=             IS_MADE,'
      '110193572=             DECODE(IS_MADE, 1, '#39#1044#1072#39', '#39#1053#1077#1090#39')'
      '110193573=      FROM REVISION_PARENT'
      
        '110193574=      WHERE DATE_BEGIN BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '110193575=        AND G_TOCHKA = :G_TOCHKA_'
      '110193576=      INTO :REVISION_PARENT,'
      '110193577=           :DATE_BEGIN,'
      '110193578=           :DATE_END,'
      '110193579=           :NOTE,'
      '110193580=           :G_TOCHKA,'
      '110193581=           :IS_MADE,'
      '110193582=           :IS_MADE_STR'
      '110193583=  DO SUSPEND;'
      '110193584=END'
      '110193585=;'
      '110193586='
      '110193587=ALTER PROCEDURE REVISION_PARENT_UPD('
      
        '110193588=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT,'
      
        '110193589=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEGI' +
        'N,'
      
        '110193590=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEGI' +
