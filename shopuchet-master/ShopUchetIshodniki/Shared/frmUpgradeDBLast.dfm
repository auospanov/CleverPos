        '|ERR_MSG;'
      '1102282697=          EXIT;'
      '1102282698=        END'
      '1102282699=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102282700=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1102282701=                                          :G_PRIHOD_,'
      
        '1102282702=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102282703=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102282704=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1102282705=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1102282706=                                          :SKLAD_PARE' +
