        'D = 0,'
      '1102492623=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102492624=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
