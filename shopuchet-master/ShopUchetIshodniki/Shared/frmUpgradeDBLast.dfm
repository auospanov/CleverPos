        '1102015206=                          AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||ZZ.G_TOCHKA||'#39'-'#39
      '1102015207=                       )'
      '1102015208=           -- '#1060#1048#1051#1068#1058#1056
      
        '1102015209=           AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PR' +
        'ODUCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
