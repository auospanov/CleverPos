        '= Z.ZAKAZ'
      
        '110208487=                                          AND Z.z_date' +
        ' BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110208488=                                          AND Z.G_TOCH' +
        'KA = :G_TOCHKA_'
      
        '110208489=                                          AND Z.is_spi' +
        'sanie = 4'
      
        '110208490=                                          AND K.ACTION' +
        '_DATE = Z.Z_DATE)'
      '110208491=               )'
      '110208492=      returning'
      '110208493=        SUMM'
      '110208494=      INTO'
      '110208495=        :summ_prihod_;'
      '110208496='
      
        '110208497=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110208498=        VALUES (19, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', (SELECT SUM(' +
        'K.SUMM)'
      
        '110208499=                                             FROM KASS' +
        'A_BEZNAL K,'
      
        '110208500=                                                  ZAKA' +
        'Z Z'
      
        '110208501=                                            WHERE K.G_' +
        'TOCHKA = :G_TOCHKA_'
      
        '110208502=                                              AND K.ZA' +
        'KAZ = Z.ZAKAZ'
      
        '110208503=                                              AND Z.z_' +
        'date BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110208504=                                              AND Z.G_' +
        'TOCHKA = :G_TOCHKA_'
      
        '110208505=                                              AND Z.is' +
        '_spisanie = 4'
      
        '110208506=                                              AND K.AC' +
        'TION_DATE = Z.Z_DATE)'
      '110208507=               );'
      
        '110208508=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L)'
      '110208509=      VALUES(20, 1);'
      '110208510='
      
        '110208511=      SUMM_PRIHOD_ALL_ = SUMM_PRIHOD_ALL_ + summ_priho' +
        'd_;'
      '110208512=  END'
      '110208513='
      '110208514=  -- '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '110208515=  FIRST_ITER = 0;'
      '110208516=  SUMM_PRIHOD_ = 0;'
      
        '110208517=  FOR SELECT lpad(EXTRACT(DAY FROM K.action_date), 2, ' +
        #39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39'.'#39'|' +
        '|EXTRACT(YEAR FROM K.action_date),'
      '110208518=             K.action_date,'
      
        '110208519=             G.name||DECODE(CHAR_LENGTH(K.NOTE), 0, '#39#39 +
        ', '#39' ('#39'||K.NOTE||'#39')'#39')'
      '110208520=             ,SUM(K.summ)'
      '110208521=        FROM KASSA k, g_prihod_rashod G'
      
        '110208522=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110208523=         AND K.ACTION = 0'
      
        '110208524=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '110208525=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '110208526=         AND K.g_tochka = :G_TOCHKA_'
      '110208527=        GROUP BY 2, 3'
      '110208528=        UNION ALL'
      
        '110208529=        SELECT lpad(EXTRACT(DAY FROM K.action_date), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM K.action_date),'
      '110208530=             K.action_date,'
      '110208531=             '#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1086#1084#39' name'
      '110208532=             ,SUM(K.summ)'
      '110208533=        FROM KASSA k'
      '110208534=        WHERE K.G_PRIHOD_RASHOD = 1'
      
        '110208535=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '110208536=         AND K.action_date <> (SELECT Z_DATE FROM ZAKA' +
        'Z WHERE ZAKAZ = K.zakaz)'
      '110208537=         AND K.g_tochka = :G_TOCHKA_'
      '110208538=        GROUP BY 2, 3'
      '110208539=        INTO :date_str,'
      '110208540=           :Z_DATE,'
      '110208541=           :NAME,'
      '110208542=           :SUMM'
      '110208543=  DO BEGIN'
      '110208544=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110208545=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110208546=      VALUES (21, 1, '#39#1055#1088#1080#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1074' '#1082#1072#1089#1089#1091#39');'
      '110208547=      FIRST_ITER = 1;'
      '110208548=    END'
      '110208549='
      
        '110208550=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '110208551=      VALUES (22, 2, :DATE_STR, :z_date, :NAME, :SUMM)' +
        ';'
      '110208552='
      '110208553=    SUMM_PRIHOD_ = SUMM_PRIHOD_ + SUMM;'
      '110208554=  END'
      '110208555='
      '110208556=  IF (FIRST_ITER = 1) THEN'
      
        '110208557=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, SUMM)'
      
        '110208558=    VALUES (23, 3, '#39#1048#1090#1086#1075#1086' '#1087#1088#1080#1093#1086#1076' '#1076#1077#1085#1077#1075#39', :SUMM_PRIHOD_' +
        ');'
      '110208559=  SUMM_PRIHOD_ALL_ = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD_;'
      '110208560='
      '110208561=  -- '#1056#1040#1057#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1048#1047' '#1050#1040#1057#1057#1067
      '110208562=  FIRST_ITER = 0;'
      '110208563=  SUMM_RASHOD_ = 0;'
      
        '110208564=  FOR SELECT lpad(EXTRACT(DAY FROM K.action_date), 2, ' +
        #39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39'.'#39'|' +
        '|EXTRACT(YEAR FROM K.action_date),'
      '110208565=             K.action_date,'
      
        '110208566=             G.name||DECODE(CHAR_LENGTH(K.NOTE), 0, '#39#39 +
        ', '#39' ('#39'||K.NOTE||'#39')'#39')'
      '110208567=             ,SUM(K.summ)'
      '110208568=        FROM KASSA k, g_prihod_rashod G'
      
        '110208569=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110208570=         AND K.ACTION = 1'
      
        '110208571=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '110208572=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '110208573=         AND K.g_tochka = :G_TOCHKA_'
      '110208574=        GROUP BY 2, 3'
      '110208575=        UNION ALL'
      
        '110208576=        SELECT lpad(EXTRACT(DAY FROM K.action_date), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM K.action_date),'
      '110208577=             K.action_date,'
      '110208578=             '#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1091'/'#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39' name'
      '110208579=             ,SUM(K.summ)'
      '110208580=        FROM KASSA k'
      '110208581=        WHERE K.G_PRIHOD_RASHOD in (2,3)'
      
        '110208582=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '110208583=         AND K.action_date <> (SELECT DATE_RECEIPT FRO' +
        'M SKLAD_PARENT WHERE SKLAD = K.sklad)'
      '110208584=         AND K.g_tochka = :G_TOCHKA_'
      '110208585=        GROUP BY 2, 3'
      '110208586=        INTO :date_str,'
      '110208587=           :Z_DATE,'
      '110208588=           :NAME,'
      '110208589=           :SUMM'
      '110208590=  DO BEGIN'
      '110208591=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110208592=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110208593=      VALUES (24, 1, '#39#1056#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1080#1079' '#1082#1072#1089#1089#1099#39');'
      '110208594=      FIRST_ITER = 1;'
      '110208595=    END'
      '110208596='
      
        '110208597=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '110208598=      VALUES (25, 2, :DATE_STR, :z_date, :NAME, :SUMM)' +
        ';'
      '110208599='
      '110208600=    SUMM_RASHOD_ = SUMM_RASHOD_ + SUMM;'
      '110208601=  END'
      '110208602='
      '110208603=  IF (FIRST_ITER = 1) THEN'
      
        '110208604=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, SUMM)'
      
        '110208605=    VALUES (26, 3, '#39#1048#1090#1086#1075#1086' '#1088#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075#39', :SUMM_RASHOD_' +
        ');'
      '110208606=  SUMM_RASHOD_ALL_ = SUMM_RASHOD_ALL_ + SUMM_RASHOD_;'
      '110208607='
      '110208608=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '110208609=  VALUES(27, 1);'
      '110208610='
      
        '110208611=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110208612=  VALUES (28, 1, '#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' '#1085#1072' '#1089#1091#1084#1084#1091#39',' +
        ' :SUMM_PRIHOD_ALL_);'
      '110208613='
      
        '110208614=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110208615=  VALUES (29, 1, '#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1085#1072' '#1089#1091#1084#1084#1091#39', :SUMM' +
        '_RASHOD_ALL_);'
      '110208616='
      
        '110208617=  OUT_SUMM_ = IN_SUMM_ + SUMM_PRIHOD_ALL_ - SUMM_RASHO' +
        'D_ALL_;'
      '110208618='
      '110208619=  FOR SELECT SORT_COL'
      '110208620=            ,ROW_COL'
      '110208621=            ,Z_DATE'
      '110208622=            ,Z_DATE_STR'
      '110208623=            ,ARTICUL'
      '110208624=            ,BARCODE'
      '110208625=            ,NAME'
      '110208626=            ,AMOUNT'
      '110208627=            ,SUMM'
      '110208628=        FROM P_REP_KASSIR_TABLE'
      '110208629=    ORDER BY 1, 3, 7'
      '110208630=    INTO :SORT_COL,'
      '110208631=        :ROWCOL,'
      '110208632=        :Z_DATE_LOC,'
      '110208633=        :Z_DATE,'
      '110208634=        :ARTICUL,'
      '110208635=        :BARCODE,'
      '110208636=        :NAME,'
      '110208637=        :AMOUNT,'
      '110208638=        :SUMM'
      '110208639=  DO'
      '110208640=    suspend;'
      '110208641=end'
      '110208642=;'
      '110208643='
      '110208644=ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      '110208645=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110208646=  CURRENCY_ INTEGER)'
      '110208647=RETURNS ('
      '110208648=  NUMBER_STR_ VARCHAR(200),'
      '110208649=  ROW_NUM INTEGER,'
      '110208650=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110208651=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110208652=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110208653=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110208654=  PRICE_ROZN TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110208655=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110208656=  AMOUNT MY_NUMERIC_5,'
      '110208657=  PRICE_N VARCHAR(50),'
      '110208658=  SUMM_N VARCHAR(50),'
      '110208659=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '110208660=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '110208661=  SUMM_VSEGO_ VARCHAR(50),'
      '110208662=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110208663=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110208664=  SUMM_STR_ VARCHAR(500),'
      '110208665=  ERR_CODE NUMERIC(15,2),'
      '110208666=  ERR_MSG VARCHAR(1024))'
      '110208667=AS'
      '110208668=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '110208669=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD_' +
        'WAYBILL'#39';'
      '110208670=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110208671=DECLARE VARIABLE I INTEGER = 1;'
      
        '110208672=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110208673=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110208674=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      
        '110208675=DECLARE VARIABLE HAVE_RIGHT_TO_SEE_COST_PRICE_ INTEGER' +
        ' = 0;'
      '110208676=BEGIN'
      '110208677='
      
        '110208678=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.sklad||'#39' '#1086#1090' '#39'||lpad(EXTRACT(' +
        'DAY FROM P.date_receipt), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM ' +
        'P.date_receipt), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.date_receipt),'
      '110208679=         G.name,'
      '110208680=         P.IS_VOZVRAT'
      
        '110208681=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON ' +
        'P.g_client = G.G_CLIENT'
      '110208682=   WHERE P.sklad = :sklad_parent_'
      '110208683=    INTO :NUMBER_STR_,'
      '110208684=         :POSTAVSHIK_NAME_,'
      '110208685=         :IS_VOZVRAT_;'
      '110208686='
      '110208687=  SELECT ID, NAME'
      '110208688=    FROM CUR_PARAMS'
      '110208689=   WHERE CUR_PARAMS = 1'
      '110208690=    INTO :G_OFFICIAL_, :G_OFFICIAL_FM_;'
      '110208691='
      
        '110208692=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058#1068 +
        ' '#1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      
        '110208693=  -- '#1048' '#1055#1056#1054#1042#1045#1056#1048#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1059' '#1053#1045#1043#1054' '#1055#1056#1040#1042#1054' '#1053#1040' '#1055#1056#1054#1057#1052#1054#1058#1056' '#1047#1040#1050#1059 +
        #1055#1054#1063#1053#1067#1061' '#1062#1045#1053
      '110208694=  IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '110208695=    SELECT G.NAME'
      '110208696=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '110208697=     WHERE P.SKLAD = :sklad_parent_'
      '110208698=       AND P.G_TOCHKA = G.G_TOCHKA'
      '110208699=      INTO :POSTAVSHIK_NAME_;'
      '110208700='
      '110208701=    SELECT COUNT(*)'
      '110208702=      FROM G_OFFICIAL_RIGHT GR'
      '110208703=     WHERE GR.G_OFFICIAL = :G_OFFICIAL_'
      '110208704=       AND GR.RIGHTS_ITEM = 105'
      '110208705=      INTO :HAVE_RIGHT_TO_SEE_COST_PRICE_;'
      '110208706=  END'
      '110208707='
      
        '110208708=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) A' +
        'S VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '110208709=         ,REPLACE(CAST(SUM(DECODE(:IS_VOZVRAT_, 3, DEC' +
        'ODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.SUMM), S.SUMM)) AS V' +
        'ARCHAR(50)), '#39'.'#39', '#39','#39')'
      
        '110208710=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(DECODE' +
        '(:IS_VOZVRAT_, 3, DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S' +
        '.PRICE), S.PRICE)), :CURRENCY_))'
      '110208711=    FROM SKLAD S'
      '110208712=   WHERE S.sklad_parent = :sklad_parent_'
      '110208713=   GROUP BY S.sklad_parent'
      '110208714=    INTO :AMOUNT_VSEGO_,'
      '110208715=         :SUMM_VSEGO_,'
      '110208716=         :summ_str_;'
      '110208717='
      '110208718=  FOR SELECT :I,'
      '110208719=             G.name,'
      '110208720=             G.ARTICUL,'
      '110208721=             G.BARCODE,'
      '110208722=             G.NOMENCLATUR_NUM,'
      '110208723=             G.PRICE,'
      '110208724=             U.short_name,'
      
        '110208725=             S.amount,    --REPLACE(CAST(S.amount AS V' +
        'ARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '110208726=             REPLACE(CAST(DECODE(:IS_VOZVRAT_, 3, DECO' +
        'DE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.PRICE), S.PRICE) AS V' +
        'ARCHAR(50)), '#39'.'#39', '#39','#39'),'
      
        '110208727=             REPLACE(CAST(DECODE(:IS_VOZVRAT_, 3, DECO' +
        'DE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.SUMM), S.SUMM) AS VAR' +
        'CHAR(50)), '#39'.'#39', '#39','#39'),'
      '110208728=             G.PRICE'
      '110208729=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '110208730=       WHERE S.sklad_parent = :sklad_parent_'
      '110208731=         AND S.g_product = G.g_product'
      '110208732=         AND G.g_unit = U.g_unit'
      '110208733=        INTO :ROW_NUM,'
      '110208734=            :NAME,'
      '110208735=            :ARTICUL,'
      '110208736=            :BARCODE,'
      '110208737=            :NOMENCLATUR_NUM,'
      '110208738=            :PRICE_ROZN,'
      '110208739=            :SHORT_NAME,'
      '110208740=            :AMOUNT,'
      '110208741=            :PRICE_N,'
      '110208742=            :SUMM_N,'
      '110208743=            :PRICE'
      '110208744=  DO BEGIN'
      '110208745=    I = I + 1;'
      '110208746=    SUSPEND;'
      '110208747=  END'
      '110208748=WHEN ANY DO BEGIN'
      '110208749=    Err_code = -20500;'
      
        '110208750=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110208751=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110208752=  END'
      '110208753=end'
      '110208754=;'
      '110208755='
      '110208756=ALTER PROCEDURE P_REP_PRODAZHA_WAYBILL('
      '110208757=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110208758=  CURRENCY_ INTEGER)'
      '110208759=RETURNS ('
      '110208760=  NUMBER_STR_ VARCHAR(200),'
      '110208761=  ROW_NUM INTEGER,'
      '110208762=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110208763=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110208764=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110208765=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110208766=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110208767=  PRICE_ROZN TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110208768=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110208769=  AMOUNT MY_NUMERIC_5,'
      '110208770=  PRICE_N VARCHAR(50),'
      '110208771=  SUMM_N VARCHAR(50),'
      '110208772=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '110208773=  SUMM_VSEGO_ VARCHAR(50),'
      '110208774=  NDS_SUMM_ VARCHAR(50),'
      '110208775=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110208776=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110208777=  SUMM_STR_ VARCHAR(500),'
      '110208778=  NDS_SUMM_STR_ VARCHAR(500),'
      '110208779=  ERR_CODE NUMERIC(15,2),'
      '110208780=  ERR_MSG VARCHAR(1024))'
      '110208781=AS'
      '110208782=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '110208783=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRODAZH' +
        'A_WAYBILL'#39';'
      '110208784=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110208785=DECLARE VARIABLE I INTEGER = 1;'
      
        '110208786=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110208787=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        '_SUMM;'
      '110208788=BEGIN'
      '110208789='
      
        '110208790=  SELECT decode(P.is_spisanie, 1, '#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39', '#39#1053#1072#1082#1083#1072#1076 +
        #1085#1072#1103' '#8470#39'||P.ZAKAZ)||'#39' '#1086#1090' '#39'||lpad(EXTRACT(DAY FROM P.z_date), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM P.z_date),'
      '110208791=         G.name'
      '110208792=    FROM ZAKAZ P,'
      '110208793=         G_CLIENT G'
      '110208794=   WHERE P.ZAKAZ = :ZAKAZ_'
      '110208795=     AND P.g_client = G.G_CLIENT'
      '110208796=    INTO :NUMBER_STR_,'
      '110208797=         :CLIENT_NAME_;'
      '110208798='
      
        '110208799=  SELECT SUM(S.amount)--REPLACE(CAST(SUM(S.amount) AS ' +
        'VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '110208800=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39'.' +
        #39', '#39','#39')'
      
        '110208801=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ' +
        '), :CURRENCY_))'
      
        '110208802=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(50))' +
        ', '#39'.'#39', '#39','#39')'
      '110208803=         ,SUM(S.nds_summ)'
      '110208804=    FROM ZAKAZ_DETAILS S'
      '110208805=   WHERE S.ZAKAZ = :ZAKAZ_'
      '110208806=   GROUP BY S.ZAKAZ'
      '110208807=    INTO :AMOUNT_VSEGO_,'
      '110208808=         :SUMM_VSEGO_,'
      '110208809=         :summ_str_,'
      '110208810=         :NDS_SUMM_,'
      '110208811=         :NDS_;'
      '110208812='
      '110208813=  if (NDS_ > 0) then'
      
        '110208814=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENCY' +
        'STR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '110208815='
      '110208816=  SELECT NAME'
      '110208817=    FROM CUR_PARAMS'
      '110208818=   WHERE CUR_PARAMS = 1'
      '110208819=    INTO :G_OFFICIAL_FM_;'
      '110208820='
      '110208821=  FOR SELECT :I,'
      '110208822=             C.NAME,'
      '110208823=             G.name,'
      '110208824=             G.ARTICUL,'
      '110208825=             G.BARCODE,'
      '110208826=             G.NOMENCLATUR_NUM,'
      '110208827=             G.PRICE,'
      '110208828=             U.short_name,'
      
        '110208829=             S.amount,--REPLACE(CAST(S.amount AS VARCH' +
        'AR(10)), '#39'.'#39', '#39','#39'),'
      
        '110208830=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39'),'
      
        '110208831=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39',' +
        ' '#39','#39')'
      
        '110208832=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, G' +
        '_PRODUCT C'
      '110208833=       WHERE S.ZAKAZ = :ZAKAZ_'
      '110208834=         AND S.g_product = G.g_product'
      '110208835=         AND G.g_unit = U.g_unit'
      '110208836=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '110208837=        INTO :ROW_NUM,'
      '110208838=            :CATEGORY_NAME,'
      '110208839=            :NAME,'
      '110208840=            :ARTICUL,'
      '110208841=            :BARCODE,'
      '110208842=            :NOMENCLATUR_NUM,'
      '110208843=            :PRICE_ROZN,'
      '110208844=            :SHORT_NAME,'
      '110208845=            :AMOUNT,'
      '110208846=            :PRICE_N,'
      '110208847=            :SUMM_N'
      '110208848=  DO BEGIN'
      '110208849=    I = I + 1;'
      '110208850=    SUSPEND;'
      '110208851=  END'
      '110208852=WHEN ANY DO BEGIN'
      '110208853=    Err_code = -20500;'
      
        '110208854=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110208855=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110208856=  END'
      '110208857=end'
      '110208858=;'
      '110208859='
      '110208860=ALTER PROCEDURE P_REP_SALESMAN_RATING('
      '110208861=  DATE_BEGIN_ DATE,'
      '110208862=  DATE_END_ DATE,'
      '110208863=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '110208864=RETURNS ('
      '110208865=  DATE_ VARCHAR(50),'
      '110208866=  G_OFFICIAL_FM TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110208867=  SUMM TYPE OF COLUMN ZAKAZ.SUMM,'
      '110208868=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110208869=  BILL_CNT INTEGER)'
      '110208870=AS'
      '110208871=BEGIN'
      '110208872='
      
        '110208873=  DATE_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE_B' +
        'EGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110208874=               lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRA' +
        'CT(YEAR FROM DATE_END_);'
      '110208875='
      '110208876=  FOR'
      
        '110208877=    SELECT DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FM||'#39 +
        ' '#39'||GG.NM||'#39' '#39'||GG.FT, GG.FIO_DOC),'
      '110208878=           TT.SUMM,'
      '110208879=           TT.SUMM_AMOUNT,'
      '110208880=           TT.BILL_CNT'
      '110208881=      FROM G_OFFICIAL GG,'
      '110208882=           (SELECT SUM(ZD.SUMM) SUMM,'
      '110208883=                   SUM(ZD.AMOUNT) SUMM_AMOUNT,'
      
        '110208884=                   (SELECT COUNT(ZZ.ZAKAZ) FROM ZAKAZ ' +
        'ZZ WHERE ZZ.G_OFFICIAL = Z.G_OFFICIAL AND ZZ.Z_DATE BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_) BILL_CNT,'
      '110208885=                   Z.G_OFFICIAL'
      '110208886=              FROM ZAKAZ Z,'
      '110208887=                   ZAKAZ_DETAILS ZD'
      '110208888=             WHERE Z.ZAKAZ = ZD.ZAKAZ'
      
        '110208889=               AND Z.G_OFFICIAL = (CASE WHEN :G_OFFICI' +
        'AL_ IS NULL THEN Z.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      
        '110208890=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110208891=             GROUP BY Z.G_OFFICIAL) TT'
      '110208892=     WHERE GG.G_OFFICIAL = TT.G_OFFICIAL'
      
        '110208893=       AND GG.G_OFFICIAL = (CASE WHEN :G_OFFICIAL_ IS ' +
        'NULL THEN GG.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      '110208894=    ORDER BY 2 DESC'
      '110208895=     INTO :G_OFFICIAL_FM'
      '110208896=          ,:SUMM'
      '110208897=          ,:AMOUNT'
      '110208898=          ,:BILL_CNT'
      '110208899=  DO SUSPEND;'
      '110208900='
      '110208901=end'
      '110208902=;'
      '110208903='
      '110208904=ALTER PROCEDURE P_REP_SALESMAN_RATING_BY_GROUP('
      '110208905=  DATE_BEGIN_ DATE,'
      '110208906=  DATE_END_ DATE,'
      '110208907=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110208908=  G_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110208909=RETURNS ('
      '110208910=  DATE_ VARCHAR(50),'
      '110208911=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110208912=  G_OFFICIAL_FM TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110208913=  SUMM TYPE OF COLUMN ZAKAZ.SUMM,'
      '110208914=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT)'
      '110208915=AS'
      '110208916=BEGIN'
      '110208917='
      
        '110208918=  DATE_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE_B' +
        'EGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110208919=               lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRA' +
        'CT(YEAR FROM DATE_END_);'
      '110208920='
      '110208921=  FOR'
      '110208922=    SELECT GP.NAME,'
      
        '110208923=           DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FM||'#39 +
        ' '#39'||GG.NM||'#39' '#39'||GG.FT, GG.FIO_DOC),'
      '110208924=           TT.SUMM,'
      '110208925=           TT.SUMM_AMOUNT'
      '110208926=      FROM G_PRODUCT GP,'
      '110208927=           G_OFFICIAL GG,'
      '110208928=           (SELECT SUM(ZD.SUMM) SUMM,'
      '110208929=                   SUM(ZD.AMOUNT) SUMM_AMOUNT,'
      '110208930=                   Z.G_OFFICIAL,'
      '110208931=                   GG.G_PRODUCT'
      '110208932=              FROM ZAKAZ Z,'
      '110208933=                   ZAKAZ_DETAILS ZD,'
      '110208934=                   G_PRODUCT G,'
      '110208935=                   G_PRODUCT GG'
      '110208936=             WHERE Z.ZAKAZ = ZD.ZAKAZ'
      '110208937=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110208938=               AND G.G_PRODUCT_PAR = GG.G_PRODUCT'
      
        '110208939=               AND Z.G_OFFICIAL = (CASE WHEN :G_OFFICI' +
        'AL_ IS NULL THEN Z.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      
        '110208940=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110208941=               AND GG.G_PRODUCT = (CASE WHEN :G_CATEGO' +
        'RY_ IS NULL THEN GG.G_PRODUCT ELSE :G_CATEGORY_ END)'
      '110208942=             GROUP BY Z.G_OFFICIAL, GG.G_PRODUCT) TT'
      '110208943=     WHERE GG.G_OFFICIAL = TT.G_OFFICIAL'
      '110208944=       AND GP.G_PRODUCT = TT.G_PRODUCT'
      
        '110208945=       AND GG.G_OFFICIAL = (CASE WHEN :G_OFFICIAL_ IS ' +
        'NULL THEN GG.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      
        '110208946=       AND GP.G_PRODUCT = (CASE WHEN :G_CATEGORY_ IS N' +
        'ULL THEN GP.G_PRODUCT ELSE :G_CATEGORY_ END)'
      '110208947=    ORDER BY 3 DESC'
      '110208948=     INTO :CATEGORY_NAME'
      '110208949=          ,:G_OFFICIAL_FM'
      '110208950=          ,:SUMM'
      '110208951=          ,:AMOUNT'
      '110208952=  DO SUSPEND;'
      '110208953='
      '110208954=end'
      '110208955=;'
      '110208956='
      '110208957=ALTER PROCEDURE READ_SKLAD_LIST('
      '110208958=  DATE_BEGIN_ DATE,'
      '110208959=  DATE_END_ DATE,'
      '110208960=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110208961=  IS_VOZVRAT_ INTEGER,'
      '110208962=  HAVE_RIGHT_TO_SEE_COST_PRICE_ INTEGER = 0)'
      '110208963=RETURNS ('
      '110208964=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '110208965=  SKLAD_PARENT TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110208966=  DATE_RECEIPT TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '110208967=  G_PRODUCT TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110208968=  AMOUNT TYPE OF COLUMN SKLAD.AMOUNT,'
      '110208969=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '110208970=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110208971=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110208972=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110208973=  NDS TYPE OF COLUMN SKLAD.NDS,'
      '110208974=  NDS_SUMM TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110208975=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110208976=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110208977=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110208978=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110208979=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110208980=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '110208981=  IS_VOZVRAT TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110208982=  PRICE_ROZN TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110208983=  PRICE_OPT TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE)'
      '110208984=AS'
      '110208985=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '110208986=BEGIN'
      '110208987='
      '110208988=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '110208989=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '110208990=      IF (sklad_parent_ is null) THEN begin'
      '110208991=        SELECT COUNT(*)'
      '110208992=          FROM SKLAD_PARENT T'
      
        '110208993=         WHERE T.date_receipt BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110208994=          AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '110208995=          AND T.IS_vozvrat <> 3'
      '110208996=          INTO CNT_;'
      '110208997='
      '110208998=        if (CNT_ = 0) then'
      '110208999=          SELECT MAX(T.date_receipt)'
      '1102081000=            FROM SKLAD_PARENT T'
      '1102081001=           WHERE T.date_receipt < :DATE_BEGIN_'
      '1102081002=             AND T.IS_vozvrat <> 3'
      
        '1102081003=             AND T.G_TOCHKA = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 2)'
      '1102081004=            INTO :DATE_BEGIN_;'
      '1102081005=      end'
      '1102081006='
      '1102081007=      FOR SELECT T.sklad sklad_detail,'
      '1102081008=               T.SKLAD_PARENT sklad,'
      '1102081009=               T.date_receipt,'
      '1102081010=               T.g_product,'
      '1102081011=               T.amount,'
      '1102081012=               T.PRICE,'
      '1102081013=               T.SUMM,'
      '1102081014=               T.PRICE_CURRENCY,'
      '1102081015=               T.SUMM_CURRENCY,'
      '1102081016=               T.nds,'
      '1102081017=               T.nds_summ,'
      '1102081018=               P.NAME PRODUCT_NAME,'
      '1102081019=               C.NAME CLIENT_NAME,'
      '1102081020=               PT.NAME PAYMENT_NAME,'
      '1102081021=               P.ARTICUL,'
      '1102081022=               P.NOMENCLATUR_NUM,'
      '1102081023=               P.BARCODE,'
      '1102081024=               P.PRICE,'
      '1102081025=               P.VOLUME_PRICE,'
      '1102081026=               T.IS_VOZVRAT'
      '1102081027=          FROM SKLAD T'
      
        '1102081028=               LEFT OUTER JOIN G_CLIENT C ON T.G_CLIE' +
        'NT = C.G_CLIENT'
      
        '1102081029=               LEFT OUTER JOIN G_PAYMENT_TYPE PT ON T' +
        '.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '1102081030=               G_PRODUCT P'
      
        '1102081031=         WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102081032=           AND T.G_PRODUCT = P.G_PRODUCT'
      
        '1102081033=           AND ((T.IS_VOZVRAT = 0 AND :IS_VOZVRAT_ IS' +
        ' NULL)'
      
        '1102081034=                OR (T.IS_VOZVRAT IN (0, 5) AND :IS_VO' +
        'ZVRAT_ = 0)'
      
        '1102081035=                OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZ' +
        'VRAT_ IN (1,2))'
      '1102081036=               )'
      '1102081037=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1102081038=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1102081039=                OR'
      
        '1102081040=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1102081041=               )'
      '1102081042=        ORDER BY T.DATE_RECEIPT DESC'
      '1102081043=      INTO :sklad,'
      '1102081044=        :SKLAD_PARENT,'
      '1102081045=        :date_receipt,'
      '1102081046=        :g_product,'
      '1102081047=        :amount,'
      '1102081048=        :PRICE,'
      '1102081049=        :SUMM,'
      '1102081050=        :PRICE_CURRENCY,'
      '1102081051=        :SUMM_CURRENCY,'
      '1102081052=        :nds,'
      '1102081053=        :nds_summ,'
      '1102081054=        :PRODUCT_NAME,'
      '1102081055=        :CLIENT_NAME,'
      '1102081056=        :PAYMENT_NAME,'
      '1102081057=        :ARTICUL,'
      '1102081058=        :NOMENCLATUR_NUM,'
      '1102081059=        :BARCODE,'
      '1102081060=        :PRICE_ROZN,'
      '1102081061=        :PRICE_OPT,'
      '1102081062=        :IS_VOZVRAT'
      '1102081063=      DO'
      '1102081064=        suspend;'
      '1102081065='
      '1102081066=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040
      '1102081067=  END ELSE BEGIN'
      '1102081068=    FOR SELECT T.SKLAD_PARENT,'
      '1102081069=               T.SKLAD,'
      '1102081070=               TR.DATE_RECEIPT,'
      '1102081071=               T.g_product,'
      '1102081072=               T.amount,'
      
        '1102081073=               DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_,' +
        ' 1, T.PRICE, 0),'
      
        '1102081074=               DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_,' +
        ' 1, T.SUMM, 0),'
      '1102081075=               P.NAME PRODUCT_NAME,'
      '1102081076=               G.NAME CLIENT_NAME,'
      '1102081077=               P.ARTICUL,'
      '1102081078=               P.NOMENCLATUR_NUM,'
      '1102081079=               P.BARCODE'
      
        '1102081080=          FROM SKLAD_PARENT TR LEFT OUTER JOIN G_TOCH' +
        'KA G ON TR.G_CLIENT = G.G_TOCHKA,'
      '1102081081=               SKLAD T,'
      '1102081082=               G_PRODUCT P'
      
        '1102081083=         WHERE TR.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '1102081084=           AND TR.SKLAD = T.SKLAD_PARENT'
      '1102081085=           AND T.G_PRODUCT = P.G_PRODUCT'
      '1102081086=           AND T.IS_VOZVRAT = 3'
      '1102081087=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1102081088=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1102081089=                OR'
      
        '1102081090=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1102081091=               )'
      '1102081092=        ORDER BY TR.SKLAD DESC'
      '1102081093=      INTO :sklad,'
      '1102081094=        :SKLAD_PARENT,'
      '1102081095=        :date_receipt,'
      '1102081096=        :g_product,'
      '1102081097=        :amount,'
      '1102081098=        :PRICE,'
      '1102081099=        :SUMM,'
      '1102081100=        :PRODUCT_NAME,'
      '1102081101=        :CLIENT_NAME,'
      '1102081102=        :ARTICUL,'
      '1102081103=        :NOMENCLATUR_NUM,'
      '1102081104=        :BARCODE'
      '1102081105=      DO'
      '1102081106=        suspend;'
      '1102081107=  END'
      '1102081108=end'
      '1102081109=;'
      '1102081110='
      '1102081111=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST('
      '1102081112=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102081113=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102081114=  HAVE_RIGHT_TO_SEE_COST_PRICE_ INTEGER = 0)'
      '1102081115=RETURNS ('
      '1102081116=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '1102081117=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS,'
      '1102081118=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '1102081119=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102081120=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1102081121=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1102081122=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_PERC,'
      
        '1102081123=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1102081124=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1102081125=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102081126=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102081127=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102081128=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102081129=  ED_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102081130=  OSTATOK_SKLAD TYPE OF COLUMN SKLAD.AMOUNT,'
      '1102081131=  PRICE_ROZN TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102081132=  PRICE_OPT TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE)'
      '1102081133=AS'
      '1102081134=BEGIN'
      '1102081135='
      '1102081136=  FOR'
      '1102081137=    SELECT D.ZAKAZ,'
      '1102081138=           D.ZAKAZ_DETAILS,'
      '1102081139=           D.G_PRODUCT,'
      '1102081140=           D.AMOUNT,'
      '1102081141=           D.PRICE,'
      '1102081142=           D.SUMM,'
      '1102081143=           D.DISCOUNT_PERC,'
      '1102081144=           D.DISCOUNT_TENGE,'
      '1102081145=           D.DISCOUNT_SUMM,'
      '1102081146=           G.ARTICUL,'
      '1102081147=           G.NOMENCLATUR_NUM,'
      '1102081148=           G.BARCODE,'
      '1102081149=           G.NAME,'
      '1102081150=           G.PRICE,'
      '1102081151=           G.VOLUME_PRICE,'
      '1102081152=           COALESCE(GU.SHORT_NAME, GU.NAME),'
      '1102081153=           LT.AMOUNT OSTATOK_SKLAD'
      '1102081154=      FROM ZAKAZ_DETAILS D,'
      '1102081155=           G_PRODUCT G,'
      '1102081156=           G_UNIT GU,'
      '1102081157=           LT_SKLAD_PRODUCT LT'
      '1102081158=     WHERE D.ZAKAZ = :ZAKAZ_'
      '1102081159=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1102081160=       AND LT.G_PRODUCT = G.G_PRODUCT'
      
        '1102081161=       AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1102081162=       AND G.G_UNIT = GU.G_UNIT'
      '1102081163=       AND :IS_SPISANIE_ <> 3'
      '1102081164=    UNION ALL'
      '1102081165=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '1102081166=           D.SKLAD ZAKAZ_DETAILS,'
      '1102081167=           D.G_PRODUCT,'
      '1102081168=           D.AMOUNT,'
      
        '1102081169=           DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 1, ' +
        'D.PRICE, 0),'
      
        '1102081170=           DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 1, ' +
        'D.SUMM, 0),'
      '1102081171=           0 DISCOUNT_PERC,'
      '1102081172=           0 DISCOUNT_TENGE,'
      '1102081173=           0 DISCOUNT_SUMM,'
      '1102081174=           G.ARTICUL,'
      '1102081175=           G.NOMENCLATUR_NUM,'
      '1102081176=           G.BARCODE,'
      '1102081177=           G.NAME,'
      '1102081178=           G.PRICE,'
      '1102081179=           G.VOLUME_PRICE,'
      '1102081180=           GU.NAME,'
      '1102081181=           LT.AMOUNT OSTATOK_SKLAD'
      '1102081182=      FROM SKLAD D,'
      '1102081183=           G_PRODUCT G,'
      '1102081184=           G_UNIT GU,'
      '1102081185=           LT_SKLAD_PRODUCT LT'
      '1102081186=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '1102081187=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1102081188=       AND LT.G_PRODUCT = G.G_PRODUCT'
      
        '1102081189=       AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1102081190=       AND G.G_UNIT = GU.G_UNIT'
      '1102081191=       AND :IS_SPISANIE_ = 3'
      '1102081192=    ORDER BY 1'
      '1102081193=    INTO  :ZAKAZ,'
      '1102081194=          :ZAKAZ_DETAILS,'
      '1102081195=          :G_PRODUCT,'
      '1102081196=          :AMOUNT,'
      '1102081197=          :PRICE,'
      '1102081198=          :SUMM,'
      '1102081199=          :DISCOUNT_PERC,'
      '1102081200=          :DISCOUNT_TENGE,'
      '1102081201=          :DISCOUNT_SUMM,'
      '1102081202=          :ARTICUL,'
      '1102081203=          :NOMENCLATUR_NUM,'
      '1102081204=          :BARCODE,'
      '1102081205=          :PRODUCT_NAME,'
      '1102081206=          :PRICE_ROZN,'
      '1102081207=          :PRICE_OPT,'
      '1102081208=          :ED_NAME,'
      '1102081209=          :OSTATOK_SKLAD'
      '1102081210=  DO'
      '1102081211=    suspend;'
      '1102081212=end'
      '1102081213=;'
      '1102081214='
      '1102081215='
      
        '1102081216=UPDATE SYSTEM_SETUP SET S_VALUE = 110208 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102081217=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102081218=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102090='
      '1102091=ALTER PROCEDURE K_DEL_KASSA('
      '1102092=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1102093=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '1102094=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102095=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '1102096=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102097=RETURNS ('
      '1102098=  ERR_CODE INTEGER,'
      '1102099=  ERR_MSG VARCHAR(1024))'
      '11020910=AS'
      '11020911=/*'
      
        '11020912='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053#1040#1051 +
        #1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065#1059#1070 +
        ' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '11020913=*/'
      '11020914=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '11020915=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11020916=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '11020917=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '11020918=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '11020919=DECLARE VARIABLE ACTION_DATE_ DATE;'
      '11020920=DECLARE VARIABLE ACTION_ TYPE OF COLUMN KASSA."ACTION";'
      
        '11020921=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11020922=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '11020923=BEGIN'
      '11020924=  PROCNAME = '#39'K_DEL_KASSA'#39';'
      '11020925='
      
        '11020926=  -----------------------------------------------------' +
        '-----------------'
      '11020927=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '11020928=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT_' +
        'TYPE_ = 1)) THEN BEGIN'
      '11020929=      SELECT K.SUMM,'
      '11020930=             K.ACTION_DATE,'
      '11020931=             K."ACTION",'
      '11020932=             K.G_TOCHKA'
      '11020933=        FROM KASSA K'
      '11020934=       WHERE K.KASSA = :KASSA_'
      '11020935=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA_;'
      '11020936='
      
        '11020937=      --***********************************************' +
        '**'
      '11020938=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '11020939=      --***********************************************' +
        '**'
      '11020940=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '11020941=      PNT_ = '#39'02'#39';'
      '11020942=      IF (:ACTION_ = 0) THEN'
      '11020943=        CREDIT_ = SUMM_;'
      '11020944=      ELSE'
      '11020945=        DEBET_ = SUMM_;'
      '11020946='
      '11020947=      UPDATE KASSA_STATE K'
      '11020948=         SET K.DEBET = K.DEBET - :DEBET_,'
      '11020949=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '11020950=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_) +' +
        ' (K.CREDIT - :CREDIT_),'
      '11020951=             K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '11020952=       WHERE K.K_DATE = :ACTION_DATE_'
      '11020953=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '11020954='
      
        '11020955=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '11020956=      /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '11020957=        SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '11020958=                     '#39'SET K.DEBET = K.DEBET - '#39'||COALES' +
        'CE(:DEBET_, 0)||'#39', '#39'||'
      
        '11020959=                          '#39'K.CREDIT = K.CREDIT - '#39'||COA' +
        'LESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '11020960=                          '#39'K.OUTPUT = K.INPUT - (K.DEBE' +
        'T - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CREDI' +
        'T_, 0)||'#39') '#39'||'
      
        '11020961=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DATE_' +
        '||'#39#39#39' '#39'||'
      
        '11020962=                     '#39'AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';' +
        #39';'
      
        '11020963=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '11020964=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11020965=      END*/'
      '11020966='
      
        '11020967=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '11020968=      PNT_ = '#39'04'#39';'
      
        '11020969=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_, :' +
        'G_TOCHKA_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES(:ERR_CODE, :ERR' +
        '_MSG);'
      '11020970=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11020971=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11020972=        EXIT;'
      '11020973=      END'
      '11020974='
      '11020975=      DELETE FROM KASSA'
      '11020976=      WHERE KASSA = :KASSA_;'
      '11020977=  END'
      
        '11020978=  -----------------------------------------------------' +
        '-----------------'
      '11020979=  --*************************************************'
      
        '11020980=  -----------------------------------------------------' +
        '-----------------'
      
        '11020981=  -----------------------------------------------------' +
        '-----------------'
      '11020982=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '11020983=  ELSE BEGIN'
      '11020984=      SELECT K.SUMM,'
      '11020985=             K.ACTION_DATE,'
      '11020986=             K."ACTION",'
      '11020987=             K.G_TOCHKA'
      '11020988=        FROM KASSA_BEZNAL K'
      '11020989=       WHERE K.KASSA_BEZNAL = :KASSA_'
      '11020990=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA_;'
      '11020991='
      
        '11020992=      --***********************************************' +
        '**'
      '11020993=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '11020994=      --***********************************************' +
        '**'
      '11020995=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '11020996=      PNT_ = '#39'02'#39';'
      '11020997=      IF (:ACTION_ = 0) THEN'
      '11020998=        CREDIT_ = SUMM_;'
      '11020999=      ELSE'
      '110209100=        DEBET_ = SUMM_;'
      '110209101='
      '110209102=      UPDATE KASSA_BEZNAL_STATE K'
      '110209103=         SET K.DEBET = K.DEBET - :DEBET_,'
      '110209104=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '110209105=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_) ' +
        '+ (K.CREDIT - :CREDIT_)'
      '110209106=       WHERE K.K_DATE = :ACTION_DATE_;'
      '110209107='
      
        '110209108=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068 +
        ' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209109=      /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
        'STEM_SETUP = 5) > 0) THEN BEGIN'
      '110209110=        SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      
        '110209111=                     '#39'SET K.DEBET = K.DEBET - '#39'||COALE' +
        'SCE(:DEBET_, 0)||'#39', '#39'||'
      
        '110209112=                         '#39'K.CREDIT = K.CREDIT - '#39'||COA' +
        'LESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '110209113=                         '#39'K.OUTPUT = K.INPUT - (K.DEBE' +
        'T - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CREDI' +
        'T_, 0)||'#39') '#39'||'
      
        '110209114=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DATE' +
        '_||'#39#39#39';'#39';'
      '110209115='
      
        '110209116=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFE' +
        'RED, SYSDATE, ERR_CODE)'
      
        '110209117=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSD' +
        'BA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209118=      END*/'
      '110209119='
      
        '110209120=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110209121=      PNT_ = '#39'04'#39';'
      
        '110209122=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION_' +
        'DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110209123=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110209124=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110209125=        EXIT;'
      '110209126=      END'
      '110209127='
      '110209128=      DELETE FROM KASSA_BEZNAL'
      '110209129=      WHERE KASSA_BEZNAL = :KASSA_;'
      '110209130=  END'
      
        '110209131=  ----------------------------------------------------' +
        '------------------'
      '110209132=  --*************************************************'
      '110209133='
      '110209134=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      '110209135=  IF (LOG_BODY_ IS NOT NULL) THEN'
      
        '110209136=    EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :USE' +
        'R_ID_, :KASSA_, :ACTION_DATE_, 3, :SUMM_, :LOG_BODY_);'
      '110209137='
      '110209138=WHEN ANY DO'
      '110209139=  begin'
      '110209140=    IF (sqlcode = -530) THEN BEGIN'
      '110209141=        ERR_CODE = -20500;'
      
        '110209142=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1081' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING' +
        '_VALUES (:ERR_MSG);'
      '110209143=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '110209144=    END'
      '110209145=    ELSE BEGIN'
      '110209146=        ERR_CODE = sqlcode;'
      
        '110209147=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073#1082 +
        #1072' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1079#1072#1087#1080#1089#1080' '#1080#1079' '#1082#1072#1089#1089#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110209148=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '110209149=    END'
      '110209150=  end'
      '110209151=end'
      '110209152=;'
      '110209153='
      '110209154=ALTER PROCEDURE K_RECALC_KASSA('
      '110209155=  ACTION_DATE_ DATE,'
      '110209156=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110209157=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110209158=RETURNS ('
      '110209159=  ERR_CODE INTEGER,'
      '110209160=  ERR_MSG VARCHAR(1024))'
      '110209161=AS'
      
        '110209162=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASS' +
        'A'#39';'
      '110209163=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110209164=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '110209165=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_STATE.K_' +
        'DATE;'
      '110209166=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '110209167=BEGIN'
      '110209168='
      '110209169=  ERR_CODE = 0;'
      '110209170=  ERR_MSG = '#39#39';'
      '110209171='
      '110209172=  IF (G_TOCHKA_ IS NULL) THEN'
      '110209173=    SELECT ID'
      '110209174=      FROM CUR_PARAMS'
      '110209175=     WHERE CUR_PARAMS = 2'
      '110209176=      INTO :G_TOCHKA_;'
      '110209177='
      
        '110209178=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047 +
        #1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043 +
        #1054#1044#1053#1071' 21.02.'
      
        '110209179=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057 +
        #1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      '110209180=  PNT_ = '#39'00'#39';'
      
        '110209181=  IF ((SELECT COUNT(*) FROM KASSA_STATE K WHERE K.K_DA' +
        'TE = CURRENT_DATE AND G_TOCHKA = :G_TOCHKA_) = 0) THEN BEGIN'
      '110209182=    INSERT INTO KASSA_STATE'
      
        '110209183=      (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, OUTP' +
        'UT, G_TOCHKA, NEED_TO_EXPORT)'
      '110209184=    VALUES'
      
        '110209185=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0 , 0' +
        ', 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110209186='
      
        '110209187=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209188=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110209189=      SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110209190=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DATE' +
        '||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '110209191=                 '#39' from RDB$DATABASE) cd '#39'||'
      
        '110209192=                 '#39'ON (c.K_DATE = cd.K_DATE AND C.G_TOC' +
        'HKA = CD.G_TOCHKA) '#39'||'
      '110209193=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110209194=                 '#39' INSERT (KASSA_STATE, K_DATE, "INPUT' +
        '", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '110209195=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, ' +
        '0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0, '#39'||G_TOCHKA_||'#39');'#39';'
      
        '110209196=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110209197=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209198=    END'
      '110209199=    */'
      '110209200=  END'
      '110209201='
      
        '110209202=  ----------------------------------------------------' +
        '------------------'
      
        '110209203=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056 +
        #1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      
        '110209204=  -- '#1040' '#1058#1040#1050#1046#1045' '#1053#1059#1046#1053#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1047#1040#1056#1055#1051 +
        #1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040#1052', '#1058#1040#1052' '#1047#1040#1055#1048#1057#1068' '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040#1058#1054#1049
      '110209205=  PNT_ = '#39'01'#39';'
      '110209206=  IF (ACTION_DATE_ >= CURRENT_DATE) THEN BEGIN'
      '110209207=    SELECT ST."OUTPUT",'
      '110209208=           ST.K_DATE'
      '110209209=      FROM KASSA_STATE ST'
      
        '110209210=     WHERE ST.K_DATE < CURRENT_DATE   -- '#1047#1044#1045#1057#1068' '#1069#1058#1054' '#1057#1055#1045 +
        #1062#1048#1040#1051#1068#1053#1054' '#1057#1044#1045#1051#1040#1053#1054', '#1063#1058#1054#1041#1067' '#1055#1045#1056#1045#1041#1048#1042#1040#1051#1040#1057#1068' '#1048' '#1047#1040#1055#1048#1057#1068' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' '#1058#1054#1046#1045', '#1040' ' +
        #1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1057#1054#1047#1044#1040#1051#1040#1057#1068', '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040' '#1053#1045#1058
      '110209211=       AND ST.G_TOCHKA = :G_TOCHKA_'
      '110209212=     ORDER BY ST.K_DATE DESC'
      '110209213=     ROWS 1'
      '110209214=     INTO :OUTPUT_,'
      '110209215=          :ACTION_DATE_;'
      '110209216='
      '110209217=    IF (OUTPUT_ IS NULL) THEN'
      '110209218=      SELECT ST."OUTPUT",'
      '110209219=             ST.K_DATE'
      '110209220=        FROM KASSA_STATE ST'
      '110209221=       WHERE ST.K_DATE = CURRENT_DATE'
      '110209222=         AND ST.G_TOCHKA = :G_TOCHKA_'
      '110209223=       ORDER BY ST.K_DATE DESC'
      '110209224=       INTO :OUTPUT_,'
      '110209225=            :ACTION_DATE_;'
      '110209226='
      '110209227=  END ELSE BEGIN'
      '110209228=    SELECT K.OUTPUT'
      '110209229=      FROM KASSA_STATE K'
      '110209230=     WHERE K.K_DATE = :ACTION_DATE_'
      '110209231=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110209232=      INTO :OUTPUT_;'
      '110209233='
      
        '110209234=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209235=    -- '#1045#1057#1051#1048' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067' '#1048#1047#1052#1045#1053#1045#1053#1048#1045', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040' '#1044#1056#1059#1043 +
        #1054#1052' '#1050#1054#1052#1055#1045' '#1058#1054#1046#1045' '#1047#1040#1055#1059#1057#1050#1040#1058#1068' K_RECALC_KASSA'
      
        '110209236=    -- '#1058#1045#1055#1045#1056#1068', '#1055#1056#1048' '#1050#1040#1046#1044#1054#1052' '#1048#1047#1052#1045#1053#1045#1053#1048#1048' '#1041#1059#1044#1045#1058' '#1042' LOG '#1055#1040#1044#1040#1058#1068 +
        ' '#1057#1058#1056#1054#1050#1040' "EXECUTE K_RECALC_KASSA" - '#1069#1058#1054' '#1053#1045#1055#1056#1048#1045#1052#1051#1045#1052#1054','
      
        '110209237=    -- '#1044#1056#1059#1043#1054#1049' '#1050#1054#1052#1055' '#1052#1054#1046#1045#1058' '#1053#1045' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1048#1053#1060#1059' '#1053#1045#1044#1045#1051#1071#1052#1048', '#1057#1054 +
        #1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1053#1059#1046#1053#1054', '#1063#1058#1054#1041#1067' '#1041#1067#1051#1040' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' '#1048' '#1047#1040#1055#1059#1057#1050#1040#1051#1040#1057#1068' ' +
        #1054#1053#1040
      '110209238=    -- '#1042' '#1050#1054#1053#1062#1045' SYNC_DOWNLOAD '#1054#1044#1048#1053' '#1056#1040#1047'.'
      
        '110209239=    -- '#1044#1051#1071' '#1069#1058#1054#1043#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1042' LOG "EXE' +
        'CUTE K_RECALC_KASSA" '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_TRANSFERED = 0 '#1048' '#1047#1040#1052#1045#1053#1071#1058#1068' '#1045#1045 +
        ' '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054
      
        '110209240=    -- '#1055#1054' '#1059#1052#1059' '#1053#1059#1046#1053#1054' '#1041#1067' '#1059#1044#1040#1051#1071#1058#1068' "EXECUTE K_RECALC_KASSA' +
        '" '#1057' '#1044#1040#1058#1054#1049' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1063#1058#1054#1041#1067' '#1053#1045' '#1041#1067#1051#1054' '#1044#1042#1054#1049#1053#1054#1043#1054' '#1055#1045#1056#1045#1057#1063#1045#1058#1040', '#1053#1054' '#1058 +
        #1040#1052' '#1058#1054#1043#1044#1040
      
        '110209241=    -- '#1053#1059#1046#1053#1054' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1044#1040#1058#1067' '#1048' G_TOCHKA - '#1069#1058#1054' '#1042#1057#1045' '#1057#1051#1048#1064 +
        #1050#1054#1052' '#1057#1051#1054#1046#1053#1054
      
        '110209242=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0 AND (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICA' +
        'T'#39') IS NULL)) THEN BEGIN'
      
        '110209243=      SQL_STMT_ = '#39'EXECUTE BLOCK AS DECLARE VARIABLE E' +
        'RR_CODE INTEGER;DECLARE VARIABLE ERR_MSG VARCHAR(1024); BEGIN '#39'|' +
        '|'
      
        '110209244=        '#39' EXECUTE PROCEDURE K_RECALC_KASSA('#39#39#39'||:ACTIO' +
        'N_DATE_||'#39#39#39', '#39'||:G_TOCHKA_||'#39', '#39'||:UPLOAD_TO_EXT_APP_||'#39') RETUR' +
        'NING_VALUES :ERR_CODE, :ERR_MSG; END'#39';'
      '110209245='
      
        '110209246=      -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1059#1044#1040#1051#1071#1070', '#1045#1057#1051#1048' '#1059#1046#1045' '#1041#1067#1051#1040' '#1054#1058#1055#1056#1040#1042#1050#1040 +
        ' '#1055#1045#1056#1045#1057#1063#1045#1058#1040' '#1047#1040' '#1069#1058#1059' '#1044#1040#1058#1059
      '110209247=      DELETE FROM LOGS'
      '110209248=      WHERE SQLSTMT = :SQL_STMT_'
      '110209249=        AND IS_TRANSFERED = 0'
      '110209250=        AND USR = '#39'SYSDBA'#39';'
      '110209251='
      
        '110209252=      INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR, IS_T' +
        'RANSFERED, SYSDATE, ERR_CODE)'
      
        '110209253=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'KASSA_' +
        'STATE'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209254=    END*/'
      '110209255=  END'
      '110209256='
      '110209257=  PNT_ = '#39'02'#39';'
      '110209258=  FOR SELECT K.K_DATE'
      '110209259=        FROM KASSA_STATE K'
      '110209260=       WHERE K.K_DATE > :ACTION_DATE_'
      '110209261=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110209262=      ORDER BY K.K_DATE, K.KASSA_STATE'
      '110209263=        INTO :K_DATE_'
      '110209264=  DO BEGIN'
      '110209265=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110209266=    UPDATE KASSA_STATE K'
      '110209267=       SET K.INPUT = :OUTPUT_,'
      
        '110209268=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE' +
        '(K.DEBET, 0) + COALESCE(K.CREDIT, 0),'
      '110209269=           K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110209270=     WHERE K.K_DATE = :K_DATE_'
      '110209271=       AND K.G_TOCHKA = :G_TOCHKA_;'
      '110209272='
      
        '110209273=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209274=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110209275=      SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      '110209276=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '110209277=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, ' +
        '0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '110209278=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39#39 +
        '||'
      
        '110209279=                 '#39'  AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';'#39 +
        ';'
      
        '110209280=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110209281=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209282=    END'
      '110209283=    */'
      '110209284='
      '110209285=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110209286=    SELECT K.OUTPUT'
      '110209287=      FROM KASSA_STATE K'
      '110209288=     WHERE K.K_DATE = :K_DATE_'
      '110209289=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110209290=      INTO :OUTPUT_;'
      '110209291=  END'
      '110209292='
      '110209293=WHEN ANY DO BEGIN'
      '110209294=    Err_code = -20500;'
      
        '110209295=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110209296=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110209297=  END'
      '110209298=end'
      '110209299=;'
      '110209300='
      '110209301=ALTER PROCEDURE K_RECALC_KASSA_BEZNAL('
      '110209302=  ACTION_DATE_ DATE)'
      '110209303=RETURNS ('
      '110209304=  ERR_CODE INTEGER,'
      '110209305=  ERR_MSG VARCHAR(1024))'
      '110209306=AS'
      
        '110209307=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASS' +
        'A_BEZNAL'#39';'
      '110209308=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110209309=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '110209310=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_BEZNAL_S' +
        'TATE.K_DATE;'
      '110209311=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '110209312=BEGIN'
      '110209313='
      
        '110209314=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047 +
        #1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043 +
        #1054#1044#1053#1071' 21.02.'
      
        '110209315=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057 +
        #1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      
        '110209316=  -- '#1052#1054#1046#1053#1054' '#1042#1045#1047#1044#1045' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' 0, '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1044#1040#1051#1068#1064#1045' '#1054#1053#1054' '#1041#1059#1044 +
        #1045#1058' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1053#1054
      '110209317=  PNT_ = '#39'00'#39';'
      
        '110209318=  IF ((SELECT COUNT(*) FROM KASSA_BEZNAL_STATE K WHERE' +
        ' K.K_DATE = CURRENT_DATE) = 0) THEN BEGIN'
      '110209319=    INSERT INTO KASSA_BEZNAL_STATE'
      
        '110209320=      (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CREDI' +
        'T, OUTPUT)'
      '110209321=    VALUES'
      
        '110209322=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0, 0,' +
        ' 0, 0);'
      '110209323='
      
        '110209324=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209325=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110209326=      SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE c '#39'||'
      
        '110209327=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DATE' +
        '||'#39#39#39' AS DATE) as K_DATE '#39'||'
      '110209328=                 '#39' from RDB$DATABASE) cd '#39'||'
      '110209329=                 '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '110209330=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110209331=                 '#39' INSERT (KASSA_BEZNAL_STATE, K_DATE,' +
        ' "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
        '110209332=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, ' +
        '0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0);'#39';'
      
        '110209333=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110209334=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209335=    END'
      '110209336=    */'
      '110209337=  END'
      '110209338='
      
        '110209339=  ----------------------------------------------------' +
        '------------------'
      
        '110209340=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056 +
        #1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110209341=  PNT_ = '#39'01'#39';'
      '110209342=  SELECT K.OUTPUT'
      '110209343=    FROM KASSA_BEZNAL_STATE K'
      '110209344=   WHERE K.K_DATE = :ACTION_DATE_'
      '110209345=    INTO :OUTPUT_;'
      '110209346='
      
        '110209347=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040#1041 +
        #1051#1048#1062#1059' LOGS'
      
        '110209348=  -- '#1045#1057#1051#1048' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067' '#1048#1047#1052#1045#1053#1045#1053#1048#1045', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040' '#1044#1056#1059#1043#1054#1052 +
        ' '#1050#1054#1052#1055#1045' '#1058#1054#1046#1045' '#1047#1040#1055#1059#1057#1050#1040#1058#1068' K_RECALC_KASSA'
      
        '110209349=  -- '#1058#1045#1055#1045#1056#1068', '#1055#1056#1048' '#1050#1040#1046#1044#1054#1052' '#1048#1047#1052#1045#1053#1045#1053#1048#1048' '#1041#1059#1044#1045#1058' '#1042' LOG '#1055#1040#1044#1040#1058#1068' '#1057 +
        #1058#1056#1054#1050#1040' "EXECUTE K_RECALC_KASSA" - '#1069#1058#1054' '#1053#1045#1055#1056#1048#1045#1052#1051#1045#1052#1054','
      
        '110209350=  -- '#1044#1056#1059#1043#1054#1049' '#1050#1054#1052#1055' '#1052#1054#1046#1045#1058' '#1053#1045' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1048#1053#1060#1059' '#1053#1045#1044#1045#1051#1071#1052#1048', '#1057#1054#1054#1058 +
        #1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1053#1059#1046#1053#1054', '#1063#1058#1054#1041#1067' '#1041#1067#1051#1040' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' '#1048' '#1047#1040#1055#1059#1057#1050#1040#1051#1040#1057#1068' '#1054#1053 +
        #1040
      '110209351=  -- '#1042' '#1050#1054#1053#1062#1045' SYNC_DOWNLOAD '#1054#1044#1048#1053' '#1056#1040#1047'.'
      
        '110209352=  -- '#1044#1051#1071' '#1069#1058#1054#1043#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1042' LOG "EXECU' +
        'TE K_RECALC_KASSA" '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_TRANSFERED = 0 '#1048' '#1047#1040#1052#1045#1053#1071#1058#1068' '#1045#1045' '#1045 +
        #1057#1051#1048' '#1053#1059#1046#1053#1054
      
        '110209353=  -- '#1055#1054' '#1059#1052#1059' '#1053#1059#1046#1053#1054' '#1041#1067' '#1059#1044#1040#1051#1071#1058#1068' "EXECUTE K_RECALC_KASSA" ' +
        #1057' '#1044#1040#1058#1054#1049' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1063#1058#1054#1041#1067' '#1053#1045' '#1041#1067#1051#1054' '#1044#1042#1054#1049#1053#1054#1043#1054' '#1055#1045#1056#1045#1057#1063#1045#1058#1040', '#1053#1054' '#1058#1040#1052 +
        ' '#1058#1054#1043#1044#1040
      
        '110209354=  -- '#1053#1059#1046#1053#1054' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1044#1040#1058#1067' '#1048' G_TOCHKA - '#1069#1058#1054' '#1042#1057#1045' '#1057#1051#1048#1064#1050#1054 +
        #1052' '#1057#1051#1054#1046#1053#1054
      
        '110209355=  /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM' +
        '_SETUP = 5) > 0 AND (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39 +
        ') IS NULL)) THEN BEGIN'
      
        '110209356=    SQL_STMT_ = '#39'EXECUTE BLOCK AS DECLARE VARIABLE ERR' +
        '_CODE INTEGER;DECLARE VARIABLE ERR_MSG VARCHAR(1024); BEGIN '#39'||'
      
        '110209357=      '#39' EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL('#39#39#39'||:' +
        'ACTION_DATE_||'#39#39#39') RETURNING_VALUES :ERR_CODE, :ERR_MSG; END'#39';'
      '110209358='
      
        '110209359=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1059#1044#1040#1051#1071#1070', '#1045#1057#1051#1048' '#1059#1046#1045' '#1041#1067#1051#1040' '#1054#1058#1055#1056#1040#1042#1050#1040' '#1055 +
        #1045#1056#1045#1057#1063#1045#1058#1040' '#1047#1040' '#1069#1058#1059' '#1044#1040#1058#1059
      '110209360=    DELETE FROM LOGS'
      '110209361=      WHERE SQLSTMT = :SQL_STMT_'
      '110209362=        AND IS_TRANSFERED = 0'
      '110209363=        AND USR = '#39'SYSDBA'#39';'
      '110209364='
      
        '110209365=    INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR, IS_TRA' +
        'NSFERED, SYSDATE, ERR_CODE)'
      
        '110209366=    VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'KASSA_ST' +
        'ATE_BEZNAL'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209367=  END*/'
      '110209368='
      '110209369=  PNT_ = '#39'02'#39';'
      '110209370=  FOR SELECT K.K_DATE'
      '110209371=        FROM KASSA_BEZNAL_STATE K'
      '110209372=       WHERE K.K_DATE > :ACTION_DATE_'
      '110209373=      ORDER BY K.K_DATE, K.KASSA_BEZNAL_STATE'
      '110209374=        INTO :K_DATE_'
      '110209375=  DO BEGIN'
      '110209376=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110209377=    UPDATE KASSA_BEZNAL_STATE K'
      '110209378=       SET K.INPUT = :OUTPUT_,'
      
        '110209379=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE' +
        '(K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '110209380=     WHERE K.K_DATE = :K_DATE_;'
      '110209381='
      
        '110209382=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209383=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110209384=      SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      '110209385=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '110209386=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, ' +
        '0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '110209387=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39';' +
        #39';'
      
        '110209388=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110209389=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209390=    END'
      '110209391=    */'
      '110209392='
      '110209393=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110209394=    SELECT K.OUTPUT'
      '110209395=      FROM KASSA_BEZNAL_STATE K'
      '110209396=     WHERE K.K_DATE = :K_DATE_'
      '110209397=      INTO :OUTPUT_;'
      '110209398=  END'
      '110209399='
      '110209400=WHEN ANY DO BEGIN'
      '110209401=    Err_code = -20500;'
      
        '110209402=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110209403=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110209404=  END'
      '110209405=end'
      '110209406=;'
      '110209407='
      '110209408=ALTER PROCEDURE K_UPD_KASSA_STATE('
      '110209409=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110209410=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110209411=  DEBET_ MY_NUMERIC,'
      '110209412=  CREDIT_ MY_NUMERIC,'
      '110209413=  NAL_BEZNAL_ INTEGER,'
      '110209414=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110209415=RETURNS ('
      '110209416=  ERR_CODE INTEGER,'
      '110209417=  ERR_MSG VARCHAR(1024))'
      '110209418=AS'
      
        '110209419=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_UPD_KASSA_S' +
        'TATE'#39';'
      '110209420=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110209421=DECLARE VARIABLE INPUT_ MY_NUMERIC = 0;'
      '110209422=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '110209423=BEGIN'
      '110209424='
      '110209425=  PNT_ = '#39'01'#39';'
      '110209426=  -- '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067
      '110209427=  IF (NAL_BEZNAL_ = 1) THEN BEGIN'
      '110209428=      UPDATE KASSA_STATE K'
      
        '110209429=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE' +
        '(:DEBET_, 0),'
      
        '110209430=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALES' +
        'CE(:CREDIT_, 0),'
      
        '110209431=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALES' +
        'CE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) ' +
        '+ COALESCE(:CREDIT_, 0)),'
      '110209432=             K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110209433=       WHERE K.K_DATE = :ACTION_DATE_'
      '110209434=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '110209435='
      
        '110209436=      IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053 +
        #1071' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '110209437=        -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '110209438=        PNT_ = '#39'02'#39';'
      '110209439=        BEGIN'
      '110209440=            SELECT K.OUTPUT'
      '110209441=              FROM KASSA_STATE K'
      '110209442=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '110209443=                                 FROM KASSA_STATE S'
      
        '110209444=                                WHERE S.K_DATE < :ACTI' +
        'ON_DATE_'
      
        '110209445=                                  AND S.G_TOCHKA = :G_' +
        'TOCHKA_)'
      '110209446=               AND K.G_TOCHKA = :G_TOCHKA_'
      '110209447=            INTO :INPUT_;'
      '110209448='
      '110209449=            if (ROW_COUNT = 0) then'
      
        '110209450=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055 +
        #1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '110209451=        WHEN ANY DO'
      '110209452=          BEGIN'
      '110209453=            Err_Code = -20500;'
      
        '110209454=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054 +
        #1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      
        '110209455=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110209456=            EXIT;'
      '110209457=          END'
      '110209458=        END'
      '110209459='
      '110209460=        PNT_ = '#39'03'#39';'
      '110209461=        INSERT INTO KASSA_STATE'
      '110209462=          (KASSA_STATE, K_DATE,'
      '110209463=           INPUT, DEBET, CREDIT, OUTPUT,'
      '110209464=           G_TOCHKA, NEED_TO_EXPORT)'
      '110209465=        VALUES'
      '110209466=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_,'
      
        '110209467=          COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), ' +
        'COALESCE(:CREDIT_, 0), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, ' +
        '0) + COALESCE(:CREDIT_,0),'
      '110209468=          :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110209469=      END'
      '110209470='
      
        '110209471=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068 +
        ' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209472=      /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
        'STEM_SETUP = 5) > 0) THEN BEGIN'
      '110209473=            SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110209474=                       '#39'USING (select CAST('#39#39#39'||ACTION' +
        '_DATE_||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '110209475=                       '#39' from RDB$DATABASE) cd '#39'||'
      
        '110209476=                       '#39'ON (c.K_DATE = cd.K_DATE AND C' +
        '.G_TOCHKA = CD.G_TOCHKA) '#39'||'
      '110209477=                       '#39'WHEN MATCHED THEN '#39'||'
      '110209478=                       '#39' UPDATE SET '#39'||'
      
        '110209479=                       '#39'  C.DEBET  = COALESCE(C.DEBET,' +
        ' 0) + '#39'||COALESCE(DEBET_, 0)||'#39', '#39'||'
      
        '110209480=                       '#39'  C.CREDIT = COALESCE(C.CREDIT' +
        ', 0) + '#39'||COALESCE(CREDIT_, 0)||'#39', '#39'||'
      
        '110209481=                       '#39'  C.OUTPUT = COALESCE(C.INPUT,' +
        ' 0) - (COALESCE(C.DEBET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39') + (COA' +
        'LESCE(C.CREDIT, 0) + '#39'||COALESCE(CREDIT_, 0)||'#39') '#39'||'
      '110209482=                       '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110209483=                       '#39' INSERT (KASSA_STATE, K_DATE, ' +
        '"INPUT", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '110209484=                       '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_S' +
        'TATE, 0)||'#39', '#39#39#39'||ACTION_DATE_||'#39#39#39', COALESCE((SELECT "OUTPUT" F' +
        'ROM KASSA_STATE WHERE '#39'||'
      
        '110209485=                                                      ' +
        '                                              '#39'K_DATE = (SELECT ' +
        'MAX(K_DATE) '#39'||'
      
        '110209486=                                                      ' +
        '                                                         '#39' FROM ' +
        'KASSA_STATE '#39'||'
      
        '110209487=                                                      ' +
        '                                                         '#39' WHERE' +
        ' K_DATE < CD.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110209488=                                                      ' +
        '                                                         '#39' AND G' +
        '_TOCHKA = CD.G_TOCHKA), 0), '#39'||'
      '110209489=                       COALESCE(DEBET_, 0)||'#39', '#39'||'
      '110209490=                       COALESCE(CREDIT_, 0)||'
      
        '110209491=                       '#39', COALESCE((SELECT "OUTPUT" FR' +
        'OM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110209492=                                                      ' +
        '                              '#39' FROM KASSA_STATE '#39'||'
      
        '110209493=                                                      ' +
        '                              '#39' WHERE K_DATE < CD.K_DATE AND G_T' +
        'OCHKA = CD.G_TOCHKA) '#39'||'
      
        '110209494=                                                      ' +
        '                              '#39' AND G_TOCHKA = CD.G_TOCHKA), 0) ' +
        '- '#39'||COALESCE(DEBET_, 0)||'#39' + '#39'||COALESCE(CREDIT_, 0)||'#39', '#39'||G_T' +
        'OCHKA_||'#39');'#39';'
      
        '110209495=            INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR' +
        ', IS_TRANSFERED, SYSDATE, ERR_CODE)'
      
        '110209496=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39 +
        'KASSA_STATE'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209497=      END*/'
      '110209498=  END'
      '110209499='
      '110209500=  -- '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1041#1045#1047#1053#1040#1051
      '110209501=  ELSE BEGIN'
      '110209502=    UPDATE KASSA_BEZNAL_STATE K'
      
        '110209503=       SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE(:' +
        'DEBET_, 0),'
      
        '110209504=           K.CREDIT = COALESCE(K.CREDIT, 0) + COALESCE' +
        '(:CREDIT_, 0),'
      
        '110209505=           K.OUTPUT = COALESCE(K.INPUT, 0) - (COALESCE' +
        '(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) + ' +
        'COALESCE(:CREDIT_, 0))'
      '110209506=     WHERE K.K_DATE = :ACTION_DATE_;'
      '110209507='
      
        '110209508=    IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' ' +
        #1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '110209509=      -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '110209510=      PNT_ = '#39'03A'#39';'
      '110209511=      BEGIN'
      '110209512=        SELECT K.OUTPUT'
      '110209513=          FROM KASSA_BEZNAL_STATE K'
      '110209514=         WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '110209515=                             FROM KASSA_BEZNAL_STATE S'
      
        '110209516=                            WHERE S.K_DATE < :ACTION_D' +
        'ATE_)'
      '110209517=        INTO :INPUT_;'
      '110209518='
      '110209519=        if (ROW_COUNT = 0) then'
      
        '110209520=          INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '110209521=      WHEN ANY DO'
      '110209522=        BEGIN'
      '110209523=          Err_Code = -20500;'
      
        '110209524=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048 +
        #1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110209525=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110209526=          EXIT;'
      '110209527=        END'
      '110209528=      END'
      '110209529='
      '110209530=      INSERT INTO KASSA_BEZNAL_STATE'
      
        '110209531=        (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CRE' +
        'DIT, OUTPUT)'
      '110209532=      VALUES'
      
        '110209533=        (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, CO' +
        'ALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0),' +
        ' COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDIT_' +
        ',0));'
      '110209534=    END'
      '110209535='
      
        '110209536=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110209537=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      
        '110209538=        SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE c '#39'|' +
        '|'
      
        '110209539=                   '#39'USING (select CAST('#39#39#39'||ACTION_DAT' +
        'E_||'#39#39#39' AS DATE) as K_DATE'#39'||'
      '110209540=                   '#39' from RDB$DATABASE) cd '#39'||'
      '110209541=                   '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '110209542=                   '#39'WHEN MATCHED THEN '#39'||'
      '110209543=                   '#39' UPDATE SET '#39'||'
      
        '110209544=                   '#39'  C.DEBET  = COALESCE(C.DEBET, 0) ' +
        '+ '#39'||COALESCE(DEBET_, 0)||'#39', '#39'||'
      
        '110209545=                   '#39'  C.CREDIT = COALESCE(C.CREDIT, 0)' +
        ' + '#39'||COALESCE(CREDIT_, 0)||'#39', '#39'||'
      
        '110209546=                   '#39'  C.OUTPUT = COALESCE(C.INPUT, 0) ' +
        '- (COALESCE(C.DEBET, 0) + '#39'||COALESCE(DEBET_, 0)||'#39') + (COALESCE' +
        '(C.CREDIT, 0) + '#39'||COALESCE(CREDIT_, 0)||'#39') '#39'||'
      '110209547=                   '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110209548=                   '#39' INSERT (KASSA_BEZNAL_STATE, K_DAT' +
        'E, "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
        '110209549=                   '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE' +
        ', 0)||'#39', '#39#39#39'||ACTION_DATE_||'#39#39#39', COALESCE((SELECT "OUTPUT" FROM ' +
        'KASSA_BEZNAL_STATE WHERE '#39'||'
      
        '110209550=                                                      ' +
        '                                           '#39'K_DATE = (SELECT MAX' +
        '(K_DATE) '#39'||'
      
        '110209551=                                                      ' +
        '                                           '#39' FROM KASSA_BEZNAL_S' +
        'TATE '#39'||'
      
        '110209552=                                                      ' +
        '                                           '#39' WHERE K_DATE < CD.K' +
        '_DATE) '#39'||'
      
        '110209553=                                                      ' +
        '                                           '#39' ), 0), '#39'||'
      '110209554=                   COALESCE(DEBET_, 0)||'#39', '#39'||'
      '110209555=                   COALESCE(CREDIT_, 0)||'
      
        '110209556=                   '#39', COALESCE((SELECT "OUTPUT" FROM K' +
        'ASSA_BEZNAL_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110209557=                                                      ' +
        '                                  '#39' FROM KASSA_BEZNAL_STATE '#39'||'
      
        '110209558=                                                      ' +
        '                                  '#39' WHERE K_DATE < CD.K_DATE) '#39'|' +
        '|'
      
        '110209559=                                                      ' +
        '                                  '#39' ), 0) - '#39'||COALESCE(DEBET_, ' +
        '0)||'#39' + '#39'||COALESCE(CREDIT_, 0)||'#39');'#39';'
      
        '110209560=        INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR, IS' +
        '_TRANSFERED, SYSDATE, ERR_CODE)'
      
        '110209561=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'KASS' +
        'A_STATE_BEZNAL'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110209562=    END*/'
      '110209563=  END'
      '110209564=END'
      '110209565=;'
      '110209566='
      '110209567=ALTER PROCEDURE LOG_INIT'
      '110209568=AS'
      '110209569=DECLARE VARIABLE TN VARCHAR(64);'
      '110209570=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110209571=DECLARE VARIABLE FN VARCHAR(64);'
      '110209572=DECLARE VARIABLE TP INTEGER;'
      
        '110209573=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110209574=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110209575=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110209576=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110209577=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110209578=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110209579=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110209580=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000) */'
      '110209581=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110209582=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110209583=DECLARE VARIABLE ANZ INTEGER;'
      '110209584=DECLARE VARIABLE L INTEGER;'
      '110209585=DECLARE VARIABLE P INTEGER;'
      '110209586=DECLARE VARIABLE S INTEGER;'
      '110209587=DECLARE VARIABLE FT CHAR(1);'
      '110209588=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110209589=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110209590=BEGIN'
      '110209591=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110209592='
      '110209593=  TN_ALT='#39#39';'
      '110209594=  TRGI='#39#39';'
      '110209595=  TRGU='#39#39';'
      '110209596=  TRGD='#39#39';'
      '110209597=  TRGIX='#39#39';'
      '110209598=  TRGUX='#39#39';'
      '110209599=  TRGDX='#39#39';'
      '110209600=  SQLF='#39#39';'
      '110209601=  SQLV='#39#39';'
      '110209602=  SQLU='#39#39';'
      '110209603=  FT='#39#39';'
      '110209604='
      '110209605=  FOR SELECT R.RDB$RELATION_NAME,'
      '110209606=            R.RDB$FIELD_NAME,'
      '110209607=            F.RDB$FIELD_TYPE,'
      '110209608=            F.RDB$FIELD_LENGTH,'
      '110209609=            F.RDB$FIELD_PRECISION,'
      '110209610=            F.RDB$FIELD_SCALE'
      '110209611=        FROM RDB$RELATION_FIELDS R,'
      '110209612=             RDB$FIELDS F'
      '110209613=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110209614=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110209615=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110209616=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110209617=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110209618=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110209619=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110209620=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110209621=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110209622=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110209623=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39')'
      '110209624=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110209625=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110209626=              OR'
      
        '110209627=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110209628=             )'
      
        '110209629=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110209630=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110209631=  DO BEGIN'
      '110209632=    TN=TRIM(TN);'
      '110209633=    FN=TRIM(FN);'
      '110209634=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110209635=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110209636=      EXECUTE STATEMENT TRGI;'
      '110209637=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110209638=      EXECUTE STATEMENT TRGU;'
      '110209639=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110209640=      EXECUTE STATEMENT TRGD;'
      '110209641='
      '110209642=      SQLF='#39#39';'
      '110209643=      SQLV='#39#39';'
      '110209644=      SQLU='#39#39';'
      '110209645=    END'
      '110209646=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110209647=      ID_COLUMN = FN;'
      '110209648='
      '110209649=    S=-S;'
      
        '110209650=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110209651=      ft='#39'N'#39';   --numerisch'
      '110209652=    else'
      '110209653=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110209654=        ft='#39'Z'#39';   --zeit'
      '110209655=      else'
      '110209656=        ft='#39'T'#39';'
      '110209657='
      '110209658=    IF (SQLF='#39#39') THEN'
      '110209659=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110209660=    ELSE'
      '110209661=      SQLF=SQLF||'#39','#39'||FN;'
      '110209662='
      '110209663=    if (ft='#39'N'#39') then begin'
      '110209664=      IF (SQLV='#39#39') THEN'
      
        '110209665=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110209666=      ELSE'
      
        '110209667=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110209668='
      '110209669=      IF (SQLU='#39#39') THEN'
      
        '110209670=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110209671=      ELSE'
      
        '110209672=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110209673=    end'
      '110209674=    else'
      '110209675=      if (ft='#39'Z'#39') then begin'
      '110209676=        IF (SQLV='#39#39') THEN'
      
        '110209677=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||re' +
        'place(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        '),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110209678=        ELSE'
      
        '110209679=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||re' +
        'place(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        '),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110209680='
      '110209681=        IF (SQLU='#39#39') THEN'
      
        '110209682=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'U' +
        'PDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM' +
        '(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39 +
        ')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110209683=        ELSE'
      
        '110209684=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39 +
        '||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39 +
