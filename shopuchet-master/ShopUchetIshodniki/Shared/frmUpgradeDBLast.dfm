      '110243627=             IS_TIS_TYPE,'
      '110243628=             POS_TERMINAL_TYPE'
      '110243629=      FROM G_NONCASH_PAY_TYPE'
      '110243630=      WHERE IS_ACTIVE = 1'
      '110243631=      INTO :G_NONCASH_PAY_TYPE,'
      '110243632=           :NAME,'
      '110243633=           :IS_ACTIVE,'
      '110243634=           :IS_TIS_TYPE,'
      '110243635=           :POS_TERMINAL_TYPE'
      '110243636=  DO'
      '110243637=  BEGIN'
      '110243638=    SUSPEND;'
      '110243639=  END'
      '110243640=END'
      '110243641=;'
      '110243642='
      '110243643=ALTER PROCEDURE G_NONCASH_PAY_TYPE_UPD('
      
        '110243644=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      '110243645=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110243646=  IS_TIS_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_TI' +
        'S_TYPE,'
      
        '110243647=  POS_TERMINAL_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.POS_TERMINAL_TYPE = 0)'
      '110243648=AS'
      '110243649=BEGIN'
      '110243650=  UPDATE G_NONCASH_PAY_TYPE'
      
        '110243651=  SET NAME = :NAME_, IS_TIS_TYPE = :IS_TIS_TYPE_, POS_' +
        'TERMINAL_TYPE = :POS_TERMINAL_TYPE_'
