      '11022020='
      '11022021=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      
        '11022022=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      
        '11022023=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT */ BIGINT,'
      
        '11022024=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      '11022025=  DATE_BEGIN_ DATE,'
      '11022026=  DATE_END_ DATE,'
      '11022027=  TIME_BEGIN_ TIME,'
      '11022028=  TIME_END_ TIME,'
      '11022029=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11022030=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11022031=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '11022032=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BI' +
        'GINT = 0)'
      '11022033=RETURNS ('
      
        '11022034=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUME' +
        'RIC(18,5),'
      
        '11022035=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERI' +
        'C(15,2),'
      
        '11022036=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11022037=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOU' +
        'NT_TENGE */ NUMERIC(15,2),'
      
        '11022038=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11022039=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHA' +
        'R(250),'
      
        '11022040=  PAYMENT_NAME /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME */' +
        ' VARCHAR(256),'
      
        '11022041=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      
        '11022042=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11022043=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11022044=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      '11022045=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '11022046=  Z_DATE BLOB SUB_TYPE 1,'
      '11022047=  ROW INTEGER,'
      '11022048=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '11022049=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      
        '11022050=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMERI' +
        'C(15,2),'
      
        '11022051=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */ ' +
        'NUMERIC(15,2),'
      
        '11022052=  OFFICIAL_NAME /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */' +
        ' VARCHAR(150),'
      '11022053=  ERR_CODE INTEGER,'
