        'ASHOD,'
      '1101823473=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101823474=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101823475=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101823476=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101823477=  IS_MEBEL_ INTEGER = 0,'
      
        '1101823478=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1101823479=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      '1101823480=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '1101823481=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1101823482=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101823483=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1101823484=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1101823485=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101823486=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101823487=RETURNS ('
      '1101823488=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101823489=  ERR_CODE INTEGER,'
      '1101823490=  ERR_MSG VARCHAR(1024))'
      '1101823491=AS'
      '1101823492=/*'
      '1101823493=IS_SPISANIE_'
      '1101823494=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101823495=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101823496=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101823497=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101823498='
      '1101823499='
      
        '1101823500=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '1101823501=*/'
      '1101823502=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1101823503=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101823504=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
