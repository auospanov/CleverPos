      '11079115='
      '11079116=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      
        '11079117=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      
        '11079118=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT */ BIGINT,'
      
        '11079119=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      '11079120=  DATE_BEGIN_ DATE,'
      '11079121=  DATE_END_ DATE,'
      '11079122=  TIME_BEGIN_ TIME,'
      '11079123=  TIME_END_ TIME,'
      '11079124=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11079125=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11079126=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11079127=RETURNS ('
      
        '11079128=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUME' +
        'RIC(18,5),'
      
        '11079129=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERI' +
        'C(15,2),'
      
        '11079130=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11079131=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOU' +
        'NT_TENGE */ NUMERIC(15,2),'
      
        '11079132=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11079133=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHA' +
        'R(250),'
      
        '11079134=  PAYMENT_NAME /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME */' +
        ' VARCHAR(256),'
      
        '11079135=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      
        '11079136=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11079137=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11079138=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      '11079139=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '11079140=  Z_DATE BLOB SUB_TYPE 1,'
      '11079141=  ROW INTEGER,'
      '11079142=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '11079143=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      '11079144=  ERR_CODE INTEGER,'
      '11079145=  ERR_MSG VARCHAR(1024))'
      '11079146=AS'
      '11079147=BEGIN'
