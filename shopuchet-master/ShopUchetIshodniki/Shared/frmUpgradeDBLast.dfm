      '1102438=AS'
      '1102439=BEGIN'
      '1102440=  SUSPEND;'
      '1102441=END'
      '1102442='#39';'
      '1102443='
      '1102444=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SKLAD('
      
        '1102445=  SKLAD_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */ INTEGER' +
        ','
      '1102446=  MODE_ INTEGER)'
      '1102447=RETURNS ('
      
        '1102448=  G_PROD_NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCH' +
        'AR(250),'
      
        '1102449=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT */ DATE,'
      
        '1102450=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT */ TIME,'
      
        '1102451=  G_CLIENT_ /* TYPE OF COLUMN SKLAD_PARENT.G_CLIENT */ I' +
        'NTEGER,'
      
        '1102452=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN SKLAD_PARENT.G_PAYME' +
        'NT_TYPE */ INTEGER,'
      
        '1102453=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE */' +
        ' VARCHAR(150),'
      
        '1102454=  NOTE_ /* TYPE OF COLUMN SKLAD_PARENT.NOTE */ VARCHAR(2' +
        '00),'
      
        '1102455=  SUMM_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(1' +
        '5,2),'
      
