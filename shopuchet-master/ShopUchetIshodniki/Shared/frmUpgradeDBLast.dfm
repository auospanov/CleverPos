      '1104021=END'
      '1104022='#39';'
      '1104023='
      '1104024=EXECUTE STATEMENT '#39'ALTER PROCEDURE DO_PRODUCT('
      
        '1104025=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTEG' +
        'ER,'
      
        '1104026=  DATE_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT */ D' +
        'ATE,'
      
        '1104027=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ IN' +
        'TEGER,'
      '1104028=  AMOUNT_ INTEGER,'
      '1104029=  NOTE_ /* TYPE OF COLUMN OTHER.NOTE */ BLOB SUB_TYPE 1)'
      '1104030=RETURNS ('
      '1104031=  SKLAD_ /* TYPE OF COLUMN OTHER.OTHER */ INTEGER,'
      '1104032=  ERR_CODE INTEGER,'
      '1104033=  ERR_MSG VARCHAR(1024))'
