      '1101340=CREATE PROCEDURE G_GET_G_PRODUCT_IMAGE('
      
        '1101341=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT)'
      '1101342=RETURNS ('
      '1101343=  IMG /* TYPE OF COLUMN G_PRODUCT_IMAGE.BODY */ BLOB,'
      
        '1101344=  PTYPE /* TYPE OF COLUMN G_PRODUCT_IMAGE.TYPE */ INTEGE' +
        'R)'
      '1101345=AS'
