      '1102502348=    IF (TN = '#39'KASSA'#39') THEN'
      
        '1102502349=        TRGD = TRGD||CRLF||'#39'  INSERT INTO LOGS(ID,SQL' +
        'STMT,TTABLE,USR)'#39'||CRLF||'
      
        '1102502350=          '#39'  SELECT GEN_ID(GEN_LOGS,1), '#39#39'KASSA:'#39#39'||O' +
        'LD.G_TOCHKA||'#39#39'~'#39#39'||OLD.ACTION_DATE, '#39#39'KASSA'#39#39', '#39#39'SYSDBA'#39#39#39'||CRL' +
        'F||'
      
        '1102502351=          '#39'  FROM RDB$DATABASE WHERE NOT EXISTS (SELE' +
        'CT 1 FROM LOGS L WHERE L.SQLSTMT = '#39#39'KASSA:'#39#39'||OLD.G_TOCHKA||'#39#39'~' +
        #39#39'||OLD.ACTION_DATE AND'#39'||CRLF||'
      
        '1102502352=          '#39'                                      L.US' +
        'R = '#39#39'SYSDBA'#39#39' AND L.DAT IS NULL AND L.IS_TRANSFERED = 0);'#39'||CRL' +
        'F;'
      '1102502353='
      '1102502354=    ELSE IF (TN = '#39'KASSA_BEZNAL'#39') THEN'
      
        '1102502355=        TRGD = TRGD||CRLF||'#39'  INSERT INTO LOGS(ID,SQL' +
        'STMT,TTABLE,USR)'#39'||CRLF||'
      
        '1102502356=          '#39'  SELECT GEN_ID(GEN_LOGS,1), '#39#39'KASSA_BEZNA' +
        'L:'#39#39'||OLD.ACTION_DATE, '#39#39'KASSA_BEZNAL'#39#39', '#39#39'SYSDBA'#39#39#39'||CRLF||'
      
        '1102502357=          '#39'  FROM RDB$DATABASE WHERE NOT EXISTS (SELE' +
        'CT 1 FROM LOGS L WHERE L.SQLSTMT = '#39#39'KASSA_BEZNAL:'#39#39'||OLD.ACTION' +
        '_DATE AND'#39'||CRLF||'
      
        '1102502358=          '#39'                                      L.US' +
        'R = '#39#39'SYSDBA'#39#39' AND L.DAT IS NULL AND L.IS_TRANSFERED = 0);'#39'||CRL' +
        'F;'
      '1102502359='
      '1102502360=    TRGD = TRGD||'#39'END'#39';'
      '1102502361='
      '1102502362=    TN_ALT=TN;'
      '1102502363=  END'
      '1102502364=  IF (TRGIX<>'#39#39') THEN'
      '1102502365=    EXECUTE STATEMENT TRGIX;'
      '1102502366='
      '1102502367=  EXECUTE STATEMENT TRGI;'
      '1102502368=  IF (TRGUX<>'#39#39') THEN'
      '1102502369=    EXECUTE STATEMENT TRGUX;'
      '1102502370='
      '1102502371=  EXECUTE STATEMENT TRGU;'
      '1102502372='
      '1102502373=  IF (TRGDX<>'#39#39') THEN'
      '1102502374=    EXECUTE STATEMENT TRGDX;'
      '1102502375=  EXECUTE STATEMENT TRGD;'
      '1102502376='
      '1102502377=  -- BLOB-'#1055#1054#1051#1071' '#1054#1058#1044#1045#1051#1068#1053#1067#1045' '#1058#1056#1048#1043#1043#1045#1056#1067
      '1102502378=  TN_ALT    = '#39#39';'
      '1102502379=  ID_COLUMN = '#39#39';'
      
        '1102502380=  FOR SELECT TRIM(RDB$RELATION_FIELDS.RDB$RELATION_NA' +
        'ME),'
      '1102502381=             TRIM(RDB$RELATION_FIELDS.RDB$FIELD_NAME)'
      
        '1102502382=        FROM RDB$RELATION_FIELDS JOIN RDB$FIELDS ON R' +
        'DB$RELATION_FIELDS.RDB$FIELD_SOURCE=RDB$FIELDS.RDB$FIELD_NAME'
      
        '1102502383=       WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T CONTAINING '#39'$'#39
      '1102502384=         AND RDB$FIELDS.RDB$FIELD_TYPE = 261'
      '1102502385=         AND RDB$FIELDS.RDB$FIELD_SUB_TYPE = 0'
      
        '1102502386=         AND RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T IN ('#39'CUR_PARAMS'#39', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_' +
        'SIZES'#39','
      
        '1102502387=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1102502388=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1102502389=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1102502390=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1102502391=                                         '#39'REVISION'#39', ' +
        #39'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1102502392=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_TOC' +
        'HKA'#39', '#39'G_PRODUCT_FILL'#39','
      
        '1102502393=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39')'
      '1102502394=        INTO :TN,'
      '1102502395=             :FN'
      '1102502396=  DO BEGIN'
      '1102502397=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN BEGIN'
      '1102502398=      SELECT TRIM(F.RDB$FIELD_NAME)'
      '1102502399=        FROM RDB$RELATION_FIELDS F'
      '1102502400=       WHERE F.RDB$RELATION_NAME = :TN'
      '1102502401=         AND F.RDB$FIELD_POSITION = 0'
      '1102502402=        INTO :ID_COLUMN;'
      '1102502403=    END'
      '1102502404='
      
        '1102502405=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1102502406=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '1102502407=        '#39'AS '#39'||CRLF||'
      '1102502408=        '#39'BEGIN '#39'||CRLF||'
      
        '1102502409=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1102502410=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF|' +
        '|'
      
        '1102502411=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1102502412=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1102502413=        '#39'END;'#39';'
      '1102502414=    EXECUTE STATEMENT :TRGI;'
      '1102502415='
      
        '1102502416=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1102502417=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '1102502418=        '#39'AS '#39'||CRLF||'
      '1102502419=        '#39'BEGIN '#39'||CRLF||'
      
        '1102502420=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1102502421=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRL' +
        'F||'
      
        '1102502422=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1102502423=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1102502424=        '#39'END;'#39';'
      '1102502425=    EXECUTE STATEMENT :TRGI;'
      '1102502426='
      '1102502427=    TN_ALT = TN;'
      '1102502428=  END'
      '1102502429=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '1102502430=        FROM RDB$RELATIONS R'
      '1102502431=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1102502432=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '1102502433=       ORDER BY R.RDB$RELATION_NAME'
      '1102502434=        INTO :TN'
      '1102502435=  DO BEGIN'
      '1102502436=    TN=TRIM(TN);'
      '1102502437=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '1102502438='
      '1102502439=    EXECUTE STATEMENT :SQLSTMT;'
      '1102502440=  END'
      '1102502441=END'
      '1102502442=;'
      '1102502443='
      '1102502444=ALTER PROCEDURE LOG_OPER_INS('
      '1102502445=  ITEM_TYPE_ INTEGER,'
      '1102502446=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102502447=  ITEM_ID_ TYPE OF DM_BIGINT,'
      '1102502448=  OPER_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102502449=  OPER_TYPE_ TYPE OF COLUMN LOG_OPER.OPERATION,'
      '1102502450=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102502451=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY,'
      '1102502452=  IS_PRIHOD_ INTEGER = 0,'
      '1102502453=  PARAM1_ VARCHAR(500) = '#39#39')'
      '1102502454=AS'
      
        '1102502455=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1102502456=DECLARE VARIABLE STR_ VARCHAR(50);'
      '1102502457=BEGIN'
      '1102502458='
      '1102502459=  IF (ITEM_TYPE_ < 10) THEN BEGIN'
      '1102502460=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1102502461='
      '1102502462=          IF (IS_PRIHOD_ = 0) THEN BEGIN'
      '1102502463=              IF (ITEM_TYPE_ = 0) THEN BEGIN'
      '1102502464=                LOG_ITEM_TYPE_ = 1;'
      '1102502465=                STR_ = '#39#1055#1088#1086#1076#1072#1078#1072#39';'
      '1102502466=              END ELSE IF (ITEM_TYPE_ = 1) THEN BEGIN'
      '1102502467=                LOG_ITEM_TYPE_ = 2;'
      '1102502468=                STR_ = '#39#1057#1087#1080#1089#1072#1085#1080#1077#39';'
      '1102502469=              END ELSE IF (ITEM_TYPE_ = 2) THEN BEGIN'
      '1102502470=                LOG_ITEM_TYPE_ = 3;'
      '1102502471=                STR_ = '#39#1042#1099#1076#1072#1095#1072' '#1087#1086#1076' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102#39';'
      '1102502472=              END ELSE IF (ITEM_TYPE_ = 3) THEN BEGIN'
      '1102502473=                LOG_ITEM_TYPE_ = 6;'
      '1102502474=                STR_ = '#39#1055#1077#1088#1077#1084#1077#1097#1077#1085#1080#1077#39';'
      '1102502475=              END ELSE IF (ITEM_TYPE_ = 4) THEN BEGIN'
      '1102502476=                LOG_ITEM_TYPE_ = 7;'
      '1102502477=                STR_ = '#39#1042#1086#1079#1074#1088#1072#1090' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39';'
      '1102502478=              END'
      '1102502479=          END'
      '1102502480=          ELSE BEGIN'
      '1102502481=              IF (ITEM_TYPE_ = 0) THEN BEGIN'
      '1102502482=                LOG_ITEM_TYPE_ = 4;'
      '1102502483=                STR_ = '#39#1055#1088#1080#1093#1086#1076#39';'
      '1102502484=              END ELSE IF (ITEM_TYPE_ = 1) THEN BEGIN'
      '1102502485=                LOG_ITEM_TYPE_ = 5;'
      '1102502486=                STR_ = '#39#1042#1086#1079#1074#1088#1072#1090#39';'
      '1102502487=              END ELSE IF (ITEM_TYPE_ = 2) THEN BEGIN'
      '1102502488=                LOG_ITEM_TYPE_ = 8;'
      '1102502489=                STR_ = '#39#1042#1086#1079#1074#1088#1072#1090' '#1074#1099#1076#1072#1095#1080' '#1087#1086#1076' '#1088#1077#1072#1083'.'#39';'
      '1102502490=              END ELSE IF (ITEM_TYPE_ = 4) THEN BEGIN'
      '1102502491=                LOG_ITEM_TYPE_ = 9;'
      '1102502492=                STR_ = '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086#39';'
      '1102502493=              END'
      '1102502494=          END'
      '1102502495='
      
        '1102502496=          INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPER' +
        'ATION, G_OFFICIAL,'
      '1102502497=            ITEM_TYPE,'
      '1102502498=            ITEM_ID, HEADER, BODY)'
      
        '1102502499=          VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TI' +
        'MESTAMP, :OPER_TYPE_, :USER_ID_,'
      '1102502500=            :LOG_ITEM_TYPE_,'
      '1102502501=            :ITEM_ID_,'
      '1102502502=            :STR_ ||'#39' '#39'|| :ITEM_ID_ || '#39' '#1086#1090' '#39' ||'
      
        '1102502503=            EXTRACT(day FROM :OPER_DATE_) || '#39'.'#39' || E' +
        'XTRACT(month FROM :OPER_DATE_)||'#39'.'#39' || EXTRACT(year FROM :OPER_D' +
        'ATE_) || '#39' '#1085#1072' '#1089#1091#1084#1084#1091' '#39' || :SUMM_, :LOG_BODY_);'
      '1102502504=      END'
      '1102502505=  END'
      
        '1102502506=  --=================================================' +
        '============='
      '1102502507=  -- '#1050#1040#1057#1057#1040
      '1102502508=  ELSE IF (ITEM_TYPE_ IN (10, 11)) THEN BEGIN'
      '1102502509=    IF (ITEM_TYPE_ = 10) THEN BEGIN'
      '1102502510=        STR_ = '#39#1055#1088#1080#1093#1086#1076' '#39';'
      '1102502511=    END ELSE IF (ITEM_TYPE_ = 11) THEN BEGIN'
      '1102502512=        STR_ = '#39#1056#1072#1089#1093#1086#1076' '#39';'
      '1102502513=    END'
      '1102502514='
      
        '1102502515=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1102502516=      ITEM_TYPE,'
      '1102502517=      ITEM_ID, HEADER, BODY)'
      
        '1102502518=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1102502519=      :ITEM_TYPE_,'
      '1102502520=      :ITEM_ID_,'
      '1102502521=      :STR_ || :ITEM_ID_ || '#39' '#1086#1090' '#39' ||'
      
        '1102502522=      EXTRACT(day FROM :OPER_DATE_) || '#39'.'#39' || EXTRACT' +
        '(month FROM :OPER_DATE_)||'#39'.'#39' || EXTRACT(year FROM :OPER_DATE_) ' +
        '|| '#39' '#1085#1072' '#1089#1091#1084#1084#1091' '#39' || :SUMM_, :LOG_BODY_);'
      '1102502523=  END'
      
        '1102502524=  --=================================================' +
        '============='
      '1102502525=  -- '#1050#1051#1048#1045#1053#1058#1067
      '1102502526=  ELSE IF (ITEM_TYPE_ = 12) THEN BEGIN'
      
        '1102502527=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1102502528=      ITEM_TYPE,'
      '1102502529=      ITEM_ID, HEADER, BODY)'
      
        '1102502530=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1102502531=      :ITEM_TYPE_,'
      '1102502532=      :ITEM_ID_,'
      '1102502533=      '#39#1050#1083#1080#1077#1085#1090' '#39'|| :PARAM1_ , :LOG_BODY_);'
      '1102502534=  END'
      
        '1102502535=  --=================================================' +
        '============='
      '1102502536=  -- '#1058#1054#1042#1040#1056#1067
      '1102502537=  ELSE IF (ITEM_TYPE_ = 13) THEN BEGIN'
      
        '1102502538=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1102502539=      ITEM_TYPE,'
      '1102502540=      ITEM_ID, HEADER, BODY)'
      
        '1102502541=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1102502542=      :ITEM_TYPE_,'
      '1102502543=      :ITEM_ID_,'
      '1102502544=      '#39#1058#1086#1074#1072#1088' '#39'|| :PARAM1_ , :LOG_BODY_);'
      '1102502545=  END'
      
        '1102502546=  --=================================================' +
        '============='
      '1102502547=  -- '#1053#1040#1057#1058#1056#1054#1049#1050#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1067
      '1102502548=  ELSE IF (ITEM_TYPE_ = 14) THEN BEGIN'
      
        '1102502549=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1102502550=      ITEM_TYPE,'
      '1102502551=      ITEM_ID, HEADER, BODY)'
      
        '1102502552=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1102502553=      :ITEM_TYPE_,'
      '1102502554=      NULL,'
      '1102502555=      '#39#1053#1072#1089#1090#1088#1086#1081#1082#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099#39', :LOG_BODY_);'
      '1102502556=  END'
      
        '1102502557=  --=================================================' +
        '============='
      '1102502558=  -- '#1054#1063#1048#1057#1058#1050#1040' '#1041#1040#1047#1067
      '1102502559=  ELSE IF (ITEM_TYPE_ = 15) THEN BEGIN'
      
        '1102502560=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1102502561=      ITEM_TYPE,'
      '1102502562=      ITEM_ID, HEADER, BODY)'
      
        '1102502563=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1102502564=      :ITEM_TYPE_,'
      '1102502565=      NULL,'
      '1102502566=      '#39#1054#1095#1080#1089#1090#1082#1072' '#1073#1072#1079#1099#39', :LOG_BODY_);'
      '1102502567=  END'
      '1102502568=END'
      '1102502569=;'
      '1102502570='
      '1102502571=ALTER PROCEDURE P_REP_INVOICE_PAY_TMP('
      '1102502572=  CURRENCY_ INTEGER,'
      '1102502573=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102502574=  AGREEMENT_IN_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102502575=  SUMM_IN_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102502576=  AMOUNT_IN_ INTEGER,'
      '1102502577=  NDS_SUMM_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS_SUMM,'
      '1102502578=  DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE)'
      '1102502579=RETURNS ('
      '1102502580=  NUM_ VARCHAR(500),'
      '1102502581=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '1102502582=  POSTAVSHIK_IDN_ VARCHAR(20),'
      '1102502583=  POSTAVSHIK_IDN_SELF_ VARCHAR(20),'
      '1102502584=  POSTAVSHIK_KPP_ VARCHAR(20),'
      '1102502585=  ACCOUNT_ VARCHAR(50),'
      '1102502586=  KBE_ VARCHAR(50),'
      '1102502587=  BANK_ VARCHAR(1000),'
      '1102502588=  BIK_ VARCHAR(20),'
      '1102502589=  KNP_ VARCHAR(20),'
      '1102502590=  POSTAVSHIK_ VARCHAR(1000),'
      '1102502591=  POKUPATEL_ VARCHAR(1000),'
      '1102502592=  AGREEMENT_ VARCHAR(500),'
      '1102502593=  SUMM_ VARCHAR(100),'
      '1102502594=  NDS_ VARCHAR(100),'
      '1102502595=  VSEGO_NAIM_ VARCHAR(500),'
      '1102502596=  VSEGO_K_OPLATE_ VARCHAR(500),'
      '1102502597=  ISPOLNITEL_ VARCHAR(500),'
      '1102502598=  ISPOLNITEL_APP_ VARCHAR(500),'
      '1102502599=  RUKOVODITEL_ VARCHAR(500),'
      '1102502600=  RUKOVODITEL_APP_ VARCHAR(500),'
      '1102502601=  ROW_NUM VARCHAR(100),'
      '1102502602=  ARTICUL VARCHAR(30),'
      '1102502603=  NAME VARCHAR(500),'
      '1102502604=  AMOUNT VARCHAR(500),'
      '1102502605=  SHORT_NAME VARCHAR(1000),'
      '1102502606=  PRICE VARCHAR(500),'
      '1102502607=  SUMM VARCHAR(500),'
      '1102502608=  ERR_CODE INTEGER,'
      '1102502609=  ERR_MSG VARCHAR(1024))'
      '1102502610=AS'
      
        '1102502611=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_INVOIC' +
        'E_PAY'#39';'
      '1102502612=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102502613=DECLARE VARIABLE IS_PAY_NDS_ TYPE OF COLUMN G_FIRM_RE' +
        'KVIZIT.IS_NDS;'
      
        '1102502614=DECLARE VARIABLE NOL_VMESTO_NDS_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.NOL_VMESTO_BEZ;'
      '1102502615=DECLARE VARIABLE I INTEGER = 1;'
      '1102502616=DECLARE VARIABLE VAL_STR_ VARCHAR(20);'
      '1102502617=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      
        '1102502618=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      '1102502619=BEGIN'
      '1102502620='
      '1102502621=  -- '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059
      
        '1102502622=  SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VARC' +
        'HAR(20)) -- NVL '#1055#1054#1057#1058#1040#1042#1048#1051
      '1102502623=    FROM INVOICE_PAY P'
      
        '1102502624=   WHERE EXTRACT(YEAR FROM P.INIT_DATE) = EXTRACT(YEA' +
        'R FROM :DATE_)'
      
        '1102502625=     AND ((SELECT * FROM IS_NUMERIC(P.NUM)) <> -999) ' +
        ' -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070' '#1058#1054#1051#1068#1050#1054' '#1062#1048#1060#1056#1054#1042#1067#1045' '#1053#1054#1052#1045#1056#1040
      '1102502626=    INTO :NUM_;'
      
        '1102502627=  if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059' '#1042 +
        #1054#1054#1041#1065#1045' '#1053#1045#1058
      '1102502628=    NUM_ = '#39'1'#39';'
      '1102502629='
      '1102502630=  -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1102502631=  SELECT G.name'
      
        '1102502632=         ,DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39':' +
        ' '#39'||G.IDN'
      '1102502633=         ,G.IDN'
      '1102502634=         ,G.KPP'
      '1102502635=         ,AC.ACCOUNT'
      '1102502636=         ,G.kbe'
      '1102502637=         ,AC.NAME'
      '1102502638=         ,AC.BIK'
      '1102502639=         ,'#39#39'        --'#1050#1053#1055
      
        '1102502640=         ,DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39':' +
        ' '#39'||G.IDN||'#39', '#39'||G.name||'#39', '#39'||COALESCE(AD.ADDRESS, '#39#39')'
      
        '1102502641=         ,DECODE(char_length(TRIM(GC.idn)), 0, '#39#39', '#39#1048 +
        #1048#1053'/'#1041#1048#1053': '#39'||GC.idn||'#39', '#39')||GC.name||COALESCE('#39', '#39'||ADC.ADDRESS, '#39 +
        #39')'
      
        '1102502642=         ,COALESCE(TRIM(:AGREEMENT_IN_), '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088 +
        #1072#39')'
      '1102502643=         ,G.IS_NDS'
      '1102502644=         ,G.NOL_VMESTO_BEZ'
      
        '1102502645=         ,'#39#1057#1095#1077#1090' '#1085#1072' '#1086#1087#1083#1072#1090#1091' '#8470#39'||:NUM_||'#39' '#1086#1090' '#39'||EXTRACT(' +
        'DAY FROM :DATE_)||'#39' '#39'||'
      
        '1102502646=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(' +
        'EXTRACT(MONTH FROM :DATE_), 1))||'#39' '#39'||EXTRACT(YEAR FROM :DATE_)|' +
        '|'#39' '#1075'.'#39
      '1102502647=  FROM G_FIRM_REKVIZIT g'
      '1102502648=         LEFT OUTER JOIN (SELECT A.G_ACCOUNT,'
      '1102502649=                                 A.ACCOUNT,'
      '1102502650=                                 A.G_FIRM_REKVIZIT,'
      '1102502651=                                 A.G_BANK,'
      '1102502652=                                 B.BIK, B.NAME'
      '1102502653=                            FROM G_FIRM_ACCOUNT A,'
      '1102502654=                                 G_BANK B'
      '1102502655=                           WHERE A.G_BANK = B.G_BANK'
      
        '1102502656=                             AND A.IS_DEFAULT = 1) AC' +
        ' ON G.G_FIRM_REKVIZIT = AC.G_FIRM_REKVIZIT'
      
        '1102502657=         LEFT OUTER JOIN (SELECT F.g_firm_rekvizit, F' +
        '.address'
      '1102502658=                            FROM G_FIRM_ADDRESS F'
      
        '1102502659=                           WHERE F.IS_DEFAULT = 1) AD' +
        ' ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT,'
      
        '1102502660=       G_CLIENT GC LEFT OUTER JOIN (SELECT GGG.g_clie' +
        'nt, GGG.address'
      
        '1102502661=                                      FROM G_ADDRESS ' +
        'GGG'
      
        '1102502662=                                     WHERE GGG.IS_DEF' +
        'AULT = 1) ADC ON GC.G_CLIENT = ADC.G_CLIENT'
      '1102502663=    WHERE G.IS_DEFAULT = 1'
      '1102502664=      AND GC.g_client = :G_CLIENT_'
      '1102502665=   INTO :POSTAVSHIK_NAME_,'
      '1102502666=        :POSTAVSHIK_IDN_,'
      '1102502667=        :POSTAVSHIK_IDN_SELF_,'
      '1102502668=        :POSTAVSHIK_KPP_,'
      '1102502669=        :ACCOUNT_,'
      '1102502670=        :KBE_,'
      '1102502671=        :BANK_,'
      '1102502672=        :BIK_,'
      '1102502673=        :KNP_,'
      '1102502674=        :POSTAVSHIK_,'
      '1102502675=        :POKUPATEL_,'
      '1102502676=        :AGREEMENT_,'
      '1102502677=        :IS_PAY_NDS_,'
      '1102502678=        :NOL_VMESTO_NDS_,'
      '1102502679=        :NUM_;'
      '1102502680='
      
        '1102502681=  --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054#1041 +
        #1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      '1102502682=  PNT_ = '#39'05'#39';'
      '1102502683=  SELECT C.id'
      '1102502684=    FROM cur_params C'
      '1102502685=   WHERE C.cur_params = 1'
      '1102502686=  INTO :G_OFFICIAL_;'
      '1102502687='
      '1102502688=  IF (ROW_COUNT = 0) then BEGIN'
      '1102502689=      SELECT MIN(O.G_OFFICIAL)'
      '1102502690=        FROM G_OFFICIAL O'
      '1102502691=        INTO :G_OFFICIAL_;'
      '1102502692=      IF (ROW_COUNT = 0) then BEGIN'
      '1102502693=          Err_Code = -20500;'
      
        '1102502694=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057#1087 +
        #1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      
        '1102502695=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102502696=          EXIT;'
      '1102502697=      END'
      '1102502698=  END'
      '1102502699='
      '1102502700=  SELECT '#39'/'#39'||O.FIO_DOC||'#39'/'#39','
      '1102502701=         A.name'
      '1102502702=    FROM G_OFFICIAL O, G_APPOINTMENT A'
      '1102502703=   WHERE O.g_official = :G_OFFICIAL_'
      '1102502704=     AND O.G_APPOINTMENT = A.G_APPOINTMENT'
      '1102502705=    INTO :ISPOLNITEL_'
      '1102502706=         ,:ISPOLNITEL_APP_;'
      '1102502707='
      '1102502708=  SELECT '#39'/'#39'||G.FIO_DOC||'#39'/'#39','
      '1102502709=         A.NAME'
      '1102502710=    FROM G_OFFICIAL G,'
      '1102502711=         G_APPOINTMENT A'
      '1102502712=    WHERE G.IS_RUKOVODITEL = 1'
      '1102502713=    AND G.G_APPOINTMENT = A.G_APPOINTMENT'
      '1102502714=  INTO :RUKOVODITEL_,'
      '1102502715=       :RUKOVODITEL_APP_;'
      '1102502716='
      '1102502717=  -- '#1053#1048#1046#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      '1102502718=  SELECT CAST(:summ_in_ AS VARCHAR(20)),'
      
        '1102502719=         '#39#1042#1089#1077#1075#1086' '#1082' '#1086#1087#1083#1072#1090#1077': '#39'||(SELECT CURR_STR from CU' +
        'RRENCYSTR(:summ_in_, :CURRENCY_))'
      '1102502720=    FROM RDB$DATABASE'
      '1102502721=  INTO :SUMM_,'
      '1102502722=       :VSEGO_K_OPLATE_;'
      '1102502723='
      
        '1102502724=  -- '#1042#1054' '#1060#1056#1040#1047#1045' '#1042#1057#1045#1043#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1049' '#1045#1057#1058#1068' '#1042#1040#1051#1070#1058#1040', '#1055#1054#1069#1058#1054#1052#1059 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1050#1051#1054#1053#1071#1058#1068
      '1102502725=  if (CURRENCY_ = 0) then'
      '1102502726=    CURR_STR_ = '#39' '#1090#1077#1085#1075#1077#39';'
      '1102502727=  else begin'
      '1102502728=      SELECT CAST(TRUNC(:summ_in_) AS VARCHAR(20))'
      '1102502729=        FROM RDB$DATABASE'
      '1102502730=      INTO :VAL_STR_;'
      '1102502731='
      
        '1102502732=      i = cast(substring(VAL_STR_ from CHAR_LENGTH(VA' +
        'L_STR_) for 1) as int);'
      '1102502733='
      '1102502734=      if (i=1) then begin'
      '1102502735=        if (CURRENCY_ = 1) then'
      '1102502736=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1100#39';'
      '1102502737=        else'
      '1102502738=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1072#39';'
      '1102502739='
      '1102502740=      end ELSE if ((i=2) or (I=3)) then begin'
      '1102502741=        if (CURRENCY_ = 1) then'
      '1102502742=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1103#39';'
      '1102502743=        ELSE'
      '1102502744=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1099#39';'
      '1102502745=      END ELSE BEGIN'
      '1102502746=        if (CURRENCY_ = 1) then'
      '1102502747=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1077#1081#39';'
      '1102502748=        ELSE'
      '1102502749=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1077#1085#39';'
      '1102502750=      end'
      '1102502751=  end'
      '1102502752='
      
        '1102502753=  SELECT '#39#1042#1089#1077#1075#1086' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1081' '#39'||:AMOUNT_IN_||'#39', '#1085#1072' '#1089#1091 +
        #1084#1084#1091' '#39'||CAST(:SUMM_IN_ AS VARCHAR(20))||:CURR_STR_,'
      '1102502754=         DECODE(:IS_PAY_NDS_,'
      
        '1102502755=                0, DECODE(:NOL_VMESTO_NDS_, 0, '#39#1041#1077#1079' '#1053 +
        #1044#1057#39', '#39'0,00'#39'),  -- '#1055#1048#1057#1040#1058#1068' "0" '#1048#1051#1048' "'#1041#1077#1079' '#1053#1044#1057'"'
      '1102502756=                CAST(:NDS_SUMM_IN_ AS VARCHAR(20))'
      '1102502757=               )'
      '1102502758=    FROM RDB$DATABASE'
      '1102502759=  INTO :VSEGO_NAIM_,'
      '1102502760=       :NDS_;'
      '1102502761='
      
        '1102502762=  -- '#1042' '#1048#1058#1054#1043#1045' '#1042' '#1045#1050#1057#1045#1051#1045' '#1042#1057#1045' '#1062#1048#1060#1056#1067' '#1042#1067#1042#1054#1044#1071#1058#1057#1071' '#1057' '#1044#1045#1057#1071#1058#1048#1063#1053#1067 +
        #1052' '#1056#1040#1047#1044#1045#1051#1048#1058#1045#1051#1045#1052' '#1058#1054#1063#1050#1040', '#1040' '#1053#1045' '#1047#1040#1055#1071#1058#1040#1071'. '#1053#1045' '#1047#1053#1040#1051' '#1063#1058#1054' '#1055#1056#1048#1044#1059#1052#1040#1058#1068' '#1048' '#1055#1054#1058#1054 +
        #1052#1059' '#1055#1054#1057#1058#1040#1042#1048#1051' '#1058#1059#1058' '#1058#1059#1055#1054' '#1047#1040#1052#1045#1053#1059
      '1102502763=  SUMM_ = REPLACE(SUMM_, '#39'.'#39', '#39','#39');'
      '1102502764=  VSEGO_NAIM_ = REPLACE(VSEGO_NAIM_, '#39'.'#39', '#39','#39');'
      '1102502765='
      '1102502766=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      '1102502767=  I = 1;'
      '1102502768=  FOR'
      '1102502769=    SELECT :I,'
      '1102502770=           G.NAME,'
      '1102502771=           G.ARTICUL,'
      '1102502772=           ZD.AMOUNT,'
      '1102502773=           U.SHORT_NAME,'
      
        '1102502774=           REPLACE(CAST(ZD.PRICE - ZD.DISCOUNT_TENGE ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1102502775=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39'.'#39',' +
        ' '#39','#39')'
      '1102502776=      FROM ZAKAZ_DETAILS_TMP ZD,'
      '1102502777=           G_PRODUCT G,'
      '1102502778=           G_UNIT U'
      '1102502779=     WHERE ZD.G_PRODUCT = G.G_PRODUCT'
      '1102502780=       AND G.G_UNIT = U.G_UNIT'
      '1102502781=   ORDER BY G.NAME, ZD.ZAKAZ_DETAILS'
      '1102502782=    INTO :ROW_NUM,'
      '1102502783=        :NAME,'
      '1102502784=        :ARTICUL,'
      '1102502785=        :AMOUNT,'
      '1102502786=        :SHORT_NAME,'
      '1102502787=        :PRICE,'
      '1102502788=        :SUMM'
      '1102502789=  DO BEGIN'
      '1102502790=    I = I + 1;'
      '1102502791=    SUSPEND;'
      '1102502792=  END'
      '1102502793='
      '1102502794=WHEN ANY DO BEGIN'
      '1102502795=    Err_code = -20500;'
      
        '1102502796=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102502797=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102502798=  END'
      '1102502799=end'
      '1102502800=;'
      '1102502801='
      '1102502802=ALTER PROCEDURE P_REP_PRIHOD('
      '1102502803=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102502804=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102502805=  DATE_BEGIN_ DATE,'
      '1102502806=  DATE_END_ DATE,'
      '1102502807=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '1102502808=RETURNS ('
      '1102502809=  PERIOD_ VARCHAR(40),'
      
        '1102502810=  P_REP_PRIHOD_TABLE TYPE OF COLUMN P_REP_PRIHOD_TABL' +
        'E.P_REP_PRIHOD_TABLE,'
      
        '1102502811=  TOVAR_NAME TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR_' +
        'NAME,'
      '1102502812=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102502813=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102502814=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102502815=  AMOUNT TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT,'
      
        '1102502816=  POSTAVSHIK TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTAV' +
        'SHIK,'
      
        '1102502817=  SELF_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_P' +
        'RICE,'
      
        '1102502818=  SELF_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_SU' +
        'MM,'
      
        '1102502819=  SELF_PRICE_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF' +
        '_PRICE_B,'
      
        '1102502820=  SELF_SUMM_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'SUMM_B,'
      
        '1102502821=  SALE_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_P' +
        'RICE,'
      
        '1102502822=  SALE_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_SU' +
        'MM,'
      '1102502823=  IS_EXPECTED VARCHAR(3),'
      
        '1102502824=  DATE_RECEIPT TYPE OF COLUMN P_REP_PRIHOD_TABLE.DATE' +
        '_RECEIPT,'
      '1102502825=  IS_HEAD TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD,'
      '1102502826=  ERR_CODE INTEGER,'
      '1102502827=  ERR_MSG VARCHAR(1024))'
      '1102502828=AS'
      '1102502829=/*'
      '1102502830='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1102502831='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1102502832='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1102502833='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1102502834='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1102502835='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1102502836='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1102502837=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1102502838=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1102502839=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1102502840='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1102502841='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1102502842=*/'
      
        '1102502843=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD' +
        #39';'
      '1102502844=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102502845=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN P_REP_PRI' +
        'HOD_TABLE.SALE_PRICE = 0;'
      
        '1102502846=DECLARE VARIABLE SUM_SALE_PRICE_ TYPE OF COLUMN P_REP' +
        '_PRIHOD_TABLE.SALE_PRICE = 0;'
      
        '1102502847=DECLARE VARIABLE SUM_SALE_PRICE_ALL_ TYPE OF COLUMN P' +
        '_REP_PRIHOD_TABLE.SALE_PRICE = 0;'
      '1102502848=DECLARE VARIABLE SUM_NAL_ NUMERIC(15,2) = 0;'
      '1102502849=DECLARE VARIABLE SUM_BEZNAL_ NUMERIC(15,2) = 0;'
      '1102502850=DECLARE VARIABLE AMOUNT_CATEGORY_ MY_NUMERIC_5 = 0;'
      '1102502851=DECLARE VARIABLE SUM_NAL_CATEGORY_ NUMERIC(15,2) = 0;'
      
        '1102502852=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ NUMERIC(15,2) =' +
        ' 0;'
      '1102502853=DECLARE VARIABLE SUM_FACT_NAL_ALL_ NUMERIC(15,2) = 0;'
      
        '1102502854=DECLARE VARIABLE SUM_FACT_BEZNAL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      '1102502855=DECLARE VARIABLE SUM_FACT_NAL_ NUMERIC(15,2) = 0;'
      '1102502856=DECLARE VARIABLE SUM_FACT_BEZNAL_ NUMERIC(15,2) = 0;'
      '1102502857=DECLARE VARIABLE PRICE_NAL_ NUMERIC(15,2) = 0;'
      '1102502858=DECLARE VARIABLE PRICE_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '1102502859=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102502860=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      '1102502861=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1102502862=DECLARE VARIABLE AMOUNT_CATEGORY_ALL_ MY_NUMERIC_5 = ' +
        '0;'
      
        '1102502863=DECLARE VARIABLE SUM_NAL_CATEGORY_ALL_ NUMERIC(15,2) ' +
        '= 0;'
      
        '1102502864=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ALL_ NUMERIC(15,' +
        '2) = 0;'
      
        '1102502865=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '1102502866=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      '1102502867=DECLARE VARIABLE I INTEGER = 1;'
      '1102502868=DECLARE VARIABLE K INTEGER = 1;'
      
        '1102502869=DECLARE VARIABLE IS_EXPECTED_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.IS_EXPECTED;'
      
        '1102502870=DECLARE VARIABLE DATE_RECEIPT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.DATE_RECEIPT;'
      '1102502871=BEGIN'
      
        '1102502872=  DELETE FROM P_REP_PRIHOD_TABLE WHERE P_REP_PRIHOD_T' +
        'ABLE = P_REP_PRIHOD_TABLE;'
      '1102502873='
      '1102502874=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1102502875='
      
        '1102502876=  FOR SELECT DECODE(GP.g_product, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', G' +
        'P.NAME),'
      '1102502877=             GP.G_PRODUCT'
      '1102502878=       FROM G_PRODUCT GP'
      '1102502879=      WHERE GP.IS_CATEGORY = 1'
      
        '1102502880=        AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102502881=             OR'
      '1102502882=             (:G_CATEGORY_ IS NULL)'
      '1102502883=            )'
      '1102502884=        AND EXISTS (SELECT 1'
      
        '1102502885=                      FROM SKLAD_PARENT Z, SKLAD ZD, ' +
        'G_PRODUCT G'
      
        '1102502886=                     WHERE :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1102502887=                       AND Z.SKLAD =  ZD.SKLAD_PARENT'
      '1102502888=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102502889=                       AND G.G_PRODUCT_PAR = GP.G_PRO' +
        'DUCT'
      '1102502890=                       AND Z.IS_VOZVRAT = 0'
      '1102502891=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102502892=                       AND Z.DATE_RECEIPT BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      
        '1102502893=                       AND ((:G_PRODUCT_ CONTAINING '#39 +
        '~'#39'||ZD.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102502894=                             OR'
      '1102502895=                             (:G_PRODUCT_ IS NULL)'
      '1102502896=                           )'
      '1102502897=                   )'
      '1102502898=      ORDER BY 1'
      '1102502899=  INTO :RECCAT_NAME_,'
      '1102502900=       :RECCAT_PRODUCT_'
      '1102502901=  DO BEGIN'
      '1102502902=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102502903=    insert into P_REP_PRIHOD_TABLE'
      '1102502904=      (P_REP_PRIHOD_TABLE, tovar_name, IS_HEAD)'
      '1102502905=    values'
      '1102502906=      (:I, :RECCAT_NAME_, 1);'
      '1102502907='
      '1102502908=    I = I + 1;'
      '1102502909='
      '1102502910=    FOR SELECT G.NAME,'
      '1102502911=               G.BARCODE,'
      '1102502912=               G.ARTICUL,'
      '1102502913=               G.NOMENCLATUR_NUM,'
      '1102502914=               G.PRICE,'
      '1102502915=               SD.AMOUNT,'
      '1102502916=               C.NAME CLIENT_NAME,'
      
        '1102502917=               DECODE(S.G_PAYMENT_TYPE, 1, SD.PRICE, ' +
        '0) PRICE_NAL,'
      
        '1102502918=               DECODE(S.G_PAYMENT_TYPE, 1, SD.SUMM, 0' +
        ') SUMM_NAL,'
      
        '1102502919=               DECODE(S.G_PAYMENT_TYPE, 2, SD.PRICE, ' +
        '0) PRICE_BEZNAL,'
      
        '1102502920=               DECODE(S.G_PAYMENT_TYPE, 2, SD.SUMM, 0' +
        ') SUMM_BEZNAL'
      
        '1102502921=               --DECODE(S.G_PAYMENT_TYPE, 1, S.SUMM_F' +
        'ACT, 0) SUMM_FACT_NAL,'
      
        '1102502922=               --,DECODE(S.G_PAYMENT_TYPE, 2, S.SUMM_' +
        'FACT, 0) SUMM_FACT_BEZNAL'
      '1102502923=               ,S.IS_EXPECTED'
      '1102502924=               ,S.DATE_RECEIPT'
      
        '1102502925=          FROM SKLAD_PARENT S LEFT OUTER JOIN G_CLIEN' +
        'T C ON S.G_CLIENT = C.G_CLIENT,'
      '1102502926=               SKLAD SD,'
      '1102502927=               G_PRODUCT G'
      
        '1102502928=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOC' +
        'HKA||'#39'-'#39
      '1102502929=           AND S.SKLAD = SD.SKLAD_PARENT'
      '1102502930=           AND SD.G_PRODUCT = G.G_PRODUCT'
      
        '1102502931=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '1102502932=           AND S.IS_VOZVRAT = 0'
      '1102502933=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102502934=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1102502935=           AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.G_PRO' +
        'DUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102502936=                 OR'
      '1102502937=                 (:G_PRODUCT_ IS NULL)'
      '1102502938=               )'
      
        '1102502939=        ORDER BY G.G_PRODUCT_PAR, S.DATE_RECEIPT, S.S' +
        'KLAD, SD.SKLAD, G.NAME'
      '1102502940=    INTO :TOVAR_NAME_,'
      '1102502941=         :BARCODE,'
      '1102502942=         :ARTICUL,'
      '1102502943=         :NOMENCLATUR_NUM,'
      '1102502944=         :SALE_PRICE_,'
      '1102502945=         :AMOUNT_,'
      '1102502946=         :CLIENT_NAME_,'
      '1102502947=         :PRICE_NAL_,'
      '1102502948=         :SUM_NAL_,'
      '1102502949=         :PRICE_BEZNAL_,'
      '1102502950=         :SUM_BEZNAL_'
      '1102502951=         --,:SUM_FACT_NAL_,'
      '1102502952=         --,:SUM_FACT_BEZNAL_'
      '1102502953=         ,:IS_EXPECTED_'
      '1102502954=         ,:DATE_RECEIPT_'
      '1102502955=    DO BEGIN'
      
        '1102502956=      INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TA' +
        'BLE, TOVAR_NAME, BARCODE, ARTICUL, NOMENCLATUR_NUM,'
      
        '1102502957=      SALE_PRICE, SALE_SUMM, AMOUNT, POSTAVSHIK, SELF' +
        '_PRICE, SELF_SUMM, SELF_PRICE_B,'
      '1102502958=                                      SELF_SUMM_B,'
      
        '1102502959=                                      IS_EXPECTED, DA' +
        'TE_RECEIPT, IS_HEAD)'
      
        '1102502960=      VALUES (:I, :TOVAR_NAME_, :BARCODE, :ARTICUL, :' +
        'NOMENCLATUR_NUM,'
      
        '1102502961=      :SALE_PRICE_, :SALE_PRICE_ * :AMOUNT_, :AMOUNT_' +
        ', :CLIENT_NAME_, :PRICE_NAL_, :SUM_NAL_, :PRICE_BEZNAL_, :SUM_BE' +
        'ZNAL_,'
      '1102502962=      :IS_EXPECTED_, :DATE_RECEIPT_, 0);'
      '1102502963='
      '1102502964=      I = I +1;'
      '1102502965='
      
        '1102502966=      AMOUNT_CATEGORY_ = AMOUNT_CATEGORY_ + COALESCE(' +
        'AMOUNT_, 0);'
      
        '1102502967=      SUM_NAL_CATEGORY_ = SUM_NAL_CATEGORY_ + COALESC' +
        'E(SUM_NAL_, 0);'
      
        '1102502968=      SUM_BEZNAL_CATEGORY_ = SUM_BEZNAL_CATEGORY_ + C' +
        'OALESCE(SUM_BEZNAL_, 0);'
      
        '1102502969=      SUM_SALE_PRICE_ = SUM_SALE_PRICE_ + SALE_PRICE_' +
        ' * AMOUNT_;'
      '1102502970='
      '1102502971=      /*IF (K = 1) THEN BEGIN'
      
        '1102502972=          SUM_FACT_NAL_ALL_ = SUM_FACT_NAL_ALL_ + SUM' +
        '_FACT_NAL_;'
      
        '1102502973=          SUM_FACT_BEZNAL_ALL_ = SUM_FACT_BEZNAL_ALL_' +
        ' + SUM_FACT_BEZNAL_;'
      '1102502974='
      '1102502975=          K = 2;'
      '1102502976=      END*/'
      '1102502977=    END'
      '1102502978='
      '1102502979=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102502980=    INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABL' +
        'E, TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEA' +
        'D)'
      
        '1102502981=    VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :SUM_SALE_PRICE' +
        '_, :AMOUNT_CATEGORY_, :SUM_NAL_CATEGORY_, :SUM_BEZNAL_CATEGORY_,' +
        ' 2);'
      '1102502982='
      '1102502983='
      
        '1102502984=    AMOUNT_CATEGORY_ALL_ = AMOUNT_CATEGORY_ALL_ + AMO' +
        'UNT_CATEGORY_;'
      
        '1102502985=    SUM_NAL_CATEGORY_ALL_ = SUM_NAL_CATEGORY_ALL_ + S' +
        'UM_NAL_CATEGORY_;'
      
        '1102502986=    SUM_BEZNAL_CATEGORY_ALL_ = SUM_BEZNAL_CATEGORY_AL' +
        'L_ + SUM_BEZNAL_CATEGORY_;'
      
        '1102502987=    SUM_SALE_PRICE_ALL_ = SUM_SALE_PRICE_ALL_ + SUM_S' +
        'ALE_PRICE_;'
      '1102502988='
      '1102502989=    AMOUNT_CATEGORY_ = 0;'
      '1102502990=    SUM_NAL_CATEGORY_ = 0;'
      '1102502991=    SUM_BEZNAL_CATEGORY_  = 0;'
      '1102502992=    SUM_SALE_PRICE_ = 0;'
      '1102502993='
      '1102502994=    I = I + 1;'
      '1102502995=    K = 1;'
      '1102502996=  END'
      '1102502997='
      '1102502998=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '1102502999=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE,' +
        ' TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '1102503000=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUM_SALE_PRICE_ALL_, :AMOUNT_' +
        'CATEGORY_ALL_, :SUM_NAL_CATEGORY_ALL_, :SUM_BEZNAL_CATEGORY_ALL_' +
        ', 3);'
      '1102503001='
      '1102503002=  I = I + 1;'
      '1102503003='
      '1102503004=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1059#1055#1051#1040#1063#1045#1053#1054
      '1102503005=  SELECT COALESCE(SUM(K.SUMM), 0)'
      '1102503006=  FROM KASSA K,'
      '1102503007=       SKLAD_PARENT S'
      '1102503008= WHERE K.SKLAD = S.SKLAD'
      '1102503009=   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      '1102503010=   AND S.IS_VOZVRAT = 0'
      
        '1102503011=   AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1102503012=   AND EXISTS (SELECT 1'
      '1102503013=                 FROM SKLAD SD'
      '1102503014=                WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '1102503015=                 AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||S' +
        'D.G_PRODUCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102503016=                       OR'
      '1102503017=                       (:G_CATEGORY_ IS NULL)'
      '1102503018=                     )'
      
        '1102503019=                 AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD' +
        '.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102503020=                       OR'
      '1102503021=                       (:G_PRODUCT_ IS NULL)'
      '1102503022=                     )'
      '1102503023=              )'
      '1102503024=    INTO :SUM_FACT_NAL_ALL_;'
      '1102503025='
      '1102503026=  SELECT COALESCE(SUM(K.SUMM), 0)'
      '1102503027=  FROM KASSA_BEZNAL K,'
      '1102503028=       SKLAD_PARENT S'
      '1102503029= WHERE K.SKLAD = S.SKLAD'
      '1102503030=   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      '1102503031=   AND S.IS_VOZVRAT = 0'
      
        '1102503032=   AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1102503033=   AND EXISTS (SELECT 1'
      '1102503034=                 FROM SKLAD SD'
      '1102503035=                WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '1102503036=                 AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||S' +
        'D.G_PRODUCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102503037=                       OR'
      '1102503038=                       (:G_CATEGORY_ IS NULL)'
      '1102503039=                     )'
      
        '1102503040=                 AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD' +
        '.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102503041=                       OR'
      '1102503042=                       (:G_PRODUCT_ IS NULL)'
      '1102503043=                     )'
      '1102503044=              )'
      '1102503045=    INTO :SUM_FACT_BEZNAL_ALL_;'
      '1102503046='
      
        '1102503047=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE,' +
        ' TOVAR_NAME, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '1102503048=  VALUES (:I, '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077#1085#1086#39', :SUM_FACT_NAL_ALL_,' +
        ' :SUM_FACT_BEZNAL_ALL_, 1);'
      '1102503049='
      
        '1102503050=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102503051=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102503052='
      
        '1102503053=  FOR SELECT P_REP_PRIHOD_TABLE, TOVAR_NAME, BARCODE,' +
        ' ARTICUL, NOMENCLATUR_NUM,'
      
        '1102503054=             SALE_PRICE, SALE_SUMM, AMOUNT, POSTAVSHI' +
        'K, SELF_PRICE, SELF_SUMM, SELF_PRICE_B, SELF_SUMM_B,'
      
        '1102503055=             (CASE WHEN IS_EXPECTED = 1 THEN '#39#1044#1072#39' WHE' +
        'N IS_EXPECTED IS NULL THEN '#39#39' ELSE '#39#1053#1077#1090#39' END),'
      '1102503056=             DATE_RECEIPT,'
      '1102503057=             IS_HEAD'
      '1102503058=      FROM P_REP_PRIHOD_TABLE'
      
        '1102503059=      INTO :P_REP_PRIHOD_TABLE, :TOVAR_NAME, :BARCODE' +
        ', :ARTICUL, :NOMENCLATUR_NUM,'
      
        '1102503060=           :SALE_PRICE, :SALE_SUMM, :AMOUNT, :POSTAVS' +
        'HIK, :SELF_PRICE, :SELF_SUMM, :SELF_PRICE_B, :SELF_SUMM_B,'
      '1102503061=           :IS_EXPECTED,'
      '1102503062=           :DATE_RECEIPT,'
      '1102503063=           :IS_HEAD'
      '1102503064=  DO'
      '1102503065=    suspend;'
      '1102503066='
      '1102503067=WHEN ANY DO BEGIN'
      '1102503068=    Err_code = -20500;'
      
        '1102503069=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102503070=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102503071=  END'
      '1102503072=end'
      '1102503073=;'
      '1102503074='
      '1102503075=ALTER PROCEDURE P_REP_SPISANIE('
      '1102503076=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102503077=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102503078=  DATE_BEGIN_ DATE,'
      '1102503079=  DATE_END_ DATE,'
      '1102503080=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '1102503081=RETURNS ('
      '1102503082=  PERIOD_ VARCHAR(40),'
      
        '1102503083=  P_REP_PRIHOD_TABLE TYPE OF COLUMN P_REP_PRIHOD_TABL' +
        'E.P_REP_PRIHOD_TABLE,'
      
        '1102503084=  TOVAR_NAME TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR_' +
        'NAME,'
      '1102503085=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102503086=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102503087=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102503088=  AMOUNT TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT,'
      
        '1102503089=  SALE_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_P' +
        'RICE,'
      '1102503090=  PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_PRICE,'
      '1102503091=  SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_SUMM,'
      
        '1102503092=  DATE_SPIS TYPE OF COLUMN P_REP_PRIHOD_TABLE.DATE_RE' +
        'CEIPT,'
      '1102503093=  IS_HEAD TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD,'
      '1102503094=  ERR_CODE INTEGER,'
      '1102503095=  ERR_MSG VARCHAR(1024))'
      '1102503096=AS'
      '1102503097=/*'
      
        '1102503098='#1058#1040#1041#1051#1048#1062#1059' '#1045#1065#1045' '#1054#1044#1053#1059' '#1053#1045' '#1057#1058#1040#1051' '#1044#1045#1051#1040#1058#1068', '#1056#1045#1064#1048#1051' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' P' +
        '_REP_PRIHOD_TABLE'
      '1102503099=*/'
      
        '1102503100=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_SPISAN' +
        'IE'#39';'
      '1102503101=DECLARE VARIABLE PNT_ VARCHAR(5) = '#39'00'#39';'
      
        '1102503102=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN P_REP_PRI' +
        'HOD_TABLE.SALE_PRICE = 0;'
      
        '1102503103=DECLARE VARIABLE SUM_SALE_PRICE_ TYPE OF COLUMN P_REP' +
        '_PRIHOD_TABLE.SALE_PRICE = 0;'
      
        '1102503104=DECLARE VARIABLE SUM_SALE_PRICE_ALL_ TYPE OF COLUMN P' +
        '_REP_PRIHOD_TABLE.SALE_PRICE = 0;'
      '1102503105=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '1102503106=DECLARE VARIABLE AMOUNT_CATEGORY_ MY_NUMERIC_5 = 0;'
      '1102503107=DECLARE VARIABLE SUM_CATEGORY_ NUMERIC(15,2) = 0;'
      '1102503108=DECLARE VARIABLE PRICE_ NUMERIC(15,2) = 0;'
      
        '1102503109=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      '1102503110=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1102503111=DECLARE VARIABLE AMOUNT_CATEGORY_ALL_ MY_NUMERIC_5 = ' +
        '0;'
      '1102503112=DECLARE VARIABLE SUM_CATEGORY_ALL_ NUMERIC(15,2) = 0;'
      
        '1102503113=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '1102503114=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      '1102503115=DECLARE VARIABLE I INTEGER = 1;'
      
        '1102503116=DECLARE VARIABLE DATE_RECEIPT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.DATE_RECEIPT;'
      '1102503117=BEGIN'
      
        '1102503118=  DELETE FROM P_REP_PRIHOD_TABLE WHERE P_REP_PRIHOD_T' +
        'ABLE = P_REP_PRIHOD_TABLE;'
      '1102503119='
      '1102503120=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1102503121='
      
        '1102503122=  FOR SELECT DECODE(GP.g_product, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', G' +
        'P.NAME),'
      '1102503123=             GP.G_PRODUCT'
      '1102503124=       FROM G_PRODUCT GP'
      '1102503125=      WHERE GP.IS_CATEGORY = 1'
      
        '1102503126=        AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102503127=             OR'
      '1102503128=             (:G_CATEGORY_ IS NULL)'
      '1102503129=            )'
      '1102503130=        AND EXISTS (SELECT 1'
      
        '1102503131=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD,' +
        ' G_PRODUCT G'
      
        '1102503132=                     WHERE :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1102503133=                       AND Z.ZAKAZ =  ZD.ZAKAZ'
      '1102503134=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102503135=                       AND G.G_PRODUCT_PAR = GP.G_PRO' +
        'DUCT'
      '1102503136=                       AND Z.IS_SPISANIE = 1'
      '1102503137=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102503138=                       AND Z.Z_DATE BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      
        '1102503139=                       AND ((:G_PRODUCT_ CONTAINING '#39 +
        '~'#39'||ZD.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102503140=                             OR'
      '1102503141=                             (:G_PRODUCT_ IS NULL)'
      '1102503142=                           )'
      '1102503143=                   )'
      '1102503144=      ORDER BY 1'
      '1102503145=  INTO :RECCAT_NAME_,'
      '1102503146=       :RECCAT_PRODUCT_'
      '1102503147=  DO BEGIN'
      '1102503148=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102503149=    insert into P_REP_PRIHOD_TABLE'
      '1102503150=      (P_REP_PRIHOD_TABLE, tovar_name, IS_HEAD)'
      '1102503151=    values'
      '1102503152=      (:I, :RECCAT_NAME_, 1);'
      '1102503153='
      '1102503154=    I = I + 1;'
      '1102503155='
      '1102503156=    FOR SELECT G.NAME,'
      '1102503157=               G.BARCODE,'
      '1102503158=               G.ARTICUL,'
      '1102503159=               G.NOMENCLATUR_NUM,'
      '1102503160=               G.PRICE,'
      '1102503161=               ZD.AMOUNT,'
      '1102503162=               ZD.PRICE,'
      '1102503163=               ZD.SUMM,'
      '1102503164=               Z.Z_DATE'
      '1102503165=          FROM ZAKAZ Z,'
      '1102503166=               ZAKAZ_DETAILS ZD,'
      '1102503167=               G_PRODUCT G'
      
        '1102503168=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1102503169=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102503170=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102503171=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '1102503172=           AND Z.IS_SPISANIE = 1'
      '1102503173=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102503174=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102503175=           AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||ZD.G_PRO' +
        'DUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102503176=                 OR'
      '1102503177=                 (:G_PRODUCT_ IS NULL)'
      '1102503178=               )'
      
        '1102503179=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ' +
        'ZD.ZAKAZ_DETAILS, G.NAME'
      '1102503180=    INTO :TOVAR_NAME_,'
      '1102503181=         :BARCODE,'
      '1102503182=         :ARTICUL,'
      '1102503183=         :NOMENCLATUR_NUM,'
      '1102503184=         :SALE_PRICE_,'
      '1102503185=         :AMOUNT_,'
      '1102503186=         :PRICE_,'
      '1102503187=         :SUMM_,'
      '1102503188=         :DATE_RECEIPT_'
      '1102503189=    DO BEGIN'
      
        '1102503190=      INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TA' +
        'BLE, TOVAR_NAME, BARCODE, ARTICUL, NOMENCLATUR_NUM,'
      
        '1102503191=      SALE_PRICE, AMOUNT, SELF_PRICE, SELF_SUMM, DATE' +
        '_RECEIPT, IS_HEAD)'
      
        '1102503192=      VALUES (:I, :TOVAR_NAME_, :BARCODE, :ARTICUL, :' +
        'NOMENCLATUR_NUM,'
      
        '1102503193=      :SALE_PRICE_, :AMOUNT_, :PRICE_, :SUMM_, :DATE_' +
        'RECEIPT_, 0);'
      '1102503194='
      '1102503195=      I = I +1;'
      '1102503196='
      
        '1102503197=      AMOUNT_CATEGORY_ = AMOUNT_CATEGORY_ + COALESCE(' +
        'AMOUNT_, 0);'
      
        '1102503198=      SUM_CATEGORY_ = SUM_CATEGORY_ + COALESCE(SUMM_,' +
        ' 0);'
      
        '1102503199=      SUM_SALE_PRICE_ = SUM_SALE_PRICE_ + SALE_PRICE_' +
        ' * AMOUNT_;'
      '1102503200=    END'
      '1102503201='
      '1102503202=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102503203=    INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABL' +
        'E, TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, IS_HEAD)'
      
        '1102503204=    VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :SUM_SALE_PRICE' +
        '_, :AMOUNT_CATEGORY_, :SUM_CATEGORY_, 2);'
      '1102503205='
      '1102503206='
      
        '1102503207=    AMOUNT_CATEGORY_ALL_ = AMOUNT_CATEGORY_ALL_ + AMO' +
        'UNT_CATEGORY_;'
      
        '1102503208=    SUM_CATEGORY_ALL_ = SUM_CATEGORY_ALL_ + SUM_CATEG' +
        'ORY_;'
      
        '1102503209=    SUM_SALE_PRICE_ALL_ = SUM_SALE_PRICE_ALL_ + SUM_S' +
        'ALE_PRICE_;'
      '1102503210='
      '1102503211=    AMOUNT_CATEGORY_ = 0;'
      '1102503212=    SUM_CATEGORY_ = 0;'
      '1102503213=    SUM_SALE_PRICE_ = 0;'
      '1102503214='
      '1102503215=    I = I + 1;'
      '1102503216=  END'
      '1102503217='
      '1102503218=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '1102503219=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE,' +
        ' TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, IS_HEAD)'
      
        '1102503220=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUM_SALE_PRICE_ALL_, :AMOUNT_' +
        'CATEGORY_ALL_, :SUM_CATEGORY_ALL_, 3);'
      '1102503221='
      '1102503222=  I = I + 1;'
      '1102503223='
      
        '1102503224=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102503225=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102503226='
      
        '1102503227=  FOR SELECT P_REP_PRIHOD_TABLE, TOVAR_NAME, BARCODE,' +
        ' ARTICUL, NOMENCLATUR_NUM,'
      
        '1102503228=             SALE_PRICE, AMOUNT, SELF_PRICE, SELF_SUM' +
        'M,'
      '1102503229=             DATE_RECEIPT,'
      '1102503230=             IS_HEAD'
      '1102503231=      FROM P_REP_PRIHOD_TABLE'
      
        '1102503232=      INTO :P_REP_PRIHOD_TABLE, :TOVAR_NAME, :BARCODE' +
        ', :ARTICUL, :NOMENCLATUR_NUM,'
      '1102503233=           :SALE_PRICE, :AMOUNT, PRICE, SUMM,'
      '1102503234=           :DATE_SPIS,'
      '1102503235=           :IS_HEAD'
      '1102503236=  DO'
      '1102503237=    suspend;'
      '1102503238='
      '1102503239=WHEN ANY DO BEGIN'
      '1102503240=    Err_code = -20500;'
      
        '1102503241=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102503242=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102503243=  END'
      '1102503244=end'
      '1102503245=;'
      '1102503246='
      '1102503247=ALTER PROCEDURE UPD_SKLAD_TMP1('
      '1102503248=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1102503249=  OLD_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1102503250=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1102503251=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1102503252=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1102503253=  OLD_PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1102503254=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1102503255=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1102503256=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1102503257=  CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHARGE_' +
        'ROZN_PROC,'
      
        '1102503258=  OLD_CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHA' +
        'RGE_ROZN_PROC,'
      
        '1102503259=  CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARGE_O' +
        'PT_PROC,'
      
        '1102503260=  OLD_CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHAR' +
        'GE_OPT_PROC,'
      '1102503261=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1102503262=  OLD_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN' +
        ','
      '1102503263=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      '1102503264=  OLD_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1102503265=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1102503266=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0,'
      
        '1102503267=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0)'
      '1102503268=RETURNS ('
      '1102503269=  ERR_CODE INTEGER,'
      '1102503270=  ERR_MSG VARCHAR(1024))'
      '1102503271=AS'
      '1102503272=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1102503273=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102503274=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLA' +
        'D.PRICE;'
      
        '1102503275=DECLARE VARIABLE PRICE_CALC_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102503276=BEGIN'
      
        '1102503277=  -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1048#1051#1057#1071' '#1058#1054#1042#1040#1056', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040#1049#1058#1048' '#1057#1053#1054#1042#1040' '#1045#1043#1054' '#1047#1040 +
        #1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1062#1045#1053#1059' '#1054#1055#1058
      '1102503278=  PNT_ = '#39'01'#39';'
      '1102503279=  IF (G_PRODUCT_ <> OLD_G_PRODUCT_) THEN BEGIN'
      '1102503280=      /*SELECT S.PRICE'
      '1102503281=        FROM SKLAD S'
      
        '1102503282=       WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1102503283=         AND S.IS_LAST = 1'
      '1102503284=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1102503285=        INTO :LAST_SELF_PRICE_;'
      '1102503286='
      '1102503287=      PRICE_ = COALESCE(LAST_SELF_PRICE_, 0);*/'
      
        '1102503288=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2), 0)'
      '1102503289=          RETURNING_VALUES :PRICE_;'
      '1102503290='
      '1102503291=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102503292=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102503293=        EXIT;'
      '1102503294=      END'
      '1102503295=  END'
      '1102503296='
      '1102503297=  IF (PRICE_ = 0) THEN BEGIN'
      '1102503298=    CHARGE_PRICE_ROZN_ = 0;'
      '1102503299=    CHARGE_PRICE_OPT_ = 0;'
      '1102503300=  END'
      '1102503301=  ELSE BEGIN'
      
        '1102503302=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048
      
        '1102503303=      IF (CHARGE_PRICE_ROZN_ <> OLD_CHARGE_PRICE_ROZN' +
        '_ OR (PRICE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 1)) THEN'
      
        '1102503304=        PRICE_ROZN_ = PRICE_ * CHARGE_PRICE_ROZN_/100' +
        ' + PRICE_;'
      '1102503305='
      
        '1102503306=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054 +
        #1062#1045#1053#1058', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1102503307=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1053#1054' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1050#1040' '#1053 +
        #1045' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1062#1045#1053#1059' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1055#1056#1054#1062#1045#1053#1058
      
        '1102503308=      ELSE IF (PRICE_ROZN_ <> OLD_PRICE_ROZN_ OR (PRI' +
        'CE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 0) ) THEN'
      
        '1102503309=        CHARGE_PRICE_ROZN_ = ROUND((PRICE_ROZN_/PRICE' +
        '_ - 1)*100, 2);'
      '1102503310='
      
        '1102503311=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040#1062#1045#1053#1050#1040' '#1054#1055#1058' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047 +
        #1040#1050#1059#1055#1050#1048' , '#1047#1053#1040#1063#1048#1058' '#1062#1045#1053#1040' '#1054#1055#1058#1040' '#1053#1045' '#1052#1045#1053#1071#1051#1040#1057#1068', '#1041#1059#1044#1059' '#1045#1045' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1102503312=      IF (CHARGE_PRICE_OPT_ <> OLD_CHARGE_PRICE_OPT_ ' +
        'OR (PRICE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 1)) THEN'
      
        '1102503313=        PRICE_OPT_ = PRICE_ * CHARGE_PRICE_OPT_/100 +' +
        ' PRICE_;'
      '1102503314='
      
        '1102503315=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1054#1055#1058#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057 +
        #1071' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1055#1058#1040', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1102503316=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1053#1054' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1050#1040' '#1053 +
        #1045' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1062#1045#1053#1059' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1055#1056#1054#1062#1045#1053#1058
      
        '1102503317=      ELSE IF (PRICE_OPT_ <> OLD_PRICE_OPT_ OR (PRICE' +
        '_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 0)) THEN'
      
        '1102503318=        CHARGE_PRICE_OPT_ = ROUND((PRICE_OPT_/PRICE_ ' +
        '- 1)*100, 2);'
      '1102503319=  END'
      '1102503320='
      '1102503321=  UPDATE SKLAD_TMP T'
      '1102503322=  SET'
      '1102503323=    G_PRODUCT = :G_PRODUCT_,'
      '1102503324=    AMOUNT = :AMOUNT_,'
      '1102503325=    PRICE = :PRICE_,'
      '1102503326=    SUMM = :AMOUNT_ * :PRICE_,'
      '1102503327=    NDS = :NDS_,'
      '1102503328=    NDS_SUMM = :NDS_SUMM_'
      '1102503329=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '1102503330=    ,SUMM_CURRENCY  = :AMOUNT_ * :PRICE_CURRENCY_'
      '1102503331=    ,T.CHARGE_ROZN_PROC = :CHARGE_PRICE_ROZN_'
      '1102503332=    ,T.PRICE_ROZN = :PRICE_ROZN_'
      '1102503333=    ,T.CHARGE_OPT_PROC = :CHARGE_PRICE_OPT_'
      '1102503334=    ,T.PRICE_OPT = :PRICE_OPT_'
      '1102503335=  WHERE'
      '1102503336=    SKLAD = :SKLAD_;'
      '1102503337=END'
      '1102503338=;'
      '1102503339='
      '1102503340=ALTER PROCEDURE UPD_ZAKAZ_DETAILS_DSCNT_ALL('
      
        '1102503341=  DISCOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_PER' +
        'C,'
      '1102503342=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102503343=  MODE_ INTEGER = 0)'
      '1102503344=RETURNS ('
      '1102503345=  ERR_CODE INTEGER,'
      '1102503346=  ERR_MSG VARCHAR(1024))'
      '1102503347=AS'
      '1102503348=/*'
      
        '1102503349='#1055#1056#1048#1052#1045#1053#1071#1045#1058' '#1057#1050#1048#1044#1050#1059' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1042 +
        #1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1056#1040#1041#1054#1063#1045#1052' '#1052#1045#1057#1058#1045' '#1050#1040#1057#1057#1048#1056#1040
      '1102503350=MODE_ - '#1050#1040#1050#1040#1071' '#1057#1050#1048#1044#1050#1040', 0 - '#1042' '#1055#1056#1054#1062#1045#1053#1058#1040#1061', 1 - '#1042' '#1044#1045#1053#1068#1043#1040#1061
      '1102503351=*/'
      
        '1102503352=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_ZAKAZ_D' +
        'ETAILS_DSCNT_All'#39';'
      '1102503353=DECLARE VARIABLE PNT_     VARCHAR(5);'
      '1102503354=DECLARE VARIABLE SUMM_    TYPE OF COLUMN ZAKAZ.SUMM;'
      
        '1102503355=DECLARE VARIABLE DS_TENGE_   TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.DISCOUNT_TENGE;'
      
        '1102503356=DECLARE VARIABLE DS_SUMM_    TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.DISCOUNT_SUMM;'
      
        '1102503357=DECLARE VARIABLE PRICE_      TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.PRICE;'
      
        '1102503358=DECLARE VARIABLE AMOUNT_     TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT;'
      
        '1102503359=DECLARE VARIABLE ID_         TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.ZAKAZ_DETAILS;'
      '1102503360=DECLARE VARIABLE CNT_        INTEGER = 0;'
      
        '1102503361=DECLARE VARIABLE DISCOUNT_TENGE_LOC_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM = 0;'
      '1102503362=DECLARE VARIABLE I           INTEGER = 0;'
      '1102503363=DECLARE VARIABLE MINUS_      INTEGER = 0;'
      '1102503364=BEGIN'
      '1102503365='
      '1102503366=  IF (MODE_ = 0) THEN'
      '1102503367=      UPDATE ZAKAZ_DETAILS_TMP T'
      '1102503368=         SET T.DISCOUNT_PERC  = :DISCOUNT_,'
      
        '1102503369=             T.DISCOUNT_TENGE = T.PRICE * :DISCOUNT_/' +
        '100,'
      
        '1102503370=             T.DISCOUNT_SUMM  = T.AMOUNT * T.PRICE * ' +
        ':DISCOUNT_/100,'
      
        '1102503371=             T.SUMM           = T.AMOUNT * T.PRICE * ' +
        '(1 - :DISCOUNT_/100)'
      '1102503372=       WHERE T.G_PRODUCT <> -2;'
      '1102503373='
      '1102503374=  ELSE BEGIN'
      '1102503375='
      '1102503376=      SELECT SUM(ZD.PRICE * ZD.AMOUNT),'
      '1102503377=             COUNT(*)'
      '1102503378=        FROM ZAKAZ_DETAILS_TMP ZD'
      '1102503379=        INTO :SUMM_,'
      '1102503380=             :CNT_;'
      '1102503381='
      '1102503382=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1102503383=                 T.PRICE,'
      '1102503384=                 T.AMOUNT'
      '1102503385=            FROM ZAKAZ_DETAILS_TMP T'
      '1102503386=           WHERE T.G_PRODUCT <> -2'
      
        '1102503387=           ORDER BY 1     --  '#1041#1059#1044#1059' '#1048#1044#1058#1048' '#1055#1054' '#1055#1054#1056#1071#1044#1050#1059', '#1063 +
        #1058#1054#1041#1067' '#1042' '#1050#1054#1053#1062#1045' '#1054#1058#1053#1071#1058#1068' '#1048#1051#1048' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1043#1054' '#1069#1051#1045#1052#1045#1053#1058#1040
      '1102503388=            INTO :ID_,'
      '1102503389=                 :PRICE_,'
      '1102503390=                 :AMOUNT_'
      '1102503391=      DO BEGIN'
      
        '1102503392=        DS_SUMM_  = (PRICE_ * AMOUNT_)/:SUMM_ * :DISC' +
        'OUNT_TENGE_;'
      '1102503393=        DS_TENGE_ = DS_SUMM_ / AMOUNT_;'
      '1102503394='
      
        '1102503395=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1069#1051#1045#1052#1045#1053#1058', '#1058#1054' '#1057#1070#1044#1040' '#1053#1040#1044#1054' '#1055 +
        #1056#1048#1041#1040#1042#1048#1058#1068'/'#1054#1058#1053#1071#1058#1068' '#1054#1057#1058#1040#1058#1054#1050' '#1054#1050#1056#1059#1043#1051#1045#1053#1048#1071' '#1054#1058' '#1042#1057#1045#1061' '#1055#1056#1045#1044#1067#1044#1059#1065#1048#1061' '#1057#1058#1056#1054#1050
      
        '1102503396=        DISCOUNT_TENGE_LOC_ = DISCOUNT_TENGE_LOC_ + R' +
        'OUND(DS_SUMM_);'
      '1102503397=        I = I + 1;'
      '1102503398=        IF (I = CNT_) THEN BEGIN'
      
        '1102503399=          MINUS_ = DISCOUNT_TENGE_ - DISCOUNT_TENGE_L' +
        'OC_;'
      '1102503400=          DS_TENGE_ = DS_TENGE_ + MINUS_;'
      '1102503401=          DS_SUMM_  = DS_TENGE_ * AMOUNT_;'
      '1102503402=        END'
      '1102503403='
      '1102503404=        UPDATE ZAKAZ_DETAILS_TMP T'
      
        '1102503405=           SET T.DISCOUNT_PERC  = :DS_TENGE_ * 100 / ' +
        'T.PRICE,'
      '1102503406=               T.DISCOUNT_TENGE = ROUND(:DS_TENGE_),'
      '1102503407=               T.DISCOUNT_SUMM  = ROUND(:DS_SUMM_),'
      
        '1102503408=               T.SUMM           = T.AMOUNT * T.PRICE ' +
        '- ROUND(:DS_SUMM_)'
      '1102503409=         WHERE T.ZAKAZ_DETAILS = :ID_;'
      '1102503410=      END'
      '1102503411=  END'
      '1102503412=END'
      '1102503413=;'
      '1102503414='
