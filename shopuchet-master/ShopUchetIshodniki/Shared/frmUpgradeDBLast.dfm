        '1102015077=                   AND NOT (SP.IS_VOZVRAT = 3 AND SP.' +
        'IS_EXPECTED = 1)) AMOUNT_PRIHOD_SKL,'
      '1102015078=               (SELECT COALESCE(SUM(S.SUMM),0)'
      '1102015079=                  FROM SKLAD S, SKLAD_PARENT SP'
      '1102015080=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      '1102015081=                   AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102015082=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
