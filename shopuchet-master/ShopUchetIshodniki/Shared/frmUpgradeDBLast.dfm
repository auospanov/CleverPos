        'HKA||'#39'-'#39
      '1102251901=        UNION ALL'
      '1102251902=        SELECT 4 ROW,'
      
        '1102251903=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39 +
        ' '#1086#1090' '#39'||lpad(EXTRACT(DAY FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lp' +
        'ad(EXTRACT(MONTH FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(Y' +
        'EAR FROM SPP.DATE_RECEIPT) STR,'
      '1102251904=               K.SKLAD ID,'
      '1102251905=               K.ACTION_DATE OPER_DATE,'
      '1102251906=               K.SUMM SUMM_DEBET,'
      '1102251907=               NULL SUMM_CREDIT,'
      '1102251908=               K.ACTION_DATE SORT_ROW'
      
        '1102251909=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1102251910=                  from KASSA'
      
        '1102251911=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '1102251912=                union all'
      
        '1102251913=                select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1102251914=                  from kassa_beznal'
      
        '1102251915=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '1102251916=               SKLAD_PARENT SPP'
      '1102251917=         WHERE K.ZAKAZ IS NULL'
      '1102251918=           AND K.SKLAD = SPP.SKLAD'
      
        '1102251919=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1102251920=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '1102251921=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_T' +
        'OCHKA||'#39'-'#39
      '1102251922=           AND K.G_PRIHOD_RASHOD = 3'
      '1102251923=        UNION ALL'
      '1102251924=        SELECT 5 ROW,'
      '1102251925=               NULL STR,'
      '1102251926=               NULL ID,'
      '1102251927=               NULL OPER_DATE,'
      '1102251928=               NULL SUMM_DEBET,'
      '1102251929=               NULL SUMM_CREDIT,'
      
        '1102251930=               '#39'31.12.2199'#39' SORT_ROW  -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072#1103 +
        ' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '1102251931=          FROM RDB$DATABASE'
      '1102251932=        ORDER BY 7, 3, 1'
      '1102251933=        INTO :ROW,'
      '1102251934=             :STR_TEXT,'
      '1102251935=             :ID,'
      '1102251936=             :OPER_DATE,'
      '1102251937=             :SUMM_DEBET,'
      '1102251938=             :SUMM_CREDIT,'
      '1102251939=             :SORT_ROW'
      '1102251940=    DO BEGIN'
      '1102251941=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '1102251942=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '1102251943='
      '1102251944=      SUSPEND;'
      '1102251945=    END'
      '1102251946=  END'
      '1102251947='
      '1102251948=END'
      '1102251949=;'
      '1102251950='
      '1102251951=ALTER PROCEDURE P_REP_KASSIR('
      '1102251952=  DATE_BEGIN_ DATE,'
      '1102251953=  DATE_END_ DATE,'
      '1102251954=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102251955=RETURNS ('
      '1102251956=  PERIOD_ VARCHAR(40),'
      '1102251957=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '1102251958=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '1102251959=  ROWCOL INTEGER,'
      '1102251960=  Z_DATE VARCHAR(40),'
      '1102251961=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102251962=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102251963=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102251964=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102251965=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '1102251966=AS'
      '1102251967=/*'
      
        '1102251968='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071 +
        ', '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '1102251969=*/'
      '1102251970=DECLARE VARIABLE SORT_COL INTEGER;'
      '1102251971=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '1102251972=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '1102251973=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '1102251974=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102251975=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102251976=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '1102251977=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      '1102251978=BEGIN'
      
        '1102251979=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102251980=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102251981='
      '1102251982=  SELECT S."INPUT"'
      '1102251983=    FROM kassa_state S'
      '1102251984=   WHERE S.k_date = :DATE_BEGIN_'
      '1102251985=     AND S.g_tochka = :G_TOCHKA_'
      '1102251986=    INTO :IN_SUMM_;'
      '1102251987='
      '1102251988=  IF (ROW_COUNT = 0) THEN'
      '1102251989=    SELECT S."OUTPUT"'
      '1102251990=      FROM kassa_state S'
      '1102251991=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102251992=                         FROM KASSA_STATE ST'
      
        '1102251993=                        WHERE ST.k_date < :DATE_BEGIN' +
        '_'
      
        '1102251994=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1102251995=      AND S.g_tochka = :G_TOCHKA_'
      '1102251996=      INTO :IN_SUMM_;'
      '1102251997='
      '1102251998=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '1102251999='
      
        '1102252000=  /* '#1050#1054#1056#1054#1063#1045' '#1048#1047'-'#1047#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048' '#1063#1058#1054'-'#1058#1054' '#1050#1056#1048#1042#1054' '#1057' '#1044#1042#1048#1046#1045#1053 +
        #1048#1045#1052' '#1044#1045#1053#1045#1043', '#1071' '#1061#1059#1049' '#1055#1054#1049#1052#1048' '#1055#1054#1063#1045#1052#1059' '#1048' '#1048#1047'-'#1047#1040' '#1063#1045#1043#1054' '#1047#1040#1045#1041#1040#1051#1054' '#1057#1059#1050#1040
      
        '1102252001=     '#1055#1054#1058#1054#1052#1059' '#1056#1045#1064#1048#1051' '#1055#1056#1054#1057#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1057#1045' '#1054#1055#1045#1056 +
        #1040#1062#1048#1048
      '1102252002=  SELECT S."OUTPUT"'
      '1102252003=    FROM kassa_state S'
      '1102252004=   WHERE S.k_date = :DATE_END_'
      '1102252005=     AND S.g_tochka = :G_TOCHKA_'
      '1102252006=    INTO :OUT_SUMM_;'
      '1102252007='
      '1102252008=  IF (ROW_COUNT = 0) THEN'
      '1102252009=    SELECT S."OUTPUT"'
      '1102252010=      FROM kassa_state S'
      '1102252011=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102252012=                         FROM KASSA_STATE ST'
      '1102252013=                        WHERE ST.k_date < :DATE_END_'
      
        '1102252014=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1102252015=      AND S.g_tochka = :G_TOCHKA_'
      '1102252016=      INTO :OUT_SUMM_;'
      '1102252017='
      '1102252018=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '1102252019=  */'
      '1102252020='
      '1102252021=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '1102252022=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')' +
        '||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_STR'
      '1102252023=           ,Z.Z_DATE'
      '1102252024=           ,GP.ARTICUL'
      '1102252025=           ,GP.BARCODE'
      '1102252026=           ,GP.NAME'
      '1102252027=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '1102252028=           ,SUM(ZD.summ)    SUMM'
      '1102252029=      FROM ZAKAZ Z'
      '1102252030=           ,ZAKAZ_DETAILS ZD'
      '1102252031=           ,G_PRODUCT GP'
      '1102252032=     WHERE Z.is_spisanie in (0, 2)'
      '1102252033=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102252034=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102252035=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102252036=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '1102252037=       AND Z.G_TOCHKA = :G_TOCHKA_'
      
        '1102252038=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NA' +
        'ME'
      '1102252039=      INTO :date_str,'
      '1102252040=           :Z_DATE,'
      '1102252041=           :ARTICUL,'
      '1102252042=           :BARCODE,'
      '1102252043=           :NAME,'
      '1102252044=           :AMOUNT,'
      '1102252045=           :SUMM'
      '1102252046=  DO BEGIN'
      '1102252047=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1102252048=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1102252049=      VALUES (1, 1, '#39#1055#1088#1086#1076#1072#1078#1072#39');'
      '1102252050=      FIRST_ITER = 1;'
      '1102252051=    END'
      '1102252052='
      
        '1102252053=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '1102252054=      VALUES (2, 2, :DATE_STR, :z_date,  :ARTICUL, :B' +
        'ARCODE, :NAME, :AMOUNT, :SUMM);'
      '1102252055=  END'
      '1102252056='
      '1102252057=  IF (first_iter > 0) THEN BEGIN'
      
        '1102252058=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102252059=        VALUES (3, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', (SELECT SUM(K.S' +
        'UMM)'
      
        '1102252060=                                         FROM KASSA K' +
        ','
      '1102252061=                                              ZAKAZ Z'
      
        '1102252062=                                        WHERE K.G_TOC' +
        'HKA = :G_TOCHKA_'
      
        '1102252063=                                          AND K.ZAKAZ' +
        ' = Z.ZAKAZ'
      
        '1102252064=                                          AND Z.z_dat' +
        'e BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102252065=                                          AND Z.G_TOC' +
        'HKA = :G_TOCHKA_'
      
        '1102252066=                                          AND Z.is_sp' +
        'isanie in (0, 2)'
      
        '1102252067=                                          AND K.ACTIO' +
        'N_DATE = Z.Z_DATE)'
      '1102252068=               )'
      '1102252069=      RETURNING'
      '1102252070=        SUMM'
      '1102252071=      INTO'
      '1102252072=        :SUMM_PRIHOD_ALL_;'
      '1102252073='
      
        '1102252074=      SUMM_PRIHOD_ALL_ = COALESCE(SUMM_PRIHOD_ALL_, 0' +
        ');'
      '1102252075='
      
        '1102252076=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102252077=        VALUES (4, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', (SELECT SUM(' +
        'K.SUMM)'
      
        '1102252078=                                             FROM KAS' +
        'SA_BEZNAL K,'
      
        '1102252079=                                                  ZAK' +
        'AZ Z'
      
        '1102252080=                                            WHERE K.G' +
        '_TOCHKA = :G_TOCHKA_'
      
        '1102252081=                                              AND K.Z' +
        'AKAZ = Z.ZAKAZ'
      
        '1102252082=                                              AND Z.z' +
        '_date BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102252083=                                              AND Z.G' +
        '_TOCHKA = :G_TOCHKA_'
      
        '1102252084=                                              AND Z.i' +
        's_spisanie in (0, 2)'
      
        '1102252085=                                              AND K.A' +
        'CTION_DATE = Z.Z_DATE)'
      '1102252086=               );'
      '1102252087='
      
        '1102252088=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL)'
      '1102252089=      VALUES(5, 1);'
      '1102252090=  END'
      '1102252091='
      '1102252092=  -- '#1055#1056#1048#1061#1054#1044
      '1102252093=  FIRST_ITER = 0;'
      
        '1102252094=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt AS VA' +
        'RCHAR(10)) DATE_STR'
      '1102252095=           ,S.date_receipt'
      '1102252096=           ,GP.ARTICUL'
      '1102252097=           ,GP.BARCODE'
      '1102252098=           ,GP.NAME'
      '1102252099=           ,SUM(SD.AMOUNT)  AMOUNT'
      '1102252100=           ,SUM(SD.summ)    SUMM'
      '1102252101=      FROM SKLAD_PARENT S'
      '1102252102=           ,SKLAD SD'
      '1102252103=           ,G_PRODUCT GP'
      '1102252104=     WHERE S.is_vozvrat = 0'
      '1102252105=       AND S.sklad = SD.sklad_parent'
      '1102252106=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '1102252107=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102252108=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102252109=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102252110=     GROUP BY S.date_receipt, GP.articul, GP.barcode,' +
        ' GP.NAME'
      '1102252111=     INTO :date_str,'
      '1102252112=           :Z_DATE,'
      '1102252113=           :ARTICUL,'
      '1102252114=           :BARCODE,'
      '1102252115=           :NAME,'
      '1102252116=           :AMOUNT,'
      '1102252117=           :SUMM'
      '1102252118=  DO BEGIN'
      '1102252119=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1102252120=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1102252121=      VALUES (6, 1, '#39#1055#1088#1080#1093#1086#1076' '#1090#1086#1074#1072#1088#1072#39');'
      '1102252122=      FIRST_ITER = 1;'
      '1102252123=    END'
      '1102252124='
      
        '1102252125=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '1102252126=      VALUES (7, 2, :DATE_STR, :z_date,  :ARTICUL, :B' +
        'ARCODE, :NAME, :AMOUNT, :SUMM);'
      '1102252127=  END'
      '1102252128='
      '1102252129=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '1102252130=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102252131=        VALUES (8, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', COALESCE((SELEC' +
        'T SUM(K.summ)'
      
        '1102252132=                                                 FROM' +
        ' KASSA K'
      
        '1102252133=                                                WHERE' +
        ' EXISTS (SELECT 1'
      
        '1102252134=                                                     ' +
        '           FROM sklad_parent P'
      
        '1102252135=                                                     ' +
        '          WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102252136=                                                     ' +
        '            AND P.G_TOCHKA = :G_TOCHKA_'
      
        '1102252137=                                                     ' +
        '            AND P.is_vozvrat = 0'
      
        '1102252138=                                                     ' +
        '            AND P.sklad = K.SKLAD'
      
        '1102252139=                                                     ' +
        '            AND P.date_receipt = K.action_date)),0)'
      '1102252140=               )'
      '1102252141=      RETURNING'
      '1102252142=        SUMM'
      '1102252143=      INTO'
      '1102252144=        :summ_rashod_all_;'
      '1102252145='
      
        '1102252146=      summ_rashod_all_ = COALESCE(summ_rashod_all_, 0' +
        ');'
      '1102252147='
      
        '1102252148=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102252149=        VALUES (9, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', COALESCE((SE' +
        'LECT SUM(K.summ)'
      
        '1102252150=                                                     ' +
        'FROM KASSA_BEZNAL K'
      
        '1102252151=                                                    W' +
        'HERE EXISTS (SELECT 1'
      
        '1102252152=                                                     ' +
        '               FROM sklad_parent P'
      
        '1102252153=                                                     ' +
        '              WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102252154=                                                     ' +
        '                AND P.G_TOCHKA = :G_TOCHKA_'
      
        '1102252155=                                                     ' +
        '                AND P.is_vozvrat = 0'
      
        '1102252156=                                                     ' +
        '                AND P.sklad = K.SKLAD'
      
        '1102252157=                                                     ' +
        '                AND P.date_receipt = K.action_date)), 0)'
      '1102252158=               );'
      
        '1102252159=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL)'
      '1102252160=        VALUES(10, 1);'
      '1102252161=  END'
      '1102252162='
      '1102252163=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1050#1051#1048#1045#1053#1058#1054#1052
      '1102252164=  FIRST_ITER = 0;'
      
        '1102252165=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt AS VA' +
        'RCHAR(10)) DATE_STR'
      '1102252166=           ,S.date_receipt'
      '1102252167=           ,GP.ARTICUL'
      '1102252168=           ,GP.BARCODE'
      '1102252169=           ,GP.NAME'
      '1102252170=           ,SUM(SD.AMOUNT)  AMOUNT'
      '1102252171=           ,SUM(SD.summ)    SUMM'
      '1102252172=      FROM SKLAD_PARENT S'
      '1102252173=           ,SKLAD SD'
      '1102252174=           ,G_PRODUCT GP'
      '1102252175=     WHERE S.is_vozvrat = 1'
      '1102252176=       AND S.sklad = SD.sklad_parent'
      '1102252177=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '1102252178=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102252179=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102252180=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102252181=     GROUP BY S.date_receipt, GP.articul, GP.barcode,' +
        ' GP.NAME'
      '1102252182=     INTO :date_str,'
      '1102252183=           :Z_DATE,'
