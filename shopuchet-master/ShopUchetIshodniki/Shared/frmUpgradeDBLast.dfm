      '1101021092=              CATEGORY_NAME_ = '#39#39';'
      '1101021093=            END ELSE'
      
        '1101021094=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1101021095='
      '1101021096=            SELECT G_PRODUCT'
      '1101021097=              FROM G_PRODUCT G'
      '1101021098=             WHERE G.NAME = :STR_'
      '1101021099=               AND G.IS_CATEGORY = 1'
      
        '1101021100=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1101021101=                   OR'
      '1101021102=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '1101021103=              INTO G_PRODUCT_PAR_;'
      '1101021104=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1101021105=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1101021106=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1101021107=                RETURNING G_PRODUCT'
      '1101021108=                INTO :G_PRODUCT_PAR_;'
      '1101021109='
      '1101021110=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1101021111=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1101021112=        END'
      
        '1101021113=        ---------------------------------------------' +
        '---------------------'
      '1101021114='
      
        '1101021115=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1101021116=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '1101021117=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1101021118=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '1101021119=        RETURNING G_PRODUCT'
      '1101021120=        INTO :G_PRODUCT_;'
      '1101021121='
      
        '1101021122=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101021123=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_);'
      '1101021124=    end'
      '1101021125='
      
        '1101021126=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101021127=    PNT_ = '#39'03'#39';'
      '1101021128=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1101021129=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1101021130=                                       :AMOUNT_,'
      '1101021131=                                       :SELF_PRICE_,'
      
        '1101021132=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1101021133=                                       0, --nds_,'
      '1101021134=                                       0 --nds_summ_,'
      
        '1101021135=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1101021136=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1101021137=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1101021138=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1101021139=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1101021140=          EXIT;'
      '1101021141=        END'
      '1101021142=    END'
      '1101021143='
      
        '1101021144=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1101021145=    PNT_ = '#39'04'#39';'
      '1101021146=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1101021147=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1101021148=        FROM SKLAD_TMP T'
      '1101021149=        INTO :CNT_;'
      '1101021150='
      '1101021151=      if (CNT_ > 0) then BEGIN'
      '1101021152=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1101021153=          FROM SKLAD_TMP T'
      '1101021154=          INTO :SUMM_, :SUMM_UE_;'
      '1101021155='
      '1101021156=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101021157=                                DATE_RECEIPT,'
      '1101021158=                                TIME_RECEIPT,'
      '1101021159=                                G_CLIENT,'
      '1101021160=                                G_PAYMENT_TYPE,'
      '1101021161=                                OSNOVANIE,'
      '1101021162=                                NOTE,'
      '1101021163=                                SUMM,'
      '1101021164=                                SUMM_FACT,'
      '1101021165=                                SUMM_CURRENCY,'
      '1101021166=                                IS_PAYED_ALL,'
      '1101021167=                                IS_VOZVRAT,'
      '1101021168=                                G_TOCHKA)'
      '1101021169=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101021170=                CURRENT_DATE,'
      '1101021171=                CURRENT_TIME,'
      '1101021172=                :G_CLIENT_,'
      '1101021173=                1,'
      '1101021174=                NULL,  --:OSNOVANIE_,'
      '1101021175=                NULL,  -- :NOTE_,'
      '1101021176=                :SUMM_,'
      '1101021177=                :SUMM_,'
      '1101021178=                :SUMM_UE_,'
      
        '1101021179=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1101021180=                0,'
      '1101021181=                :G_TOCHKA_)'
      '1101021182=        RETURNING'
      '1101021183=          SKLAD'
      '1101021184=        INTO'
      '1101021185=          :SKLAD_PARENT_;'
      '1101021186='
      '1101021187=        PNT_ = '#39'05'#39';'
      '1101021188=        FOR SELECT SKLAD,'
      '1101021189=                   G_PRODUCT,'
      '1101021190=                   AMOUNT,'
      '1101021191=                   PRICE,'
      '1101021192=                   SUMM'
      '1101021193=                   ,PRICE_CURRENCY'
      '1101021194=                   ,SUMM_CURRENCY'
      '1101021195=              FROM SKLAD_TMP'
      '1101021196=             ORDER BY 1'
      '1101021197=              INTO :SKLAD_TMP_,'
      '1101021198=                   :RG_PRODUCT_,'
      '1101021199=                   :RAMOUNT_,'
      '1101021200=                   :RPRICE_,'
      '1101021201=                   :RSUMM_'
      '1101021202=                   ,:RPRICE_UE_'
      '1101021203=                   ,:RSUMM_UE_'
      '1101021204=        DO BEGIN'
      '1101021205='
      '1101021206=            UPDATE SKLAD SK'
      '1101021207=               SET SK.IS_LAST = 0'
      '1101021208=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101021209=               AND SK.IS_LAST = 1;'
      '1101021210='
      '1101021211=            INSERT INTO SKLAD'
      '1101021212=            ('
      '1101021213=             SKLAD,'
      '1101021214=             SKLAD_PARENT,'
      '1101021215=             DATE_RECEIPT,'
      '1101021216=             G_CLIENT,'
      '1101021217=             G_PRODUCT,'
      '1101021218=             AMOUNT,'
      '1101021219=             PRICE,'
      '1101021220=             SUMM,'
      '1101021221=             G_PAYMENT_TYPE,'
      '1101021222=             OSNOVANIE,'
      '1101021223=             NOTE,'
      '1101021224=             NDS,'
      '1101021225=             NDS_SUMM,'
      '1101021226=             IS_LAST,'
      '1101021227=             IS_VOZVRAT,'
      '1101021228=             G_TOCHKA'
      '1101021229=             ,PRICE_CURRENCY'
      '1101021230=             ,SUMM_CURRENCY'
      '1101021231=            ) VALUES ('
      '1101021232=             :SKLAD_TMP_,'
      '1101021233=             :SKLAD_PARENT_,'
      '1101021234=             CURRENT_DATE,'
      '1101021235=             :G_CLIENT_,'
      '1101021236=             :RG_PRODUCT_,'
      '1101021237=             :RAMOUNT_,'
      '1101021238=             :RPRICE_,'
      '1101021239=             :RSUMM_,'
      '1101021240=             1,       --:G_PAYMENT_TYPE_,'
      '1101021241=             NULL,    --:OSNOVANIE_,'
      '1101021242=             NULL,    --:NOTE_,'
      '1101021243=             0,       --:RNDS_,'
      '1101021244=             0,       --:RNDS_SUMM_,'
      '1101021245=             1,       --IS_LAST_'
      '1101021246=             0,        --:IS_VOZVRAT_'
      '1101021247=             :G_TOCHKA_'
      '1101021248=             ,:RPRICE_UE_'
      '1101021249=             ,:RSUMM_UE_'
      '1101021250=            );'
      '1101021251='
      
        '1101021252=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101021253=            PNT_ = '#39'06'#39';'
      '1101021254=            UPDATE LT_SKLAD_PRODUCT L'
      '1101021255=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1101021256=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101021257=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101021258='
      '1101021259=            PNT_ = '#39'06a'#39';'
      '1101021260=            IF (ROW_COUNT = 0) THEN'
      
        '1101021261=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101021262=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '1101021263=        END'
      '1101021264='
      '1101021265=        PNT_ = '#39'07'#39';'
      
        '1101021266=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101021267=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1101021268=                                :SUMM_,'
      '1101021269=                                CURRENT_DATE,'
      
        '1101021270=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1101021271=                                NULL,   --ZAKAZ_'
      '1101021272=                                :SKLAD_PARENT_,'
      '1101021273=                                1,'
      
        '1101021274=                                :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101021275=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101021276=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101021277=          EXIT;'
      '1101021278=        END'
      '1101021279='
      '1101021280=        DELETE FROM SKLAD_TMP;'
      '1101021281=      END'
      '1101021282=    END'
      '1101021283='
      
        '1101021284=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1101021285=    if (ERR_MSG_ IS NOT NULL) then'
      '1101021286=      ERR_MSG = ERR_MSG_;'
      '1101021287='
      '1101021288=WHEN ANY DO BEGIN'
      '1101021289=    Err_code = gdscode;'
      
        '1101021290=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1101021291=  END'
      '1101021292=END'
      '1101021293=;'
      
        '1101021294=UPDATE SYSTEM_SETUP SET S_VALUE = 110102 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101021295=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101021296=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101030=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '1101031=  ARTICUL_ /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '1101032=  NOMENCLATUR_NUM_ /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '1101033=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '1101034=  NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '1101035=  NAME_G_UNIT_ /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(' +
        '50),'
      
        '1101036=  PRICE_ /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      
        '1101037=  VOLUME_PRICE_ /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ' */ NUMERIC(15,2),'
      
        '1101038=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      '1101039=  SELF_PRICE_ NUMERIC(15,2),'
      '11010310=  AMOUNT_ /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      
        '11010311=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT ' +
        '*/ NUMERIC(15,2),'
      
        '11010312=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */' +
        ' VARCHAR(150),'
      
        '11010313=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300' +
        '),'
      
        '11010314=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      '11010315=  SELF_PRICE_UE_ NUMERIC(15,2),'
      
        '11010316=  KOD_TNVD_ /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VAR' +
        'CHAR(50),'
      '11010317=  CATEGORY_NAME_ VARCHAR(1000),'
      
        '11010318=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ B' +
        'LOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      '11010319=  IS_THIS_LAST_ INTEGER,'
      '11010320=  UPDATE_IF_EXIST_ INTEGER)'
      '11010321=RETURNS ('
      '11010322=  ERR_CODE INTEGER,'
      '11010323=  ERR_MSG VARCHAR(1024))'
      '11010324=AS'
      '11010325=BEGIN'
      '11010326=  SUSPEND;'
      '11010327=END'
      '11010328=;'
      '11010329='
      '11010330=ALTER PROCEDURE GET_SKLAD('
      
        '11010331=  SKLAD_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */ BIGINT' +
        ','
      '11010332=  MODE_ INTEGER)'
      '11010333=RETURNS ('
      
        '11010334=  G_PROD_NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '11010335=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_REC' +
        'EIPT */ DATE,'
      
        '11010336=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_REC' +
        'EIPT */ TIME,'
      
        '11010337=  G_CLIENT_ /* TYPE OF COLUMN SKLAD_PARENT.G_CLIENT */ ' +
        'BIGINT,'
      
        '11010338=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN SKLAD_PARENT.G_PAYM' +
        'ENT_TYPE */ BIGINT,'
      
        '11010339=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE *' +
        '/ VARCHAR(150),'
      
        '11010340=  NOTE_ /* TYPE OF COLUMN SKLAD_PARENT.NOTE */ VARCHAR(' +
        '200),'
      
        '11010341=  SUMM_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11010342=  SUMM_FACT_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT *' +
        '/ NUMERIC(15,2),'
      
        '11010343=  SUMM_CURRENCY_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_CU' +
        'RRENCY */ NUMERIC(15,2),'
      
        '11010344=  IS_PAYED_ALL_ /* TYPE OF COLUMN SKLAD_PARENT.IS_PAYED' +
        '_ALL */ INTEGER,'
      '11010345=  CNT_T_ INTEGER,'
      
        '11010346=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ BIGINT,'
      
        '11010347=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      '11010348=  HAVERIGHT_ INTEGER,'
      '11010349=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11010350=  IS_EXPECTED_ /* TYPE OF COLUMN SKLAD_PARENT.IS_EXPECT' +
        'ED */ INTEGER,'
      '11010351=  ERR_CODE INTEGER,'
      '11010352=  ERR_MSG VARCHAR(1024))'
      '11010353=AS'
      '11010354=BEGIN'
      '11010355=  SUSPEND;'
      '11010356=END'
      '11010357=;'
      '11010358='
      '11010359=ALTER PROCEDURE INS_SKLAD('
      
        '11010360=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT,'
      
        '11010361=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_REC' +
        'EIPT */ DATE,'
      
        '11010362=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_REC' +
        'EIPT */ TIME,'
      '11010363=  G_CLIENT_ /* TYPE OF COLUMN SKLAD.G_CLIENT */ BIGINT,'
      
        '11010364=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN SKLAD.G_PAYMENT_TYP' +
        'E */ BIGINT,'
      
        '11010365=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD.OSNOVANIE */ VARCH' +
        'AR(150),'
      '11010366=  NOTE_ /* TYPE OF COLUMN SKLAD.NOTE */ VARCHAR(200),'
      
        '11010367=  IS_VOZVRAT_ /* TYPE OF COLUMN SKLAD.IS_VOZVRAT */ INT' +
        'EGER,'
      
        '11010368=  SUMM_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11010369=  SUMM_FACT_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT *' +
        '/ NUMERIC(15,2),'
      
        '11010370=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ BIGINT,'
      
        '11010371=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      '11010372=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11010373=  SUMM_CURRENCY_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_CU' +
        'RRENCY */ NUMERIC(15,2) = 0,'
      
        '11010374=  IS_EXPECTED_ /* TYPE OF COLUMN SKLAD_PARENT.IS_EXPECT' +
        'ED */ INTEGER = 0)'
      '11010375=RETURNS ('
      
