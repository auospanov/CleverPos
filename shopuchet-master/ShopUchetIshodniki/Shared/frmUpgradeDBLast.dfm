        '1102492975=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057 +
        #1058#1042#1045#1053#1053#1054')'
      
        '1102492976=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102492977=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102492978='
      
        '1102492979=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056 +
        ' '#1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '1102492980=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053 +
        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1102492981=      IF (IS_VOZVRAT_ = 0) THEN'
      '1102492982=        G_PRIHOD_RASHOD_ = 2;'
      '1102492983=      ELSE'
      '1102492984=        G_PRIHOD_RASHOD_ = 3;'
      '1102492985='
      '1102492986=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102492987=            PNT_ = '#39'09'#39';'
      '1102492988=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102492989=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102492990=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102492991=            ELSE'
      
        '1102492992=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102492993='
      '1102492994=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102492995=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102492996='
      
        '1102492997=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1102492998=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1102492999=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102493000=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1102493001=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1102493002=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1102493003=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102493004=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1102493005=                                              :SKLAD_' +
        'PARENT_,'
      
        '1102493006=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1102493007=                                              :G_TOCH' +
        'KA_,'
      
        '1102493008=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102493009=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102493010='
      
        '1102493011=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102493012=            ELSE BEGIN'
      
        '1102493013=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102493014=                SELECT 1'
      '1102493015=                  FROM KASSA K'
      '1102493016=                 WHERE K.KASSA = :KASSA_'
      '1102493017=                UNION ALL'
      '1102493018=                SELECT 2'
      '1102493019=                  FROM KASSA_BEZNAL KB'
      '1102493020=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102493021=                 INTO :PAYMENT_TYPE_OLD_;'
      '1102493022='
      
        '1102493023=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102493024=                      PNT_ = '#39'010'#39';'
      
        '1102493025=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1102493026=                                                    1' +
        ',     -- ACTION_'
      
        '1102493027=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1102493028=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1102493029=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1102493030=                                                    N' +
        'ULL,   --NOTE_'
      
        '1102493031=                                                    N' +
        'ULL,  --ZAKAZ'
      
        '1102493032=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1102493033=                                                    :' +
