      '110228148=END'
      '110228149=;'
      '110228150='
      '110228151='
      
        '110228152=/*****************************************************' +
        '*************************/'
      
        '110228153=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110228154=/*****************************************************' +
        '*************************/'
      '110228155=ALTER PROCEDURE DEL_SKLAD_DETAIL('
      '110228156=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110228157=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110228158=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110228159=RETURNS ('
      '110228160=  ERR_CODE INTEGER,'
      '110228161=  ERR_MSG VARCHAR(1024))'
      '110228162=AS'
      
        '110228163=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD_DET' +
        'AIL'#39';'
      '110228164=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '110228165=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '110228166=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110228167=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '110228168=DECLARE VARIABLE IS_LAST_ TYPE OF COLUMN SKLAD.IS_LAST' +
        ';'
      
        '110228169=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110228170=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110228171=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110228172=DECLARE VARIABLE G_PRODUCT_SOSTAV_ TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT;'
      
        '110228173=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      
        '110228174=DECLARE VARIABLE IS_EXPECTED_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_EXPECTED;'
      
        '110228175=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.A' +
        'MOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071 +
        ') */'
      
        '110228176=DECLARE VARIABLE G_TOCHKA_PROVIDER_ TYPE OF COLUMN G_T' +
        'OCHKA.G_TOCHKA;'
      '110228177=BEGIN'
      '110228178=  PNT_ = '#39'01'#39';'
      '110228179=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1053#1048#1052#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110228180=  FOR SELECT S.G_PRODUCT,'
      '110228181=             S.AMOUNT,'
      '110228182=             S.IS_LAST'
      '110228183=             ,SP.IS_VOZVRAT'
      '110228184=             ,SP.G_TOCHKA'
      '110228185=             ,SP.IS_EXPECTED'
      '110228186=             ,SP.G_CLIENT'
      '110228187=        FROM SKLAD S, SKLAD_PARENT SP'
      '110228188=       WHERE SP.SKLAD = S.SKLAD_PARENT'
      '110228189=         AND S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110228190=         AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '110228191=       INTO :G_PRODUCT_,'
      '110228192=            :AMOUNT_,'
      '110228193=            :IS_LAST_'
      '110228194=            ,:IS_VOZVRAT_'
      '110228195=            ,:G_TOCHKA_'
      '110228196=            ,:IS_EXPECTED_'
      '110228197=            ,:G_TOCHKA_PROVIDER_'
      '110228198=  DO BEGIN'
      '110228199=    IF (IS_EXPECTED_ = 0) THEN'
      '110228200=        UPDATE LT_SKLAD_PRODUCT LT'
      '110228201=           SET LT.AMOUNT = LT.AMOUNT - :AMOUNT_,'
      '110228202=               LT.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110228203=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110228204=           AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110228205='
      
        '110228206=    /*IF (IS_LAST_ = 1) then    -- '#1045#1057#1051#1048' '#1057#1058#1054#1048#1058' IS_LAST,' +
        ' '#1058#1054' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1045#1043#1054' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048', '#1063#1058#1054#1041#1067' '#1053#1045' '#1058#1045#1056#1071#1058#1068' '#1055#1054#1057#1051#1045#1044 +
        #1053#1070#1070' '#1055#1054#1057#1058#1040#1042#1050#1059
      '110228207=        UPDATE SKLAD SK'
      '110228208=             SET SK.IS_LAST = 1'
      '110228209=           WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110228210=             AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110228211=                               FROM SKLAD SS'
      
        '110228212=                              WHERE SS.G_TOCHKA = :G_T' +
        'OCHKA_'
      
        '110228213=                                AND SS.G_PRODUCT = SK.' +
        'G_PRODUCT'
      
        '110228214=                                AND SS.SKLAD_PARENT <>' +
        ' :SKLAD_PARENT_'
      
        '110228215=                                AND SS.DATE_RECEIPT = ' +
        '(SELECT MAX(SSS.DATE_RECEIPT)'
      
        '110228216=                                                      ' +
        '   FROM SKLAD SSS'
      
        '110228217=                                                      ' +
        '  WHERE SSS.G_PRODUCT = SS.G_PRODUCT'
      
        '110228218=                                                      ' +
        '    AND SSS.IS_VOZVRAT in (0, 4)'
      
        '110228219=                                                      ' +
        '    AND SSS.SKLAD_PARENT <> :SKLAD_PARENT_'
      
        '110228220=                                                      ' +
        '    AND SSS.G_TOCHKA = :G_TOCHKA_));'
      '110228221=    */'
      '110228222='
      '110228223=  END'
      '110228224='
      '110228225=  PNT_ = '#39'02'#39';'
      
        '110228226=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051'. '#1042' '#1069 +
        #1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1050#1054#1051'-'#1042#1054' '#1053#1040#1044#1054' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1058#1068' '#1050#1054#1051'-'#1042#1054' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1048' '#1059#1044#1040#1051 +
        #1071#1058#1068' '#1044#1040#1053#1053#1067#1045
      '110228227=  -- '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067' LT_ZAKAZ_REAL'
      '110228228=  IF (IS_VOZVRAT_ = 2) THEN BEGIN'
      '110228229=    FOR SELECT ZD.AMOUNT,'
      '110228230=             ZD.PRICE,'
      '110228231=             LZ.ZAKAZ_NA_REAL'
      '110228232=        FROM SKLAD ZD,'
      '110228233=             LT_ZAKAZ_REAL LZ'
      '110228234=       WHERE ZD.SKLAD_PARENT = :SKLAD_PARENT_'
      '110228235=         AND ZD.SKLAD = COALESCE(:SKLAD_, ZD.SKLAD)'
      '110228236=         AND ZD.SKLAD = LZ.SKLAD'
      '110228237=       INTO :AMOUNT_,'
      '110228238=            :PRICE_,'
      '110228239=            :ZAKAZ_NA_REAL_'
      '110228240=    DO BEGIN'
      '110228241=      UPDATE ZAKAZ_NA_REAL ZRR'
      
        '110228242=         SET ZRR.AMOUNT_RETURNED = ZRR.AMOUNT_RETURNED' +
        ' - :AMOUNT_,'
      
        '110228243=             ZRR.SUMM_RETURNED = ZRR.SUMM_RETURNED - :' +
        'AMOUNT_ * :PRICE_,'
      '110228244=             ZRR.IS_PAYED_ALL = 0'
      '110228245=       WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110228246=    END'
      '110228247='
      '110228248=    IF (SKLAD_ IS NOT NULL) THEN'
      
        '110228249=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD = :SKL' +
        'AD_;'
      '110228250=    ELSE'
      
        '110228251=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD IN (SE' +
        'LECT SKLAD FROM SKLAD WHERE SKLAD_PARENT = :SKLAD_PARENT_);'
      '110228252=  END'
      
        '110228253=  -- '#1055#1056#1048#1041#1040#1042#1051#1070' '#1048#1061' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050', '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1058#1056 +
        #1040#1053#1057#1060#1045#1056' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110228254=  ELSE IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '110228255=    FOR SELECT S.G_PRODUCT,'
      '110228256=               S.AMOUNT'
      '110228257=          FROM SKLAD S'
      '110228258=         WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110228259=           AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '110228260=          INTO :G_PRODUCT_,'
      '110228261=               :AMOUNT_PRIHOD_'
      '110228262=    DO BEGIN'
      '110228263=      UPDATE LT_SKLAD_PRODUCT L'
      '110228264=         SET L.AMOUNT = L.AMOUNT + :AMOUNT_PRIHOD_,'
      '110228265=             L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110228266=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110228267=         AND L.G_TOCHKA = :G_TOCHKA_PROVIDER_;'
      '110228268=    END'
      '110228269=  END'
      '110228270='
      '110228271=  PNT_ = '#39'03'#39';'
      
        '110228272=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057 +
        #1054#1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056 +
        #1040', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '110228273=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050 +
        ' '#1055#1056#1048#1052#1045#1056#1059' '#1058#1045#1057#1058#1054' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1052#1059#1050#1048' (5 '#1064#1058') '#1048' '#1057#1040#1061#1040#1056#1040' (4 '#1064#1058'), '#1057#1054#1054#1058#1042#1045#1058#1057#1058 +
        #1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1045#1057#1058#1040' = 4'
      '110228274=  /*FOR SELECT K.G_PRODUCT'
      '110228275=        FROM SKLAD ZD,'
      '110228276=             G_PRODUCT_KIT K'
      '110228277=       WHERE ZD.G_PRODUCT = K.G_PRODUCT_ITEM'
      '110228278=         AND ZD.sklad_parent = :SKLAD_PARENT_'
      '110228279=       GROUP BY K.G_PRODUCT'
      '110228280=       INTO :G_PRODUCT_SOSTAV_'
      '110228281=  DO BEGIN'
      '110228282=    SELECT MIN(L.AMOUNT)'
      '110228283=      FROM G_PRODUCT_KIT K,'
      '110228284=           LT_SKLAD_PRODUCT L'
      '110228285=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '110228286=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '110228287=       AND L.G_TOCHKA = :G_TOCHKA_'
      '110228288=     GROUP BY K.G_PRODUCT'
      '110228289=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110228290='
      '110228291=    UPDATE LT_SKLAD_PRODUCT L'
      '110228292=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '110228293=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_;'
      '110228294=  END*/'
      '110228295='
      '110228296=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '110228297=  PNT_ = '#39'04'#39';'
      '110228298=  DELETE from SKLAD S'
      '110228299=  WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110228300=    AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD);'
      '110228301='
      '110228302=when sqlcode -530 DO'
      '110228303=  begin'
      '110228304=    ERR_CODE = -20500;'
      
        '110228305=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110228306=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110228307=  end'
      '110228308=end'
      '110228309=;'
      '110228310='
      '110228311=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '110228312=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110228313=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110228314=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110228315=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110228316=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110228317=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110228318=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110228319=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110228320=  SELF_PRICE_ NUMERIC(15,2),'
      '110228321=  AMOUNT_ MY_NUMERIC_5,'
      '110228322=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110228323=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110228324=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110228325=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110228326=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '110228327=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110228328=  CATEGORY_NAME_ VARCHAR(1000),'
      '110228329=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110228330=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110228331=  IS_THIS_LAST_ INTEGER,'
      '110228332=  UPDATE_IF_EXIST_ INTEGER,'
      '110228333=  DO_SEARCH_CATEGORY_ INTEGER,'
      '110228334=  BARCODE_IS_MAIN_ INTEGER,'
      '110228335=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110228336=RETURNS ('
      '110228337=  ERR_CODE INTEGER,'
      '110228338=  ERR_MSG VARCHAR(1024))'
      '110228339=AS'
      
        '110228340=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PR' +
        'ODUCT'#39';'
      '110228341=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110228342=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110228343=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR = NULL;'
      
        '110228344=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110228345=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110228346=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110228347=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110228348=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110228349=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110228350=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM_CURRENCY;'
      '110228351=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110228352=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110228353=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110228354=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110228355=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110228356=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110228357=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '110228358=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110228359=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '110228360=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110228361=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110228362=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110228363=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110228364=BEGIN'
      '110228365=    ERR_MSG = '#39#39';'
      '110228366=    PNT_ = '#39'00'#39';'
      '110228367='
      
        '110228368=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045 +
