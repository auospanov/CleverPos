        '_NUM,'
      '110221126=  AMOUNT TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT,'
      
        '110221127=  POSTAVSHIK TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTAVS' +
        'HIK,'
      
        '110221128=  SELF_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_PR' +
        'ICE,'
      
        '110221129=  SELF_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_SUM' +
        'M,'
      
        '110221130=  SELF_PRICE_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'PRICE_B,'
      
        '110221131=  SELF_SUMM_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_S' +
        'UMM_B,'
      
        '110221132=  SALE_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_PR' +
        'ICE,'
      
        '110221133=  SALE_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_SUM' +
        'M,'
      '110221134=  IS_HEAD TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD,'
      '110221135=  ERR_CODE INTEGER,'
      '110221136=  ERR_MSG VARCHAR(1024))'
      '110221137=AS'
      '110221138=/*'
      '110221139='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110221140='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050 +
        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110221141='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110221142='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110221143='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110221144='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110221145='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110221146=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110221147=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110221148=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110221149='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110221150='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110221151=*/'
      
        '110221152=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD'#39 +
        ';'
      '110221153=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110221154=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN P_REP_PRIH' +
        'OD_TABLE.SALE_PRICE = 0;'
      
        '110221155=DECLARE VARIABLE SUM_SALE_PRICE_ TYPE OF COLUMN P_REP_' +
        'PRIHOD_TABLE.SALE_PRICE = 0;'
      
        '110221156=DECLARE VARIABLE SUM_SALE_PRICE_ALL_ TYPE OF COLUMN P_' +
        'REP_PRIHOD_TABLE.SALE_PRICE = 0;'
      '110221157=DECLARE VARIABLE SUM_NAL_ NUMERIC(15,2) = 0;'
      '110221158=DECLARE VARIABLE SUM_BEZNAL_ NUMERIC(15,2) = 0;'
      '110221159=DECLARE VARIABLE AMOUNT_CATEGORY_ MY_NUMERIC_5 = 0;'
      '110221160=DECLARE VARIABLE SUM_NAL_CATEGORY_ NUMERIC(15,2) = 0;'
      
        '110221161=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ NUMERIC(15,2) = ' +
        '0;'
      '110221162=DECLARE VARIABLE SUM_FACT_NAL_ALL_ NUMERIC(15,2) = 0;'
      
        '110221163=DECLARE VARIABLE SUM_FACT_BEZNAL_ALL_ NUMERIC(15,2) = ' +
        '0;'
      '110221164=DECLARE VARIABLE SUM_FACT_NAL_ NUMERIC(15,2) = 0;'
      '110221165=DECLARE VARIABLE SUM_FACT_BEZNAL_ NUMERIC(15,2) = 0;'
      '110221166=DECLARE VARIABLE PRICE_NAL_ NUMERIC(15,2) = 0;'
      '110221167=DECLARE VARIABLE PRICE_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '110221168=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110221169=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      '110221170=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110221171=DECLARE VARIABLE AMOUNT_CATEGORY_ALL_ MY_NUMERIC_5 = 0' +
        ';'
      
        '110221172=DECLARE VARIABLE SUM_NAL_CATEGORY_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '110221173=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ALL_ NUMERIC(15,2' +
        ') = 0;'
      
        '110221174=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110221175=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      '110221176=DECLARE VARIABLE I INTEGER = 1;'
      '110221177=DECLARE VARIABLE K INTEGER = 1;'
      '110221178=BEGIN'
      
        '110221179=  DELETE FROM P_REP_PRIHOD_TABLE WHERE P_REP_PRIHOD_TA' +
        'BLE = P_REP_PRIHOD_TABLE;'
      '110221180='
      '110221181=  DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '110221182=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110221183='
      
        '110221184=  FOR SELECT DECODE(GP.g_product, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', GP' +
        '.NAME),'
      '110221185=             GP.G_PRODUCT'
      '110221186=       FROM G_PRODUCT GP'
      '110221187=      WHERE GP.IS_CATEGORY = 1'
      
        '110221188=        AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110221189=             OR'
      '110221190=             (:G_CATEGORY_ IS NULL)'
      '110221191=            )'
      '110221192=        AND EXISTS (SELECT 1'
      
        '110221193=                      FROM SKLAD_PARENT Z, SKLAD ZD, G' +
        '_PRODUCT G'
      
        '110221194=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110221195=                       AND Z.SKLAD =  ZD.SKLAD_PARENT'
      '110221196=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110221197=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110221198=                       AND Z.IS_VOZVRAT = 0'
      '110221199=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110221200=                       AND Z.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      
        '110221201=                       AND ((:G_PRODUCT_ CONTAINING '#39'~' +
        #39'||ZD.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110221202=                             OR'
      '110221203=                             (:G_PRODUCT_ IS NULL)'
      '110221204=                           )'
      '110221205=                   )'
      '110221206=      ORDER BY 1'
      '110221207=  INTO :RECCAT_NAME_,'
      '110221208=       :RECCAT_PRODUCT_'
      '110221209=  DO BEGIN'
      '110221210=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110221211=    insert into P_REP_PRIHOD_TABLE'
      '110221212=      (P_REP_PRIHOD_TABLE, tovar_name, IS_HEAD)'
      '110221213=    values'
      '110221214=      (:I, :RECCAT_NAME_, 1);'
      '110221215='
      '110221216=    I = I + 1;'
      '110221217='
      '110221218=    FOR SELECT G.NAME,'
      '110221219=               G.BARCODE,'
      '110221220=               G.ARTICUL,'
      '110221221=               G.NOMENCLATUR_NUM,'
      '110221222=               G.PRICE,'
      '110221223=               SD.AMOUNT,'
      '110221224=               C.NAME CLIENT_NAME,'
      
        '110221225=               DECODE(S.G_PAYMENT_TYPE, 1, SD.PRICE, 0' +
        ') PRICE_NAL,'
      
        '110221226=               DECODE(S.G_PAYMENT_TYPE, 1, SD.SUMM, 0)' +
        ' SUMM_NAL,'
      
        '110221227=               DECODE(S.G_PAYMENT_TYPE, 2, SD.PRICE, 0' +
        ') PRICE_BEZNAL,'
      
        '110221228=               DECODE(S.G_PAYMENT_TYPE, 2, SD.SUMM, 0)' +
        ' SUMM_BEZNAL'
      
        '110221229=               --DECODE(S.G_PAYMENT_TYPE, 1, S.SUMM_FA' +
        'CT, 0) SUMM_FACT_NAL,'
      
        '110221230=               --,DECODE(S.G_PAYMENT_TYPE, 2, S.SUMM_F' +
        'ACT, 0) SUMM_FACT_BEZNAL'
      
        '110221231=          FROM SKLAD_PARENT S LEFT OUTER JOIN G_CLIENT' +
        ' C ON S.G_CLIENT = C.G_CLIENT,'
      '110221232=               SKLAD SD,'
      '110221233=               G_PRODUCT G'
      
        '110221234=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110221235=           AND S.SKLAD = SD.SKLAD_PARENT'
      '110221236=           AND SD.G_PRODUCT = G.G_PRODUCT'
      
        '110221237=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '110221238=           AND S.IS_VOZVRAT = 0'
      '110221239=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110221240=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110221241=           AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.G_PROD' +
        'UCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110221242=                 OR'
      '110221243=                 (:G_PRODUCT_ IS NULL)'
      '110221244=               )'
      
        '110221245=        ORDER BY G.G_PRODUCT_PAR, S.DATE_RECEIPT, S.SK' +
        'LAD, SD.SKLAD, G.NAME'
      '110221246=    INTO :TOVAR_NAME_,'
      '110221247=         :BARCODE,'
      '110221248=         :ARTICUL,'
      '110221249=         :NOMENCLATUR_NUM,'
      '110221250=         :SALE_PRICE_,'
      '110221251=         :AMOUNT_,'
      '110221252=         :CLIENT_NAME_,'
      '110221253=         :PRICE_NAL_,'
      '110221254=         :SUM_NAL_,'
      '110221255=         :PRICE_BEZNAL_,'
      '110221256=         :SUM_BEZNAL_'
      '110221257=         --,:SUM_FACT_NAL_,'
      '110221258=         --,:SUM_FACT_BEZNAL_'
      '110221259=    DO BEGIN'
      
        '110221260=      INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TAB' +
        'LE, TOVAR_NAME, BARCODE, ARTICUL, NOMENCLATUR_NUM,'
      
        '110221261=      SALE_PRICE, SALE_SUMM, AMOUNT, POSTAVSHIK, SELF_' +
        'PRICE, SELF_SUMM, SELF_PRICE_B,'
      
        '110221262=                                      SELF_SUMM_B, IS_' +
        'HEAD)'
      
        '110221263=      VALUES (:I, :TOVAR_NAME_, :BARCODE, :ARTICUL, :N' +
        'OMENCLATUR_NUM,'
      
        '110221264=      :SALE_PRICE_, :SALE_PRICE_ * :AMOUNT_, :AMOUNT_,' +
        ' :CLIENT_NAME_, :PRICE_NAL_, :SUM_NAL_, :PRICE_BEZNAL_, :SUM_BEZ' +
        'NAL_, 0);'
      '110221265='
      '110221266=      I = I +1;'
      '110221267='
      
        '110221268=      AMOUNT_CATEGORY_ = AMOUNT_CATEGORY_ + COALESCE(A' +
        'MOUNT_, 0);'
      
        '110221269=      SUM_NAL_CATEGORY_ = SUM_NAL_CATEGORY_ + COALESCE' +
        '(SUM_NAL_, 0);'
      
        '110221270=      SUM_BEZNAL_CATEGORY_ = SUM_BEZNAL_CATEGORY_ + CO' +
        'ALESCE(SUM_BEZNAL_, 0);'
      
        '110221271=      SUM_SALE_PRICE_ = SUM_SALE_PRICE_ + SALE_PRICE_ ' +
        '* AMOUNT_;'
      '110221272='
      '110221273=      /*IF (K = 1) THEN BEGIN'
      
        '110221274=          SUM_FACT_NAL_ALL_ = SUM_FACT_NAL_ALL_ + SUM_' +
        'FACT_NAL_;'
      
        '110221275=          SUM_FACT_BEZNAL_ALL_ = SUM_FACT_BEZNAL_ALL_ ' +
        '+ SUM_FACT_BEZNAL_;'
      '110221276='
      '110221277=          K = 2;'
      '110221278=      END*/'
      '110221279=    END'
      '110221280='
      '110221281=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110221282=    INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE' +
        ', TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD' +
        ')'
      
        '110221283=    VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :SUM_SALE_PRICE_' +
        ', :AMOUNT_CATEGORY_, :SUM_NAL_CATEGORY_, :SUM_BEZNAL_CATEGORY_, ' +
        '2);'
      '110221284='
      '110221285='
      
        '110221286=    AMOUNT_CATEGORY_ALL_ = AMOUNT_CATEGORY_ALL_ + AMOU' +
        'NT_CATEGORY_;'
      
        '110221287=    SUM_NAL_CATEGORY_ALL_ = SUM_NAL_CATEGORY_ALL_ + SU' +
        'M_NAL_CATEGORY_;'
      
        '110221288=    SUM_BEZNAL_CATEGORY_ALL_ = SUM_BEZNAL_CATEGORY_ALL' +
        '_ + SUM_BEZNAL_CATEGORY_;'
      
        '110221289=    SUM_SALE_PRICE_ALL_ = SUM_SALE_PRICE_ALL_ + SUM_SA' +
        'LE_PRICE_;'
      '110221290='
      '110221291=    AMOUNT_CATEGORY_ = 0;'
      '110221292=    SUM_NAL_CATEGORY_ = 0;'
      '110221293=    SUM_BEZNAL_CATEGORY_  = 0;'
      '110221294=    SUM_SALE_PRICE_ = 0;'
      '110221295='
      '110221296=    I = I + 1;'
      '110221297=    K = 1;'
      '110221298=  END'
      '110221299='
      '110221300=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '110221301=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110221302=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUM_SALE_PRICE_ALL_, :AMOUNT_C' +
        'ATEGORY_ALL_, :SUM_NAL_CATEGORY_ALL_, :SUM_BEZNAL_CATEGORY_ALL_,' +
        ' 3);'
      '110221303='
      '110221304=  I = I + 1;'
      '110221305='
      '110221306=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1059#1055#1051#1040#1063#1045#1053#1054
      '110221307=  SELECT COALESCE(SUM(K.SUMM), 0)'
      '110221308=  FROM KASSA K,'
      '110221309=       SKLAD_PARENT S'
      '110221310= WHERE K.SKLAD = S.SKLAD'
      '110221311=   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      '110221312=   AND S.IS_VOZVRAT = 0'
      
        '110221313=   AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110221314=   AND EXISTS (SELECT 1'
      '110221315=                 FROM SKLAD SD'
      '110221316=                WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '110221317=                 AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||SD' +
        '.G_PRODUCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110221318=                       OR'
      '110221319=                       (:G_CATEGORY_ IS NULL)'
      '110221320=                     )'
      
        '110221321=                 AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.' +
        'G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110221322=                       OR'
      '110221323=                       (:G_PRODUCT_ IS NULL)'
      '110221324=                     )'
      '110221325=              )'
      '110221326=    INTO :SUM_FACT_NAL_ALL_;'
      '110221327='
      '110221328=  SELECT COALESCE(SUM(K.SUMM), 0)'
      '110221329=  FROM KASSA_BEZNAL K,'
      '110221330=       SKLAD_PARENT S'
      '110221331= WHERE K.SKLAD = S.SKLAD'
      '110221332=   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      '110221333=   AND S.IS_VOZVRAT = 0'
      
        '110221334=   AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110221335=   AND EXISTS (SELECT 1'
      '110221336=                 FROM SKLAD SD'
      '110221337=                WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '110221338=                 AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||SD' +
        '.G_PRODUCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110221339=                       OR'
      '110221340=                       (:G_CATEGORY_ IS NULL)'
      '110221341=                     )'
      
        '110221342=                 AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.' +
        'G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110221343=                       OR'
      '110221344=                       (:G_PRODUCT_ IS NULL)'
      '110221345=                     )'
      '110221346=              )'
      '110221347=    INTO :SUM_FACT_BEZNAL_ALL_;'
      '110221348='
      
        '110221349=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110221350=  VALUES (:I, '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077#1085#1086#39', :SUM_FACT_NAL_ALL_, ' +
        ':SUM_FACT_BEZNAL_ALL_, 1);'
      '110221351='
      
        '110221352=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110221353=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110221354='
      
        '110221355=  FOR SELECT P_REP_PRIHOD_TABLE, TOVAR_NAME, BARCODE, ' +
        'ARTICUL, NOMENCLATUR_NUM,'
      
        '110221356=             SALE_PRICE, SALE_SUMM, AMOUNT, POSTAVSHIK' +
        ', SELF_PRICE, SELF_SUMM, SELF_PRICE_B, SELF_SUMM_B,'
      '110221357=             IS_HEAD'
      '110221358=      FROM P_REP_PRIHOD_TABLE'
      
        '110221359=      INTO :P_REP_PRIHOD_TABLE, :TOVAR_NAME, :BARCODE,' +
        ' :ARTICUL, :NOMENCLATUR_NUM,'
      
        '110221360=           :SALE_PRICE, :SALE_SUMM, :AMOUNT, :POSTAVSH' +
        'IK, :SELF_PRICE, :SELF_SUMM, :SELF_PRICE_B, :SELF_SUMM_B, :IS_HE' +
        'AD'
      '110221361=  DO'
      '110221362=    suspend;'
      '110221363='
      '110221364=WHEN ANY DO BEGIN'
      '110221365=    Err_code = -20500;'
      
        '110221366=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110221367=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110221368=  END'
      '110221369=end'
      '110221370=;'
      '110221371='
      '110221372=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD('
      '110221373=  OBJECT_TYPE_ INTEGER,'
      '110221374=  LOAD_TYPE_ INTEGER = 0,'
      '110221375=  OPER_ INTEGER = 0)'
      '110221376=RETURNS ('
      '110221377=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '110221378=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110221379=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110221380=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110221381=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110221382=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '110221383=  CLIENT_ID TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110221384=  IDN TYPE OF COLUMN G_CLIENT.IDN,'
      '110221385=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110221386=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '110221387=  SUMM_ALL TYPE OF COLUMN ZAKAZ.SUMM,'
      '110221388=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110221389=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110221390=  SUMM_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110221391=  SUMM_SERT MY_NUMERIC,'
      '110221392=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110221393=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110221394=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110221395=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110221396=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110221397=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110221398=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110221399=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110221400=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_AP' +
        'P,'
      '110221401=  PARENT_ID TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '110221402=  ITEM_ID TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DETAILS,'
      '110221403=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110221404=  G_TOCHKA TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110221405=  RTYPE TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '110221406=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE)'
      '110221407=AS'
      '110221408=/*'
      
        '110221409=OPER_      : '#1058#1048#1055' '#1054#1055#1045#1056#1040#1062#1048#1048', 1 - '#1042#1057#1058#1040#1042#1050#1040', 2 - '#1048#1047#1052#1045#1053#1045#1053#1048#1045',' +
        ' 3 - '#1059#1044#1040#1051#1045#1053#1048#1045
      
        '110221410=LOAD_TYPE_ : '#1058#1048#1055' '#1042#1067#1043#1056#1059#1047#1050#1048'  0 - '#1054#1041#1067#1063#1053#1040#1071', 1 - '#1044#1051#1071' '#1052#1054#1041#1048#1051#1050 +
        #1048
      '110221411=*/'
      '110221412=BEGIN'
      '110221413='
      
        '110221414=-- G_PRODUCT, '#1058#1054#1051#1068#1050#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1071', '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1054#1050 +
        #1040' '#1055#1054#1057#1067#1051#1040#1058#1068' '#1042' '#1052#1054#1041#1048#1051#1050#1059' '#1053#1045' '#1041#1059#1044#1059
      '110221415=  IF (OBJECT_TYPE_ = 4) THEN BEGIN'
      '110221416=    FOR SELECT TT.ARTICUL'
      '110221417=              ,TT.BARCODE'
      '110221418=              ,TT.NOMENCLATUR_NUM'
      
        '110221419=              ,DECODE(TT.NAME, '#39#39', '#39#1041#1077#1079' '#1085#1072#1079#1074#1072#1085#1080#1103#39', TT.' +
        'NAME) NAME'
      '110221420=              ,TT.PRICE'
      '110221421=              ,TT.SYNC_EXT_APP'
      '110221422=              ,TT.G_PRODUCT_PAR'
      '110221423=              ,TT.IS_CATEGORY'
      '110221424=              ,TT.G_PRODUCT'
      '110221425=          FROM ('
      
        '110221426=                WITH RECURSIVE TREE AS (SELECT T.G_PRO' +
        'DUCT,'
      '110221427=                               T.G_PRODUCT_PAR,'
      '110221428=                               T.NAME,'
      '110221429=                               1 LVL'
      '110221430=                          FROM G_PRODUCT T'
      '110221431=                         WHERE T.G_PRODUCT_PAR IS NULL'
      '110221432=                           AND T.IS_CATEGORY = 1'
      '110221433=                           AND T.IS_ACTIVE = 1'
      '110221434=                        UNION ALL'
      '110221435=                        SELECT T.G_PRODUCT,'
      '110221436=                               T.G_PRODUCT_PAR,'
      '110221437=                               T.NAME,'
      '110221438=                               GG.LVL + 1'
      
        '110221439=                          FROM G_PRODUCT T INNER JOIN ' +
        'TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '110221440=                         WHERE T.IS_CATEGORY = 1'
      '110221441=                           AND T.IS_ACTIVE = 1'
      '110221442=                       )'
      
        '110221443=                SELECT AP.OPER, TR.G_PRODUCT, '#39#39' ARTIC' +
        'UL, '#39#39' BARCODE, '#39#39' NOMENCLATUR_NUM, TR.NAME, 0 PRICE, AP.SYNC_EX' +
        'T_APP, TR.G_PRODUCT_PAR, 1 IS_CATEGORY, TR.LVL'
      '110221444=                FROM TREE TR,'
      '110221445=                     SYNC_EXT_APP AP'
      '110221446=                WHERE TR.G_PRODUCT = AP.ID'
      '110221447=                AND AP.IS_LOADING = 1'
      '110221448=                AND AP.OBJECT_TYPE = 4'
      
        '110221449=                AND AP.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045 +
        #1053#1048#1071
      '110221450=                AND :OPER_ <> 3'
      '110221451=                UNION ALL'
      '110221452=                SELECT S.OPER'
      '110221453=                      ,P.G_PRODUCT'
      '110221454=                      ,P.ARTICUL'
      '110221455=                      ,P.BARCODE'
      '110221456=                      ,P.NOMENCLATUR_NUM'
      '110221457=                      ,P.NAME'
      '110221458=                      ,P.PRICE'
      '110221459=                      ,S.SYNC_EXT_APP'
      '110221460=                      ,P.G_PRODUCT_PAR'
      '110221461=                      ,P.IS_CATEGORY'
      '110221462=                      ,10000 LVL'
      '110221463=                 FROM SYNC_EXT_APP S'
      '110221464=                      ,G_PRODUCT P'
      '110221465=                WHERE S.IS_LOADING = 1'
      
        '110221466=                  AND ((S.IS_LOADED = 0 AND :LOAD_TYPE' +
        '_ = 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221467=                  AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221468=                  AND S.OBJECT_TYPE = 4'
      '110221469=                  AND S.ID = P.G_PRODUCT'
      '110221470=                  AND P.IS_CATEGORY = 0'
      
        '110221471=                  AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051 +
        #1045#1053#1048#1071
      '110221472=                  AND :OPER_ <> 3'
      '110221473=                UNION ALL'
      '110221474=                SELECT S.OPER'
      '110221475=                      ,S.ID G_PRODUCT'
      '110221476=                      ,'#39#39' ARTICUL'
      '110221477=                      ,'#39#39' BARCODE'
      '110221478=                      ,'#39#39' NOMENCLATUR_NUM'
      '110221479=                      ,'#39#39' NAME'
      '110221480=                      ,0PRICE'
      '110221481=                      ,S.SYNC_EXT_APP'
      '110221482=                      ,0 G_PRODUCT_PAR'
      '110221483=                      ,0 IS_CATEGORY'
      '110221484=                      ,10000 LVL'
      '110221485=                 FROM SYNC_EXT_APP S'
      '110221486=                WHERE S.IS_LOADING = 1'
      
        '110221487=                  AND ((S.IS_LOADED = 0 AND :LOAD_TYPE' +
        '_ = 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221488=                  AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221489=                  AND S.OBJECT_TYPE = 4'
      '110221490=                  AND S.OPER = 3        -- '#1059#1044#1040#1051#1045#1053#1048#1071
      '110221491=                  AND :OPER_ = 3'
      '110221492=                ORDER BY 11) TT'
      '110221493=         INTO :ARTICUL,'
      '110221494=              :BARCODE,'
      '110221495=              :NOMENCLATUR_NUM,'
      '110221496=              :TOVAR_NAME,'
      '110221497=              :PRICE,'
      '110221498=              :SYNC_EXT_APP,'
      '110221499=              :PARENT_ID,'
      '110221500=              :IS_CATEGORY,'
      '110221501=              :G_PRODUCT'
      '110221502=    DO'
      '110221503=        SUSPEND;'
      '110221504=  END'
      '110221505=  ELSE BEGIN'
      '110221506=      FOR SELECT S.OPER'
      
        '110221507=                  ,(CASE WHEN Z.REC_ID IS NOT NULL THE' +
        'N Z.REC_ID ELSE Z.ZAKAZ END) ID'
      '110221508=                  ,Z.Z_DATE'
      '110221509=                  ,Z.Z_TIME'
      '110221510=                  ,C.G_CLIENT ID'
      '110221511=                  ,C.IDN'
      '110221512=                  ,C.NAME CLIENT_NAME'
      '110221513=                  ,G.NAME SKLAD_NAME'
      '110221514=                  ,Z.SUMM SUMM_ALL'
      '110221515=                  ,Z.SUMM_CASH'
      '110221516=                  ,Z.SUMM_NONCASH'
      '110221517=                  ,Z.SUMM_BONUS'
      '110221518=                  ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110221519=                  ,P.ARTICUL'
      '110221520=                  ,P.BARCODE'
      '110221521=                  ,P.NOMENCLATUR_NUM'
      '110221522=                  ,P.NAME'
      '110221523=                  ,ZD.AMOUNT'
      '110221524=                  ,ZD.PRICE - ZD.DISCOUNT_TENGE PRICE'
      '110221525=                  ,ZD.SUMM'
      '110221526=                  ,S.SYNC_EXT_APP'
      '110221527=                  ,Z.OSNOVANIE'
      '110221528=                  ,Z.NOTE'
      '110221529=                  ,NULL PARENT_ID'
      '110221530=                  ,NULL IS_CATEGORY'
      '110221531=                  ,Z.G_TOCHKA'
      '110221532=                  ,Z.IS_SPISANIE RTYPE'
      '110221533=                  ,ZD.ZAKAZ_DETAILS  ITEM_ID'
      '110221534=                  ,ZD.G_PRODUCT'
      '110221535=                  ,ZD.COST_PRICE'
      '110221536=             FROM SYNC_EXT_APP S'
      '110221537=                  ,ZAKAZ Z'
      '110221538=                  ,ZAKAZ_DETAILS ZD'
      '110221539=                  ,G_TOCHKA G'
      '110221540=                  ,G_CLIENT C'
      '110221541=                  ,G_PRODUCT P'
      '110221542=            WHERE S.IS_LOADING = 1'
      
        '110221543=              AND ((S.IS_LOADED = 0 AND :LOAD_TYPE_ = ' +
        '0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221544=              AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221545=              AND S.OBJECT_TYPE = 1'
      '110221546=              AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110221547=              AND :OPER_ <> 3'
      '110221548=              AND S.ID = Z.ZAKAZ'
      '110221549=              AND Z.ZAKAZ = ZD.ZAKAZ'
      '110221550=              AND Z.G_TOCHKA = G.G_TOCHKA'
      '110221551=              AND Z.G_CLIENT = C.G_CLIENT'
      '110221552=              AND ZD.G_PRODUCT = P.G_PRODUCT'
      '110221553=            UNION ALL'
      '110221554=            SELECT S.OPER'
      
        '110221555=                   ,S.ID          -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1047#1040 +
        #1055#1048#1057#1068', '#1050#1054#1058#1054#1056#1040#1071' '#1055#1056#1048#1064#1051#1040' '#1057' '#1052#1054#1041#1048#1051#1050#1048', '#1058#1054' '#1042' '#1052#1054#1052#1045#1053#1058' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1057#1070#1044#1040' '#1059#1046#1045' '#1042#1057 +
        #1058#1040#1042#1051#1071#1045#1058#1057#1071' REC_ID'
      '110221556=                   ,NULL Z_DATE'
      '110221557=                   ,NULL Z_TIME'
      '110221558=                   ,NULL ID'
      '110221559=                   ,NULL IDN'
      '110221560=                   ,NULL CLIENT_NAME'
      '110221561=                   ,NULL SKLAD_NAME'
      '110221562=                   ,0 SUMM_ALL'
      '110221563=                   ,0 SUMM_CASH'
      '110221564=                   ,0 SUMM_NONCASH'
      '110221565=                   ,0 SUMM_BONUS'
      '110221566=                   ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110221567=                   ,NULL ARTICUL'
      '110221568=                   ,NULL BARCODE'
      '110221569=                   ,NULL NOMENCLATUR_NUM'
      '110221570=                   ,NULL'
      '110221571=                   ,0 AMOUNT'
      '110221572=                   ,0 PRICE'
      '110221573=                   ,0 SUMM'
      '110221574=                   ,S.SYNC_EXT_APP'
      '110221575=                   ,NULL OSNOVANIE'
      '110221576=                   ,NULL NOTE'
      '110221577=                   ,NULL PARENT_ID'
      '110221578=                   ,NULL IS_CATEGORY'
      '110221579=                   ,NULL G_TOCHKA'
      '110221580=                   ,NULL RTYPE'
      '110221581=                   ,NULL ITEM_ID'
      '110221582=                   ,NULL G_PRODUCT'
      '110221583=                   ,NULL COST_PRICE'
      '110221584=              FROM SYNC_EXT_APP S'
      '110221585=             WHERE S.IS_LOADING = 1'
      
        '110221586=               AND ((S.IS_LOADED = 0 AND :LOAD_TYPE_ =' +
        ' 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221587=               AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221588=               AND S.OBJECT_TYPE = 1'
      
        '110221589=               AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048 +
        #1071
      '110221590=               AND (:OPER_ = 3 OR :OPER_ = 0)'
      '110221591=            UNION ALL'
      '110221592=            SELECT S.OPER'
      
        '110221593=                  ,(CASE WHEN SP.REC_ID IS NOT NULL TH' +
        'EN SP.REC_ID ELSE SP.SKLAD END) ID'
      '110221594=                  ,SP.DATE_RECEIPT Z_DATE'
      '110221595=                  ,NULL Z_TIME'
      '110221596=                  ,C.G_CLIENT ID'
      '110221597=                  ,C.IDN'
      '110221598=                  ,C.NAME CLIENT_NAME'
      '110221599=                  ,G.NAME SKLAD_NAME'
      '110221600=                  ,SP.SUMM SUMM_ALL'
      
        '110221601=                  ,(SELECT SUM(KS.SUMM) FROM KASSA KS ' +
        'WHERE KS.SKLAD = SP.SKLAD) SUMM_CASH'
      
        '110221602=                  ,(SELECT SUM(KS.SUMM) FROM KASSA_BEZ' +
        'NAL KS WHERE KS.SKLAD = SP.SKLAD) SUMM_NONCASH'
      '110221603=                  ,0 SUMM_BONUS'
      '110221604=                  ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110221605=                  ,P.ARTICUL'
      '110221606=                  ,P.BARCODE'
      '110221607=                  ,P.NOMENCLATUR_NUM'
      '110221608=                  ,P.NAME'
      '110221609=                  ,SD.AMOUNT'
      '110221610=                  ,SD.PRICE'
      '110221611=                  ,SD.SUMM'
      '110221612=                  ,S.SYNC_EXT_APP'
      '110221613=                  ,SP.OSNOVANIE'
      '110221614=                  ,SP.NOTE'
      '110221615=                  ,NULL PARENT_ID'
      '110221616=                  ,NULL IS_CATEGORY'
      '110221617=                  ,SP.G_TOCHKA'
      '110221618=                  ,SP.IS_VOZVRAT RTYPE'
      '110221619=                  ,SD.SKLAD  ITEM_ID'
      '110221620=                  ,SD.G_PRODUCT'
      '110221621=                  ,NULL COST_PRICE'
      '110221622=             FROM SYNC_EXT_APP S'
      
        '110221623=                  ,SKLAD_PARENT SP LEFT OUTER JOIN G_C' +
        'LIENT C ON SP.G_CLIENT = C.G_CLIENT'
      '110221624=                  ,SKLAD SD'
      '110221625=                  ,G_TOCHKA G'
      '110221626='
      '110221627=                  ,G_PRODUCT P'
      '110221628=            WHERE S.IS_LOADING = 1'
      
        '110221629=              AND ((S.IS_LOADED = 0 AND :LOAD_TYPE_ = ' +
        '0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221630=              AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221631=              AND S.OBJECT_TYPE = 2'
      '110221632=              AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110221633=              AND :OPER_ <> 3'
      '110221634=              AND S.ID = SP.SKLAD'
      '110221635=              AND SP.SKLAD = SD.SKLAD_PARENT'
      '110221636=              AND SP.G_TOCHKA = G.G_TOCHKA'
      '110221637='
      '110221638=              AND SD.G_PRODUCT = P.G_PRODUCT'
      '110221639=            UNION ALL'
      '110221640=            SELECT S.OPER'
      
        '110221641=                   ,S.ID            -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' ' +
        #1047#1040#1055#1048#1057#1068', '#1050#1054#1058#1054#1056#1040#1071' '#1055#1056#1048#1064#1051#1040' '#1057' '#1052#1054#1041#1048#1051#1050#1048', '#1058#1054' '#1042' '#1052#1054#1052#1045#1053#1058' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1057#1070#1044#1040' '#1059#1046#1045' ' +
        #1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' REC_ID'
      '110221642=                   ,NULL Z_DATE'
      '110221643=                   ,NULL Z_TIME'
      '110221644=                   ,NULL ID'
      '110221645=                   ,NULL IDN'
      '110221646=                   ,NULL CLIENT_NAME'
      '110221647=                   ,NULL SKLAD_NAME'
      '110221648=                   ,0 SUMM_ALL'
      '110221649=                   ,0 SUMM_CASH'
      '110221650=                   ,0 SUMM_NONCASH'
      '110221651=                   ,0 SUMM_BONUS'
      '110221652=                   ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110221653=                   ,NULL ARTICUL'
      '110221654=                   ,NULL BARCODE'
      '110221655=                   ,NULL NOMENCLATUR_NUM'
      '110221656=                   ,NULL'
      '110221657=                   ,0 AMOUNT'
      '110221658=                   ,0 PRICE'
      '110221659=                   ,0 SUMM'
      '110221660=                   ,S.SYNC_EXT_APP'
      '110221661=                   ,NULL OSNOVANIE'
      '110221662=                   ,NULL NOTE'
      '110221663=                   ,NULL PARENT_ID'
      '110221664=                   ,NULL IS_CATEGORY'
      '110221665=                   ,NULL G_TOCHKA'
      '110221666=                   ,NULL RTYPE'
      '110221667=                   ,NULL ITEM_ID'
      '110221668=                   ,NULL G_PRODUCT'
      '110221669=                   ,NULL COST_PRICE'
      '110221670=              FROM SYNC_EXT_APP S'
      '110221671=             WHERE S.IS_LOADING = 1'
      
        '110221672=               AND ((S.IS_LOADED = 0 AND :LOAD_TYPE_ =' +
        ' 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221673=               AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221674=               AND S.OBJECT_TYPE = 2'
      
        '110221675=               AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048 +
        #1071
      '110221676=               AND (:OPER_ = 3 OR :OPER_ = 0)'
      '110221677='
      '110221678=             -- G_TOCHKA'
      '110221679=             UNION ALL'
      '110221680=             SELECT S.OPER'
      '110221681=                  ,G.G_TOCHKA ID'
      '110221682=                  ,NULL Z_DATE'
      '110221683=                  ,NULL Z_TIME'
      '110221684=                  ,NULL ID'
      '110221685=                  ,'#39#39
      '110221686=                  ,'#39#39' CLIENT_NAME'
      '110221687=                  ,'#39#39' SKLAD_NAME'
