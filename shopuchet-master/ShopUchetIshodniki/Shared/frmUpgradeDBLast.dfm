      '110752262=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110752263=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '110752264=                    PNT_ = '#39'10'#39';'
      
        '110752265=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
