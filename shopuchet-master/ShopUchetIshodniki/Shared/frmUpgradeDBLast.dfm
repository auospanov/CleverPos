        '110751386=       SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE(:' +
        'DEBET_, 0),'
      
        '110751387=           K.CREDIT = COALESCE(K.CREDIT, 0) + COALESCE' +
        '(:CREDIT_, 0),'
      
        '110751388=           K.OUTPUT = COALESCE(K.INPUT, 0) - (COALESCE' +
        '(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) + ' +
        'COALESCE(:CREDIT_, 0))'
      '110751389=     WHERE K.K_DATE = :ACTION_DATE_;'
      '110751390='
      
        '110751391=    IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' ' +
        #1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '110751392=      -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '110751393=      PNT_ = '#39'03A'#39';'
      '110751394=      BEGIN'
      '110751395=        SELECT K.OUTPUT'
      '110751396=          FROM KASSA_BEZNAL_STATE K'
      '110751397=         WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '110751398=                             FROM KASSA_BEZNAL_STATE S'
      
        '110751399=                            WHERE S.K_DATE < :ACTION_D' +
