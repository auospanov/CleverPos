      '11024216=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11024217=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11024218=  CATEGORY_NAME_ VARCHAR(1000),'
      '11024219=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11024220=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11024221=  DOP_BARCODE_ VARCHAR(1000),'
      '11024222=  IS_THIS_LAST_ INTEGER,'
      '11024223=  UPDATE_IF_EXIST_ INTEGER,'
      '11024224=  DO_SEARCH_CATEGORY_ INTEGER,'
      '11024225=  BARCODE_IS_MAIN_ INTEGER,'
      '11024226=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '11024227=RETURNS ('
      '11024228=  ERR_CODE INTEGER,'
      '11024229=  ERR_MSG VARCHAR(1024))'
      '11024230=AS'
      '11024231=/*'
      '11024232=26.09.2022'
      '11024233='#1044#1054#1041#1040#1042#1051#1045#1053#1040' '#1042#1054#1047#1052#1054#1046#1053#1054#1057#1058#1068' '#1043#1056#1059#1047#1048#1058#1068' '#1044#1054#1055' '#1064#1056#1048#1061#1050#1054#1044#1040
      '11024234=*/'
      
        '11024235=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11024236=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11024237=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11024238=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR = NULL;'
      
        '11024239=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11024240=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11024241=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11024242=DECLARE VARIABLE G_PRODUCT_DOP_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT = 0;'
      
        '11024243=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11024244=DECLARE VARIABLE G_PRODUCT_NAME_DOP_ TYPE OF COLUMN G_P' +
        'RODUCT.NAME;'
      
