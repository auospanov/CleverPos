        #1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101323345=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040 +
        #1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '1101323346=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055 +
        #1054' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1101323347=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101323348=                SELECT K.KASSA'
      '1101323349=                FROM KASSA K'
      '1101323350=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101323351=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101323352=                 INTO :KASSA_POP_;'
      '1101323353=            ELSE'
      '1101323354=                SELECT K.KASSA_BEZNAL'
      '1101323355=                FROM KASSA_BEZNAL K'
      '1101323356=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101323357=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101323358=                 INTO :KASSA_POP_;'
      '1101323359='
      
        '1101323360=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101323361=              PNT_ = '#39'09'#39';'
      
        '1101323362=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' ' +
        #1054#1053#1040' '#1045#1057#1058#1068
      '1101323363=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '1101323364=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
