      '11067324=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '11067325=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT_' +
        'TYPE_ = 1)) THEN BEGIN'
      '11067326=      PNT_ = '#39'01'#39';'
      
        '11067327=      -- '#1045#1057#1051#1048' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040', '#1058#1054' '#1059#1044#1040#1051#1071#1070' '#1057#1058#1040#1056#1059#1070' '#1047#1040#1055#1048#1057#1068' ' +
        #1048' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1047#1040' '#1053#1054#1042#1059#1070' '#1044#1040#1058#1059
      '11067328=      SELECT L.ACTION_DATE,'
      '11067329=             L.SUMM,'
      '11067330=             L.G_TOCHKA'
      '11067331=        FROM KASSA L'
      '11067332=       WHERE L.KASSA = :KASSA_'
      '11067333=        INTO :ACTION_DATE_OLD_,'
      '11067334=             :SUMM_OLD_,'
      '11067335=             :G_TOCHKA_;'
      '11067336='
      
        '11067337=      IF ((SUMM_OLD_ <> SUMM_) or (ACTION_DATE_OLD_ <> ' +
        'ACTION_DATE_)) THEN BEGIN'
      
        '11067338=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_PAY' +
        'MENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11067339=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11067340=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11067341=            EXIT;'
      '11067342=          END'
      '11067343='
      '11067344=          PNT_ = '#39'02'#39';'
      '11067345=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '11067346=                                        :G_PRIHOD_RASHO' +
        'D_,'
      '11067347=                                        :SUMM_,'
      '11067348=                                        :ACTION_DATE_,'
      '11067349=                                        :NOTE_,'
      '11067350=                                        :ZAKAZ_,'
      '11067351=                                        :SKLAD_,'
      
        '11067352=                                        :G_PAYMENT_TYPE' +
        '_,'
      '11067353=                                        :G_TOCHKA_,'
      '11067354=                                        :G_OFFICIAL_'
      
        '11067355=                                        ) RETURNING_VAL' +
        'UES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '11067356=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11067357=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11067358=            EXIT;'
      '11067359=          END'
      '11067360='
      
        '11067361=          -- '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1053#1045' '#1041#1067#1051#1054' '#1055#1056#1054#1041#1051#1045#1052' '#1042' '#1042#1067 +
        #1047#1067#1042#1040#1070#1065#1045#1049' '#1055#1056#1054#1062#1045#1044#1059#1056#1045', '#1048#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1052#1045#1053#1071#1070' '#1053#1054#1042#1067#1049' ID '#1050#1040#1057#1057#1067' '#1053#1040' '#1057#1058#1040 +
        #1056#1067#1049','
      
        '11067362=          -- '#1042#1045#1044#1068' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1042#1067#1047#1067#1042#1040#1051#1057#1071' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1056#1040#1047#1059#1052#1045#1042#1040 +
        #1045#1058#1057#1071' '#1063#1058#1054' ID '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071
      '11067363=          UPDATE KASSA SS'
      '11067364=             SET SS.KASSA = :KASSA_'
      '11067365=           WHERE SS.KASSA = :KASSA_NEW_;'
      '11067366='
      
        '11067367=          EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE' +
