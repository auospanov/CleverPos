      '110158110=      END'
      '110158111=    END'
      '110158112='
      '110158113=  SELECT MINVALUE(1, LT.AMOUNT)'
      '110158114=    FROM LT_SKLAD_PRODUCT LT'
      '110158115=   WHERE LT.G_PRODUCT = :G_PRODUCT_'
      
        '110158116=     AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      '110158117=    INTO :AMOUNT_;'
      '110158118='
      
        '110158119=  /*END ELSE if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) the' +
        'n BEGIN'
      '110158120=    SELECT T.G_PRODUCT_PAR,'
      '110158121=        T.G_PRODUCT,'
      '110158122=        T.PRICE,'
      '110158123=        T.VOLUME_PRICE'
      '110158124=    FROM G_PRODUCT T'
