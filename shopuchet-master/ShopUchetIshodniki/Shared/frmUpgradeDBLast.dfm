      '1102230='
      '1102231=ALTER PROCEDURE G_GET_G_PRODUCT('
      
        '1102232=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT,'
      '1102233=  MODE_ INTEGER = 0)'
      '1102234=RETURNS ('
      
        '1102235=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR */ BIGINT,'
      '1102236=  ARTICUL_ VARCHAR(30),'
      '1102237=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1102238=  BARCODE_ VARCHAR(30),'
      '1102239=  NAME_ VARCHAR(500),'
      '11022310=  G_UNIT_ /* TYPE OF COLUMN G_UNIT.G_UNIT */ BIGINT,'
      '11022311=  PRICE_ NUMERIC(15,2),'
      '11022312=  VOLUME_PRICE_ NUMERIC(15,2),'
      
        '11022313=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT ' +
        '*/ NUMERIC(15,2),'
      
        '11022314=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */' +
        ' VARCHAR(150),'
      
        '11022315=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300' +
        '),'
      
        '11022316=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ B' +
        'LOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '11022317=  IS_KIT_ /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER' +
        ','
      
        '11022318=  MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT */' +
        ' NUMERIC(15,2),'
      
        '11022319=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      
        '11022320=  SALES_COMM_ /* TYPE OF COLUMN G_PRODUCT.SALES_COMM */' +
        ' NUMERIC(15,2),'
      
        '11022321=  KOD_TNVD_ /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VAR' +
        'CHAR(50),'
      
        '11022322=  FAST_TOVAR_ /* TYPE OF COLUMN G_PRODUCT.FAST_TOVAR */' +
        ' INTEGER,'
      
        '11022323=  DO_NOT_SHOW_RMK_ /* TYPE OF COLUMN G_PRODUCT.DO_NOT_S' +
        'HOW_RMK */ INTEGER,'
      
        '11022324=  DO_NOT_CHARGE_BONUS_ /* TYPE OF COLUMN G_PRODUCT.DO_N' +
        'OT_CHARGE_BONUS */ INTEGER,'
      
        '11022325=  LAST_PRICE_ /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUME' +
        'RIC(15,2),'
      
        '11022326=  IS_MARKED_ /* TYPE OF COLUMN G_PRODUCT.IS_MARKED */ S' +
        'MALLINT,'
      
        '11022327=  BRAND_ /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(1' +
        '50),'
      
        '11022328=  IS_WEIGHT_ /* TYPE OF COLUMN G_PRODUCT.IS_WEIGHT */ S' +
        'MALLINT,'
      
