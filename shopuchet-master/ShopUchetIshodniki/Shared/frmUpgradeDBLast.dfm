      '110243653=END'
      '110243654=;'
      '110243655='
      '110243656=ALTER PROCEDURE G_READ_G_DISCOUNT_LIST('
      '110243657=  IS_ALL_ INTEGER)'
      '110243658=RETURNS ('
      '110243659=  G_DISCOUNT TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '110243660=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110243661=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110243662=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110243663=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110243664=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110243665=  G_PRODUCT_PAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110243666=  DATE_BEGIN DATE,'
      '110243667=  DATE_END DATE,'
      '110243668=  NAME VARCHAR(1024),'
      '110243669=  PRICE NUMERIC(15,2),'
      '110243670=  SKIDKA_PROC NUMERIC(15,2),'
      '110243671=  SKIDKA_SUM NUMERIC(15,2),'
      '110243672=  IS_CONST INTEGER,'
      '110243673=  TOCHKA_NAME TYPE OF COLUMN G_TOCHKA.NAME)'
      '110243674=AS'
      '110243675=BEGIN'
      '110243676='
      '110243677=    FOR'
      
        '110243678=      SELECT GD.G_DISCOUNT, GD.G_PRODUCT, GP.NAME, GP.' +
        'ARTICUL, GP.BARCODE, GP.NOMENCLATUR_NUM,'
      '110243679=             GD.DATE_BEGIN,'
      '110243680=             GD.DATE_END,'
      
        '110243681=             CASE WHEN GD.DATE_END IS NULL THEN 1 ELSE' +
        ' 0 END IS_CONST,'
      
        '110243682=             GD.NAME, GD.PRICE, GD.SKIDKA_PROC, GD.SKI' +
        'DKA_SUM,'
      
        '110243683=             CASE WHEN GD.G_TOCHKA IS NULL THEN '#39#1042#1089#1077' '#1090 +
        #1086#1095#1082#1080#39' ELSE T.NAME END'
      '110243684=             ,PAR.NAME'
      
        '110243685=      FROM G_DISCOUNT GD LEFT OUTER JOIN G_TOCHKA T ON' +
        ' GD.G_TOCHKA = T.G_TOCHKA,'
      '110243686=           G_PRODUCT GP,'
      '110243687=           G_PRODUCT PAR'
      
        '110243688=      WHERE ((GD.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2) AND GD.G_TOCHKA IS NOT NULL)'
      '110243689=             OR'
      '110243690=             GD.G_TOCHKA IS NULL'
      '110243691=            )'
      '110243692=        AND GD.G_PRODUCT = GP.G_PRODUCT'
      '110243693=        AND GP.G_PRODUCT_PAR = PAR.G_PRODUCT'
      '110243694=        AND ('
      '110243695=             (('
      '110243696=                ('
      
        '110243697=                  /*GD.DATE_BEGIN <= CURRENT_DATE     ' +
        '  -- '#1042#1067#1043#1056#1059#1046#1040#1070#1058#1057#1071' '#1057' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1052' '#1055#1045#1056#1048#1054#1044#1054#1052
      '110243698=                  AND'
      '110243699=                  */GD.DATE_END >= CURRENT_DATE'
      '110243700=                  AND GD.DATE_BEGIN IS NOT NULL'
      '110243701=                  AND GD.DATE_END IS NOT NULL'
      '110243702=                )'
      '110243703=              OR'
      '110243704=                ('
      
        '110243705=                 GD.DATE_BEGIN IS NULL AND GD.DATE_END' +
        ' IS NULL  -- '#1040' '#1058#1040#1050#1046#1045' '#1055#1054#1057#1058#1054#1071#1053#1053#1067#1045' '#1057#1050#1048#1044#1050#1048
      '110243706=                )'
      '110243707=              )'
      '110243708=              AND :IS_ALL_ = 1)'
      '110243709=             OR'
      
        '110243710=             (:IS_ALL_ = 0)                           ' +
        '          -- '#1051#1048#1041#1054' '#1042#1057#1045
      '110243711=            )'
      
        '110243712=      INTO :G_DISCOUNT, :G_PRODUCT, :G_PRODUCT_NAME, :' +
        'ARTICUL, :BARCODE, :NOMENCLATUR_NUM, :DATE_BEGIN, :DATE_END, :IS' +
        '_CONST, :NAME, :PRICE, :SKIDKA_PROC, :SKIDKA_SUM,'
      '110243713=           :TOCHKA_NAME'
      '110243714=           ,:G_PRODUCT_PAR_NAME'
      '110243715=    DO'
      '110243716=      SUSPEND;'
      '110243717=end'
      '110243718=;'
      '110243719='
