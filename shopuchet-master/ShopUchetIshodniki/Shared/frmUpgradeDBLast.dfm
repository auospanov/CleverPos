        '1101323334=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_' +
        ', :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101323335=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323336=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
