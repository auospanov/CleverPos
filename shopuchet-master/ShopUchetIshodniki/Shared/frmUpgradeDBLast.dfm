      '110242403=  END'
      '110242404='
      
        '110242405=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      '110242406=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110242407=    SELECT K.KASSA'
      '110242408=      FROM KASSA K'
      '110242409=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110242410=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110242411=      INTO :KASSA_POP_;'
      '110242412=  ELSE'
      '110242413=    SELECT K.KASSA_BEZNAL'
      '110242414=      FROM KASSA_BEZNAL K'
      '110242415=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110242416=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110242417=       INTO :KASSA_POP_;'
      '110242418='
      
        '110242419=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '110242420=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEGI' +
        'N'
      '110242421=      PNT_ = '#39#39'012'#39#39';'
      '110242422=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      '110242423=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_,'
      
        '110242424=                                          1,     -- AC' +
        'TION_'
      '110242425=                                          :G_PRIHOD_,'
      
        '110242426=                                          :SUMM_PRIHOD' +
