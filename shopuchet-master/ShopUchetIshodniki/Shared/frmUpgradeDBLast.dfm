        '1102017022=                 INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM' +
        '_ITER_;'
      '1102017023='
      
        '1102017024=                LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090 +
        ' "'#39' || EXTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month' +
        ' FROM ACTION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_' +
        ') || '#39'"'#39';'
      '1102017025='
      '1102017026=                IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102017027=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102017028=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1102017029=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1102017030=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1102017031=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1102017032=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1102017033=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1102017034=                                                  1,'
      
        '1102017035=                                                  :G_' +
        'TOCHKA_,'
      
        '1102017036=                                                  :UP' +
        'LOAD_TO_EXT_APP_,'
      
        '1102017037=                                                  :G_' +
        'OFFICIAL_'
      
        '1102017038=                                                  ) R' +
        'ETURNING_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1102017039=                    LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102017040=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES' +
        '_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1102017041='
