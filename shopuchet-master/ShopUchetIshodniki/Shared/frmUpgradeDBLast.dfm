        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110244399=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110244400=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110244401=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_TOCH' +
        'KA'#39', '#39'G_PRODUCT_FILL'#39','
      
        '110244402=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39')'
      '110244403=        INTO :TN,'
      '110244404=             :FN'
      '110244405=  DO BEGIN'
      '110244406=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN BEGIN'
      '110244407=      SELECT TRIM(F.RDB$FIELD_NAME)'
      '110244408=        FROM RDB$RELATION_FIELDS F'
      '110244409=       WHERE F.RDB$RELATION_NAME = :TN'
      '110244410=         AND F.RDB$FIELD_POSITION = 0'
      '110244411=        INTO :ID_COLUMN;'
      '110244412=    END'
      '110244413='
      
        '110244414=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110244415=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '110244416=        '#39'AS '#39'||CRLF||'
      '110244417=        '#39'BEGIN '#39'||CRLF||'
      
        '110244418=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      '110244419=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF||'
      
        '110244420=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110244421=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110244422=        '#39'END;'#39';'
      '110244423=    EXECUTE STATEMENT :TRGI;'
      '110244424='
      
        '110244425=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110244426=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '110244427=        '#39'AS '#39'||CRLF||'
      '110244428=        '#39'BEGIN '#39'||CRLF||'
      
        '110244429=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '110244430=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRLF' +
        '||'
      
        '110244431=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110244432=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110244433=        '#39'END;'#39';'
      '110244434=    EXECUTE STATEMENT :TRGI;'
      '110244435='
      '110244436=    TN_ALT = TN;'
      '110244437=  END'
      '110244438=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '110244439=        FROM RDB$RELATIONS R'
      '110244440=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110244441=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '110244442=       ORDER BY R.RDB$RELATION_NAME'
      '110244443=        INTO :TN'
      '110244444=  DO BEGIN'
      '110244445=    TN=TRIM(TN);'
      '110244446=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '110244447='
      '110244448=    EXECUTE STATEMENT :SQLSTMT;'
      '110244449=  END'
      '110244450=END'
      '110244451=;'
      '110244452='
      '110244453=ALTER PROCEDURE R_EDIT_REVISION('
      '110244454=  AMOUNT_REAL_ TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '110244455=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110244456=  DATETIME_ TYPE OF COLUMN REVISION.DATETIME_CREATED,'
      '110244457=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110244458=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE = '#39#39','
      '110244459=  PREFIX_ VARCHAR(2) = '#39#39')'
      '110244460=RETURNS ('
      '110244461=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '110244462=  ERR_CODE INTEGER,'
      '110244463=  ERR_MSG VARCHAR(1024))'
      '110244464=AS'
      
        '110244465=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'R_EDIT_REVISI' +
        'ON'#39';'
      '110244466=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110244467=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_PR' +
        'ODUCT.AMOUNT;'
      '110244468=DECLARE VARIABLE I INTEGER = 1;'
      
        '110244469=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      
        '110244470=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE' +
        ';'
      
        '110244471=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      
        '110244472=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110244473=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110244474=DECLARE VARIABLE IS_MARKED_ TYPE OF COLUMN G_PRODUCT.I' +
        'S_MARKED;'
      
        '110244475=DECLARE VARIABLE IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.I' +
        'S_WEIGHT;'
      
        '110244476=DECLARE VARIABLE VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRO' +
        'DUCT.VES_GRAMM_PRICE;'
      '110244477=BEGIN'
      '110244478=  PNT_ = '#39'00'#39';'
      '110244479=  IF (BARCODE_ <> '#39#39') THEN BEGIN'
      
        '110244480=    EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARC' +
        'ODE_, '#39#39'/*:ARTICUL_*/, '#39#39'/*:NOMER_*/, '#39#39'/*:NAME_*/, :PREFIX_)'
      
        '110244481=        RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEG' +
        'ORY_, :PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :IS_MARKED_,'
      
        '110244482=        :IS_WEIGHT_, :VES_GRAMM_PRICE_, :ERR_CODE, :ER' +
        'R_MSG;'
      '110244483='
      
        '110244484=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) TH' +
        'EN'
      '110244485=      AMOUNT_REAL_ = AMOUNT_;'
      '110244486='
      '110244487=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110244488=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110244489='
      '110244490=      EXIT;'
      '110244491=    END'
      '110244492=  END'
      '110244493='
      '110244494=  PNT_ = '#39'01'#39';'
      '110244495=  SELECT LT.AMOUNT + LT.AMOUNT_RESERVE'
      '110244496=    FROM LT_SKLAD_PRODUCT LT'
      '110244497=   WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110244498=     AND LT.G_TOCHKA = :G_TOCHKA_'
      '110244499=    INTO :AMOUNT_BD_;'
      '110244500='
      '110244501=  AMOUNT_BD_ = COALESCE(AMOUNT_BD_, 0);'
      '110244502='
      
        '110244503=  -- '#1045#1057#1051#1048' '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1042#1040#1053#1040' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070 +
        ' 1 ('#1045#1057#1051#1048' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045')'
      '110244504=  -- '#1045#1057#1051#1048' '#1053#1045' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1064#1045#1044#1064#1045#1045' '#1050#1054#1051'-'#1042#1054
      '110244505=  PNT_ = '#39'02'#39';'
      '110244506=  UPDATE REVISION_TMP R'
      
        '110244507=     SET R.AMOUNT_REAL = DECODE(:BARCODE_, '#39#39', :AMOUNT' +
        '_REAL_, (CASE WHEN SUBSTRING(:BARCODE_ FROM 1 FOR 2) = :PREFIX_ ' +
        'THEN R.AMOUNT_REAL + :AMOUNT_REAL_ ELSE R.AMOUNT_REAL + 1 END))'
      '110244508=   WHERE R.G_PRODUCT = :G_PRODUCT_'
      '110244509=  RETURNING'
      '110244510=    REVISION'
      '110244511=  INTO'
      '110244512=    :REVISION_;'
      '110244513='
      '110244514=  PNT_ = '#39'03'#39';'
      '110244515=  IF (ROW_COUNT = 0) THEN'
      
        '110244516=      INSERT INTO REVISION_TMP (REVISION, G_PRODUCT, A' +
        'MOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '110244517=      VALUES (GEN_ID(GEN_REVISION, 1), :G_PRODUCT_, :A' +
        'MOUNT_BD_, :AMOUNT_REAL_, :DATETIME_)'
      '110244518=      RETURNING'
      '110244519=        REVISION'
      '110244520=      INTO'
      '110244521=        :REVISION_;'
      '110244522='
      '110244523=WHEN ANY DO BEGIN'
      '110244524=    Err_code = -20500;'
      
        '110244525=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1042#1057 +
        #1058#1040#1042#1050#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110244526=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110244527=  END'
      '110244528=END'
      '110244529=;'
      '110244530='
      '110244531='
      
        '110244532=UPDATE SYSTEM_SETUP SET S_VALUE = 110244 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110244533=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110244534=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102450='
