      '110231835=      VALUES (16, 1, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39');'
      '110231836=      FIRST_ITER = 1;'
