        '110192375=                INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP' +
        ', OBJECT_TYPE, ID, OPER)'
      
        '110192376=                VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4' +
        ', :G_PRODUCT_LOC_, 3);'
      '110192377=          END'
      '110192378='
      '110192379=          SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110192380=      END'
      '110192381=    END'
      '110192382='
      '110192383='
      
        '110192384=    -- '#1058#1045#1055#1045#1056#1068' '#1059#1044#1040#1051#1071#1070' '#1058#1045#1061', '#1063#1058#1054' '#1053#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040 +
        #1061'/'#1055#1056#1048#1061#1054#1044#1040#1061
      '110192385=    FOR SELECT P.G_PRODUCT,'
      '110192386=               '#39#1058#1086#1074#1072#1088' '#39'|| P.NAME,'
      
