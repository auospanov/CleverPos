        '1101323365=                                                  0, ' +
        '    -- ACTION_'
      
        '1101323366=                                                  :G_' +
        'PRIHOD_,'
      
        '1101323367=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101323368=                                                  :Z_' +
        'DATE_,'
      
        '1101323369=                                                  NUL' +
        'L,   --NOTE_'
      
        '1101323370=                                                  :ZA' +
        'KAZ_,'
      
        '1101323371=                                                  NUL' +
        'L,'
      
        '1101323372=                                                  :G_' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101323373=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101323374=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '1101323375=                    PNT_ = '#39'10'#39';'
      
        '1101323376=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101323377=                                                  :G_' +
        'PRIHOD_,'
      
        '1101323378=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101323379=                                                  :Z_' +
        'DATE_,'
      
        '1101323380=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101323381=                                                  :ZA' +
        'KAZ_,'
      
        '1101323382=                                                  NUL' +
        'L,'
      
        '1101323383=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1101323384=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101323385=              END'
      '1101323386='
      
        '1101323387=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101323388=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101323389=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101323390=                PNT_ = '#39'11'#39';'
      '1101323391=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101323392=                    EXECUTE PROCEDURE K_DEL_KASSA(:KA' +
        'SSA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1101323393=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323394=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101323395=                      EXIT;'
      '1101323396=                    END'
      '1101323397='
      
        '1101323398=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101323399=                                                  :G_' +
        'PRIHOD_,'
      
        '1101323400=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101323401=                                                  :Z_' +
        'DATE_,'
      
        '1101323402=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101323403=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1101323404=                                                  NUL' +
        'L,'
      
        '1101323405=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1101323406=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101323407=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323408=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101323409=                      EXIT;'
      '1101323410=                    END'
      '1101323411=                END'
      '1101323412=            END'
      
        '1101323413=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      
        '1101323414=            --=======================================' +
        '=========================='
      '1101323415='
      
        '1101323416=            --=======================================' +
        '=========================='
      '1101323417=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101323418=            --=======================================' +
        '=========================='
      '1101323419=            PNT_ = '#39'12'#39';'
      
        '1101323420=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1101323421=                KASSA_ = NULL;'
      '1101323422='
      '1101323423=                SELECT S.S_VALUE'
      '1101323424=                  FROM SYSTEM_SETUP S'
      '1101323425=                 WHERE S.SYSTEM_SETUP = 4'
      '1101323426=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101323427='
      '1101323428=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101323429=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101323430=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101323431='
      
        '1101323432=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101323433=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1101323434=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1101323435='
      '1101323436=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101323437=                ELSE'
      
        '1101323438=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1101323439='
      '1101323440=                SELECT K.KASSA, K.SUMM'
      '1101323441=                FROM KASSA K'
      '1101323442=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1101323443=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101323444=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101323445=                 AND K.G_TOCHKA = :G_TOCHKA_'
      
        '1101323446=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_' +
        ';'
      '1101323447='
      '1101323448=                IF (KASSA_ IS NULL) THEN'
      
        '1101323449=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101323450=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101323451=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101323452=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101323453=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1101323454=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1101323455=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1101323456=                                                  1,'
      
        '1101323457=                                                  :G_' +
        'TOCHKA_,'
      
        '1101323458=                                                  :G_' +
        'OFFICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101323459=                ELSE BEGIN'
      
        '1101323460=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_,'
      
        '1101323461=                                                  1, ' +
        '    -- ACTION_'
      
        '1101323462=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101323463=                                                  :SA' +
        'LES_COMM_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_ - :SALES_COMM_OLD_,'
      
        '1101323464=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101323465=                                                  :OF' +
        'FICIAL_NAME_,   --NOTE_'
      
        '1101323466=                                                  NUL' +
        'L,'
      
        '1101323467=                                                  NUL' +
        'L,'
      
        '1101323468=                                                  1, ' +
        '  --:PAYMENT_TYPE_,'
      
        '1101323469=                                                  :G_' +
        'OFFICIAL_'
      
        '1101323470=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101323471=                END'
      '1101323472=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323473=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101323474=                  EXIT;'
      '1101323475=                END'
      '1101323476=            END'
      
        '1101323477=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1101323478=            --=======================================' +
        '=========================='
      '1101323479='
      '1101323480=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1101323481='
      '1101323482=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101323483=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101323484=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101323485=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 2);'
      '1101323486=  END'
      '1101323487=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1101323488=  ---------------------------------------------------' +
        '------------'
      
        '1101323489=  --*************************************************' +
        '************'
      
        '1101323490=  ---------------------------------------------------' +
        '------------'
      '1101323491=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101323492=  ELSE BEGIN'
      '1101323493=      PNT_ = '#39'020'#39';'
      '1101323494=      SELECT SP.G_TOCHKA,'
      '1101323495=             SP.G_CLIENT,'
      '1101323496=             SP.IS_EXPECTED'
      '1101323497=        FROM SKLAD_PARENT SP'
      '1101323498=       WHERE SP.SKLAD = :ZAKAZ_'
      '1101323499=        INTO :G_TOCHKA_OLD_,'
      '1101323500=             :G_TOCHKA_,'
      '1101323501=             :IS_EXPECTED_OLD_;'
      '1101323502='
      
        '1101323503=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101323504=      PNT_ = '#39'021'#39';'
      '1101323505=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '1101323506=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101323507=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323508=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101323509=            EXIT;'
      '1101323510=          END'
      '1101323511='
      '1101323512=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101323513=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101323514=                FROM ZAKAZ_DETAILS_TMP Z'
      '1101323515=              INTO :G_PRODUCT_,'
      '1101323516=                  :Z_AMOUNT_,'
      '1101323517=                  :PRICE_,'
      '1101323518=                  :SUMMM_'
      '1101323519=          DO BEGIN'
      '1101323520=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101323521=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1101323522=            IS_THIS_LAST_ = 0;'
      '1101323523=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101323524=                FROM SKLAD SK'
      '1101323525=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101323526=                 AND SK.IS_LAST = 1'
      '1101323527=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1101323528=                INTO :DATE_LAST_;'
      '1101323529='
      
        '1101323530=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101323531=                UPDATE SKLAD SK'
      '1101323532=                   SET SK.IS_LAST = 0'
      '1101323533=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101323534=                   AND SK.IS_LAST = 1'
      '1101323535=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101323536='
      '1101323537=                IS_THIS_LAST_ = 1;'
      '1101323538=            END'
      '1101323539='
      '1101323540='
      '1101323541=            INSERT INTO SKLAD'
      '1101323542=            ('
      '1101323543=             SKLAD,'
      '1101323544=             SKLAD_PARENT,'
      '1101323545=             DATE_RECEIPT,'
      '1101323546=             G_CLIENT,'
      '1101323547=             G_PRODUCT,'
      '1101323548=             AMOUNT,'
      '1101323549=             PRICE,'
      '1101323550=             SUMM,'
      '1101323551=             G_PAYMENT_TYPE,'
      '1101323552=             OSNOVANIE,'
      '1101323553=             NOTE,'
      '1101323554=             NDS,'
      '1101323555=             NDS_SUMM,'
      '1101323556=             IS_LAST,'
      '1101323557=             IS_VOZVRAT,'
      '1101323558=             G_TOCHKA'
      '1101323559=            ) VALUES ('
      '1101323560=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101323561=             :ZAKAZ_,'
      '1101323562=             :Z_DATE_,'
      '1101323563=             :G_TOCHKA_,'
      '1101323564=             :G_PRODUCT_,'
      '1101323565=             :Z_AMOUNT_,'
      '1101323566=             :PRICE_,'
      '1101323567=             :SUMMM_,'
      '1101323568=             :G_PAYMENT_TYPE_,'
      '1101323569=             :OSNOVANIE_,'
      '1101323570=             :NOTE_,'
      '1101323571=             0,  --:RNDS_,'
      '1101323572=             0,  --:RNDS_SUMM_,'
      
        '1101323573=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1101323574=             3,  --:IS_VOZVRAT_,'
      '1101323575=             :G_CLIENT_'
      '1101323576=            );'
      '1101323577='
      
        '1101323578=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1101323579=            UPDATE LT_SKLAD_PRODUCT L'
      '1101323580=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '1101323581=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323582=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101323583='
      
        '1101323584=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101323585=            PNT_ = '#39'023'#39';'
      '1101323586=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101323587=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323588=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_'
      '1101323589=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323590=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1101323591='
      '1101323592=                IF (ROW_COUNT = 0) THEN'
      
        '1101323593=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_' +
        'SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101323594=            END'
      '1101323595=          END'
      '1101323596=      END'
      '1101323597=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1101323598=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1101323599=      ELSE BEGIN'
      
        '1101323600=          -------------------------------------------' +
        '------------------'
      
        '1101323601=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1101323602=          PNT_ = '#39'025'#39';'
      '1101323603=          FOR SELECT SKLAD,'
      '1101323604=                     AMOUNT,'
      '1101323605=                     G_PRODUCT'
      '1101323606=                FROM SKLAD S'
      '1101323607=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1101323608=                 AND NOT EXISTS (SELECT 1'
      
        '1101323609=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1101323610=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1101323611=          INTO :SKLAD_,'
      '1101323612=               :Z_AMOUNT_,'
      '1101323613=               :G_PRODUCT_'
      '1101323614=          DO BEGIN'
      
        '1101323615=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101323616=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323617=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101323618=              EXIT;'
      '1101323619=            END'
      '1101323620=          END'
      '1101323621='
      '1101323622=          PNT_ = '#39'030'#39';'
      '1101323623=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1101323624=                     S.G_PRODUCT,'
      '1101323625=                     S.AMOUNT,'
      '1101323626=                     S.PRICE,'
      '1101323627=                     S.SUMM,'
      '1101323628=                     T.SKLAD,'
      '1101323629=                     T.AMOUNT,'
      '1101323630=                     T.IS_LAST,'
      '1101323631=                     T.DATE_RECEIPT'
      
        '1101323632=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1101323633=                INTO :ZAKAZ_DETAILS_,'
      '1101323634=                     :G_PRODUCT_,'
      '1101323635=                     :Z_AMOUNT_,'
      '1101323636=                     :PRICE_,'
      '1101323637=                     :SUMMM_,'
      '1101323638=                     :SKLAD_OLD_,'
      '1101323639=                     :AMOUNT_OLD_,'
      '1101323640=                     :IS_THIS_LAST_,'
      '1101323641=                     :DATE_RECEIPT_OLD_'
      '1101323642=          DO BEGIN'
      
        '1101323643=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101323644=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1101323645=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1101323646=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1101323647=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1101323648=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101323649=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1101323650=                       )'
      '1101323651=                RETURNING'
      '1101323652=                  SKLAD'
      '1101323653=                INTO'
      '1101323654=                  :SKLAD_;'
      '1101323655='
      
        '1101323656=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101323657=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323658=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_'
      '1101323659=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323660=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101323661='
      
        '1101323662=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101323663=                IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGI' +
        'N'
      '1101323664=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323665=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_'
      '1101323666=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323667=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101323668='
      '1101323669=                    IF (ROW_COUNT = 0) THEN'
      
        '1101323670=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN' +
        '_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101323671=                END'
      '1101323672='
      
        '1101323673=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101323674=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045 +
        #1053#1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042 +
        #1051#1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1101323675=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_S' +
        'KLAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1101323676=                /*SELECT MAX(SK.DATE_RECEIPT)'
      '1101323677=                  FROM SKLAD SK'
      '1101323678=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101323679=                   AND SK.IS_LAST = 1'
      '1101323680=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '1101323681=                  INTO :DATE_LAST_;'
      '1101323682='
      
        '1101323683=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ ' +
        '>= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101323684=                  UPDATE SKLAD SK'
      '1101323685=                     SET SK.IS_LAST = 0'
      '1101323686=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101323687=                     AND SK.IS_LAST = 1'
      '1101323688=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101323689='
      '1101323690=                  UPDATE SKLAD SK'
      '1101323691=                     SET SK.IS_LAST = 1'
      '1101323692=                   WHERE SK.SKLAD = :SKLAD_;'
      '1101323693=                END*/'
      '1101323694='
      
        '1101323695=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101323696=            END ELSE BEGIN'
      '1101323697=                UPDATE SKLAD S'
      '1101323698=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1101323699=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1101323700=                       S.PRICE    = :PRICE_,'
      '1101323701=                       S.SUMM     = :SUMMM_,'
      '1101323702=                       S.OSNOVANIE = :OSNOVANIE_,'
      '1101323703=                       S.NOTE      = :NOTE_'
      '1101323704=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1101323705='
      
        '1101323706=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101323707=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101323708=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323709=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_)'
      '1101323710=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323711=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1101323712=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1101323713=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323714=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_)'
      '1101323715=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323716=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101323717='
      
        '1101323718=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101323719=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101323720=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101323721=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323722=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_)'
      
        '1101323723=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101323724=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101323725='
      
        '1101323726=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1101323727=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323728=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_)'
      
        '1101323729=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101323730=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101323731='
      
        '1101323732=                -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' ' +
        #1057#1050#1051#1040#1044', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1101323733=                END ELSE IF (IS_EXPECTED_OLD_ = 1 AND' +
        ' NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101323734=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323735=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_'
      '1101323736=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323737=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101323738='
      '1101323739=                    IF (ROW_COUNT = 0) THEN'
      
        '1101323740=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101323741=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101323742=                END'
      
        '1101323743=                -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042 +
        #1040' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1101323744=                ELSE IF (IS_EXPECTED_OLD_ = 0 AND NOT' +
        '_MINUS_OSTATOK_ = 1) THEN BEGIN'
      '1101323745=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323746=                       SET L.AMOUNT = L.AMOUNT - (:AM' +
        'OUNT_OLD_ - :Z_AMOUNT_) - :Z_AMOUNT_'
      '1101323747=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323748=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101323749=                END'
      '1101323750='
      
        '1101323751=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1101323752=                /*IF ((Z_DATE_ > DATE_RECEIPT_OLD_) A' +
        'ND (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1101323753=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101323754=                      FROM SKLAD SK'
      '1101323755=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101323756=                       AND SK.IS_LAST = 1'
      '1101323757=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101323758=                      INTO :DATE_LAST_;'
      '1101323759='
      
        '1101323760=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101323761=                      UPDATE SKLAD SK'
      '1101323762=                         SET SK.IS_LAST = 0'
      
        '1101323763=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1101323764=                         AND SK.IS_LAST = 1'
      
        '1101323765=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1101323766='
      '1101323767=                      UPDATE SKLAD SK'
      '1101323768=                         SET SK.IS_LAST = 1'
      
        '1101323769=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101323770=                    END'
      '1101323771=                END'
      '1101323772='
      
        '1101323773=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1101323774=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1101323775=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101323776=                      FROM SKLAD SK'
      '1101323777=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101323778=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1101323779=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101323780=                       AND SK.is_vozvrat IN (0,3,4)'
      '1101323781=                      INTO :DATE_LAST_;'
      '1101323782='
      
        '1101323783=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101323784=                      UPDATE SKLAD SK'
      '1101323785=                         SET SK.IS_LAST = 0'
      
        '1101323786=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101323787='
      '1101323788=                       UPDATE SKLAD SK'
      '1101323789=                         SET SK.IS_LAST = 1'
      
        '1101323790=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1101323791=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1101323792=                                           FROM SKLAD' +
        ' SS'
      
        '1101323793=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1101323794=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1101323795=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1101323796=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1101323797=                    END'
      '1101323798=                END*/'
      '1101323799=            END'
      '1101323800=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1101323801=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1101323802='
      '1101323803=      UPDATE SKLAD_PARENT'
      '1101323804=      SET'
      
        '1101323805=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1101323806=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1101323807=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101323808=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101323809=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101323810=       SUMM      = :SUMM_,'
      '1101323811=       SUMM_FACT = :SUMM_FACT_,'
      '1101323812=       IS_EXPECTED = :NOT_MINUS_OSTATOK_'
      '1101323813=      WHERE SKLAD  = :ZAKAZ_;'
      '1101323814=  END'
      '1101323815='
      '1101323816=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101323817=END'
      '1101323818=;'
      '1101323819='
      '1101323820='
      
        '1101323821=/****************************************************' +
        '**************************/'
      
        '1101323822=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101323823=/****************************************************' +
        '**************************/'
      '1101323824=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1101323825=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101323826=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101323827=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101323828=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101323829=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101323830=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101323831=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101323832=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101323833=RETURNS ('
      '1101323834=  ERR_CODE INTEGER,'
      '1101323835=  ERR_MSG VARCHAR(1024))'
      '1101323836=AS'
      '1101323837=/*'
      
        '1101323838='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1101323839='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1101323840='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1101323841=*/'
      
        '1101323842=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1101323843=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101323844=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1101323845=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1101323846=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1101323847=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1101323848=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1101323849=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1101323850=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1101323851=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101323852=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1101323853=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1101323854=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1101323855=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101323856=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101323857=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101323858=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101323859=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101323860=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1101323861=BEGIN'
      '1101323862='
      '1101323863=  PNT_ = '#39'00'#39';'
      '1101323864=  CLRF = ascii_char( 10 );'
      '1101323865='
      '1101323866=  SELECT S.S_VALUE'
      '1101323867=    FROM SYSTEM_SETUP S'
      '1101323868=   WHERE S.SYSTEM_SETUP = 2'
      '1101323869=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1101323870='
      '1101323871=  PNT_ = '#39'01'#39';'
      '1101323872=  SELECT G.nds_value'
      '1101323873=    FROM G_FIRM_REKVIZIT G'
      '1101323874=   WHERE G.is_default = 1'
      '1101323875=    INTO :NDS_;'
      '1101323876='
      '1101323877=  PNT_ = '#39'02'#39';'
      
        '1101323878=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1101323879=        FROM IMPORT_TBL_TMP'
      
        '1101323880=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1101323881=  DO BEGIN'
      '1101323882=    SELECT G_PRODUCT,'
      '1101323883=           PRICE'
      '1101323884=      FROM ('
      '1101323885=            SELECT P.G_PRODUCT, P.price'
      '1101323886=              FROM G_PRODUCT P'
      
        '1101323887=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1101323888=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1101323889=            UNION'
      '1101323890=            SELECT LT.G_PRODUCT, P.PRICE'
      '1101323891=              FROM LT_BARCODE LT, g_product P'
      
        '1101323892=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1101323893=               AND LT.g_product = P.g_product'
      '1101323894=           )'
      '1101323895=      INTO :G_PRODUCT_,'
      '1101323896=           :PRICE_OUR_;'
      '1101323897='
      '1101323898=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1101323899=      ERR_CODE = -20500;'
      
        '1101323900=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1101323901=      Exit;'
      '1101323902=    END'
      '1101323903='
      '1101323904=    PNT_ = '#39'03'#39';'
      
        '1101323905=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1101323906=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1101323907=      RETURNING_VALUES :COST_PRICE_;'
      '1101323908='
      '1101323909=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1101323910=    IF (price_ IS NULL) THEN'
      '1101323911=      PRICE_ = PRICE_OUR_;'
      '1101323912='
      '1101323913=    PNT_ = '#39'04'#39';'
      
        '1101323914=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1101323915=                                              :AMOUNT' +
        '_,'
      
        '1101323916=                                              :PRICE_' +
        ','
      
        '1101323917=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1101323918=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1101323919=                                              :DISCOU' +
        'NT_,'
      
        '1101323920=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1101323921=                                              :NDS_,'
      
        '1101323922=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1101323923=                                              :COST_P' +
        'RICE_,'
      
        '1101323924=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1101323925=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1101323926=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1101323927=                                              0     -' +
        '-MODE_'
      
        '1101323928=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1101323929=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101323930=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101323931=      EXIT;'
      '1101323932=    END'
      '1101323933='
      '1101323934=    G_PRODUCT_ = NULL;'
      '1101323935=  END'
      '1101323936='
      '1101323937=  PNT_ = '#39'05'#39';'
      '1101323938=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1101323939=    SELECT SUM(T.summ)'
      '1101323940=      FROM ZAKAZ_DETAILS_TMP T'
      '1101323941=      INTO :SUMM_;'
      '1101323942=    SUMM_FACT_ = SUMM_;'
      '1101323943=  END'
      '1101323944='
      '1101323945=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1101323946=  if (G_PAYMENT_TYPE_ = 1) then'
      '1101323947=    SUMM_CASH_ = summ_fact_;'
      '1101323948=  ELSE'
      '1101323949=    SUMM_NONCASH_ = summ_fact_;'
      '1101323950='
      '1101323951=  PNT_ = '#39'06'#39';'
      '1101323952=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1101323953=    G_CLIENT_ = 10;'
      '1101323954='
      '1101323955=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101323956=                              :Z_DATE_,'
      '1101323957=                              :Z_TIME_,'
      '1101323958=                              :G_CLIENT_,'
      '1101323959=                              :G_PAYMENT_TYPE_,'
      '1101323960=                              '#39#39', --:OSNOVANIE_,'
      '1101323961=                              0,  -- IS_SPISANIE'
      
        '1101323962=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1101323963=                              :SUMM_,'
      '1101323964=                              :SUMM_FACT_,'
      '1101323965=                              :SUMM_CASH_,'
      '1101323966=                              :SUMM_NONCASH_,'
      
        '1101323967=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1101323968=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1101323969=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1101323970=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1101323971=                              0,    -- :BY_RECIPE__,'
      '1101323972=                              0,    -- IS_RESERVE__'
      '1101323973=                              NULL -- :PAYMENTS__'
      '1101323974=                              )'
      
        '1101323975=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101323976=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101323977=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101323978=    EXIT;'
      '1101323979=  END'
      '1101323980='
      '1101323981=  DELETE FROM import_tbl_tmp;'
      '1101323982='
      '1101323983=WHEN ANY DO BEGIN'
      '1101323984=    ERR_CODE = gdscode;'
      
        '1101323985=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1101323986=  END'
      '1101323987=end'
      '1101323988=;'
      '1101323989='
      '1101323990=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1101323991=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101323992=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101323993=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101323994=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101323995=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101323996=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101323997=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101323998=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101323999=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101324000=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101324001=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101324002=RETURNS ('
      '1101324003=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101324004=  ERR_CODE INTEGER,'
      '1101324005=  ERR_MSG VARCHAR(1024))'
      '1101324006=AS'
      
        '1101324007=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1101324008=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1101324009=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1101324010=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1101324011='
      
        '1101324012=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101324013=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1101324014=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1101324015=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101324016=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101324017=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101324018=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1101324019=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1101324020=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1101324021=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1101324022=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101324023=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101324024=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1101324025=BEGIN'
      '1101324026='
      '1101324027=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101324028=    SELECT ID'
      '1101324029=      FROM CUR_PARAMS'
      '1101324030=     WHERE CUR_PARAMS = 2'
      '1101324031=      INTO :G_TOCHKA_;'
      '1101324032='
      
        '1101324033=  --*************************************************' +
        '*************************************************'
      
        '1101324034=  --*************************************************' +
        '*************************************************'
      '1101324035=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101324036=  --*************************************************' +
        '*************************************************'
      
        '1101324037=  --*************************************************' +
        '*************************************************'
      '1101324038=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1101324039=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1101324040=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1101324041=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101324042=            INTO :AMOUNT_,'
      '1101324043=                 :G_PRODUCT_'
      '1101324044=      DO BEGIN'
      '1101324045=          UPDATE LT_SKLAD_PRODUCT L'
      '1101324046=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101324047=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101324048=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101324049=      END'
      '1101324050='
      '1101324051=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1101324052=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1101324053=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1101324054=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1101324055=             NDS_SUMM, COST_PRICE'
      '1101324056=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101324057='
      '1101324058=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101324059=                                  :Z_DATE_,'
      '1101324060=                                  :Z_TIME_,'
      '1101324061=                                  :G_CLIENT_,'
      '1101324062=                                  :G_PAYMENT_TYPE_,'
      '1101324063=                                  :OSNOVANIE_,'
      
        '1101324064=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1101324065=                                  :NOTE_,'
      
        '1101324066=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1101324067=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1101324068=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1101324069=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1101324070=                                  0, --SUMM_BONUS_'
      
        '1101324071=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1101324072=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101324073=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1101324074=                                  0,    --BY_RECIPE'
      '1101324075=                                  0     --IS_RESERVE'
      '1101324076=                                  ,NULL  -- PAYMENTS_'
      '1101324077=                                  ,0     --IS_MEBEL_'
      
        '1101324078=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1101324079=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1101324080=                                  ,NULL  --ADDRESS_'
      '1101324081=                                  ,NULL  --PRICE_'
      '1101324082=                                  ,UPLOAD_TO_EXT_APP_'
      '1101324083=                                  )'
      '1101324084=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1101324085='
      '1101324086=      if (ERR_CODE <> 0) then BEGIN'
      '1101324087=        ERR_CODE = -20500;'
      '1101324088=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101324089=        Exit;'
      '1101324090=      END'
      '1101324091='
      
        '1101324092=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101324093=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1101324094=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1101324095=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1101324096=      UPDATE ZAKAZ'
      '1101324097=         SET IS_SPISANIE = 2'
      '1101324098=       WHERE ZAKAZ = :ZAKAZ_;'
      '1101324099='
      
        '1101324100=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101324101=      FOR SELECT T.AMOUNT,'
      '1101324102=                 T.SUMM,'
      '1101324103=                 T.G_PRODUCT,'
      '1101324104=                 T.ZAKAZ_NA_REAL,'
      '1101324105=                 T.ZAKAZ_DETAILS'
      '1101324106=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101324107=            INTO :AMOUNT_,'
      '1101324108=                 :Z_SUMM_,'
      '1101324109=                 :G_PRODUCT_,'
      '1101324110=                 :ZAKAZ_NA_REAL_,'
      '1101324111=                 :ZAKAZ_DETAILS_'
      '1101324112=      DO BEGIN'
      '1101324113=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101324114=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1101324115=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1101324116=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101324117=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101324118='
      
        '1101324119=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101324120=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1101324121=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1101324122=      END'
      '1101324123=  END'
      '1101324124=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101324125=  --*************************************************' +
        '*************************************************'
      
        '1101324126=  --*************************************************' +
        '*************************************************'
      '1101324127='
      
        '1101324128=  --*************************************************' +
        '*************************************************'
      
        '1101324129=  --*************************************************' +
        '*************************************************'
      '1101324130=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101324131=  --*************************************************' +
        '*************************************************'
      
        '1101324132=  --*************************************************' +
        '*************************************************'
      '1101324133=  ELSE BEGIN'
      '1101324134=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1101324135=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101324136=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101324137=      FOR SELECT T.AMOUNT,'
      '1101324138=                 T.SUMM,'
      '1101324139=                 T.G_PRODUCT,'
      '1101324140=                 T.ZAKAZ_NA_REAL,'
      '1101324141=                 T.ZAKAZ_DETAILS'
      '1101324142=                 ,T.PRICE'
      '1101324143=                 ,T.NDS'
      '1101324144=                 ,T.NDS_SUMM'
      '1101324145=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101324146=            INTO :AMOUNT_,'
      '1101324147=                 :Z_SUMM_,'
      '1101324148=                 :G_PRODUCT_,'
      '1101324149=                 :ZAKAZ_NA_REAL_,'
      '1101324150=                 :ZAKAZ_DETAILS_'
      '1101324151=                 ,:PRICE_'
      '1101324152=                 ,:NDS_'
      '1101324153=                 ,:NDS_SUMM_'
      '1101324154=      DO BEGIN'
      
        '1101324155=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101324156=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1101324157='
      
        '1101324158=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1101324159=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1101324160='
      '1101324161=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101324162=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1101324163=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1101324164=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101324165=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101324166=      END'
      '1101324167='
      '1101324168=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101324169=                                  :Z_DATE_,'
      '1101324170=                                  :Z_TIME_,'
      '1101324171=                                  :G_CLIENT_,'
      '1101324172=                                  :G_PAYMENT_TYPE_,'
      '1101324173=                                  :OSNOVANIE_,'
      '1101324174=                                  :NOTE_,'
      
        '1101324175=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1101324176=                                  :SUMM_,'
      '1101324177=                                  :SUMM_FACT_,'
      
        '1101324178=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1101324179=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1101324180=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1101324181=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1101324182='
      '1101324183=      if (ERR_CODE <> 0) then BEGIN'
      '1101324184=        ERR_CODE = -20500;'
      '1101324185=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101324186=        Exit;'
      '1101324187=      END'
      '1101324188=  END'
      '1101324189=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101324190=  --*************************************************' +
        '*************************************************'
      
        '1101324191=  --*************************************************' +
        '*************************************************'
      '1101324192='
      '1101324193=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101324194=END'
      '1101324195=;'
      '1101324196='
      '1101324197=ALTER PROCEDURE R_UNIFICATION('
      '1101324198=  MODE_ INTEGER)'
      '1101324199=RETURNS ('
      '1101324200=  COUNT_SPIS_ INTEGER,'
      '1101324201=  COUNT_PRIH_ INTEGER,'
      '1101324202=  ERR_CODE INTEGER,'
      '1101324203=  ERR_MSG VARCHAR(1024))'
      '1101324204=AS'
      
        '1101324205=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1101324206=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101324207=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1101324208=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1101324209=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1101324210=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1101324211=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1101324212=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101324213=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1101324214=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101324215=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101324216=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101324217=BEGIN'
      '1101324218='
      '1101324219=  COUNT_SPIS_ = 0;'
      '1101324220=  COUNT_PRIH_ = 0;'
      '1101324221='
      '1101324222=  SELECT ID'
      '1101324223=    FROM CUR_PARAMS'
      '1101324224=   WHERE CUR_PARAMS = 2'
      '1101324225=    INTO :G_TOCHKA_;'
      '1101324226='
      
        '1101324227=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1101324228=      FROM REVISION'
      '1101324229=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1101324230=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1101324231=  DO BEGIN'
      
        '1101324232=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1101324233=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1101324234=        RETURNING_VALUES :COST_PRICE_;'
      '1101324235='
      
        '1101324236=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1101324237=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1101324238=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1101324239='
      '1101324240=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1101324241=    END'
      '1101324242='
      
        '1101324243=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1101324244=      SELECT S.price'
      '1101324245=        FROM SKLAD S'
      '1101324246=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1101324247=         AND S.g_product = :G_PRODUCT_'
      '1101324248=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1101324249=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1101324250=                                 FROM SKLAD DD'
      
        '1101324251=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1101324252=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1101324253=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1101324254=                                )'
      '1101324255=        ORDER BY s.sklad DESC'
      '1101324256=        ROWS 1 TO 1'
      '1101324257=        INTO :PRICE_LAST_;'
      '1101324258='
      '1101324259=    /* SELECT S.PRICE'
      '1101324260=        FROM SKLAD S'
      '1101324261=       WHERE S.IS_LAST = 1'
      '1101324262=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1101324263=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1101324264=        INTO :PRICE_LAST_; */'
      '1101324265='
      
        '1101324266=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1101324267='
      
        '1101324268=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101324269=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1101324270='
      '1101324271=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1101324272=    END'
      '1101324273='
      '1101324274=    UPDATE REVISION R'
      '1101324275=       SET R.IS_UNIFIED = 1'
      '1101324276=     WHERE R.REVISION = :REVISION_;'
      '1101324277=  END'
      '1101324278='
      '1101324279=  PNT_ = '#39'01'#39';'
      '1101324280=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1101324281=    SELECT SUM(S.SUMM)'
      '1101324282=      FROM ZAKAZ_DETAILS_TMP S'
      '1101324283=      INTO :SUMM_;'
      '1101324284='
      '1101324285=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1101324286=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1101324287=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1101324288=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1101324289=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1101324290=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1101324291=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1101324292=                                NULL,           --:NO' +
        'TE_,'
      
        '1101324293=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1101324294=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1101324295=                                0,              --SUM' +
        'M_BONUS_'
      
        '1101324296=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1101324297=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1101324298=                                NULL,'
      
        '1101324299=                                0,        -- BY_RECIP' +
        'E'
      
        '1101324300=                                0         -- IS_RESER' +
        'VE'
      '1101324301=                                ,NULL  -- PAYMENTS_'
      '1101324302=                                ,0     -- SUMM_CASH'
      
        '1101324303=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1101324304=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1101324305=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101324306=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101324307=      EXIT;'
      '1101324308=    END'
      '1101324309=  END'
      '1101324310='
      '1101324311=  PNT_ = '#39'02'#39';'
      '1101324312=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1101324313=    SELECT SUM(S.SUMM)'
      '1101324314=      FROM SKLAD_TMP S'
      '1101324315=      INTO :SUMM_;'
      '1101324316='
      '1101324317=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1101324318=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1101324319=                                CURRENT_TIME,'
      
        '1101324320=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1101324321=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1101324322=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1101324323=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1101324324=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1101324325=                                :SUMM_,'
      '1101324326=                                :SUMM_,'
      
        '1101324327=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1101324328=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1101324329=                                ,NULL  --PAYMENTS'
      '1101324330=                                )'
      
        '1101324331=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1101324332=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101324333=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101324334=      EXIT;'
      '1101324335=    END'
      '1101324336=  END'
      '1101324337=END'
      '1101324338=;'
      
        '1101324339=UPDATE SYSTEM_SETUP SET S_VALUE = 110132 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101324340=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101324341=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101330=ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '1101331=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101332=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101333=  MODE_ INTEGER)'
      '1101334=RETURNS ('
      '1101335=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '1101336=AS'
      '1101337=/*'
      
        '1101338=11.04.2019 '#1047#1053#1040#1052#1045#1053#1040#1058#1045#1051#1068#1053#1067#1049' '#1044#1045#1053#1068', '#1056#1045#1064#1048#1051' '#1058#1045#1055#1045#1056#1068' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1055 +
        #1054' IS_LAST, '#1040' '#1055#1054' MAX DATE_RECEIPT'
      '1101339=*/'
      
        '11013310=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE;'
      
        '11013311=DECLARE VARIABLE CNT_ INTEGER;   -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1047#1040#1050#1059#1055#1054#1050' ' +
        '5 '#1048#1051#1048' 200, '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067
      '11013312=BEGIN'
      '11013313=  IF (G_TOCHKA_ IS NULL) THEN'
      '11013314=    SELECT ID'
      '11013315=      FROM CUR_PARAMS'
      '11013316=     WHERE CUR_PARAMS = 2'
      '11013317=      INTO :G_TOCHKA_;'
      '11013318='
      '11013319=  IF (COALESCE(MODE_, 0) = 0) THEN'
      '11013320=      SELECT S.price'
      '11013321=        FROM SKLAD S'
      '11013322=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '11013323=         AND S.g_product = :G_PRODUCT_'
      '11013324=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '11013325=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECEI' +
        'PT)'
      '11013326=                                 FROM SKLAD DD'
      
        '11013327=                                WHERE DD.g_product = :G' +
        '_PRODUCT_'
      
        '11013328=                                  AND DD.G_TOCHKA = :G_' +
        'TOCHKA_'
      
        '11013329=                                  AND DD.IS_VOZVRAT IN ' +
        '(0, 4)'
      '11013330=                                )'
      '11013331=        ORDER BY S.SKLAD DESC'
      '11013332=        ROWS 1 TO 1'
      '11013333=        INTO :PRICE_;'
      '11013334=      /*SELECT S.PRICE'
      '11013335=        FROM SKLAD S'
      '11013336=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '11013337=         AND S.IS_LAST = 1'
      '11013338=         AND S.G_PRODUCT = :G_PRODUCT_'
      '11013339=        INTO :PRICE_;*/'
      '11013340='
      
        '11013341=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047#1040 +
        #1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '11013342=  ELSE BEGIN'
      '11013343=    SELECT S.S_VALUE'
      '11013344=      FROM SYSTEM_SETUP S'
      '11013345=     WHERE S.SYSTEM_SETUP = 1'
      '11013346=      INTO :FORMULA_;'
      '11013347='
      '11013348=    IF (FORMULA_ = 1) THEN BEGIN'
      '11013349=      SELECT S.price'
      '11013350=        FROM SKLAD S'
      '11013351=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '11013352=         AND S.g_product = :G_PRODUCT_'
      '11013353=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '11013354=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECEI' +
        'PT)'
      '11013355=                                 FROM SKLAD DD'
      
        '11013356=                                WHERE DD.g_product = :G' +
        '_PRODUCT_'
      
        '11013357=                                  AND DD.G_TOCHKA = :G_' +
        'TOCHKA_'
      
        '11013358=                                  AND DD.IS_VOZVRAT IN ' +
        '(0, 4)'
      '11013359=                                )'
      '11013360=        ORDER BY 1 DESC'
      '11013361=        ROWS 1 TO 1'
      '11013362=        INTO :PRICE_;'
      '11013363='
      
        '11013364=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045#1058 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048 +
        '" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '11013365=      IF (ROW_COUNT = 0) THEN'
      '11013366=        SELECT S.PRICE'
      '11013367=          FROM SKLAD S'
      '11013368=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '11013369=                            FROM SKLAD SS'
      
        '11013370=                           WHERE /*SS.G_TOCHKA = :G_TOC' +
        'HKA_'
      
        '11013371=                             AND */SS.G_PRODUCT = :G_PR' +
        'ODUCT_'
      
        '11013372=                             AND SS.DATE_RECEIPT = (SEL' +
        'ECT MAX(SSS.DATE_RECEIPT)'
      
        '11013373=                                                      F' +
        'ROM SKLAD SSS'
      
        '11013374=                                                     WH' +
        'ERE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '11013375=                                                       ' +
        'AND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '11013376=                                                       ' +
        'AND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '11013377=                                                   )'
      
        '11013378=                             AND SS.IS_VOZVRAT IN (0, 4' +
        ') --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '11013379=                         )'
      '11013380=          INTO :PRICE_;'
      '11013381=    END ELSE BEGIN'
      '11013382=        IF (FORMULA_ = 0) THEN'
      '11013383=            CNT_ = 5;'
      '11013384=        ELSE'
      '11013385=            CNT_ = 200;'
      '11013386='
      
        '11013387=        SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOU' +
        'NT), 2)'
      '11013388=        FROM (SELECT S.AMOUNT, S.PRICE'
      '11013389=                FROM SKLAD_PARENT SP,'
      '11013390=                     SKLAD S'
      '11013391=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '11013392=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '11013393=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '11013394=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '11013395=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.I' +
        'S_VOZVRAT IN (0, 3, 4)'
      
        '11013396=                ORDER BY S.DATE_RECEIPT DESC, S.SKLAD D' +
        'ESC ROWS 1 TO :CNT_) T'
      '11013397=        INTO :PRICE_;'
      '11013398='
      
        '11013399=        -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056 +
        #1045#1058' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048 +
        '" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '110133100=        IF (PRICE_ IS NULL) THEN'
      
        '110133101=            SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T' +
        '.AMOUNT), 2)'
      '110133102=            FROM (SELECT S.AMOUNT, S.PRICE'
      '110133103=                    FROM SKLAD_PARENT SP,'
      '110133104=                         SKLAD S'
      
        '110133105=                   WHERE SP.DATE_RECEIPT <= CURRENT_DA' +
        'TE'
      '110133106=                     AND SP.SKLAD = S.SKLAD_PARENT'
      '110133107=                     AND S.G_PRODUCT = :G_PRODUCT_'
      
        '110133108=                     AND SP.IS_VOZVRAT IN (0, 4) --AND' +
        ' SP.IS_VOZVRAT IN (0, 3, 4)'
      
        '110133109=                    ORDER BY S.DATE_RECEIPT DESC, S.SK' +
        'LAD DESC ROWS 1 TO :CNT_) T'
      '110133110=              INTO :PRICE_;'
      '110133111=        END'
      '110133112=  END'
      '110133113='
      '110133114=  PRICE_ = COALESCE(:PRICE_, 0);'
      '110133115=  SUSPEND;'
      '110133116=END'
      '110133117=;'
      '110133118='
      '110133119=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '110133120=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110133121=  INCLUDE_NOL_ INTEGER,'
      '110133122=  INCLUDE_FEW_ INTEGER,'
      '110133123=  SORT_BY_NAME_ INTEGER,'
      '110133124=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110133125=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110133126=RETURNS ('
      '110133127=  PERIOD_ VARCHAR(40),'
      '110133128=  ROW_NUM VARCHAR(15),'
      '110133129=  ARTICUL VARCHAR(1000),'
      '110133130=  BARCODE VARCHAR(30),'
      
        '110133131=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110133132=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110133133=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110133134=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110133135=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110133136=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110133137=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110133138=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110133139=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110133140=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110133141=  TOVAR_NAME VARCHAR(250),'
      '110133142=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110133143=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110133144=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110133145=  ERR_CODE INTEGER,'
      '110133146=  ERR_MSG VARCHAR(1024))'
      '110133147=AS'
      
        '110133148=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110133149=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110133150=DECLARE VARIABLE I INTEGER = 1;'
      '110133151=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110133152=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110133153=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110133154=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110133155=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110133156=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110133157=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110133158=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110133159=BEGIN'
      '110133160='
      
        '110133161=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110133162=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110133163='
      '110133164=  SELECT S.S_VALUE,'
      '110133165=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110133166=    FROM SYSTEM_SETUP S'
      '110133167=   WHERE S.SYSTEM_SETUP = 1'
      '110133168=    INTO :FORMULA_,'
      '110133169=         :PRIHOD_CNT_;'
      '110133170='
      '110133171=  FOR SELECT GP.PATH,'
      '110133172=             GP.G_PRODUCT'
      '110133173=        FROM P_REP_TREE GP'
      '110133174=       WHERE EXISTS (SELECT 1'
      '110133175=                       FROM G_PRODUCT'
      '110133176=                      WHERE IS_CATEGORY = 0'
      
        '110133177=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110133178=                    )'
      
        '110133179=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110133180=              OR'
      '110133181=              (:G_CATEGORY_ is NULL)'
      '110133182=             )'
      '110133183=       ORDER BY 1, 2'
      '110133184=       INTO :PATH_NAME_,'
      '110133185=            :G_PRODUCT_'
      '110133186=  DO BEGIN'
      
        '110133187=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110133188=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110133189=      SELECT COUNT(G.G_PRODUCT)'
      
        '110133190=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110133191=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110133192=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110133193=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110133194=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110133195=              OR'
      
        '110133196=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110133197=              or'
      
        '110133198=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110133199=             )'
      '110133200=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110133201=         AND ((EXISTS (SELECT 1'
      '110133202=                       FROM SKLAD S'
      '110133203=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110133204=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110133205=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110133206=              OR'
      '110133207=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110133208=        INTO :CNT_;'
      '110133209='
      '110133210=      IF (CNT_ > 0) THEN BEGIN'
      
        '110133211=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110133212=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110133213='
      
        '110133214=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110133215=                                              ARTICUL,'
      '110133216=                                              BARCODE,'
      
        '110133217=                                              NOMENCLA' +
        'TUR_NUM,'
      '110133218=                                              NAME,'
      
        '110133219=                                              UNIT_NAM' +
        'E,'
      '110133220=                                              PRICE,'
      
        '110133221=                                              VOLUME_P' +
        'RICE,'
      '110133222=                                              AMOUNT,'
      
        '110133223=                                              AMOUNT_R' +
        'ESERVE,'
      '110133224=                                              SUMM,'
      
        '110133225=                                              PRICE_SE' +
        'LF,'
      
        '110133226=                                              SORT_COL' +
        ','
      
        '110133227=                                              IS_CATEG' +
        'ORY,'
      '110133228=                                              NOTE,'
      
        '110133229=                                              CROSSCOD' +
        'E)'
      
        '110133230=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110133231=                 G.ARTICUL,'
      '110133232=                 G.BARCODE,'
      '110133233=                 G.NOMENCLATUR_NUM,'
      '110133234=                 G.NAME,'
      '110133235=                 U.SHORT_NAME,'
      '110133236=                 G.PRICE,'
      '110133237=                 G.VOLUME_PRICE,'
      '110133238=                 COALESCE(S.AMOUNT, 0),'
      '110133239=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110133240=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110133241=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110133242=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110133243=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110133244=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110133245=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110133246=                  DECODE(:FORMULA_,'
      '110133247=                         1,'
      '110133248=                         (SELECT S.PRICE'
      '110133249=                            FROM SKLAD S'
      
        '110133250=                           WHERE S.SKLAD = (SELECT MAX' +
        '(SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST' +
        ' = 1'
      
        '110133251=                                              FROM SKL' +
        'AD SS'
      
        '110133252=                                             WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39
      
        '110133253=                                               AND SS.' +
        'G_PRODUCT = G.G_PRODUCT'
      
        '110133254=                                               AND SS.' +
        'IS_LAST = 1)'
      '110133255=                         ),'
      
        '110133256=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110133257=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110133258=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110133259=                                         SKLAD S'
      
        '110133260=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110133261=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110133262=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110133263=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110133264=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110133265=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110133266=                         )), 0) spr,'
      
        '110133267=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110133268=                 0'
      '110133269=                 ,G.NOTE'
      
        '110133270=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      
        '110133271=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110133272=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110133273=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110133274=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110133275=             AND G.IS_CATEGORY = 0'
      '110133276=             AND G.is_active = 1'
      '110133277=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110133278=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110133279=                  OR'
      
        '110133280=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110133281=                  or'
      
        '110133282=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110133283=                 )'
      '110133284=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110133285=             AND ((EXISTS (SELECT 1'
      '110133286=                           FROM SKLAD S'
      
        '110133287=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110133288=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110133289=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110133290=                  OR'
      '110133291=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110133292=           ORDER BY 13;'
      '110133293=      END'
      '110133294=  END'
      '110133295='
      
        '110133296=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110133297='
      
        '110133298=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AMO' +
        'UNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '110133299=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110133300=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110133301=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE,' +
        ' :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_C' +
        'ATEGORY, :TOVAR_NAME'
      '110133302=  DO BEGIN'
      '110133303=    I = I + 1;'
      '110133304=    SUSPEND;'
      '110133305=  END'
      '110133306=WHEN ANY DO BEGIN'
      '110133307=    Err_code = -20500;'
      
        '110133308=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110133309=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110133310=  END'
      '110133311=end'
      '110133312=;'
      '110133313='
      '110133314=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110133315=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110133316=  INCLUDE_NOL_ INTEGER,'
      '110133317=  INCLUDE_FEW_ INTEGER,'
      '110133318=  SORT_BY_NAME_ INTEGER,'
      '110133319=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110133320=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110133321=RETURNS ('
      '110133322=  PERIOD_ VARCHAR(40),'
      '110133323=  ROW_NUM VARCHAR(15),'
      '110133324=  ARTICUL VARCHAR(1000),'
      '110133325=  BARCODE VARCHAR(30),'
      
        '110133326=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110133327=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110133328=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110133329=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110133330=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110133331=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110133332=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110133333=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110133334=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110133335=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110133336=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110133337=  TOVAR_NAME VARCHAR(250),'
      '110133338=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110133339=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110133340=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110133341=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110133342=  ERR_CODE INTEGER,'
      '110133343=  ERR_MSG VARCHAR(1024))'
      '110133344=AS'
      '110133345=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '110133346=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110133347=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110133348=DECLARE VARIABLE I INTEGER = 1;'
      '110133349=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110133350=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110133351=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110133352=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110133353=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110133354=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110133355=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110133356=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110133357=BEGIN'
      '110133358='
      
        '110133359=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110133360=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110133361='
      '110133362=  SELECT S.S_VALUE,'
      '110133363=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110133364=    FROM SYSTEM_SETUP S'
      '110133365=   WHERE S.SYSTEM_SETUP = 1'
      '110133366=    INTO :FORMULA_,'
      '110133367=         :PRIHOD_CNT_;'
      '110133368='
      '110133369=  FOR SELECT GP.PATH,'
      '110133370=             GP.G_PRODUCT'
      '110133371=        FROM P_REP_TREE GP'
      '110133372=       WHERE EXISTS (SELECT 1'
      '110133373=                       FROM G_PRODUCT'
      '110133374=                      WHERE IS_CATEGORY = 0'
      
        '110133375=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110133376=                    )'
      
        '110133377=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110133378=              OR'
      '110133379=              (:G_CATEGORY_ is NULL)'
      '110133380=             )'
      '110133381=       ORDER BY 1, 2'
      '110133382=       INTO :PATH_NAME_,'
      '110133383=            :G_PRODUCT_'
      '110133384=  DO BEGIN'
      
        '110133385=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110133386=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110133387=      SELECT COUNT(G.G_PRODUCT)'
      
        '110133388=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110133389=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110133390=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110133391=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110133392=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110133393=              OR'
      
        '110133394=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110133395=              or'
      
        '110133396=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110133397=             )'
      '110133398=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110133399=         AND ((EXISTS (SELECT 1'
      '110133400=                       FROM SKLAD S'
      '110133401=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110133402=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110133403=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110133404=              OR'
      '110133405=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110133406=        INTO :CNT_;'
      '110133407='
      '110133408=      IF (CNT_ > 0) THEN BEGIN'
      
        '110133409=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110133410=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110133411='
      
        '110133412=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110133413=                                              ARTICUL,'
      '110133414=                                              BARCODE,'
      
        '110133415=                                              NOMENCLA' +
        'TUR_NUM,'
      '110133416=                                              NAME,'
      
        '110133417=                                              UNIT_NAM' +
        'E,'
      '110133418=                                              PRICE,'
      
        '110133419=                                              VOLUME_P' +
        'RICE,'
      
        '110133420=                                              SKIDKA_P' +
        'RICE,'
      '110133421=                                              AMOUNT,'
      
        '110133422=                                              AMOUNT_R' +
        'ESERVE,'
      '110133423=                                              SUMM,'
      
        '110133424=                                              PRICE_SE' +
        'LF,'
      
        '110133425=                                              SORT_COL' +
        ','
      
        '110133426=                                              IS_CATEG' +
        'ORY,'
      '110133427=                                              NOTE,'
      
        '110133428=                                              CROSSCOD' +
        'E,'
      '110133429=                                              PLACE)'
      
        '110133430=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110133431=                 G.ARTICUL,'
      '110133432=                 G.BARCODE,'
      '110133433=                 G.NOMENCLATUR_NUM,'
      '110133434=                 G.NAME,'
      '110133435=                 U.SHORT_NAME,'
      '110133436=                 G.PRICE,'
      '110133437=                 G.VOLUME_PRICE,'
      '110133438=                 G.PRICE - GD.SKIDKA_SUM,'
      '110133439=                 COALESCE(S.AMOUNT, 0),'
      '110133440=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110133441=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110133442=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110133443=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110133444=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110133445=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110133446=                  DECODE(:FORMULA_,'
      '110133447=                         1,'
      '110133448=                         (SELECT S.PRICE'
      '110133449=                            FROM SKLAD S'
      
        '110133450=                           WHERE S.SKLAD = (SELECT MAX' +
        '(SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST' +
        ' = 1'
      
        '110133451=                                              FROM SKL' +
        'AD SS'
      
        '110133452=                                             WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39
      
        '110133453=                                               AND SS.' +
        'G_PRODUCT = G.G_PRODUCT'
      
        '110133454=                                               AND SS.' +
        'IS_LAST = 1)'
      '110133455=                         ),'
      
        '110133456=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110133457=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110133458=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110133459=                                         SKLAD S'
      
        '110133460=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110133461=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110133462=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110133463=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110133464=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110133465=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '110133466=                        )), 0) spr,'
      
        '110133467=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110133468=                 0'
      '110133469=                 ,G.NOTE'
      
        '110133470=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110133471=                 ,G.PLACE'
      
        '110133472=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '110133473=                                                FROM G' +
        '_DISCOUNT D'
      
        '110133474=                                                WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110133475=                                                      ' +
        '  AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '110133476=                                                      ' +
        '  AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '110133477=                                                      ' +
        ')'
      
        '110133478=                                                      ' +
        'OR'
      
        '110133479=                                                      ' +
        '(D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '110133480=                                                 AND (' +
        '(:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '110133481=                                                     O' +
        'R'
      
        '110133482=                                                     (' +
        'D.G_TOCHKA IS NULL))'
      
        '110133483=                                              ) GD ON ' +
        'G.G_PRODUCT = GD.G_PRODUCT'
      
        '110133484=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110133485=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110133486=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110133487=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110133488=             AND G.IS_CATEGORY = 0'
      '110133489=             AND G.is_active = 1'
      '110133490=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110133491=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110133492=                  OR'
      
        '110133493=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110133494=                  or'
      
        '110133495=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110133496=                 )'
      '110133497=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110133498=             AND ((EXISTS (SELECT 1'
      '110133499=                           FROM SKLAD S'
      
        '110133500=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110133501=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110133502=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110133503=                  OR'
      '110133504=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110133505=           ORDER BY 14;'
      '110133506=      END'
      '110133507=  END'
      '110133508='
      
        '110133509=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110133510='
      
        '110133511=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKID' +
        'KA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE' +
        '_SELF, IS_CATEGORY,'
      '110133512=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110133513=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110133514=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLU' +
        'ME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE' +
        '_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110133515=  DO BEGIN'
      '110133516=    I = I + 1;'
      '110133517=    SUSPEND;'
      '110133518=  END'
      '110133519='
      '110133520=     /*'
      '110133521=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110133522='
      '110133523=     SELECT :I,'
      
        '110133524=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110133525=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110133526=             U.SHORT_NAME UNIT_NAME,'
      '110133527=             SS.PRICE,'
      '110133528=             SS.VOLUME_PRICE,'
      '110133529=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110133530=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110133531=             SS.IS_CATEGORY'
      '110133532=        FROM (WITH RECURSIVE TREE'
      '110133533=              AS (SELECT T.G_PRODUCT,'
      '110133534=                       T.NAME AS ARTICUL,'
      
        '110133535=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110133536=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110133537=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110133538=                       T.IS_CATEGORY,'
      '110133539=                       NULL G_UNIT'
      '110133540=                  FROM G_PRODUCT T'
      '110133541=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110133542=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110133543=                UNION ALL'
      '110133544=                SELECT T.G_PRODUCT,'
      '110133545=                       DECODE(T. T.ARTICUL,'
      '110133546=                       T.NAME,'
      '110133547=                       T.PRICE,'
      '110133548=                       T.VOLUME_PRICE,'
      '110133549=                       T.IS_CATEGORY,'
      '110133550=                       T.G_UNIT'
      
        '110133551=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110133552=                 WHERE T.IS_ACTIVE = 1'
      '110133553=                )'
      '110133554=             SELECT * FROM TREE) SS'
      
        '110133555=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110133556=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110133557=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110133558=    INTO :ROW_NUM,'
      '110133559=        :ARTICUL,'
      '110133560=        :NAME,'
      '110133561=        :UNIT_NAME,'
      '110133562=        :PRICE,'
      '110133563=        :VOLUME_PRICE,'
      '110133564=        :SKIDKA_PRICE,'
      '110133565=        :AMOUNT,'
      '110133566=        :IS_CATEGORY'
      '110133567=    DO BEGIN'
      '110133568=      I = I + 1;'
      '110133569=      SUSPEND;'
      '110133570=    END  */'
      '110133571=WHEN ANY DO BEGIN'
      '110133572=    Err_code = -20500;'
      
        '110133573=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110133574=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110133575=  END'
      '110133576=end'
      '110133577=;'
      
        '110133578=UPDATE SYSTEM_SETUP SET S_VALUE = 110133 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110133579=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
