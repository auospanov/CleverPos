        ',   --NOTE_ => :NOTE_,'
      
        '110402709=                                                  :ZAK' +
        'AZ_,   --ZAKAZ_'
      
        '110402710=                                                  NULL' +
        ','
      
        '110402711=                                                  :G_P' +
        'AYMENT_TYPE_,'
      
        '110402712=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110402713=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402714=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110402715=                      EXIT;'
      '110402716=                    END'
      '110402717=                END'
      '110402718=            END'
      
        '110402719=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058 +
        #1068#1048
      
        '110402720=            --========================================' +
        '========================='
      '110402721=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '110402722=  END'
      '110402723=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '110402724=  ----------------------------------------------------' +
        '-----------'
      
        '110402725=  --**************************************************' +
        '***********'
      
        '110402726=  ----------------------------------------------------' +
        '-----------'
      '110402727=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110402728=  ELSE BEGIN'
      '110402729=      PNT_ = '#39#39'020'#39#39';'
      '110402730=      SELECT SP.G_TOCHKA,'
