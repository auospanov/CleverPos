        ' "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
        '110202300=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, ' +
        '0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0);'#39';'
      
        '110202301=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110202302=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202303=    END'
      '110202304=    */'
      '110202305=  END'
      '110202306='
      
        '110202307=  ----------------------------------------------------' +
        '------------------'
      
        '110202308=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056 +
        #1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110202309=  PNT_ = '#39'01'#39';'
      '110202310=  SELECT K.OUTPUT'
      '110202311=    FROM KASSA_BEZNAL_STATE K'
      '110202312=   WHERE K.K_DATE = :ACTION_DATE_'
      '110202313=    INTO :OUTPUT_;'
      '110202314='
      
        '110202315=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040#1041 +
        #1051#1048#1062#1059' LOGS'
      
        '110202316=  -- '#1045#1057#1051#1048' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067' '#1048#1047#1052#1045#1053#1045#1053#1048#1045', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040' '#1044#1056#1059#1043#1054#1052 +
        ' '#1050#1054#1052#1055#1045' '#1058#1054#1046#1045' '#1047#1040#1055#1059#1057#1050#1040#1058#1068' K_RECALC_KASSA'
      
        '110202317=  -- '#1058#1045#1055#1045#1056#1068', '#1055#1056#1048' '#1050#1040#1046#1044#1054#1052' '#1048#1047#1052#1045#1053#1045#1053#1048#1048' '#1041#1059#1044#1045#1058' '#1042' LOG '#1055#1040#1044#1040#1058#1068' '#1057 +
        #1058#1056#1054#1050#1040' "EXECUTE K_RECALC_KASSA" - '#1069#1058#1054' '#1053#1045#1055#1056#1048#1045#1052#1051#1045#1052#1054','
      
        '110202318=  -- '#1044#1056#1059#1043#1054#1049' '#1050#1054#1052#1055' '#1052#1054#1046#1045#1058' '#1053#1045' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1048#1053#1060#1059' '#1053#1045#1044#1045#1051#1071#1052#1048', '#1057#1054#1054#1058 +
        #1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1053#1059#1046#1053#1054', '#1063#1058#1054#1041#1067' '#1041#1067#1051#1040' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' '#1048' '#1047#1040#1055#1059#1057#1050#1040#1051#1040#1057#1068' '#1054#1053 +
        #1040
      '110202319=  -- '#1042' '#1050#1054#1053#1062#1045' SYNC_DOWNLOAD '#1054#1044#1048#1053' '#1056#1040#1047'.'
      
        '110202320=  -- '#1044#1051#1071' '#1069#1058#1054#1043#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1042' LOG "EXECU' +
        'TE K_RECALC_KASSA" '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_TRANSFERED = 0 '#1048' '#1047#1040#1052#1045#1053#1071#1058#1068' '#1045#1045' '#1045 +
        #1057#1051#1048' '#1053#1059#1046#1053#1054
      
        '110202321=  -- '#1055#1054' '#1059#1052#1059' '#1053#1059#1046#1053#1054' '#1041#1067' '#1059#1044#1040#1051#1071#1058#1068' "EXECUTE K_RECALC_KASSA" ' +
        #1057' '#1044#1040#1058#1054#1049' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1063#1058#1054#1041#1067' '#1053#1045' '#1041#1067#1051#1054' '#1044#1042#1054#1049#1053#1054#1043#1054' '#1055#1045#1056#1045#1057#1063#1045#1058#1040', '#1053#1054' '#1058#1040#1052 +
        ' '#1058#1054#1043#1044#1040
      
        '110202322=  -- '#1053#1059#1046#1053#1054' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1044#1040#1058#1067' '#1048' G_TOCHKA - '#1069#1058#1054' '#1042#1057#1045' '#1057#1051#1048#1064#1050#1054 +
        #1052' '#1057#1051#1054#1046#1053#1054
      
        '110202323=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_S' +
        'ETUP = 5) > 0 AND (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39') ' +
        'IS NULL)) THEN BEGIN'
      
        '110202324=    SQL_STMT_ = '#39'EXECUTE BLOCK AS DECLARE VARIABLE ERR' +
        '_CODE INTEGER;DECLARE VARIABLE ERR_MSG VARCHAR(1024); BEGIN '#39'||'
      
        '110202325=      '#39' EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL('#39#39#39'||:' +
        'ACTION_DATE_||'#39#39#39') RETURNING_VALUES :ERR_CODE, :ERR_MSG; END'#39';'
      '110202326='
      
        '110202327=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1059#1044#1040#1051#1071#1070', '#1045#1057#1051#1048' '#1059#1046#1045' '#1041#1067#1051#1040' '#1054#1058#1055#1056#1040#1042#1050#1040' '#1055 +
        #1045#1056#1045#1057#1063#1045#1058#1040' '#1047#1040' '#1069#1058#1059' '#1044#1040#1058#1059
      '110202328=    DELETE FROM LOGS'
      '110202329=      WHERE SQLSTMT = :SQL_STMT_'
      '110202330=        AND IS_TRANSFERED = 0'
      '110202331=        AND USR = '#39'SYSDBA'#39';'
      '110202332='
      
        '110202333=    INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR, IS_TRA' +
        'NSFERED, SYSDATE, ERR_CODE)'
      
        '110202334=    VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'KASSA_ST' +
        'ATE_BEZNAL'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202335=  END'
      '110202336='
      '110202337=  PNT_ = '#39'02'#39';'
      '110202338=  FOR SELECT K.K_DATE'
      '110202339=        FROM KASSA_BEZNAL_STATE K'
      '110202340=       WHERE K.K_DATE > :ACTION_DATE_'
      '110202341=      ORDER BY K.K_DATE, K.KASSA_BEZNAL_STATE'
      '110202342=        INTO :K_DATE_'
      '110202343=  DO BEGIN'
      '110202344=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110202345=    UPDATE KASSA_BEZNAL_STATE K'
      '110202346=       SET K.INPUT = :OUTPUT_,'
      
        '110202347=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE' +
        '(K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '110202348=     WHERE K.K_DATE = :K_DATE_;'
      '110202349='
      
        '110202350=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202351=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110202352=      SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      '110202353=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '110202354=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, ' +
        '0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '110202355=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39';' +
        #39';'
      
        '110202356=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110202357=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202358=    END'
      '110202359=    */'
      '110202360='
      '110202361=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110202362=    SELECT K.OUTPUT'
      '110202363=      FROM KASSA_BEZNAL_STATE K'
      '110202364=     WHERE K.K_DATE = :K_DATE_'
      '110202365=      INTO :OUTPUT_;'
      '110202366=  END'
      '110202367='
      '110202368=WHEN ANY DO BEGIN'
      '110202369=    Err_code = -20500;'
      
        '110202370=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110202371=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110202372=  END'
      '110202373=end'
      '110202374=;'
      '110202375='
      '110202376=ALTER PROCEDURE K_UPD_KASSA_STATE('
      '110202377=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110202378=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110202379=  DEBET_ MY_NUMERIC,'
      '110202380=  CREDIT_ MY_NUMERIC,'
      '110202381=  NAL_BEZNAL_ INTEGER,'
      '110202382=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110202383=RETURNS ('
      '110202384=  ERR_CODE INTEGER,'
      '110202385=  ERR_MSG VARCHAR(1024))'
      '110202386=AS'
      
        '110202387=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_UPD_KASSA_S' +
        'TATE'#39';'
      '110202388=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110202389=DECLARE VARIABLE INPUT_ MY_NUMERIC = 0;'
      '110202390=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '110202391=BEGIN'
      '110202392='
      '110202393=  PNT_ = '#39'01'#39';'
      '110202394=  -- '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067
      '110202395=  IF (NAL_BEZNAL_ = 1) THEN BEGIN'
      '110202396=      UPDATE KASSA_STATE K'
      
        '110202397=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE' +
        '(:DEBET_, 0),'
      
        '110202398=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALES' +
        'CE(:CREDIT_, 0),'
      
        '110202399=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALES' +
        'CE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) ' +
        '+ COALESCE(:CREDIT_, 0)),'
      '110202400=             K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110202401=       WHERE K.K_DATE = :ACTION_DATE_'
      '110202402=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '110202403='
      
        '110202404=      IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053 +
        #1071' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '110202405=        -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '110202406=        PNT_ = '#39'02'#39';'
      '110202407=        BEGIN'
      '110202408=            SELECT K.OUTPUT'
      '110202409=              FROM KASSA_STATE K'
      '110202410=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '110202411=                                 FROM KASSA_STATE S'
      
        '110202412=                                WHERE S.K_DATE < :ACTI' +
        'ON_DATE_'
      
        '110202413=                                  AND S.G_TOCHKA = :G_' +
        'TOCHKA_)'
      '110202414=               AND K.G_TOCHKA = :G_TOCHKA_'
      '110202415=            INTO :INPUT_;'
      '110202416='
      '110202417=            if (ROW_COUNT = 0) then'
      
        '110202418=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055 +
        #1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '110202419=        WHEN ANY DO'
      '110202420=          BEGIN'
      '110202421=            Err_Code = -20500;'
      
        '110202422=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054 +
        #1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      
        '110202423=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110202424=            EXIT;'
      '110202425=          END'
      '110202426=        END'
      '110202427='
      '110202428=        PNT_ = '#39'03'#39';'
      '110202429=        INSERT INTO KASSA_STATE'
      '110202430=          (KASSA_STATE, K_DATE,'
      '110202431=           INPUT, DEBET, CREDIT, OUTPUT,'
      '110202432=           G_TOCHKA, NEED_TO_EXPORT)'
      '110202433=        VALUES'
      '110202434=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_,'
      
        '110202435=          COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), ' +
        'COALESCE(:CREDIT_, 0), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, ' +
        '0) + COALESCE(:CREDIT_,0),'
      '110202436=          :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110202437='
      
        '110202438=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048 +
        #1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202439=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
        'STEM_SETUP = 5) > 0) THEN BEGIN'
      '110202440=            SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110202441=                       '#39'USING (select CAST('#39#39#39'||ACTION' +
        '_DATE_||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '110202442=                       '#39' from RDB$DATABASE) cd '#39'||'
      
        '110202443=                       '#39'ON (c.K_DATE = cd.K_DATE AND C' +
        '.G_TOCHKA = CD.G_TOCHKA) '#39'||'
      '110202444=                       '#39'WHEN MATCHED THEN '#39'||'
      '110202445=                       '#39' UPDATE SET '#39'||'
      
        '110202446=                       '#39'  C.INPUT  = COALESCE((SELECT ' +
        '"OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110202447=                                                      ' +
        '                                          '#39' FROM KASSA_STATE '#39'||'
      
        '110202448=                                                      ' +
        '                                          '#39' WHERE K_DATE < CD.K_' +
        'DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110202449=                                                      ' +
        '                                          '#39' AND G_TOCHKA = CD.G_' +
        'TOCHKA), 0), '#39'||'
      
