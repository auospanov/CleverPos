        'RICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39') *  P.VES_GRAMM'#39';'
      '110237200='
      '110237201=          --'#1048#1047#1052#1045#1053#1048#1058#1068' '#1055#1054' '#1042#1040#1051#1070#1058#1045
      '110237202=          ELSE IF (MODE_ = 4) THEN'
      
        '110237203=            SQL_STR_ = SQL_STR_ ||'#39'P.VES_GRAMM_PRICE =' +
        ' ROUND(P.VES_GRAMM_PRICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39 +
        ', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110237204=                       '#39' P.PRICE = ROUND(P.VES_GRAMM_P' +
        'RICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39') *  ' +
        'P.VES_GRAMM'#39';'
      '110237205='
