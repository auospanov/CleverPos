      '1102012541=              :COST_PRICE,'
      '1102012542=              :SALES_COMM_,'
      '1102012543=              :MARK_CODE_'
      '1102012544=      DO BEGIN'
      
        '1102012545=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102012546=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1102012547=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1102012548=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102012549=        END'
      '1102012550='
      '1102012551=        INSERT INTO ZAKAZ_DETAILS'
      '1102012552=        VALUES('
      '1102012553=          :ZAKAZ_DETAILS_TMP_,'
      '1102012554=          :ZAKAZ_,'
      '1102012555=          :G_PRODUCT,'
      '1102012556=          :AMOUNT,'
      '1102012557=          :PRICE,'
      '1102012558=          :SUMM,'
      '1102012559=          :DISCOUNT_PERC,'
      '1102012560=          :DISCOUNT_TENGE,'
      '1102012561=          :DISCOUNT_SUMM,'
      '1102012562=          :NDS,'
      '1102012563=          :NDS_SUMM,'
      '1102012564=          :COST_PRICE,'
      '1102012565=          :SALES_COMM_SUMM_ITER_,'
      '1102012566=          :MARK_CODE_'
      '1102012567=        );'
      '1102012568='
      
        '1102012569=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1102012570=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1102012571=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1102012572=                UPDATE LT_SKLAD_PRODUCT L'
      '1102012573=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102012574=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_  -- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051 +
        #1067' '#1055#1056#1048#1061#1054#1044', '#1061#1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102012575=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102012576=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102012577='
      '1102012578=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1102012579=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102012580=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057 +
        #1051#1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102012581=                -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048 +
        #1071' ('#1053#1040#1055#1056#1048#1052#1045#1056' '#1052#1054#1041#1048#1051#1040'), '#1058#1054' '#1053#1040' '#1052#1048#1053#1059#1057' '#1053#1045' '#1055#1056#1054#1042#1045#1056#1071#1070
      '1102012582=                PNT_ = '#39'04'#39';'
      
        '1102012583=                IF (ROW_COUNT = 0 AND ((SELECT S_VALU' +
        'E FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) AND REC_ID_ IS ' +
        'NULL) then BEGIN'
      '1102012584=                  Err_Code = -20500;'
      
        '1102012585=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_C' +
        'ODE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_' +
        'PRODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072 +
        #1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102012586=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102012587=                  EXIT;'
      '1102012588=                END ELSE if (ROW_COUNT = 0) then'
      
        '1102012589=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102012590=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);  -' +
        '- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067' '#1055#1056#1048#1061#1054#1044', '#1061 +
        #1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102012591=            END'
      '1102012592='
      '1102012593=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102012594=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102012595=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102012596=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :AMOUNT'
      '1102012597=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102012598=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102012599='
      '1102012600='
      '1102012601=        END'
      '1102012602=      END'
      '1102012603='
      '1102012604=      ----------------------------------------'
      
        '1102012605=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1102012606=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1102012607=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1102012608='
      
        '1102012609=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1102012610=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1102012611=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1102012612=                PNT_ = '#39'05'#39';'
      
        '1102012613=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1102012614=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1102012615=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1102012616=                                              :Z_DATE' +
        '_,'
      
        '1102012617=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102012618=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1102012619=                                              NULL,'
      
        '1102012620=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1102012621=                                              :G_TOCH' +
        'KA_,'
      
        '1102012622=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102012623=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102012624=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102012625=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102012626=                  EXIT;'
      '1102012627=                END'
      '1102012628=            END'
      '1102012629='
      '1102012630=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1102012631=        END ELSE BEGIN'
      '1102012632=            PNT_ = '#39'06'#39';'
      
        '1102012633=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1102012634=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1102012635=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1102012636=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102012637=                ELSE'
      
        '1102012638=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102012639='
      
        '1102012640=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1102012641=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102012642='
      
        '1102012643=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102012644='
      '1102012645=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102012646=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102012647=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1102012648=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1102012649=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1102012650=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1102012651=                                                  :ZA' +
        'KAZ_,'
      
        '1102012652=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1102012653=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1102012654=                                                  :G_' +
        'TOCHKA_,'
      
        '1102012655=                                                  :UP' +
        'LOAD_TO_EXT_APP_'
      
        '1102012656=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102012657=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102012658=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1102012659=                      EXIT;'
      '1102012660=                    END'
      '1102012661=                END'
      '1102012662=            END'
      '1102012663=        END'
      '1102012664=      END'
      '1102012665='
      
        '1102012666=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1102012667=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1102012668=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1102012669=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1102012670=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1102012671=          UPDATE G_DISCONT_CARD D'
      
        '1102012672=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1102012673=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1102012674=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1102012675=          RETURNING'
      '1102012676=            D.SUMM_ALL'
      '1102012677=          INTO'
      '1102012678=            :CLIENT_SUMM_ALL_;'
      '1102012679='
      '1102012680=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1102012681=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1102012682=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1102012683=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1102012684=          ORDER BY G.SUMM_FROM'
      '1102012685=          ROWS 1 TO 1'
      '1102012686=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1102012687='
      '1102012688=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1102012689=            UPDATE G_CLIENT G'
      '1102012690=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1102012691=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1102012692=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1102012693='
      '1102012694=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1102012695=            UPDATE G_DISCONT_CARD D'
      '1102012696=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1102012697=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1102012698=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1102012699=      END'
      '1102012700='
      
        '1102012701=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' ' +
        #1057' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', ' +
        #1050#1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '1102012702=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057 +
        #1051#1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102012703=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102012704=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102012705=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102012706=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1102012707=      PNT_ = '#39'07'#39';'
      
        '1102012708=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THE' +
        'N BEGIN'
      '1102012709=        SELECT S.S_VALUE'
      '1102012710=          FROM SYSTEM_SETUP S'
      '1102012711=         WHERE S.SYSTEM_SETUP = 4'
      '1102012712=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102012713='
      '1102012714=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102012715=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102012716=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102012717='
      
        '1102012718=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1102012719=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1102012720=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1102012721='
      '1102012722=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102012723=        ELSE'
      
        '1102012724=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1102012725='
      '1102012726=        KASSA_ZP_ID_ = NULL;'
      '1102012727=        SELECT K.KASSA, K.SUMM'
      '1102012728=        FROM KASSA K'
      '1102012729=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1102012730=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102012731=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102012732=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102012733=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1102012734='
      
        '1102012735=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1102012736='
      '1102012737=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102012738=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102012739=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102012740=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1102012741=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1102012742=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1102012743=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1102012744=                                          NULL,     -' +
        '-:SKLAD_,'
      '1102012745=                                          1,'
      '1102012746=                                          :G_TOCHKA_,'
      
        '1102012747=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102012748=                                          :G_OFFICIAL' +
        '_'
      
        '1102012749=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1102012750=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102012751=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1102012752='
      '1102012753=        END ELSE BEGIN'
      
        '1102012754=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1102012755=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1102012756=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1102012757=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1102012758='
      
        '1102012759=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1102012760=                                          1,     -- A' +
        'CTION_'
      
        '1102012761=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102012762=                                          :SALES_COMM' +
        '_SUMM_ALL_,   --SUMM_'
      
        '1102012763=                                          :ACTION_DAT' +
