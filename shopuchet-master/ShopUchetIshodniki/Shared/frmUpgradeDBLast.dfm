        '1106011781=                 '#39#1055#1077#1088#1077#1084#1077#1097#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076' "'#39'||c.N' +
        'AME||'#39'"'#39','
      '1106011782=                 NULL,'
      '1106011783=                 NULL,'
      '1106011784=                 NULL,'
      '1106011785=                 S.PRICE,'
      '1106011786=                 S.AMOUNT,'
      '1106011787=                 S.SUMM'
      '1106011788=            FROM SKLAD_PARENT SP,'
      '1106011789=                 G_TOCHKA C,'
      '1106011790=                 SKLAD S,'
      '1106011791=                 G_PRODUCT G'
      
        '1106011792=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_' +
