      '110153207=    end else begin'
      '110153208=      CURR_STR_ = '#39' '#1090#1077#1085#1075#1077#39';'
      '110153209=      CURR_STR_KOP_ = '#39' '#1090#1080#1099#1085#39';'
      '110153210=    end'
      
        '110153211=      --**********************************************' +
        '**************'
      '110153212='
      
        '110153213=    curr_str = curr_str || CURR_STR_||'#39' '#39'|| cents ||CU' +
        'RR_STR_KOP_;'
      '110153214='
      
        '110153215=  end ELSE IF (Currency = -2) THEN begin   --'#1044#1051#1071' '#1044#1054#1042#1045#1056 +
        #1050#1048
      '110153216=    IF (cents = '#39'00'#39') THEN'
