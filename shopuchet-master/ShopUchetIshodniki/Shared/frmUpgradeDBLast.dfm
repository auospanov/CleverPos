      '1102503735=                END'
      '1102503736='
      
        '1102503737=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1102503738=            END'
      '1102503739='
      
        '1102503740=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1102503741=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1102503742=                FROM KASSA K'
      '1102503743=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1102503744=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
