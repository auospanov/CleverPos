      '110243602=    G_NONCASH_PAY_TYPE,'
      '110243603=    NAME, IS_TIS_TYPE, POS_TERMINAL_TYPE)'
      '110243604=  VALUES ('
      '110243605=    GEN_ID(GEN_G_NONCASH_PAY_TYPE, 1),'
      '110243606=    :NAME_, :IS_TIS_TYPE_, :POS_TERMINAL_TYPE_'
      '110243607=  )'
