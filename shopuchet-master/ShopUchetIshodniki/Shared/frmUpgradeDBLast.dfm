      '110225984=     ,SUMM_CURRENCY'
      '110225985=     ,MARK_CODE'
      '110225986=     ,COST_PRICE'
      '110225987=    ) VALUES ('
      '110225988=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
