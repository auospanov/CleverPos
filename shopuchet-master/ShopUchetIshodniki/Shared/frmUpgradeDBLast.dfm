      '1106014449='
      '1106014450=ALTER PROCEDURE DEL_DETAILS_TMP('
      
        '1106014451=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS)'
      '1106014452=RETURNS ('
      '1106014453=  ERR_CODE INTEGER,'
      '1106014454=  ERR_MSG VARCHAR(1024))'
      '1106014455=AS'
      
        '1106014456=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_DETAILS_' +
        'TMP'#39';'
      '1106014457=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106014458=begin'
      '1106014459=  DELETE FROM ZAKAZ_DETAILS_TMP'
      '1106014460=  WHERE'
      
        '1106014461=    ZAKAZ_DETAILS = COALESCE(:ZAKAZ_DETAILS_, ZAKAZ_D' +
        'ETAILS);'
      '1106014462='
      '1106014463=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL'
      '1106014464=  WHERE'
      
        '1106014465=    ZAKAZ_DETAILS = COALESCE(:ZAKAZ_DETAILS_, ZAKAZ_D' +
        'ETAILS);'
      '1106014466='
      '1106014467=when sqlcode -530 DO'
      '1106014468=  begin'
      '1106014469=    ERR_CODE = -20500;'
      
        '1106014470=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106014471=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106014472=  end'
      '1106014473=end'
      '1106014474=;'
      '1106014475='
      '1106014476=ALTER PROCEDURE DEL_PRODUCT('
      '1106014477=  SKLAD_ TYPE OF COLUMN OTHER.SKLAD_PARENT_ID)'
      '1106014478=RETURNS ('
      '1106014479=  ERR_CODE INTEGER,'
      '1106014480=  ERR_MSG VARCHAR(1024))'
      '1106014481=AS'
      '1106014482=/*'
      
        '1106014483='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1106014484='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1106014485=*/'
      
        '1106014486=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DEL_PRODUCT' +
        #39';'
      '1106014487=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106014488=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1106014489=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PROD' +
        'UCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' */'
      
        '1106014490=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1106014491=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106014492=DECLARE VARIABLE ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.A' +
        'RRIVAL_TYPE;'
      
        '1106014493=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106014494=BEGIN'
      '1106014495='
      '1106014496=  PNT_ = '#39'00'#39';'
      '1106014497=  SELECT O.G_TOCHKA'
      '1106014498=    FROM SKLAD_PARENT O'
      '1106014499=   WHERE O.SKLAD = :SKLAD_'
      '1106014500=    INTO :G_TOCHKA_;'
      '1106014501='
      '1106014502=  FOR SELECT D.AMOUNT'
      '1106014503=            ,D.G_PRODUCT'
      '1106014504=            ,O.ARRIVAL_TYPE'
      '1106014505=        FROM OTHER O,'
      '1106014506=             OTHER_DETAILS D'
      '1106014507=       WHERE O.sklad_parent_id = :SKLAD_'
      '1106014508=         AND O.OTHER = D.OTHER'
      '1106014509=        INTO :AMOUNT_NEED_'
      '1106014510=            ,:G_PRODUCT_KIT_'
      '1106014511=            ,:ARRIVAL_TYPE_'
      '1106014512=  DO BEGIN'
      '1106014513=    UPDATE LT_SKLAD_PRODUCT L'
      
        '1106014514=       SET L.AMOUNT = L.AMOUNT + DECODE(:ARRIVAL_TYPE' +
        '_, 0, -:AMOUNT_NEED_, :AMOUNT_NEED_)   -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040 +
        ', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1048' '#1053#1040#1054#1041#1054#1056#1054#1058
      '1106014515=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1106014516=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106014517=  END'
      '1106014518='
      '1106014519=  PNT_ = '#39'01'#39';'
      
        '1106014520=  DELETE FROM OTHER_DETAILS D WHERE EXISTS (SELECT 1 ' +
        'FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_ AND OTHER = D.OTHER);'
      '1106014521=  DELETE FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_;'
      '1106014522='
      '1106014523=  PNT_ = '#39'02'#39';'
      
        '1106014524=  EXECUTE PROCEDURE DEL_SKLAD(:SKLAD_, NULL) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014525=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014526=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106014527=      EXIT;'
      '1106014528=  END'
      '1106014529=END'
      '1106014530=;'
      '1106014531='
      '1106014532=ALTER PROCEDURE DEL_SKLAD('
      '1106014533=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1106014534=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '1106014535=RETURNS ('
      '1106014536=  ERR_CODE INTEGER,'
      '1106014537=  ERR_MSG VARCHAR(1024))'
      '1106014538=AS'
      '1106014539=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD'#39';'
      '1106014540=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106014541=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106014542=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1106014543=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1106014544=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1106014545=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1106014546=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1106014547=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.' +
        'AMOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057 +
        #1071') */'
      
        '1106014548=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA' +
        '.NAME;'
      '1106014549=BEGIN'
      '1106014550='
      '1106014551=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '1106014552=    SELECT S_VALUE'
      '1106014553=      FROM SYSTEM_SETUP'
      '1106014554=     WHERE SYSTEM_SETUP = 2'
      '1106014555=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1106014556='
      '1106014557=  SELECT SP.IS_VOZVRAT,'
      
        '1106014558=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TO' +
        'CHKA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '1106014559=         ,G.NAME'
      '1106014560=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '1106014561=   WHERE SP.SKLAD = :SKLAD_'
      '1106014562=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '1106014563=    INTO :IS_VOZVRAT_,'
      '1106014564=         :G_TOCHKA_'
      '1106014565=         ,:TOCHKA_NAME_;'
      '1106014566='
      '1106014567=  PNT_ = '#39'02'#39';'
      '1106014568=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '1106014569=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '1106014570=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040 +
        #1045#1058' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      '1106014571=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '1106014572=      FOR SELECT S.G_PRODUCT,'
      '1106014573=                 SUM(S.AMOUNT)'
      '1106014574=            FROM SKLAD S'
      '1106014575=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '1106014576=           GROUP BY S.G_PRODUCT'
      '1106014577=            INTO :G_PRODUCT_,'
      '1106014578=                 :AMOUNT_PRIHOD_'
      '1106014579=      DO BEGIN'
      '1106014580=          SELECT L.AMOUNT,'
      '1106014581=                 G.NAME'
      '1106014582=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '1106014583=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106014584=             AND L.G_PRODUCT = G.G_PRODUCT'
      '1106014585=             AND L.G_TOCHKA = :G_TOCHKA_'
      '1106014586=            INTO :AMOUNT_LAST_,'
      '1106014587=                 :NAME_;'
      '1106014588='
      
        '1106014589=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) ' +
        'THEN BEGIN'
      '1106014590=              ERR_CODE = -20500;'
      
        '1106014591=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE,' +
        ' '#39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||NAME_||'#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||TOCHKA_NAME_||'#39'" '#1089#1090 +
        #1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      
        '1106014592=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106014593=              EXIT;'
      '1106014594=          END'
      '1106014595=      END'
      '1106014596=  END'
      '1106014597='
      
        '1106014598=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014599=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014600=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106014601=    EXIT;'
      '1106014602=  END'
      '1106014603='
      '1106014604=  -------------------------------------'
      
        '1106014605=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048 +
        ' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050 +
        #1051#1040#1044#1040
      
        '1106014606=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053 +
        #1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' ' +
        #1055#1054#1044#1056#1071#1044
      '1106014607=  PNT_ = '#39'05'#39';'
      '1106014608=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '1106014609=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '1106014610=      FOR SELECT S.KASSA'
      '1106014611=            FROM KASSA S'
      '1106014612=           WHERE S.SKLAD = :SKLAD_'
      '1106014613=            INTO :KASSA_'
      '1106014614=      DO BEGIN'
      
        '1106014615=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014616=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014617=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1106014618=             EXIT;'
      '1106014619=          END'
      '1106014620=      END'
      '1106014621='
      '1106014622=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '1106014623=      FOR SELECT S.KASSA_BEZNAL'
      '1106014624=            FROM KASSA_BEZNAL S'
      '1106014625=           WHERE S.SKLAD = :SKLAD_'
      '1106014626=            INTO :KASSA_'
      '1106014627=      DO BEGIN'
      
        '1106014628=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014629=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014630=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1106014631=             EXIT;'
      '1106014632=          END'
      '1106014633=      END'
      '1106014634=  END'
      '1106014635=  -------------------------------------'
      '1106014636='
      '1106014637=  PNT_ = '#39'06'#39';'
      '1106014638=  DELETE FROM sklad_PARENT'
      '1106014639=  WHERE sklad = :sklad_;'
      '1106014640='
      '1106014641=when sqlcode -530 DO'
      '1106014642=  begin'
      '1106014643=    ERR_CODE = -20500;'
      
        '1106014644=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106014645=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106014646=  end'
      '1106014647=end'
      '1106014648=;'
      '1106014649='
      '1106014650=ALTER PROCEDURE DEL_SKLAD_DETAIL('
      '1106014651=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106014652=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '1106014653=RETURNS ('
      '1106014654=  ERR_CODE INTEGER,'
      '1106014655=  ERR_MSG VARCHAR(1024))'
      '1106014656=AS'
      
        '1106014657=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD_DE' +
        'TAIL'#39';'
      '1106014658=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '1106014659=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      '1106014660=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '1106014661=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '1106014662=DECLARE VARIABLE IS_LAST_ TYPE OF COLUMN SKLAD.IS_LAS' +
        'T;'
      
        '1106014663=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1106014664=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1106014665=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1106014666=DECLARE VARIABLE G_PRODUCT_SOSTAV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1106014667=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      
        '1106014668=DECLARE VARIABLE IS_EXPECTED_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.IS_EXPECTED;'
      
        '1106014669=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.' +
        'AMOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057 +
        #1071') */'
      
        '1106014670=DECLARE VARIABLE G_TOCHKA_PROVIDER_ TYPE OF COLUMN G_' +
        'TOCHKA.G_TOCHKA;'
      '1106014671=BEGIN'
      '1106014672=  PNT_ = '#39'01'#39';'
      '1106014673=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1053#1048#1052#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1106014674=  FOR SELECT S.G_PRODUCT,'
      '1106014675=             S.AMOUNT,'
      '1106014676=             S.IS_LAST'
      '1106014677=             ,SP.IS_VOZVRAT'
      '1106014678=             ,SP.G_TOCHKA'
      '1106014679=             ,SP.IS_EXPECTED'
      '1106014680=             ,SP.G_CLIENT'
      '1106014681=        FROM SKLAD S, SKLAD_PARENT SP'
      '1106014682=       WHERE SP.SKLAD = S.SKLAD_PARENT'
      '1106014683=         AND S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1106014684=         AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '1106014685=       INTO :G_PRODUCT_,'
      '1106014686=            :AMOUNT_,'
      '1106014687=            :IS_LAST_'
      '1106014688=            ,:IS_VOZVRAT_'
      '1106014689=            ,:G_TOCHKA_'
      '1106014690=            ,:IS_EXPECTED_'
      '1106014691=            ,:G_TOCHKA_PROVIDER_'
      '1106014692=  DO BEGIN'
      '1106014693=    IF (IS_EXPECTED_ = 0) THEN'
      '1106014694=        UPDATE LT_SKLAD_PRODUCT LT'
      '1106014695=           SET LT.AMOUNT = LT.AMOUNT - :AMOUNT_'
      '1106014696=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1106014697=           AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1106014698='
      
        '1106014699=    IF (IS_LAST_ = 1) then    -- '#1045#1057#1051#1048' '#1057#1058#1054#1048#1058' IS_LAST, ' +
        #1058#1054' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1045#1043#1054' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048', '#1063#1058#1054#1041#1067' '#1053#1045' '#1058#1045#1056#1071#1058#1068' '#1055#1054#1057#1051#1045#1044#1053 +
        #1070#1070' '#1055#1054#1057#1058#1040#1042#1050#1059
      '1106014700=        UPDATE SKLAD SK'
      '1106014701=             SET SK.IS_LAST = 1'
      '1106014702=           WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106014703=             AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1106014704=                               FROM SKLAD SS'
      
        '1106014705=                              WHERE SS.G_TOCHKA = :G_' +
        'TOCHKA_'
      
        '1106014706=                                AND SS.G_PRODUCT = SK' +
        '.G_PRODUCT'
      
        '1106014707=                                AND SS.SKLAD_PARENT <' +
        '> :SKLAD_PARENT_'
      
        '1106014708=                                AND SS.DATE_RECEIPT =' +
        ' (SELECT MAX(SSS.DATE_RECEIPT)'
      
        '1106014709=                                                     ' +
        '    FROM SKLAD SSS'
      
        '1106014710=                                                     ' +
        '   WHERE SSS.G_PRODUCT = SS.G_PRODUCT'
      
        '1106014711=                                                     ' +
        '     AND SSS.IS_VOZVRAT in (0, 4)'
      
        '1106014712=                                                     ' +
        '     AND SSS.SKLAD_PARENT <> :SKLAD_PARENT_'
      
        '1106014713=                                                     ' +
        '     AND SSS.G_TOCHKA = :G_TOCHKA_));'
      '1106014714='
      '1106014715=  END'
      '1106014716='
      '1106014717=  PNT_ = '#39'02'#39';'
      
        '1106014718=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051'. '#1042' ' +
        #1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1050#1054#1051'-'#1042#1054' '#1053#1040#1044#1054' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1058#1068' '#1050#1054#1051'-'#1042#1054' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1048' '#1059#1044#1040 +
        #1051#1071#1058#1068' '#1044#1040#1053#1053#1067#1045
      '1106014719=  -- '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067' LT_ZAKAZ_REAL'
      '1106014720=  IF (IS_VOZVRAT_ = 2) THEN BEGIN'
      '1106014721=    FOR SELECT ZD.AMOUNT,'
      '1106014722=             ZD.PRICE,'
      '1106014723=             LZ.ZAKAZ_NA_REAL'
      '1106014724=        FROM SKLAD ZD,'
      '1106014725=             LT_ZAKAZ_REAL LZ'
      '1106014726=       WHERE ZD.SKLAD_PARENT = :SKLAD_PARENT_'
      '1106014727=         AND ZD.SKLAD = COALESCE(:SKLAD_, ZD.SKLAD)'
      '1106014728=         AND ZD.SKLAD = LZ.SKLAD'
      '1106014729=       INTO :AMOUNT_,'
      '1106014730=            :PRICE_,'
      '1106014731=            :ZAKAZ_NA_REAL_'
      '1106014732=    DO BEGIN'
      '1106014733=      UPDATE ZAKAZ_NA_REAL ZRR'
      
        '1106014734=         SET ZRR.AMOUNT_RETURNED = ZRR.AMOUNT_RETURNE' +
        'D - :AMOUNT_,'
      
        '1106014735=             ZRR.SUMM_RETURNED = ZRR.SUMM_RETURNED - ' +
        ':AMOUNT_ * :PRICE_,'
      '1106014736=             ZRR.IS_PAYED_ALL = 0'
      '1106014737=       WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106014738=    END'
      '1106014739='
      '1106014740=    IF (SKLAD_ IS NOT NULL) THEN'
      
        '1106014741=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD = :SK' +
        'LAD_;'
      '1106014742=    ELSE'
      
        '1106014743=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD IN (S' +
        'ELECT SKLAD FROM SKLAD WHERE SKLAD_PARENT = :SKLAD_PARENT_);'
      '1106014744=  END'
      
        '1106014745=  -- '#1055#1056#1048#1041#1040#1042#1051#1070' '#1048#1061' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050', '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1058 +
        #1056#1040#1053#1057#1060#1045#1056' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1106014746=  ELSE IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '1106014747=    FOR SELECT S.G_PRODUCT,'
      '1106014748=               S.AMOUNT'
      '1106014749=          FROM SKLAD S'
      '1106014750=         WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1106014751=           AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '1106014752=          INTO :G_PRODUCT_,'
      '1106014753=               :AMOUNT_PRIHOD_'
      '1106014754=    DO BEGIN'
      '1106014755=      UPDATE LT_SKLAD_PRODUCT L'
      '1106014756=         SET L.AMOUNT = L.AMOUNT + :AMOUNT_PRIHOD_'
      '1106014757=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106014758=         AND L.G_TOCHKA = :G_TOCHKA_PROVIDER_;'
      '1106014759=    END'
      '1106014760=  END'
      '1106014761='
      '1106014762=  PNT_ = '#39'03'#39';'
      
        '1106014763=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' ' +
        #1057#1054#1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040 +
        #1056#1040', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '1106014764=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', ' +
        #1050' '#1055#1056#1048#1052#1045#1056#1059' '#1058#1045#1057#1058#1054' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1052#1059#1050#1048' (5 '#1064#1058') '#1048' '#1057#1040#1061#1040#1056#1040' (4 '#1064#1058'), '#1057#1054#1054#1058#1042#1045#1058#1057 +
        #1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1045#1057#1058#1040' = 4'
      '1106014765=  /*FOR SELECT K.G_PRODUCT'
      '1106014766=        FROM SKLAD ZD,'
      '1106014767=             G_PRODUCT_KIT K'
      '1106014768=       WHERE ZD.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1106014769=         AND ZD.sklad_parent = :SKLAD_PARENT_'
      '1106014770=       GROUP BY K.G_PRODUCT'
      '1106014771=       INTO :G_PRODUCT_SOSTAV_'
      '1106014772=  DO BEGIN'
      '1106014773=    SELECT MIN(L.AMOUNT)'
      '1106014774=      FROM G_PRODUCT_KIT K,'
      '1106014775=           LT_SKLAD_PRODUCT L'
      '1106014776=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '1106014777=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '1106014778=       AND L.G_TOCHKA = :G_TOCHKA_'
      '1106014779=     GROUP BY K.G_PRODUCT'
      '1106014780=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1106014781='
      '1106014782=    UPDATE LT_SKLAD_PRODUCT L'
      '1106014783=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '1106014784=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_;'
      '1106014785=  END*/'
      '1106014786='
      '1106014787=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1106014788=  PNT_ = '#39'04'#39';'
      '1106014789=  DELETE from SKLAD S'
      '1106014790=  WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1106014791=    AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD);'
      '1106014792='
      '1106014793=when sqlcode -530 DO'
      '1106014794=  begin'
      '1106014795=    ERR_CODE = -20500;'
      
        '1106014796=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106014797=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106014798=  end'
      '1106014799=end'
      '1106014800=;'
      '1106014801='
      '1106014802=ALTER PROCEDURE DEL_SKLAD_TMP('
      '1106014803=  SKLAD_ TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1106014804=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '1106014805=RETURNS ('
      '1106014806=  ERR_CODE INTEGER,'
      '1106014807=  ERR_MSG VARCHAR(1024))'
      '1106014808=AS'
      
        '1106014809=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1048' '#1055#1056#1048' '#1054#1044#1048#1053#1054#1063#1053#1054#1052' '#1059#1044#1040#1051#1045#1053#1048#1048' '#1044#1045#1058#1040#1051 +
        #1048', '#1048' '#1055#1056#1048' '#1054#1063#1048#1057#1058#1050#1045' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067','
      '1106014810='#1050#1054#1043#1044#1040' '#1047#1040#1050#1056#1067#1042#1040#1045#1058#1057#1071' '#1054#1050#1053#1054' "'#1055#1056#1048#1061#1054#1044' '#1053#1040#1050#1051#1040#1044#1053#1040#1071'"*/'
      
        '1106014811=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD_TM' +
        'P'#39';'
      '1106014812=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106014813=DECLARE VARIABLE G_PRODUCT_ INTEGER;'
      
        '1106014814=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1106014815=DECLARE VARIABLE AMOUNT_CUR_SKLAD_ TYPE OF COLUMN SKL' +
        'AD.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' *' +
        '/'
      
        '1106014816=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1055#1056#1048#1061#1054#1044#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045 +
        ' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044' */'
      
        '1106014817=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      '1106014818=BEGIN'
      '1106014819='
      '1106014820=  SELECT T.SKLAD_PARENT'
      '1106014821=    FROM SKLAD_TMP T'
      '1106014822=   WHERE T.SKLAD = :SKLAD_'
      '1106014823=    INTO :SKLAD_PARENT_;'
      '1106014824='
      '1106014825=  DELETE FROM SKLAD_TMP'
      '1106014826=  WHERE SKLAD = COALESCE(:sklad_, sklad);'
      '1106014827='
      
        '1106014828=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054 +
        #1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1053#1054' '#1069#1058#1040' '#1055#1056#1054#1042#1045#1056#1050#1040' '#1053#1059#1046#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058#1057#1071' '#1059 +
        #1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044', '#1054' '#1063#1045#1052' '#1057#1042#1048#1044#1045#1058#1045#1051#1068#1057#1058#1042#1059#1045#1058' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1049' SKLAD_P' +
        'ARENT_'
      
        '1106014829=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SK' +
        'LAD_PARENT_, 0) <> 0)) then BEGIN'
      '1106014830=      SELECT L.G_PRODUCT,'
      '1106014831=             L.AMOUNT'
      '1106014832=        FROM SKLAD S,'
      '1106014833=             LT_SKLAD_PRODUCT L'
      '1106014834=       WHERE S.SKLAD = :SKLAD_'
      '1106014835=         AND S.G_PRODUCT = L.G_PRODUCT'
      '1106014836=         AND S.G_TOCHKA = L.G_TOCHKA'
      '1106014837=        INTO :G_PRODUCT_,'
      '1106014838=             :AMOUNT_CUR_;'
      '1106014839='
      
        '1106014840=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1055#1056#1048#1061#1054#1044', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1106014841=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1055#1056#1048#1061#1054#1044', '#1056#1045 +
        #1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 40, '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068', '#1063#1043#1054#1041#1067' '#1053#1045' '#1059#1064#1051#1054' ' +
        #1042' '#1052#1048#1053#1059#1057
      
        '1106014842=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1045#1057#1051#1048' '#1057#1058#1040#1056#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1041#1054#1051#1068#1064#1045' '#1053#1054#1042#1054#1043#1054' - '#1047#1053#1040#1063#1048#1058' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042 +
        #1040#1056#1040' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1054#1057#1068','
      '1106014843=      -- '#1053#1040#1044#1054' '#1057#1044#1045#1051#1040#1058#1068' '#1063#1058#1054#1041#1067' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1057#1068' '#1053#1045' '#1042' '#1052#1048#1053#1059#1057
      '1106014844=      SELECT SUM(AMOUNT)'
      '1106014845=        FROM SKLAD T'
      '1106014846=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1106014847=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '1106014848=        INTO :AMOUNT_OLD_;'
      '1106014849='
      '1106014850=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045
      '1106014851=      SELECT SUM(AMOUNT)'
      '1106014852=        FROM SKLAD_TMP T'
      '1106014853=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1106014854=       INTO :AMOUNT_CUR_SKLAD_;'
      '1106014855='
      
        '1106014856=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD' +
        '_) THEN BEGIN'
      
        '1106014857=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_C' +
        'UR_SKLAD_)) < 0) THEN BEGIN'
      '1106014858=            ERR_CODE = -20500;'
      
        '1106014859=            ERR_MSG = '#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086 +
        #1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39'||ASCII_CHAR(10)||'
      
        '1106014860=                      '#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'.'#39';'
      
        '1106014861=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1106014862=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1106014863=            EXIT;'
      '1106014864=          END'
      '1106014865=      END'
      '1106014866=  END'
      '1106014867='
      '1106014868=when sqlcode -530 DO'
      '1106014869=  begin'
      '1106014870=    ERR_CODE = -20500;'
      
        '1106014871=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106014872=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106014873=  end'
      '1106014874=end'
      '1106014875=;'
      '1106014876='
      '1106014877=ALTER PROCEDURE DEL_ZAKAZ('
      '1106014878=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106014879=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '1106014880=RETURNS ('
      '1106014881=  ERR_CODE INTEGER,'
      '1106014882=  ERR_MSG VARCHAR(1024))'
      '1106014883=AS'
      '1106014884=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '1106014885=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106014886=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106014887=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M;'
      
        '1106014888=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '1106014889=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1106014890=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '1106014891=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1106014892=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1106014893=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1106014894=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM;'
      
        '1106014895=DECLARE VARIABLE SALES_COMM_OLD_       TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM;'
      
        '1106014896=DECLARE VARIABLE ACTION_DATE_ZP_       TYPE OF COLUMN' +
        ' KASSA.ACTION_DATE;'
      
        '1106014897=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      '1106014898=BEGIN'
      
        '1106014899=  --*************************************************' +
        '***************'
      '1106014900=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1106014901=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1106014902=      SELECT Z.SUMM,'
      '1106014903=             Z.SUMM_BONUS,'
      '1106014904=             Z.SUMM_BONUS_GOT,'
      '1106014905=             Z.G_CLIENT,'
      '1106014906=             Z.G_OFFICIAL,'
      '1106014907=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '1106014908=             G.FM'
      
        '1106014909=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1106014910=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106014911=        INTO :SUMM_ZAKAZ_,'
      '1106014912=             :SUMM_PAY_BONUS_,'
      '1106014913=             :SUMM_BONUS_GOT_,'
      '1106014914=             :G_CLIENT_,'
      '1106014915=             :G_OFFICIAL_,'
      '1106014916=             :DO_NOT_SALES_COMM_,'
      '1106014917=             :OFFICIAL_NAME_;'
      '1106014918='
      
        '1106014919=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1106014920=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ') THEN'
      '1106014921=        SELECT SUM(ZD.SALES_COMM)'
      '1106014922=          FROM ZAKAZ_DETAILS ZD'
      '1106014923=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1106014924=          INTO :SALES_COMM_OLD_;'
      '1106014925='
      '1106014926=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1106014927=      PNT_ = '#39'01'#39';'
      
        '1106014928=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014929=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014930=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106014931=        EXIT;'
      '1106014932=      END'
      '1106014933='
      '1106014934=      -------------------------------------'
      '1106014935=      PNT_ = '#39'02'#39';'
      '1106014936=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '1106014937=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040 +
        #1051#1048#1063#1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045 +
        #1053#1048#1071' '#1055#1054#1044#1056#1071#1044
      '1106014938=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '1106014939=      FOR SELECT S.KASSA'
      '1106014940=            FROM KASSA S'
      '1106014941=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1106014942=            INTO :KASSA_'
      '1106014943=      DO BEGIN'
      
        '1106014944=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014945=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014946=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106014947=            EXIT;'
      '1106014948=          END'
      '1106014949=      END'
      '1106014950='
      '1106014951=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '1106014952=      PNT_ = '#39'03'#39';'
      '1106014953=      FOR SELECT S.KASSA_BEZNAL'
      '1106014954=            FROM KASSA_BEZNAL S'
      '1106014955=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1106014956=            INTO :KASSA_'
      '1106014957=      DO BEGIN'
      
        '1106014958=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014959=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014960=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106014961=            EXIT;'
      '1106014962=          END'
      '1106014963=      END'
      '1106014964=      -------------------------------------'
      '1106014965='
      
        '1106014966=      --=============================================' +
        '===================='
      '1106014967=      -- '#1041#1051#1054#1050' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040
      
        '1106014968=      --=============================================' +
        '===================='
      '1106014969=      PNT_ = '#39'03.1'#39';'
      
        '1106014970=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ' AND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '1106014971=            KASSA_ = NULL;'
      '1106014972='
      '1106014973=            SELECT S.S_VALUE'
      '1106014974=              FROM SYSTEM_SETUP S'
      '1106014975=             WHERE S.SYSTEM_SETUP = 4'
      '1106014976=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '1106014977='
      '1106014978=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1106014979=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1106014980=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1106014981='
      
        '1106014982=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' ' +
        #1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1106014983=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THE' +
        'N'
      
        '1106014984=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - D' +
        'ECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY ' +
        'FROM CURRENT_DATE)));'
      '1106014985='
      '1106014986=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1106014987=            ELSE'
      
        '1106014988=               ACTION_DATE_ZP_ = Current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date -' +
        ' EXTRACT(DAY FROM current_date) + 32);'
      '1106014989='
      '1106014990=            SELECT K.KASSA, K.SUMM'
      '1106014991=            FROM KASSA K'
      '1106014992=            WHERE K.G_PRIHOD_RASHOD = -1'
      '1106014993=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1106014994=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1106014995=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1106014996='
      '1106014997=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '1106014998=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106014999=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1106015000=                                              -:SALES' +
        '_COMM_OLD_,'
      
        '1106015001=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1106015002=                                              :OFFICI' +
        'AL_NAME_,'
      
        '1106015003=                                              NULL,  ' +
        '   --:ZAKAZ_,'
      
        '1106015004=                                              NULL,  ' +
        '   --:SKLAD_,'
      '1106015005=                                              1,'
      
        '1106015006=                                              (SELECT' +
        ' ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1106015007=                                              :G_OFFI' +
        'CIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106015008=            END ELSE'
      
        '1106015009=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_' +
        ','
      
        '1106015010=                                              1,     ' +
        '-- ACTION_'
      
        '1106015011=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1106015012=                                              :SALES_' +
        'COMM_SUMM_ITER_ - :SALES_COMM_OLD_,'
      
        '1106015013=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1106015014=                                              :OFFICI' +
        'AL_NAME_,   --NOTE_'
      '1106015015=                                              NULL,'
      '1106015016=                                              NULL,'
      '1106015017=                                              1,'
      
        '1106015018=                                              G_OFFIC' +
        'IAL_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1106015019='
      '1106015020=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106015021=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106015022=              EXIT;'
      '1106015023=            END'
      '1106015024=      END'
      '1106015025=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1106015026=      --=============================================' +
        '===================='
      '1106015027='
      
        '1106015028=      -- '#1045#1057#1051#1048' '#1050#1040#1050#1040#1071'-'#1058#1054' '#1063#1040#1057#1058#1068' '#1041#1067#1051#1040' '#1054#1055#1051#1040#1063#1045#1053#1040' '#1041#1054#1053#1059#1057#1040#1052#1048' -' +
        ' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1048#1061', '#1058#1054' '#1045#1057#1058#1068' '#1047#1040#1050#1048#1044#1067#1042#1040#1070' '#1050#1051#1048#1045#1053#1058#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1053#1040' '#1053#1040#1050#1054#1055#1051#1045 +
        #1053#1048#1071
      '1106015029=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '1106015030=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' ' +
        #1055#1054#1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '1106015031=      UPDATE G_DISCONT_CARD G'
      
        '1106015032=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_' +
        ', 0) - :SUMM_BONUS_GOT_,'
      
        '1106015033=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0)' +
        ', 0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '1106015034=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '1106015035='
      '1106015036=      PNT_ = '#39'04'#39';'
      '1106015037=      UPDATE INVOICE I'
      '1106015038=         SET I.ZAKAZ = NULL'
      '1106015039=       WHERE I.ZAKAZ = :zakaz_;'
      '1106015040='
      '1106015041=      UPDATE INVOICE_PAY I'
      '1106015042=         SET I.ZAKAZ = NULL'
      '1106015043=       WHERE I.ZAKAZ = :zakaz_;'
      '1106015044='
      '1106015045=      UPDATE WAYBILL W'
      '1106015046=         SET W.ZAKAZ = NULL'
      '1106015047=       WHERE W.ZAKAZ = :zakaz_;'
      '1106015048=      --********************************************'
      '1106015049='
      '1106015050=      PNT_ = '#39'015'#39';'
      '1106015051=      DELETE FROM zakaz'
      '1106015052=      WHERE zakaz = :zakaz_;'
      '1106015053=  END'
      '1106015054=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '1106015055=  --*************************************************' +
        '***************************'
      '1106015056=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1106015057=  ELSE BEGIN'
      '1106015058=    PNT_ = '#39'20'#39';'
      
        '1106015059=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL) RETURN' +
        'ING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106015060=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106015061=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106015062=      EXIT;'
      '1106015063=    END'
      '1106015064=  END'
      '1106015065='
      '1106015066=when sqlcode -530 DO'
      '1106015067=  begin'
      '1106015068=    ERR_CODE = -20500;'
      
        '1106015069=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106015070=    ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '1106015071=  end'
      '1106015072=end'
      '1106015073=;'
      '1106015074='
      '1106015075=ALTER PROCEDURE DEL_ZAKAZ_DETAIL('
      '1106015076=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '1106015077=RETURNS ('
      '1106015078=  ERR_CODE INTEGER,'
      '1106015079=  ERR_MSG VARCHAR(1024))'
      '1106015080=AS'
      
        '1106015081=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ_DE' +
        'TAIL'#39';'
      '1106015082=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '1106015083=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106015084=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1106015085=DECLARE VARIABLE IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS' +
        '_SPISANIE;'
      
        '1106015086=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_' +
        'RESERVE;'
      
        '1106015087=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1106015088=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1106015089=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1106015090=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106015091=BEGIN'
      '1106015092='
      
        '1106015093=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1040' '#1042#1044#1056#1059#1043' '#1059#1044#1040#1051#1071#1070' '#1054#1055#1051#1040#1058#1059' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040 +
        #1051#1048#1047#1040#1062#1048#1070
      '1106015094=  SELECT Z.IS_SPISANIE,'
      '1106015095=         Z.G_TOCHKA'
      '1106015096=         ,Z.IS_RESERVE'
      '1106015097=    FROM ZAKAZ Z'
      '1106015098=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106015099=    INTO :IS_SPISANIE_,'
      '1106015100=         :G_TOCHKA_'
      '1106015101=         ,:IS_RESERVE_;'
      '1106015102='
      
        '1106015103=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1048#1051#1048' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040'. '#1058#1054' ' +
        #1057#1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1106015104=  if (IS_SPISANIE_ <> 2) then BEGIN'
      '1106015105=      FOR SELECT G_PRODUCT,'
      '1106015106=                 AMOUNT'
      '1106015107=            FROM ZAKAZ_DETAILS Z'
      '1106015108=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106015109=           INTO :G_PRODUCT_,'
      '1106015110=                :AMOUNT_'
      '1106015111=      DO BEGIN'
      
        '1106015112=        -- '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1050' '#1054#1057#1053#1054#1042#1053#1054#1052#1059' '#1054#1057#1058 +
        #1040#1058#1050#1059
      '1106015113=        IF (IS_RESERVE_ = 0) THEN'
      '1106015114=            UPDATE LT_SKLAD_PRODUCT LT'
      '1106015115=               SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_'
      '1106015116=             WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1106015117=               AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1106015118='
      
        '1106015119=        -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1056#1045#1047#1045#1056#1042', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1054#1058' '#1047#1040#1056#1045#1047#1045#1056#1042#1048#1056#1054 +
        #1042#1040#1053#1053#1054#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040
      '1106015120=        ELSE'
      '1106015121=            UPDATE LT_SKLAD_PRODUCT LT'
      
        '1106015122=               SET LT.AMOUNT_RESERVE = LT.AMOUNT_RESE' +
        'RVE - :AMOUNT_'
      '1106015123=             WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1106015124=               AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1106015125=      END'
      '1106015126='
      
        '1106015127=  --*************************************************' +
        '**********'
      
        '1106015128=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051', '#1058#1054' '#1053#1040#1044#1054' ' +
        #1042#1054#1057#1057#1058#1040#1053#1054#1042#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1045' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      
        '1106015129=  -- '#1048#1065#1059' '#1055#1054' '#1044#1040#1053#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1048' '#1055#1056#1048 +
        #1041#1040#1042#1051#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050' '#1053#1045#1052#1059', '#1045#1057#1051#1048' '#1042#1045#1057#1068' '#1058#1054#1042#1040#1056' '#1054#1055#1051#1040#1063#1045#1053', '#1058#1054' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042 +
        #1059#1070' '#1047#1040#1055#1048#1057#1068
      '1106015130=  END ELSE BEGIN'
      '1106015131=      FOR SELECT ZD.AMOUNT,'
      '1106015132=                 ZD.PRICE,'
      '1106015133=                 ZD.DISCOUNT_TENGE,'
      '1106015134=                 LZ.ZAKAZ_NA_REAL'
      '1106015135=            FROM ZAKAZ Z,'
      '1106015136=                 ZAKAZ_DETAILS ZD,'
      '1106015137=                 LT_ZAKAZ_REAL LZ'
      '1106015138=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106015139=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106015140=             AND ZD.ZAKAZ_DETAILS = LZ.ZAKAZ_DETAILS'
      '1106015141=           INTO :AMOUNT_,'
      '1106015142=                :PRICE_,'
      '1106015143=                :DISCOUNT_TENGE_,'
      '1106015144=                :ZAKAZ_NA_REAL_'
      '1106015145=      DO BEGIN'
      '1106015146=          UPDATE ZAKAZ_NA_REAL ZRR'
      
        '1106015147=             SET ZRR.AMOUNT_PAYED = ZRR.AMOUNT_PAYED ' +
        '- :AMOUNT_,'
      
        '1106015148=                 ZRR.SUMM_PAYED = ZRR.SUMM_PAYED - :A' +
        'MOUNT_ * (:PRICE_ - :DISCOUNT_TENGE_),'
      '1106015149=                 ZRR.IS_PAYED_ALL = 0'
      '1106015150=           WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106015151=      END'
      '1106015152='
      '1106015153=      -- '#1059#1044#1040#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067
      
        '1106015154=      DELETE FROM LT_ZAKAZ_REAL R WHERE R.ZAKAZ_DETAI' +
        'LS IN (SELECT ZAKAZ_DETAILS FROM ZAKAZ_DETAILS ZD WHERE ZD.ZAKAZ' +
        ' = :ZAKAZ_);'
      '1106015155=  END'
      '1106015156='
      '1106015157=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1106015158=  PNT_ = '#39'03'#39';'
      '1106015159=  DELETE from zakaz_DETAILS z'
      '1106015160=  WHERE z.zakaz = :zakaz_;'
      '1106015161='
      '1106015162=when sqlcode -530 DO'
      '1106015163=  begin'
      '1106015164=    ERR_CODE = -20500;'
      
        '1106015165=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      
        '1106015166=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106015167=  end'
      '1106015168=WHEN ANY DO'
      '1106015169=  begin'
      '1106015170=    ERR_CODE = sqlcode;'
      '1106015171=  end'
      '1106015172=end'
      '1106015173=;'
      '1106015174='
      '1106015175=ALTER PROCEDURE DEL_ZAKAZ_NA_REAL('
      
        '1106015176=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_N' +
        'A_REAL)'
      '1106015177=RETURNS ('
      '1106015178=  ERR_CODE INTEGER,'
      '1106015179=  ERR_MSG VARCHAR(1024))'
      '1106015180=AS'
      
        '1106015181=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ_NA' +
        '_REAL'#39';'
      '1106015182=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '1106015183=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106015184=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1106015185=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '1106015186=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1106015187=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106015188=begin'
      
        '1106015189=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040 +
        #1044#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1054#1053' '#1059#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1063#1045#1053
      '1106015190=  FOR SELECT G_PRODUCT,'
      '1106015191=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED,'
      '1106015192=             Z.ZAKAZ_REAL_PARENT,'
      '1106015193=             ZP.G_TOCHKA'
      '1106015194=        FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      '1106015195=       WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '1106015196=         AND Z.IS_PAYED_ALL = 0'
      
        '1106015197=         AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PARE' +
        'NT'
      '1106015198=       INTO :G_PRODUCT_,'
      '1106015199=            :AMOUNT_,'
      '1106015200=            :ZAKAZ_REAL_PARENT_,'
      '1106015201=            :G_TOCHKA_'
      '1106015202=  DO BEGIN'
      '1106015203=    UPDATE LT_SKLAD_PRODUCT LT'
      '1106015204=       SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_'
      '1106015205=     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1106015206=       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1106015207=  END'
      '1106015208='
      '1106015209=  -- '#1059#1044#1040#1051#1071#1070' '#1058#1054#1042#1040#1056' '#1048#1047' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1106015210=  PNT_ = '#39'03'#39';'
      '1106015211=  DELETE from ZAKAZ_NA_REAL z'
      '1106015212=  WHERE z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106015213='
      
        '1106015214=  -- '#1059#1044#1040#1051#1071#1070' '#1042#1057#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070', '#1045#1057#1051#1048' '#1041#1054#1051#1045#1045' '#1044#1054#1063#1045#1056#1053#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049' '#1059' '#1053#1045#1045' '#1053#1045#1058
      '1106015215=  SELECT COUNT(*)'
      '1106015216=    FROM ZAKAZ_NA_REAL Z'
      '1106015217=   WHERE Z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_'
      '1106015218=    INTO :CNT_;'
      '1106015219='
      '1106015220=  if (CNT_ = 0) then'
      '1106015221=      DELETE from ZAKAZ_REAL_PARENT z'
      
        '1106015222=      WHERE z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_' +
        ';'
      '1106015223='
      '1106015224=when sqlcode -530 DO'
      '1106015225=  begin'
      '1106015226=    ERR_CODE = -20500;'
      
        '1106015227=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106015228=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106015229=  end'
      '1106015230=end'
      '1106015231=;'
      '1106015232='
      '1106015233=ALTER PROCEDURE DELIVERY_DEL('
      '1106015234=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY)'
      '1106015235=AS'
      '1106015236=BEGIN'
      '1106015237=  DELETE FROM DELIVERY'
      '1106015238=  WHERE DELIVERY = COALESCE(:DELIVERY_, DELIVERY);'
      '1106015239=END'
      '1106015240=;'
      '1106015241='
      '1106015242=ALTER PROCEDURE DELIVERY_GET('
      '1106015243=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY)'
      '1106015244=RETURNS ('
      '1106015245=  G_CLIENT_ TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '1106015246=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      '1106015247=  DOSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      
        '1106015248=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E,'
      '1106015249=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS,'
      '1106015250=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE,'
      '1106015251=  NOTE_ TYPE OF COLUMN DELIVERY.NOTE,'
      '1106015252=  STATUS_ TYPE OF COLUMN DELIVERY.STATUS,'
      '1106015253=  ZAKAZ_ TYPE OF COLUMN DELIVERY.ZAKAZ,'
      '1106015254=  SKLAD_ TYPE OF COLUMN DELIVERY.SKLAD,'
      
        '1106015255=  TOVAR_DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.TOVAR_' +
        'DELIVERY_DATE)'
      '1106015256=AS'
      '1106015257=BEGIN'
      '1106015258=  SELECT D.G_CLIENT,'
      '1106015259=         DOSTAVSHIK,'
      '1106015260=         DELIVERY_DATE,'
      '1106015261=         ADDRESS,'
      '1106015262=         PRICE,'
      '1106015263=         D.NOTE,'
      '1106015264=         STATUS,'
      '1106015265=         ZAKAZ,'
      '1106015266=         SKLAD,'
      '1106015267=         TOVAR_DELIVERY_DATE'
      '1106015268=         ,C.NAME'
      
        '1106015269=  FROM DELIVERY D LEFT OUTER JOIN G_CLIENT C ON D.DOS' +
        'TAVSHIK = C.G_CLIENT'
      '1106015270=  WHERE DELIVERY = :DELIVERY_'
      '1106015271=  INTO :G_CLIENT_,'
      '1106015272=       :DOSTAVSHIK_,'
      '1106015273=       :DELIVERY_DATE_,'
      '1106015274=       :ADDRESS_,'
      '1106015275=       :PRICE_,'
      '1106015276=       :NOTE_,'
      '1106015277=       :STATUS_,'
      '1106015278=       :ZAKAZ_,'
      '1106015279=       :SKLAD_,'
      '1106015280=       :TOVAR_DELIVERY_DATE_'
      '1106015281=       ,:DOSTAVSHIK_NAME_;'
      '1106015282=END'
      '1106015283=;'
      '1106015284='
      '1106015285=ALTER PROCEDURE DELIVERY_INS('
      '1106015286=  G_CLIENT_ TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '1106015287=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      
        '1106015288=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E,'
      '1106015289=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS,'
      '1106015290=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE,'
      '1106015291=  NOTE_ TYPE OF COLUMN DELIVERY.NOTE,'
      '1106015292=  STATUS_ TYPE OF COLUMN DELIVERY.STATUS,'
      '1106015293=  ZAKAZ_ TYPE OF COLUMN DELIVERY.ZAKAZ,'
      '1106015294=  SKLAD_ TYPE OF COLUMN DELIVERY.SKLAD,'
      
        '1106015295=  TOVAR_DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.TOVAR_' +
        'DELIVERY_DATE)'
      '1106015296=RETURNS ('
      '1106015297=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY)'
      '1106015298=AS'
      '1106015299=BEGIN'
      '1106015300=  INSERT INTO DELIVERY ('
      '1106015301=    DELIVERY,'
      '1106015302=    G_CLIENT,'
      '1106015303=    DOSTAVSHIK,'
      '1106015304=    DELIVERY_DATE,'
      '1106015305=    ADDRESS,'
      '1106015306=    PRICE,'
      '1106015307=    NOTE,'
      '1106015308=    STATUS,'
      '1106015309=    ZAKAZ,'
      '1106015310=    SKLAD,'
      '1106015311=    TOVAR_DELIVERY_DATE'
      '1106015312=    )'
      '1106015313=  VALUES ('
      '1106015314=    GEN_ID(GEN_DELIVERY, 1),'
      '1106015315=    :G_CLIENT_,'
      '1106015316=    :DOSTAVSHIK_,'
      '1106015317=    :DELIVERY_DATE_,'
      '1106015318=    :ADDRESS_,'
      '1106015319=    :PRICE_,'
      '1106015320=    :NOTE_,'
      '1106015321=    :STATUS_,'
      '1106015322=    :ZAKAZ_,'
      '1106015323=    :SKLAD_,'
      '1106015324=    :TOVAR_DELIVERY_DATE_'
      '1106015325=    )'
      '1106015326=  RETURNING'
      '1106015327=    DELIVERY'
      '1106015328=  INTO'
      '1106015329=    :DELIVERY_;'
      '1106015330=END'
      '1106015331=;'
      '1106015332='
      '1106015333=ALTER PROCEDURE DELIVERY_READ('
      '1106015334=  DATE_ DATE)'
      '1106015335=RETURNS ('
      '1106015336=  DELIVERY TYPE OF COLUMN DELIVERY.DELIVERY,'
      '1106015337=  G_CLIENT TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '1106015338=  DOSTAVSHIK TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      
        '1106015339=  TOVAR_DELIVERY_DATE TYPE OF COLUMN DELIVERY.TOVAR_D' +
        'ELIVERY_DATE,'
      
        '1106015340=  DELIVERY_DATE TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ','
      '1106015341=  ADDRESS TYPE OF COLUMN DELIVERY.ADDRESS,'
      '1106015342=  PRICE TYPE OF COLUMN DELIVERY.PRICE,'
      '1106015343=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106015344=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '1106015345=  DOST_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106015346=  NOTE TYPE OF COLUMN DELIVERY.NOTE,'
      '1106015347=  STATUS VARCHAR(50),'
      '1106015348=  ZAKAZ VARCHAR(50))'
      '1106015349=AS'
      '1106015350=BEGIN'
      '1106015351=  FOR SELECT DELIVERY,'
      '1106015352=             D.G_CLIENT,'
      '1106015353=             DOSTAVSHIK,'
      '1106015354=             TOVAR_DELIVERY_DATE,'
      '1106015355=             DELIVERY_DATE,'
      '1106015356=             ADDRESS,'
      '1106015357=             PRICE,'
      '1106015358=             D.NOTE'
      '1106015359=             ,GC.NAME'
      '1106015360=             ,GC.PHONE'
      '1106015361=             ,DS.NAME'
      
        '1106015362=             ,DECODE(STATUS, 0, '#39' '#1053#1077' '#1076#1086#1089#1090#1072#1074#1083#1077#1085#1086#39', 1, ' +
        #39#1044#1086#1089#1090#1072#1074#1083#1077#1085#1086#39') status'
      
        '1106015363=             ,Z.ZAKAZ ||'#39' '#1086#1090' '#39'||lpad(extract(day from' +
        ' Z.Z_DATE),2,'#39'0'#39') ||'
      
        '1106015364=               '#39'.'#39' || lpad(extract(month from Z.Z_DAT' +
        'E),2,'#39'0'#39') ||'
      '1106015365=               '#39'.'#39' || extract(year from Z.Z_DATE)'
      
        '1106015366=      FROM DELIVERY D LEFT OUTER JOIN G_CLIENT DS ON ' +
        'D.DOSTAVSHIK = DS.G_CLIENT, G_CLIENT GC'
      
        '1106015367=                      LEFT OUTER JOIN ZAKAZ Z ON D.ZA' +
        'KAZ = Z.ZAKAZ'
      '1106015368=      WHERE D.G_CLIENT = GC.G_CLIENT'
      '1106015369=        AND (D.DELIVERY_DATE IS NULL'
      '1106015370=             OR'
      '1106015371=             D.DELIVERY_DATE >= :DATE_'
      '1106015372=             )'
      '1106015373=      INTO :DELIVERY,'
      '1106015374=           :G_CLIENT,'
      '1106015375=           :DOSTAVSHIK,'
      '1106015376=           :TOVAR_DELIVERY_DATE,'
      '1106015377=           :DELIVERY_DATE,'
      '1106015378=           :ADDRESS,'
      '1106015379=           :PRICE,'
      '1106015380=           :NOTE'
      '1106015381=           ,:CLIENT_NAME'
      '1106015382=           ,:PHONE'
      '1106015383=           ,:DOST_NAME'
      '1106015384=           ,:STATUS'
      '1106015385=           ,:ZAKAZ'
      '1106015386=  DO'
      '1106015387=  BEGIN'
      '1106015388=    SUSPEND;'
      '1106015389=  END'
      '1106015390=END'
      '1106015391=;'
      '1106015392='
      '1106015393=ALTER PROCEDURE DELIVERY_UPD('
      '1106015394=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY,'
      '1106015395=  G_CLIENT_ TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '1106015396=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      
        '1106015397=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E,'
      '1106015398=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS,'
      '1106015399=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE,'
      '1106015400=  NOTE_ TYPE OF COLUMN DELIVERY.NOTE,'
      '1106015401=  STATUS_ TYPE OF COLUMN DELIVERY.STATUS,'
      '1106015402=  ZAKAZ_ TYPE OF COLUMN DELIVERY.ZAKAZ,'
      '1106015403=  SKLAD_ TYPE OF COLUMN DELIVERY.SKLAD,'
      
        '1106015404=  TOVAR_DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.TOVAR_' +
        'DELIVERY_DATE)'
      '1106015405=AS'
      '1106015406=BEGIN'
      '1106015407=  UPDATE DELIVERY'
      '1106015408=  SET G_CLIENT = :G_CLIENT_,'
      '1106015409=      DOSTAVSHIK = :DOSTAVSHIK_,'
      '1106015410=      DELIVERY_DATE = :DELIVERY_DATE_,'
      '1106015411=      ADDRESS = :ADDRESS_,'
      '1106015412=      PRICE = :PRICE_,'
      '1106015413=      NOTE = :NOTE_,'
      '1106015414=      STATUS = :STATUS_,'
      '1106015415=      ZAKAZ = :ZAKAZ_,'
      '1106015416=      SKLAD = :SKLAD_,'
      '1106015417=      TOVAR_DELIVERY_DATE = :TOVAR_DELIVERY_DATE_'
      '1106015418=  WHERE (DELIVERY = :DELIVERY_);'
      '1106015419=END'
      '1106015420=;'
      '1106015421='
      '1106015422=ALTER PROCEDURE DO_PRODUCT('
      '1106015423=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106015424=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1106015425=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1106015426=  AMOUNT_ INTEGER,'
      '1106015427=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '1106015428=RETURNS ('
      '1106015429=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1106015430=  ERR_CODE INTEGER,'
      '1106015431=  ERR_MSG VARCHAR(1024))'
      '1106015432=AS'
      '1106015433=/*'
      
        '1106015434='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1106015435='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1106015436=*/'
      
        '1106015437=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1106015438=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106015439=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1106015440=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1106015441=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1106015442=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1106015443=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1106015444=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1106015445=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M = 0;'
      
        '1106015446=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1106015447=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      '1106015448=BEGIN'
      '1106015449=  PNT_ = '#39'00'#39';'
      '1106015450='
      '1106015451=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106015452=    SELECT ID'
      '1106015453=      FROM CUR_PARAMS'
      '1106015454=     WHERE CUR_PARAMS = 2'
      '1106015455=      INTO :G_TOCHKA_;'
      '1106015456='
      '1106015457=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1106015458=  SELECT P.S_VALUE'
      '1106015459=    FROM SYSTEM_SETUP P'
      '1106015460=   WHERE P.SYSTEM_SETUP = 2'
      '1106015461=    INTO :CAN_SELL_;'
      '1106015462='
      '1106015463=  SELECT MAX(G.NAME)'
      '1106015464=    FROM G_PRODUCT G,'
      '1106015465=         G_PRODUCT_KIT K'
      '1106015466=   WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1106015467=     AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1106015468=     AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PROD' +
        'UCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCHKA' +
        '_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1106015469=    INTO :NAME_;'
      '1106015470='
      '1106015471=  IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEGIN'
      '1106015472=    ERR_CODE = -20500;'
      
        '1106015473=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072#1090#1086#1082' ' +
        #1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1089#1086#1073#1088#1072 +
        #1090#1100' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106015474=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106015475=    EXIT;'
      '1106015476=  END'
      '1106015477='
      '1106015478=  PNT_ = '#39'01'#39';'
      '1106015479=  -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1106015480=  INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIVAL' +
        '_TYPE, PARENT_ID, NOTE, G_TOCHKA)'
      
        '1106015481=  VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0, ' +
        '1, :OTHER_, :NOTE_, :G_TOCHKA_)'
      '1106015482=  RETURNING OTHER'
      '1106015483=  INTO :OTHER_;'
      '1106015484='
      '1106015485=  FOR SELECT K.G_PRODUCT_ITEM'
      '1106015486=            ,K.AMOUNT*:AMOUNT_'
      '1106015487=            ,K.amount'
      '1106015488=            ,G.G_PRODUCT'
      '1106015489=        FROM G_PRODUCT_KIT K'
      '1106015490=            ,G_PRODUCT G'
      '1106015491=       WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1106015492=         AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1106015493=        INTO :ITEM_'
      '1106015494=            ,:AMOUNT_NEED_'
      '1106015495=            ,:AMOUNT_NEED_ONE_'
      '1106015496=            ,:G_PRODUCT_KIT_'
      '1106015497=  DO BEGIN'
      
        '1106015498=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        'KIT_, NULL, 1)'
      '1106015499=      RETURNING_VALUES :SELF_PRICE_;'
      '1106015500='
      '1106015501=    UPDATE LT_SKLAD_PRODUCT L'
      '1106015502=       SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '1106015503=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1106015504=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106015505='
      '1106015506=    IF (ROW_COUNT = 0) THEN'
      
        '1106015507=      INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(GEN' +
        '_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G_TO' +
        'CHKA_);'
      '1106015508='
      
        '1106015509=    INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHER, ' +
        'G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1106015510=    VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_, :G' +
        '_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1106015511='
      
        '1106015512=    COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*SELF' +
        '_PRICE_;'
      '1106015513=  END'
      '1106015514='
      '1106015515='
      
        '1106015516=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063#1040#1051#1045 +
        ' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1106015517=  PNT_ = '#39'02'#39';'
      
        '1106015518=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PR' +
        'ICE, SUMM, NDS, NDS_SUMM)'
      
        '1106015519=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :A' +
        'MOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1106015520='
      '1106015521=  EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1106015522=                              :DATE_,'
      '1106015523=                              CURRENT_TIME,'
      '1106015524=                              NULL, --:G_CLIENT__,'
      
        '1106015525=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1106015526=                              NULL, --:OSNOVANIE__,'
      '1106015527=                              :NOTE_,'
      '1106015528=                              4, --:IS_VOZVRAT_,'
      '1106015529=                              :AMOUNT_*:COST_PRICE_,'
      '1106015530=                              :AMOUNT_*:COST_PRICE_,'
      '1106015531=                              0, --:G_PRIHOD_,'
      '1106015532=                              0 --:SUMM_PRIHOD_)'
      '1106015533=                              ,NULL     --PAYMENTS_'
      
        '1106015534=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1106015535=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106015536=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106015537=      EXIT;'
      '1106015538=  END'
      '1106015539='
      '1106015540=  UPDATE OTHER O'
      '1106015541=    SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1106015542=  WHERE O.OTHER = :OTHER_;'
      '1106015543=END'
      '1106015544=;'
      '1106015545='
      '1106015546=ALTER PROCEDURE DOCS_DEL('
      '1106015547=  DOCS_ TYPE OF COLUMN DOCS.DOCS)'
      '1106015548=AS'
      '1106015549=begin'
      '1106015550=  delete from docs'
      '1106015551=  where (docs = :docs_);'
      '1106015552=end'
      '1106015553=;'
      '1106015554='
      '1106015555=ALTER PROCEDURE DOCS_GET('
      '1106015556=  DOCS_ TYPE OF COLUMN DOCS.DOCS,'
      '1106015557=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106015558=  DOC_TYPE_ TYPE OF COLUMN DOCS.DOC_TYPE)'
      '1106015559=RETURNS ('
      '1106015560=  DOCS_ID_ TYPE OF COLUMN DOCS.DOCS,'
      '1106015561=  NUM_ TYPE OF COLUMN DOCS.NUM,'
      '1106015562=  DOCS_DATE_ TYPE OF COLUMN DOCS.DOCS_DATE,'
      '1106015563=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106015564=  G_FIRM_ADDRESS_ TYPE OF COLUMN DOCS.G_FIRM_ADDRESS,'
      '1106015565=  G_FIRM_ACCOUNT_ TYPE OF COLUMN DOCS.G_FIRM_ACCOUNT,'
      '1106015566=  G_CLIENT_ TYPE OF COLUMN DOCS.G_CLIENT,'
      
        '1106015567=  G_CLIENT_ADDRESS_ TYPE OF COLUMN DOCS.G_CLIENT_ADDR' +
        'ESS,'
      
        '1106015568=  G_CLIENT_ACCOUNT_ TYPE OF COLUMN DOCS.G_CLIENT_ACCO' +
        'UNT,'
      '1106015569=  G_OFFICIAL_ TYPE OF COLUMN DOCS.G_OFFICIAL,'
      '1106015570=  NOTE_ TYPE OF COLUMN DOCS.NOTE,'
      '1106015571=  PARAM1_ TYPE OF COLUMN DOCS.PARAM1,'
      '1106015572=  PARAM2_ TYPE OF COLUMN DOCS.PARAM2,'
      '1106015573=  PARAM3_ TYPE OF COLUMN DOCS.PARAM3,'
      '1106015574=  PARAM4_ TYPE OF COLUMN DOCS.PARAM4,'
      '1106015575=  PARAM5_ TYPE OF COLUMN DOCS.PARAM5,'
      '1106015576=  PARAM6_ TYPE OF COLUMN DOCS.PARAM6,'
      
        '1106015577=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN G_OFFICIAL.G_OFF' +
        'ICIAL,'
      '1106015578=  GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106015579=  IS_SAVED_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106015580=  ERR_CODE INTEGER,'
      '1106015581=  ERR_MSG VARCHAR(1024))'
      '1106015582=AS'
      '1106015583=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DOCS_GET'#39';'
      '1106015584=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106015585=BEGIN'
      
        '1106015586=  SELECT DOCS, DOCS ID, NUM, DOCS_DATE, G_FIRM, G_FIR' +
        'M_ADDRESS, G_FIRM_ACCOUNT, G_CLIENT, G_CLIENT_ADDRESS,'
      
        '1106015587=         G_CLIENT_ACCOUNT, G_OFFICIAL, G_OFFICIAL_RUK' +
        'OVOD, GLAVBUH, NOTE, PARAM1, PARAM2, PARAM3, PARAM4, PARAM5, PAR' +
        'AM6, 1'
      '1106015588=  FROM DOCS'
      
        '1106015589=  WHERE ((DOCS = :docs_ AND :docs_ <> 0)    -- '#1055#1056#1048' '#1057#1054 +
        #1047#1044#1040#1053#1048#1048' '#1044#1054#1050#1059#1052#1045#1053#1058#1040' '#1048#1051#1048' '#1045#1043#1054' '#1055#1056#1054#1057#1052#1054#1058#1056#1045' '#1042' '#1056#1045#1046#1048#1052#1045' "'#1055#1056#1054#1044#1040#1046#1048'" '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071 +
        ' docs_ '#1053#1045' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ==>'
      
        '1106015590=          OR                                -- ==> '#1055#1045 +
        #1056#1045#1044#1040#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' :ZAKAZ_'
      
        '1106015591=         (ZAKAZ = :ZAKAZ_ AND DOC_TYPE = :DOC_TYPE_ A' +
        'ND :docs_ = 0))'
      
        '1106015592=  INTO :DOCS_, :DOCS_ID_, :NUM_, :DOCS_DATE_, :G_FIRM' +
        '_, :G_FIRM_ADDRESS_, :G_FIRM_ACCOUNT_, :G_CLIENT_, :G_CLIENT_ADD' +
        'RESS_,'
      
        '1106015593=       :G_CLIENT_ACCOUNT_, :G_OFFICIAL_, :G_OFFICIAL_' +
        'RUKOVOD_, :GLAVBUH_, :NOTE_, :PARAM1_, :PARAM2_, :PARAM3_, :PARA' +
        'M4_, :PARAM5_, :PARAM6_, :IS_SAVED_;'
      '1106015594='
      '1106015595=  IF (ROW_COUNT = 0) then BEGIN'
      
        '1106015596=  --*************************************************' +
        '*'
      
        '1106015597=    -- '#1047#1053#1040#1063#1048#1058' '#1044#1054#1050#1059#1052#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056#1045#1044 +
        #1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1106015598=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1106015599=    SELECT'
      '1106015600=      G.g_firm_rekvizit,'
      '1106015601=      GF.g_address,'
      '1106015602=      A.g_account'
      '1106015603=    FROM G_FIRM_REKVIZIT g'
      
        '1106015604=           LEFT OUTER JOIN G_FIRM_ADDRESS GF ON G.G_F' +
        'IRM_REKVIZIT = GF.G_FIRM_REKVIZIT AND GF.IS_DEFAULT = 1'
      
        '1106015605=           LEFT OUTER JOIN G_FIRM_ACCOUNT A ON G.G_FI' +
        'RM_REKVIZIT = A.G_FIRM_REKVIZIT AND A.IS_DEFAULT = 1'
      '1106015606=    WHERE G.is_default = 1'
      '1106015607=    INTO'
      '1106015608=      :G_FIRM_,'
      '1106015609=      :G_FIRM_ADDRESS_,'
      '1106015610=      :G_FIRM_ACCOUNT_;'
      '1106015611='
      '1106015612=    -- '#1048#1053#1060#1054' '#1054' '#1050#1051#1048#1045#1053#1058#1045
      '1106015613=    SELECT G.g_client,'
      '1106015614=           GA.g_address,'
      '1106015615=           A.g_account'
      '1106015616=      FROM ZAKAZ Z,'
      '1106015617=           G_CLIENT G'
      
        '1106015618=           LEFT OUTER JOIN G_ADDRESS GA ON G.G_CLIENT' +
        ' = GA.G_CLIENT AND GA.IS_DEFAULT = 1'
      
        '1106015619=           LEFT OUTER JOIN G_ACCOUNT A ON G.G_CLIENT ' +
        '= A.G_CLIENT AND A.IS_DEFAULT = 1'
      '1106015620=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106015621=      AND Z.G_CLIENT = G.G_CLIENT'
      '1106015622=     INTO :G_CLIENT_,'
      '1106015623=          :G_CLIENT_ADDRESS_,'
      '1106015624=          :G_CLIENT_ACCOUNT_;'
      '1106015625='
      
        '1106015626=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058 +
        #1054#1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      '1106015627=    PNT_ = '#39'05'#39';'
      '1106015628=    SELECT C.id'
      '1106015629=      FROM cur_params C'
      '1106015630=     WHERE C.cur_params = 1'
      '1106015631=    INTO :G_OFFICIAL_;'
      '1106015632='
      '1106015633=    IF (ROW_COUNT = 0) then BEGIN'
      '1106015634=        SELECT MIN(O.G_OFFICIAL)'
      '1106015635=          FROM G_OFFICIAL O'
      '1106015636=          INTO :G_OFFICIAL_;'
      '1106015637=        IF (ROW_COUNT = 0) then BEGIN'
      '1106015638=            Err_Code = -20500;'
      
        '1106015639=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1057#1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '1106015640=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106015641=            EXIT;'
      '1106015642=        END'
      '1106015643=    END'
      '1106015644='
      '1106015645=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '1106015646=    SELECT O.G_OFFICIAL'
      '1106015647=    FROM G_OFFICIAL O'
      '1106015648=    WHERE O.IS_RUKOVODITEL = 1'
      '1106015649=    INTO :G_OFFICIAL_RUKOVOD_;'
      '1106015650='
      '1106015651=    --'#1048#1065#1059' '#1075#1083#1072#1074#1073#1091#1093#1072
      '1106015652=    SELECT O.G_OFFICIAL'
      '1106015653=    FROM G_OFFICIAL O'
      '1106015654=    WHERE O.IS_GLAVBUH = 1'
      '1106015655=    INTO :GLAVBUH_;'
      '1106015656='
      
        '1106015657=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1053#1040#1050#1051#1040#1044#1053#1054#1049', '#1057#1053#1040#1063#1040#1051#1040' '#1057#1044#1045#1051#1040 +
        #1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '1106015658=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VA' +
        'RCHAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '1106015659=      FROM DOCS P'
      '1106015660=     WHERE P.doc_type = :DOC_TYPE_'
      '1106015661=    INTO :NUM_;'
      '1106015662='
      
        '1106015663=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1042#1054#1054#1041#1065#1045 +
        ' '#1053#1045#1058
      '1106015664=      NUM_ = '#39'1'#39';'
      '1106015665=    DOCS_DATE_ = CURRENT_DATE;'
      '1106015666=  END'
      '1106015667=end'
      '1106015668=;'
      '1106015669='
      '1106015670=ALTER PROCEDURE DOCS_INS('
