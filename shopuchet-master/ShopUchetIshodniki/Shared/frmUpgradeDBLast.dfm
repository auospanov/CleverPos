        #1054#1052#1045#1056#1059
      '110228520=    PNT_ = '#39'02.2'#39';'
      
        '110228521=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
