      '1102401665=    SUMM_RASHOD_ = SUMM_RASHOD_ + SUMM;'
      '1102401666='
      
        '1102401667=    SUMM_RASHOD_ALL_BEZNAL_ = SUMM_RASHOD_ALL_BEZNAL_' +
        ' + SUMM;'
      '1102401668=  END'
      '1102401669='
      
        '1102401670=  -- '#1045#1057#1051#1048' FIRST_ITER = 1 '#1047#1053#1040#1063#1048#1058' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1044#1040#1053#1053#1067#1045' '#1045#1057#1058#1068',' +
        ' '#1056#1040#1057#1061#1054#1044' '#1041#1067#1051
      '1102401671=  IF (FIRST_ITER = 1) THEN BEGIN'
      
