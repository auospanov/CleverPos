      '1102283371=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102283372='
      
        '1102283373=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
