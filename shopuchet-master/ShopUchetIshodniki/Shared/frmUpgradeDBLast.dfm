      '110158150=        :VOLUME_PRICE_;'
      '110158151='
      '110158152=    if (ROW_COUNT = 0) then BEGIN'
      '110158153=      ERR_CODE = -20500;'
      
        '110158154=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083#1072#1090#1091#1088#1085#1099#1084' '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMER_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '110158155=      ERR_MSG = PROCNAME||ERR_MSG;'
      '110158156=      EXIT;'
      '110158157=    END'
      '110158158='
      
        '110158159=  END ELSE if (CHAR_LENGTH(TRIM(:NAME_)) > 0) then BEG' +
        'IN'
      
        '110158160=      --'#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MAX '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042#1044#1056#1059#1043' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1057' '#1058#1040#1050#1048#1052' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1052
      '110158161=      EXECUTE STATEMENT'
      
        '110158162=      '#39'SELECT G_PRODUCT, G_PRODUCT_PAR, PRICE FROM G_P' +
        'RODUCT '#39'||'
      '110158163=      '#39' WHERE G_PRODUCT = '#39'||'
      
        '110158164=                  '#39'(SELECT MAX(G_PRODUCT) FROM G_PRODU' +
        'CT '#39'||'
      
        '110158165=                  '#39' WHERE UPPER(NAME) LIKE '#39#39'%'#39'||:NAME' +
        '_||'#39'%'#39#39')'#39
      
        '110158166=      INTO :G_PRODUCT_, :G_PRODUCT_CATEGORY_, :PRICE_ ' +
