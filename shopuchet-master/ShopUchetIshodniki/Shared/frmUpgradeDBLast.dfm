      '1102121995=               '#39'  '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      '1102121996=               '#39'*'#39'||:VOZVRAT_CASH_AMOUNT_ AMOUNT,'
      '1102121997=               '#39'='#39'||:VOZVRAT_CASH_SUMM_ SUMM'
      '1102121998=          FROM RDB$DATABASE'
