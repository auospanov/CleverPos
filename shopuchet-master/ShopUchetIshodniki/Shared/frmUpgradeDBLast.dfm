      '1102400='
      '1102401='
      
        '1102402=/*******************************************************' +
        '***********************/'
      
        '1102403=/****                           Altering tables         ' +
        '                   ****/'
      
        '1102404=/*******************************************************' +
        '***********************/'
      '1102405=UPDATE RDB$RELATION_FIELDS SET RDB$NULL_FLAG = 1'
      
        '1102406=WHERE (RDB$FIELD_NAME = '#39'DATE_RECEIPT'#39') AND (RDB$RELATIO' +
        'N_NAME = '#39'SKLAD_PARENT'#39');'
      '1102407='
