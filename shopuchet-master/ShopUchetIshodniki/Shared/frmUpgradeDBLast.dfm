      '11044128='
      '11044129='
      '11044130=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_CLIENT('
      '11044131=  G_CLIENT_ INTEGER)'
      '11044132=RETURNS ('
      '11044133=  G_CLIENT_PARENT_ INTEGER,'
      '11044134=  G_CONTRAGENT_ INTEGER,'
      '11044135=  NAME_ VARCHAR(500),'
      '11044136=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11044137=  IDN_ VARCHAR(12),'
      '11044138=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11044139=  KBE_ VARCHAR(5),'
      '11044140=  SKIDKA_ NUMERIC(15,2),'
      '11044141=  BY_DEFAULT_ INTEGER,'
      '11044142=  IS_BEZNAL_ INTEGER,'
      '11044143=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11044144=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11044145=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '11044146=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '11044147=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11044148=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11044149=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11044150=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '11044151=  NOTIFY_SKIDKA_ INTEGER,'
      '11044152=  NOTIFY_DR_ INTEGER,'
      '11044153=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '11044154=  G_CLIENT_PROMO_ INTEGER,'
      '11044155=  FM_PROMO_ VARCHAR(50),'
      '11044156=  ERR_CODE INTEGER,'
      '11044157=  ERR_MSG VARCHAR(1024))'
      '11044158=AS'
      '11044159=begin'
      '11044160=    SELECT'
      
        '11044161=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE, ' +
        'SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '11044162=      ,P.G_PROMOTION'
      '11044163=      ,P.NAME'
      '11044164=      ,notify_dr'
      '11044165=      ,notify_skidka'
      
        '11044166=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T.' +
        'g_promotion = P.g_promotion'
      '11044167=    WHERE T.G_CLIENT = :G_CLIENT_'
      '11044168=    INTO'
      
        '11044169=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_,' +
        ' :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :DT' +
        '_, :NAME_FULL_'
      '11044170=      ,:G_PROMOTION_'
      '11044171=      ,:G_PROMOTION_STR_'
      '11044172=      ,:NOTIFY_DR_'
      '11044173=      ,:NOTIFY_SKIDKA_'
      '11044174=      ;'
      '11044175='
      '11044176=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '11044177=    FROM G_DISCONT_CARD'
      '11044178=    WHERE G_CLIENT = :G_CLIENT_'
      '11044179=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '11044180=end'
      '11044181='#39';'
      '11044182='
      '11044183=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_CLIENT('
      '11044184=  G_CLIENT_PARENT_ INTEGER,'
      '11044185=  G_CONTRAGENT_ INTEGER,'
      '11044186=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11044187=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11044188=  IDN_ VARCHAR(12),'
      '11044189=  KBE_ VARCHAR(5),'
      '11044190=  SKIDKA_ NUMERIC(15,2),'
      '11044191=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11044192=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11044193=  BY_DEFAULT_ INTEGER,'
      '11044194=  IS_SUPPLIER_ INTEGER,'
      '11044195=  IS_CATEGORY_ INTEGER,'
      '11044196=  IS_BEZNAL_ INTEGER,'
      '11044197=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11044198=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11044199=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11044200=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11044201=  NOTIFY_SKIDKA_ INTEGER,'
      '11044202=  NOTIFY_DR_ INTEGER,'
      '11044203=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '11044204=  G_CLIENT_PROMO_ INTEGER)'
      '11044205=RETURNS ('
      '11044206=  G_CLIENT_ INTEGER,'
      '11044207=  ERR_CODE INTEGER,'
      '11044208=  ERR_MSG VARCHAR(1024))'
      '11044209=AS'
      '11044210=DECLARE VARIABLE CNT_ INTEGER;'
      '11044211=begin'
      
        '11044212=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1' +
        ', '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11044213=    if (BY_DEFAULT_ = 1) then'
      '11044214=      UPDATE g_client'
      '11044215=         SET BY_DEFAULT = 0'
      '11044216=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11044217='
      
        '11044218=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G_' +
        'CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '11044219=                          IS_CATEGORY, IS_BEZNAL, PHONE' +
        ', NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR)'
      
        '11044220=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_,' +
        ' :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_, ' +
        ':BY_DEFAULT_,'
      
        '11044221=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE_' +
        ', :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR_' +
        ')'
      '11044222=    returning G_CLIENT'
      '11044223=    into :G_CLIENT_;'
      '11044224='
      '11044225=    if (IS_CATEGORY_ = 0) then BEGIN'
      '11044226=        IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11044227=            SELECT COUNT(*)'
      '11044228=              FROM G_DISCONT_CARD'
      '11044229=             WHERE BARCODE = :BARCODE_'
      
        '11044230=             AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040 +
        #1049#1058#1048' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11044231=             INTO :CNT_;'
      '11044232='
      '11044233=            IF (CNT_ > 0) THEN BEGIN'
      '11044234=              ERR_CODE = -20500;'
      
        '11044235=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39 +
        #39') RETURNING_VALUES (:ERR_MSG);'
      '11044236=              EXIT;'
      '11044237=            END'
      '11044238=        END'
      '11044239='
      
        '11044240=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11044241=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, 0, 0);'
      '11044242=    END'
      '11044243=end'
      '11044244='#39';'
      '11044245='
      '11044246=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_CLIENT('
      '11044247=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11044248=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      '11044249=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '11044250=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11044251=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11044252=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '11044253=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '11044254=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '11044255=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11044256=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11044257=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '11044258=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '11044259=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '11044260=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '11044261=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11044262=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11044263=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11044264=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11044265=  NOTIFY_SKIDKA_ INTEGER,'
      '11044266=  NOTIFY_DR_ INTEGER,'
      '11044267=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '11044268=  G_CLIENT_PROMO_ INTEGER)'
      '11044269=RETURNS ('
      '11044270=  ERR_CODE INTEGER,'
      '11044271=  ERR_MSG VARCHAR(1024))'
      '11044272=AS'
      '11044273=DECLARE VARIABLE CNT_ INTEGER;'
      '11044274=BEGIN'
      
        '11044275=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1, ' +
        #1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11044276=  if (BY_DEFAULT_ = 1) then'
      '11044277=    UPDATE g_client'
      '11044278=       SET BY_DEFAULT = 0'
      '11044279=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11044280='
      '11044281=  UPDATE g_client'
      '11044282=  SET'
      
        '11044283=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CLIE' +
        'NT_PARENT),'
      
        '11044284=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTRAG' +
        'ENT),'
      '11044285=   NAME = COALESCE(:NAME_, NAME),'
      '11044286=   IDN  = COALESCE(:IDN_, IDN),'
      '11044287=   KBE  = COALESCE(:KBE_, KBE),'
      '11044288=   PHONE = COALESCE(:PHONE_, PHONE),'
      '11044289=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '11044290=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      '11044291=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER),'
      '11044292=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '11044293=   ,DT    = COALESCE(:DT_, DT)'
      '11044294=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '11044295=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '11044296=   ,G_PROMOTION = :G_PROMOTION_'
      '11044297=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '11044298=   ,NOTIFY_DR = :NOTIFY_DR_'
      '11044299=  WHERE'
      '11044300=    g_client = :g_client_;'
      '11044301='
      '11044302=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '11044303=    IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11044304=        SELECT COUNT(*)'
      '11044305=          FROM G_DISCONT_CARD'
      '11044306=         WHERE BARCODE = :BARCODE_'
      
        '11044307=         AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040#1049#1058#1048' ' +
        #1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11044308=         INTO :CNT_;'
      '11044309='
      '11044310=        IF (CNT_ > 0) THEN BEGIN'
      '11044311=          ERR_CODE = -20500;'
      
        '11044312=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1050#1072#1088 +
        #1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11044313=          EXIT;'
      '11044314=        END'
      '11044315=    END'
      '11044316='
      '11044317=    UPDATE G_DISCONT_CARD G'
      '11044318=    SET G.BARCODE = :BARCODE_,'
      '11044319=        G.N_PERCENT = :N_PERCENT_,'
      '11044320=        G.summ = COALESCE(G.summ, 0),'
      '11044321=        G.summ_all = COALESCE(G.summ_all, 0)'
      '11044322=    WHERE G.G_CLIENT = :g_client_;'
      '11044323='
      '11044324=    if (ROW_COUNT = 0) then'
      
        '11044325=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_CLI' +
        'ENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11044326=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIENT_' +
        ', :BARCODE_, :N_PERCENT_, 0, (select Coalesce(sum(SUMM_FACT), 0)' +
        ' from zakaz where g_client = :g_client_));'
      '11044327=  END'
      '11044328=end'
      '11044329='#39';'
      '11044330='
      
        '11044331=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRODAZHA_WAYBI' +
        'LL('
      '11044332=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11044333=  CURRENCY_ INTEGER)'
      '11044334=RETURNS ('
      '11044335=  NUMBER_STR_ VARCHAR(200),'
      '11044336=  ROW_NUM INTEGER,'
      '11044337=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11044338=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11044339=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11044340=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11044341=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11044342=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11044343=  AMOUNT VARCHAR(50),'
      '11044344=  PRICE_N VARCHAR(50),'
      '11044345=  SUMM_N VARCHAR(50),'
      '11044346=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11044347=  SUMM_VSEGO_ VARCHAR(50),'
      '11044348=  NDS_SUMM_ VARCHAR(50),'
      '11044349=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11044350=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11044351=  SUMM_STR_ VARCHAR(500),'
      '11044352=  NDS_SUMM_STR_ VARCHAR(500),'
      '11044353=  ERR_CODE NUMERIC(15,2),'
      '11044354=  ERR_MSG VARCHAR(1024))'
      '11044355=AS'
      '11044356=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '11044357=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRODAZH' +
        'A_WAYBILL'#39#39';'
      '11044358=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11044359=DECLARE VARIABLE I INTEGER = 1;'
      
        '11044360=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11044361=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS_' +
        'SUMM;'
      '11044362=BEGIN'
      '11044363='
      
        '11044364=  SELECT decode(P.is_spisanie, 1, '#39#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39#39', '#39#39#1053#1072#1082#1083 +
        #1072#1076#1085#1072#1103' '#8470#39#39'||P.ZAKAZ)||'#39#39' '#1086#1090' '#39#39'||lpad(EXTRACT(DAY FROM P.z_date), ' +
        '2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39#39'.'#39 +
        #39'||EXTRACT(YEAR FROM P.z_date),'
      '11044365=         G.name'
      '11044366=    FROM ZAKAZ P,'
      '11044367=         G_CLIENT G'
      '11044368=   WHERE P.ZAKAZ = :ZAKAZ_'
      '11044369=     AND P.g_client = G.G_CLIENT'
      '11044370=    INTO :NUMBER_STR_,'
      '11044371=         :CLIENT_NAME_;'
      '11044372='
      
        '11044373=  SELECT REPLACE(CAST(SUM(S.amount) AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39')'
      
        '11044374=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39')'
      
        '11044375=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ)' +
        ', :CURRENCY_))'
      
        '11044376=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(10)),' +
        ' '#39#39'.'#39#39', '#39#39','#39#39')'
      '11044377=         ,SUM(S.nds_summ)'
      '11044378=    FROM ZAKAZ_DETAILS S'
      '11044379=   WHERE S.ZAKAZ = :ZAKAZ_'
      '11044380=   GROUP BY S.ZAKAZ'
      '11044381=    INTO :AMOUNT_VSEGO_,'
      '11044382=         :SUMM_VSEGO_,'
      '11044383=         :summ_str_,'
      '11044384=         :NDS_SUMM_,'
      '11044385=         :NDS_;'
      '11044386='
      '11044387=  if (NDS_ > 0) then'
      
        '11044388=    SELECT '#39#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39#39'||CURR_STR from CURRENC' +
        'YSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '11044389='
      '11044390=  SELECT NAME'
      '11044391=    FROM CUR_PARAMS'
      '11044392=   WHERE CUR_PARAMS = 1'
      '11044393=    INTO :G_OFFICIAL_FM_;'
      '11044394='
      '11044395=  FOR SELECT :I,'
      '11044396=             C.NAME,'
      '11044397=             G.name,'
      '11044398=             G.ARTICUL,'
      '11044399=             G.BARCODE,'
      '11044400=             G.NOMENCLATUR_NUM,'
      '11044401=             U.short_name,'
      
        '11044402=             REPLACE(CAST(S.amount AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39'),'
      
        '11044403=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39#39'.'#39 +
        #39', '#39#39','#39#39'),'
      
        '11044404=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39#39'.'#39#39 +
        ', '#39#39','#39#39')'
      
        '11044405=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, G_' +
        'PRODUCT C'
      '11044406=       WHERE S.ZAKAZ = :ZAKAZ_'
      '11044407=         AND S.g_product = G.g_product'
      '11044408=         AND G.g_unit = U.g_unit'
      '11044409=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '11044410=        INTO :ROW_NUM,'
      '11044411=            :CATEGORY_NAME,'
      '11044412=            :NAME,'
      '11044413=            :ARTICUL,'
      '11044414=            :BARCODE,'
      '11044415=            :NOMENCLATUR_NUM,'
      '11044416=            :SHORT_NAME,'
      '11044417=            :AMOUNT,'
      '11044418=            :PRICE_N,'
      '11044419=            :SUMM_N'
      '11044420=  DO BEGIN'
      '11044421=    I = I + 1;'
      '11044422=    SUSPEND;'
      '11044423=  END'
      '11044424=WHEN ANY DO BEGIN'
      '11044425=    Err_code = -20500;'
      
        '11044426=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11044427=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11044428=  END'
      '11044429=end'
      '11044430='#39';'
      
        '11044431=UPDATE SYSTEM_SETUP SET S_VALUE = 11044 WHERE SYSTEM_SE' +
        'TUP = 3;'
      '11044432=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110450=EXECUTE BLOCK AS BEGIN'
      
        '110451=UPDATE SYSTEM_SETUP SET S_VALUE = 11045 WHERE SYSTEM_SETU' +
        'P = 3;'
      '110452=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110460=EXECUTE BLOCK AS BEGIN'
      
        '110461=UPDATE SYSTEM_SETUP SET S_VALUE = 11046 WHERE SYSTEM_SETU' +
        'P = 3;'
      '110462=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110470=EXECUTE BLOCK AS BEGIN'
      '110471=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_ZAKAZ_DETAILS_TMP('
      
        '110472=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ_D' +
        'ETAILS)'
      '110473=RETURNS ('
      '110474=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT,'
      '110475=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110476=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110477=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110478=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOUN' +
        'T_PERC,'
      
        '110479=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_TENGE,'
      
        '1104710=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_SUMM,'
      '1104711=  NDS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1104712=  NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1104713=  TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1104714=  ROZN_PRICE_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1104715=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1104716=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1104717=  OSTATOK_ INTEGER,'
      '1104718=  CNT_Z_ INTEGER,'
      '1104719=  ERR_CODE INTEGER,'
      '1104720=  ERR_MSG VARCHAR(1024))'
      '1104721=AS'
      '1104722=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      '1104723=BEGIN'
      '1104724=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '1104725=  /*CNT_Z_ = 0;'
      '1104726=  SELECT COUNT(*)'
      '1104727=    FROM (SELECT *'
      '1104728=           FROM ZAKAZ Z ROWS 1 TO 100)'
      '1104729=    INTO :CNT_Z_;*/'
      '1104730='
      '1104731=  SELECT'
      '1104732=    t.G_PRODUCT,'
      '1104733=    t.AMOUNT,'
      '1104734=    t.PRICE,'
      '1104735=    t.SUMM,'
      '1104736=    t.DISCOUNT_PERC,'
      '1104737=    T.DISCOUNT_TENGE,'
      '1104738=    T.DISCOUNT_SUMM,'
      '1104739=    T.NDS,'
      '1104740=    T.NDS_SUMM,'
      '1104741=    G.NAME,'
      '1104742=    G.price,'
      '1104743=    G.VOLUME_PRICE,'
      '1104744=    G.PACK_AMOUNT,'
      '1104745=    LT.AMOUNT'
      '1104746=  FROM ZAKAZ_DETAILS_TMP t,'
      
        '1104747=       G_PRODUCT G LEFT OUTER JOIN LT_SKLAD_PRODUCT LT O' +
        'N G.G_PRODUCT = LT.G_PRODUCT AND LT.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1104748=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1104749=    AND T.G_PRODUCT = G.G_PRODUCT'
      '1104750=  INTO'
      '1104751=    :G_PRODUCT_,'
      '1104752=    :AMOUNT_,'
      '1104753=    :PRICE_,'
      '1104754=    :SUMM_,'
      '1104755=    :DISCOUNT_PERC_,'
      '1104756=    :DISCOUNT_TENGE_,'
      '1104757=    :DISCOUNT_SUMM_,'
      '1104758=    :NDS_,'
      '1104759=    :NDS_SUMM_,'
      '1104760=    :TOVAR_NAME_,'
      '1104761=    :ROZN_PRICE_,'
      '1104762=    :VOLUME_PRICE_,'
      '1104763=    :PACK_AMOUNT_,'
      '1104764=    :OSTATOK_;'
      '1104765=end'
      '1104766='#39';'
      '1104767='
      '1104768=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD_TMP('
      '1104769=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1104770=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1104771=  PRICE_ NUMERIC(15,2),'
      '1104772=  SUMM_ NUMERIC(15,2),'
      '1104773=  NDS_ NUMERIC(15,2),'
      '1104774=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1104775=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY = ' +
        '0,'
      '1104776=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = 0)'
      '1104777=RETURNS ('
      '1104778=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1104779=  ERR_CODE INTEGER,'
      '1104780=  ERR_MSG VARCHAR(1024))'
      '1104781=AS'
      
        '1104782=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD_TMP' +
        #39#39';'
      '1104783=BEGIN'
      '1104784=  SELECT T.SKLAD'
      '1104785=    FROM SKLAD_TMP T'
      '1104786=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1104787=     AND T.PRICE = :PRICE_'
      '1104788=    INTO :SKLAD_;'
      '1104789='
      '1104790=  IF (SKLAD_ IS NOT NULL) THEN'
      '1104791=    UPDATE SKLAD_TMP T'
      '1104792=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1104793=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1104794=     WHERE T.G_PRODUCT = :G_PRODUCT_;'
      '1104795='
      '1104796=  ELSE'
      
        '1104797=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, P' +
        'RICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY)'
      
        '1104798=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :' +
        'AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '1104799=        ,:PRICE_CURRENCY_'
      '11047100=        ,:SUMM_CURRENCY_)'
      '11047101=      RETURNING SKLAD'
      '11047102=      INTO :SKLAD_;'
      '11047103=end'
      '11047104='#39';'
      '11047105='
      
        '11047106=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ_DETAILS_TM' +
        'P('
      
        '11047107=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT' +
        ','
      '11047108=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11047109=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11047110=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '11047111=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '11047112=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '11047113=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '11047114=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '11047115=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '11047116=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '11047117=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '11047118=  IS_SPISANIE_ INTEGER,'
      '11047119=  NEW_LINE_SALE_ INTEGER = 0,'
      '11047120=  MODE_ INTEGER = 0)'
      '11047121=RETURNS ('
      
        '11047122=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '11047123=  ERR_CODE INTEGER,'
      '11047124=  ERR_MSG VARCHAR(1024))'
      '11047125=AS'
      
        '11047129=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39#39';'
      
        '11047130=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0;'
      
        '11047131=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.AMOUNT = 0;'
      
        '11047132=DECLARE VARIABLE ZAKAZ_ INTEGER = 0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID ' +
        #1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047#1040#1050#1040#1047' */'
      
        '11047133=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' */'
      
        '11047134=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '11047135=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.Z_TYPE = 0;'
      
        '11047136=DECLARE VARIABLE AMOUNT__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.AMOUNT;'
      
        '11047137=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.PRICE;'
      
        '11047138=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.COST_PRICE;'
      
        '11047139=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '11047140=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KI' +
        'T;'
      
        '11047141=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051 +
        #1048#1062#1045' */'
      '11047142=BEGIN'
      '11047143='
      '11047145=  SELECT T.ZAKAZ, T.Z_TYPE'
      '11047146=    FROM ZAKAZ_DETAILS_TMP T'
      '11047147=   WHERE T.ZAKAZ IS NOT NULL'
      
        '11047148=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089#1090 +
        #1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072' ' +
        'MULTIPLE ROWS IN SINGLETON SELECT'
      '11047149=    INTO :ZAKAZ_, :Z_TYPE_;'
      '11047150='
      
        '11047151=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051#1045 +
        #1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11047152=           ,G.IS_KIT'
      '11047153=           ,K.AMOUNT * :AMOUNT_'
      '11047154=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '11047155=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRIC' +
        'E)'
      
        '11047156=           ,(SELECT * FROM GET_LAST_SELF_PRICE(K.G_PROD' +
        'UCT_ITEM, NULL, 1)) COST_PRICE'
      
        '11047157=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K ' +
        'ON G.G_PRODUCT = K.G_PRODUCT'
      '11047158=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11047159=       AND IS_KIT = 1'
      '11047160=    UNION'
      
        '11047161=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054#1044 +
        #1040#1046
      '11047162=           ,G.IS_KIT'
      '11047163=           ,:AMOUNT_'
      '11047164=           ,:PRICE_'
      '11047165=           ,0'
      '11047166=           ,:COST_PRICE_'
      '11047167=      FROM G_PRODUCT G'
      '11047168=     WHERE G_PRODUCT = :G_PRODUCT_'
      '11047169=       AND IS_KIT <> 1'
      '11047170=      INTO :G_PRODUCT_'
      '11047171=           ,:IS_KIT_'
      '11047172=           ,:AMOUNT_'
      '11047173=           ,:PRICE__'
      '11047174=           ,:SOSTAV_PRICE_'
      '11047175=           ,:COST_PRICE__'
      '11047176=  DO BEGIN'
      
        '11047177=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090#1089 +
        #1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083#1077 +
        #1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '11047178=      IF (IS_KIT_ = 1) THEN BEGIN'
      '11047179=        IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '11047180=          PRICE__ = COST_PRICE__;'
      '11047181='
      
        '11047182=        END ELSE IF (Discount_perc_ <> 0) THEN BEGIN   ' +
        '   -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '11047183=          DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PERC_/10' +
        '0;'
      '11047184='
      '11047185='
      
        '11047186=        END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN BEGI' +
        'N   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '11047187=          DISCOUNT_PERC_ = PRICE_ * 100 / SOSTAV_PRICE_' +
        ';'
      '11047188=          DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_;'
      '11047189=        END'
      '11047190='
      '11047191=        DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT_;'
      '11047192=        SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOUNT_;'
      '11047193=        NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '11047194=      END'
      '11047195='
      
        '11047196=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045#1057 +
        #1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '11047197=      IF (NEW_LINE_SALE_ = 0) THEN'
      '11047198=          SELECT ZD.zakaz_details'
      '11047199=            FROM zakaz_details_tmp ZD'
      '11047200=           WHERE ZD.G_PRODUCT = :g_product_'
      '11047201=             AND ZD.PRICE = :PRICE__'
      '11047202=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '11047203=            INTO :ZAKAZ_DTLS_TMP_;'
      '11047204='
      '11047205='
      '11047206=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '11047207=        UPDATE ZAKAZ_DETAILS_TMP P'
      '11047208=           SET P.amount = P.amount + :amount_'
      
        '11047209=               ,P.summ = (P.price - P.discount_TENGE) *' +
        ' (P.amount + :AMOUNT_)'
      
        '11047210=               ,P.discount_summ = P.discount_TENGE * (P' +
        '.amount + :AMOUNT_)'
      '11047211=               ,P.NDS = :NDS_'
      '11047212=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '11047213=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '11047214='
      '11047215=      ELSE BEGIN'
      '11047216=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '11047217=          ('
      '11047218=           ZAKAZ_DETAILS,'
      '11047219=           ZAKAZ,'
      '11047220=           G_PRODUCT,'
      '11047221=           AMOUNT,'
      '11047222=           PRICE,'
      '11047223=           SUMM,'
      '11047224=           DISCOUNT_PERC,'
      '11047225=           DISCOUNT_TENGE,'
      '11047226=           DISCOUNT_SUMM,'
      '11047227=           NDS,'
      '11047228=           NDS_SUMM,'
      '11047229=           COST_PRICE'
      '11047230=          ) VALUES ('
      '11047231=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '11047232=           :ZAKAZ_,'
      '11047233=           :G_PRODUCT_,'
      '11047234=           :AMOUNT_,'
      '11047235=           :PRICE__,'
      '11047236=           :SUMM_,'
      '11047237=           :DISCOUNT_PERC_,'
      '11047238=           :DISCOUNT_TENGE_,'
      '11047239=           :DISCOUNT_SUMM_,'
      '11047240=           :NDS_,'
      '11047241=           :NDS_SUMM_,'
      '11047242=           :COST_PRICE__'
      '11047243=          )'
      '11047244=          RETURNING'
      '11047245=            ZAKAZ_DETAILS'
      '11047246=          INTO'
      '11047247=            :ZAKAZ_DETAILS_;'
      '11047248=      END'
      '11047249='
      '11047250=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11047251=      SELECT AMOUNT - AMOUNT_RESERVE'
      '11047252=        FROM LT_SKLAD_PRODUCT L'
      '11047253=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '11047254=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11047255=       INTO :AMOUNT_CUR_;'
      '11047256='
      
        '11047257=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048 +
        #1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '11047258=      if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '11047264=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '11047265=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '11047266=              SELECT SUM(AMOUNT)'
      '11047267=                FROM ZAKAZ_DETAILS T'
      '11047268=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11047269=                 AND T.ZAKAZ = :ZAKAZ_'
      '11047270=                INTO :AMOUNT_OLD_;'
      '11047271=            ELSE'
      '11047272=              SELECT SUM(AMOUNT)'
      '11047273=                FROM SKLAD T'
      '11047274=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11047275=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '11047276=                INTO :AMOUNT_OLD_;'
      '11047277=          END'
      '11047278='
      '11047279=          -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '11047280=          SELECT SUM(AMOUNT)'
      '11047281=            FROM ZAKAZ_DETAILS_TMP T'
      '11047282=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11047283=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '11047284='
      
        '11047285=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ' +
        '_, 0);'
      '11047286=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '11047287='
      
        '11047288=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COAL' +
        'ESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '11047289=            SELECT NAME'
      '11047290=            FROM G_PRODUCT'
      '11047291=            WHERE G_PRODUCT = :G_PRODUCT_'
      '11047292=            INTO :PRODUCT_NAME_;'
      '11047293='
      '11047294=            ERR_CODE = -20500;'
      
        '11047295=            ERR_MSG = '#39#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39#39'||PRODUCT_' +
        'NAME_||'#39#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39#39'||ASCII_CHAR(10)||'
      
        '11047296=                      '#39#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39#39';'
      
        '11047297=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR' +
        '_MSG) RETURNING_VALUES (:ERR_MSG);'
      '11047298=            ERR_MSG = PROCNAME||ERR_MSG;'
      '11047299=            EXIT;'
      '11047300=          END'
      '11047301=      END'
      '11047302=  END'
      '11047303=end'
      '11047304='#39';'
      
        '11047305=UPDATE SYSTEM_SETUP SET S_VALUE = 11047 WHERE SYSTEM_SE' +
        'TUP = 3;'
