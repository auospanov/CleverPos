        '11042757=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048#1057 +
        #1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '11042758=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FROM' +
        ' SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
