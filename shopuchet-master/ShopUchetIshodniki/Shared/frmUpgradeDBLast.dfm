      '11041789=     WHERE CUR_PARAMS = 2'
      '11041790=      INTO :G_TOCHKA_;'
      '11041791='
      
        '11041792=  --***************************************************' +
        '***********************************************'
      
        '11041793=  --***************************************************' +
        '***********************************************'
      '11041794=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11041795=  --***************************************************' +
        '***********************************************'
      
        '11041796=  --***************************************************' +
        '***********************************************'
      '11041797=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '11041798=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1055#1054 +
        #1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '11041799=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '11041800=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '11041801=            INTO :AMOUNT_,'
      '11041802=                 :G_PRODUCT_'
      '11041803=      DO BEGIN'
      '11041804=          UPDATE LT_SKLAD_PRODUCT L'
      '11041805=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '11041806=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11041807=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '11041808=      END'
      '11041809='
      '11041810=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '11041811=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE' +
        ','
      
        '11041812=                                     DISCOUNT_SUMM, NDS' +
        ', NDS_SUMM, COST_PRICE)'
      
        '11041813=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, P' +
        'RICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '11041814=             NDS_SUMM, COST_PRICE'
      '11041815=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '11041816='
      '11041817=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '11041818=                                  :Z_DATE_,'
      '11041819=                                  :Z_TIME_,'
      '11041820=                                  :G_CLIENT_,'
      '11041821=                                  :G_PAYMENT_TYPE_,'
      '11041822=                                  :OSNOVANIE_,'
      
        '11041823=                                  :IS_SPISANIE_,   -- :' +
        'IS_SPISANIE_'
      '11041824=                                  :NOTE_,'
      
        '11041825=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040#1050 +
        #1040#1047#1040
      
        '11041826=                                  :SUMM_FACT_,  -- '#1048' '#1057#1059 +
        #1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '11041827=                                  DECODE(G_PAYMENT_TYPE' +
        '_, 1, SUMM_FACT_, 0),'
      
        '11041828=                                  DECODE(G_PAYMENT_TYPE' +
        '_, 2, SUMM_FACT_, 0),'
      '11041829=                                  0, --SUMM_BONUS_'
      '11041830=                                  0, --SUMM_BONUS_GOT_'
      
        '11041831=                                  null,         -- '#1057#1058#1040#1058 +
        #1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '11041832=                                  0,            -- '#1057#1059#1052#1052 +
        #1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '11041833=                                  0,    --BY_RECIPE'
      '11041834=                                  0     --IS_RESERVE'
      '11041835=                                  ,NULL  -- PAYMENTS_'
      '11041836=                                  )'
      '11041837=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '11041838='
      '11041839=      if (ERR_CODE <> 0) then BEGIN'
      '11041840=        ERR_CODE = -20500;'
      '11041841=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '11041842=        Exit;'
      '11041843=      END'
      '11041844='
      
        '11041845=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' '#1040#1055 +
        #1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' '#1055 +
        #1054#1044' '#1056#1045#1040#1051
      
        '11041846=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044#1040' ' +
        #1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '11041847=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054#1055#1051 +
        #1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042#1045#1044 +
        #1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '11041848=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063 +
        #1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '11041849=      UPDATE ZAKAZ'
      '11041850=         SET IS_SPISANIE = 2'
      '11041851=       WHERE ZAKAZ = :ZAKAZ_;'
      '11041852='
      
        '11041853=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '11041854=      FOR SELECT T.AMOUNT,'
      '11041855=                 T.SUMM,'
      '11041856=                 T.G_PRODUCT,'
      '11041857=                 T.ZAKAZ_NA_REAL,'
      '11041858=                 T.ZAKAZ_DETAILS'
      '11041859=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '11041860=            INTO :AMOUNT_,'
      '11041861=                 :Z_SUMM_,'
      '11041862=                 :G_PRODUCT_,'
      '11041863=                 :ZAKAZ_NA_REAL_,'
      '11041864=                 :ZAKAZ_DETAILS_'
      '11041865=      DO BEGIN'
      '11041866=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '11041867=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOUN' +
        'T_,'
      
        '11041868=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM_' +
        ','
      
        '11041869=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, CO' +
        'ALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + :' +
        'AMOUNT_, 1, 0)'
      '11041870=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '11041871='
      
        '11041872=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '11041873=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKAZ' +
        '_NA_REAL, ZAKAZ_DETAILS)'
      
        '11041874=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_NA' +
        '_REAL_, :ZAKAZ_DETAILS_);'
      '11041875=      END'
      '11041876=  END'
      '11041877=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11041878=  --***************************************************' +
        '***********************************************'
      
        '11041879=  --***************************************************' +
        '***********************************************'
      '11041880='
      
        '11041881=  --***************************************************' +
        '***********************************************'
      
        '11041882=  --***************************************************' +
        '***********************************************'
      '11041883=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11041884=  --***************************************************' +
        '***********************************************'
      
        '11041885=  --***************************************************' +
        '***********************************************'
      '11041886=  ELSE BEGIN'
      '11041887=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '11041888=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ZAK' +
        'AZ_DETAILS - ZAKAZ_REAL'
      
        '11041889=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '11041890=      FOR SELECT T.AMOUNT,'
      '11041891=                 T.SUMM,'
      '11041892=                 T.G_PRODUCT,'
      '11041893=                 T.ZAKAZ_NA_REAL,'
      '11041894=                 T.ZAKAZ_DETAILS'
      '11041895=                 ,T.PRICE'
      '11041896=                 ,T.NDS'
      '11041897=                 ,T.NDS_SUMM'
      '11041898=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '11041899=            INTO :AMOUNT_,'
      '11041900=                 :Z_SUMM_,'
      '11041901=                 :G_PRODUCT_,'
      '11041902=                 :ZAKAZ_NA_REAL_,'
      '11041903=                 :ZAKAZ_DETAILS_'
      '11041904=                 ,:PRICE_'
      '11041905=                 ,:NDS_'
      '11041906=                 ,:NDS_SUMM_'
      '11041907=      DO BEGIN'
      
        '11041908=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '11041909=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '11041910='
      
        '11041911=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKAZ' +
        '_NA_REAL, SKLAD)'
      
        '11041912=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_NA' +
        '_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '11041913='
      '11041914=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '11041915=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_RE' +
        'TURNED, 0) + :AMOUNT_,'
      
        '11041916=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RETU' +
        'RNED, 0) + :Z_SUMM_,'
      
        '11041917=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, CO' +
        'ALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + :' +
        'AMOUNT_, 1, 0)'
      '11041918=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '11041919=      END'
      '11041920='
      '11041921=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '11041922=                                  :Z_DATE_,'
      '11041923=                                  :Z_TIME_,'
      '11041924=                                  :G_CLIENT_,'
      '11041925=                                  :G_PAYMENT_TYPE_,'
      '11041926=                                  :OSNOVANIE_,'
      '11041927=                                  :NOTE_,'
      
        '11041928=                                  2,        --:IS_VOZVR' +
        'AT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-'#1050 +
        #1059
      '11041929=                                  :SUMM_,'
      '11041930=                                  :SUMM_FACT_,'
      
        '11041931=                                  NULL,     --:G_PRIHOD' +
        '_,'
      
        '11041932=                                  NULL      --:SUMM_PRI' +
        'HOD_'
      '11041933=                                  ,NULL     -- PAYMENTS'
      
        '11041934=                                  ) RETURNING_VALUES :S' +
        'KLAD_, :ERR_CODE, :ERR_MSG;'
      '11041935='
      '11041936=      if (ERR_CODE <> 0) then BEGIN'
      '11041937=        ERR_CODE = -20500;'
      '11041938=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '11041939=        Exit;'
      '11041940=      END'
      '11041941=  END'
      '11041942=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11041943=  --***************************************************' +
        '***********************************************'
      
        '11041944=  --***************************************************' +
        '***********************************************'
      '11041945='
      '11041946=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '11041947=END'
      '11041948='#39';'
      '11041949=END  --END_EXECUTE_BLOCK'
      '11041950=EXECUTE BLOCK AS BEGIN'
      '11041951='
      '11041952=EXECUTE STATEMENT '#39'ALTER PROCEDURE R_UNIFICATION('
      '11041953=  MODE_ INTEGER)'
      '11041954=RETURNS ('
      '11041955=  COUNT_SPIS_ INTEGER,'
      '11041956=  COUNT_PRIH_ INTEGER,'
      '11041957=  ERR_CODE INTEGER,'
      '11041958=  ERR_MSG VARCHAR(1024))'
      '11041959=AS'
      
        '11041960=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'R_UNIFICATION' +
        #39#39';'
      '11041961=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11041962=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REVI' +
        'SION;'
      
        '11041963=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_P' +
        'RODUCT;'
      
        '11041964=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AMO' +
        'UNT_BD;'
      
        '11041965=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_REAL;'
      
        '11041966=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRICE' +
        ';'
      '11041967=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11041968=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11041969=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKL' +
        'AD;'
      
        '11041970=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11041971=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      '11041972=BEGIN'
      '11041973='
      '11041974=  COUNT_SPIS_ = 0;'
      '11041975=  COUNT_PRIH_ = 0;'
      '11041976='
      '11041977=  SELECT ID'
      '11041978=    FROM CUR_PARAMS'
      '11041979=   WHERE CUR_PARAMS = 2'
      '11041980=    INTO :G_TOCHKA_;'
      '11041981='
      
        '11041982=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REA' +
        'L'
      '11041983=      FROM REVISION'
      
        '11041984=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOUN' +
        'T_REAL_'
      '11041985=  DO BEGIN'
      
        '11041986=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2)' +
        ')) THEN BEGIN'
      
        '11041987=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1)'
      '11041988=        RETURNING_VALUES :COST_PRICE_;'
      '11041989='
      
        '11041990=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_P' +
        'RODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '11041991=                                     DISCOUNT_SUMM, NDS' +
        ', NDS_SUMM)'
      
        '11041992=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, ' +
        ':AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMOU' +
        'NT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '11041993='
      '11041994=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '11041995=    END'
      '11041996='
      
        '11041997=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1)' +
        ')) then BEGIN'
      '11041998=      SELECT S.PRICE'
      '11041999=        FROM SKLAD S'
      '110411000=       WHERE S.IS_LAST = 1'
      '110411001=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110411002=         AND S.G_TOCHKA = :G_TOCHKA_'
      '110411003=        INTO :PRICE_LAST_;'
      '110411004='
      
        '110411005=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056 +
        #1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '110411006='
      
        '110411007=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110411008=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AM' +
        'OUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '110411009='
      '110411010=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '110411011=    END'
      '110411012='
      '110411013=    UPDATE REVISION R'
      '110411014=       SET R.IS_UNIFIED = 1'
      '110411015=     WHERE R.REVISION = :REVISION_;'
      '110411016=  END'
      '110411017='
      '110411018=  PNT_ = '#39#39'01'#39#39';'
      '110411019=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '110411020=    SELECT SUM(S.SUMM)'
      '110411021=      FROM ZAKAZ_DETAILS_TMP S'
      '110411022=      INTO :SUMM_;'
      '110411023='
      '110411024=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110411025=                                CURRENT_DATE, --:Z_DAT' +
        'E_,'
      
        '110411026=                                CURRENT_TIME, --:Z_TIM' +
        'E'
      
        '110411027=                                10,          --:G_CLIE' +
        'NT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '110411028=                                1,            --:G_PAY' +
        'MENT_TYPE_,'
      
        '110411029=                                NULL,         --:OSNOV' +
        'ANIE_,'
      
        '110411030=                                1,              --:IS_' +
        'SPISANIE_,'
      
        '110411031=                                NULL,           --:NOT' +
        'E_,'
      
        '110411032=                                :SUMM_,              -' +
        '-:SUMM_,'
      
        '110411033=                                :SUMM_,              -' +
        '-:SUMM_FACT_,'
      
        '110411034=                                0,              --SUMM' +
        '_BONUS_'
      
        '110411035=                                0,              --SUMM' +
        '_BONUS_GOT'
      
        '110411036=                                NULL,           --:G_P' +
        'RIHOD_,'
      '110411037=                                NULL,'
      '110411038=                                0,        -- BY_RECIPE'
      
        '110411039=                                0         -- IS_RESERV' +
        'E'
      '110411040=                                ,NULL  -- PAYMENTS_'
      '110411041=                                ,0     -- SUMM_CASH'
      '110411042=                                ,0     -- SUMM_NONCASH'
      
        '110411043=                                ) RETURNING_VALUES :ZA' +
        'KAZ_, :ERR_CODE, :ERR_MSG;'
      '110411044=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110411045=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110411046=      EXIT;'
      '110411047=    END'
      '110411048=  END'
      '110411049='
      '110411050=  PNT_ = '#39#39'02'#39#39';'
      '110411051=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '110411052=    SELECT SUM(S.SUMM)'
      '110411053=      FROM SKLAD_TMP S'
      '110411054=      INTO :SUMM_;'
      '110411055='
      '110411056=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110411057=                                CURRENT_DATE,   --:DAT' +
        'E_RECEIPT_,'
      '110411058=                                CURRENT_TIME,'
      
        '110411059=                                NULL,           --:G_C' +
        'LIENT_,'
      
        '110411060=                                1,              --:G_P' +
        'AYMENT_TYPE_,'
      
        '110411061=                                NULL,           --:OSN' +
        'OVANIE_,'
      
        '110411062=                                '#39#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39#39', ' +
        '          --:NOTE_,'
      
        '110411063=                                5,              --:IS_' +
        'VOZVRAT_,'
      '110411064=                                :SUMM_,'
      '110411065=                                :SUMM_,'
      
        '110411066=                                NULL,           --:G_P' +
        'RIHOD_,'
      
        '110411067=                                NULL            --:SUM' +
        'M_PRIHOD_'
      '110411068=                                ,NULL  --PAYMENTS'
      '110411069=                                )'
      '110411070=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110411071=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110411072=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110411073=      EXIT;'
      '110411074=    END'
      '110411075=  END'
      '110411076=END'
      '110411077='#39';'
      '110411078='
      '110411079=EXECUTE STATEMENT '#39'ALTER PROCEDURE SYNC_DOWNLOAD('
      '110411080=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110411081=  UPLOAD_TABLE_TMP TYPE OF COLUMN UPLOAD_TABLE_TMP.UPL' +
        'OAD_TABLE_TMP,'
      '110411082=  MODE TYPE OF COLUMN UPLOAD_TABLE_TMP.MODE,'
      '110411083=  PARENT TYPE OF COLUMN UPLOAD_TABLE_TMP.PARENT,'
      '110411084=  DATE_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.DATE_OPER,'
      '110411085=  TIME_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.TIME_OPER,'
      '110411086=  G_CLIENT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_CLIENT,'
      
        '110411087=  G_PAYMENT_TYPE TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PAY' +
        'MENT_TYPE,'
      '110411088=  SUMM_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_ALL,'
      
        '110411089=  SUMM_FACT_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_F' +
        'ACT_ALL,'
      
        '110411090=  SUMM_PAY_BONUS TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'PAY_BONUS,'
      
        '110411091=  SUMM_BONUS_GOT TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'BONUS_GOT,'
      '110411092=  OSNOVANIE TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE,'
      '110411093=  NOTE TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE,'
      
        '110411094=  G_OFFICIAL TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICIA' +
        'L,'
      '110411095=  G_PRODUCT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT,'
      '110411096=  AMOUNT TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT,'
      '110411097=  PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE,'
      '110411098=  SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM,'
      
        '110411099=  DISCOUNT_PERC TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_PERC,'
      
        '110411100=  DISCOUNT_TENGE TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCO' +
        'UNT_TENGE,'
      
        '110411101=  DISCOUNT_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_SUMM,'
      '110411102=  NDS TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS,'
      '110411103=  NDS_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM,'
      
        '110411104=  COST_PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRIC' +
        'E,'
      '110411105=  BY_RECIPE TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE,'
      
        '110411106=  IS_RESERVE TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESERV' +
        'E,'
      '110411107=  PAYMENTS BLOB SUB_TYPE 1,'
      '110411108=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110411109=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110411110=  IS_LOAD_ INTEGER)'
      '110411111=RETURNS ('
      '110411112=  ERR_CODE INTEGER,'
      '110411113=  ERR_MSG VARCHAR(1024))'
      '110411114=AS'
      '110411115=/*'
      '110411116='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110411117='#1048#1044#1059' '#1055#1054' '#1042#1057#1045#1052' '#1055#1054#1054#1063#1045#1056#1045#1044#1053#1054', '#1055#1045#1056#1045#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1048#1055#1054#1052' '#1055#1056#1054#1062#1045#1057#1057#1040' '#1041#1059 +
        #1044#1059' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110411118='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1062#1048#1050#1051#1054#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059 +
        #1070' '#1058#1040#1041#1051#1048#1062#1059
      '110411119=*/'
      
        '110411120=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'SYNC_DOWNLOA' +
        'D'#39#39';'
      '110411121=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110411122=DECLARE VARIABLE MODE_ TYPE OF COLUMN UPLOAD_TABLE_TMP' +
        '.MODE;'
      
        '110411123=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110411124=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110411125=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110411126=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110411127=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110411128=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110411129=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '110411130=DECLARE VARIABLE BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RE' +
        'CIPE;'
      
        '110411131=DECLARE VARIABLE BY_RECIPE__ TYPE OF COLUMN ZAKAZ.BY_R' +
        'ECIPE;'
      
        '110411132=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '110411133=DECLARE VARIABLE IS_RESERVE__ TYPE OF COLUMN ZAKAZ.IS_' +
        'RESERVE;'
      
        '110411134=DECLARE VARIABLE PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZ' +
        'E 80;'
      
        '110411135=DECLARE VARIABLE PAYMENTS__ BLOB SUB_TYPE 1 SEGMENT SI' +
        'ZE 80;'
      
        '110411136=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.G_CLIENT;'
      
        '110411137=DECLARE VARIABLE G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_' +
        'PARENT.G_PAYMENT_TYPE;'
      
        '110411138=DECLARE VARIABLE OSNOVANIE_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.OSNOVANIE;'
      
        '110411139=DECLARE VARIABLE NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOT' +
        'E;'
      
        '110411140=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110411141=DECLARE VARIABLE SUMM_FACT_ALL_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM_FACT;'
      
        '110411142=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '110411143=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110411144=DECLARE VARIABLE PARENT_ TYPE OF COLUMN UPLOAD_TABLE_T' +
        'MP.PARENT;'
      
        '110411145=DECLARE VARIABLE PARENT_OLD_ TYPE OF COLUMN UPLOAD_TAB' +
        'LE_TMP.PARENT;'
      '110411146=DECLARE VARIABLE MODE_OLD_ INTEGER;'
      '110411147=DECLARE VARIABLE DATE_OPER__ DATE;'
      '110411148=DECLARE VARIABLE TIME_OPER__ TIME;'
      
        '110411149=DECLARE VARIABLE G_CLIENT__ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '110411150=DECLARE VARIABLE G_PAYMENT_TYPE__ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      
        '110411151=DECLARE VARIABLE OSNOVANIE__ TYPE OF COLUMN ZAKAZ.OSNO' +
        'VANIE;'
      '110411152=DECLARE VARIABLE NOTE__ TYPE OF COLUMN ZAKAZ.NOTE;'
      '110411153=DECLARE VARIABLE SUMM__ NUMERIC(15,2);'
      '110411154=DECLARE VARIABLE SUMM_FACT__ NUMERIC(15,2);'
      
        '110411155=DECLARE VARIABLE SUMM_CASH__ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '110411156=DECLARE VARIABLE SUMM_NONCASH__ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '110411157=DECLARE VARIABLE SUMM_PAY_BONUS__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '110411158=DECLARE VARIABLE SUMM_BONUS_GOT__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '110411159=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '110411160=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2' +
        ');'
      
        '110411161=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      '110411162=DECLARE VARIABLE DATE_OPER_ DATE;'
      '110411163=DECLARE VARIABLE TIME_OPER_ TIME;'
      
        '110411164=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '110411165=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110411166=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '110411167=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN ZAKAZ.G_OF' +
        'FICIAL;'
      
        '110411168=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110411169=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110411170=DECLARE VARIABLE IS_FIRST_TIME_ INTEGER = 0; /* '#1054#1041#1056#1040#1041#1040 +
        #1058#1067#1042#1040#1045#1058#1057#1071' '#1055#1045#1056#1042#1040#1071' '#1057#1058#1056#1054#1050#1040' 0, '#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1057#1058#1056#1054#1050#1048' = 1 */'
      '110411171=BEGIN'
      '110411172=  PNT_ = '#39#39'00'#39#39';'
      '110411173=  IF (IS_LOAD_ = 0) THEN BEGIN'
      '110411174=      SELECT 1'
      '110411175=        FROM G_PRODUCT G'
      '110411176=       WHERE G.G_PRODUCT = :G_PRODUCT'
      '110411177=       INTO :G_PRODUCT_;'
      '110411178='
      '110411179=      IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '110411180=        ERR_CODE = -20500;'
      
        '110411181=        ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072': '#1090#1086#1074#1072#1088' '#1089' '#1080#1076#1077#1085#1090#1080#1092#1080#1082#1072#1090#1086#1088#1086#1084' '#39 +
        #39'||G_PRODUCT||'#39#39' '#1086#1090#1089#1091#1090#1089#1090#1074#1091#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'.'#39#39';'
      '110411182=        Exit;'
      '110411183=      END'
      '110411184='
      
        '110411185=      INSERT INTO UPLOAD_TABLE_TMP (UPLOAD_TABLE_TMP, ' +
        'MODE, PARENT, DATE_OPER, TIME_OPER, G_CLIENT, G_PAYMENT_TYPE,'
      
        '110411186=                                    SUMM_ALL, SUMM_FAC' +
        'T_ALL, SUMM_PAY_BONUS, SUMM_BONUS_GOT, OSNOVANIE, NOTE, G_OFFICI' +
        'AL, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110411187=                                    DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RESERVE, P' +
        'AYMENTS)'
      
        '110411188=      VALUES (:UPLOAD_TABLE_TMP, :MODE, :PARENT, :DATE' +
        '_OPER, :TIME_OPER, DECODE(:G_CLIENT, 0, NULL, :G_CLIENT), :G_PAY' +
        'MENT_TYPE,'
      
        '110411189=              :SUMM_ALL, :SUMM_FACT_ALL, :SUMM_PAY_BON' +
        'US, :SUMM_BONUS_GOT, :OSNOVANIE, :NOTE, :G_OFFICIAL, :G_PRODUCT,' +
        ' :AMOUNT, :PRICE, :SUMM, :DISCOUNT_PERC,'
      
        '110411190=              :DISCOUNT_TENGE, :DISCOUNT_SUMM, :NDS, :' +
        'NDS_SUMM, :COST_PRICE, :BY_RECIPE, :IS_RESERVE, :PAYMENTS);'
      '110411191='
      '110411192=  END ELSE BEGIN'
      '110411193=      PNT_ = '#39#39'01'#39#39';'
      '110411194=      IF (G_TOCHKA_ IS NULL) THEN'
      '110411195=        SELECT ID'
      '110411196=          FROM CUR_PARAMS'
      '110411197=         WHERE CUR_PARAMS = 2'
      '110411198=          INTO :G_TOCHKA_;'
      '110411199='
      
        '110411200=      FOR SELECT MODE, PARENT, DATE_OPER, TIME_OPER, G' +
        '_CLIENT, G_PAYMENT_TYPE, SUMM_ALL, SUMM_FACT_ALL, SUMM_PAY_BONUS' +
        ', SUMM_BONUS_GOT, OSNOVANIE,'
      
        '110411201=                 NOTE, G_OFFICIAL, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      
        '110411202=                 NDS_SUMM, COST_PRICE, BY_RECIPE, IS_R' +
        'ESERVE, PAYMENTS'
      '110411203=          FROM UPLOAD_TABLE_TMP'
      
        '110411204=          WHERE MODE <> 6        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056 +
        #1040' '#1041#1059#1044#1059' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1054#1058#1044#1045#1051#1068#1053#1054', '#1058#1040#1052' '#1044#1056#1059#1043#1054#1049' '#1055#1056#1048#1053#1062#1048#1055
      '110411205=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110411206=          INTO :MODE_, :PARENT_, :DATE_OPER_, :TIME_OP' +
        'ER_, :G_CLIENT_, :G_PAYMENT_TYPE_, :SUMM_ALL_, :SUMM_FACT_ALL_, ' +
        ' :SUMM_PAY_BONUS_, :SUMM_BONUS_GOT_,'
      
        '110411207=               :OSNOVANIE_, :NOTE_, :G_OFFICIAL_, :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_PERC_, :DISCOUNT_T' +
        'ENGE_,'
      
        '110411208=               :DISCOUNT_SUMM_, :NDS_, :NDS_SUMM_, :CO' +
        'ST_PRICE_, :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_'
      '110411209=      DO BEGIN'
      '110411210=          -- '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110411211=          PNT_ = '#39#39'02'#39#39';'
      
