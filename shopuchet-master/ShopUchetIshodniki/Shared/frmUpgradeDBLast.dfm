      '110153131=  /* '#1060#1083#1072#1075' "'#1087#1086#1082#1072#1079#1072#1090#1100' '#1085#1072#1079#1074#1072#1085#1080#1077' '#1074#1072#1083#1102#1090#1099'" */'
      '110153132=  if (Currency not in (-1, -2)) then begin'
