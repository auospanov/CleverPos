      '1102122066=        SELECT 17 COL,'
      '1102122067=               '#39'  '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      
        '1102122068=               '#39'*'#39'||(:VOZVRAT_CASH_AMOUNT_ + :VOZVRAT' +
