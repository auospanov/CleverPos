      '11042881=        IF (ROW_COUNT = 0) THEN'
      
        '11042882=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PROD' +
        'UCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '11042883=      END'
      '11042884=  END'
      '11042885='
      '11042886=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '11042887='
      
        '11042888=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054 +
        #1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '11042889=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11042890=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ => ' +
        ':ACTION_'
      '11042891=                                  G_PRIHOD_,'
      '11042892=                                  :SUMM_PRIHOD_,'
      '11042893=                                  :Z_DATE_,'
      
        '11042894=                                  NULL,   --NOTE_ => :N' +
        'OTE_,'
      '11042895=                                  :ZAKAZ_,'
      '11042896=                                  NULL,'
      '11042897=                                  :G_PAYMENT_TYPE_,'
      
        '11042898=                                  :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11042899=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11042900=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||E' +
        'RR_MSG;'
      '11042901=      EXIT;'
      '11042902=    END'
      '11042903=  END'
      '11042904='
      
        '11042905=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057#1058 +
        #1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '11042906=  IF (IS_MEBEL_ = 1) THEN'
      
        '11042907=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS,' +
        ' ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '11042908=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, :' +
        'ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '11042909=end'
      '11042910='#39';'
      '11042911=END  --END_EXECUTE_BLOCK'
      '11042912=EXECUTE BLOCK AS BEGIN'
      '11042913='
      '11042914=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_BILL('
      '11042915=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11042916=  SUMM_DANO_ NUMERIC(15,2),'
      '11042917=  SUMM_SDACHA_ NUMERIC(15,2),'
      '11042918=  CURRENCY_ INTEGER,'
      '11042919=  MODE_ INTEGER,'
      '11042920=  PRINT_SLOGAN_ VARCHAR(80))'
      '11042921=RETURNS ('
      '11042922=  FIRM_NAME_ VARCHAR(600),'
      '11042923=  IDN_STR_ VARCHAR(30),'
      '11042924=  FIRM_IDN_ VARCHAR(50),'
      '11042925=  FIRM_ADDRESS_ VARCHAR(550),'
      '11042926=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11042927=  DATE_ VARCHAR(100),'
      '11042928=  PAYMENT_TYPE_ VARCHAR(100),'
      '11042929=  G_CLIENT_NAME_ VARCHAR(300),'
      '11042930=  G_OFFICIAL_FM_ VARCHAR(300),'
      '11042931=  SUMM_VSEGO_ VARCHAR(50),'
      '11042932=  SUMM_VSEGO_N_ VARCHAR(50),'
      '11042933=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11042934=  ROW_NUM INTEGER,'
      '11042935=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11042936=  AMOUNT VARCHAR(50),'
      '11042937=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11042938=  PRICE VARCHAR(50),'
      '11042939=  PRICE_N VARCHAR(50),'
      '11042940=  SUMM VARCHAR(50),'
      '11042941=  SUMM_N VARCHAR(50),'
      '11042942=  SUMM_POLUCH_ VARCHAR(50),'
      '11042943=  SUMM_SDACH_ VARCHAR(50),'
      '11042944=  SUMM_STR_ VARCHAR(200),'
      '11042945=  SLOGAN_ VARCHAR(80),'
      '11042946=  SUMM_SKIDKA_ VARCHAR(50),'
      '11042947=  ERR_CODE NUMERIC(15,2),'
      '11042948=  ERR_MSG VARCHAR(1024))'
      '11042949=AS'
      '11042950=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '11042951=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_BILL'#39#39';'
      '11042952=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11042953=DECLARE VARIABLE I INTEGER = 1;'
      
        '11042954=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      '11042955=BEGIN'
      '11042956=  SLOGAN_ = PRINT_SLOGAN_;'
      '11042957='
      
        '11042958=  -- '#1063#1058#1054#1041#1067' '#1053#1045' '#1055#1040#1056#1048#1058#1068#1057#1071' '#1048' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1057#1051#1054#1052#1040#1058#1068', '#1056#1045#1064#1048#1051' '#1057#1044#1045#1051#1040 +
        #1058#1068' '#1044#1042#1040' '#1041#1054#1051#1068#1064#1048#1061' IF'
      '11042959=  --IF (MODE_ = 0) THEN BEGIN'
      '11042960=          -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '11042961=          SELECT z.ZAKAZ--GEN_ID(GEN_BILL, 1)'
      '11042962=                 --,Z.Z_DATE'
      
        '11042963=                 ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39 +
        #39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39 +
        #39'||EXTRACT(YEAR FROM Z.Z_DATE)||'#39#39'  '#39#39'||EXTRACT(HOUR FROM Z.Z_TI' +
        'ME)||'#39#39':'#39#39'||EXTRACT(MINUTE FROM Z.Z_TIME)'
      
        '11042964=                 --,CAST(ROUND(Z.SUMM, 2) AS VARCHAR(10' +
        '0))   09.12.2017'
      '11042965=                 --,CAST(Z.SUMM AS VARCHAR(100))'
      '11042966=                 ,'#39#39#1050#1083#1080#1077#1085#1090': '#39#39'||G.NAME'
      
        '11042967=                 ,'#39#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39#39'||COALESCE(O.FM, '#39#39#39#39')' +
        '||'#39#39' '#39#39'||COALESCE(O.NM, '#39#39#39#39')'
      
        '11042968=                 ,'#39#39#1054#1087#1083#1072#1090#1072': '#39#39' ||CASE WHEN Z.summ_nonca' +
        'sh <> 0 AND Z.summ_cash <> 0 THEN '#39#39#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39#39' ELSE P.NAME E' +
        'ND'
      
        '11042969=            FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O O' +
        'N Z.G_OFFICIAL = O.G_OFFICIAL,'
      '11042970=                 G_CLIENT G,'
      '11042971=                 G_PAYMENT_TYPE P'
      '11042972=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '11042973=             AND Z.G_CLIENT = G.G_CLIENT'
      '11042974=             AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11042975=            INTO :NUM_,'
      '11042976=                :DATE_,'
      '11042977=                --:SUMM_VSEGO_,      09.12.2017'
      '11042978=                --:SUMM_VSEGO_N_,'
      '11042979=                :G_CLIENT_NAME_,'
      '11042980=                :G_OFFICIAL_FM_,'
      '11042981=                :PAYMENT_TYPE_;'
      '11042982='
      '11042983=          SELECT R.G_FIRM_REKVIZIT,'
      '11042984=                 '#39#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39#39'||r.NAME,'
      
        '11042985=                 DECODE(:CURRENCY_, 0, '#39#39#1048#1048#1053'/'#1041#1048#1053#39#39', '#39#39#1048 +
        #1053#1053#39#39')||'#39#39' '#1086#1088#1075'.: '#39#39'||COALESCE(R.IDN, '#39#39#39#39')'
      '11042986=            FROM G_FIRM_REKVIZIT R'
      '11042987=           WHERE R.is_default = 1'
      '11042988=            INTO :G_FIRM_REKVIZIT_,'
      '11042989=                 :FIRM_NAME_,'
      '11042990=                 :FIRM_IDN_;'
      '11042991='
      '11042992=          SELECT CAST(SUM(ZD.AMOUNT) AS VARCHAR(100)),'
      
        '11042993=                 CAST(SUM(ZD.DISCOUNT_SUMM) AS VARCHAR(' +
        '100)),'
      
        '11042994=                 CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_S' +
        'UMM), 2) AS VARCHAR(100)),'
      '11042995=                 CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '11042996=          FROM ZAKAZ_DETAILS ZD'
      '11042997=          WHERE ZD.ZAKAZ = :ZAKAZ_'
      '11042998=          INTO :AMOUNT_VSEGO_,'
      '11042999=               :SUMM_SKIDKA_,'
      '110421000=               :SUMM_VSEGO_,'
      '110421001=               :SUMM_VSEGO_N_;'
      '110421002='
      '110421003=          SELECT '#39#39#1040#1076#1088#1077#1089': '#39#39'||R.address'
      '110421004=            FROM G_FIRM_ADDRESS R'
      '110421005=           WHERE R.IS_DEFAULT = 1'
      '110421006=             AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110421007=            INTO :FIRM_ADDRESS_;'
      '110421008='
      
        '110421009=          --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058 +
        #1067' '#1052#1040#1043#1040#1047#1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110421010=          FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#39#1054#1088#1075#1072 +
        #1085#1080#1079#1072#1094#1080#1103':'#39#39');'
      '110421011=          IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110421012=            IF (CURRENCY_ = 0) THEN'
      '110421013=              FIRM_IDN_ = '#39#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39#39';'
      '110421014=            ELSE'
      '110421015=              FIRM_IDN_ = '#39#39#1048#1053#1053' '#1086#1088#1075'.:'#39#39';'
      '110421016=          END'
      '110421017='
      
        '110421018=          FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#39#1040 +
        #1076#1088#1077#1089':'#39#39');'
      '110421019='
      
        '110421020=          SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS ' +
        'VARCHAR(100));'
      
        '110421021=          SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) A' +
        'S VARCHAR(100));'
      '110421022='
      '110421023=          SELECT CURR_STR||'#39#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39#39
      
        '110421024=            from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY' +
        '_)'
      '110421025=          INTO :SUMM_STR_;'
      '110421026='
      '110421027=          FOR'
      '110421028=            SELECT :I,'
      '110421029=                   G.NAME,'
      '110421030=                   ZD.AMOUNT,'
      
        '110421031=                   CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(' +
        '100)),'
      
        '110421032=                   CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SU' +
        'MM, 2) AS VARCHAR(100))'
      '110421033=                   ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110421034=                   ,CAST(ZD.PRICE - COALESCE(ZD.DISCOU' +
        'NT_TENGE, 0) AS VARCHAR(100))'
      '110421035=                   ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110421036=              FROM ZAKAZ Z,'
      '110421037=                   ZAKAZ_DETAILS ZD,'
      '110421038=                   G_PRODUCT G,'
      '110421039=                   G_UNIT U'
      '110421040=             WHERE Z.ZAKAZ = :ZAKAZ_'
      '110421041=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110421042=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110421043=               AND G.G_UNIT = U.G_UNIT'
      '110421044=             ORDER BY ZD.zakaz_details'
      '110421045=            INTO :ROW_NUM,'
      '110421046=                :NAME,'
      '110421047=                :AMOUNT,'
      '110421048=                :PRICE,'
      '110421049=                :SUMM'
      '110421050=                ,:SHORT_NAME'
      '110421051=                ,:PRICE_N'
      '110421052=                ,:SUMM_N'
      '110421053=          DO BEGIN'
      '110421054=            I = I + 1;'
      '110421055='
      
        '110421056=            -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040 +
        #1071' '#1063#1040#1057#1058#1068' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      
        '110421057=            if (POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_) > 0) ' +
        'then'
      
        '110421058=              SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ F' +
        'ROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_)-1);'
      
        '110421059=            if (POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_N_) > 0' +
        ') then'
      
        '110421060=              SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_' +
        ' FROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_N_)-1);'
      
        '110421061=            if (POSITION('#39#39'.00'#39#39' IN AMOUNT_VSEGO_) > 0' +
        ') then'
      
        '110421062=              AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_' +
        ' FROM 1 FOR POSITION('#39#39'.00'#39#39' IN AMOUNT_VSEGO_)-1);'
      '110421063=            if (POSITION('#39#39'.00'#39#39' IN AMOUNT) > 0) then'
      
        '110421064=              AMOUNT         = SUBSTRING(AMOUNT FROM 1' +
        ' FOR POSITION('#39#39'.00'#39#39' IN AMOUNT)-1);'
      '110421065=            if (POSITION('#39#39'.00'#39#39' IN PRICE) > 0) then'
      
        '110421066=              PRICE          = SUBSTRING(PRICE FROM 1 ' +
        'FOR POSITION('#39#39'.00'#39#39' IN PRICE)-1);'
      '110421067=            if (POSITION('#39#39'.00'#39#39' IN PRICE_N) > 0) then'
      
        '110421068=              PRICE_N        = SUBSTRING(PRICE_N FROM ' +
        '1 FOR POSITION('#39#39'.00'#39#39' IN PRICE_N)-1);'
      '110421069=            if (POSITION('#39#39'.00'#39#39' IN SUMM) > 0) then'
      
        '110421070=              SUMM           = SUBSTRING(SUMM FROM 1 F' +
        'OR POSITION('#39#39'.00'#39#39' IN SUMM)-1);'
      '110421071=            if (POSITION('#39#39'.00'#39#39' IN SUMM_N) > 0) then'
      
        '110421072=              SUMM_N         = SUBSTRING(SUMM_N FROM 1' +
        ' FOR POSITION('#39#39'.00'#39#39' IN SUMM_N)-1);'
      
        '110421073=            if (POSITION('#39#39'.00'#39#39' IN SUMM_POLUCH_) > 0)' +
        ' then'
      
        '110421074=              SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ ' +
        'FROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_POLUCH_)-1);'
      
        '110421075=            if (POSITION('#39#39'.00'#39#39' IN SUMM_SDACH_) > 0) ' +
        'then'
      
        '110421076=              SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ F' +
        'ROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_SDACH_)-1);'
      '110421077='
      '110421078=            SUSPEND;'
      '110421079=          END'
      '110421080=  /*END'
      '110421081=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1045#1063#1040#1058#1068' '#1063#1045#1050#1040
      '110421082=  ----------------------------------'
      '110421083=  ELSE BEGIN'
      '110421084=          -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110421085=          SELECT z.ZAKAZ--GEN_ID(GEN_BILL, 1)'
      '110421086=                 ,Z.Z_DATE'
      '110421087=                 ,G.NAME'
      
        '110421088=                 ,COALESCE(O.FM, '#39#39#39#39')||'#39#39' '#39#39'||COALESC' +
        'E(O.NM, '#39#39#39#39')'
      '110421089=                 ,P.NAME'
      
        '110421090=            FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ' +
        'ON Z.G_OFFICIAL = O.G_OFFICIAL,'
      '110421091=                 G_CLIENT G,'
      '110421092=                 G_PAYMENT_TYPE P'
      '110421093=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110421094=             AND Z.G_CLIENT = G.G_CLIENT'
      '110421095=             AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110421096=            INTO :NUM_,'
      '110421097=                :DATE_,'
      '110421098=                :G_CLIENT_NAME_,'
      '110421099=                :G_OFFICIAL_FM_,'
      '110421100=                :PAYMENT_TYPE_;'
      '110421101='
      '110421102=          SELECT R.G_FIRM_REKVIZIT,'
      '110421103=                 r.NAME,'
      '110421104=                 R.IDN,'
      
        '110421105=                 DECODE(:CURRENCY_, 0, '#39#39#1048#1048#1053'/'#1041#1048#1053#39#39', '#39#39 +
        #1048#1053#1053#39#39')||'#39#39' '#1086#1088#1075'.:'#39#39
      '110421106=            FROM G_FIRM_REKVIZIT R'
      '110421107=           WHERE R.is_default = 1'
      '110421108=            INTO :G_FIRM_REKVIZIT_,'
      '110421109=                 :FIRM_NAME_,'
      '110421110=                 :FIRM_IDN_,'
      '110421111=                 :IDN_STR_;'
      '110421112='
      '110421113=          SELECT R.ADDRESS'
      '110421114=            FROM G_FIRM_ADDRESS R'
      '110421115=           WHERE R.IS_DEFAULT = 1'
      '110421116=             AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110421117=            INTO :FIRM_ADDRESS_;'
      '110421118='
      '110421119=          SELECT CAST(SUM(ZD.AMOUNT) AS VARCHAR(100))'
      '110421120=          FROM ZAKAZ_DETAILS ZD'
      '110421121=          WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110421122=          INTO :AMOUNT_VSEGO_;'
      '110421123='
      
        '110421124=          SELECT CAST(ROUND(SUM(ZD.SUMM), 2) AS VARCHA' +
        'R(100)),'
      
        '110421125=                 CAST(ROUND(SUM(ZD.SUMM), 2) AS VARCHA' +
        'R(100))'
      '110421126=          FROM ZAKAZ_DETAILS ZD,'
      '110421127=               G_PRODUCT G'
      '110421128=          WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110421129=            AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110421130=          INTO :SUMM_VSEGO_,'
      '110421131=               SUMM_VSEGO_N_;'
      '110421132='
      '110421133=          SUMM_POLUCH_ = SUMM_VSEGO_;'
      '110421134=          SUMM_SDACH_  = 0;'
      '110421135='
      '110421136=          SELECT CURR_STR||'#39#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39#39
      
        '110421137=            from CURRENCYSTR(CAST(:SUMM_VSEGO_ AS NUME' +
        'RIC(15,2)), :CURRENCY_)'
      '110421138=          INTO :SUMM_STR_;'
      '110421139='
      '110421140=          FOR'
      '110421141=            SELECT :I,'
      '110421142=                   G.NAME,'
      '110421143=                   CAST(ZD.AMOUNT AS VARCHAR(100)),'
      
        '110421144=                   CAST(ROUND((ZD.PRICE - COALESCE(ZD.' +
        'DISCOUNT_TENGE, 0)), 2) AS VARCHAR(100)),'
      
        '110421145=                   CAST(ROUND(ZD.SUMM, 2) AS VARCHAR(1' +
        '00))'
      '110421146=                   ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110421147=                   ,CAST((ZD.PRICE - COALESCE(ZD.DISCO' +
        'UNT_TENGE, 0)) AS VARCHAR(100))'
      
        '110421148=                   ,CAST(ROUND(ZD.SUMM, 2) AS VARCHAR(' +
        '100))'
      '110421149=              FROM ZAKAZ Z,'
      '110421150=                   ZAKAZ_DETAILS ZD,'
      '110421151=                   G_PRODUCT G,'
      '110421152=                   G_UNIT U'
      '110421153=             WHERE Z.ZAKAZ = :ZAKAZ_'
      '110421154=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110421155=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110421156=               AND G.G_UNIT = U.G_UNIT'
      '110421157=             ORDER BY ZD.zakaz_details'
      '110421158=            INTO :ROW_NUM,'
      '110421159=                :NAME,'
      '110421160=                :AMOUNT,'
      '110421161=                :PRICE,'
      '110421162=                :SUMM'
      '110421163=                ,:SHORT_NAME'
      '110421164=                ,:PRICE_N'
      '110421165=                ,:SUMM_N'
      '110421166=          DO BEGIN'
      '110421167=            I = I + 1;'
      '110421168='
      
        '110421169=            -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040 +
        #1071' '#1063#1040#1057#1058#1068' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      
        '110421170=            if (POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_) > 0) ' +
        'then'
      
        '110421171=              SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ F' +
        'ROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_)-1);'
      
        '110421172=            if (POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_N_) > 0' +
        ') then'
      
        '110421173=              SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_' +
        ' FROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_N_)-1);'
      
        '110421174=            if (POSITION('#39#39'.00'#39#39' IN AMOUNT_VSEGO_) > 0' +
        ') then'
      
        '110421175=              AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_' +
        ' FROM 1 FOR POSITION('#39#39'.00'#39#39' IN AMOUNT_VSEGO_)-1);'
      '110421176=            if (POSITION('#39#39'.00'#39#39' IN AMOUNT) > 0) then'
      
        '110421177=              AMOUNT         = SUBSTRING(AMOUNT FROM 1' +
        ' FOR POSITION('#39#39'.00'#39#39' IN AMOUNT)-1);'
      '110421178=            if (POSITION('#39#39'.00'#39#39' IN PRICE) > 0) then'
      
        '110421179=              PRICE          = SUBSTRING(PRICE FROM 1 ' +
        'FOR POSITION('#39#39'.00'#39#39' IN PRICE)-1);'
      '110421180=            if (POSITION('#39#39'.00'#39#39' IN PRICE_N) > 0) then'
      
        '110421181=              PRICE_N        = SUBSTRING(PRICE_N FROM ' +
        '1 FOR POSITION('#39#39'.00'#39#39' IN PRICE_N)-1);'
      '110421182=            if (POSITION('#39#39'.00'#39#39' IN SUMM) > 0) then'
      
        '110421183=              SUMM           = SUBSTRING(SUMM FROM 1 F' +
        'OR POSITION('#39#39'.00'#39#39' IN SUMM)-1);'
      '110421184=            if (POSITION('#39#39'.00'#39#39' IN SUMM_N) > 0) then'
      
        '110421185=              SUMM_N         = SUBSTRING(SUMM_N FROM 1' +
        ' FOR POSITION('#39#39'.00'#39#39' IN SUMM_N)-1);'
      
        '110421186=            if (POSITION('#39#39'.00'#39#39' IN SUMM_POLUCH_) > 0)' +
        ' then'
      
        '110421187=              SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ ' +
        'FROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_POLUCH_)-1);'
      
        '110421188=            if (POSITION('#39#39'.00'#39#39' IN SUMM_SDACH_) > 0) ' +
        'then'
      
        '110421189=              SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ F' +
        'ROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_SDACH_)-1);'
      '110421190=            SUSPEND;'
      '110421191=          END'
      '110421192=  END  */'
      '110421193=WHEN ANY DO BEGIN'
      '110421194=    Err_code = -20500;'
      
        '110421195=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110421196=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110421197=  END'
      '110421198=end'
      '110421199='#39';'
      '110421200='
      
        '110421201=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRIHOD_WAYBIL' +
        'L('
      '110421202=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110421203=  CURRENCY_ INTEGER)'
      '110421204=RETURNS ('
      '110421205=  NUMBER_STR_ VARCHAR(200),'
      '110421206=  ROW_NUM INTEGER,'
      '110421207=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110421208=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110421209=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110421210=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110421211=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110421212=  AMOUNT VARCHAR(50),'
      '110421213=  PRICE_N VARCHAR(50),'
      '110421214=  SUMM_N VARCHAR(50),'
      '110421215=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110421216=  SUMM_VSEGO_ VARCHAR(50),'
      '110421217=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110421218=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110421219=  SUMM_STR_ VARCHAR(500),'
      '110421220=  ERR_CODE NUMERIC(15,2),'
      '110421221=  ERR_MSG VARCHAR(1024))'
      '110421222=AS'
      '110421223=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '110421224=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRIHOD' +
        '_WAYBILL'#39#39';'
      '110421225=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110421226=DECLARE VARIABLE I INTEGER = 1;'
      
        '110421227=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110421228=DECLARE VARIABLE IS_VOZVRAT_    TYPE OF COLUMN SKLAD_P' +
        'ARENT.IS_VOZVRAT;'
      '110421229=BEGIN'
      '110421230='
      
        '110421231=  SELECT '#39#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39#39'||P.sklad||'#39#39' '#1086#1090' '#39#39'||lpad(EXTR' +
        'ACT(DAY FROM P.date_receipt), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MON' +
        'TH FROM P.date_receipt), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM P.date_' +
        'receipt),'
      '110421232=         G.name,'
      '110421233=         P.IS_VOZVRAT'
      
        '110421234=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON ' +
        'P.g_client = G.G_CLIENT'
      '110421235=   WHERE P.sklad = :sklad_parent_'
      '110421236=    INTO :NUMBER_STR_,'
      '110421237=         :POSTAVSHIK_NAME_,'
      '110421238=         :IS_VOZVRAT_;'
      '110421239='
      
        '110421240=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058#1068 +
        ' '#1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      '110421241=  IF (IS_VOZVRAT_ = 3) THEN'
      '110421242=    SELECT G.NAME'
      '110421243=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '110421244=     WHERE P.SKLAD = :sklad_parent_'
      '110421245=       AND P.G_TOCHKA = G.G_TOCHKA'
      '110421246=      INTO :POSTAVSHIK_NAME_;'
      '110421247='
      
        '110421248=  SELECT REPLACE(CAST(SUM(S.amount) AS VARCHAR(10)), '#39 +
        #39'.'#39#39', '#39#39','#39#39')'
      
        '110421249=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39')'
      
        '110421250=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ' +
        '), :CURRENCY_))'
      '110421251=    FROM SKLAD S'
      '110421252=   WHERE S.sklad_parent = :sklad_parent_'
      '110421253=   GROUP BY S.sklad_parent'
      '110421254=    INTO :AMOUNT_VSEGO_,'
      '110421255=         :SUMM_VSEGO_,'
      '110421256=         :summ_str_;'
      '110421257='
      '110421258=  SELECT NAME'
      '110421259=    FROM CUR_PARAMS'
      '110421260=   WHERE CUR_PARAMS = 1'
      '110421261=    INTO :G_OFFICIAL_FM_;'
      '110421262='
      '110421263=  FOR SELECT :I,'
      '110421264=             G.name,'
      '110421265=             G.ARTICUL,'
      '110421266=             G.BARCODE,'
      '110421267=             G.NOMENCLATUR_NUM,'
      '110421268=             U.short_name,'
      
        '110421269=             REPLACE(CAST(S.amount AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39'),'
      
        '110421270=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39'),'
      
        '110421271=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39#39'.'#39 +
        #39', '#39#39','#39#39')'
      '110421272=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '110421273=       WHERE S.sklad_parent = :sklad_parent_'
      '110421274=         AND S.g_product = G.g_product'
      '110421275=         AND G.g_unit = U.g_unit'
      '110421276=        INTO :ROW_NUM,'
      '110421277=            :NAME,'
      '110421278=            :ARTICUL,'
      '110421279=            :BARCODE,'
      '110421280=            :NOMENCLATUR_NUM,'
      '110421281=            :SHORT_NAME,'
      '110421282=            :AMOUNT,'
      '110421283=            :PRICE_N,'
      '110421284=            :SUMM_N'
      '110421285=  DO BEGIN'
      '110421286=    I = I + 1;'
      '110421287=    SUSPEND;'
      '110421288=  END'
      '110421289=WHEN ANY DO BEGIN'
      '110421290=    Err_code = -20500;'
      
        '110421291=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110421292=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110421293=  END'
      '110421294=end'
      '110421295='#39';'
      '110421296='
      '110421297=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD('
      '110421298=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110421299=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '110421300=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110421301=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110421302=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110421303=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110421304=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110421305=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110421306=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '110421307=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110421308=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110421309=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110421310=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110421311=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110421312=RETURNS ('
      '110421313=  ERR_CODE INTEGER,'
      '110421314=  ERR_MSG VARCHAR(1024))'
      '110421315=AS'
      
        '110421316=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110421317=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      
        '110421318=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110421319=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110421320=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      '110421321=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110421322=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110421323=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLAD' +
        '_PARENT.IS_EXPECTED;'
      
        '110421324=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110421325=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110421326=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110421327=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      '110421328=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110421329=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '110421330=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '110421331=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110421332=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110421333=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN SK' +
        'LAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110421334=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLAD' +
        '.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058 +
        ' */'
      
        '110421335=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110421336=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110421337=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110421338=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110421339=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110421340=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110421341=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110421342=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110421343=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110421344=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110421345=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39'; /* ' +
        #1044#1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '110421346=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110421347=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      '110421348=BEGIN'
      '110421349='
      '110421350=  IS_THIS_LAST_ = 0;'
      '110421351='
      '110421352=  SELECT S.G_TOCHKA,'
      '110421353=         S.IS_VOZVRAT,'
      '110421354=         S.G_PAYMENT_TYPE'
      '110421355=         ,S.is_expected'
      '110421356=    FROM SKLAD_parent S'
      '110421357=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '110421358=    INTO :G_TOCHKA_,'
      '110421359=         :IS_VOZVRAT_,'
      '110421360=         :G_PAYMENT_TYPE_OLD_'
      '110421361=         ,:IS_EXPECTED_OLD_;'
      '110421362='
      '110421363=  PNT_ = '#39#39'00'#39#39';'
      '110421364=  UPDATE SKLAD_PARENT'
      '110421365=  SET'
      
        '110421366=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEIP' +
        'T),'
      
        '110421367=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEIP' +
        'T),'
      
        '110421368=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYME' +
        'NT_TYPE),'
      '110421369=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110421370=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110421371=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '110421372=   SUMM      = :SUMM_,'
      '110421373=   SUMM_FACT = :SUMM_FACT_,'
      '110421374=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '110421375=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0)  ' +
        '-- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' ' +
        #1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110421376=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '110421377=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '110421378='
      
        '110421379=  ----------------------------------------------------' +
        '---------'
      '110421380=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040
      '110421381=  PNT_ = '#39#39'02'#39#39';'
      '110421382=  FOR SELECT SKLAD'
      '110421383=        FROM SKLAD S'
      '110421384=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110421385=         AND NOT EXISTS (SELECT 1'
      '110421386=                           FROM SKLAD_TMP T'
      '110421387=                        WHERE T.SKLAD = S.SKLAD)'
      '110421388=  INTO :SKLAD_'
      '110421389=  DO BEGIN'
      
        '110421390=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_,' +
        ' :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110421391=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110421392=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110421393=      EXIT;'
      '110421394=    END'
      '110421395=  END'
      '110421396='
      
        '110421397=  ----------------------------------------------------' +
        '---------'
      
        '110421398=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044#1054 +
        #1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '110421399=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '110421400=  PNT_ = '#39#39'03'#39#39';'
      '110421401=  FOR SELECT S.SKLAD,'
      '110421402=             S.G_PRODUCT,'
      '110421403=             S.AMOUNT,'
      '110421404=             S.PRICE,'
      '110421405=             S.SUMM,'
      '110421406=             S.NDS,'
      '110421407=             S.NDS_SUMM,'
      '110421408=             T.SKLAD,'
      '110421409=             T.AMOUNT,'
      '110421410=             T.IS_LAST,'
      '110421411=             T.DATE_RECEIPT'
      '110421412=             ,S.PRICE_CURRENCY'
      '110421413=             ,S.SUMM_CURRENCY'
      
        '110421414=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLAD' +
        ', AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT = ' +
        ':SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '110421415=  INTO :SKLAD_,'
      '110421416=       :G_PRODUCT_,'
      '110421417=       :AMOUNT_,'
      '110421418=       :PRICE_,'
      '110421419=       :SUMM_ONE_,'
      '110421420=       :NDS_,'
      '110421421=       :NDS_SUMM_,'
      '110421422=       :SKLAD_OLD_,'
      '110421423=       :AMOUNT_OLD_,'
      '110421424=       :IS_THIS_LAST_,'
      '110421425=       :DATE_RECEIPT_OLD_'
      '110421426=       ,:PRICE_CURRENCY_'
      '110421427=       ,:SUMM_CURRENCY_TMP_'
      '110421428=  DO BEGIN'
      
        '110421429=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058#1040 +
        #1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110421430=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '110421431=        PNT_ = '#39#39'04'#39#39';'
      
        '110421432=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_R' +
        'ECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYPE' +
        ', NDS, NDS_SUMM,'
      
        '110421433=                          IS_LAST, NOTE, OSNOVANIE, IS' +
        '_VOZVRAT, G_TOCHKA'
      '110421434=                          ,PRICE_CURRENCY'
      '110421435=                          ,SUMM_CURRENCY)'
      
        '110421436=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIPT' +
        '_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_PA' +
        'YMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '110421437=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '110421438=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :G' +
        '_TOCHKA_'
      '110421439=               ,:PRICE_CURRENCY_'
      '110421440=               ,:SUMM_CURRENCY_TMP_'
      '110421441=               );'
      '110421442='
      
        '110421443=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '110421444=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110421445=            UPDATE LT_SKLAD_PRODUCT L'
      '110421446=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110421447=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110421448=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110421449='
      '110421450=            IF (ROW_COUNT = 0) THEN'
      
        '110421451=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN' +
        '_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCHK' +
        'A_);'
      '110421452=        END'
      '110421453='
      
        '110421454=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050 +
        ' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058 +
        #1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110421455=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045#1052 +
        ' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056#1048 +
        #1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '110421456=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DETA' +
        'IL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '110421457=        PNT_ = '#39#39'05'#39#39';'
      '110421458=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '110421459=            SELECT MAX(SK.DATE_RECEIPT)'
      '110421460=              FROM SKLAD SK'
      '110421461=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110421462=               AND SK.IS_LAST = 1'
      '110421463=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110421464=              INTO :DATE_LAST_;'
      '110421465='
      
        '110421466=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110421467=              UPDATE SKLAD SK'
      '110421468=                 SET SK.IS_LAST = 0'
      '110421469=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110421470=                 AND SK.IS_LAST = 1'
      '110421471=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110421472='
      '110421473=              UPDATE SKLAD SK'
      '110421474=                 SET SK.IS_LAST = 1'
      '110421475=               WHERE SK.SKLAD = :SKLAD_;'
      '110421476=            END'
      '110421477=        END'
      
        '110421478=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110421479=    END ELSE BEGIN'
      '110421480=        PNT_ = '#39#39'06'#39#39';'
      '110421481=        UPDATE SKLAD S'
      '110421482=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '110421483=               S.G_CLIENT = :G_CLIENT_,'
      '110421484=               S.AMOUNT   = :AMOUNT_,'
      '110421485=               S.PRICE    = :PRICE_,'
      '110421486=               S.SUMM     = :SUMM_ONE_,'
      '110421487=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110421488=               S.NDS      = :NDS_,'
      '110421489=               S.NDS_SUMM = :NDS_SUMM_,'
      '110421490=               S.OSNOVANIE = :OSNOVANIE_,'
      '110421491=               S.NOTE      = :NOTE_'
      '110421492=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110421493=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP_'
      '110421494=         WHERE S.SKLAD = :SKLAD_;'
      '110421495='
      '110421496=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '110421497=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_) THEN BEGI' +
        'N'
      '110421498=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '110421499=              UPDATE LT_SKLAD_PRODUCT L'
      
        '110421500=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OL' +
        'D_ - :AMOUNT_)'
      '110421501=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110421502=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '110421503='
      '110421504=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '110421505=              UPDATE LT_SKLAD_PRODUCT L'
      
        '110421506=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ -' +
        ' :AMOUNT_OLD_)'
      '110421507=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110421508=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '110421509=        END'
      
        '110421510=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058#1054 +
        ' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '110421511=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED_' +
        ' = 0) THEN BEGIN'
      '110421512=            UPDATE LT_SKLAD_PRODUCT L'
      '110421513=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110421514=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110421515=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110421516='
      '110421517=            IF (ROW_COUNT = 0) THEN'
      
        '110421518=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN' +
        '_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCHK' +
        'A_);'
      '110421519=        END'
      
        '110421520=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042#1048 +
        #1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      '110421521=        ELSE BEGIN'
      '110421522=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110421523=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD_' +
        ' - :AMOUNT_) - :AMOUNT_'
      '110421524=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110421525=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110421526=        END'
      '110421527='
      
        '110421528=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048' ' +
        #1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048 +
        #1058#1068' IS_LAST = 1'
      '110421529=        PNT_ = '#39#39'07'#39#39';'
      
        '110421530=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110421531=            SELECT MAX(SK.DATE_RECEIPT)'
      '110421532=              FROM SKLAD SK'
      '110421533=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110421534=               AND SK.IS_LAST = 1'
      '110421535=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110421536=              INTO :DATE_LAST_;'
      '110421537='
      
        '110421538=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110421539=              UPDATE SKLAD SK'
      '110421540=                 SET SK.IS_LAST = 0'
      '110421541=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110421542=                 AND SK.IS_LAST = 1'
      '110421543=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110421544='
      '110421545=              UPDATE SKLAD SK'
      '110421546=                 SET SK.IS_LAST = 1'
      '110421547=               WHERE SK.SKLAD = :SKLAD_;'
      '110421548=            END'
      '110421549=        END'
      '110421550='
      
        '110421551=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048' ' +
        'IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068 +
        ' IS_LAST = 0'
      '110421552=        PNT_ = '#39#39'08'#39#39';'
      
        '110421553=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (I' +
        'S_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110421554=            SELECT MAX(SK.DATE_RECEIPT)'
      '110421555=              FROM SKLAD SK'
      '110421556=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110421557=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '110421558=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110421559=               AND SK.is_vozvrat IN (0,4)'
      '110421560=              INTO :DATE_LAST_;'
      '110421561='
      
        '110421562=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_REC' +
        'EIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' '#1055 +
        #1054#1057#1051#1045#1044#1053#1071#1071
      '110421563=              UPDATE SKLAD SK'
      '110421564=                 SET SK.IS_LAST = 0'
      '110421565=               WHERE SK.SKLAD = :SKLAD_;'
      '110421566='
      '110421567=               UPDATE SKLAD SK'
      '110421568=                 SET SK.IS_LAST = 1'
      '110421569=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110421570=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110421571=                                   FROM SKLAD SS'
      
        '110421572=                                  WHERE SS.G_PRODUCT =' +
        ' SK.G_PRODUCT'
      
        '110421573=                                    AND SS.DATE_RECEIP' +
        'T = :DATE_LAST_'
      
        '110421574=                                    AND SS.G_TOCHKA = ' +
        ':G_TOCHKA_'
      
        '110421575=                                    AND SS.is_vozvrat ' +
        'IN (0,4));'
      '110421576='
      '110421577=            END'
      
        '110421578=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054#1052 +
        ' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1053 +
        #1048#1052'.'
      
        '110421579=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059#1044 +
        #1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '110421580=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THIS' +
        '_LAST_ = 1)) THEN BEGIN'
      '110421581=              UPDATE SKLAD SK'
      '110421582=                 SET SK.IS_LAST = 1'
      '110421583=               WHERE SK.SKLAD = :SKLAD_;'
      '110421584=            END'
      '110421585=        END'
      '110421586=    END'
      '110421587=  END'
      '110421588='
      
        '110421589=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057#1057 +
        #1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '110421590=      ----------------------------------------'
      
        '110421591=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058#1068 +
        ' '#1044#1040#1058#1059' '#1042' '#1055#1056#1048#1061#1054#1044#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '110421592=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048' ' +
        #1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052'  - '#1058#1045#1055#1045#1056#1068' '#1069#1058#1054' '#1044#1045#1051#1040#1045#1058#1057#1071' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' K_UPD_KASSA'
      '110421593=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '110421594=      -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '110421595=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '110421596=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110421597=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '110421598='
      
        '110421599=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' ' +
        #1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '110421600=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053#1054 +
        #1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '110421601=      IF (IS_VOZVRAT_ = 0) THEN'
      '110421602=        G_PRIHOD_RASHOD_ = 2;'
      '110421603=      ELSE'
      '110421604=        G_PRIHOD_RASHOD_ = 3;'
      '110421605='
      '110421606=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110421607=            PNT_ = '#39#39'09'#39#39';'
      '110421608=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110421609=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110421610=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110421611=            ELSE'
      
        '110421612=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110421613='
      '110421614=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110421615=                RETURNING_VALUES :KASSA_, :PAYMENT_DAT' +
        'E_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110421616='
      
        '110421617=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110421618=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THEN'
      
        '110421619=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110421620=                                              :G_PRIHO' +
        'D_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110421621=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110421622=                                              :PAYMENT' +
        '_DATE_,'
      
        '110421623=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110421624=                                              NULL,   ' +
        '--ZAKAZ_'
      
        '110421625=                                              :SKLAD_P' +
        'ARENT_,'
      
        '110421626=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110421627=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110421628='
      
        '110421629=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058 +
        #1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '110421630=            ELSE BEGIN'
      
        '110421631=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048 +
        #1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '110421632=                SELECT 1'
      '110421633=                  FROM KASSA K'
      '110421634=                 WHERE K.KASSA = :KASSA_'
      '110421635=                UNION ALL'
      '110421636=                SELECT 2'
      '110421637=                  FROM KASSA_BEZNAL KB'
      '110421638=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110421639=                 INTO :PAYMENT_TYPE_OLD_;'
      '110421640='
      
        '110421641=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110421642=                      PNT_ = '#39#39'010'#39#39';'
      
        '110421643=                      EXECUTE PROCEDURE K_UPD_KASSA(:K' +
        'ASSA_,'
      
        '110421644=                                                    1,' +
        '     -- ACTION_'
      
        '110421645=                                                    :G' +
        '_PRIHOD_RASHOD_,'
      
        '110421646=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110421647=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110421648=                                                    NU' +
        'LL,   --NOTE_'
      
        '110421649=                                                    NU' +
        'LL,  --ZAKAZ'
      
        '110421650=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110421651=                                                    :P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110421652='
      
        '110421653=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040 +
        #1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110421654=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040 +
        #1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110421655=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110421656=                      PNT_ = '#39#39'011'#39#39';'
      
        '110421657=                      EXECUTE PROCEDURE K_DEL_KASSA(:K' +
        'ASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG' +
        ');'
      '110421658=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110421659=                        ERR_MSG = PROCNAME||'#39#39' -> PNT_' +
        ' '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110421660=                        EXIT;'
      '110421661=                      END'
      '110421662='
      
        '110421663=                      EXECUTE PROCEDURE K_INS_KASSA(1,' +
        '     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110421664=                                                    :G' +
        '_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110421665=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110421666=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110421667=                                                    NU' +
        'LL,   --NOTE_ => :NOTE_,'
      
        '110421668=                                                    NU' +
        'LL,   --ZAKAZ_'
      
        '110421669=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110421670=                                                    :P' +
        'AYMENT_TYPE_,'
      
        '110421671=                                                    :G' +
        '_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110421672=                END'
      '110421673=            END'
      '110421674=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110421675=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110421676=              EXIT;'
      '110421677=            END'
      '110421678='
      
        '110421679=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~'#39#39'; ' +
        '  -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '110421680=      END'
      '110421681='
      
        '110421682=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059#1044 +
        #1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '110421683=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110421684=            FROM KASSA K'
      '110421685=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110421686=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA||'#39#39'~'#39#39
      '110421687=           UNION'
      '110421688=          SELECT KASSA, 1 PAYMENT_TYPE'
      '110421689=            FROM KASSA K'
      '110421690=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110421691=             AND K.SUMM = 0'
      '110421692=          UNION'
      '110421693=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110421694=            FROM KASSA_BEZNAL K'
      '110421695=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110421696=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA_BEZNAL||'#39#39'~'#39#39
      '110421697=          UNION'
      '110421698=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110421699=            FROM KASSA_BEZNAL K'
      '110421700=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110421701=             AND K.SUMM = 0'
      '110421702=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110421703=      DO BEGIN'
      '110421704=        PNT_ = '#39#39'011A'#39#39';'
      
        '110421705=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYMEN' +
        'T_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110421706=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110421707=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110421708=          EXIT;'
      '110421709=        END'
      '110421710=      END'
      '110421711=  END'
      '110421712='
      
        '110421713=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      '110421714=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110421715=    SELECT K.KASSA'
      '110421716=      FROM KASSA K'
      '110421717=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110421718=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110421719=      INTO :KASSA_POP_;'
      '110421720=  ELSE'
      '110421721=    SELECT K.KASSA_BEZNAL'
      '110421722=      FROM KASSA_BEZNAL K'
      '110421723=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110421724=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110421725=       INTO :KASSA_POP_;'
      '110421726='
      
        '110421727=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '110421728=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEGI' +
        'N'
      '110421729=      PNT_ = '#39#39'012'#39#39';'
      '110421730=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      '110421731=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_,'
      
        '110421732=                                          1,     -- AC' +
        'TION_'
      '110421733=                                          :G_PRIHOD_,'
      
        '110421734=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110421735=                                          :DATE_RECEIP' +
        'T_,'
      
        '110421736=                                          NULL,   --NO' +
        'TE_'
      '110421737=                                          NULL,'
      
        '110421738=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110421739=                                          :G_PAYMENT_T' +
        'YPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110421740=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110421741=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110421742=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_'
      '110421743=                                          :G_PRIHOD_,'
      
        '110421744=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110421745=                                          :DATE_RECEIP' +
        'T_,'
      
        '110421746=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      '110421747=                                          NULL,'
      
        '110421748=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110421749=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110421750=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110421751=      END'
      '110421752=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110421753=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110421754=        EXIT;'
      '110421755=      END'
      '110421756='
      
        '110421757=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048 +
        #1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110421758=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048 +
        #1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110421759=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110421760=        PNT_ = '#39#39'013'#39#39';'
      
        '110421761=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110421762=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110421763=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110421764=          EXIT;'
      '110421765=        END'
      '110421766=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110421767=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '110421768=                                          :G_PRIHOD_,'
      
        '110421769=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110421770=                                          :DATE_RECEIP' +
        'T_,'
      
        '110421771=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110421772=                                          NULL,   --ZA' +
        'KAZ_'
      
        '110421773=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110421774=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110421775=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110421776=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110421777=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110421778=              EXIT;'
      '110421779=            END'
      '110421780=        END'
      '110421781=  END'
      '110421782=end'
      '110421783='#39';'
      '110421784=END  --END_EXECUTE_BLOCK'
      '110421785=EXECUTE BLOCK AS BEGIN'
      '110421786='
      
        '110421787=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        'S_TMP('
      
        '110421788=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110421789=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110421790=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110421791=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110421792=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '110421793=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '110421794=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      '110421795=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110421796=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110421797=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '110421798=RETURNS ('
      '110421799=  ERR_CODE INTEGER,'
      '110421800=  ERR_MSG VARCHAR(1024))'
      '110421801=AS'
      '110421802=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '110421803=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL_TMP'#39#39';'
      '110421804=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110421805=DECLARE VARIABLE G_PRODUCT_ INTEGER;'
      
        '110421806=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '110421807=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054 +
        #1052' '#1047#1040#1050#1040#1047#1045' */'
      
        '110421808=DECLARE VARIABLE ZAKAZ_ INTEGER = 0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID' +
        ' '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047#1040#1050#1040#1047' */'
      
        '110421809=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110421810=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      '110421811=BEGIN'
      '110421812='
      
        '110421813=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070', '#1040' '#1047#1040#1058#1045#1052' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1040#1053#1040#1051 +
        #1048#1047' '#1055#1054' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1045#1053#1053#1054#1052#1059' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059','
      
        '110421814=  -- '#1048' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1045#1043#1054' '#1057' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045'. '#1045#1057#1051#1048' '#1063#1058#1054', ' +
        #1055#1056#1048' '#1043#1045#1053#1045#1056#1040#1062#1048#1048' '#1054#1064#1048#1041#1050#1048', '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1041#1059#1044#1045#1058' ROLLBACK'
      '110421815=  PNT_ = '#39#39'01'#39#39';'
      '110421816=  UPDATE ZAKAZ_DETAILS_TMP t'
      '110421817=     SET t.AMOUNT = :AMOUNT_,'
      '110421818=        t.PRICE = :PRICE_,'
      '110421819=        t.SUMM = :SUMM_,'
      '110421820=        t.DISCOUNT_PERC = :DISCOUNT_PERC_,'
      '110421821=        t.DISCOUNT_TENGE = :DISCOUNT_TENGE_,'
      '110421822=        T.DISCOUNT_SUMM = :DISCOUNT_SUMM_,'
      '110421823=        T.NDS = :NDS_,'
      '110421824=        T.NDS_SUMM = :NDS_SUMM_'
      '110421825=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '110421826=  RETURNING'
      '110421827=    ZAKAZ, Z_TYPE'
      '110421828=  INTO'
      '110421829=    :ZAKAZ_, :Z_TYPE_;'
      '110421830='
      
        '110421831=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054#1043 +
        #1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110421832=  PNT_ = '#39#39'02'#39#39';'
      '110421833=  if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '110421834=      SELECT L.G_PRODUCT,'
      '110421835=             L.AMOUNT - L.AMOUNT_RESERVE'
      '110421836=        FROM ZAKAZ_DETAILS_TMP S,'
      '110421837=             LT_SKLAD_PRODUCT L'
      '110421838=       WHERE S.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '110421839=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '110421840=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110421841=        INTO :G_PRODUCT_,'
      '110421842=             :AMOUNT_CUR_;'
      '110421843='
      
        '110421844=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110421845=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110421846=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110421847=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051 +
        #1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068 +
        #1050#1054
      
        '110421848=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068 +
        ' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110421849=      PNT_ = '#39#39'04'#39#39';'
      '110421850=      if (COALESCE(Z_TYPE_, 0) <> 3) then'
      '110421851=          SELECT SUM(AMOUNT)'
      '110421852=            FROM ZAKAZ_DETAILS T'
      '110421853=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110421854=             AND T.ZAKAZ = :ZAKAZ_'
      '110421855=            INTO :AMOUNT_OLD_;'
      '110421856=      ELSE'
      '110421857=          SELECT SUM(AMOUNT)'
      '110421858=            FROM SKLAD T'
      '110421859=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110421860=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110421861=            INTO :AMOUNT_OLD_;'
      '110421862='
      '110421863=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110421864=      PNT_ = '#39#39'05'#39#39';'
      '110421865=      SELECT SUM(AMOUNT)'
      '110421866=        FROM ZAKAZ_DETAILS_TMP T'
      '110421867=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110421868=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110421869='
      
        '110421870=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110421871=        ERR_CODE = -20500;'
      
        '110421872=        ERR_MSG = '#39#39#1055#1086#1089#1083#1077' '#1076#1072#1085#1085#1086#1081' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090 +
        #1086#1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39#39'||ASCII_CHAR(10)||'
      
        '110421873=                  '#39#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082#1086#1084' ' +
        #1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39#39';'
      
        '110421874=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_MS' +
        'G) RETURNING_VALUES (:ERR_MSG);'
      '110421875=        ERR_MSG = PROCNAME||ERR_MSG;'
      '110421876=        EXIT;'
      '110421877=      END'
      '110421878=  END'
      '110421879=when sqlcode -811 DO'
      '110421880=  begin'
      '110421881=    ERR_CODE = -20500;'
      
        '110421882=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1052#1085#1086#1078#1077#1089#1090#1074 +
        #1086' '#1089#1090#1088#1086#1082' '#1074' '#1086#1076#1080#1085#1086#1095#1085#1086#1084' SELECT!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110421883=    ERR_MSG = PROCNAME||'#39#39' ->  PNT_ '#39#39'||PNT_||'#39#39'. '#39#39'||' +
        'ERR_MSG;'
      '110421884=  end'
      '110421885=END'
      '110421886='#39';'
      '110421887=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110430=EXECUTE BLOCK AS BEGIN'
      '110431=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRICE_LIST('
      '110432=  G_CATEGORY_ VARCHAR(2000),'
      '110433=  INCLUDE_NOL_ INTEGER,'
      '110434=  INCLUDE_FEW_ INTEGER,'
      '110435=  SORT_BY_NAME_ INTEGER,'
      
        '110436=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ INTEGE' +
        'R,'
      '110437=  G_TOCHKA_ARR_ VARCHAR(1000) = '#39#39#39#39')'
      '110438=RETURNS ('
      '110439=  PERIOD_ VARCHAR(40),'
      '1104310=  ROW_NUM VARCHAR(15),'
      '1104311=  ARTICUL VARCHAR(1000),'
      '1104312=  BARCODE VARCHAR(30),'
      
        '1104313=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      '1104314=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1104315=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50)' +
        ','
      
        '1104316=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15,' +
        '2),'
      
        '1104317=  VOLUME_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE ' +
