        '11016311='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053#1040#1051 +
        #1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065#1059#1070 +
        ' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '11016312=*/'
      '11016313=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '11016314=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11016315=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '11016316=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '11016317=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '11016318=DECLARE VARIABLE ACTION_DATE_ DATE;'
      '11016319=DECLARE VARIABLE ACTION_ TYPE OF COLUMN KASSA."ACTION";'
      
        '11016320=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11016321=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '11016322=BEGIN'
      '11016323=  PROCNAME = '#39'K_DEL_KASSA'#39';'
      '11016324='
      
        '11016325=  -----------------------------------------------------' +
        '-----------------'
      '11016326=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '11016327=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT_' +
        'TYPE_ = 1)) THEN BEGIN'
      '11016328=      SELECT K.SUMM,'
      '11016329=             K.ACTION_DATE,'
      '11016330=             K."ACTION",'
      '11016331=             K.G_TOCHKA'
      '11016332=        FROM KASSA K'
      '11016333=       WHERE K.KASSA = :KASSA_'
      '11016334=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA_;'
      '11016335='
      
        '11016336=      --***********************************************' +
        '**'
      '11016337=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '11016338=      --***********************************************' +
        '**'
      '11016339=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '11016340=      PNT_ = '#39'02'#39';'
      '11016341=      IF (:ACTION_ = 0) THEN'
      '11016342=        CREDIT_ = SUMM_;'
      '11016343=      ELSE'
      '11016344=        DEBET_ = SUMM_;'
      '11016345='
      '11016346=      UPDATE KASSA_STATE K'
      '11016347=         SET K.DEBET = K.DEBET - :DEBET_,'
      '11016348=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '11016349=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_) +' +
        ' (K.CREDIT - :CREDIT_)'
      '11016350=       WHERE K.K_DATE = :ACTION_DATE_'
      '11016351=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '11016352='
      
        '11016353=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '11016354=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTE' +
        'M_SETUP = 5) > 0) THEN BEGIN'
      '11016355=        SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '11016356=                     '#39'SET K.DEBET = K.DEBET - '#39'||COALES' +
        'CE(:DEBET_, 0)||'#39', '#39'||'
      
        '11016357=                          '#39'K.CREDIT = K.CREDIT - '#39'||COA' +
        'LESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '11016358=                          '#39'K.OUTPUT = K.INPUT - (K.DEBE' +
        'T - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CREDI' +
        'T_, 0)||'#39') '#39'||'
      
        '11016359=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DATE_' +
        '||'#39#39#39' '#39'||'
      
        '11016360=                     '#39'AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';' +
        #39';'
      
        '11016361=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '11016362=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11016363=      END'
      '11016364='
      
        '11016365=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '11016366=      PNT_ = '#39'04'#39';'
      
        '11016367=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_, :' +
        'G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '11016368=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11016369=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11016370=        EXIT;'
      '11016371=      END'
      '11016372='
      '11016373=      DELETE FROM KASSA'
      '11016374=      WHERE KASSA = :KASSA_;'
      '11016375=  END'
      
        '11016376=  -----------------------------------------------------' +
        '-----------------'
      '11016377=  --*************************************************'
      
        '11016378=  -----------------------------------------------------' +
        '-----------------'
      
        '11016379=  -----------------------------------------------------' +
        '-----------------'
      '11016380=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '11016381=  ELSE BEGIN'
      '11016382=      SELECT K.SUMM,'
      '11016383=             K.ACTION_DATE,'
      '11016384=             K."ACTION",'
      '11016385=             K.G_TOCHKA'
      '11016386=        FROM KASSA_BEZNAL K'
      '11016387=       WHERE K.KASSA_BEZNAL = :KASSA_'
      '11016388=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA_;'
      '11016389='
      
        '11016390=      --***********************************************' +
        '**'
      '11016391=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '11016392=      --***********************************************' +
        '**'
      '11016393=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '11016394=      PNT_ = '#39'02'#39';'
      '11016395=      IF (:ACTION_ = 0) THEN'
      '11016396=        CREDIT_ = SUMM_;'
      '11016397=      ELSE'
      '11016398=        DEBET_ = SUMM_;'
      '11016399='
      '110163100=      UPDATE KASSA_BEZNAL_STATE K'
      '110163101=         SET K.DEBET = K.DEBET - :DEBET_,'
      '110163102=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '110163103=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_) ' +
        '+ (K.CREDIT - :CREDIT_)'
      '110163104=       WHERE K.K_DATE = :ACTION_DATE_;'
      '110163105='
      
        '110163106=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068 +
        ' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110163107=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110163108=        SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      
        '110163109=                     '#39'SET K.DEBET = K.DEBET - '#39'||COALE' +
        'SCE(:DEBET_, 0)||'#39', '#39'||'
      
        '110163110=                         '#39'K.CREDIT = K.CREDIT - '#39'||COA' +
        'LESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '110163111=                         '#39'K.OUTPUT = K.INPUT - (K.DEBE' +
        'T - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CREDI' +
        'T_, 0)||'#39') '#39'||'
      
        '110163112=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DATE' +
        '_||'#39#39#39';'#39';'
      '110163113='
      
        '110163114=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFE' +
        'RED, SYSDATE, ERR_CODE)'
      
        '110163115=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSD' +
        'BA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110163116=      END'
      '110163117='
      
        '110163118=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110163119=      PNT_ = '#39'04'#39';'
      
        '110163120=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION_' +
        'DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110163121=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110163122=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110163123=        EXIT;'
      '110163124=      END'
      '110163125='
      '110163126=      DELETE FROM KASSA_BEZNAL'
      '110163127=      WHERE KASSA_BEZNAL = :KASSA_;'
      '110163128=  END'
      
        '110163129=  ----------------------------------------------------' +
        '------------------'
      '110163130=  --*************************************************'
      '110163131='
      '110163132=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      '110163133=  IF (LOG_BODY_ IS NOT NULL) THEN'
      
        '110163134=    EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :USE' +
        'R_ID_, :KASSA_, :ACTION_DATE_, 3, :SUMM_, :LOG_BODY_);'
      '110163135='
      '110163136=when sqlcode -530 DO'
      '110163137=  begin'
      '110163138=    ERR_CODE = -20500;'
      
        '110163139=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110163140=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110163141=  end'
      '110163142=end'
      '110163143=;'
      '110163144='
      '110163145=ALTER PROCEDURE K_INS_KASSA('
      '110163146=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '110163147=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASHO' +
        'D,'
      '110163148=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '110163149=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110163150=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '110163151=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '110163152=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '110163153=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110163154=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110163155=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL,'
      
        '110163156=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110163157=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110163158=RETURNS ('
      '110163159=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '110163160=  ERR_CODE INTEGER,'
      '110163161=  ERR_MSG VARCHAR(1024))'
      '110163162=AS'
      '110163163=/*'
      
        '110163164='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053#1040 +
        #1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065#1059 +
        #1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '110163165=*/'
      '110163166=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '110163167=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110163168=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '110163169=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '110163170=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '110163171=begin'
      '110163172=  PROCNAME = '#39'K_INS_KASSA'#39';'
      '110163173='
      '110163174=  IF (G_TOCHKA_ IS NULL) THEN'
      '110163175=    SELECT ID'
      '110163176=      FROM CUR_PARAMS'
      '110163177=     WHERE CUR_PARAMS = 2'
      '110163178=      INTO :G_TOCHKA_;'
      '110163179='
      
        '110163180=  ----------------------------------------------------' +
        '------------------'
      '110163181=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '110163182=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT' +
        '_TYPE_ = 1)) THEN BEGIN'
      
        '110163183=      insert into KASSA (KASSA, "ACTION", G_PRIHOD_RAS' +
        'HOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, G_OFFICIAL' +
        ')'
      
        '110163184=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIHO' +
        'D_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_T' +
        'OCHKA_, :G_OFFICIAL_)'
      '110163185=      returning KASSA'
      '110163186=      into :KASSA_;'
      '110163187='
      '110163188=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '110163189=      PNT_ = '#39'02'#39';'
      '110163190=      IF (:ACTION_ = 0) THEN'
      '110163191=        CREDIT_ = SUMM_;'
      '110163192=      ELSE'
      '110163193=        DEBET_ = SUMM_;'
      '110163194='
      
        '110163195=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DATE' +
        '_, :G_TOCHKA_, :DEBET_, :CREDIT_, 1) RETURNING_VALUES (:ERR_CODE' +
        ', :ERR_MSG);'
      '110163196=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110163197=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110163198=        EXIT;'
      '110163199=      END'
      '110163200='
      
        '110163201=      ------------------------------------------------' +
        '----------------------'
      
        '110163202=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110163203=      PNT_ = '#39'04'#39';'
      
        '110163204=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_, ' +
        ':G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110163205=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110163206=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110163207=        EXIT;'
      '110163208=      END'
      '110163209=  END'
      
        '110163210=  ----------------------------------------------------' +
        '------------------'
      
        '110163211=  ----------------------------------------------------' +
        '------------------'
      '110163212=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '110163213=  ---------- '#1042' KASSA_BEZNAL_STATE '#1053#1045' '#1044#1045#1051#1040#1070' '#1056#1040#1047#1044#1045#1051#1045#1053#1048#1045' ' +
        #1055#1054' '#1057#1050#1051#1040#1044#1040#1052', '#1042#1045#1044#1068' '#1056#1040#1057#1063#1045#1058#1053#1067#1049' '#1057#1063#1045#1058' '#1054#1041#1065#1048#1049
      '110163214=  ELSE BEGIN'
      
        '110163215=      insert into KASSA_BEZNAL (KASSA_BEZNAL, "ACTION"' +
        ', G_PRIHOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCH' +
        'KA, G_OFFICIAL)'
      
        '110163216=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIHO' +
        'D_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_T' +
        'OCHKA_, :G_OFFICIAL_)'
      '110163217=      returning KASSA_BEZNAL'
      '110163218=      into :KASSA_;'
      '110163219='
      '110163220=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '110163221=      PNT_ = '#39'02A'#39';'
      '110163222=      IF (:ACTION_ = 0) THEN'
      '110163223=        CREDIT_ = SUMM_;'
      '110163224=      ELSE'
      '110163225=        DEBET_ = SUMM_;'
      '110163226='
      
        '110163227=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DATE' +
        '_, :G_TOCHKA_, :DEBET_, :CREDIT_, 0) RETURNING_VALUES (:ERR_CODE' +
        ', :ERR_MSG);'
