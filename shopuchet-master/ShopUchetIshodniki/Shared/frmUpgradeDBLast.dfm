        '11041783=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUM' +
        'M;'
      '11041784=BEGIN'
      '11041785='
      '11041786=  IF (G_TOCHKA_ IS NULL) THEN'
      '11041787=    SELECT ID'
