        'MOUNT_PRIHOD_SKL_;'
      
        '1101322336=      SUMM_PRIHOD_SKL_   = SUMM_PRIHOD_SKL_ + REC_SUM' +
        'M_PRIHOD_SKL_;'
      
        '1101322337=      AMOUNT_UHOD_SKL_   = AMOUNT_UHOD_SKL_ + REC_AMO' +
        'UNT_UHOD_SKL_;'
      
