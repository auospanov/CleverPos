        '11018321=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST_F' +
        'IO,'
      '11018322=  ERR_CODE INTEGER,'
      '11018323=  ERR_MSG VARCHAR(1024))'
      '11018324=AS'
      
        '11018325=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'W_GET_WAYBILL'#39 +
        ';'
