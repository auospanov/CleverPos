        'T,'
      '11024026=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '11024027=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '11024028=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '11024029=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '11024030=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '11024031=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11024032=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11024033=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11024034=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11024035=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11024036=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY = 0,'
      
        '11024037=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED ' +
        '= 0,'
      '11024038=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '11024039=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '11024040=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '11024041=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NU' +
        'LL,'
      '11024042=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '11024043=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE = NULL,'
      '11024044=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = NULL)'
      '11024045=RETURNS ('
      '11024046=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11024047=  ERR_CODE INTEGER,'
      '11024048=  ERR_MSG VARCHAR(1024))'
      '11024049=AS'
      '11024050=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '11024051=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042#1040 +
        #1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '11024052=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '11024053=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '11024054=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050 +
        #1048
      
        '11024055=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' '#1057 +
        #1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '11024056=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050#1040 +
        #1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047#1044 +
        #1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '11024057=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059#1044 +
        #1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM ' +
        #1041#1059#1044#1059
      '11024058=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '11024059=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047#1053 +
        #1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048' ' +
        #1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '11024060=--'
      
        '11024061=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTED' +
        ' = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '11024062=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056#1054 +
        #1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1059 +
        #1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '11024063='
      
        '11024064=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045 +
        #1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '11024065=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '11024066=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11024067=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11024068=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11024069=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11024070=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11024071=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '11024072=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM = 0;'
      
        '11024073=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      '11024074=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11024075=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIH' +
        'OD_RASHOD.G_PRIHOD_RASHOD;'
      
        '11024076=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11024077=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '11024078=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11024079=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11024080=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11024081=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11024082=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11024083=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11024084=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.P' +
        'RICE_CURRENCY;'
      
        '11024085=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKLA' +
        'D.SUMM_CURRENCY;'
      
        '11024086=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.P' +
        'RICE_ROZN;'
      
        '11024087=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRODU' +
        'CT.PRICE;'
      
        '11024088=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK_C' +
        'ODE;'
      
        '11024089=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COST_' +
        'PRICE;'
      
        '11024090=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS_GOT;'
      
        '11024091=DECLARE VARIABLE SUMM_BONUS_ TYPE OF COLUMN G_DISCONT_C' +
        'ARD.SUMM;'
      
        '11024092=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.SUMM;'
      
        '11024093=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM;'
      '11024094=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '11024095=BEGIN'
      '11024096='
      '11024097=  PNT_ = '#39'00'#39';'
      '11024098=  IS_THIS_LAST_ = 0;'
      '11024099='
      '110240100=  IF (G_TOCHKA_ IS NULL) THEN'
      '110240101=    SELECT ID'
      '110240102=      FROM CUR_PARAMS'
      '110240103=     WHERE CUR_PARAMS = 2'
      '110240104=      INTO :G_TOCHKA_;'
      '110240105='
      '110240106=  IF (G_TOCHKA_ IS NULL) THEN BEGIN'
      '110240107=    ERR_CODE = -20500;'
      
        '110240108=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077' '#1091#1082#1072#1079#1072#1085 +
        ' '#1089#1082#1083#1072#1076' '#1087#1088#1086#1076#1072#1078#1080'! '#1054#1073#1088#1072#1090#1080#1090#1077#1089#1100' '#1082' '#1088#1072#1079#1088#1072#1073#1086#1090#1095#1080#1082#1091'!'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110240109=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110240110=    EXIT;'
      '110240111=  END'
      '110240112='
      '110240113=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110240114=  IF (G_OFFICIAL_ IS NULL) THEN'
      '110240115=      SELECT ID'
      '110240116=        FROM CUR_PARAMS'
      '110240117=       WHERE CUR_PARAMS = 1'
      '110240118=        INTO :G_OFFICIAL_;'
      '110240119='
      '110240120=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110240121=                            DATE_RECEIPT,'
      '110240122=                            TIME_RECEIPT,'
      '110240123=                            G_CLIENT,'
      '110240124=                            G_PAYMENT_TYPE,'
      '110240125=                            OSNOVANIE,'
      '110240126=                            NOTE,'
      '110240127=                            SUMM,'
      '110240128=                            SUMM_FACT,'
      '110240129=                            SUMM_CURRENCY,'
      '110240130=                            IS_PAYED_ALL,'
      '110240131=                            IS_VOZVRAT,'
      '110240132=                            G_TOCHKA'
      '110240133=                            ,G_OFFICIAL'
      '110240134=                            ,IS_EXPECTED'
      '110240135=                            ,G_NONCASH_PAY_TYPE'
      '110240136=                            ,REC_ID'
      '110240137=                            ,ZAKAZ)'
      '110240138=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110240139=          :DATE_RECEIPT_,'
      '110240140=          :TIME_RECEIPT_,'
      '110240141=          :G_CLIENT_,'
      '110240142=          :G_PAYMENT_TYPE_,'
      '110240143=          :OSNOVANIE_,'
      '110240144=          :NOTE_,'
      '110240145=          :SUMM_,'
      '110240146=          :SUMM_FACT_,'
      '110240147=          :SUMM_CURRENCY_,'
      
        '110240148=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE ' +
        '0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057 +
        #1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110240149=          :IS_VOZVRAT_,'
      '110240150=          :G_TOCHKA_'
      '110240151=          ,:G_OFFICIAL_'
      '110240152=          ,:IS_EXPECTED_'
      '110240153=          ,:G_NONCASH_PAY_TYPE_'
      '110240154=          ,:REC_ID_'
      '110240155=          ,:ZAKAZ_)'
      '110240156=  RETURNING'
      '110240157=    SKLAD'
      '110240158=  INTO'
      '110240159=    :SKLAD_;'
      '110240160='
      '110240161=  PNT_ = '#39'01'#39';'
      '110240162=  FOR SELECT SKLAD,'
      '110240163=             T.G_PRODUCT,'
      '110240164=             AMOUNT,'
      '110240165=             T.PRICE,'
      '110240166=             SUMM,'
      '110240167=             NDS,'
      '110240168=             NDS_SUMM'
      '110240169=             ,PRICE_CURRENCY'
      '110240170=             ,SUMM_CURRENCY'
      '110240171=             ,PRICE_ROZN'
      '110240172=             ,GG.PRICE'
      '110240173=             ,T.MARK_CODE'
      '110240174=             ,T.COST_PRICE'
      '110240175=        FROM SKLAD_TMP T,'
      '110240176=             G_PRODUCT GG'
      '110240177=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110240178=      ORDER BY 1'
      '110240179=      INTO :SKLAD_TMP_,'
      '110240180=           :RG_PRODUCT_,'
      '110240181=           :RAMOUNT_,'
      '110240182=           :RPRICE_,'
      '110240183=           :RSUMM_,'
      '110240184=           :RNDS_,'
      '110240185=           :RNDS_SUMM_'
      '110240186=           ,:PRICE_CURRENCY_'
      '110240187=           ,:SUMM_CURRENCY_TMP_'
      '110240188=           ,:SALE_PRICE_'
      '110240189=           ,:SALE_PRICE_CUR_'
      '110240190=           ,:MARK_CODE_'
      '110240191=           ,:COST_PRICE_'
      '110240192=  DO BEGIN'
      '110240193=    INSERT INTO SKLAD'
      '110240194=    ('
      '110240195=     SKLAD,'
      '110240196=     SKLAD_PARENT,'
      '110240197=     DATE_RECEIPT,'
      '110240198=     G_CLIENT,'
      '110240199=     G_PRODUCT,'
      '110240200=     AMOUNT,'
      '110240201=     PRICE,'
      '110240202=     SUMM,'
      '110240203=     G_PAYMENT_TYPE,'
      '110240204=     OSNOVANIE,'
      '110240205=     NOTE,'
      '110240206=     NDS,'
      '110240207=     NDS_SUMM,'
      '110240208=     IS_LAST,'
      '110240209=     IS_VOZVRAT,'
      '110240210=     G_TOCHKA'
      '110240211=     ,PRICE_CURRENCY'
      '110240212=     ,SUMM_CURRENCY'
      '110240213=     ,MARK_CODE'
      '110240214=     ,COST_PRICE'
      '110240215=    ) VALUES ('
      '110240216=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110240217=     :SKLAD_,'
      '110240218=     :DATE_RECEIPT_,'
      '110240219=     :G_CLIENT_,'
      '110240220=     :RG_PRODUCT_,'
      '110240221=     :RAMOUNT_,'
      '110240222=     :RPRICE_,'
      '110240223=     :RSUMM_,'
      '110240224=     :G_PAYMENT_TYPE_,'
      '110240225=     :OSNOVANIE_,'
      '110240226=     :NOTE_,'
      '110240227=     COALESCE(:RNDS_, 0),'
      '110240228=     COALESCE(:RNDS_SUMM_, 0),'
      
        '110240229=     0, --DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '110240230=     :IS_VOZVRAT_,'
      '110240231=     :G_TOCHKA_'
      '110240232=     ,:PRICE_CURRENCY_'
      '110240233=     ,:SUMM_CURRENCY_TMP_'
      '110240234=     ,:MARK_CODE_'
      '110240235=     ,:COST_PRICE_'
      '110240236=    );'
      '110240237='
      
        '110240238=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110240239=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110240240=        PNT_ = '#39'02'#39';'
      '110240241=        UPDATE LT_SKLAD_PRODUCT L'
      '110240242=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '110240243=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110240244=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110240245=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110240246='
      '110240247=        IF (ROW_COUNT = 0) THEN'
      
        '110240248=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110240249=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :RG' +
        '_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110240250=    END'
      '110240251='
      
        '110240252=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054 +
        #1044#1045
      '110240253=      UPDATE G_PRODUCT G'
      '110240254=         SET G.PRICE = :SALE_PRICE_'
      '110240255=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110240256=  END'
      '110240257=  ----------------------------------------'
      '110240258='
      
        '110240259=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110240260=  PNT_ = '#39'05'#39';'
      
        '110240261=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110240262=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110240263=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110240264=      ELSE'
      '110240265=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110240266='
      
        '110240267=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110240268=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110240269=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110240270=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110240271=                                        :SUMM_FACT_,'
      
        '110240272=                                        :DATE_RECEIPT_' +
        ','
      
        '110240273=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110240274=                                        NULL,   --ZAKA' +
        'Z_'
      '110240275=                                        :SKLAD_,'
      
        '110240276=                                        :G_PAYMENT_TYP' +
        'E_,'
      '110240277=                                        :G_TOCHKA_,'
      
        '110240278=                                        :UPLOAD_TO_EXT' +
        '_APP_'
      
        '110240279=                                        ) RETURNING_VA' +
        'LUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110240280=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110240281=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110240282=            EXIT;'
      '110240283=          END'
      '110240284=      END ELSE BEGIN'
      '110240285=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110240286=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110240287=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110240288=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110240289=            ELSE'
      
        '110240290=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110240291='
      '110240292=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110240293=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110240294='
      
        '110240295=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110240296='
      '110240297=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110240298=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110240299=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110240300=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110240301=                                              :PAYMENT' +
        '_DATE_,'
      
        '110240302=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110240303=                                              NULL,   ' +
        '--ZAKAZ_'
      '110240304=                                              :SKLAD_,'
      
        '110240305=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110240306=                                              :G_TOCHK' +
        'A_,'
      
        '110240307=                                              :UPLOAD_' +
        'TO_EXT_APP_'
      
        '110240308=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110240309=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110240310=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110240311=                  EXIT;'
      '110240312=                END'
      '110240313=            END'
      '110240314=          END'
      '110240315=      END'
      '110240316=  END'
      '110240317='
      '110240318=  -- 28.04.2022'
      
        '110240319=  -- '#1045#1057#1051#1048' '#1054#1060#1054#1056#1052#1051#1071#1045#1058#1057#1071' '#1042#1054#1047#1042#1056#1040#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1058#1054' '#1053#1040 +
        #1044#1054' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042' '#1047#1040' '#1069#1058#1059' '#1055#1056#1054#1044#1040#1046#1059
      
        '110240320=  -- '#1055#1056#1048#1063#1045#1052' '#1042#1045#1056#1053#1059#1058#1068' '#1048#1047' '#1042#1057#1045#1049' '#1055#1056#1054#1044#1040#1046#1048' '#1052#1054#1043#1059#1058' '#1058#1054#1051#1068#1050#1054' '#1063#1040#1057#1058#1068 +
        ', '#1055#1054#1069#1058#1054#1052#1059' '#1053#1040#1044#1054' '#1057#1063#1048#1058#1040#1058#1068
      
        '110240321=  -- '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1050' '#1052#1054#1052#1045#1053#1058#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1052#1054#1046#1045#1058' '#1048#1047#1052#1045#1053#1048#1058#1068#1057 +
        #1071', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1050#1040#1050#1054#1049' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1058#1054#1043#1044#1040' '#1041#1067#1051
      
        '110240322=  -- '#1055#1054' '#1061#1054#1056#1054#1064#1045#1052#1059' '#1045#1065#1045' '#1053#1040#1044#1054' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1043#1054' '#1055#1056#1054#1062 +
        #1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1042' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1048#1048' '#1057' '#1051#1045#1057#1045#1053#1050#1054#1049', '#1053#1054' '#1055#1054#1050#1040' '#1053#1045' '#1041#1059#1044#1059' '#1069#1058#1054#1043#1054' '#1044#1045#1051#1040 +
        #1058#1068
      
        '110240323=  IF (ZAKAZ_ IS NOT NULL AND IS_VOZVRAT_ = 1) THEN BEG' +
        'IN'
      '110240324=     /*SELECT Z.SUMM_BONUS_GOT,'
      '110240325=            Z.SUMM'
      '110240326=       FROM ZAKAZ Z'
      '110240327=      WHERE ZAKAZ = :ZAKAZ_'
      '110240328=       INTO :SUMM_BONUS_GOT_,'
      '110240329=            :ZAKAZ_SUMM_;'
      '110240330='
      '110240331=     IF (ZAKAZ_SUMM_ = SUMM_) THEN'
      '110240332=       BONUS_TO_MINUS_ = SUMM_BONUS_GOT_;'
      '110240333='
      '110240334=     ELSE BEGIN'
      
        '110240335=       BONUS_PERCENT_ = SUMM_BONUS_GOT_ / ZAKAZ_SUMM_;' +
        '  -- '#1053#1040#1061#1054#1046#1059' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058
      '110240336='
      
        '110240337=       BONUS_TO_MINUS_ = ROUND(SUMM_ * BONUS_PERCENT_,' +
        ' 2);   -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040#1058#1040
      '110240338=     END'
      '110240339='
      '110240340=     UPDATE G_DISCONT_CARD G'
      '110240341=        SET G.SUMM = G.SUMM - :BONUS_TO_MINUS_,'
      '110240342=            G.SUMM_ALL = G.SUMM_ALL - :SUMM_'
      '110240343=      WHERE G.G_CLIENT = :G_CLIENT_;*/'
      '110240344='
      '110240345=    SELECT G.SUMM'
      '110240346=      FROM G_DISCONT_CARD G'
      '110240347=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110240348=      INTO :SUMM_BONUS_;'
      '110240349='
      '110240350=    IF (:SUMM_BONUS_ > 0) THEN BEGIN'
      '110240351=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '110240352=              SUM(Z.SUMM)'
      '110240353=         FROM ZAKAZ Z'
      '110240354=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '110240355=         INTO :SUMM_BONUS_GOT_,'
      '110240356=              :SUMM_ALL_;'
      '110240357='
      
        '110240358=       SELECT ROUND( SUM(SP.SUMM * (Z.SUMM_BONUS_GOT /' +
        ' Z.SUMM)), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056 +
        #1040#1058#1040
      '110240359=              SUM(SP.SUMM)'
      '110240360=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '110240361=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '110240362=          AND SP.ZAKAZ = Z.ZAKAZ'
      '110240363=         INTO :BONUS_TO_MINUS_,'
      '110240364=              :SUMM_TO_MINUS_;'
      '110240365='
      '110240366=       UPDATE G_DISCONT_CARD G'
      
        '110240367=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_MI' +
        'NUS_,'
      
        '110240368=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINUS' +
        '_'
      '110240369=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '110240370=    END'
      '110240371=  END'
      '110240372='
      '110240373=  DELETE FROM SKLAD_TMP;'
      '110240374='
      
        '110240375=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110240376=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110240377=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110240378=                                  G_PRIHOD_,'
      '110240379=                                  :SUMM_PRIHOD_,'
      '110240380=                                  :DATE_RECEIPT_,'
      
        '110240381=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110240382=                                  NULL,   --:ZAKAZ_,'
      '110240383=                                  :SKLAD_,'
      '110240384=                                  :G_PAYMENT_TYPE_,'
      '110240385=                                  :G_TOCHKA_,'
      '110240386=                                  :UPLOAD_TO_EXT_APP_'
      
        '110240387=                                  ) RETURNING_VALUES (' +
        ':KASSA_, :ERR_CODE, :ERR_MSG);'
      '110240388=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110240389=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110240390=      EXIT;'
      '110240391=    END'
      '110240392=  END'
      '110240393='
      
        '110240394=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO_' +
        'EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1043 +
        #1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '110240395=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, 1' +
        ', 2)) THEN'
      
        '110240396=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER, IS_LOADED_MOB)'
      '110240397=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '110240398=            2,'
      '110240399=            :SKLAD_,'
      '110240400=            1,'
      
        '110240401=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ' +
        'ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' ' +
        #1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '110240402=           );'
      '110240403='
      '110240404=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110240405=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_I' +
        'D_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '110240406=END'
      '110240407=;'
      '110240408='
      '110240409=ALTER PROCEDURE INS_ZAKAZ('
      '110240410=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110240411=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110240412=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110240413=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110240414=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110240415=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110240416=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110240417=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110240418=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110240419=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110240420=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110240421=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110240422=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110240423=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110240424=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110240425=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110240426=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110240427=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110240428=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110240429=  IS_MEBEL_ INTEGER = 0,'
      
        '110240430=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110240431=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      
        '110240432=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NUL' +
        'L,'
      '110240433=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '110240434=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110240435=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110240436=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110240437=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110240438=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110240439=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '110240440=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE = NULL,'
      
        '110240441=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD ' +
        '= NULL,'
      
        '110240442=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PAY' +
        '_TRANSACTION_ID = NULL,'
      
        '110240443=  REQUEST_NUMBER_ TYPE OF COLUMN ZAKAZ.REQUEST_NUMBER ' +
        '= NULL)'
      '110240444=RETURNS ('
      '110240445=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110240446=  ERR_CODE INTEGER,'
      '110240447=  ERR_MSG VARCHAR(1024))'
      '110240448=AS'
      '110240449=/*'
      '110240450=IS_SPISANIE_'
      '110240451=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110240452=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110240453=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110240454=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110240455='
      '110240456='
      
        '110240457=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110240458=*/'
      '110240459=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110240460=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110240461=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110240462=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110240463=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110240464=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110240465=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110240466=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110240467=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110240468=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110240469=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110240470=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110240471=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110240472=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110240473=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '110240474=DECLARE VARIABLE CNT_ INTEGER;'
      '110240475=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110240476=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110240477=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110240478=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110240479=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110240480=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110240481=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110240482=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110240483=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110240484=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110240485=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110240486=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110240487=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110240488=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110240489=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110240490=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110240491=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      
        '110240492=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.MARK_CODE;'
      '110240493=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '110240494=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN L' +
        'OG_OPER.OPERATION;'
      
        '110240495=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '110240496=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110240497=BEGIN'
      '110240498='
      
        '110240499=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110240500=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110240501=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110240502=  IF (CNT_ = 0) THEN BEGIN'
      '110240503=    ERR_CODE = -20500;'
      
        '110240504=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110240505=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110240506=    EXIT;'
      '110240507=  END'
      '110240508='
      '110240509=  IF (G_TOCHKA_ IS NULL) THEN'
      '110240510=    SELECT ID'
      '110240511=      FROM CUR_PARAMS'
      '110240512=     WHERE CUR_PARAMS = 2'
      '110240513=      INTO :G_TOCHKA_;'
      '110240514='
      '110240515=  IF (G_TOCHKA_ IS NULL) THEN BEGIN'
      '110240516=    ERR_CODE = -20500;'
      
        '110240517=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077' '#1091#1082#1072#1079#1072#1085 +
        ' '#1089#1082#1083#1072#1076' '#1087#1088#1086#1076#1072#1078#1080'! '#1054#1073#1088#1072#1090#1080#1090#1077#1089#1100' '#1082' '#1088#1072#1079#1088#1072#1073#1086#1090#1095#1080#1082#1091'!'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110240518=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110240519=    EXIT;'
      '110240520=  END'
      '110240521='
      '110240522=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110240523=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110240524=      PNT_ = '#39'01'#39';'
      
        '110240525=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110240526=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110240527=      ELSE'
      '110240528=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110240529='
      '110240530=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110240531=      SELECT G.G_OFFICIAL,'
      '110240532=             G.DO_NOT_SALES_COMM,'
      '110240533=             G.FM||'#39' '#39'||G.NM'
      '110240534=        FROM G_OFFICIAL G'
      
        '110240535=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110240536=        INTO :G_OFFICIAL_,'
      '110240537=             :DO_NOT_SALES_COMM_,'
      '110240538=             :OFFICIAL_NAME_;'
      '110240539='
      '110240540=      INSERT INTO ZAKAZ'
      '110240541=      ('
      '110240542=       ZAKAZ,'
      '110240543=       G_TOCHKA,'
      '110240544=       Z_DATE,'
      '110240545=       Z_TIME,'
      '110240546=       G_CLIENT,'
      '110240547=       G_PAYMENT_TYPE,'
      '110240548=       OSNOVANIE,'
      '110240549=       IS_SPISANIE,'
      '110240550=       NOTE,'
      '110240551=       SUMM,'
      '110240552=       SUMM_FACT,'
