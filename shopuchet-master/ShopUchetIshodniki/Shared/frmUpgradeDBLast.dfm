      '11075847=                                  NULL,'
      '11075848=                                  :G_PAYMENT_TYPE_,'
      
        '11075849=                                  :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11075850=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075851=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11075852=      EXIT;'
      '11075853=    END'
      '11075854=  END'
      '11075855='
      
        '11075856=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057#1058 +
        #1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '11075857=  IF (IS_MEBEL_ = 1) THEN'
      
        '11075858=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS,' +
        ' ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '11075859=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, :' +
        'ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '11075860=end'
      '11075861=;'
      '11075862='
      '11075863=ALTER PROCEDURE K_DEL_KASSA('
      '11075864=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '11075865=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE)'
      '11075866=RETURNS ('
      '11075867=  ERR_CODE INTEGER,'
      '11075868=  ERR_MSG VARCHAR(1024))'
      '11075869=AS'
      '11075870=/*'
      
        '11075871='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053#1040#1051 +
        #1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065#1059#1070 +
        ' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '11075872=*/'
      '11075873=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '11075874=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11075875=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '11075876=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '11075877=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '11075878=DECLARE VARIABLE ACTION_DATE_ DATE;'
      '11075879=DECLARE VARIABLE ACTION_ TYPE OF COLUMN KASSA."ACTION";'
      
        '11075880=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11075881=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '11075882=BEGIN'
      '11075883=  PROCNAME = '#39'K_DEL_KASSA'#39';'
      '11075884='
      
        '11075885=  -----------------------------------------------------' +
        '-----------------'
      '11075886=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '11075887=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT_' +
        'TYPE_ = 1)) THEN BEGIN'
      '11075888=      SELECT K.SUMM,'
      '11075889=             K.ACTION_DATE,'
      '11075890=             K."ACTION",'
      '11075891=             K.G_TOCHKA'
      '11075892=        FROM KASSA K'
      '11075893=       WHERE K.KASSA = :KASSA_'
      '11075894=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA_;'
      '11075895='
      
        '11075896=      --***********************************************' +
        '**'
      '11075897=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '11075898=      --***********************************************' +
        '**'
      '11075899=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '11075900=      PNT_ = '#39'02'#39';'
      '11075901=      IF (:ACTION_ = 0) THEN'
      '11075902=        CREDIT_ = SUMM_;'
      '11075903=      ELSE'
      '11075904=        DEBET_ = SUMM_;'
      '11075905='
      '11075906=      UPDATE KASSA_STATE K'
      '11075907=         SET K.DEBET = K.DEBET - :DEBET_,'
      '11075908=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '11075909=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_) +' +
        ' (K.CREDIT - :CREDIT_)'
      '11075910=       WHERE K.K_DATE = :ACTION_DATE_'
      '11075911=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '11075912='
      
        '11075913=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '11075914=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTE' +
        'M_SETUP = 5) > 0) THEN BEGIN'
      '11075915=        SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '11075916=                     '#39'SET K.DEBET = K.DEBET - '#39'||COALES' +
        'CE(:DEBET_, 0)||'#39', '#39'||'
      
        '11075917=                          '#39'K.CREDIT = K.CREDIT - '#39'||COA' +
        'LESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '11075918=                          '#39'K.OUTPUT = K.INPUT - (K.DEBE' +
        'T - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CREDI' +
        'T_, 0)||'#39') '#39'||'
      
        '11075919=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DATE_' +
        '||'#39#39#39' '#39'||'
      
        '11075920=                     '#39'AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';' +
        #39';'
      
        '11075921=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '11075922=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11075923=      END'
      '11075924='
      
        '11075925=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '11075926=      PNT_ = '#39'04'#39';'
      
        '11075927=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_, :' +
        'G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '11075928=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075929=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11075930=        EXIT;'
      '11075931=      END'
      '11075932='
      '11075933=      DELETE FROM KASSA'
      '11075934=      WHERE KASSA = :KASSA_;'
      '11075935=  END'
      
        '11075936=  -----------------------------------------------------' +
        '-----------------'
      '11075937=  --*************************************************'
      
        '11075938=  -----------------------------------------------------' +
        '-----------------'
      
        '11075939=  -----------------------------------------------------' +
        '-----------------'
      '11075940=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '11075941=  ELSE BEGIN'
      '11075942=      SELECT K.SUMM,'
      '11075943=             K.ACTION_DATE,'
      '11075944=             K."ACTION",'
      '11075945=             K.G_TOCHKA'
      '11075946=        FROM KASSA_BEZNAL K'
      '11075947=       WHERE K.KASSA_BEZNAL = :KASSA_'
      '11075948=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA_;'
      '11075949='
      
        '11075950=      --***********************************************' +
        '**'
      '11075951=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '11075952=      --***********************************************' +
        '**'
      '11075953=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '11075954=      PNT_ = '#39'02'#39';'
      '11075955=      IF (:ACTION_ = 0) THEN'
      '11075956=        CREDIT_ = SUMM_;'
      '11075957=      ELSE'
      '11075958=        DEBET_ = SUMM_;'
      '11075959='
      '11075960=      UPDATE KASSA_BEZNAL_STATE K'
      '11075961=         SET K.DEBET = K.DEBET - :DEBET_,'
      '11075962=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '11075963=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_) +' +
        ' (K.CREDIT - :CREDIT_)'
      '11075964=       WHERE K.K_DATE = :ACTION_DATE_;'
      '11075965='
      
        '11075966=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '11075967=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTE' +
        'M_SETUP = 5) > 0) THEN BEGIN'
      '11075968=        SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      
        '11075969=                     '#39'SET K.DEBET = K.DEBET - '#39'||COALES' +
        'CE(:DEBET_, 0)||'#39', '#39'||'
      
        '11075970=                         '#39'K.CREDIT = K.CREDIT - '#39'||COAL' +
        'ESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '11075971=                         '#39'K.OUTPUT = K.INPUT - (K.DEBET' +
        ' - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CREDIT' +
        '_, 0)||'#39') '#39'||'
      
        '11075972=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DATE_' +
        '||'#39#39#39';'#39';'
      '11075973='
      
        '11075974=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '11075975=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11075976=      END'
      '11075977='
      
        '11075978=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '11075979=      PNT_ = '#39'04'#39';'
      
        '11075980=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION_D' +
        'ATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '11075981=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075982=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11075983=        EXIT;'
      '11075984=      END'
      '11075985='
      '11075986=      DELETE FROM KASSA_BEZNAL'
      '11075987=      WHERE KASSA_BEZNAL = :KASSA_;'
      '11075988=  END'
      
        '11075989=  -----------------------------------------------------' +
        '-----------------'
      '11075990=  --*************************************************'
      '11075991='
      '11075992=when sqlcode -530 DO'
      '11075993=  begin'
      '11075994=    ERR_CODE = -20500;'
      
        '11075995=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' '#1089 +
        #1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11075996=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11075997=  end'
      '11075998=end'
      '11075999=;'
      '110751000='
      '110751001=ALTER PROCEDURE K_INS_KASSA('
      '110751002=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '110751003=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASHO' +
        'D,'
      '110751004=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '110751005=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110751006=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '110751007=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '110751008=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '110751009=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110751010=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110751011=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL)'
      '110751012=RETURNS ('
      '110751013=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '110751014=  ERR_CODE INTEGER,'
      '110751015=  ERR_MSG VARCHAR(1024))'
      '110751016=AS'
      '110751017=/*'
      
        '110751018='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053#1040 +
        #1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065#1059 +
        #1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '110751019=*/'
      '110751020=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '110751021=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110751022=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '110751023=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '110751024=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '110751025=begin'
      '110751026=  PROCNAME = '#39'K_INS_KASSA'#39';'
      '110751027='
      '110751028=  IF (G_TOCHKA_ IS NULL) THEN'
      '110751029=    SELECT ID'
      '110751030=      FROM CUR_PARAMS'
      '110751031=     WHERE CUR_PARAMS = 2'
      '110751032=      INTO :G_TOCHKA_;'
      '110751033='
      
        '110751034=  ----------------------------------------------------' +
        '------------------'
      '110751035=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '110751036=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMENT' +
        '_TYPE_ = 1)) THEN BEGIN'
      
        '110751037=      insert into KASSA (KASSA, "ACTION", G_PRIHOD_RAS' +
        'HOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, G_OFFICIAL' +
        ')'
      
        '110751038=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIHO' +
        'D_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_T' +
        'OCHKA_, :G_OFFICIAL_)'
      '110751039=      returning KASSA'
      '110751040=      into :KASSA_;'
      '110751041='
      '110751042=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '110751043=      PNT_ = '#39'02'#39';'
      '110751044=      IF (:ACTION_ = 0) THEN'
      '110751045=        CREDIT_ = SUMM_;'
      '110751046=      ELSE'
      '110751047=        DEBET_ = SUMM_;'
      '110751048='
      
        '110751049=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DATE' +
        '_, :G_TOCHKA_, :DEBET_, :CREDIT_, 1) RETURNING_VALUES (:ERR_CODE' +
        ', :ERR_MSG);'
      '110751050=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110751051=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110751052=        EXIT;'
      '110751053=      END'
      '110751054='
      
        '110751055=      ------------------------------------------------' +
        '----------------------'
      
        '110751056=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110751057=      PNT_ = '#39'04'#39';'
      
        '110751058=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_, ' +
        ':G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110751059=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110751060=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110751061=        EXIT;'
      '110751062=      END'
      '110751063=  END'
      
        '110751064=  ----------------------------------------------------' +
        '------------------'
      
        '110751065=  ----------------------------------------------------' +
        '------------------'
      '110751066=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '110751067=  ---------- '#1042' KASSA_BEZNAL_STATE '#1053#1045' '#1044#1045#1051#1040#1070' '#1056#1040#1047#1044#1045#1051#1045#1053#1048#1045' ' +
        #1055#1054' '#1057#1050#1051#1040#1044#1040#1052', '#1042#1045#1044#1068' '#1056#1040#1057#1063#1045#1058#1053#1067#1049' '#1057#1063#1045#1058' '#1054#1041#1065#1048#1049
      '110751068=  ELSE BEGIN'
      
        '110751069=      insert into KASSA_BEZNAL (KASSA_BEZNAL, "ACTION"' +
        ', G_PRIHOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCH' +
        'KA, G_OFFICIAL)'
      
        '110751070=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIHO' +
        'D_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_T' +
        'OCHKA_, :G_OFFICIAL_)'
      '110751071=      returning KASSA_BEZNAL'
      '110751072=      into :KASSA_;'
      '110751073='
      '110751074=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '110751075=      PNT_ = '#39'02A'#39';'
      '110751076=      IF (:ACTION_ = 0) THEN'
      '110751077=        CREDIT_ = SUMM_;'
      '110751078=      ELSE'
      '110751079=        DEBET_ = SUMM_;'
      '110751080='
      
        '110751081=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DATE' +
        '_, :G_TOCHKA_, :DEBET_, :CREDIT_, 0) RETURNING_VALUES (:ERR_CODE' +
        ', :ERR_MSG);'
      '110751082=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110751083=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110751084=        EXIT;'
      '110751085=      END'
      '110751086='
      
        '110751087=      ------------------------------------------------' +
        '----------------------'
      
        '110751088=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110751089=      PNT_ = '#39'04A'#39';'
      
        '110751090=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION_' +
        'DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '110751091=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110751092=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110751093=        EXIT;'
      '110751094=      END'
      '110751095=  END'
      
        '110751096=  ----------------------------------------------------' +
        '------------------'
      
        '110751097=  ----------------------------------------------------' +
        '------------------'
      '110751098=end'
      '110751099=;'
      '110751100='
      '110751101=ALTER PROCEDURE K_RECALC_KASSA('
      '110751102=  ACTION_DATE_ DATE,'
      '110751103=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110751104=RETURNS ('
      '110751105=  ERR_CODE INTEGER,'
      '110751106=  ERR_MSG VARCHAR(1024))'
      '110751107=AS'
      
        '110751108=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASS' +
        'A'#39';'
      '110751109=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110751110=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '110751111=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_STATE.K_' +
        'DATE;'
      '110751112=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '110751113=begin'
      '110751114='
      '110751115=  IF (G_TOCHKA_ IS NULL) THEN'
      '110751116=    SELECT ID'
      '110751117=      FROM CUR_PARAMS'
      '110751118=     WHERE CUR_PARAMS = 2'
      '110751119=      INTO :G_TOCHKA_;'
      '110751120='
      
        '110751121=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047 +
        #1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043 +
        #1054#1044#1053#1071' 21.02.'
      
        '110751122=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057 +
        #1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      
        '110751123=  -- '#1052#1054#1046#1053#1054' '#1042#1045#1047#1044#1045' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' 0, '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1044#1040#1051#1068#1064#1045' '#1054#1053#1054' '#1041#1059#1044 +
        #1045#1058' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1053#1054
      '110751124=  PNT_ = '#39'00'#39';'
      
        '110751125=  IF ((SELECT COUNT(*) FROM KASSA_STATE K WHERE K.K_DA' +
        'TE = CURRENT_DATE AND G_TOCHKA = :G_TOCHKA_) = 0) THEN BEGIN'
      '110751126=    INSERT INTO KASSA_STATE'
      
        '110751127=      (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, OUTP' +
        'UT, G_TOCHKA)'
      '110751128=    VALUES'
      
        '110751129=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0, 0,' +
        ' 0, 0, :G_TOCHKA_);'
      '110751130='
      
        '110751131=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751132=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM' +
        '_SETUP = 5) > 0) THEN BEGIN'
      '110751133=      SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110751134=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DATE' +
        '||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '110751135=                 '#39' from RDB$DATABASE) cd '#39'||'
      
        '110751136=                 '#39'ON (c.K_DATE = cd.K_DATE AND C.G_TOC' +
        'HKA = CD.G_TOCHKA) '#39'||'
      '110751137=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110751138=                 '#39' INSERT (KASSA_STATE, K_DATE, "INPUT' +
        '", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '110751139=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, ' +
        '0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0, '#39'||G_TOCHKA_||'#39');'#39';'
      
        '110751140=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110751141=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751142=    END'
      '110751143=  END'
      '110751144='
      
        '110751145=  ----------------------------------------------------' +
        '------------------'
      
        '110751146=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056 +
        #1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110751147=  PNT_ = '#39'01'#39';'
      '110751148=  SELECT K.OUTPUT'
      '110751149=    FROM KASSA_STATE K'
      '110751150=   WHERE K.K_DATE = :ACTION_DATE_'
      '110751151=     AND K.G_TOCHKA = :G_TOCHKA_'
      '110751152=    INTO :OUTPUT_;'
      '110751153='
      '110751154=  PNT_ = '#39'02'#39';'
      '110751155=  FOR SELECT K.K_DATE'
      '110751156=        FROM KASSA_STATE K'
      '110751157=       WHERE K.K_DATE > :ACTION_DATE_'
      '110751158=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110751159=      ORDER BY K.K_DATE, K.KASSA_STATE'
      '110751160=        INTO :K_DATE_'
      '110751161=  DO BEGIN'
      '110751162=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110751163=    UPDATE KASSA_STATE K'
      '110751164=       SET K.INPUT = :OUTPUT_,'
      
        '110751165=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE' +
        '(K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '110751166=     WHERE K.K_DATE = :K_DATE_'
      '110751167=       AND K.G_TOCHKA = :G_TOCHKA_;'
      '110751168='
      
        '110751169=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751170=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM' +
        '_SETUP = 5) > 0) THEN BEGIN'
      '110751171=      SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      '110751172=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '110751173=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, ' +
        '0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '110751174=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39#39 +
        '||'
      
        '110751175=                 '#39'  AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';'#39 +
        ';'
      
        '110751176=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110751177=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751178=    END'
      '110751179='
      '110751180=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110751181=    SELECT K.OUTPUT'
      '110751182=      FROM KASSA_STATE K'
      '110751183=     WHERE K.K_DATE = :K_DATE_'
      '110751184=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110751185=      INTO :OUTPUT_;'
      '110751186=  END'
      '110751187='
      '110751188=WHEN ANY DO BEGIN'
      '110751189=    Err_code = -20500;'
      
        '110751190=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110751191=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110751192=  END'
      '110751193=end'
      '110751194=;'
      '110751195='
      '110751196=ALTER PROCEDURE K_RECALC_KASSA_BEZNAL('
      '110751197=  ACTION_DATE_ DATE)'
      '110751198=RETURNS ('
      '110751199=  ERR_CODE INTEGER,'
      '110751200=  ERR_MSG VARCHAR(1024))'
      '110751201=AS'
      
        '110751202=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASS' +
        'A_BEZNAL'#39';'
      '110751203=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110751204=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '110751205=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_BEZNAL_S' +
        'TATE.K_DATE;'
      '110751206=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '110751207=BEGIN'
      '110751208='
      
        '110751209=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047 +
        #1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043 +
        #1054#1044#1053#1071' 21.02.'
      
        '110751210=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057 +
        #1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      
        '110751211=  -- '#1052#1054#1046#1053#1054' '#1042#1045#1047#1044#1045' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' 0, '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1044#1040#1051#1068#1064#1045' '#1054#1053#1054' '#1041#1059#1044 +
        #1045#1058' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1053#1054
      '110751212=  PNT_ = '#39'00'#39';'
      
        '110751213=  IF ((SELECT COUNT(*) FROM KASSA_BEZNAL_STATE K WHERE' +
        ' K.K_DATE = CURRENT_DATE) = 0) THEN BEGIN'
      '110751214=    INSERT INTO KASSA_BEZNAL_STATE'
      
        '110751215=      (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CREDI' +
        'T, OUTPUT)'
      '110751216=    VALUES'
      
        '110751217=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0, 0,' +
        ' 0, 0);'
      '110751218='
      
        '110751219=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751220=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM' +
        '_SETUP = 5) > 0) THEN BEGIN'
      '110751221=      SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE c '#39'||'
      
        '110751222=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DATE' +
        '||'#39#39#39' AS DATE) as K_DATE '#39'||'
      '110751223=                 '#39' from RDB$DATABASE) cd '#39'||'
      '110751224=                 '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '110751225=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110751226=                 '#39' INSERT (KASSA_BEZNAL_STATE, K_DATE,' +
        ' "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
        '110751227=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, ' +
        '0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0);'#39';'
      
        '110751228=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110751229=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751230=    END'
      '110751231=  END'
      '110751232='
      
        '110751233=  ----------------------------------------------------' +
        '------------------'
      
        '110751234=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056 +
        #1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '110751235=  PNT_ = '#39'01'#39';'
      '110751236=  SELECT K.OUTPUT'
      '110751237=    FROM KASSA_BEZNAL_STATE K'
      '110751238=   WHERE K.K_DATE = :ACTION_DATE_'
      '110751239=    INTO :OUTPUT_;'
      '110751240='
      '110751241=  PNT_ = '#39'02'#39';'
      '110751242=  FOR SELECT K.K_DATE'
      '110751243=        FROM KASSA_BEZNAL_STATE K'
      '110751244=       WHERE K.K_DATE > :ACTION_DATE_'
      '110751245=      ORDER BY K.K_DATE, K.KASSA_BEZNAL_STATE'
      '110751246=        INTO :K_DATE_'
      '110751247=  DO BEGIN'
      '110751248=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110751249=    UPDATE KASSA_BEZNAL_STATE K'
      '110751250=       SET K.INPUT = :OUTPUT_,'
      
        '110751251=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE' +
        '(K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '110751252=     WHERE K.K_DATE = :K_DATE_;'
      '110751253='
      
        '110751254=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751255=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM' +
        '_SETUP = 5) > 0) THEN BEGIN'
      '110751256=      SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      '110751257=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '110751258=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, ' +
        '0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '110751259=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39';' +
        #39';'
      
        '110751260=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110751261=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751262=    END'
      '110751263='
      '110751264=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110751265=    SELECT K.OUTPUT'
      '110751266=      FROM KASSA_BEZNAL_STATE K'
      '110751267=     WHERE K.K_DATE = :K_DATE_'
      '110751268=      INTO :OUTPUT_;'
      '110751269=  END'
      '110751270='
      '110751271=WHEN ANY DO BEGIN'
      '110751272=    Err_code = -20500;'
      
        '110751273=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110751274=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110751275=  END'
      '110751276=end'
      '110751277=;'
      '110751278='
      '110751279=ALTER PROCEDURE K_UPD_KASSA_STATE('
      '110751280=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '110751281=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110751282=  DEBET_ MY_NUMERIC,'
      '110751283=  CREDIT_ MY_NUMERIC,'
      '110751284=  NAL_BEZNAL_ INTEGER)'
      '110751285=RETURNS ('
      '110751286=  ERR_CODE INTEGER,'
      '110751287=  ERR_MSG VARCHAR(1024))'
      '110751288=AS'
      
        '110751289=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_UPD_KASSA_S' +
        'TATE'#39';'
      '110751290=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110751291=DECLARE VARIABLE INPUT_ MY_NUMERIC = 0;'
      '110751292=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '110751293=BEGIN'
      '110751294='
      '110751295=  PNT_ = '#39'01'#39';'
      '110751296=  -- '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067
      '110751297=  IF (NAL_BEZNAL_ = 1) THEN BEGIN'
      '110751298=      UPDATE KASSA_STATE K'
      
        '110751299=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE' +
        '(:DEBET_, 0),'
      
        '110751300=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALES' +
        'CE(:CREDIT_, 0),'
      
        '110751301=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALES' +
        'CE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) ' +
        '+ COALESCE(:CREDIT_, 0))'
      '110751302=       WHERE K.K_DATE = :ACTION_DATE_'
      '110751303=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '110751304='
      '110751305='
      
        '110751306=      IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053 +
        #1071' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '110751307=        -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '110751308=        PNT_ = '#39'02'#39';'
      '110751309=        BEGIN'
      '110751310=            SELECT K.OUTPUT'
      '110751311=              FROM KASSA_STATE K'
      '110751312=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '110751313=                                 FROM KASSA_STATE S'
      
        '110751314=                                WHERE S.K_DATE < :ACTI' +
        'ON_DATE_'
      
        '110751315=                                  AND S.G_TOCHKA = :G_' +
        'TOCHKA_)'
      '110751316=               AND K.G_TOCHKA = :G_TOCHKA_'
      '110751317=            INTO :INPUT_;'
      '110751318='
      '110751319=            if (ROW_COUNT = 0) then'
      
        '110751320=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055 +
        #1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '110751321=        WHEN ANY DO'
      '110751322=          BEGIN'
      '110751323=            Err_Code = -20500;'
      
        '110751324=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054 +
        #1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      
        '110751325=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110751326=            EXIT;'
      '110751327=          END'
      '110751328=        END'
      '110751329='
      '110751330=        PNT_ = '#39'03'#39';'
      '110751331=        INSERT INTO KASSA_STATE'
      
        '110751332=          (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, ' +
        'OUTPUT, G_TOCHKA)'
      '110751333=        VALUES'
      
        '110751334=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, ' +
        'COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0' +
        '), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDI' +
        'T_,0), :G_TOCHKA_);'
      '110751335='
      
        '110751336=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048 +
        #1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751337=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
        'STEM_SETUP = 5) > 0) THEN BEGIN'
      '110751338=            SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110751339=                       '#39'USING (select CAST('#39#39#39'||ACTION' +
        '_DATE_||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '110751340=                       '#39' from RDB$DATABASE) cd '#39'||'
      
        '110751341=                       '#39'ON (c.K_DATE = cd.K_DATE AND C' +
        '.G_TOCHKA = CD.G_TOCHKA) '#39'||'
      '110751342=                       '#39'WHEN MATCHED THEN '#39'||'
      '110751343=                       '#39' UPDATE SET '#39'||'
      
        '110751344=                       '#39'  C.INPUT  = COALESCE((SELECT ' +
        '"OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110751345=                                                      ' +
        '                                          '#39' FROM KASSA_STATE '#39'||'
      
        '110751346=                                                      ' +
        '                                          '#39' WHERE K_DATE < CD.K_' +
        'DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751347=                                                      ' +
        '                                          '#39' AND G_TOCHKA = CD.G_' +
        'TOCHKA), 0), '#39'||'
      
        '110751348=                       '#39'  C.DEBET  = C.DEBET + '#39'||DEBE' +
        'T_||'#39', '#39'||'
      
        '110751349=                       '#39'  C.CREDIT = C.CREDIT + '#39'||CRE' +
        'DIT_||'#39', '#39'||'
      
        '110751350=                       '#39'  C.OUTPUT = COALESCE((SELECT ' +
        '"OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110751351=                                                      ' +
        '                                          '#39' FROM KASSA_STATE '#39'||'
      
        '110751352=                                                      ' +
        '                                          '#39' WHERE K_DATE < CD.K_' +
        'DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751353=                                                      ' +
        '                                          '#39' AND G_TOCHKA = CD.G_' +
        'TOCHKA), 0) - (C.DEBET + '#39'||DEBET_||'#39') + (C.CREDIT + '#39'||CREDIT_|' +
        '|'#39') '#39'||'
      '110751354=                       '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110751355=                       '#39' INSERT (KASSA_STATE, K_DATE, ' +
        '"INPUT", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '110751356=                       '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_S' +
        'TATE, 0)||'#39', '#39#39#39'||ACTION_DATE_||'#39#39#39', COALESCE((SELECT "OUTPUT" F' +
        'ROM KASSA_STATE WHERE '#39'||'
      
        '110751357=                            '#39'K_DATE = (SELECT MAX(K_DA' +
        'TE) '#39'||'
      '110751358=                            '#39' FROM KASSA_STATE '#39'||'
      
        '110751359=                            '#39' WHERE K_DATE < CD.K_DATE' +
        ' AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751360=                            '#39' AND G_TOCHKA = CD.G_TOCH' +
        'KA), 0), '#39'||DEBET_||'#39', '#39'||CREDIT_||'#39', COALESCE((SELECT "OUTPUT" ' +
        'FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110751361=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110751362=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751363=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0) - '#39'||DEBET_||'#39' + '#39'||CREDIT_||'#39', '#39'||G_TOCHKA_||'#39')' +
        ';'#39';'
      
        '110751364=            INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRA' +
        'NSFERED, SYSDATE, ERR_CODE)'
      
        '110751365=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39 +
        'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751366=        END'
      '110751367=      END'
      '110751368=      ELSE BEGIN'
      
        '110751369=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048 +
        #1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751370=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
        'STEM_SETUP = 5) > 0) THEN BEGIN'
      '110751371=            SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '110751372=                         '#39'SET K.DEBET = COALESCE(K.DEB' +
        'ET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '110751373=                            '#39'K.CREDIT = COALESCE(K.CRE' +
        'DIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '110751374=                            '#39'K.OUTPUT = COALESCE(K.INP' +
        'UT, 0) - (COALESCE(K.DEBET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39') + (' +
        'COALESCE(K.CREDIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39') '#39'||'
      
        '110751375=                       '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_' +
        'DATE_||'#39#39#39' '#39'||'
      
        '110751376=                         '#39'AND K.G_TOCHKA = '#39'||G_TOCHKA' +
