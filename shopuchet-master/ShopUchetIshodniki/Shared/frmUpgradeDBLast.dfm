        'L_ + SUMM_UHOD_SKL_;'
      '1101322296='
      '1101322297=            AMOUNT_PRIHOD_  = 0;'
      '1101322298=            SUMM_PRIHOD_    = 0;'
      '1101322299=            AMOUNT_UHOD_    = 0;'
      '1101322300=            SUMM_UHOD_      = 0;'
      '1101322301=            AMOUNT_SPISANO_ = 0;'
      '1101322302=            SUMM_SPISANO_   = 0;'
      '1101322303=            AMOUNT_VOZVRAT_ = 0;'
      '1101322304=            SUMM_VOZVRAT_   = 0;'
