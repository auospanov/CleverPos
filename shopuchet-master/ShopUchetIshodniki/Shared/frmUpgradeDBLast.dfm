      '1104071=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ INTEGER,'
      
        '1104072=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ' */ INTEGER,'
