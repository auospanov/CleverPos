        ';'
      '1101625519=                    END'
      '1101625520=                END'
      '1101625521=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625522=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101625523=                  EXIT;'
      '1101625524=                END'
      '1101625525='
      
        '1101625526=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101625527=            END'
      '1101625528='
      
        '1101625529=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101625530=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101625531=                FROM KASSA K'
      '1101625532=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101625533=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
      '1101625534=                UNION'
      '1101625535=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1101625536=                  FROM KASSA K'
      '1101625537=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1101625538=                   AND K.SUMM = 0'
      '1101625539=                UNION'
      
        '1101625540=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101625541=                FROM KASSA_BEZNAL K'
      '1101625542=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101625543=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA_BEZNAL||'#39'~'#39
      '1101625544=                UNION'
      
        '1101625545=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101625546=                FROM KASSA_BEZNAL K'
      '1101625547=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101625548=                 AND K.SUMM = 0'
      '1101625549=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101625550=            DO BEGIN'
      '1101625551=                PNT_ = '#39'08'#39';'
      
        '1101625552=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_' +
        ', :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101625553=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625554=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '1101625555=                    EXIT;'
      '1101625556=                END'
      '1101625557=            END'
      '1101625558='
      
        '1101625559=            --=======================================' +
        '=========================='
      '1101625560=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101625561=            --=======================================' +
        '=========================='
      
        '1101625562=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057 +
        #1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101625563=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040 +
        #1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '1101625564=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055 +
        #1054' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1101625565=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101625566=                SELECT K.KASSA'
      '1101625567=                FROM KASSA K'
      '1101625568=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101625569=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101625570=                 INTO :KASSA_POP_;'
      '1101625571=            ELSE'
      '1101625572=                SELECT K.KASSA_BEZNAL'
      '1101625573=                FROM KASSA_BEZNAL K'
      '1101625574=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101625575=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101625576=                 INTO :KASSA_POP_;'
      '1101625577='
      
        '1101625578=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101625579=              PNT_ = '#39'09'#39';'
      
        '1101625580=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' ' +
        #1054#1053#1040' '#1045#1057#1058#1068
      '1101625581=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '1101625582=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_POP_,'
      
        '1101625583=                                                  0, ' +
        '    -- ACTION_'
      
        '1101625584=                                                  :G_' +
        'PRIHOD_,'
      
        '1101625585=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101625586=                                                  :Z_' +
        'DATE_,'
      
        '1101625587=                                                  NUL' +
        'L,   --NOTE_'
      
        '1101625588=                                                  :ZA' +
        'KAZ_,'
      
        '1101625589=                                                  NUL' +
        'L,'
      
        '1101625590=                                                  :G_' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101625591=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101625592=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '1101625593=                    PNT_ = '#39'10'#39';'
      
        '1101625594=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101625595=                                                  :G_' +
        'PRIHOD_,'
      
        '1101625596=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101625597=                                                  :Z_' +
        'DATE_,'
      
        '1101625598=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101625599=                                                  :ZA' +
        'KAZ_,'
      
        '1101625600=                                                  NUL' +
        'L,'
      
        '1101625601=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1101625602=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101625603=              END'
      '1101625604='
      
        '1101625605=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101625606=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101625607=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101625608=                PNT_ = '#39'11'#39';'
      '1101625609=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101625610=                    EXECUTE PROCEDURE K_DEL_KASSA(:KA' +
        'SSA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1101625611=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625612=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101625613=                      EXIT;'
      '1101625614=                    END'
      '1101625615='
      
        '1101625616=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101625617=                                                  :G_' +
        'PRIHOD_,'
      
        '1101625618=                                                  :SU' +
        'MM_PRIHOD_,'
      
