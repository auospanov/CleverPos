      '1101825614=                      EXIT;'
      '1101825615=                    END'
      '1101825616=                END'
      '1101825617=            END'
      
        '1101825618=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      
        '1101825619=            --=======================================' +
        '=========================='
      '1101825620='
      
        '1101825621=            --=======================================' +
        '=========================='
      '1101825622=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101825623=            --=======================================' +
        '=========================='
      '1101825624=            PNT_ = '#39'12'#39';'
      
        '1101825625=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1101825626=                KASSA_ZP_ID_ = NULL;'
      '1101825627='
      '1101825628=                SELECT S.S_VALUE'
      '1101825629=                  FROM SYSTEM_SETUP S'
      '1101825630=                 WHERE S.SYSTEM_SETUP = 4'
      '1101825631=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101825632='
      '1101825633=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101825634=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101825635=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101825636='
      
        '1101825637=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101825638=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1101825639=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1101825640='
      '1101825641=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101825642=                ELSE'
      
        '1101825643=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1101825644='
      '1101825645=                SELECT K.KASSA, K.SUMM'
      '1101825646=                FROM KASSA K'
      '1101825647=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1101825648=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101825649=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101825650=                 AND K.G_TOCHKA = :G_TOCHKA_'
      
        '1101825651=                 INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM' +
        '_ITER_;'
      '1101825652='
      
        '1101825653=                LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090 +
        ' "'#39' || EXTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month' +
        ' FROM ACTION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_' +
        ') || '#39'"'#39';'
      '1101825654='
      '1101825655=                IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1101825656=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101825657=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101825658=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101825659=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101825660=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1101825661=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1101825662=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1101825663=                                                  1,'
      
        '1101825664=                                                  :G_' +
        'TOCHKA_,'
      
        '1101825665=                                                  :G_' +
        'OFFICIAL_) RETURNING_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG)' +
        ';'
      '1101825666=                    LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101825667=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES' +
        '_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101825668='
      '1101825669=                END ELSE BEGIN'
      
        '1101825670=                    SALES_COMM_SUMM_ALL_ = SALES_COMM' +
        '_SUMM_ITER_ + SALES_COMM_SUMM_ALL_ - SALES_COMM_OLD_;'
      '1101825671=                    LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101825672=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' ' +
        '"'#39' || SALES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101825673=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39' '#1085#1072' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101825674='
      
        '1101825675=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_ZP_ID_,'
      
        '1101825676=                                                  1, ' +
        '    -- ACTION_'
      
        '1101825677=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101825678=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101825679=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101825680=                                                  :OF' +
        'FICIAL_NAME_,   --NOTE_'
      
        '1101825681=                                                  NUL' +
        'L,'
      
        '1101825682=                                                  NUL' +
        'L,'
      
        '1101825683=                                                  1, ' +
        '  --:PAYMENT_TYPE_,'
      
        '1101825684=                                                  :G_' +
        'OFFICIAL_'
      
        '1101825685=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101825686=                END'
      '1101825687=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825688=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101825689=                  EXIT;'
      '1101825690=                END'
      '1101825691=            END'
      
        '1101825692=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1101825693=            --=======================================' +
        '=========================='
      '1101825694='
      '1101825695=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1101825696='
      '1101825697=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101825698=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101825699=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101825700=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 2'
      '1101825701=          FROM RDB$DATABASE'
      
        '1101825702=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP' +
        ' AP WHERE AP.OBJECT_TYPE = 1 AND AP.ID = :ZAKAZ_ AND AP.IS_LOADI' +
        'NG = 0);'
      '1101825703=  END'
      '1101825704=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1101825705=  ---------------------------------------------------' +
        '------------'
      
        '1101825706=  --*************************************************' +
        '************'
      
        '1101825707=  ---------------------------------------------------' +
        '------------'
      '1101825708=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101825709=  ELSE BEGIN'
      '1101825710=      PNT_ = '#39'020'#39';'
      '1101825711=      SELECT SP.G_TOCHKA,'
      '1101825712=             SP.G_CLIENT,'
      '1101825713=             SP.IS_EXPECTED'
      '1101825714=        FROM SKLAD_PARENT SP'
      '1101825715=       WHERE SP.SKLAD = :ZAKAZ_'
      '1101825716=        INTO :G_TOCHKA_OLD_,'
      '1101825717=             :G_TOCHKA_,'
      '1101825718=             :IS_EXPECTED_OLD_;'
      '1101825719='
      
        '1101825720=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101825721=      PNT_ = '#39'021'#39';'
      '1101825722=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '1101825723=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' NULL, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '1101825724=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825725=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101825726=            EXIT;'
      '1101825727=          END'
      '1101825728='
      '1101825729=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101825730=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101825731=                FROM ZAKAZ_DETAILS_TMP Z'
      '1101825732=              INTO :G_PRODUCT_,'
      '1101825733=                  :Z_AMOUNT_,'
      '1101825734=                  :PRICE_,'
      '1101825735=                  :SUMMM_'
      '1101825736=          DO BEGIN'
      '1101825737=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101825738=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1101825739=            IS_THIS_LAST_ = 0;'
      '1101825740=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101825741=                FROM SKLAD SK'
      '1101825742=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101825743=                 AND SK.IS_LAST = 1'
      '1101825744=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1101825745=                INTO :DATE_LAST_;'
      '1101825746='
      
        '1101825747=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101825748=                UPDATE SKLAD SK'
      '1101825749=                   SET SK.IS_LAST = 0'
      '1101825750=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101825751=                   AND SK.IS_LAST = 1'
      '1101825752=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101825753='
      '1101825754=                IS_THIS_LAST_ = 1;'
      '1101825755=            END'
      '1101825756='
      '1101825757='
      '1101825758=            INSERT INTO SKLAD'
      '1101825759=            ('
      '1101825760=             SKLAD,'
      '1101825761=             SKLAD_PARENT,'
      '1101825762=             DATE_RECEIPT,'
      '1101825763=             G_CLIENT,'
      '1101825764=             G_PRODUCT,'
      '1101825765=             AMOUNT,'
      '1101825766=             PRICE,'
      '1101825767=             SUMM,'
      '1101825768=             G_PAYMENT_TYPE,'
      '1101825769=             OSNOVANIE,'
      '1101825770=             NOTE,'
      '1101825771=             NDS,'
      '1101825772=             NDS_SUMM,'
      '1101825773=             IS_LAST,'
      '1101825774=             IS_VOZVRAT,'
      '1101825775=             G_TOCHKA'
      '1101825776=            ) VALUES ('
      '1101825777=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101825778=             :ZAKAZ_,'
      '1101825779=             :Z_DATE_,'
      '1101825780=             :G_TOCHKA_,'
      '1101825781=             :G_PRODUCT_,'
      '1101825782=             :Z_AMOUNT_,'
      '1101825783=             :PRICE_,'
      '1101825784=             :SUMMM_,'
      '1101825785=             :G_PAYMENT_TYPE_,'
      '1101825786=             :OSNOVANIE_,'
      '1101825787=             :NOTE_,'
      '1101825788=             0,  --:RNDS_,'
      '1101825789=             0,  --:RNDS_SUMM_,'
      
        '1101825790=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1101825791=             3,  --:IS_VOZVRAT_,'
      '1101825792=             :G_CLIENT_'
      '1101825793=            );'
      '1101825794='
      
        '1101825795=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1101825796=            UPDATE LT_SKLAD_PRODUCT L'
      '1101825797=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_,'
      
        '1101825798=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101825799=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101825800=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101825801='
      
        '1101825802=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101825803=            PNT_ = '#39'023'#39';'
      '1101825804=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101825805=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101825806=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_,'
      
        '1101825807=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1101825808=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101825809=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1101825810='
      '1101825811=                IF (ROW_COUNT = 0) THEN'
      
        '1101825812=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101825813=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1101825814=            END'
      '1101825815=          END'
      '1101825816=      END'
      '1101825817=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1101825818=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1101825819=      ELSE BEGIN'
      
        '1101825820=          -------------------------------------------' +
        '------------------'
      
        '1101825821=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1101825822=          PNT_ = '#39'025'#39';'
      '1101825823=          FOR SELECT SKLAD,'
      '1101825824=                     AMOUNT,'
      '1101825825=                     G_PRODUCT'
      '1101825826=                FROM SKLAD S'
      '1101825827=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1101825828=                 AND NOT EXISTS (SELECT 1'
      
        '1101825829=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1101825830=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1101825831=          INTO :SKLAD_,'
      '1101825832=               :Z_AMOUNT_,'
      '1101825833=               :G_PRODUCT_'
      '1101825834=          DO BEGIN'
      
        '1101825835=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :E' +
        'RR_MSG);'
      '1101825836=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825837=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101825838=              EXIT;'
      '1101825839=            END'
      '1101825840=          END'
      '1101825841='
      '1101825842=          PNT_ = '#39'030'#39';'
      '1101825843=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1101825844=                     S.G_PRODUCT,'
      '1101825845=                     S.AMOUNT,'
      '1101825846=                     S.PRICE,'
      '1101825847=                     S.SUMM,'
      '1101825848=                     T.SKLAD,'
      '1101825849=                     T.AMOUNT,'
      '1101825850=                     T.IS_LAST,'
      '1101825851=                     T.DATE_RECEIPT'
      
        '1101825852=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1101825853=                INTO :ZAKAZ_DETAILS_,'
      '1101825854=                     :G_PRODUCT_,'
      '1101825855=                     :Z_AMOUNT_,'
      '1101825856=                     :PRICE_,'
      '1101825857=                     :SUMMM_,'
      '1101825858=                     :SKLAD_OLD_,'
      '1101825859=                     :AMOUNT_OLD_,'
      '1101825860=                     :IS_THIS_LAST_,'
      '1101825861=                     :DATE_RECEIPT_OLD_'
      '1101825862=          DO BEGIN'
      
        '1101825863=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101825864=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1101825865=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1101825866=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1101825867=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
