        '1102282575=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1102282576=                                                    :' +
        'PAYMENT_TYPE_,'
      
        '1102282577=                                                    :' +
        'UPLOAD_TO_EXT_APP_'
      
        '1102282578=                                                    )' +
        ' RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102282579='
      
        '1102282580=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102282581=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102282582=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1102282583=                      PNT_ = '#39'011'#39';'
      
        '1102282584=                      EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUE' +
        'S (:ERR_CODE, :ERR_MSG);'
      '1102282585=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102282586=                        ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1102282587=                        EXIT;'
      '1102282588=                      END'
      '1102282589='
      
        '1102282590=                      EXECUTE PROCEDURE K_INS_KASSA(1' +
        ',     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102282591=                                                    :' +
        'G_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1102282592=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1102282593=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1102282594=                                                    N' +
        'ULL,   --NOTE_ => :NOTE_,'
      
        '1102282595=                                                    N' +
        'ULL,   --ZAKAZ_'
      
        '1102282596=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1102282597=                                                    :' +
        'PAYMENT_TYPE_,'
      
        '1102282598=                                                    :' +
        'G_TOCHKA_,'
      
        '1102282599=                                                    :' +
        'UPLOAD_TO_EXT_APP_'
      
        '1102282600=                                                    )' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102282601=                END'
      '1102282602=            END'
      '1102282603=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102282604=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102282605=              EXIT;'
      '1102282606=            END'
      '1102282607='
      
        '1102282608=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1102282609=      END'
      '1102282610='
      
        '1102282611=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1102282612=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1102282613=            FROM KASSA K'
      '1102282614=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102282615=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1102282616=           UNION'
      '1102282617=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1102282618=            FROM KASSA K'
      '1102282619=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102282620=             AND K.SUMM = 0'
      '1102282621=          UNION'
      '1102282622=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102282623=            FROM KASSA_BEZNAL K'
      '1102282624=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102282625=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1102282626=          UNION'
      '1102282627=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102282628=            FROM KASSA_BEZNAL K'
      '1102282629=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102282630=             AND K.SUMM = 0'
      '1102282631=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1102282632=      DO BEGIN'
      '1102282633=        PNT_ = '#39'011A'#39';'
      
        '1102282634=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, ' +
        ':ERR_MSG);'
      '1102282635=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102282636=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102282637=          EXIT;'
      '1102282638=        END'
      '1102282639=      END'
      '1102282640=  END'
      '1102282641='
      
        '1102282642=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1102282643=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1102282644=    SELECT K.KASSA'
      '1102282645=      FROM KASSA K'
      '1102282646=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102282647=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102282648=      INTO :KASSA_POP_;'
      '1102282649=  ELSE'
      '1102282650=    SELECT K.KASSA_BEZNAL'
      '1102282651=      FROM KASSA_BEZNAL K'
      '1102282652=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102282653=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102282654=       INTO :KASSA_POP_;'
      '1102282655='
      
        '1102282656=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1102282657=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1102282658=      PNT_ = '#39'012'#39';'
      '1102282659=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1102282660=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1102282661=                                          1,     -- A' +
        'CTION_'
      '1102282662=                                          :G_PRIHOD_,'
      
