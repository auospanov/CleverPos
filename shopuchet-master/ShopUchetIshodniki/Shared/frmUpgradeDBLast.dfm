        '110606317=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_ADDRESS.G_ADDRESS_T' +
        'YPE,'
      '110606318=  G_CLIENT_ TYPE OF COLUMN G_ADDRESS.G_CLIENT,'
      '110606319=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110606320=  PHONE_ TYPE OF COLUMN G_ADDRESS.PHONE,'
      '110606321=  FAX_ TYPE OF COLUMN G_ADDRESS.FAX,'
      '110606322=  EMAIL_ TYPE OF COLUMN G_ADDRESS.EMAIL,'
      '110606323=  WEBSITE_ TYPE OF COLUMN G_ADDRESS.WEBSITE,'
      '110606324=  IS_DEFAULT_ TYPE OF COLUMN G_ADDRESS.IS_DEFAULT,'
      '110606325=  ERR_CODE INTEGER,'
      '110606326=  ERR_MSG VARCHAR(1024))'
      '110606327=AS'
