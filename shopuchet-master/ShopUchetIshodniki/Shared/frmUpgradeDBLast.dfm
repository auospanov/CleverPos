        'INT,'
      '110173119=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39','
      '110173120=  IS_EXPORT_ INTEGER = 0)'
      '110173121=RETURNS ('
      '110173122=  PERIOD_ VARCHAR(40),'
      '110173123=  ROW_NUM VARCHAR(15),'
      '110173124=  ARTICUL VARCHAR(1000),'
      
        '110173125=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
