      '110206853='
      
        '110206854=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '110206855=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041 +
        #1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '110206856=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052 +
        ' '#1057#1051#1059#1063#1040#1045
      
        '110206857=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054' ' +
        #1051#1048#1062#1040'"'
      '110206858=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '110206859=          UPDATE G_DISCONT_CARD D'
      
        '110206860=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_,' +
        ' 0) + :SUMM_BONUS_GOT_,'
      '110206861=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110206862=          WHERE D.G_CLIENT = :G_CLIENT_'
      '110206863=          RETURNING'
      '110206864=            D.SUMM_ALL'
      '110206865=          INTO'
      '110206866=            :CLIENT_SUMM_ALL_;'
      '110206867='
      '110206868=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '110206869=            FROM G_CLIENT_DISC_VAL_GRID G'
      '110206870=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '110206871=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '110206872=          ORDER BY G.SUMM_FROM'
      '110206873=          ROWS 1 TO 1'
      '110206874=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '110206875='
      '110206876=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '110206877=            UPDATE G_CLIENT G'
      '110206878=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '110206879=             WHERE G.G_CLIENT = :G_CLIENT_'
      '110206880=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '110206881='
      '110206882=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '110206883=            UPDATE G_DISCONT_CARD D'
      '110206884=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '110206885=             WHERE D.G_CLIENT = :G_CLIENT_'
      '110206886=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '110206887=      END'
      '110206888='
      
        '110206889=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' '#1057 +
        ' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', '#1050 +
        #1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '110206890=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057#1051 +
        #1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '110206891=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048#1057 +
