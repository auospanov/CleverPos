      '110211513=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '110211514=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUME' +
        'RIC(15,2),'
      
        '110211515=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUME' +
        'RIC(15,2),'
      
        '110211516=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH *' +
        '/ NUMERIC(15,2),'
      
        '110211517=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NU' +
        'MERIC(15,2),'
      
        '110211518=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_G' +
        'OT */ NUMERIC(15,2),'
      
        '110211519=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD' +
        '_RASHOD */ BIGINT,'
      
        '110211520=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC' +
        '(15,2),'
      
        '110211521=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ ' +
        'INTEGER,'
      
        '110211522=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTE' +
        'GER,'
      
        '110211523=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ IN' +
        'TEGER,'
      '110211524=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110211525=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '110211526=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110211527=  ADDRESS_ /* TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS */' +
        ' VARCHAR(500) = NULL,'
      
        '110211528=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT = NULL,'
      
        '110211529=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SU' +
        'B_TYPE 1 SEGMENT SIZE 16384 = NULL,'
      
        '110211530=  G_NONCASH_PAY_TYPE_ /* TYPE OF COLUMN G_NONCASH_PAY_' +
        'TYPE.G_NONCASH_PAY_TYPE */ BIGINT = NULL)'
      '110211531=RETURNS ('
      '110211532=  ERR_CODE INTEGER,'
      '110211533=  ERR_MSG VARCHAR(1024))'
      '110211534=AS'
      '110211535=BEGIN'
      '110211536=  SUSPEND;'
      '110211537=END'
      '110211538=;'
      '110211539='
      '110211540='
      
        '110211541=/*****************************************************' +
        '*************************/'
      
        '110211542=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110211543=/*****************************************************' +
        '*************************/'
      '110211544=ALTER PROCEDURE G_NONCASH_PAY_TYPE_DEL('
      
        '110211545=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE)'
      '110211546=AS'
      '110211547=BEGIN'
      
        '110211548=  IF ((SELECT COUNT(*) FROM ZAKAZ Z WHERE Z.G_NONCASH_' +
        'PAY_TYPE = :G_NONCASH_PAY_TYPE_) > 0) THEN'
      '110211549=    UPDATE G_NONCASH_PAY_TYPE'
      '110211550=    SET IS_ACTIVE = 0'
      '110211551=    WHERE (G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_);'
      '110211552='
      '110211553=  ELSE'
      '110211554=    DELETE FROM G_NONCASH_PAY_TYPE'
      '110211555=    WHERE (G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_);'
      '110211556=END'
      '110211557=;'
      '110211558='
      '110211559=ALTER PROCEDURE G_NONCASH_PAY_TYPE_GET('
      
        '110211560=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE)'
      '110211561=RETURNS ('
      '110211562=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110211563=  IS_ACTIVE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_ACTI' +
        'VE)'
      '110211564=AS'
      '110211565=BEGIN'
      '110211566=  SELECT NAME,'
      '110211567=         IS_ACTIVE'
      '110211568=    FROM G_NONCASH_PAY_TYPE'
      '110211569=  WHERE (G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_)'
      '110211570=  INTO :NAME_,'
      '110211571=       :IS_ACTIVE_;'
      '110211572=END'
      '110211573=;'
      '110211574='
      '110211575=ALTER PROCEDURE G_NONCASH_PAY_TYPE_INS('
      '110211576=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME)'
      '110211577=RETURNS ('
      
        '110211578=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE)'
      '110211579=AS'
      '110211580=BEGIN'
      '110211581=  INSERT INTO G_NONCASH_PAY_TYPE ('
      '110211582=    G_NONCASH_PAY_TYPE,'
      '110211583=    NAME)'
      '110211584=  VALUES ('
      '110211585=    GEN_ID(GEN_G_NONCASH_PAY_TYPE, 1),'
      '110211586=    :NAME_'
      '110211587=  )'
      '110211588=  RETURNING'
      '110211589=    G_NONCASH_PAY_TYPE'
      '110211590=  INTO'
      '110211591=    :G_NONCASH_PAY_TYPE_;'
      '110211592=END'
      '110211593=;'
      '110211594='
      '110211595=ALTER PROCEDURE G_NONCASH_PAY_TYPE_READ'
      '110211596=RETURNS ('
      
        '110211597=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE,'
      '110211598=  NAME TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110211599=  IS_ACTIVE TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_ACTIV' +
        'E)'
      '110211600=AS'
      '110211601=BEGIN'
      '110211602=  FOR SELECT G_NONCASH_PAY_TYPE,'
      '110211603=             NAME,'
      '110211604=             IS_ACTIVE'
      '110211605=      FROM G_NONCASH_PAY_TYPE'
      '110211606=      INTO :G_NONCASH_PAY_TYPE,'
      '110211607=           :NAME,'
      '110211608=           :IS_ACTIVE'
      '110211609=  DO'
      '110211610=  BEGIN'
      '110211611=    SUSPEND;'
      '110211612=  END'
      '110211613=END'
      '110211614=;'
      '110211615='
      '110211616=ALTER PROCEDURE G_NONCASH_PAY_TYPE_UPD('
      
        '110211617=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      '110211618=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME)'
      '110211619=AS'
      '110211620=BEGIN'
      '110211621=  UPDATE G_NONCASH_PAY_TYPE'
      '110211622=  SET NAME = :NAME_'
      '110211623=  WHERE (G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_);'
      '110211624=END'
      '110211625=;'
      '110211626='
      '110211627=ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '110211628=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110211629=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '110211630=RETURNS ('
      '110211631=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110211632=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110211633=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110211634=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110211635=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110211636=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110211637=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110211638=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS,'
      '110211639=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110211640=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110211641=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110211642=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110211643=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110211644=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110211645=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110211646=  CNT_Z_ INTEGER,'
      
        '110211647=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110211648=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110211649=  HAVERIGHT_ INTEGER,'
      '110211650=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110211651=  NOT_MINUS_OSTATOK_ TYPE OF COLUMN SKLAD_PARENT.IS_EX' +
        'PECTED,'
      
        '110211652=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      '110211653=  ERR_CODE INTEGER,'
      '110211654=  ERR_MSG VARCHAR(1024))'
      '110211655=AS'
      '110211656=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      
        '110211657=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110211658=begin'
      '110211659='
      '110211660=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1086#1076#1072#1078', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110211661=  /*CNT_Z_ = 0;'
      '110211662=  SELECT COUNT(*)'
      '110211663=    FROM (SELECT Z.ZAKAZ'
      '110211664=            FROM ZAKAZ Z ROWS 1 TO 100)'
      '110211665=    INTO :CNT_Z_;*/'
      '110211666='
      
        '110211667=  --**************************************************' +
        '**************'
      '110211668=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '110211669=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110211670=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '110211671=          SELECT'
      '110211672=            T.G_TOCHKA,'
      '110211673=            T.Z_DATE,'
      '110211674=            T.Z_TIME,'
      '110211675=            T.G_CLIENT,'
      '110211676=            T.G_PAYMENT_TYPE,'
      '110211677=            T.OSNOVANIE,'
      '110211678=            T.NOTE,'
      '110211679=            T.SUMM,'
      '110211680=            T.SUMM_FACT,'
      '110211681=            T.SUMM_BONUS,'
      '110211682=            T.summ_bonus_got,'
      '110211683=            T.IS_PAYED_ALL,'
      '110211684=            COALESCE(T.BY_RECIPE, 0)'
      '110211685=            ,IS_RESERVE'
      '110211686=            ,NOT_MINUS_OSTATOK'
      '110211687=            ,DELIVERY_ADDRESS'
      '110211688=            ,G_NONCASH_PAY_TYPE'
      '110211689=          FROM ZAKAZ T'
      '110211690=          WHERE T.ZAKAZ = :ZAKAZ_'
      '110211691=          INTO'
      '110211692=            :G_TOCHKA_,'
      '110211693=            :Z_DATE_,'
      '110211694=            :Z_TIME_,'
      '110211695=            :G_CLIENT_,'
      '110211696=            :G_PAYMENT_TYPE_,'
      '110211697=            :OSNOVANIE_,'
      '110211698=            :NOTE_,'
      '110211699=            :SUMM_,'
      '110211700=            :SUMM_FACT_,'
      '110211701=            :SUMM_PAY_BONUS_,'
      '110211702=            :SUMM_GOT_BONUS_,'
      '110211703=            :IS_PAYED_ALL_,'
      '110211704=            :BY_RECIPE_,'
      '110211705=            :IS_RESERVE_,'
      '110211706=            :NOT_MINUS_OSTATOK_,'
      '110211707=            :ADDRESS_,'
      '110211708=            :G_NONCASH_PAY_TYPE_;'
      '110211709='
      '110211710=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '110211711=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS,' +
        ' ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_' +
        'TENGE,'
      
        '110211712=                                        DISCOUNT_SUMM,' +
        ' NDS, NDS_SUMM, COST_PRICE)'
      
        '110211713=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AM' +
        'OUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110211714=                   DISCOUNT_SUMM, NDS, NDS_SUMM, COST_' +
        'PRICE'
      '110211715=              FROM ZAKAZ_DETAILS'
      '110211716=             WHERE ZAKAZ = :ZAKAZ_'
      '110211717=             ORDER BY 1;'
      '110211718='
      '110211719=          -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110211720=          SELECT K.G_PRIHOD_RASHOD,'
      '110211721=                 K.SUMM'
      
        '110211722=            FROM (SELECT * FROM KASSA UNION SELECT * F' +
        'ROM KASSA_BEZNAL) K'
      '110211723=           WHERE K.ZAKAZ = :ZAKAZ_'
      '110211724=             AND K.G_PRIHOD_RASHOD NOT IN (1, -5)'
      '110211725=            INTO :G_PRIHOD_,'
      '110211726=                 :SUMM_PRIHOD_;'
      '110211727=      END'
      '110211728='
      
        '110211729=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RET' +
        'URNING_VALUES :PAYMENTS_;'
      '110211730=  END'
      '110211731=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110211732=  --*************************************************'
      '110211733=  --*************************************************'
      '110211734=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110211735=  ELSE BEGIN'
      '110211736=    SELECT'
      '110211737=        T.G_CLIENT,'
      '110211738=        T.DATE_RECEIPT,'
      '110211739=        T.TIME_RECEIPT,'
      '110211740=        T.G_TOCHKA,'
      '110211741=        T.G_PAYMENT_TYPE,'
      '110211742=        T.OSNOVANIE,'
      '110211743=        T.NOTE,'
      '110211744=        T.SUMM,'
      '110211745=        T.SUMM_FACT,'
      '110211746=        0,'
      '110211747=        0,'
      '110211748=        0,'
      '110211749=        T.IS_EXPECTED'
      '110211750=      FROM SKLAD_PARENT T'
      '110211751=      WHERE T.SKLAD = :ZAKAZ_'
      '110211752=      INTO'
      '110211753=        :G_TOCHKA_,'
      '110211754=        :Z_DATE_,'
      '110211755=        :Z_TIME_,'
      '110211756=        :G_CLIENT_,'
      '110211757=        :G_PAYMENT_TYPE_,'
      '110211758=        :OSNOVANIE_,'
      '110211759=        :NOTE_,'
      '110211760=        :SUMM_,'
      '110211761=        :SUMM_FACT_,'
      '110211762=        :SUMM_PAY_BONUS_,'
      '110211763=        :IS_PAYED_ALL_,'
      '110211764=        :BY_RECIPE_,'
      '110211765=        :NOT_MINUS_OSTATOK_;'
      '110211766='
      '110211767=      -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110211768=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '110211769=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '110211770=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE,' +
        ' SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047#1040 +
        #1055#1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '110211771=        FROM SKLAD'
      '110211772=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '110211773=      ORDER BY 1;'
      '110211774=  END'
      '110211775='
      
        '110211776=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110211777=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110211778=  HaveRight_ = 1;'
      '110211779=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '110211780=    SELECT ID'
      '110211781=      FROM CUR_PARAMS'
      '110211782=     WHERE CUR_PARAMS = 1'
      '110211783=      INTO :G_OFFICIAL_CUR_;'
      '110211784='
      
        '110211785=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110211786=      HaveRight_ = 1;'
      '110211787=    else'
      
        '110211788=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110211789='
      '110211790=    /* '#1040#1053#1040#1051#1048#1047' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045
      '110211791=    if (HaveRight_ = 0) then begin'
      
        '110211792=      ERR_CODE = -20500; // '#1053#1077' '#1076#1086#1089#1090#1072#1090#1086#1095#1085#1086' '#1087#1088#1072#1074' '#1076#1083#1103' '#1074#1099#1087 +
        #1086#1083#1085#1077#1085#1080#1103' '#1086#1087#1077#1088#1072#1094#1080#1080
      
        '110211793=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' '#1085#1077' '#1086 +
        #1073#1083#1072#1076#1072#1077#1090#1077' '#1087#1088#1072#1074#1086#1084' '#1076#1083#1103' '#1088#1077#1076#1072#1082#1090#1080#1088#1086#1074#1072#1085#1080#1103' '#1085#1072#1082#1083#1072#1076#1085#1099#1093#39'||ascii_char(10)||'#39 +
        #1079#1072' '#1087#1088#1086#1096#1083#1099#1077' '#1076#1072#1090#1099'.'#39') RETURNING_VALUES(:ERR_MSG);'
      '110211794=      EXIT;'
      '110211795=    end*/'
      '110211796=  END'
      '110211797=end'
      '110211798=;'
      '110211799='
      '110211800=ALTER PROCEDURE INS_ZAKAZ('
      '110211801=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110211802=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110211803=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110211804=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110211805=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110211806=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110211807=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110211808=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110211809=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110211810=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110211811=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110211812=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110211813=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110211814=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110211815=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110211816=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110211817=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110211818=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110211819=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110211820=  IS_MEBEL_ INTEGER = 0,'
      
        '110211821=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110211822=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      
        '110211823=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NUL' +
        'L,'
      '110211824=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '110211825=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110211826=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110211827=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110211828=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110211829=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110211830=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '110211831=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE = NULL)'
      '110211832=RETURNS ('
      '110211833=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110211834=  ERR_CODE INTEGER,'
      '110211835=  ERR_MSG VARCHAR(1024))'
      '110211836=AS'
      '110211837=/*'
      '110211838=IS_SPISANIE_'
      '110211839=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110211840=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110211841=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110211842=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110211843='
      '110211844='
      
        '110211845=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110211846=*/'
      '110211847=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110211848=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110211849=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110211850=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110211851=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110211852=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110211853=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110211854=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110211855=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110211856=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110211857=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110211858=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110211859=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110211860=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110211861=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '110211862=DECLARE VARIABLE CNT_ INTEGER;'
      '110211863=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110211864=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110211865=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110211866=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110211867=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110211868=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110211869=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110211870=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110211871=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110211872=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110211873=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110211874=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110211875=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110211876=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110211877=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110211878=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110211879=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      
        '110211880=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.MARK_CODE;'
      '110211881=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '110211882=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN L' +
        'OG_OPER.OPERATION;'
      
        '110211883=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '110211884=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110211885=BEGIN'
      '110211886='
      
        '110211887=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110211888=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110211889=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110211890=  IF (CNT_ = 0) THEN BEGIN'
      '110211891=    ERR_CODE = -20500;'
      
        '110211892=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110211893=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110211894=    EXIT;'
      '110211895=  END'
      '110211896='
      '110211897=  IF (G_TOCHKA_ IS NULL) THEN'
      '110211898=    SELECT ID'
      '110211899=      FROM CUR_PARAMS'
      '110211900=     WHERE CUR_PARAMS = 2'
      '110211901=      INTO :G_TOCHKA_;'
      '110211902='
      '110211903=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110211904=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110211905=      PNT_ = '#39'01'#39';'
      
        '110211906=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110211907=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110211908=      ELSE'
      '110211909=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110211910='
      '110211911=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110211912=      SELECT G.G_OFFICIAL,'
      '110211913=             G.DO_NOT_SALES_COMM,'
      '110211914=             G.FM||'#39' '#39'||G.NM'
      '110211915=        FROM G_OFFICIAL G'
      
        '110211916=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110211917=        INTO :G_OFFICIAL_,'
      '110211918=             :DO_NOT_SALES_COMM_,'
      '110211919=             :OFFICIAL_NAME_;'
      '110211920='
      '110211921=      INSERT INTO ZAKAZ'
      '110211922=      ('
      '110211923=       ZAKAZ,'
      '110211924=       G_TOCHKA,'
      '110211925=       Z_DATE,'
      '110211926=       Z_TIME,'
      '110211927=       G_CLIENT,'
      '110211928=       G_PAYMENT_TYPE,'
      '110211929=       OSNOVANIE,'
      '110211930=       IS_SPISANIE,'
      '110211931=       NOTE,'
      '110211932=       SUMM,'
      '110211933=       SUMM_FACT,'
      '110211934=       SUMM_BONUS,'
      '110211935=       IS_PAYED_ALL'
      '110211936=       ,G_OFFICIAL'
      '110211937=       ,BY_RECIPE'
      '110211938=       ,SUMM_BONUS_GOT'
      '110211939=       ,IS_RESERVE'
      '110211940=       ,SUMM_CASH'
      '110211941=       ,SUMM_NONCASH'
      '110211942=       ,NOT_MINUS_OSTATOK'
      '110211943=       ,DELIVERY_ADDRESS'
      '110211944=       ,REC_ID'
      '110211945=       ,G_NONCASH_PAY_TYPE'
      '110211946=      ) VALUES ('
      '110211947=       GEN_ID(GEN_ZAKAZ, 1),'
      '110211948=       :G_TOCHKA_,'
      '110211949=       :Z_DATE_,'
      '110211950=       :Z_TIME_,'
      '110211951=       :G_CLIENT_,'
      '110211952=       :G_PAYMENT_TYPE_,'
      '110211953=       :OSNOVANIE_,'
      '110211954=       :IS_SPISANIE_,'
      '110211955=       :NOTE_,'
      '110211956=       :SUMM_,'
      '110211957=       :SUMM_FACT_1_,'
      '110211958=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110211959=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110211960=       ,:G_OFFICIAL_'
      '110211961=       ,:BY_RECIPE_'
      '110211962=       ,:SUMM_BONUS_GOT_'
      '110211963=       ,:IS_RESERVE_'
      '110211964=       ,COALESCE(:SUMM_CASH_, 0)'
      '110211965=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110211966=       ,:NOT_MINUS_OSTATOK_'
      '110211967=       ,:ADDRESS_'
      '110211968=       ,:REC_ID_'
      '110211969=       ,:G_NONCASH_PAY_TYPE_'
      '110211970=      )'
      '110211971=      RETURNING'
      '110211972=        ZAKAZ'
      '110211973=      INTO'
      '110211974=        :ZAKAZ_;'
      '110211975='
      '110211976=      PNT_ = '#39'02'#39';'
      
        '110211977=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110211978=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM, Z.MARK_CODE'
      '110211979=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110211980=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110211981=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110211982=              :G_PRODUCT,'
      '110211983=              :AMOUNT,'
      '110211984=              :PRICE,'
      '110211985=              :SUMM,'
      '110211986=              :DISCOUNT_PERC,'
      '110211987=              :DISCOUNT_TENGE,'
      '110211988=              :DISCOUNT_SUMM,'
      '110211989=              :NDS,'
      '110211990=              :NDS_SUMM,'
      '110211991=              :COST_PRICE,'
      '110211992=              :SALES_COMM_,'
      '110211993=              :MARK_CODE_'
      '110211994=      DO BEGIN'
      
        '110211995=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110211996=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '110211997=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/1' +
        '00;'
      
        '110211998=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_AL' +
        'L_ + SALES_COMM_SUMM_ITER_;'
      '110211999=        END'
      '1102111000='
      '1102111001=        INSERT INTO ZAKAZ_DETAILS'
      '1102111002=        VALUES('
      '1102111003=          :ZAKAZ_DETAILS_TMP_,'
      '1102111004=          :ZAKAZ_,'
      '1102111005=          :G_PRODUCT,'
      '1102111006=          :AMOUNT,'
      '1102111007=          :PRICE,'
      '1102111008=          :SUMM,'
      '1102111009=          :DISCOUNT_PERC,'
      '1102111010=          :DISCOUNT_TENGE,'
      '1102111011=          :DISCOUNT_SUMM,'
      '1102111012=          :NDS,'
      '1102111013=          :NDS_SUMM,'
      '1102111014=          :COST_PRICE,'
      '1102111015=          :SALES_COMM_SUMM_ITER_,'
      '1102111016=          :MARK_CODE_'
      '1102111017=        );'
      '1102111018='
      
        '1102111019=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
