      '110153116=    /* '#1055#1077#1088#1077#1093#1086#1076#1080#1084' '#1082' '#1089#1083#1077#1076#1091#1102#1097#1077#1081' '#1090#1088#1080#1072#1076#1077' */'
      '110153117=    val_str = left(val_str, char_length(val_str)-3);'
      '110153118=    /* '#1059#1074#1077#1083#1080#1095#1080#1074#1072#1077#1084' '#1089#1095#1105#1090#1095#1080#1082' '#1088#1072#1079#1088#1103#1076#1072' */'
