      '1102017284=                     AND SK.IS_LAST = 1'
      '1102017285=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102017286='
      '1102017287=                  UPDATE SKLAD SK'
      '1102017288=                     SET SK.IS_LAST = 1'
      '1102017289=                   WHERE SK.SKLAD = :SKLAD_;'
      '1102017290=                END*/'
      '1102017291='
      
        '1102017292=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102017293=            END ELSE BEGIN'
      '1102017294=                UPDATE SKLAD S'
      '1102017295=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1102017296=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1102017297=                       S.PRICE    = :PRICE_,'
      '1102017298=                       S.SUMM     = :SUMMM_,'
      '1102017299=                       S.OSNOVANIE = :OSNOVANIE_,'
      '1102017300=                       S.NOTE      = :NOTE_'
      '1102017301=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1102017302='
      
        '1102017303=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102017304=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102017305=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017306=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_),'
      
        '1102017307=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102017308=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017309=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1102017310=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1102017311=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017312=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_),'
      
        '1102017313=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102017314=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017315=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102017316='
      
        '1102017317=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1102017318=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102017319=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102017320=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017321=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_),'
      
        '1102017322=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1102017323=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1102017324=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1102017325='
      
        '1102017326=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1102017327=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017328=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_),'
      
        '1102017329=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1102017330=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1102017331=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1102017332='
      
        '1102017333=                -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' ' +
        #1057#1050#1051#1040#1044', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1102017334=                END ELSE IF (IS_EXPECTED_OLD_ = 1 AND' +
        ' NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102017335=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017336=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_,'
      
        '1102017337=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102017338=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017339=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102017340='
      '1102017341=                    IF (ROW_COUNT = 0) THEN'
      
        '1102017342=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102017343=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_AP' +
        'P_);'
      '1102017344=                END'
      
        '1102017345=                -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042 +
        #1040' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1102017346=                ELSE IF (IS_EXPECTED_OLD_ = 0 AND NOT' +
        '_MINUS_OSTATOK_ = 1) THEN BEGIN'
      '1102017347=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017348=                       SET L.AMOUNT = L.AMOUNT - (:AM' +
        'OUNT_OLD_ - :Z_AMOUNT_) - :Z_AMOUNT_,'
      
        '1102017349=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102017350=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017351=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102017352=                END'
      '1102017353='
      
        '1102017354=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1102017355=                /*IF ((Z_DATE_ > DATE_RECEIPT_OLD_) A' +
        'ND (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1102017356=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1102017357=                      FROM SKLAD SK'
      '1102017358=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102017359=                       AND SK.IS_LAST = 1'
      '1102017360=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1102017361=                      INTO :DATE_LAST_;'
      '1102017362='
      
        '1102017363=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102017364=                      UPDATE SKLAD SK'
      '1102017365=                         SET SK.IS_LAST = 0'
      
        '1102017366=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1102017367=                         AND SK.IS_LAST = 1'
      
        '1102017368=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1102017369='
      '1102017370=                      UPDATE SKLAD SK'
      '1102017371=                         SET SK.IS_LAST = 1'
      
        '1102017372=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1102017373=                    END'
      '1102017374=                END'
      '1102017375='
      
        '1102017376=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1102017377=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1102017378=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1102017379=                      FROM SKLAD SK'
      '1102017380=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102017381=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1102017382=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1102017383=                       AND SK.is_vozvrat IN (0,3,4)'
      '1102017384=                      INTO :DATE_LAST_;'
      '1102017385='
      
        '1102017386=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102017387=                      UPDATE SKLAD SK'
      '1102017388=                         SET SK.IS_LAST = 0'
      
        '1102017389=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1102017390='
      '1102017391=                       UPDATE SKLAD SK'
      '1102017392=                         SET SK.IS_LAST = 1'
      
        '1102017393=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1102017394=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1102017395=                                           FROM SKLAD' +
        ' SS'
      
        '1102017396=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1102017397=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1102017398=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1102017399=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1102017400=                    END'
      '1102017401=                END*/'
      '1102017402=            END'
      '1102017403=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1102017404=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1102017405='
      '1102017406=      UPDATE SKLAD_PARENT'
      '1102017407=      SET'
      
        '1102017408=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1102017409=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1102017410=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102017411=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102017412=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102017413=       SUMM      = :SUMM_,'
      '1102017414=       SUMM_FACT = :SUMM_FACT_,'
      '1102017415=       IS_EXPECTED = :NOT_MINUS_OSTATOK_'
      '1102017416=      WHERE SKLAD  = :ZAKAZ_;'
      '1102017417=  END'
      '1102017418='
      '1102017419=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102017420='
      '1102017421=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102017422=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 2, :SUMM_, :LOG_BODY_, 0);'
      '1102017423='
      '1102017424=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102017425=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102017426=END'
      '1102017427=;'
      '1102017428='
      '1102017429=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL_REAL('
      '1102017430=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102017431=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102017432=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102017433=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102017434=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102017435=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102017436=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102017437=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102017438=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102017439=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102017440=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102017441=RETURNS ('
      '1102017442=  ERR_CODE INTEGER,'
      '1102017443=  ERR_MSG VARCHAR(1024))'
      '1102017444=AS'
      '1102017445=/*'
      
        '1102017446='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'-'#1054#1055#1051#1040#1058#1059' '#1047 +
        #1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051
      '1102017447='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1060#1054#1056#1052#1045' TOplataTovaraRealNForm'
      '1102017448='
      
        '1102017449=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1040#1055#1044#1045#1049#1058' '#1042#1054#1047#1042#1056#1040#1058#1040' ' +
        #1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102017450=*/'
      
        '1102017451=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL_REAL'#39';'
      '1102017452=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102017453=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102017454=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1102017455=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1102017456=DECLARE VARIABLE Z_G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.G_PRODUCT;'
      
        '1102017457=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1102017458=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '1102017459=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      '1102017460=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102017461=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1102017462=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      
        '1102017463=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1102017464=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102017465=BEGIN'
      
        '1102017466=  --*************************************************' +
        '*************************************************'
      
        '1102017467=  --*************************************************' +
        '*************************************************'
      '1102017468=  --  '#1040#1055#1044#1045#1049#1058' '#1054#1041#1067#1063#1053#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1047#1040' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102017469=  --*************************************************' +
        '*************************************************'
      
        '1102017470=  --*************************************************' +
        '*************************************************'
      '1102017471=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102017472=      SELECT Z.G_PAYMENT_TYPE'
      '1102017473=        FROM ZAKAZ Z'
      '1102017474=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102017475=        INTO :G_PAYMENT_TYPE_OLD_;'
      '1102017476='
      '1102017477=      PNT_ = '#39'01a'#39';'
      '1102017478=      UPDATE zakaz'
      '1102017479=      SET'
      '1102017480=       Z_DATE = :Z_DATE_,'
      '1102017481=       Z_TIME = :Z_TIME_,'
      '1102017482=       G_CLIENT = :G_CLIENT_,'
      '1102017483=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102017484=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102017485=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1102017486=       SUMM = :SUMM_,'
      '1102017487=       SUMM_FACT = :SUMM_FACT_,'
      
        '1102017488=       SUMM_CASH = DECODE(:G_PAYMENT_TYPE_, 1, :SUMM_' +
        'FACT_, 0),'
      
        '1102017489=       SUMM_NONCASH = DECODE(:G_PAYMENT_TYPE_, 2, :SU' +
        'MM_FACT_, 0)'
      '1102017490=      WHERE'
      '1102017491=        zakaz = :zakaz_;'
      '1102017492='
      '1102017493=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1102017494=      PNT_ = '#39'02a'#39';'
      
        '1102017495=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102017496=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017497=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102017498=        EXIT;'
      '1102017499=      END'
      '1102017500='
      '1102017501=      PNT_ = '#39'03a'#39';'
      '1102017502=      DELETE from zakaz_DETAILS z'
      '1102017503=      WHERE z.zakaz = :zakaz_;'
      '1102017504=      FOR SELECT G_PRODUCT,'
      '1102017505=                 AMOUNT,'
      '1102017506=                 SUMM,'
      '1102017507=                 ZAKAZ_NA_REAL,'
      '1102017508=                 ZAKAZ_DETAILS'
      '1102017509=            FROM ZAKAZ_DETAILS_TMP_REAL'
      '1102017510=      INTO :Z_G_PRODUCT_,'
      '1102017511=           :Z_AMOUNT_,'
      '1102017512=           :Z_SUMM_,'
      '1102017513=           :ZAKAZ_NA_REAL_,'
      '1102017514=           :ZAKAZ_DETAILS_'
      '1102017515=      DO BEGIN'
      '1102017516=        PNT_ = '#39'04a'#39';'
      
        '1102017517=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E, DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '1102017518=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, ' +
        'NDS, NDS_SUMM, COST_PRICE'
      '1102017519=          FROM ZAKAZ_DETAILS_TMP_REAL Z'
      '1102017520=         WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      
        '1102017521=           AND Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;   -' +
        '-'#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1054#1043#1059#1058' '#1055#1054#1042#1058#1054#1056#1071#1058#1068#1057#1071' :ZAKAZ_NA_REAL_, '#1058#1054' '#1045#1057#1058#1068' '#1055#1054' '#1054#1044#1053#1054#1052#1059 +
        ' :ZAKAZ_NA_REAL_ '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' :ZAKAZ_DETAILS_'
      '1102017522='
      '1102017523=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102017524=        PNT_ = '#39'05a'#39';'
      '1102017525=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102017526=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :Z_A' +
        'MOUNT_,'
      
        '1102017527=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1102017528=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'ZR.AMOUNT_PAYED + :Z_AMOUNT_, 1, 0)'
      '1102017529=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102017530='
      
        '1102017531=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL, '#1053#1054' '#1058'.'#1050'. ZAKAZ_DETAILS '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1057 +
        ' ID ZAKAZ_REAL ('#1042#1067#1064#1045' '#1047#1040#1055#1054#1051#1053#1071#1045#1058#1057#1071' ZAKAZ_DETAILS_TMP),'
      
        '1102017532=        -- '#1058#1054' '#1058#1059#1058' '#1054#1041#1045' '#1050#1054#1051#1054#1053#1050#1048' '#1041#1059#1044#1059#1058' '#1055#1054#1061#1054#1046#1048' '#1044#1056#1059#1043' '#1053#1040' '#1044#1056 +
        #1059#1043#1040
      '1102017533=        PNT_ = '#39'06a'#39';'
      
        '1102017534=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1102017535=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1102017536=      END'
      '1102017537='
      '1102017538=      ----------------------------------------'
      
        '1102017539=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102017540=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1102017541=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1102017542=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102017543=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1102017544=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1102017545=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102017546=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102017547=      if (G_PAYMENT_TYPE_OLD_ = 1) then'
      '1102017548=          SELECT S.KASSA,'
      '1102017549=                 S.G_TOCHKA'
      '1102017550=            FROM KASSA S'
      '1102017551=           WHERE S.ZAKAZ = :ZAKAZ_'
      
        '1102017552=             AND S.G_PRIHOD_RASHOD = 1     -- '#1055#1056#1054#1044#1040#1046#1040 +
        ' '#1058#1054#1042#1040#1056#1040
      '1102017553=            INTO :KASSA_,'
      '1102017554=                 :G_TOCHKA_;'
      '1102017555=      ELSE'
      '1102017556=          SELECT S.KASSA_BEZNAL,'
      '1102017557=                 S.G_TOCHKA'
      '1102017558=            FROM KASSA_BEZNAL S'
      '1102017559=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1102017560=             AND S.G_PRIHOD_RASHOD = 1'
      '1102017561=            INTO :KASSA_,'
      '1102017562=                 :G_TOCHKA_;'
      '1102017563='
      
        '1102017564=        -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045 +
        ' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1102017565=        IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) TH' +
        'EN BEGIN'
      '1102017566=          PNT_ = '#39'05'#39';'
      '1102017567=          EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '1102017568=                                        0,     -- ACT' +
        'ION_'
      
        '1102017569=                                        1,     --:G_P' +
        'RIHOD_RASHOD_,'
      '1102017570=                                        :SUMM_FACT_,'
      '1102017571=                                        :Z_DATE_,'
      
        '1102017572=                                        NULL,   --NOT' +
        'E_'
      '1102017573=                                        :ZAKAZ_,'
      '1102017574=                                        NULL,'
      
        '1102017575=                                        :G_PAYMENT_TY' +
        'PE_,'
      
        '1102017576=                                        :UPLOAD_TO_EX' +
        'T_APP_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102017577=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017578=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102017579=            EXIT;'
      '1102017580=          END'
      '1102017581='
      
        '1102017582=        -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044 +
        #1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102017583=        -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044 +
        #1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102017584=        END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT' +
        '_TYPE_) THEN BEGIN'
      '1102017585=            PNT_ = '#39'07'#39';'
      
        '1102017586=            EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G' +
        '_PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_' +
        'CODE, :ERR_MSG);'
      '1102017587=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017588=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102017589=              EXIT;'
      '1102017590=            END'
      '1102017591='
      
        '1102017592=            EXECUTE PROCEDURE K_INS_KASSA(0,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102017593=                                          1,     -- G' +
        '_PRIHOD_RASHOD_'
      
        '1102017594=                                          :SUMM_FACT_' +
        ','
      '1102017595=                                          :Z_DATE_,'
      
        '1102017596=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1102017597=                                          :ZAKAZ_,   ' +
        '--ZAKAZ_'
      '1102017598=                                          NULL,'
      
        '1102017599=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102017600=                                          :G_TOCHKA_,'
      
        '1102017601=                                          :UPLOAD_TO_' +
        'EXT_APP_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102017602=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017603=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102017604=              EXIT;'
      '1102017605=            END'
      '1102017606=        END'
      '1102017607=      ----------------------------------------'
      '1102017608=  END'
      '1102017609=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102017610=  --*************************************************' +
        '*************************************************'
      
        '1102017611=  --*************************************************' +
        '*************************************************'
      '1102017612='
      
        '1102017613=  --*************************************************' +
        '*************************************************'
      
        '1102017614=  --*************************************************' +
        '*************************************************'
      '1102017615=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102017616=  --*************************************************' +
        '*************************************************'
      
        '1102017617=  --*************************************************' +
        '*************************************************'
      '1102017618=  ELSE BEGIN'
      '1102017619=      UPDATE SKLAD_PARENT'
      '1102017620=      SET'
      
        '1102017621=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1102017622=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1102017623=       G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_' +
        'PAYMENT_TYPE),'
      '1102017624=       G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1102017625=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102017626=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102017627=       SUMM = :SUMM_,'
      '1102017628=       SUMM_FACT = :SUMM_FACT_'
      '1102017629=      WHERE SKLAD  = :ZAKAZ_'
      '1102017630=      RETURNING G_TOCHKA'
      '1102017631=      INTO :G_TOCHKA_;'
      '1102017632='
      '1102017633=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1102017634=      PNT_ = '#39'02'#39';'
      
        '1102017635=      EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, NUL' +
        'L, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102017636=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017637=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102017638=        EXIT;'
      '1102017639=      END'
      '1102017640='
      '1102017641=      PNT_ = '#39'03'#39';'
      '1102017642=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1102017643=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102017644=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102017645=      FOR SELECT T.AMOUNT,'
      '1102017646=                 T.SUMM,'
      '1102017647=                 T.G_PRODUCT,'
      '1102017648=                 T.ZAKAZ_NA_REAL,'
      '1102017649=                 T.ZAKAZ_DETAILS'
      '1102017650=                 ,T.PRICE'
      '1102017651=                 ,T.NDS'
      '1102017652=                 ,T.NDS_SUMM'
      '1102017653=                 ,T.DISCOUNT_TENGE'
      '1102017654=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102017655=            INTO :Z_AMOUNT_,'
      '1102017656=                 :Z_SUMM_,'
      '1102017657=                 :Z_G_PRODUCT_,'
      '1102017658=                 :ZAKAZ_NA_REAL_,'
      '1102017659=                 :ZAKAZ_DETAILS_'
      '1102017660=                 ,:PRICE_'
      '1102017661=                 ,:NDS_'
      '1102017662=                 ,:NDS_SUMM_'
      '1102017663=                 ,:DISCOUNT_TENGE_'
      '1102017664=      DO BEGIN'
      
        '1102017665=        INSERT INTO SKLAD(SKLAD, G_PRODUCT, DATE_RECE' +
        'IPT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, IS_VOZVRA' +
        'T'
      
        '1102017666=                         ,G_CLIENT, G_PAYMENT_TYPE, O' +
        'SNOVANIE, NOTE, G_TOCHKA)'
      
        '1102017667=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :Z_G_PRODU' +
        'CT_, :Z_DATE_, :Z_AMOUNT_, :PRICE_ - :DISCOUNT_TENGE_, :Z_SUMM_,' +
        ' :NDS_, :NDS_SUMM_, :ZAKAZ_, 2'
      
        '1102017668=                         ,:G_CLIENT_, :G_PAYMENT_TYPE' +
        '_, :OSNOVANIE_, :NOTE_, :G_TOCHKA_);'
      '1102017669='
      
        '1102017670=        UPDATE LT_SKLAD_PRODUCT L       -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102017671=           SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_,'
      '1102017672=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102017673=         WHERE L.G_PRODUCT = :Z_G_PRODUCT_'
      '1102017674=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102017675='
      
        '1102017676=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1102017677=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1102017678='
      '1102017679=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102017680=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :Z_AMOUNT_,'
      
        '1102017681=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1102017682=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :Z_AMOUNT_, 1, 0)'
      '1102017683=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102017684=      END'
      '1102017685=  END'
      '1102017686=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102017687=  --*************************************************' +
        '*************************************************'
      
        '1102017688=  --*************************************************' +
        '*************************************************'
      '1102017689='
      '1102017690=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102017691=END'
      '1102017692=;'
      '1102017693='
      '1102017694=ALTER PROCEDURE UPSERT_SKLAD_EXT_LOAD('
      '1102017695=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1102017696=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1102017697=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102017698=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102017699=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102017700=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102017701=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102017702=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1102017703=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102017704=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      '1102017705=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102017706=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102017707=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102017708=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102017709=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102017710=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102017711=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102017712=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL)'
      '1102017713=RETURNS ('
      '1102017714=  ERR_CODE INTEGER,'
      '1102017715=  ERR_MSG VARCHAR(1024))'
      '1102017716=AS'
      
        '1102017717=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1055#1056#1048#1061#1054#1044#1040' '#1048#1047' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071' ' +
        '- '#1052#1054#1041#1048#1051#1050#1048' '#1048#1051#1048' '#1057#1040#1049#1058#1040
      
        '1102017718=-- '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1058#1040#1050#1054#1049' ID - '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1054' '#1054#1041#1053 +
        #1054#1042#1051#1071#1070', '#1053#1045#1058' - '#1058#1040#1050' '#1042#1057#1058#1040#1042#1051#1071#1070
      
        '1102017719=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPSERT_SKLA' +
        'D_EXT_LOAD'#39';'
      
        '1102017720=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD = NULL;'
      '1102017721=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102017722=BEGIN'
      '1102017723='
      '1102017724=  PNT_ = '#39'00'#39';'
      '1102017725='
      '1102017726=  SELECT SP.SKLAD'
      '1102017727=    FROM SKLAD_PARENT SP'
      '1102017728=   WHERE SP.REC_ID = :REC_ID_'
      '1102017729=    INTO :SKLAD_PARENT_;'
      '1102017730='
      '1102017731=  IF (SKLAD_PARENT_ IS NULL) THEN BEGIN'
      '1102017732='
      '1102017733=    PNT_ = '#39'01'#39';'
      
        '1102017734=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_, :DATE_REC' +
        'EIPT_, :TIME_RECEIPT_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_' +
        ','
      
        '1102017735=        :NOTE_, :IS_VOZVRAT_, :SUMM_, :SUMM_FACT_, NU' +
        'LL /*:G_PRIHOD_*/, 0 /*:SUMM_PRIHOD_*/, :PAYMENTS_, :SUMM_CURREN' +
        'CY_, :IS_EXPECTED_,'
      
        '1102017736=        :UPLOAD_TO_EXT_APP_, :USER_ID_, :LOG_BODY_, :' +
        'G_OFFICIAL_, :REC_ID_)'
      
        '1102017737=        RETURNING_VALUES :SKLAD_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102017738='
      '1102017739=  END'
      '1102017740=  ELSE BEGIN'
      '1102017741='
      '1102017742=    PNT_ = '#39'02'#39';'
      
        '1102017743=    EXECUTE PROCEDURE UPD_SKLAD(:SKLAD_PARENT_, :DATE' +
        '_RECEIPT_, :TIME_RECEIPT_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVA' +
        'NIE_,'
      
        '1102017744=        :NOTE_, :SUMM_, :SUMM_FACT_, NULL /*:G_PRIHOD' +
        '_*/, 0 /*:SUMM_PRIHOD_*/, :PAYMENTS_, :SUMM_CURRENCY_, :IS_EXPEC' +
        'TED_,'
      '1102017745=        :UPLOAD_TO_EXT_APP_, :USER_ID_, :LOG_BODY_)'
      '1102017746=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102017747='
      '1102017748=    DELETE FROM SKLAD_TMP;'
      '1102017749='
      '1102017750=  END'
      '1102017751='
      '1102017752=  IF (:ERR_CODE <> 0) THEN'
      
        '1102017753=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102017754=END'
      '1102017755=;'
      '1102017756='
      '1102017757=ALTER PROCEDURE UPSERT_ZAKAZ_EXT_LOAD('
      '1102017758=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102017759=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102017760=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102017761=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102017762=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102017763=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102017764=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102017765=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102017766=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102017767=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102017768=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102017769=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102017770=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102017771=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102017772=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102017773=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102017774=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102017775=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102017776=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102017777=  IS_MEBEL_ INTEGER = 0,'
      
        '1102017778=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1102017779=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      
        '1102017780=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      '1102017781=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1102017782=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102017783=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102017784=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102017785=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102017786=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102017787=  REC_ID_ TYPE OF COLUMN ZAKAZ.REC_ID = NULL)'
      '1102017788=RETURNS ('
      '1102017789=  ERR_CODE INTEGER,'
      '1102017790=  ERR_MSG VARCHAR(1024))'
      '1102017791=AS'
      '1102017792=/*'
      
        '1102017793=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1055#1056#1048#1061#1054#1044#1040' '#1048#1047' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071' ' +
        '- '#1052#1054#1041#1048#1051#1050#1048' '#1048#1051#1048' '#1057#1040#1049#1058#1040
      
        '1102017794=-- '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1058#1040#1050#1054#1049' ID - '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1054' '#1054#1041#1053 +
        #1054#1042#1051#1071#1070', '#1053#1045#1058' - '#1058#1040#1050' '#1042#1057#1058#1040#1042#1051#1071#1070
      '1102017795=*/'
      
        '1102017796=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'UPSERT_ZAKAZ' +
        '_EXT_LOAD'#39';'
      '1102017797=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102017798=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        'NULL;'
      '1102017799=BEGIN'
      '1102017800='
      '1102017801=  PNT_ = '#39'00'#39';'
      '1102017802='
      '1102017803=  SELECT SP.ZAKAZ'
      '1102017804=    FROM ZAKAZ SP'
      '1102017805=   WHERE SP.REC_ID = :REC_ID_'
      '1102017806=    INTO :ZAKAZ_;'
      '1102017807='
      '1102017808=  IF (ZAKAZ_ IS NULL) THEN BEGIN'
      '1102017809='
      '1102017810=    PNT_ = '#39'01'#39';'
      
        '1102017811=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_, :Z_DATE_,' +
        ' :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :IS_SPISAN' +
        'IE_,'
      
        '1102017812=        :NOTE_, :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SU' +
        'MM_NONCASH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_P' +
        'RIHOD_,'
      
        '1102017813=        :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_, :IS_ME' +
        'BEL_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_,'
      
        '1102017814=        :UPLOAD_TO_EXT_APP_, :G_OFFICIAL_, :NOT_MINUS' +
        '_OSTATOK_, :USER_ID_, :LOG_BODY_, :REC_ID_)'
      
        '1102017815=        RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102017816='
      '1102017817=  END'
      '1102017818=  ELSE BEGIN'
      '1102017819='
      '1102017820=    PNT_ = '#39'02'#39';'
      
        '1102017821=    EXECUTE PROCEDURE UPDATE_ZAKAZ_DETAIL(:ZAKAZ_, :Z' +
        '_DATE_, :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NO' +
        'TE_,'
      
        '1102017822=        :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SUMM_NONCA' +
        'SH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_PRIHOD_,'
      
        '1102017823=        :IS_SPISANIE_, :BY_RECIPE_, :IS_RESERVE_, :PA' +
        'YMENTS_, :UPLOAD_TO_EXT_APP_, :NOT_MINUS_OSTATOK_, :ADDRESS_,'
      '1102017824=        :USER_ID_, :LOG_BODY_)'
      '1102017825=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102017826='
      '1102017827=  END'
      '1102017828='
      '1102017829=  IF (:ERR_CODE <> 0) THEN'
      
        '1102017830=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102017831='
      '1102017832=END'
      '1102017833=;'
      '1102017834='
      '1102017835='
      
        '1102017836=/****************************************************' +
        '**************************/'
      
        '1102017837=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102017838=/****************************************************' +
        '**************************/'
      '1102017839=ALTER PROCEDURE DO_PRODUCT('
      '1102017840=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102017841=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1102017842=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102017843=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102017844=  NOTE_ TYPE OF COLUMN OTHER.NOTE,'
      
        '1102017845=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102017846=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102017847=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102017848=RETURNS ('
      '1102017849=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1102017850=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1102017851=  ERR_CODE INTEGER,'
      '1102017852=  ERR_MSG VARCHAR(1024))'
      '1102017853=AS'
      '1102017854=/*'
      
        '1102017855='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1102017856='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1102017857=*/'
      
        '1102017858=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1102017859=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102017860=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1102017861=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1102017862=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1102017863=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1102017864=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1102017865=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1102017866=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1102017867=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '1102017868=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102017869=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102017870=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1102017871=DECLARE VARIABLE POS_ INTEGER;'
      '1102017872=DECLARE VARIABLE STR_ VARCHAR(300);'
      '1102017873=BEGIN'
      '1102017874=  PNT_ = '#39'00'#39';'
      '1102017875=  COST_PRICE_ = 0;'
      '1102017876='
      '1102017877=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102017878=    SELECT ID'
      '1102017879=      FROM CUR_PARAMS'
      '1102017880=     WHERE CUR_PARAMS = 2'
      '1102017881=      INTO :G_TOCHKA_;'
      '1102017882='
      '1102017883=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1102017884=  SELECT P.S_VALUE'
      '1102017885=    FROM SYSTEM_SETUP P'
      '1102017886=   WHERE P.SYSTEM_SETUP = 2'
      '1102017887=    INTO :CAN_SELL_;'
      '1102017888='
      '1102017889=  IF (LOG_BODY_ IS NOT NULL) THEN'
      '1102017890=    LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM 3);'
      '1102017891='
      '1102017892=  FOR SELECT :G_PRODUCT_IN_,'
      '1102017893=             :AMOUNT_IN_'
      '1102017894=        FROM RDB$DATABASE'
      '1102017895=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '1102017896=      UNION ALL'
      '1102017897=      SELECT G_PRODUCT,'
      '1102017898=             AMOUNT'
      '1102017899=        FROM ZAKAZ_DETAILS_TMP'
      '1102017900=       WHERE :G_PRODUCT_IN_ IS NULL'
      '1102017901=        INTO :G_PRODUCT_,'
      '1102017902=             :AMOUNT_'
      '1102017903=  DO BEGIN'
      '1102017904=      SELECT MAX(G.NAME)'
      '1102017905=        FROM G_PRODUCT G,'
      '1102017906=             G_PRODUCT_KIT K'
      '1102017907=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1102017908=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1102017909=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_' +
        'PRODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TO' +
        'CHKA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1102017910=        INTO :NAME_;'
      '1102017911='
      
        '1102017912=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN B' +
        'EGIN'
      '1102017913=        ERR_CODE = -20500;'
      
        '1102017914=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087 +
        #1088#1086#1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102017915=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102017916=        EXIT;'
      '1102017917=      END'
      '1102017918='
      '1102017919=      PNT_ = '#39'01'#39';'
      
        '1102017920=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TIME, OP_' +
        'TYPE, ARRIVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '1102017921=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_,' +
        ' CURRENT_TIME, 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '1102017922=      RETURNING OTHER'
      '1102017923=      INTO :OTHER_;'
      '1102017924='
      '1102017925=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1102017926=      COST_PRICE_ = 0;'
      '1102017927=      FOR SELECT K.G_PRODUCT_ITEM'
      '1102017928=                ,K.AMOUNT*:AMOUNT_'
      '1102017929=                ,K.amount'
      '1102017930=                ,G.G_PRODUCT'
      '1102017931=            FROM G_PRODUCT_KIT K'
      '1102017932=                ,G_PRODUCT G'
      '1102017933=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1102017934=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1102017935=            INTO :ITEM_'
      '1102017936=                ,:AMOUNT_NEED_'
      '1102017937=                ,:AMOUNT_NEED_ONE_'
      '1102017938=                ,:G_PRODUCT_KIT_'
      '1102017939=      DO BEGIN'
      
        '1102017940=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_KIT_, NULL, 1)'
      '1102017941=          RETURNING_VALUES :SELF_PRICE_;'
      '1102017942='
      '1102017943=        UPDATE LT_SKLAD_PRODUCT L'
      '1102017944=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_,'
      '1102017945=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102017946=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1102017947=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102017948='
      '1102017949=        IF (ROW_COUNT = 0) THEN'
      
        '1102017950=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :' +
        'G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102017951='
      
        '1102017952=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTH' +
        'ER, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1102017953=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_' +
        ', :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1102017954='
      
        '1102017955=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*' +
        'SELF_PRICE_;'
      '1102017956=      END'
      '1102017957='
      
        '1102017958=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1102017959=      PNT_ = '#39'02'#39';'
      
        '1102017960=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102017961=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1102017962='
      '1102017963=      SUMM_ = AMOUNT_*COST_PRICE_;'
      '1102017964='
      '1102017965=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102017966=                              :DATE_,'
      '1102017967=                              CURRENT_TIME,'
      '1102017968=                              NULL, --:G_CLIENT__,'
      
        '1102017969=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1102017970=                              NULL, --:OSNOVANIE__,'
      '1102017971=                              :NOTE_,'
      '1102017972=                              4, --:IS_VOZVRAT_,'
      '1102017973=                              :SUMM_,'
      '1102017974=                              :SUMM_,'
      '1102017975=                              0, --:G_PRIHOD_,'
      '1102017976=                              0 --:SUMM_PRIHOD_)'
      '1102017977=                              ,NULL     --PAYMENTS_'
      
        '1102017978=                              ,0        --SUMM_CURREN' +
        'CY_'
      
        '1102017979=                              ,0        --IS_EXPECTED' +
        '_'
      '1102017980=                              ,:UPLOAD_TO_EXT_APP_'
      
        '1102017981=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102017982=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017983=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102017984=          EXIT;'
      '1102017985=      END'
      '1102017986='
      '1102017987=      UPDATE OTHER O'
      '1102017988=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1102017989=      WHERE O.OTHER = :OTHER_;'
      '1102017990='
      '1102017991=      -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102017992=      -- '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1042' '#1058#1040#1050#1054#1052' '#1042#1048#1044#1045' "~*'#1041#1051#1040'-'#1041#1051 +
        #1040' '#1058#1040#1050#1054#1049'-'#1058#1054' '#1058#1054#1042#1040#1056'~*'#1041#1051#1040'-'#1041#1051#1040' '#1042#1058#1054#1056#1054#1049' '#1058#1054#1042#1040#1056'~*"'
      
        '1102017993=      -- '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1042#1067#1056#1045#1047#1040#1058#1068'. '#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1058#1040#1050' '#1044#1045#1051#1040#1058#1068 +
        ' '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1040' '#1058#1059#1058' '#1057#1054#1047#1044#1040#1045#1058#1057#1071
      '1102017994=      -- '#1056#1040#1047#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048'-'#1047#1040#1055#1048#1057#1071#1052#1048
      '1102017995=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1102017996=        POS_ = POSITION('#39'~*'#39' IN LOG_BODY_);'
      
        '1102017997=        IF (CHAR_LENGTH(LOG_BODY_) <> (POS_ + 1)) THE' +
        'N'
      
        '1102017998=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR POS_ ' +
        '- 1);'
      '1102017999=        ELSE'
      
        '1102018000=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR CHAR_' +
        'LENGTH(LOG_BODY_) - 3);'
      '1102018001='
      '1102018002=        --ERR_CODE = -20500;'
      '1102018003=        --ERR_MSG = STR_; EXIT;'
      '1102018004='
      
        '1102018005=        EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, ' +
        ':OTHER_, :DATE_, 1, :SUMM_, :STR_, 1);'
      '1102018006='
      
        '1102018007=        LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM (POSIT' +
        'ION('#39'~*'#39' IN LOG_BODY_)) + 2);'
      '1102018008=      END'
      '1102018009=  END'
      '1102018010=END'
      '1102018011=;'
      '1102018012='
      '1102018013=ALTER PROCEDURE G_TOCHKA_DEL('
      '1102018014=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102018015=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102018016=RETURNS ('
      '1102018017=  ERR_CODE INTEGER,'
      '1102018018=  ERR_MSG VARCHAR(1024))'
      '1102018019=AS'
      '1102018020=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '1102018021=BEGIN'
      '1102018022=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '1102018023=    ERR_CODE = -20500;'
      
        '1102018024=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091 +
        #1076#1072#1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1102018025=    EXIT;'
      '1102018026=  END'
      '1102018027='
      '1102018028=  DELETE FROM KASSA_STATE S'
      '1102018029=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1102018030='
      
        '1102018031=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '1102018032=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0) THEN'
      
        '1102018033=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1102018034=      VALUES (GEN_ID(GEN_LOGS, 1), '#39'DELETE FROM KASSA' +
        '_STATE S WHERE S.G_TOCHKA = '#39'||:G_TOCHKA_||'#39';'#39', '#39'SYSDBA'#39', 0, CUR' +
        'RENT_TIMESTAMP, :ERR_CODE);'
      '1102018035='
      '1102018036=  DELETE FROM KASSA S'
      '1102018037=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1102018038='
      '1102018039=  FOR SELECT KASSA_BEZNAL'
      '1102018040=        FROM KASSA_BEZNAL'
      '1102018041=       WHERE G_TOCHKA = :G_TOCHKA_'
      '1102018042=        INTO :KASSA_'
      '1102018043=  DO BEGIN'
      
        '1102018044=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNI' +
        'NG_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102018045=    IF (:ERR_CODE <> 0) THEN'
      '1102018046=      EXIT;'
      '1102018047=  END'
      '1102018048='
      '1102018049=  UPDATE G_OFFICIAL O'
      '1102018050=     SET O.G_TOCHKA = NULL'
      '1102018051=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '1102018052='
      '1102018053=  DELETE FROM INVOICE I'
      '1102018054=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1102018055=                      FROM ZAKAZ'
      '1102018056=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1102018057='
      '1102018058=  DELETE FROM INVOICE_PAY I'
      '1102018059=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1102018060=                      FROM ZAKAZ'
      '1102018061=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1102018062='
      '1102018063=  DELETE FROM WAYBILL I'
      '1102018064=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1102018065=                      FROM ZAKAZ'
      '1102018066=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1102018067='
      '1102018068=  DELETE FROM LT_ZAKAZ_REAL R'
      '1102018069=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '1102018070=                              FROM ZAKAZ Z, ZAKAZ_DET' +
        'AILS ZD'
      
        '1102018071=                             WHERE Z.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '1102018072=                               AND Z.ZAKAZ = ZD.ZAKAZ' +
        ');'
      '1102018073='
      '1102018074=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '1102018075=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1102018076=                                  FROM ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1102018077=                                 WHERE G_TOCHKA = :G_' +
        'TOCHKA_);'
      '1102018078='
      '1102018079=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '1102018080=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1102018081='
      '1102018082=  DELETE FROM ZAKAZ_DETAILS D'
      '1102018083=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1102018084=                      FROM ZAKAZ'
      '1102018085=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1102018086='
      '1102018087=  DELETE FROM ZAKAZ D'
      '1102018088=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1102018089='
      '1102018090=  DELETE FROM SKLAD D'
      '1102018091=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1102018092='
      '1102018093=  DELETE FROM SKLAD_PARENT D'
      '1102018094=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1102018095='
      '1102018096=  DELETE FROM ZAKAZ_DETAILS D'
      '1102018097=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1102018098=                      FROM ZAKAZ'
      '1102018099=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1102018100='
      '1102018101=  DELETE FROM LT_SKLAD_PRODUCT'
      '1102018102=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '1102018103='
      '1102018104=  DELETE FROM G_TOCHKA'
      '1102018105=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '1102018106='
      
        '1102018107=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054 +
        #1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1102018108=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '1102018109=    UPDATE SYNC_EXT_APP AP'
      '1102018110=       SET AP.OPER = 3'
      '1102018111=     WHERE AP.OBJECT_TYPE = 3'
      '1102018112=       AND AP.ID = :G_TOCHKA_'
      '1102018113=       AND AP.IS_LOADING = 0;'
      '1102018114='
      '1102018115=    IF (ROW_COUNT = 0) THEN'
      
        '1102018116=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1102018117=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 3, :G_TO' +
        'CHKA_, 3);'
      '1102018118=  END'
      '1102018119=END'
      '1102018120=;'
      '1102018121='
      '1102018122=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1102018123=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102018124=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102018125=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102018126=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102018127=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102018128=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102018129=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102018130=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102018131=RETURNS ('
      '1102018132=  ERR_CODE INTEGER,'
      '1102018133=  ERR_MSG VARCHAR(1024))'
      '1102018134=AS'
      '1102018135=/*'
      
        '1102018136='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1102018137='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1102018138='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1102018139=*/'
      
        '1102018140=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1102018141=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102018142=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1102018143=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1102018144=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1102018145=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1102018146=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1102018147=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1102018148=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1102018149=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102018150=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1102018151=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1102018152=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1102018153=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1102018154=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102018155=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102018156=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102018157=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102018158=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1102018159=BEGIN'
      '1102018160='
      '1102018161=  PNT_ = '#39'00'#39';'
      '1102018162=  CLRF = ascii_char( 10 );'
      '1102018163='
      '1102018164=  SELECT S.S_VALUE'
      '1102018165=    FROM SYSTEM_SETUP S'
      '1102018166=   WHERE S.SYSTEM_SETUP = 2'
      '1102018167=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1102018168='
      '1102018169=  PNT_ = '#39'01'#39';'
      '1102018170=  SELECT G.nds_value'
      '1102018171=    FROM G_FIRM_REKVIZIT G'
      '1102018172=   WHERE G.is_default = 1'
      '1102018173=    INTO :NDS_;'
      '1102018174='
      '1102018175=  PNT_ = '#39'02'#39';'
      
        '1102018176=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1102018177=        FROM IMPORT_TBL_TMP'
      
        '1102018178=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1102018179=  DO BEGIN'
      '1102018180=    SELECT G_PRODUCT,'
      '1102018181=           PRICE'
      '1102018182=      FROM ('
      '1102018183=            SELECT P.G_PRODUCT, P.price'
      '1102018184=              FROM G_PRODUCT P'
      
        '1102018185=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1102018186=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1102018187=            UNION'
      '1102018188=            SELECT LT.G_PRODUCT, P.PRICE'
      '1102018189=              FROM LT_BARCODE LT, g_product P'
      
        '1102018190=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1102018191=               AND LT.g_product = P.g_product'
      '1102018192=           )'
      '1102018193=      INTO :G_PRODUCT_,'
      '1102018194=           :PRICE_OUR_;'
      '1102018195='
      '1102018196=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1102018197=      ERR_CODE = -20500;'
      
        '1102018198=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1102018199=      Exit;'
      '1102018200=    END'
      '1102018201='
      '1102018202=    PNT_ = '#39'03'#39';'
      
        '1102018203=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1102018204=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1102018205=      RETURNING_VALUES :COST_PRICE_;'
      '1102018206='
      '1102018207=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1102018208=    IF (price_ IS NULL) THEN'
      '1102018209=      PRICE_ = PRICE_OUR_;'
      '1102018210='
      '1102018211=    PNT_ = '#39'04'#39';'
      
        '1102018212=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1102018213=                                              :AMOUNT' +
        '_,'
      
        '1102018214=                                              :PRICE_' +
        ','
      
        '1102018215=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1102018216=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1102018217=                                              :DISCOU' +
        'NT_,'
      
        '1102018218=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1102018219=                                              :NDS_,'
      
        '1102018220=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1102018221=                                              :COST_P' +
        'RICE_,'
      
        '1102018222=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1102018223=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1102018224=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1102018225=                                              0     -' +
        '-MODE_'
      
        '1102018226=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1102018227=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102018228=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102018229=      EXIT;'
      '1102018230=    END'
      '1102018231='
      '1102018232=    G_PRODUCT_ = NULL;'
      '1102018233=  END'
      '1102018234='
      '1102018235=  PNT_ = '#39'05'#39';'
      '1102018236=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1102018237=    SELECT SUM(T.summ)'
      '1102018238=      FROM ZAKAZ_DETAILS_TMP T'
      '1102018239=      INTO :SUMM_;'
      '1102018240=    SUMM_FACT_ = SUMM_;'
      '1102018241=  END'
      '1102018242='
      '1102018243=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1102018244=  if (G_PAYMENT_TYPE_ = 1) then'
      '1102018245=    SUMM_CASH_ = summ_fact_;'
      '1102018246=  ELSE'
      '1102018247=    SUMM_NONCASH_ = summ_fact_;'
      '1102018248='
      '1102018249=  PNT_ = '#39'06'#39';'
      '1102018250=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1102018251=    G_CLIENT_ = 10;'
      '1102018252='
      '1102018253=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102018254=                              :Z_DATE_,'
      '1102018255=                              :Z_TIME_,'
      '1102018256=                              :G_CLIENT_,'
      '1102018257=                              :G_PAYMENT_TYPE_,'
      '1102018258=                              '#39#39', --:OSNOVANIE_,'
      '1102018259=                              0,  -- IS_SPISANIE'
      
        '1102018260=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1102018261=                              :SUMM_,'
      '1102018262=                              :SUMM_FACT_,'
      '1102018263=                              :SUMM_CASH_,'
      '1102018264=                              :SUMM_NONCASH_,'
      
        '1102018265=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1102018266=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1102018267=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1102018268=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1102018269=                              0,    -- :BY_RECIPE__,'
      '1102018270=                              0,    -- IS_RESERVE__'
      '1102018271=                              NULL -- :PAYMENTS__'
      '1102018272=                              )'
      
        '1102018273=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102018274=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102018275=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102018276=    EXIT;'
      '1102018277=  END'
      '1102018278='
      '1102018279=  DELETE FROM import_tbl_tmp;'
      '1102018280='
      '1102018281=WHEN ANY DO BEGIN'
      '1102018282=    ERR_CODE = gdscode;'
      
        '1102018283=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1102018284=  END'
      '1102018285=end'
      '1102018286=;'
      '1102018287='
      '1102018288=ALTER PROCEDURE P_REP_ZAYAVKA_POSTAVSHIK('
      '1102018289=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102018290=  BEGIN_DATE_ DATE,'
      '1102018291=  END_DATE_ DATE,'
      '1102018292=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102018293=  DO_SKLAD_ INTEGER,'
      '1102018294=  MODE_ INTEGER,'
      '1102018295=  MODE_VYBOR_ INTEGER,'
      '1102018296=  MODE_VAL_ INTEGER,'
      '1102018297=  NEW_VAL_ MY_NUMERIC_5,'
      '1102018298=  ROUND_MODE_ INTEGER)'
      '1102018299=RETURNS ('
      '1102018300=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102018301=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '1102018302=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102018303=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102018304=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1102018305=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1102018306=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1102018307=  ERR_CODE INTEGER,'
      '1102018308=  ERR_MSG VARCHAR(1024))'
      '1102018309=AS'
      '1102018310=/*'
      
        '1102018311='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057 +
        #1056#1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '1102018312='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055 +
        #1054#1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '1102018313=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055 +
        #1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '1102018314=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 -' +
        ' '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '1102018315=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058 +
        #1054#1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045 +
        ' '#1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102018316=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '1102018317=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067 +
        #1042#1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      
        '1102018318=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' *' +
        '/'
      '1102018319=DECLARE VARIABLE ROUND_ INTEGER;'
      '1102018320=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '1102018321=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      
        '1102018322=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PA' +
        'RENT;'
      '1102018323=BEGIN'
      '1102018324=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102018325='
      '1102018326=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102018327=    SELECT ID'
      '1102018328=      FROM CUR_PARAMS'
      '1102018329=     WHERE CUR_PARAMS = 2'
      '1102018330=      INTO :G_TOCHKA_;'
      '1102018331='
      '1102018332=  IF (ROUND_MODE_ = 0) THEN'
      '1102018333=      ROUND_ = 0;'
      '1102018334=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '1102018335=      ROUND_ = -1;'
      '1102018336=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '1102018337=      ROUND_ = -2;'
      '1102018338=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '1102018339=      ROUND_ = -3;'
      '1102018340=  ELSE IF (ROUND_MODE_ = -1) THEN'
      '1102018341=      ROUND_ = 5;'
      '1102018342='
      
        '1102018343=  SQL_STR_ = '#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39';'
      '1102018344='
      
        '1102018345=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040 +
        ' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102018346=  IF (MODE_ = 0) THEN BEGIN'
      
        '1102018347=    SQL_STR_ = SQL_STR_ || '#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39';'
      '1102018348=    IF (MODE_VAL_ = 0) THEN'
      '1102018349=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1102018350=    ELSE'
      
        '1102018351=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1102018352='
      '1102018353=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1102018354=  END'
      '1102018355=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '1102018356=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '1102018357=    SQL_STR_ = SQL_STR_ || '#39'ROUND(ABS(LT.AMOUNT)'#39';'
      '1102018358=    IF (MODE_VAL_ = 0) THEN'
      '1102018359=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1102018360=    ELSE'
      
        '1102018361=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1102018362='
      '1102018363=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1102018364=  END'
      '1102018365='
      
        '1102018366=  SQL_STR_ = SQL_STR_ || '#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39'||'
      
        '1102018367=            '#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39';'
      '1102018368='
      '1102018369=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '1102018370=    SQL_STR_ = SQL_STR_ ||'#39'AND EXISTS (SELECT 1'#39'||'
      
        '1102018371=                                        '#39' FROM SKLAD ' +
        'S'#39'||'
      
        '1102018372=                                        '#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39'||'
      
        '1102018373=                                        '#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39'||'
      
        '1102018374=                                        '#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39';'
      '1102018375=    IF (MODE_VYBOR_ = 2) THEN'
      
        '1102018376=      SQL_STR_ = SQL_STR_ ||'#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39';'
      '1102018377=    ELSE'
      
        '1102018378=      SQL_STR_ = SQL_STR_ ||'#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053 +
        #1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042#1057 +
        #1045#1043#1044#1040
      '1102018379=    SQL_STR_ = SQL_STR_ ||'#39') '#39';'
      '1102018380=  END ELSE BEGIN'
      
        '1102018381=    SQL_STR_ = SQL_STR_ ||'#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39';  --' +
        ' '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '1102018382=  END'
      '1102018383='
      '1102018384=  IF (MODE_ = 0) THEN'
      
        '1102018385=    SQL_STR_ = SQL_STR_ || '#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39';'
      '1102018386=  ELSE IF (MODE_ = 1) THEN'
      '1102018387=    SQL_STR_ = SQL_STR_ || '#39' AND LT.AMOUNT < 0'#39';'
      
        '1102018388=  SQL_STR_ = SQL_STR_ || '#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39';'
      '1102018389='
      '1102018390=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '1102018391=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '1102018392=      FOR EXECUTE STATEMENT'
      
        '1102018393=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1102018394=          INTO :G_PRODUCT,'
      '1102018395=               :CATEGORY_NAME,'
      '1102018396=               :NAME,'
      '1102018397=               :ARTICUL,'
      '1102018398=               :AMOUNT_CUR,'
      '1102018399=               :MIN_AMOUNT,'
      '1102018400=               :AMOUNT_TO_ZAKAZ'
      '1102018401=        DO BEGIN'
      
        '1102018402=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_' +
        'PRODUCT, :G_TOCHKA_, 0)'
      '1102018403=              RETURNING_VALUES :COST_PRICE_;'
      '1102018404='
      
        '1102018405=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, ' +
        'AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102018406=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_' +
        'PRODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO' +
        '_ZAKAZ, 0, 0);'
      '1102018407=        END'
      '1102018408='
      '1102018409=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102018410=                                      CURRENT_DATE,'
      '1102018411=                                      CURRENT_TIME,'
      '1102018412=                                      :G_CLIENT_,'
      '1102018413=                                      1,'
      
        '1102018414=                                      NULL, --:OSNOVA' +
        'NIE__,'
      
        '1102018415=                                      NULL, --:NOTE__' +
        ','
      
        '1102018416=                                      0, --:IS_VOZVRA' +
        'T_,'
      
        '1102018417=                                      (SELECT SUM(S.S' +
        'UMM) FROM SKLAD_TMP S),'
      
        '1102018418=                                      0, -- :SUMM_FAC' +
        'T_'
      
        '1102018419=                                      0, --:G_PRIHOD_' +
        ','
      
        '1102018420=                                      0 --:SUMM_PRIHO' +
        'D_)'
      
        '1102018421=                                      ,NULL --PAYMENT' +
        'S'
      
        '1102018422=                                     )RETURNING_VALUE' +
        'S :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102018423=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102018424=          ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39'||ERR_MSG;'
      '1102018425=          EXIT;'
      '1102018426=        END'
      '1102018427=  END'
      '1102018428=  ELSE BEGIN'
      '1102018429=      FOR EXECUTE STATEMENT'
      
        '1102018430=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1102018431=      INTO :G_PRODUCT,'
      '1102018432=           :CATEGORY_NAME,'
      '1102018433=           :NAME,'
      '1102018434=           :ARTICUL,'
      '1102018435=           :AMOUNT_CUR,'
      '1102018436=           :MIN_AMOUNT,'
      '1102018437=           :AMOUNT_TO_ZAKAZ'
      '1102018438=      DO SUSPEND;'
      '1102018439=  END'
      '1102018440=END'
      '1102018441=;'
      '1102018442='
      '1102018443=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1102018444=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102018445=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102018446=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102018447=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102018448=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102018449=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102018450=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102018451=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102018452=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102018453=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102018454=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102018455=RETURNS ('
      '1102018456=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102018457=  ERR_CODE INTEGER,'
      '1102018458=  ERR_MSG VARCHAR(1024))'
      '1102018459=AS'
      
        '1102018460=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1102018461=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1102018462=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102018463=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1102018464='
      
        '1102018465=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102018466=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1102018467=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1102018468=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102018469=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102018470=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102018471=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1102018472=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1102018473=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1102018474=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1102018475=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102018476=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1102018477=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1102018478=BEGIN'
      '1102018479='
      '1102018480=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102018481=    SELECT ID'
      '1102018482=      FROM CUR_PARAMS'
      '1102018483=     WHERE CUR_PARAMS = 2'
      '1102018484=      INTO :G_TOCHKA_;'
      '1102018485='
      
        '1102018486=  --*************************************************' +
        '*************************************************'
      
        '1102018487=  --*************************************************' +
        '*************************************************'
      '1102018488=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102018489=  --*************************************************' +
        '*************************************************'
      
        '1102018490=  --*************************************************' +
        '*************************************************'
      '1102018491=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1102018492=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1102018493=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1102018494=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102018495=            INTO :AMOUNT_,'
      '1102018496=                 :G_PRODUCT_'
      '1102018497=      DO BEGIN'
      '1102018498=          UPDATE LT_SKLAD_PRODUCT L'
      
        '1102018499=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_      ' +
        '-- 03.03.2021 '#1057#1070#1044#1040' '#1053#1045' '#1057#1058#1040#1051' '#1057#1058#1040#1042#1048#1058#1068' NEED_TO_REPLACE '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1047#1040 +
        #1063#1045#1052
      '1102018500=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102018501=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102018502=      END'
      '1102018503='
      '1102018504=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1102018505=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1102018506=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1102018507=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1102018508=             NDS_SUMM, COST_PRICE'
      '1102018509=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102018510='
      '1102018511=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102018512=                                  :Z_DATE_,'
      '1102018513=                                  :Z_TIME_,'
      '1102018514=                                  :G_CLIENT_,'
      '1102018515=                                  :G_PAYMENT_TYPE_,'
      '1102018516=                                  :OSNOVANIE_,'
      
        '1102018517=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1102018518=                                  :NOTE_,'
      
        '1102018519=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1102018520=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1102018521=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1102018522=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1102018523=                                  0, --SUMM_BONUS_'
      
        '1102018524=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1102018525=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102018526=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1102018527=                                  0,    --BY_RECIPE'
      '1102018528=                                  0     --IS_RESERVE'
      '1102018529=                                  ,NULL  -- PAYMENTS_'
      '1102018530=                                  ,0     --IS_MEBEL_'
      
        '1102018531=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1102018532=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1102018533=                                  ,NULL  --ADDRESS_'
      '1102018534=                                  ,NULL  --PRICE_'
      
        '1102018535=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      '1102018536=                                  )'
      '1102018537=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102018538='
      '1102018539=      if (ERR_CODE <> 0) then BEGIN'
      '1102018540=        ERR_CODE = -20500;'
      '1102018541=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102018542=        Exit;'
      '1102018543=      END'
      '1102018544='
      
        '1102018545=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102018546=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1102018547=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1102018548=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1102018549=      UPDATE ZAKAZ'
      '1102018550=         SET IS_SPISANIE = 2'
      '1102018551=       WHERE ZAKAZ = :ZAKAZ_;'
      '1102018552='
      
        '1102018553=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102018554=      FOR SELECT T.AMOUNT,'
      '1102018555=                 T.SUMM,'
      '1102018556=                 T.G_PRODUCT,'
      '1102018557=                 T.ZAKAZ_NA_REAL,'
      '1102018558=                 T.ZAKAZ_DETAILS'
      '1102018559=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102018560=            INTO :AMOUNT_,'
      '1102018561=                 :Z_SUMM_,'
      '1102018562=                 :G_PRODUCT_,'
      '1102018563=                 :ZAKAZ_NA_REAL_,'
      '1102018564=                 :ZAKAZ_DETAILS_'
      '1102018565=      DO BEGIN'
      '1102018566=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102018567=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1102018568=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1102018569=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102018570=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102018571='
      
        '1102018572=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102018573=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1102018574=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1102018575=      END'
      '1102018576=  END'
      '1102018577=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102018578=  --*************************************************' +
        '*************************************************'
      
        '1102018579=  --*************************************************' +
        '*************************************************'
      '1102018580='
      
        '1102018581=  --*************************************************' +
        '*************************************************'
      
        '1102018582=  --*************************************************' +
        '*************************************************'
      '1102018583=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102018584=  --*************************************************' +
        '*************************************************'
      
        '1102018585=  --*************************************************' +
        '*************************************************'
      '1102018586=  ELSE BEGIN'
      '1102018587=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1102018588=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102018589=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102018590=      FOR SELECT T.AMOUNT,'
      '1102018591=                 T.SUMM,'
      '1102018592=                 T.G_PRODUCT,'
      '1102018593=                 T.ZAKAZ_NA_REAL,'
      '1102018594=                 T.ZAKAZ_DETAILS'
      '1102018595=                 ,T.PRICE'
      '1102018596=                 ,T.NDS'
      '1102018597=                 ,T.NDS_SUMM'
      '1102018598=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102018599=            INTO :AMOUNT_,'
      '1102018600=                 :Z_SUMM_,'
      '1102018601=                 :G_PRODUCT_,'
      '1102018602=                 :ZAKAZ_NA_REAL_,'
      '1102018603=                 :ZAKAZ_DETAILS_'
      '1102018604=                 ,:PRICE_'
      '1102018605=                 ,:NDS_'
      '1102018606=                 ,:NDS_SUMM_'
      '1102018607=      DO BEGIN'
      
        '1102018608=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102018609=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1102018610='
      
        '1102018611=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1102018612=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1102018613='
      '1102018614=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102018615=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1102018616=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1102018617=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102018618=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102018619=      END'
      '1102018620='
      '1102018621=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102018622=                                  :Z_DATE_,'
      '1102018623=                                  :Z_TIME_,'
      '1102018624=                                  :G_CLIENT_,'
      '1102018625=                                  :G_PAYMENT_TYPE_,'
      '1102018626=                                  :OSNOVANIE_,'
      '1102018627=                                  :NOTE_,'
      
        '1102018628=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1102018629=                                  :SUMM_,'
      '1102018630=                                  :SUMM_FACT_,'
      
        '1102018631=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1102018632=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1102018633=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1102018634=                                  ,0        --SUMM_CU' +
        'RRENCY_'
      
        '1102018635=                                  ,0        --IS_EXPE' +
        'CTED_'
      
        '1102018636=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      
        '1102018637=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102018638='
      '1102018639=      if (ERR_CODE <> 0) then BEGIN'
      '1102018640=        ERR_CODE = -20500;'
      '1102018641=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102018642=        Exit;'
      '1102018643=      END'
      '1102018644=  END'
      '1102018645=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102018646=  --*************************************************' +
        '*************************************************'
      
        '1102018647=  --*************************************************' +
        '*************************************************'
      '1102018648='
      '1102018649=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102018650=END'
      '1102018651=;'
      '1102018652='
      '1102018653=ALTER PROCEDURE R_MADE_REVISION('
      
        '1102018654=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102018655=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102018656=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102018657=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102018658=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102018659=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '1102018660=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102018661=RETURNS ('
      '1102018662=  COUNT_SPIS_ INTEGER,'
      '1102018663=  COUNT_PRIH_ INTEGER,'
      
        '1102018664=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT' +
        '.REVISION_PARENT,'
      '1102018665=  ERR_CODE INTEGER,'
      '1102018666=  ERR_MSG VARCHAR(1024))'
      '1102018667=AS'
      
        '1102018668=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVIS' +
        'ION'#39';'
      '1102018669=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102018670=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102018671=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102018672=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102018673=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102018674=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102018675=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102018676=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102018677=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102018678=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      
        '1102018679=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REV' +
        'ISION.DATETIME_CREATED;'
      
        '1102018680=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.AMOUNT;'
      '1102018681=BEGIN'
      '1102018682='
      '1102018683=  COUNT_SPIS_ = 0;'
      '1102018684=  COUNT_PRIH_ = 0;'
      '1102018685='
      '1102018686=  PNT_ = '#39'00'#39';'
      '1102018687=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '1102018688=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGI' +
        'N_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '1102018689=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102018690='
      '1102018691=     IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102018692=       ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '1102018693=       EXIT;'
      '1102018694=     END'
      '1102018695=  END'
      '1102018696='
      '1102018697=  PNT_ = '#39'01'#39';'
      
        '1102018698=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL, DATETIME_CREATED'
      '1102018699=      FROM REVISION_TMP'
      '1102018700=      --WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102018701=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_, :DATETIME_CREATED_'
      '1102018702=  DO BEGIN'
      '1102018703=    /*SELECT SUM(ZD.AMOUNT)'
      '1102018704=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102018705=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ A' +
        'S DATE) AND CURRENT_DATE'
      
        '1102018706=       AND Z.Z_TIME >= CAST(:DATETIME_CREATED_ AS TIM' +
        'E)'
      '1102018707=       AND Z.Z_TIME <= CURRENT_TIME'
      '1102018708=       AND Z.IS_SPISANIE IN (0, 1)'
      '1102018709=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102018710=      INTO :AMOUNT_SALED_;*/'
      '1102018711='
      '1102018712=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '1102018713=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102018714=        RETURNING_VALUES :COST_PRICE_;'
      '1102018715='
      
        '1102018716=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102018717=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102018718=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/, :COST_PRICE_' +
        ', :COST_PRICE_ * (:AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_' +
        '*/), 0, 0, 0, 0, 0);'
      '1102018719='
      '1102018720=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102018721=    END'
      '1102018722='
      '1102018723=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      '1102018724=      SELECT S.price'
      '1102018725=        FROM SKLAD S'
      '1102018726=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102018727=         AND S.g_product = :G_PRODUCT_'
      '1102018728=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102018729=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102018730=                                 FROM SKLAD DD'
      
        '1102018731=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102018732=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102018733=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102018734=                                )'
      '1102018735=        ORDER BY s.sklad DESC'
      '1102018736=        ROWS 1 TO 1'
      '1102018737=        INTO :PRICE_LAST_;'
      '1102018738='
      
        '1102018739=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102018740='
      
        '1102018741=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102018742=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/, :PRICE_LAST_' +
        ', (:AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/) * :PRICE_LA' +
        'ST_, 0, 0);'
      '1102018743='
      '1102018744=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102018745=    END'
      '1102018746=  END'
      '1102018747='
      '1102018748=  PNT_ = '#39'01A'#39';'
      '1102018749=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102018750=    SELECT SUM(S.SUMM)'
      '1102018751=      FROM ZAKAZ_DETAILS_TMP S'
      '1102018752=      INTO :SUMM_;'
      '1102018753='
      '1102018754=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102018755=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102018756=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102018757=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102018758=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102018759=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102018760=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102018761=                                NULL,           --:NO' +
        'TE_,'
      
        '1102018762=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102018763=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102018764=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102018765=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102018766=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102018767=                                NULL,'
      
        '1102018768=                                0,        -- BY_RECIP' +
        'E'
      
        '1102018769=                                0         -- IS_RESER' +
        'VE'
      '1102018770=                                ,NULL  -- PAYMENTS_'
      '1102018771=                                ,0     -- SUMM_CASH'
      
        '1102018772=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102018773=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102018774=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102018775=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102018776=      EXIT;'
      '1102018777=    END'
      '1102018778=  END'
      '1102018779='
      '1102018780=  PNT_ = '#39'02'#39';'
      '1102018781=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102018782=    SELECT SUM(S.SUMM)'
      '1102018783=      FROM SKLAD_TMP S'
      '1102018784=      INTO :SUMM_;'
      '1102018785='
      '1102018786=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102018787=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102018788=                                CURRENT_TIME,'
      
        '1102018789=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102018790=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102018791=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102018792=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102018793=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102018794=                                :SUMM_,'
      '1102018795=                                :SUMM_,'
      
        '1102018796=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102018797=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102018798=                                ,NULL  --PAYMENTS'
      '1102018799=                                )'
      
        '1102018800=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102018801=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102018802=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102018803=      EXIT;'
      '1102018804=    END'
      '1102018805=  END'
      '1102018806='
      '1102018807=  UPDATE REVISION_PARENT RP'
      '1102018808=     SET RP.IS_MADE = 1,'
      '1102018809=         RP.DATE_END = :DATE_END_,'
      '1102018810=         RP.TIME_END = :TIME_END_'
      '1102018811=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '1102018812='
      '1102018813=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '1102018814=END'
      '1102018815=;'
      '1102018816='
      '1102018817=ALTER PROCEDURE R_UNIFICATION('
      '1102018818=  MODE_ INTEGER)'
      '1102018819=RETURNS ('
      '1102018820=  COUNT_SPIS_ INTEGER,'
      '1102018821=  COUNT_PRIH_ INTEGER,'
      '1102018822=  ERR_CODE INTEGER,'
      '1102018823=  ERR_MSG VARCHAR(1024))'
      '1102018824=AS'
      
        '1102018825=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1102018826=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102018827=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102018828=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102018829=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102018830=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102018831=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102018832=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102018833=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102018834=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102018835=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102018836=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102018837=BEGIN'
      '1102018838='
      '1102018839=  COUNT_SPIS_ = 0;'
      '1102018840=  COUNT_PRIH_ = 0;'
      '1102018841='
      '1102018842=  SELECT ID'
      '1102018843=    FROM CUR_PARAMS'
      '1102018844=   WHERE CUR_PARAMS = 2'
      '1102018845=    INTO :G_TOCHKA_;'
      '1102018846='
      
        '1102018847=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1102018848=      FROM REVISION'
      '1102018849=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1102018850=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1102018851=  DO BEGIN'
      
        '1102018852=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1102018853=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102018854=        RETURNING_VALUES :COST_PRICE_;'
      '1102018855='
      
        '1102018856=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102018857=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102018858=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1102018859='
      '1102018860=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102018861=    END'
      '1102018862='
      
        '1102018863=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1102018864=      SELECT S.price'
      '1102018865=        FROM SKLAD S'
      '1102018866=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102018867=         AND S.g_product = :G_PRODUCT_'
      '1102018868=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102018869=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102018870=                                 FROM SKLAD DD'
      
        '1102018871=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102018872=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102018873=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102018874=                                )'
      '1102018875=        ORDER BY s.sklad DESC'
      '1102018876=        ROWS 1 TO 1'
      '1102018877=        INTO :PRICE_LAST_;'
      '1102018878='
      '1102018879=    /* SELECT S.PRICE'
      '1102018880=        FROM SKLAD S'
      '1102018881=       WHERE S.IS_LAST = 1'
      '1102018882=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1102018883=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1102018884=        INTO :PRICE_LAST_; */'
      '1102018885='
      
        '1102018886=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102018887='
      
        '1102018888=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102018889=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1102018890='
      '1102018891=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102018892=    END'
      '1102018893='
      '1102018894=    UPDATE REVISION R'
      '1102018895=       SET R.IS_UNIFIED = 1'
      '1102018896=     WHERE R.REVISION = :REVISION_;'
      '1102018897=  END'
      '1102018898='
      '1102018899=  PNT_ = '#39'01'#39';'
      '1102018900=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102018901=    SELECT SUM(S.SUMM)'
      '1102018902=      FROM ZAKAZ_DETAILS_TMP S'
      '1102018903=      INTO :SUMM_;'
      '1102018904='
      '1102018905=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102018906=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102018907=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102018908=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102018909=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102018910=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102018911=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102018912=                                NULL,           --:NO' +
        'TE_,'
      
        '1102018913=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102018914=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102018915=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102018916=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102018917=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102018918=                                NULL,'
      
        '1102018919=                                0,        -- BY_RECIP' +
        'E'
      
        '1102018920=                                0         -- IS_RESER' +
        'VE'
      '1102018921=                                ,NULL  -- PAYMENTS_'
      '1102018922=                                ,0     -- SUMM_CASH'
      
        '1102018923=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102018924=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102018925=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102018926=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102018927=      EXIT;'
      '1102018928=    END'
      '1102018929=  END'
      '1102018930='
      '1102018931=  PNT_ = '#39'02'#39';'
      '1102018932=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102018933=    SELECT SUM(S.SUMM)'
      '1102018934=      FROM SKLAD_TMP S'
      '1102018935=      INTO :SUMM_;'
      '1102018936='
      '1102018937=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102018938=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102018939=                                CURRENT_TIME,'
      
        '1102018940=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102018941=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102018942=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102018943=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102018944=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102018945=                                :SUMM_,'
      '1102018946=                                :SUMM_,'
      
        '1102018947=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102018948=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102018949=                                ,NULL  --PAYMENTS'
      '1102018950=                                )'
      
        '1102018951=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102018952=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102018953=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102018954=      EXIT;'
      '1102018955=    END'
      '1102018956=  END'
      '1102018957=END'
      '1102018958=;'
      '1102018959='
      '1102018960='
      
        '1102018961=UPDATE SYSTEM_SETUP SET S_VALUE = 110201 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102018962=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102018963=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102020='
      '1102021=ALTER PROCEDURE K_RECALC_KASSA('
      '1102022=  ACTION_DATE_ DATE,'
      
        '1102023=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
