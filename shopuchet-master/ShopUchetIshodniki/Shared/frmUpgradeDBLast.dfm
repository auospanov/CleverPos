        '1102012074=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PR' +
        'IHOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '1102012075=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102012076=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102012077=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1102012078=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102012079=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102012080=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1102012081=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102012082=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102012083=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1102012084=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1102012085=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1102012086=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1102012087=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK' +
        '_CODE;'
      '1102012088=BEGIN'
      '1102012089='
      '1102012090=  PNT_ = '#39'00'#39';'
      '1102012091=  IS_THIS_LAST_ = 0;'
      '1102012092='
      '1102012093=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102012094=    SELECT ID'
      '1102012095=      FROM CUR_PARAMS'
      '1102012096=     WHERE CUR_PARAMS = 2'
      '1102012097=      INTO :G_TOCHKA_;'
      '1102012098='
      '1102012099=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1102012100=  IF (G_OFFICIAL_ IS NULL) THEN'
      '1102012101=      SELECT ID'
      '1102012102=        FROM CUR_PARAMS'
      '1102012103=       WHERE CUR_PARAMS = 1'
      '1102012104=        INTO :G_OFFICIAL_;'
      '1102012105='
      '1102012106=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '1102012107=                            DATE_RECEIPT,'
      '1102012108=                            TIME_RECEIPT,'
      '1102012109=                            G_CLIENT,'
      '1102012110=                            G_PAYMENT_TYPE,'
      '1102012111=                            OSNOVANIE,'
      '1102012112=                            NOTE,'
      '1102012113=                            SUMM,'
      '1102012114=                            SUMM_FACT,'
      '1102012115=                            SUMM_CURRENCY,'
      '1102012116=                            IS_PAYED_ALL,'
      '1102012117=                            IS_VOZVRAT,'
      '1102012118=                            G_TOCHKA'
      '1102012119=                            ,G_OFFICIAL'
      '1102012120=                            ,IS_EXPECTED'
      '1102012121=                            ,REC_ID)'
      '1102012122=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1102012123=          :DATE_RECEIPT_,'
      '1102012124=          :TIME_RECEIPT_,'
      '1102012125=          :G_CLIENT_,'
      '1102012126=          :G_PAYMENT_TYPE_,'
      '1102012127=          :OSNOVANIE_,'
      '1102012128=          :NOTE_,'
      '1102012129=          :SUMM_,'
      '1102012130=          :SUMM_FACT_,'
      '1102012131=          :SUMM_CURRENCY_,'
      
        '1102012132=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE' +
        ' 0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045 +
        #1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102012133=          :IS_VOZVRAT_,'
      '1102012134=          :G_TOCHKA_'
      '1102012135=          ,:G_OFFICIAL_'
      '1102012136=          ,:IS_EXPECTED_'
      '1102012137=          ,:REC_ID_)'
      '1102012138=  RETURNING'
      '1102012139=    SKLAD'
      '1102012140=  INTO'
      '1102012141=    :SKLAD_;'
      '1102012142='
      '1102012143=  PNT_ = '#39'01'#39';'
      '1102012144=  FOR SELECT SKLAD,'
      '1102012145=             T.G_PRODUCT,'
      '1102012146=             AMOUNT,'
      '1102012147=             T.PRICE,'
      '1102012148=             SUMM,'
      '1102012149=             NDS,'
      '1102012150=             NDS_SUMM'
      '1102012151=             ,PRICE_CURRENCY'
      '1102012152=             ,SUMM_CURRENCY'
      '1102012153=             ,PRICE_ROZN'
      '1102012154=             ,GG.PRICE'
      '1102012155=             ,T.MARK_CODE'
      '1102012156=        FROM SKLAD_TMP T,'
      '1102012157=             G_PRODUCT GG'
      '1102012158=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '1102012159=      ORDER BY 1'
      '1102012160=      INTO :SKLAD_TMP_,'
      '1102012161=           :RG_PRODUCT_,'
      '1102012162=           :RAMOUNT_,'
      '1102012163=           :RPRICE_,'
      '1102012164=           :RSUMM_,'
      '1102012165=           :RNDS_,'
      '1102012166=           :RNDS_SUMM_'
      '1102012167=           ,:PRICE_CURRENCY_'
      '1102012168=           ,:SUMM_CURRENCY_TMP_'
      '1102012169=           ,:SALE_PRICE_'
      '1102012170=           ,:SALE_PRICE_CUR_'
      '1102012171=           ,:MARK_CODE_'
      '1102012172=  DO BEGIN'
      '1102012173=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '1102012174=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST,' +
        ' '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102012175=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051 +
        #1068#1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '1102012176=      IS_THIS_LAST_ = 0;'
      '1102012177=      SELECT MAX(SK.DATE_RECEIPT)'
      '1102012178=        FROM SKLAD SK'
      '1102012179=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1102012180=         AND SK.IS_LAST = 1'
      '1102012181=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102012182=        INTO :DATE_LAST_;'
      '1102012183='
      
        '1102012184=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102012185=        UPDATE SKLAD SK'
      '1102012186=           SET SK.IS_LAST = 0'
      '1102012187=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1102012188=           AND SK.IS_LAST = 1'
      '1102012189=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102012190='
      '1102012191=        IS_THIS_LAST_ = 1;'
      '1102012192=      END'
      '1102012193=    END'
      '1102012194='
      '1102012195=    INSERT INTO SKLAD'
      '1102012196=    ('
      '1102012197=     SKLAD,'
      '1102012198=     SKLAD_PARENT,'
      '1102012199=     DATE_RECEIPT,'
      '1102012200=     G_CLIENT,'
      '1102012201=     G_PRODUCT,'
      '1102012202=     AMOUNT,'
      '1102012203=     PRICE,'
      '1102012204=     SUMM,'
      '1102012205=     G_PAYMENT_TYPE,'
      '1102012206=     OSNOVANIE,'
      '1102012207=     NOTE,'
      '1102012208=     NDS,'
      '1102012209=     NDS_SUMM,'
      '1102012210=     IS_LAST,'
      '1102012211=     IS_VOZVRAT,'
      '1102012212=     G_TOCHKA'
      '1102012213=     ,PRICE_CURRENCY'
      '1102012214=     ,SUMM_CURRENCY'
      '1102012215=     ,MARK_CODE'
      '1102012216=    ) VALUES ('
      '1102012217=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1102012218=     :SKLAD_,'
      '1102012219=     :DATE_RECEIPT_,'
      '1102012220=     :G_CLIENT_,'
      '1102012221=     :RG_PRODUCT_,'
      '1102012222=     :RAMOUNT_,'
      '1102012223=     :RPRICE_,'
      '1102012224=     :RSUMM_,'
      '1102012225=     :G_PAYMENT_TYPE_,'
      '1102012226=     :OSNOVANIE_,'
      '1102012227=     :NOTE_,'
      '1102012228=     :RNDS_,'
      '1102012229=     :RNDS_SUMM_,'
      
        '1102012230=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056 +
        #1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059 +
        #1044#1045#1058' 0'
      '1102012231=     :IS_VOZVRAT_,'
      '1102012232=     :G_TOCHKA_'
      '1102012233=     ,:PRICE_CURRENCY_'
      '1102012234=     ,:SUMM_CURRENCY_TMP_'
      '1102012235=     ,:MARK_CODE_'
      '1102012236=    );'
      '1102012237='
      
        '1102012238=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1102012239=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102012240=        PNT_ = '#39'02'#39';'
      '1102012241=        UPDATE LT_SKLAD_PRODUCT L'
      '1102012242=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '1102012243=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102012244=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1102012245=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102012246='
      '1102012247=        IF (ROW_COUNT = 0) THEN'
      
        '1102012248=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT' +
        ')'
      
        '1102012249=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :R' +
        'G_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102012250=    END'
      '1102012251='
      
        '1102012252=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061 +
        #1054#1044#1045
      '1102012253=      UPDATE G_PRODUCT G'
      '1102012254=         SET G.PRICE = :SALE_PRICE_'
      '1102012255=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '1102012256=  END'
      '1102012257=  ----------------------------------------'
      '1102012258='
      
        '1102012259=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1102012260=  PNT_ = '#39'05'#39';'
      
        '1102012261=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1102012262=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1102012263=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102012264=      ELSE'
      '1102012265=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1102012266='
      
        '1102012267=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1102012268=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1102012269=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102012270=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1102012271=                                        :SUMM_FACT_,'
      
        '1102012272=                                        :DATE_RECEIPT' +
        '_,'
      
        '1102012273=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1102012274=                                        NULL,   --ZAK' +
        'AZ_'
      '1102012275=                                        :SKLAD_,'
      
        '1102012276=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1102012277=                                        :G_TOCHKA_,'
      
        '1102012278=                                        :UPLOAD_TO_EX' +
        'T_APP_'
      
        '1102012279=                                        ) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102012280=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102012281=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102012282=            EXIT;'
      '1102012283=          END'
      '1102012284=      END ELSE BEGIN'
      '1102012285=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102012286=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102012287=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102012288=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102012289=            ELSE'
      
        '1102012290=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102012291='
      '1102012292=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102012293=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102012294='
      
        '1102012295=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102012296='
      '1102012297=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102012298=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102012299=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1102012300=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1102012301=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1102012302=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102012303=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1102012304=                                              :SKLAD_' +
        ','
      
        '1102012305=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1102012306=                                              :G_TOCH' +
        'KA_,'
      
        '1102012307=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102012308=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102012309=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102012310=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102012311=                  EXIT;'
      '1102012312=                END'
      '1102012313=            END'
      '1102012314=          END'
      '1102012315=      END'
      '1102012316=  END'
      '1102012317='
      '1102012318=  DELETE FROM SKLAD_TMP;'
      '1102012319='
      
        '1102012320=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1102012321=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102012322=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1102012323=                                  G_PRIHOD_,'
      '1102012324=                                  :SUMM_PRIHOD_,'
      '1102012325=                                  :DATE_RECEIPT_,'
      
        '1102012326=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102012327=                                  NULL,   --:ZAKAZ_,'
      '1102012328=                                  :SKLAD_,'
      '1102012329=                                  :G_PAYMENT_TYPE_,'
      '1102012330=                                  :G_TOCHKA_,'
      '1102012331=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102012332=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102012333=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102012334=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102012335=      EXIT;'
      '1102012336=    END'
      '1102012337=  END'
      '1102012338='
      
        '1102012339=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102012340=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, ' +
        '1, 2)) THEN'
      
        '1102012341=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      '1102012342=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '1102012343=            2,'
      '1102012344=            :SKLAD_,'
      '1102012345=            1,'
      
        '1102012346=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1' +
        ' ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052 +
        ' '#1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102012347=           );'
      '1102012348='
      '1102012349=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102012350=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1102012351=END'
      '1102012352=;'
      '1102012353='
      '1102012354=ALTER PROCEDURE INS_ZAKAZ('
      '1102012355=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102012356=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102012357=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102012358=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102012359=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102012360=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102012361=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102012362=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102012363=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102012364=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102012365=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102012366=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102012367=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102012368=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102012369=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102012370=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102012371=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102012372=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102012373=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102012374=  IS_MEBEL_ INTEGER = 0,'
      
        '1102012375=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1102012376=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      
        '1102012377=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      '1102012378=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1102012379=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102012380=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102012381=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102012382=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102012383=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102012384=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL)'
      '1102012385=RETURNS ('
      '1102012386=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102012387=  ERR_CODE INTEGER,'
      '1102012388=  ERR_MSG VARCHAR(1024))'
      '1102012389=AS'
      '1102012390=/*'
      '1102012391=IS_SPISANIE_'
      '1102012392=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102012393=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102012394=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102012395=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102012396='
      '1102012397='
      
        '1102012398=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102012399=*/'
      '1102012400=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1102012401=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102012402=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102012403=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1102012404=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1102012405=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1102012406=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1102012407=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1102012408=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1102012409=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1102012410=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1102012411=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1102012412=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1102012413=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1102012414=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '1102012415=DECLARE VARIABLE CNT_ INTEGER;'
      '1102012416=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1102012417=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1102012418=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102012419=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102012420=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1102012421=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102012422=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102012423=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1102012424=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102012425=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1102012426=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1102012427=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102012428=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102012429=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102012430=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLI' +
        'ENT.SKIDKA;'
      
        '1102012431=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.N_PERCENT;'
      
        '1102012432=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DI' +
        'SCONT_CARD.SUMM_ALL;'
      
        '1102012433=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.MARK_CODE;'
      '1102012434=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102012435=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1102012436=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1102012437=BEGIN'
      '1102012438='
      
        '1102012439=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1102012440=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1102012441=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1102012442=  IF (CNT_ = 0) THEN BEGIN'
      '1102012443=    ERR_CODE = -20500;'
      
        '1102012444=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1102012445=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1102012446=    EXIT;'
      '1102012447=  END'
      '1102012448='
      '1102012449=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102012450=    SELECT ID'
      '1102012451=      FROM CUR_PARAMS'
      '1102012452=     WHERE CUR_PARAMS = 2'
      '1102012453=      INTO :G_TOCHKA_;'
      '1102012454='
      '1102012455=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102012456=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1102012457=      PNT_ = '#39'01'#39';'
      
        '1102012458=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102012459=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102012460=      ELSE'
      '1102012461=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102012462='
      '1102012463=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1102012464=      SELECT G.G_OFFICIAL,'
      '1102012465=             G.DO_NOT_SALES_COMM,'
      '1102012466=             G.FM||'#39' '#39'||G.NM'
      '1102012467=        FROM G_OFFICIAL G'
      
        '1102012468=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1102012469=        INTO :G_OFFICIAL_,'
      '1102012470=             :DO_NOT_SALES_COMM_,'
      '1102012471=             :OFFICIAL_NAME_;'
      '1102012472='
      '1102012473=      INSERT INTO ZAKAZ'
      '1102012474=      ('
      '1102012475=       ZAKAZ,'
      '1102012476=       G_TOCHKA,'
      '1102012477=       Z_DATE,'
      '1102012478=       Z_TIME,'
      '1102012479=       G_CLIENT,'
      '1102012480=       G_PAYMENT_TYPE,'
      '1102012481=       OSNOVANIE,'
      '1102012482=       IS_SPISANIE,'
      '1102012483=       NOTE,'
      '1102012484=       SUMM,'
      '1102012485=       SUMM_FACT,'
      '1102012486=       SUMM_BONUS,'
      '1102012487=       IS_PAYED_ALL'
      '1102012488=       ,G_OFFICIAL'
      '1102012489=       ,BY_RECIPE'
      '1102012490=       ,SUMM_BONUS_GOT'
      '1102012491=       ,IS_RESERVE'
      '1102012492=       ,SUMM_CASH'
      '1102012493=       ,SUMM_NONCASH'
      '1102012494=       ,NOT_MINUS_OSTATOK'
      '1102012495=       ,DELIVERY_ADDRESS'
      '1102012496=       ,REC_ID'
      '1102012497=      ) VALUES ('
      '1102012498=       GEN_ID(GEN_ZAKAZ, 1),'
      '1102012499=       :G_TOCHKA_,'
      '1102012500=       :Z_DATE_,'
      '1102012501=       :Z_TIME_,'
      '1102012502=       :G_CLIENT_,'
      '1102012503=       :G_PAYMENT_TYPE_,'
      '1102012504=       :OSNOVANIE_,'
      '1102012505=       :IS_SPISANIE_,'
      '1102012506=       :NOTE_,'
      '1102012507=       :SUMM_,'
      '1102012508=       :SUMM_FACT_1_,'
      '1102012509=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1102012510=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102012511=       ,:G_OFFICIAL_'
      '1102012512=       ,:BY_RECIPE_'
      '1102012513=       ,:SUMM_BONUS_GOT_'
      '1102012514=       ,:IS_RESERVE_'
      '1102012515=       ,COALESCE(:SUMM_CASH_, 0)'
      '1102012516=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1102012517=       ,:NOT_MINUS_OSTATOK_'
      '1102012518=       ,:ADDRESS_'
      '1102012519=       ,:REC_ID_'
      '1102012520=      )'
      '1102012521=      RETURNING'
      '1102012522=        ZAKAZ'
      '1102012523=      INTO'
      '1102012524=        :ZAKAZ_;'
      '1102012525='
      '1102012526=      PNT_ = '#39'02'#39';'
      
        '1102012527=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1102012528=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM, Z.MARK_CODE'
      '1102012529=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1102012530=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1102012531=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1102012532=              :G_PRODUCT,'
      '1102012533=              :AMOUNT,'
      '1102012534=              :PRICE,'
      '1102012535=              :SUMM,'
      '1102012536=              :DISCOUNT_PERC,'
      '1102012537=              :DISCOUNT_TENGE,'
      '1102012538=              :DISCOUNT_SUMM,'
      '1102012539=              :NDS,'
