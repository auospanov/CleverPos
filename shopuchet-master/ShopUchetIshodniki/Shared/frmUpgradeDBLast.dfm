        'G);'
      '1102017098=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017099=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102017100=            EXIT;'
      '1102017101=          END'
      '1102017102='
      '1102017103=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102017104=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102017105=                FROM ZAKAZ_DETAILS_TMP Z'
      '1102017106=              INTO :G_PRODUCT_,'
      '1102017107=                  :Z_AMOUNT_,'
      '1102017108=                  :PRICE_,'
      '1102017109=                  :SUMMM_'
      '1102017110=          DO BEGIN'
      '1102017111=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102017112=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1102017113=            IS_THIS_LAST_ = 0;'
      '1102017114=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102017115=                FROM SKLAD SK'
      '1102017116=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102017117=                 AND SK.IS_LAST = 1'
      '1102017118=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1102017119=                INTO :DATE_LAST_;'
      '1102017120='
      
        '1102017121=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102017122=                UPDATE SKLAD SK'
      '1102017123=                   SET SK.IS_LAST = 0'
      '1102017124=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102017125=                   AND SK.IS_LAST = 1'
      '1102017126=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102017127='
      '1102017128=                IS_THIS_LAST_ = 1;'
      '1102017129=            END'
      '1102017130='
      '1102017131='
      '1102017132=            INSERT INTO SKLAD'
      '1102017133=            ('
      '1102017134=             SKLAD,'
      '1102017135=             SKLAD_PARENT,'
      '1102017136=             DATE_RECEIPT,'
      '1102017137=             G_CLIENT,'
      '1102017138=             G_PRODUCT,'
      '1102017139=             AMOUNT,'
      '1102017140=             PRICE,'
      '1102017141=             SUMM,'
      '1102017142=             G_PAYMENT_TYPE,'
      '1102017143=             OSNOVANIE,'
      '1102017144=             NOTE,'
      '1102017145=             NDS,'
      '1102017146=             NDS_SUMM,'
      '1102017147=             IS_LAST,'
      '1102017148=             IS_VOZVRAT,'
      '1102017149=             G_TOCHKA'
      '1102017150=            ) VALUES ('
      '1102017151=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102017152=             :ZAKAZ_,'
      '1102017153=             :Z_DATE_,'
      '1102017154=             :G_TOCHKA_,'
      '1102017155=             :G_PRODUCT_,'
      '1102017156=             :Z_AMOUNT_,'
      '1102017157=             :PRICE_,'
      '1102017158=             :SUMMM_,'
      '1102017159=             :G_PAYMENT_TYPE_,'
      '1102017160=             :OSNOVANIE_,'
      '1102017161=             :NOTE_,'
      '1102017162=             0,  --:RNDS_,'
      '1102017163=             0,  --:RNDS_SUMM_,'
      
        '1102017164=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1102017165=             3,  --:IS_VOZVRAT_,'
      '1102017166=             :G_CLIENT_'
      '1102017167=            );'
      '1102017168='
      
        '1102017169=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1102017170=            UPDATE LT_SKLAD_PRODUCT L'
      '1102017171=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_,'
      
        '1102017172=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102017173=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017174=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102017175='
      
        '1102017176=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1102017177=            PNT_ = '#39'023'#39';'
      '1102017178=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102017179=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017180=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_,'
      
        '1102017181=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102017182=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017183=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1102017184='
      '1102017185=                IF (ROW_COUNT = 0) THEN'
      
        '1102017186=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102017187=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102017188=            END'
      '1102017189=          END'
      '1102017190=      END'
      '1102017191=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1102017192=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1102017193=      ELSE BEGIN'
      
        '1102017194=          -------------------------------------------' +
        '------------------'
      
        '1102017195=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1102017196=          PNT_ = '#39'025'#39';'
      '1102017197=          FOR SELECT SKLAD,'
      '1102017198=                     AMOUNT,'
      '1102017199=                     G_PRODUCT'
      '1102017200=                FROM SKLAD S'
      '1102017201=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1102017202=                 AND NOT EXISTS (SELECT 1'
      
        '1102017203=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1102017204=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1102017205=          INTO :SKLAD_,'
      '1102017206=               :Z_AMOUNT_,'
      '1102017207=               :G_PRODUCT_'
      '1102017208=          DO BEGIN'
      
        '1102017209=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :E' +
        'RR_MSG);'
      '1102017210=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017211=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102017212=              EXIT;'
      '1102017213=            END'
      '1102017214=          END'
      '1102017215='
      '1102017216=          PNT_ = '#39'030'#39';'
      '1102017217=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1102017218=                     S.G_PRODUCT,'
      '1102017219=                     S.AMOUNT,'
      '1102017220=                     S.PRICE,'
      '1102017221=                     S.SUMM,'
      '1102017222=                     T.SKLAD,'
      '1102017223=                     T.AMOUNT,'
      '1102017224=                     T.IS_LAST,'
      '1102017225=                     T.DATE_RECEIPT'
      
        '1102017226=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1102017227=                INTO :ZAKAZ_DETAILS_,'
      '1102017228=                     :G_PRODUCT_,'
      '1102017229=                     :Z_AMOUNT_,'
      '1102017230=                     :PRICE_,'
      '1102017231=                     :SUMMM_,'
      '1102017232=                     :SKLAD_OLD_,'
      '1102017233=                     :AMOUNT_OLD_,'
      '1102017234=                     :IS_THIS_LAST_,'
      '1102017235=                     :DATE_RECEIPT_OLD_'
      '1102017236=          DO BEGIN'
      
        '1102017237=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102017238=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1102017239=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1102017240=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1102017241=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1102017242=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102017243=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1102017244=                       )'
      '1102017245=                RETURNING'
      '1102017246=                  SKLAD'
      '1102017247=                INTO'
      '1102017248=                  :SKLAD_;'
      '1102017249='
      
        '1102017250=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102017251=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017252=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1102017253=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102017254=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017255=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102017256='
      
        '1102017257=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1102017258=                IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGI' +
        'N'
      '1102017259=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102017260=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_,'
      
        '1102017261=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102017262=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102017263=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102017264='
      '1102017265=                    IF (ROW_COUNT = 0) THEN'
      
        '1102017266=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102017267=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_AP' +
        'P_);'
      '1102017268=                END'
      '1102017269='
      
        '1102017270=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102017271=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045 +
        #1053#1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042 +
        #1051#1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1102017272=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_S' +
        'KLAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1102017273=                /*SELECT MAX(SK.DATE_RECEIPT)'
      '1102017274=                  FROM SKLAD SK'
      '1102017275=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102017276=                   AND SK.IS_LAST = 1'
      '1102017277=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '1102017278=                  INTO :DATE_LAST_;'
      '1102017279='
      
        '1102017280=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ ' +
        '>= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102017281=                  UPDATE SKLAD SK'
      '1102017282=                     SET SK.IS_LAST = 0'
