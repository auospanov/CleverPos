      '11049298=                     G.G_UNIT = :G_UNIT_,'
      '11049299=                     G.PRICE  = :PRICE_,'
      '11049300=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11049301=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11049302=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11049303=                     G.PLACE = :PLACE_,'
      
        '11049304=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11049305=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11049306=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11049307=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11049308='
      
        '11049309=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.' +
        #39#39';'
      '11049310=            END ELSE'
      
        '11049311=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11049312=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' ' +
        '- '#39#39'||G_PRODUCT_NAME_||'#39#39'.'#39#39';'
      '11049313=        END'
      '11049314=    end'
      '11049315='
      
        '11049316=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11049317=    PNT_ = '#39#39'02b'#39#39';'
      
        '11049318=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11049319=        SELECT G.G_PRODUCT,'
      '11049320=               G.NAME'
      '11049321=          FROM G_PRODUCT G'
      '11049322=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11049323=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '11049324=          INTO :G_PRODUCT_,'
      '11049325=               :G_PRODUCT_NAME_;'
      '11049326='
      '11049327=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11049328=          SELECT G.G_PRODUCT,'
      '11049329=                 G.NAME'
      '11049330=            FROM G_PRODUCT G, LT_BARCODE L'
      '11049331=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11049332=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11049333=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '11049334=            INTO :G_PRODUCT_,'
      '11049335=                 :G_PRODUCT_NAME_;'
      '11049336='
      
        '11049337=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11049338=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11049339=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11049340=              UPDATE G_PRODUCT G'
      '11049341=                 SET G.NAME = :NAME_,'
      '11049342=                     G.G_UNIT = :G_UNIT_,'
      '11049343=                     G.PRICE  = :PRICE_,'
      '11049344=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11049345=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11049346=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11049347=                     G.PLACE = :PLACE_,'
      
        '11049348=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11049349=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11049350=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11049351=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11049352='
      
        '11049353=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        #39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '11049354=            END ELSE'
      
        '11049355=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11049356=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODUC' +
        'T_NAME_||'#39#39'.'#39#39';'
      '11049357=        END'
      '11049358=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN'
      
        '11049359=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RETU' +
        'RNING_VALUES (:BARCODE_);'
      '11049360='
      '11049361=    PNT_ = '#39#39'02b'#39#39';'
      '11049362=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '11049363=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR' +
        ', ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME' +
        '_PRICE,'
      
        '11049364=                               IS_CATEGORY, PACK_AMOUNT' +
        ', MF_COUNTRY, NOTE, PLACE)'
      
        '11049365=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PA' +
        'R_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :' +
        'PRICE_,'
      
        '11049366=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_C' +
        'OUNTRY_, :NOTE_, :PLACE_)'
      '11049367=        returning G_PRODUCT'
      '11049368=        into :G_PRODUCT_;'
      '11049369='
      
        '11049370=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11049371=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, 0, :G_TOCHKA_);'
      '11049372=    end'
      '11049373='
      
        '11049374=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045#1051 +
        #1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11049375=    PNT_ = '#39#39'03'#39#39';'
      '11049376=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '11049377=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '11049378=                                       :AMOUNT_,'
      '11049379=                                       :SELF_PRICE_,'
      
        '11049380=                                       :AMOUNT_ * :SELF' +
        '_PRICE_,'
      '11049381=                                       0, --nds_,'
      '11049382=                                       0 --nds_summ_,'
      '11049383=                                       ,:SELF_PRICE_UE_'
      
        '11049384=                                       ,:AMOUNT_ * :SEL' +
        'F_PRICE_UE_'
      
        '11049385=                                       ) RETURNING_VALU' +
        'ES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '11049386=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11049387=          ERR_MSG  = '#39#39' PNT_ '#39#39'||PNT_||'#39#39' -> '#39#39'||ERR_MS' +
        'G;'
      '11049388=          EXIT;'
      '11049389=        END'
      '11049390=    END'
      '11049391='
      
        '11049392=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' ' +
        #1047#1040#1055#1048#1057#1068
      '11049393=    PNT_ = '#39#39'04'#39#39';'
      '11049394=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '11049395=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061#1054 +
        #1044
      '11049396=        FROM SKLAD_TMP T'
      '11049397=        INTO :CNT_;'
      '11049398='
      '11049399=      if (CNT_ > 0) then BEGIN'
      '11049400=        SELECT SUM(T.SUMM)'
      '11049401=          FROM SKLAD_TMP T'
      '11049402=          INTO :SUMM_;'
      '11049403='
      '11049404=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '11049405=                                DATE_RECEIPT,'
      '11049406=                                TIME_RECEIPT,'
      '11049407=                                G_CLIENT,'
      '11049408=                                G_PAYMENT_TYPE,'
      '11049409=                                OSNOVANIE,'
      '11049410=                                NOTE,'
      '11049411=                                SUMM,'
      '11049412=                                SUMM_FACT,'
      '11049413=                                IS_PAYED_ALL,'
      '11049414=                                IS_VOZVRAT,'
      '11049415=                                G_TOCHKA)'
      '11049416=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11049417=                CURRENT_DATE,'
      '11049418=                CURRENT_TIME,'
      '11049419=                :G_CLIENT_,'
      '11049420=                1,'
      '11049421=                NULL,  --:OSNOVANIE_,'
      '11049422=                NULL,  -- :NOTE_,'
      '11049423=                :SUMM_,'
      '11049424=                :SUMM_,'
      
        '11049425=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040 +
        ' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11049426=                0,'
      '11049427=                :G_TOCHKA_)'
      '11049428=        RETURNING'
      '11049429=          SKLAD'
      '11049430=        INTO'
      '11049431=          :SKLAD_PARENT_;'
      '11049432='
      '11049433=        PNT_ = '#39#39'05'#39#39';'
      '11049434=        FOR SELECT SKLAD,'
      '11049435=                   G_PRODUCT,'
      '11049436=                   AMOUNT,'
      '11049437=                   PRICE,'
      '11049438=                   SUMM'
      '11049439=                   ,PRICE_CURRENCY'
      '11049440=                   ,SUMM_CURRENCY'
      '11049441=              FROM SKLAD_TMP'
      '11049442=             ORDER BY 1'
      '11049443=              INTO :SKLAD_TMP_,'
      '11049444=                   :RG_PRODUCT_,'
      '11049445=                   :RAMOUNT_,'
      '11049446=                   :RPRICE_,'
      '11049447=                   :RSUMM_'
      '11049448=                   ,:RPRICE_UE_'
      '11049449=                   ,:RSUMM_UE_'
      '11049450=        DO BEGIN'
      '11049451='
      '11049452=            UPDATE SKLAD SK'
      '11049453=               SET SK.IS_LAST = 0'
      '11049454=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11049455=               AND SK.IS_LAST = 1;'
      '11049456='
      '11049457=            INSERT INTO SKLAD'
      '11049458=            ('
      '11049459=             SKLAD,'
      '11049460=             SKLAD_PARENT,'
      '11049461=             DATE_RECEIPT,'
      '11049462=             G_CLIENT,'
      '11049463=             G_PRODUCT,'
      '11049464=             AMOUNT,'
      '11049465=             PRICE,'
      '11049466=             SUMM,'
      '11049467=             G_PAYMENT_TYPE,'
      '11049468=             OSNOVANIE,'
      '11049469=             NOTE,'
      '11049470=             NDS,'
      '11049471=             NDS_SUMM,'
      '11049472=             IS_LAST,'
      '11049473=             IS_VOZVRAT,'
      '11049474=             G_TOCHKA'
      '11049475=             ,PRICE_CURRENCY'
      '11049476=             ,SUMM_CURRENCY'
      '11049477=            ) VALUES ('
      '11049478=             :SKLAD_TMP_,'
      '11049479=             :SKLAD_PARENT_,'
      '11049480=             CURRENT_DATE,'
      '11049481=             :G_CLIENT_,'
      '11049482=             :RG_PRODUCT_,'
      '11049483=             :RAMOUNT_,'
      '11049484=             :RPRICE_,'
      '11049485=             :RSUMM_,'
      '11049486=             1,       --:G_PAYMENT_TYPE_,'
      '11049487=             NULL,    --:OSNOVANIE_,'
      '11049488=             NULL,    --:NOTE_,'
      '11049489=             0,       --:RNDS_,'
      '11049490=             0,       --:RNDS_SUMM_,'
      '11049491=             1,       --IS_LAST_'
      '11049492=             0,        --:IS_VOZVRAT_'
      '11049493=             :G_TOCHKA_'
      '11049494=             ,:RPRICE_UE_'
      '11049495=             ,:RSUMM_UE_'
      '11049496=            );'
      '11049497='
      
        '11049498=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11049499=            PNT_ = '#39#39'06'#39#39';'
      '11049500=            UPDATE LT_SKLAD_PRODUCT L'
      '11049501=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11049502=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11049503=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11049504='
      '11049505=            PNT_ = '#39#39'06a'#39#39';'
      '11049506=            IF (ROW_COUNT = 0) THEN'
      
        '11049507=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11049508=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11049509=        END'
      '11049510='
      '11049511=        PNT_ = '#39#39'07'#39#39';'
      
        '11049512=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_' +
        ' => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11049513=                                2,    --:G_PRIHOD_RASHO' +
        'D_,'
      '11049514=                                :SUMM_,'
      '11049515=                                CURRENT_DATE,'
      
        '11049516=                                NULL,   --NOTE_ => :NOT' +
        'E_,'
      '11049517=                                NULL,   --ZAKAZ_'
      '11049518=                                :SKLAD_PARENT_,'
      '11049519=                                1,'
      
        '11049520=                                :G_TOCHKA_) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11049521=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11049522=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39 +
        #39'||ERR_MSG;'
      '11049523=          EXIT;'
      '11049524=        END'
      '11049525='
      '11049526=        DELETE FROM SKLAD_TMP;'
      '11049527=      END'
      '11049528=    END'
      '11049529='
      
        '11049530=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054#1069 +
        #1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '11049531=    if (ERR_MSG_ IS NOT NULL) then'
      '11049532=      ERR_MSG = ERR_MSG_;'
      '11049533='
      '11049534=WHEN ANY DO BEGIN'
      '11049535=    Err_code = gdscode;'
      
        '11049536=    ERR_MSG = '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39#39'||gdscode||'#39#39 +
        ' --> PNT_ '#39#39'||PNT_;'
      '11049537=  END'
      '11049538=END'
      '11049539='#39';'
      '11049540='
      
        '11049541=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_READ_G_OFFICIAL_LI' +
        'ST'
      '11049542=RETURNS ('
      '11049543=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11049544=  FM TYPE OF COLUMN G_OFFICIAL.FM,'
      '11049545=  NM TYPE OF COLUMN G_OFFICIAL.NM,'
      '11049546=  FT TYPE OF COLUMN G_OFFICIAL.FT,'
      '11049547=  FIO VARCHAR(200),'
      '11049548=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11049549=  RNN TYPE OF COLUMN G_OFFICIAL.RNN,'
      '11049550=  IDN TYPE OF COLUMN G_OFFICIAL.IDN,'
      '11049551=  DT TYPE OF COLUMN G_OFFICIAL.DT,'
      '11049552=  G_ID_KIND TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '11049553=  ID_NUM TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '11049554=  ID_DATE TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '11049555=  ID_ISSUER TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '11049556=  G_APPOINTMENT TYPE OF COLUMN G_OFFICIAL.G_APPOINTMENT' +
        ','
      
        '11049557=  IS_RUKOVODITEL TYPE OF COLUMN G_OFFICIAL.IS_RUKOVODIT' +
        'EL,'
      '11049558=  IS_GLAVBUH TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      '11049559=  APP_NAME TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '11049560=  PASS TYPE OF COLUMN G_OFFICIAL.PASS)'
      '11049561=AS'
      '11049562=begin'
      '11049563=    FOR'
      '11049564=    SELECT t.G_OFFICIAL,'
      '11049565=           T.FM,'
      '11049566=           T.NM,'
      '11049567=           T.FT,'
      '11049568=           T.FM||'#39#39' '#39#39'||T.NM||'#39#39' '#39#39'||T.FT,'
      
        '11049569=           DECODE(CHAR_LENGTH(T.FIO_DOC), 0, T.FM||'#39#39' '#39 +
        #39'||T.NM||'#39#39' '#39#39'||T.FT, T.FIO_DOC),'
      '11049570=           T.RNN,'
      '11049571=           T.IDN,'
      '11049572=           T.DT,'
      '11049573=           T.G_ID_KIND,'
      '11049574=           T.ID_NUM,'
      '11049575=           T.ID_DATE,'
      '11049576=           T.ID_ISSUER,'
      '11049577=           T.G_APPOINTMENT,'
      '11049578=           T.IS_RUKOVODITEL,'
      '11049579=           T.IS_GLAVBUH,'
      '11049580=           G.NAME APP_NAME'
      '11049581=           ,T.PASS'
      
        '11049582=      FROM g_OFFICIAL t LEFT OUTER JOIN G_APPOINTMENT G' +
        ' ON T.G_APPOINTMENT = G.G_APPOINTMENT'
      '11049583=     WHERE T.G_APPOINTMENT = G.G_APPOINTMENT'
      '11049584=    ORDER BY T.G_OFFICIAL, T.FM, T.NM, T.FT'
      '11049585=    INTO :G_OFFICIAL,'
      '11049586=        :FM,'
      '11049587=        :NM,'
      '11049588=        :FT,'
      '11049589=        :FIO,'
      '11049590=        :FIO_DOC,'
      '11049591=        :RNN,'
      '11049592=        :IDN,'
      '11049593=        :DT,'
      '11049594=        :G_ID_KIND,'
      '11049595=        :ID_NUM,'
      '11049596=        :ID_DATE,'
      '11049597=        :ID_ISSUER,'
      '11049598=        :G_APPOINTMENT,'
      '11049599=        :IS_RUKOVODITEL,'
      '11049600=        :IS_GLAVBUH,'
      '11049601=        :APP_NAME'
      '11049602=        ,:PASS'
      '11049603=    DO'
      '11049604=      SUSPEND;'
      '11049605=end'
      '11049606='#39';'
      '11049607='
      '11049608=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SYS_PARAM_COUNT('
      '11049609=  MODE_ INTEGER,'
      '11049610=  PARAM1_ INTEGER)'
      '11049611=RETURNS ('
      '11049612=  PARAM1_OUT_ INTEGER,'
      '11049613=  PARAM2_OUT_ INTEGER,'
      '11049614=  PARAM1_STR_OUT_ VARCHAR(50),'
      '11049615=  PARAM2_STR_OUT_ VARCHAR(50))'
      '11049616=AS'
      '11049617=/*'
      '11049618='#1045#1057#1051#1048' MODE_ = 0'
      
        '11049619='#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1055#1056#1048' '#1047#1040#1055#1059#1057#1050#1045' '#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071', '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045#1049 +
        ' '#1041#1054#1051#1068#1064#1045' '#1054#1044#1053#1054#1043#1054','
      
        '11049620='#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043#1054' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054#1043#1044#1040' '#1042#1067#1044#1040 +
        #1042#1040#1058#1068' '#1054#1050#1053#1054' '#1057' '#1042#1067#1041#1054#1056#1054#1052' '#1051#1054#1043#1048#1053#1040'/'#1055#1040#1056#1054#1051#1071'.'
      
        '11049621='#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045#1049' '#1053#1045#1058', '#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043#1054' ' +
        #1053#1045' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054' '#1054#1050#1053#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      '11049622='
      '11049623='#1045#1057#1051#1048' MODE_ = 1'
      
        '11049624='#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1050#1051#1040#1044#1054#1042' '#1048' '#1042#1067#1044#1040#1045#1058#1057#1071' '#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052#1054#1051 +
        #1063#1040#1053#1048#1070'.'
      
        '11049625='#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1048#1065#1059' '#1055#1054' '#1070#1047#1045#1056#1059', '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1046#1059', '#1058#1054' '#1057#1058#1040 +
        #1042#1051#1070' '#1057#1050#1051#1040#1044' 1'
      '11049626=*/'
      '11049627=BEGIN'
      '11049628='
      '11049629=  IF (MODE_ = 0) THEN BEGIN'
      '11049630=      SELECT COUNT(*)'
      '11049631=        FROM G_OFFICIAL G'
      '11049632=        INTO :PARAM1_OUT_;'
      '11049633='
      '11049634=      if (PARAM1_OUT_ = 1) then'
      '11049635=        SELECT G.PASS'
      '11049636=          FROM G_OFFICIAL G'
      '11049637=          INTO :PARAM1_STR_OUT_;'
      '11049638='
      '11049639=  END ELSE BEGIN'
      '11049640=    SELECT COUNT(*)'
      '11049641=      FROM G_TOCHKA G'
      '11049642=      INTO :PARAM1_OUT_;'
      '11049643='
      '11049644=    IF (PARAM1_OUT_ > 1) THEN BEGIN'
      '11049645=      SELECT G.G_TOCHKA'
      '11049646=        FROM G_OFFICIAL G'
      
        '11049647=       WHERE G.G_OFFICIAL = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 1)'
      '11049648=        INTO :PARAM2_OUT_;'
      '11049649='
      '11049650=      if (COALESCE(PARAM2_OUT_, 0)  = 0) then'
      '11049651=        PARAM2_OUT_ = 1;'
      '11049652=    END'
      '11049653=  END'
      '11049654=END'
      '11049655='#39';'
      '11049656='
      '11049657=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_KASSIR('
      '11049658=  DATE_BEGIN_ DATE,'
      '11049659=  DATE_END_ DATE,'
      '11049660=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11049661=RETURNS ('
      '11049662=  PERIOD_ VARCHAR(40),'
      '11049663=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '11049664=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '11049665=  ROWCOL INTEGER,'
      '11049666=  Z_DATE VARCHAR(40),'
      '11049667=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11049668=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11049669=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11049670=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11049671=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '11049672=AS'
      '11049673=/*'
      
        '11049674='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071', ' +
        #1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '11049675=*/'
      '11049676=DECLARE VARIABLE SORT_COL INTEGER;'
      '11049677=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '11049678=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '11049679=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      '11049680=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = 0;'
      '11049681=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = 0;'
      
        '11049682=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NULL ' +
        '= 0;'
      
        '11049683=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NULL ' +
        '= 0;'
      '11049684=BEGIN'
      
        '11049685=  PERIOD_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_' +
        '), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '11049686=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39 +
        #39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXTR' +
        'ACT(YEAR FROM DATE_END_);'
      '11049687='
      '11049688=  SELECT S."INPUT"'
      '11049689=    FROM kassa_state S'
      '11049690=   WHERE S.k_date = :DATE_BEGIN_'
      '11049691=     AND S.g_tochka = :G_TOCHKA_'
      '11049692=    INTO :IN_SUMM_;'
      '11049693='
      '11049694=  IF (ROW_COUNT = 0) THEN'
      '11049695=    SELECT S."OUTPUT"'
      '11049696=      FROM kassa_state S'
      '11049697=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '11049698=                         FROM KASSA_STATE ST'
      '11049699=                        WHERE ST.k_date < :DATE_BEGIN_'
      '11049700=                         AND ST.g_tochka = :G_TOCHKA_)'
      '11049701=      AND S.g_tochka = :G_TOCHKA_'
      '11049702=      INTO :IN_SUMM_;'
      '11049703='
      '11049704=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '11049705='
      '11049706=  SELECT S."OUTPUT"'
      '11049707=    FROM kassa_state S'
      '11049708=   WHERE S.k_date = :DATE_END_'
      '11049709=     AND S.g_tochka = :G_TOCHKA_'
      '11049710=    INTO :OUT_SUMM_;'
      '11049711='
      '11049712=  IF (ROW_COUNT = 0) THEN'
      '11049713=    SELECT S."OUTPUT"'
      '11049714=      FROM kassa_state S'
      '11049715=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '11049716=                         FROM KASSA_STATE ST'
      '11049717=                        WHERE ST.k_date < :DATE_END_'
      '11049718=                         AND ST.g_tochka = :G_TOCHKA_)'
      '11049719=      AND S.g_tochka = :G_TOCHKA_'
      '11049720=      INTO :OUT_SUMM_;'
      '11049721='
      '11049722=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '11049723='
      '11049724=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '11049725=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39#39'0'#39#39')' +
        '||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EX' +
        'TRACT(YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_ST' +
        'R'
      '11049726=           ,Z.Z_DATE'
      '11049727=           ,GP.ARTICUL'
      '11049728=           ,GP.BARCODE'
      '11049729=           ,GP.NAME'
      '11049730=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '11049731=           ,SUM(ZD.summ)    SUMM'
      '11049732=      FROM ZAKAZ Z'
      '11049733=           ,ZAKAZ_DETAILS ZD'
      '11049734=           ,G_PRODUCT GP'
      '11049735=     WHERE Z.is_spisanie in (0, 2)'
      '11049736=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11049737=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11049738=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      '11049739=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11049740=       AND Z.G_TOCHKA = :G_TOCHKA_'
      '11049741=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NAME'
      '11049742=      INTO :date_str,'
      '11049743=           :Z_DATE,'
      '11049744=           :ARTICUL,'
      '11049745=           :BARCODE,'
      '11049746=           :NAME,'
      '11049747=           :AMOUNT,'
      '11049748=           :SUMM'
      '11049749=  DO BEGIN'
      '11049750=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '11049751=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR)'
      '11049752=      VALUES (1, 1, '#39#39#1055#1088#1086#1076#1072#1078#1072#39#39');'
      '11049753=      FIRST_ITER = 1;'
      '11049754=    END'
      '11049755='
      
        '11049756=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '11049757=      VALUES (2, 2, :DATE_STR, :z_date,  :ARTICUL, :BAR' +
        'CODE, :NAME, :AMOUNT, :SUMM);'
      '11049758=  END'
      '11049759='
      '11049760=  IF (first_iter > 0) THEN BEGIN'
      
        '11049761=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '11049762=        VALUES (3, 3, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39#39', (SELECT SUM(K.S' +
        'UMM)'
      '11049763=                                         FROM KASSA K,'
      '11049764=                                              ZAKAZ Z'
      
        '11049765=                                        WHERE K.G_TOCHK' +
