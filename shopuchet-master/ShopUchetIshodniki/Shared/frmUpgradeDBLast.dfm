        #1076#1077#1089#1103#1090#1074#1086#1089#1077#1084#1100#1076#1077#1089#1103#1090#1076#1077#1074#1103#1085#1086#1089#1090#1086#39';'
      
        '110157175=  ones_idx = /* 3.2 */ '#39'001000010000100001030040601004' +
        '0140501904023060290603506041110521006210072120841009411105101151' +
        '212712'#39';'
      
        '110157176=  ones = '#39#1090#1088#1080#1095#1077#1090#1099#1088#1077#1087#1103#1090#1100#1096#1077#1089#1090#1100#1089#1077#1084#1100#1074#1086#1089#1077#1084#1100#1076#1077#1074#1103#1090#1100#1076#1077#1089#1103#1090#1100#1086#1076#1080#1085 +
        #1085#1072#1076#1094#1072#1090#1100#1076#1074#1077#1085#1072#1076#1094#1072#1090#1100#1090#1088#1080#1085#1072#1076#1094#1072#1090#1100#1095#1077#1090#1099#1088#1085#1072#1076#1094#1072#1090#1100#1087#1103#1090#1085#1072#1076#1094#1072#1090#1100#1096#1077#1089#1090#1085#1072#1076#1094#1072#1090#1100#1089#1077#1084#1085 +
        #1072#1076#1094#1072#1090#1100#1074#1086#1089#1077#1084#1085#1072#1076#1094#1072#1090#1100#1076#1077#1074#1103#1090#1085#1072#1076#1094#1072#1090#1100#39';'
      '110157177='
      '110157178=  if (CURRENCY is null) then CURRENCY = -1;'
