      '110242369=            END'
      '110242370='
      
        '110242371=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~'#39#39'; ' +
        '  -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '110242372=      END'
      '110242373='
      
        '110242374=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059#1044 +
        #1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '110242375=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110242376=            FROM KASSA K'
      '110242377=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110242378=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA||'#39#39'~'#39#39
      '110242379=           UNION'
      '110242380=          SELECT KASSA, 1 PAYMENT_TYPE'
      '110242381=            FROM KASSA K'
      '110242382=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110242383=             AND K.SUMM = 0'
      '110242384=          UNION'
      '110242385=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110242386=            FROM KASSA_BEZNAL K'
      '110242387=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110242388=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA_BEZNAL||'#39#39'~'#39#39
