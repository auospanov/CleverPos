        '1102112217=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
