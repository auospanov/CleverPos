      '110231886='
      
        '110231887=  -- '#1055#1056#1048#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1042' '#1050#1040#1057#1057#1059' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059' '#1053#1045' '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068', ' +
