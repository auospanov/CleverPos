      '1104085='
      '1104086=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD('
      
        '1104087=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTEG' +
        'ER,'
      
        '1104088=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT */ DATE,'
      
        '1104089=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT */ TIME,'
      '1104090=  G_CLIENT_ /* TYPE OF COLUMN SKLAD.G_CLIENT */ INTEGER,'
      
        '1104091=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ' */ INTEGER,'
      
        '1104092=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD.OSNOVANIE */ VARCHA' +
        'R(150),'
      '1104093=  NOTE_ /* TYPE OF COLUMN SKLAD.NOTE */ VARCHAR(200),'
      
        '1104094=  IS_VOZVRAT_ /* TYPE OF COLUMN SKLAD.IS_VOZVRAT */ INTE' +
        'GER,'
      
        '1104095=  SUMM_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(1' +
        '5,2),'
      
        '1104096=  SUMM_FACT_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT */' +
        ' NUMERIC(15,2),'
      
        '1104097=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD */ INTEGER,'
      
        '1104098=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(1' +
        '5,2),'
      '1104099=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11040100=  SUMM_CURRENCY_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_CU' +
        'RRENCY */ NUMERIC(15,2) = 0)'
      '11040101=RETURNS ('
      
        '11040102=  SKLAD_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */ INTEGE' +
        'R,'
