        '1102461812=                                                  :ZA' +
        'KAZ_,'
      
        '1102461813=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1102461814=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1102461815=                                                  :G_' +
        'TOCHKA_,'
      
        '1102461816=                                                  :UP' +
        'LOAD_TO_EXT_APP_'
      
        '1102461817=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102461818=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102461819=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1102461820=                      EXIT;'
      '1102461821=                    END'
      '1102461822=                END'
