        '_, :REC_AMOUNT_UHOD_SKL_, :REC_SUMM_UHOD_SKL_,'
      '1101322324=        :REC_AMOUNT_OUT_,'
      '1101322325=        0);'
      '1101322326='
      
        '1101322327=      AMOUNT_PRIHOD_  = AMOUNT_PRIHOD_ + REC_AMOUNT_P' +
        'RIHOD_;'
      
        '1101322328=      SUMM_PRIHOD_    = SUMM_PRIHOD_   + REC_SUMM_PRI' +
        'HOD_;'
      
        '1101322329=      AMOUNT_UHOD_    = AMOUNT_UHOD_   + REC_AMOUNT_U' +
        'HOD_;'
      
        '1101322330=      SUMM_UHOD_      = SUMM_UHOD_     + REC_SUMM_UHO' +
        'D_;'
      
        '1101322331=      AMOUNT_SPISANO_ = AMOUNT_SPISANO_  + REC_AMOUNT' +
        '_SPISANO_;'
      
        '1101322332=      SUMM_SPISANO_   = SUMM_SPISANO_    + REC_SUMM_S' +
        'PISANO_;'
      
