        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110402611=                  EXIT;'
      '110402612=                END'
      '110402613='
      
        '110402614=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~' +
        #39#39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '110402615=            END'
      '110402616='
      
        '110402617=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048 +
        ' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '110402618=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110402619=                FROM KASSA K'
      '110402620=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110402621=                 AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'|' +
        '|K.KASSA||'#39#39'~'#39#39
      '110402622=                UNION'
      '110402623=                SELECT KASSA, 1 PAYMENT_TYPE'
      '110402624=                  FROM KASSA K'
      '110402625=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '110402626=                   AND K.SUMM = 0'
      '110402627=                UNION'
      
        '110402628=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110402629=                FROM KASSA_BEZNAL K'
      '110402630=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110402631=                 AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'|' +
        '|K.KASSA_BEZNAL||'#39#39'~'#39#39
      '110402632=                UNION'
      
        '110402633=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110402634=                FROM KASSA_BEZNAL K'
      '110402635=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110402636=                 AND K.SUMM = 0'
      '110402637=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110402638=            DO BEGIN'
      '110402639=                PNT_ = '#39#39'08'#39#39';'
      
        '110402640=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_,' +
        ' :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110402641=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402642=                    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'|' +
        '|PNT_||'#39#39' '#39#39'||ERR_MSG;'
