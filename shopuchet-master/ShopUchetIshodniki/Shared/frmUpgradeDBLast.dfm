        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110233647=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '110233648=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110233649=       AND ((EXISTS (SELECT 1'
      '110233650=                       FROM SKLAD S'
      '110233651=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110233652=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110233653=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110233654=              OR'
      '110233655=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110233656=     GROUP BY TR.PATH'
      '110233657=     ORDER BY TR.PATH'
      
        '110233658=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST_' +
        ', REC_NDS_SUMM_'
      '110233659=  DO BEGIN'
      '110233660=    IF (IS_FIRST_ = 1) then BEGIN'
      '110233661=      insert into p_rep_profit_table'
      '110233662=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110233663=      values'
      
        '110233664=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '110233665='
      '110233666=      IS_FIRST_ = 0;'
      '110233667=    END'
      '110233668='
      
        '110233669=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS_' +
        'SUMM_;'
      '110233670='
      '110233671=    insert into p_rep_profit_table'
      
        '110233672=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110233673=    values'
      '110233674=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110233675=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_, ' +
        ':REC_SUM_COST_, :REC_PROFIT_, 0);'
      '110233676='
      '110233677=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '110233678=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, 0' +
        ');'
      
        '110233679=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, 0' +
        ');'
      '110233680=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110233681=  END'
      '110233682='
      '110233683=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '110233684=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110233685=    insert into p_rep_profit_table'
      
        '110233686=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110233687=    values'
      
        '110233688=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090#1086 +
        #1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT' +
        '_, 2);'
      '110233689='
      '110233690=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110233691=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110233692=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110233693=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '110233694=  END'
      '110233695=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110233696=  --**************************************************' +
        '***************************************'
      '110233697=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '110233698=  insert into p_rep_profit_table'
      '110233699=    (p_rep_profit_table, is_head)'
      '110233700=  values'
      '110233701=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110233702='
      '110233703=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '110233704=  insert into p_rep_profit_table'
      
        '110233705=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110233706=  values'
      
        '110233707=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072#1079 +
        #1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT_' +
        'ALL_, 1);'
      '110233708='
      '110233709=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '110233710=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110233711=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110233712=         SUM(Z.SUMM_BONUS)'
      '110233713=    FROM ZAKAZ Z'
      
        '110233714=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      
        '110233715=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1089 +
        #1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '110233716=     AND Z.IS_RESERVE = 0'
      '110233717=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110233718=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110233719=     AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFFIC' +
        'IAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '110233720=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110233721=     AND ((EXISTS (SELECT 1'
      '110233722=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '110233723=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '110233724=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '110233725=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '110233726=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110233727=          OR'
      '110233728=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110233729=    INTO :SUMM_CASH_ALL_,'
      '110233730=         :SUMM_NONCASH_ALL_,'
      '110233731=         :SUMM_BONUS_ALL_;'
      '110233732='
      
        '110233733=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052', '#1058#1059#1058' '#1053#1045' '#1055#1054 +
        #1051#1059#1063#1040#1045#1058#1057#1071' '#1059#1063#1048#1058#1067#1042#1040#1058#1068' '#1041#1054#1053#1059#1057#1067', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1042#1054#1047#1042#1056#1040#1058#1040#1061' '#1054#1053#1048' '#1053#1045' '#1061#1056#1040#1053#1071#1058#1057 +
        #1071
      
        '110233734=  SELECT  (SELECT SUM(K.SUMM) FROM KASSA K WHERE K.SKL' +
        'AD = SP.SKLAD),'
      
        '110233735=          (SELECT SUM(K1.SUMM) FROM KASSA_BEZNAL K1 WH' +
        'ERE K1.SKLAD = SP.SKLAD)'
      '110233736=     FROM SKLAD_PARENT SP,'
      '110233737=          SKLAD S,'
      '110233738=          G_PRODUCT G'
      
        '110233739=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||' +
        #39'-'#39
      
        '110233740=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110233741=      AND SP.IS_VOZVRAT IN (1,2)'
      
        '110233742=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'S.G_CLIENT, 0))'
      
        '110233743=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE' +
        '_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110233744=      AND SP.SKLAD = S.SKLAD_PARENT'
      '110233745=      AND S.G_PRODUCT = G.G_PRODUCT'
      '110233746=      AND ((EXISTS (SELECT 1'
      '110233747=                       FROM SKLAD SS'
      '110233748=                      WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '110233749=                        AND SS.G_PRODUCT = G.G_PRODUCT'
      
        '110233750=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110233751=              OR'
      '110233752=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110233753=    INTO :SUMM_CASH_RETURN_,'
      '110233754=         :SUMM_NONCASH_RETURN_;'
      '110233755='
      
        '110233756=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COALE' +
        'SCE(SUMM_CASH_RETURN_, 0);'
      
        '110233757=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) -' +
        ' COALESCE(SUMM_NONCASH_RETURN_, 0);'
      '110233758=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110233759='
      '110233760=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110233761='
      
        '110233762=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '110233763=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110233764='
      '110233765=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110233766=    SELECT G.NAME'
      '110233767=      FROM G_CLIENT G'
      '110233768=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110233769=    INTO :CLIENT_NAME_;'
      '110233770=  ELSE'
      '110233771=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '110233772='
      '110233773=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110233774=    SELECT G.NAME'
      '110233775=      FROM G_PAYMENT_TYPE G'
      '110233776=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110233777=    INTO :PAYMENT_NAME_;'
      '110233778=  ELSE'
      '110233779=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '110233780='
      '110233781=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110233782=        P.TOVAR_NAME,'
      
        '110233783=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), '#39 +
        '.'#39', '#39','#39'),'
      
        '110233784=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR(' +
        '100)), '#39'.'#39', '#39','#39'),'
      
        '110233785=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR(' +
        '100)), '#39'.'#39', '#39','#39'),'
      
        '110233786=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100)' +
        '), '#39'.'#39', '#39','#39'),'
      '110233787=        P.IS_HEAD'
      
        '110233788=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110233789=    ORDER BY 1'
      '110233790=  INTO :P_REP_PROFIT_TABLE,'
      '110233791=       :TOVAR_NAME,'
      '110233792=       :SUMM,'
      '110233793=       :NDS_SUMM,'
      '110233794=       :SUM_SELF,'
      '110233795=       :PROFIT,'
      '110233796=       :IS_HEAD'
      '110233797=  DO'
      '110233798=    suspend;'
      '110233799='
      '110233800=WHEN ANY DO BEGIN'
      '110233801=    Err_code = -20500;'
      
        '110233802=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110233803=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110233804=  END'
      '110233805=end'
      '110233806=;'
      '110233807='
      '110233808='
      
        '110233809=UPDATE SYSTEM_SETUP SET S_VALUE = 110233 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110233810=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110233811=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102340='
      '1102341=ALTER PROCEDURE GET_FREE_BARCODE('
      '1102342=  MODE_ INTEGER,'
      '1102343=  PREFIX_ VARCHAR(2))'
      '1102344=RETURNS ('
      '1102345=  BARCODE_ VARCHAR(13))'
      '1102346=AS'
      '1102347=/*'#1058#1077#1084#1077#1082#1086#1074' '#1040'.'#1040'. 01.02.2015'
      '1102348=  '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1064#1058#1056#1048#1061#1050#1054#1044
      '1102349=  */'
      '11023410=DECLARE VARIABLE N INTEGER;'
      '11023411=DECLARE VARIABLE M INTEGER;'
      '11023412=DECLARE VARIABLE K INTEGER;'
      '11023413=BEGIN'
      '11023414=  if (MODE_ IN (13, 131)) then begin'
      '11023415=      if (MODE_ = 131) then begin'
      
        '11023416=        -- '#1085#1072#1076#1086' '#1087#1088#1086#1074#1077#1088#1103#1090#1100' '#1085#1077' '#1091#1096#1077#1083' '#1083#1080' '#1075#1077#1085#1077#1088#1072#1090#1086#1088' '#1079#1072' 5 '#1079#1085#1072 +
        #1082#1086#1074', '#1085#1072#1087#1088#1080#1084#1077#1088' 102261, '#1090#1086#1075#1076#1072' '#1087#1086#1089#1083#1077#1076#1085#1103#1103' '#1077#1076#1080#1085#1080#1094#1072' '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1077#1090#1089#1103
      
        '11023417=        -- '#1080' '#1096#1090#1088#1080#1093#1082#1086#1076' '#1087#1086#1083#1091#1095#1072#1077#1090#1089#1103' '#1086#1076#1080#1085' '#1080' '#1090#1086#1090' '#1078#1077'. '#1087#1088#1080#1076#1077#1090#1089 +
        #1103' '#1090#1091#1090' '#1089#1088#1072#1079#1091' '#1091#1074#1077#1083#1080#1095#1080#1074#1072#1090#1100' '#1085#1072' 10000'
      '11023418=        M = GEN_ID(GEN_BARCODE_SCALE,  1);'
      '11023419=        IF (CHAR_LENGTH(M) > 5) THEN BEGIN'
      '11023420=          K = SUBSTRING(M FROM 1 FOR 1);'
      '11023421=          M = (K + 1) * 10000;'
      
        '11023422=          EXECUTE STATEMENT '#39'SET GENERATOR GEN_BARCODE_' +
        'SCALE TO '#39' || M;'
      '11023423=        END'
      '11023424='
      
        '11023425=        BARCODE_ = prefix_ || LPAD(GEN_ID(GEN_BARCODE_S' +
        'CALE,  0), 5, '#39'0'#39')||'#39'00000'#39';'
      '11023426=      end else'
      
        '11023427=        BARCODE_ = '#39'2'#39' || LPAD(GEN_ID(GEN_BARCODE,  1),' +
        ' 12 - CHAR_LENGTH('#39'2'#39'), '#39'0'#39');'
      '11023428='
      
        '11023429=      N = (CAST (SUBSTRING (BARCODE_ FROM  2 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023430=           CAST (SUBSTRING (BARCODE_ FROM  4 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023431=           CAST (SUBSTRING (BARCODE_ FROM  6 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023432=           CAST (SUBSTRING (BARCODE_ FROM  8 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023433=           CAST (SUBSTRING (BARCODE_ FROM 10 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023434=           CAST (SUBSTRING (BARCODE_ FROM 12 FOR 1) AS ' +
        'INTEGER)'
      '11023435=          ) * 3+'
      
        '11023436=           CAST (SUBSTRING (BARCODE_ FROM  1 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023437=           CAST (SUBSTRING (BARCODE_ FROM  3 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023438=           CAST (SUBSTRING (BARCODE_ FROM  5 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023439=           CAST (SUBSTRING (BARCODE_ FROM  7 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023440=           CAST (SUBSTRING (BARCODE_ FROM  9 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023441=           CAST (SUBSTRING (BARCODE_ FROM 11 FOR 1) AS ' +
        'INTEGER);'
      '11023442=  end else begin'
      
        '11023443=      BARCODE_ = '#39'2'#39' || LPAD(GEN_ID(GEN_BARCODE,  1), 7' +
        ' - CHAR_LENGTH('#39'2'#39'), '#39'0'#39');'
      '11023444='
      
        '11023445=      N = (CAST (SUBSTRING (BARCODE_ FROM  1 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023446=           CAST (SUBSTRING (BARCODE_ FROM  3 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023447=           CAST (SUBSTRING (BARCODE_ FROM  5 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023448=           CAST (SUBSTRING (BARCODE_ FROM  7 FOR 1) AS ' +
        'INTEGER)'
      '11023449=          ) * 3+'
      
        '11023450=           CAST (SUBSTRING (BARCODE_ FROM  2 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023451=           CAST (SUBSTRING (BARCODE_ FROM  4 FOR 1) AS ' +
        'INTEGER)+'
      
        '11023452=           CAST (SUBSTRING (BARCODE_ FROM  6 FOR 1) AS ' +
        'INTEGER);'
      '11023453=  end'
      '11023454='
      '11023455=  N = MOD(N, 10);'
      '11023456='
      '11023457=  IF(N > 0)THEN N = 10 - N;'
      '11023458='
      '11023459=  BARCODE_ = BARCODE_ || CAST(N AS VARCHAR(20));'
      '11023460=end'
      '11023461=;'
      '11023462='
      '11023463='
      
        '11023464=UPDATE SYSTEM_SETUP SET S_VALUE = 110234 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '11023465=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11023466=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102350='
      '1102351=ALTER PROCEDURE P_REP_KASSIR('
      '1102352=  DATE_BEGIN_ DATE,'
      '1102353=  DATE_END_ DATE,'
      '1102354=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102355=RETURNS ('
      '1102356=  PERIOD_ VARCHAR(40),'
      '1102357=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '1102358=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '1102359=  IN_SUMM_NONCASH_ TYPE OF MY_NUMERIC,'
      '11023510=  OUT_SUMM_NONCASH_ TYPE OF MY_NUMERIC,'
      '11023511=  ROWCOL INTEGER,'
      '11023512=  Z_DATE VARCHAR(60),'
      '11023513=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11023514=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11023515=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11023516=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11023517=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '11023518=AS'
      '11023519=/*'
      
        '11023520='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071', ' +
        #1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '11023521=*/'
      '11023522=DECLARE VARIABLE SORT_COL INTEGER;'
      '11023523=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '11023524=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '11023525=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      '11023526=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = 0;'
      '11023527=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = 0;'
      
        '11023528=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NULL ' +
        '= 0;'
      
        '11023529=DECLARE VARIABLE SUMM_SALES_ALL_ TYPE OF NUMERIC_NULL =' +
        ' 0;'
      
        '11023530=DECLARE VARIABLE SUMM_RETURNS_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      
        '11023531=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NULL ' +
        '= 0;'
      
        '11023532=DECLARE VARIABLE SUMM_PRIHOD_BEZNAL_ TYPE OF NUMERIC_NU' +
        'LL = 0;'
      
        '11023533=DECLARE VARIABLE SUMM_RASHOD_BEZNAL_ TYPE OF NUMERIC_NU' +
        'LL = 0;'
      
        '11023534=DECLARE VARIABLE SUMM_PRIHOD_ALL_BEZNAL_ TYPE OF NUMERI' +
        'C_NULL = 0;'
      
        '11023535=DECLARE VARIABLE SUMM_RASHOD_ALL_BEZNAL_ TYPE OF NUMERI' +
        'C_NULL = 0;'
      '11023536=BEGIN'
      
        '11023537=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE_' +
        'BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '11023538=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM DATE_END_);'
      '11023539=  /*'#1042#1093#1086#1076#1103#1097#1080#1081' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072#1083'*/'
      '11023540=  SELECT S."INPUT"'
      '11023541=    FROM kassa_state S'
      '11023542=   WHERE S.k_date = :DATE_BEGIN_'
      '11023543=     AND S.g_tochka = :G_TOCHKA_'
      '11023544=    INTO :IN_SUMM_;'
      '11023545='
      '11023546=  IF (ROW_COUNT = 0) THEN'
      '11023547=    SELECT S."OUTPUT"'
      '11023548=      FROM kassa_state S'
      '11023549=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '11023550=                         FROM KASSA_STATE ST'
      '11023551=                        WHERE ST.k_date < :DATE_BEGIN_'
      '11023552=                         AND ST.g_tochka = :G_TOCHKA_)'
      '11023553=      AND S.g_tochka = :G_TOCHKA_'
      '11023554=      INTO :IN_SUMM_;'
      '11023555='
      '11023556=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '11023557=  /*'#1042#1093#1086#1076#1103#1097#1080#1081' '#1086#1089#1090#1072#1090#1086#1082' '#1073#1077#1079#1085#1072#1083'*/'
      '11023558=  SELECT S."INPUT"'
      '11023559=    FROM kassa_beznal_state S'
      '11023560=   WHERE S.k_date = :DATE_BEGIN_'
      '11023561=    INTO :IN_SUMM_NONCASH_;'
      '11023562='
      '11023563=  IF (ROW_COUNT = 0) THEN'
      '11023564=    SELECT S."OUTPUT"'
      '11023565=      FROM kassa_beznal_state S'
      '11023566=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '11023567=                         FROM KASSA_BEZNAL_STATE ST'
      '11023568=                        WHERE ST.k_date < :DATE_BEGIN_)'
      '11023569=      INTO :IN_SUMM_NONCASH_;'
      '11023570='
      '11023571=  IN_SUMM_NONCASH_ = COALESCE(IN_SUMM_NONCASH_, 0);'
      '11023572='
      
        '11023573=  /* '#1050#1054#1056#1054#1063#1045' '#1048#1047'-'#1047#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048' '#1063#1058#1054'-'#1058#1054' '#1050#1056#1048#1042#1054' '#1057' '#1044#1042#1048#1046#1045#1053#1048#1045 +
        #1052' '#1044#1045#1053#1045#1043', '#1071' '#1061#1059#1049' '#1055#1054#1049#1052#1048' '#1055#1054#1063#1045#1052#1059' '#1048' '#1048#1047'-'#1047#1040' '#1063#1045#1043#1054' '#1047#1040#1045#1041#1040#1051#1054' '#1057#1059#1050#1040
      
        '11023574=     '#1055#1054#1058#1054#1052#1059' '#1056#1045#1064#1048#1051' '#1055#1056#1054#1057#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1057#1045' '#1054#1055#1045#1056#1040#1062 +
        #1048#1048
      '11023575=  SELECT S."OUTPUT"'
      '11023576=    FROM kassa_state S'
      '11023577=   WHERE S.k_date = :DATE_END_'
      '11023578=     AND S.g_tochka = :G_TOCHKA_'
      '11023579=    INTO :OUT_SUMM_;'
      '11023580='
      '11023581=  IF (ROW_COUNT = 0) THEN'
      '11023582=    SELECT S."OUTPUT"'
      '11023583=      FROM kassa_state S'
      '11023584=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '11023585=                         FROM KASSA_STATE ST'
      '11023586=                        WHERE ST.k_date < :DATE_END_'
      '11023587=                         AND ST.g_tochka = :G_TOCHKA_)'
      '11023588=      AND S.g_tochka = :G_TOCHKA_'
      '11023589=      INTO :OUT_SUMM_;'
      '11023590='
      '11023591=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '11023592=  */'
      '11023593='
      '11023594=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '11023595=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||' +
        #39'.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_STR'
      '11023596=           ,Z.Z_DATE'
      '11023597=           ,GP.ARTICUL'
      '11023598=           ,GP.BARCODE'
      '11023599=           ,GP.NAME'
      '110235100=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '110235101=           ,SUM(ZD.summ)    SUMM'
      '110235102=      FROM ZAKAZ Z'
      '110235103=           ,ZAKAZ_DETAILS ZD'
      '110235104=           ,G_PRODUCT GP'
      '110235105=     WHERE Z.is_spisanie in (0, 2)'
      '110235106=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110235107=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110235108=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110235109=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      '110235110=       AND Z.G_TOCHKA = :G_TOCHKA_'
      
        '110235111=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NAM' +
        'E'
      '110235112=      INTO :date_str,'
      '110235113=           :Z_DATE,'
      '110235114=           :ARTICUL,'
      '110235115=           :BARCODE,'
      '110235116=           :NAME,'
      '110235117=           :AMOUNT,'
      '110235118=           :SUMM'
      '110235119=  DO BEGIN'
      '110235120=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110235121=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110235122=      VALUES (1, 1, '#39#1055#1088#1086#1076#1072#1078#1072#39');'
      '110235123=      FIRST_ITER = 1;'
      '110235124=    END'
      '110235125='
      
        '110235126=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '110235127=      VALUES (2, 2, :DATE_STR, :z_date,  :ARTICUL, :BA' +
        'RCODE, :NAME, :AMOUNT, :SUMM);'
      '110235128=  END'
      '110235129='
      '110235130=  IF (first_iter > 0) THEN BEGIN'
      
        '110235131=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110235132=        VALUES (3, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', (SELECT COALESCE' +
        '(SUM(K.SUMM), 0)'
      '110235133=                                         FROM KASSA K,'
      '110235134=                                              ZAKAZ Z'
      
        '110235135=                                        WHERE K.G_TOCH' +
        'KA = :G_TOCHKA_'
      
        '110235136=                                          AND K.ZAKAZ ' +
        '= Z.ZAKAZ'
      
        '110235137=                                          AND Z.z_date' +
        ' BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110235138=                                          AND Z.G_TOCH' +
        'KA = :G_TOCHKA_'
      
        '110235139=                                          AND Z.is_spi' +
        'sanie in (0, 2)'
      
        '110235140=                                          AND K.ACTION' +
        '_DATE = Z.Z_DATE)'
      '110235141=               )'
      '110235142=      RETURNING'
      '110235143=        SUMM'
      '110235144=      INTO'
      '110235145=        :SUMM_PRIHOD_ALL_;'
      '110235146='
      
        '110235147=      SUMM_PRIHOD_ALL_ = COALESCE(SUMM_PRIHOD_ALL_, 0)' +
        ';'
      '110235148='
      
        '110235149=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110235150=        VALUES (4, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', (SELECT COALE' +
        'SCE(SUM(K.SUMM), 0)'
      
        '110235151=                                             FROM KASS' +
        'A_BEZNAL K,'
      
        '110235152=                                                  ZAKA' +
        'Z Z'
      
        '110235153=                                            WHERE K.G_' +
        'TOCHKA = :G_TOCHKA_'
      
        '110235154=                                              AND K.ZA' +
        'KAZ = Z.ZAKAZ'
      
        '110235155=                                              AND Z.z_' +
        'date BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110235156=                                              AND Z.G_' +
        'TOCHKA = :G_TOCHKA_'
      
        '110235157=                                              AND Z.is' +
        '_spisanie in (0, 2)'
      
        '110235158=                                              AND K.AC' +
        'TION_DATE = Z.Z_DATE)'
      '110235159=               )'
      '110235160=      RETURNING'
      '110235161=        SUMM'
      '110235162=      INTO'
      '110235163=        :SUMM_PRIHOD_ALL_BEZNAL_;'
      '110235164='
      
        '110235165=      SUMM_PRIHOD_ALL_BEZNAL_ = COALESCE(SUMM_PRIHOD_A' +
        'LL_BEZNAL_, 0);'
      '110235166='
      
        '110235167=      SUMM_SALES_ALL_ = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD' +
        '_ALL_BEZNAL_;'
      '110235168='
      
        '110235169=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L)'
      '110235170=      VALUES(5, 1);'
      '110235171=  END'
      '110235172='
      '110235173=  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110235174=  FIRST_ITER = 0;'
      
        '110235175=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2,' +
        ' '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt AS VAR' +
        'CHAR(10)) DATE_STR'
      '110235176=           ,S.date_receipt'
      '110235177=           ,GP.ARTICUL'
      '110235178=           ,GP.BARCODE'
      '110235179=           ,GP.NAME'
      '110235180=           ,SUM(SD.AMOUNT)  AMOUNT'
      '110235181=           ,SUM(SD.summ)    SUMM'
      '110235182=      FROM SKLAD_PARENT S'
      '110235183=           ,SKLAD SD'
      '110235184=           ,G_PRODUCT GP'
      '110235185=     WHERE S.is_vozvrat = 0'
      '110235186=       AND S.sklad = SD.sklad_parent'
      '110235187=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '110235188=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110235189=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110235190=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '110235191=     GROUP BY S.date_receipt, GP.articul, GP.barcode, ' +
        'GP.NAME'
      '110235192=     INTO :date_str,'
      '110235193=           :Z_DATE,'
      '110235194=           :ARTICUL,'
      '110235195=           :BARCODE,'
      '110235196=           :NAME,'
      '110235197=           :AMOUNT,'
      '110235198=           :SUMM'
      '110235199=  DO BEGIN'
      '110235200=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110235201=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110235202=      VALUES (6, 1, '#39#1055#1088#1080#1093#1086#1076' '#1090#1086#1074#1072#1088#1072#39');'
      '110235203=      FIRST_ITER = 1;'
      '110235204=    END'
      '110235205='
      
        '110235206=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '110235207=      VALUES (7, 2, :DATE_STR, :z_date,  :ARTICUL, :BA' +
        'RCODE, :NAME, :AMOUNT, :SUMM);'
      '110235208=  END'
      '110235209='
      '110235210=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '110235211=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110235212=        VALUES (8, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', COALESCE((SELECT' +
        ' SUM(K.summ)'
      
        '110235213=                                                 FROM ' +
        'KASSA K'
      
        '110235214=                                                WHERE ' +
        'EXISTS (SELECT 1'
      
        '110235215=                                                      ' +
        '          FROM sklad_parent P'
      
        '110235216=                                                      ' +
        '         WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110235217=                                                      ' +
        '           AND P.G_TOCHKA = :G_TOCHKA_'
      
        '110235218=                                                      ' +
        '           AND P.is_vozvrat = 0'
      
        '110235219=                                                      ' +
        '           AND P.sklad = K.SKLAD'
      
        '110235220=                                                      ' +
        '           AND P.date_receipt = K.action_date)),0)'
      '110235221=               )'
      '110235222=      RETURNING'
      '110235223=        SUMM'
      '110235224=      INTO'
      '110235225=        :summ_rashod_all_;'
      '110235226='
      
        '110235227=      summ_rashod_all_ = COALESCE(summ_rashod_all_, 0)' +
        ';'
      '110235228='
      
        '110235229=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110235230=        VALUES (9, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', COALESCE((SEL' +
        'ECT SUM(K.summ)'
      
        '110235231=                                                     F' +
        'ROM KASSA_BEZNAL K'
      
        '110235232=                                                    WH' +
        'ERE EXISTS (SELECT 1'
      
        '110235233=                                                      ' +
        '              FROM sklad_parent P'
      
        '110235234=                                                      ' +
        '             WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110235235=                                                      ' +
        '               AND P.G_TOCHKA = :G_TOCHKA_'
      
        '110235236=                                                      ' +
        '               AND P.is_vozvrat = 0'
      
        '110235237=                                                      ' +
        '               AND P.sklad = K.SKLAD'
      
        '110235238=                                                      ' +
        '               AND P.date_receipt = K.action_date)), 0)'
      '110235239=               )'
      '110235240=      RETURNING'
      '110235241=        SUMM'
      '110235242=      INTO'
      '110235243=        :summ_rashod_all_beznal_;'
      '110235244='
      
        '110235245=      summ_rashod_all_beznal_ = COALESCE(summ_rashod_a' +
        'll_beznal_, 0);'
      '110235246='
      
        '110235247=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L)'
      '110235248=        VALUES(10, 1);'
      '110235249=  END'
      '110235250='
      '110235251=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1050#1051#1048#1045#1053#1058#1054#1052
      '110235252=  FIRST_ITER = 0;'
      
        '110235253=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2,' +
        ' '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt AS VAR' +
        'CHAR(10)) DATE_STR'
      '110235254=           ,S.date_receipt'
      '110235255=           ,GP.ARTICUL'
      '110235256=           ,GP.BARCODE'
      '110235257=           ,GP.NAME'
      '110235258=           ,SUM(SD.AMOUNT)  AMOUNT'
      '110235259=           ,SUM(SD.summ)    SUMM'
      '110235260=      FROM SKLAD_PARENT S'
      '110235261=           ,SKLAD SD'
      '110235262=           ,G_PRODUCT GP'
      '110235263=     WHERE S.is_vozvrat = 1'
      '110235264=       AND S.sklad = SD.sklad_parent'
      '110235265=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '110235266=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110235267=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110235268=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '110235269=     GROUP BY S.date_receipt, GP.articul, GP.barcode, ' +
        'GP.NAME'
      '110235270=     INTO :date_str,'
      '110235271=           :Z_DATE,'
      '110235272=           :ARTICUL,'
      '110235273=           :BARCODE,'
      '110235274=           :NAME,'
      '110235275=           :AMOUNT,'
      '110235276=           :SUMM'
      '110235277=  DO BEGIN'
      '110235278=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110235279=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110235280=      VALUES (11, 1, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1082#1083#1080#1077#1085#1090#1086#1084#39');'
      '110235281=      FIRST_ITER = 1;'
      '110235282=    END'
      '110235283='
      
        '110235284=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '110235285=      VALUES (12, 2, :DATE_STR, :z_date,  :ARTICUL, :B' +
        'ARCODE, :NAME, :AMOUNT, :SUMM);'
      '110235286=  END'
      '110235287='
      '110235288=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '110235289=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110235290=        VALUES (13, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', COALESCE((SELEC' +
        'T SUM(K.summ)'
      
        '110235291=                                                 FROM ' +
        'KASSA K'
      
        '110235292=                                                WHERE ' +
        'EXISTS (SELECT 1'
      
        '110235293=                                                      ' +
        '          FROM sklad_parent P'
      
        '110235294=                                                      ' +
        '         WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110235295=                                                      ' +
        '           AND P.G_TOCHKA = :G_TOCHKA_'
      
