        '110152725=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER' +
        ','
      '110152726=  IS_MARKED INTEGER,'
      
        '110152727=  SUM_TO_CHARGE_BONUS /* TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.SUMM */ NUMERIC(15,2))'
      '110152728=AS'
      '110152729=BEGIN'
      '110152730=  SUSPEND;'
      '110152731=END'
      '110152732=;'
      '110152733='
      '110152734='
      
        '110152735=/*****************************************************' +
        '*************************/'
      
        '110152736=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110152737=/*****************************************************' +
        '*************************/'
      '110152738=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110152739=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110152740=  MODE_ INTEGER = 0)'
      '110152741=RETURNS ('
      
        '110152742=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110152743=  ARTICUL_ VARCHAR(30),'
      '110152744=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110152745=  BARCODE_ VARCHAR(30),'
      '110152746=  NAME_ VARCHAR(500),'
      '110152747=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110152748=  PRICE_ NUMERIC(15,2),'
      '110152749=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110152750=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110152751=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110152752=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110152753=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110152754=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110152755=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110152756=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110152757=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110152758=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110152759=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110152760=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      
        '110152761=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110152762=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110152763=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110152764=  ERR_CODE INTEGER,'
      '110152765=  ERR_MSG VARCHAR(1024))'
      '110152766=AS'
      '110152767=begin'
      '110152768=    SELECT'
      '110152769=        G_PRODUCT_PAR,'
      '110152770=        ARTICUL,'
      '110152771=        NOMENCLATUR_NUM,'
      '110152772=        BARCODE,'
      '110152773=        NAME,'
      '110152774=        G_UNIT,'
      '110152775=        PRICE,'
      '110152776=        VOLUME_PRICE,'
      '110152777=        PACK_AMOUNT,'
      '110152778=        MF_COUNTRY,'
      '110152779=        NOTE,'
      '110152780=        CROSSCODE,'
      '110152781=        IS_KIT,'
      '110152782=        MIN_AMOUNT,'
      '110152783=        PLACE,'
      '110152784=        SALES_COMM,'
      '110152785=        KOD_TNVD,'
      '110152786=        FAST_TOVAR,'
      '110152787=        DO_NOT_SHOW_RMK,'
      '110152788=        DO_NOT_CHARGE_BONUS,'
      '110152789=        IS_MARKED,'
      
        '110152790=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1))'
      '110152791=    FROM G_PRODUCT T'
      '110152792=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110152793=    INTO'
      '110152794=        :G_PRODUCT_PAR_,'
      '110152795=        :ARTICUL_,'
      '110152796=        :NOMENCLATUR_NUM_,'
      '110152797=        :BARCODE_,'
      '110152798=        :NAME_,'
      '110152799=        :G_UNIT_,'
      '110152800=        :PRICE_,'
      '110152801=        :VOLUME_PRICE_,'
      '110152802=        :PACK_AMOUNT_,'
      '110152803=        :MF_COUNTRY_,'
      '110152804=        :NOTE_,'
      '110152805=        :CROSSCODE_,'
      '110152806=        :IS_KIT_,'
      '110152807=        :MIN_AMOUNT_,'
      '110152808=        :PLACE_,'
      '110152809=        :SALES_COMM_,'
      '110152810=        :KOD_TNVD_,'
      '110152811=        :FAST_TOVAR_,'
      '110152812=        :DO_NOT_SHOW_RMK_,'
      '110152813=        :DO_NOT_CHARGE_BONUS_,'
      '110152814=        :IS_MARKED_,'
      '110152815=        :LAST_PRICE_;'
      '110152816='
      '110152817=    INSERT INTO LT_BARCODE_TMP'
      
        '110152818=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110152819='
      '110152820=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110152821=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110152822='
      
        '110152823=    INSERT INTO G_PRODUCT_KIT_TMP (G_PRODUCT_KIT, G_PR' +
        'ODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3)'
      
        '110152824=    SELECT DECODE(:MODE_, 0, G_PRODUCT_KIT, GEN_ID(GEN' +
        '_G_PRODUCT_KIT, 1)), G_PRODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, P' +
        'RICE1, PRICE2, PRICE3'
      '110152825=    FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRODUCT_;'
      '110152826=end'
      '110152827=;'
      '110152828='
      '110152829=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '110152830=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110152831=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110152832=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '110152833=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110152834=  PREFIX_ VARCHAR(2))'
      '110152835=RETURNS ('
      '110152836=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110152837=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT_PAR,'
      '110152838=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110152839=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110152840=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110152841=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110152842=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110152843=  ERR_CODE INTEGER,'
      '110152844=  ERR_MSG VARCHAR(1024))'
      '110152845=AS'
      '110152846=/*'
      '110152847='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '110152848=*/'
      
        '110152849=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PRODU' +
        'CT_BY_BARCODE'#39';'
      '110152850=BEGIN'
      '110152851='
      '110152852=  IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '110152853=    ERR_CODE = -20500;'
      
        '110152854=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093#1082#1086#1076' ' +
        #1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110152855=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110152856=    EXIT;'
      '110152857=  END'
      '110152858='
      
        '110152859=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) TH' +
        'EN BEGIN'
      '110152860=        SELECT T.G_PRODUCT_PAR,'
      '110152861=               T.G_PRODUCT,'
      '110152862=               T.PRICE,'
      '110152863=               T.VOLUME_PRICE,'
      '110152864=               T.IS_KIT,'
      '110152865=               T.IS_MARKED'
      '110152866=          FROM G_PRODUCT T'
      
        '110152867=          WHERE SUBSTRING(T.BARCODE FROM 3 FOR 5) = SU' +
        'BSTRING(:BARCODE_ FROM 3 FOR 5)'
      '110152868=            AND T.IS_ACTIVE = 1'
      '110152869=          INTO :G_PRODUCT_CATEGORY_,'
      '110152870=               :G_PRODUCT_,'
      '110152871=               :PRICE_,'
      '110152872=               :VOLUME_PRICE_,'
      '110152873=               :IS_KIT_,'
      '110152874=               :IS_MARKED_;'
      '110152875='
      
        '110152876=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM 8' +
        ' FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '110152877=    END ELSE'
      '110152878=        SELECT T.G_PRODUCT_PAR,'
      '110152879=               T.G_PRODUCT,'
      '110152880=               T.PRICE,'
      '110152881=               T.VOLUME_PRICE,'
      '110152882=               T.IS_KIT,'
      '110152883=               T.IS_MARKED'
      '110152884=          FROM G_PRODUCT T'
      '110152885=          WHERE T.BARCODE = :BARCODE_'
      '110152886=            AND T.IS_ACTIVE = 1'
      '110152887=          INTO :G_PRODUCT_CATEGORY_,'
      '110152888=               :G_PRODUCT_,'
      '110152889=               :PRICE_,'
      '110152890=               :VOLUME_PRICE_,'
      '110152891=               :IS_KIT_,'
      '110152892=               :IS_MARKED_;'
      '110152893='
      '110152894=    if (ROW_COUNT = 0) then BEGIN'
      
        '110152895=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' '#1044 +
        #1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '110152896=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) ' +
        'THEN'
      '110152897=          SELECT T.G_PRODUCT_PAR,'
      '110152898=                 T.G_PRODUCT,'
      '110152899=                 T.PRICE,'
      '110152900=                 T.VOLUME_PRICE,'
      '110152901=                 T.IS_KIT,'
      '110152902=                 T.IS_MARKED'
      '110152903=            FROM G_PRODUCT T, LT_BARCODE D'
      '110152904=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110152905=              AND T.IS_ACTIVE = 1'
      
        '110152906=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) = ' +
        'SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '110152907=            INTO'
      '110152908=                :G_PRODUCT_CATEGORY_,'
      '110152909=                :G_PRODUCT_,'
      '110152910=                :PRICE_,'
      '110152911=                :VOLUME_PRICE_,'
      '110152912=                :IS_KIT_,'
      '110152913=                :IS_MARKED_;'
      '110152914=      ELSE'
      '110152915=          SELECT T.G_PRODUCT_PAR,'
      '110152916=                 T.G_PRODUCT,'
      '110152917=                 T.PRICE,'
      '110152918=                 T.VOLUME_PRICE,'
      '110152919=                 T.IS_KIT,'
      '110152920=                 T.IS_MARKED'
      '110152921=            FROM G_PRODUCT T, LT_BARCODE D'
      '110152922=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110152923=              AND T.IS_ACTIVE = 1'
      '110152924=              AND D.BARCODE = :BARCODE_'
      '110152925=            INTO'
      '110152926=                :G_PRODUCT_CATEGORY_,'
      '110152927=                :G_PRODUCT_,'
      '110152928=                :PRICE_,'
      '110152929=                :VOLUME_PRICE_,'
      '110152930=                :IS_KIT_,'
      '110152931=                :IS_MARKED_;'
      '110152932='
      '110152933=      if (ROW_COUNT = 0) then BEGIN'
      '110152934=          ERR_CODE = -20500;'
      
        '110152935=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110152936=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110152937=          EXIT;'
      '110152938=      END'
      '110152939=    END'
      '110152940='
      
        '110152941=  /*END ELSE if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) the' +
        'n BEGIN'
      '110152942=    SELECT T.G_PRODUCT_PAR,'
      '110152943=        T.G_PRODUCT,'
      '110152944=        T.PRICE,'
      '110152945=        T.VOLUME_PRICE'
      '110152946=    FROM G_PRODUCT T'
      '110152947=    WHERE T.ARTICUL = :ARTICUL_'
      '110152948=    INTO'
      '110152949=        G_PRODUCT_CATEGORY_,'
      '110152950=        :G_PRODUCT_,'
      '110152951=        :PRICE_,'
      '110152952=        :VOLUME_PRICE_;'
      '110152953='
      '110152954=    if (ROW_COUNT = 0) then BEGIN'
      '110152955=      ERR_CODE = -20500;'
      
        '110152956=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:ERR_MS' +
        'G);'
      '110152957=      ERR_MSG = PROCNAME||ERR_MSG;'
      '110152958=      EXIT;'
      '110152959=    END'
      '110152960='
      
        '110152961=  END ELSE if (CHAR_LENGTH(TRIM(:NOMER_)) > 0) then BE' +
        'GIN'
      '110152962=    SELECT T.G_PRODUCT_PAR,'
      '110152963=        T.G_PRODUCT,'
      '110152964=        T.PRICE,'
      '110152965=        T.VOLUME_PRICE'
      '110152966=    FROM G_PRODUCT T'
      '110152967=    WHERE T.NOMENCLATUR_NUM = :NOMER_'
      '110152968=    INTO'
      '110152969=        G_PRODUCT_CATEGORY_,'
      '110152970=        :G_PRODUCT_,'
      '110152971=        :PRICE_,'
      '110152972=        :VOLUME_PRICE_;'
      '110152973='
      '110152974=    if (ROW_COUNT = 0) then BEGIN'
      '110152975=      ERR_CODE = -20500;'
      
        '110152976=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083#1072#1090#1091#1088#1085#1099#1084' '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMER_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '110152977=      ERR_MSG = PROCNAME||ERR_MSG;'
      '110152978=      EXIT;'
      '110152979=    END'
      '110152980='
      
        '110152981=  END ELSE if (CHAR_LENGTH(TRIM(:NAME_)) > 0) then BEG' +
        'IN'
      
        '110152982=      --'#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MAX '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042#1044#1056#1059#1043' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1057' '#1058#1040#1050#1048#1052' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1052
      '110152983=      EXECUTE STATEMENT'
      
        '110152984=      '#39'SELECT G_PRODUCT, G_PRODUCT_PAR, PRICE FROM G_P' +
        'RODUCT '#39'||'
      '110152985=      '#39' WHERE G_PRODUCT = '#39'||'
      
        '110152986=                  '#39'(SELECT MAX(G_PRODUCT) FROM G_PRODU' +
        'CT '#39'||'
      
        '110152987=                  '#39' WHERE UPPER(NAME) LIKE '#39#39'%'#39'||:NAME' +
        '_||'#39'%'#39#39')'#39
      
        '110152988=      INTO :G_PRODUCT_, :G_PRODUCT_CATEGORY_, :PRICE_ ' +
        ';'
      '110152989=      if (G_PRODUCT_ = 0) then BEGIN'
      '110152990=          ERR_CODE = -20500;'
      
        '110152991=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1077#1084' "'#39'||NAME_||'#39'" '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '110152992=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110152993=          EXIT;'
      '110152994=      END'
      '110152995=  END  */'
      '110152996=end'
      '110152997=;'
      '110152998='
      '110152999=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '1101521000=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101521001=  ARTICUL_ VARCHAR(30),'
      '1101521002=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101521003=  BARCODE_ VARCHAR(30),'
      '1101521004=  NAME_ VARCHAR(500),'
      '1101521005=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101521006=  PRICE_ NUMERIC(15,2),'
      '1101521007=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101521008=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101521009=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101521010=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101521011=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101521012=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101521013=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101521014=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101521015=  IS_CATEGORY_ INTEGER,'
      '1101521016=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101521017=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101521018=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101521019=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101521020=  IS_MARKED_ INTEGER)'
      '1101521021=RETURNS ('
      '1101521022=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101521023=  ERR_CODE INTEGER,'
      '1101521024=  ERR_MSG VARCHAR(1024))'
      '1101521025=AS'
      
        '1101521026=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PROD' +
        'UCT'#39';'
      '1101521027=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1101521028=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101521029=begin'
      
        '1101521030=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101521031=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1101521032=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101521033=                      FROM G_PRODUCT G'
      
        '1101521034=                     WHERE UPPER(G.ARTICUL) = UPPER(T' +
        'RIM(:ARTICUL_))'
      '1101521035=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '1101521036=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101521037=          ERR_CODE = -20500;'
      
        '1101521038=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1101521039=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101521040=          EXIT;'
      '1101521041=        END'
      '1101521042=    end'
      '1101521043='
      
        '1101521044=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      
        '1101521045=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) the' +
        'n begin'
      '1101521046=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101521047=                     FROM G_PRODUCT G'
      
        '1101521048=                    WHERE UPPER(G.NOMENCLATUR_NUM) = ' +
        'UPPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '1101521049=                      AND TRIM(G.NOMENCLATUR_NUM) <> ' +
        #39#39
      
        '1101521050=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101521051=          ERR_CODE = -20500;'
      
        '1101521052=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1101521053=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101521054=          EXIT;'
      '1101521055=        END'
      '1101521056=    end'
      '1101521057='
      '1101521058=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101521059=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101521060=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '1101521061=                      FROM G_PRODUCT G'
      
        '1101521062=                     WHERE UPPER(G.BARCODE) = UPPER(T' +
        'RIM(:BARCODE_))'
      '1101521063=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '1101521064=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101521065=          ERR_CODE = -20500;'
      
        '1101521066=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101521067=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101521068=          EXIT;'
      '1101521069=        END'
      '1101521070='
      '1101521071=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101521072=                     FROM G_PRODUCT G, LT_BARCODE L'
      '1101521073=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101521074=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '1101521075=                      AND TRIM(L.BARCODE) <> '#39#39
      
        '1101521076=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101521077=          ERR_CODE = -20500;'
      
        '1101521078=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101521079=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101521080=          EXIT;'
      '1101521081=        END'
      '1101521082=    end'
      '1101521083='
      
        '1101521084=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_P' +
        'RICE,'
      
        '1101521085=                           IS_CATEGORY, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_CO' +
        'MM, KOD_TNVD,'
      
        '1101521086=                           FAST_TOVAR, DO_NOT_CHARGE_' +
        'BONUS, IS_MARKED)'
      
        '1101521087=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PR' +
        'ICE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1101521088=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CRO' +
        'SSCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNV' +
        'D_,'
      
        '1101521089=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_' +
        'MARKED_)'
      '1101521090=    RETURNING G_PRODUCT'
      '1101521091=    INTO :G_PRODUCT_;'
      '1101521092='
      '1101521093=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1101521094=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1101521095=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101521096=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1101521097='
      '1101521098=        INSERT INTO LT_BARCODE'
      
        '1101521099=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101521100='
      
        '1101521101=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089 +
        #1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '1101521102=        INSERT into G_PRODUCT_IMAGE'
      
        '1101521103=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TY' +
        'PE from G_PRODUCT_IMAGE_TMP;'
      '1101521104='
      
        '1101521105=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074 +
        #1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '1101521106=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076 +
        #1091#1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '1101521107=        IF (is_kit_ > 0) THEN begin'
      '1101521108=            INSERT INTO G_PRODUCT_KIT'
      
        '1101521109=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP;'
      '1101521110='
      '1101521111=            if (is_kit_ = 1) then begin'
      
        '1101521112=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101521113=                  FROM G_PRODUCT_KIT K,'
      '1101521114=                       LT_SKLAD_PRODUCT L'
      '1101521115=                 WHERE K.g_product = :G_PRODUCT_'
      '1101521116=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101521117=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101521118=                 GROUP BY K.G_PRODUCT'
      '1101521119=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101521120='
      '1101521121=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101521122=                   SET L.AMOUNT = COALESCE(:G_PRODUCT' +
        '_SOSTAV_AMOUNT_, 0)'
      '1101521123=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101521124=            end'
      '1101521125=        END'
      '1101521126=    END'
      '1101521127=end'
      '1101521128=;'
      '1101521129='
      '1101521130=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1101521131=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101521132=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101521133=  ARTICUL_ VARCHAR(30),'
      '1101521134=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101521135=  BARCODE_ VARCHAR(30),'
      '1101521136=  NAME_ VARCHAR(500),'
      '1101521137=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101521138=  PRICE_ NUMERIC(15,2),'
      '1101521139=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101521140=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101521141=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101521142=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101521143=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101521144=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101521145=  IS_CATEGORY_ INTEGER,'
      '1101521146=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101521147=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101521148=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101521149=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101521150=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101521151=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101521152=  IS_MARKED_ INTEGER)'
      '1101521153=RETURNS ('
      '1101521154=  ERR_CODE INTEGER,'
      '1101521155=  ERR_MSG VARCHAR(1024))'
      '1101521156=AS'
      
        '1101521157=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      
        '1101521158=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101521159=begin'
      
        '1101521160=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101521161=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '1101521162=                  FROM G_PRODUCT G'
      
        '1101521163=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(' +
        ':ARTICUL_))'
      '1101521164=                   AND TRIM(G.ARTICUL) <> '#39#39
      '1101521165=                   AND TRIM(:ARTICUL_) <> '#39#39
      '1101521166=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101521167=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101521168=      ERR_CODE = -20500;'
      
        '1101521169=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '1101521170=      EXIT;'
      '1101521171=    END'
      '1101521172='
      
        '1101521173=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1101521174=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101521175=                  FROM G_PRODUCT G'
      
        '1101521176=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPP' +
        'ER(TRIM(:NOMENCLATUR_NUM_))'
      '1101521177=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1101521178=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1101521179=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101521180=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101521181=      ERR_CODE = -20500;'
      
        '1101521182=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101521183=      EXIT;'
      '1101521184=    END'
      '1101521185='
      '1101521186=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101521187=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101521188=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101521189=                  FROM G_PRODUCT G'
      
        '1101521190=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(' +
        ':BARCODE_))'
      '1101521191=                   AND TRIM(G.BARCODE) <> '#39#39
      '1101521192=                   AND TRIM(:BARCODE_) <> '#39#39
      '1101521193=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101521194=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101521195=          ERR_CODE = -20500;'
      
        '1101521196=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101521197=          EXIT;'
      '1101521198=        END'
      '1101521199='
      '1101521200=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101521201=                    FROM G_PRODUCT G, LT_BARCODE L'
      '1101521202=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101521203=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '1101521204=                     AND TRIM(L.BARCODE) <> '#39#39
      '1101521205=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101521206=          ERR_CODE = -20500;'
      
        '1101521207=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101521208=          EXIT;'
      '1101521209=        END'
      '1101521210=    END'
      '1101521211='
      '1101521212=    update G_PRODUCT'
      '1101521213=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1101521214=        ARTICUL = :ARTICUL_,'
      '1101521215=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1101521216=        BARCODE = :BARCODE_,'
      '1101521217=        NAME = :NAME_,'
      '1101521218=        G_UNIT = :G_UNIT_,'
      '1101521219=        PRICE = :PRICE_,'
      '1101521220=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101521221=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1101521222=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1101521223=        NOTE         = :NOTE_,'
      '1101521224=        CROSSCODE    = :CROSSCODE_,'
      '1101521225=        IS_KIT       = :IS_KIT_,'
      '1101521226=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1101521227=        PLACE        = :PLACE_,'
      '1101521228=        SALES_COMM   = :SALES_COMM_,'
      '1101521229=        KOD_TNVD     = :KOD_TNVD_,'
      '1101521230=        FAST_TOVAR   = :FAST_TOVAR_,'
      '1101521231=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '1101521232=        IS_MARKED    = :IS_MARKED_'
      '1101521233=    where (G_PRODUCT = :G_PRODUCT_);'
      '1101521234='
      '1101521235=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1101521236=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1101521237='
      '1101521238=        INSERT INTO LT_BARCODE'
      
        '1101521239=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101521240='
      '1101521241=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1101521242=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1101521243=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1101521244='
      
        '1101521245=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1101521246=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101521247='
      '1101521248=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1101521249=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1101521250=            INSERT INTO G_PRODUCT_KIT'
      
        '1101521251=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1101521252=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1101521253=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1101521254=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1101521255='
      
        '1101521256=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1101521257=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101521258='
      '1101521259=            UPDATE G_PRODUCT_KIT G'
      
        '1101521260=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1101521261=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1101521262=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1101521263=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1101521264='
      
        '1101521265=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1101521266=            if (is_kit_ = 1) then begin'
      
        '1101521267=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101521268=                  FROM G_PRODUCT_KIT K,'
      '1101521269=                       LT_SKLAD_PRODUCT L'
      '1101521270=                 WHERE K.g_product = :G_PRODUCT_'
      '1101521271=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101521272=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101521273=                 GROUP BY K.G_PRODUCT'
      '1101521274=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101521275='
      '1101521276=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101521277=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1101521278=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101521279=            end'
      '1101521280=        END'
      '1101521281=    END'
      '1101521282=end'
      '1101521283=;'
      '1101521284='
      '1101521285=ALTER PROCEDURE INS_SKLAD('
      '1101521286=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1101521287=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1101521288=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1101521289=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1101521290=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1101521291=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101521292=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101521293=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1101521294=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101521295=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1101521296=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101521297=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101521298=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1101521299=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1101521300=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1101521301=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101521302=RETURNS ('
      '1101521303=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101521304=  ERR_CODE INTEGER,'
      '1101521305=  ERR_MSG VARCHAR(1024))'
      '1101521306=AS'
      '1101521307=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '1101521308=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054 +
        #1042#1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '1101521309=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '1101521310=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '1101521311=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059 +
        #1055#1050#1048
      
        '1101521312=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '1101521313=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053 +
        #1050#1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054 +
        #1047#1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '1101521314=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041 +
        #1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUM' +
        'M '#1041#1059#1044#1059
      '1101521315=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1101521316=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048 +
        #1047#1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053 +
        #1048' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '1101521317=--'
      
        '1101521318=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1101521319=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1101521320=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '1101521321=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101521322=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1101521323=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1101521324=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1101521325=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1101521326=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '1101521327=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_' +
        'SUMM = 0;'
      
        '1101521328=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      '1101521329=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101521330=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PR' +
        'IHOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '1101521331=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101521332=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101521333=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1101521334=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101521335=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101521336=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1101521337=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101521338=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101521339=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1101521340=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1101521341=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101521342=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1101521343=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1101521344=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK' +
        '_CODE;'
      '1101521345=BEGIN'
      '1101521346='
      '1101521347=  PNT_ = '#39'00'#39';'
      '1101521348=  IS_THIS_LAST_ = 0;'
      '1101521349='
      '1101521350=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101521351=    SELECT ID'
      '1101521352=      FROM CUR_PARAMS'
      '1101521353=     WHERE CUR_PARAMS = 2'
      '1101521354=      INTO :G_TOCHKA_;'
      '1101521355='
      '1101521356=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1101521357=  SELECT ID'
      '1101521358=    FROM CUR_PARAMS'
      '1101521359=   WHERE CUR_PARAMS = 1'
      '1101521360=    INTO :G_OFFICIAL_;'
      '1101521361='
      '1101521362=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101521363=                            DATE_RECEIPT,'
      '1101521364=                            TIME_RECEIPT,'
      '1101521365=                            G_CLIENT,'
      '1101521366=                            G_PAYMENT_TYPE,'
      '1101521367=                            OSNOVANIE,'
      '1101521368=                            NOTE,'
      '1101521369=                            SUMM,'
      '1101521370=                            SUMM_FACT,'
      '1101521371=                            SUMM_CURRENCY,'
      '1101521372=                            IS_PAYED_ALL,'
      '1101521373=                            IS_VOZVRAT,'
      '1101521374=                            G_TOCHKA'
      '1101521375=                            ,G_OFFICIAL'
      '1101521376=                            ,IS_EXPECTED)'
      '1101521377=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101521378=          :DATE_RECEIPT_,'
      '1101521379=          :TIME_RECEIPT_,'
      '1101521380=          :G_CLIENT_,'
      '1101521381=          :G_PAYMENT_TYPE_,'
      '1101521382=          :OSNOVANIE_,'
      '1101521383=          :NOTE_,'
      '1101521384=          :SUMM_,'
      '1101521385=          :SUMM_FACT_,'
      '1101521386=          :SUMM_CURRENCY_,'
      
        '1101521387=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_P' +
        'AYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' ' +
        '"'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101521388=          :IS_VOZVRAT_,'
      '1101521389=          :G_TOCHKA_'
      '1101521390=          ,:G_OFFICIAL_'
      '1101521391=          ,:IS_EXPECTED_)'
      '1101521392=  RETURNING'
      '1101521393=    SKLAD'
      '1101521394=  INTO'
      '1101521395=    :SKLAD_;'
      '1101521396='
      '1101521397=  PNT_ = '#39'01'#39';'
      '1101521398=  FOR SELECT SKLAD,'
      '1101521399=             T.G_PRODUCT,'
      '1101521400=             AMOUNT,'
      '1101521401=             T.PRICE,'
      '1101521402=             SUMM,'
      '1101521403=             NDS,'
      '1101521404=             NDS_SUMM'
      '1101521405=             ,PRICE_CURRENCY'
      '1101521406=             ,SUMM_CURRENCY'
      '1101521407=             ,PRICE_ROZN'
      '1101521408=             ,GG.PRICE'
      '1101521409=             ,T.MARK_CODE'
      '1101521410=        FROM SKLAD_TMP T,'
      '1101521411=             G_PRODUCT GG'
      '1101521412=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '1101521413=      ORDER BY 1'
      '1101521414=      INTO :SKLAD_TMP_,'
      '1101521415=           :RG_PRODUCT_,'
      '1101521416=           :RAMOUNT_,'
      '1101521417=           :RPRICE_,'
      '1101521418=           :RSUMM_,'
      '1101521419=           :RNDS_,'
      '1101521420=           :RNDS_SUMM_'
      '1101521421=           ,:PRICE_CURRENCY_'
      '1101521422=           ,:SUMM_CURRENCY_TMP_'
      '1101521423=           ,:SALE_PRICE_'
      '1101521424=           ,:SALE_PRICE_CUR_'
      '1101521425=           ,:MARK_CODE_'
      '1101521426=  DO BEGIN'
      '1101521427=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '1101521428=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST,' +
        ' '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101521429=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051 +
        #1068#1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '1101521430=      IS_THIS_LAST_ = 0;'
      '1101521431=      SELECT MAX(SK.DATE_RECEIPT)'
      '1101521432=        FROM SKLAD SK'
      '1101521433=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101521434=         AND SK.IS_LAST = 1'
      '1101521435=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101521436=        INTO :DATE_LAST_;'
      '1101521437='
      
        '1101521438=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101521439=        UPDATE SKLAD SK'
      '1101521440=           SET SK.IS_LAST = 0'
      '1101521441=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101521442=           AND SK.IS_LAST = 1'
      '1101521443=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101521444='
      '1101521445=        IS_THIS_LAST_ = 1;'
      '1101521446=      END'
      '1101521447=    END'
      '1101521448='
      '1101521449=    INSERT INTO SKLAD'
      '1101521450=    ('
      '1101521451=     SKLAD,'
      '1101521452=     SKLAD_PARENT,'
      '1101521453=     DATE_RECEIPT,'
      '1101521454=     G_CLIENT,'
      '1101521455=     G_PRODUCT,'
      '1101521456=     AMOUNT,'
      '1101521457=     PRICE,'
      '1101521458=     SUMM,'
      '1101521459=     G_PAYMENT_TYPE,'
      '1101521460=     OSNOVANIE,'
      '1101521461=     NOTE,'
      '1101521462=     NDS,'
      '1101521463=     NDS_SUMM,'
      '1101521464=     IS_LAST,'
      '1101521465=     IS_VOZVRAT,'
      '1101521466=     G_TOCHKA'
      '1101521467=     ,PRICE_CURRENCY'
      '1101521468=     ,SUMM_CURRENCY'
      '1101521469=     ,MARK_CODE'
      '1101521470=    ) VALUES ('
      '1101521471=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1101521472=     :SKLAD_,'
      '1101521473=     :DATE_RECEIPT_,'
      '1101521474=     :G_CLIENT_,'
      '1101521475=     :RG_PRODUCT_,'
      '1101521476=     :RAMOUNT_,'
      '1101521477=     :RPRICE_,'
      '1101521478=     :RSUMM_,'
      '1101521479=     :G_PAYMENT_TYPE_,'
      '1101521480=     :OSNOVANIE_,'
      '1101521481=     :NOTE_,'
      '1101521482=     :RNDS_,'
      '1101521483=     :RNDS_SUMM_,'
      
        '1101521484=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056 +
        #1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059 +
        #1044#1045#1058' 0'
      '1101521485=     :IS_VOZVRAT_,'
      '1101521486=     :G_TOCHKA_'
      '1101521487=     ,:PRICE_CURRENCY_'
      '1101521488=     ,:SUMM_CURRENCY_TMP_'
      '1101521489=     ,:MARK_CODE_'
      '1101521490=    );'
      '1101521491='
      
        '1101521492=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1101521493=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101521494=        PNT_ = '#39'02'#39';'
      '1101521495=        UPDATE LT_SKLAD_PRODUCT L'
      '1101521496=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1101521497=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101521498=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101521499='
      '1101521500=        IF (ROW_COUNT = 0) THEN'
      
        '1101521501=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA' +
        '_);'
      '1101521502=    END'
      '1101521503='
      
        '1101521504=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061 +
        #1054#1044#1045
      '1101521505=      UPDATE G_PRODUCT G'
      '1101521506=         SET G.PRICE = :SALE_PRICE_'
      '1101521507=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '1101521508=  END'
      '1101521509=  ----------------------------------------'
      '1101521510='
      
        '1101521511=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1101521512=  PNT_ = '#39'05'#39';'
      
        '1101521513=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1101521514=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1101521515=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101521516=      ELSE'
      '1101521517=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1101521518='
      
        '1101521519=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1101521520=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1101521521=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101521522=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1101521523=                                        :SUMM_FACT_,'
      
        '1101521524=                                        :DATE_RECEIPT' +
        '_,'
      
        '1101521525=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1101521526=                                        NULL,   --ZAK' +
        'AZ_'
      '1101521527=                                        :SKLAD_,'
      
        '1101521528=                                        :G_PAYMENT_TY' +
        'PE_,'
      
        '1101521529=                                        :G_TOCHKA_) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101521530=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101521531=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101521532=            EXIT;'
      '1101521533=          END'
      '1101521534=      END ELSE BEGIN'
      '1101521535=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1101521536=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1101521537=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101521538=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101521539=            ELSE'
      
        '1101521540=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101521541='
      '1101521542=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101521543=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101521544='
      
        '1101521545=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101521546='
      '1101521547=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101521548=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101521549=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1101521550=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1101521551=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1101521552=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101521553=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1101521554=                                              :SKLAD_' +
        ','
      
        '1101521555=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1101521556=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101521557=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101521558=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101521559=                  EXIT;'
      '1101521560=                END'
      '1101521561=            END'
      '1101521562=          END'
      '1101521563=      END'
      '1101521564=  END'
      '1101521565='
      '1101521566=  DELETE FROM SKLAD_TMP;'
      '1101521567='
      
        '1101521568=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1101521569=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101521570=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1101521571=                                  G_PRIHOD_,'
      '1101521572=                                  :SUMM_PRIHOD_,'
      '1101521573=                                  :DATE_RECEIPT_,'
      
        '1101521574=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101521575=                                  NULL,   --:ZAKAZ_,'
      '1101521576=                                  :SKLAD_,'
      '1101521577=                                  :G_PAYMENT_TYPE_,'
      
        '1101521578=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101521579=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101521580=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101521581=      EXIT;'
      '1101521582=    END'
      '1101521583=  END'
      '1101521584='
      '1101521585=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101521586=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THE' +
        'N'
      
        '1101521587=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101521588=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_, ' +
        '1);'
      '1101521589=end'
      '1101521590=;'
      '1101521591='
      '1101521592=ALTER PROCEDURE INS_SKLAD_TMP('
      '1101521593=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101521594=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101521595=  PRICE_ NUMERIC(15,2),'
      '1101521596=  SUMM_ NUMERIC(15,2),'
      '1101521597=  NDS_ NUMERIC(15,2),'
      '1101521598=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101521599=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1101521600=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0,'
      
        '1101521601=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC = 0,'
      
        '1101521602=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0' +
        ','
      
        '1101521603=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OP' +
        'T_PROC = 0,'
      '1101521604=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0,'
      
        '1101521605=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0,'
      '1101521606=  MARK_CODE_ TYPE OF COLUMN SKLAD_TMP.MARK_CODE = '#39#39')'
      '1101521607=RETURNS ('
      '1101521608=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101521609=  ERR_CODE INTEGER,'
      '1101521610=  ERR_MSG VARCHAR(1024))'
      '1101521611=AS'
      
        '1101521612=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_T' +
        'MP'#39';'
      '1101521613=BEGIN'
      '1101521614='
      '1101521615=  IF (CHAR_LENGTH(MARK_CODE_) = 0) THEN'
      '1101521616=      SELECT T.SKLAD'
      '1101521617=        FROM SKLAD_TMP T'
      '1101521618=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101521619=         AND T.PRICE = :PRICE_'
      '1101521620=        INTO :SKLAD_;'
      '1101521621='
      '1101521622=  IF (SKLAD_ IS NOT NULL) THEN'
      '1101521623=    UPDATE SKLAD_TMP T'
      '1101521624=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1101521625=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1101521626=     WHERE T.SKLAD = :SKLAD_;'
      '1101521627='
      '1101521628=  ELSE BEGIN'
      '1101521629=      IF (PRICE_ = 0) THEN BEGIN'
      '1101521630=        CHARGE_ROZN_PROC_ = 0;'
      '1101521631=        CHARGE_OPT_PROC_ = 0;'
      '1101521632=      END ELSE BEGIN'
      
        '1101521633=        CHARGE_ROZN_PROC_ = ROUND((:PRICE_ROZN_ - :PR' +
        'ICE_) * 100 / :PRICE_, 2);'
      
        '1101521634=        CHARGE_OPT_PROC_ = ROUND((:PRICE_OPT_ - :PRIC' +
        'E_) * 100 / :PRICE_, 2);'
      '1101521635=      END'
      '1101521636='
      
        '1101521637=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '1101521638=                            CHARGE_ROZN_PROC,'
      '1101521639=                            PRICE_ROZN,'
      '1101521640=                            CHARGE_OPT_PROC,'
      
        '1101521641=                            PRICE_OPT, CHANGE_SALE_PR' +
        'ICE, MARK_CODE)'
      
        '1101521642=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '1101521643=        ,:PRICE_CURRENCY_'
      '1101521644=        ,:SUMM_CURRENCY_'
      '1101521645=        ,:CHARGE_ROZN_PROC_'
      '1101521646=        ,:PRICE_ROZN_'
      '1101521647=        ,:CHARGE_OPT_PROC_'
      '1101521648=        ,:PRICE_OPT_'
      '1101521649=        ,:CHANGE_SALE_PRICE_'
      '1101521650=        ,:MARK_CODE_)'
      '1101521651=      RETURNING SKLAD'
      '1101521652=      INTO :SKLAD_;'
      '1101521653=  END'
      '1101521654=end'
      '1101521655=;'
      '1101521656='
      '1101521657=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '1101521658=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101521659=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1101521660=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT ' +
        '= 0,'
      
        '1101521661=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0)'
      '1101521662=RETURNS ('
      '1101521663=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101521664=  ERR_CODE INTEGER,'
      '1101521665=  ERR_MSG VARCHAR(1024))'
      '1101521666=AS'
      '1101521667=/*'
      '1101521668='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '1101521669=*/'
      
        '1101521670=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_T' +
        'MP'#39';'
      '1101521671=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101521672=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '1101521673=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      '1101521674=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '1101521675=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT' +
        '.PRICE;'
      
        '1101521676=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODU' +
        'CT.VOLUME_PRICE;'
      '1101521677=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '1101521678=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '1101521679=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101521680=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      
        '1101521681=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101521682=DECLARE VARIABLE IS_MARKED_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_MARKED;'
      '1101521683=BEGIN'
      '1101521684='
      '1101521685=  PNT_ = '#39'01'#39';'
      
        '1101521686=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCO' +
        'DE_, NULL, NULL, NULL, NULL)'
      
        '1101521687=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGO' +
        'RY_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :IS_MARKE' +
        'D_, :ERR_CODE, :ERR_MSG;'
      '1101521688='
      '1101521689=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101521690=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101521691=    EXIT;'
      '1101521692=  END'
      '1101521693='
      '1101521694=  PNT_ = '#39'02'#39';'
      '1101521695=  IF (IS_VOZVRAT_ = 0) THEN BEGIN'
      
        '1101521696=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, :G_TOCHKA_, 0)'
      '1101521697=          RETURNING_VALUES :PRICE_;'
      '1101521698='
      '1101521699=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101521700=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101521701=        EXIT;'
      '1101521702=      END'
      '1101521703=  END ELSE'
      '1101521704=    PRICE_ = SALE_PRICE_;'
      '1101521705='
      '1101521706=  AMOUNT_ = 1;'
      '1101521707='
      '1101521708=  SELECT T.SKLAD'
      '1101521709=    FROM SKLAD_TMP T'
      '1101521710=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101521711=     AND T.PRICE = :PRICE_'
      '1101521712=    INTO :SKLAD_;'
      '1101521713='
      '1101521714=  IF (SKLAD_ IS NOT NULL) THEN'
      '1101521715=    UPDATE SKLAD_TMP T'
      '1101521716=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1101521717=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1101521718=     WHERE T.SKLAD = :SKLAD_;'
      '1101521719='
      '1101521720=  ELSE'
      
        '1101521721=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PR' +
        'ICE_OPT, CHANGE_SALE_PRICE)'
      
        '1101521722=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_,'
      
        '1101521723=             DECODE(:PRICE_, 0, 0, ROUND((:SALE_PRICE' +
        '_/:PRICE_ - 1)*100, 2)),'
      '1101521724=             :SALE_PRICE_,'
      
        '1101521725=             DECODE(:PRICE_, 0, 0, ROUND((:VOLUME_PRI' +
        'CE_/:PRICE_ - 1)*100, 2)),'
      '1101521726=             :VOLUME_PRICE_,'
      '1101521727=             :CHANGE_SALE_PRICE_)'
      '1101521728=      RETURNING SKLAD'
      '1101521729=      INTO :SKLAD_;'
      '1101521730=end'
      '1101521731=;'
      '1101521732='
      '1101521733=ALTER PROCEDURE INS_ZAKAZ('
      '1101521734=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101521735=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101521736=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101521737=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101521738=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101521739=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101521740=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101521741=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101521742=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101521743=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101521744=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101521745=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101521746=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101521747=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101521748=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101521749=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101521750=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101521751=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101521752=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101521753=  IS_MEBEL_ INTEGER = 0,'
      
        '1101521754=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1101521755=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      '1101521756=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '1101521757=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1101521758=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101521759=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1101521760=  NOT_MINUS_OSTATOK_ INTEGER = 0)'
      '1101521761=RETURNS ('
      '1101521762=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101521763=  ERR_CODE INTEGER,'
      '1101521764=  ERR_MSG VARCHAR(1024))'
      '1101521765=AS'
      '1101521766=/*'
      '1101521767=IS_SPISANIE_'
      '1101521768=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101521769=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101521770=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101521771=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101521772='
      '1101521773='
      
        '1101521774=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '1101521775=*/'
      '1101521776=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1101521777=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101521778=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101521779=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1101521780=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1101521781=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1101521782=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1101521783=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1101521784=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1101521785=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1101521786=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1101521787=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1101521788=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1101521789=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1101521790=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101521791=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '1101521792=DECLARE VARIABLE CNT_ INTEGER;'
      '1101521793=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1101521794=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1101521795=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1101521796=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101521797=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101521798=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1101521799=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101521800=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101521801=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1101521802=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101521803=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101521804=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101521805=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1101521806=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1101521807=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101521808=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLI' +
        'ENT.SKIDKA;'
      
        '1101521809=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.N_PERCENT;'
      
        '1101521810=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DI' +
        'SCONT_CARD.SUMM_ALL;'
      
        '1101521811=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.MARK_CODE;'
      '1101521812=BEGIN'
      '1101521813='
      
        '1101521814=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1101521815=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1101521816=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1101521817=  IF (CNT_ = 0) THEN BEGIN'
      '1101521818=    ERR_CODE = -20500;'
      
        '1101521819=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101521820=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1101521821=    EXIT;'
      '1101521822=  END'
      '1101521823='
      '1101521824=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101521825=    SELECT ID'
      '1101521826=      FROM CUR_PARAMS'
      '1101521827=     WHERE CUR_PARAMS = 2'
      '1101521828=      INTO :G_TOCHKA_;'
      '1101521829='
      '1101521830=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101521831=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1101521832=      PNT_ = '#39'01'#39';'
      
        '1101521833=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101521834=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101521835=      ELSE'
      '1101521836=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101521837='
      '1101521838=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1101521839=      SELECT G.G_OFFICIAL,'
      '1101521840=             G.DO_NOT_SALES_COMM,'
      '1101521841=             G.FM||'#39' '#39'||G.NM'
      '1101521842=        FROM G_OFFICIAL G'
      
        '1101521843=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1101521844=        INTO :G_OFFICIAL_,'
      '1101521845=             :DO_NOT_SALES_COMM_,'
      '1101521846=             :OFFICIAL_NAME_;'
      '1101521847='
      '1101521848=      INSERT INTO ZAKAZ'
      '1101521849=      ('
      '1101521850=       ZAKAZ,'
      '1101521851=       G_TOCHKA,'
      '1101521852=       Z_DATE,'
      '1101521853=       Z_TIME,'
      '1101521854=       G_CLIENT,'
      '1101521855=       G_PAYMENT_TYPE,'
      '1101521856=       OSNOVANIE,'
      '1101521857=       IS_SPISANIE,'
      '1101521858=       NOTE,'
      '1101521859=       SUMM,'
      '1101521860=       SUMM_FACT,'
      '1101521861=       SUMM_BONUS,'
      '1101521862=       IS_PAYED_ALL'
      '1101521863=       ,G_OFFICIAL'
      '1101521864=       ,BY_RECIPE'
      '1101521865=       ,SUMM_BONUS_GOT'
      '1101521866=       ,IS_RESERVE'
      '1101521867=       ,SUMM_CASH'
      '1101521868=       ,SUMM_NONCASH'
      '1101521869=       ,NOT_MINUS_OSTATOK'
      '1101521870=      ) VALUES ('
      '1101521871=       GEN_ID(GEN_ZAKAZ, 1),'
      '1101521872=       :G_TOCHKA_,'
      '1101521873=       :Z_DATE_,'
      '1101521874=       :Z_TIME_,'
      '1101521875=       :G_CLIENT_,'
      '1101521876=       :G_PAYMENT_TYPE_,'
      '1101521877=       :OSNOVANIE_,'
      '1101521878=       :IS_SPISANIE_,'
      '1101521879=       :NOTE_,'
      '1101521880=       :SUMM_,'
      '1101521881=       :SUMM_FACT_1_,'
      '1101521882=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1101521883=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101521884=       ,:G_OFFICIAL_'
      '1101521885=       ,:BY_RECIPE_'
      '1101521886=       ,:SUMM_BONUS_GOT_'
      '1101521887=       ,:IS_RESERVE_'
      '1101521888=       ,COALESCE(:SUMM_CASH_, 0)'
      '1101521889=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1101521890=       ,:NOT_MINUS_OSTATOK_'
      '1101521891=      )'
      '1101521892=      RETURNING'
      '1101521893=        ZAKAZ'
      '1101521894=      INTO'
      '1101521895=        :ZAKAZ_;'
      '1101521896='
      '1101521897=      PNT_ = '#39'02'#39';'
      
        '1101521898=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1101521899=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM, Z.MARK_CODE'
      '1101521900=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1101521901=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1101521902=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1101521903=              :G_PRODUCT,'
      '1101521904=              :AMOUNT,'
      '1101521905=              :PRICE,'
      '1101521906=              :SUMM,'
      '1101521907=              :DISCOUNT_PERC,'
      '1101521908=              :DISCOUNT_TENGE,'
      '1101521909=              :DISCOUNT_SUMM,'
      '1101521910=              :NDS,'
      '1101521911=              :NDS_SUMM,'
      '1101521912=              :COST_PRICE,'
      '1101521913=              :SALES_COMM_,'
      '1101521914=              :MARK_CODE_'
      '1101521915=      DO BEGIN'
      
        '1101521916=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101521917=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1101521918=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1101521919=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101521920=        END'
      '1101521921='
      '1101521922=        INSERT INTO ZAKAZ_DETAILS'
      '1101521923=        VALUES('
      '1101521924=          :ZAKAZ_DETAILS_TMP_,'
      '1101521925=          :ZAKAZ_,'
      '1101521926=          :G_PRODUCT,'
      '1101521927=          :AMOUNT,'
      '1101521928=          :PRICE,'
      '1101521929=          :SUMM,'
      '1101521930=          :DISCOUNT_PERC,'
      '1101521931=          :DISCOUNT_TENGE,'
      '1101521932=          :DISCOUNT_SUMM,'
      '1101521933=          :NDS,'
      '1101521934=          :NDS_SUMM,'
      '1101521935=          :COST_PRICE,'
      '1101521936=          :SALES_COMM_SUMM_ITER_,'
      '1101521937=          :MARK_CODE_'
      '1101521938=        );'
      '1101521939='
      
        '1101521940=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1101521941=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1101521942=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1101521943=                UPDATE LT_SKLAD_PRODUCT L'
      '1101521944=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101521945=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101521946=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101521947='
      '1101521948=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101521949=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101521950=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057 +
        #1051#1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '1101521951=                PNT_ = '#39'04'#39';'
      
        '1101521952=                IF ((ROW_COUNT = 0) AND ((SELECT S_VA' +
        'LUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101521953=                  Err_Code = -20500;'
      
        '1101521954=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_C' +
        'ODE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_' +
        'PRODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072 +
        #1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101521955=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101521956=                  EXIT;'
      '1101521957=                END ELSE if (ROW_COUNT = 0) then'
      
        '1101521958=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101521959=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1101521960=            END'
      '1101521961='
      '1101521962=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101521963=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101521964=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101521965=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :AMOUNT'
