      '110229195=ALTER PROCEDURE FILL_FIRST_DATA('
      '110229196=  PRODUCTY_ INTEGER = 0,'
      '110229197=  HIM_ INTEGER = 0,'
      '110229198=  APTEKA_ INTEGER = 0)'
      '110229199=AS'
      '110229200=BEGIN'
      '110229201=  IF (PRODUCTY_ = 1 OR HIM_ = 1) THEN BEGIN'
      '110229202=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229203=      VALUES (2, '#39#1073#1091#1090'.'#39', '#39#1073#1091#1090'.'#39');'
      '110229204=  END'
      '110229205='
      '110229206=  IF (APTEKA_ = 1) THEN BEGIN'
      '110229207='
      '110229208=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229209=      VALUES (3, '#39#1082#1075#39', '#39#1082#1075#39');'
      '110229210=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229211=      VALUES (5, '#39#1091#1087#1072#1082'.'#39', '#39#1091#1087#1072#1082'.'#39');'
      '110229212=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229213=      VALUES (6, '#39#1092#1083#1072#1082'.'#39', '#39#1092#1083#1072#1082'.'#39');'
      '110229214=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229215=      VALUES (7, '#39#1087#1086#1076#1075#1091#1079'.'#39', '#39#1087#1086#1076#1075#1091#1079'.'#39');'
      '110229216=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229217=      VALUES (8, '#39#1087#1083#1072#1089#1090'.'#39', '#39#1087#1083#1072#1089#1090'.'#39');'
      '110229218=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229219=      VALUES (9, '#39#1087#1072#1082'.'#39', '#39#1087#1072#1082'.'#39');'
      '110229220=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229221=      VALUES (10, '#39#1090#1072#1073'.'#39', '#39#1090#1072#1073'.'#39');'
      '110229222=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229223=      VALUES (11, '#39#1072#1084#1087'.'#39', '#39#1072#1084#1087'.'#39');'
      '110229224=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229225=      VALUES (12, '#39#1082#1086#1088'.'#39', '#39#1082#1086#1088'.'#39');'
      '110229226=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229227=      VALUES (13, '#39#1090#1091#1073#1072#39', '#39#1090#1091#1073#1072#39');'
      '110229228=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229229=      VALUES (14, '#39#1087#1072#1088'.'#39', '#39#1087#1072#1088'.'#39');'
      '110229230=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229231=      VALUES (15, '#39#1090#1085#1075'.'#39', '#39#1090#1085#1075'.'#39');'
      '110229232=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229233=      VALUES (16, '#39#1089#1072#1083#1092#1077#1090'.'#39', '#39#1089#1072#1083#1092#1077#1090'.'#39');'
      '110229234=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '110229235=      VALUES (17, '#39#1053#1072#1073#1086#1088#39', '#39#1085#1072#1073#1086#1088#39');'
      '110229236=  END'
      '110229237='
      '110229238=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_UNIT TO 35'#39';'
      '110229239='
      '110229240=  IF (PRODUCTY_ = 1) THEN'
      
        '110229241=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE' +
        ','
      
        '110229242=                           VOLUME_PRICE, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PL' +
        'ACE,'
      
        '110229243=                           SALES_COMM, IS_MARKED, IS_W' +
        'EIGHT)'
      
        '110229244=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLA' +
        'TUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '110229245=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, I' +
        'S_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM, 0, 0'
      '110229246=      FROM G_PRODUCT_FILL T'
      '110229247=     WHERE T.G_PRODUCT BETWEEN 0 AND 40000'
      '110229248=    ORDER BY 1;'
      '110229249='
      '110229250=  IF (HIM_ = 1) THEN'
      
        '110229251=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE' +
        ','
      
        '110229252=                           VOLUME_PRICE, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PL' +
        'ACE,'
      
        '110229253=                           SALES_COMM, IS_MARKED, IS_W' +
        'EIGHT)'
      
        '110229254=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLA' +
        'TUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '110229255=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, I' +
        'S_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM, 0, 0'
      '110229256=      FROM G_PRODUCT_FILL T'
      '110229257=     WHERE T.G_PRODUCT BETWEEN 40000 AND 50000'
      '110229258=    ORDER BY 1;'
      '110229259='
      '110229260=  IF (APTEKA_ = 1) THEN'
      
        '110229261=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE' +
        ','
      
        '110229262=                           VOLUME_PRICE, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PL' +
        'ACE,'
      
        '110229263=                           SALES_COMM, IS_MARKED, IS_W' +
        'EIGHT)'
      
        '110229264=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLA' +
        'TUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '110229265=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, I' +
        'S_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM, 0, 0'
      '110229266=      FROM G_PRODUCT_FILL T'
      '110229267=     WHERE T.G_PRODUCT BETWEEN 53051 AND 70000'
      '110229268=    ORDER BY 1;'
      '110229269='
      
        '110229270=  INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, G_PR' +
        'ODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110229271=  SELECT GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), G_PRODUCT, 0' +
        ', 0, 1, 0'
      '110229272=  FROM G_PRODUCT'
      '110229273=  WHERE IS_CATEGORY = 0;'
      '110229274='
      
        '110229275=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_PRODUCT TO 70' +
        '001'#39';'
      
        '110229276=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_ARTICUL TO 4000' +
        '0'#39';'
      '110229277=END'
      '110229278=;'
      '110229279='
      '110229280=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '110229281=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110229282=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110229283=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110229284=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110229285=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110229286=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110229287=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110229288=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110229289=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110229290=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110229291=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110229292=  IS_SPISANIE_ INTEGER,'
      '110229293=  NEW_LINE_SALE_ INTEGER = 0,'
      '110229294=  MODE_ INTEGER = 0,'
      '110229295=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '110229296=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '110229297=  MARK_CODE_ VARCHAR(100) = '#39#39','
      
        '110229298=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE = 0,'
      '110229299=  NOT_MINUS_OSTATOK_ SMALLINT = 0)'
      '110229300=RETURNS ('
      
        '110229301=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110229302=  ERR_CODE INTEGER,'
      '110229303=  ERR_MSG VARCHAR(1024))'
      '110229304=AS'
      '110229305=/*'
      
        '110229306=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048 +
        #1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '110229307=*/'
      
        '110229308=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39';'
      '110229309=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '110229310=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110229311=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      
        '110229312=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110229313=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110229314=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110229315=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110229316=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110229317=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110229318=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '110229319=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110229320=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' */'
      
        '110229321=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' ' +
        #1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '110229322=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110229323=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '110229324=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '110229325=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUMN' +
        ' G_PRODUCT.G_PRODUCT;'
      '110229326=BEGIN'
      '110229327=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '110229328='
      
        '110229329=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110229330=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110229331=    FROM ZAKAZ_DETAILS_TMP T'
      '110229332=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110229333=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110229334=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110229335='
      
        '110229336=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110229337=           ,G.IS_KIT'
      '110229338=           ,K.AMOUNT * :AMOUNT_'
      '110229339=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110229340=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      '110229341=           ,(CASE'
      
        '110229342=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE' +
        '_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * ' +
        'FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '110229343=             ELSE K.PRICE'
      '110229344=           END) COST_PRICE'
      
        '110229345=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_L' +
        'AST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '110229346=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE ' +
        'G_PRODUCT = :G_PRODUCT_) CNT'
      
        '110229347=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110229348=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110229349=       AND G.IS_KIT = 1'
      '110229350=    UNION'
      
        '110229351=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110229352=           ,G.IS_KIT'
      '110229353=           ,:AMOUNT_'
      '110229354=           ,:PRICE_'
      '110229355=           ,0'
      '110229356=           ,:COST_PRICE_'
      '110229357=           ,0'
      '110229358=      FROM G_PRODUCT G'
      '110229359=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110229360=       AND G.IS_KIT <> 1'
      '110229361=      INTO :G_PRODUCT_'
      '110229362=           ,:IS_KIT_'
      '110229363=           ,:AMOUNT_'
      '110229364=           ,:PRICE__'
      '110229365=           ,:SOSTAV_PRICE_'
      '110229366=           ,:COST_PRICE__'
      '110229367=           ,:SOSTAV_COUNT_'
      '110229368=  DO BEGIN'
      '110229369=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110229370='
      
        '110229371=      --==============================================' +
        '============='
      '110229372=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110229373=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110229374=        FROM LT_SKLAD_PRODUCT L'
      '110229375=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110229376=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110229377=       INTO :AMOUNT_CUR_;'
      '110229378='
      
        '110229379=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110229380=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110229381=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110229382=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051 +
        #1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068 +
        #1050#1054
      
        '110229383=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068 +
        ' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110229384=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110229385=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110229386=          SELECT SUM(AMOUNT)'
      '110229387=            FROM ZAKAZ_DETAILS T'
      '110229388=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110229389=             AND T.ZAKAZ = :ZAKAZ_'
      '110229390=            INTO :AMOUNT_OLD_;'
      '110229391=        ELSE'
      '110229392=          SELECT SUM(AMOUNT)'
      '110229393=            FROM SKLAD T'
      '110229394=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110229395=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110229396=            INTO :AMOUNT_OLD_;'
      '110229397=      END'
      '110229398='
      '110229399=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110229400=      SELECT SUM(AMOUNT)'
      '110229401=        FROM ZAKAZ_DETAILS_TMP T'
      '110229402=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110229403=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110229404='
      
        '110229405=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_, ' +
        '0) + :AMOUNT_;'
      '110229406=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '110229407='
      
        '110229408=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110229409='
      
        '110229410=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '110229411=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042 +
        #1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110229412=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) T' +
        'HEN BEGIN'
      '110229413=            PNT_ = '#39'01'#39';'
      
        '110229414=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FR' +
        'OM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      '110229415=                                         CURRENT_DATE,'
      '110229416=                                         :G_PRODUCT_,'
      
        '110229417=                                         ABS(AMOUNT_CU' +
        'R_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUN' +
        'T_,'
      
        '110229418=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086 +
        ' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110229419=                                         )'
      
        '110229420=                RETURNING_VALUES :SKLAD_, :COST_PRICE_' +
        '_, :ERR_CODE, :ERR_MSG;'
      '110229421=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110229422=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110229423=              EXIT;'
      '110229424=            END'
      '110229425=        END'
      
        '110229426=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_PR' +
        'ODUCT_ <> -2 AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '110229427=            SELECT NAME'
      '110229428=            FROM G_PRODUCT'
      '110229429=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110229430=            INTO :PRODUCT_NAME_;'
      '110229431='
      '110229432=            ERR_CODE = -20500;'
      
        '110229433=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110229434=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110229435=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110229436=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110229437=            EXIT;'
      '110229438=        END'
      '110229439=      END'
      '110229440=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110229441=      --==============================================' +
        '============='
      '110229442='
      
        '110229443=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110229444=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110229445='
      '110229446=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '110229447=        --    PRICE__ = SOSTAV_PRICE_;'
      '110229448=        --END ELSE BEGIN'
      '110229449=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110229450=              PRICE__ = COST_PRICE__;'
      '110229451='
      
        '110229452=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110229453=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110229454='
      '110229455='
      
        '110229456=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110229457=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110229458=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110229459=            END'
      '110229460='
      
        '110229461=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110229462=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110229463=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110229464=        --END'
      '110229465=      END'
      '110229466='
      
        '110229467=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '110229468=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041#1048 +
        #1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '110229469=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_CODE' +
        '_) = 0) THEN'
      '110229470=          SELECT ZD.zakaz_details'
      '110229471=            FROM zakaz_details_tmp ZD'
      '110229472=           WHERE ZD.G_PRODUCT = :g_product_'
      '110229473=             AND ZD.PRICE = :PRICE__'
      '110229474=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110229475=            INTO :ZAKAZ_DTLS_TMP_;'
      '110229476='
      '110229477='
      '110229478=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN BEGIN'
      '110229479=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110229480=           SET P.amount = P.amount + :amount_'
      
        '110229481=               ,P.summ = ROUND((P.price - P.discount_T' +
        'ENGE) * (P.amount + :AMOUNT_), 2)  -- '#1086#1082#1088#1091#1075#1083#1103#1102' '#1076#1086' 2 '#1079#1085#1072#1082#1086#1074', '#1095#1090#1086#1073 +
        #1099' '#1087#1086#1090#1086#1084' '#1085#1077' '#1073#1099#1083#1086' '#1087#1088#1086#1073#1083#1077#1084' '#1087#1088#1080' '#1087#1077#1088#1077#1076#1072#1095#1077' '#1074' '#1060#1056
      
        '110229482=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110229483=               ,P.NDS = :NDS_'
      '110229484=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110229485=               ,P.VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '110229486=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110229487=        ZAKAZ_DETAILS_ = :ZAKAZ_DTLS_TMP_;'
      '110229488='
      '110229489=      END ELSE BEGIN'
      
        '110229490=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN ' +
        'BEGIN'
      '110229491=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_;'
      '110229492=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '110229493=          END'
      '110229494='
      '110229495=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110229496=          ('
      '110229497=           ZAKAZ_DETAILS,'
      '110229498=           ZAKAZ,'
      '110229499=           G_PRODUCT,'
      '110229500=           AMOUNT,'
      '110229501=           PRICE,'
      '110229502=           SUMM,'
      '110229503=           DISCOUNT_PERC,'
      '110229504=           DISCOUNT_TENGE,'
      '110229505=           DISCOUNT_SUMM,'
      '110229506=           NDS,'
      '110229507=           NDS_SUMM,'
      '110229508=           COST_PRICE,'
      '110229509=           MARK_CODE,'
      '110229510=           ORIGINAL_KIT_ID,'
      '110229511=           ORIGINAL_KIT_PRICE,'
      '110229512=           VES_GRAMM_PRICE'
      '110229513=          ) VALUES ('
      '110229514=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110229515=           :ZAKAZ_,'
      '110229516=           :G_PRODUCT_,'
      '110229517=           :AMOUNT_,'
      '110229518=           :PRICE__,'
      '110229519=           :SUMM_,'
      '110229520=           :DISCOUNT_PERC_,'
      '110229521=           :DISCOUNT_TENGE_,'
      '110229522=           :DISCOUNT_SUMM_,'
      '110229523=           :NDS_,'
      '110229524=           :NDS_SUMM_,'
      '110229525=           :COST_PRICE__,'
      '110229526=           :MARK_CODE_,'
      '110229527=           :ORIGINAL_KIT_ID_,'
      '110229528=           :ORIGINAL_KIT_PRICE_,'
      '110229529=           :VES_GRAMM_PRICE_'
      '110229530=          )'
      '110229531=          RETURNING'
      '110229532=            ZAKAZ_DETAILS'
      '110229533=          INTO'
      '110229534=            :ZAKAZ_DETAILS_;'
      '110229535=      END'
      '110229536=  END'
      '110229537=end'
      '110229538=;'
      '110229539='
      '110229540=ALTER PROCEDURE P_REP_BILL('
      '110229541=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110229542=  SUMM_DANO_ NUMERIC(15,2),'
      '110229543=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110229544=  CURRENCY_ INTEGER,'
      '110229545=  MODE_ INTEGER,'
      '110229546=  PRINT_SLOGAN_ VARCHAR(80),'
      '110229547=  DECIMAL_ INTEGER,'
      '110229548=  BONUS_ NUMERIC(15,2),'
      '110229549=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS)'
      '110229550=RETURNS ('
      '110229551=  FIRM_NAME_ VARCHAR(600),'
      '110229552=  IDN_STR_ VARCHAR(30),'
      '110229553=  FIRM_IDN_ VARCHAR(50),'
      '110229554=  FIRM_ADDRESS_ VARCHAR(550),'
      '110229555=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110229556=  DATE_ VARCHAR(100),'
      '110229557=  PAYMENT_TYPE_ VARCHAR(100),'
      '110229558=  G_CLIENT_NAME_ VARCHAR(300),'
      '110229559=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110229560=  SUMM_VSEGO_ VARCHAR(50),'
      '110229561=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110229562=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110229563=  ROW_NUM INTEGER,'
      '110229564=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110229565=  NAME_ART VARCHAR(1000),'
      '110229566=  AMOUNT VARCHAR(50),'
      '110229567=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110229568=  PRICE VARCHAR(50),'
      '110229569=  PRICE_N VARCHAR(50),'
      '110229570=  SUMM VARCHAR(50),'
      '110229571=  SUMM_N VARCHAR(50),'
      '110229572=  SUMM_POLUCH_ VARCHAR(50),'
      '110229573=  SUMM_SDACH_ VARCHAR(50),'
      '110229574=  SUMM_STR_ VARCHAR(200),'
      '110229575=  SLOGAN_ VARCHAR(80),'
      '110229576=  SUMM_SKIDKA_ VARCHAR(50),'
      '110229577=  SUMM_SERVICE_ VARCHAR(50),'
      '110229578=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110229579=  BONUS_STR_ VARCHAR(100),'
      '110229580=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110229581=  ERR_CODE NUMERIC(15,2),'
      '110229582=  ERR_MSG VARCHAR(1024),'
      '110229583=  NAME_MARKER TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE)'
      '110229584=AS'
      '110229585=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '110229586=declare variable PROCNAME varchar(30) = '#39'P_REP_BILL'#39';'
      '110229587=declare variable PNT_ varchar(5);'
      '110229588=declare variable I integer = 1;'
      
        '110229589=declare variable G_FIRM_REKVIZIT_ type of column G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110229590=declare variable AMOUNT_NUM_ type of column ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110229591=declare variable AMOUNT_VSEGO_NUM_ type of column ZAKA' +
        'Z_DETAILS.AMOUNT;'
      
        '110229592=declare variable SUMM_NONCASH_ type of column ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110229593=declare variable SUMM_CASH_ type of column ZAKAZ.SUMM_' +
        'CASH;'
      
        '110229594=declare variable SERVICE_SUMM_ type of column ZAKAZ_DE' +
        'TAILS.SUMM;'
      '110229595=BEGIN'
      '110229596=  SLOGAN_ = PRINT_SLOGAN_;'
      '110229597=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '110229598=  IF (BONUS_ > 0) THEN BEGIN'
      
        '110229599=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_, 2) AS VARCHAR(100));'
      '110229600=  END'
      '110229601='
      '110229602=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '110229603=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_' +
        ';'
      '110229604=  END'
      '110229605='
      '110229606=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110229607=  SELECT z.ZAKAZ'
      '110229608=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '110229609=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')' +
        '||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '110229610=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '110229611=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COAL' +
        'ESCE(O.NM, '#39#39')'
      '110229612=         ,Z.summ_noncash'
      '110229613=         ,Z.summ_cash'
      '110229614=         ,Z.NOTE'
      
        '110229615=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '110229616=         G_CLIENT G,'
      '110229617=         G_PAYMENT_TYPE P'
      '110229618=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110229619=     AND Z.G_CLIENT = G.G_CLIENT'
      '110229620=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110229621=    INTO :NUM_'
      '110229622=        ,:PAYMENT_TYPE_'
      '110229623=        ,:DATE_'
      '110229624=        ,:G_CLIENT_NAME_'
      '110229625=        ,:G_OFFICIAL_FM_'
      '110229626=        ,:SUMM_NONCASH_'
      '110229627=        ,:SUMM_CASH_'
      '110229628=        ,:NOTE_'
      '110229629=        ;'
      '110229630='
      '110229631=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110229632=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110229633='
      '110229634=  SELECT R.G_FIRM_REKVIZIT,'
      '110229635=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110229636=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110229637=    FROM G_FIRM_REKVIZIT R'
      '110229638=   WHERE R.is_default = 1'
      '110229639=    INTO :G_FIRM_REKVIZIT_,'
      '110229640=         :FIRM_NAME_,'
      '110229641=         :FIRM_IDN_;'
      '110229642='
      '110229643=  SELECT ZD.SUMM'
      '110229644=    FROM ZAKAZ_DETAILS ZD'
      '110229645=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110229646=    AND ZD.G_PRODUCT = -2'
      '110229647=    INTO :SERVICE_SUMM_;'
      '110229648=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110229649='
      '110229650=  SELECT SUM(ZD.AMOUNT),'
      
        '110229651=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCH' +
        'AR(50)),'
      
        '110229652=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2' +
        ') AS VARCHAR(50)),'
      
        '110229653=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110229654=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '110229655=  FROM ZAKAZ_DETAILS ZD'
      '110229656=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110229657=    AND ZD.G_PRODUCT <> -2'
      '110229658=  INTO :AMOUNT_VSEGO_NUM_,'
      '110229659=       :SUMM_SKIDKA_,'
      '110229660=       :SUMM_VSEGO_,'
      '110229661=       :SUMM_VSEGO_N_,'
      '110229662=       :SUMM_SERVICE_;'
      '110229663='
      '110229664=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110229665=    FROM G_FIRM_ADDRESS R'
      '110229666=   WHERE R.IS_DEFAULT = 1'
      '110229667=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110229668=    INTO :FIRM_ADDRESS_;'
      '110229669='
      
        '110229670=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110229671=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110229672=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110229673=    IF (CURRENCY_ = 0) THEN'
      '110229674=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110229675=    ELSE'
      '110229676=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110229677=  END'
      '110229678='
      '110229679=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110229680='
      
        '110229681=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110229682=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110229683='
      '110229684=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110229685=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110229686=  INTO :SUMM_STR_;'
      '110229687='
      '110229688=  FOR'
      '110229689=    SELECT :I,'
      '110229690=           G.NAME,'
      
        '110229691=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.MA' +
        'RK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||Z' +
        'D.MARK_CODE END),'
      
        '110229692=           (CASE WHEN (G.ARTICUL is null) or (G.ARTICU' +
        'L = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '110229693=           ZD.AMOUNT,'
      '110229694=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '110229695=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) A' +
        'S VARCHAR(100))'
      '110229696=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110229697=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE' +
        ', 0) AS VARCHAR(100))'
      '110229698=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110229699=      FROM ZAKAZ Z,'
      '110229700=           ZAKAZ_DETAILS ZD,'
      '110229701=           G_PRODUCT G,'
      '110229702=           G_UNIT U'
      '110229703=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110229704=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110229705=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110229706=       AND G.G_UNIT = U.G_UNIT'
      '110229707=       AND G.G_PRODUCT <> -2'
      '110229708=     ORDER BY ZD.zakaz_details'
      '110229709=    INTO :ROW_NUM,'
      '110229710=        :NAME,'
      '110229711=        :NAME_MARKER,'
      '110229712=        :NAME_ART,'
      '110229713=        :AMOUNT_NUM_,'
      '110229714=        :PRICE,'
      '110229715=        :SUMM'
      '110229716=        ,:SHORT_NAME'
      '110229717=        ,:PRICE_N'
      '110229718=        ,:SUMM_N'
      '110229719='
      '110229720=  DO BEGIN'
      '110229721=    I = I + 1;'
      '110229722='
      
        '110229723=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110229724=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110229725=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110229726=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110229727=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110229728=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110229729=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110229730=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110229731=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110229732=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110229733=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110229734=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110229735=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110229736=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110229737=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110229738=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110229739=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110229740=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110229741=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110229742=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110229743=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110229744=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110229745=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);'
      '110229746='
      '110229747=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110229748=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110229749=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110229750=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110229751=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110229752=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110229753=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110229754=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110229755=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110229756=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110229757=    END ELSE BEGIN'
      '110229758=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110229759=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110229760=    END'
      '110229761='
      
        '110229762=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110229763=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110229764='
      
        '110229765=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110229766=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110229767='
      '110229768=    SUSPEND;'
      '110229769=  END'
      '110229770=WHEN ANY DO BEGIN'
      '110229771=    Err_code = -20500;'
      
        '110229772=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110229773=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110229774=  END'
      '110229775=end'
      '110229776=;'
      '110229777='
      '110229778=ALTER PROCEDURE P_REP_TOVAR_HISTORY('
      '110229779=  G_PRODUCT_ARR_ BLOB SUB_TYPE 1,'
      '110229780=  DATE_BEGIN_ DATE,'
      '110229781=  DATE_END_ DATE,'
      '110229782=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110229783=RETURNS ('
      '110229784=  ROW INTEGER,'
      '110229785=  DATE_ACT DATE,'
      '110229786=  OPER VARCHAR(500),'
      '110229787=  PRICE_PRIHOD NUMERIC(15,2),'
      '110229788=  AMOUNT_PRIHOD MY_NUMERIC_5,'
      '110229789=  SUMM_PRIHOD NUMERIC(15,2),'
      '110229790=  PRICE_UHOD NUMERIC(15,2),'
      '110229791=  AMOUNT_UHOD MY_NUMERIC_5,'
      '110229792=  SUMM_UHOD NUMERIC(15,2),'
      '110229793=  ERR_CODE INTEGER,'
      '110229794=  ERR_MSG VARCHAR(1024))'
      '110229795=AS'
      
        '110229796=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_H' +
        'ISTORY'#39';'
      '110229797=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110229798=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '110229799=DECLARE VARIABLE DATE_SORT DATE;'
      '110229800=BEGIN'
      '110229801='
      '110229802=  FOR SELECT F.G_PRODUCT'
      '110229803=        FROM G_PRODUCT F'
      
        '110229804=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39'~'#39'||F.G_PRODU' +
        'CT||'#39'~'#39
      '110229805=       AND EXISTS (SELECT 1'
      '110229806=                     FROM SKLAD SS'
      
        '110229807=                    WHERE SS.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      '110229808=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '110229809=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||SS.G_TOCHKA||'#39'-'#39
      '110229810=                   UNION ALL'
      '110229811=                   SELECT 1'
      '110229812=                     FROM SKLAD SS'
      
        '110229813=                    WHERE SS.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      '110229814=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '110229815=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||SS.G_CLIENT||'#39'-'#39
      '110229816=                   UNION ALL'
      '110229817=                   SELECT 1'
      '110229818=                     FROM ZAKAZ ZZ,'
      '110229819=                          ZAKAZ_DETAILS ZZD'
      '110229820=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '110229821=                      AND ZZ.IS_RESERVE = 0'
      
        '110229822=                      AND ZZ.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      '110229823=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      '110229824=                      AND ZZ.IS_SPISANIE <> 2'
      
        '110229825=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||ZZ.G_TOCHKA||'#39'-'#39
      '110229826=                   UNION ALL'
      '110229827=                   SELECT 1'
      '110229828=                     FROM ZAKAZ_REAL_PARENT Z,'
      '110229829=                          ZAKAZ_NA_REAL D'
      
        '110229830=                    WHERE Z.ZAKAZ_REAL_PARENT = D.ZAKA' +
        'Z_REAL_PARENT'
      
        '110229831=                      AND Z.ZAKAZ_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '110229832=                      AND D.G_PRODUCT = F.G_PRODUCT'
      
        '110229833=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||Z.G_TOCHKA||'#39'-'#39
      '110229834=                   UNION ALL'
      '110229835=                   SELECT 1'
      '110229836=                     FROM OTHER ZZ,'
      '110229837=                          OTHER_DETAILS ZZD'
      '110229838=                    WHERE ZZ.OTHER = ZZD.OTHER'
      
        '110229839=                      AND ZZ.OP_DATE BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '110229840=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      
        '110229841=                      AND :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||ZZ.G_TOCHKA||'#39'-'#39
      '110229842=                   )'
      '110229843=       ORDER BY F.NAME'
      '110229844=       INTO :G_PRODUCT_'
      '110229845=  DO BEGIN'
      '110229846=      FOR SELECT -2,'
      '110229847=                 CAST('#39'01.01.1985'#39' AS DATE) DATE_SORT,'
      '110229848=                 NULL,'
      '110229849=                 NAME,'
      '110229850=                 NULL,'
      '110229851=                 NULL,'
      '110229852=                 NULL,'
      '110229853=                 NULL,'
      '110229854=                 NULL,'
      '110229855=                 NULL'
      '110229856=            FROM G_PRODUCT G'
      '110229857=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110229858=          UNION ALL'
      '110229859=          SELECT -1,'
      '110229860=                 CAST('#39'01.01.1990'#39' AS DATE) DATE_SORT,'
      '110229861=                 NULL,'
      '110229862=                 '#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1085#1072#1095#1072#1083#1086#39','
      '110229863=                 NULL,'
      
        '110229864=                 (select (select COALESCE(sum(amount),' +
        ' 0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '110229865=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||g_tochka||'#39'-'#39')'
      '110229866=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '110229867=                       (select COALESCE(sum(zr.AMOUNT_' +
        'ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110229868=                        where zr.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '110229869=                        and zr.ZAKAZ_REAL_PARENT = zrp' +
        '.ZAKAZ_REAL_PARENT'
      
        '110229870=                        and zrp.ZAKAZ_DATE >= :DATE_BE' +
        'GIN_)'
      '110229871=                       +'
      
        '110229872=                       (select COALESCE(sum(zd.amount)' +
        ', 0) from zakaz_details zd, zakaz z'
      
        '110229873=                        where zd.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '110229874=                        and zd.zakaz = z.zakaz and z.z' +
        '_date >= :DATE_BEGIN_'
      '110229875=                        and z.IS_RESERVE = 0'
      
        '110229876=                        and z.IS_SPISANIE <> 2   -- '#1085#1077 +
        ' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073 +
        #1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110229877=                        and not (z.IS_SPISANIE = 0 and' +
        ' z.NOT_MINUS_OSTATOK = 1))'
      '110229878=                       +'
      
        '110229879=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110229880=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '110229881=                       +'
      
        '110229882=                       (select COALESCE(sum(od.amount)' +
        ', 0) from other_details od, other o'
      
        '110229883=                        where od.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '110229884=                        and od.other = o.other and o.o' +
        'p_date >= :DATE_BEGIN_)'
      '110229885=                       -'
      
        '110229886=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s, sklad_parent sp'
      
        '110229887=                        where s.SKLAD_PARENT = sp.SKLA' +
        'D and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-' +
        #39'||SP.G_TOCHKA||'#39'-'#39
      
        '110229888=                        and sp.is_vozvrat <> 3 and sp.' +
        'date_receipt >= :DATE_BEGIN_ and not (sp.IS_VOZVRAT = 0 and sp.I' +
        'S_EXPECTED = 1))'
      '110229889=                       -'
      
        '110229890=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s, sklad_parent sp'
      
        '110229891=                        where s.SKLAD_PARENT = sp.SKLA' +
        'D and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '110229892=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||Sp.g_tochka||'#39'-'#39' and sp.date_receipt >= :DATE_BEGIN_ and sp' +
        '.IS_EXPECTED = 0)'
      '110229893=                  from rdb$database) PRICE,'
      '110229894=                 NULL,'
      '110229895=                 NULL,'
      '110229896=                 NULL,'
      '110229897=                 NULL'
      '110229898=            FROM G_PRODUCT G'
      '110229899=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110229900=          UNION ALL'
      '110229901=          SELECT SP.IS_VOZVRAT,'
      '110229902=                 SP.DATE_RECEIPT DATE_SORT,'
      '110229903=                 SP.DATE_RECEIPT DATE_ACT,'
      '110229904=                 DECODE(SP.IS_VOZVRAT,'
      
        '110229905=                        0, '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072', '#1087#1086#1089#1090#1072#1074 +
        #1097#1080#1082' '#39'||SUBSTRING(COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39') FROM 1 FOR 300),'
      
        '110229906=                        1, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39'||' +
        'COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39'),'
      
        '110229907=                        2, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39'||' +
        'COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39'),'
      
        '110229908=                        5, '#39#1042#1099#1088#1072#1074#1085#1080#1074#1072#1085#1080#1077' '#1086#1089#1090#1072#1090#1082#1086#1074' ('#1088#1077#1074 +
        #1080#1079#1080#1103')'#39'),'
      '110229909=                 S.PRICE,'
      '110229910=                 S.AMOUNT,'
      '110229911=                 S.SUMM,'
      '110229912=                 NULL,'
      '110229913=                 NULL,'
      '110229914=                 NULL'
      
        '110229915=            FROM SKLAD_PARENT SP LEFT OUTER JOIN G_CLI' +
        'ENT C ON SP.G_CLIENT = C.G_CLIENT,'
      '110229916=                 SKLAD S,'
      '110229917=                 G_PRODUCT G'
      
        '110229918=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '110229919=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '110229920=             AND SP.SKLAD = S.SKLAD_PARENT'
      '110229921=             AND S.G_PRODUCT = G.G_PRODUCT'
      '110229922=             AND G.G_PRODUCT = :G_PRODUCT_'
      '110229923=             AND SP.IS_VOZVRAT NOT IN (2, 3, 4)'
      '110229924=             AND SP.IS_EXPECTED = 0'
      '110229925=          UNION ALL'
      '110229926=          SELECT SP.IS_VOZVRAT,'
