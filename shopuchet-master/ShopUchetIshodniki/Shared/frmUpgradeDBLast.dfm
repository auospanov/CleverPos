        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102503668='
      '1102503669=                PNT_ = '#39'05'#39';'
      
        '1102503670=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN BEGIN'
      
        '1102503671=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1102503672=                                                  1, ' +
