      '110682152='
      '110682153=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '110682154=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' ('#1088 +
        #1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080#1079#1072#1094#1080 +
        #1080'"'
      
        '110682155=  -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052#1059' '#1063#1058 +
        #1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048#1058#1040#1045#1058 +
        #1057#1071
      '110682156=  SELECT Z.SUMM'
      '110682157=    FROM ZAKAZ Z'
      '110682158=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110682159=    INTO :ZSUMM_;'
      '110682160='
      
        '110682161=  STOIM_TOVAROV_ = REPLACE(CAST(ROUND(ZSUMM_/(1 + :NDS' +
        '_VALUE_/100), 2) AS VARCHAR(10)), '#39'.'#39', '#39','#39');'
      '110682162=  IF (ZSUMM_ <> 0) then'
      
        '110682163=    SUMM_NDS_    = REPLACE(CAST(CAST(ROUND(ZSUMM_ * ND' +
        'S_VALUE_/(100 + NDS_VALUE_), 2) AS NUMERIC(15,2)) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39');'
      '110682164=  ELSE'
      '110682165=    SUMM_NDS_    = '#39#39';'
      
        '110682166=  SUMM_VSEGO_    = REPLACE(CAST(ZSUMM_ AS VARCHAR(10))' +
        ', '#39'.'#39', '#39','#39');'
      '110682167='
