        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1101321452=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1101321453=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1101321454=      RETURNING SKLAD'
      '1101321455=      INTO :SKLAD_;'
      '1101321456='
      '1101321457=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101321458=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101321459=          INTO :G_PRODUCT,'
      '1101321460=              :AMOUNT,'
      '1101321461=              :PRICE,'
      '1101321462=              :SUMM'
      '1101321463=      DO BEGIN'
      '1101321464=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101321465=        UPDATE LT_SKLAD_PRODUCT L'
      '1101321466=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101321467=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101321468=           AND L.G_TOCHKA = :G_TOCHKA_;'
