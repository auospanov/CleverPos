      '1102492587=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102492588=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102492589=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102492590=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '1102492591=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE)'
      '1102492592=AS'
      '1102492593=BEGIN'
