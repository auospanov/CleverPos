      '110168980='
      
        '110168981=/*****************************************************' +
        '*************************/'
      
        '110168982=/****                           Dropping indices      ' +
        '                     ****/'
      
        '110168983=/*****************************************************' +
        '*************************/'
      '110168984='
      '110168985=DROP INDEX LT_BARCODE_IDX1;'
      '110168986='
      '110168987='
      
        '110168988=/*****************************************************' +
        '*************************/'
      
        '110168989=/****                           Altering tables       ' +
        '                     ****/'
      
        '110168990=/*****************************************************' +
        '*************************/'
      '110168991=ALTER TABLE G_PRODUCT ALTER COLUMN BARCODE'
      '110168992=  TYPE VR_DOC_OSNOVANIE;'
      '110168993='
      '110168994=ALTER TABLE LT_BARCODE ALTER COLUMN BARCODE'
      '110168995=  TYPE VR_DOC_OSNOVANIE;'
      '110168996='
      '110168997=ALTER TABLE LT_BARCODE_TMP ALTER COLUMN BARCODE'
      '110168998=  TYPE VR_DOC_OSNOVANIE;'
      '110168999='
      '1101681000='
      
        '1101681001=/****************************************************' +
        '**************************/'
      
        '1101681002=/****                           Creating indices     ' +
        '                      ****/'
      
        '1101681003=/****************************************************' +
        '**************************/'
      '1101681004=CREATE INDEX LT_BARCODE_IDX1'
      '1101681005=  ON LT_BARCODE (BARCODE);'
      '1101681006='
      '1101681007='
      
        '1101681008=/****************************************************' +
        '**************************/'
      
        '1101681009=/****                      Altering stored procedures' +
        '                      ****/'
      
        '1101681010=/****************************************************' +
        '**************************/'
      '1101681011='
      '1101681012=ALTER PROCEDURE DO_PRODUCT('
      '1101681013=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101681014=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1101681015=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101681016=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101681017=  NOTE_ TYPE OF COLUMN OTHER.NOTE,'
      
        '1101681018=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101681019=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101681020=RETURNS ('
      '1101681021=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1101681022=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101681023=  ERR_CODE INTEGER,'
      '1101681024=  ERR_MSG VARCHAR(1024))'
      '1101681025=AS'
      '1101681026=/*'
      
        '1101681027='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1101681028='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1101681029=*/'
      
        '1101681030=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1101681031=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101681032=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1101681033=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1101681034=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1101681035=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1101681036=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1101681037=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101681038=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1101681039=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '1101681040=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101681041=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101681042=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1101681043=DECLARE VARIABLE POS_ INTEGER;'
      '1101681044=DECLARE VARIABLE STR_ VARCHAR(300);'
      '1101681045=BEGIN'
      '1101681046=  PNT_ = '#39'00'#39';'
      '1101681047=  COST_PRICE_ = 0;'
      '1101681048='
      '1101681049=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101681050=    SELECT ID'
      '1101681051=      FROM CUR_PARAMS'
      '1101681052=     WHERE CUR_PARAMS = 2'
      '1101681053=      INTO :G_TOCHKA_;'
      '1101681054='
      '1101681055=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1101681056=  SELECT P.S_VALUE'
      '1101681057=    FROM SYSTEM_SETUP P'
      '1101681058=   WHERE P.SYSTEM_SETUP = 2'
      '1101681059=    INTO :CAN_SELL_;'
      '1101681060='
      '1101681061=  IF (LOG_BODY_ IS NOT NULL) THEN'
      '1101681062=    LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM 3);'
      '1101681063='
      '1101681064=  FOR SELECT :G_PRODUCT_IN_,'
      '1101681065=             :AMOUNT_IN_'
      '1101681066=        FROM RDB$DATABASE'
      '1101681067=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '1101681068=      UNION ALL'
      '1101681069=      SELECT G_PRODUCT,'
      '1101681070=             AMOUNT'
      '1101681071=        FROM ZAKAZ_DETAILS_TMP'
      '1101681072=       WHERE :G_PRODUCT_IN_ IS NULL'
      '1101681073=        INTO :G_PRODUCT_,'
      '1101681074=             :AMOUNT_'
      '1101681075=  DO BEGIN'
      '1101681076=      SELECT MAX(G.NAME)'
      '1101681077=        FROM G_PRODUCT G,'
      '1101681078=             G_PRODUCT_KIT K'
      '1101681079=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1101681080=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1101681081=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_' +
        'PRODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TO' +
        'CHKA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1101681082=        INTO :NAME_;'
      '1101681083='
      
        '1101681084=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN B' +
        'EGIN'
      '1101681085=        ERR_CODE = -20500;'
      
        '1101681086=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087 +
        #1088#1086#1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101681087=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101681088=        EXIT;'
      '1101681089=      END'
      '1101681090='
      '1101681091=      PNT_ = '#39'01'#39';'
      
        '1101681092=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TIME, OP_' +
        'TYPE, ARRIVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '1101681093=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_,' +
        ' CURRENT_TIME, 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '1101681094=      RETURNING OTHER'
      '1101681095=      INTO :OTHER_;'
      '1101681096='
      '1101681097=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1101681098=      FOR SELECT K.G_PRODUCT_ITEM'
      '1101681099=                ,K.AMOUNT*:AMOUNT_'
      '1101681100=                ,K.amount'
      '1101681101=                ,G.G_PRODUCT'
      '1101681102=            FROM G_PRODUCT_KIT K'
      '1101681103=                ,G_PRODUCT G'
      '1101681104=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101681105=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1101681106=            INTO :ITEM_'
      '1101681107=                ,:AMOUNT_NEED_'
      '1101681108=                ,:AMOUNT_NEED_ONE_'
      '1101681109=                ,:G_PRODUCT_KIT_'
      '1101681110=      DO BEGIN'
      
        '1101681111=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_KIT_, NULL, 1)'
      '1101681112=          RETURNING_VALUES :SELF_PRICE_;'
      '1101681113='
      '1101681114=        UPDATE LT_SKLAD_PRODUCT L'
      '1101681115=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '1101681116=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1101681117=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101681118='
      '1101681119=        IF (ROW_COUNT = 0) THEN'
      
        '1101681120=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :' +
        'G_TOCHKA_);'
      '1101681121='
      
        '1101681122=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTH' +
        'ER, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1101681123=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_' +
        ', :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1101681124='
      
        '1101681125=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*' +
        'SELF_PRICE_;'
      '1101681126=      END'
      '1101681127='
      
        '1101681128=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1101681129=      PNT_ = '#39'02'#39';'
      
        '1101681130=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101681131=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1101681132='
      '1101681133=      SUMM_ = AMOUNT_*COST_PRICE_;'
      '1101681134='
      '1101681135=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101681136=                              :DATE_,'
      '1101681137=                              CURRENT_TIME,'
      '1101681138=                              NULL, --:G_CLIENT__,'
      
        '1101681139=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1101681140=                              NULL, --:OSNOVANIE__,'
      '1101681141=                              :NOTE_,'
      '1101681142=                              4, --:IS_VOZVRAT_,'
      '1101681143=                              :SUMM_,'
      '1101681144=                              :SUMM_,'
      '1101681145=                              0, --:G_PRIHOD_,'
      '1101681146=                              0 --:SUMM_PRIHOD_)'
      '1101681147=                              ,NULL     --PAYMENTS_'
      
        '1101681148=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101681149=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101681150=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101681151=          EXIT;'
      '1101681152=      END'
      '1101681153='
      '1101681154=      UPDATE OTHER O'
      '1101681155=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1101681156=      WHERE O.OTHER = :OTHER_;'
      '1101681157='
      '1101681158=      -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101681159=      -- '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1042' '#1058#1040#1050#1054#1052' '#1042#1048#1044#1045' "~*'#1041#1051#1040'-'#1041#1051 +
        #1040' '#1058#1040#1050#1054#1049'-'#1058#1054' '#1058#1054#1042#1040#1056'~*'#1041#1051#1040'-'#1041#1051#1040' '#1042#1058#1054#1056#1054#1049' '#1058#1054#1042#1040#1056'~*"'
      
        '1101681160=      -- '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1042#1067#1056#1045#1047#1040#1058#1068'. '#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1058#1040#1050' '#1044#1045#1051#1040#1058#1068 +
        ' '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1040' '#1058#1059#1058' '#1057#1054#1047#1044#1040#1045#1058#1057#1071
      '1101681161=      -- '#1056#1040#1047#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048'-'#1047#1040#1055#1048#1057#1071#1052#1048
      '1101681162=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1101681163=        POS_ = POSITION('#39'~*'#39' IN LOG_BODY_);'
      
        '1101681164=        IF (CHAR_LENGTH(LOG_BODY_) <> (POS_ + 1)) THE' +
        'N'
      
        '1101681165=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR POS_ ' +
        '- 1);'
      '1101681166=        ELSE'
      
        '1101681167=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR CHAR_' +
        'LENGTH(LOG_BODY_) - 3);'
      '1101681168='
      '1101681169=        --ERR_CODE = -20500;'
      '1101681170=        --ERR_MSG = STR_; EXIT;'
      '1101681171='
      
        '1101681172=        EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, ' +
        ':OTHER_, :DATE_, 1, :SUMM_, :STR_, 1);'
      '1101681173='
      
        '1101681174=        LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM (POSIT' +
        'ION('#39'~*'#39' IN LOG_BODY_)) + 2);'
      '1101681175=      END'
      '1101681176=  END'
      '1101681177=END'
      '1101681178=;'
      '1101681179='
      '1101681180='
      
        '1101681181=/****************************************************' +
        '**************************/'
      
        '1101681182=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101681183=/****************************************************' +
        '**************************/'
      '1101681184=ALTER PROCEDURE FILL_FIRST_DATA('
      '1101681185=  PRODUCTY_ INTEGER = 0,'
      '1101681186=  HIM_ INTEGER = 0,'
      '1101681187=  APTEKA_ INTEGER = 0)'
      '1101681188=AS'
      '1101681189=BEGIN'
      '1101681190=  IF (PRODUCTY_ = 1 OR HIM_ = 1) THEN BEGIN'
      '1101681191=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681192=      VALUES (2, '#39#1073#1091#1090'.'#39', '#39#1073#1091#1090'.'#39');'
      '1101681193=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681194=      VALUES (3, '#39#1082#1075#39', '#39#1082#1075#39');'
      '1101681195=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681196=      VALUES (4, '#39#1096#1080#39', '#39#1096#1080#39');'
      '1101681197=  END'
      '1101681198='
      '1101681199=  IF (APTEKA_ = 1) THEN BEGIN'
      '1101681200=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681201=      VALUES (18, '#39#1091#1087#1072#1082#39', '#39#1091#1087#1072#1082#39');'
      '1101681202=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681203=      VALUES (19, '#39#1092#1083#1072#1082#39', '#39#1092#1083#1072#1082#39');'
      '1101681204=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681205=      VALUES (20, '#39#1087#1086#1076#1075#1091#1079'..'#39', '#39#1087#1086#1076#1075#1091#1079'..'#39');'
      '1101681206=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681207=      VALUES (21, '#39#1064#1058#39', '#39#1064#1058#39');'
      '1101681208=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681209=      VALUES (22, '#39#1055#1051#1040#1057#1058'.'#39', '#39#1055#1051#1040#1057#1058'.'#39');'
      '1101681210=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681211=      VALUES (23, '#39#1087#1072#1082'.'#39', '#39#1087#1072#1082'.'#39');'
      '1101681212=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681213=      VALUES (24, '#39#1090#1072#1073'.'#39', '#39#1090#1072#1073'.'#39');'
      '1101681214=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681215=      VALUES (25, '#39#1072#1084#1087'.'#39', '#39#1072#1084#1087'.'#39');'
      '1101681216=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681217=      VALUES (26, '#39#1087#1083#1072#1089#1090'.'#39', '#39#1087#1083#1072#1089#1090'.'#39');'
      '1101681218=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681219=      VALUES (27, '#39#1082#1086#1088'.'#39', '#39#1082#1086#1088'.'#39');'
      '1101681220=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681221=      VALUES (28, '#39#1087#1072#1082#39', '#39#1087#1072#1082#39');'
      '1101681222=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681223=      VALUES (29, '#39#1090#1091#1073#1072#39', '#39#1090#1091#1073#1072#39');'
      '1101681224=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681225=      VALUES (30, '#39#1087#1072#1088#39', '#39#1087#1072#1088#39');'
      '1101681226=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681227=      VALUES (31, '#39#1090#1085#1075#39', '#39#1090#1085#1075#39');'
      '1101681228=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1101681229=      VALUES (32, '#39#1089#1072#1083#1092#1077#1090'.'#39', '#39#1089#1072#1083#1092#1077#1090'.'#39');'
      '1101681230=  END'
      '1101681231='
      '1101681232=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_UNIT TO 35'#39';'
      '1101681233='
      '1101681234=  IF (PRODUCTY_ = 1) THEN'
      
        '1101681235=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRIC' +
        'E,'
      
        '1101681236=                           VOLUME_PRICE, PACK_AMOUNT,' +
        ' MF_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, P' +
        'LACE,'
      '1101681237=                           SALES_COMM)'
      
        '1101681238=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCL' +
        'ATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '1101681239=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, ' +
        'IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM'
      '1101681240=      FROM G_PRODUCT_FILL T'
      '1101681241=     WHERE T.G_PRODUCT BETWEEN 22080 AND 36644'
      '1101681242=    ORDER BY 1;'
      '1101681243='
      '1101681244=  IF (HIM_ = 1) THEN'
      
        '1101681245=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRIC' +
        'E,'
      
        '1101681246=                           VOLUME_PRICE, PACK_AMOUNT,' +
        ' MF_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, P' +
        'LACE,'
      '1101681247=                           SALES_COMM)'
      
        '1101681248=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCL' +
        'ATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '1101681249=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, ' +
        'IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM'
      '1101681250=      FROM G_PRODUCT_FILL T'
      '1101681251=     WHERE T.G_PRODUCT BETWEEN 36645 AND 39663'
      '1101681252=    ORDER BY 1;'
      '1101681253='
      '1101681254=  IF (APTEKA_ = 1) THEN'
      
        '1101681255=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRIC' +
        'E,'
      
        '1101681256=                           VOLUME_PRICE, PACK_AMOUNT,' +
        ' MF_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, P' +
        'LACE,'
      '1101681257=                           SALES_COMM)'
      
        '1101681258=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCL' +
        'ATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '1101681259=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, ' +
        'IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM'
      '1101681260=      FROM G_PRODUCT_FILL T'
      '1101681261=     WHERE T.G_PRODUCT BETWEEN 53051 AND 64823'
      '1101681262=    ORDER BY 1;'
      '1101681263='
      
        '1101681264=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_PRODUCT TO 6' +
        '4900'#39';'
      
        '1101681265=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_ARTICUL TO 290' +
        '45'#39';'
      '1101681266=END'
      '1101681267=;'
      '1101681268='
      '1101681269=ALTER PROCEDURE G_GET_G_PRODUCT('
      '1101681270=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101681271=  MODE_ INTEGER = 0)'
      '1101681272=RETURNS ('
      
        '1101681273=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101681274=  ARTICUL_ VARCHAR(30),'
      '1101681275=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101681276=  BARCODE_ VARCHAR(30),'
      '1101681277=  NAME_ VARCHAR(500),'
      '1101681278=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101681279=  PRICE_ NUMERIC(15,2),'
      '1101681280=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101681281=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101681282=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101681283=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101681284=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101681285=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101681286=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101681287=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101681288=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101681289=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101681290=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101681291=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SH' +
        'OW_RMK,'
      
        '1101681292=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101681293=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101681294=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '1101681295=  ERR_CODE INTEGER,'
      '1101681296=  ERR_MSG VARCHAR(1024))'
      '1101681297=AS'
      '1101681298=begin'
      '1101681299=    SELECT'
      '1101681300=        G_PRODUCT_PAR,'
      '1101681301=        ARTICUL,'
      '1101681302=        NOMENCLATUR_NUM,'
      '1101681303=        BARCODE,'
      '1101681304=        NAME,'
      '1101681305=        G_UNIT,'
      '1101681306=        PRICE,'
      '1101681307=        VOLUME_PRICE,'
      '1101681308=        PACK_AMOUNT,'
      '1101681309=        MF_COUNTRY,'
      '1101681310=        NOTE,'
      '1101681311=        CROSSCODE,'
      '1101681312=        IS_KIT,'
      '1101681313=        MIN_AMOUNT,'
      '1101681314=        PLACE,'
      '1101681315=        SALES_COMM,'
      '1101681316=        KOD_TNVD,'
      '1101681317=        FAST_TOVAR,'
      '1101681318=        DO_NOT_SHOW_RMK,'
      '1101681319=        DO_NOT_CHARGE_BONUS,'
      '1101681320=        IS_MARKED,'
      
        '1101681321=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1))'
      '1101681322=    FROM G_PRODUCT T'
      '1101681323=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101681324=    INTO'
      '1101681325=        :G_PRODUCT_PAR_,'
      '1101681326=        :ARTICUL_,'
      '1101681327=        :NOMENCLATUR_NUM_,'
      '1101681328=        :BARCODE_,'
      '1101681329=        :NAME_,'
      '1101681330=        :G_UNIT_,'
      '1101681331=        :PRICE_,'
      '1101681332=        :VOLUME_PRICE_,'
      '1101681333=        :PACK_AMOUNT_,'
      '1101681334=        :MF_COUNTRY_,'
      '1101681335=        :NOTE_,'
      '1101681336=        :CROSSCODE_,'
      '1101681337=        :IS_KIT_,'
      '1101681338=        :MIN_AMOUNT_,'
      '1101681339=        :PLACE_,'
      '1101681340=        :SALES_COMM_,'
      '1101681341=        :KOD_TNVD_,'
      '1101681342=        :FAST_TOVAR_,'
      '1101681343=        :DO_NOT_SHOW_RMK_,'
      '1101681344=        :DO_NOT_CHARGE_BONUS_,'
      '1101681345=        :IS_MARKED_,'
      '1101681346=        :LAST_PRICE_;'
      '1101681347='
      '1101681348=    INSERT INTO LT_BARCODE_TMP'
      
        '1101681349=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BAR' +
        'CODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '1101681350='
      '1101681351=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '1101681352=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :' +
        'G_PRODUCT_;'
      '1101681353='
      
        '1101681354=    INSERT INTO G_PRODUCT_KIT_TMP (G_PRODUCT_KIT, G_P' +
        'RODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3)'
      
        '1101681355=    SELECT DECODE(:MODE_, 0, G_PRODUCT_KIT, GEN_ID(GE' +
        'N_G_PRODUCT_KIT, 1)), G_PRODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, ' +
        'PRICE1, PRICE2, PRICE3'
      '1101681356=    FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRODUCT_;'
      '1101681357=end'
      '1101681358=;'
      '1101681359='
      '1101681360=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '1101681361=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101681362=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101681363=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '1101681364=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101681365=  PREFIX_ VARCHAR(2))'
      '1101681366=RETURNS ('
      '1101681367=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101681368=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT_PAR,'
      '1101681369=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101681370=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101681371=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101681372=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101681373=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '1101681374=  ERR_CODE INTEGER,'
      '1101681375=  ERR_MSG VARCHAR(1024))'
      '1101681376=AS'
      '1101681377=/*'
      '1101681378='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '1101681379=*/'
      
        '1101681380=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PROD' +
        'UCT_BY_BARCODE'#39';'
      '1101681381=BEGIN'
      '1101681382='
      '1101681383=    IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '1101681384=        ERR_CODE = -20500;'
      
        '1101681385=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080 +
        #1093#1082#1086#1076' '#1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101681386=        ERR_MSG = PROCNAME||ERR_MSG;'
      '1101681387=        EXIT;'
      '1101681388=    END'
      '1101681389='
      
        '1101681390=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) T' +
        'HEN BEGIN'
      '1101681391=        SELECT T.G_PRODUCT_PAR,'
      '1101681392=               T.G_PRODUCT,'
      '1101681393=               T.PRICE,'
      '1101681394=               T.VOLUME_PRICE,'
      '1101681395=               T.IS_KIT,'
      '1101681396=               T.IS_MARKED'
      '1101681397=          FROM G_PRODUCT T'
      
        '1101681398=          WHERE SUBSTRING(T.BARCODE FROM 1 FOR 7) = S' +
        'UBSTRING(:BARCODE_ FROM 1 FOR 7)'
      '1101681399=            AND T.IS_ACTIVE = 1'
      '1101681400=          INTO :G_PRODUCT_CATEGORY_,'
      '1101681401=               :G_PRODUCT_,'
      '1101681402=               :PRICE_,'
      '1101681403=               :VOLUME_PRICE_,'
      '1101681404=               :IS_KIT_,'
      '1101681405=               :IS_MARKED_;'
      '1101681406='
      
        '1101681407=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM ' +
        '8 FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '1101681408=    END ELSE'
      '1101681409=        SELECT T.G_PRODUCT_PAR,'
      '1101681410=               T.G_PRODUCT,'
      '1101681411=               T.PRICE,'
      '1101681412=               T.VOLUME_PRICE,'
      '1101681413=               T.IS_KIT,'
      '1101681414=               T.IS_MARKED'
      '1101681415=          FROM G_PRODUCT T'
      '1101681416=          WHERE T.BARCODE = :BARCODE_'
      '1101681417=            AND T.IS_ACTIVE = 1'
      '1101681418=          INTO :G_PRODUCT_CATEGORY_,'
      '1101681419=               :G_PRODUCT_,'
      '1101681420=               :PRICE_,'
      '1101681421=               :VOLUME_PRICE_,'
      '1101681422=               :IS_KIT_,'
      '1101681423=               :IS_MARKED_;'
      '1101681424='
      '1101681425=    IF (ROW_COUNT = 0) THEN BEGIN'
      
        '1101681426=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' ' +
        #1044#1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '1101681427=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_)' +
        ' THEN'
      '1101681428=          SELECT T.G_PRODUCT_PAR,'
      '1101681429=                 T.G_PRODUCT,'
      '1101681430=                 T.PRICE,'
      '1101681431=                 T.VOLUME_PRICE,'
      '1101681432=                 T.IS_KIT,'
      '1101681433=                 T.IS_MARKED'
      '1101681434=            FROM G_PRODUCT T, LT_BARCODE D'
      '1101681435=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1101681436=              AND T.IS_ACTIVE = 1'
      
        '1101681437=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) =' +
        ' SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '1101681438=            INTO'
      '1101681439=                :G_PRODUCT_CATEGORY_,'
      '1101681440=                :G_PRODUCT_,'
      '1101681441=                :PRICE_,'
      '1101681442=                :VOLUME_PRICE_,'
      '1101681443=                :IS_KIT_,'
      '1101681444=                :IS_MARKED_;'
      '1101681445=      ELSE'
      '1101681446=          SELECT T.G_PRODUCT_PAR,'
      '1101681447=                 T.G_PRODUCT,'
      '1101681448=                 T.PRICE,'
      '1101681449=                 T.VOLUME_PRICE,'
      '1101681450=                 T.IS_KIT,'
      '1101681451=                 T.IS_MARKED'
      '1101681452=            FROM G_PRODUCT T, LT_BARCODE D'
      '1101681453=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1101681454=              AND T.IS_ACTIVE = 1'
      '1101681455=              AND D.BARCODE = :BARCODE_'
      '1101681456=            INTO'
      '1101681457=                :G_PRODUCT_CATEGORY_,'
      '1101681458=                :G_PRODUCT_,'
      '1101681459=                :PRICE_,'
      '1101681460=                :VOLUME_PRICE_,'
      '1101681461=                :IS_KIT_,'
      '1101681462=                :IS_MARKED_;'
      '1101681463='
      '1101681464=      IF (ROW_COUNT = 0) THEN BEGIN'
      '1101681465=          ERR_CODE = -20500;'
      
        '1101681466=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1101681467=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101681468=          EXIT;'
      '1101681469=      END'
      '1101681470=    END'
      '1101681471='
      
        '1101681472=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) <> PREFIX_) ' +
        'THEN'
      
        '1101681473=        SELECT CASE WHEN LT.AMOUNT < 1 AND LT.AMOUNT ' +
        '> 0 AND ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = ' +
        '2) = 0) THEN LT.AMOUNT ELSE 1 END'
      '1101681474=          FROM LT_SKLAD_PRODUCT LT'
      '1101681475=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      
        '1101681476=           AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '1101681477=          INTO :AMOUNT_;'
      '1101681478=END'
      '1101681479=;'
      '1101681480='
      '1101681481=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101681482=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101681483=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM,'
      '1101681484=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101681485=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101681486=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101681487=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101681488=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101681489=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101681490=  SELF_PRICE_ NUMERIC(15,2),'
      '1101681491=  AMOUNT_ MY_NUMERIC_5,'
      '1101681492=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101681493=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101681494=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101681495=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101681496=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1101681497=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101681498=  CATEGORY_NAME_ VARCHAR(1000),'
      '1101681499=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101681500=  IS_THIS_LAST_ INTEGER,'
      '1101681501=  UPDATE_IF_EXIST_ INTEGER)'
      '1101681502=RETURNS ('
      '1101681503=  ERR_CODE INTEGER,'
      '1101681504=  ERR_MSG VARCHAR(1024))'
      '1101681505=AS'
      
        '1101681506=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_P' +
        'RODUCT'#39';'
      '1101681507=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101681508=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101681509=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT_PAR;'
      
        '1101681510=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1101681511=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT' +
        ';'
      
        '1101681512=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT = 0;'
      
        '1101681513=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1101681514=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD;'
      
        '1101681515=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1101681516=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM_CURRENCY;'
      '1101681517=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1101681518=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101681519=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      
        '1101681520=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1101681521=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1101681522=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1101681523=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1101681524=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1101681525=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1101681526=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1101681527=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101681528=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1101681529=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1101681530=BEGIN'
      '1101681531=    ERR_MSG = '#39#39';'
      '1101681532=    PNT_ = '#39'00'#39';'
      '1101681533='
      
        '1101681534=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044 +
        #1045#1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '1101681535=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS889' +
        '88~98888~"'
      
        '1101681536=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' ' +
        #1053#1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '1101681537=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '1101681538=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39 +
        '~'#39');'
      '1101681539=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '1101681540=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '1101681541=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '1101681542=    END ELSE'
      '1101681543=        CROSSCODE_ = NULL;'
      '1101681544='
      '1101681545=    PNT_ = '#39'01'#39';'
      '1101681546=    SELECT ID'
      '1101681547=      FROM CUR_PARAMS'
      '1101681548=    WHERE CUR_PARAMS = 2'
      '1101681549=      INTO :G_TOCHKA_;'
      '1101681550='
      '1101681551=    SELECT G.G_UNIT'
      '1101681552=      FROM G_UNIT G'
      
        '1101681553=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAM' +
        'E_G_UNIT_))'
      '1101681554=      INTO :G_UNIT_;'
      '1101681555=    if (ROW_COUNT = 0) then'
      '1101681556=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1101681557='
      '1101681558=    PNT_ = '#39'02'#39';'
      
        '1101681559=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101681560=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1101681561=        SELECT G.G_PRODUCT,'
      '1101681562=               G.NAME'
      '1101681563=          FROM G_PRODUCT G'
      
        '1101681564=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1101681565=           AND TRIM(G.ARTICUL) <> '#39#39
      '1101681566=           AND G.IS_ACTIVE = 1'
      '1101681567=          INTO :G_PRODUCT_,'
      '1101681568=               :G_PRODUCT_NAME_;'
      '1101681569='
      
        '1101681570=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101681571=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101681572=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101681573=              UPDATE G_PRODUCT G'
      '1101681574=                 SET G.NAME = :NAME_,'
      '1101681575=                     G.G_UNIT = :G_UNIT_,'
      '1101681576=                     G.PRICE  = :PRICE_,'
      '1101681577=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101681578=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101681579=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101681580=                     G.PLACE = :PLACE_,'
      
        '1101681581=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101681582=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101681583=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101681584=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101681585=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101681586=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101681587='
      
        '1101681588=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101681589=            END ELSE'
      
        '1101681590=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101681591=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAM' +
        'E_||'#39'.'#39';'
      '1101681592=        END'
      '1101681593=    END ELSE'
      
        '1101681594=      EXECUTE PROCEDURE get_free_articul RETURNING_VA' +
        'LUES (:ARTICUL_);'
      '1101681595='
      
        '1101681596=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '1101681597=    PNT_ = '#39'02a'#39';'
      
        '1101681598=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '1101681599=        SELECT G.G_PRODUCT,'
