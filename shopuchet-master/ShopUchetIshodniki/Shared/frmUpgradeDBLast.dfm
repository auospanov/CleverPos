      '110192439=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110192440='
      '110192441=          DELETE FROM G_PRODUCT C'
      '110192442=           WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110192443='
      
        '110192444=          -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071 +
        #1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110192445=          IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110192446=            UPDATE SYNC_EXT_APP AP'
      '110192447=               SET AP.OPER = 3'
      '110192448=             WHERE AP.OBJECT_TYPE = 4'
      '110192449=               AND AP.ID = :G_PRODUCT_LOC_'
      '110192450=               AND AP.IS_LOADING = 0;'
      '110192451='
      '110192452=            IF (ROW_COUNT = 0) THEN'
      
        '110192453=                INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP' +
        ', OBJECT_TYPE, ID, OPER)'
      
        '110192454=                VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4' +
        ', :G_PRODUCT_LOC_, 3);'
