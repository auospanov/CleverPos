      '110237310=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110237311=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
