      '110240679=      ----------------------------------------'
      
        '110240680=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063 +
        #1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110240681=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '110240682=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110240683='
      
        '110240684=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048',' +
        ' '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044 +
        #1048#1053' '#1055#1051#1040#1058#1045#1046
      '110240685=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110240686=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110240687=                PNT_ = '#39'05'#39';'
      
        '110240688=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110240689=                                              1,     -' +
        '- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110240690=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110240691=                                              :Z_DATE_' +
        ','
      
        '110240692=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110240693=                                              ZAKAZ_, ' +
        '  --ZAKAZ_'
      '110240694=                                              NULL,'
      
        '110240695=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110240696=                                              :G_TOCHK' +
        'A_,'
      
        '110240697=                                              :UPLOAD_' +
        'TO_EXT_APP_'
      
        '110240698=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110240699=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110240700=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110240701=                  EXIT;'
      '110240702=                END'
      '110240703=            END'
      '110240704='
      '110240705=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110240706=        END ELSE BEGIN'
      '110240707=            PNT_ = '#39'06'#39';'
      
        '110240708=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110240709=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110240710=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110240711=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110240712=                ELSE'
      
        '110240713=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110240714='
      
        '110240715=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110240716=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110240717='
      
        '110240718=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110240719='
      '110240720=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110240721=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110240722=                                                  1,  ' +
        '   --:G_PRIHOD_RASHOD_,'
      
        '110240723=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110240724=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110240725=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110240726=                                                  :ZAK' +
        'AZ_,'
      
        '110240727=                                                  NULL' +
        ',     --:SKLAD_,'
      
        '110240728=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110240729=                                                  :G_T' +
        'OCHKA_,'
      
        '110240730=                                                  :UPL' +
        'OAD_TO_EXT_APP_'
      
        '110240731=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110240732=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110240733=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110240734=                      EXIT;'
      '110240735=                    END'
      '110240736=                END'
      '110240737=            END'
      '110240738=        END'
      '110240739=      END'
      '110240740='
      
        '110240741=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '110240742=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041 +
        #1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '110240743=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052 +
        ' '#1057#1051#1059#1063#1040#1045
      
        '110240744=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054' ' +
        #1051#1048#1062#1040'"'
      '110240745=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '110240746=          UPDATE G_DISCONT_CARD D'
      
        '110240747=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_,' +
        ' 0) + :SUMM_BONUS_GOT_,'
      '110240748=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110240749=          WHERE D.G_CLIENT = :G_CLIENT_'
      '110240750=          RETURNING'
      '110240751=            D.SUMM_ALL'
      '110240752=          INTO'
      '110240753=            :CLIENT_SUMM_ALL_;'
      '110240754='
      '110240755=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '110240756=            FROM G_CLIENT_DISC_VAL_GRID G'
      '110240757=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '110240758=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '110240759=          ORDER BY G.SUMM_FROM'
      '110240760=          ROWS 1 TO 1'
      '110240761=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '110240762='
      '110240763=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '110240764=            UPDATE G_CLIENT G'
      '110240765=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '110240766=             WHERE G.G_CLIENT = :G_CLIENT_'
      '110240767=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '110240768='
      '110240769=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '110240770=            UPDATE G_DISCONT_CARD D'
      '110240771=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '110240772=             WHERE D.G_CLIENT = :G_CLIENT_'
      '110240773=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '110240774=      END'
      '110240775='
      
        '110240776=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' '#1057 +
        ' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', '#1050 +
