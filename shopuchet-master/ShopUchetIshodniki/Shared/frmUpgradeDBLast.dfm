      '1102371654=;'
      '1102371655='
      '1102371656=ALTER PROCEDURE INS_SKLAD_TMP('
      '1102371657=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1102371658=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1102371659=  PRICE_ NUMERIC(15,2),'
      '1102371660=  SUMM_ NUMERIC(15,2),'
      '1102371661=  NDS_ NUMERIC(15,2) = 0,'
      '1102371662=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM = 0,'
      
        '1102371663=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1102371664=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0,'
      
        '1102371665=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC = 0,'
      
        '1102371666=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0' +
        ','
      
        '1102371667=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OP' +
        'T_PROC = 0,'
      '1102371668=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0,'
      
        '1102371669=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0,'
      '1102371670=  MARK_CODE_ TYPE OF COLUMN SKLAD_TMP.MARK_CODE = '#39#39','
      
        '1102371671=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT ' +
        '= 0)'
      '1102371672=RETURNS ('
      '1102371673=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1102371674=  ERR_CODE INTEGER,'
      '1102371675=  ERR_MSG VARCHAR(1024))'
      '1102371676=AS'
      
        '1102371677=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_T' +
        'MP'#39';'
      
        '1102371678=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M = 0;'
      '1102371679=BEGIN'
      '1102371680='
      '1102371681=  IF (CHAR_LENGTH(MARK_CODE_) = 0) THEN'
      '1102371682=      SELECT T.SKLAD'
      '1102371683=        FROM SKLAD_TMP T'
      '1102371684=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102371685=         AND T.PRICE = :PRICE_'
      '1102371686=        INTO :SKLAD_;'
      '1102371687='
      '1102371688=  IF (SKLAD_ IS NOT NULL) THEN'
      '1102371689=    UPDATE SKLAD_TMP T'
      '1102371690=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1102371691=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1102371692=     WHERE T.SKLAD = :SKLAD_;'
      '1102371693='
      '1102371694=  ELSE BEGIN'
      '1102371695=      IF (PRICE_ = 0) THEN BEGIN'
      '1102371696=        CHARGE_ROZN_PROC_ = 0;'
      '1102371697=        CHARGE_OPT_PROC_ = 0;'
      '1102371698=      END ELSE BEGIN'
      
        '1102371699=        CHARGE_ROZN_PROC_ = ROUND((:PRICE_ROZN_ - :PR' +
        'ICE_) * 100 / :PRICE_, 2);'
      
        '1102371700=        CHARGE_OPT_PROC_ = ROUND((:PRICE_OPT_ - :PRIC' +
        'E_) * 100 / :PRICE_, 2);'
      '1102371701=      END'
      '1102371702='
      '1102371703=      IF (IS_VOZVRAT_ = 1) THEN BEGIN'
      
        '1102371704=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_, NULL, 1)'
      '1102371705=          RETURNING_VALUES :SELF_PRICE_;'
      '1102371706=      END'
      '1102371707='
      
        '1102371708=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '1102371709=                            CHARGE_ROZN_PROC,'
      '1102371710=                            PRICE_ROZN,'
      '1102371711=                            CHARGE_OPT_PROC,'
      
        '1102371712=                            PRICE_OPT, CHANGE_SALE_PR' +
        'ICE, MARK_CODE, COST_PRICE)'
      
        '1102371713=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '1102371714=        ,:PRICE_CURRENCY_'
      '1102371715=        ,:SUMM_CURRENCY_'
      '1102371716=        ,:CHARGE_ROZN_PROC_'
      '1102371717=        ,:PRICE_ROZN_'
      '1102371718=        ,:CHARGE_OPT_PROC_'
      '1102371719=        ,:PRICE_OPT_'
      
        '1102371720=        ,0        -- :CHANGE_SALE_PRICE_ '#1055#1054' '#1048#1044#1045#1045' '#1059#1046#1045' ' +
        #1053#1045' '#1053#1059#1046#1053#1054', '#1062#1045#1053#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1048' '#1058#1040#1050', '#1058#1045#1055#1045#1056#1068' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1042#1054#1054#1041#1065#1045' '#1053#1048#1063#1045#1043#1054' ' +
        #1053#1045' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071', '#1055#1054#1047#1046#1045' '#1053#1040#1044#1054' '#1059#1041#1056#1040#1058#1068' 15.10.2021'
      '1102371721=        ,:MARK_CODE_'
      '1102371722=        ,:SELF_PRICE_)'
      '1102371723=      RETURNING SKLAD'
      '1102371724=      INTO :SKLAD_;'
      '1102371725=  END'
      '1102371726=end'
      '1102371727=;'
      '1102371728='
      '1102371729=ALTER PROCEDURE INS_ZAKAZ('
      '1102371730=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102371731=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102371732=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102371733=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102371734=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102371735=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102371736=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102371737=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102371738=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102371739=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102371740=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102371741=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102371742=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102371743=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102371744=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102371745=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102371746=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102371747=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102371748=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102371749=  IS_MEBEL_ INTEGER = 0,'
      
        '1102371750=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = nu' +
        'll,'
      
        '1102371751=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = null,'
      
        '1102371752=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = nu' +
        'll,'
      '1102371753=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = null,'
      '1102371754=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102371755=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'null,'
      '1102371756=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102371757=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = nul' +
        'l,'
      '1102371758=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = null,'
      '1102371759=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = null,'
      
        '1102371760=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = null,'
      
        '1102371761=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD' +
        ' = null,'
      
        '1102371762=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PA' +
        'Y_TRANSACTION_ID = null,'
      
        '1102371763=  REQUEST_NUMBER_ TYPE OF COLUMN ZAKAZ.REQUEST_NUMBER' +
        ' = null)'
      '1102371764=RETURNS ('
      '1102371765=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102371766=  ERR_CODE INTEGER,'
      '1102371767=  ERR_MSG VARCHAR(1024))'
      '1102371768=AS'
      '1102371769=/*'
      '1102371770=IS_SPISANIE_'
      '1102371771=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102371772=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102371773=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102371774=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102371775='
      '1102371776='
      
        '1102371777=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102371778=*/'
      '1102371779=declare variable PROCNAME varchar(30) = '#39'INS_ZAKAZ'#39';'
      '1102371780=declare variable PNT_ varchar(5);'
      '1102371781=declare variable KASSA_ type of column KASSA.KASSA;'
      
        '1102371782=declare variable G_PRODUCT type of column G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1102371783=declare variable AMOUNT type of column ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1102371784=declare variable PRICE type of column ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1102371785=declare variable SUMM type of column ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1102371786=declare variable DISCOUNT_PERC type of column ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1102371787=declare variable DISCOUNT_TENGE type of column ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1102371788=declare variable DISCOUNT_SUMM type of column ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1102371789=declare variable NDS type of column ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1102371790=declare variable NDS_SUMM type of column ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1102371791=declare variable COST_PRICE type of column ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1102371792=declare variable SUMM_FACT_1_ type of column ZAKAZ.SU' +
        'MM_FACT;'
      
        '1102371793=declare variable ZAKAZ_DETAILS_TMP_ type of column ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '1102371794=declare variable CNT_ integer;'
      '1102371795=declare variable IS_THIS_LAST_ integer = 0;'
      
        '1102371796=declare variable PAYMENT_ID_ type of column KASSA.KAS' +
        'SA;'
      
        '1102371797=declare variable PAYMENT_DATE_ type of column KASSA.A' +
        'CTION_DATE;'
      
        '1102371798=declare variable PAYMENT_SUMM_ type of column KASSA.S' +
        'UMM;'
      
        '1102371799=declare variable PAYMENT_TYPE_ type of column G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1102371800=declare variable STR_ varchar(500);'
      '1102371801=declare variable POS_TILDA_ integer;'
      
        '1102371802=declare variable SALES_COMM_ type of column G_PRODUCT' +
        '.SALES_COMM;'
      
        '1102371803=declare variable DO_NOT_SALES_COMM_ type of column G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102371804=declare variable OFFICIAL_NAME_ type of column G_OFFI' +
        'CIAL.FM;'
      
        '1102371805=declare variable WHEN_CHARGE_SALES_COMM_ type of colu' +
        'mn SYSTEM_SETUP.S_VALUE;'
      
        '1102371806=declare variable SALES_COMM_SUMM_ITER_ type of column' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102371807=declare variable SALES_COMM_SUMM_ALL_ type of column ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102371808=declare variable ACTION_DATE_ZP_ type of column KASSA' +
        '.ACTION_DATE;'
      
        '1102371809=declare variable NEW_SKIDKA_VAL_ type of column G_CLI' +
        'ENT.SKIDKA;'
      
        '1102371810=declare variable NEW_BONUS_VAL_ type of column G_DISC' +
        'ONT_CARD.N_PERCENT;'
      
        '1102371811=declare variable CLIENT_SUMM_ALL_ type of column G_DI' +
        'SCONT_CARD.SUMM_ALL;'
      
        '1102371812=declare variable MARK_CODE_ type of column ZAKAZ_DETA' +
        'ILS.MARK_CODE;'
      '1102371813=declare variable LOG_BODY_KASSA_ varchar(1024) = '#39#39';'
      
        '1102371814=declare variable LOG_KASSA_OPER_TYPE_ type of column ' +
        'LOG_OPER.OPERATION;'
      
        '1102371815=declare variable KASSA_ZP_ID_ type of column KASSA.KA' +
        'SSA;'
      
        '1102371816=declare variable ZAKAZ_REAL_PARENT_ type of column ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '1102371817=BEGIN'
      '1102371818='
      
        '1102371819=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1102371820=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1102371821=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1102371822=  IF (CNT_ = 0) THEN BEGIN'
      '1102371823=    ERR_CODE = -20500;'
      
        '1102371824=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1102371825=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1102371826=    EXIT;'
      '1102371827=  END'
      '1102371828='
      '1102371829=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102371830=    SELECT ID'
      '1102371831=      FROM CUR_PARAMS'
      '1102371832=     WHERE CUR_PARAMS = 2'
      '1102371833=      INTO :G_TOCHKA_;'
      '1102371834='
      '1102371835=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102371836=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1102371837=      PNT_ = '#39'01'#39';'
      
        '1102371838=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102371839=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102371840=      ELSE'
      '1102371841=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102371842='
      '1102371843=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1102371844=      SELECT G.G_OFFICIAL,'
      '1102371845=             G.DO_NOT_SALES_COMM,'
      '1102371846=             G.FM||'#39' '#39'||G.NM'
      '1102371847=        FROM G_OFFICIAL G'
      
        '1102371848=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1102371849=        INTO :G_OFFICIAL_,'
      '1102371850=             :DO_NOT_SALES_COMM_,'
      '1102371851=             :OFFICIAL_NAME_;'
      '1102371852='
      '1102371853=      INSERT INTO ZAKAZ'
      '1102371854=      ('
      '1102371855=       ZAKAZ,'
      '1102371856=       G_TOCHKA,'
      '1102371857=       Z_DATE,'
      '1102371858=       Z_TIME,'
      '1102371859=       G_CLIENT,'
      '1102371860=       G_PAYMENT_TYPE,'
      '1102371861=       OSNOVANIE,'
      '1102371862=       IS_SPISANIE,'
      '1102371863=       NOTE,'
      '1102371864=       SUMM,'
      '1102371865=       SUMM_FACT,'
      '1102371866=       SUMM_BONUS,'
      '1102371867=       IS_PAYED_ALL'
      '1102371868=       ,G_OFFICIAL'
      '1102371869=       ,BY_RECIPE'
      '1102371870=       ,SUMM_BONUS_GOT'
      '1102371871=       ,IS_RESERVE'
      '1102371872=       ,SUMM_CASH'
      '1102371873=       ,SUMM_NONCASH'
      '1102371874=       ,NOT_MINUS_OSTATOK'
      '1102371875=       ,DELIVERY_ADDRESS'
      '1102371876=       ,REC_ID'
      '1102371877=       ,G_NONCASH_PAY_TYPE'
      '1102371878=       ,POS_PAY_METHOD'
      '1102371879=       ,POS_PAY_TRANSACTION_ID'
      '1102371880=       ,REQUEST_NUMBER'
      '1102371881=      ) VALUES ('
      '1102371882=       GEN_ID(GEN_ZAKAZ, 1),'
      '1102371883=       :G_TOCHKA_,'
      '1102371884=       :Z_DATE_,'
      '1102371885=       :Z_TIME_,'
      '1102371886=       :G_CLIENT_,'
      '1102371887=       :G_PAYMENT_TYPE_,'
      '1102371888=       :OSNOVANIE_,'
      '1102371889=       :IS_SPISANIE_,'
      '1102371890=       :NOTE_,'
      '1102371891=       :SUMM_,'
      '1102371892=       :SUMM_FACT_1_,'
      '1102371893=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1102371894=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102371895=       ,:G_OFFICIAL_'
      '1102371896=       ,:BY_RECIPE_'
      '1102371897=       ,:SUMM_BONUS_GOT_'
      '1102371898=       ,:IS_RESERVE_'
      '1102371899=       ,COALESCE(:SUMM_CASH_, 0)'
      '1102371900=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1102371901=       ,:NOT_MINUS_OSTATOK_'
      '1102371902=       ,:ADDRESS_'
      '1102371903=       ,:REC_ID_'
      '1102371904=       ,:G_NONCASH_PAY_TYPE_'
      '1102371905=       ,:POS_PAY_METHOD_'
      '1102371906=       ,:POS_PAY_TRANSACTION_ID_'
      '1102371907=       ,:REQUEST_NUMBER_'
      '1102371908=      )'
      '1102371909=      RETURNING'
      '1102371910=        ZAKAZ'
      '1102371911=      INTO'
      '1102371912=        :ZAKAZ_;'
      '1102371913='
      '1102371914=      PNT_ = '#39'02'#39';'
      
        '1102371915=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1102371916=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM, Z.MARK_CODE'
      '1102371917=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1102371918=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1102371919=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1102371920=              :G_PRODUCT,'
      '1102371921=              :AMOUNT,'
      '1102371922=              :PRICE,'
      '1102371923=              :SUMM,'
      '1102371924=              :DISCOUNT_PERC,'
      '1102371925=              :DISCOUNT_TENGE,'
      '1102371926=              :DISCOUNT_SUMM,'
      '1102371927=              :NDS,'
      '1102371928=              :NDS_SUMM,'
      '1102371929=              :COST_PRICE,'
      '1102371930=              :SALES_COMM_,'
      '1102371931=              :MARK_CODE_'
      '1102371932=      DO BEGIN'
      
        '1102371933=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102371934=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1102371935=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1102371936=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102371937=        END'
      '1102371938='
      '1102371939=        INSERT INTO ZAKAZ_DETAILS'
      '1102371940=        VALUES('
      '1102371941=          :ZAKAZ_DETAILS_TMP_,'
      '1102371942=          :ZAKAZ_,'
      '1102371943=          :G_PRODUCT,'
      '1102371944=          :AMOUNT,'
      '1102371945=          :PRICE,'
      '1102371946=          :SUMM,'
      '1102371947=          :DISCOUNT_PERC,'
      '1102371948=          :DISCOUNT_TENGE,'
      '1102371949=          :DISCOUNT_SUMM,'
      '1102371950=          :NDS,'
      '1102371951=          :NDS_SUMM,'
      '1102371952=          :COST_PRICE,'
      '1102371953=          :SALES_COMM_SUMM_ITER_,'
      '1102371954=          :MARK_CODE_'
      '1102371955=        );'
      '1102371956='
      
        '1102371957=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1102371958=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1102371959=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1102371960=                UPDATE LT_SKLAD_PRODUCT L'
      '1102371961=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102371962=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_  -- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051 +
        #1067' '#1055#1056#1048#1061#1054#1044', '#1061#1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102371963=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102371964=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102371965='
      '1102371966=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1102371967=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102371968=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057 +
        #1051#1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102371969=                -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048 +
        #1071' ('#1053#1040#1055#1056#1048#1052#1045#1056' '#1052#1054#1041#1048#1051#1040'), '#1058#1054' '#1053#1040' '#1052#1048#1053#1059#1057' '#1053#1045' '#1055#1056#1054#1042#1045#1056#1071#1070
      '1102371970=                PNT_ = '#39'04'#39';'
      
        '1102371971=                IF (ROW_COUNT = 0 AND ((SELECT S_VALU' +
        'E FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) AND REC_ID_ IS ' +
        'NULL) then BEGIN'
      '1102371972=                  Err_Code = -20500;'
      
        '1102371973=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_C' +
        'ODE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_' +
        'PRODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072 +
        #1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102371974=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102371975=                  EXIT;'
      '1102371976=                END ELSE if (ROW_COUNT = 0) then'
      
        '1102371977=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102371978=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);  -' +
        '- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067' '#1055#1056#1048#1061#1054#1044', '#1061 +
        #1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102371979=            END'
      '1102371980='
      '1102371981=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102371982=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102371983=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102371984=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :AMOUNT'
      '1102371985=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102371986=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102371987='
      '1102371988='
      '1102371989=        END'
      '1102371990=      END'
      '1102371991='
      '1102371992=      ----------------------------------------'
      
        '1102371993=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1102371994=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1102371995=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1102371996='
      
        '1102371997=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1102371998=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1102371999=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1102372000=                PNT_ = '#39'05'#39';'
      
        '1102372001=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1102372002=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1102372003=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1102372004=                                              :Z_DATE' +
        '_,'
      
        '1102372005=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102372006=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1102372007=                                              NULL,'
      
        '1102372008=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1102372009=                                              :G_TOCH' +
        'KA_,'
      
        '1102372010=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102372011=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102372012=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102372013=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102372014=                  EXIT;'
      '1102372015=                END'
      '1102372016=            END'
      '1102372017='
      '1102372018=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1102372019=        END ELSE BEGIN'
      '1102372020=            PNT_ = '#39'06'#39';'
      
        '1102372021=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1102372022=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1102372023=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1102372024=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102372025=                ELSE'
      
        '1102372026=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102372027='
      
        '1102372028=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1102372029=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102372030='
      
        '1102372031=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102372032='
      '1102372033=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102372034=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102372035=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1102372036=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1102372037=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1102372038=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1102372039=                                                  :ZA' +
        'KAZ_,'
      
        '1102372040=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1102372041=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1102372042=                                                  :G_' +
        'TOCHKA_,'
      
        '1102372043=                                                  :UP' +
        'LOAD_TO_EXT_APP_'
      
        '1102372044=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102372045=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102372046=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1102372047=                      EXIT;'
      '1102372048=                    END'
      '1102372049=                END'
      '1102372050=            END'
      '1102372051=        END'
      '1102372052=      END'
      '1102372053='
      
        '1102372054=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1102372055=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1102372056=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1102372057=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1102372058=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1102372059=          UPDATE G_DISCONT_CARD D'
      
        '1102372060=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1102372061=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1102372062=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1102372063=          RETURNING'
      '1102372064=            D.SUMM_ALL'
      '1102372065=          INTO'
      '1102372066=            :CLIENT_SUMM_ALL_;'
      '1102372067='
      '1102372068=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1102372069=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1102372070=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1102372071=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1102372072=          ORDER BY G.SUMM_FROM'
      '1102372073=          ROWS 1 TO 1'
      '1102372074=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1102372075='
      '1102372076=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1102372077=            UPDATE G_CLIENT G'
      '1102372078=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1102372079=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1102372080=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1102372081='
      '1102372082=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1102372083=            UPDATE G_DISCONT_CARD D'
      '1102372084=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1102372085=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1102372086=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1102372087=      END'
      '1102372088='
      
        '1102372089=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' ' +
        #1057' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', ' +
        #1050#1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '1102372090=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057 +
        #1051#1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102372091=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102372092=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102372093=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102372094=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1102372095=      PNT_ = '#39'07'#39';'
      
        '1102372096=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THE' +
        'N BEGIN'
      '1102372097=        SELECT S.S_VALUE'
      '1102372098=          FROM SYSTEM_SETUP S'
      '1102372099=         WHERE S.SYSTEM_SETUP = 4'
      '1102372100=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102372101='
      '1102372102=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102372103=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102372104=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102372105='
      
        '1102372106=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1102372107=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1102372108=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1102372109='
      '1102372110=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102372111=        ELSE'
      
        '1102372112=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1102372113='
      '1102372114=        KASSA_ZP_ID_ = NULL;'
      '1102372115=        SELECT K.KASSA, K.SUMM'
      '1102372116=        FROM KASSA K'
      '1102372117=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1102372118=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102372119=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102372120=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102372121=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1102372122='
      
        '1102372123=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1102372124='
      '1102372125=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102372126=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102372127=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102372128=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1102372129=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1102372130=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1102372131=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1102372132=                                          NULL,     -' +
        '-:SKLAD_,'
      '1102372133=                                          1,'
      '1102372134=                                          :G_TOCHKA_,'
      
        '1102372135=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102372136=                                          :G_OFFICIAL' +
        '_'
      
        '1102372137=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1102372138=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102372139=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1102372140='
      '1102372141=        END ELSE BEGIN'
      
        '1102372142=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1102372143=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1102372144=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1102372145=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1102372146='
      
        '1102372147=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1102372148=                                          1,     -- A' +
        'CTION_'
      
        '1102372149=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102372150=                                          :SALES_COMM' +
        '_SUMM_ALL_,   --SUMM_'
      
        '1102372151=                                          :ACTION_DAT' +
        'E_ZP_,  -- ACTION_DATE_'
      
        '1102372152=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      
        '1102372153=                                          NULL,      ' +
        '        -- ZAKAZ_'
      
        '1102372154=                                          NULL,      ' +
        '        -- SKLAD_'
      
        '1102372155=                                          1,         ' +
        '        --:PAYMENT_TYPE_,'
      
        '1102372156=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102372157=                                          :G_OFFICIAL' +
        '_'
      
        '1102372158=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102372159='
      '1102372160=        END'
      '1102372161=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102372162=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102372163=          EXIT;'
      '1102372164=        END'
      '1102372165=      END */'
      '1102372166='
      
        '1102372167=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOA' +
        'D_TO_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040 +
        #1058#1053#1054' '#1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102372168=      IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_SPISANIE_ = ' +
        '0) THEN'
      
        '1102372169=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER, IS_LOADED_MOB)'
      
        '1102372170=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1, (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END));  ' +
        ' -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' CASE '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' '#1054#1041#1053#1054#1042#1051#1045#1053 +
        #1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102372171=  END'
      '1102372172=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102372173=  ----------------------------------------'
      '1102372174=  ----------------------------------------'
      '1102372175=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102372176=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1102372177=      PNT_ = '#39'25'#39';'
      
        '1102372178=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1102372179=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1102372180=      RETURNING ZAKAZ_REAL_PARENT'
      '1102372181=      INTO :ZAKAZ_REAL_PARENT_;'
      '1102372182='
      
        '1102372183=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1102372184=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102372185=          INTO :G_PRODUCT,'
      '1102372186=              :AMOUNT,'
      '1102372187=              :PRICE,'
      '1102372188=              :SUMM,'
      '1102372189=              :DISCOUNT_PERC,'
      '1102372190=              :DISCOUNT_TENGE,'
      '1102372191=              :DISCOUNT_SUMM,'
      '1102372192=              :NDS,'
      '1102372193=              :NDS_SUMM'
      '1102372194=      DO BEGIN'
      '1102372195=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102372196=          UPDATE LT_SKLAD_PRODUCT L'
      '1102372197=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102372198=                 L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_AP' +
        'P_'
      '1102372199=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102372200=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102372201='
      
        '1102372202=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102372203=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102372204=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1102372205=            Err_Code = -20500;'
      
        '1102372206=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102372207=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102372208=            EXIT;'
      '1102372209=          END ELSE if (ROW_COUNT = 0) then'
      
        '1102372210=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102372211=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102372212='
      
        '1102372213=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1102372214=                                     G_PRODUCT,'
      '1102372215=                                     PRICE,'
      
        '1102372216=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1102372217=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1102372218=                                     NDS_SUMM)'
      
        '1102372219=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1102372220=                  :G_PRODUCT,'
      
        '1102372221=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1102372222=                  :AMOUNT, :SUMM,'
      '1102372223=                  0, --AMOUNT_PAYED,'
      '1102372224=                  0, --SUMM_PAYED,'
      '1102372225=                  0, --IS_PAYED_ALL,'
      '1102372226=                  :DISCOUNT_PERC,'
      '1102372227=                  :DISCOUNT_TENGE,'
      '1102372228=                  :DISCOUNT_SUMM,'
      '1102372229=                  :NDS,'
      '1102372230=                  :NDS_SUMM)'
      '1102372231=          RETURNING ZAKAZ_NA_REAL'
      '1102372232=          INTO :ZAKAZ_;'
      '1102372233=      END'
      '1102372234=  END'
      '1102372235=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102372236=  ----------------------------------------'
      '1102372237=  ----------------------------------------'
      '1102372238=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1102372239=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1102372240=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102372241=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102372242=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1102372243=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102372244=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102372245=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102372246=      RETURNING SKLAD'
      '1102372247=      INTO :ZAKAZ_;'
      '1102372248='
      '1102372249=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102372250=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102372251=          INTO :G_PRODUCT,'
      '1102372252=              :AMOUNT,'
      '1102372253=              :PRICE,'
      '1102372254=              :SUMM'
      '1102372255=      DO BEGIN'
      '1102372256=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102372257=        UPDATE LT_SKLAD_PRODUCT L'
      '1102372258=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1102372259=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102372260=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102372261=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102372262='
      '1102372263=        IF (ROW_COUNT = 0) THEN'
      
        '1102372264=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102372265=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102372266='
      '1102372267=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102372268=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1102372269=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1102372270=        SELECT MAX(SK.DATE_RECEIPT)'
      '1102372271=            FROM SKLAD SK'
      '1102372272=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102372273=             AND SK.IS_LAST = 1'
      '1102372274=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1102372275=            INTO :DATE_LAST_;'
      '1102372276='
      
        '1102372277=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102372278=            UPDATE SKLAD SK'
      '1102372279=               SET SK.IS_LAST = 0'
      '1102372280=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102372281=               AND SK.IS_LAST = 1'
      '1102372282=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102372283='
      '1102372284=            IS_THIS_LAST_ = 1;'
      '1102372285=        END */'
      '1102372286='
      '1102372287='
      '1102372288=        INSERT INTO SKLAD'
      '1102372289=        ('
      '1102372290=         SKLAD,'
      '1102372291=         SKLAD_PARENT,'
      '1102372292=         DATE_RECEIPT,'
      '1102372293=         G_CLIENT,'
      '1102372294=         G_PRODUCT,'
      '1102372295=         AMOUNT,'
      '1102372296=         PRICE,'
      '1102372297=         SUMM,'
      '1102372298=         G_PAYMENT_TYPE,'
      '1102372299=         OSNOVANIE,'
      '1102372300=         NOTE,'
      '1102372301=         NDS,'
      '1102372302=         NDS_SUMM,'
      '1102372303=         IS_LAST,'
      '1102372304=         IS_VOZVRAT,'
      '1102372305=         G_TOCHKA'
      '1102372306=        ) VALUES ('
      '1102372307=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102372308=         :ZAKAZ_,'
      '1102372309=         :Z_DATE_,'
      '1102372310=         :G_TOCHKA_,'
      '1102372311=         :G_PRODUCT,'
      '1102372312=         :AMOUNT,'
      '1102372313=         :PRICE,'
      '1102372314=         :SUMM,'
      '1102372315=         :G_PAYMENT_TYPE_,'
      '1102372316=         :OSNOVANIE_,'
      '1102372317=         :NOTE_,'
      '1102372318=         0,  --:RNDS_,'
      '1102372319=         0,  --:RNDS_SUMM_,'
      
        '1102372320=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102372321=         3,  --:IS_VOZVRAT_,'
      '1102372322=         :G_CLIENT_'
      '1102372323=        );'
      '1102372324='
      
        '1102372325=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102372326=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102372327=        PNT_ = '#39'02'#39';'
      '1102372328=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102372329=            UPDATE LT_SKLAD_PRODUCT L'
      '1102372330=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102372331=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102372332=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102372333=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102372334='
      '1102372335=            IF (ROW_COUNT = 0) THEN'
      
        '1102372336=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102372337=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102372338=        END'
      '1102372339=      END'
      '1102372340=  END'
      '1102372341='
      '1102372342=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102372343='
      
        '1102372344=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102372345=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102372346=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102372347=                                  G_PRIHOD_,'
      '1102372348=                                  :SUMM_PRIHOD_,'
      '1102372349=                                  :Z_DATE_,'
      
        '1102372350=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102372351=                                  :ZAKAZ_,'
      '1102372352=                                  NULL,'
      '1102372353=                                  :G_PAYMENT_TYPE_,'
      '1102372354=                                  :G_TOCHKA_,'
      '1102372355=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102372356=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102372357=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102372358=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102372359=      EXIT;'
      '1102372360=    END'
      '1102372361=  END'
      '1102372362='
      
        '1102372363=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102372364=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102372365=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102372366=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102372367='
      '1102372368=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102372369=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102372370='
      '1102372371=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102372372=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102372373=end'
      '1102372374=;'
      '1102372375='
      '1102372376=ALTER PROCEDURE P_REP_BILL('
      '1102372377=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102372378=  SUMM_DANO_ NUMERIC(15,2),'
      '1102372379=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1102372380=  CURRENCY_ INTEGER,'
      '1102372381=  MODE_ INTEGER,'
      '1102372382=  PRINT_SLOGAN_ VARCHAR(80),'
      '1102372383=  DECIMAL_ INTEGER,'
      '1102372384=  BONUS_ NUMERIC(15,2),'
      '1102372385=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '1102372386=  BONUS_ALL_ NUMERIC(15,2) = 0)'
      '1102372387=RETURNS ('
      '1102372388=  FIRM_NAME_ VARCHAR(600),'
      '1102372389=  IDN_STR_ VARCHAR(30),'
      '1102372390=  FIRM_IDN_ VARCHAR(50),'
      '1102372391=  FIRM_ADDRESS_ VARCHAR(550),'
      '1102372392=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102372393=  DATE_ VARCHAR(100),'
      '1102372394=  PAYMENT_TYPE_ VARCHAR(100),'
      '1102372395=  G_CLIENT_NAME_ VARCHAR(300),'
      '1102372396=  G_OFFICIAL_FM_ VARCHAR(300),'
      '1102372397=  SUMM_VSEGO_ VARCHAR(50),'
      '1102372398=  SUMM_VSEGO_N_ VARCHAR(50),'
      '1102372399=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1102372400=  ROW_NUM INTEGER,'
      '1102372401=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102372402=  NAME_ART VARCHAR(1000),'
      '1102372403=  AMOUNT VARCHAR(50),'
      '1102372404=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102372405=  PRICE VARCHAR(50),'
      '1102372406=  PRICE_N VARCHAR(50),'
      '1102372407=  SUMM VARCHAR(50),'
      '1102372408=  SUMM_N VARCHAR(50),'
      '1102372409=  SUMM_POLUCH_ VARCHAR(50),'
      '1102372410=  SUMM_SDACH_ VARCHAR(50),'
      '1102372411=  SUMM_STR_ VARCHAR(200),'
      '1102372412=  SLOGAN_ VARCHAR(80),'
      '1102372413=  SUMM_SKIDKA_ VARCHAR(50),'
      '1102372414=  SUMM_SERVICE_ VARCHAR(50),'
      '1102372415=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102372416=  BONUS_STR_ VARCHAR(100),'
      '1102372417=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '1102372418=  ERR_CODE NUMERIC(15,2),'
      '1102372419=  ERR_MSG VARCHAR(1024),'
      '1102372420=  NAME_MARKER VARCHAR(1000),'
      '1102372421=  BONUSALL_STR_ VARCHAR(100))'
      '1102372422=AS'
      '1102372423=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '1102372424=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '1102372425=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102372426=DECLARE VARIABLE I INTEGER = 1;'
      
        '1102372427=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1102372428=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1102372429=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.AMOUNT;'
      
        '1102372430=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102372431=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102372432=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      '1102372433=BEGIN'
      '1102372434=  SLOGAN_ = PRINT_SLOGAN_;'
      '1102372435=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '1102372436=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '1102372437=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS' +
        '_;'
      '1102372438=  END'
      '1102372439='
      '1102372440=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1102372441=  SELECT z.ZAKAZ'
      '1102372442=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '1102372443=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39 +
        ')||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '1102372444=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '1102372445=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COA' +
        'LESCE(O.NM, '#39#39')'
      '1102372446=         ,Z.summ_noncash'
      '1102372447=         ,Z.summ_cash'
      '1102372448=         ,Z.NOTE'
      
        '1102372449=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_' +
        'OFFICIAL = O.G_OFFICIAL,'
      '1102372450=         G_CLIENT G,'
      '1102372451=         G_PAYMENT_TYPE P'
      '1102372452=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102372453=     AND Z.G_CLIENT = G.G_CLIENT'
      '1102372454=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1102372455=    INTO :NUM_'
      '1102372456=        ,:PAYMENT_TYPE_'
      '1102372457=        ,:DATE_'
      '1102372458=        ,:G_CLIENT_NAME_'
      '1102372459=        ,:G_OFFICIAL_FM_'
      '1102372460=        ,:SUMM_NONCASH_'
      '1102372461=        ,:SUMM_CASH_'
      '1102372462=        ,:NOTE_'
      '1102372463=        ;'
      '1102372464='
      '1102372465=  --'#1041#1054#1053#1059#1057#1067' '#1042' '#1063#1045#1050#1045
      '1102372466=  IF (BONUS_ > 0) THEN'
      '1102372467=  BEGIN'
      
        '1102372468=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(' +
        'BONUS_, 2) AS VARCHAR(100));'
      '1102372469=  END'
      '1102372470='
      '1102372471=  if (BONUS_ALL_ > 0) then'
      '1102372472=  BEGIN'
      
        '1102372473=    BONUSALL_STR_ = '#39#1042#1089#1077#1075#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_ALL_, 2) AS VARCHAR(100));'
      '1102372474=  END'
      '1102372475='
      '1102372476=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1102372477=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '1102372478=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '1102372479='
      '1102372480=  SELECT R.G_FIRM_REKVIZIT,'
      '1102372481=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '1102372482=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086 +
        #1088#1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '1102372483=    FROM G_FIRM_REKVIZIT R'
      '1102372484=   WHERE R.is_default = 1'
      '1102372485=    INTO :G_FIRM_REKVIZIT_,'
      '1102372486=         :FIRM_NAME_,'
      '1102372487=         :FIRM_IDN_;'
      '1102372488='
      '1102372489=  SELECT ZD.SUMM'
      '1102372490=    FROM ZAKAZ_DETAILS ZD'
      '1102372491=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102372492=    AND ZD.G_PRODUCT = -2'
      '1102372493=    INTO :SERVICE_SUMM_;'
      '1102372494=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '1102372495='
      '1102372496=  SELECT SUM(ZD.AMOUNT),'
      
        '1102372497=         CAST(ROUND(SUM((CASE WHEN ZD.DISCOUNT_SUMM>0' +
        ' THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)),'
      
        '1102372498=         CAST(ROUND(SUM(ZD.SUMM + (CASE WHEN ZD.DISCO' +
        'UNT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)' +
        '),'
      
        '1102372499=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHA' +
        'R(50)),'
      '1102372500=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '1102372501=  FROM ZAKAZ_DETAILS ZD'
      '1102372502=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102372503=    AND ZD.G_PRODUCT <> -2'
      '1102372504=  INTO :AMOUNT_VSEGO_NUM_,'
      '1102372505=       :SUMM_SKIDKA_,'
      '1102372506=       :SUMM_VSEGO_,'
      '1102372507=       :SUMM_VSEGO_N_,'
      '1102372508=       :SUMM_SERVICE_;'
      '1102372509='
      '1102372510=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '1102372511=    FROM G_FIRM_ADDRESS R'
      '1102372512=   WHERE R.IS_DEFAULT = 1'
      '1102372513=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '1102372514=    INTO :FIRM_ADDRESS_;'
      '1102372515='
      
        '1102372516=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047 +
        #1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '1102372517=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':' +
        #39');'
      '1102372518=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '1102372519=    IF (CURRENCY_ = 0) THEN'
      '1102372520=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '1102372521=    ELSE'
      '1102372522=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '1102372523=  END'
      '1102372524='
      '1102372525=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '1102372526='
      
        '1102372527=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR' +
        '(100));'
      
        '1102372528=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCH' +
        'AR(100));'
      '1102372529='
      '1102372530=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '1102372531=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '1102372532=  INTO :SUMM_STR_;'
      '1102372533='
      '1102372534=  FOR'
      '1102372535=    SELECT :I,'
      '1102372536=           G.NAME,'
      
        '1102372537=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.M' +
        'ARK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||' +
        'ZD.MARK_CODE END),'
      
        '1102372538=           (CASE WHEN (G.ARTICUL is null) or (G.ARTIC' +
        'UL = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '1102372539=           ZD.AMOUNT,'
      
        '1102372540=           CAST(ROUND(ZD.PRICE - (CASE WHEN ZD.DISCOU' +
        'NT_SUMM<0 THEN ZD.DISCOUNT_SUMM else 0 END)/ZD.AMOUNT, 2) AS VAR' +
        'CHAR(100)),'
      
        '1102372541=           CAST(ROUND(ZD.SUMM + (CASE WHEN ZD.DISCOUN' +
        'T_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END) , 2) AS VARCHAR(100))'
      '1102372542=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '1102372543=           ,CAST(ZD.PRICE - COALESCE((CASE WHEN ZD.DI' +
        'SCOUNT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END), 0) AS VARCHAR(1' +
        '00))'
      '1102372544=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '1102372545=      FROM ZAKAZ Z,'
      '1102372546=           ZAKAZ_DETAILS ZD,'
      '1102372547=           G_PRODUCT G,'
      '1102372548=           G_UNIT U'
      '1102372549=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102372550=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102372551=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1102372552=       AND G.G_UNIT = U.G_UNIT'
      '1102372553=       AND G.G_PRODUCT <> -2'
      '1102372554=     ORDER BY ZD.zakaz_details'
      '1102372555=    INTO :ROW_NUM,'
      '1102372556=        :NAME,'
      '1102372557=        :NAME_MARKER,'
      '1102372558=        :NAME_ART,'
      '1102372559=        :AMOUNT_NUM_,'
      '1102372560=        :PRICE,'
      '1102372561=        :SUMM'
      '1102372562=        ,:SHORT_NAME'
      '1102372563=        ,:PRICE_N'
      '1102372564=        ,:SUMM_N'
      '1102372565='
      '1102372566=  DO BEGIN'
      '1102372567=    I = I + 1;'
      '1102372568='
      
        '1102372569=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068 +
        ' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '1102372570=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '1102372571=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '1102372572=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '1102372573=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '1102372574=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '1102372575=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE)-1);'
      '1102372576=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '1102372577=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR P' +
        'OSITION('#39'.00'#39' IN PRICE_N)-1);'
      '1102372578=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '1102372579=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM)-1);'
      '1102372580=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '1102372581=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN SUMM_N)-1);'
      '1102372582=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '1102372583=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '1102372584=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '1102372585=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '1102372586=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '1102372587=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '1102372588=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '1102372589=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM' +
        ' 1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '1102372590=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '1102372591=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR' +
        ' POSITION('#39'.00'#39' IN BONUS_STR_)-1);'
      '1102372592='
      '1102372593=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1102372594=    IF (DECIMAL_ = 2) THEN BEGIN'
      '1102372595=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '1102372596=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,2));'
      '1102372597=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '1102372598=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '1102372599=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,3));'
      '1102372600=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '1102372601=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '1102372602=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,4));'
      '1102372603=    END ELSE BEGIN'
      '1102372604=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '1102372605=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,5));'
      '1102372606=    END'
      '1102372607='
      
        '1102372608=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT) > 0) then'
      
        '1102372609=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR PO' +
        'SITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '1102372610='
      
        '1102372611=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT_VSEGO_) > 0) then'
      
        '1102372612=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1' +
        ' FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '1102372613='
      '1102372614=    SUSPEND;'
      '1102372615=  END'
      '1102372616=WHEN ANY DO BEGIN'
      '1102372617=    Err_code = -20500;'
      
        '1102372618=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102372619=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102372620=  END'
      '1102372621=end'
      '1102372622=;'
      '1102372623='
      '1102372624=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '1102372625=  DATE_BEGIN_ DATE,'
      '1102372626=  DATE_END_ DATE,'
      '1102372627=  IS_SPISANIE_ INTEGER,'
      '1102372628=  SALE_OF_GOODS_ INTEGER)'
      '1102372629=RETURNS ('
      '1102372630=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102372631=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102372632=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1102372633=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102372634=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102372635=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1102372636=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102372637=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102372638=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102372639=  DETAILS_STR VARCHAR(3000),'
      '1102372640=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102372641=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1102372642=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '1102372643=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '1102372644=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1102372645=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102372646=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102372647=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102372648=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102372649=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1102372650=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '1102372651=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102372652=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102372653=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102372654=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102372655=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      
        '1102372656=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      
        '1102372657=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PA' +
        'Y_TYPE.NAME,'
      '1102372658=  BONUSALL TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '1102372659=  REQUEST_NUMBER TYPE OF COLUMN ZAKAZ.REQUEST_NUMBER)'
      '1102372660=AS'
      '1102372661=/*'
      '1102372662=IS_SPISANIE_'
      '1102372663=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102372664=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102372665=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102372666=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102372667=*/'
      '1102372668=declare variable CNT_ integer = 0;'
      
        '1102372669=declare variable G_OFFICIAL_LOCAL_ type of column G_O' +
        'FFICIAL.G_OFFICIAL;'
      
        '1102372670=declare variable G_OFFICIAL_APPOINT_ type of column G' +
        '_OFFICIAL.IS_ISPOLNITEL;'
      '1102372671=BEGIN'
      '1102372672=  sale_of_goods_ = COALESCE(sale_of_goods_, 0);'
      '1102372673=  if (sale_of_goods_ = 0) then'
      '1102372674=  begin'
      '1102372675=    G_OFFICIAL_LOCAL_ = 0;'
      '1102372676=    G_OFFICIAL_APPOINT_ = 1;'
      '1102372677=  end'
      '1102372678=  else'
      '1102372679=  begin'
      '1102372680=      SELECT G.G_OFFICIAL,'
      '1102372681=             G.IS_RUKOVODITEL + G.IS_GLAVBUH'
      '1102372682=        FROM CUR_PARAMS C,'
      '1102372683=             G_OFFICIAL G'
      '1102372684=       WHERE C.ID = G.G_OFFICIAL'
      '1102372685=         AND C.CUR_PARAMS = 1'
      '1102372686=        INTO :G_OFFICIAL_LOCAL_,'
      '1102372687=             :G_OFFICIAL_APPOINT_;'
      '1102372688=  end'
      '1102372689='
      '1102372690='
      '1102372691=  G_OFFICIAL_LOCAL_ = COALESCE(G_OFFICIAL_LOCAL_, 0);'
      
        '1102372692=  G_OFFICIAL_APPOINT_ = COALESCE(G_OFFICIAL_APPOINT_,' +
        ' 0);'
      '1102372693='
      '1102372694=  IF (IS_SPISANIE_ <> 3) THEN'
      '1102372695=  BEGIN'
      '1102372696=      SELECT COUNT(*)'
      '1102372697=        FROM ZAKAZ T'
      
        '1102372698=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '1102372699=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1102372700=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '1102372701=        INTO CNT_;'
      '1102372702='
      '1102372703=      if (CNT_ = 0) then'
      '1102372704=        SELECT MAX(T.Z_DATE)'
      '1102372705=          FROM ZAKAZ T'
      '1102372706=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '1102372707=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '1102372708=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102372709=          INTO :DATE_BEGIN_;'
      '1102372710='
      '1102372711=  END ELSE'
      '1102372712=  BEGIN'
      '1102372713=      SELECT COUNT(*)'
      '1102372714=        FROM SKLAD_PARENT T'
      
        '1102372715=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1102372716=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1102372717=        INTO CNT_;'
      '1102372718='
      '1102372719=      if (CNT_ = 0) then'
      '1102372720=        SELECT MAX(T.DATE_RECEIPT)'
      '1102372721=          FROM SKLAD_PARENT T'
      '1102372722=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1102372723=           AND T.IS_VOZVRAT = 3'
      
        '1102372724=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102372725=          INTO :DATE_BEGIN_;'
      '1102372726=  END'
      '1102372727='
      '1102372728=  -- '#1055#1056#1054#1044#1040#1046#1048
      '1102372729=  IF (IS_SPISANIE_ IN (0,2,4)) THEN'
      '1102372730=  BEGIN'
      '1102372731=      FOR'
      '1102372732=        SELECT T.ZAKAZ,'
      
        '1102372733=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102372734=               T.G_TOCHKA,'
      '1102372735=               T.Z_DATE,'
      '1102372736=               T.Z_TIME,'
      '1102372737=               T.G_CLIENT,'
      '1102372738=               T.OSNOVANIE,'
      '1102372739=               T.NOTE,'
      '1102372740=               gc.name,'
      
        '1102372741=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AM' +
        'OUNT||'#39')'#39', '#39', '#39')'
      
        '1102372742=                            FROM (SELECT G.name, SUM(' +
        'D.amount) AMOUNT'
      
        '1102372743=                                    FROM ZAKAZ Z, ZAK' +
        'AZ_DETAILS D, G_PRODUCT G'
      
        '1102372744=                                   WHERE D.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1102372745=                                     AND D.ZAKAZ = Z.' +
        'ZAKAZ'
      
        '1102372746=                                     AND Z.ZAKAZ = T.' +
        'ZAKAZ'
      '1102372747=                                   GROUP BY G.name)'
      
        '1102372748=                          ) FROM 1 FOR 1500)*/'#39' '#39' DET' +
        'AILS_STR,'
      '1102372749=               T.IS_SPISANIE,'
      
        '1102372750=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_A' +
        'LL,'
      '1102372751=               IP.INVOICE_PAY,'
      '1102372752=               I.INVOICE,'
      '1102372753=               W.WAYBILL,'
      '1102372754=               T.SUMM,'
      '1102372755=               T.SUMM_FACT,'
      '1102372756=               COALESCE(t.SUMM_BONUS, 0),'
      '1102372757=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '1102372758=               COALESCE(T.BY_RECIPE, 0)'
      '1102372759=               ,IS_RESERVE'
      '1102372760=               ,T.SUMM_CASH'
      '1102372761=               ,T.SUMM_NONCASH'
      '1102372762=               ,O.g_official'
      '1102372763=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '1102372764=               ,T.DELIVERY_ADDRESS'
      '1102372765=               ,GN.G_NONCASH_PAY_TYPE'
      '1102372766=               ,GN.NAME'
      '1102372767=               ,GD.SUMM'
      '1102372768=               ,T.REQUEST_NUMBER'
      '1102372769=          FROM ZAKAZ T'
      
        '1102372770=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1102372771=                    LEFT OUTER JOIN INVOICE_PAY IP ON' +
        ' T.ZAKAZ = IP.ZAKAZ'
      
        '1102372772=                    LEFT OUTER JOIN INVOICE I ON T.ZA' +
        'KAZ = I.ZAKAZ'
      
        '1102372773=                    LEFT OUTER JOIN WAYBILL W ON T.ZA' +
        'KAZ = W.ZAKAZ'
      
        '1102372774=                    LEFT OUTER JOIN G_OFFICIAL O ON T' +
        '.g_official = O.g_official'
      
        '1102372775=                    LEFT OUTER JOIN G_NONCASH_PAY_TYP' +
        'E GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '1102372776=                    LEFT OUTER JOIN G_DISCONT_CARD GD' +
        ' ON T.G_CLIENT = GD.G_CLIENT'
      
        '1102372777=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102372778=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISA' +
        'NIE_ = 0'
      '1102372779=                 AND'
      
        '1102372780=                 ((:G_OFFICIAL_APPOINT_ = 0 AND T.G_O' +
        'FFICIAL = :G_OFFICIAL_LOCAL_)'
      '1102372781=                   OR'
      '1102372782=                  (:G_OFFICIAL_APPOINT_ = 1 )'
      '1102372783=                 )'
      '1102372784=                )'
      '1102372785=                or'
      
        '1102372786=                (T.IS_SPISANIE = :IS_SPISANIE_ AND :I' +
        'S_SPISANIE_ <> 0)'
      '1102372787=               )'
      
        '1102372788=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102372789=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1102372790=        INTO :ZAKAZ,'
      '1102372791=             :Z_NUM,'
      '1102372792=             :G_TOCHKA,'
      '1102372793=             :Z_DATE,'
      '1102372794=             :Z_TIME,'
      '1102372795=             :G_CLIENT,'
      '1102372796=             :OSNOVANIE,'
      '1102372797=             :NOTE,'
      '1102372798=             :CLIENT_NAME,'
      '1102372799=             :DETAILS_STR,'
      '1102372800=             :IS_SPISANIE,'
      '1102372801=             :IS_PAYED_ALL,'
      '1102372802=             :INVOICE_PAY,'
      '1102372803=             :INVOICE,'
      '1102372804=             :WAYBILL,'
      '1102372805=             :SUM_ZAKAZ,'
      '1102372806=             :SUM_FACT,'
      '1102372807=             :SUMM_PAY_BONUS,'
      '1102372808=             :SUMM_BONUS_GOT,'
      '1102372809=             :BY_RECIPE'
      '1102372810=             ,:IS_RESERVE'
      '1102372811=             ,:summ_cash'
      '1102372812=             ,:SUMM_NONCASH'
      '1102372813=             ,:G_OFFICIAL'
      '1102372814=             ,:G_OFFICIAL_FIO'
      '1102372815=             ,:ADDRESS'
      '1102372816=             ,:G_NONCASH_PAY_TYPE'
      '1102372817=             ,:G_NONCASH_PAY_TYPE_NAME'
      '1102372818=             ,:BONUSALL'
      '1102372819=             ,:REQUEST_NUMBER'
      '1102372820=      DO'
      '1102372821=        suspend;'
      '1102372822='
      '1102372823=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '1102372824=  END ELSE IF (IS_SPISANIE_ = 1) THEN'
      '1102372825=  BEGIN'
      '1102372826=      FOR'
      '1102372827=        SELECT T.ZAKAZ,'
      
        '1102372828=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102372829=               T.G_TOCHKA,'
      '1102372830=               T.Z_DATE,'
      '1102372831=               T.Z_TIME,'
      '1102372832=               T.G_CLIENT,'
      '1102372833=               T.OSNOVANIE,'
      '1102372834=               T.NOTE,'
      '1102372835=               NULL,'
      '1102372836=               SUBSTRING((SELECT'
      
        '1102372837=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT|' +
        '|'#39')'#39', '#39', '#39')'
      
        '1102372838=                        FROM ZAKAZ_DETAILS D, G_PRODU' +
        'CT G'
      
        '1102372839=                        WHERE D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '1102372840=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '1102372841=                          GROUP BY ZAKAZ) FROM 1 FOR ' +
        '999) DETAILS_STR,'
      '1102372842=               T.IS_SPISANIE,'
      '1102372843=               0,'
      '1102372844=               NULL,'
      '1102372845=               NULL,'
      '1102372846=               NULL,'
      '1102372847=               T.SUMM,'
      '1102372848=               T.SUMM_FACT,'
      '1102372849=               0,'
      '1102372850=               0,'
      '1102372851=               0,'
      '1102372852=               T.REQUEST_NUMBER'
      '1102372853=          FROM ZAKAZ T'
      
        '1102372854=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1102372855=           AND T.IS_SPISANIE  = 1'
      
        '1102372856=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102372857=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1102372858=        INTO :ZAKAZ,'
      '1102372859=             :Z_NUM,'
      '1102372860=             :G_TOCHKA,'
      '1102372861=             :Z_DATE,'
      '1102372862=             :Z_TIME,'
      '1102372863=             :G_CLIENT,'
      '1102372864=             :OSNOVANIE,'
      '1102372865=             :NOTE,'
      '1102372866=             :CLIENT_NAME,'
      '1102372867=             :DETAILS_STR,'
      '1102372868=             :IS_SPISANIE,'
      '1102372869=             :IS_PAYED_ALL,'
      '1102372870=             :INVOICE_PAY,'
      '1102372871=             :INVOICE,'
      '1102372872=             :WAYBILL,'
      '1102372873=             :SUM_ZAKAZ,'
      '1102372874=             :SUM_FACT,'
      '1102372875=             :SUMM_PAY_BONUS,'
      '1102372876=             :SUMM_BONUS_GOT,'
      '1102372877=             :BONUSALL,'
      '1102372878=             :REQUEST_NUMBER'
      '1102372879=      DO'
      '1102372880=        suspend;'
      '1102372881='
      '1102372882=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102372883=  END ELSE'
      '1102372884=  BEGIN'
      '1102372885=      FOR'
      '1102372886=        SELECT T.SKLAD,'
      
        '1102372887=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102372888=               T.G_TOCHKA,'
      '1102372889=               T.DATE_RECEIPT,'
      '1102372890=               T.TIME_RECEIPT,'
      '1102372891=               T.G_CLIENT,'
      '1102372892=               T.OSNOVANIE,'
      '1102372893=               T.NOTE,'
      '1102372894=               gc.name,'
      '1102372895=               /*SUBSTRING((SELECT'
      
        '1102372896=                            LIST(G.NAME||'#39'('#39'||D.AMOUN' +
        'T||'#39')'#39', '#39', '#39')'
      '1102372897=                            FROM SKLAD D, G_PRODUCT G'
      
        '1102372898=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1102372899=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1102372900=                            GROUP BY SKLAD_PARENT) FR' +
        'OM 1 FOR 999)*/ '#39#39' DETAILS_STR,'
      '1102372901=               T.SUMM,'
      '1102372902=               T.IS_VOZVRAT,'
      '1102372903=               W.WAYBILL'
      
        '1102372904=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL' +
        ' W ON T.SKLAD = W.ZAKAZ,'
      '1102372905=               G_TOCHKA GC'
      
        '1102372906=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1102372907=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102372908=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '1102372909=           AND T.IS_VOZVRAT = 3'
      '1102372910=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '1102372911=        INTO :ZAKAZ,'
      '1102372912=             :Z_NUM,'
      '1102372913=             :G_TOCHKA,'
      '1102372914=             :Z_DATE,'
      '1102372915=             :Z_TIME,'
      '1102372916=             :G_CLIENT,'
      '1102372917=             :OSNOVANIE,'
      '1102372918=             :NOTE,'
      '1102372919=             :CLIENT_NAME,'
      '1102372920=             :DETAILS_STR,'
      '1102372921=             :SUM_ZAKAZ,'
      '1102372922=             :IS_SPISANIE,'
      '1102372923=             :WAYBILL'
      '1102372924=      DO'
      '1102372925=        suspend;'
      '1102372926=  END'
      '1102372927='
      '1102372928=end'
      '1102372929=;'
      '1102372930='
      '1102372931='
      
        '1102372932=/****************************************************' +
        '**************************/'
      
        '1102372933=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102372934=/****************************************************' +
        '**************************/'
      '1102372935=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1102372936=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102372937=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102372938=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102372939=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102372940=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102372941=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102372942=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102372943=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102372944=RETURNS ('
      '1102372945=  ERR_CODE INTEGER,'
      '1102372946=  ERR_MSG VARCHAR(1024))'
      '1102372947=AS'
      '1102372948=/*'
      
        '1102372949='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1102372950='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1102372951='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1102372952=*/'
      
        '1102372953=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1102372954=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102372955=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1102372956=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1102372957=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1102372958=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1102372959=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1102372960=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1102372961=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1102372962=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102372963=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1102372964=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1102372965=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1102372966=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1102372967=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102372968=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102372969=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102372970=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102372971=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1102372972=BEGIN'
      '1102372973='
      '1102372974=  PNT_ = '#39'00'#39';'
      '1102372975=  CLRF = ascii_char( 10 );'
      '1102372976='
      '1102372977=  SELECT S.S_VALUE'
      '1102372978=    FROM SYSTEM_SETUP S'
      '1102372979=   WHERE S.SYSTEM_SETUP = 2'
      '1102372980=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1102372981='
      '1102372982=  PNT_ = '#39'01'#39';'
      '1102372983=  SELECT G.nds_value'
      '1102372984=    FROM G_FIRM_REKVIZIT G'
      '1102372985=   WHERE G.is_default = 1'
      '1102372986=    INTO :NDS_;'
      '1102372987='
      '1102372988=  PNT_ = '#39'02'#39';'
      
        '1102372989=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1102372990=        FROM IMPORT_TBL_TMP'
      
        '1102372991=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1102372992=  DO BEGIN'
      '1102372993=    SELECT G_PRODUCT,'
      '1102372994=           PRICE'
      '1102372995=      FROM ('
      '1102372996=            SELECT P.G_PRODUCT, P.price'
      '1102372997=              FROM G_PRODUCT P'
      
        '1102372998=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1102372999=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1102373000=            UNION'
      '1102373001=            SELECT LT.G_PRODUCT, P.PRICE'
      '1102373002=              FROM LT_BARCODE LT, g_product P'
      
        '1102373003=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1102373004=               AND LT.g_product = P.g_product'
      '1102373005=           )'
      '1102373006=      INTO :G_PRODUCT_,'
      '1102373007=           :PRICE_OUR_;'
      '1102373008='
      '1102373009=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1102373010=      ERR_CODE = -20500;'
      
        '1102373011=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1102373012=      Exit;'
      '1102373013=    END'
      '1102373014='
      '1102373015=    PNT_ = '#39'03'#39';'
      
        '1102373016=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1102373017=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1102373018=      RETURNING_VALUES :COST_PRICE_;'
      '1102373019='
      '1102373020=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1102373021=    IF (price_ IS NULL) THEN'
      '1102373022=      PRICE_ = PRICE_OUR_;'
      '1102373023='
      '1102373024=    PNT_ = '#39'04'#39';'
      
        '1102373025=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1102373026=                                              :AMOUNT' +
        '_,'
      
        '1102373027=                                              :PRICE_' +
        ','
      
        '1102373028=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1102373029=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1102373030=                                              :DISCOU' +
        'NT_,'
      
        '1102373031=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1102373032=                                              :NDS_,'
      
        '1102373033=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1102373034=                                              :COST_P' +
        'RICE_,'
      
        '1102373035=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1102373036=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1102373037=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1102373038=                                              0     -' +
        '-MODE_'
      
        '1102373039=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1102373040=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102373041=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102373042=      EXIT;'
      '1102373043=    END'
      '1102373044='
      '1102373045=    G_PRODUCT_ = NULL;'
      '1102373046=  END'
      '1102373047='
      '1102373048=  PNT_ = '#39'05'#39';'
      '1102373049=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1102373050=    SELECT SUM(T.summ)'
      '1102373051=      FROM ZAKAZ_DETAILS_TMP T'
      '1102373052=      INTO :SUMM_;'
      '1102373053=    SUMM_FACT_ = SUMM_;'
      '1102373054=  END'
      '1102373055='
      '1102373056=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1102373057=  if (G_PAYMENT_TYPE_ = 1) then'
      '1102373058=    SUMM_CASH_ = summ_fact_;'
      '1102373059=  ELSE'
      '1102373060=    SUMM_NONCASH_ = summ_fact_;'
      '1102373061='
      '1102373062=  PNT_ = '#39'06'#39';'
      '1102373063=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1102373064=    G_CLIENT_ = 10;'
      '1102373065='
      '1102373066=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102373067=                              :Z_DATE_,'
      '1102373068=                              :Z_TIME_,'
      '1102373069=                              :G_CLIENT_,'
      '1102373070=                              :G_PAYMENT_TYPE_,'
      '1102373071=                              '#39#39', --:OSNOVANIE_,'
      '1102373072=                              0,  -- IS_SPISANIE'
      
        '1102373073=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1102373074=                              :SUMM_,'
      '1102373075=                              :SUMM_FACT_,'
      '1102373076=                              :SUMM_CASH_,'
      '1102373077=                              :SUMM_NONCASH_,'
      
        '1102373078=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1102373079=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1102373080=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1102373081=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1102373082=                              0,    -- :BY_RECIPE__,'
      '1102373083=                              0,    -- IS_RESERVE__'
      '1102373084=                              NULL -- :PAYMENTS__'
      '1102373085=                              )'
      
        '1102373086=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102373087=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102373088=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102373089=    EXIT;'
      '1102373090=  END'
      '1102373091='
      '1102373092=  DELETE FROM import_tbl_tmp;'
      '1102373093='
      '1102373094=WHEN ANY DO BEGIN'
      '1102373095=    ERR_CODE = gdscode;'
      
        '1102373096=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1102373097=  END'
      '1102373098=end'
      '1102373099=;'
      '1102373100='
      '1102373101=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '1102373102=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1102373103=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1102373104=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102373105=  DATE_BEGIN_ DATE,'
      '1102373106=  DATE_END_ DATE,'
      '1102373107=  TIME_BEGIN_ TIME,'
      '1102373108=  TIME_END_ TIME,'
      '1102373109=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102373110=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102373111=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1102373112=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '1102373113=RETURNS ('
      '1102373114=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102373115=  AMOUNT_VES TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      '1102373116=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1102373117=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1102373118=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1102373119=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1102373120=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102373121=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1102373122=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102373123=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102373124=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102373125=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102373126=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102373127=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102373128=  Z_DATE BLOB SUB_TYPE 1,'
      '1102373129=  ROW INTEGER,'
      '1102373130=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102373131=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102373132=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102373133=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102373134=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102373135=  ERR_CODE INTEGER,'
      '1102373136=  ERR_MSG VARCHAR(1024))'
      '1102373137=AS'
      
        '1102373138=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST'#39';'
      '1102373139=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102373140=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1102373141=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '1102373142=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1102373143=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BA' +
        'RCODE;'
      
        '1102373144=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PR' +
        'ODUCT.BARCODE;'
      
        '1102373145=DECLARE VARIABLE BRAND_ TYPE OF COLUMN G_PRODUCT.BRAN' +
        'D;'
      
        '1102373146=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102373147=DECLARE VARIABLE AMOUNT_VES_ TYPE OF COLUMN G_PRODUCT' +
        '.VES_GRAMM;'
      
        '1102373148=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102373149=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.NAME;'
      
        '1102373150=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '1102373151=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1102373152=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM = 0;'
      
        '1102373153=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1102373154=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1102373155=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1102373156=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_SUMM = 0;'
      
        '1102373157=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1102373158=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1102373159=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1102373160=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1102373161=DECLARE VARIABLE I INTEGER = 1;'
      '1102373162=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      
        '1102373163=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAM' +
        'E;'
      
        '1102373164=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102373165=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102373166=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FIO_DOC;'
      '1102373167=BEGIN'
      '1102373168=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1102373169=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1102373170='
      
        '1102373171=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') |' +
        '| '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extr' +
        'act(year from Z.Z_DATE),'
      '1102373172=             Z.Z_TIME,'
      '1102373173=             GP.ARTICUL,'
      '1102373174=             GP.BARCODE,'
      '1102373175=             GP.NOMENCLATUR_NUM,'
      '1102373176=             GP.BRAND,'
      '1102373177=             GP.NAME,'
      '1102373178=             ZD.AMOUNT,'
      '1102373179=             ZD.AMOUNT * COALESCE(GP.VES_GRAMM, 0),'
      '1102373180=             ZD.PRICE,'
      '1102373181=             ZD.DISCOUNT_TENGE,'
      '1102373182=             ZD.SUMM,'
      '1102373183=             ZD.DISCOUNT_SUMM,'
      '1102373184=             GC.NAME,'
      
        '1102373185=             (CASE WHEN (Z.SUMM_CASH > 0 AND Z.SUMM_N' +
        'ONCASH > 0) THEN '#39#1057#1084#1077#1096#1072#1085#1085#1099#1081#39
      
        '1102373186=                   WHEN Z.SUMM_CASH > 0 THEN '#39#1053#1072#1083#1080#1095#1085#1099 +
        #1081#39
      '1102373187=                   ELSE '#39#1041#1077#1079#1085#1072#1083#1080#1095#1085#1099#1081#39' END),'
      '1102373188=             TR.PATH,'
      '1102373189=             Z.NOTE,'
      '1102373190=             U.SHORT_NAME,'
      '1102373191=             Z.SUMM_CASH,'
      '1102373192=             Z.SUMM_NONCASH,'
      
        '1102373193=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, ' +
        #39#39')'
      
        '1102373194=      FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.' +
        'G_OFFICIAL = O.G_OFFICIAL,'
      '1102373195=           ZAKAZ_DETAILS ZD,'
      '1102373196=           G_CLIENT GC,'
      '1102373197=           G_PAYMENT_TYPE P,'
      '1102373198=           G_PRODUCT GP,'
      '1102373199=           G_UNIT U,'
      '1102373200=           P_REP_TREE TR'
      
        '1102373201=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102373202=       AND Z.IS_SPISANIE IN (0,2)'
      '1102373203=       AND Z.IS_RESERVE = 0'
      '1102373204=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102373205=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1102373206=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1102373207=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102373208=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102373209=       AND GP.G_UNIT = U.G_UNIT'
      '1102373210=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102373211=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1102373212=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1102373213=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1102373214=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1102373215=            OR'
      
        '1102373216=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1102373217=           )/*'
      
        '1102373218=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_' +
        'END_ AND :TIME_BEGIN_ IS NOT NULL)'
      '1102373219=            OR'
      '1102373220=            :TIME_BEGIN_ IS NULL)*/'
      
        '1102373221=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102373222=             OR'
      '1102373223=             (:G_CATEGORY_ IS NULL)'
      '1102373224=           )'
      
        '1102373225=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102373226=             OR'
      '1102373227=            (:G_PRODUCT_ IS NULL)'
      '1102373228=           )'
      '1102373229=       AND ((EXISTS (SELECT 1'
      '1102373230=                       FROM SKLAD S'
      '1102373231=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1102373232=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1102373233=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102373234=              OR'
      '1102373235=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102373236='
      '1102373237=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '1102373238=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :' +
        'NOMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :AMOUNT_VES_,' +
        ' :PRICE_,'
      
        '1102373239=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, ' +
        ':CLIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_,'
      
        '1102373240=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME' +
        '_'
      '1102373241=  DO BEGIN'
      '1102373242=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1102373243=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102373244=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102373245=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, ' +
        '"DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '1102373246=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL' +
        '_, :DISCOUNT_SUMM_ROLL_, 1);'
      '1102373247='
      '1102373248=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1102373249=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1102373250=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ +' +
        ' DISCOUNT_SUMM_ROLL_;'
      '1102373251=            SUMM_ROLL_ = 0;'
      '1102373252=            DISCOUNT_SUMM_ROLL_ = 0;'
      '1102373253=            I = I + 1;'
      '1102373254=        END'
      '1102373255='
      '1102373256=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102373257=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DAT' +
        'E", ROW)'
      '1102373258=        VALUES (:I, :PATH_, 1);'
      '1102373259=        I = I + 1;'
      '1102373260=    END'
      '1102373261='
      
        '1102373262=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", ' +
        '"TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, BRAND, NAME, AMOUNT, ' +
        'AMOUNT_VES, PRICE, DISCOUNT, SUMM,'
      
        '1102373263=                                         DISCOUNT_SUM' +
        'M, CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME,'
      
        '1102373264=                                         SUMM_CASH, S' +
        'UMM_NONCASH, OFFICIAL_NAME)'
      
        '1102373265=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCO' +
        'DE_, :NOMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :AMOUNT' +
        '_VES_, :PRICE_, :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '1102373266=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0,' +
        ' :UNIT_NAME_,'
      
        '1102373267=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NA' +
        'ME_);'
      '1102373268='
      '1102373269=    I = I + 1;'
      '1102373270=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '1102373271=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCO' +
        'UNT_SUMM_;'
      '1102373272=    LAST_PATH_ = PATH_;'
      '1102373273=  END'
      '1102373274='
      '1102373275=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102373276=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1102373277=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOU' +
        'NT_SUMM_ROLL_, 1);'
      '1102373278='
      '1102373279=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1102373280=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1102373281=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_' +
        'SUMM_ROLL_;'
      '1102373282='
      
        '1102373283=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1102373284=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1102373285='
      
        '1102373286=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENC' +
        'LATUR_NUM, BRAND, NAME, AMOUNT, AMOUNT_VES, PRICE, DISCOUNT, SUM' +
        'M, DISCOUNT_SUMM, CLIENT_NAME,'
      
        '1102373287=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME, SUMM' +
        '_CASH, SUMM_NONCASH, OFFICIAL_NAME'
      '1102373288=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1102373289=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOM' +
        'ENCLATUR_NUM, :BRAND, :TOVAR_NAME,'
      
        '1102373290=           :AMOUNT, :AMOUNT_VES, :PRICE, :DISCOUNT_TE' +
        'NGE, :SUMM, :DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      
        '1102373291=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCA' +
        'SH, :OFFICIAL_NAME'
      '1102373292=  do suspend;'
      '1102373293='
      '1102373294=WHEN ANY DO BEGIN'
      '1102373295=    Err_code = -20500;'
      
        '1102373296=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1102373297=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102373298=  END'
      '1102373299=end'
      '1102373300=;'
      '1102373301='
      '1102373302=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1102373303=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102373304=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102373305=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102373306=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102373307=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102373308=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102373309=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102373310=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102373311=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102373312=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102373313=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102373314=RETURNS ('
      '1102373315=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102373316=  ERR_CODE INTEGER,'
      '1102373317=  ERR_MSG VARCHAR(1024))'
      '1102373318=AS'
      
        '1102373319=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1102373320=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1102373321=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102373322=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1102373323='
      
        '1102373324=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102373325=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1102373326=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1102373327=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102373328=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102373329=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102373330=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1102373331=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1102373332=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1102373333=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1102373334=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102373335=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1102373336=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1102373337=BEGIN'
      '1102373338='
      '1102373339=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102373340=    SELECT ID'
      '1102373341=      FROM CUR_PARAMS'
      '1102373342=     WHERE CUR_PARAMS = 2'
      '1102373343=      INTO :G_TOCHKA_;'
      '1102373344='
      
        '1102373345=  --*************************************************' +
        '*************************************************'
      
        '1102373346=  --*************************************************' +
        '*************************************************'
      '1102373347=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102373348=  --*************************************************' +
        '*************************************************'
      
        '1102373349=  --*************************************************' +
        '*************************************************'
      '1102373350=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1102373351=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1102373352=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1102373353=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102373354=            INTO :AMOUNT_,'
      '1102373355=                 :G_PRODUCT_'
      '1102373356=      DO BEGIN'
      '1102373357=          UPDATE LT_SKLAD_PRODUCT L'
      
        '1102373358=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_      ' +
        '-- 03.03.2021 '#1057#1070#1044#1040' '#1053#1045' '#1057#1058#1040#1051' '#1057#1058#1040#1042#1048#1058#1068' NEED_TO_REPLACE '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1047#1040 +
        #1063#1045#1052
      '1102373359=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102373360=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102373361=      END'
      '1102373362='
      '1102373363=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1102373364=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1102373365=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1102373366=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1102373367=             NDS_SUMM, COST_PRICE'
      '1102373368=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102373369='
      '1102373370=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102373371=                                  :Z_DATE_,'
      '1102373372=                                  :Z_TIME_,'
      '1102373373=                                  :G_CLIENT_,'
      '1102373374=                                  :G_PAYMENT_TYPE_,'
      '1102373375=                                  :OSNOVANIE_,'
      
        '1102373376=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1102373377=                                  :NOTE_,'
      
        '1102373378=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1102373379=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1102373380=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1102373381=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1102373382=                                  0, --SUMM_BONUS_'
      
        '1102373383=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1102373384=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102373385=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1102373386=                                  0,    --BY_RECIPE'
      '1102373387=                                  0     --IS_RESERVE'
      '1102373388=                                  ,NULL  -- PAYMENTS_'
      '1102373389=                                  ,0     --IS_MEBEL_'
      
        '1102373390=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1102373391=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1102373392=                                  ,NULL  --ADDRESS_'
      '1102373393=                                  ,NULL  --PRICE_'
      
        '1102373394=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      '1102373395=                                  )'
      '1102373396=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102373397='
      '1102373398=      if (ERR_CODE <> 0) then BEGIN'
      '1102373399=        ERR_CODE = -20500;'
      '1102373400=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102373401=        Exit;'
      '1102373402=      END'
      '1102373403='
      
        '1102373404=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102373405=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1102373406=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1102373407=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1102373408=      UPDATE ZAKAZ'
      '1102373409=         SET IS_SPISANIE = 2'
      '1102373410=       WHERE ZAKAZ = :ZAKAZ_;'
      '1102373411='
      
        '1102373412=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102373413=      FOR SELECT T.AMOUNT,'
      '1102373414=                 T.SUMM,'
      '1102373415=                 T.G_PRODUCT,'
      '1102373416=                 T.ZAKAZ_NA_REAL,'
      '1102373417=                 T.ZAKAZ_DETAILS'
      '1102373418=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102373419=            INTO :AMOUNT_,'
      '1102373420=                 :Z_SUMM_,'
      '1102373421=                 :G_PRODUCT_,'
      '1102373422=                 :ZAKAZ_NA_REAL_,'
      '1102373423=                 :ZAKAZ_DETAILS_'
      '1102373424=      DO BEGIN'
      '1102373425=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102373426=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1102373427=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1102373428=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102373429=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102373430='
      
        '1102373431=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102373432=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1102373433=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1102373434=      END'
      '1102373435=  END'
      '1102373436=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102373437=  --*************************************************' +
        '*************************************************'
      
        '1102373438=  --*************************************************' +
        '*************************************************'
      '1102373439='
      
        '1102373440=  --*************************************************' +
        '*************************************************'
      
        '1102373441=  --*************************************************' +
        '*************************************************'
      '1102373442=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102373443=  --*************************************************' +
        '*************************************************'
      
        '1102373444=  --*************************************************' +
        '*************************************************'
      '1102373445=  ELSE BEGIN'
      '1102373446=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1102373447=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102373448=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102373449=      FOR SELECT T.AMOUNT,'
      '1102373450=                 T.SUMM,'
      '1102373451=                 T.G_PRODUCT,'
      '1102373452=                 T.ZAKAZ_NA_REAL,'
      '1102373453=                 T.ZAKAZ_DETAILS'
      '1102373454=                 ,T.PRICE'
      '1102373455=                 ,T.NDS'
      '1102373456=                 ,T.NDS_SUMM'
      '1102373457=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102373458=            INTO :AMOUNT_,'
      '1102373459=                 :Z_SUMM_,'
      '1102373460=                 :G_PRODUCT_,'
      '1102373461=                 :ZAKAZ_NA_REAL_,'
      '1102373462=                 :ZAKAZ_DETAILS_'
      '1102373463=                 ,:PRICE_'
      '1102373464=                 ,:NDS_'
      '1102373465=                 ,:NDS_SUMM_'
      '1102373466=      DO BEGIN'
      
        '1102373467=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102373468=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1102373469='
      
        '1102373470=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1102373471=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1102373472='
      '1102373473=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102373474=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1102373475=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1102373476=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102373477=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102373478=      END'
      '1102373479='
      '1102373480=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102373481=                                  :Z_DATE_,'
      '1102373482=                                  :Z_TIME_,'
      '1102373483=                                  :G_CLIENT_,'
      '1102373484=                                  :G_PAYMENT_TYPE_,'
      '1102373485=                                  :OSNOVANIE_,'
      '1102373486=                                  :NOTE_,'
      
        '1102373487=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1102373488=                                  :SUMM_,'
      '1102373489=                                  :SUMM_FACT_,'
      
        '1102373490=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1102373491=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1102373492=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1102373493=                                  ,0        --SUMM_CU' +
        'RRENCY_'
      
        '1102373494=                                  ,0        --IS_EXPE' +
        'CTED_'
      
        '1102373495=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      
        '1102373496=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102373497='
      '1102373498=      if (ERR_CODE <> 0) then BEGIN'
      '1102373499=        ERR_CODE = -20500;'
      '1102373500=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102373501=        Exit;'
      '1102373502=      END'
      '1102373503=  END'
      '1102373504=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102373505=  --*************************************************' +
        '*************************************************'
      
        '1102373506=  --*************************************************' +
        '*************************************************'
      '1102373507='
      '1102373508=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102373509=END'
      '1102373510=;'
      '1102373511='
      '1102373512=ALTER PROCEDURE R_MADE_REVISION('
      
        '1102373513=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102373514=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102373515=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102373516=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102373517=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102373518=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '1102373519=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102373520=RETURNS ('
      '1102373521=  COUNT_SPIS_ INTEGER,'
      '1102373522=  COUNT_PRIH_ INTEGER,'
      
        '1102373523=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT' +
        '.REVISION_PARENT,'
      '1102373524=  ERR_CODE INTEGER,'
      '1102373525=  ERR_MSG VARCHAR(1024))'
      '1102373526=AS'
      
        '1102373527=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVIS' +
        'ION'#39';'
      '1102373528=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102373529=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102373530=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102373531=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102373532=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102373533=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102373534=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102373535=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102373536=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102373537=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      
        '1102373538=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REV' +
        'ISION.DATETIME_CREATED;'
      
        '1102373539=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.AMOUNT;'
      '1102373540=BEGIN'
      '1102373541='
      '1102373542=  COUNT_SPIS_ = 0;'
      '1102373543=  COUNT_PRIH_ = 0;'
      '1102373544='
      '1102373545=  PNT_ = '#39'00'#39';'
      '1102373546=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '1102373547=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGI' +
        'N_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '1102373548=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102373549='
      '1102373550=     IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102373551=       ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '1102373552=       EXIT;'
      '1102373553=     END'
      '1102373554=  END'
      '1102373555='
      '1102373556=  PNT_ = '#39'01'#39';'
      
        '1102373557=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL, DATETIME_CREATED'
      '1102373558=      FROM REVISION_TMP'
      '1102373559=      --WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102373560=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_, :DATETIME_CREATED_'
      '1102373561=  DO BEGIN'
      '1102373562=    /*SELECT SUM(ZD.AMOUNT)'
      '1102373563=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102373564=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ A' +
        'S DATE) AND CURRENT_DATE'
      
        '1102373565=       AND Z.Z_TIME >= CAST(:DATETIME_CREATED_ AS TIM' +
        'E)'
      '1102373566=       AND Z.Z_TIME <= CURRENT_TIME'
      '1102373567=       AND Z.IS_SPISANIE IN (0, 1)'
      '1102373568=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102373569=      INTO :AMOUNT_SALED_;*/'
      '1102373570='
      '1102373571=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '1102373572=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102373573=        RETURNING_VALUES :COST_PRICE_;'
      '1102373574='
      
        '1102373575=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102373576=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102373577=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/, :COST_PRICE_' +
        ', :COST_PRICE_ * (:AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_' +
        '*/), 0, 0, 0, 0, 0);'
      '1102373578='
      '1102373579=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102373580=    END'
      '1102373581='
      '1102373582=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      '1102373583=      SELECT S.price'
      '1102373584=        FROM SKLAD S'
      '1102373585=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102373586=         AND S.g_product = :G_PRODUCT_'
      '1102373587=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102373588=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102373589=                                 FROM SKLAD DD'
      
        '1102373590=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102373591=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102373592=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102373593=                                )'
      '1102373594=        ORDER BY s.sklad DESC'
      '1102373595=        ROWS 1 TO 1'
      '1102373596=        INTO :PRICE_LAST_;'
      '1102373597='
      
        '1102373598=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102373599='
      
        '1102373600=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102373601=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/, :PRICE_LAST_' +
        ', (:AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/) * :PRICE_LA' +
        'ST_, 0, 0);'
      '1102373602='
      '1102373603=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102373604=    END'
      '1102373605=  END'
      '1102373606='
      '1102373607=  PNT_ = '#39'01A'#39';'
      '1102373608=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102373609=    SELECT SUM(S.SUMM)'
      '1102373610=      FROM ZAKAZ_DETAILS_TMP S'
      '1102373611=      INTO :SUMM_;'
      '1102373612='
      '1102373613=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102373614=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102373615=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102373616=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102373617=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102373618=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102373619=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102373620=                                NULL,           --:NO' +
        'TE_,'
      
        '1102373621=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102373622=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102373623=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102373624=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102373625=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102373626=                                NULL,'
      
        '1102373627=                                0,        -- BY_RECIP' +
        'E'
      
        '1102373628=                                0         -- IS_RESER' +
        'VE'
      '1102373629=                                ,NULL  -- PAYMENTS_'
      '1102373630=                                ,0     -- SUMM_CASH'
      
        '1102373631=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102373632=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102373633=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102373634=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102373635=      EXIT;'
      '1102373636=    END'
      '1102373637=  END'
      '1102373638='
      '1102373639=  PNT_ = '#39'02'#39';'
      '1102373640=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102373641=    SELECT SUM(S.SUMM)'
      '1102373642=      FROM SKLAD_TMP S'
      '1102373643=      INTO :SUMM_;'
      '1102373644='
      '1102373645=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102373646=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102373647=                                CURRENT_TIME,'
      
        '1102373648=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102373649=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102373650=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102373651=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102373652=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102373653=                                :SUMM_,'
      '1102373654=                                :SUMM_,'
      
        '1102373655=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102373656=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102373657=                                ,NULL  --PAYMENTS'
      '1102373658=                                )'
      
        '1102373659=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102373660=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102373661=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102373662=      EXIT;'
      '1102373663=    END'
      '1102373664=  END'
      '1102373665='
      '1102373666=  UPDATE REVISION_PARENT RP'
      '1102373667=     SET RP.IS_MADE = 1,'
      '1102373668=         RP.DATE_END = :DATE_END_,'
      '1102373669=         RP.TIME_END = :TIME_END_'
      '1102373670=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '1102373671='
      '1102373672=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '1102373673=END'
      '1102373674=;'
      '1102373675='
      '1102373676=ALTER PROCEDURE R_UNIFICATION('
      '1102373677=  MODE_ INTEGER)'
      '1102373678=RETURNS ('
      '1102373679=  COUNT_SPIS_ INTEGER,'
      '1102373680=  COUNT_PRIH_ INTEGER,'
      '1102373681=  ERR_CODE INTEGER,'
      '1102373682=  ERR_MSG VARCHAR(1024))'
      '1102373683=AS'
      
        '1102373684=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1102373685=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102373686=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102373687=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102373688=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102373689=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102373690=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102373691=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102373692=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102373693=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102373694=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102373695=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102373696=BEGIN'
      '1102373697='
      '1102373698=  COUNT_SPIS_ = 0;'
      '1102373699=  COUNT_PRIH_ = 0;'
      '1102373700='
      '1102373701=  SELECT ID'
      '1102373702=    FROM CUR_PARAMS'
      '1102373703=   WHERE CUR_PARAMS = 2'
      '1102373704=    INTO :G_TOCHKA_;'
      '1102373705='
      
        '1102373706=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1102373707=      FROM REVISION'
      '1102373708=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1102373709=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1102373710=  DO BEGIN'
      
        '1102373711=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1102373712=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102373713=        RETURNING_VALUES :COST_PRICE_;'
      '1102373714='
      
        '1102373715=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102373716=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102373717=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1102373718='
      '1102373719=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102373720=    END'
      '1102373721='
      
        '1102373722=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1102373723=      SELECT S.price'
      '1102373724=        FROM SKLAD S'
      '1102373725=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102373726=         AND S.g_product = :G_PRODUCT_'
      '1102373727=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102373728=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102373729=                                 FROM SKLAD DD'
      
        '1102373730=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102373731=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102373732=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102373733=                                )'
      '1102373734=        ORDER BY s.sklad DESC'
      '1102373735=        ROWS 1 TO 1'
      '1102373736=        INTO :PRICE_LAST_;'
      '1102373737='
      '1102373738=    /* SELECT S.PRICE'
      '1102373739=        FROM SKLAD S'
      '1102373740=       WHERE S.IS_LAST = 1'
      '1102373741=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1102373742=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1102373743=        INTO :PRICE_LAST_; */'
      '1102373744='
      
        '1102373745=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102373746='
      
        '1102373747=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102373748=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1102373749='
      '1102373750=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102373751=    END'
      '1102373752='
      '1102373753=    UPDATE REVISION R'
      '1102373754=       SET R.IS_UNIFIED = 1'
      '1102373755=     WHERE R.REVISION = :REVISION_;'
      '1102373756=  END'
      '1102373757='
      '1102373758=  PNT_ = '#39'01'#39';'
      '1102373759=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102373760=    SELECT SUM(S.SUMM)'
      '1102373761=      FROM ZAKAZ_DETAILS_TMP S'
      '1102373762=      INTO :SUMM_;'
      '1102373763='
      '1102373764=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102373765=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102373766=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102373767=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102373768=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102373769=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102373770=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102373771=                                NULL,           --:NO' +
        'TE_,'
      
        '1102373772=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102373773=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102373774=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102373775=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102373776=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102373777=                                NULL,'
      
        '1102373778=                                0,        -- BY_RECIP' +
        'E'
      
        '1102373779=                                0         -- IS_RESER' +
        'VE'
      '1102373780=                                ,NULL  -- PAYMENTS_'
      '1102373781=                                ,0     -- SUMM_CASH'
      
        '1102373782=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102373783=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102373784=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102373785=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102373786=      EXIT;'
      '1102373787=    END'
      '1102373788=  END'
      '1102373789='
      '1102373790=  PNT_ = '#39'02'#39';'
      '1102373791=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102373792=    SELECT SUM(S.SUMM)'
      '1102373793=      FROM SKLAD_TMP S'
      '1102373794=      INTO :SUMM_;'
      '1102373795='
      '1102373796=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102373797=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102373798=                                CURRENT_TIME,'
      
        '1102373799=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102373800=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102373801=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102373802=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102373803=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102373804=                                :SUMM_,'
      '1102373805=                                :SUMM_,'
      
        '1102373806=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102373807=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102373808=                                ,NULL  --PAYMENTS'
      '1102373809=                                )'
      
        '1102373810=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102373811=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102373812=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102373813=      EXIT;'
      '1102373814=    END'
      '1102373815=  END'
      '1102373816=END'
      '1102373817=;'
      '1102373818='
      '1102373819=ALTER PROCEDURE UPSERT_ZAKAZ_EXT_LOAD('
      '1102373820=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102373821=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102373822=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102373823=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102373824=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102373825=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102373826=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102373827=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102373828=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102373829=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102373830=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102373831=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102373832=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102373833=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102373834=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102373835=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102373836=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102373837=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102373838=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102373839=  IS_MEBEL_ INTEGER = 0,'
      
        '1102373840=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1102373841=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      
        '1102373842=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      '1102373843=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1102373844=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102373845=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102373846=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102373847=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102373848=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102373849=  REC_ID_ TYPE OF COLUMN ZAKAZ.REC_ID = NULL)'
      '1102373850=RETURNS ('
      '1102373851=  ERR_CODE INTEGER,'
      '1102373852=  ERR_MSG VARCHAR(1024))'
      '1102373853=AS'
      '1102373854=/*'
      
        '1102373855=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1055#1056#1048#1061#1054#1044#1040' '#1048#1047' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071' ' +
        '- '#1052#1054#1041#1048#1051#1050#1048' '#1048#1051#1048' '#1057#1040#1049#1058#1040
      
        '1102373856=-- '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1058#1040#1050#1054#1049' ID - '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1054' '#1054#1041#1053 +
        #1054#1042#1051#1071#1070', '#1053#1045#1058' - '#1058#1040#1050' '#1042#1057#1058#1040#1042#1051#1071#1070
      '1102373857=*/'
      
        '1102373858=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'UPSERT_ZAKAZ' +
        '_EXT_LOAD'#39';'
      '1102373859=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102373860=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        'NULL;'
      '1102373861=BEGIN'
      '1102373862='
      '1102373863=  PNT_ = '#39'00'#39';'
      '1102373864='
      '1102373865=  SELECT SP.ZAKAZ'
      '1102373866=    FROM ZAKAZ SP'
      '1102373867=   WHERE SP.REC_ID = :REC_ID_'
      '1102373868=    INTO :ZAKAZ_;'
      '1102373869='
      '1102373870=  IF (ZAKAZ_ IS NULL) THEN BEGIN'
      '1102373871='
      '1102373872=    PNT_ = '#39'01'#39';'
      
        '1102373873=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_, :Z_DATE_,' +
        ' :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :IS_SPISAN' +
        'IE_,'
      
        '1102373874=        :NOTE_, :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SU' +
        'MM_NONCASH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_P' +
        'RIHOD_,'
      
        '1102373875=        :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_, :IS_ME' +
        'BEL_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_,'
      
        '1102373876=        :UPLOAD_TO_EXT_APP_, :G_OFFICIAL_, :NOT_MINUS' +
        '_OSTATOK_, :USER_ID_, :LOG_BODY_, :REC_ID_)'
      
        '1102373877=        RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102373878='
      '1102373879=  END'
      '1102373880=  ELSE BEGIN'
      '1102373881='
      '1102373882=    PNT_ = '#39'02'#39';'
      
        '1102373883=    EXECUTE PROCEDURE UPDATE_ZAKAZ_DETAIL(:ZAKAZ_, :Z' +
        '_DATE_, :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NO' +
        'TE_,'
      
        '1102373884=        :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SUMM_NONCA' +
        'SH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_PRIHOD_,'
      
        '1102373885=        :IS_SPISANIE_, :BY_RECIPE_, :IS_RESERVE_, :PA' +
        'YMENTS_, :UPLOAD_TO_EXT_APP_, :NOT_MINUS_OSTATOK_, :ADDRESS_,'
      '1102373886=        :USER_ID_, :LOG_BODY_)'
      '1102373887=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102373888='
      '1102373889=  END'
      '1102373890='
      '1102373891=  IF (:ERR_CODE <> 0) THEN'
      
        '1102373892=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102373893='
      '1102373894=END'
      '1102373895=;'
      
        '1102373896=UPDATE SYSTEM_SETUP SET S_VALUE = 110237 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102373897=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102373898=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102380='
      '1102381=ALTER PROCEDURE CLEAR_BASE('
      '1102382=  MODE_ INTEGER = 0)'
      '1102383=AS'
      '1102384=/*'
      '1102385=mode_'
      '1102386=0 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077
      '1102387=1 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1087#1088#1086#1076#1072#1078#1080' '#1080' '#1087#1088#1080#1093#1086#1076#1099
      '1102388=2 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077', '#1082#1088#1086#1084#1077' '#1090#1086#1074#1072#1088#1086#1074
      '1102389=*/'
      '11023810=BEGIN'
      '11023811=  delete from LT_ZAKAZ_REAL;'
      '11023812=  delete from REVISION;'
      '11023813='
      '11023814=  delete from kassa;'
      '11023815=  delete from kassa_state;'
      '11023816='
      '11023817=  delete from kassa_beznal;'
      '11023818=  delete from kassa_beznal_state;'
      '11023819='
      '11023820=  delete from waybill;'
      '11023821=  delete from invoice;'
      '11023822=  delete from INVOICE_PAY;'
      '11023823=  delete from docs;'
      '11023824=  delete from other_details;'
      '11023825=  delete from other;'
      '11023826='
      '11023827=  delete from sklad'
      '11023828=   where exists (select 1'
      '11023829=                  from sklad_parent sp'
      '11023830=                 where sp.IS_VOZVRAT = 1'
      '11023831=                   and sp.ZAKAZ is not NULL'
      '11023832=                   and sp.SKLAD = sklad_parent);'
      '11023833=  delete from sklad_parent'
      '11023834=   where IS_VOZVRAT = 1'
      '11023835=     and ZAKAZ is not NULL;'
      '11023836='
      '11023837=  delete from zakaz_details;'
      '11023838=  delete from zakaz;'
      '11023839='
      '11023840=  delete from zakaz_na_real;'
      '11023841=  delete from ZAKAZ_real_parent;'
      '11023842='
      '11023843=  delete from sklad;'
      '11023844=  delete from sklad_parent;'
      '11023845='
      '11023846=  update lt_sklad_product l'
      '11023847=     set l.AMOUNT = 0,'
      '11023848=         l.AMOUNT_RESERVE = 0;'
      '11023849='
      '11023850=  IF (MODE_ IN (0, 2)) THEN BEGIN'
      '11023851=    delete from g_address;'
      '11023852=    delete from g_account;'
      '11023853=    delete from G_DISCONT_CARD;'
      '11023854=    delete from DELIVERY;'
      '11023855='
      
        '11023856=    --'#1076#1077#1083#1072#1102' '#1089#1085#1072#1095#1072#1083#1072' '#1072#1087#1076#1077#1081#1090' '#1087#1072#1088#1077#1085#1090#1086#1074', '#1095#1090#1086#1073#1099' '#1091#1076#1072#1083#1077#1085#1080#1077' '#1087#1088#1086 +
        #1096#1083#1086' '#1075#1083#1072#1076#1082#1086
      
        '11023857=    update g_client c set c.G_CLIENT_PARENT = null wher' +
        'e c.G_CLIENT <> 10;'
      
        '11023858=    delete from g_client c where c.G_CLIENT not in (9,1' +
        '0);'
      '11023859=    delete from g_discount;'
      
        '11023860=    delete from g_prihod_rashod where g_prihod_rashod n' +
        'ot in (-5,-1,0,1,2,3);'
      '11023861=    delete from g_firm_address;'
      '11023862=    delete from g_firm_account;'
      '11023863=    delete from g_firm_rekvizit;'
      '11023864=    delete from G_OFFICIAL_RIGHT;'
      '11023865=    delete from g_official;'
      '11023866='
      '11023867=    IF (mode_ = 0) THEN begin'
      '11023868=      delete from G_PRODUCT_IMAGE;'
      '11023869=      delete from G_PRODUCT_KIT;'
      '11023870=      delete from LT_BARCODE;'
      '11023871=      delete from LT_SKLAD_PRODUCT;'
      '11023872=      delete from G_PRODUCT g where g.IS_CATEGORY = 0;'
      '11023873=      update g_product g set g.g_product_par = null;'
      
        '11023874=      delete from G_PRODUCT g where g.IS_CATEGORY = 1 a' +
        'nd g.G_PRODUCT <> -1;'
      '11023875=      delete from g_unit where g_unit <> 1;'
      '11023876=    end'
      '11023877='
      '11023878=  END'
      '11023879=END'
      '11023880=;'
      '11023881='
      '11023882=ALTER PROCEDURE READ_SKLAD_PARENT_LIST('
      '11023883=  DATE_BEGIN_ DATE,'
      '11023884=  DATE_END_ DATE,'
      '11023885=  IS_VOZVRAT_ INTEGER)'
      '11023886=RETURNS ('
      '11023887=  SKLAD TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      
        '11023888=  DATE_RECEIPT TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT' +
        ','
      
        '11023889=  TIME_RECEIPT TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIPT' +
        ','
      '11023890=  G_CLIENT TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      '11023891=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '11023892=  G_PAYMENT_TYPE TYPE OF COLUMN SKLAD_PARENT.G_PAYMENT_' +
        'TYPE,'
      '11023893=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '11023894=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '11023895=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '11023896=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11023897=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      '11023898=  SUMM_SALE TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11023899=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_ALL' +
        ','
      '110238100=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '110238101=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110238102=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      
        '110238103=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE,'
      
        '110238104=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PAY' +
        '_TYPE.NAME)'
      '110238105=AS'
      '110238106=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110238107=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110238108=BEGIN'
      '110238109='
      '110238110=  SELECT ID'
      '110238111=    FROM CUR_PARAMS'
      '110238112=   WHERE CUR_PARAMS = 2'
      '110238113=    INTO :G_TOCHKA_;'
      '110238114='
      '110238115=  SELECT COUNT(*)'
      '110238116=    FROM SKLAD_PARENT T'
      
        '110238117=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110238118=     AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :IS_V' +
        'OZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '110238119=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ ' +
        '= 1))'
      '110238120=     AND T.G_TOCHKA = :G_TOCHKA_'
      '110238121=    INTO CNT_;'
      '110238122='
      '110238123=  if (CNT_ = 0) then'
      '110238124=    SELECT MAX(T.DATE_RECEIPT)'
      '110238125=      FROM SKLAD_PARENT T'
      '110238126=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110238127=       AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :IS' +
        '_VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '110238128=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ ' +
        '= 1))'
      '110238129=       AND T.G_TOCHKA = :G_TOCHKA_'
      '110238130=      INTO :DATE_BEGIN_;'
      '110238131='
      '110238132=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '110238133=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '110238134=      FOR'
      '110238135=        SELECT T.SKLAD,'
      '110238136=               T.DATE_RECEIPT,'
      '110238137=               T.TIME_RECEIPT,'
      '110238138=               T.G_CLIENT,'
      '110238139=               GC.NAME,'
      '110238140=               T.G_PAYMENT_TYPE,'
      '110238141=               PT.NAME,'
      '110238142=               T.OSNOVANIE,'
      '110238143=               T.NOTE,'
      '110238144=               T.SUMM,'
      '110238145=               T.SUMM_FACT,'
      
        '110238146=               (SELECT SUM(S.AMOUNT * G.PRICE) FROM SK' +
        'LAD S, G_PRODUCT G'
      
        '110238147=                 WHERE S.SKLAD_PARENT = T.SKLAD AND S.' +
        'G_PRODUCT = G.G_PRODUCT),'
      '110238148=               T.IS_PAYED_ALL,'
      '110238149=               T.IS_VOZVRAT,'
      '110238150=               T.g_official,'
      '110238151=               COALESCE(GO.fio_doc, GO.FM||'#39' '#39'||GO.nm)'
      '110238152=               ,GN.G_NONCASH_PAY_TYPE'
      '110238153=               ,GN.NAME'
      '110238154=          FROM SKLAD_PARENT T'
      
        '110238155=                    LEFT OUTER JOIN G_CLIENT GC ON T.G' +
        '_CLIENT = GC.G_CLIENT'
      
        '110238156=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT ' +
        'ON T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '110238157=                    LEFT OUTER JOIN G_OFFICIAL GO ON T' +
        '.g_official = GO.G_OFFICIAL'
      
        '110238158=                    LEFT OUTER JOIN G_NONCASH_PAY_TYPE' +
        ' GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '110238159=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVRA' +
        'T_ = 0)'
      
        '110238160=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVR' +
        'AT_ = 1))'
      '110238161=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '110238162=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110238163=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '110238164=        INTO :SKLAD,'
      '110238165=             :DATE_RECEIPT,'
      '110238166=             :TIME_RECEIPT,'
      '110238167=             :G_CLIENT,'
      '110238168=             :CLIENT_NAME,'
      '110238169=             :G_PAYMENT_TYPE,'
      '110238170=             :PAYMENT_NAME,'
      '110238171=             :OSNOVANIE,'
      '110238172=             :NOTE,'
      '110238173=             :SUMM,'
      '110238174=             :SUMM_FACT,'
      '110238175=             :SUMM_SALE,'
      '110238176=             :IS_PAYED_ALL,'
      '110238177=             :IS_VOZVRAT,'
      '110238178=             :G_OFFICIAL,'
      '110238179=             :G_OFFICIAL_FIO'
      '110238180=             ,:G_NONCASH_PAY_TYPE'
      '110238181=             ,:G_NONCASH_PAY_TYPE_NAME'
      '110238182=      DO'
      '110238183=        suspend;'
      '110238184='
      
        '110238185=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1047#1044#1045#1057#1068' '#1044#1040#1053#1053#1067#1049' '#1057#1050#1051#1040#1044' '#1057#1058#1054#1048#1058' ' +
        #1050#1040#1050' '#1050#1051#1048#1045#1053#1058', '#1040' '#1042' G_TOCHKA '#1057#1058#1054#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '110238186=  END ELSE BEGIN'
      '110238187=      FOR'
      '110238188=        SELECT T.SKLAD,'
      '110238189=               T.DATE_RECEIPT,'
      '110238190=               T.G_TOCHKA,'
      '110238191=               G.NAME,'
      
        '110238192=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||D' +
        '.AMOUNT||'#39')'#39', '#39', '#39')'
      '110238193=                            FROM SKLAD D, G_PRODUCT G'
      
        '110238194=                           WHERE D.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '110238195=                             AND D.SKLAD_PARENT = T.SK' +
        'LAD'
      
        '110238196=                           GROUP BY SKLAD_PARENT) FROM' +
        ' 1 FOR 999) DETAILS_STR, */'
      '110238197=               T.OSNOVANIE,'
      '110238198=               T.NOTE,'
      '110238199=               T.SUMM'
      
        '110238200=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHKA' +
        ' G ON T.G_CLIENT = G.G_TOCHKA'
      '110238201=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '110238202=           AND T.IS_VOZVRAT = 3'
      
        '110238203=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110238204=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '110238205=        INTO :SKLAD,'
      '110238206=             :DATE_RECEIPT,'
      '110238207=             :G_CLIENT,'
      '110238208=             :CLIENT_NAME,'
      '110238209=             --:DETAILS_STR,'
      '110238210=             :OSNOVANIE,'
      '110238211=             :NOTE,'
      '110238212=             :SUMM'
      '110238213=      DO'
      '110238214=        suspend;'
      '110238215=  END'
      '110238216=end'
      '110238217=;'
      '110238218='
      '110238219='
      
        '110238220=UPDATE SYSTEM_SETUP SET S_VALUE = 110238 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110238221=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110238222=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102390='
      '1102391=ALTER PROCEDURE G_TOCHKA_DEL('
      
        '1102392=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T,'
      '1102393=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102394=RETURNS ('
      '1102395=  ERR_CODE INTEGER,'
      '1102396=  ERR_MSG VARCHAR(1024))'
      '1102397=AS'
      '1102398=BEGIN'
      '1102399=  SUSPEND;'
