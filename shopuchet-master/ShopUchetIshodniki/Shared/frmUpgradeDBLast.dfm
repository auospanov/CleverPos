      '110202564=  END'
      '110202565=END'
      '110202566=;'
      '110202567='
      '110202568=ALTER PROCEDURE LOG_INIT'
      '110202569=AS'
      '110202570=DECLARE VARIABLE TN VARCHAR(64);'
      '110202571=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110202572=DECLARE VARIABLE FN VARCHAR(64);'
      '110202573=DECLARE VARIABLE TP INTEGER;'
      
        '110202574=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110202575=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110202576=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110202577=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110202578=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110202579=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110202580=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110202581=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000) */'
      '110202582=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110202583=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110202584=DECLARE VARIABLE ANZ INTEGER;'
      '110202585=DECLARE VARIABLE L INTEGER;'
      '110202586=DECLARE VARIABLE P INTEGER;'
      '110202587=DECLARE VARIABLE S INTEGER;'
      '110202588=DECLARE VARIABLE FT CHAR(1);'
      '110202589=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110202590=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110202591=BEGIN'
      '110202592=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110202593='
      '110202594=  TN_ALT='#39#39';'
      '110202595=  TRGI='#39#39';'
      '110202596=  TRGU='#39#39';'
      '110202597=  TRGD='#39#39';'
      '110202598=  TRGIX='#39#39';'
      '110202599=  TRGUX='#39#39';'
      '110202600=  TRGDX='#39#39';'
      '110202601=  SQLF='#39#39';'
      '110202602=  SQLV='#39#39';'
      '110202603=  SQLU='#39#39';'
      '110202604=  FT='#39#39';'
      '110202605='
      '110202606=  FOR SELECT R.RDB$RELATION_NAME,'
      '110202607=            R.RDB$FIELD_NAME,'
      '110202608=            F.RDB$FIELD_TYPE,'
      '110202609=            F.RDB$FIELD_LENGTH,'
      '110202610=            F.RDB$FIELD_PRECISION,'
      '110202611=            F.RDB$FIELD_SCALE'
      '110202612=        FROM RDB$RELATION_FIELDS R,'
      '110202613=             RDB$FIELDS F'
      '110202614=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110202615=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110202616=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110202617=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110202618=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110202619=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110202620=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110202621=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110202622=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110202623=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110202624=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39')'
      '110202625=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110202626=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110202627=              OR'
      
        '110202628=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110202629=             )'
      
        '110202630=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110202631=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110202632=  DO BEGIN'
      '110202633=    TN=TRIM(TN);'
      '110202634=    FN=TRIM(FN);'
      '110202635=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110202636=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110202637=      EXECUTE STATEMENT TRGI;'
      '110202638=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110202639=      EXECUTE STATEMENT TRGU;'
      '110202640=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110202641=      EXECUTE STATEMENT TRGD;'
      '110202642='
      '110202643=      SQLF='#39#39';'
      '110202644=      SQLV='#39#39';'
      '110202645=      SQLU='#39#39';'
      '110202646=    END'
      '110202647=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110202648=      ID_COLUMN = FN;'
      '110202649='
      '110202650=    S=-S;'
      
        '110202651=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110202652=      ft='#39'N'#39';   --numerisch'
      '110202653=    else'
      '110202654=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110202655=        ft='#39'Z'#39';   --zeit'
      '110202656=      else'
