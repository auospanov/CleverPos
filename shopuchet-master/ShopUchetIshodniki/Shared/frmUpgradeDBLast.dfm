      '1102461948=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102461949=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1102461950=      PNT_ = '#39'25'#39';'
      
        '1102461951=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1102461952=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1102461953=      RETURNING ZAKAZ_REAL_PARENT'
      '1102461954=      INTO :ZAKAZ_REAL_PARENT_;'
      '1102461955='
      
        '1102461956=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1102461957=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102461958=          INTO :G_PRODUCT,'
      '1102461959=              :AMOUNT,'
