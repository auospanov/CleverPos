      '1101131656=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1101131657=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101131658=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101131659=            ELSE'
      
        '1101131660=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101131661='
      '1101131662=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101131663=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101131664='
      
        '1101131665=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1101131666=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1101131667=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101131668=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1101131669=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1101131670=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1101131671=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101131672=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1101131673=                                              :SKLAD_' +
        'PARENT_,'
      
        '1101131674=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1101131675=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101131676='
      
        '1101131677=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101131678=            ELSE BEGIN'
      
        '1101131679=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101131680=                SELECT 1'
      '1101131681=                  FROM KASSA K'
      '1101131682=                 WHERE K.KASSA = :KASSA_'
      '1101131683=                UNION ALL'
      '1101131684=                SELECT 2'
      '1101131685=                  FROM KASSA_BEZNAL KB'
      '1101131686=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101131687=                 INTO :PAYMENT_TYPE_OLD_;'
      '1101131688='
      
        '1101131689=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101131690=                      PNT_ = '#39'010'#39';'
      
        '1101131691=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1101131692=                                                    1' +
        ',     -- ACTION_'
      
        '1101131693=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1101131694=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1101131695=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1101131696=                                                    N' +
        'ULL,   --NOTE_'
      
        '1101131697=                                                    N' +
        'ULL,  --ZAKAZ'
      
        '1101131698=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1101131699=                                                    :' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101131700='
      
        '1101131701=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101131702=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101131703=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101131704=                      PNT_ = '#39'011'#39';'
      
        '1101131705=                      EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '1101131706=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101131707=                        ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
