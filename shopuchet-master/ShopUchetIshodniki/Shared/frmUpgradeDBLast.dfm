        'MSG);'
      
        '1101825491=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1101825492=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101825493=                          EXIT;'
      '1101825494=                        END'
      '1101825495='
      '1101825496=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
