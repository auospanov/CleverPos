        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110227149='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110227150='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110227151='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110227152='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110227153='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110227154=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110227155=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110227156=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110227157='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110227158='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110227159='
      '110227160='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = NULL, '#1058#1054' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '110227161='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = -100, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040 +
        #1057#1057#1059' '#1042#1054#1054#1041#1065#1045
      
        '110227162='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = ID, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1050#1054#1053#1050#1056#1045#1058#1053#1059#1070' '#1057#1058 +
        #1040#1058#1068#1070' '#1055#1056#1048#1061#1054#1044#1040' '#1042' '#1050#1040#1057#1057#1059
      '110227163=*'
      '110227164=*/'
      
        '110227165=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39 +
        ';'
      '110227166=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110227167=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110227168=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110227169=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110227170=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110227171=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110227172=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '110227173=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '110227174=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '110227175=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '110227176=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110227177=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110227178=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110227179=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110227180=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110227181=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110227182=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110227183=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110227184=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110227185=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110227186=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110227187=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110227188=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110227189=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110227190=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110227191=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110227192=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110227193=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110227194=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110227195=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110227196=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110227197=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110227198=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110227199=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110227200=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110227201=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110227202=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110227203=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110227204=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110227205=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110227206=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110227207=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110227208=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110227209=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110227210=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110227211=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110227212=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110227213=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '110227214=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM_FACT;'
      
        '110227215=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN S' +
        'KLAD_PARENT.SUMM_FACT;'
      '110227216=BEGIN'
      
        '110227217=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110227218=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110227219='
      '110227220=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110227221=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110227222=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110227223='
      '110227224=  FOR SELECT GP.PATH,'
      '110227225=             GP.G_PRODUCT'
      '110227226=       FROM P_REP_TREE GP'
      '110227227=      WHERE EXISTS (SELECT 1'
      
        '110227228=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110227229=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110227230=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110227231=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110227232=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110227233=                       AND Z.IS_SPISANIE = 0'
      '110227234=                       AND Z.is_reserve = 0'
      '110227235=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110227236=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110227237=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227238=                       AND COALESCE(Z.G_OFFICIAL, 0) =' +
        ' COALESCE(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056 +
        #1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227239=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110227240=                       AND ((EXISTS (SELECT 1'
      
        '110227241=                                       FROM SKLAD S, G' +
        '_PRODUCT G'
      
        '110227242=                                      WHERE S.G_CLIENT' +
        ' = :G_SUPPLIER_'
      
        '110227243=                                        AND S.G_PRODUC' +
        'T = G.G_PRODUCT'
      
        '110227244=                                        AND G.G_PRODUC' +
        'T_PAR = GP.G_PRODUCT'
      
        '110227245=                                        AND :G_TOCHKA_' +
        'ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_,' +
        ' 0) <> 0)'
      '110227246=                              OR'
      
        '110227247=                              COALESCE(:G_SUPPLIER_, 0' +
        ') = 0)'
      '110227248=                       )'
      '110227249=      ORDER BY 1, 2'
      '110227250=  INTO :RECCAT_NAME_,'
      '110227251=       :RECCAT_PRODUCT_'
      '110227252=  DO BEGIN'
      '110227253=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227254=    insert into p_rep_profit_table'
      '110227255=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110227256=    values'
      
        '110227257=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110227258='
      '110227259=    FOR SELECT Z.ZAKAZ,'
      '110227260=               Z.G_TOCHKA,'
      '110227261=               Z.Z_DATE,'
      '110227262=               Z.G_CLIENT,'
      '110227263=               C.NAME CLIENT_NAME,'
      '110227264=               Z.G_PAYMENT_TYPE,'
      '110227265=               P.NAME PAYMENT_NAME,'
      '110227266=               Z.OSNOVANIE,'
      '110227267=               G.G_PRODUCT,'
      '110227268=               G.G_PRODUCT_PAR,'
      '110227269=               G.NAME TOVAR_NAME,'
      '110227270=               ZD.AMOUNT,'
      '110227271=               ZD.PRICE,'
      '110227272=               ZD.SUMM,'
      '110227273=               ZD.DISCOUNT_PERC,'
      '110227274=               ZD.DISCOUNT_SUMM,'
      '110227275=               ZD.NDS,'
      '110227276=               ZD.NDS_SUMM,'
      '110227277=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110227278=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110227279=               ZAKAZ_DETAILS ZD,'
      '110227280=               G_PRODUCT G,'
      '110227281=               G_PAYMENT_TYPE P'
      
        '110227282=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110227283=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110227284=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110227285=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110227286=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110227287=           AND Z.IS_SPISANIE = 0                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '110227288=           AND Z.IS_RESERVE = 0                    -- ' +
        #1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '110227289=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110227290=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110227291=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110227292=           AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G' +
        '_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' ' +
        #1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227293=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110227294=           AND ((EXISTS (SELECT 1'
      '110227295=                           FROM SKLAD S'
      
        '110227296=                          WHERE S.G_CLIENT = :G_SUPPLI' +
        'ER_'
      
        '110227297=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110227298=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110227299=                OR'
      '110227300=                COALESCE(:G_SUPPLIER_, 0) = 0'
      '110227301=               )'
      
        '110227302=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110227303=    INTO :REC_ZAKAZ_,'
      '110227304=        :REC_G_TOCHKA_,'
      '110227305=        :REC_Z_DATE_,'
      '110227306=        :REC_G_CLIENT_,'
      '110227307=        :REC_CLIENT_NAME_,'
      '110227308=        :REC_G_PAYMENT_TYPE_,'
      '110227309=        :REC_PAYMENT_NAME_,'
      '110227310=        :REC_OSNOVANIE_,'
      '110227311=        :REC_G_PRODUCT_,'
      '110227312=        :REC_G_PRODUCT_PAR_,'
      '110227313=        :REC_TOVAR_NAME_,'
      '110227314=        :REC_AMOUNT_,'
      '110227315=        :REC_PRICE_,'
      '110227316=        :REC_SUMM_,'
      '110227317=        :REC_DISCOUNT_PERC_,'
      '110227318=        :REC_DISCOUNT_SUMM_,'
      '110227319=        :REC_NDS_,'
      '110227320=        :REC_NDS_SUMM_,'
      '110227321=        :REC_PRICE_SELF_'
      '110227322=    DO BEGIN'
      '110227323=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110227324=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110227325='
      '110227326=      insert into p_rep_profit_table'
      
        '110227327=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110227328=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110227329=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110227330=      values'
      '110227331=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110227332=        :REC_ZAKAZ_,'
      '110227333=        :REC_g_tochka_,'
      
        '110227334=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110227335=         :REC_osnovanie_,'
      '110227336=         :REC_g_product_,'
      '110227337=         :REC_g_product_par_,'
      '110227338=         :REC_tovar_name_,'
      '110227339=         :REC_amount_,'
      '110227340=         :REC_price_,'
      '110227341=         :REC_summ_,'
      '110227342=         :REC_discount_perc_,'
      '110227343=         :REC_discount_summ_,'
      
        '110227344=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110227345='
      
        '110227346=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110227347=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110227348=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110227349=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110227350=    END'
      '110227351='
      '110227352=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227353=    insert into p_rep_profit_table'
      
        '110227354=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110227355=    values'
      
        '110227356=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110227357='
      '110227358=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110227359=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110227360=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110227361=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110227362='
      '110227363=    SUM_ZAKAZ_ = 0;'
      '110227364=    SUM_COST_  = 0;'
      '110227365=    NDS_SUMM_  = 0;'
      '110227366=    PROFIT_    = 0;'
      '110227367=  END'
      '110227368='
      '110227369=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110227370=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110227371=      insert into p_rep_profit_table'
      
        '110227372=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110227373=      values'
      
        '110227374=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110227375='
      
        '110227376=  --**************************************************' +
        '***************************************'
      '110227377=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110227378=  ----------------------------------------------------' +
        '---'
      '110227379=  SELECT COUNT(*)'
      
        '110227380=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110227381=          UNION ALL'
      
        '110227382=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110227383=         G_PRIHOD_RASHOD G'
      
        '110227384=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110227385=    AND K.ACTION = 1'
      
        '110227386=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110227387=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110227388=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053#1045 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110227389=  INTO :CNT_;'
      '110227390='
      '110227391=  IF (CNT_ > 0) THEN BEGIN'
      '110227392=    SUM_COST_  = 0;'
      '110227393=    PROFIT_    = 0;'
      '110227394='
      '110227395=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227396=    INSERT INTO P_REP_PROFIT_TABLE'
      '110227397=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110227398=    VALUES'
      
        '110227399=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', 1' +
        ');'
      '110227400='
      '110227401=    FOR SELECT K.ACTION_DATE,'
      '110227402=               K.SUMM,'
      
        '110227403=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, '#39 +
        ' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '110227404=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '110227405=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39
      '110227406=              UNION ALL'
      
        '110227407=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, ' +
        'SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM kas' +
        'sa_beznal'
      
        '110227408=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39') k,'
      '110227409=              G_PRIHOD_RASHOD G'
      '110227410=        WHERE K.ACTION = 1'
      
        '110227411=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110227412=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110227413=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)   ' +
        ' -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110227414=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110227415=    INTO :ACTION_DATE_,'
      '110227416=         :SUMM_,'
      '110227417=         :ACTION_NAME_'
      '110227418=    DO BEGIN'
      '110227419=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110227420=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110227421=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110227422=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110227423=        VALUES'
      
        '110227424=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, 0,'
      
        '110227425=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALES' +
        'CE(:SUMM_, 0), 0);'
      '110227426='
      '110227427=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110227428=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110227429=    END'
      '110227430='
      '110227431=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110227432=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110227433=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110227434=    insert into p_rep_profit_table'
      
        '110227435=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110227436=    values'
      
        '110227437=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110227438=  END'
      '110227439=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '110227440=  --**************************************************' +
        '***************************************'
      '110227441='
      
        '110227442=  --**************************************************' +
        '***************************************'
      '110227443=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '110227444=  ----------------------------------------------------' +
        '---'
      '110227445=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227446=  SELECT COUNT(*)'
      
        '110227447=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110227448=          UNION ALL'
      
        '110227449=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110227450=         G_PRIHOD_RASHOD G'
      
        '110227451=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110227452=    AND K.ACTION = 0'
      
        '110227453=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110227454=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110227455=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056#1045 +
        #1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110227456=    AND ((:G_PRIHOD_RASHOD_ IS NULL)'
      '110227457=         OR'
      
        '110227458=         (G.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_ AND :G' +
        '_PRIHOD_RASHOD_ = -100)'
      '110227459=         OR'
      
        '110227460=         (G.G_PRIHOD_RASHOD <> :G_PRIHOD_RASHOD_ AND :' +
        'G_PRIHOD_RASHOD_ <> -100)'
      '110227461=        )'
      '110227462=  INTO :CNT_;'
      '110227463='
      '110227464=  IF (CNT_ > 0) THEN BEGIN'
      '110227465=    PRIHOD_ALL_  = 0;'
      '110227466=    PRIHOD_ALL_NAL_  = 0;'
      '110227467=    PRIHOD_ALL_BEZNAL_  = 0;'
      '110227468=    PROFIT_     = 0;'
      '110227469='
      '110227470=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227471=    INSERT INTO P_REP_PROFIT_TABLE'
      '110227472=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110227473=    VALUES'
      
        '110227474=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', 1' +
        ');'
      '110227475='
      '110227476=    FOR SELECT K.ACTION_DATE,'
      '110227477=               K.NAL,'
      '110227478=               K.BEZNAL,'
      '110227479=               G.NAME'
      
        '110227480=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 ' +
        'BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110227481=               UNION ALL'
      
        '110227482=               SELECT kassa_BEZNAL KASSA, ACTION_DATE,' +
        ' 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kass' +
        'a_beznal) K,'
      '110227483=              G_PRIHOD_RASHOD G'
      
        '110227484=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '110227485=          AND K.ACTION = 0'
      
        '110227486=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110227487=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110227488=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110227489=          AND ((:G_PRIHOD_RASHOD_ IS NULL)'
      '110227490=               OR'
      
        '110227491=               (G.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_ ' +
        'AND :G_PRIHOD_RASHOD_ = -100)'
      '110227492=               OR'
      
        '110227493=               (G.G_PRIHOD_RASHOD <> :G_PRIHOD_RASHOD_' +
        ' AND :G_PRIHOD_RASHOD_ <> -100)'
      '110227494=              )'
      '110227495=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110227496=    INTO :ACTION_DATE_,'
      '110227497=         :SUMM_NAL_,'
      '110227498=         :SUMM_BEZNAL_,'
      '110227499=         :ACTION_NAME_'
      '110227500=    DO BEGIN'
      '110227501=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110227502=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110227503=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110227504=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110227505=        VALUES'
      
        '110227506=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '110227507=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '110227508='
      '110227509=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110227510=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM' +
        '_BEZNAL_;'
      
        '110227511=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_B' +
        'EZNAL_;'
      
        '110227512=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZ' +
        'NAL_;'
      '110227513=    END'
      '110227514='
      '110227515=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110227516=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110227517=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '110227518=    insert into p_rep_profit_table'
      
        '110227519=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110227520=    values'
      
        '110227521=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110227522=  END'
      '110227523='
      '110227524=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '110227525=  --**************************************************' +
        '***************************************'
      '110227526='
      
        '110227527=  --**************************************************' +
        '***************************************'
      '110227528=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110227529=  --**************************************************' +
        '***************************************'
      '110227530=  SELECT COUNT(*)'
      '110227531=    FROM ZAKAZ Z'
      
        '110227532=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110227533=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110227534=     AND Z.IS_SPISANIE = 1'
      
        '110227535=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110227536=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110227537=  INTO :CNT_;'
      '110227538='
      '110227539=  IF (CNT_ > 0) THEN BEGIN'
      '110227540=      SUM_ZAKAZ_ = 0;'
      '110227541=      SUM_COST_  = 0;'
      '110227542=      PROFIT_    = 0;'
      '110227543='
      '110227544=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227545=      insert into p_rep_profit_table'
      '110227546=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110227547=      values'
      
        '110227548=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39', 1);'
      '110227549='
      '110227550=      FOR SELECT Z.ZAKAZ,'
      '110227551=                 Z.G_TOCHKA,'
      '110227552=                 Z.Z_DATE,'
      '110227553=                 Z.G_CLIENT,'
      '110227554=                 '#39#39' CLIENT_NAME,'
      '110227555=                 Z.G_PAYMENT_TYPE,'
      '110227556=                 '#39#39' PAYMENT_NAME,'
      '110227557=                 Z.OSNOVANIE,'
      '110227558=                 G.G_PRODUCT,'
      '110227559=                 G.G_PRODUCT_PAR,'
      '110227560=                 G.NAME TOVAR_NAME,'
      '110227561=                 ZD.AMOUNT,'
      '110227562=                 ZD.PRICE,'
      '110227563=                 ZD.SUMM,'
      '110227564=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '110227565=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '110227566=                 0 NDS, --ZD.NDS,'
      '110227567=                 0 NDS_SUMM'
      
        '110227568=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT ' +
        'G'
      
        '110227569=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TO' +
        'CHKA||'#39'-'#39
      '110227570=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110227571=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110227572=             AND Z.IS_SPISANIE = 1                    ' +
        '-- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '110227573=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110227574=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '110227575=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G' +
        '_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059 +
        #1057#1058#1067#1052
      
        '110227576=             AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(' +
        ':G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045 +
        #1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227577=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALE' +
        'SCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110227578=             AND ((EXISTS (SELECT 1'
      '110227579=                           FROM SKLAD S'
      
        '110227580=                          WHERE S.G_CLIENT = :G_SUPPLI' +
        'ER_'
      
        '110227581=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110227582=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110227583=                  OR'
      '110227584=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110227585=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS'
      '110227586=      INTO :REC_ZAKAZ_,'
      '110227587=            :REC_G_TOCHKA_,'
      '110227588=            :REC_Z_DATE_,'
      '110227589=            :REC_G_CLIENT_,'
      '110227590=            :REC_CLIENT_NAME_,'
      '110227591=            :REC_G_PAYMENT_TYPE_,'
      '110227592=            :REC_PAYMENT_NAME_,'
      '110227593=            :REC_OSNOVANIE_,'
      '110227594=            :REC_G_PRODUCT_,'
      '110227595=            :REC_G_PRODUCT_PAR_,'
      '110227596=            :REC_TOVAR_NAME_,'
      '110227597=            :REC_AMOUNT_,'
      '110227598=            :REC_PRICE_,'
      '110227599=            :REC_SUMM_,'
      '110227600=            :REC_DISCOUNT_PERC_,'
      '110227601=            :REC_DISCOUNT_SUMM_,'
      '110227602=            :REC_NDS_,'
      '110227603=            :REC_NDS_SUMM_'
      '110227604=      DO BEGIN'
      '110227605=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110227606=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067 +
        ' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '110227607=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '110227608=        REC_profit_   = -REC_SUMM_;'
      '110227609='
      '110227610=        insert into p_rep_profit_table'
      
        '110227611=          (p_rep_profit_table, zakaz, g_tochka, z_date' +
        ', g_client, client_name, g_payment_type, payment_name,'
      
        '110227612=           osnovanie, g_product, g_product_par, tovar_' +
        'name, amount, price, summ, discount_perc, discount_summ,'
      
        '110227613=           nds, nds_summ, price_self, sum_self, profit' +
        ', is_head)'
      '110227614=        values'
      
        '110227615=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAK' +
        'AZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '110227616=         :REC_osnovanie_, :REC_g_product_, :REC_g_prod' +
        'uct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_pe' +
        'rc_, :REC_discount_summ_,'
      
        '110227617=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_' +
        'SUM_COST_, :REC_profit_, 0);'
      '110227618='
      
        '110227619=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST' +
        '_, 0);'
      
        '110227620=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, ' +
        '0);'
      '110227621=      END'
      '110227622='
      '110227623=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227624=      insert into p_rep_profit_table'
      
        '110227625=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110227626=      values'
      
        '110227627=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0' +
        ', :SUM_COST_, 0, :PROFIT_, 2);'
      '110227628='
      '110227629=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110227630=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110227631=  END'
      '110227632=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110227633=  --**************************************************' +
        '***************************************'
      '110227634='
      
        '110227635=  --**************************************************' +
        '***************************************'
      '110227636=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110227637=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048#1045 +
        #1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '110227638=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053#1054 +
        '", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '110227639=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' '#1055 +
        #1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '110227640='
      
        '110227641=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '110227642=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 45' +
        '00'
      
        '110227643=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056#1048 +
        #1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057#1054 +
        #1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '110227644=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070#1047 +
        #1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054' ' +
        #1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '110227645='
      
        '110227646=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059#1063 +
        #1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '110227647=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058'.' +
        ' - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '110227648=  --**************************************************' +
        '***************************************'
      '110227649=  SELECT COUNT(*)'
      '110227650=    FROM SKLAD S'
      
        '110227651=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      
        '110227652=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110227653=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110227654=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110227655=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110227656=     AND ((EXISTS (SELECT 1'
      '110227657=                   FROM SKLAD SS'
      '110227658=                  WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '110227659=                    AND SS.G_PRODUCT = S.G_PRODUCT'
      
        '110227660=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110227661=          OR'
      '110227662=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110227663=  INTO :CNT_;'
      '110227664='
      '110227665=  IF (CNT_ > 0) THEN BEGIN'
      '110227666=    SUM_ZAKAZ_ = 0;'
      '110227667=    PROFIT_    = 0;'
      '110227668=    SUM_COST_  = 0;'
      '110227669=    NDS_SUMM_  = 0;'
      '110227670='
      '110227671=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227672=    insert into p_rep_profit_table'
      '110227673=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110227674=    values'
      
        '110227675=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39', 1);'
      '110227676='
      '110227677=    FOR SELECT S.DATE_RECEIPT,'
      '110227678=               S.G_PRODUCT,'
      '110227679=               G.NAME TOVAR_NAME,'
      '110227680=               S.AMOUNT,'
      '110227681=               -S.PRICE,'
      '110227682=               -S.SUMM,'
      '110227683=               SP.G_TOCHKA,'
      '110227684=               S.COST_PRICE,'
      '110227685=               S.NDS,'
      '110227686=               S.NDS_SUMM'
      '110227687=         FROM SKLAD_PARENT SP,'
      '110227688=              SKLAD S,'
      '110227689=              G_PRODUCT G'
      
        '110227690=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCH' +
        'KA||'#39'-'#39
      
        '110227691=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110227692=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110227693=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110227694=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110227695=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110227696=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110227697=          AND ((EXISTS (SELECT 1'
      '110227698=                           FROM SKLAD SS'
      
        '110227699=                          WHERE SS.G_CLIENT = :G_SUPPL' +
        'IER_'
      
        '110227700=                            AND SS.G_PRODUCT = S.G_PRO' +
        'DUCT'
      
        '110227701=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110227702=                  OR'
      '110227703=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110227704=        ORDER BY 1'
      '110227705=    INTO :V_DATE_RECEIPT_,'
      '110227706=         :V_G_PRODUCT_,'
      '110227707=         :V_TOVAR_NAME_,'
      '110227708=         :V_AMOUNT_,'
      '110227709=         :V_PRICE_,'
      '110227710=         :V_SUMM_,'
      '110227711=         :REC_G_TOCHKA_,'
      '110227712=         :REC_PRICE_SELF_,'
      '110227713=         :REC_NDS_,'
      '110227714=         :REC_NDS_SUMM_'
      '110227715=    DO BEGIN'
      '110227716=      REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110227717=      REC_profit_   = V_SUMM_ + REC_SUM_COST_ + REC_ND' +
        'S_SUMM_;'
      '110227718='
      '110227719=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110227720=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110227721=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110227722=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, s' +
        'um_self)'
      '110227723=      VALUES'
      
        '110227724=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, :V' +
        '_SUMM_,'
      
        '110227725=         0, 0, :REC_NDS_, :REC_NDS_SUMM_, :REC_profit_' +
        ', 0, :REC_PRICE_SELF_, :REC_SUM_COST_);'
      '110227726='
      '110227727=      SUM_COST_  = SUM_COST_  + REC_SUM_COST_;'
      '110227728=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      
        '110227729=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110227730=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110227731=    END'
      '110227732='
      '110227733='
      '110227734=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110227735=    SUMM_COST_All_ = SUMM_COST_All_ - SUM_COST_;'
      '110227736=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ - NDS_SUMM_;'
      '110227737=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110227738='
      '110227739=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227740=    insert into p_rep_profit_table'
      
        '110227741=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110227742=    values'
      
        '110227743=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110227744='
      '110227745=    SUM_COST_  = 0;'
      '110227746=    SUM_ZAKAZ_ = 0;'
      '110227747=    NDS_SUMM_  = 0;'
      '110227748=    PROFIT_    = 0;'
      '110227749=  END'
      '110227750=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110227751=  --**************************************************' +
        '***************************************'
      '110227752='
      
        '110227753=  --**************************************************' +
        '***************************************'
      
        '110227754=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045#1051 +
        #1054' '#1052#1045#1057#1058#1054
      '110227755=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '110227756=  --**************************************************' +
        '***************************************'
      '110227757=  /*SELECT COUNT(*)'
      '110227758=    FROM ZAKAZ Z'
      
        '110227759=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110227760=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110227761=     AND Z.IS_SPISANIE = 4'
      
        '110227762=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110227763=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110227764=  INTO :CNT_;'
      '110227765='
      '110227766=  IF (CNT_ > 0) THEN BEGIN'
      '110227767=      SUM_ZAKAZ_ = 0;'
      '110227768=      SUM_COST_  = 0;'
      '110227769=      PROFIT_    = 0;'
      '110227770=      NDS_SUMM_  = 0;'
      '110227771='
      '110227772=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227773=      insert into p_rep_profit_table'
      '110227774=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110227775=      values'
      
        '110227776=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058 +
        #1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '110227777='
      '110227778=      FOR SELECT Z.ZAKAZ,'
      '110227779=               Z.G_TOCHKA,'
      '110227780=               Z.Z_DATE,'
      '110227781=               Z.G_CLIENT,'
      '110227782=               C.NAME CLIENT_NAME,'
      '110227783=               Z.G_PAYMENT_TYPE,'
      '110227784=               P.NAME PAYMENT_NAME,'
      '110227785=               Z.OSNOVANIE,'
      '110227786=               G.G_PRODUCT,'
      '110227787=               G.G_PRODUCT_PAR,'
      '110227788=               G.NAME TOVAR_NAME,'
      '110227789=               ZD.AMOUNT,'
      '110227790=               ZD.PRICE,'
      '110227791=               ZD.SUMM,'
      '110227792=               ZD.DISCOUNT_PERC,'
      '110227793=               ZD.DISCOUNT_SUMM,'
      '110227794=               ZD.NDS,'
      '110227795=               ZD.NDS_SUMM,'
      '110227796=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110227797=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110227798=               ZAKAZ_DETAILS ZD,'
      '110227799=               G_PRODUCT G,'
      '110227800=               G_PAYMENT_TYPE P'
      
        '110227801=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110227802=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110227803=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110227804=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110227805=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110227806=           AND Z.IS_SPISANIE = 4                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110227807=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110227808=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110227809=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110227810=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110227811=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110227812=    INTO :REC_ZAKAZ_,'
      '110227813=        :REC_G_TOCHKA_,'
      '110227814=        :REC_Z_DATE_,'
      '110227815=        :REC_G_CLIENT_,'
      '110227816=        :REC_CLIENT_NAME_,'
      '110227817=        :REC_G_PAYMENT_TYPE_,'
      '110227818=        :REC_PAYMENT_NAME_,'
      '110227819=        :REC_OSNOVANIE_,'
      '110227820=        :REC_G_PRODUCT_,'
      '110227821=        :REC_G_PRODUCT_PAR_,'
      '110227822=        :REC_TOVAR_NAME_,'
      '110227823=        :REC_AMOUNT_,'
      '110227824=        :REC_PRICE_,'
      '110227825=        :REC_SUMM_,'
      '110227826=        :REC_DISCOUNT_PERC_,'
      '110227827=        :REC_DISCOUNT_SUMM_,'
      '110227828=        :REC_NDS_,'
      '110227829=        :REC_NDS_SUMM_,'
      '110227830=        :REC_PRICE_SELF_'
      '110227831=    DO BEGIN'
      '110227832=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '110227833=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '110227834='
      '110227835=      insert into p_rep_profit_table'
      
        '110227836=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110227837=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110227838=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110227839=      values'
      '110227840=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110227841=        :REC_ZAKAZ_,'
      '110227842=        :REC_g_tochka_,'
      
        '110227843=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110227844=         :REC_osnovanie_,'
      '110227845=         :REC_g_product_,'
      '110227846=         :REC_g_product_par_,'
      '110227847=         :REC_tovar_name_,'
      '110227848=         :REC_amount_,'
      '110227849=         :REC_price_,'
      '110227850=         :REC_summ_,'
      '110227851=         :REC_discount_perc_,'
      '110227852=         :REC_discount_summ_,'
      
        '110227853=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110227854='
      
        '110227855=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110227856=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110227857=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110227858=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110227859=    END'
      '110227860='
      '110227861=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227862=    insert into p_rep_profit_table'
      
        '110227863=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110227864=    values'
      
        '110227865=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110227866='
      '110227867=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110227868=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '110227869=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110227870=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110227871='
      '110227872=    SUM_ZAKAZ_ = 0;'
      '110227873=    SUM_COST_  = 0;'
      '110227874=    NDS_SUMM_  = 0;'
      '110227875=    PROFIT_    = 0;'
      '110227876=  END'
      '110227877=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '110227878=  --**************************************************' +
        '***************************************'
      '110227879='
      
        '110227880=  --**************************************************' +
        '***************************************'
      
        '110227881=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048 +
        #1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110227882=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054 +
        #1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110227883=  --**************************************************' +
        '***************************************'
      '110227884=  SELECT COUNT(*)'
      '110227885=    FROM ZAKAZ S'
      
        '110227886=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110227887=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110227888=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227889=     AND COALESCE(S.G_OFFICIAL, 0) = COALESCE(:G_OFFIC' +
        'IAL_, COALESCE(S.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '110227890=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110227891=     AND S.IS_SPISANIE = 2'
      '110227892=  INTO :CNT_;'
      '110227893='
      '110227894=  IF (CNT_ > 0) THEN BEGIN'
      '110227895=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227896=      insert into p_rep_profit_table'
      '110227897=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110227898=      values'
      
        '110227899=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '110227900='
      '110227901=      SUM_ZAKAZ_ = 0;'
      '110227902=      SUM_COST_  = 0;'
      '110227903=      NDS_SUMM_  = 0;'
      '110227904=      PROFIT_    = 0;'
      '110227905=      FOR SELECT GP.NAME,'
      '110227906=                 GP.G_PRODUCT'
      '110227907=           FROM G_PRODUCT GP'
      '110227908=          WHERE IS_CATEGORY = 1'
      '110227909=            AND EXISTS (SELECT 1'
      
        '110227910=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110227911=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110227912=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110227913=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110227914=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110227915=                           AND Z.IS_SPISANIE = 2'
      '110227916=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110227917=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110227918=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058 +
        ' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227919=                           AND COALESCE(Z.G_OFFICIAL, ' +
        '0) = COALESCE(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' ' +
        #1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227920=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110227921=                           AND ((EXISTS (SELECT 1'
      
        '110227922=                                           FROM SKLAD ' +
        'S'
      
        '110227923=                                          WHERE S.G_CL' +
        'IENT = :G_SUPPLIER_'
      
        '110227924=                                            AND S.G_PR' +
        'ODUCT = G.G_PRODUCT'
      
        '110227925=                                            AND :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLI' +
        'ER_, 0) <> 0)'
      '110227926=                                  OR'
      
        '110227927=                                  COALESCE(:G_SUPPLIER' +
        '_, 0) = 0)'
      '110227928=                           )'
      '110227929=          ORDER BY 1'
      '110227930=      INTO :RECCAT_NAME_,'
      '110227931=           :RECCAT_PRODUCT_'
      '110227932=      DO BEGIN'
      '110227933=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110227934=        insert into p_rep_profit_table'
      '110227935=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110227936=        values'
      
        '110227937=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110227938='
      '110227939=        FOR SELECT Z.ZAKAZ,'
      '110227940=                   Z.G_TOCHKA,'
      '110227941=                   Z.Z_DATE,'
      '110227942=                   Z.G_CLIENT,'
      '110227943=                   C.NAME CLIENT_NAME,'
      '110227944=                   Z.G_PAYMENT_TYPE,'
      '110227945=                   P.NAME PAYMENT_NAME,'
      '110227946=                   Z.OSNOVANIE,'
      '110227947=                   G.G_PRODUCT,'
      '110227948=                   G.G_PRODUCT_PAR,'
      '110227949=                   G.NAME TOVAR_NAME,'
      '110227950=                   ZD.AMOUNT,'
      '110227951=                   ZD.PRICE,'
      '110227952=                   ZD.SUMM,'
      '110227953=                   ZD.DISCOUNT_PERC,'
      '110227954=                   ZD.DISCOUNT_SUMM,'
      '110227955=                   ZD.NDS,'
      '110227956=                   ZD.NDS_SUMM,'
      '110227957=                   ZD.COST_PRICE'
      
        '110227958=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110227959=                   ZAKAZ_DETAILS ZD,'
      '110227960=                   G_PRODUCT G,'
      '110227961=                   G_PAYMENT_TYPE P'
      
        '110227962=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_' +
        'TOCHKA||'#39'-'#39
      '110227963=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110227964=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110227965=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110227966=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_ ' +
        ' -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110227967=               AND Z.IS_SPISANIE = 2                  ' +
        '  -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '110227968=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110227969=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110227970=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '110227971=               AND COALESCE(Z.G_OFFICIAL, 0) = COALESC' +
        'E(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054 +
        #1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110227972=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110227973=               AND ((EXISTS (SELECT 1'
      '110227974=                               FROM SKLAD S'
      
        '110227975=                              WHERE S.G_CLIENT = :G_SU' +
        'PPLIER_'
      
        '110227976=                                AND S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '110227977=                                AND :G_TOCHKA_ARR_ CON' +
        'TAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0' +
        ')'
      '110227978=                      OR'
      '110227979=                      COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110227980=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110227981=        INTO :REC_ZAKAZ_,'
      '110227982=            :REC_G_TOCHKA_,'
      '110227983=            :REC_Z_DATE_,'
      '110227984=            :REC_G_CLIENT_,'
      '110227985=            :REC_CLIENT_NAME_,'
      '110227986=            :REC_G_PAYMENT_TYPE_,'
      '110227987=            :REC_PAYMENT_NAME_,'
      '110227988=            :REC_OSNOVANIE_,'
      '110227989=            :REC_G_PRODUCT_,'
      '110227990=            :REC_G_PRODUCT_PAR_,'
      '110227991=            :REC_TOVAR_NAME_,'
      '110227992=            :REC_AMOUNT_,'
      '110227993=            :REC_PRICE_,'
      '110227994=            :REC_SUMM_,'
      '110227995=            :REC_DISCOUNT_PERC_,'
      '110227996=            :REC_DISCOUNT_SUMM_,'
      '110227997=            :REC_NDS_,'
      '110227998=            :REC_NDS_SUMM_,'
      '110227999=            :REC_PRICE_SELF_'
      '1102271000=        DO BEGIN'
      
        '1102271001=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SEL' +
        'F_;'
      
        '1102271002=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ -' +
        ' REC_NDS_SUMM_;'
      '1102271003='
      '1102271004=          insert into p_rep_profit_table'
      
        '1102271005=            (p_rep_profit_table, zakaz, g_tochka, z_d' +
        'ate, g_client, client_name, g_payment_type, payment_name,'
      
        '1102271006=             osnovanie, g_product, g_product_par, tov' +
        'ar_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1102271007=             nds, nds_summ, price_self, sum_self, pro' +
        'fit, is_head)'
      '1102271008=          values'
      '1102271009=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1102271010=            :REC_ZAKAZ_,'
      '1102271011=            :REC_g_tochka_,'
      
        '1102271012=            :REC_z_date_, :REC_g_client_, :REC_client' +
        '_name_, :REC_g_payment_type_, :REC_payment_name_,'
      '1102271013=             :REC_osnovanie_,'
      '1102271014=             :REC_g_product_,'
      '1102271015=             :REC_g_product_par_,'
      '1102271016=             :REC_tovar_name_,'
      '1102271017=             :REC_amount_,'
      '1102271018=             :REC_price_,'
      '1102271019=             :REC_summ_,'
      '1102271020=             :REC_discount_perc_,'
      '1102271021=             :REC_discount_summ_,'
      
        '1102271022=             :REC_nds_, :REC_nds_summ_, :REC_price_se' +
        'lf_, :REC_SUM_COST_, :REC_profit_, 0);'
      '1102271023='
      
        '1102271024=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM' +
        '_, 0);'
      
        '1102271025=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_C' +
        'OST_, 0);'
      
        '1102271026=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_S' +
        'UMM_, 0);'
      
        '1102271027=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_' +
        ', 0);'
      '1102271028=        END'
      '1102271029='
      '1102271030=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102271031=        insert into p_rep_profit_table'
      
        '1102271032=          (p_rep_profit_table, tovar_name, summ, sum_' +
        'self, NDS_SUMM, profit, is_head)'
      '1102271033=        values'
      
        '1102271034=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1102271035='
      
        '1102271036=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ' +
        '_;'
      '1102271037=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '1102271038=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '1102271039=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '1102271040='
      '1102271041=        SUM_ZAKAZ_ = 0;'
      '1102271042=        SUM_COST_  = 0;'
      '1102271043=        NDS_SUMM_  = 0;'
      '1102271044=        PROFIT_    = 0;'
      '1102271045=      END'
      '1102271046='
      '1102271047=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1102271048=      insert into p_rep_profit_table'
      
        '1102271049=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1102271050=      values'
      
        '1102271051=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '1102271052='
      
        '1102271053=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REA' +
        'L_;'
      
        '1102271054=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REA' +
        'L_;'
      
        '1102271055=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_' +
        ';'
      '1102271056=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '1102271057=  END'
      '1102271058=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102271059=  --*************************************************' +
        '****************************************'
      '1102271060=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '1102271061='
      '1102271062=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1102271063=  insert into p_rep_profit_table'
      '1102271064=    (p_rep_profit_table, is_head)'
      '1102271065=  values'
      '1102271066=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1102271067='
      '1102271068=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1102271069=  insert into p_rep_profit_table'
      
        '1102271070=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102271071=  values'
      
        '1102271072=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1102271073='
      '1102271074=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1102271075=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1102271076=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1102271077=         SUM(Z.SUMM_BONUS)'
      '1102271078=    FROM ZAKAZ Z'
      
        '1102271079=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1102271080=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1102271081=     AND Z.IS_RESERVE = 0'
      '1102271082=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102271083=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271084=     AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '1102271085=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102271086=     AND ((EXISTS (SELECT 1'
      '1102271087=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1102271088=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1102271089=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1102271090=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1102271091=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102271092=          OR'
      '1102271093=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102271094=    INTO :SUMM_CASH_ALL_,'
      '1102271095=         :SUMM_NONCASH_ALL_,'
      '1102271096=         :SUMM_BONUS_ALL_;'
      '1102271097='
      '1102271098=  SELECT SUM(NAL),'
      '1102271099=         SUM(BEZNAL)'
      
        '1102271100=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHE' +
        'RE K.SKLAD = SP.SKLAD) NAL,'
      
        '1102271101=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL' +
        ' KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '1102271102=           FROM SKLAD_PARENT SP'
      
        '1102271103=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '1102271104=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102271105=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '1102271106=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, CO' +
        'ALESCE(SP.G_CLIENT, 0))'
      
        '1102271107=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYME' +
        'NT_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '1102271108=        )'
      '1102271109=  INTO :SUMM_VOZVRAT_NAL_,'
      '1102271110=       :SUMM_VOZVRAT_BEZNAL_;'
      '1102271111='
      
        '1102271112=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COAL' +
        'ESCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '1102271113=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) ' +
        '- COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '1102271114=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1102271115='
      '1102271116=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1102271117='
      
        '1102271118=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1102271119=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1102271120='
      '1102271121=/*  insert into p_rep_profit_table'
      
        '1102271122=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102271123=  values'
      
        '1102271124=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1102271125='
      '1102271126=  insert into p_rep_profit_table'
      '1102271127=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1102271128=  values'
      
        '1102271129=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1102271130='
      '1102271131=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1102271132=    SELECT G.NAME'
      '1102271133=      FROM G_CLIENT G'
      '1102271134=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102271135=    INTO :CLIENT_NAME_;'
      '1102271136=  ELSE'
      '1102271137=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102271138='
      '1102271139=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1102271140=    SELECT G.NAME'
      '1102271141=      FROM G_PAYMENT_TYPE G'
      '1102271142=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1102271143=    INTO :PAYMENT_NAME_;'
      '1102271144=  ELSE'
      '1102271145=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102271146='
      '1102271147=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1102271148=        P.ZAKAZ,'
      '1102271149=        P.G_TOCHKA,'
      '1102271150=        P.Z_DATE,'
      '1102271151=        P.G_CLIENT,'
      '1102271152=        P.CLIENT_NAME,'
      '1102271153=        P.G_PAYMENT_TYPE,'
      '1102271154=        P.PAYMENT_NAME,'
      '1102271155=        P.OSNOVANIE,'
      '1102271156=        P.G_PRODUCT,'
      '1102271157=        P.G_PRODUCT_PAR,'
      '1102271158=        P.TOVAR_NAME,'
      '1102271159=        G.ARTICUL,'
      '1102271160=        G.NOMENCLATUR_NUM,'
      '1102271161=        G.BARCODE,'
      '1102271162=        P.AMOUNT,'
      
        '1102271163=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1102271164=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1102271165=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102271166=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102271167=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1102271168=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102271169=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102271170=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102271171=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1102271172=        P.IS_HEAD'
      
        '1102271173=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1102271174=    ORDER BY 1'
      '1102271175=  INTO :P_REP_PROFIT_TABLE,'
      '1102271176=       :ZAKAZ,'
      '1102271177=       :G_TOCHKA,'
      '1102271178=       :Z_DATE,'
      '1102271179=       :G_CLIENT,'
      '1102271180=       :CLIENT_NAME,'
      '1102271181=       :G_PAYMENT_TYPE,'
      '1102271182=       :PAYMENT_NAME,'
      '1102271183=       :OSNOVANIE,'
      '1102271184=       :G_PRODUCT,'
      '1102271185=       :G_PRODUCT_PAR,'
      '1102271186=       :TOVAR_NAME,'
      '1102271187=       :ARTICUL,'
      '1102271188=       :NOMENCLATUR_NUM,'
      '1102271189=       :BARCODE,'
      '1102271190=       :AMOUNT,'
      '1102271191=       :PRICE,'
      '1102271192=       :SUMM,'
      '1102271193=       :DISCOUNT_PERC,'
      '1102271194=       :DISCOUNT_SUMM,'
      '1102271195=       :NDS,'
      '1102271196=       :NDS_SUMM,'
      '1102271197=       :PRICE_SELF,'
      '1102271198=       :SUM_SELF,'
      '1102271199=       :PROFIT,'
      '1102271200=       :IS_HEAD'
      '1102271201=  DO'
      '1102271202=    suspend;'
      '1102271203='
      '1102271204=WHEN ANY DO BEGIN'
      '1102271205=    Err_code = -20500;'
      
        '1102271206=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102271207=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102271208=  END'
      '1102271209=end'
      '1102271210=;'
      '1102271211='
      '1102271212=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '1102271213=  DATE_BEGIN_ DATE,'
      '1102271214=  DATE_END_ DATE,'
      '1102271215=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1102271216=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      '1102271217=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1102271218=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0,'
      
        '1102271219=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      
        '1102271220=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_P' +
        'RIHOD_RASHOD = NULL)'
      '1102271221=RETURNS ('
      '1102271222=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1102271223=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '1102271224=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SU' +
        'MM,'
      '1102271225=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1102271226=  SUMM_ALL_ NUMERIC(15,2),'
      '1102271227=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1102271228=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1102271229=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1102271230=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1102271231=  PROFIT_ALL_ NUMERIC(15,2),'
      '1102271232=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1102271233=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABL' +
        'E.P_REP_PROFIT_TABLE,'
      
        '1102271234=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_' +
        'NAME,'
      '1102271235=  SUMM NUMERIC(15,2),'
      '1102271236=  NDS_SUMM NUMERIC(15,2),'
      '1102271237=  SUM_SELF NUMERIC(15,2),'
      '1102271238=  PROFIT NUMERIC(15,2),'
      '1102271239=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1102271240=  ERR_CODE INTEGER,'
      '1102271241=  ERR_MSG VARCHAR(1024))'
      '1102271242=AS'
      '1102271243=/*'
      '1102271244='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1102271245='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1102271246='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1102271247='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1102271248='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1102271249='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1102271250='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1102271251=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1102271252=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1102271253=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1102271254='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1102271255='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1102271256='
      
        '1102271257='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = NULL, '#1058#1054' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057 +
        #1059
      
        '1102271258='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = -100, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050 +
        #1040#1057#1057#1059' '#1042#1054#1054#1041#1065#1045
      
        '1102271259='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = ID, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1050#1054#1053#1050#1056#1045#1058#1053#1059#1070' '#1057 +
        #1058#1040#1058#1068#1070' '#1055#1056#1048#1061#1054#1044#1040' '#1042' '#1050#1040#1057#1057#1059
      '1102271260=*/'
      
        '1102271261=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT' +
        #39';'
      '1102271262=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102271263=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1102271264=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1102271265=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1102271266=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1102271267=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1102271268=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1102271269=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1102271270=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM;'
      
        '1102271271=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.NDS_SUMM;'
      
        '1102271272=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.S' +
        'UMM;'
      '1102271273=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '1102271274=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '1102271275=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1102271276=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059 +
        #1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1102271277=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /' +
        '* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1102271278=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0' +
        '; /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '1102271279=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1102271280=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      '1102271281=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '1102271282=BEGIN'
      
        '1102271283=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_T' +
        'ABLE = P_REP_PROFIT_TABLE;'
      '1102271284=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102271285='
      '1102271286=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '1102271287=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '1102271288=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '1102271289='
      '1102271290=  FOR SELECT SUM(ZD.SUMM)'
      '1102271291=           ,TR.PATH'
      '1102271292=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1102271293=           ,SUM(ZD.nds_summ)'
      '1102271294=      FROM ZAKAZ Z,'
      '1102271295=           ZAKAZ_DETAILS ZD,'
      '1102271296=           G_PRODUCT GP,'
      '1102271297=           P_REP_TREE TR'
      
        '1102271298=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102271299=       AND Z.IS_SPISANIE = 0'
      '1102271300=       AND Z.IS_RESERVE = 0'
      '1102271301=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102271302=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102271303=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102271304=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102271305=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102271306=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271307=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058 +
        #1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271308=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102271309=       AND ((EXISTS (SELECT 1'
      '1102271310=                       FROM SKLAD S'
      '1102271311=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1102271312=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1102271313=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102271314=              OR'
      '1102271315=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102271316=     GROUP BY TR.PATH'
      '1102271317=     ORDER BY TR.PATH'
      
        '1102271318=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, ' +
        'NDS_SUMM_'
      '1102271319=  DO BEGIN'
      '1102271320=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '1102271321='
      '1102271322=    insert into p_rep_profit_table'
      
        '1102271323=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1102271324=    values'
      '1102271325=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1102271326=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :S' +
        'UM_COST_, :PROFIT_, 0);'
      '1102271327='
      '1102271328=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1102271329=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1102271330=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1102271331=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102271332=  END'
      '1102271333='
      '1102271334=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1102271335=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1102271336=      insert into p_rep_profit_table'
      
        '1102271337=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1102271338=      values'
      
        '1102271339=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1102271340='
      
        '1102271341=  --*************************************************' +
        '****************************************'
      '1102271342=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1102271343=  ---------------------------------------------------' +
        '----'
      '1102271344=  IS_FIRST_ = 1;'
      '1102271345=  SUM_COST_ = 0;'
      '1102271346=  PROFIT_   = 0;'
      '1102271347='
      '1102271348=  FOR SELECT G.NAME,'
      '1102271349=             SUM(K.SUMM)'
      
        '1102271350=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRI' +
        'HOD_RASHOD, G_TOCHKA FROM KASSA'
      '1102271351=              UNION ALL'
      
        '1102271352=              SELECT ACTION_DATE, SUMM NAL, ACTION, G' +
        '_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1102271353=             G_PRIHOD_RASHOD G'
      
        '1102271354=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1102271355=        AND K.ACTION = 1'
      
        '1102271356=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102271357=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1102271358=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    ' +
        '-- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102271359=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1102271360=        INTO :REC_TOVAR_NAME_'
      '1102271361=             ,:SUMM_'
      '1102271362=  DO BEGIN'
      '1102271363=    IF (IS_FIRST_ = 1) then BEGIN'
      '1102271364=      INSERT INTO P_REP_PROFIT_TABLE'
      '1102271365=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1102271366=      VALUES'
      
        '1102271367=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39 +
        ', 1);'
      '1102271368='
      '1102271369=      IS_FIRST_ = 0;'
      '1102271370=    END'
      '1102271371='
      '1102271372=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102271373=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1102271374=    VALUES'
      
        '1102271375=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '1102271376='
      '1102271377=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1102271378=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1102271379=  END'
      '1102271380='
      '1102271381=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1102271382=  IF (SUM_COST_ > 0) then BEGIN'
      '1102271383=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1102271384=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102271385=    insert into p_rep_profit_table'
      
        '1102271386=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102271387=    values'
      
        '1102271388=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1102271389=  END'
      '1102271390=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1102271391=  --*************************************************' +
        '****************************************'
      '1102271392='
      
        '1102271393=  --*************************************************' +
        '****************************************'
      '1102271394=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102271395=  ---------------------------------------------------' +
        '----'
      '1102271396=  IS_FIRST_ = 1;'
      '1102271397=  PROFIT_   = 0;'
      '1102271398=  PRIHOD_ALL_  = 0;'
      '1102271399=  PRIHOD_ALL_NAL_  = 0;'
      '1102271400=  PRIHOD_ALL_BEZNAL_  = 0;'
      '1102271401='
      '1102271402=  FOR SELECT G.NAME,'
      '1102271403=             SUM(K.NAL),'
      '1102271404=             SUM(K.BEZNAL)'
      
        '1102271405=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1102271406=              UNION ALL'
      
        '1102271407=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1102271408=             G_PRIHOD_RASHOD G'
      
        '1102271409=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1102271410=        AND K.ACTION = 0'
      
        '1102271411=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102271412=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1102271413=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102271414=        AND ((:G_PRIHOD_RASHOD_ IS NULL)'
      '1102271415=             OR'
      
        '1102271416=             (G.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_ A' +
        'ND :G_PRIHOD_RASHOD_ = -100)'
      '1102271417=             OR'
      
        '1102271418=             (G.G_PRIHOD_RASHOD <> :G_PRIHOD_RASHOD_ ' +
        'AND :G_PRIHOD_RASHOD_ <> -100)'
      '1102271419=            )'
      '1102271420=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1102271421=        INTO :REC_TOVAR_NAME_'
      '1102271422=             ,:SUMM_NAL_'
      '1102271423=             ,:SUMM_BEZNAL_'
      '1102271424=  DO BEGIN'
      '1102271425=    IF (IS_FIRST_ = 1) then BEGIN'
      '1102271426=      INSERT INTO P_REP_PROFIT_TABLE'
      '1102271427=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1102271428=      VALUES'
      
        '1102271429=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39 +
        ', 1);'
      '1102271430='
      '1102271431=      IS_FIRST_ = 0;'
      '1102271432=    END'
      '1102271433='
      '1102271434=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102271435=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_' +
        'SUMM, SUMM, PROFIT, IS_HEAD)'
      '1102271436=    VALUES'
      
        '1102271437=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZN' +
        'AL_, 0);'
      '1102271438='
      '1102271439=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '1102271440=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BE' +
        'ZNAL_;'
      
        '1102271441=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      
        '1102271442=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL' +
        '_;'
      '1102271443=  END'
      '1102271444='
      '1102271445=  IF (PROFIT_ > 0) then BEGIN'
      '1102271446=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1102271447=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102271448=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1102271449=    insert into p_rep_profit_table'
      
        '1102271450=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102271451=    values'
      
        '1102271452=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1102271453=  END'
      '1102271454=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1102271455=  --*************************************************' +
        '****************************************'
      '1102271456='
      
        '1102271457=  --*************************************************' +
        '****************************************'
      '1102271458=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102271459=  --*************************************************' +
        '****************************************'
      '1102271460=  IS_FIRST_ = 1;'
      '1102271461=  SUM_COST_ = 0;'
      '1102271462=  PROFIT_   = 0;'
      
        '1102271463=  FOR SELECT SUM(ZD.SUMM)        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040 +
        #1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040 +
        #1044#1054
      '1102271464=           ,TR.PATH'
      '1102271465=      FROM ZAKAZ Z,'
      '1102271466=           ZAKAZ_DETAILS ZD,'
      '1102271467=           G_PRODUCT GP,'
      '1102271468=           P_REP_TREE TR'
      
        '1102271469=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102271470=       AND Z.IS_SPISANIE = 1'
      '1102271471=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102271472=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102271473=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102271474=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102271475=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102271476=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271477=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058 +
        #1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271478=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102271479=     GROUP BY TR.PATH'
      '1102271480=     ORDER BY TR.PATH'
      '1102271481=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '1102271482=  DO BEGIN'
      '1102271483='
      '1102271484=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1102271485=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102271486=      insert into p_rep_profit_table'
      '1102271487=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102271488=      values'
      
        '1102271489=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1102271490='
      '1102271491=      IS_FIRST_ = 0;'
      '1102271492=    END'
      '1102271493='
      '1102271494=    insert into p_rep_profit_table'
      
        '1102271495=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1102271496=    values'
      '1102271497=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1102271498=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZA' +
        'KAZ_, 0);'
      '1102271499='
      '1102271500=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '1102271501=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '1102271502=  END'
      '1102271503='
      '1102271504=  if (SUM_COST_ > 0) then BEGIN'
      '1102271505=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102271506=    insert into p_rep_profit_table'
      
        '1102271507=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102271508=    values'
      
