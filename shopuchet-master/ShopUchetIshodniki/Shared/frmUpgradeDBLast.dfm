      '1106016107=ALTER PROCEDURE G_GET_G_DISCOUNT('
      '1106016108=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT)'
      '1106016109=RETURNS ('
      '1106016110=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '1106016111=  G_PRODUCT_PAR_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '1106016112=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '1106016113=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '1106016114=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '1106016115=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '1106016116=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1106016117=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1106016118=  G_TOCHKA_ TYPE OF COLUMN G_DISCOUNT.G_TOCHKA,'
      '1106016119=  ERR_CODE INTEGER,'
      '1106016120=  ERR_MSG VARCHAR(1024))'
      '1106016121=AS'
      '1106016122=begin'
      
        '1106016123=    SELECT D.G_PRODUCT, P.G_PRODUCT_PAR, D.DATE_BEGIN' +
        ', D.DATE_END, D.NAME, D.PRICE, D.SKIDKA_PROC, D.SKIDKA_SUM, D.G_' +
        'TOCHKA'
      '1106016124=    FROM G_DISCOUNT D, G_PRODUCT P'
      '1106016125=    WHERE d.G_DISCOUNT = :G_DISCOUNT_'
      '1106016126=    and D.G_PRODUCT = P.G_PRODUCT'
      
        '1106016127=    INTO :G_PRODUCT_, :G_PRODUCT_PAR_, :DATE_BEGIN_, ' +
        ':DATE_END_, :NAME_, :PRICE_, :SKIDKA_PROC_, :SKIDKA_SUM_, :G_TOC' +
        'HKA_;'
      '1106016128=end'
      '1106016129=;'
      '1106016130='
      '1106016131=ALTER PROCEDURE G_GET_G_DISCOUNT_BY_PRODUCT('
      '1106016132=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '1106016133=RETURNS ('
      '1106016134=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1106016135=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1106016136=  IS_HAVE_SKIDKA_ VARCHAR(10),'
      '1106016137=  ERR_CODE INTEGER,'
      '1106016138=  ERR_MSG VARCHAR(1024))'
      '1106016139=AS'
      
        '1106016140=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106016141=BEGIN'
      '1106016142=    SELECT ID'
      '1106016143=      FROM CUR_PARAMS'
      '1106016144=     WHERE CUR_PARAMS = 2'
      '1106016145=      INTO :G_TOCHKA_;'
      '1106016146='
      '1106016147=    SELECT D.SKIDKA_PROC, D.SKIDKA_SUM, '#39#1045#1057#1058#1068#39
      '1106016148=    FROM G_DISCOUNT D'
      '1106016149=    WHERE D.G_PRODUCT = :G_PRODUCT_'
      
        '1106016150=      AND ((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051 +
        #1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      '1106016151=            AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '1106016152=            AND D.DATE_BEGIN IS NOT NULL AND D.DATE_E' +
        'ND IS NOT NULL'
      '1106016153=            )'
      '1106016154=            OR'
      
        '1106016155=            (D.DATE_BEGIN IS NULL AND D.DATE_END IS N' +
        'ULL)'
      '1106016156=          )'
      
        '1106016157=      AND COALESCE(D.G_TOCHKA, :G_TOCHKA_) = :G_TOCHK' +
        'A_'
      
        '1106016158=    INTO :SKIDKA_PROC_, :SKIDKA_SUM_, :IS_HAVE_SKIDKA' +
        '_;'
      '1106016159='
      '1106016160=    if (IS_HAVE_SKIDKA_ IS NULL) then'
      '1106016161=      IS_HAVE_SKIDKA_ = '#39#1053#1045#1058#39';'
      '1106016162=end'
      '1106016163=;'
      '1106016164='
      '1106016165=ALTER PROCEDURE G_GET_G_FIRM_ACCOUNT('
      '1106016166=  G_ACCOUNT_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_ACCOUNT)'
      '1106016167=RETURNS ('
      '1106016168=  ACCOUNT_ TYPE OF COLUMN G_FIRM_ACCOUNT.ACCOUNT,'
      
        '1106016169=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_FI' +
        'RM_REKVIZIT,'
      '1106016170=  G_BANK_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_BANK,'
      
        '1106016171=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_ACCOUNT.IS_DEFAUL' +
        'T,'
      '1106016172=  ERR_CODE INTEGER,'
      '1106016173=  ERR_MSG VARCHAR(1024))'
      '1106016174=AS'
