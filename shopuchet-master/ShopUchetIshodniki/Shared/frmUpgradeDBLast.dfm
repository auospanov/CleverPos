        '110752302=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058 +
        #1068#1048
      
        '110752303=            --========================================' +
        '========================='
      '110752304='
      
        '110752305=            --========================================' +
        '========================='
      '110752306=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '110752307=            --========================================' +
        '========================='
      '110752308=            PNT_ = '#39'12'#39';'
      
        '110752309=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SAL' +
        'ES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) ' +
        'THEN BEGIN'
      '110752310=                KASSA_ = NULL;'
      '110752311='
      '110752312=                SELECT S.S_VALUE'
      '110752313=                  FROM SYSTEM_SETUP S'
      '110752314=                 WHERE S.SYSTEM_SETUP = 4'
      '110752315=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '110752316='
      '110752317=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '110752318=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110752319=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110752320='
      
        '110752321=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051 +
        #1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '110752322=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) ' +
        'THEN'
      
        '110752323=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7 ' +
        '- DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKD' +
        'AY FROM CURRENT_DATE)));'
      '110752324='
      '110752325=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '110752326=                ELSE'
      
        '110752327=                   ACTION_DATE_ZP_ = Current_date - EX' +
        'TRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_dat' +
        'e - EXTRACT(DAY FROM current_date) + 32);'
      '110752328='
      '110752329=                SELECT K.KASSA, K.SUMM'
      '110752330=                FROM KASSA K'
      '110752331=                WHERE K.G_PRIHOD_RASHOD = -1'
      '110752332=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110752333=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110752334=                 AND K.G_TOCHKA = :G_TOCHKA_'
      '110752335=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110752336='
      '110752337=                IF (KASSA_ IS NULL) THEN'
      
        '110752338=                    EXECUTE PROCEDURE K_INS_KASSA(1,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110752339=                                                  -1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '110752340=                                                  :SAL' +
        'ES_COMM_SUMM_ALL_,'
      
        '110752341=                                                  :ACT' +
        'ION_DATE_ZP_,'
      
        '110752342=                                                  :OFF' +
        'ICIAL_NAME_,'
      
        '110752343=                                                  NULL' +
        ',     --:ZAKAZ_,'
      
        '110752344=                                                  NULL' +
        ',     --:SKLAD_,'
      '110752345=                                                  1,'
      
        '110752346=                                                  :G_T' +
        'OCHKA_,'
      
        '110752347=                                                  :G_O' +
        'FFICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110752348=                ELSE BEGIN'
      
        '110752349=                    EXECUTE PROCEDURE K_UPD_KASSA(:KAS' +
        'SA_,'
      
        '110752350=                                                  1,  ' +
        '   -- ACTION_'
      
        '110752351=                                                  -1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '110752352=                                                  :SAL' +
        'ES_COMM_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_ - :SALES_COMM_OLD_,'
      
        '110752353=                                                  :ACT' +
        'ION_DATE_ZP_,'
      
        '110752354=                                                  :OFF' +
        'ICIAL_NAME_,   --NOTE_'
      
        '110752355=                                                  NULL' +
        ','
      
        '110752356=                                                  NULL' +
        ','
      
        '110752357=                                                  1,  ' +
        ' --:PAYMENT_TYPE_,'
      
        '110752358=                                                  :G_O' +
        'FFICIAL_'
      
        '110752359=                                                  ) RE' +
        'TURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110752360=                END'
      '110752361=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110752362=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110752363=                  EXIT;'
      '110752364=                END'
      '110752365=            END'
      
        '110752366=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062 +
        #1059
      
        '110752367=            --========================================' +
        '========================='
      '110752368='
      '110752369=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '110752370='
      '110752371=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '110752372=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0)' +
        ' THEN'
      
        '110752373=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110752374=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 2);'
      '110752375=  END'
      '110752376=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '110752377=  ----------------------------------------------------' +
        '-----------'
      
        '110752378=  --**************************************************' +
        '***********'
      
        '110752379=  ----------------------------------------------------' +
        '-----------'
      '110752380=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110752381=  ELSE BEGIN'
      '110752382=      PNT_ = '#39'020'#39';'
      '110752383=      SELECT SP.G_TOCHKA,'
      '110752384=             SP.G_CLIENT'
      '110752385=        FROM SKLAD_PARENT SP'
      '110752386=       WHERE SP.SKLAD = :ZAKAZ_'
      '110752387=        INTO :G_TOCHKA_OLD_,'
      '110752388=             :G_TOCHKA_;'
      '110752389='
      
        '110752390=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063 +
        #1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040#1044 +
        #1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110752391=      PNT_ = '#39'021'#39';'
      '110752392=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '110752393=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, ' +
        'NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110752394=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110752395=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110752396=            EXIT;'
      '110752397=          END'
      '110752398='
      '110752399=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110752400=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110752401=                FROM ZAKAZ_DETAILS_TMP Z'
      '110752402=              INTO :G_PRODUCT_,'
      '110752403=                  :Z_AMOUNT_,'
      '110752404=                  :PRICE_,'
      '110752405=                  :SUMMM_'
      '110752406=          DO BEGIN'
      '110752407=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '110752408=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '110752409=            IS_THIS_LAST_ = 0;'
      '110752410=            SELECT MAX(SK.DATE_RECEIPT)'
      '110752411=                FROM SKLAD SK'
      '110752412=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110752413=                 AND SK.IS_LAST = 1'
      '110752414=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '110752415=                INTO :DATE_LAST_;'
      '110752416='
      
        '110752417=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALESC' +
        'E(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110752418=                UPDATE SKLAD SK'
      '110752419=                   SET SK.IS_LAST = 0'
      '110752420=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110752421=                   AND SK.IS_LAST = 1'
      '110752422=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '110752423='
      '110752424=                IS_THIS_LAST_ = 1;'
      '110752425=            END'
      '110752426='
      '110752427='
      '110752428=            INSERT INTO SKLAD'
      '110752429=            ('
      '110752430=             SKLAD,'
      '110752431=             SKLAD_PARENT,'
      '110752432=             DATE_RECEIPT,'
      '110752433=             G_CLIENT,'
      '110752434=             G_PRODUCT,'
      '110752435=             AMOUNT,'
      '110752436=             PRICE,'
      '110752437=             SUMM,'
      '110752438=             G_PAYMENT_TYPE,'
      '110752439=             OSNOVANIE,'
      '110752440=             NOTE,'
      '110752441=             NDS,'
      '110752442=             NDS_SUMM,'
      '110752443=             IS_LAST,'
      '110752444=             IS_VOZVRAT,'
      '110752445=             G_TOCHKA'
      '110752446=            ) VALUES ('
      '110752447=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '110752448=             :ZAKAZ_,'
      '110752449=             :Z_DATE_,'
      '110752450=             :G_TOCHKA_,'
      '110752451=             :G_PRODUCT_,'
      '110752452=             :Z_AMOUNT_,'
      '110752453=             :PRICE_,'
      '110752454=             :SUMMM_,'
      '110752455=             :G_PAYMENT_TYPE_,'
      '110752456=             :OSNOVANIE_,'
      '110752457=             :NOTE_,'
      '110752458=             0,  --:RNDS_,'
      '110752459=             0,  --:RNDS_SUMM_,'
      
        '110752460=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048 +
