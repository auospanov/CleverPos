        '110261046=      VALUES (12, 10, :DATE_STR, :z_date,  :ARTICUL, :' +
        'BARCODE, :NAME, :AMOUNT, :SUMM);'
      '110261047=  END'
      '110261048='
      '110261049=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '110261050=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110261051=        VALUES (13, 2, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39#39', COALESCE((SEL' +
        'ECT SUM(K.summ)'
      
        '110261052=                                                 FROM ' +
        'KASSA K'
      
        '110261053=                                                WHERE ' +
        'EXISTS (SELECT 1'
      
        '110261054=                                                      ' +
        '          FROM sklad_parent P'
      
        '110261055=                                                      ' +
