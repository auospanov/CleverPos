      '1102016047=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102016048=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
