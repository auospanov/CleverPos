        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110401682=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110401683=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110401684=                      EXIT;'
      '110401685=                    END'
      '110401686=                END'
      '110401687=            END'
      '110401688=        END'
