      '110240808=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '110240809='
      
        '110240810=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || EX' +
        'TRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM ACT' +
        'ION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39';'
      '110240811='
      '110240812=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
