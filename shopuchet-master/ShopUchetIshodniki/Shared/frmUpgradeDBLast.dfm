      '110197783=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '110197784=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110197785=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110197786=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110197787=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110197788=RETURNS ('
      '110197789=  ERR_CODE INTEGER,'
      '110197790=  ERR_MSG VARCHAR(1024))'
      '110197791=AS'
      
        '110197792=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODU' +
        'CT'#39';'
      '110197793=DECLARE VARIABLE CNT_ INTEGER;'
      '110197794=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110197795=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110197796=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110197797=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110197798=BEGIN'
      '110197799=  /*IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110197800=                FROM G_PRODUCT'
      
        '110197801=               WHERE G_PRODUCT_PAR = :G_PRODUCT_)) the' +
        'n BEGIN'
      '110197802=    ERR_CODE = -20500;'
      
        '110197803=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076 +
        #1072#1083#1080#1090#1100' '#1076#1072#1085#1085#1091#1102' '#1075#1088#1091#1087#1087#1091', '#1090'.'#1082'. '#1074' '#1085#1077#1081' '#1089#1086#1089#1090#1086#1103#1090' '#1090#1086#1074#1072#1088#1099'/'#1075#1088#1091#1087#1087#1099'. '#1059#1076#1072#1083#1080#1090#1077' '#1074 +
        #1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110197804=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110197805=    EXIT;'
