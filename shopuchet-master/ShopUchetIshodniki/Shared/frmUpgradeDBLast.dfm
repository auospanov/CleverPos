        '2.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '110682119=     AND I.ADDRESS = FD.G_ADDRESS'
      '110682120=     AND I.IIK = FC.G_ACCOUNT'
      '110682121=     AND FC.G_BANK = FB.G_BANK'
      '110682122=     AND I.G_PAYMENT_TYPE = GP.G_PAYMENT_TYPE'
      '110682123=     AND I.G_OFFICIAL = IO.G_OFFICIAL'
      '110682124=     AND IO.G_APPOINTMENT = AP.G_APPOINTMENT'
      '110682125=   INTO  :POSTAVSHIK_NAME_,'
