      '1101824700='
      '1101824701=ALTER PROCEDURE UPD_SKLAD('
      '1101824702=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101824703=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1101824704=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1101824705=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1101824706=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1101824707=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101824708=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101824709=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101824710=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1101824711=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101824712=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101824713=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1101824714=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1101824715=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1101824716=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101824717=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101824718=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101824719=RETURNS ('
      '1101824720=  ERR_CODE INTEGER,'
      '1101824721=  ERR_MSG VARCHAR(1024))'
      '1101824722=AS'
      
        '1101824723=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1101824724=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1101824725=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101824726=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101824727=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1101824728=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101824729=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101824730=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1101824731=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1101824732=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1101824733=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101824734=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1101824735=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101824736=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1101824737=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101824738=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1101824739=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1101824740=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101824741=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1101824742=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101824743=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101824744=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101824745=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101824746=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101824747=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101824748=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101824749=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101824750=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101824751=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101824752=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101824753=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1101824754=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1101824755=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1101824756=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      '1101824757=BEGIN'
      '1101824758='
      '1101824759=  IS_THIS_LAST_ = 0;'
      '1101824760='
      '1101824761=  SELECT S.G_TOCHKA,'
      '1101824762=         S.IS_VOZVRAT,'
      '1101824763=         S.G_PAYMENT_TYPE'
      '1101824764=         ,S.is_expected'
      '1101824765=    FROM SKLAD_parent S'
      '1101824766=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1101824767=    INTO :G_TOCHKA_,'
      '1101824768=         :IS_VOZVRAT_,'
      '1101824769=         :G_PAYMENT_TYPE_OLD_'
      '1101824770=         ,:IS_EXPECTED_OLD_;'
      '1101824771='
      '1101824772=  PNT_ = '#39'00'#39';'
      '1101824773=  UPDATE SKLAD_PARENT'
      '1101824774=  SET'
      
        '1101824775=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1101824776=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1101824777=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1101824778=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1101824779=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101824780=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101824781=   SUMM      = :SUMM_,'
      '1101824782=   SUMM_FACT = :SUMM_FACT_,'
      '1101824783=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1101824784=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0) ' +
        ' -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054 +
        ' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101824785=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '1101824786=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1101824787='
      
        '1101824788=  ---------------------------------------------------' +
        '----------'
      
        '1101824789=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1101824790=  PNT_ = '#39'02'#39';'
      '1101824791=  FOR SELECT SKLAD'
      '1101824792=        FROM SKLAD S'
      '1101824793=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101824794=         AND NOT EXISTS (SELECT 1'
      '1101824795=                           FROM SKLAD_TMP T'
      '1101824796=                        WHERE T.SKLAD = S.SKLAD)'
      '1101824797=  INTO :SKLAD_'
      '1101824798=  DO BEGIN'
      
        '1101824799=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1101824800=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101824801=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101824802=      EXIT;'
      '1101824803=    END'
      '1101824804=  END'
      '1101824805='
      
        '1101824806=  ---------------------------------------------------' +
        '----------'
      
        '1101824807=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1101824808=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1101824809=  PNT_ = '#39'03'#39';'
      '1101824810=  FOR SELECT S.SKLAD,'
      '1101824811=             S.G_PRODUCT,'
      '1101824812=             S.AMOUNT,'
      '1101824813=             S.PRICE,'
      '1101824814=             S.SUMM,'
      '1101824815=             S.NDS,'
      '1101824816=             S.NDS_SUMM,'
      '1101824817=             T.SKLAD,'
      '1101824818=             T.AMOUNT,'
      '1101824819=             T.IS_LAST,'
      '1101824820=             T.DATE_RECEIPT'
      '1101824821=             ,S.PRICE_CURRENCY'
      '1101824822=             ,S.SUMM_CURRENCY'
      '1101824823=             ,S.PRICE_ROZN'
      
        '1101824824=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1101824825=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1101824826=  INTO :SKLAD_,'
      '1101824827=       :G_PRODUCT_,'
      '1101824828=       :AMOUNT_,'
      '1101824829=       :PRICE_,'
      '1101824830=       :SUMM_ONE_,'
      '1101824831=       :NDS_,'
      '1101824832=       :NDS_SUMM_,'
      '1101824833=       :SKLAD_OLD_,'
      '1101824834=       :AMOUNT_OLD_,'
      '1101824835=       :IS_THIS_LAST_,'
      '1101824836=       :DATE_RECEIPT_OLD_'
      '1101824837=       ,:PRICE_CURRENCY_'
      '1101824838=       ,:SUMM_CURRENCY_TMP_'
      '1101824839=       ,:SALE_PRICE_'
      '1101824840=       ,:SALE_PRICE_CUR_'
      '1101824841=  DO BEGIN'
      
        '1101824842=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101824843=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1101824844=        PNT_ = '#39'04'#39';'
      
        '1101824845=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1101824846=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1101824847=                          ,PRICE_CURRENCY'
      '1101824848=                          ,SUMM_CURRENCY)'
      
        '1101824849=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1101824850=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101824851=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1101824852=               ,:PRICE_CURRENCY_'
      '1101824853=               ,:SUMM_CURRENCY_TMP_'
      '1101824854=               );'
      '1101824855='
      
        '1101824856=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1101824857=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1101824858=            UPDATE LT_SKLAD_PRODUCT L'
      '1101824859=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1101824860=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101824861=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101824862=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101824863='
      '1101824864=            IF (ROW_COUNT = 0) THEN'
      
        '1101824865=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1101824866=        END'
      '1101824867='
      
        '1101824868=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101824869=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1101824870=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1101824871=        PNT_ = '#39'05'#39';'
      '1101824872=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1101824873=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101824874=              FROM SKLAD SK'
      '1101824875=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101824876=               AND SK.IS_LAST = 1'
      '1101824877=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101824878=              INTO :DATE_LAST_;'
      '1101824879='
      
        '1101824880=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101824881=              UPDATE SKLAD SK'
      '1101824882=                 SET SK.IS_LAST = 0'
      '1101824883=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101824884=                 AND SK.IS_LAST = 1'
      '1101824885=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101824886='
      '1101824887=              UPDATE SKLAD SK'
      '1101824888=                 SET SK.IS_LAST = 1'
      '1101824889=               WHERE SK.SKLAD = :SKLAD_;'
      '1101824890=            END'
      '1101824891=        END'
      
        '1101824892=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101824893=    END ELSE BEGIN'
      '1101824894=        PNT_ = '#39'06'#39';'
      '1101824895=        UPDATE SKLAD S'
      '1101824896=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1101824897=               S.G_CLIENT = :G_CLIENT_,'
      '1101824898=               S.AMOUNT   = :AMOUNT_,'
      '1101824899=               S.PRICE    = :PRICE_,'
      '1101824900=               S.SUMM     = :SUMM_ONE_,'
      '1101824901=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101824902=               S.NDS      = :NDS_,'
      '1101824903=               S.NDS_SUMM = :NDS_SUMM_,'
      '1101824904=               S.OSNOVANIE = :OSNOVANIE_,'
      '1101824905=               S.NOTE      = :NOTE_'
      '1101824906=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1101824907=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1101824908=         WHERE S.SKLAD = :SKLAD_;'
      '1101824909='
      '1101824910=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1101824911=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_ AND IS_EX' +
        'PECTED_ = 0) THEN BEGIN'
      '1101824912=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1101824913=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1101824914=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_),'
      
        '1101824915=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1101824916=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101824917=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101824918='
      '1101824919=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1101824920=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1101824921=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_),'
      
        '1101824922=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1101824923=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101824924=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101824925=        END'
      
        '1101824926=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1101824927=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1101824928=            UPDATE LT_SKLAD_PRODUCT L'
      '1101824929=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1101824930=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101824931=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101824932=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101824933='
      '1101824934=            IF (ROW_COUNT = 0) THEN'
      
        '1101824935=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1101824936=        END'
      
        '1101824937=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1101824938=        ELSE IF (IS_EXPECTED_OLD_ = 0 AND IS_EXPECTED' +
        '_ = 1) THEN BEGIN'
      '1101824939=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1101824940=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_,'
      
        '1101824941=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101824942=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101824943=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101824944=        END'
      '1101824945='
      
        '1101824946=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1101824947=        PNT_ = '#39'07'#39';'
      
        '1101824948=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1101824949=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101824950=              FROM SKLAD SK'
      '1101824951=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101824952=               AND SK.IS_LAST = 1'
      '1101824953=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101824954=              INTO :DATE_LAST_;'
      '1101824955='
      
        '1101824956=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101824957=              UPDATE SKLAD SK'
      '1101824958=                 SET SK.IS_LAST = 0'
      '1101824959=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101824960=                 AND SK.IS_LAST = 1'
      '1101824961=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101824962='
      '1101824963=              UPDATE SKLAD SK'
      '1101824964=                 SET SK.IS_LAST = 1'
      '1101824965=               WHERE SK.SKLAD = :SKLAD_;'
      '1101824966=            END'
      '1101824967=        END'
      '1101824968='
      
        '1101824969=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1101824970=        PNT_ = '#39'08'#39';'
      
        '1101824971=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1101824972=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101824973=              FROM SKLAD SK'
      '1101824974=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101824975=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1101824976=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101824977=               AND SK.is_vozvrat IN (0,4)'
      '1101824978=              INTO :DATE_LAST_;'
      '1101824979='
      
        '1101824980=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101824981=              UPDATE SKLAD SK'
      '1101824982=                 SET SK.IS_LAST = 0'
      '1101824983=               WHERE SK.SKLAD = :SKLAD_;'
      '1101824984='
      '1101824985=               UPDATE SKLAD SK'
      '1101824986=                 SET SK.IS_LAST = 1'
      '1101824987=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101824988=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1101824989=                                   FROM SKLAD SS'
      
        '1101824990=                                  WHERE SS.G_PRODUCT ' +
        '= SK.G_PRODUCT'
      
        '1101824991=                                    AND SS.DATE_RECEI' +
        'PT = :DATE_LAST_'
      
        '1101824992=                                    AND SS.G_TOCHKA =' +
        ' :G_TOCHKA_'
      
        '1101824993=                                    AND SS.is_vozvrat' +
        ' IN (0,4));'
      '1101824994='
      '1101824995=            END'
      
        '1101824996=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054 +
        #1052' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' ' +
        #1053#1048#1052'.'
      
        '1101824997=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059 +
        #1044#1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '1101824998=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THI' +
        'S_LAST_ = 1)) THEN BEGIN'
      '1101824999=              UPDATE SKLAD SK'
      '1101825000=                 SET SK.IS_LAST = 1'
      '1101825001=               WHERE SK.SKLAD = :SKLAD_;'
      '1101825002=            END'
      '1101825003=        END'
      '1101825004=    END'
      '1101825005='
      
        '1101825006=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '1101825007=      UPDATE G_PRODUCT G'
      '1101825008=         SET G.PRICE = :SALE_PRICE_'
      '1101825009=       WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101825010=  END'
      '1101825011='
      
        '1101825012=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057 +
        #1057#1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '1101825013=      ----------------------------------------'
      
        '1101825014=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1055#1056#1048#1061#1054#1044#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101825015=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052'  - '#1058#1045#1055#1045#1056#1068' '#1069#1058#1054' '#1044#1045#1051#1040#1045#1058#1057#1071' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' K_UPD_KASSA'
      '1101825016=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101825017=      -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' ' +
        #1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054 +
        #1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101825018=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057 +
        #1058#1042#1045#1053#1053#1054')'
      
        '1101825019=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101825020=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101825021='
      
        '1101825022=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056 +
        ' '#1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '1101825023=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053 +
        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1101825024=      IF (IS_VOZVRAT_ = 0) THEN'
      '1101825025=        G_PRIHOD_RASHOD_ = 2;'
      '1101825026=      ELSE'
      '1101825027=        G_PRIHOD_RASHOD_ = 3;'
      '1101825028='
      '1101825029=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1101825030=            PNT_ = '#39'09'#39';'
      '1101825031=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1101825032=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101825033=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101825034=            ELSE'
      
        '1101825035=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101825036='
      '1101825037=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101825038=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101825039='
      
        '1101825040=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1101825041=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1101825042=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101825043=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1101825044=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1101825045=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1101825046=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101825047=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1101825048=                                              :SKLAD_' +
        'PARENT_,'
      
        '1101825049=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1101825050=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101825051='
      
        '1101825052=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101825053=            ELSE BEGIN'
      
        '1101825054=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101825055=                SELECT 1'
      '1101825056=                  FROM KASSA K'
      '1101825057=                 WHERE K.KASSA = :KASSA_'
      '1101825058=                UNION ALL'
      '1101825059=                SELECT 2'
      '1101825060=                  FROM KASSA_BEZNAL KB'
      '1101825061=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101825062=                 INTO :PAYMENT_TYPE_OLD_;'
      '1101825063='
      
        '1101825064=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101825065=                      PNT_ = '#39'010'#39';'
      
        '1101825066=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1101825067=                                                    1' +
        ',     -- ACTION_'
      
        '1101825068=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1101825069=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1101825070=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1101825071=                                                    N' +
        'ULL,   --NOTE_'
      
        '1101825072=                                                    N' +
        'ULL,  --ZAKAZ'
      
        '1101825073=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1101825074=                                                    :' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101825075='
      
        '1101825076=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101825077=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101825078=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101825079=                      PNT_ = '#39'011'#39';'
      
        '1101825080=                      EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '1101825081=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825082=                        ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101825083=                        EXIT;'
      '1101825084=                      END'
      '1101825085='
      
        '1101825086=                      EXECUTE PROCEDURE K_INS_KASSA(1' +
        ',     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101825087=                                                    :' +
        'G_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1101825088=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1101825089=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1101825090=                                                    N' +
        'ULL,   --NOTE_ => :NOTE_,'
      
        '1101825091=                                                    N' +
        'ULL,   --ZAKAZ_'
      
        '1101825092=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1101825093=                                                    :' +
        'PAYMENT_TYPE_,'
      
        '1101825094=                                                    :' +
        'G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101825095=                END'
      '1101825096=            END'
      '1101825097=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825098=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101825099=              EXIT;'
      '1101825100=            END'
      '1101825101='
      
        '1101825102=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101825103=      END'
      '1101825104='
      
        '1101825105=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101825106=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101825107=            FROM KASSA K'
      '1101825108=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101825109=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1101825110=           UNION'
      '1101825111=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1101825112=            FROM KASSA K'
      '1101825113=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101825114=             AND K.SUMM = 0'
      '1101825115=          UNION'
      '1101825116=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101825117=            FROM KASSA_BEZNAL K'
      '1101825118=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101825119=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1101825120=          UNION'
      '1101825121=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101825122=            FROM KASSA_BEZNAL K'
      '1101825123=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101825124=             AND K.SUMM = 0'
      '1101825125=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101825126=      DO BEGIN'
      '1101825127=        PNT_ = '#39'011A'#39';'
      
        '1101825128=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101825129=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825130=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101825131=          EXIT;'
      '1101825132=        END'
      '1101825133=      END'
      '1101825134=  END'
      '1101825135='
      
        '1101825136=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1101825137=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101825138=    SELECT K.KASSA'
      '1101825139=      FROM KASSA K'
      '1101825140=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101825141=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101825142=      INTO :KASSA_POP_;'
      '1101825143=  ELSE'
      '1101825144=    SELECT K.KASSA_BEZNAL'
      '1101825145=      FROM KASSA_BEZNAL K'
      '1101825146=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101825147=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101825148=       INTO :KASSA_POP_;'
      '1101825149='
      
        '1101825150=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1101825151=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1101825152=      PNT_ = '#39'012'#39';'
      '1101825153=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1101825154=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1101825155=                                          1,     -- A' +
        'CTION_'
      '1101825156=                                          :G_PRIHOD_,'
      
        '1101825157=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101825158=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101825159=                                          NULL,   --N' +
        'OTE_'
      '1101825160=                                          NULL,'
      
        '1101825161=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101825162=                                          :G_PAYMENT_' +
        'TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101825163=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101825164=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101825165=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1101825166=                                          :G_PRIHOD_,'
      
        '1101825167=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101825168=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101825169=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1101825170=                                          NULL,'
      
        '1101825171=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101825172=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101825173=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101825174=      END'
      '1101825175=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825176=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101825177=        EXIT;'
      '1101825178=      END'
      '1101825179='
      
        '1101825180=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101825181=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101825182=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101825183=        PNT_ = '#39'013'#39';'
      
        '1101825184=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101825185=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825186=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101825187=          EXIT;'
      '1101825188=        END'
      '1101825189=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101825190=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1101825191=                                          :G_PRIHOD_,'
      
        '1101825192=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101825193=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101825194=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1101825195=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1101825196=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101825197=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101825198=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101825199=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825200=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101825201=              EXIT;'
      '1101825202=            END'
      '1101825203=        END'
      '1101825204=  END'
      '1101825205='
      '1101825206=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101825207=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ IN (0,1)' +
        ') THEN'
      
        '1101825208=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101825209=    SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PAR' +
        'ENT_, 2'
      '1101825210=      FROM RDB$DATABASE'
      
        '1101825211=     WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP ' +
        'WHERE AP.OBJECT_TYPE = 2 AND AP.ID = :SKLAD_PARENT_ AND AP.IS_LO' +
        'ADING = 0);'
      '1101825212='
      '1101825213=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101825214=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_PARENT_, :DATE_RECEIPT_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1101825215=end'
      '1101825216=;'
      '1101825217='
      '1101825218=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1101825219=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101825220=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101825221=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101825222=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101825223=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101825224=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101825225=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101825226=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101825227=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101825228=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101825229=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101825230=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101825231=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101825232=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101825233=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101825234=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101825235=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101825236=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101825237=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101825238=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1101825239=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1101825240=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101825241=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101825242=RETURNS ('
      '1101825243=  ERR_CODE INTEGER,'
      '1101825244=  ERR_MSG VARCHAR(1024))'
      '1101825245=AS'
      '1101825246=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1101825247='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1101825248=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1101825249=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1101825250='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1101825251=*/'
      
        '1101825252=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1101825253=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101825254=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101825255=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1101825256=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101825257=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1101825258=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1101825259=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
