        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102462094=         3,  --:IS_VOZVRAT_,'
      '1102462095=         :G_CLIENT_'
      '1102462096=        );'
      '1102462097='
      
        '1102462098=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102462099=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102462100=        PNT_ = '#39'02'#39';'
      '1102462101=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102462102=            UPDATE LT_SKLAD_PRODUCT L'
      '1102462103=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102462104=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102462105=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102462106=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102462107='
      '1102462108=            IF (ROW_COUNT = 0) THEN'
      
        '1102462109=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102462110=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102462111=        END'
      '1102462112=      END'
      '1102462113=  END'
      '1102462114='
      '1102462115=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102462116='
      
        '1102462117=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102462118=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102462119=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102462120=                                  G_PRIHOD_,'
      '1102462121=                                  :SUMM_PRIHOD_,'
      '1102462122=                                  :Z_DATE_,'
      
        '1102462123=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
