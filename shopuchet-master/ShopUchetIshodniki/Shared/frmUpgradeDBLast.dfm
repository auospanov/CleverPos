      '11096384=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11096385=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_' +
        '||'#39' '#39'||ERR_MSG;'
