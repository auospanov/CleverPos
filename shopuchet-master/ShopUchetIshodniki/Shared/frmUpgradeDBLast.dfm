      '110243759=  SUMM_BONUS_ VARCHAR(50),'
      '110243760=  SUMM_SDACH_ VARCHAR(50),'
      '110243761=  SUMM_STR_ VARCHAR(200),'
      '110243762=  SLOGAN_ VARCHAR(80),'
      '110243763=  SUMM_SKIDKA_ VARCHAR(50),'
      '110243764=  SUMM_SERVICE_ VARCHAR(50),'
      '110243765=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110243766=  BONUS_STR_ VARCHAR(100),'
      '110243767=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110243768=  ERR_CODE NUMERIC(15,2),'
      '110243769=  ERR_MSG VARCHAR(1024),'
      '110243770=  NAME_MARKER VARCHAR(1000),'
      '110243771=  BONUSALL_STR_ VARCHAR(100))'
      '110243772=AS'
      '110243773=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045
      '110243774='
      '110243775=26.09.2022'
      
        '110243776='#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1054#1041#1065#1040#1071' '#1057#1050#1048#1044#1050#1040' '#1042' '#1050#1054#1053#1062#1045' '#1063#1045#1050#1040', '#1063#1058#1054' '#1041#1067#1051#1054' ' +
        #1053#1045#1059#1044#1054#1041#1053#1054', '#1053#1045#1055#1054#1053#1071#1058#1053#1054' '#1053#1040' '#1050#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1041#1067#1051#1040' '#1057#1050#1048#1044#1050#1040
      
        '110243777='#1058#1045#1055#1045#1056#1068' '#1046#1045' '#1057#1050#1048#1044#1050#1040' '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1055#1054#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1054#1042#1040#1056#1054#1052'. '#1048#1057#1061#1054#1044#1071 +
        ' '#1048#1047' '#1069#1058#1054#1043#1054' '#1053#1045#1050#1054#1058#1054#1056#1067#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1067#1045' '#1059#1055#1056#1040#1047#1044#1053#1048#1051#1048#1057#1068
      '110243778='
      
        '110243779='#1058#1045#1055#1045#1056#1068' '#1057#1058#1056#1054#1050#1040' "'#1057#1059#1052#1052#1040'" '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1041#1067#1051#1054' '#1044#1054#1041#1040 +
        #1042#1051#1045#1053#1054' "'#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%"'
      '110243780='
      
        '110243781=SUMM_VSEGO_ - '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054#1050 +
        ', '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '110243782=SUMM_VSEGO_WITHOUT_SERVICE_ - '#1058#1045#1055#1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053 +
        #1053#1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '110243783='
      '110243784='
      
        '110243785=SUMM_POLUCH_  - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1055#1054#1051#1059#1063#1045#1053#1054' ' +
        #1054#1058' '#1050#1051#1048#1045#1053#1058#1040' '#1053#1040#1051#1048#1063#1053#1067#1052#1048' = SUMM_DANO_, '#1055#1056#1048#1061#1054#1044#1048#1058' '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040
      
        '110243786=SUMM_NONCASH_ - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1054#1055#1051#1040#1063#1045#1053#1054' ' +
        #1055#1054' '#1041#1045#1047#1053#1040#1051#1059
      '110243787=SUMM_BONUS_   - '#1057#1050#1054#1051#1068#1050#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1041#1054#1053#1059#1057#1040#1052#1048
      '110243788='
      
        '110243789=PAYMENT_TYPE_ - '#1059#1055#1056#1040#1047#1044#1053#1045#1053#1040', '#1058'.'#1050'. '#1057#1058#1056#1054#1050#1040' "'#1057#1055#1054#1057#1054#1041' '#1054#1055#1051#1040#1058#1067 +
        '" '#1059#1041#1056#1040#1053#1040', '#1058#1045#1055#1045#1056#1068' '#1042#1053#1048#1047#1059' '#1041#1059#1044#1045#1058' '#1044#1042#1045' '#1057#1058#1056#1054#1050#1048':'
      '110243790="'#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '110243791="'#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '110243792=*/'
      '110243793=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '110243794=DECLARE VARIABLE PNT_ VARCHAR(5) = '#39'00'#39';'
      '110243795=DECLARE VARIABLE I INTEGER = 1;'
      
        '110243796=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110243797=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110243798=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.AMOUNT;'
      
        '110243799=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.SUMM;'
      '110243800=BEGIN'
      '110243801=  SLOGAN_ = PRINT_SLOGAN_;'
      '110243802=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '110243803=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '110243804=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_' +
        ';'
      '110243805=  END'
      '110243806='
      '110243807=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110243808=  SELECT z.ZAKAZ'
      '110243809=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '110243810=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')' +
        '||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '110243811=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '110243812=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COAL' +
        'ESCE(O.NM, '#39#39')'
      '110243813=         ,Z.NOTE'
      
        '110243814=         ,CAST(ROUND(Z.summ_noncash, 2) AS VARCHAR(100' +
        '))'
      '110243815=         ,CAST(ROUND(:SUMM_DANO_, 2) AS VARCHAR(100))'
      
        '110243816=         ,CAST(ROUND(:SUMM_SDACHA_, 2) AS VARCHAR(100)' +
        ')'
      '110243817=         ,CAST(ROUND(Z.SUMM_BONUS, 2) AS VARCHAR(100))'
      
        '110243818=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '110243819=         G_CLIENT G,'
      '110243820=         G_PAYMENT_TYPE P'
      '110243821=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110243822=     AND Z.G_CLIENT = G.G_CLIENT'
      '110243823=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110243824=    INTO :NUM_'
      '110243825=        ,:PAYMENT_TYPE_'
      '110243826=        ,:DATE_'
      '110243827=        ,:G_CLIENT_NAME_'
      '110243828=        ,:G_OFFICIAL_FM_'
      '110243829=        ,:NOTE_'
      '110243830=        ,:SUMM_NONCASH_'
      '110243831=        ,:SUMM_POLUCH_'
      '110243832=        ,:SUMM_SDACH_'
      '110243833=        ,:SUMM_BONUS_'
      '110243834=        ;'
      '110243835='
      '110243836=  --'#1041#1054#1053#1059#1057#1067' '#1042' '#1063#1045#1050#1045
      '110243837=  IF (BONUS_ > 0) THEN'
      '110243838=  BEGIN'
      
        '110243839=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_, 2) AS VARCHAR(100));'
      '110243840=  END'
      '110243841='
      '110243842=  if (BONUS_ALL_ > 0) then'
      '110243843=  BEGIN'
      
        '110243844=    BONUSALL_STR_ = '#39#1042#1089#1077#1075#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(BO' +
        'NUS_ALL_, 2) AS VARCHAR(100));'
      '110243845=  END'
      '110243846='
      '110243847=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110243848=  --IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110243849=  --  PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110243850='
      '110243851=  SELECT R.G_FIRM_REKVIZIT,'
      '110243852=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110243853=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110243854=    FROM G_FIRM_REKVIZIT R'
      '110243855=   WHERE R.is_default = 1'
      '110243856=    INTO :G_FIRM_REKVIZIT_,'
      '110243857=         :FIRM_NAME_,'
      '110243858=         :FIRM_IDN_;'
      '110243859='
      '110243860=  SELECT ZD.SUMM'
      '110243861=    FROM ZAKAZ_DETAILS ZD'
      '110243862=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110243863=    AND ZD.G_PRODUCT = -2'
      '110243864=    INTO :SERVICE_SUMM_;'
      '110243865=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110243866='
      '110243867=  SELECT SUM(ZD.AMOUNT),'
      
        '110243868=         CAST(ROUND(SUM((CASE WHEN ZD.DISCOUNT_SUMM>0 ' +
        'THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)),'
      
        '110243869=         CAST(ROUND(SUM(ZD.SUMM + (CASE WHEN ZD.DISCOU' +
        'NT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50))' +
        ','
      '110243870=         CAST(SUM(ZD.SUMM) AS VARCHAR(50)),'
      
        '110243871=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110243872=         CAST(:SERVICE_SUMM_  AS VARCHAR(50)),'
      '110243873=         CAST(SUM(ZD.NDS_SUMM) AS VARCHAR(50))'
      '110243874=  FROM ZAKAZ_DETAILS ZD'
      '110243875=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110243876=    AND ZD.G_PRODUCT <> -2'
      '110243877=  INTO :AMOUNT_VSEGO_NUM_,'
      '110243878=       :SUMM_SKIDKA_,'
      
        '110243879=       :SUMM_VSEGO_,     -- 26.09.2022 '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040 +
        #1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054#1050', '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042#1057 +
        #1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '110243880=       :SUMM_VSEGO_WITHOUT_SERVICE_, -- 26.09.2022 '#1058#1045#1055 +
        #1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '110243881=       :SUMM_VSEGO_N_,'
      '110243882=       :SUMM_SERVICE_,'
      '110243883=       :SUMM_NDS_;'
      '110243884='
      '110243885=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110243886=    FROM G_FIRM_ADDRESS R'
      '110243887=   WHERE R.IS_DEFAULT = 1'
      '110243888=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110243889=    INTO :FIRM_ADDRESS_;'
      '110243890='
      
        '110243891=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110243892=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110243893=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110243894=    IF (CURRENCY_ = 0) THEN'
      '110243895=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110243896=    ELSE'
      '110243897=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110243898=  END'
      '110243899='
      '110243900=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110243901='
      '110243902=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110243903=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110243904=  INTO :SUMM_STR_;'
      '110243905='
      '110243906=  FOR'
      '110243907=    SELECT :I || '#39'. '#39' || G.NAME,'
      
        '110243908=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.MA' +
        'RK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||Z' +
        'D.MARK_CODE END),'
      
        '110243909=           (CASE WHEN (G.ARTICUL is null) or (G.ARTICU' +
        'L = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '110243910=           ZD.AMOUNT,'
      
        '110243911=           CAST(ROUND(ZD.PRICE - (CASE WHEN ZD.DISCOUN' +
        'T_SUMM<0 THEN ZD.DISCOUNT_SUMM else 0 END)/ZD.AMOUNT, 2) AS VARC' +
        'HAR(100)),'
      
        '110243912=           CAST(ROUND(ZD.SUMM + (CASE WHEN ZD.DISCOUNT' +
        '_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END) , 2) AS VARCHAR(100))'
      '110243913=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110243914=           ,CAST(ZD.PRICE - ZD.DISCOUNT_TENGE AS VARCH' +
        'AR(100))'
      '110243915=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110243916=           ,CAST(ZD.DISCOUNT_SUMM AS VARCHAR(100))'
      '110243917=      FROM ZAKAZ Z,'
      '110243918=           ZAKAZ_DETAILS ZD,'
      '110243919=           G_PRODUCT G,'
      '110243920=           G_UNIT U'
      '110243921=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110243922=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110243923=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110243924=       AND G.G_UNIT = U.G_UNIT'
      '110243925=       AND G.G_PRODUCT <> -2'
      '110243926=     ORDER BY ZD.zakaz_details'
      '110243927=    INTO :NAME,'
      '110243928=        :NAME_MARKER,'
      '110243929=        :NAME_ART,'
      '110243930=        :AMOUNT_NUM_,'
      '110243931=        :PRICE,'
      '110243932=        :SUMM'
      '110243933=        ,:SHORT_NAME'
      '110243934=        ,:PRICE_N'
      '110243935=        ,:SUMM_N'
      '110243936=        ,:DISCOUNT'
      '110243937='
      '110243938=  DO BEGIN'
      '110243939=    I = I + 1;'
      '110243940='
      
        '110243941=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110243942=    /*if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110243943=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110243944=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110243945=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110243946=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110243947=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110243948=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110243949=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110243950=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110243951=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110243952=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110243953=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110243954=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110243955=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110243956=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110243957=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110243958=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110243959=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110243960=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110243961=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110243962=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110243963=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);*/'
      '110243964='
      '110243965=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110243966=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110243967=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110243968=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110243969=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110243970=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110243971=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110243972=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110243973=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110243974=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110243975=    END ELSE BEGIN'
      '110243976=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110243977=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110243978=    END'
      '110243979='
      
        '110243980=    --if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMO' +
        'UNT) > 0) then'
      
        '110243981=    --  AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR P' +
        'OSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110243982='
      
        '110243983=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110243984=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110243985='
      
        '110243986=    SUMM_TXT = AMOUNT || '#39' x '#39' || PRICE_N || '#39' = '#39' || ' +
        'SUMM_N;'
      '110243987='
      '110243988=    SUSPEND;'
      '110243989=  END'
      '110243990=WHEN ANY DO BEGIN'
      '110243991=    Err_code = -20500;'
      
        '110243992=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110243993=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110243994=  END'
      '110243995=end'
      '110243996=;'
      '110243997='
      '110243998=ALTER PROCEDURE P_REP_REVISION('
      
        '110243999=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT)'
      '1102431000=RETURNS ('
      
        '1102431001=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102431002=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102431003=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102431004=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102431005=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102431006=  TOVAROV_CNT_ TYPE OF COLUMN REVISION.AMOUNT_BD,'
      '1102431007=  TOVAROV_NAME_CNT_ INTEGER,'
      
        '1102431008=  SPISANO_TOVAROV_CNT_ TYPE OF COLUMN REVISION.AMOUNT' +
        '_BD,'
      '1102431009=  SPISANO_TOVAROV_NAME_CNT_ INTEGER,'
      
        '1102431010=  PRIHOD_TOVAROV_CNT_ TYPE OF COLUMN REVISION.AMOUNT_' +
        'BD,'
      '1102431011=  PRIHOD_TOVAROV_NAME_CNT_ INTEGER,'
      '1102431012=  IZLISHKI_SUMM_ MY_NUMERIC,'
      '1102431013=  IZLISHKI_ZAKUP_SUMM_ MY_NUMERIC,'
      '1102431014=  POTERI_SUMM_ MY_NUMERIC,'
      '1102431015=  POTERI_ZAKUP_SUMM_ MY_NUMERIC,'
      '1102431016=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102431017=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102431018=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102431019=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102431020=  AMOUNT_BD TYPE OF COLUMN REVISION.AMOUNT_BD,'
      '1102431021=  AMOUNT_REAL TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '1102431022=  DIFF_SUMM TYPE OF COLUMN REVISION.AMOUNT_BD)'
      '1102431023=AS'
      '1102431024=/*'
      '1102431025='#1054#1058#1063#1045#1058' '#1055#1054' '#1056#1045#1042#1048#1047#1048#1048
      '1102431026=*/'
      '1102431027=DECLARE VARIABLE SORT_COL INTEGER;'
      '1102431028=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '1102431029=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '1102431030=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '1102431031=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102431032=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102431033=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '1102431034=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      '1102431035=BEGIN'
      '1102431036='
      '1102431037=  SELECT T.DATE_BEGIN,'
      '1102431038=         T.TIME_BEGIN,'
      '1102431039=         T.DATE_END,'
      '1102431040=         T.TIME_END,'
      '1102431041=         T.NOTE,'
      
        '1102431042=         (SELECT SUM(R.AMOUNT_REAL) FROM REVISION R W' +
        'HERE R.REVISION_PARENT = T.REVISION_PARENT) SUMM,'
      
        '1102431043=         (SELECT COUNT(1) FROM REVISION WHERE REVISIO' +
        'N_PARENT = T.REVISION_PARENT),'
      
        '1102431044=         (SELECT SUM(AMOUNT) FROM ZAKAZ_DETAILS WHERE' +
        ' ZAKAZ = T.ZAKAZ),'
      
        '1102431045=         (SELECT COUNT(1) FROM ZAKAZ_DETAILS WHERE ZA' +
        'KAZ = T.ZAKAZ),'
      
        '1102431046=         (SELECT SUM(AMOUNT) FROM SKLAD WHERE SKLAD_P' +
        'ARENT = T.SKLAD_PARENT),'
      
        '1102431047=         (SELECT COUNT(1) FROM SKLAD WHERE SKLAD_PARE' +
        'NT = T.SKLAD_PARENT)'
      '1102431048=    FROM REVISION_PARENT T'
      '1102431049=   WHERE T.REVISION_PARENT = :REVISION_PARENT_'
      '1102431050=    INTO :DATE_BEGIN_,'
      '1102431051=         :TIME_BEGIN_,'
      '1102431052=         :DATE_END_,'
      '1102431053=         :TIME_END_,'
      '1102431054=         :NOTE_,'
      '1102431055=         :TOVAROV_CNT_,'
      '1102431056=         :TOVAROV_NAME_CNT_,'
      '1102431057=         :SPISANO_TOVAROV_CNT_,'
      '1102431058=         :SPISANO_TOVAROV_NAME_CNT_,'
      '1102431059=         :PRIHOD_TOVAROV_CNT_,'
      '1102431060=         :PRIHOD_TOVAROV_NAME_CNT_;'
      '1102431061='
      
        '1102431062=  SELECT SUM(G.PRICE * CAST((R.AMOUNT_BD - R.AMOUNT_R' +
        'EAL) AS DOUBLE PRECISION)) ROZN,'
      '1102431063=         MAX(Z.SUMM)  ZAKUP'
      
        '1102431064=    FROM REVISION_PARENT RP, REVISION R, G_PRODUCT G,' +
        ' ZAKAZ Z'
      '1102431065=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_'
      '1102431066=     AND RP.ZAKAZ = Z.ZAKAZ'
      '1102431067=     AND RP.REVISION_PARENT = R.REVISION_PARENT'
      '1102431068=     AND R.G_PRODUCT = G.G_PRODUCT'
      '1102431069=     AND (R.AMOUNT_BD - R.AMOUNT_REAL) > 0'
      '1102431070=    INTO :POTERI_SUMM_,'
      '1102431071=         :POTERI_ZAKUP_SUMM_;'
      '1102431072='
      
        '1102431073=  SELECT SUM(G.PRICE * CAST((R.AMOUNT_REAL - R.AMOUNT' +
        '_BD) AS DOUBLE PRECISION)) ROZN,'
      '1102431074=         MAX(S.SUMM)   ZAKUP'
      
        '1102431075=    FROM REVISION_PARENT RP, REVISION R, G_PRODUCT G,' +
        ' SKLAD_PARENT S'
      '1102431076=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_'
      '1102431077=     AND RP.SKLAD_PARENT = S.SKLAD'
      '1102431078=     AND RP.REVISION_PARENT = R.REVISION_PARENT'
      '1102431079=     AND R.G_PRODUCT = G.G_PRODUCT'
      '1102431080=     AND (R.AMOUNT_REAL - R.AMOUNT_BD) > 0'
      '1102431081=    INTO :IZLISHKI_SUMM_,'
      '1102431082=         :IZLISHKI_ZAKUP_SUMM_;'
      '1102431083='
      '1102431084=  -- '#1044#1045#1058#1040#1051#1048
      '1102431085=  FOR SELECT G.NAME,'
      '1102431086=           G.BARCODE,'
      '1102431087=           G.ARTICUL,'
      '1102431088=           G.PRICE,'
      '1102431089=           R.AMOUNT_BD,'
      '1102431090=           R.AMOUNT_REAL,'
      '1102431091=           R.AMOUNT_REAL - R.AMOUNT_BD DIFF_SUMM'
      '1102431092=    FROM REVISION R, G_PRODUCT G'
      '1102431093=   WHERE R.REVISION_PARENT = :REVISION_PARENT_'
      '1102431094=     AND R.G_PRODUCT = G.G_PRODUCT'
      '1102431095=   ORDER BY R.REVISION'
      '1102431096=    INTO :NAME,'
      '1102431097=         :BARCODE,'
      '1102431098=         :ARTICUL,'
      '1102431099=         :PRICE,'
      '1102431100=         :AMOUNT_BD,'
      '1102431101=         :AMOUNT_REAL,'
      '1102431102=         :DIFF_SUMM'
      '1102431103=  DO'
      '1102431104=    suspend;'
      '1102431105=end'
      '1102431106=;'
      '1102431107='
      '1102431108=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '1102431109=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1102431110=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1102431111=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102431112=  DATE_BEGIN_ DATE,'
      '1102431113=  DATE_END_ DATE,'
      '1102431114=  TIME_BEGIN_ TIME,'
      '1102431115=  TIME_END_ TIME,'
      '1102431116=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102431117=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102431118=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1102431119=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '1102431120=RETURNS ('
      '1102431121=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102431122=  AMOUNT_VES TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      '1102431123=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1102431124=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1102431125=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1102431126=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1102431127=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102431128=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '1102431129=  NONCASH_PAYMENT_NAME TYPE OF COLUMN G_NONCASH_PAY_T' +
        'YPE.NAME,'
      '1102431130=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102431131=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102431132=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102431133=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102431134=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102431135=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102431136=  Z_DATE BLOB SUB_TYPE 1,'
      '1102431137=  ROW INTEGER,'
      '1102431138=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102431139=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102431140=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102431141=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102431142=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102431143=  ERR_CODE INTEGER,'
      '1102431144=  ERR_MSG VARCHAR(1024))'
      '1102431145=AS'
      
        '1102431146=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST'#39';'
      '1102431147=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102431148=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1102431149=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '1102431150=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1102431151=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BA' +
        'RCODE;'
      
        '1102431152=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PR' +
        'ODUCT.BARCODE;'
      
        '1102431153=DECLARE VARIABLE BRAND_ TYPE OF COLUMN G_PRODUCT.BRAN' +
        'D;'
      
        '1102431154=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102431155=DECLARE VARIABLE AMOUNT_VES_ TYPE OF COLUMN G_PRODUCT' +
        '.VES_GRAMM;'
      
        '1102431156=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102431157=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.NAME;'
      
        '1102431158=DECLARE VARIABLE NONCASH_PAYMENT_NAME_ TYPE OF COLUMN' +
        ' G_NONCASH_PAY_TYPE.NAME;'
      
        '1102431159=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '1102431160=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1102431161=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM = 0;'
      
        '1102431162=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1102431163=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1102431164=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1102431165=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_SUMM = 0;'
      
        '1102431166=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1102431167=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1102431168=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1102431169=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1102431170=DECLARE VARIABLE I INTEGER = 1;'
      '1102431171=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      
        '1102431172=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAM' +
        'E;'
      
        '1102431173=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102431174=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102431175=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FIO_DOC;'
      '1102431176=BEGIN'
      '1102431177=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1102431178=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1102431179='
      
        '1102431180=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') |' +
        '| '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extr' +
        'act(year from Z.Z_DATE),'
      '1102431181=             Z.Z_TIME,'
      '1102431182=             GP.ARTICUL,'
      '1102431183=             GP.BARCODE,'
      '1102431184=             GP.NOMENCLATUR_NUM,'
      '1102431185=             GP.BRAND,'
      '1102431186=             GP.NAME,'
      '1102431187=             ZD.AMOUNT,'
      '1102431188=             ZD.AMOUNT * COALESCE(GP.VES_GRAMM, 0),'
      '1102431189=             ZD.PRICE,'
      '1102431190=             ZD.DISCOUNT_TENGE,'
      '1102431191=             ZD.SUMM,'
      '1102431192=             ZD.DISCOUNT_SUMM,'
      '1102431193=             GC.NAME,'
      
        '1102431194=             (CASE WHEN (Z.SUMM_CASH > 0 AND Z.SUMM_N' +
        'ONCASH > 0) THEN '#39#1057#1084#1077#1096#1072#1085#1085#1099#1081#39
      
        '1102431195=                   WHEN Z.SUMM_CASH > 0 THEN '#39#1053#1072#1083#1080#1095#1085#1099 +
        #1081#39
      '1102431196=                   ELSE '#39#1041#1077#1079#1085#1072#1083#1080#1095#1085#1099#1081#39' END),'
      '1102431197=             GN.NAME NON_CASH_NAME,'
      '1102431198=             TR.PATH,'
      '1102431199=             Z.NOTE,'
      '1102431200=             U.SHORT_NAME,'
      '1102431201=             Z.SUMM_CASH,'
      '1102431202=             Z.SUMM_NONCASH,'
      
        '1102431203=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, ' +
        #39#39')'
      
        '1102431204=      FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.' +
        'G_OFFICIAL = O.G_OFFICIAL'
      
        '1102431205=                   LEFT OUTER JOIN G_NONCASH_PAY_TYPE' +
        ' GN ON Z.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE,'
      '1102431206=           ZAKAZ_DETAILS ZD,'
      '1102431207=           G_CLIENT GC,'
      '1102431208=           G_PAYMENT_TYPE P,'
      '1102431209=           G_PRODUCT GP,'
      '1102431210=           G_UNIT U,'
      '1102431211=           P_REP_TREE TR'
      
        '1102431212=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102431213=       AND Z.IS_SPISANIE IN (0,2)'
      '1102431214=       AND Z.IS_RESERVE = 0'
      '1102431215=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102431216=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1102431217=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1102431218=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102431219=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102431220=       AND GP.G_UNIT = U.G_UNIT'
      '1102431221=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102431222=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1102431223=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1102431224=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1102431225=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1102431226=            OR'
      
        '1102431227=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1102431228=           )/*'
      
        '1102431229=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_' +
        'END_ AND :TIME_BEGIN_ IS NOT NULL)'
      '1102431230=            OR'
      '1102431231=            :TIME_BEGIN_ IS NULL)*/'
      
        '1102431232=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102431233=             OR'
      '1102431234=             (:G_CATEGORY_ IS NULL)'
      '1102431235=           )'
      
        '1102431236=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102431237=             OR'
      '1102431238=            (:G_PRODUCT_ IS NULL)'
      '1102431239=           )'
      '1102431240=       AND ((EXISTS (SELECT 1'
      '1102431241=                       FROM SKLAD S'
      '1102431242=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1102431243=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1102431244=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102431245=              OR'
      '1102431246=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102431247='
      '1102431248=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '1102431249=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :' +
        'NOMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :AMOUNT_VES_,' +
        ' :PRICE_,'
      
        '1102431250=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, ' +
        ':CLIENT_NAME_, :PAYMENT_NAME_, :NONCASH_PAYMENT_NAME_, :PATH_, :' +
        'NOTE_, :UNIT_NAME_,'
      
        '1102431251=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME' +
        '_'
      '1102431252=  DO BEGIN'
      '1102431253=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1102431254=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102431255=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102431256=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, ' +
        '"DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '1102431257=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL' +
        '_, :DISCOUNT_SUMM_ROLL_, 1);'
      '1102431258='
      '1102431259=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1102431260=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1102431261=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ +' +
        ' DISCOUNT_SUMM_ROLL_;'
      '1102431262=            SUMM_ROLL_ = 0;'
      '1102431263=            DISCOUNT_SUMM_ROLL_ = 0;'
      '1102431264=            I = I + 1;'
      '1102431265=        END'
      '1102431266='
      '1102431267=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102431268=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DAT' +
        'E", ROW)'
      '1102431269=        VALUES (:I, :PATH_, 1);'
      '1102431270=        I = I + 1;'
      '1102431271=    END'
      '1102431272='
      
        '1102431273=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", ' +
        '"TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, BRAND, NAME, AMOUNT, ' +
        'AMOUNT_VES, PRICE, DISCOUNT, SUMM,'
      
        '1102431274=                                         DISCOUNT_SUM' +
        'M, CLIENT_NAME, PAYMENT_TYPE, NONCASH_PAYMENT_NAME, NOTE, ROW, U' +
        'NIT_NAME,'
      
        '1102431275=                                         SUMM_CASH, S' +
        'UMM_NONCASH, OFFICIAL_NAME)'
      
        '1102431276=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCO' +
        'DE_, :NOMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :AMOUNT' +
        '_VES_, :PRICE_, :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '1102431277=            :CLIENT_NAME_, :PAYMENT_NAME_, :NONCASH_P' +
        'AYMENT_NAME_, :NOTE_, 0, :UNIT_NAME_,'
      
        '1102431278=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NA' +
        'ME_);'
      '1102431279='
      '1102431280=    I = I + 1;'
      '1102431281=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '1102431282=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCO' +
        'UNT_SUMM_;'
      '1102431283=    LAST_PATH_ = PATH_;'
      '1102431284=  END'
      '1102431285='
      '1102431286=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102431287=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1102431288=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOU' +
        'NT_SUMM_ROLL_, 1);'
      '1102431289='
      '1102431290=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1102431291=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1102431292=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_' +
        'SUMM_ROLL_;'
      '1102431293='
      
        '1102431294=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1102431295=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1102431296='
      
        '1102431297=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENC' +
        'LATUR_NUM, BRAND, NAME, AMOUNT, AMOUNT_VES, PRICE, DISCOUNT, SUM' +
        'M, DISCOUNT_SUMM, CLIENT_NAME,'
      
        '1102431298=             PAYMENT_TYPE, NONCASH_PAYMENT_NAME, ROW,' +
        ' NOTE, UNIT_NAME, SUMM_CASH, SUMM_NONCASH, OFFICIAL_NAME'
      '1102431299=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1102431300=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOM' +
        'ENCLATUR_NUM, :BRAND, :TOVAR_NAME,'
      
        '1102431301=           :AMOUNT, :AMOUNT_VES, :PRICE, :DISCOUNT_TE' +
        'NGE, :SUMM, :DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :NONCAS' +
        'H_PAYMENT_NAME, :ROW,'
      
        '1102431302=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCA' +
        'SH, :OFFICIAL_NAME'
      '1102431303=  do suspend;'
      '1102431304='
      '1102431305=WHEN ANY DO BEGIN'
      '1102431306=    Err_code = -20500;'
      
        '1102431307=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1102431308=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102431309=  END'
      '1102431310=end'
      '1102431311=;'
      '1102431312='
      '1102431313=ALTER PROCEDURE R_EDIT_REVISION('
      '1102431314=  AMOUNT_REAL_ TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '1102431315=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102431316=  DATETIME_ TYPE OF COLUMN REVISION.DATETIME_CREATED,'
      '1102431317=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102431318=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE = '#39#39','
      '1102431319=  PREFIX_ VARCHAR(2) = '#39#39')'
      '1102431320=RETURNS ('
      '1102431321=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '1102431322=  ERR_CODE INTEGER,'
      '1102431323=  ERR_MSG VARCHAR(1024))'
      '1102431324=AS'
      
        '1102431325=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'R_EDIT_REVIS' +
        'ION'#39';'
      '1102431326=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102431327=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT;'
      '1102431328=DECLARE VARIABLE I INTEGER = 1;'
      
        '1102431329=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1102431330=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRIC' +
        'E;'
      
        '1102431331=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODU' +
        'CT.VOLUME_PRICE;'
      
        '1102431332=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102431333=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1102431334=DECLARE VARIABLE IS_MARKED_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_MARKED;'
      
        '1102431335=DECLARE VARIABLE IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_WEIGHT;'
      
        '1102431336=DECLARE VARIABLE VES_GRAMM_PRICE_ TYPE OF COLUMN G_PR' +
        'ODUCT.VES_GRAMM_PRICE;'
      '1102431337=BEGIN'
      '1102431338=  PNT_ = '#39'00'#39';'
      '1102431339=  IF (BARCODE_ <> '#39#39') THEN BEGIN'
      
        '1102431340=    EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BAR' +
        'CODE_, '#39#39'/*:ARTICUL_*/, '#39#39'/*:NOMER_*/, '#39#39'/*:NAME_*/, :PREFIX_)'
      
        '1102431341=        RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATE' +
        'GORY_, :PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :IS_MARKED_,'
      
        '1102431342=        :IS_WEIGHT_, :VES_GRAMM_PRICE_, :ERR_CODE, :E' +
        'RR_MSG;'
      '1102431343='
      '1102431344=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102431345=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102431346='
      '1102431347=      EXIT;'
      '1102431348=    END'
      '1102431349=  END'
      '1102431350='
      '1102431351=  PNT_ = '#39'01'#39';'
      '1102431352=  SELECT LT.AMOUNT + LT.AMOUNT_RESERVE'
      '1102431353=    FROM LT_SKLAD_PRODUCT LT'
      '1102431354=   WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1102431355=     AND LT.G_TOCHKA = :G_TOCHKA_'
      '1102431356=    INTO :AMOUNT_BD_;'
      '1102431357='
      '1102431358=  AMOUNT_BD_ = COALESCE(AMOUNT_BD_, 0);'
      '1102431359='
      
        '1102431360=  -- '#1045#1057#1051#1048' '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1042#1040#1053#1040' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071 +
        #1070' 1 ('#1045#1057#1051#1048' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045')'
      '1102431361=  -- '#1045#1057#1051#1048' '#1053#1045' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1064#1045#1044#1064#1045#1045' '#1050#1054#1051'-'#1042#1054
      '1102431362=  PNT_ = '#39'02'#39';'
      '1102431363=  UPDATE REVISION_TMP R'
      
        '1102431364=     SET R.AMOUNT_REAL = DECODE(:BARCODE_, '#39#39', :AMOUN' +
        'T_REAL_, R.AMOUNT_REAL + 1)'
      '1102431365=   WHERE R.G_PRODUCT = :G_PRODUCT_'
      '1102431366=  RETURNING'
      '1102431367=    REVISION'
      '1102431368=  INTO'
      '1102431369=    :REVISION_;'
      '1102431370='
      '1102431371=  PNT_ = '#39'03'#39';'
      '1102431372=  IF (ROW_COUNT = 0) THEN'
      
        '1102431373=      INSERT INTO REVISION_TMP (REVISION, G_PRODUCT, ' +
        'AMOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '1102431374=      VALUES (GEN_ID(GEN_REVISION, 1), :G_PRODUCT_, :' +
        'AMOUNT_BD_, :AMOUNT_REAL_, :DATETIME_)'
      '1102431375=      RETURNING'
      '1102431376=        REVISION'
      '1102431377=      INTO'
      '1102431378=        :REVISION_;'
      '1102431379='
      '1102431380=WHEN ANY DO BEGIN'
      '1102431381=    Err_code = -20500;'
      
        '1102431382=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1042 +
        #1057#1058#1040#1042#1050#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102431383=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102431384=  END'
      '1102431385=END'
      '1102431386=;'
      '1102431387='
      '1102431388=ALTER PROCEDURE R_FILL_REVISION('
      '1102431389=  G_PRODUCT_PAR_ BLOB SUB_TYPE 1,'
      '1102431390=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102431391=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102431392=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102431393=  TYPE_ INTEGER)'
      '1102431394=RETURNS ('
      '1102431395=  ERR_CODE INTEGER,'
      '1102431396=  ERR_MSG VARCHAR(1024))'
      '1102431397=AS'
      
        '1102431398=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT;'
      
        '1102431399=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.G_PRODUCT;'
      '1102431400=BEGIN'
      '1102431401='
      '1102431402=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102431403=    SELECT ID'
      '1102431404=      FROM CUR_PARAMS'
      '1102431405=     WHERE CUR_PARAMS = 2'
      '1102431406=      INTO :G_TOCHKA_;'
      '1102431407='
      '1102431408=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1041#1044
      '1102431409=  IF (COALESCE(SKLAD_, 0) = 0) THEN BEGIN'
      '1102431410=      FOR SELECT G.G_PRODUCT,'
      '1102431411=                 COALESCE(LT.AMOUNT, 0)'
      
        '1102431412=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, (AMOUNT + AMOUNT_RESERVE) AMOUNT'
      
        '1102431413=                                                FROM ' +
        'LT_SKLAD_PRODUCT'
      
        '1102431414=                                               WHERE ' +
        'G_TOCHKA = :G_TOCHKA_) LT ON G.g_product = LT.g_product'
      '1102431415=           WHERE G.IS_ACTIVE = 1'
      '1102431416=             AND G.IS_KIT <> 1'
      
        '1102431417=             AND ((:G_PRODUCT_PAR_ CONTAINING '#39'~'#39'||G.' +
        'G_PRODUCT_PAR||'#39'~'#39' AND :G_PRODUCT_PAR_ IS NOT NULL)'
      '1102431418=                  OR'
      '1102431419=                  (:G_PRODUCT_PAR_ IS NULL)'
      '1102431420=                 )'
      
        '1102431421=             AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||G.G_PR' +
        'ODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102431422=                  OR'
      '1102431423=                  (:G_PRODUCT_ IS NULL)'
      '1102431424=                 )'
      '1102431425=             AND G.IS_CATEGORY = 0'
      
        '1102431426=             AND NOT EXISTS (SELECT 1 FROM REVISION_T' +
        'MP WHERE G_PRODUCT = G.G_PRODUCT)'
      '1102431427=          /*UNION ALL'
      '1102431428=          SELECT G.G_PRODUCT,'
      '1102431429=                 COALESCE(LT.AMOUNT, 0)'
      '1102431430=            FROM G_PRODUCT G,'
      '1102431431=                 LT_SKLAD_PRODUCT LT'
      '1102431432=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      
        '1102431433=             AND G.G_PRODUCT_PAR IN (SELECT GG.G_PROD' +
        'UCT'
      
        '1102431434=                                      FROM G_PRODUCT ' +
        'GG'
      
        '1102431435=                                     WHERE :G_PRODUCT' +
        '_PAR_ CONTAINING '#39'~'#39'||GG.G_PRODUCT_PAR||'#39'~'#39
      
        '1102431436=                                       AND GG.IS_CATE' +
        'GORY = 1'
      
        '1102431437=                                       and gg.G_PRODU' +
        'CT_PAR is not null)'
      '1102431438=             AND G.IS_CATEGORY = 0'
      '1102431439=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) > 0'
      '1102431440=             AND LT.G_TOCHKA = :G_TOCHKA_'
      '1102431441=          UNION ALL'
      '1102431442=          SELECT G.G_PRODUCT,'
      '1102431443=                 COALESCE(LT.AMOUNT, 0)'
      '1102431444=            FROM G_PRODUCT G,'
      '1102431445=                 LT_SKLAD_PRODUCT LT'
      '1102431446=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      '1102431447=             AND G.IS_CATEGORY = 0'
      '1102431448=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0'
      '1102431449=             AND LT.G_TOCHKA = :G_TOCHKA_'
      
        '1102431450=          /*UNION ALL              '#1061#1059#1049' '#1047#1053#1040#1045#1058' '#1047#1040#1063#1045#1052' '#1041#1067 +
        #1051#1054' '#1053#1059#1046#1053#1054'  11.02.2016'
      '1102431451=          SELECT G.G_PRODUCT,'
      '1102431452=                 COALESCE(LT.AMOUNT, 0)'
      
        '1102431453=            FROM G_PRODUCT G LEFT OUTER JOIN LT_SKLAD' +
        '_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT'
      
        '1102431454=           WHERE G.G_PRODUCT_PAR IN (SELECT GG.G_PROD' +
        'UCT'
      
        '1102431455=                                      FROM G_PRODUCT ' +
        'GG'
      
        '1102431456=                                     WHERE GG.IS_CATE' +
        'GORY = 1'
      
        '1102431457=                                       and gg.G_PRODU' +
        'CT_PAR is not null)'
      '1102431458=             AND G.IS_CATEGORY = 0'
      '1102431459=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0 */'
      '1102431460=          ORDER BY 1'
      '1102431461=          INTO :G_PRODUCT__,'
      '1102431462=               :AMOUNT_BD_'
      '1102431463=      DO BEGIN'
      '1102431464='
      
        '1102431465=        --INSERT INTO REVISION (REVISION, SKLAD, G_PR' +
        'ODUCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1102431466=        --VALUES (GEN_ID(GEN_REVISION, 1), NULL, :G_P' +
        'RODUCT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      
        '1102431467=        INSERT INTO REVISION_TMP (REVISION, G_PRODUCT' +
        ', AMOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '1102431468=        VALUES (GEN_ID(GEN_REVISION, 1), :G_PRODUCT__' +
        ', :AMOUNT_BD_, 0, CURRENT_TIME);'
      '1102431469='
      '1102431470=        --I = I + 1;'
      '1102431471=      END'
      '1102431472='
      '1102431473=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102431474=  END ELSE BEGIN'
      '1102431475=      FOR SELECT SS.G_PRODUCT,'
      '1102431476=                 SS.AMOUNT'
      '1102431477=            FROM SKLAD_PARENT S, SKLAD SS'
      '1102431478=           WHERE S.SKLAD = :SKLAD_'
      '1102431479=             AND S.SKLAD = SS.SKLAD_PARENT'
      
        '1102431480=             AND S.G_TOCHKA = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 2)'
      '1102431481=          ORDER BY 1'
      '1102431482=          INTO :G_PRODUCT__,'
      '1102431483=               :AMOUNT_BD_'
      '1102431484=      DO BEGIN'
      '1102431485='
      
        '1102431486=        INSERT INTO REVISION (REVISION, SKLAD, G_PROD' +
        'UCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1102431487=        VALUES (GEN_ID(GEN_REVISION, 1), NULL, :G_PRO' +
        'DUCT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      '1102431488='
      '1102431489=        --I = I + 1;'
      '1102431490=      END'
      '1102431491=  END'
      '1102431492=END'
      '1102431493=;'
      '1102431494='
      '1102431495=ALTER PROCEDURE R_MADE_REVISION('
      
        '1102431496=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102431497=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102431498=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102431499=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102431500=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102431501=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '1102431502=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102431503=RETURNS ('
      '1102431504=  COUNT_SPIS_ INTEGER,'
      '1102431505=  SUMM_SPIS_ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1102431506=  COUNT_PRIH_ INTEGER,'
      '1102431507=  SUMM_PRIHOD_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      
        '1102431508=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT' +
        '.REVISION_PARENT,'
      '1102431509=  ERR_CODE INTEGER,'
      '1102431510=  ERR_MSG VARCHAR(1024))'
      '1102431511=AS'
      
        '1102431512=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVIS' +
        'ION'#39';'
      '1102431513=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102431514=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102431515=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102431516=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102431517=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102431518=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102431519=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102431520=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102431521=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      
        '1102431522=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REV' +
        'ISION.DATETIME_CREATED;'
      
        '1102431523=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.AMOUNT;'
      '1102431524=DECLARE VARIABLE CNT_ INTEGER;'
      '1102431525=BEGIN'
      '1102431526='
      '1102431527=  COUNT_SPIS_  = 0;'
      '1102431528=  COUNT_PRIH_  = 0;'
      '1102431529=  SUMM_SPIS_   = 0;'
      '1102431530=  SUMM_PRIHOD_ = 0;'
      '1102431531='
      '1102431532=  PNT_ = '#39'00'#39';'
      '1102431533=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '1102431534=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGI' +
        'N_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '1102431535=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102431536=  END'
      
        '1102431537=  -- '#1052#1054#1046#1045#1058' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1051#1048' '#1056#1045#1042#1048#1047#1048#1070', '#1044#1054#1041#1040#1042#1051#1071#1051#1048' '#1058#1054#1042#1040#1056#1067' '#1048' ' +
        #1053#1040#1046#1040#1051#1048' "'#1047#1040#1042#1045#1056#1064#1048#1058#1068'", '#1058#1054#1043#1044#1040' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1053#1054#1042#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1042' REVISION'
      '1102431538=  ELSE BEGIN'
      
        '1102431539=     EXECUTE PROCEDURE REVISION_PARENT_UPD(:REVISION_' +
        'PARENT_, :DATE_BEGIN_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NO' +
        'TE_,'
      '1102431540=         :G_TOCHKA_, 0 /*:IS_MADE_*/);'
      '1102431541=  END'
      '1102431542=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102431543=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102431544=    EXIT;'
      '1102431545=  END'
      '1102431546='
      '1102431547=  PNT_ = '#39'01'#39';'
      
        '1102431548=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL, DATETIME_CREATED'
      '1102431549=      FROM REVISION'
      '1102431550=      WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102431551=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_, :DATETIME_CREATED_'
      '1102431552=  DO BEGIN'
      '1102431553=    /*SELECT SUM(ZD.AMOUNT)'
      '1102431554=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102431555=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ A' +
        'S DATE) AND CURRENT_DATE'
      
        '1102431556=       AND Z.Z_TIME > CAST(:DATETIME_CREATED_ AS TIME' +
        ')'
      '1102431557=       AND Z.Z_TIME < CURRENT_TIME'
      '1102431558=       AND Z.IS_SPISANIE IN (0, 1)'
      '1102431559=       AND Z.ZAKAZ = ZD.ZAKAZ_DETAILS'
      '1102431560=      INTO :AMOUNT_SALED_;*/'
      '1102431561='
      '1102431562=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '1102431563=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102431564=        RETURNING_VALUES :COST_PRICE_;'
      '1102431565='
      
        '1102431566=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102431567=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102431568=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/), 0, 0, 0, 0, 0);'
      '1102431569='
      '1102431570=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102431571=    END'
      '1102431572='
      '1102431573=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      
        '1102431574=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102431575=        RETURNING_VALUES :COST_PRICE_;'
      '1102431576='
      
        '1102431577=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102431578=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :COST_PRICE_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_/* - :AMOUNT_SALED_*/) * :COST_PRICE_, 0, 0);'
      '1102431579='
      '1102431580=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102431581=    END'
      '1102431582=  END'
      '1102431583='
      '1102431584=  PNT_ = '#39'01A'#39';'
      '1102431585=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102431586=    SELECT SUM(S.SUMM)'
      '1102431587=      FROM ZAKAZ_DETAILS_TMP S'
      '1102431588=      INTO :SUMM_SPIS_;'
      '1102431589='
      '1102431590=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102431591=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102431592=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102431593=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102431594=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102431595=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102431596=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102431597=                                NULL,           --:NO' +
        'TE_,'
      
        '1102431598=                                :SUMM_SPIS_,         ' +
        '     --:SUMM_,'
      
        '1102431599=                                :SUMM_SPIS_,         ' +
        '     --:SUMM_FACT_,'
      
        '1102431600=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102431601=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102431602=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102431603=                                NULL,'
      
        '1102431604=                                0,        -- BY_RECIP' +
        'E'
      
        '1102431605=                                0         -- IS_RESER' +
        'VE'
      '1102431606=                                ,NULL  -- PAYMENTS_'
      '1102431607=                                ,0     -- SUMM_CASH'
      
        '1102431608=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102431609=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102431610=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102431611=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102431612=      EXIT;'
      '1102431613=    END'
      '1102431614=  END'
      '1102431615='
      '1102431616=  PNT_ = '#39'02'#39';'
      '1102431617=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102431618=    SELECT SUM(S.SUMM)'
      '1102431619=      FROM SKLAD_TMP S'
      '1102431620=      INTO :SUMM_PRIHOD_;'
      '1102431621='
      '1102431622=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102431623=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102431624=                                CURRENT_TIME,'
      
        '1102431625=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102431626=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102431627=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102431628=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102431629=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102431630=                                :SUMM_PRIHOD_,'
      '1102431631=                                :SUMM_PRIHOD_,'
      
        '1102431632=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102431633=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102431634=                                ,NULL  --PAYMENTS'
      '1102431635=                                )'
      
        '1102431636=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102431637=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102431638=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102431639=      EXIT;'
      '1102431640=    END'
      '1102431641=  END'
      '1102431642='
      '1102431643=  UPDATE REVISION_PARENT RP'
      '1102431644=     SET RP.IS_MADE      = 1,'
      '1102431645=         RP.DATE_END     = :DATE_END_,'
      '1102431646=         RP.TIME_END     = :TIME_END_,'
      '1102431647=         RP.SKLAD_PARENT = :SKLAD_,'
      '1102431648=         RP.ZAKAZ        = :ZAKAZ_'
      '1102431649=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '1102431650='
      '1102431651=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '1102431652=END'
      '1102431653=;'
      '1102431654='
      '1102431655=ALTER PROCEDURE REVISION_PARENT_DEL('
      
        '1102431656=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      '1102431657=  REVISION_ TYPE OF COLUMN REVISION_TMP.REVISION)'
      '1102431658=AS'
      '1102431659=BEGIN'
      '1102431660=  IF (REVISION_PARENT_ <> 0) THEN BEGIN'
      '1102431661=      DELETE FROM REVISION R'
      '1102431662=      WHERE R.REVISION_PARENT = :REVISION_PARENT_;'
      '1102431663='
      '1102431664=      DELETE FROM REVISION_PARENT'
      '1102431665=      WHERE (REVISION_PARENT = :REVISION_PARENT_);'
      '1102431666=  END'
      '1102431667=  ELSE BEGIN'
      '1102431668=    IF (REVISION_ <> 0) THEN'
      
        '1102431669=       DELETE FROM REVISION_TMP WHERE REVISION = :REV' +
        'ISION_;'
      '1102431670=    ELSE'
      '1102431671=       DELETE FROM REVISION_TMP;'
      '1102431672=  END'
      '1102431673=END'
      '1102431674=;'
      '1102431675='
      '1102431676=ALTER PROCEDURE REVISION_PARENT_GET('
      
        '1102431677=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102431678=RETURNS ('
      
        '1102431679=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102431680=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102431681=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102431682=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102431683=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102431684=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '1102431685=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE,'
      '1102431686=  SPIS_SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102431687=  SPIS_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102431688=  PRIHOD_SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102431689=  PRIHOD_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT)'
      '1102431690=AS'
      '1102431691=BEGIN'
      
        '1102431692=  SELECT DATE_BEGIN, TIME_BEGIN, DATE_END, TIME_END, ' +
        'NOTE, G_TOCHKA, IS_MADE,'
      
        '1102431693=         COALESCE((SELECT SUM(AMOUNT) FROM ZAKAZ_DETA' +
        'ILS WHERE ZAKAZ = T.ZAKAZ), 0),'
      
        '1102431694=         COALESCE((SELECT SUMM FROM ZAKAZ WHERE ZAKAZ' +
        ' = T.ZAKAZ), 0),'
      
        '1102431695=         COALESCE((SELECT SUM(AMOUNT) FROM SKLAD WHER' +
        'E SKLAD_PARENT = T.SKLAD_PARENT), 0),'
      
        '1102431696=         COALESCE((SELECT S.SUMM FROM SKLAD_PARENT S ' +
        'WHERE S.SKLAD = T.SKLAD_PARENT), 0)'
      '1102431697=  FROM REVISION_PARENT T'
      '1102431698=  WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102431699=  INTO :DATE_BEGIN_, :TIME_BEGIN_, :DATE_END_, :TIME_' +
        'END_, :NOTE_, :G_TOCHKA_, :IS_MADE_, :SPIS_AMOUNT_, :SPIS_SUMM_,'
      '1102431700=       :PRIHOD_AMOUNT_, :PRIHOD_SUMM_;'
      '1102431701='
      
        '1102431702=  INSERT INTO REVISION_TMP (REVISION, G_PRODUCT, AMOU' +
        'NT_BD, AMOUNT_REAL, REVISION_PARENT, DATETIME_CREATED)'
      
        '1102431703=  SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL,' +
        ' REVISION_PARENT, DATETIME_CREATED'
      '1102431704=  FROM REVISION'
      '1102431705=  WHERE REVISION_PARENT = :REVISION_PARENT_;'
      '1102431706=END'
      '1102431707=;'
      '1102431708='
      '1102431709=ALTER PROCEDURE REVISION_PARENT_INS('
      
        '1102431710=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102431711=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102431712=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102431713=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102431714=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102431715=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '1102431716=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE)'
      '1102431717=RETURNS ('
      
        '1102431718=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      '1102431719=  ERR_CODE INTEGER,'
      '1102431720=  ERR_MSG VARCHAR(1024))'
      '1102431721=AS'
      '1102431722=BEGIN'
      '1102431723=  INSERT INTO REVISION_PARENT ('
      '1102431724=    REVISION_PARENT,'
      '1102431725=    DATE_BEGIN,'
      '1102431726=    TIME_BEGIN,'
      '1102431727=    DATE_END,'
      '1102431728=    TIME_END,'
      '1102431729=    NOTE,'
      '1102431730=    G_TOCHKA,'
      '1102431731=    IS_MADE)'
      '1102431732=  VALUES ('
      '1102431733=    GEN_ID(GEN_REVISION_PARENT, 1),'
      '1102431734=    :DATE_BEGIN_,'
      '1102431735=    :TIME_BEGIN_,'
      '1102431736=    :DATE_END_,'
      '1102431737=    :TIME_END_,'
      '1102431738=    :NOTE_,'
      '1102431739=    :G_TOCHKA_,'
      '1102431740=    :IS_MADE_)'
      '1102431741=  RETURNING REVISION_PARENT'
      '1102431742=  INTO :REVISION_PARENT_;'
      '1102431743='
      
        '1102431744=  INSERT INTO REVISION (REVISION, G_PRODUCT, AMOUNT_B' +
        'D, AMOUNT_REAL, REVISION_PARENT, DATETIME_CREATED)'
      
        '1102431745=  SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL,' +
        ' :REVISION_PARENT_, DATETIME_CREATED'
      '1102431746=  FROM REVISION_TMP;'
      '1102431747='
      '1102431748=  DELETE FROM REVISION_TMP;'
      '1102431749=END'
      '1102431750=;'
      '1102431751='
      '1102431752=ALTER PROCEDURE REVISION_PARENT_READ('
      
        '1102431753=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      '1102431754=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102431755=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA)'
      '1102431756=RETURNS ('
      
        '1102431757=  REVISION_PARENT TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT,'
      '1102431758=  DATE_BEGIN TIMESTAMP,'
      '1102431759=  DATE_END TIMESTAMP,'
      '1102431760=  NOTE TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102431761=  G_TOCHKA TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '1102431762=  IS_MADE TYPE OF COLUMN REVISION_PARENT.IS_MADE,'
      '1102431763=  IS_MADE_STR VARCHAR(5))'
      '1102431764=AS'
      '1102431765=DECLARE VARIABLE CNT_ INTEGER ;'
      '1102431766=BEGIN'
      '1102431767='
      '1102431768=  SELECT COUNT(*)'
      '1102431769=    FROM REVISION_PARENT T'
      
        '1102431770=   WHERE DATE_BEGIN BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '1102431771=     AND G_TOCHKA = :G_TOCHKA_'
      '1102431772=    INTO CNT_;'
      '1102431773='
      '1102431774=  if (CNT_ = 0) then'
      '1102431775=    SELECT MAX(T.DATE_BEGIN)'
      '1102431776=      FROM REVISION_PARENT T'
      '1102431777=     WHERE T.DATE_BEGIN < :DATE_BEGIN_'
      '1102431778=       AND T.G_TOCHKA = :G_TOCHKA_'
      '1102431779=      INTO :DATE_BEGIN_;'
      '1102431780='
      '1102431781=  FOR SELECT REVISION_PARENT,'
      '1102431782=             DATE_BEGIN + TIME_BEGIN,'
      '1102431783=             DATE_END + TIME_END,'
      '1102431784=             NOTE,'
      '1102431785=             G_TOCHKA,'
      '1102431786=             IS_MADE,'
      '1102431787=             DECODE(IS_MADE, 1, '#39#1044#1072#39', '#39#1053#1077#1090#39')'
      '1102431788=      FROM REVISION_PARENT'
      
        '1102431789=      WHERE DATE_BEGIN BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '1102431790=        AND G_TOCHKA = :G_TOCHKA_'
      '1102431791=      INTO :REVISION_PARENT,'
      '1102431792=           :DATE_BEGIN,'
      '1102431793=           :DATE_END,'
      '1102431794=           :NOTE,'
      '1102431795=           :G_TOCHKA,'
      '1102431796=           :IS_MADE,'
      '1102431797=           :IS_MADE_STR'
      '1102431798=  DO SUSPEND;'
      '1102431799=END'
      '1102431800=;'
      '1102431801='
      '1102431802='
      
        '1102431803=UPDATE SYSTEM_SETUP SET S_VALUE = 110243 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102431804=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102431805=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102440='
      '1102441=ALTER PROCEDURE CLEAR_BASE('
      '1102442=  MODE_ INTEGER = 0)'
      '1102443=AS'
      '1102444=/*'
      '1102445=mode_'
      '1102446=0 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077
      '1102447=1 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1087#1088#1086#1076#1072#1078#1080' '#1080' '#1087#1088#1080#1093#1086#1076#1099
      '1102448=2 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077', '#1082#1088#1086#1084#1077' '#1090#1086#1074#1072#1088#1086#1074
      '1102449=*/'
      '11024410=BEGIN'
      '11024411=  delete from LT_ZAKAZ_REAL;'
      '11024412=  delete from REVISION;'
      '11024413='
      '11024414=  delete from kassa;'
      '11024415=  delete from kassa_state;'
      '11024416='
      '11024417=  delete from kassa_beznal;'
      '11024418=  delete from kassa_beznal_state;'
      '11024419='
      '11024420=  delete from waybill;'
      '11024421=  delete from invoice;'
      '11024422=  delete from INVOICE_PAY;'
      '11024423=  delete from docs;'
      '11024424=  delete from other_details;'
      '11024425=  delete from other;'
      '11024426='
      '11024427=  DELETE FROM REVISION;'
      '11024428=  delete from REVISION_PARENT;'
      '11024429='
      '11024430=  delete from sklad'
      '11024431=   where exists (select 1'
      '11024432=                  from sklad_parent sp'
      '11024433=                 where sp.IS_VOZVRAT = 1'
      '11024434=                   and sp.ZAKAZ is not NULL'
      '11024435=                   and sp.SKLAD = sklad_parent);'
      '11024436=  delete from sklad_parent'
      '11024437=   where IS_VOZVRAT = 1'
      '11024438=     and ZAKAZ is not NULL;'
      '11024439='
      '11024440=  delete from zakaz_details;'
      '11024441=  delete from zakaz;'
      '11024442='
      '11024443=  delete from zakaz_na_real;'
      '11024444=  delete from ZAKAZ_real_parent;'
      '11024445='
      '11024446=  delete from sklad;'
      '11024447=  delete from sklad_parent;'
      '11024448='
      '11024449=  update lt_sklad_product l'
      '11024450=     set l.AMOUNT = 0,'
      '11024451=         l.AMOUNT_RESERVE = 0;'
      '11024452='
      '11024453=  IF (MODE_ IN (0, 2)) THEN BEGIN'
      '11024454=    delete from g_address;'
      '11024455=    delete from g_account;'
      '11024456=    delete from G_DISCONT_CARD;'
      '11024457=    delete from DELIVERY;'
      '11024458='
      
        '11024459=    --'#1076#1077#1083#1072#1102' '#1089#1085#1072#1095#1072#1083#1072' '#1072#1087#1076#1077#1081#1090' '#1087#1072#1088#1077#1085#1090#1086#1074', '#1095#1090#1086#1073#1099' '#1091#1076#1072#1083#1077#1085#1080#1077' '#1087#1088#1086 +
        #1096#1083#1086' '#1075#1083#1072#1076#1082#1086
      
        '11024460=    update g_client c set c.G_CLIENT_PARENT = null wher' +
        'e c.G_CLIENT <> 10;'
      
        '11024461=    delete from g_client c where c.G_CLIENT not in (9,1' +
        '0);'
      '11024462=    delete from g_discount;'
      
        '11024463=    delete from g_prihod_rashod where g_prihod_rashod n' +
        'ot in (-5,-1,0,1,2,3);'
      '11024464=    delete from g_firm_address;'
      '11024465=    delete from g_firm_account;'
      '11024466=    delete from g_firm_rekvizit;'
      '11024467=    delete from G_OFFICIAL_RIGHT;'
      '11024468=    delete from g_official;'
      '11024469='
      '11024470=    IF (mode_ = 0) THEN begin'
      '11024471=      delete from G_PRODUCT_IMAGE;'
      '11024472=      delete from G_PRODUCT_KIT;'
      '11024473=      delete from LT_BARCODE;'
      '11024474=      delete from LT_SKLAD_PRODUCT;'
      '11024475=      delete from G_PRODUCT g where g.IS_CATEGORY = 0;'
      '11024476=      update g_product g set g.g_product_par = null;'
      
        '11024477=      delete from G_PRODUCT g where g.IS_CATEGORY = 1 a' +
        'nd g.G_PRODUCT <> -1;'
      '11024478=      delete from g_unit where g_unit <> 1;'
      '11024479=    end'
      '11024480='
      '11024481=  END'
      '11024482=END'
      '11024483=;'
      '11024484='
      '11024485=ALTER PROCEDURE LOG_INIT'
      '11024486=AS'
      '11024487=DECLARE VARIABLE TN VARCHAR(64);'
      '11024488=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '11024489=DECLARE VARIABLE FN VARCHAR(64);'
      '11024490=DECLARE VARIABLE TP INTEGER;'
      
        '11024491=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80; ' +
        '/* VARCHAR(30000); */'
      
        '11024492=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80; ' +
        '/* VARCHAR(30000); */'
      
        '11024493=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80; ' +
        '/* VARCHAR(30000); */'
      
        '11024494=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE 8' +
        '0; /* VARCHAR(30000); */'
      '11024495=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '11024496=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '11024497=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '11024498=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80; ' +
        '/* VARCHAR(30000) */'
      '11024499=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110244100=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110244101=DECLARE VARIABLE ANZ INTEGER;'
      '110244102=DECLARE VARIABLE L INTEGER;'
      '110244103=DECLARE VARIABLE P INTEGER;'
      '110244104=DECLARE VARIABLE S INTEGER;'
      '110244105=DECLARE VARIABLE FT CHAR(1);'
      '110244106=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110244107=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110244108=BEGIN'
      '110244109=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110244110='
      '110244111=  TN_ALT='#39#39';'
      '110244112=  TRGI='#39#39';'
      '110244113=  TRGU='#39#39';'
      '110244114=  TRGD='#39#39';'
      '110244115=  TRGIX='#39#39';'
      '110244116=  TRGUX='#39#39';'
      '110244117=  TRGDX='#39#39';'
      '110244118=  SQLF='#39#39';'
      '110244119=  SQLV='#39#39';'
      '110244120=  SQLU='#39#39';'
      '110244121=  FT='#39#39';'
      '110244122='
      '110244123=  FOR SELECT R.RDB$RELATION_NAME,'
      '110244124=            R.RDB$FIELD_NAME,'
      '110244125=            F.RDB$FIELD_TYPE,'
      '110244126=            F.RDB$FIELD_LENGTH,'
      '110244127=            F.RDB$FIELD_PRECISION,'
      '110244128=            F.RDB$FIELD_SCALE'
      '110244129=        FROM RDB$RELATION_FIELDS R,'
      '110244130=             RDB$FIELDS F'
      '110244131=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110244132=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110244133=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110244134=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110244135=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110244136=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110244137=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110244138=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110244139=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110244140=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110244141=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39','#39'REVISION_TMP'#39','#39'UPLOAD_TA' +
        'BLE_TMP'#39','
      
        '110244142=                                         '#39'KASPI_CITY'#39',' +
        #39'KASPI_POINT'#39')'
      '110244143=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110244144=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110244145=              OR'
      
        '110244146=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110244147=             )'
      
        '110244148=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110244149=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110244150=  DO BEGIN'
      '110244151=    TN=TRIM(TN);'
      '110244152=    FN=TRIM(FN);'
      '110244153=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110244154=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110244155=      EXECUTE STATEMENT TRGI;'
      '110244156=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110244157=      EXECUTE STATEMENT TRGU;'
      '110244158=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110244159=      EXECUTE STATEMENT TRGD;'
      '110244160='
      '110244161=      SQLF='#39#39';'
      '110244162=      SQLV='#39#39';'
      '110244163=      SQLU='#39#39';'
      '110244164=    END'
      '110244165=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110244166=      ID_COLUMN = FN;'
      '110244167='
      '110244168=    S=-S;'
      
        '110244169=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110244170=      ft='#39'N'#39';   --numerisch'
      '110244171=    else'
      '110244172=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110244173=        ft='#39'Z'#39';   --zeit'
      '110244174=      else'
      '110244175=        ft='#39'T'#39';'
      '110244176='
      '110244177=    IF (SQLF='#39#39') THEN'
      '110244178=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110244179=    ELSE'
      '110244180=      SQLF=SQLF||'#39','#39'||FN;'
      '110244181='
      '110244182=    if (ft='#39'N'#39') then begin'
      '110244183=      IF (SQLV='#39#39') THEN'
      
        '110244184=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110244185=      ELSE'
      
        '110244186=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110244187='
      '110244188=      IF (SQLU='#39#39') THEN'
      
        '110244189=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110244190=      ELSE'
      
        '110244191=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110244192=    end'
      '110244193=    else'
      '110244194=      if (ft='#39'Z'#39') then begin'
      '110244195=        IF (SQLV='#39#39') THEN'
      
        '110244196=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||re' +
        'place(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        '),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110244197=        ELSE'
      
        '110244198=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||re' +
        'place(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        '),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110244199='
      '110244200=        IF (SQLU='#39#39') THEN'
      
        '110244201=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'U' +
        'PDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM' +
        '(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39 +
        ')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110244202=        ELSE'
      
        '110244203=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39 +
        '||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39 +
        #39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110244204=    end'
      '110244205=    else begin'
      '110244206=      IF (SQLV='#39#39') THEN'
      
        '110244207=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||repl' +
        'ace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRL' +
        'F;'
      '110244208=      ELSE'
      
        '110244209=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||repl' +
        'ace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRL' +
        'F;'
      '110244210='
      '110244211=      IF (SQLU='#39#39') THEN'
      
        '110244212=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39 +
        #39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110244213=      ELSE'
      
        '110244214=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        ')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110244215=    end'
      '110244216=    SELECT COUNT(*)'
      '110244217=      FROM RDB$TRIGGERS'
      '110244218=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGI'#39
      '110244219=      INTO :ANZ;'
      '110244220='
      '110244221=    IF (ANZ>0) THEN'
      '110244222=      TRGIX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGI'#39';'
      '110244223=    ELSE'
      '110244224=      TRGIX='#39#39';'
      '110244225='
      
        '110244226=    TRGI='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGI FOR '#39'||TN||'#39' AC' +
        'TIVE AFTER INSERT POSITION 255 AS '#39'||CRLF||'
      
        '110244227=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEG' +
        'MENT SIZE 80;'#39'||CRLF||'
      '110244228=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '110244229=         '#39'BEGIN'#39'||CRLF||'
      
        '110244230=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39' ||CRLF;'
      '110244231='
      '110244232=    IF (TN = '#39'LT_SKLAD_PRODUCT'#39') THEN BEGIN'
      '110244233='
      
        '110244234=      /*19.08.2021 '#1050#1054#1056#1054#1063#1045' '#1050#1040#1050' '#1041#1067' '#1071' '#1053#1048' '#1057#1058#1040#1056#1040#1051#1057#1071' - '#1042#1057#1045' '#1056 +
        #1040#1042#1053#1054' '#1055#1054#1071#1042#1051#1071#1070#1058#1057#1071' '#1050#1054#1051#1051#1048#1047#1048#1048' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052
      
        '110244235=      '#1056#1045#1064#1048#1051' '#1058#1040#1050' - '#1058#1059#1058' '#1041#1059#1044#1059' '#1055#1056#1054#1057#1058#1054' '#1047#1040#1055#1048#1057#1067#1042#1040#1058#1068' ID '#1058#1054#1042#1040#1056#1054 +
        #1042', '#1055#1054' '#1050#1054#1058#1054#1056#1067#1052' '#1048#1047#1052#1045#1053#1048#1051#1048#1057#1068' '#1054#1057#1058#1040#1058#1050#1048', '#1048' '#1059#1046#1045' '#1055#1056#1048' '#1047#1040#1043#1056#1059#1047#1050#1045' '#1044#1040#1053#1053#1067#1061
      
        '110244236=      '#1041#1059#1044#1059' '#1058#1059#1055#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1042#1057#1045#1061' '#1055#1056#1048#1061#1054#1044#1054#1042'-'#1056#1040#1057#1061#1054#1044#1054#1042 +
        ' '#1058#1054#1042#1040#1056#1040', '#1071' '#1053#1045' '#1044#1059#1052#1040#1070' '#1063#1058#1054' '#1069#1058#1054' '#1041#1059#1044#1045#1058' '#1047#1040#1053#1048#1052#1040#1058#1068' '#1052#1053#1054#1043#1054' '#1042#1056#1045#1052#1045#1053#1048
      '110244237='
      '110244238=      TRGI = TRGI||'
      
        '110244239=         '#39'  SQLSTMT='#39#39#39'||'#39'MERGE INTO LT_SKLAD_PRODUCT ' +
        'LT '#39'||'
      
        '110244240=                        '#39'USING (select '#39#39' || NEW.G_PRO' +
        'DUCT || '#39#39' AS G_PRODUCT, '#39#39' || NEW.G_TOCHKA || '#39#39' AS G_TOCHKA FR' +
        'OM RDB$DATABASE) CD '#39'||'
      
        '110244241=                        '#39'ON (LT.G_PRODUCT = CD.G_PRODU' +
        'CT AND LT.G_TOCHKA = CD.G_TOCHKA) '#39'||'
      '110244242=                        '#39'WHEN MATCHED THEN '#39'||'
      '110244243=                        '#39'    UPDATE SET '#39'||'
      
