        '1102017057=                                                  :UP' +
        'LOAD_TO_EXT_APP_,'
      
        '1102017058=                                                  :G_' +
        'OFFICIAL_'
      
        '1102017059=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102017060=                END'
      '1102017061=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102017062=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102017063=                  EXIT;'
      '1102017064=                END'
      '1102017065=            END */'
      
        '1102017066=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1102017067=            --=======================================' +
        '=========================='
      '1102017068='
      '1102017069=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1102017070='
      
        '1102017071=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOA' +
        'D_TO_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040 +
        #1058#1053#1054' '#1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102017072=      IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_SPISANIE_ = ' +
        '0) THEN'
      
        '1102017073=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER, IS_LOADED_MOB)'
      
        '1102017074=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 2, CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END'
      '1102017075=          FROM RDB$DATABASE'
      
        '1102017076=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP' +
        ' AP WHERE AP.OBJECT_TYPE = 1 AND AP.ID = :ZAKAZ_ AND AP.IS_LOADI' +
        'NG = 0);'
      '1102017077=  END'
      '1102017078=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1102017079=  ---------------------------------------------------' +
