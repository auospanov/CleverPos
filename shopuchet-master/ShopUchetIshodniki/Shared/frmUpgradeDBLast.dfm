      '1101010=CREATE PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      
        '1101011=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '1101012=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T)'
      '1101013=RETURNS ('
      '1101014=  SKLAD_ /* TYPE OF COLUMN SKLAD.SKLAD */ BIGINT,'
      '1101015=  ERR_CODE INTEGER,'
      '1101016=  ERR_MSG VARCHAR(1024))'
      '1101017=AS'
      '1101018=BEGIN'
      '1101019=  SUSPEND;'
      '11010110=END'
      '11010111=;'
      '11010112='
      '11010113='
      
        '11010114=/******************************************************' +
        '************************/'
      
        '11010115=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11010116=/******************************************************' +
        '************************/'
      '11010117=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '11010118=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11010119=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11010120=RETURNS ('
      '11010121=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '11010122=  ERR_CODE INTEGER,'
      '11010123=  ERR_MSG VARCHAR(1024))'
      '11010124=AS'
      '11010125=/*'
      '11010126='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '11010127=*/'
      
        '11010128=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TMP' +
        #39';'
      '11010129=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11010130=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      
        '11010131=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11010132=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE;'
      
        '11010133=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT' +
        '.VOLUME_PRICE;'
      '11010134=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '11010135=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '11010136=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '11010137=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUM' +
        'M;'
      '11010138=BEGIN'
      '11010139='
      '11010140=  PNT_ = '#39'01'#39';'
      
        '11010141=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCODE' +
        '_, NULL, NULL, NULL, NULL)'
      
        '11010142=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGORY' +
        '_, :PRICE_, :VOLUME_PRICE_, :AMOUNT_, :ERR_CODE, :ERR_MSG;'
      '11010143='
      '11010144=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11010145=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11010146=    EXIT;'
      '11010147=  END'
      '11010148='
      '11010149=  PNT_ = '#39'02'#39';'
      
        '11010150=  EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, :G' +
        '_TOCHKA_, 0)'
      '11010151=      RETURNING_VALUES :PRICE_;'
      '11010152='
      '11010153=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11010154=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11010155=    EXIT;'
      '11010156=  END'
      '11010157='
      '11010158=  AMOUNT_ = 1;'
      '11010159='
      '11010160=  SELECT T.SKLAD'
      '11010161=    FROM SKLAD_TMP T'
      '11010162=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11010163=     AND T.PRICE = :PRICE_'
      '11010164=    INTO :SKLAD_;'
      '11010165='
      '11010166=  IF (SKLAD_ IS NOT NULL) THEN'
      '11010167=    UPDATE SKLAD_TMP T'
      '11010168=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '11010169=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '11010170=     WHERE T.SKLAD = :SKLAD_;'
      '11010171='
      '11010172=  ELSE'
      
        '11010173=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM)'
      
        '11010174=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, ' +
        ':AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_)'
      '11010175=      RETURNING SKLAD'
      '11010176=      INTO :SKLAD_;'
      '11010177=end'
      '11010178=;'
      
        '11010179=UPDATE SYSTEM_SETUP SET S_VALUE = 110101 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '11010180=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11010181=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
