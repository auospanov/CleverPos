        '110233592=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058 +
        #1054#1042#1040#1056#1040#39', 1);'
      '110233593='
      '110233594=      IS_FIRST_ = 0;'
      '110233595=    END'
      '110233596='
      '110233597=    REC_profit_   = REC_SUM_COST_ + V_SUMM_;'
