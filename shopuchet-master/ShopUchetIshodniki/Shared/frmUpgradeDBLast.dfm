      '11052216=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_DISCOUNT('
      '11052217=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT)'
      '11052218=RETURNS ('
      '11052219=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '11052220=  G_PRODUCT_PAR_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '11052221=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11052222=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11052223=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11052224=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '11052225=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11052226=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11052227=  G_TOCHKA_ TYPE OF COLUMN G_DISCOUNT.G_TOCHKA,'
      '11052228=  ERR_CODE INTEGER,'
      '11052229=  ERR_MSG VARCHAR(1024))'
      '11052230=AS'
      '11052231=begin'
      
        '11052232=    SELECT D.G_PRODUCT, P.G_PRODUCT_PAR, D.DATE_BEGIN, ' +
        'D.DATE_END, D.NAME, D.PRICE, D.SKIDKA_PROC, D.SKIDKA_SUM, D.G_TO' +
        'CHKA'
      '11052233=    FROM G_DISCOUNT D, G_PRODUCT P'
      '11052234=    WHERE d.G_DISCOUNT = :G_DISCOUNT_'
      '11052235=    and D.G_PRODUCT = P.G_PRODUCT'
      
        '11052236=    INTO :G_PRODUCT_, :G_PRODUCT_PAR_, :DATE_BEGIN_, :D' +
        'ATE_END_, :NAME_, :PRICE_, :SKIDKA_PROC_, :SKIDKA_SUM_, :G_TOCHK' +
        'A_;'
      '11052237=end'
      '11052238='#39';'
      '11052239='
      
        '11052240=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_DISCOUNT_BY_' +
        'PRODUCT('
      '11052241=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '11052242=RETURNS ('
      '11052243=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11052244=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11052245=  IS_HAVE_SKIDKA_ VARCHAR(10),'
      '11052246=  ERR_CODE INTEGER,'
      '11052247=  ERR_MSG VARCHAR(1024))'
      '11052248=AS'
      
        '11052249=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11052250=BEGIN'
      '11052251=    SELECT ID'
      '11052252=      FROM CUR_PARAMS'
      '11052253=     WHERE CUR_PARAMS = 2'
      '11052254=      INTO :G_TOCHKA_;'
      '11052255='
      '11052256=    SELECT D.SKIDKA_PROC, D.SKIDKA_SUM, '#39#39#1045#1057#1058#1068#39#39
      '11052257=    FROM G_DISCOUNT D'
      '11052258=    WHERE D.G_PRODUCT = :G_PRODUCT_'
      
        '11052259=      AND ((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050 +
        #1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      '11052260=            AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '11052261=            AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END' +
        ' IS NOT NULL'
      '11052262=            )'
      '11052263=            OR'
      
        '11052264=            (D.DATE_BEGIN IS NULL AND D.DATE_END IS NUL' +
        'L)'
      '11052265=          )'
      '11052266=      AND COALESCE(D.G_TOCHKA, :G_TOCHKA_) = :G_TOCHKA_'
      '11052267=    INTO :SKIDKA_PROC_, :SKIDKA_SUM_, :IS_HAVE_SKIDKA_;'
      '11052268='
      '11052269=    if (IS_HAVE_SKIDKA_ IS NULL) then'
      '11052270=      IS_HAVE_SKIDKA_ = '#39#39#1053#1045#1058#39#39';'
      '11052271=end'
      '11052272='#39';'
      '11052273='
      
        '11052274=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_PRODUCT_SALE' +
        'MODE('
      '11052275=  G_PRODUCT_ INTEGER,'
      '11052276=  G_TOCHKA_ INTEGER)'
      '11052277=RETURNS ('
      '11052278=  NAME_ VARCHAR(500),'
      '11052279=  PRICE_ NUMERIC(15,2),'
      '11052280=  ROZN_PRICE_ NUMERIC(15,2),'
      '11052281=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11052282=  AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '11052283=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11052284=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11052285=  SKIDKA_SUMM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11052286=  ERR_CODE INTEGER,'
      '11052287=  ERR_MSG VARCHAR(1024))'
      '11052288=AS'
      '11052289=BEGIN'
      '11052290=    SELECT'
      '11052291=        t.NAME,'
      '11052292=        t.PRICE,'
      '11052293=        T.price,'
      '11052294=        t.VOLUME_PRICE,'
      '11052295=        t.PACK_AMOUNT'
      
        '11052296=        ,COALESCE(P.AMOUNT, 0) - COALESCE(P.AMOUNT_RESE' +
        'RVE, 0) AMOUNT'
      '11052297=        ,COALESCE(PP.SKIDKA_PROC, 0)'
      '11052298=        ,COALESCE(PP.SKIDKA_SUM, 0)'
      '11052299=    FROM G_PRODUCT T'
      
        '11052300=         LEFT OUTER JOIN (SELECT G_PRODUCT, AMOUNT, AMO' +
        'UNT_RESERVE FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_)  ' +
        'P ON T.G_PRODUCT = P.G_PRODUCT'
      
        '11052301=         LEFT OUTER JOIN (SELECT G_PRODUCT, D.SKIDKA_PR' +
        'OC, D.SKIDKA_SUM'
      
        '11052302=                                        FROM G_DISCOUNT' +
        ' D'
      
        '11052303=                                        WHERE (D.DATE_B' +
        'EGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '11052304=                                                AND D.D' +
        'ATE_END >= CURRENT_TIMESTAMP'
      
        '11052305=                                                AND D.D' +
        'ATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      '11052306=                                              )'
      '11052307=                                              OR'
      
        '11052308=                                              (D.DATE_B' +
        'EGIN IS NULL AND D.DATE_END IS NULL)'
      
        '11052309=                                        AND COALESCE(D.' +
        'G_TOCHKA, :G_TOCHKA_) = :G_TOCHKA_'
      
        '11052310=                                     ) PP ON T.G_PRODUC' +
        'T = PP.G_PRODUCT'
      '11052311=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11052312=    INTO'
      '11052313=        :NAME_,'
      '11052314=        :PRICE_,'
      '11052315=        :ROZN_PRICE_,'
      '11052316=        :VOLUME_PRICE_,'
      '11052317=        :PACK_AMOUNT_,'
      '11052318=        :AMOUNT_,'
      '11052319=        :SKIDKA_PROC_,'
      '11052320=        :SKIDKA_SUMM_;'
      '11052321=end'
      '11052322='#39';'
      '11052323='
      '11052324=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_DISCOUNT('
      
        '11052325=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11052326=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '11052327=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11052328=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11052329=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11052330=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11052331=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11052332=  G_TOCHKA_ TYPE OF COLUMN G_DISCOUNT.G_TOCHKA)'
      '11052333=RETURNS ('
      '11052334=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11052335=  ERR_CODE INTEGER,'
      '11052336=  ERR_MSG VARCHAR(1024))'
      '11052337=AS'
      '11052338=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11052339=DECLARE VARIABLE G_PRODUCT_REC_ TYPE OF COLUMN G_DISCOU' +
        'NT.G_PRODUCT;'
      
        '11052340=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_DISCOUNT.G' +
        '_PRODUCT;'
      
        '11052341=DECLARE VARIABLE SKIDKA_PROC_R_ TYPE OF COLUMN G_DISCOU' +
        'NT.SKIDKA_PROC; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      
        '11052342=DECLARE VARIABLE SKIDKA_SUM_R_ TYPE OF COLUMN G_DISCOUN' +
        'T.SKIDKA_SUM; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      '11052343=begin'
      '11052344=    FOR SELECT G.G_PRODUCT,'
      '11052345=               G.PRICE'
      '11052346=          FROM G_PRODUCT G'
      
        '11052347=         WHERE G.G_PRODUCT_PAR = DECODE(:G_PRODUCT_PAR_' +
        ', -1, G.G_PRODUCT_PAR, :G_PRODUCT_PAR_)'
      
        '11052348=           AND G.G_PRODUCT = COALESCE(:G_PRODUCT_, G.G_' +
        'PRODUCT)'
      '11052349=           AND G.IS_ACTIVE = 1'
      '11052350=           AND G.IS_CATEGORY = 0'
      '11052351=           AND G.PRICE > 0'
      '11052352=          INTO :G_PRODUCT_REC_,'
      '11052353=               :PRICE_REC_'
      '11052354=    DO BEGIN'
      '11052357=        if (COALESCE(G_PRODUCT_, 0) = 0) then'
      
        '11052358=          DELETE FROM G_DISCOUNT WHERE COALESCE(DATE_BE' +
        'GIN, CURRENT_DATE) <= CURRENT_DATE AND COALESCE(DATE_END, CURREN' +
        'T_DATE) >= CURRENT_DATE'
      '11052359=            AND G_PRODUCT = :G_PRODUCT_REC_;'
      '11052360=        ELSE BEGIN'
      '11052361=            SELECT COUNT(*)'
      '11052362=              FROM G_DISCOUNT'
      '11052363=             WHERE G_PRODUCT = :G_PRODUCT_REC_'
      
        '11052364=               AND COALESCE(DATE_BEGIN, CURRENT_DATE) <' +
        '= CURRENT_DATE'
      
        '11052365=               AND COALESCE(DATE_END, CURRENT_DATE) >= ' +
        'CURRENT_DATE'
      
        '11052366=               AND ((G_TOCHKA = COALESCE(:G_TOCHKA_, 0)' +
        ')'
      '11052367=                    OR'
      '11052368=                    (G_TOCHKA IS NULL)'
      '11052369=                   )'
      '11052370=              INTO CNT_;'
      '11052371='
      '11052372=            IF (CNT_ <> 0) THEN BEGIN'
      '11052373=              ERR_CODE = -20500;'
      
        '11052374=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1053#1072' '#1076#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '11052375=              EXIT;'
      '11052376=            END'
      '11052377=        END'
      '11052378='
      
        '11052379=        -- '#1055#1056#1048' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1071' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' '#1055#1054#1051#1059#1063#1040#1045#1058#1057 +
        #1071' '#1063#1058#1054' '#1054#1044#1053#1054' '#1048#1047' '#1055#1054#1051#1045#1049' - '#1055#1059#1057#1058#1054#1045
      '11052380=        SKIDKA_PROC_R_ = SKIDKA_PROC_;'
      '11052381=        SKIDKA_SUM_R_  = SKIDKA_SUM_;'
      '11052382=        IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '11052383=          IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '11052384=            SKIDKA_PROC_R_ = ROUND(SKIDKA_SUM_ * 100 / ' +
        'PRICE_REC_ , 2);'
      '11052385=          IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '11052386=            SKIDKA_SUM_R_ = ROUND(PRICE_REC_ * SKIDKA_P' +
        'ROC_ / 100 , 2);'
      '11052387=        END'
      '11052388='
      
        '11052389=        INSERT INTO G_DISCOUNT (G_DISCOUNT, G_PRODUCT, ' +
        'DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA_SUM, G_TO' +
        'CHKA)'
      
        '11052390=        VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G_PRODUCT_R' +
        'EC_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :SKIDKA_PROC' +
        '_R_, :SKIDKA_SUM_R_'
      '11052391=                ,:G_TOCHKA_)'
      '11052392=        RETURNING G_DISCOUNT'
      '11052393=        INTO :G_DISCOUNT_;'
      '11052394=    END'
      '11052395=end'
      '11052396='#39';'
      '11052397='
      
        '11052398=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_READ_G_DISCOUNT_LI' +
        'ST('
      '11052399=  IS_ALL_ INTEGER)'
      '11052400=RETURNS ('
      '11052401=  G_DISCOUNT INTEGER,'
      '11052402=  G_PRODUCT INTEGER,'
      '11052403=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11052404=  DATE_BEGIN DATE,'
      '11052405=  DATE_END DATE,'
      '11052406=  NAME VARCHAR(1024),'
      '11052407=  PRICE NUMERIC(15,2),'
      '11052408=  SKIDKA_PROC NUMERIC(15,2),'
      '11052409=  SKIDKA_SUM NUMERIC(15,2),'
      '11052410=  IS_CONST INTEGER,'
      '11052411=  TOCHKA_NAME TYPE OF COLUMN G_TOCHKA.NAME)'
      '11052412=AS'
      '11052413=begin'
      '11052414=    FOR'
      '11052415=      SELECT GD.G_DISCOUNT, GD.G_PRODUCT, GP.NAME,'
      '11052416=             GD.DATE_BEGIN,'
      '11052417=             GD.DATE_END,'
      
        '11052418=             CASE WHEN GD.DATE_END IS NULL THEN 1 ELSE ' +
        '0 END IS_CONST,'
      
        '11052419=             GD.NAME, GD.PRICE, GD.SKIDKA_PROC, GD.SKID' +
        'KA_SUM,'
      
        '11052420=             CASE WHEN GD.G_TOCHKA IS NULL THEN '#39#39#1042#1089#1077' '#1090 +
        #1086#1095#1082#1080#39#39' ELSE T.NAME END'
      
        '11052421=      FROM G_DISCOUNT GD LEFT OUTER JOIN G_TOCHKA T ON ' +
        'GD.G_TOCHKA = T.G_TOCHKA, G_PRODUCT GP'
      '11052422=      WHERE GD.G_PRODUCT = GP.G_PRODUCT'
      '11052423=        AND ('
      '11052424=             (('
      '11052425=                ('
      
        '11052426=                  GD.DATE_BEGIN <= CURRENT_DATE       -' +
        '- '#1042#1067#1043#1056#1059#1046#1040#1070#1058#1057#1071' '#1057' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1052' '#1055#1045#1056#1048#1054#1044#1054#1052
      '11052427=                  AND'
      '11052428=                  GD.DATE_END >= CURRENT_DATE'
      '11052429=                  AND GD.DATE_BEGIN IS NOT NULL'
      '11052430=                  AND GD.DATE_END IS NOT NULL'
      '11052431=                )'
      '11052432=              OR'
      '11052433=                ('
      
        '11052434=                 GD.DATE_BEGIN IS NULL AND GD.DATE_END ' +
        'IS NULL  -- '#1040' '#1058#1040#1050#1046#1045' '#1055#1054#1057#1058#1054#1071#1053#1053#1067#1045' '#1057#1050#1048#1044#1050#1048
      '11052435=                )'
      '11052436=              )'
      '11052437=              AND :IS_ALL_ = 1)'
      '11052438=             OR'
      
        '11052439=             (:IS_ALL_ = 0)                            ' +
        '         -- '#1051#1048#1041#1054' '#1042#1057#1045
      '11052440=            )'
      
        '11052441=      INTO :G_DISCOUNT, :G_PRODUCT, :G_PRODUCT_NAME, :D' +
        'ATE_BEGIN, :DATE_END, :IS_CONST, :NAME, :PRICE, :SKIDKA_PROC, :S' +
        'KIDKA_SUM,'
      '11052442=           :TOCHKA_NAME'
      '11052443=    DO'
      '11052444=      SUSPEND;'
      '11052445=end'
      '11052446='#39';'
      '11052447='
      '11052448=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_DISCOUNT('
      '11052449=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11052450=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      
        '11052451=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11052452=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11052453=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11052454=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11052455=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '11052456=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11052457=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11052458=  G_TOCHKA_ TYPE OF COLUMN G_DISCOUNT.G_TOCHKA)'
      '11052459=RETURNS ('
      '11052460=  ERR_CODE INTEGER,'
      '11052461=  ERR_MSG VARCHAR(1024))'
      '11052462=AS'
      '11052463=DECLARE VARIABLE CNT_ INTEGER;'
      '11052464=begin'
      '11052465=    SELECT COUNT(*)'
      '11052466=      FROM G_DISCOUNT'
      '11052467=     WHERE G_PRODUCT = :G_PRODUCT_'
      '11052468=       AND DATE_BEGIN <= CURRENT_TIMESTAMP'
      '11052469=       AND DATE_END >= CURRENT_TIMESTAMP'
      '11052470=       AND G_DISCOUNT <> :G_DISCOUNT_'
      '11052471=       AND ((G_TOCHKA = COALESCE(:G_TOCHKA_, 0))'
      '11052472=            OR'
      '11052473=            (G_TOCHKA IS NULL)'
      '11052474=           )'
      '11052475=      INTO CNT_;'
      '11052476='
      '11052477=    IF (CNT_ <> 0) THEN BEGIN'
      '11052478=      ERR_CODE = -20500;'
      
        '11052479=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1072' '#1076#1072#1085#1085 +
        #1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39#39') RETURNING_VALUES (:ERR_' +
        'MSG);'
      '11052480=      EXIT;'
      '11052481=    END'
      '11052482='
      '11052483=    UPDATE G_DISCOUNT'
      '11052484=    SET G_PRODUCT = :G_PRODUCT_,'
      '11052485=        DATE_BEGIN = :DATE_BEGIN_,'
      '11052486=        DATE_END = :DATE_END_,'
      '11052487=        NAME = :NAME_,'
      '11052488=        PRICE = :PRICE_,'
      '11052489=        SKIDKA_PROC = :SKIDKA_PROC_,'
      '11052490=        SKIDKA_SUM = :SKIDKA_SUM_,'
      '11052491=        G_TOCHKA = :G_TOCHKA_'
      '11052492=    WHERE (G_DISCOUNT = :G_DISCOUNT_);'
      '11052493=end'
      '11052494='#39';'
      
        '11052495=UPDATE SYSTEM_SETUP SET S_VALUE = 11052 WHERE SYSTEM_SE' +
        'TUP = 3;'
      '11052496=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110530=EXECUTE BLOCK AS BEGIN'
      '110531=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_ZAKAZ('
      '110532=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ INTEGER,'
      
        '110533=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ INT' +
        'EGER = 0)'
      '110534=RETURNS ('
      '110535=  ERR_CODE INTEGER,'
      '110536=  ERR_MSG VARCHAR(1024))'
      '110537=AS'
      '110538=BEGIN'
      '110539=  SUSPEND;'
      '1105310=END'
      '1105311='#39';'
      '1105312='
      '1105313=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_OFFICIAL('
      
        '1105314=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' INTEGER)'
      '1105315=RETURNS ('
      '1105316=  FM_ /* TYPE OF COLUMN G_OFFICIAL.FM */ VARCHAR(100),'
      '1105317=  NM_ /* TYPE OF COLUMN G_OFFICIAL.NM */ VARCHAR(100),'
      '1105318=  FT_ /* TYPE OF COLUMN G_OFFICIAL.FT */ VARCHAR(100),'
      
        '1105319=  FIO_DOC_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */ VARCH' +
        'AR(150),'
      '1105320=  RNN_ /* TYPE OF COLUMN G_OFFICIAL.RNN */ VARCHAR(12),'
      '1105321=  IDN_ /* TYPE OF COLUMN G_OFFICIAL.IDN */ VARCHAR(12),'
      '1105322=  DT_ /* TYPE OF COLUMN G_OFFICIAL.DT */ DATE,'
      
        '1105323=  G_ID_KIND_ /* TYPE OF COLUMN G_OFFICIAL.G_ID_KIND */ V' +
        'ARCHAR(100),'
      
        '1105324=  ID_NUM_ /* TYPE OF COLUMN G_OFFICIAL.ID_NUM */ VARCHAR' +
        '(100),'
      '1105325=  ID_DATE_ /* TYPE OF COLUMN G_OFFICIAL.ID_DATE */ DATE,'
      
        '1105326=  ID_ISSUER_ /* TYPE OF COLUMN G_OFFICIAL.ID_ISSUER */ V' +
        'ARCHAR(100),'
      
        '1105327=  G_APPOINTMENT_ /* TYPE OF COLUMN G_OFFICIAL.G_APPOINTM' +
        'ENT */ INTEGER,'
      
        '1105328=  IS_RUKOVODITEL_ /* TYPE OF COLUMN G_OFFICIAL.IS_RUKOVO' +
        'DITEL */ INTEGER,'
      
        '1105329=  IS_GLAVBUH_ /* TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH */' +
        ' INTEGER,'
      
        '1105330=  IS_ISPOLNITEL_ /* TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNI' +
        'TEL */ SMALLINT,'
      
        '1105331=  PASSWORD_ /* TYPE OF COLUMN G_OFFICIAL.PASS */ VARCHAR' +
        '(50),'
      
        '1105332=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTEG' +
        'ER,'
      '1105333=  RIGHTS_ARR_ VARCHAR(1000),'
      '1105334=  ERR_CODE INTEGER,'
      '1105335=  ERR_MSG VARCHAR(1024))'
      '1105336=AS'
      '1105337=BEGIN'
      '1105338=  SUSPEND;'
      '1105339=END'
      '1105340='#39';'
      '1105341='
      '1105342=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_PRODUCT('
      '1105343=  G_PRODUCT_ INTEGER)'
      '1105344=RETURNS ('
      '1105345=  G_PRODUCT_PAR_ INTEGER,'
      '1105346=  ARTICUL_ VARCHAR(30),'
      '1105347=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1105348=  BARCODE_ VARCHAR(30),'
      '1105349=  NAME_ VARCHAR(500),'
      '1105350=  G_UNIT_ INTEGER,'
      '1105351=  PRICE_ NUMERIC(15,2),'
      '1105352=  VOLUME_PRICE_ NUMERIC(15,2),'
      
        '1105353=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT *' +
        '/ NUMERIC(15,2),'
      
        '1105354=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */ ' +
        'VARCHAR(150),'
      
        '1105355=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300)' +
        ','
      
        '1105356=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ BL' +
        'OB SUB_TYPE 1 SEGMENT SIZE 16384,'
      '1105357=  IS_KIT_ /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER,'
      
        '1105358=  MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT */ ' +
        'NUMERIC(15,2),'
      
        '1105359=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(25' +
        '0),'
      '1105360=  ERR_CODE INTEGER,'
      '1105361=  ERR_MSG VARCHAR(1024))'
      '1105362=AS'
      '1105363=BEGIN'
      '1105364=  SUSPEND;'
      '1105365=END'
      '1105366='#39';'
      '1105367='
      '1105368=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '1105369=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR */ INTEGER,'
      
        '1105370=  ARTICUL_ /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
