        '1102201395=                                                    N' +
        'ULL,  --ZAKAZ'
      
        '1102201396=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1102201397=                                                    :' +
        'PAYMENT_TYPE_,'
      
        '1102201398=                                                    :' +
        'UPLOAD_TO_EXT_APP_'
      
        '1102201399=                                                    )' +
        ' RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102201400='
      
        '1102201401=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102201402=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102201403=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1102201404=                      PNT_ = '#39'011'#39';'
      
        '1102201405=                      EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUE' +
        'S (:ERR_CODE, :ERR_MSG);'
      '1102201406=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201407=                        ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1102201408=                        EXIT;'
      '1102201409=                      END'
      '1102201410='
      
        '1102201411=                      EXECUTE PROCEDURE K_INS_KASSA(1' +
        ',     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102201412=                                                    :' +
        'G_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1102201413=                                                    :' +
