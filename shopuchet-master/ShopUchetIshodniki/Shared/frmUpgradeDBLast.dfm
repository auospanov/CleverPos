      '1102391346='
      '1102391347=  /*'
      '1102391348=  POS_ = 1;'
      '1102391349=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '1102391350=    BEGIN'
      
        '1102391351=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ F' +
        'ROM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '1102391352='
      '1102391353=        WHILE (POS_ > 0) DO BEGIN'
      '1102391354=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '1102391355='
      '1102391356=            IF (POS_ > 0) THEN'
      
        '1102391357=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1' +
        ' FOR POS_ - 1);'
      '1102391358=            ELSE'
      '1102391359=              STR_ = PRODUCT_ID_ARR_;'
      '1102391360='
      
        '1102391361=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 F' +
        'OR POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '1102391362=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSI' +
        'TION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN ST' +
        'R_)) AS BIGINT);'
      '1102391363='
      
        '1102391364=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_' +
        'ARR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '1102391365='
      '1102391366=            select ('
      '1102391367=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102391368=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s, sklad_parent sp'
      '1102391369=                    where sp.SKLAD = s.SKLAD_PARENT'
      '1102391370=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '1102391371=                      and s.g_product = :G_PRODUCT_'
      
        '1102391372=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077 +
        ' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102391373='
      '1102391374=                   -'
      '1102391375=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102391376=                   (select COALESCE(sum(zr.AMOUNT_ALL' +
        '), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102391377=                    where zr.g_product = :G_PRODUCT_ ' +
        'and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102391378=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZA' +
