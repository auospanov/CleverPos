      '110121101=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '110121102=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_'
      '110121103=       AND L.G_TOCHKA = NEW.g_tochka;'
      '110121104='
      '110121105=    IF (ROW_COUNT = 0) THEN'
      
        '110121106=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, ' +
        'G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110121107=      VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PROD' +
        'UCT_SOSTAV_, :G_PRODUCT_SOSTAV_AMOUNT_, 0, NEW.G_TOCHKA);'
      '110121108=  END'
      '110121109=end'
      '110121110=;'
      '110121111='
      '110121112='
      
        '110121113=/*****************************************************' +
        '*************************/'
      
        '110121114=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110121115=/*****************************************************' +
        '*************************/'
      '110121116=ALTER PROCEDURE DO_PRODUCT('
      '110121117=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110121118=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '110121119=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110121120=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110121121=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '110121122=RETURNS ('
      '110121123=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '110121124=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '110121125=  ERR_CODE INTEGER,'
      '110121126=  ERR_MSG VARCHAR(1024))'
      '110121127=AS'
      '110121128=/*'
      
        '110121129='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055 +
        #1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '110121130='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '110121131=*/'
      '110121132=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39';'
      '110121133=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110121134=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042 +
        #1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '110121135=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT;'
      
        '110121136=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '110121137=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067 +
        ' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '110121138=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110121139=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110121140=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '110121141=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      '110121142=BEGIN'
      '110121143=  PNT_ = '#39'00'#39';'
      '110121144=  COST_PRICE_ = 0;'
      '110121145='
      '110121146=  IF (G_TOCHKA_ IS NULL) THEN'
      '110121147=    SELECT ID'
      '110121148=      FROM CUR_PARAMS'
      '110121149=     WHERE CUR_PARAMS = 2'
      '110121150=      INTO :G_TOCHKA_;'
      '110121151='
      '110121152=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '110121153=  SELECT P.S_VALUE'
      '110121154=    FROM SYSTEM_SETUP P'
      '110121155=   WHERE P.SYSTEM_SETUP = 2'
      '110121156=    INTO :CAN_SELL_;'
      '110121157='
      '110121158=  SELECT MAX(G.NAME)'
      '110121159=    FROM G_PRODUCT G,'
      '110121160=         G_PRODUCT_KIT K'
      '110121161=   WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '110121162=     AND K.G_PRODUCT = :G_PRODUCT_'
      
        '110121163=     AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PRODU' +
        'CT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCHKA_' +
        '), 0) < (K.AMOUNT * :AMOUNT_)'
      '110121164=    INTO :NAME_;'
      '110121165='
      '110121166=  IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEGIN'
      '110121167=    ERR_CODE = -20500;'
      
        '110121168=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072#1090#1086#1082' '#1089 +
        #1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087#1088#1086#1080#1079#1074 +
        #1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110121169=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110121170=    EXIT;'
      '110121171=  END'
      '110121172='
      '110121173=  PNT_ = '#39'01'#39';'
      '110121174=  -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '110121175=  INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIVAL_' +
        'TYPE, PARENT_ID, NOTE, G_TOCHKA)'
      
        '110121176=  VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0, 1' +
        ', :OTHER_, :NOTE_, :G_TOCHKA_)'
      '110121177=  RETURNING OTHER'
      '110121178=  INTO :OTHER_;'
      '110121179='
      '110121180=  FOR SELECT K.G_PRODUCT_ITEM'
      '110121181=            ,K.AMOUNT*:AMOUNT_'
      '110121182=            ,K.amount'
      '110121183=            ,G.G_PRODUCT'
      '110121184=        FROM G_PRODUCT_KIT K'
      '110121185=            ,G_PRODUCT G'
      '110121186=       WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110121187=         AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '110121188=        INTO :ITEM_'
      '110121189=            ,:AMOUNT_NEED_'
      '110121190=            ,:AMOUNT_NEED_ONE_'
      '110121191=            ,:G_PRODUCT_KIT_'
      '110121192=  DO BEGIN'
      
        '110121193=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_K' +
        'IT_, NULL, 1)'
      '110121194=      RETURNING_VALUES :SELF_PRICE_;'
      '110121195='
      '110121196=    UPDATE LT_SKLAD_PRODUCT L'
      '110121197=       SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110121198=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110121199=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110121200='
      '110121201=    IF (ROW_COUNT = 0) THEN'
      
        '110121202=      INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(GEN_' +
        'LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G_TOC' +
        'HKA_);'
      '110121203='
      
        '110121204=    INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHER, G' +
        '_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110121205=    VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_, :G_' +
        'PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110121206='
      
        '110121207=    COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*SELF_' +
        'PRICE_;'
      '110121208=  END'
      '110121209='
      '110121210='
      
        '110121211=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063#1040#1051#1045' ' +
        #1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110121212=  PNT_ = '#39'02'#39';'
      
        '110121213=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM)'
      
        '110121214=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :AM' +
        'OUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110121215='
      '110121216=  EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110121217=                              :DATE_,'
      '110121218=                              CURRENT_TIME,'
      '110121219=                              NULL, --:G_CLIENT__,'
      
        '110121220=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110121221=                              NULL, --:OSNOVANIE__,'
      '110121222=                              :NOTE_,'
      '110121223=                              4, --:IS_VOZVRAT_,'
      '110121224=                              :AMOUNT_*:COST_PRICE_,'
      '110121225=                              :AMOUNT_*:COST_PRICE_,'
      '110121226=                              0, --:G_PRIHOD_,'
      '110121227=                              0 --:SUMM_PRIHOD_)'
      '110121228=                              ,NULL     --PAYMENTS_'
      
        '110121229=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110121230=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110121231=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110121232=      EXIT;'
      '110121233=  END'
      '110121234='
      '110121235=  UPDATE OTHER O'
      '110121236=    SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110121237=  WHERE O.OTHER = :OTHER_;'
      '110121238=END'
      '110121239=;'
      
        '110121240=UPDATE SYSTEM_SETUP SET S_VALUE = 110121 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110121241=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110121242=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101220=ALTER TABLE G_CLIENT_DISC_VAL_GRID DROP CONSTRAINT PK_G_' +
        'CLIENT_DISC_VAL_GRID;'
      
        '1101221=ALTER TABLE G_CLIENT_DISC_VAL_GRID ALTER COLUMN G_CLIENT' +
        '_DISC_VAL_GRID TYPE DM_BIGINT;'
      
        '1101222=ALTER TABLE G_CLIENT_DISC_VAL_GRID ADD CONSTRAINT PK_G_C' +
        'LIENT_DISC_VAL_GRID PRIMARY KEY (G_CLIENT_DISC_VAL_GRID);'
      
        '1101223=UPDATE SYSTEM_SETUP SET S_VALUE = 110122 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101224=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101225=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101230=CREATE PROCEDURE GET_PRODUCTION_SELF_PRICE('
      
        '1101231=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT,'
      
        '1101232=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T)'
      '1101233=RETURNS ('
      '1101234=  PRICE_ /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(15,2))'
      '1101235=AS'
      '1101236=BEGIN'
      '1101237=  SUSPEND;'
      '1101238=END'
      '1101239=;'
      '11012310='
      '11012311='
      
        '11012312=/******************************************************' +
        '************************/'
      
        '11012313=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11012314=/******************************************************' +
        '************************/'
      '11012315=ALTER PROCEDURE DO_PRODUCT('
      '11012316=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11012317=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '11012318=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11012319=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11012320=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '11012321=RETURNS ('
      '11012322=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '11012323=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '11012324=  ERR_CODE INTEGER,'
      '11012325=  ERR_MSG VARCHAR(1024))'
      '11012326=AS'
      '11012327=/*'
      
        '11012328='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055#1056 +
        #1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '11012329='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '11012330=*/'
      '11012331=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39';'
      '11012332=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11012333=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042#1040 +
        #1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '11012334=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT;'
      
        '11012335=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '11012336=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067' ' +
        #1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '11012337=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11012338=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      '11012339=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM;'
      '11012340=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '11012341=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11012342=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      '11012343=BEGIN'
      '11012344=  PNT_ = '#39'00'#39';'
      '11012345=  COST_PRICE_ = 0;'
      '11012346='
      '11012347=  IF (G_TOCHKA_ IS NULL) THEN'
      '11012348=    SELECT ID'
      '11012349=      FROM CUR_PARAMS'
      '11012350=     WHERE CUR_PARAMS = 2'
      '11012351=      INTO :G_TOCHKA_;'
      '11012352='
      '11012353=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '11012354=  SELECT P.S_VALUE'
      '11012355=    FROM SYSTEM_SETUP P'
      '11012356=   WHERE P.SYSTEM_SETUP = 2'
      '11012357=    INTO :CAN_SELL_;'
      '11012358='
      '11012359=  FOR SELECT :G_PRODUCT_IN_,'
      '11012360=             :AMOUNT_IN_'
      '11012361=        FROM RDB$DATABASE'
      '11012362=      UNION ALL'
      '11012363=      SELECT G_PRODUCT,'
      '11012364=             AMOUNT'
      '11012365=        FROM ZAKAZ_DETAILS_TMP'
      '11012366=        INTO :G_PRODUCT_,'
      '11012367=             :AMOUNT_'
      '11012368=  DO BEGIN'
      '11012369=      SELECT MAX(G.NAME)'
      '11012370=        FROM G_PRODUCT G,'
      '11012371=             G_PRODUCT_KIT K'
      '11012372=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '11012373=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '11012374=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PR' +
        'ODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCH' +
        'KA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '11012375=        INTO :NAME_;'
      '11012376='
      
        '11012377=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEG' +
        'IN'
      '11012378=        ERR_CODE = -20500;'
      
        '11012379=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072#1090#1086 +
        #1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087#1088#1086 +
        #1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11012380=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11012381=        EXIT;'
      '11012382=      END'
      '11012383='
      '11012384=      PNT_ = '#39'01'#39';'
      
        '11012385=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIV' +
        'AL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '11012386=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0' +
        ', 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '11012387=      RETURNING OTHER'
      '11012388=      INTO :OTHER_;'
      '11012389='
      '11012390=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11012391=      FOR SELECT K.G_PRODUCT_ITEM'
      '11012392=                ,K.AMOUNT*:AMOUNT_'
      '11012393=                ,K.amount'
      '11012394=                ,G.G_PRODUCT'
      '11012395=            FROM G_PRODUCT_KIT K'
      '11012396=                ,G_PRODUCT G'
      '11012397=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11012398=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '11012399=            INTO :ITEM_'
      '110123100=                ,:AMOUNT_NEED_'
      '110123101=                ,:AMOUNT_NEED_ONE_'
      '110123102=                ,:G_PRODUCT_KIT_'
      '110123103=      DO BEGIN'
      
        '110123104=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODU' +
        'CT_KIT_, NULL, 1)'
      '110123105=          RETURNING_VALUES :SELF_PRICE_;'
      '110123106='
      '110123107=        UPDATE LT_SKLAD_PRODUCT L'
      '110123108=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110123109=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110123110=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110123111='
      '110123112=        IF (ROW_COUNT = 0) THEN'
      
        '110123113=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G' +
        '_TOCHKA_);'
      '110123114='
      
        '110123115=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHE' +
        'R, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110123116=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_,' +
        ' :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110123117='
      
        '110123118=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*S' +
        'ELF_PRICE_;'
      '110123119=      END'
      '110123120='
      
        '110123121=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063 +
        #1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110123122=      PNT_ = '#39'02'#39';'
      
        '110123123=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110123124=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110123125='
      '110123126=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110123127=                              :DATE_,'
      '110123128=                              CURRENT_TIME,'
      '110123129=                              NULL, --:G_CLIENT__,'
      
        '110123130=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110123131=                              NULL, --:OSNOVANIE__,'
      '110123132=                              :NOTE_,'
      '110123133=                              4, --:IS_VOZVRAT_,'
      '110123134=                              :AMOUNT_*:COST_PRICE_,'
      '110123135=                              :AMOUNT_*:COST_PRICE_,'
      '110123136=                              0, --:G_PRIHOD_,'
      '110123137=                              0 --:SUMM_PRIHOD_)'
      '110123138=                              ,NULL     --PAYMENTS_'
      
        '110123139=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110123140=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110123141=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110123142=          EXIT;'
      '110123143=      END'
      '110123144='
      '110123145=      UPDATE OTHER O'
      '110123146=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110123147=      WHERE O.OTHER = :OTHER_;'
      '110123148=  END'
      '110123149=END'
      '110123150=;'
      '110123151='
      '110123152=ALTER PROCEDURE GET_PRODUCTION_SELF_PRICE('
      '110123153=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110123154=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110123155=RETURNS ('
      '110123156=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '110123157=AS'
      '110123158=BEGIN'
      
        '110123159=  SELECT SUM(K.AMOUNT * (SELECT * FROM GET_LAST_SELF_P' +
        'RICE(K.G_PRODUCT_ITEM, :G_TOCHKA_, 1)))'
      '110123160=    FROM G_PRODUCT_KIT K'
      '110123161=    WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110123162=    INTO :PRICE_;'
      '110123163='
      '110123164=  SUSPEND;'
      '110123165=END'
      '110123166=;'
      
        '110123167=UPDATE SYSTEM_SETUP SET S_VALUE = 110123 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110123168=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110123169=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
