      '1102283488='
      
        '1102283489=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102283490=            END ELSE BEGIN'
      '1102283491=                UPDATE SKLAD S'
      '1102283492=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1102283493=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1102283494=                       S.PRICE    = :PRICE_,'
      '1102283495=                       S.SUMM     = :SUMMM_,'
