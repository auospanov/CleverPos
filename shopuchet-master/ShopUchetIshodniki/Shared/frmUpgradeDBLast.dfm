      '1106020138=  ERR_MSG VARCHAR(1024))'
      '1106020139=AS'
      
        '1106020140=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INVOICE_PAY'#39 +
        ';'
      '1106020141=DECLARE VARIABLE PNT_ VARCHAR(5);'
