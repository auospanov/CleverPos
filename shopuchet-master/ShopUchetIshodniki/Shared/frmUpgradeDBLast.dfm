      '1101131830=end'
      '1101131831=;'
      '1101131832='
      '1101131833=ALTER PROCEDURE UPD_SKLAD_TMP1('
      '1101131834=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101131835=  OLD_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101131836=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101131837=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101131838=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101131839=  OLD_PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101131840=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101131841=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101131842=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101131843=  CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHARGE_' +
        'ROZN_PROC,'
      
        '1101131844=  OLD_CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHA' +
        'RGE_ROZN_PROC,'
      
        '1101131845=  CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARGE_O' +
        'PT_PROC,'
      
        '1101131846=  OLD_CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHAR' +
        'GE_OPT_PROC,'
      '1101131847=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101131848=  OLD_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN' +
        ','
      '1101131849=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      '1101131850=  OLD_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101131851=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1101131852=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0)'
      '1101131853=RETURNS ('
      '1101131854=  ERR_CODE INTEGER,'
      '1101131855=  ERR_MSG VARCHAR(1024))'
      '1101131856=AS'
      '1101131857=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101131858=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101131859=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLA' +
        'D.PRICE;'
      '1101131860=BEGIN'
      
        '1101131861=  -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1048#1051#1057#1071' '#1058#1054#1042#1040#1056', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040#1049#1058#1048' '#1057#1053#1054#1042#1040' '#1045#1043#1054' '#1047#1040 +
        #1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1062#1045#1053#1059' '#1054#1055#1058
      '1101131862=  PNT_ = '#39'01'#39';'
      '1101131863=  IF (G_PRODUCT_ <> OLD_G_PRODUCT_) THEN BEGIN'
      '1101131864=      SELECT S.PRICE'
      '1101131865=        FROM SKLAD S'
      
        '1101131866=       WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101131867=         AND S.IS_LAST = 1'
      '1101131868=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1101131869=        INTO :LAST_SELF_PRICE_;'
      '1101131870='
      '1101131871=      PRICE_ = COALESCE(LAST_SELF_PRICE_, 0);'
      '1101131872=  END'
      '1101131873='
      '1101131874=  IF (PRICE_ = 0) THEN BEGIN'
      '1101131875=    CHARGE_PRICE_ROZN_ = 0;'
      '1101131876=    CHARGE_PRICE_OPT_ = 0;'
      '1101131877=  END'
      '1101131878=  ELSE BEGIN'
      
        '1101131879=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048
      
        '1101131880=      IF (CHARGE_PRICE_ROZN_ <> OLD_CHARGE_PRICE_ROZN' +
        '_ OR PRICE_ <> OLD_PRICE_) THEN'
      
        '1101131881=        PRICE_ROZN_ = PRICE_ * CHARGE_PRICE_ROZN_/100' +
        ' + PRICE_;'
      
        '1101131882=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054 +
        #1062#1045#1053#1058', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '1101131883=      ELSE IF (PRICE_ROZN_ <> OLD_PRICE_ROZN_) THEN'
      
        '1101131884=        CHARGE_PRICE_ROZN_ = ROUND((PRICE_ROZN_/PRICE' +
        '_ - 1)*100, 2);'
      '1101131885='
      
        '1101131886=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040#1062#1045#1053#1050#1040' '#1054#1055#1058' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047 +
        #1040#1050#1059#1055#1050#1048#1047' , '#1047#1053#1040#1063#1048#1058' '#1062#1045#1053#1040' '#1054#1055#1058#1040' '#1053#1045' '#1052#1045#1053#1071#1051#1040#1057#1068', '#1041#1059#1044#1059' '#1045#1045' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101131887=      IF (CHARGE_PRICE_OPT_ <> OLD_CHARGE_PRICE_OPT_ ' +
        'OR PRICE_ <> OLD_PRICE_ ) THEN'
      
        '1101131888=        PRICE_OPT_ = PRICE_ * CHARGE_PRICE_OPT_/100 +' +
        ' PRICE_;'
      '1101131889='
      
        '1101131890=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1054#1055#1058#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057 +
        #1071' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1055#1058#1040', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '1101131891=      ELSE IF (PRICE_OPT_ <> OLD_PRICE_OPT_) THEN'
      
        '1101131892=        CHARGE_PRICE_OPT_ = ROUND((PRICE_OPT_/PRICE_ ' +
        '- 1)*100, 2);'
      '1101131893=  END'
      '1101131894='
      '1101131895=  UPDATE SKLAD_TMP T'
      '1101131896=  SET'
      '1101131897=    G_PRODUCT = :G_PRODUCT_,'
      '1101131898=    AMOUNT = :AMOUNT_,'
      '1101131899=    PRICE = :PRICE_,'
      '1101131900=    SUMM = :AMOUNT_ * :PRICE_,'
      '1101131901=    NDS = :NDS_,'
      '1101131902=    NDS_SUMM = :NDS_SUMM_'
      '1101131903=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '1101131904=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '1101131905=    ,T.CHARGE_ROZN_PROC = :CHARGE_PRICE_ROZN_'
      '1101131906=    ,T.PRICE_ROZN = :PRICE_ROZN_'
      '1101131907=    ,T.CHARGE_OPT_PROC = :CHARGE_PRICE_OPT_'
      '1101131908=    ,T.PRICE_OPT = :PRICE_OPT_'
      '1101131909=  WHERE'
      '1101131910=    SKLAD = :SKLAD_;'
      '1101131911=END'
      '1101131912=;'
      '1101131913='
      '1101131914='
      
        '1101131915=/****************************************************' +
        '**************************/'
      
        '1101131916=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101131917=/****************************************************' +
        '**************************/'
      '1101131918=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1101131919=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101131920=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101131921=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101131922=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101131923=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101131924=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101131925=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101131926=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101131927=RETURNS ('
      '1101131928=  ERR_CODE INTEGER,'
      '1101131929=  ERR_MSG VARCHAR(1024))'
      '1101131930=AS'
      '1101131931=/*'
      
        '1101131932='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1101131933='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1101131934='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1101131935=*/'
      
        '1101131936=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1101131937=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101131938=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1101131939=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1101131940=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1101131941=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1101131942=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1101131943=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1101131944=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1101131945=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101131946=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1101131947=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1101131948=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1101131949=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101131950=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101131951=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101131952=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101131953=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101131954=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1101131955=BEGIN'
      '1101131956='
      '1101131957=  PNT_ = '#39'00'#39';'
      '1101131958=  CLRF = ascii_char( 10 );'
      '1101131959='
      '1101131960=  SELECT S.S_VALUE'
      '1101131961=    FROM SYSTEM_SETUP S'
      '1101131962=   WHERE S.SYSTEM_SETUP = 2'
      '1101131963=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1101131964='
      '1101131965=  PNT_ = '#39'01'#39';'
      '1101131966=  SELECT G.nds_value'
      '1101131967=    FROM G_FIRM_REKVIZIT G'
      '1101131968=   WHERE G.is_default = 1'
      '1101131969=    INTO :NDS_;'
      '1101131970='
      '1101131971=  PNT_ = '#39'02'#39';'
      
        '1101131972=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1101131973=        FROM IMPORT_TBL_TMP'
      
        '1101131974=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1101131975=  DO BEGIN'
      '1101131976=    SELECT G_PRODUCT,'
      '1101131977=           PRICE'
      '1101131978=      FROM ('
      '1101131979=            SELECT P.G_PRODUCT, P.price'
      '1101131980=              FROM G_PRODUCT P'
      
        '1101131981=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1101131982=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1101131983=            UNION'
      '1101131984=            SELECT LT.G_PRODUCT, P.PRICE'
      '1101131985=              FROM LT_BARCODE LT, g_product P'
      
        '1101131986=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1101131987=               AND LT.g_product = P.g_product'
      '1101131988=           )'
      '1101131989=      INTO :G_PRODUCT_,'
      '1101131990=           :PRICE_OUR_;'
      '1101131991='
      '1101131992=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1101131993=      ERR_CODE = -20500;'
      
        '1101131994=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1101131995=      Exit;'
      '1101131996=    END'
      '1101131997='
      '1101131998=    PNT_ = '#39'03'#39';'
      
        '1101131999=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1101132000=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1101132001=      RETURNING_VALUES :COST_PRICE_;'
      '1101132002='
      '1101132003=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1101132004=    IF (price_ IS NULL) THEN'
      '1101132005=      PRICE_ = PRICE_OUR_;'
      '1101132006='
      '1101132007=    PNT_ = '#39'04'#39';'
      
        '1101132008=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1101132009=                                              :AMOUNT' +
        '_,'
      
        '1101132010=                                              :PRICE_' +
        ','
      
        '1101132011=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1101132012=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1101132013=                                              :DISCOU' +
        'NT_,'
      
        '1101132014=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1101132015=                                              :NDS_,'
      
        '1101132016=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1101132017=                                              :COST_P' +
        'RICE_,'
      
        '1101132018=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1101132019=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1101132020=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1101132021=                                              0     -' +
        '-MODE_'
      
        '1101132022=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1101132023=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101132024=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101132025=      EXIT;'
      '1101132026=    END'
      '1101132027='
      '1101132028=    G_PRODUCT_ = NULL;'
      '1101132029=  END'
      '1101132030='
      '1101132031=  PNT_ = '#39'05'#39';'
      '1101132032=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1101132033=    SELECT SUM(T.summ)'
      '1101132034=      FROM ZAKAZ_DETAILS_TMP T'
      '1101132035=      INTO :SUMM_;'
      '1101132036=    SUMM_FACT_ = SUMM_;'
      '1101132037=  END'
      '1101132038='
      '1101132039=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1101132040=  if (G_PAYMENT_TYPE_ = 1) then'
      '1101132041=    SUMM_CASH_ = summ_fact_;'
      '1101132042=  ELSE'
      '1101132043=    SUMM_NONCASH_ = summ_fact_;'
      '1101132044='
      '1101132045=  PNT_ = '#39'06'#39';'
      '1101132046=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1101132047=    G_CLIENT_ = 10;'
      '1101132048='
      '1101132049=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101132050=                              :Z_DATE_,'
      '1101132051=                              :Z_TIME_,'
      '1101132052=                              :G_CLIENT_,'
      '1101132053=                              :G_PAYMENT_TYPE_,'
      '1101132054=                              '#39#39', --:OSNOVANIE_,'
      '1101132055=                              0,  -- IS_SPISANIE'
      
        '1101132056=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1101132057=                              :SUMM_,'
      '1101132058=                              :SUMM_FACT_,'
      '1101132059=                              :SUMM_CASH_,'
      '1101132060=                              :SUMM_NONCASH_,'
      
        '1101132061=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1101132062=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1101132063=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1101132064=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1101132065=                              0,    -- :BY_RECIPE__,'
      '1101132066=                              0,    -- IS_RESERVE__'
      '1101132067=                              NULL -- :PAYMENTS__'
      '1101132068=                              )'
      
        '1101132069=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101132070=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101132071=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101132072=    EXIT;'
      '1101132073=  END'
      '1101132074='
      '1101132075=  DELETE FROM import_tbl_tmp;'
      '1101132076='
      '1101132077=WHEN ANY DO BEGIN'
      '1101132078=    ERR_CODE = gdscode;'
      
        '1101132079=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1101132080=  END'
      '1101132081=end'
      '1101132082=;'
      
        '1101132083=UPDATE SYSTEM_SETUP SET S_VALUE = 110113 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101132084=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101132085=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101140=CREATE PROCEDURE P_REP_ZAKAZ_NA_REAL_WAYBILL('
      
        '1101141=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_REAL_' +
        'PARENT */ BIGINT,'
      '1101142=  CURRENCY_ INTEGER)'
      '1101143=RETURNS ('
      '1101144=  NUMBER_STR_ VARCHAR(200),'
      '1101145=  ROW_NUM INTEGER,'
      
        '1101146=  CATEGORY_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      '1101147=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1101148=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1101149=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '11011410=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11011411=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(5' +
        '0),'
      '11011412=  AMOUNT /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      '11011413=  PRICE_N VARCHAR(50),'
      '11011414=  SUMM_N VARCHAR(50),'
      '11011415=  AMOUNT_VSEGO_ /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      '11011416=  SUMM_VSEGO_ VARCHAR(50),'
      '11011417=  NDS_SUMM_ VARCHAR(50),'
      
        '11011418=  G_OFFICIAL_FM_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC *' +
        '/ VARCHAR(150),'
      
        '11011419=  CLIENT_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCH' +
        'AR(250),'
      '11011420=  SUMM_STR_ VARCHAR(500),'
      '11011421=  NDS_SUMM_STR_ VARCHAR(500),'
      '11011422=  ERR_CODE NUMERIC(15,2),'
      '11011423=  ERR_MSG VARCHAR(1024))'
      '11011424=AS'
      '11011425=BEGIN'
      '11011426=  SUSPEND;'
      '11011427=END'
      '11011428=;'
      '11011429='
      '11011430='
      
        '11011431=/******************************************************' +
        '************************/'
      
        '11011432=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11011433=/******************************************************' +
        '************************/'
      '11011434=ALTER PROCEDURE P_REP_PROFIT('
      '11011435=  DATE_BEGIN_ DATE,'
      '11011436=  DATE_END_ DATE,'
      '11011437=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11011438=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYME' +
        'NT_TYPE,'
      '11011439=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11011440=RETURNS ('
      '11011441=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11011442=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '11011443=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUMM' +
        ','
      '11011444=  SUMM_COST_ALL_STR VARCHAR(50),'
      '11011445=  SUMM_ALL_ NUMERIC(15,2),'
      '11011446=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '11011447=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '11011448=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '11011449=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '11011450=  PROFIT_ALL_ NUMERIC(15,2),'
      '11011451=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '11011452=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'P_REP_PROFIT_TABLE,'
      '11011453=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '11011454=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '11011455=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '11011456=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '11011457=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT_' +
        'NAME,'
      
        '11011458=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PA' +
        'YMENT_TYPE,'
      
        '11011459=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYMEN' +
        'T_NAME,'
      
        '11011460=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANIE' +
        ','
      
        '11011461=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUCT' +
        ','
      
        '11011462=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRO' +
        'DUCT_PAR,'
      
        '11011463=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_NA' +
        'ME,'
      '11011464=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11011465=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11011466=  AMOUNT MY_NUMERIC_5,'
      '11011467=  PRICE NUMERIC(15,2),'
      '11011468=  SUMM NUMERIC(15,2),'
      '11011469=  DISCOUNT_PERC NUMERIC(15,2),'
      '11011470=  DISCOUNT_SUMM NUMERIC(15,2),'
      '11011471=  NDS NUMERIC(15,2),'
      '11011472=  NDS_SUMM NUMERIC(15,2),'
      '11011473=  PRICE_SELF NUMERIC(15,2),'
      '11011474=  SUM_SELF NUMERIC(15,2),'
      '11011475=  PROFIT NUMERIC(15,2),'
      '11011476=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '11011477=  ERR_CODE INTEGER,'
      '11011478=  ERR_MSG VARCHAR(1024))'
      '11011479=AS'
      '11011480=/*'
      '11011481='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '11011482='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050#1054 +
        ' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048#1054 +
        #1044
      
        '11011483='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055#1071 +
        #1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '11011484='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069#1058 +
        #1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053#1045 +
        #1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '11011485='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '11011486='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '11011487='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '11011488=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '11011489=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '11011490=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '11011491='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*1750' +
        ' + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '11011492='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' '#1047 +
        #1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '11011493=*'
      '11011494=*/'
      '11011495=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39';'
      '11011496=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11011497=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '11011498=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '11011499=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110114100=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110114101=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110114102=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '110114103=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '110114104=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '110114105=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '110114106=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110114107=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110114108=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110114109=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110114110=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110114111=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110114112=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110114113=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110114114=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110114115=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110114116=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110114117=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110114118=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110114119=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110114120=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110114121=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110114122=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110114123=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110114124=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110114125=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110114126=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110114127=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110114128=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110114129=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110114130=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110114131=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110114132=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110114133=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110114134=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110114135=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110114136=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110114137=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110114138=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110114139=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110114140=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110114141=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110114142=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110114143=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '110114144=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM_FACT;'
      
        '110114145=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN S' +
        'KLAD_PARENT.SUMM_FACT;'
      '110114146=BEGIN'
      
        '110114147=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110114148=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110114149='
      '110114150=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110114151=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110114152=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110114153='
      '110114154=  FOR SELECT GP.PATH,'
      '110114155=             GP.G_PRODUCT'
      '110114156=       FROM P_REP_TREE GP'
      '110114157=      WHERE EXISTS (SELECT 1'
      
        '110114158=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110114159=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110114160=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110114161=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110114162=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110114163=                       AND Z.IS_SPISANIE = 0'
      '110114164=                       AND Z.is_reserve = 0'
      '110114165=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110114166=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110114167=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110114168=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110114169=                       )'
      '110114170=      ORDER BY 1, 2'
      '110114171=  INTO :RECCAT_NAME_,'
      '110114172=       :RECCAT_PRODUCT_'
      '110114173=  DO BEGIN'
      '110114174=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114175=    insert into p_rep_profit_table'
      '110114176=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110114177=    values'
      
        '110114178=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110114179='
      '110114180=    FOR SELECT Z.ZAKAZ,'
      '110114181=               Z.G_TOCHKA,'
      '110114182=               Z.Z_DATE,'
      '110114183=               Z.G_CLIENT,'
      '110114184=               C.NAME CLIENT_NAME,'
      '110114185=               Z.G_PAYMENT_TYPE,'
      '110114186=               P.NAME PAYMENT_NAME,'
      '110114187=               Z.OSNOVANIE,'
      '110114188=               G.G_PRODUCT,'
      '110114189=               G.G_PRODUCT_PAR,'
      '110114190=               G.NAME TOVAR_NAME,'
      '110114191=               ZD.AMOUNT,'
      '110114192=               ZD.PRICE,'
      '110114193=               ZD.SUMM,'
      '110114194=               ZD.DISCOUNT_PERC,'
      '110114195=               ZD.DISCOUNT_SUMM,'
      '110114196=               ZD.NDS,'
      '110114197=               ZD.NDS_SUMM,'
      '110114198=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110114199=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110114200=               ZAKAZ_DETAILS ZD,'
      '110114201=               G_PRODUCT G,'
      '110114202=               G_PAYMENT_TYPE P'
      
        '110114203=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110114204=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110114205=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110114206=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110114207=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110114208=           AND Z.IS_SPISANIE = 0                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '110114209=           AND Z.IS_RESERVE = 0                    -- ' +
        #1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '110114210=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110114211=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110114212=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110114213=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110114214=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110114215=    INTO :REC_ZAKAZ_,'
      '110114216=        :REC_G_TOCHKA_,'
      '110114217=        :REC_Z_DATE_,'
      '110114218=        :REC_G_CLIENT_,'
      '110114219=        :REC_CLIENT_NAME_,'
      '110114220=        :REC_G_PAYMENT_TYPE_,'
      '110114221=        :REC_PAYMENT_NAME_,'
      '110114222=        :REC_OSNOVANIE_,'
      '110114223=        :REC_G_PRODUCT_,'
      '110114224=        :REC_G_PRODUCT_PAR_,'
      '110114225=        :REC_TOVAR_NAME_,'
      '110114226=        :REC_AMOUNT_,'
      '110114227=        :REC_PRICE_,'
      '110114228=        :REC_SUMM_,'
      '110114229=        :REC_DISCOUNT_PERC_,'
      '110114230=        :REC_DISCOUNT_SUMM_,'
      '110114231=        :REC_NDS_,'
      '110114232=        :REC_NDS_SUMM_,'
      '110114233=        :REC_PRICE_SELF_'
      '110114234=    DO BEGIN'
      '110114235=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110114236=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110114237='
      '110114238=      insert into p_rep_profit_table'
      
        '110114239=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110114240=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110114241=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110114242=      values'
      '110114243=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110114244=        :REC_ZAKAZ_,'
      '110114245=        :REC_g_tochka_,'
      
        '110114246=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110114247=         :REC_osnovanie_,'
      '110114248=         :REC_g_product_,'
      '110114249=         :REC_g_product_par_,'
      '110114250=         :REC_tovar_name_,'
      '110114251=         :REC_amount_,'
      '110114252=         :REC_price_,'
      '110114253=         :REC_summ_,'
      '110114254=         :REC_discount_perc_,'
      '110114255=         :REC_discount_summ_,'
      
        '110114256=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110114257='
      
        '110114258=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110114259=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110114260=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110114261=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110114262=    END'
      '110114263='
      '110114264=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114265=    insert into p_rep_profit_table'
      
        '110114266=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110114267=    values'
      
        '110114268=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110114269='
      '110114270=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110114271=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110114272=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110114273=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110114274='
      '110114275=    SUM_ZAKAZ_ = 0;'
      '110114276=    SUM_COST_  = 0;'
      '110114277=    NDS_SUMM_  = 0;'
      '110114278=    PROFIT_    = 0;'
      '110114279=  END'
      '110114280='
      '110114281=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110114282=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110114283=      insert into p_rep_profit_table'
      
        '110114284=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110114285=      values'
      
        '110114286=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110114287='
      
        '110114288=  --**************************************************' +
        '***************************************'
      '110114289=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110114290=  ----------------------------------------------------' +
        '---'
      '110114291=  SELECT COUNT(*)'
      
        '110114292=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110114293=          UNION ALL'
      
        '110114294=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110114295=         G_PRIHOD_RASHOD G'
      
        '110114296=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110114297=    AND K.ACTION = 1'
      
        '110114298=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110114299=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110114300=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053#1045 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110114301=  INTO :CNT_;'
      '110114302='
      '110114303=  IF (CNT_ > 0) THEN BEGIN'
      '110114304=    SUM_COST_  = 0;'
      '110114305=    PROFIT_    = 0;'
      '110114306='
      '110114307=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114308=    INSERT INTO P_REP_PROFIT_TABLE'
      '110114309=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110114310=    VALUES'
      
        '110114311=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', 1' +
        ');'
      '110114312='
      '110114313=    FOR SELECT K.ACTION_DATE,'
      '110114314=               K.SUMM,'
      
        '110114315=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, '#39 +
        ' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '110114316=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '110114317=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39
      '110114318=              UNION ALL'
      
        '110114319=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, ' +
        'SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM kas' +
        'sa_beznal'
      
        '110114320=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39') k,'
      '110114321=              G_PRIHOD_RASHOD G'
      '110114322=        WHERE K.ACTION = 1'
      
        '110114323=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110114324=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110114325=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)   ' +
        ' -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110114326=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110114327=    INTO :ACTION_DATE_,'
      '110114328=         :SUMM_,'
      '110114329=         :ACTION_NAME_'
      '110114330=    DO BEGIN'
      '110114331=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110114332=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110114333=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110114334=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110114335=        VALUES'
      
        '110114336=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, 0,'
      
        '110114337=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALES' +
        'CE(:SUMM_, 0), 0);'
      '110114338='
      '110114339=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110114340=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110114341=    END'
      '110114342='
      '110114343=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110114344=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110114345=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110114346=    insert into p_rep_profit_table'
      
        '110114347=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110114348=    values'
      
        '110114349=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110114350=  END'
      '110114351=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '110114352=  --**************************************************' +
        '***************************************'
      '110114353='
      
        '110114354=  --**************************************************' +
        '***************************************'
      '110114355=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '110114356=  ----------------------------------------------------' +
        '---'
      '110114357=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114358=  SELECT COUNT(*)'
      
        '110114359=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110114360=          UNION ALL'
      
        '110114361=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110114362=         G_PRIHOD_RASHOD G'
      
        '110114363=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110114364=    AND K.ACTION = 0'
      
        '110114365=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110114366=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110114367=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056#1045 +
        #1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110114368=  INTO :CNT_;'
      '110114369='
      '110114370=  IF (CNT_ > 0) THEN BEGIN'
      '110114371=    PRIHOD_ALL_  = 0;'
      '110114372=    PRIHOD_ALL_NAL_  = 0;'
      '110114373=    PRIHOD_ALL_BEZNAL_  = 0;'
      '110114374=    PROFIT_     = 0;'
      '110114375='
      '110114376=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114377=    INSERT INTO P_REP_PROFIT_TABLE'
      '110114378=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110114379=    VALUES'
      
        '110114380=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', 1' +
        ');'
      '110114381='
      '110114382=    FOR SELECT K.ACTION_DATE,'
      '110114383=               K.NAL,'
      '110114384=               K.BEZNAL,'
      '110114385=               G.NAME'
      
        '110114386=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 ' +
        'BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110114387=               UNION ALL'
      
        '110114388=               SELECT kassa_BEZNAL KASSA, ACTION_DATE,' +
        ' 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kass' +
        'a_beznal) K,'
      '110114389=              G_PRIHOD_RASHOD G'
      
        '110114390=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '110114391=          AND K.ACTION = 0'
      
        '110114392=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110114393=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110114394=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110114395=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110114396=    INTO :ACTION_DATE_,'
      '110114397=         :SUMM_NAL_,'
      '110114398=         :SUMM_BEZNAL_,'
      '110114399=         :ACTION_NAME_'
      '110114400=    DO BEGIN'
      '110114401=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110114402=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110114403=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110114404=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110114405=        VALUES'
      
        '110114406=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '110114407=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '110114408='
      '110114409=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110114410=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM' +
        '_BEZNAL_;'
      
        '110114411=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_B' +
        'EZNAL_;'
      
        '110114412=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZ' +
        'NAL_;'
      '110114413=    END'
      '110114414='
      '110114415=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110114416=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110114417=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '110114418=    insert into p_rep_profit_table'
      
        '110114419=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110114420=    values'
      
        '110114421=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110114422=  END'
      '110114423='
      '110114424=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '110114425=  --**************************************************' +
        '***************************************'
      '110114426='
      
        '110114427=  --**************************************************' +
        '***************************************'
      '110114428=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110114429=  --**************************************************' +
        '***************************************'
      '110114430=  SELECT COUNT(*)'
      '110114431=    FROM ZAKAZ Z'
      
        '110114432=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110114433=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110114434=     AND Z.IS_SPISANIE = 1'
      
        '110114435=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110114436=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110114437=  INTO :CNT_;'
      '110114438='
      '110114439=  IF (CNT_ > 0) THEN BEGIN'
      '110114440=      SUM_ZAKAZ_ = 0;'
      '110114441=      SUM_COST_  = 0;'
      '110114442=      PROFIT_    = 0;'
      '110114443='
      '110114444=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114445=      insert into p_rep_profit_table'
      '110114446=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110114447=      values'
      
        '110114448=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39', 1);'
      '110114449='
      '110114450=      FOR SELECT Z.ZAKAZ,'
      '110114451=                 Z.G_TOCHKA,'
      '110114452=                 Z.Z_DATE,'
      '110114453=                 Z.G_CLIENT,'
      '110114454=                 '#39#39' CLIENT_NAME,'
      '110114455=                 Z.G_PAYMENT_TYPE,'
      '110114456=                 '#39#39' PAYMENT_NAME,'
      '110114457=                 Z.OSNOVANIE,'
      '110114458=                 G.G_PRODUCT,'
      '110114459=                 G.G_PRODUCT_PAR,'
      '110114460=                 G.NAME TOVAR_NAME,'
      '110114461=                 ZD.AMOUNT,'
      '110114462=                 ZD.PRICE,'
      '110114463=                 ZD.SUMM,'
      '110114464=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '110114465=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '110114466=                 0 NDS, --ZD.NDS,'
      '110114467=                 0 NDS_SUMM'
      
        '110114468=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT ' +
        'G'
      
        '110114469=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TO' +
        'CHKA||'#39'-'#39
      '110114470=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110114471=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110114472=             AND Z.IS_SPISANIE = 1                    ' +
        '-- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '110114473=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110114474=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '110114475=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G' +
        '_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059 +
        #1057#1058#1067#1052
      
        '110114476=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALE' +
        'SCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110114477=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS'
      '110114478=      INTO :REC_ZAKAZ_,'
      '110114479=            :REC_G_TOCHKA_,'
      '110114480=            :REC_Z_DATE_,'
      '110114481=            :REC_G_CLIENT_,'
      '110114482=            :REC_CLIENT_NAME_,'
      '110114483=            :REC_G_PAYMENT_TYPE_,'
      '110114484=            :REC_PAYMENT_NAME_,'
      '110114485=            :REC_OSNOVANIE_,'
      '110114486=            :REC_G_PRODUCT_,'
      '110114487=            :REC_G_PRODUCT_PAR_,'
      '110114488=            :REC_TOVAR_NAME_,'
      '110114489=            :REC_AMOUNT_,'
      '110114490=            :REC_PRICE_,'
      '110114491=            :REC_SUMM_,'
      '110114492=            :REC_DISCOUNT_PERC_,'
      '110114493=            :REC_DISCOUNT_SUMM_,'
      '110114494=            :REC_NDS_,'
      '110114495=            :REC_NDS_SUMM_'
      '110114496=      DO BEGIN'
      '110114497=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110114498=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067 +
        ' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '110114499=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '110114500=        REC_profit_   = -REC_SUMM_;'
      '110114501='
      '110114502=        insert into p_rep_profit_table'
      
        '110114503=          (p_rep_profit_table, zakaz, g_tochka, z_date' +
        ', g_client, client_name, g_payment_type, payment_name,'
      
        '110114504=           osnovanie, g_product, g_product_par, tovar_' +
        'name, amount, price, summ, discount_perc, discount_summ,'
      
        '110114505=           nds, nds_summ, price_self, sum_self, profit' +
        ', is_head)'
      '110114506=        values'
      
        '110114507=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAK' +
        'AZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '110114508=         :REC_osnovanie_, :REC_g_product_, :REC_g_prod' +
        'uct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_pe' +
        'rc_, :REC_discount_summ_,'
      
        '110114509=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_' +
        'SUM_COST_, :REC_profit_, 0);'
      '110114510='
      
        '110114511=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST' +
        '_, 0);'
      
        '110114512=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, ' +
        '0);'
      '110114513=      END'
      '110114514='
      '110114515=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114516=      insert into p_rep_profit_table'
      
        '110114517=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110114518=      values'
      
        '110114519=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0' +
        ', :SUM_COST_, 0, :PROFIT_, 2);'
      '110114520='
      '110114521=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110114522=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110114523=  END'
      '110114524=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110114525=  --**************************************************' +
        '***************************************'
      '110114526='
      
        '110114527=  --**************************************************' +
        '***************************************'
      '110114528=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110114529=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048#1045 +
        #1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '110114530=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053#1054 +
        '", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '110114531=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' '#1055 +
        #1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '110114532='
      
        '110114533=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '110114534=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 45' +
        '00'
      
        '110114535=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056#1048 +
        #1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057#1054 +
        #1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '110114536=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070#1047 +
        #1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054' ' +
        #1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '110114537='
      
        '110114538=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059#1063 +
        #1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '110114539=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058'.' +
        ' - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '110114540=  --**************************************************' +
        '***************************************'
      '110114541=  SELECT COUNT(*)'
      '110114542=    FROM SKLAD S'
      
        '110114543=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      
        '110114544=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110114545=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110114546=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110114547=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110114548=  INTO :CNT_;'
      '110114549='
      '110114550=  IF (CNT_ > 0) THEN BEGIN'
      '110114551=    SUM_ZAKAZ_ = 0;'
      '110114552=    PROFIT_    = 0;'
      '110114553=    SUM_COST_  = 0;'
      '110114554='
      '110114555=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114556=    insert into p_rep_profit_table'
      '110114557=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110114558=    values'
      
        '110114559=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39', 1);'
      '110114560='
      '110114561=    FOR SELECT S.DATE_RECEIPT,'
      '110114562=               S.G_PRODUCT,'
      '110114563=               G.NAME TOVAR_NAME,'
      '110114564=               S.AMOUNT,'
      '110114565=               S.PRICE,'
      '110114566=               S.SUMM,'
      '110114567=               SP.G_TOCHKA'
      '110114568=         FROM SKLAD_PARENT SP,'
      '110114569=              SKLAD S,'
      '110114570=              G_PRODUCT G'
      
        '110114571=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCH' +
        'KA||'#39'-'#39
      
        '110114572=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110114573=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110114574=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110114575=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110114576=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110114577=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110114578=        ORDER BY 1'
      '110114579=    INTO :V_DATE_RECEIPT_,'
      '110114580=         :V_G_PRODUCT_,'
      '110114581=         :V_TOVAR_NAME_,'
      '110114582=         :V_AMOUNT_,'
      '110114583=         :V_PRICE_,'
      '110114584=         :V_SUMM_,'
      '110114585=         :REC_G_TOCHKA_'
      '110114586=    DO BEGIN'
      '110114587=      --REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110114588=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;   ' +
        ' -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044 +
        #1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059 +
        #1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '110114589='
      '110114590='
      '110114591=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110114592=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110114593=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110114594=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, s' +
        'um_self)'
      '110114595=      VALUES'
      
        '110114596=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, -:' +
        'V_SUMM_,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045 +
        ' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047 +
        #1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '110114597=         0, 0, 0, 0, :REC_profit_, 0, 0, 0);'
      '110114598='
      
        '110114599=      --SUM_COST_  = SUM_COST_  + COALESCE(REC_SUM_COS' +
        'T_, 0);     -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '110114600=      SUM_COST_ = 0;'
      '110114601=      SUM_ZAKAZ_ = SUM_ZAKAZ_ - COALESCE(V_SUMM_, 0);'
      '110114602=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110114603=    END'
      '110114604='
      '110114605='
      
        '110114606=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_; --SU' +
        'M_COST_;'
      '110114607=    --SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '110114608=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110114609='
      '110114610=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114611=    insert into p_rep_profit_table'
      
        '110114612=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110114613=    values'
      
        '110114614=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, 0, 0, :PROFIT_, 2);'
      '110114615=  END'
      '110114616=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110114617=  --**************************************************' +
        '***************************************'
      '110114618='
      
        '110114619=  --**************************************************' +
        '***************************************'
      
        '110114620=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045#1051 +
        #1054' '#1052#1045#1057#1058#1054
      '110114621=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '110114622=  --**************************************************' +
        '***************************************'
      '110114623=  /*SELECT COUNT(*)'
      '110114624=    FROM ZAKAZ Z'
      
        '110114625=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110114626=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110114627=     AND Z.IS_SPISANIE = 4'
      
        '110114628=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110114629=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110114630=  INTO :CNT_;'
      '110114631='
      '110114632=  IF (CNT_ > 0) THEN BEGIN'
      '110114633=      SUM_ZAKAZ_ = 0;'
      '110114634=      SUM_COST_  = 0;'
      '110114635=      PROFIT_    = 0;'
      '110114636=      NDS_SUMM_  = 0;'
      '110114637='
      '110114638=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114639=      insert into p_rep_profit_table'
      '110114640=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110114641=      values'
      
        '110114642=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058 +
        #1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '110114643='
      '110114644=      FOR SELECT Z.ZAKAZ,'
      '110114645=               Z.G_TOCHKA,'
      '110114646=               Z.Z_DATE,'
      '110114647=               Z.G_CLIENT,'
      '110114648=               C.NAME CLIENT_NAME,'
      '110114649=               Z.G_PAYMENT_TYPE,'
      '110114650=               P.NAME PAYMENT_NAME,'
      '110114651=               Z.OSNOVANIE,'
      '110114652=               G.G_PRODUCT,'
      '110114653=               G.G_PRODUCT_PAR,'
      '110114654=               G.NAME TOVAR_NAME,'
      '110114655=               ZD.AMOUNT,'
      '110114656=               ZD.PRICE,'
      '110114657=               ZD.SUMM,'
      '110114658=               ZD.DISCOUNT_PERC,'
      '110114659=               ZD.DISCOUNT_SUMM,'
      '110114660=               ZD.NDS,'
      '110114661=               ZD.NDS_SUMM,'
      '110114662=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110114663=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110114664=               ZAKAZ_DETAILS ZD,'
      '110114665=               G_PRODUCT G,'
      '110114666=               G_PAYMENT_TYPE P'
      
        '110114667=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110114668=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110114669=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110114670=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110114671=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110114672=           AND Z.IS_SPISANIE = 4                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110114673=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110114674=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110114675=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110114676=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110114677=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110114678=    INTO :REC_ZAKAZ_,'
      '110114679=        :REC_G_TOCHKA_,'
      '110114680=        :REC_Z_DATE_,'
      '110114681=        :REC_G_CLIENT_,'
      '110114682=        :REC_CLIENT_NAME_,'
      '110114683=        :REC_G_PAYMENT_TYPE_,'
      '110114684=        :REC_PAYMENT_NAME_,'
      '110114685=        :REC_OSNOVANIE_,'
      '110114686=        :REC_G_PRODUCT_,'
      '110114687=        :REC_G_PRODUCT_PAR_,'
      '110114688=        :REC_TOVAR_NAME_,'
      '110114689=        :REC_AMOUNT_,'
      '110114690=        :REC_PRICE_,'
      '110114691=        :REC_SUMM_,'
      '110114692=        :REC_DISCOUNT_PERC_,'
      '110114693=        :REC_DISCOUNT_SUMM_,'
      '110114694=        :REC_NDS_,'
      '110114695=        :REC_NDS_SUMM_,'
      '110114696=        :REC_PRICE_SELF_'
      '110114697=    DO BEGIN'
      '110114698=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '110114699=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '110114700='
      '110114701=      insert into p_rep_profit_table'
      
        '110114702=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110114703=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110114704=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110114705=      values'
      '110114706=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110114707=        :REC_ZAKAZ_,'
      '110114708=        :REC_g_tochka_,'
      
        '110114709=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110114710=         :REC_osnovanie_,'
      '110114711=         :REC_g_product_,'
      '110114712=         :REC_g_product_par_,'
      '110114713=         :REC_tovar_name_,'
      '110114714=         :REC_amount_,'
      '110114715=         :REC_price_,'
      '110114716=         :REC_summ_,'
      '110114717=         :REC_discount_perc_,'
      '110114718=         :REC_discount_summ_,'
      
        '110114719=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110114720='
      
        '110114721=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110114722=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110114723=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110114724=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110114725=    END'
      '110114726='
      '110114727=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114728=    insert into p_rep_profit_table'
      
        '110114729=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110114730=    values'
      
        '110114731=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110114732='
      '110114733=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110114734=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '110114735=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110114736=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110114737='
      '110114738=    SUM_ZAKAZ_ = 0;'
      '110114739=    SUM_COST_  = 0;'
      '110114740=    NDS_SUMM_  = 0;'
      '110114741=    PROFIT_    = 0;'
      '110114742=  END'
      '110114743=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '110114744=  --**************************************************' +
        '***************************************'
      '110114745='
      
        '110114746=  --**************************************************' +
        '***************************************'
      
        '110114747=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048 +
        #1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110114748=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054 +
        #1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110114749=  --**************************************************' +
        '***************************************'
      '110114750=  SELECT COUNT(*)'
      '110114751=    FROM ZAKAZ S'
      
        '110114752=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110114753=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110114754=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110114755=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110114756=     AND S.IS_SPISANIE = 2'
      '110114757=  INTO :CNT_;'
      '110114758='
      '110114759=  IF (CNT_ > 0) THEN BEGIN'
      '110114760=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114761=      insert into p_rep_profit_table'
      '110114762=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110114763=      values'
      
        '110114764=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '110114765='
      '110114766=      SUM_ZAKAZ_ = 0;'
      '110114767=      SUM_COST_  = 0;'
      '110114768=      NDS_SUMM_  = 0;'
      '110114769=      PROFIT_    = 0;'
      '110114770=      FOR SELECT GP.NAME,'
      '110114771=                 GP.G_PRODUCT'
      '110114772=           FROM G_PRODUCT GP'
      '110114773=          WHERE IS_CATEGORY = 1'
      '110114774=            AND EXISTS (SELECT 1'
      
        '110114775=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110114776=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110114777=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110114778=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110114779=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110114780=                           AND Z.IS_SPISANIE = 2'
      '110114781=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110114782=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110114783=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058 +
        ' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110114784=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110114785=                           )'
      '110114786=          ORDER BY 1'
      '110114787=      INTO :RECCAT_NAME_,'
      '110114788=           :RECCAT_PRODUCT_'
      '110114789=      DO BEGIN'
      '110114790=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114791=        insert into p_rep_profit_table'
      '110114792=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110114793=        values'
      
        '110114794=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110114795='
      '110114796=        FOR SELECT Z.ZAKAZ,'
      '110114797=                   Z.G_TOCHKA,'
      '110114798=                   Z.Z_DATE,'
      '110114799=                   Z.G_CLIENT,'
      '110114800=                   C.NAME CLIENT_NAME,'
      '110114801=                   Z.G_PAYMENT_TYPE,'
      '110114802=                   P.NAME PAYMENT_NAME,'
      '110114803=                   Z.OSNOVANIE,'
      '110114804=                   G.G_PRODUCT,'
      '110114805=                   G.G_PRODUCT_PAR,'
      '110114806=                   G.NAME TOVAR_NAME,'
      '110114807=                   ZD.AMOUNT,'
      '110114808=                   ZD.PRICE,'
      '110114809=                   ZD.SUMM,'
      '110114810=                   ZD.DISCOUNT_PERC,'
      '110114811=                   ZD.DISCOUNT_SUMM,'
      '110114812=                   ZD.NDS,'
      '110114813=                   ZD.NDS_SUMM,'
      '110114814=                   ZD.COST_PRICE'
      
        '110114815=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110114816=                   ZAKAZ_DETAILS ZD,'
      '110114817=                   G_PRODUCT G,'
      '110114818=                   G_PAYMENT_TYPE P'
      
        '110114819=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_' +
        'TOCHKA||'#39'-'#39
      '110114820=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110114821=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110114822=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110114823=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_ ' +
        ' -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110114824=               AND Z.IS_SPISANIE = 2                  ' +
        '  -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '110114825=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110114826=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110114827=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '110114828=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110114829=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110114830=        INTO :REC_ZAKAZ_,'
      '110114831=            :REC_G_TOCHKA_,'
      '110114832=            :REC_Z_DATE_,'
      '110114833=            :REC_G_CLIENT_,'
      '110114834=            :REC_CLIENT_NAME_,'
      '110114835=            :REC_G_PAYMENT_TYPE_,'
      '110114836=            :REC_PAYMENT_NAME_,'
      '110114837=            :REC_OSNOVANIE_,'
      '110114838=            :REC_G_PRODUCT_,'
      '110114839=            :REC_G_PRODUCT_PAR_,'
      '110114840=            :REC_TOVAR_NAME_,'
      '110114841=            :REC_AMOUNT_,'
      '110114842=            :REC_PRICE_,'
      '110114843=            :REC_SUMM_,'
      '110114844=            :REC_DISCOUNT_PERC_,'
      '110114845=            :REC_DISCOUNT_SUMM_,'
      '110114846=            :REC_NDS_,'
      '110114847=            :REC_NDS_SUMM_,'
      '110114848=            :REC_PRICE_SELF_'
      '110114849=        DO BEGIN'
      
        '110114850=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF' +
        '_;'
      
        '110114851=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - ' +
        'REC_NDS_SUMM_;'
      '110114852='
      '110114853=          insert into p_rep_profit_table'
      
        '110114854=            (p_rep_profit_table, zakaz, g_tochka, z_da' +
        'te, g_client, client_name, g_payment_type, payment_name,'
      
        '110114855=             osnovanie, g_product, g_product_par, tova' +
        'r_name, amount, price, summ, discount_perc, discount_summ,'
      
        '110114856=             nds, nds_summ, price_self, sum_self, prof' +
        'it, is_head)'
      '110114857=          values'
      '110114858=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110114859=            :REC_ZAKAZ_,'
      '110114860=            :REC_g_tochka_,'
      
        '110114861=            :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      '110114862=             :REC_osnovanie_,'
      '110114863=             :REC_g_product_,'
      '110114864=             :REC_g_product_par_,'
      '110114865=             :REC_tovar_name_,'
      '110114866=             :REC_amount_,'
      '110114867=             :REC_price_,'
      '110114868=             :REC_summ_,'
      '110114869=             :REC_discount_perc_,'
      '110114870=             :REC_discount_summ_,'
      
        '110114871=             :REC_nds_, :REC_nds_summ_, :REC_price_sel' +
        'f_, :REC_SUM_COST_, :REC_profit_, 0);'
      '110114872='
      
        '110114873=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_' +
        ', 0);'
      
        '110114874=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_CO' +
        'ST_, 0);'
      
        '110114875=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SU' +
        'MM_, 0);'
      
        '110114876=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_,' +
        ' 0);'
      '110114877=        END'
      '110114878='
      '110114879=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110114880=        insert into p_rep_profit_table'
      
        '110114881=          (p_rep_profit_table, tovar_name, summ, sum_s' +
        'elf, NDS_SUMM, profit, is_head)'
      '110114882=        values'
      
        '110114883=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39',' +
        ' :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110114884='
      
        '110114885=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_' +
        ';'
      '110114886=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '110114887=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '110114888=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '110114889='
      '110114890=        SUM_ZAKAZ_ = 0;'
      '110114891=        SUM_COST_  = 0;'
      '110114892=        NDS_SUMM_  = 0;'
      '110114893=        PROFIT_    = 0;'
      '110114894=      END'
      '110114895='
      '110114896=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110114897=      insert into p_rep_profit_table'
      
        '110114898=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110114899=      values'
      
        '110114900=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SUM' +
        'M_REAL_, :PROFIT_REAL_, 2);'
      '110114901='
      
        '110114902=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL' +
        '_;'
      
        '110114903=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL' +
        '_;'
      '110114904=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '110114905=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '110114906=  END'
      '110114907=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110114908=  --**************************************************' +
        '***************************************'
      '110114909=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '110114910='
      '110114911=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '110114912=  insert into p_rep_profit_table'
      '110114913=    (p_rep_profit_table, is_head)'
      '110114914=  values'
      '110114915=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110114916='
      '110114917=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '110114918=  insert into p_rep_profit_table'
      
        '110114919=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110114920=  values'
      
        '110114921=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072#1079 +
        #1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT_' +
        'ALL_, 1);'
      '110114922='
      '110114923=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '110114924=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110114925=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110114926=         SUM(Z.SUMM_BONUS)'
      '110114927=    FROM ZAKAZ Z'
      
        '110114928=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      
        '110114929=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1089 +
        #1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '110114930=     AND Z.IS_RESERVE = 0'
      '110114931=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110114932=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110114933=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110114934=    INTO :SUMM_CASH_ALL_,'
      '110114935=         :SUMM_NONCASH_ALL_,'
      '110114936=         :SUMM_BONUS_ALL_;'
      '110114937='
      '110114938=  SELECT SUM(NAL),'
      '110114939=         SUM(BEZNAL)'
      
        '110114940=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHER' +
        'E K.SKLAD = SP.SKLAD) NAL,'
      
        '110114941=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL ' +
        'KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '110114942=           FROM SKLAD_PARENT SP'
      
        '110114943=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TO' +
        'CHKA||'#39'-'#39
      
        '110114944=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110114945=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '110114946=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COA' +
        'LESCE(SP.G_CLIENT, 0))'
      
        '110114947=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMEN' +
        'T_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '110114948=        )'
      '110114949=  INTO :SUMM_VOZVRAT_NAL_,'
      '110114950=       :SUMM_VOZVRAT_BEZNAL_;'
      '110114951='
      
        '110114952=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COALE' +
        'SCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '110114953=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) -' +
        ' COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '110114954=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110114955='
      '110114956=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110114957='
      
        '110114958=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '110114959=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110114960='
      '110114961=/*  insert into p_rep_profit_table'
      
        '110114962=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110114963=  values'
      
        '110114964=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077 +
        #1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_A' +
        'LL_-:SUM_COST_ALL_, 3);'
      '110114965='
      '110114966=  insert into p_rep_profit_table'
      '110114967=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '110114968=  values'
      
        '110114969=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '110114970='
      '110114971=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110114972=    SELECT G.NAME'
      '110114973=      FROM G_CLIENT G'
      '110114974=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110114975=    INTO :CLIENT_NAME_;'
      '110114976=  ELSE'
      '110114977=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '110114978='
      '110114979=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110114980=    SELECT G.NAME'
      '110114981=      FROM G_PAYMENT_TYPE G'
      '110114982=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110114983=    INTO :PAYMENT_NAME_;'
      '110114984=  ELSE'
      '110114985=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '110114986='
      '110114987=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110114988=        P.ZAKAZ,'
      '110114989=        P.G_TOCHKA,'
      '110114990=        P.Z_DATE,'
      '110114991=        P.G_CLIENT,'
      '110114992=        P.CLIENT_NAME,'
      '110114993=        P.G_PAYMENT_TYPE,'
      '110114994=        P.PAYMENT_NAME,'
      '110114995=        P.OSNOVANIE,'
      '110114996=        P.G_PRODUCT,'
      '110114997=        P.G_PRODUCT_PAR,'
      '110114998=        P.TOVAR_NAME,'
      '110114999=        G.ARTICUL,'
      '1101141000=        G.NOMENCLATUR_NUM,'
      '1101141001=        P.AMOUNT,'
      
        '1101141002=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1101141003=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101141004=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101141005=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101141006=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101141007=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101141008=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101141009=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101141010=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1101141011=        P.IS_HEAD'
      
        '1101141012=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1101141013=    ORDER BY 1'
      '1101141014=  INTO :P_REP_PROFIT_TABLE,'
      '1101141015=       :ZAKAZ,'
      '1101141016=       :G_TOCHKA,'
      '1101141017=       :Z_DATE,'
      '1101141018=       :G_CLIENT,'
      '1101141019=       :CLIENT_NAME,'
      '1101141020=       :G_PAYMENT_TYPE,'
      '1101141021=       :PAYMENT_NAME,'
      '1101141022=       :OSNOVANIE,'
      '1101141023=       :G_PRODUCT,'
      '1101141024=       :G_PRODUCT_PAR,'
      '1101141025=       :TOVAR_NAME,'
      '1101141026=       :ARTICUL,'
      '1101141027=       :NOMENCLATUR_NUM,'
      '1101141028=       :AMOUNT,'
      '1101141029=       :PRICE,'
      '1101141030=       :SUMM,'
      '1101141031=       :DISCOUNT_PERC,'
      '1101141032=       :DISCOUNT_SUMM,'
      '1101141033=       :NDS,'
      '1101141034=       :NDS_SUMM,'
      '1101141035=       :PRICE_SELF,'
      '1101141036=       :SUM_SELF,'
      '1101141037=       :PROFIT,'
      '1101141038=       :IS_HEAD'
      '1101141039=  DO'
      '1101141040=    suspend;'
      '1101141041='
      '1101141042=WHEN ANY DO BEGIN'
      '1101141043=    Err_code = -20500;'
      
        '1101141044=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101141045=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101141046=  END'
      '1101141047=end'
      '1101141048=;'
      '1101141049='
      '1101141050=ALTER PROCEDURE P_REP_ZAKAZ_NA_REAL_WAYBILL('
      
        '1101141051=  ZAKAZ_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_REAL_' +
        'PARENT,'
      '1101141052=  CURRENCY_ INTEGER)'
      '1101141053=RETURNS ('
      '1101141054=  NUMBER_STR_ VARCHAR(200),'
      '1101141055=  ROW_NUM INTEGER,'
      '1101141056=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101141057=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101141058=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101141059=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101141060=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101141061=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101141062=  AMOUNT MY_NUMERIC_5,'
      '1101141063=  PRICE_N VARCHAR(50),'
      '1101141064=  SUMM_N VARCHAR(50),'
      '1101141065=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1101141066=  SUMM_VSEGO_ VARCHAR(50),'
      '1101141067=  NDS_SUMM_ VARCHAR(50),'
      '1101141068=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101141069=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101141070=  SUMM_STR_ VARCHAR(500),'
      '1101141071=  NDS_SUMM_STR_ VARCHAR(500),'
      '1101141072=  ERR_CODE NUMERIC(15,2),'
      '1101141073=  ERR_MSG VARCHAR(1024))'
      '1101141074=AS'
      
        '1101141075=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042#1067#1044#1040#1063#1048' '#1055#1054#1044' '#1056#1045 +
        #1040#1051
      '1101141076=*/'
      
        '1101141077=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZ_' +
        'NA_REAL_WAYBILL'#39';'
      '1101141078=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101141079=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101141080=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101141081=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S_SUMM;'
      '1101141082=BEGIN'
      '1101141083='
      
        '1101141084=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.OSNOVANIE||'#39' '#1086#1090' '#39'||lpad(EXT' +
        'RACT(DAY FROM P.ZAKAZ_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FR' +
        'OM P.ZAKAZ_DATE), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.ZAKAZ_DATE),'
      '1101141085=         G.name'
      '1101141086=    FROM ZAKAZ_REAL_PARENT P,'
      '1101141087=         G_CLIENT G'
      '1101141088=   WHERE P.ZAKAZ_REAL_PARENT = :ZAKAZ_'
      '1101141089=     AND P.g_client = G.G_CLIENT'
      '1101141090=    INTO :NUMBER_STR_,'
      '1101141091=         :CLIENT_NAME_;'
      '1101141092='
      
        '1101141093=  SELECT SUM(S.amount_ALL)--REPLACE(CAST(SUM(S.amount' +
        ') AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1101141094=         ,REPLACE(CAST(SUM(S.summ_ALL) AS VARCHAR(50)' +
        '), '#39'.'#39', '#39','#39')'
      
        '1101141095=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.sum' +
        'm_ALL), :CURRENCY_))'
      
        '1101141096=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(50)' +
        '), '#39'.'#39', '#39','#39')'
      '1101141097=         ,SUM(S.nds_summ)'
      '1101141098=    FROM ZAKAZ_NA_REAL S'
      '1101141099=   WHERE S.ZAKAZ_REAL_PARENT = :ZAKAZ_'
      '1101141100=   GROUP BY S.ZAKAZ_REAL_PARENT'
      '1101141101=    INTO :AMOUNT_VSEGO_,'
      '1101141102=         :SUMM_VSEGO_,'
      '1101141103=         :summ_str_,'
      '1101141104=         :NDS_SUMM_,'
      '1101141105=         :NDS_;'
      '1101141106='
      '1101141107=  if (NDS_ > 0) then'
      
        '1101141108=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENC' +
        'YSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '1101141109='
      '1101141110=  SELECT NAME'
      '1101141111=    FROM CUR_PARAMS'
      '1101141112=   WHERE CUR_PARAMS = 1'
      '1101141113=    INTO :G_OFFICIAL_FM_;'
      '1101141114='
      '1101141115=  FOR SELECT :I,'
      '1101141116=             C.NAME,'
      '1101141117=             G.name,'
      '1101141118=             G.ARTICUL,'
      '1101141119=             G.BARCODE,'
      '1101141120=             G.NOMENCLATUR_NUM,'
      '1101141121=             U.short_name,'
      '1101141122=             S.AMOUNT_ALL,'
      
        '1101141123=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101141124=             REPLACE(CAST(S.SUMM_ALL AS VARCHAR(50)),' +
        ' '#39'.'#39', '#39','#39')'
      
        '1101141125=        FROM ZAKAZ_NA_REAL S, G_PRODUCT G, G_UNIT U, ' +
        'G_PRODUCT C'
      '1101141126=       WHERE S.ZAKAZ_REAL_PARENT = :ZAKAZ_'
      '1101141127=         AND S.g_product = G.g_product'
      '1101141128=         AND G.g_unit = U.g_unit'
      '1101141129=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '1101141130=        INTO :ROW_NUM,'
      '1101141131=            :CATEGORY_NAME,'
      '1101141132=            :NAME,'
      '1101141133=            :ARTICUL,'
      '1101141134=            :BARCODE,'
      '1101141135=            :NOMENCLATUR_NUM,'
      '1101141136=            :SHORT_NAME,'
      '1101141137=            :AMOUNT,'
      '1101141138=            :PRICE_N,'
      '1101141139=            :SUMM_N'
      '1101141140=  DO BEGIN'
      '1101141141=    I = I + 1;'
      '1101141142=    SUSPEND;'
      '1101141143=  END'
      '1101141144=WHEN ANY DO BEGIN'
      '1101141145=    Err_code = -20500;'
      
        '1101141146=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101141147=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101141148=  END'
      '1101141149=end'
      '1101141150=;'
      '1101141151='
      '1101141152=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD'
      '1101141153=RETURNS ('
      '1101141154=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '1101141155=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101141156=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101141157=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101141158=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101141159=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '1101141160=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101141161=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101141162=  SUMM_SERT MY_NUMERIC,'
      '1101141163=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101141164=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101141165=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101141166=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101141167=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101141168=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101141169=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101141170=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_A' +
        'PP)'
      '1101141171=AS'
      '1101141172=/*'
      '1101141173=*/'
      '1101141174=BEGIN'
      '1101141175=  FOR  SELECT S.OPER'
      '1101141176=              ,Z.ZAKAZ'
      '1101141177=              ,Z.Z_DATE'
      '1101141178=              ,Z.Z_TIME'
      '1101141179=              ,C.NAME CLIENT_NAME'
      '1101141180=              ,G.NAME SKLAD_NAME'
      '1101141181=              ,Z.SUMM_CASH'
      '1101141182=              ,Z.SUMM_NONCASH'
      '1101141183=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1101141184=              ,P.ARTICUL'
      '1101141185=              ,P.BARCODE'
      '1101141186=              ,P.NOMENCLATUR_NUM'
      '1101141187=              ,P.NAME'
      '1101141188=              ,ZD.AMOUNT'
      '1101141189=              ,ZD.PRICE - ZD.DISCOUNT_TENGE PRICE'
      '1101141190=              ,ZD.SUMM'
      '1101141191=              ,S.SYNC_EXT_APP'
      '1101141192=         FROM SYNC_EXT_APP S'
      '1101141193=              ,ZAKAZ Z'
      '1101141194=              ,ZAKAZ_DETAILS ZD'
      '1101141195=              ,G_TOCHKA G'
      '1101141196=              ,G_CLIENT C'
      '1101141197=              ,G_PRODUCT P'
      '1101141198=        WHERE S.OBJECT_TYPE = 1'
      '1101141199=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1101141200=          AND S.ID = Z.ZAKAZ'
      '1101141201=          AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101141202=          AND Z.G_TOCHKA = G.G_TOCHKA'
      '1101141203=          AND Z.G_CLIENT = C.G_CLIENT'
      '1101141204=          AND ZD.G_PRODUCT = P.G_PRODUCT'
      '1101141205=        UNION ALL'
      '1101141206=        SELECT S.OPER'
      '1101141207=               ,Z.ZAKAZ'
      '1101141208=               ,NULL Z_DATE'
      '1101141209=               ,NULL Z_TIME'
      '1101141210=               ,NULL CLIENT_NAME'
      '1101141211=               ,NULL SKLAD_NAME'
      '1101141212=               ,0 SUMM_CASH'
      '1101141213=               ,0 SUMM_NONCASH'
      '1101141214=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1101141215=               ,NULL ARTICUL'
      '1101141216=               ,NULL BARCODE'
      '1101141217=               ,NULL NOMENCLATUR_NUM'
      '1101141218=               ,NULL'
      '1101141219=               ,0 AMOUNT'
      '1101141220=               ,0 PRICE'
      '1101141221=               ,0 SUMM'
      '1101141222=               ,S.SYNC_EXT_APP'
      '1101141223=          FROM SYNC_EXT_APP S'
      '1101141224=              ,ZAKAZ Z'
      '1101141225=         WHERE S.ID = Z.ZAKAZ'
      '1101141226=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1101141227=        ORDER BY 1, 3, 4, 2, 10'
      '1101141228=         INTO :OPER,'
      '1101141229=              :ZAKAZ,'
      '1101141230=              :Z_DATE,'
      '1101141231=              :Z_TIME,'
      '1101141232=              :CLIENT_NAME,'
      '1101141233=              :SKLAD_NAME,'
      '1101141234=              :SUMM_CASH,'
      '1101141235=              :SUMM_NONCASH,'
      '1101141236=              :SUMM_SERT,'
      '1101141237=              :ARTICUL,'
      '1101141238=              :BARCODE,'
      '1101141239=              :NOMENCLATUR_NUM,'
      '1101141240=              :TOVAR_NAME,'
      '1101141241=              :AMOUNT,'
      '1101141242=              :PRICE,'
      '1101141243=              :SUMM,'
      '1101141244=              :SYNC_EXT_APP'
      '1101141245=  DO'
      '1101141246=    SUSPEND;'
      '1101141247=END'
      '1101141248=;'
      
        '1101141249=UPDATE SYSTEM_SETUP SET S_VALUE = 110114 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101141250=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101141251=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101150=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      '1101151=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT,'
      '1101152=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101153=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101154=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1101155=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1101156=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1101157=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1101158=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101159=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '11011510=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '11011511=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '11011512=  IS_SPISANIE_ INTEGER,'
      '11011513=  NEW_LINE_SALE_ INTEGER = 0,'
      '11011514=  MODE_ INTEGER = 0,'
      '11011515=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '11011516=  DO_PRODUCT_IN_SALE_ INTEGER = 0)'
      '11011517=RETURNS ('
      
        '11011518=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '11011519=  ERR_CODE INTEGER,'
      '11011520=  ERR_MSG VARCHAR(1024))'
      '11011521=AS'
      '11011522=/*'
      
        '11011523=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048#1058 +
        #1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '11011524=*/'
      
        '11011525=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DETA' +
        'ILS_TMP'#39';'
      '11011526=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '11011527=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0;'
      
        '11011528=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.AMOUNT = 0;'
      
        '11011529=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0;' +
        ' /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047#1040 +
        #1050#1040#1047' */'
      
        '11011530=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' */'
      
        '11011531=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '11011532=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.Z_TYPE = 0;'
      
        '11011533=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.PRICE;'
      
        '11011534=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.COST_PRICE;'
      
        '11011535=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '11011536=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KI' +
        'T;'
      
        '11011537=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051 +
        #1048#1062#1045' */'
      
        '11011538=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040 +
        #1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' '#1062 +
        #1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '11011539=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKL' +
        'AD;'
      '11011540=BEGIN'
      '11011541='
      
        '11011542=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070#1058 +
        ' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '11011543=  SELECT T.ZAKAZ, T.Z_TYPE'
      '11011544=    FROM ZAKAZ_DETAILS_TMP T'
      '11011545=   WHERE T.ZAKAZ IS NOT NULL'
      
        '11011546=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089#1090 +
        #1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072' ' +
        'MULTIPLE ROWS IN SINGLETON SELECT'
      '11011547=    INTO :ZAKAZ_, :Z_TYPE_;'
      '11011548='
      
        '11011549=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051#1045 +
        #1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11011550=           ,G.IS_KIT'
      '11011551=           ,K.AMOUNT * :AMOUNT_'
      '11011552=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '11011553=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRIC' +
        'E)'
      '11011554=           ,(CASE'
      
        '11011555=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE_' +
        ' in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * F' +
        'ROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '11011556=             ELSE K.PRICE'
      '11011557=           END) COST_PRICE'
      
        '11011558=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_LA' +
        'ST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '11011559=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE G' +
        '_PRODUCT = :G_PRODUCT_) CNT'
      
        '11011560=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K ' +
        'ON G.G_PRODUCT = K.G_PRODUCT'
      '11011561=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11011562=       AND G.IS_KIT = 1'
      '11011563=    UNION'
      
        '11011564=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054#1044 +
        #1040#1046
      '11011565=           ,G.IS_KIT'
      '11011566=           ,:AMOUNT_'
      '11011567=           ,:PRICE_'
      '11011568=           ,0'
      '11011569=           ,:COST_PRICE_'
      '11011570=           ,0'
      '11011571=      FROM G_PRODUCT G'
      '11011572=     WHERE G_PRODUCT = :G_PRODUCT_'
      '11011573=       AND G.IS_KIT <> 1'
      '11011574=      INTO :G_PRODUCT_'
      '11011575=           ,:IS_KIT_'
      '11011576=           ,:AMOUNT_'
      '11011577=           ,:PRICE__'
      '11011578=           ,:SOSTAV_PRICE_'
      '11011579=           ,:COST_PRICE__'
      '11011580=           ,:SOSTAV_COUNT_'
      '11011581=  DO BEGIN'
      '11011582=      ZAKAZ_DTLS_TMP_ = NULL;'
      '11011583='
      
        '11011584=      --===============================================' +
        '============'
      '11011585=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11011586=      SELECT AMOUNT - AMOUNT_RESERVE'
      '11011587=        FROM LT_SKLAD_PRODUCT L'
      '11011588=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '11011589=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11011590=       INTO :AMOUNT_CUR_;'
      '11011591='
      
        '11011592=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056 +
        #1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '11011593=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040#1050 +
        #1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '11011594=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '11011595=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051#1054 +
        ', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068#1050 +
        #1054
      
        '11011596=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068' ' +
        #1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11011597=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '11011598=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '11011599=          SELECT SUM(AMOUNT)'
      '110115100=            FROM ZAKAZ_DETAILS T'
      '110115101=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110115102=             AND T.ZAKAZ = :ZAKAZ_'
      '110115103=            INTO :AMOUNT_OLD_;'
      '110115104=        ELSE'
      '110115105=          SELECT SUM(AMOUNT)'
      '110115106=            FROM SKLAD T'
      '110115107=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110115108=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110115109=            INTO :AMOUNT_OLD_;'
      '110115110=      END'
      '110115111='
      '110115112=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110115113=      SELECT SUM(AMOUNT)'
      '110115114=        FROM ZAKAZ_DETAILS_TMP T'
      '110115115=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110115116=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110115117='
      
        '110115118=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_, ' +
        '0) + :AMOUNT_;'
      '110115119=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '110115120='
      
        '110115121=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110115122='
      
        '110115123=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '110115124=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042 +
        #1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110115125=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) T' +
        'HEN BEGIN'
      '110115126=            PNT_ = '#39'01'#39';'
      
        '110115127=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FR' +
        'OM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      '110115128=                                         CURRENT_DATE,'
      '110115129=                                         :G_PRODUCT_,'
      
        '110115130=                                         ABS(AMOUNT_CU' +
        'R_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUN' +
        'T_,'
      
        '110115131=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086 +
        ' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110115132=                                         )'
      
        '110115133=                RETURNING_VALUES :SKLAD_, :COST_PRICE_' +
        '_, :ERR_CODE, :ERR_MSG;'
      '110115134=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110115135=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110115136=              EXIT;'
      '110115137=            END'
      '110115138=        END'
      
        '110115139=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BE' +
        'GIN'
      '110115140=            SELECT NAME'
      '110115141=            FROM G_PRODUCT'
      '110115142=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110115143=            INTO :PRODUCT_NAME_;'
      '110115144='
      '110115145=            ERR_CODE = -20500;'
      
        '110115146=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110115147=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110115148=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110115149=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110115150=            EXIT;'
      '110115151=        END'
      '110115152=      END'
      '110115153=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110115154=      --==============================================' +
        '============='
      '110115155='
      
        '110115156=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110115157=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110115158=        IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '110115159=            PRICE__ = SOSTAV_PRICE_;'
      '110115160=        END ELSE BEGIN'
      '110115161=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110115162=              PRICE__ = COST_PRICE__;'
      '110115163='
      
        '110115164=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110115165=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110115166='
      '110115167='
      
        '110115168=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110115169=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110115170=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110115171=            END'
      '110115172='
      
        '110115173=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110115174=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110115175=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110115176=        END'
      '110115177=      END'
      '110115178='
      
        '110115179=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '110115180=      IF (NEW_LINE_SALE_ = 0) THEN'
      '110115181=          SELECT ZD.zakaz_details'
      '110115182=            FROM zakaz_details_tmp ZD'
      '110115183=           WHERE ZD.G_PRODUCT = :g_product_'
      '110115184=             AND ZD.PRICE = :PRICE__'
      '110115185=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110115186=            INTO :ZAKAZ_DTLS_TMP_;'
      '110115187='
      '110115188='
      '110115189=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110115190=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110115191=           SET P.amount = P.amount + :amount_'
      
        '110115192=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110115193=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110115194=               ,P.NDS = :NDS_'
      '110115195=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110115196=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110115197='
      '110115198=      ELSE BEGIN'
      '110115199=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110115200=          ('
      '110115201=           ZAKAZ_DETAILS,'
      '110115202=           ZAKAZ,'
      '110115203=           G_PRODUCT,'
      '110115204=           AMOUNT,'
      '110115205=           PRICE,'
      '110115206=           SUMM,'
      '110115207=           DISCOUNT_PERC,'
      '110115208=           DISCOUNT_TENGE,'
      '110115209=           DISCOUNT_SUMM,'
      '110115210=           NDS,'
      '110115211=           NDS_SUMM,'
      '110115212=           COST_PRICE'
      '110115213=          ) VALUES ('
      '110115214=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110115215=           :ZAKAZ_,'
      '110115216=           :G_PRODUCT_,'
      '110115217=           :AMOUNT_,'
      '110115218=           :PRICE__,'
      '110115219=           :SUMM_,'
      '110115220=           :DISCOUNT_PERC_,'
      '110115221=           :DISCOUNT_TENGE_,'
      '110115222=           :DISCOUNT_SUMM_,'
      '110115223=           :NDS_,'
      '110115224=           :NDS_SUMM_,'
      '110115225=           :COST_PRICE__'
      '110115226=          )'
      '110115227=          RETURNING'
      '110115228=            ZAKAZ_DETAILS'
      '110115229=          INTO'
      '110115230=            :ZAKAZ_DETAILS_;'
      '110115231=      END'
      '110115232=  END'
      '110115233=end'
      '110115234=;'
      
        '110115235=UPDATE SYSTEM_SETUP SET S_VALUE = 110115 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110115236=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110115237=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101160=ALTER PROCEDURE K_RECALC_KASSA('
      '1101161=  ACTION_DATE_ DATE,'
      '1101162=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101163=RETURNS ('
      '1101164=  ERR_CODE INTEGER,'
      '1101165=  ERR_MSG VARCHAR(1024))'
      '1101166=AS'
      
        '1101167=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASSA'#39 +
        ';'
      '1101168=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101169=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '11011610=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_STATE.K_D' +
        'ATE;'
      '11011611=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '11011612=begin'
      '11011613='
      '11011614=  IF (G_TOCHKA_ IS NULL) THEN'
      '11011615=    SELECT ID'
      '11011616=      FROM CUR_PARAMS'
      '11011617=     WHERE CUR_PARAMS = 2'
      '11011618=      INTO :G_TOCHKA_;'
      '11011619='
      
        '11011620=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047#1040 +
        #1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043#1054 +
        #1044#1053#1071' 21.02.'
      
        '11011621=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057#1071 +
        ' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      '11011622=  PNT_ = '#39'00'#39';'
      
        '11011623=  IF ((SELECT COUNT(*) FROM KASSA_STATE K WHERE K.K_DAT' +
        'E = CURRENT_DATE AND G_TOCHKA = :G_TOCHKA_) = 0) THEN BEGIN'
      '11011624=    INSERT INTO KASSA_STATE'
      
        '11011625=      (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, OUTPU' +
        'T, G_TOCHKA)'
      '11011626=    VALUES'
      
        '11011627=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0 , 0,' +
        ' 0, 0, :G_TOCHKA_);'
      '11011628='
      
        '11011629=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '11011630=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0) THEN BEGIN'
      '11011631=      SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '11011632=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DATE|' +
        '|'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '11011633=                 '#39' from RDB$DATABASE) cd '#39'||'
      
        '11011634=                 '#39'ON (c.K_DATE = cd.K_DATE AND C.G_TOCH' +
        'KA = CD.G_TOCHKA) '#39'||'
      '11011635=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '11011636=                 '#39' INSERT (KASSA_STATE, K_DATE, "INPUT"' +
        ', DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '11011637=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, 0' +
        ')||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0, '#39'||G_TOCHKA_||'#39');'#39';'
      
        '11011638=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERED' +
        ', SYSDATE, ERR_CODE)'
      
        '11011639=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA'#39 +
        ', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11011640=    END'
      '11011641=  END'
      '11011642='
      
        '11011643=  -----------------------------------------------------' +
        '-----------------'
      
        '11011644=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056#1048 +
        #1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      
        '11011645=  -- '#1040' '#1058#1040#1050#1046#1045' '#1053#1059#1046#1053#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1047#1040#1056#1055#1051#1040 +
        #1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040#1052', '#1058#1040#1052' '#1047#1040#1055#1048#1057#1068' '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040#1058#1054#1049
      '11011646=  PNT_ = '#39'01'#39';'
      '11011647=  IF (ACTION_DATE_ >= CURRENT_DATE) THEN'
      '11011648=    SELECT ST."OUTPUT",'
      '11011649=           ST.K_DATE'
      '11011650=      FROM KASSA_STATE ST'
      '11011651=     WHERE ST.K_DATE < CURRENT_DATE'
      '11011652=     ORDER BY ST.K_DATE DESC'
      '11011653=     ROWS 1'
      '11011654=     INTO :OUTPUT_,'
      '11011655=          :ACTION_DATE_;'
      '11011656=  ELSE'
      '11011657=    SELECT K.OUTPUT'
      '11011658=      FROM KASSA_STATE K'
      '11011659=     WHERE K.K_DATE = :ACTION_DATE_'
      '11011660=       AND K.G_TOCHKA = :G_TOCHKA_'
      '11011661=      INTO :OUTPUT_;'
      '11011662='
      '11011663=  PNT_ = '#39'02'#39';'
      '11011664=  FOR SELECT K.K_DATE'
      '11011665=        FROM KASSA_STATE K'
      '11011666=       WHERE K.K_DATE > :ACTION_DATE_'
      '11011667=         AND K.G_TOCHKA = :G_TOCHKA_'
      '11011668=      ORDER BY K.K_DATE, K.KASSA_STATE'
      '11011669=        INTO :K_DATE_'
      '11011670=  DO BEGIN'
      '11011671=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '11011672=    UPDATE KASSA_STATE K'
      '11011673=       SET K.INPUT = :OUTPUT_,'
      
        '11011674=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE(' +
        'K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '11011675=     WHERE K.K_DATE = :K_DATE_'
      '11011676=       AND K.G_TOCHKA = :G_TOCHKA_;'
      '11011677='
      
        '11011678=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '11011679=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0) THEN BEGIN'
      '11011680=      SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      '11011681=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '11011682=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, 0' +
        ')||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '11011683=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39#39'|' +
        '|'
      '11011684=                 '#39'  AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';'#39';'
      
        '11011685=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERED' +
        ', SYSDATE, ERR_CODE)'
      
        '11011686=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA'#39 +
        ', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11011687=    END'
      '11011688='
      '11011689=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '11011690=    SELECT K.OUTPUT'
      '11011691=      FROM KASSA_STATE K'
      '11011692=     WHERE K.K_DATE = :K_DATE_'
      '11011693=       AND K.G_TOCHKA = :G_TOCHKA_'
      '11011694=      INTO :OUTPUT_;'
      '11011695=  END'
      '11011696='
      '11011697=WHEN ANY DO BEGIN'
      '11011698=    Err_code = -20500;'
      
        '11011699=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110116100=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110116101=  END'
      '110116102=end'
      '110116103=;'
      
        '110116104=UPDATE SYSTEM_SETUP SET S_VALUE = 110116 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110116105=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110116106=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101170=ALTER PROCEDURE K_RECALC_KASSA('
      '1101171=  ACTION_DATE_ DATE,'
      '1101172=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101173=RETURNS ('
      '1101174=  ERR_CODE INTEGER,'
      '1101175=  ERR_MSG VARCHAR(1024))'
      '1101176=AS'
      
        '1101177=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASSA'#39 +
        ';'
      '1101178=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101179=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '11011710=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_STATE.K_D' +
        'ATE;'
      '11011711=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '11011712=begin'
      '11011713='
      '11011714=  IF (G_TOCHKA_ IS NULL) THEN'
      '11011715=    SELECT ID'
      '11011716=      FROM CUR_PARAMS'
      '11011717=     WHERE CUR_PARAMS = 2'
      '11011718=      INTO :G_TOCHKA_;'
      '11011719='
      
        '11011720=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047#1040 +
        #1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043#1054 +
        #1044#1053#1071' 21.02.'
      
        '11011721=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057#1071 +
        ' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      '11011722=  PNT_ = '#39'00'#39';'
      
        '11011723=  IF ((SELECT COUNT(*) FROM KASSA_STATE K WHERE K.K_DAT' +
        'E = CURRENT_DATE AND G_TOCHKA = :G_TOCHKA_) = 0) THEN BEGIN'
      '11011724=    INSERT INTO KASSA_STATE'
      
        '11011725=      (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, OUTPU' +
        'T, G_TOCHKA)'
      '11011726=    VALUES'
      
        '11011727=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0 , 0,' +
        ' 0, 0, :G_TOCHKA_);'
      '11011728='
      
        '11011729=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '11011730=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0) THEN BEGIN'
      '11011731=      SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '11011732=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DATE|' +
        '|'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '11011733=                 '#39' from RDB$DATABASE) cd '#39'||'
      
        '11011734=                 '#39'ON (c.K_DATE = cd.K_DATE AND C.G_TOCH' +
        'KA = CD.G_TOCHKA) '#39'||'
      '11011735=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '11011736=                 '#39' INSERT (KASSA_STATE, K_DATE, "INPUT"' +
        ', DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '11011737=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, 0' +
        ')||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0, '#39'||G_TOCHKA_||'#39');'#39';'
      
        '11011738=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERED' +
        ', SYSDATE, ERR_CODE)'
      
        '11011739=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA'#39 +
        ', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11011740=    END'
      '11011741=  END'
      '11011742='
      
        '11011743=  -----------------------------------------------------' +
        '-----------------'
      
        '11011744=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056#1048 +
        #1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      
        '11011745=  -- '#1040' '#1058#1040#1050#1046#1045' '#1053#1059#1046#1053#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1047#1040#1056#1055#1051#1040 +
        #1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040#1052', '#1058#1040#1052' '#1047#1040#1055#1048#1057#1068' '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040#1058#1054#1049
      '11011746=  PNT_ = '#39'01'#39';'
      '11011747=  IF (ACTION_DATE_ >= CURRENT_DATE) THEN'
      '11011748=    SELECT ST."OUTPUT",'
      '11011749=           ST.K_DATE'
      '11011750=      FROM KASSA_STATE ST'
      '11011751=     WHERE ST.K_DATE < CURRENT_DATE'
      '11011752=       AND ST.G_TOCHKA = :G_TOCHKA_'
      '11011753=     ORDER BY ST.K_DATE DESC'
      '11011754=     ROWS 1'
      '11011755=     INTO :OUTPUT_,'
      '11011756=          :ACTION_DATE_;'
      '11011757=  ELSE'
      '11011758=    SELECT K.OUTPUT'
      '11011759=      FROM KASSA_STATE K'
      '11011760=     WHERE K.K_DATE = :ACTION_DATE_'
      '11011761=       AND K.G_TOCHKA = :G_TOCHKA_'
      '11011762=      INTO :OUTPUT_;'
      '11011763='
      '11011764=  PNT_ = '#39'02'#39';'
      '11011765=  FOR SELECT K.K_DATE'
      '11011766=        FROM KASSA_STATE K'
      '11011767=       WHERE K.K_DATE > :ACTION_DATE_'
      '11011768=         AND K.G_TOCHKA = :G_TOCHKA_'
      '11011769=      ORDER BY K.K_DATE, K.KASSA_STATE'
      '11011770=        INTO :K_DATE_'
      '11011771=  DO BEGIN'
      '11011772=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '11011773=    UPDATE KASSA_STATE K'
      '11011774=       SET K.INPUT = :OUTPUT_,'
      
        '11011775=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE(' +
        'K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '11011776=     WHERE K.K_DATE = :K_DATE_'
      '11011777=       AND K.G_TOCHKA = :G_TOCHKA_;'
      '11011778='
      
        '11011779=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '11011780=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0) THEN BEGIN'
      '11011781=      SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      '11011782=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '11011783=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, 0' +
        ')||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '11011784=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39#39'|' +
        '|'
      '11011785=                 '#39'  AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';'#39';'
      
        '11011786=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERED' +
        ', SYSDATE, ERR_CODE)'
      
        '11011787=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA'#39 +
        ', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '11011788=    END'
      '11011789='
      '11011790=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '11011791=    SELECT K.OUTPUT'
      '11011792=      FROM KASSA_STATE K'
      '11011793=     WHERE K.K_DATE = :K_DATE_'
      '11011794=       AND K.G_TOCHKA = :G_TOCHKA_'
      '11011795=      INTO :OUTPUT_;'
      '11011796=  END'
      '11011797='
      '11011798=WHEN ANY DO BEGIN'
      '11011799=    Err_code = -20500;'
      
        '110117100=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110117101=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110117102=  END'
      '110117103=end'
      '110117104=;'
      
        '110117105=UPDATE SYSTEM_SETUP SET S_VALUE = 110117 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110117106=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110117107=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101180=CREATE PROCEDURE P_REP_AVERAGE_BILL('
      '1101181=  DATE_BEGIN_ DATE,'
      '1101182=  DATE_END_ DATE,'
      '1101183=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101184=RETURNS ('
      
        '1101185=  SUMM_ /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      '1101186=  ERR_CODE INTEGER,'
      '1101187=  ERR_MSG VARCHAR(1024))'
      '1101188=AS'
      '1101189=BEGIN'
      '11011810=  SUSPEND;'
      '11011811=END'
      '11011812=;'
      '11011813='
      '11011814='
      
        '11011815=/******************************************************' +
        '************************/'
      
        '11011816=/****                   Creating generators (sequences)' +
        '                    ****/'
      
        '11011817=/******************************************************' +
        '************************/'
      '11011818='
      '11011819=CREATE GENERATOR GEN_SYNC_COMPS;'
      '11011820='
      '11011821='
      
        '11011822=/******************************************************' +
        '************************/'
      
        '11011823=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11011824=/******************************************************' +
        '************************/'
      '11011825='
      '11011826=ALTER PROCEDURE DEL_ZAKAZ_DETAIL('
      '11011827=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '11011828=RETURNS ('
      '11011829=  ERR_CODE INTEGER,'
      '11011830=  ERR_MSG VARCHAR(1024))'
      '11011831=AS'
      
        '11011832=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ_DETA' +
        'IL'#39';'
      '11011833=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '11011834=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11011835=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '11011836=DECLARE VARIABLE IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_S' +
        'PISANIE;'
      
        '11011837=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RE' +
        'SERVE;'
      
        '11011838=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '11011839=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11011840=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA' +
        '_REAL.ZAKAZ_NA_REAL;'
      
        '11011841=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11011842=BEGIN'
      '11011843=  PNT_ = '#39'00'#39';'
      
        '11011844=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1040' '#1042#1044#1056#1059#1043' '#1059#1044#1040#1051#1071#1070' '#1054#1055#1051#1040#1058#1059' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051#1048 +
        #1047#1040#1062#1048#1070
      '11011845=  SELECT Z.IS_SPISANIE,'
      '11011846=         Z.G_TOCHKA'
      '11011847=         ,Z.IS_RESERVE'
      '11011848=    FROM ZAKAZ Z'
      '11011849=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11011850=    INTO :IS_SPISANIE_,'
      '11011851=         :G_TOCHKA_'
      '11011852=         ,:IS_RESERVE_;'
      '11011853='
      
        '11011854=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1048#1051#1048' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040'. '#1058#1054' '#1057#1053 +
        #1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11011855=  if (IS_SPISANIE_ <> 2) then BEGIN'
      '11011856=      FOR SELECT G_PRODUCT,'
      '11011857=                 AMOUNT'
      '11011858=            FROM ZAKAZ_DETAILS Z'
      '11011859=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '11011860=           INTO :G_PRODUCT_,'
      '11011861=                :AMOUNT_'
      '11011862=      DO BEGIN'
      '11011863=        BEGIN'
      
        '11011864=            -- '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1050' '#1054#1057#1053#1054#1042#1053#1054#1052#1059' '#1054 +
        #1057#1058#1040#1058#1050#1059
      '11011865=            IF (IS_RESERVE_ = 0) THEN'
      '11011866=                UPDATE LT_SKLAD_PRODUCT LT'
      '11011867=                   SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_'
      '11011868=                 WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '11011869=                   AND LT.G_TOCHKA = :G_TOCHKA_;'
      '11011870='
      
        '11011871=            -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1056#1045#1047#1045#1056#1042', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1054#1058' '#1047#1040#1056#1045#1047#1045#1056#1042#1048 +
        #1056#1054#1042#1040#1053#1053#1054#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040
      '11011872=            ELSE'
      '11011873=                UPDATE LT_SKLAD_PRODUCT LT'
      
        '11011874=                   SET LT.AMOUNT_RESERVE = LT.AMOUNT_RE' +
        'SERVE - :AMOUNT_'
      '11011875=                 WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '11011876=                   AND LT.G_TOCHKA = :G_TOCHKA_;'
      '11011877=        WHEN EXCEPTION NOL_EXCEPTION DO'
      '11011878=          begin'
      '11011879=            ERR_CODE = -20500;'
      
        '11011880=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042' ' +
        #1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1086#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087 +
        #1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11011881=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11011882=            EXIT;'
      '11011883=          end'
      '11011884=        END'
      '11011885=      END'
      '11011886='
      
        '11011887=  --***************************************************' +
        '********'
      
        '11011888=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051', '#1058#1054' '#1053#1040#1044#1054' '#1042#1054 +
        #1057#1057#1058#1040#1053#1054#1042#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1045' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      
        '11011889=  -- '#1048#1065#1059' '#1055#1054' '#1044#1040#1053#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1048' '#1055#1056#1048#1041#1040 +
        #1042#1051#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050' '#1053#1045#1052#1059', '#1045#1057#1051#1048' '#1042#1045#1057#1068' '#1058#1054#1042#1040#1056' '#1054#1055#1051#1040#1063#1045#1053', '#1058#1054' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070 +
        ' '#1047#1040#1055#1048#1057#1068
      '11011890=  END ELSE BEGIN'
      '11011891=      FOR SELECT ZD.AMOUNT,'
      '11011892=                 ZD.PRICE,'
      '11011893=                 ZD.DISCOUNT_TENGE,'
      '11011894=                 LZ.ZAKAZ_NA_REAL'
      '11011895=            FROM ZAKAZ Z,'
      '11011896=                 ZAKAZ_DETAILS ZD,'
      '11011897=                 LT_ZAKAZ_REAL LZ'
      '11011898=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '11011899=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110118100=             AND ZD.ZAKAZ_DETAILS = LZ.ZAKAZ_DETAILS'
      '110118101=           INTO :AMOUNT_,'
      '110118102=                :PRICE_,'
      '110118103=                :DISCOUNT_TENGE_,'
      '110118104=                :ZAKAZ_NA_REAL_'
      '110118105=      DO BEGIN'
      '110118106=          UPDATE ZAKAZ_NA_REAL ZRR'
      
        '110118107=             SET ZRR.AMOUNT_PAYED = ZRR.AMOUNT_PAYED -' +
        ' :AMOUNT_,'
      
        '110118108=                 ZRR.SUMM_PAYED = ZRR.SUMM_PAYED - :AM' +
        'OUNT_ * (:PRICE_ - :DISCOUNT_TENGE_),'
      '110118109=                 ZRR.IS_PAYED_ALL = 0'
      '110118110=           WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110118111=      END'
      '110118112='
      '110118113=      -- '#1059#1044#1040#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067
      
        '110118114=      DELETE FROM LT_ZAKAZ_REAL R WHERE R.ZAKAZ_DETAIL' +
        'S IN (SELECT ZAKAZ_DETAILS FROM ZAKAZ_DETAILS ZD WHERE ZD.ZAKAZ ' +
        '= :ZAKAZ_);'
      '110118115=  END'
      '110118116='
      '110118117=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '110118118=  PNT_ = '#39'03'#39';'
      '110118119=  DELETE from zakaz_DETAILS z'
      '110118120=  WHERE z.zakaz = :zakaz_;'
      '110118121='
      '110118122=when sqlcode -530 DO'
      '110118123=  begin'
      '110118124=    ERR_CODE = -20500;'
      
        '110118125=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      
        '110118126=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110118127=  end'
      '110118128=WHEN ANY DO'
      '110118129=  begin'
      '110118130=    ERR_CODE = sqlcode;'
      '110118131=  end'
      '110118132=end'
      '110118133=;'
      '110118134='
      '110118135=ALTER PROCEDURE P_REP_AVERAGE_BILL('
      '110118136=  DATE_BEGIN_ DATE,'
      '110118137=  DATE_END_ DATE,'
      '110118138=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110118139=RETURNS ('
      '110118140=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '110118141=  ERR_CODE INTEGER,'
      '110118142=  ERR_MSG VARCHAR(1024))'
      '110118143=AS'
      
        '110118144=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_AVERAGE' +
        '_BILL'#39';'
      '110118145=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110118146=DECLARE VARIABLE CNT_ INTEGER;'
      '110118147=BEGIN'
      '110118148=  SUMM_ = 0;'
      '110118149='
      '110118150=  SELECT COUNT(*)'
      '110118151=    FROM ZAKAZ ZZ'
      '110118152=   WHERE ZZ.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110118153=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOCHKA||'#39 +
        '-'#39
      '110118154=    INTO :CNT_;'
      '110118155='
      '110118156=  SELECT ROUND(SUM(Z.SUMM) / :CNT_, 2)'
      '110118157=    FROM ZAKAZ Z'
      '110118158=   WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110118159=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110118160=    INTO :SUMM_;'
      '110118161='
      '110118162=  FOR'
      '110118163=  SELECT :SUMM_'
      '110118164=    FROM RDB$DATABASE R'
      '110118165=    INTO :SUMM_'
      '110118166=  DO'
      '110118167=    SUSPEND;'
      '110118168='
      '110118169=WHEN ANY DO BEGIN'
      '110118170=    Err_code = -20500;'
      
        '110118171=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110118172=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110118173=  END'
      '110118174=end'
      '110118175=;'
      '110118176=EXECUTE BLOCK AS'
      '110118177=DECLARE SS_ BIGINT;'
      '110118178=DECLARE TT_ BIGINT;'
      '110118179=BEGIN'
      '110118180=    SELECT MAX(SYNC_COMPS) FROM SYNC_COMPS INTO SS_;'
      
        '110118181=    SELECT GEN_ID(GEN_SYNC_COMPS, :SS_) FROM RDB$DATAB' +
        'ASE INTO TT_;'
      '110118182=END;'
      
        '110118183=UPDATE SYSTEM_SETUP SET S_VALUE = 110118 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110118184=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110118185=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101190=CREATE PROCEDURE K_READ_KASSASTMT_LIST('
      '1101191=  DATE_BEGIN_ DATE,'
      '1101192=  DATE_END_ DATE,'
      
        '1101193=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE */ BIGINT,'
      '1101194=  G_TOCHKA_ /* TYPE OF COLUMN KASSA.G_TOCHKA */ BIGINT)'
      '1101195=RETURNS ('
      
        '1101196=  KASSA_STATE /* TYPE OF COLUMN KASSA_STATE.KASSA_STATE ' +
        '*/ BIGINT,'
      '1101197=  K_DATE /* TYPE OF COLUMN KASSA_STATE.K_DATE */ DATE,'
      
        '1101198=  INPUT /* TYPE OF COLUMN KASSA_STATE.INPUT */ NUMERIC(1' +
        '5,2),'
      
        '1101199=  DEBET /* TYPE OF COLUMN KASSA_STATE.DEBET */ NUMERIC(1' +
        '5,2),'
      
        '11011910=  CREDIT /* TYPE OF COLUMN KASSA_STATE.CREDIT */ NUMERI' +
        'C(15,2),'
      
        '11011911=  OUTPUT /* TYPE OF COLUMN KASSA_STATE.OUTPUT */ NUMERI' +
        'C(15,2))'
      '11011912=AS'
      '11011913=BEGIN'
      '11011914=  SUSPEND;'
      '11011915=END'
      '11011916=;'
      '11011917='
      '11011918='
      
        '11011919=/******************************************************' +
        '************************/'
      
        '11011920=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11011921=/******************************************************' +
        '************************/'
      '11011922=ALTER PROCEDURE K_READ_KASSASTMT_LIST('
      '11011923=  DATE_BEGIN_ DATE,'
      '11011924=  DATE_END_ DATE,'
      
        '11011925=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYME' +
        'NT_TYPE,'
      '11011926=  G_TOCHKA_ TYPE OF COLUMN KASSA.G_TOCHKA)'
      '11011927=RETURNS ('
      '11011928=  KASSA_STATE TYPE OF COLUMN KASSA_STATE.KASSA_STATE,'
      '11011929=  K_DATE TYPE OF COLUMN KASSA_STATE.K_DATE,'
      '11011930=  INPUT TYPE OF COLUMN KASSA_STATE.INPUT,'
      '11011931=  DEBET TYPE OF COLUMN KASSA_STATE.DEBET,'
      '11011932=  CREDIT TYPE OF COLUMN KASSA_STATE.CREDIT,'
      '11011933=  OUTPUT TYPE OF COLUMN KASSA_STATE.OUTPUT)'
      '11011934=AS'
      '11011935=BEGIN'
      '11011936='
      
        '11011937=  FOR SELECT KASSA_STATE, K_DATE, "INPUT", DEBET, CREDI' +
        'T, "OUTPUT"'
      '11011938=      FROM KASSA_STATE'
      
        '11011939=      WHERE :G_PAYMENT_TYPE_ = 1 AND G_TOCHKA = :G_TOCH' +
        'KA_'
      '11011940=      AND K_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11011941=      UNION ALL'
      
        '11011942=      SELECT KASSA_BEZNAL_STATE, K_DATE, "INPUT", DEBET' +
        ', CREDIT, "OUTPUT"'
      '11011943=      FROM KASSA_BEZNAL_STATE'
      '11011944=      WHERE :G_PAYMENT_TYPE_ = 2'
      '11011945=      AND K_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11011946=      ORDER BY 2'
      
        '11011947=      INTO :KASSA_STATE, :K_DATE, :"INPUT", :DEBET, :CR' +
        'EDIT, :"OUTPUT"'
      '11011948=  DO'
      '11011949=    SUSPEND;'
      '11011950=END'
      '11011951=;'
      
        '11011952=UPDATE SYSTEM_SETUP SET S_VALUE = 110119 WHERE SYSTEM_S' +
