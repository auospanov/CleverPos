        'L,'
      '110199404=               IP.INVOICE_PAY,'
      '110199405=               I.INVOICE,'
      '110199406=               W.WAYBILL,'
      '110199407=               T.SUMM,'
      '110199408=               T.SUMM_FACT,'
      '110199409=               COALESCE(t.SUMM_BONUS, 0),'
      '110199410=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '110199411=               COALESCE(T.BY_RECIPE, 0)'
      '110199412=               ,IS_RESERVE'
      '110199413=               ,T.SUMM_CASH'
      '110199414=               ,T.SUMM_NONCASH'
      '110199415=               ,O.g_official'
      '110199416=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '110199417=               ,T.DELIVERY_ADDRESS'
      '110199418=          FROM ZAKAZ T'
      
        '110199419=                    LEFT OUTER JOIN G_CLIENT GC ON T.G' +
        '_CLIENT = GC.G_CLIENT'
      
        '110199420=                    LEFT OUTER JOIN INVOICE_PAY IP ON ' +
        'T.ZAKAZ = IP.ZAKAZ'
      
        '110199421=                    LEFT OUTER JOIN INVOICE I ON T.ZAK' +
        'AZ = I.ZAKAZ'
      
        '110199422=                    LEFT OUTER JOIN WAYBILL W ON T.ZAK' +
        'AZ = W.ZAKAZ'
      
        '110199423=                    LEFT OUTER JOIN G_OFFICIAL O ON T.' +
        'g_official = O.g_official'
      
        '110199424=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110199425=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISAN' +
        'IE_ = 0'
      '110199426=                 AND'
      
        '110199427=                 ((:G_OFFICIAL_APPOINT_ = 1 AND T.G_OF' +
        'FICIAL = :G_OFFICIAL_LOCAL_)'
      '110199428=                   OR'
      '110199429=                  (:G_OFFICIAL_APPOINT_ = 0 )'
      '110199430=                 )'
      '110199431=                )'
      '110199432=                or'
      
        '110199433=                (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS' +
        '_SPISANIE_ <> 0)'
      '110199434=               )'
      
        '110199435=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
