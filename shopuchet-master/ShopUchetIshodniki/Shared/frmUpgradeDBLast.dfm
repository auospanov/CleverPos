        'G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110223735=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110223736='
      
        '110223737=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076 +
        #1086#1084' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110223738='
      
