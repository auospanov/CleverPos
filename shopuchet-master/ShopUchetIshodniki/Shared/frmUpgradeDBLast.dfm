      '1101241202=        END'
      '1101241203=      END'
      '1101241204=  END'
      '1101241205='
      
        '1101241206=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1101241207=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101241208=    SELECT K.KASSA'
      '1101241209=      FROM KASSA K'
      '1101241210=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101241211=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101241212=      INTO :KASSA_POP_;'
      '1101241213=  ELSE'
      '1101241214=    SELECT K.KASSA_BEZNAL'
      '1101241215=      FROM KASSA_BEZNAL K'
      '1101241216=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101241217=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101241218=       INTO :KASSA_POP_;'
      '1101241219='
      
        '1101241220=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1101241221=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1101241222=      PNT_ = '#39'012'#39';'
      '1101241223=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1101241224=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1101241225=                                          1,     -- A' +
