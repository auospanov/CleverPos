      '1106014437=ALTER PROCEDURE CUR_PARAMS_UPD('
      '1106014438=  CUR_PARAMS_ TYPE OF COLUMN CUR_PARAMS.CUR_PARAMS,'
      '1106014439=  ID_ TYPE OF COLUMN CUR_PARAMS.ID,'
      '1106014440=  NAME_ TYPE OF COLUMN CUR_PARAMS.NAME)'
      '1106014441=AS'
