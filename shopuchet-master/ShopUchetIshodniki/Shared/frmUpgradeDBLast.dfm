      '11096627=             AMOUNT,'
      '11096628=             PRICE,'
      '11096629=             SUMM,'
      '11096630=             G_PAYMENT_TYPE,'
      '11096631=             OSNOVANIE,'
      '11096632=             NOTE,'
      '11096633=             NDS,'
      '11096634=             NDS_SUMM,'
      '11096635=             IS_LAST,'
      '11096636=             IS_VOZVRAT,'
      '11096637=             G_TOCHKA'
      '11096638=            ) VALUES ('
      '11096639=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '11096640=             :ZAKAZ_,'
      '11096641=             :Z_DATE_,'
      '11096642=             :G_TOCHKA_,'
      '11096643=             :G_PRODUCT_,'
      '11096644=             :Z_AMOUNT_,'
      '11096645=             :PRICE_,'
      '11096646=             :SUMMM_,'
      '11096647=             :G_PAYMENT_TYPE_,'
      '11096648=             :OSNOVANIE_,'
      '11096649=             :NOTE_,'
      '11096650=             0,  --:RNDS_,'
      '11096651=             0,  --:RNDS_SUMM_,'
      
        '11096652=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' ' +
        #1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059 +
        ' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045 +
        #1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '11096653=             3,  --:IS_VOZVRAT_,'
      '11096654=             :G_CLIENT_'
      '11096655=            );'
      '11096656='
      
        '11096657=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058#1040#1042 +
        #1065#1048#1050#1045
      '11096658=            UPDATE LT_SKLAD_PRODUCT L'
      '11096659=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '11096660=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096661=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11096662='
      
        '11096663=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11096664=            PNT_ = '#39'023'#39';'
