        '   -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110402556=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110402557=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110402558=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110402559=                                                  :ZAK' +
        'AZ_,   --ZAKAZ_'
      
        '110402560=                                                  NULL' +
        ','
      
        '110402561=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110402562=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110402563='
      
        '110402564=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057 +
        #1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '110402565=                ELSE BEGIN'
      
        '110402566=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053 +
        #1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '110402567=                    SELECT 1'
      '110402568=                      FROM KASSA K'
      '110402569=                     WHERE K.KASSA = :KASSA_'
      '110402570=                    UNION ALL'
      '110402571=                    SELECT 2'
      '110402572=                      FROM KASSA_BEZNAL KB'
      '110402573=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110402574=                     INTO :PAYMENT_TYPE_OLD_;'
      '110402575='
      '110402576=                    PNT_ = '#39#39'06'#39#39';'
      
        '110402577=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_TY' +
        'PE_) THEN'
      
        '110402578=                        EXECUTE PROCEDURE K_UPD_KASSA(' +
        ':KASSA_,'
      
        '110402579=                                                      ' +
        '0,     -- ACTION_'
      
        '110402580=                                                      ' +
        '1,     --:G_PRIHOD_RASHOD_,'
      
        '110402581=                                                      ' +
        ':PAYMENT_SUMM_,'
      
        '110402582=                                                      ' +
        ':PAYMENT_DATE_,'
      
        '110402583=                                                      ' +
        'NULL,   --NOTE_'
      
        '110402584=                                                      ' +
        ':ZAKAZ_,'
      
        '110402585=                                                      ' +
        'NULL,'
      
        '110402586=                                                      ' +
        ':PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '110402587=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055 +
        #1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110402588=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041 +
        #1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110402589=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110402590=                        PNT_ = '#39#39'07'#39#39';'
      
        '110402591=                        EXECUTE PROCEDURE K_DEL_KASSA(' +
        ':KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_M' +
        'SG);'
      '110402592=                        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402593=                          ERR_MSG = PROCNAME||'#39#39' -> PN' +
        'T_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110402594=                          EXIT;'
      '110402595=                        END'
      '110402596='
      '110402597=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '110402598=                           EXECUTE PROCEDURE K_INS_KAS' +
        'SA(0,     -- ACTION_ => :ACTION_'
      
        '110402599=                                                      ' +
        '    1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
