        'SUMM, NDS,'
      '1102012830=                                     NDS_SUMM)'
      
        '1102012831=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_,'
      '1102012832=                  :G_PRODUCT,'
      
        '1102012833=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1102012834=                  :AMOUNT, :SUMM,'
      '1102012835=                  0, --AMOUNT_PAYED,'
      '1102012836=                  0, --SUMM_PAYED,'
      '1102012837=                  0, --IS_PAYED_ALL,'
      '1102012838=                  :DISCOUNT_PERC,'
      '1102012839=                  :DISCOUNT_TENGE,'
      '1102012840=                  :DISCOUNT_SUMM,'
      '1102012841=                  :NDS,'
      '1102012842=                  :NDS_SUMM)'
      '1102012843=          RETURNING ZAKAZ_NA_REAL'
      '1102012844=          INTO :ZAKAZ_;'
      '1102012845=      END'
      '1102012846=  END'
      '1102012847=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102012848=  ----------------------------------------'
      '1102012849=  ----------------------------------------'
      '1102012850=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1102012851=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1102012852=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102012853=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102012854=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1102012855=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102012856=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102012857=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102012858=      RETURNING SKLAD'
      '1102012859=      INTO :ZAKAZ_;'
      '1102012860='
      '1102012861=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102012862=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102012863=          INTO :G_PRODUCT,'
      '1102012864=              :AMOUNT,'
      '1102012865=              :PRICE,'
      '1102012866=              :SUMM'
      '1102012867=      DO BEGIN'
      '1102012868=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102012869=        UPDATE LT_SKLAD_PRODUCT L'
      '1102012870=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1102012871=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102012872=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102012873=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102012874='
      '1102012875=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102012876=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1102012877=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1102012878=        SELECT MAX(SK.DATE_RECEIPT)'
      '1102012879=            FROM SKLAD SK'
      '1102012880=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102012881=             AND SK.IS_LAST = 1'
      '1102012882=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1102012883=            INTO :DATE_LAST_;'
      '1102012884='
      
        '1102012885=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102012886=            UPDATE SKLAD SK'
      '1102012887=               SET SK.IS_LAST = 0'
      '1102012888=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102012889=               AND SK.IS_LAST = 1'
      '1102012890=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102012891='
      '1102012892=            IS_THIS_LAST_ = 1;'
      '1102012893=        END */'
      '1102012894='
      '1102012895='
      '1102012896=        INSERT INTO SKLAD'
      '1102012897=        ('
      '1102012898=         SKLAD,'
      '1102012899=         SKLAD_PARENT,'
      '1102012900=         DATE_RECEIPT,'
      '1102012901=         G_CLIENT,'
      '1102012902=         G_PRODUCT,'
      '1102012903=         AMOUNT,'
      '1102012904=         PRICE,'
      '1102012905=         SUMM,'
      '1102012906=         G_PAYMENT_TYPE,'
      '1102012907=         OSNOVANIE,'
      '1102012908=         NOTE,'
      '1102012909=         NDS,'
      '1102012910=         NDS_SUMM,'
      '1102012911=         IS_LAST,'
      '1102012912=         IS_VOZVRAT,'
      '1102012913=         G_TOCHKA'
      '1102012914=        ) VALUES ('
      '1102012915=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102012916=         :ZAKAZ_,'
      '1102012917=         :Z_DATE_,'
      '1102012918=         :G_TOCHKA_,'
      '1102012919=         :G_PRODUCT,'
      '1102012920=         :AMOUNT,'
      '1102012921=         :PRICE,'
      '1102012922=         :SUMM,'
      '1102012923=         :G_PAYMENT_TYPE_,'
      '1102012924=         :OSNOVANIE_,'
      '1102012925=         :NOTE_,'
      '1102012926=         0,  --:RNDS_,'
      '1102012927=         0,  --:RNDS_SUMM_,'
      
        '1102012928=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102012929=         3,  --:IS_VOZVRAT_,'
      '1102012930=         :G_CLIENT_'
      '1102012931=        );'
      '1102012932='
      
        '1102012933=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102012934=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102012935=        PNT_ = '#39'02'#39';'
      '1102012936=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102012937=            UPDATE LT_SKLAD_PRODUCT L'
      '1102012938=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102012939=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102012940=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102012941=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102012942='
      '1102012943=            IF (ROW_COUNT = 0) THEN'
      
        '1102012944=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102012945=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102012946=        END'
      '1102012947=      END'
      '1102012948=  END'
      '1102012949='
      '1102012950=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102012951='
      
        '1102012952=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102012953=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102012954=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102012955=                                  G_PRIHOD_,'
      '1102012956=                                  :SUMM_PRIHOD_,'
      '1102012957=                                  :Z_DATE_,'
      
        '1102012958=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102012959=                                  :ZAKAZ_,'
      '1102012960=                                  NULL,'
      '1102012961=                                  :G_PAYMENT_TYPE_,'
      '1102012962=                                  :G_TOCHKA_,'
      '1102012963=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102012964=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102012965=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102012966=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102012967=      EXIT;'
      '1102012968=    END'
      '1102012969=  END'
      '1102012970='
      
        '1102012971=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102012972=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102012973=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102012974=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102012975='
      '1102012976=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102012977=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102012978='
      '1102012979=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102012980=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102012981=end'
      '1102012982=;'
      '1102012983='
      '1102012984=ALTER PROCEDURE K_DEL_KASSA('
      '1102012985=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      
        '1102012986=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102012987=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102012988=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102012989=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102012990=RETURNS ('
      '1102012991=  ERR_CODE INTEGER,'
      '1102012992=  ERR_MSG VARCHAR(1024))'
      '1102012993=AS'
      '1102012994=/*'
      
        '1102012995='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1102012996=*/'
      '1102012997=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1102012998=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102012999=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1102013000=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1102013001=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '1102013002=DECLARE VARIABLE ACTION_DATE_ DATE;'
      
        '1102013003=DECLARE VARIABLE ACTION_ TYPE OF COLUMN KASSA."ACTION' +
        '";'
      
        '1102013004=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102013005=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '1102013006=BEGIN'
      '1102013007=  PROCNAME = '#39'K_DEL_KASSA'#39';'
      '1102013008='
      
        '1102013009=  ---------------------------------------------------' +
        '-------------------'
      '1102013010=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1102013011=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMEN' +
        'T_TYPE_ = 1)) THEN BEGIN'
      '1102013012=      SELECT K.SUMM,'
      '1102013013=             K.ACTION_DATE,'
      '1102013014=             K."ACTION",'
      '1102013015=             K.G_TOCHKA'
      '1102013016=        FROM KASSA K'
      '1102013017=       WHERE K.KASSA = :KASSA_'
      
        '1102013018=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA' +
        '_;'
      '1102013019='
      
        '1102013020=      --*********************************************' +
        '****'
      '1102013021=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '1102013022=      --*********************************************' +
        '****'
      '1102013023=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1102013024=      PNT_ = '#39'02'#39';'
      '1102013025=      IF (:ACTION_ = 0) THEN'
      '1102013026=        CREDIT_ = SUMM_;'
      '1102013027=      ELSE'
      '1102013028=        DEBET_ = SUMM_;'
      '1102013029='
      '1102013030=      UPDATE KASSA_STATE K'
      '1102013031=         SET K.DEBET = K.DEBET - :DEBET_,'
      '1102013032=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '1102013033=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_)' +
        ' + (K.CREDIT - :CREDIT_),'
      '1102013034=             K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102013035=       WHERE K.K_DATE = :ACTION_DATE_'
      '1102013036=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '1102013037='
      
        '1102013038=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058 +
        #1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102013039=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1102013040=        SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '1102013041=                     '#39'SET K.DEBET = K.DEBET - '#39'||COAL' +
        'ESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '1102013042=                          '#39'K.CREDIT = K.CREDIT - '#39'||C' +
        'OALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '1102013043=                          '#39'K.OUTPUT = K.INPUT - (K.DE' +
        'BET - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CRE' +
        'DIT_, 0)||'#39') '#39'||'
      
        '1102013044=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DAT' +
        'E_||'#39#39#39' '#39'||'
      
        '1102013045=                     '#39'AND K.G_TOCHKA = '#39'||G_TOCHKA_||' +
        #39';'#39';'
      
        '1102013046=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSF' +
        'ERED, SYSDATE, ERR_CODE)'
      
        '1102013047=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYS' +
        'DBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013048=      END'
      '1102013049='
      
        '1102013050=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1102013051=      PNT_ = '#39'04'#39';'
      
        '1102013052=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_,' +
        ' :G_TOCHKA_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES(:ERR_CODE, :E' +
        'RR_MSG);'
      '1102013053=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013054=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102013055=        EXIT;'
      '1102013056=      END'
      '1102013057='
      '1102013058=      DELETE FROM KASSA'
      '1102013059=      WHERE KASSA = :KASSA_;'
      '1102013060=  END'
      
        '1102013061=  ---------------------------------------------------' +
        '-------------------'
      '1102013062=  --*************************************************'
      
        '1102013063=  ---------------------------------------------------' +
        '-------------------'
      
        '1102013064=  ---------------------------------------------------' +
        '-------------------'
      '1102013065=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '1102013066=  ELSE BEGIN'
      '1102013067=      SELECT K.SUMM,'
      '1102013068=             K.ACTION_DATE,'
      '1102013069=             K."ACTION",'
      '1102013070=             K.G_TOCHKA'
      '1102013071=        FROM KASSA_BEZNAL K'
      '1102013072=       WHERE K.KASSA_BEZNAL = :KASSA_'
      
        '1102013073=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA' +
        '_;'
      '1102013074='
      
        '1102013075=      --*********************************************' +
        '****'
      '1102013076=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '1102013077=      --*********************************************' +
        '****'
      '1102013078=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1102013079=      PNT_ = '#39'02'#39';'
      '1102013080=      IF (:ACTION_ = 0) THEN'
      '1102013081=        CREDIT_ = SUMM_;'
      '1102013082=      ELSE'
      '1102013083=        DEBET_ = SUMM_;'
      '1102013084='
      '1102013085=      UPDATE KASSA_BEZNAL_STATE K'
      '1102013086=         SET K.DEBET = K.DEBET - :DEBET_,'
      '1102013087=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '1102013088=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_)' +
        ' + (K.CREDIT - :CREDIT_)'
      '1102013089=       WHERE K.K_DATE = :ACTION_DATE_;'
      '1102013090='
      
        '1102013091=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058 +
        #1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102013092=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1102013093=        SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      
        '1102013094=                     '#39'SET K.DEBET = K.DEBET - '#39'||COAL' +
        'ESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '1102013095=                         '#39'K.CREDIT = K.CREDIT - '#39'||CO' +
        'ALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '1102013096=                         '#39'K.OUTPUT = K.INPUT - (K.DEB' +
        'ET - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CRED' +
        'IT_, 0)||'#39') '#39'||'
      
        '1102013097=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DAT' +
        'E_||'#39#39#39';'#39';'
      '1102013098='
      
        '1102013099=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSF' +
        'ERED, SYSDATE, ERR_CODE)'
      
        '1102013100=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYS' +
        'DBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013101=      END'
      '1102013102='
      
        '1102013103=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1102013104=      PNT_ = '#39'04'#39';'
      
        '1102013105=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION' +
        '_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1102013106=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013107=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102013108=        EXIT;'
      '1102013109=      END'
      '1102013110='
      '1102013111=      DELETE FROM KASSA_BEZNAL'
      '1102013112=      WHERE KASSA_BEZNAL = :KASSA_;'
      '1102013113=  END'
      
        '1102013114=  ---------------------------------------------------' +
        '-------------------'
      '1102013115=  --*************************************************'
      '1102013116='
      '1102013117=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      '1102013118=  IF (LOG_BODY_ IS NOT NULL) THEN'
      
        '1102013119=    EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :US' +
        'ER_ID_, :KASSA_, :ACTION_DATE_, 3, :SUMM_, :LOG_BODY_);'
      '1102013120='
      '1102013121=WHEN ANY DO'
      '1102013122=  begin'
      '1102013123=    IF (sqlcode = -530) THEN BEGIN'
      '1102013124=        ERR_CODE = -20500;'
      
        '1102013125=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072 +
        #1085#1085#1086#1081' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNIN' +
        'G_VALUES (:ERR_MSG);'
      
        '1102013126=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG' +
        ';'
      '1102013127=    END'
      '1102013128=    ELSE BEGIN'
      '1102013129=        ERR_CODE = sqlcode;'
      
        '1102013130=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073 +
        #1082#1072' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1079#1072#1087#1080#1089#1080' '#1080#1079' '#1082#1072#1089#1089#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102013131=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG' +
        ';'
      '1102013132=    END'
      '1102013133=  end'
      '1102013134=end'
      '1102013135=;'
      '1102013136='
      '1102013137=ALTER PROCEDURE K_INS_KASSA('
      '1102013138=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1102013139=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1102013140=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1102013141=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1102013142=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1102013143=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1102013144=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      
        '1102013145=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102013146=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102013147=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102013148=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL,'
      
        '1102013149=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102013150=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102013151=RETURNS ('
      '1102013152=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1102013153=  ERR_CODE INTEGER,'
      '1102013154=  ERR_MSG VARCHAR(1024))'
      '1102013155=AS'
      '1102013156=/*'
      
        '1102013157='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1102013158=*/'
      '1102013159=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1102013160=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102013161=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1102013162=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1102013163=BEGIN'
      '1102013164='
      '1102013165=  PROCNAME = '#39'K_INS_KASSA'#39';'
      '1102013166='
      '1102013167=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102013168=    SELECT ID'
      '1102013169=      FROM CUR_PARAMS'
      '1102013170=     WHERE CUR_PARAMS = 2'
      '1102013171=      INTO :G_TOCHKA_;'
      '1102013172='
      
        '1102013173=  ---------------------------------------------------' +
        '-------------------'
      '1102013174=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1102013175=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMEN' +
        'T_TYPE_ = 1)) THEN BEGIN'
      
        '1102013176=      insert into KASSA (KASSA, "ACTION", G_PRIHOD_RA' +
        'SHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, G_OFFICIA' +
        'L)'
      
        '1102013177=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIH' +
        'OD_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_' +
        'TOCHKA_, :G_OFFICIAL_)'
      '1102013178=      returning KASSA'
      '1102013179=      into :KASSA_;'
      '1102013180='
      '1102013181=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1102013182=      PNT_ = '#39'02'#39';'
      '1102013183=      IF (:ACTION_ = 0) THEN'
      '1102013184=        CREDIT_ = SUMM_;'
      '1102013185=      ELSE'
      '1102013186=        DEBET_ = SUMM_;'
      '1102013187='
      
        '1102013188=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DAT' +
        'E_, :G_TOCHKA_, :DEBET_, :CREDIT_, 1, :UPLOAD_TO_EXT_APP_) RETUR' +
        'NING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102013189=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102013190=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102013191=        EXIT;'
      '1102013192=      END'
      '1102013193='
      
        '1102013194=      -----------------------------------------------' +
        '-----------------------'
      
        '1102013195=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1102013196=      PNT_ = '#39'04'#39';'
      
        '1102013197=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_,' +
        ' :G_TOCHKA_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES(:ERR_CODE, :E' +
        'RR_MSG);'
      '1102013198=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013199=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102013200=        EXIT;'
      '1102013201=      END'
      '1102013202=  END'
      
        '1102013203=  ---------------------------------------------------' +
        '-------------------'
      
        '1102013204=  ---------------------------------------------------' +
        '-------------------'
      '1102013205=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1102013206=  ---------- '#1042' KASSA_BEZNAL_STATE '#1053#1045' '#1044#1045#1051#1040#1070' '#1056#1040#1047#1044#1045#1051#1045#1053#1048#1045 +
        ' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052', '#1042#1045#1044#1068' '#1056#1040#1057#1063#1045#1058#1053#1067#1049' '#1057#1063#1045#1058' '#1054#1041#1065#1048#1049
      '1102013207=  ELSE BEGIN'
      
        '1102013208=      insert into KASSA_BEZNAL (KASSA_BEZNAL, "ACTION' +
        '", G_PRIHOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOC' +
        'HKA, G_OFFICIAL)'
      
        '1102013209=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIH' +
        'OD_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_' +
        'TOCHKA_, :G_OFFICIAL_)'
      '1102013210=      returning KASSA_BEZNAL'
      '1102013211=      into :KASSA_;'
      '1102013212='
      '1102013213=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1102013214=      PNT_ = '#39'02A'#39';'
      '1102013215=      IF (:ACTION_ = 0) THEN'
      '1102013216=        CREDIT_ = SUMM_;'
      '1102013217=      ELSE'
      '1102013218=        DEBET_ = SUMM_;'
      '1102013219='
      
        '1102013220=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DAT' +
        'E_, :G_TOCHKA_, :DEBET_, :CREDIT_, 0) RETURNING_VALUES (:ERR_COD' +
        'E, :ERR_MSG);'
      '1102013221=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102013222=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102013223=        EXIT;'
      '1102013224=      END'
      '1102013225='
      
        '1102013226=      -----------------------------------------------' +
        '-----------------------'
      
        '1102013227=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1102013228=      PNT_ = '#39'04A'#39';'
      
        '1102013229=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION' +
        '_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1102013230=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013231=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102013232=        EXIT;'
      '1102013233=      END'
      '1102013234=  END'
      
        '1102013235=  ---------------------------------------------------' +
        '-------------------'
      
        '1102013236=  ---------------------------------------------------' +
        '-------------------'
      '1102013237=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      '1102013238=  IF (LOG_BODY_ IS NOT NULL) THEN'
      
        '1102013239=    EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :US' +
        'ER_ID_, :KASSA_, :ACTION_DATE_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1102013240=end'
      '1102013241=;'
      '1102013242='
      '1102013243=ALTER PROCEDURE K_PAY_DOLG('
      '1102013244=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1102013245=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1102013246=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1102013247=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1102013248=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1102013249=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1102013250=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      
        '1102013251=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102013252=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102013253=  ZAKAZ_ARR_ BLOB SUB_TYPE 1,'
      
        '1102013254=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102013255=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102013256=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102013257=RETURNS ('
      '1102013258=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1102013259=  ERR_CODE INTEGER,'
      '1102013260=  ERR_MSG VARCHAR(1024))'
      '1102013261=AS'
      '1102013262=/*'
      
        '1102013263=ZAKAZ_ARR_ - '#1052#1040#1057#1057#1048#1042' '#1055#1056#1054#1044#1040#1046', '#1055#1054' '#1050#1054#1058#1054#1056#1067#1052' '#1050#1051#1048#1045#1053#1058' '#1043#1040#1057#1048#1058' '#1044 +
        #1054#1051#1043#1048
      '1102013264='
      
        '1102013265='#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1055#1051#1040#1058#1040' '#1044#1054#1051#1043#1040' '#1048' '#1054#1058' '#1042#1053#1054#1057#1048#1052#1054#1049' '#1057#1059#1052#1052#1067' '#1063#1058#1054'-'#1058#1054' '#1054#1057#1058#1040 +
        #1051#1054#1057#1068', '#1047#1053#1040#1063#1048#1058' '#1063#1058#1054'-'#1058#1054' '#1053#1045' '#1058#1054','
      
        '1102013266='#1042#1054#1047#1052#1054#1046#1053#1054' '#1044#1056#1059#1043#1054#1049' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1046#1045' '#1054#1060#1054#1056#1052#1048#1051' '#1054#1055#1051#1040#1058#1059' '#1044#1054#1051#1043#1040 +
        ' '#1048' '#1042#1048#1047#1048#1058#1067' '#1054#1055#1051#1040#1063#1045#1053#1067', '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1051#1059#1063#1064#1045' '#1042#1067#1044#1040#1052' '#1054#1064#1048#1041#1050#1059
      
        '1102013267='#1055#1056#1048#1063#1045#1052' '#1069#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1063 +
        #1045#1056#1045#1047' '#1050#1040#1057#1057#1040' - '#1055#1056#1048#1061#1054#1044', '#1048#1051#1048' '#1055#1054' '#1050#1053#1054#1055#1050#1045' '#1042
      
        '1102013268='#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048'. '#1045#1057#1051#1048' '#1046#1045' '#1055#1054#1058#1054#1052' '#1069#1058#1054#1058' '#1055#1051#1040#1058#1045#1046' '#1056#1045#1044#1040#1050#1058#1048#1056 +
        #1059#1070#1058' '#1063#1045#1056#1045#1047' "'#1057#1055#1048#1057#1054#1050' '#1055#1051#1040#1058#1045#1046#1045#1049'" - '#1058#1054' '#1069#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      '1102013269=*/'
      '1102013270=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_PAY_DOLG'#39';'
      '1102013271=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102013272=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1102013273=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1102013274=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      
        '1102013275=DECLARE VARIABLE OSTATOK_ TYPE OF COLUMN ZAKAZ.SUMM_F' +
        'ACT;'
      
        '1102013276=DECLARE VARIABLE SUMM_TMP_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'FACT;'
      '1102013277=begin'
      '1102013278=  ERR_CODE = 0;'
      '1102013279=  ERR_MSG = '#39#39';'
      '1102013280='
      '1102013281=  PNT_ = '#39'00'#39';'
      '1102013282=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102013283=    SELECT ID'
      '1102013284=      FROM CUR_PARAMS'
      '1102013285=     WHERE CUR_PARAMS = 2'
      '1102013286=      INTO :G_TOCHKA_;'
      '1102013287='
      
        '1102013288=  -- '#1069#1058#1054' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1054#1055#1051#1040#1058#1040' '#1044#1054#1051#1043#1040' '#1050#1051#1048#1045#1053#1058#1054#1052', '#1040' '#1058#1040#1052' '#1052#1054#1046#1045 +
        #1058' '#1041#1067#1058#1068' '#1052#1040#1057#1057#1048#1042' '#1055#1056#1054#1044#1040#1046
      
        '1102013289=  -- '#1040' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1048' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071 +
        ' '#1057#1053#1054#1042#1040' '#1056#1045#1064#1040#1058#1068' '#1063#1045#1056#1045#1047' UNION'
      
        '1102013290=  -- '#1042' K_UPD_KASSA '#1053#1048#1063#1045#1043#1054' '#1058#1040#1050#1054#1043#1054' '#1044#1045#1051#1040#1058#1068' '#1053#1045' '#1041#1059#1044#1059', '#1055#1054#1058#1054 +
        #1052#1059' '#1063#1058#1054' '#1048#1047#1052#1045#1053#1048#1058#1068' '#1054#1055#1051#1040#1058#1059' '#1044#1054#1051#1043#1040' '#1041#1059#1044#1045#1058' '#1053#1045#1042#1054#1047#1052#1054#1046#1053#1054
      '1102013291=  -- '#1055#1059#1057#1058#1068' '#1059#1044#1040#1051#1071#1070#1058' '#1048' '#1047#1040#1053#1054#1042#1054' '#1047#1040#1042#1054#1044#1071#1058
      '1102013292=  SUMM_TMP_ = SUMM_;'
      '1102013293=  FOR SELECT Z.ZAKAZ,'
      
        '1102013294=             Z.SUMM - Z.SUMM_FACT - Z.SUMM_BONUS OSTA' +
        'TOK'
      '1102013295=        FROM ZAKAZ Z'
      '1102013296=       WHERE :ZAKAZ_ARR_ CONTAINING '#39'~'#39'||Z.ZAKAZ||'#39'~'#39
      '1102013297=         AND :G_PRIHOD_RASHOD_ = -5'
      '1102013298=         AND Z.IS_PAYED_ALL = 0'
      '1102013299=        INTO :ZAKAZ_,'
      '1102013300=             :OSTATOK_'
      '1102013301=  DO BEGIN'
      '1102013302=      IF (G_PRIHOD_RASHOD_ = -5) THEN BEGIN'
      '1102013303=        SUMM_ = MINVALUE(OSTATOK_, SUMM_TMP_);'
      '1102013304=        SUMM_TMP_ = SUMM_TMP_ - SUMM_;'
      '1102013305=      END'
      '1102013306='
      '1102013307=      EXECUTE PROCEDURE K_INS_KASSA(0,  --:ACTION_,'
      
        '1102013308=                                    -5, --:G_PRIHOD_R' +
        'ASHOD_,'
      '1102013309=                                    :SUMM_,'
      '1102013310=                                    :ACTION_DATE_,'
      '1102013311=                                    :NOTE_,'
      '1102013312=                                    :ZAKAZ_,'
      
        '1102013313=                                    NULL,   --:SKLAD_' +
        ','
      '1102013314=                                    :G_PAYMENT_TYPE_,'
      '1102013315=                                    :G_TOCHKA_,'
      
        '1102013316=                                    :UPLOAD_TO_EXT_AP' +
        'P_,'
      
        '1102013317=                                    NULL,  -- G_OFFIC' +
        'IAL_'
      '1102013318=                                    :USER_ID_,'
      
        '1102013319=                                    :LOG_BODY_) RETUR' +
        'NING_VALUES :KASSA_, :ERR_CODE, :ERR_MSG;'
      '1102013320='
      '1102013321=      UPDATE ZAKAZ Z'
      
        '1102013322=         SET Z.IS_PAYED_ALL = DECODE(:OSTATOK_, :SUMM' +
        '_, 1, 0),'
      
        '1102013323=             Z.SUMM_CASH    = DECODE(:G_PAYMENT_TYPE_' +
        ', 1, Z.SUMM_CASH + :SUMM_, Z.SUMM_CASH),'
      
        '1102013324=             Z.SUMM_NONCASH = DECODE(:G_PAYMENT_TYPE_' +
        ', 2, Z.SUMM_NONCASH + :SUMM_, Z.SUMM_NONCASH),'
      '1102013325=             Z.SUMM_FACT    = Z.SUMM_FACT + :SUMM_'
      '1102013326=       WHERE Z.ZAKAZ = :ZAKAZ_;'
      '1102013327='
      '1102013328=      IF (SUMM_TMP_ = 0) THEN'
      '1102013329=        BREAK;'
      '1102013330=  END'
      '1102013331='
      
        '1102013332=  IF (G_PRIHOD_RASHOD_ = -5 AND SUMM_TMP_ > 0) THEN B' +
        'EGIN'
      '1102013333=    ERR_CODE = -20500;'
      
        '1102013334=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057#1091#1084#1084#1072' '#1086#1087 +
        #1083#1072#1090#1099' '#1076#1086#1083#1075#1072' '#1086#1082#1072#1079#1072#1083#1072#1089#1100' '#1073#1086#1083#1100#1096#1077' '#1089#1091#1084#1084#1099' '#1074#1099#1073#1088#1072#1085#1085#1099#1093' '#1076#1086#1083#1075#1086#1074' '#1085#1072' '#39'||SUMM_TM' +
        'P_||'#39'. '#1042#1086#1079#1084#1086#1078#1085#1086' '#1086#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1073#1099#1083#1072' '#1091#1078#1077' '#39'||'
      
        '1102013335=    '#39#1086#1092#1086#1088#1084#1083#1077#1085#1072' '#1076#1088#1091#1075#1080#1084' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1084'!'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      
        '1102013336=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102013337=    EXIT;'
      '1102013338=  END'
      '1102013339=END'
      '1102013340=;'
      '1102013341='
      '1102013342=ALTER PROCEDURE K_RECALC_KASSA('
      '1102013343=  ACTION_DATE_ DATE,'
      '1102013344=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102013345=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102013346=RETURNS ('
      '1102013347=  ERR_CODE INTEGER,'
      '1102013348=  ERR_MSG VARCHAR(1024))'
      '1102013349=AS'
      
        '1102013350=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KAS' +
        'SA'#39';'
      '1102013351=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102013352=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '1102013353=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_STATE.K' +
        '_DATE;'
      '1102013354=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '1102013355=BEGIN'
      '1102013356='
      '1102013357=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102013358=    SELECT ID'
      '1102013359=      FROM CUR_PARAMS'
      '1102013360=     WHERE CUR_PARAMS = 2'
      '1102013361=      INTO :G_TOCHKA_;'
      '1102013362='
      
        '1102013363=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' ' +
        #1047#1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045 +
        #1043#1054#1044#1053#1071' 21.02.'
      
        '1102013364=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058 +
        #1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      '1102013365=  PNT_ = '#39'00'#39';'
      
        '1102013366=  IF ((SELECT COUNT(*) FROM KASSA_STATE K WHERE K.K_D' +
        'ATE = CURRENT_DATE AND G_TOCHKA = :G_TOCHKA_) = 0) THEN BEGIN'
      '1102013367=    INSERT INTO KASSA_STATE'
      
        '1102013368=      (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, OUT' +
        'PUT, G_TOCHKA, NEED_TO_EXPORT)'
      '1102013369=    VALUES'
      
        '1102013370=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0 , ' +
        '0, 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102013371='
      
        '1102013372=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102013373=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1102013374=      SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '1102013375=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DAT' +
        'E||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '1102013376=                 '#39' from RDB$DATABASE) cd '#39'||'
      
        '1102013377=                 '#39'ON (c.K_DATE = cd.K_DATE AND C.G_TO' +
        'CHKA = CD.G_TOCHKA) '#39'||'
      '1102013378=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '1102013379=                 '#39' INSERT (KASSA_STATE, K_DATE, "INPU' +
        'T", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '1102013380=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE,' +
        ' 0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0, '#39'||G_TOCHKA_||'#39');'#39';'
      
        '1102013381=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1102013382=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013383=    END'
      '1102013384=    */'
      '1102013385=  END'
      '1102013386='
      
        '1102013387=  ---------------------------------------------------' +
        '-------------------'
      
        '1102013388=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055 +
        #1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      
        '1102013389=  -- '#1040' '#1058#1040#1050#1046#1045' '#1053#1059#1046#1053#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1047#1040#1056#1055 +
        #1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040#1052', '#1058#1040#1052' '#1047#1040#1055#1048#1057#1068' '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040#1058#1054#1049
      '1102013390=  PNT_ = '#39'01'#39';'
      '1102013391=  IF (ACTION_DATE_ >= CURRENT_DATE) THEN BEGIN'
      '1102013392=    SELECT ST."OUTPUT",'
      '1102013393=           ST.K_DATE'
      '1102013394=      FROM KASSA_STATE ST'
      
        '1102013395=     WHERE ST.K_DATE < CURRENT_DATE   -- '#1047#1044#1045#1057#1068' '#1069#1058#1054' '#1057#1055 +
        #1045#1062#1048#1040#1051#1068#1053#1054' '#1057#1044#1045#1051#1040#1053#1054', '#1063#1058#1054#1041#1067' '#1055#1045#1056#1045#1041#1048#1042#1040#1051#1040#1057#1068' '#1048' '#1047#1040#1055#1048#1057#1068' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' '#1058#1054#1046#1045', '#1040 +
        ' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1057#1054#1047#1044#1040#1051#1040#1057#1068', '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040' '#1053#1045#1058
      '1102013396=       AND ST.G_TOCHKA = :G_TOCHKA_'
      '1102013397=     ORDER BY ST.K_DATE DESC'
      '1102013398=     ROWS 1'
      '1102013399=     INTO :OUTPUT_,'
      '1102013400=          :ACTION_DATE_;'
      '1102013401='
      '1102013402=    IF (OUTPUT_ IS NULL) THEN'
      '1102013403=      SELECT ST."OUTPUT",'
      '1102013404=             ST.K_DATE'
      '1102013405=        FROM KASSA_STATE ST'
      '1102013406=       WHERE ST.K_DATE = CURRENT_DATE'
      '1102013407=         AND ST.G_TOCHKA = :G_TOCHKA_'
      '1102013408=       ORDER BY ST.K_DATE DESC'
      '1102013409=       INTO :OUTPUT_,'
      '1102013410=            :ACTION_DATE_;'
      '1102013411='
      '1102013412=  END ELSE BEGIN'
      '1102013413=    SELECT K.OUTPUT'
      '1102013414=      FROM KASSA_STATE K'
      '1102013415=     WHERE K.K_DATE = :ACTION_DATE_'
      '1102013416=       AND K.G_TOCHKA = :G_TOCHKA_'
      '1102013417=      INTO :OUTPUT_;'
      '1102013418='
      
        '1102013419=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102013420=    -- '#1045#1057#1051#1048' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067' '#1048#1047#1052#1045#1053#1045#1053#1048#1045', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040' '#1044#1056#1059 +
        #1043#1054#1052' '#1050#1054#1052#1055#1045' '#1058#1054#1046#1045' '#1047#1040#1055#1059#1057#1050#1040#1058#1068' K_RECALC_KASSA'
      
        '1102013421=    -- '#1058#1045#1055#1045#1056#1068', '#1055#1056#1048' '#1050#1040#1046#1044#1054#1052' '#1048#1047#1052#1045#1053#1045#1053#1048#1048' '#1041#1059#1044#1045#1058' '#1042' LOG '#1055#1040#1044#1040#1058 +
        #1068' '#1057#1058#1056#1054#1050#1040' "EXECUTE K_RECALC_KASSA" - '#1069#1058#1054' '#1053#1045#1055#1056#1048#1045#1052#1051#1045#1052#1054','
      
        '1102013422=    -- '#1044#1056#1059#1043#1054#1049' '#1050#1054#1052#1055' '#1052#1054#1046#1045#1058' '#1053#1045' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1048#1053#1060#1059' '#1053#1045#1044#1045#1051#1071#1052#1048', '#1057 +
        #1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1053#1059#1046#1053#1054', '#1063#1058#1054#1041#1067' '#1041#1067#1051#1040' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' '#1048' '#1047#1040#1055#1059#1057#1050#1040#1051#1040#1057#1068 +
        ' '#1054#1053#1040
      '1102013423=    -- '#1042' '#1050#1054#1053#1062#1045' SYNC_DOWNLOAD '#1054#1044#1048#1053' '#1056#1040#1047'.'
      
        '1102013424=    -- '#1044#1051#1071' '#1069#1058#1054#1043#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1042' LOG "EX' +
        'ECUTE K_RECALC_KASSA" '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_TRANSFERED = 0 '#1048' '#1047#1040#1052#1045#1053#1071#1058#1068' '#1045 +
        #1045' '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054
      
        '1102013425=    -- '#1055#1054' '#1059#1052#1059' '#1053#1059#1046#1053#1054' '#1041#1067' '#1059#1044#1040#1051#1071#1058#1068' "EXECUTE K_RECALC_KASS' +
        'A" '#1057' '#1044#1040#1058#1054#1049' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1063#1058#1054#1041#1067' '#1053#1045' '#1041#1067#1051#1054' '#1044#1042#1054#1049#1053#1054#1043#1054' '#1055#1045#1056#1045#1057#1063#1045#1058#1040', '#1053#1054' ' +
        #1058#1040#1052' '#1058#1054#1043#1044#1040
      
        '1102013426=    -- '#1053#1059#1046#1053#1054' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1044#1040#1058#1067' '#1048' G_TOCHKA - '#1069#1058#1054' '#1042#1057#1045' '#1057#1051#1048 +
        #1064#1050#1054#1052' '#1057#1051#1054#1046#1053#1054
      
        '1102013427=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTE' +
        'M_SETUP = 5) > 0 AND (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT' +
        #39') IS NULL)) THEN BEGIN'
      
        '1102013428=      SQL_STMT_ = '#39'EXECUTE BLOCK AS DECLARE VARIABLE ' +
        'ERR_CODE INTEGER;DECLARE VARIABLE ERR_MSG VARCHAR(1024); BEGIN '#39 +
        '||'
      
        '1102013429=        '#39' EXECUTE PROCEDURE K_RECALC_KASSA('#39#39#39'||:ACTI' +
        'ON_DATE_||'#39#39#39', '#39'||:G_TOCHKA_||'#39', '#39'||:UPLOAD_TO_EXT_APP_||'#39') RETU' +
        'RNING_VALUES :ERR_CODE, :ERR_MSG; END'#39';'
      '1102013430='
      
        '1102013431=      -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1059#1044#1040#1051#1071#1070', '#1045#1057#1051#1048' '#1059#1046#1045' '#1041#1067#1051#1040' '#1054#1058#1055#1056#1040#1042#1050 +
        #1040' '#1055#1045#1056#1045#1057#1063#1045#1058#1040' '#1047#1040' '#1069#1058#1059' '#1044#1040#1058#1059
      '1102013432=      DELETE FROM LOGS'
      '1102013433=      WHERE SQLSTMT = :SQL_STMT_'
      '1102013434=        AND IS_TRANSFERED = 0'
      '1102013435=        AND USR = '#39'SYSDBA'#39';'
      '1102013436='
      
        '1102013437=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1102013438=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013439=    END'
      '1102013440=  END'
      '1102013441='
      '1102013442=  PNT_ = '#39'02'#39';'
      '1102013443=  FOR SELECT K.K_DATE'
      '1102013444=        FROM KASSA_STATE K'
      '1102013445=       WHERE K.K_DATE > :ACTION_DATE_'
      '1102013446=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102013447=      ORDER BY K.K_DATE, K.KASSA_STATE'
      '1102013448=        INTO :K_DATE_'
      '1102013449=  DO BEGIN'
      '1102013450=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1102013451=    UPDATE KASSA_STATE K'
      '1102013452=       SET K.INPUT = :OUTPUT_,'
      
        '1102013453=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESC' +
        'E(K.DEBET, 0) + COALESCE(K.CREDIT, 0),'
      '1102013454=           K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102013455=     WHERE K.K_DATE = :K_DATE_'
      '1102013456=       AND K.G_TOCHKA = :G_TOCHKA_;'
      '1102013457='
      
        '1102013458=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102013459=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1102013460=      SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '1102013461=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'|' +
        '|'
      
        '1102013462=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_,' +
        ' 0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '1102013463=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39 +
        #39'||'
      
        '1102013464=                 '#39'  AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';' +
        #39';'
      
        '1102013465=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1102013466=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013467=    END'
      '1102013468=    */'
      '1102013469='
      '1102013470=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1102013471=    SELECT K.OUTPUT'
      '1102013472=      FROM KASSA_STATE K'
      '1102013473=     WHERE K.K_DATE = :K_DATE_'
      '1102013474=       AND K.G_TOCHKA = :G_TOCHKA_'
      '1102013475=      INTO :OUTPUT_;'
      '1102013476=  END'
      '1102013477='
      '1102013478=WHEN ANY DO BEGIN'
      '1102013479=    Err_code = -20500;'
      
        '1102013480=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102013481=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102013482=  END'
      '1102013483=end'
      '1102013484=;'
      '1102013485='
      '1102013486=ALTER PROCEDURE K_RECALC_KASSA_BEZNAL('
      '1102013487=  ACTION_DATE_ DATE)'
      '1102013488=RETURNS ('
      '1102013489=  ERR_CODE INTEGER,'
      '1102013490=  ERR_MSG VARCHAR(1024))'
      '1102013491=AS'
      
        '1102013492=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KAS' +
        'SA_BEZNAL'#39';'
      '1102013493=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102013494=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '1102013495=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_BEZNAL_' +
        'STATE.K_DATE;'
      '1102013496=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '1102013497=BEGIN'
      '1102013498='
      
        '1102013499=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' ' +
        #1047#1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045 +
        #1043#1054#1044#1053#1071' 21.02.'
      
        '1102013500=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058 +
        #1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      
        '1102013501=  -- '#1052#1054#1046#1053#1054' '#1042#1045#1047#1044#1045' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' 0, '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1044#1040#1051#1068#1064#1045' '#1054#1053#1054' '#1041#1059 +
        #1044#1045#1058' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1053#1054
      '1102013502=  PNT_ = '#39'00'#39';'
      
        '1102013503=  IF ((SELECT COUNT(*) FROM KASSA_BEZNAL_STATE K WHER' +
        'E K.K_DATE = CURRENT_DATE) = 0) THEN BEGIN'
      '1102013504=    INSERT INTO KASSA_BEZNAL_STATE'
      
        '1102013505=      (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CRED' +
        'IT, OUTPUT)'
      '1102013506=    VALUES'
      
        '1102013507=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0, 0' +
        ', 0, 0);'
      '1102013508='
      
        '1102013509=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102013510=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1102013511=      SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE c '#39'||'
      
        '1102013512=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DAT' +
        'E||'#39#39#39' AS DATE) as K_DATE '#39'||'
      '1102013513=                 '#39' from RDB$DATABASE) cd '#39'||'
      '1102013514=                 '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '1102013515=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '1102013516=                 '#39' INSERT (KASSA_BEZNAL_STATE, K_DATE' +
        ', "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
        '1102013517=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE,' +
        ' 0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0);'#39';'
      
        '1102013518=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1102013519=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013520=    END'
      '1102013521=    */'
      '1102013522=  END'
      '1102013523='
      
        '1102013524=  ---------------------------------------------------' +
        '-------------------'
      
        '1102013525=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055 +
        #1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1102013526=  PNT_ = '#39'01'#39';'
      '1102013527=  SELECT K.OUTPUT'
      '1102013528=    FROM KASSA_BEZNAL_STATE K'
      '1102013529=   WHERE K.K_DATE = :ACTION_DATE_'
      '1102013530=    INTO :OUTPUT_;'
      '1102013531='
      
        '1102013532=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '1102013533=  -- '#1045#1057#1051#1048' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067' '#1048#1047#1052#1045#1053#1045#1053#1048#1045', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040' '#1044#1056#1059#1043#1054 +
        #1052' '#1050#1054#1052#1055#1045' '#1058#1054#1046#1045' '#1047#1040#1055#1059#1057#1050#1040#1058#1068' K_RECALC_KASSA'
      
        '1102013534=  -- '#1058#1045#1055#1045#1056#1068', '#1055#1056#1048' '#1050#1040#1046#1044#1054#1052' '#1048#1047#1052#1045#1053#1045#1053#1048#1048' '#1041#1059#1044#1045#1058' '#1042' LOG '#1055#1040#1044#1040#1058#1068' ' +
        #1057#1058#1056#1054#1050#1040' "EXECUTE K_RECALC_KASSA" - '#1069#1058#1054' '#1053#1045#1055#1056#1048#1045#1052#1051#1045#1052#1054','
      
        '1102013535=  -- '#1044#1056#1059#1043#1054#1049' '#1050#1054#1052#1055' '#1052#1054#1046#1045#1058' '#1053#1045' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1048#1053#1060#1059' '#1053#1045#1044#1045#1051#1071#1052#1048', '#1057#1054#1054 +
        #1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1053#1059#1046#1053#1054', '#1063#1058#1054#1041#1067' '#1041#1067#1051#1040' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' '#1048' '#1047#1040#1055#1059#1057#1050#1040#1051#1040#1057#1068' '#1054 +
        #1053#1040
      '1102013536=  -- '#1042' '#1050#1054#1053#1062#1045' SYNC_DOWNLOAD '#1054#1044#1048#1053' '#1056#1040#1047'.'
      
        '1102013537=  -- '#1044#1051#1071' '#1069#1058#1054#1043#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1042' LOG "EXEC' +
        'UTE K_RECALC_KASSA" '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_TRANSFERED = 0 '#1048' '#1047#1040#1052#1045#1053#1071#1058#1068' '#1045#1045' ' +
        #1045#1057#1051#1048' '#1053#1059#1046#1053#1054
      
        '1102013538=  -- '#1055#1054' '#1059#1052#1059' '#1053#1059#1046#1053#1054' '#1041#1067' '#1059#1044#1040#1051#1071#1058#1068' "EXECUTE K_RECALC_KASSA"' +
        ' '#1057' '#1044#1040#1058#1054#1049' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1063#1058#1054#1041#1067' '#1053#1045' '#1041#1067#1051#1054' '#1044#1042#1054#1049#1053#1054#1043#1054' '#1055#1045#1056#1045#1057#1063#1045#1058#1040', '#1053#1054' '#1058#1040 +
        #1052' '#1058#1054#1043#1044#1040
      
        '1102013539=  -- '#1053#1059#1046#1053#1054' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1044#1040#1058#1067' '#1048' G_TOCHKA - '#1069#1058#1054' '#1042#1057#1045' '#1057#1051#1048#1064#1050 +
        #1054#1052' '#1057#1051#1054#1046#1053#1054
      
        '1102013540=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0 AND (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39')' +
        ' IS NULL)) THEN BEGIN'
      
        '1102013541=    SQL_STMT_ = '#39'EXECUTE BLOCK AS DECLARE VARIABLE ER' +
        'R_CODE INTEGER;DECLARE VARIABLE ERR_MSG VARCHAR(1024); BEGIN '#39'||'
      
        '1102013542=      '#39' EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL('#39#39#39'||' +
        ':ACTION_DATE_||'#39#39#39') RETURNING_VALUES :ERR_CODE, :ERR_MSG; END'#39';'
      '1102013543='
      
        '1102013544=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1059#1044#1040#1051#1071#1070', '#1045#1057#1051#1048' '#1059#1046#1045' '#1041#1067#1051#1040' '#1054#1058#1055#1056#1040#1042#1050#1040' ' +
        #1055#1045#1056#1045#1057#1063#1045#1058#1040' '#1047#1040' '#1069#1058#1059' '#1044#1040#1058#1059
      '1102013545=    DELETE FROM LOGS'
      '1102013546=      WHERE SQLSTMT = :SQL_STMT_'
      '1102013547=        AND IS_TRANSFERED = 0'
      '1102013548=        AND USR = '#39'SYSDBA'#39';'
      '1102013549='
      
        '1102013550=    INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERED' +
        ', SYSDATE, ERR_CODE)'
      
        '1102013551=    VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA'#39 +
        ', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013552=  END'
      '1102013553='
      '1102013554=  PNT_ = '#39'02'#39';'
      '1102013555=  FOR SELECT K.K_DATE'
      '1102013556=        FROM KASSA_BEZNAL_STATE K'
      '1102013557=       WHERE K.K_DATE > :ACTION_DATE_'
      '1102013558=      ORDER BY K.K_DATE, K.KASSA_BEZNAL_STATE'
      '1102013559=        INTO :K_DATE_'
      '1102013560=  DO BEGIN'
      '1102013561=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1102013562=    UPDATE KASSA_BEZNAL_STATE K'
      '1102013563=       SET K.INPUT = :OUTPUT_,'
      
        '1102013564=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESC' +
        'E(K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '1102013565=     WHERE K.K_DATE = :K_DATE_;'
      '1102013566='
      
        '1102013567=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' ' +
        #1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102013568=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1102013569=      SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      
        '1102013570=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'|' +
        '|'
      
        '1102013571=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_,' +
        ' 0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '1102013572=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39 +
        ';'#39';'
      
        '1102013573=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1102013574=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDB' +
        'A'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102013575=    END'
      '1102013576=    */'
      '1102013577='
      '1102013578=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1102013579=    SELECT K.OUTPUT'
      '1102013580=      FROM KASSA_BEZNAL_STATE K'
      '1102013581=     WHERE K.K_DATE = :K_DATE_'
      '1102013582=      INTO :OUTPUT_;'
      '1102013583=  END'
      '1102013584='
      '1102013585=WHEN ANY DO BEGIN'
      '1102013586=    Err_code = -20500;'
      
        '1102013587=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102013588=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102013589=  END'
      '1102013590=end'
      '1102013591=;'
      '1102013592='
      '1102013593=ALTER PROCEDURE K_UPD_KASSA('
      '1102013594=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1102013595=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1102013596=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1102013597=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1102013598=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1102013599=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1102013600=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1102013601=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      
        '1102013602=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102013603=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102013604=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL,'
      
        '1102013605=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102013606=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102013607=RETURNS ('
      '1102013608=  ERR_CODE INTEGER,'
      '1102013609=  ERR_MSG VARCHAR(1024))'
      '1102013610=AS'
      '1102013611=/*'
      
        '1102013612='#1050#1054#1056#1054#1063#1045' '#1063#1058#1054#1041#1067' '#1053#1045' '#1055#1040#1056#1048#1058#1068#1057#1071' '#1057' '#1058#1071#1046#1045#1051#1067#1052' '#1040#1051#1043#1054#1056#1048#1058#1052#1054#1052' '#1048' '#1053#1040#1042#1054#1056 +
