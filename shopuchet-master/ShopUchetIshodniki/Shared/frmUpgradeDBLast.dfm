        '1102201527=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102201528=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102201529=                                          :G_TOCHKA_,'
      
        '1102201530=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102201531=                                         ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102201532=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201533=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102201534=              EXIT;'
      '1102201535=            END'
      '1102201536=        END'
      '1102201537=  END'
      '1102201538='
      
        '1102201539=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102201540=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0,1' +
        ')) THEN'
      
        '1102201541=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      
        '1102201542=    SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PAR' +
        'ENT_, 2, CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END'
      '1102201543=      FROM RDB$DATABASE'
      
        '1102201544=     WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP ' +
        'WHERE AP.OBJECT_TYPE = 2 AND AP.ID = :SKLAD_PARENT_ AND AP.IS_LO' +
        'ADING = 0);'
      '1102201545='
      '1102201546=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102201547=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_PARENT_, :DATE_RECEIPT_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1102201548=end'
      '1102201549=;'
      '1102201550='
      '1102201551='
      
        '1102201552=/****************************************************' +
        '**************************/'
      
        '1102201553=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102201554=/****************************************************' +
        '**************************/'
      '1102201555=ALTER PROCEDURE DO_PRODUCT('
      '1102201556=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102201557=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1102201558=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102201559=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102201560=  NOTE_ TYPE OF COLUMN OTHER.NOTE,'
      
        '1102201561=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102201562=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102201563=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102201564=RETURNS ('
      '1102201565=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1102201566=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1102201567=  ERR_CODE INTEGER,'
      '1102201568=  ERR_MSG VARCHAR(1024))'
      '1102201569=AS'
      '1102201570=/*'
      
        '1102201571='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1102201572='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1102201573=*/'
      
        '1102201574=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1102201575=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102201576=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1102201577=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1102201578=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1102201579=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1102201580=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1102201581=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1102201582=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1102201583=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '1102201584=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102201585=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102201586=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1102201587=DECLARE VARIABLE POS_ INTEGER;'
      '1102201588=DECLARE VARIABLE STR_ VARCHAR(300);'
      '1102201589=BEGIN'
      '1102201590=  PNT_ = '#39'00'#39';'
      '1102201591=  COST_PRICE_ = 0;'
      '1102201592='
      '1102201593=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102201594=    SELECT ID'
      '1102201595=      FROM CUR_PARAMS'
      '1102201596=     WHERE CUR_PARAMS = 2'
      '1102201597=      INTO :G_TOCHKA_;'
      '1102201598='
      '1102201599=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1102201600=  SELECT P.S_VALUE'
      '1102201601=    FROM SYSTEM_SETUP P'
      '1102201602=   WHERE P.SYSTEM_SETUP = 2'
      '1102201603=    INTO :CAN_SELL_;'
      '1102201604='
      '1102201605=  IF (LOG_BODY_ IS NOT NULL) THEN'
      '1102201606=    LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM 3);'
      '1102201607='
      '1102201608=  FOR SELECT :G_PRODUCT_IN_,'
      '1102201609=             :AMOUNT_IN_'
      '1102201610=        FROM RDB$DATABASE'
      '1102201611=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '1102201612=      UNION ALL'
      '1102201613=      SELECT G_PRODUCT,'
      '1102201614=             AMOUNT'
      '1102201615=        FROM ZAKAZ_DETAILS_TMP'
      '1102201616=       WHERE :G_PRODUCT_IN_ IS NULL'
      '1102201617=        INTO :G_PRODUCT_,'
      '1102201618=             :AMOUNT_'
      '1102201619=  DO BEGIN'
      '1102201620=      SELECT MAX(G.NAME)'
      '1102201621=        FROM G_PRODUCT G,'
      '1102201622=             G_PRODUCT_KIT K'
      '1102201623=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1102201624=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1102201625=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_' +
        'PRODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TO' +
        'CHKA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1102201626=        INTO :NAME_;'
      '1102201627='
      
        '1102201628=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN B' +
        'EGIN'
      '1102201629=        ERR_CODE = -20500;'
      
        '1102201630=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087 +
        #1088#1086#1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102201631=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102201632=        EXIT;'
      '1102201633=      END'
      '1102201634='
      '1102201635=      PNT_ = '#39'01'#39';'
      
        '1102201636=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TIME, OP_' +
        'TYPE, ARRIVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '1102201637=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_,' +
        ' CURRENT_TIME, 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '1102201638=      RETURNING OTHER'
      '1102201639=      INTO :OTHER_;'
      '1102201640='
      '1102201641=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1102201642=      COST_PRICE_ = 0;'
      '1102201643=      FOR SELECT K.G_PRODUCT_ITEM'
      '1102201644=                ,K.AMOUNT*:AMOUNT_'
      '1102201645=                ,K.amount'
      '1102201646=                ,G.G_PRODUCT'
      '1102201647=            FROM G_PRODUCT_KIT K'
      '1102201648=                ,G_PRODUCT G'
      '1102201649=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1102201650=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1102201651=            INTO :ITEM_'
      '1102201652=                ,:AMOUNT_NEED_'
      '1102201653=                ,:AMOUNT_NEED_ONE_'
      '1102201654=                ,:G_PRODUCT_KIT_'
      '1102201655=      DO BEGIN'
      
        '1102201656=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_KIT_, NULL, 1)'
      '1102201657=          RETURNING_VALUES :SELF_PRICE_;'
      '1102201658='
      '1102201659=        UPDATE LT_SKLAD_PRODUCT L'
      '1102201660=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_,'
      '1102201661=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102201662=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1102201663=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102201664='
      '1102201665=        IF (ROW_COUNT = 0) THEN'
      
        '1102201666=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :' +
        'G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102201667='
      
        '1102201668=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTH' +
        'ER, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1102201669=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_' +
        ', :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1102201670='
      
        '1102201671=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*' +
        'SELF_PRICE_;'
      '1102201672=      END'
      '1102201673='
      
        '1102201674=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1102201675=      PNT_ = '#39'02'#39';'
      
        '1102201676=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102201677=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1102201678='
      '1102201679=      SUMM_ = AMOUNT_*COST_PRICE_;'
      '1102201680='
      '1102201681=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102201682=                              :DATE_,'
      '1102201683=                              CURRENT_TIME,'
      '1102201684=                              NULL, --:G_CLIENT__,'
      
        '1102201685=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1102201686=                              NULL, --:OSNOVANIE__,'
      '1102201687=                              :NOTE_,'
      '1102201688=                              4, --:IS_VOZVRAT_,'
      '1102201689=                              :SUMM_,'
      '1102201690=                              :SUMM_,'
      '1102201691=                              0, --:G_PRIHOD_,'
      '1102201692=                              0 --:SUMM_PRIHOD_)'
      '1102201693=                              ,NULL     --PAYMENTS_'
      
        '1102201694=                              ,0        --SUMM_CURREN' +
        'CY_'
      
        '1102201695=                              ,0        --IS_EXPECTED' +
        '_'
      '1102201696=                              ,:UPLOAD_TO_EXT_APP_'
      
        '1102201697=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102201698=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201699=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102201700=          EXIT;'
      '1102201701=      END'
      '1102201702='
      '1102201703=      UPDATE OTHER O'
      '1102201704=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1102201705=      WHERE O.OTHER = :OTHER_;'
      '1102201706='
      '1102201707=      -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102201708=      -- '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1042' '#1058#1040#1050#1054#1052' '#1042#1048#1044#1045' "~*'#1041#1051#1040'-'#1041#1051 +
        #1040' '#1058#1040#1050#1054#1049'-'#1058#1054' '#1058#1054#1042#1040#1056'~*'#1041#1051#1040'-'#1041#1051#1040' '#1042#1058#1054#1056#1054#1049' '#1058#1054#1042#1040#1056'~*"'
      
        '1102201709=      -- '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1042#1067#1056#1045#1047#1040#1058#1068'. '#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1058#1040#1050' '#1044#1045#1051#1040#1058#1068 +
        ' '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1040' '#1058#1059#1058' '#1057#1054#1047#1044#1040#1045#1058#1057#1071
      '1102201710=      -- '#1056#1040#1047#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048'-'#1047#1040#1055#1048#1057#1071#1052#1048
      '1102201711=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1102201712=        POS_ = POSITION('#39'~*'#39' IN LOG_BODY_);'
      
        '1102201713=        IF (CHAR_LENGTH(LOG_BODY_) <> (POS_ + 1)) THE' +
        'N'
      
        '1102201714=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR POS_ ' +
        '- 1);'
      '1102201715=        ELSE'
      
        '1102201716=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR CHAR_' +
        'LENGTH(LOG_BODY_) - 3);'
      '1102201717='
      '1102201718=        --ERR_CODE = -20500;'
      '1102201719=        --ERR_MSG = STR_; EXIT;'
      '1102201720='
      
        '1102201721=        EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, ' +
        ':OTHER_, :DATE_, 1, :SUMM_, :STR_, 1);'
      '1102201722='
      
        '1102201723=        LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM (POSIT' +
        'ION('#39'~*'#39' IN LOG_BODY_)) + 2);'
      '1102201724=      END'
      '1102201725=  END'
      '1102201726=END'
      '1102201727=;'
      '1102201728='
      '1102201729=ALTER PROCEDURE P_REP_ZAYAVKA_POSTAVSHIK('
      '1102201730=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102201731=  BEGIN_DATE_ DATE,'
      '1102201732=  END_DATE_ DATE,'
      '1102201733=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102201734=  DO_SKLAD_ INTEGER,'
      '1102201735=  MODE_ INTEGER,'
      '1102201736=  MODE_VYBOR_ INTEGER,'
      '1102201737=  MODE_VAL_ INTEGER,'
      '1102201738=  NEW_VAL_ MY_NUMERIC_5,'
      '1102201739=  ROUND_MODE_ INTEGER)'
      '1102201740=RETURNS ('
      '1102201741=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102201742=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '1102201743=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102201744=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102201745=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1102201746=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1102201747=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1102201748=  ERR_CODE INTEGER,'
      '1102201749=  ERR_MSG VARCHAR(1024))'
      '1102201750=AS'
      '1102201751=/*'
      
        '1102201752='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057 +
        #1056#1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '1102201753='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055 +
        #1054#1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '1102201754=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055 +
        #1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '1102201755=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 -' +
        ' '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '1102201756=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058 +
        #1054#1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045 +
        ' '#1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102201757=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '1102201758=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067 +
        #1042#1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      
        '1102201759=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' *' +
        '/'
      '1102201760=DECLARE VARIABLE ROUND_ INTEGER;'
      '1102201761=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '1102201762=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      
        '1102201763=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PA' +
        'RENT;'
      '1102201764=BEGIN'
      '1102201765=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102201766='
      '1102201767=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102201768=    SELECT ID'
      '1102201769=      FROM CUR_PARAMS'
      '1102201770=     WHERE CUR_PARAMS = 2'
      '1102201771=      INTO :G_TOCHKA_;'
      '1102201772='
      '1102201773=  IF (ROUND_MODE_ = 0) THEN'
      '1102201774=      ROUND_ = 0;'
      '1102201775=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '1102201776=      ROUND_ = -1;'
      '1102201777=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '1102201778=      ROUND_ = -2;'
      '1102201779=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '1102201780=      ROUND_ = -3;'
      '1102201781=  ELSE IF (ROUND_MODE_ = -1) THEN'
      '1102201782=      ROUND_ = 5;'
      '1102201783='
      
        '1102201784=  SQL_STR_ = '#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39';'
      '1102201785='
      
        '1102201786=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040 +
        ' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102201787=  IF (MODE_ = 0) THEN BEGIN'
      
        '1102201788=    SQL_STR_ = SQL_STR_ || '#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39';'
      '1102201789=    IF (MODE_VAL_ = 0) THEN'
      '1102201790=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1102201791=    ELSE'
      
        '1102201792=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1102201793='
      '1102201794=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1102201795=  END'
      '1102201796=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '1102201797=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '1102201798=    SQL_STR_ = SQL_STR_ || '#39'ROUND(ABS(LT.AMOUNT)'#39';'
      '1102201799=    IF (MODE_VAL_ = 0) THEN'
      '1102201800=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1102201801=    ELSE'
      
        '1102201802=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1102201803='
      '1102201804=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1102201805=  END'
      '1102201806='
      
        '1102201807=  SQL_STR_ = SQL_STR_ || '#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39'||'
      
        '1102201808=            '#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39';'
      '1102201809='
      '1102201810=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '1102201811=    SQL_STR_ = SQL_STR_ ||'#39'AND EXISTS (SELECT 1'#39'||'
      
        '1102201812=                                        '#39' FROM SKLAD ' +
        'S'#39'||'
      
        '1102201813=                                        '#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39'||'
      
        '1102201814=                                        '#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39'||'
      
        '1102201815=                                        '#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39';'
      '1102201816=    IF (MODE_VYBOR_ = 2) THEN'
      
        '1102201817=      SQL_STR_ = SQL_STR_ ||'#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39';'
      '1102201818=    ELSE'
      
        '1102201819=      SQL_STR_ = SQL_STR_ ||'#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053 +
        #1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042#1057 +
        #1045#1043#1044#1040
      '1102201820=    SQL_STR_ = SQL_STR_ ||'#39') '#39';'
      '1102201821=  END ELSE BEGIN'
      
        '1102201822=    SQL_STR_ = SQL_STR_ ||'#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39';  --' +
        ' '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '1102201823=  END'
      '1102201824='
      '1102201825=  IF (MODE_ = 0) THEN'
      
        '1102201826=    SQL_STR_ = SQL_STR_ || '#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39';'
      '1102201827=  ELSE IF (MODE_ = 1) THEN'
      '1102201828=    SQL_STR_ = SQL_STR_ || '#39' AND LT.AMOUNT < 0'#39';'
      
        '1102201829=  SQL_STR_ = SQL_STR_ || '#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39';'
      '1102201830='
      '1102201831=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '1102201832=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '1102201833=      FOR EXECUTE STATEMENT'
      
        '1102201834=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1102201835=          INTO :G_PRODUCT,'
      '1102201836=               :CATEGORY_NAME,'
      '1102201837=               :NAME,'
      '1102201838=               :ARTICUL,'
      '1102201839=               :AMOUNT_CUR,'
      '1102201840=               :MIN_AMOUNT,'
      '1102201841=               :AMOUNT_TO_ZAKAZ'
      '1102201842=        DO BEGIN'
      
        '1102201843=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_' +
        'PRODUCT, :G_TOCHKA_, 0)'
      '1102201844=              RETURNING_VALUES :COST_PRICE_;'
      '1102201845='
      
        '1102201846=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, ' +
        'AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102201847=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_' +
        'PRODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO' +
        '_ZAKAZ, 0, 0);'
      '1102201848=        END'
      '1102201849='
      '1102201850=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102201851=                                      CURRENT_DATE,'
      '1102201852=                                      CURRENT_TIME,'
      '1102201853=                                      :G_CLIENT_,'
      '1102201854=                                      1,'
      
        '1102201855=                                      NULL, --:OSNOVA' +
        'NIE__,'
      
        '1102201856=                                      NULL, --:NOTE__' +
        ','
      
        '1102201857=                                      0, --:IS_VOZVRA' +
        'T_,'
      
        '1102201858=                                      (SELECT SUM(S.S' +
        'UMM) FROM SKLAD_TMP S),'
      
        '1102201859=                                      0, -- :SUMM_FAC' +
        'T_'
      
        '1102201860=                                      0, --:G_PRIHOD_' +
        ','
      
        '1102201861=                                      0 --:SUMM_PRIHO' +
        'D_)'
      
        '1102201862=                                      ,NULL --PAYMENT' +
        'S'
      
        '1102201863=                                     )RETURNING_VALUE' +
        'S :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102201864=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102201865=          ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39'||ERR_MSG;'
      '1102201866=          EXIT;'
      '1102201867=        END'
      '1102201868=  END'
      '1102201869=  ELSE BEGIN'
      '1102201870=      FOR EXECUTE STATEMENT'
      
        '1102201871=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1102201872=      INTO :G_PRODUCT,'
      '1102201873=           :CATEGORY_NAME,'
      '1102201874=           :NAME,'
      '1102201875=           :ARTICUL,'
      '1102201876=           :AMOUNT_CUR,'
      '1102201877=           :MIN_AMOUNT,'
      '1102201878=           :AMOUNT_TO_ZAKAZ'
      '1102201879=      DO SUSPEND;'
      '1102201880=  END'
      '1102201881=END'
      '1102201882=;'
      '1102201883='
      '1102201884=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1102201885=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102201886=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102201887=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102201888=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102201889=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102201890=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102201891=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102201892=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102201893=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102201894=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102201895=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102201896=RETURNS ('
      '1102201897=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102201898=  ERR_CODE INTEGER,'
      '1102201899=  ERR_MSG VARCHAR(1024))'
      '1102201900=AS'
      
        '1102201901=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1102201902=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1102201903=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102201904=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1102201905='
      
        '1102201906=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102201907=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1102201908=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1102201909=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102201910=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102201911=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102201912=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1102201913=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1102201914=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1102201915=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1102201916=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102201917=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1102201918=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1102201919=BEGIN'
      '1102201920='
      '1102201921=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102201922=    SELECT ID'
      '1102201923=      FROM CUR_PARAMS'
      '1102201924=     WHERE CUR_PARAMS = 2'
      '1102201925=      INTO :G_TOCHKA_;'
      '1102201926='
      
        '1102201927=  --*************************************************' +
        '*************************************************'
      
        '1102201928=  --*************************************************' +
        '*************************************************'
      '1102201929=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102201930=  --*************************************************' +
        '*************************************************'
      
        '1102201931=  --*************************************************' +
        '*************************************************'
      '1102201932=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1102201933=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1102201934=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1102201935=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102201936=            INTO :AMOUNT_,'
      '1102201937=                 :G_PRODUCT_'
      '1102201938=      DO BEGIN'
      '1102201939=          UPDATE LT_SKLAD_PRODUCT L'
      
        '1102201940=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_      ' +
        '-- 03.03.2021 '#1057#1070#1044#1040' '#1053#1045' '#1057#1058#1040#1051' '#1057#1058#1040#1042#1048#1058#1068' NEED_TO_REPLACE '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1047#1040 +
        #1063#1045#1052
      '1102201941=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102201942=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102201943=      END'
      '1102201944='
      '1102201945=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1102201946=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1102201947=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1102201948=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1102201949=             NDS_SUMM, COST_PRICE'
      '1102201950=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102201951='
      '1102201952=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102201953=                                  :Z_DATE_,'
      '1102201954=                                  :Z_TIME_,'
      '1102201955=                                  :G_CLIENT_,'
      '1102201956=                                  :G_PAYMENT_TYPE_,'
      '1102201957=                                  :OSNOVANIE_,'
      
        '1102201958=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1102201959=                                  :NOTE_,'
      
        '1102201960=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1102201961=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1102201962=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1102201963=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1102201964=                                  0, --SUMM_BONUS_'
      
        '1102201965=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1102201966=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102201967=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1102201968=                                  0,    --BY_RECIPE'
      '1102201969=                                  0     --IS_RESERVE'
      '1102201970=                                  ,NULL  -- PAYMENTS_'
      '1102201971=                                  ,0     --IS_MEBEL_'
      
        '1102201972=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1102201973=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1102201974=                                  ,NULL  --ADDRESS_'
      '1102201975=                                  ,NULL  --PRICE_'
      
        '1102201976=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      '1102201977=                                  )'
      '1102201978=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102201979='
      '1102201980=      if (ERR_CODE <> 0) then BEGIN'
      '1102201981=        ERR_CODE = -20500;'
      '1102201982=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102201983=        Exit;'
      '1102201984=      END'
      '1102201985='
      
        '1102201986=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102201987=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1102201988=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1102201989=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1102201990=      UPDATE ZAKAZ'
      '1102201991=         SET IS_SPISANIE = 2'
      '1102201992=       WHERE ZAKAZ = :ZAKAZ_;'
      '1102201993='
      
        '1102201994=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102201995=      FOR SELECT T.AMOUNT,'
      '1102201996=                 T.SUMM,'
      '1102201997=                 T.G_PRODUCT,'
      '1102201998=                 T.ZAKAZ_NA_REAL,'
      '1102201999=                 T.ZAKAZ_DETAILS'
      '1102202000=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102202001=            INTO :AMOUNT_,'
      '1102202002=                 :Z_SUMM_,'
      '1102202003=                 :G_PRODUCT_,'
      '1102202004=                 :ZAKAZ_NA_REAL_,'
      '1102202005=                 :ZAKAZ_DETAILS_'
      '1102202006=      DO BEGIN'
      '1102202007=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102202008=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1102202009=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1102202010=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102202011=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102202012='
      
        '1102202013=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102202014=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1102202015=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1102202016=      END'
      '1102202017=  END'
      '1102202018=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102202019=  --*************************************************' +
        '*************************************************'
      
        '1102202020=  --*************************************************' +
        '*************************************************'
      '1102202021='
      
        '1102202022=  --*************************************************' +
        '*************************************************'
      
        '1102202023=  --*************************************************' +
        '*************************************************'
      '1102202024=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102202025=  --*************************************************' +
        '*************************************************'
      
        '1102202026=  --*************************************************' +
        '*************************************************'
      '1102202027=  ELSE BEGIN'
      '1102202028=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1102202029=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102202030=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102202031=      FOR SELECT T.AMOUNT,'
      '1102202032=                 T.SUMM,'
      '1102202033=                 T.G_PRODUCT,'
      '1102202034=                 T.ZAKAZ_NA_REAL,'
      '1102202035=                 T.ZAKAZ_DETAILS'
      '1102202036=                 ,T.PRICE'
      '1102202037=                 ,T.NDS'
      '1102202038=                 ,T.NDS_SUMM'
      '1102202039=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102202040=            INTO :AMOUNT_,'
      '1102202041=                 :Z_SUMM_,'
      '1102202042=                 :G_PRODUCT_,'
      '1102202043=                 :ZAKAZ_NA_REAL_,'
      '1102202044=                 :ZAKAZ_DETAILS_'
      '1102202045=                 ,:PRICE_'
      '1102202046=                 ,:NDS_'
      '1102202047=                 ,:NDS_SUMM_'
      '1102202048=      DO BEGIN'
      
        '1102202049=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102202050=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1102202051='
      
        '1102202052=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1102202053=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1102202054='
      '1102202055=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102202056=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1102202057=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1102202058=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102202059=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102202060=      END'
      '1102202061='
      '1102202062=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102202063=                                  :Z_DATE_,'
      '1102202064=                                  :Z_TIME_,'
      '1102202065=                                  :G_CLIENT_,'
      '1102202066=                                  :G_PAYMENT_TYPE_,'
      '1102202067=                                  :OSNOVANIE_,'
      '1102202068=                                  :NOTE_,'
      
        '1102202069=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1102202070=                                  :SUMM_,'
      '1102202071=                                  :SUMM_FACT_,'
      
        '1102202072=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1102202073=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1102202074=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1102202075=                                  ,0        --SUMM_CU' +
        'RRENCY_'
      
        '1102202076=                                  ,0        --IS_EXPE' +
        'CTED_'
      
        '1102202077=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      
        '1102202078=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102202079='
      '1102202080=      if (ERR_CODE <> 0) then BEGIN'
      '1102202081=        ERR_CODE = -20500;'
      '1102202082=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102202083=        Exit;'
      '1102202084=      END'
      '1102202085=  END'
      '1102202086=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102202087=  --*************************************************' +
        '*************************************************'
      
        '1102202088=  --*************************************************' +
        '*************************************************'
      '1102202089='
      '1102202090=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102202091=END'
      '1102202092=;'
      '1102202093='
      '1102202094=ALTER PROCEDURE R_MADE_REVISION('
      
        '1102202095=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102202096=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102202097=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102202098=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102202099=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102202100=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '1102202101=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102202102=RETURNS ('
      '1102202103=  COUNT_SPIS_ INTEGER,'
      '1102202104=  COUNT_PRIH_ INTEGER,'
      
        '1102202105=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT' +
        '.REVISION_PARENT,'
      '1102202106=  ERR_CODE INTEGER,'
      '1102202107=  ERR_MSG VARCHAR(1024))'
      '1102202108=AS'
      
        '1102202109=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVIS' +
        'ION'#39';'
      '1102202110=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102202111=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102202112=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102202113=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102202114=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102202115=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102202116=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102202117=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102202118=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102202119=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      
        '1102202120=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REV' +
        'ISION.DATETIME_CREATED;'
      
        '1102202121=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.AMOUNT;'
      '1102202122=BEGIN'
      '1102202123='
      '1102202124=  COUNT_SPIS_ = 0;'
      '1102202125=  COUNT_PRIH_ = 0;'
      '1102202126='
      '1102202127=  PNT_ = '#39'00'#39';'
      '1102202128=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '1102202129=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGI' +
        'N_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '1102202130=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102202131='
      '1102202132=     IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102202133=       ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '1102202134=       EXIT;'
      '1102202135=     END'
      '1102202136=  END'
      '1102202137='
      '1102202138=  PNT_ = '#39'01'#39';'
      
        '1102202139=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL, DATETIME_CREATED'
      '1102202140=      FROM REVISION_TMP'
      '1102202141=      --WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102202142=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_, :DATETIME_CREATED_'
      '1102202143=  DO BEGIN'
      '1102202144=    /*SELECT SUM(ZD.AMOUNT)'
      '1102202145=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102202146=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ A' +
        'S DATE) AND CURRENT_DATE'
      
        '1102202147=       AND Z.Z_TIME >= CAST(:DATETIME_CREATED_ AS TIM' +
        'E)'
      '1102202148=       AND Z.Z_TIME <= CURRENT_TIME'
      '1102202149=       AND Z.IS_SPISANIE IN (0, 1)'
      '1102202150=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102202151=      INTO :AMOUNT_SALED_;*/'
      '1102202152='
      '1102202153=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '1102202154=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102202155=        RETURNING_VALUES :COST_PRICE_;'
      '1102202156='
      
        '1102202157=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102202158=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102202159=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/, :COST_PRICE_' +
        ', :COST_PRICE_ * (:AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_' +
        '*/), 0, 0, 0, 0, 0);'
      '1102202160='
      '1102202161=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102202162=    END'
      '1102202163='
      '1102202164=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      '1102202165=      SELECT S.price'
      '1102202166=        FROM SKLAD S'
      '1102202167=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102202168=         AND S.g_product = :G_PRODUCT_'
      '1102202169=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102202170=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102202171=                                 FROM SKLAD DD'
      
        '1102202172=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102202173=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102202174=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102202175=                                )'
      '1102202176=        ORDER BY s.sklad DESC'
      '1102202177=        ROWS 1 TO 1'
      '1102202178=        INTO :PRICE_LAST_;'
      '1102202179='
      
        '1102202180=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102202181='
      
        '1102202182=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102202183=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/, :PRICE_LAST_' +
        ', (:AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/) * :PRICE_LA' +
        'ST_, 0, 0);'
      '1102202184='
      '1102202185=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102202186=    END'
      '1102202187=  END'
      '1102202188='
      '1102202189=  PNT_ = '#39'01A'#39';'
      '1102202190=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102202191=    SELECT SUM(S.SUMM)'
      '1102202192=      FROM ZAKAZ_DETAILS_TMP S'
      '1102202193=      INTO :SUMM_;'
      '1102202194='
      '1102202195=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102202196=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102202197=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102202198=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102202199=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102202200=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102202201=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102202202=                                NULL,           --:NO' +
        'TE_,'
      
        '1102202203=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102202204=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102202205=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102202206=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102202207=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102202208=                                NULL,'
      
        '1102202209=                                0,        -- BY_RECIP' +
        'E'
      
        '1102202210=                                0         -- IS_RESER' +
        'VE'
      '1102202211=                                ,NULL  -- PAYMENTS_'
      '1102202212=                                ,0     -- SUMM_CASH'
      
        '1102202213=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102202214=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102202215=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102202216=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102202217=      EXIT;'
      '1102202218=    END'
      '1102202219=  END'
      '1102202220='
      '1102202221=  PNT_ = '#39'02'#39';'
      '1102202222=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102202223=    SELECT SUM(S.SUMM)'
      '1102202224=      FROM SKLAD_TMP S'
      '1102202225=      INTO :SUMM_;'
      '1102202226='
      '1102202227=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102202228=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102202229=                                CURRENT_TIME,'
      
        '1102202230=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102202231=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102202232=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102202233=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102202234=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102202235=                                :SUMM_,'
      '1102202236=                                :SUMM_,'
      
        '1102202237=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102202238=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102202239=                                ,NULL  --PAYMENTS'
      '1102202240=                                )'
      
        '1102202241=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102202242=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102202243=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102202244=      EXIT;'
      '1102202245=    END'
      '1102202246=  END'
      '1102202247='
      '1102202248=  UPDATE REVISION_PARENT RP'
      '1102202249=     SET RP.IS_MADE = 1,'
      '1102202250=         RP.DATE_END = :DATE_END_,'
      '1102202251=         RP.TIME_END = :TIME_END_'
      '1102202252=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '1102202253='
      '1102202254=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '1102202255=END'
      '1102202256=;'
      '1102202257='
      '1102202258=ALTER PROCEDURE R_UNIFICATION('
      '1102202259=  MODE_ INTEGER)'
      '1102202260=RETURNS ('
      '1102202261=  COUNT_SPIS_ INTEGER,'
      '1102202262=  COUNT_PRIH_ INTEGER,'
      '1102202263=  ERR_CODE INTEGER,'
      '1102202264=  ERR_MSG VARCHAR(1024))'
      '1102202265=AS'
      
        '1102202266=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1102202267=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102202268=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102202269=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102202270=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102202271=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102202272=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102202273=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102202274=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102202275=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102202276=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102202277=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102202278=BEGIN'
      '1102202279='
      '1102202280=  COUNT_SPIS_ = 0;'
      '1102202281=  COUNT_PRIH_ = 0;'
      '1102202282='
      '1102202283=  SELECT ID'
      '1102202284=    FROM CUR_PARAMS'
      '1102202285=   WHERE CUR_PARAMS = 2'
      '1102202286=    INTO :G_TOCHKA_;'
      '1102202287='
      
        '1102202288=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1102202289=      FROM REVISION'
      '1102202290=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1102202291=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1102202292=  DO BEGIN'
      
        '1102202293=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1102202294=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102202295=        RETURNING_VALUES :COST_PRICE_;'
      '1102202296='
      
        '1102202297=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102202298=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102202299=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1102202300='
      '1102202301=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102202302=    END'
      '1102202303='
      
        '1102202304=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1102202305=      SELECT S.price'
      '1102202306=        FROM SKLAD S'
      '1102202307=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102202308=         AND S.g_product = :G_PRODUCT_'
      '1102202309=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102202310=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102202311=                                 FROM SKLAD DD'
      
        '1102202312=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102202313=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102202314=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102202315=                                )'
      '1102202316=        ORDER BY s.sklad DESC'
      '1102202317=        ROWS 1 TO 1'
      '1102202318=        INTO :PRICE_LAST_;'
      '1102202319='
      '1102202320=    /* SELECT S.PRICE'
      '1102202321=        FROM SKLAD S'
      '1102202322=       WHERE S.IS_LAST = 1'
      '1102202323=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1102202324=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1102202325=        INTO :PRICE_LAST_; */'
      '1102202326='
      
        '1102202327=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102202328='
      
        '1102202329=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102202330=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1102202331='
      '1102202332=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102202333=    END'
      '1102202334='
      '1102202335=    UPDATE REVISION R'
      '1102202336=       SET R.IS_UNIFIED = 1'
      '1102202337=     WHERE R.REVISION = :REVISION_;'
      '1102202338=  END'
      '1102202339='
      '1102202340=  PNT_ = '#39'01'#39';'
      '1102202341=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102202342=    SELECT SUM(S.SUMM)'
      '1102202343=      FROM ZAKAZ_DETAILS_TMP S'
      '1102202344=      INTO :SUMM_;'
      '1102202345='
      '1102202346=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102202347=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102202348=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102202349=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102202350=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102202351=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102202352=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102202353=                                NULL,           --:NO' +
        'TE_,'
      
        '1102202354=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102202355=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102202356=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102202357=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102202358=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102202359=                                NULL,'
      
        '1102202360=                                0,        -- BY_RECIP' +
        'E'
      
        '1102202361=                                0         -- IS_RESER' +
        'VE'
      '1102202362=                                ,NULL  -- PAYMENTS_'
      '1102202363=                                ,0     -- SUMM_CASH'
      
        '1102202364=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102202365=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102202366=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102202367=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102202368=      EXIT;'
      '1102202369=    END'
      '1102202370=  END'
      '1102202371='
      '1102202372=  PNT_ = '#39'02'#39';'
      '1102202373=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102202374=    SELECT SUM(S.SUMM)'
      '1102202375=      FROM SKLAD_TMP S'
      '1102202376=      INTO :SUMM_;'
      '1102202377='
      '1102202378=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102202379=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102202380=                                CURRENT_TIME,'
      
        '1102202381=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102202382=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102202383=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102202384=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102202385=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102202386=                                :SUMM_,'
      '1102202387=                                :SUMM_,'
      
        '1102202388=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102202389=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102202390=                                ,NULL  --PAYMENTS'
      '1102202391=                                )'
      
        '1102202392=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102202393=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102202394=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102202395=      EXIT;'
      '1102202396=    END'
      '1102202397=  END'
      '1102202398=END'
      '1102202399=;'
      '1102202400='
      '1102202401=ALTER PROCEDURE UPSERT_SKLAD_EXT_LOAD('
      '1102202402=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1102202403=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1102202404=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102202405=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102202406=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102202407=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102202408=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102202409=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1102202410=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102202411=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      '1102202412=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102202413=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102202414=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102202415=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102202416=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102202417=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102202418=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102202419=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL)'
      '1102202420=RETURNS ('
      '1102202421=  ERR_CODE INTEGER,'
      '1102202422=  ERR_MSG VARCHAR(1024))'
      '1102202423=AS'
      
        '1102202424=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1055#1056#1048#1061#1054#1044#1040' '#1048#1047' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071' ' +
        '- '#1052#1054#1041#1048#1051#1050#1048' '#1048#1051#1048' '#1057#1040#1049#1058#1040
      
        '1102202425=-- '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1058#1040#1050#1054#1049' ID - '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1054' '#1054#1041#1053 +
        #1054#1042#1051#1071#1070', '#1053#1045#1058' - '#1058#1040#1050' '#1042#1057#1058#1040#1042#1051#1071#1070
      
        '1102202426=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPSERT_SKLA' +
        'D_EXT_LOAD'#39';'
      
        '1102202427=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD = NULL;'
      '1102202428=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102202429=BEGIN'
      '1102202430='
      '1102202431=  PNT_ = '#39'00'#39';'
      '1102202432='
      '1102202433=  SELECT SP.SKLAD'
      '1102202434=    FROM SKLAD_PARENT SP'
      '1102202435=   WHERE SP.REC_ID = :REC_ID_'
      '1102202436=    INTO :SKLAD_PARENT_;'
      '1102202437='
      '1102202438=  IF (SKLAD_PARENT_ IS NULL) THEN BEGIN'
      '1102202439='
      '1102202440=    PNT_ = '#39'01'#39';'
      
        '1102202441=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_, :DATE_REC' +
        'EIPT_, :TIME_RECEIPT_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_' +
        ','
      
        '1102202442=        :NOTE_, :IS_VOZVRAT_, :SUMM_, :SUMM_FACT_, NU' +
        'LL /*:G_PRIHOD_*/, 0 /*:SUMM_PRIHOD_*/, :PAYMENTS_, :SUMM_CURREN' +
        'CY_, :IS_EXPECTED_,'
      
        '1102202443=        :UPLOAD_TO_EXT_APP_, :USER_ID_, :LOG_BODY_, :' +
        'G_OFFICIAL_, :REC_ID_)'
      
        '1102202444=        RETURNING_VALUES :SKLAD_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102202445='
      '1102202446=  END'
      '1102202447=  ELSE BEGIN'
      '1102202448='
      '1102202449=    PNT_ = '#39'02'#39';'
      
        '1102202450=    EXECUTE PROCEDURE UPD_SKLAD(:SKLAD_PARENT_, :DATE' +
        '_RECEIPT_, :TIME_RECEIPT_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVA' +
        'NIE_,'
      
        '1102202451=        :NOTE_, :SUMM_, :SUMM_FACT_, NULL /*:G_PRIHOD' +
        '_*/, 0 /*:SUMM_PRIHOD_*/, :PAYMENTS_, :SUMM_CURRENCY_, :IS_EXPEC' +
        'TED_,'
      '1102202452=        :UPLOAD_TO_EXT_APP_, :USER_ID_, :LOG_BODY_)'
      '1102202453=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102202454='
      '1102202455=    DELETE FROM SKLAD_TMP;'
      '1102202456='
      '1102202457=  END'
      '1102202458='
      '1102202459=  IF (:ERR_CODE <> 0) THEN'
      
        '1102202460=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102202461=END'
      '1102202462=;'
      '1102202463='
      '1102202464='
      
        '1102202465=UPDATE SYSTEM_SETUP SET S_VALUE = 110220 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102202466=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102202467=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102210='
      '1102211=ALTER PROCEDURE P_REP_PRIHOD('
      '1102212=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102213=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102214=  DATE_BEGIN_ DATE,'
      '1102215=  DATE_END_ DATE,'
      '1102216=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '1102217=RETURNS ('
      '1102218=  PERIOD_ VARCHAR(40),'
      
        '1102219=  P_REP_PRIHOD_TABLE /* TYPE OF COLUMN P_REP_PRIHOD_TABL' +
        'E.P_REP_PRIHOD_TABLE */ INTEGER,'
      
        '11022110=  TOVAR_NAME /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR' +
        '_NAME */ VARCHAR(250),'
      
        '11022111=  AMOUNT /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT */' +
        ' NUMERIC(18,5),'
      
        '11022112=  POSTAVSHIK /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTA' +
        'VSHIK */ VARCHAR(250),'
      
        '11022113=  SELF_PRICE /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'PRICE */ NUMERIC(15,2),'
      
        '11022114=  SELF_SUMM /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_S' +
        'UMM */ NUMERIC(15,2),'
      
