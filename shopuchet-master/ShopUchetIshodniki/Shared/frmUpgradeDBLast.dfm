        'TE_END_'
      '110233569=      AND SP.IS_VOZVRAT IN (1,2)'
      '110233570=      and G.g_product_PAR = TR.g_product'
      
        '110233571=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'S.G_CLIENT, 0))'
      
        '110233572=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE' +
        '_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110233573=      AND SP.SKLAD = S.SKLAD_PARENT'
      '110233574=      AND S.G_PRODUCT = G.G_PRODUCT'
      '110233575=      AND ((EXISTS (SELECT 1'
      '110233576=                       FROM SKLAD SS'
      '110233577=                      WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '110233578=                        AND SS.G_PRODUCT = G.G_PRODUCT'
      
        '110233579=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110233580=              OR'
      '110233581=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110233582=     GROUP BY TR.PATH'
      '110233583=     ORDER BY TR.PATH'
      '110233584=     INTO :V_SUMM_,'
      '110233585=          :REC_SUM_COST_,'
