      '11053825=  SKLAD_ /* TYPE OF COLUMN KASSA.SKLAD */ INTEGER,'
      
        '11053826=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYP' +
