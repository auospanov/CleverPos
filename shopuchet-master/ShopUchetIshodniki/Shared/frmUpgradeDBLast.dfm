      '110153112='
      
        '110153113=    /* '#1055#1088#1080#1089#1086#1077#1076#1080#1085#1103#1077#1084' '#1086#1073#1088#1072#1073#1086#1090#1072#1085#1085#1091#1102' '#1090#1088#1080#1072#1076#1091' '#1082' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1091' *' +
        '/'
      
        '110153114=    if (curr_str != '#39#39' and buf != '#39#39') then buf = buf |' +
