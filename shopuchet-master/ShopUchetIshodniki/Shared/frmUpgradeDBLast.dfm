      '110103227='
      '110103228=ALTER PROCEDURE INS_SKLAD_TMP('
      
        '110103229=  G_PRODUCT_ /* TYPE OF COLUMN SKLAD.G_PRODUCT */ BIGI' +
        'NT,'
      
        '110103230=  AMOUNT_ /* TYPE OF COLUMN SKLAD.AMOUNT */ NUMERIC(18' +
        ',5),'
