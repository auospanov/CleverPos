        'G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110240899='
      
        '110240900=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZA' +
