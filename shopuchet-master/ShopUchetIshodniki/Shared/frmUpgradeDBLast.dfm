      '110250539='
      
        '110250540=/*****************************************************' +
        '*************************/'
      
        '110250541=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110250542=/*****************************************************' +
        '*************************/'
      '110250543=ALTER PROCEDURE CLEAR_BASE('
      '110250544=  MODE_ INTEGER = 0)'
      '110250545=AS'
      '110250546=/*'
      '110250547=mode_'
      '110250548=0 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077
      '110250549=1 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1087#1088#1086#1076#1072#1078#1080' '#1080' '#1087#1088#1080#1093#1086#1076#1099
      '110250550=2 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077', '#1082#1088#1086#1084#1077' '#1090#1086#1074#1072#1088#1086#1074
      '110250551=*/'
      '110250552=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110250553=DECLARE VARIABLE FM_ VARCHAR(300);'
      '110250554=BEGIN'
      '110250555=  delete from LT_ZAKAZ_REAL;'
      '110250556='
      '110250557=  delete from kassa;'
      '110250558=  delete from kassa_state;'
      '110250559='
      '110250560=  delete from kassa_beznal;'
      '110250561=  delete from kassa_beznal_state;'
      '110250562='
      '110250563=  delete from waybill;'
      '110250564=  delete from invoice;'
      '110250565=  delete from INVOICE_PAY;'
      '110250566=  delete from docs;'
      '110250567=  delete from other_details;'
      '110250568=  delete from other;'
      '110250569='
      '110250570=  DELETE FROM REVISION;'
      '110250571=  delete from REVISION_PARENT;'
      '110250572='
      '110250573=  DELETE FROM LOGS;'
      '110250574=  DELETE FROM LOG_OPER;'
      '110250575='
      '110250576=  delete from sklad'
      '110250577=   where exists (select 1'
      '110250578=                  from sklad_parent sp'
      '110250579=                 where sp.IS_VOZVRAT = 1'
      '110250580=                   and sp.ZAKAZ is not NULL'
      '110250581=                   and sp.SKLAD = sklad_parent);'
      '110250582=  delete from sklad_parent'
      '110250583=   where IS_VOZVRAT = 1'
      '110250584=     and ZAKAZ is not NULL;'
      '110250585='
      '110250586=  delete from zakaz_details;'
      '110250587=  delete from zakaz;'
      '110250588='
      '110250589=  delete from zakaz_na_real;'
      '110250590=  delete from ZAKAZ_real_parent;'
      '110250591='
      '110250592=  delete from sklad;'
      '110250593=  delete from sklad_parent;'
      '110250594='
      '110250595=  update lt_sklad_product l'
      '110250596=     set l.AMOUNT = 0,'
      '110250597=         l.AMOUNT_RESERVE = 0;'
      '110250598='
      
        '110250599=  -- '#1044#1054' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042' '#1047#1040#1055#1048#1064#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1063#1048#1057#1058#1050#1059' '#1041 +
        #1040#1047#1067'. '#1052#1054#1046#1053#1054' '#1041#1067#1051#1054' '#1041#1067' '#1042' '#1060#1040#1049#1051', '#1053#1054' '#1060#1040#1049#1051' '#1052#1054#1046#1053#1054' '#1059#1044#1040#1051#1048#1058#1068
      '110250600=  SELECT COALESCE(G.FM, '#39#39')||'#39' '#39'||COALESCE(G.NM, '#39#39')'
      '110250601=    FROM G_OFFICIAL G'
      
        '110250602=   WHERE G.G_OFFICIAL = (SELECT ID FROM CUR_PARAMS WHE' +
        'RE CUR_PARAMS = 1)'
      '110250603=    INTO :FM_;'
      '110250604=  IF (ROW_COUNT = 0) THEN'
      '110250605=    FM_ = '#39#1053#1077#1090' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1103#39';'
      '110250606='
      '110250607=  STR_ = '#39#1054#1095#1080#1089#1090#1082#1072' '#1073#1072#1079#1099' '#1074' '#1088#1077#1078#1080#1084#1077' '#39';'
      '110250608=  IF (MODE_ = 0) THEN'
      '110250609=    STR_ = STR_ || '#39'"'#1054#1063#1048#1057#1058#1048#1058#1068' '#1042#1057#1025'"'#39';'
      '110250610=  ELSE IF (MODE_ = 1) THEN'
      '110250611=    STR_ = STR_ || '#39'"'#1054#1063#1048#1057#1058#1048#1058#1068' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1055#1056#1048#1061#1054#1044#1067'"'#39';'
      '110250612=  ELSE'
      '110250613=    STR_ = STR_ || '#39'"'#1054#1063#1048#1057#1058#1048#1058#1068' '#1042#1057#1025', '#1050#1056#1054#1052#1045' '#1058#1054#1042#1040#1056#1054#1042'"'#39';'
      '110250614='
      '110250615=  STR_ = STR_ || '#39'" '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1084' "'#39' || :FM_ || '#39'".'#39';'
      '110250616='
      
        '110250617=  EXECUTE PROCEDURE LOG_OPER_INS(15, 0, 0, CURRENT_DAT' +
        'E, 1, 0, :STR_, 0);'
      '110250618=  ---------------'
      '110250619='
      '110250620=  IF (MODE_ IN (0, 2)) THEN BEGIN'
      '110250621=    delete from g_address;'
      '110250622=    delete from g_account;'
      '110250623=    delete from G_DISCONT_CARD;'
      '110250624=    delete from DELIVERY;'
      '110250625='
      
        '110250626=    --'#1076#1077#1083#1072#1102' '#1089#1085#1072#1095#1072#1083#1072' '#1072#1087#1076#1077#1081#1090' '#1087#1072#1088#1077#1085#1090#1086#1074', '#1095#1090#1086#1073#1099' '#1091#1076#1072#1083#1077#1085#1080#1077' '#1087#1088 +
        #1086#1096#1083#1086' '#1075#1083#1072#1076#1082#1086
      
        '110250627=    update g_client c set c.G_CLIENT_PARENT = null whe' +
        're c.G_CLIENT <> 10;'
      
        '110250628=    delete from g_client c where c.G_CLIENT not in (9,' +
        '10);'
      '110250629=    delete from g_discount;'
      
        '110250630=    delete from g_prihod_rashod where g_prihod_rashod ' +
        'not in (-5,-1,0,1,2,3);'
      '110250631=    delete from g_firm_address;'
      '110250632=    delete from g_firm_account;'
      '110250633=    delete from g_firm_rekvizit;'
      '110250634=    delete from G_OFFICIAL_RIGHT;'
      '110250635=    delete from g_official;'
      '110250636=    delete from G_APPOINTMENT;'
      '110250637='
      '110250638=    IF (mode_ = 0) THEN begin'
      '110250639=      delete from G_PRODUCT_IMAGE;'
      '110250640=      delete from G_PRODUCT_KIT;'
      '110250641=      delete from LT_BARCODE;'
      '110250642=      delete from LT_SKLAD_PRODUCT;'
      '110250643=      delete from G_PRODUCT g where g.IS_CATEGORY = 0;'
      '110250644=      update g_product g set g.g_product_par = null;'
      
        '110250645=      delete from G_PRODUCT g where g.IS_CATEGORY = 1 ' +
        'and g.G_PRODUCT <> -1;'
      '110250646=      delete from g_unit where g_unit <> 1;'
      '110250647=    end'
      '110250648='
      '110250649=  END'
      '110250650=END'
      '110250651=;'
      '110250652='
      '110250653=ALTER PROCEDURE DOCS_GET('
      '110250654=  DOCS_ TYPE OF COLUMN DOCS.DOCS,'
      '110250655=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110250656=  DOC_TYPE_ TYPE OF COLUMN DOCS.DOC_TYPE)'
      '110250657=RETURNS ('
      '110250658=  DOCS_ID_ TYPE OF COLUMN DOCS.DOCS,'
      '110250659=  NUM_ TYPE OF COLUMN DOCS.NUM,'
      '110250660=  DOCS_DATE_ TYPE OF COLUMN DOCS.DOCS_DATE,'
      '110250661=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '110250662=  G_FIRM_ADDRESS_ TYPE OF COLUMN DOCS.G_FIRM_ADDRESS,'
      '110250663=  G_FIRM_ACCOUNT_ TYPE OF COLUMN DOCS.G_FIRM_ACCOUNT,'
      '110250664=  G_CLIENT_ TYPE OF COLUMN DOCS.G_CLIENT,'
      
        '110250665=  G_CLIENT_ADDRESS_ TYPE OF COLUMN DOCS.G_CLIENT_ADDRE' +
        'SS,'
      
        '110250666=  G_CLIENT_ACCOUNT_ TYPE OF COLUMN DOCS.G_CLIENT_ACCOU' +
        'NT,'
      '110250667=  G_OFFICIAL_ TYPE OF COLUMN DOCS.G_OFFICIAL,'
      '110250668=  NOTE_ TYPE OF COLUMN DOCS.NOTE,'
      '110250669=  PARAM1_ TYPE OF COLUMN DOCS.PARAM1,'
      '110250670=  PARAM2_ TYPE OF COLUMN DOCS.PARAM2,'
      '110250671=  PARAM3_ TYPE OF COLUMN DOCS.PARAM3,'
      '110250672=  PARAM4_ TYPE OF COLUMN DOCS.PARAM4,'
      '110250673=  PARAM5_ TYPE OF COLUMN DOCS.PARAM5,'
      '110250674=  PARAM6_ TYPE OF COLUMN DOCS.PARAM6,'
      
        '110250675=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN G_OFFICIAL.G_OFFI' +
        'CIAL,'
      '110250676=  GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110250677=  IS_SAVED_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110250678=  ERR_CODE INTEGER,'
      '110250679=  ERR_MSG VARCHAR(1024))'
      '110250680=AS'
      '110250681=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DOCS_GET'#39';'
      '110250682=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110250683=DECLARE VARIABLE ZAKAZ_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      '110250684=BEGIN'
      
        '110250685=  SELECT DOCS, DOCS ID, NUM, DOCS_DATE, G_FIRM, G_FIRM' +
        '_ADDRESS, G_FIRM_ACCOUNT, G_CLIENT, G_CLIENT_ADDRESS,'
      
        '110250686=         G_CLIENT_ACCOUNT, G_OFFICIAL, G_OFFICIAL_RUKO' +
        'VOD, GLAVBUH, NOTE, PARAM1, PARAM2, PARAM3, PARAM4, PARAM5, PARA' +
        'M6, 1'
      '110250687=  FROM DOCS'
      
        '110250688=  WHERE ((DOCS = :docs_ AND :docs_ <> 0)    -- '#1055#1056#1048' '#1057#1054#1047 +
        #1044#1040#1053#1048#1048' '#1044#1054#1050#1059#1052#1045#1053#1058#1040' '#1048#1051#1048' '#1045#1043#1054' '#1055#1056#1054#1057#1052#1054#1058#1056#1045' '#1042' '#1056#1045#1046#1048#1052#1045' "'#1055#1056#1054#1044#1040#1046#1048'" '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ' +
        'docs_ '#1053#1045' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ==>'
      
        '110250689=          OR                                -- ==> '#1055#1045#1056 +
        #1045#1044#1040#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' :ZAKAZ_'
      
        '110250690=         (ZAKAZ = :ZAKAZ_ AND DOC_TYPE = :DOC_TYPE_ AN' +
        'D :docs_ = 0))'
      
        '110250691=  INTO :DOCS_, :DOCS_ID_, :NUM_, :DOCS_DATE_, :G_FIRM_' +
        ', :G_FIRM_ADDRESS_, :G_FIRM_ACCOUNT_, :G_CLIENT_, :G_CLIENT_ADDR' +
        'ESS_,'
      
        '110250692=       :G_CLIENT_ACCOUNT_, :G_OFFICIAL_, :G_OFFICIAL_R' +
        'UKOVOD_, :GLAVBUH_, :NOTE_, :PARAM1_, :PARAM2_, :PARAM3_, :PARAM' +
        '4_, :PARAM5_, :PARAM6_, :IS_SAVED_;'
      '110250693='
      '110250694=  IF (ROW_COUNT = 0) THEN BEGIN'
      '110250695=  --**************************************************'
      
        '110250696=    -- '#1047#1053#1040#1063#1048#1058' '#1044#1054#1050#1059#1052#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056#1045#1044#1042 +
        #1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '110250697=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '110250698=    SELECT'
      '110250699=      G.g_firm_rekvizit,'
      '110250700=      GF.g_address,'
      '110250701=      A.g_account'
      '110250702=    FROM G_FIRM_REKVIZIT g'
      
        '110250703=           LEFT OUTER JOIN G_FIRM_ADDRESS GF ON G.G_FI' +
        'RM_REKVIZIT = GF.G_FIRM_REKVIZIT AND GF.IS_DEFAULT = 1'
      
        '110250704=           LEFT OUTER JOIN G_FIRM_ACCOUNT A ON G.G_FIR' +
        'M_REKVIZIT = A.G_FIRM_REKVIZIT AND A.IS_DEFAULT = 1'
      '110250705=    WHERE G.is_default = 1'
      '110250706=    INTO'
      '110250707=      :G_FIRM_,'
      '110250708=      :G_FIRM_ADDRESS_,'
      '110250709=      :G_FIRM_ACCOUNT_;'
      '110250710='
      '110250711=    -- '#1048#1053#1060#1054' '#1054' '#1050#1051#1048#1045#1053#1058#1045
      '110250712=    SELECT G.g_client,'
      '110250713=           GA.g_address,'
      '110250714=           A.g_account,'
      
        '110250715=           DECODE(CHAR_LENGTH(COALESCE(G.DOGOVOR, '#39#39'))' +
        ', 0, '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39', G.DOGOVOR || '#39' '#1086#1090' '#39' ||'
      
        '110250716=              lpad(EXTRACT(DAY FROM G.DOGOVOR_DATE), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM G.DOGOVOR_DATE), 2, '#39'0'#39')||'
      '110250717=              '#39'.'#39'||EXTRACT(YEAR FROM G.DOGOVOR_DATE)),'
      '110250718=           Z.Z_DATE'
      '110250719=      FROM ZAKAZ Z,'
      '110250720=           G_CLIENT G'
      
        '110250721=           LEFT OUTER JOIN G_ADDRESS GA ON G.G_CLIENT ' +
        '= GA.G_CLIENT AND GA.IS_DEFAULT = 1'
      
        '110250722=           LEFT OUTER JOIN G_ACCOUNT A ON G.G_CLIENT =' +
        ' A.G_CLIENT AND A.IS_DEFAULT = 1'
      '110250723=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '110250724=      AND Z.G_CLIENT = G.G_CLIENT'
      '110250725=     INTO :G_CLIENT_,'
      '110250726=          :G_CLIENT_ADDRESS_,'
      '110250727=          :G_CLIENT_ACCOUNT_,'
      '110250728=          :NOTE_,'
      '110250729=          :ZAKAZ_DATE_;'
      '110250730='
      
        '110250731=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054 +
        #1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      '110250732=    PNT_ = '#39'05'#39';'
      '110250733=    SELECT C.id'
      '110250734=      FROM cur_params C'
      '110250735=     WHERE C.cur_params = 1'
      '110250736=    INTO :G_OFFICIAL_;'
      '110250737='
      '110250738=    IF (ROW_COUNT = 0) then BEGIN'
      '110250739=        SELECT MIN(O.G_OFFICIAL)'
      '110250740=          FROM G_OFFICIAL O'
      '110250741=          INTO :G_OFFICIAL_;'
      '110250742=        IF (ROW_COUNT = 0) then BEGIN'
      '110250743=            Err_Code = -20500;'
      
        '110250744=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057 +
        #1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      
        '110250745=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110250746=            EXIT;'
      '110250747=        END'
      '110250748=    END'
      '110250749='
      '110250750=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '110250751=    SELECT O.G_OFFICIAL'
      '110250752=    FROM G_OFFICIAL O'
      '110250753=    WHERE O.IS_RUKOVODITEL = 1'
      '110250754=    INTO :G_OFFICIAL_RUKOVOD_;'
      '110250755='
      '110250756=    --'#1048#1065#1059' '#1075#1083#1072#1074#1073#1091#1093#1072
      '110250757=    SELECT O.G_OFFICIAL'
      '110250758=    FROM G_OFFICIAL O'
      '110250759=    WHERE O.IS_GLAVBUH = 1'
      '110250760=    INTO :GLAVBUH_;'
      '110250761='
      '110250762=    DOCS_DATE_ = CURRENT_DATE;'
      '110250763='
      
        '110250764=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1053#1040#1050#1051#1040#1044#1053#1054#1049', '#1057#1053#1040#1063#1040#1051#1040' '#1057#1044#1045#1051#1040#1051 +
        ' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '110250765=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VAR' +
        'CHAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '110250766=      FROM DOCS P'
      '110250767=     WHERE P.DOC_TYPE = :DOC_TYPE_'
      
        '110250768=       AND EXTRACT(YEAR FROM P.DOCS_DATE) = EXTRACT(YE' +
        'AR FROM :DOCS_DATE_)'
      
        '110250769=       AND ((SELECT * FROM IS_NUMERIC(P.NUM)) <> -999)' +
        '  -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070' '#1058#1054#1051#1068#1050#1054' '#1062#1048#1060#1056#1054#1042#1067#1045' '#1053#1054#1052#1045#1056#1040
      '110250770=    INTO :NUM_;'
      '110250771='
      
        '110250772=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1042#1054#1054#1041#1065#1045' ' +
        #1053#1045#1058
      '110250773=      NUM_ = '#39'1'#39';'
      '110250774='
      '110250775=  END'
      '110250776=end'
      '110250777=;'
      '110250778='
      '110250779=ALTER PROCEDURE G_GET_G_CLIENT('
      '110250780=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '110250781=RETURNS ('
      
        '110250782=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      
        '110250783=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT,'
      '110250784=  NAME_ VARCHAR(500),'
      '110250785=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110250786=  IDN_ VARCHAR(12),'
      '110250787=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '110250788=  KBE_ VARCHAR(5),'
      '110250789=  SKIDKA_ NUMERIC(15,2),'
      '110250790=  BY_DEFAULT_ INTEGER,'
      '110250791=  IS_BEZNAL_ INTEGER,'
      '110250792=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110250793=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110250794=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110250795=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110250796=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110250797=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110250798=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110250799=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '110250800=  NOTIFY_SKIDKA_ INTEGER,'
      '110250801=  NOTIFY_DR_ INTEGER,'
      '110250802=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110250803=  FM_PROMO_ VARCHAR(50),'
      
        '110250804=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONU' +
        'S_PAY_SUMM,'
      '110250805=  LAST_PURCHASE_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110250806=  DOGOVOR_ TYPE OF COLUMN G_CLIENT.DOGOVOR,'
      '110250807=  DOGOVOR_DATE_ TYPE OF COLUMN G_CLIENT.DOGOVOR_DATE,'
      '110250808=  ERR_CODE INTEGER,'
      '110250809=  ERR_MSG VARCHAR(1024))'
      '110250810=AS'
      '110250811=/**/'
      '110250812=begin'
      '110250813=    SELECT'
      
        '110250814=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE,' +
        ' SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '110250815=      ,P.G_PROMOTION'
      '110250816=      ,P.NAME'
      '110250817=      ,notify_dr'
      '110250818=      ,notify_skidka'
      '110250819=      ,MAX_BONUS_PAY_SUMM'
      '110250820=      ,DOGOVOR'
      '110250821=      ,DOGOVOR_DATE'
      
        '110250822=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T' +
        '.g_promotion = P.g_promotion'
      '110250823=    WHERE T.G_CLIENT = :G_CLIENT_'
      '110250824=    INTO'
      
        '110250825=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_' +
        ', :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :D' +
        'T_, :NAME_FULL_'
      '110250826=      ,:G_PROMOTION_'
      '110250827=      ,:G_PROMOTION_STR_'
      '110250828=      ,:NOTIFY_DR_'
      '110250829=      ,:NOTIFY_SKIDKA_'
      '110250830=      ,:MAX_BONUS_PAY_SUMM_'
      '110250831=      ,:DOGOVOR_'
      '110250832=      ,:DOGOVOR_DATE_'
      '110250833=      ;'
      '110250834='
      '110250835=    SELECT MAX(Z.Z_DATE)'
      '110250836=      FROM ZAKAZ Z'
      '110250837=     WHERE Z.G_CLIENT = :G_CLIENT_'
      '110250838=     INTO :LAST_PURCHASE_DATE_;'
      '110250839='
      '110250840=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '110250841=    FROM G_DISCONT_CARD'
      '110250842=    WHERE G_CLIENT = :G_CLIENT_'
      '110250843=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '110250844=end'
      '110250845=;'
      '110250846='
      '110250847=ALTER PROCEDURE G_INS_G_CLIENT('
      '110250848=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110250849=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT,'
      '110250850=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110250851=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110250852=  IDN_ VARCHAR(12),'
      '110250853=  KBE_ VARCHAR(5),'
      '110250854=  SKIDKA_ NUMERIC(15,2),'
      '110250855=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '110250856=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110250857=  BY_DEFAULT_ INTEGER,'
      '110250858=  IS_SUPPLIER_ INTEGER,'
      '110250859=  IS_CATEGORY_ INTEGER,'
      '110250860=  IS_BEZNAL_ INTEGER,'
      '110250861=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110250862=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110250863=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110250864=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110250865=  NOTIFY_SKIDKA_ INTEGER,'
      '110250866=  NOTIFY_DR_ INTEGER,'
      '110250867=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '110250868=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110250869=  SUMM_BONUS_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      
        '110250870=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONU' +
        'S_PAY_SUMM,'
      '110250871=  DOGOVOR_ TYPE OF COLUMN G_CLIENT.DOGOVOR,'
      '110250872=  DOGOVOR_DATE_ TYPE OF COLUMN G_CLIENT.DOGOVOR_DATE,'
      
        '110250873=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110250874=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110250875=RETURNS ('
      '110250876=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110250877=  ERR_CODE INTEGER,'
      '110250878=  ERR_MSG VARCHAR(1024))'
      '110250879=AS'
      '110250880=DECLARE VARIABLE CNT_ INTEGER;'
      '110250881=begin'
      
        '110250882=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = ' +
        '1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '110250883=    if (BY_DEFAULT_ = 1) then'
      '110250884=      UPDATE g_client'
      '110250885=         SET BY_DEFAULT = 0'
      '110250886=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '110250887='
      
        '110250888=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G' +
        '_CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '110250889=                          IS_CATEGORY, IS_BEZNAL, PHON' +
        'E, NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR, M' +
        'AX_BONUS_PAY_SUMM,'
      '110250890=                          DOGOVOR, DOGOVOR_DATE)'
      
        '110250891=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_' +
        ', :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_,' +
        ' :BY_DEFAULT_,'
      
        '110250892=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE' +
        '_, :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR' +
        '_, :MAX_BONUS_PAY_SUMM_,'
      '110250893=            :DOGOVOR_, :DOGOVOR_DATE_)'
      '110250894=    returning G_CLIENT'
      '110250895=    into :G_CLIENT_;'
      '110250896='
      '110250897=    if (IS_CATEGORY_ = 0) then BEGIN'
      '110250898=        IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '110250899=            IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '110250900=                         FROM G_DISCONT_CARD'
      '110250901=                        WHERE BARCODE = :BARCODE_'
      
        '110250902=                          AND G_CLIENT <> :G_CLIENT_))' +
        ' THEN BEGIN'
      '110250903=              ERR_CODE = -20500;'
      
        '110250904=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '110250905=              EXIT;'
      '110250906=            END'
      '110250907=        END'
      '110250908='
      
        '110250909=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_' +
        'CLIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '110250910=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIE' +
        'NT_, :BARCODE_, :N_PERCENT_, :SUMM_BONUS_ALL_, 0);'
      '110250911=    END'
      '110250912='
      '110250913=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110250914=    EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_C' +
        'LIENT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '110250915=end'
      '110250916=;'
      '110250917='
      '110250918=ALTER PROCEDURE G_UPD_G_CLIENT('
      '110250919=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110250920=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      '110250921=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '110250922=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110250923=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110250924=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '110250925=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '110250926=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '110250927=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '110250928=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110250929=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '110250930=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '110250931=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '110250932=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '110250933=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110250934=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110250935=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110250936=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110250937=  NOTIFY_SKIDKA_ INTEGER,'
      '110250938=  NOTIFY_DR_ INTEGER,'
      '110250939=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '110250940=  G_CLIENT_PROMO_ INTEGER,'
      '110250941=  SUMM_BONUS_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      
        '110250942=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONU' +
        'S_PAY_SUMM,'
      '110250943=  DOGOVOR_ TYPE OF COLUMN G_CLIENT.DOGOVOR,'
      '110250944=  DOGOVOR_DATE_ TYPE OF COLUMN G_CLIENT.DOGOVOR_DATE,'
      
        '110250945=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110250946=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110250947=RETURNS ('
      '110250948=  ERR_CODE INTEGER,'
      '110250949=  ERR_MSG VARCHAR(1024))'
      '110250950=AS'
      '110250951=DECLARE VARIABLE CNT_ INTEGER;'
      '110250952=BEGIN'
      
        '110250953=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1,' +
        ' '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '110250954=  if (BY_DEFAULT_ = 1) then'
      '110250955=    UPDATE g_client'
      '110250956=       SET BY_DEFAULT = 0'
      '110250957=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '110250958='
      '110250959=  UPDATE g_client'
      '110250960=  SET'
      
        '110250961=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CLI' +
        'ENT_PARENT),'
      
        '110250962=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTRA' +
        'GENT),'
      '110250963=   NAME = COALESCE(:NAME_, NAME),'
      '110250964=   IDN  = COALESCE(:IDN_, IDN),'
      '110250965=   KBE  = COALESCE(:KBE_, KBE),'
      '110250966=   PHONE = COALESCE(:PHONE_, PHONE),'
      '110250967=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '110250968=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      '110250969=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER),'
      '110250970=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '110250971=   ,DT    = :DT_ --COALESCE(:DT_, DT)'
      '110250972=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '110250973=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '110250974=   ,G_PROMOTION = :G_PROMOTION_'
      '110250975=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '110250976=   ,NOTIFY_DR = :NOTIFY_DR_'
      '110250977=   ,MAX_BONUS_PAY_SUMM = :MAX_BONUS_PAY_SUMM_'
      '110250978=   ,DOGOVOR = COALESCE(:DOGOVOR_, DOGOVOR)'
      '110250979=   ,DOGOVOR_DATE = :DOGOVOR_DATE_'
      '110250980=  WHERE'
      '110250981=    g_client = :g_client_;'
      '110250982='
      '110250983=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '110250984=    IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '110250985=        IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '110250986=                     FROM G_DISCONT_CARD'
      '110250987=                    WHERE BARCODE = :BARCODE_'
      
        '110250988=                      AND G_CLIENT <> :G_CLIENT_)) THE' +
        'N BEGIN'
      '110250989=          ERR_CODE = -20500;'
      
        '110250990=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1050#1072#1088 +
        #1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '110250991=          EXIT;'
      '110250992=        END'
      '110250993=    END'
      '110250994='
      '110250995=    UPDATE G_DISCONT_CARD G'
      '110250996=    SET G.BARCODE = :BARCODE_,'
      '110250997=        G.N_PERCENT = :N_PERCENT_,'
      '110250998=        G.summ = :SUMM_BONUS_ALL_,'
      '110250999=        G.summ_all = COALESCE(G.summ_all, 0)'
      '1102501000=    WHERE G.G_CLIENT = :g_client_;'
      '1102501001='
      '1102501002=    if (ROW_COUNT = 0) then'
      
        '1102501003=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '1102501004=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, :SUMM_BONUS_ALL_, (select Coalesce(s' +
        'um(SUMM_FACT), 0) from zakaz where g_client = :g_client_));'
      '1102501005=  END'
      '1102501006='
      '1102501007=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102501008=  EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_CL' +
        'IENT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1102501009=end'
      '1102501010=;'
      '1102501011='
      '1102501012=ALTER PROCEDURE INS_ZAKAZ('
      '1102501013=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102501014=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102501015=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102501016=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102501017=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102501018=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102501019=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102501020=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102501021=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102501022=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102501023=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102501024=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102501025=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102501026=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102501027=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102501028=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102501029=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102501030=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102501031=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102501032=  IS_MEBEL_ INTEGER = 0,'
      
        '1102501033=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1102501034=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      
        '1102501035=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      '1102501036=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1102501037=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102501038=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102501039=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102501040=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102501041=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102501042=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '1102501043=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL,'
      
        '1102501044=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD' +
        ' = NULL,'
      
        '1102501045=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PA' +
        'Y_TRANSACTION_ID = NULL,'
      
        '1102501046=  REQUEST_NUMBER_ TYPE OF COLUMN ZAKAZ.REQUEST_NUMBER' +
        ' = NULL)'
      '1102501047=RETURNS ('
      '1102501048=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102501049=  ERR_CODE INTEGER,'
      '1102501050=  ERR_MSG VARCHAR(1024))'
      '1102501051=AS'
      '1102501052=/*'
      '1102501053=IS_SPISANIE_'
      '1102501054=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102501055=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102501056=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102501057=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102501058='
      '1102501059='
      
        '1102501060=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102501061=*/'
      '1102501062=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1102501063=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102501064=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102501065=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1102501066=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1102501067=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1102501068=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1102501069=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1102501070=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1102501071=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1102501072=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1102501073=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1102501074=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1102501075=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1102501076=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '1102501077=DECLARE VARIABLE CNT_ INTEGER;'
      '1102501078=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1102501079=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1102501080=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102501081=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102501082=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1102501083=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102501084=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102501085=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1102501086=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102501087=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1102501088=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1102501089=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102501090=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102501091=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102501092=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLI' +
        'ENT.SKIDKA;'
      
        '1102501093=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.N_PERCENT;'
      
        '1102501094=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DI' +
        'SCONT_CARD.SUMM_ALL;'
      
        '1102501095=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.MARK_CODE;'
      '1102501096=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102501097=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1102501098=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      
        '1102501099=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '1102501100=BEGIN'
      '1102501101='
      
        '1102501102=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1102501103=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1102501104=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1102501105=  IF (CNT_ = 0) THEN BEGIN'
      '1102501106=    ERR_CODE = -20500;'
      
        '1102501107=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1102501108=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1102501109=    EXIT;'
      '1102501110=  END'
      '1102501111='
      '1102501112=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102501113=    SELECT ID'
      '1102501114=      FROM CUR_PARAMS'
      '1102501115=     WHERE CUR_PARAMS = 2'
      '1102501116=      INTO :G_TOCHKA_;'
      '1102501117='
      '1102501118=  IF (G_TOCHKA_ IS NULL) THEN BEGIN'
      '1102501119=    ERR_CODE = -20500;'
      
        '1102501120=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077' '#1091#1082#1072#1079#1072 +
        #1085' '#1089#1082#1083#1072#1076' '#1087#1088#1086#1076#1072#1078#1080'! '#1054#1073#1088#1072#1090#1080#1090#1077#1089#1100' '#1082' '#1088#1072#1079#1088#1072#1073#1086#1090#1095#1080#1082#1091'!'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1102501121=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1102501122=    EXIT;'
      '1102501123=  END'
      '1102501124='
      '1102501125=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102501126=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1102501127=      PNT_ = '#39'01'#39';'
      
        '1102501128=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102501129=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102501130=      ELSE'
      '1102501131=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102501132='
      '1102501133=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1102501134=      SELECT G.G_OFFICIAL,'
      '1102501135=             G.DO_NOT_SALES_COMM,'
      
        '1102501136=             COALESCE(G.FM, '#39#39')||'#39' '#39'||COALESCE(G.NM, ' +
        #39#39')'
      '1102501137=        FROM G_OFFICIAL G'
      
        '1102501138=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1102501139=        INTO :G_OFFICIAL_,'
      '1102501140=             :DO_NOT_SALES_COMM_,'
      '1102501141=             :OFFICIAL_NAME_;'
      '1102501142='
      '1102501143=      INSERT INTO ZAKAZ'
      '1102501144=      ('
      '1102501145=       ZAKAZ,'
      '1102501146=       G_TOCHKA,'
      '1102501147=       Z_DATE,'
      '1102501148=       Z_TIME,'
      '1102501149=       G_CLIENT,'
      '1102501150=       G_PAYMENT_TYPE,'
      '1102501151=       OSNOVANIE,'
      '1102501152=       IS_SPISANIE,'
      '1102501153=       NOTE,'
      '1102501154=       SUMM,'
      '1102501155=       SUMM_FACT,'
      '1102501156=       SUMM_BONUS,'
      '1102501157=       IS_PAYED_ALL'
      '1102501158=       ,G_OFFICIAL'
      '1102501159=       ,BY_RECIPE'
      '1102501160=       ,SUMM_BONUS_GOT'
      '1102501161=       ,IS_RESERVE'
      '1102501162=       ,SUMM_CASH'
      '1102501163=       ,SUMM_NONCASH'
      '1102501164=       ,NOT_MINUS_OSTATOK'
      '1102501165=       ,DELIVERY_ADDRESS'
      '1102501166=       ,REC_ID'
      '1102501167=       ,G_NONCASH_PAY_TYPE'
      '1102501168=       ,POS_PAY_METHOD'
      '1102501169=       ,POS_PAY_TRANSACTION_ID'
      '1102501170=       ,REQUEST_NUMBER'
      '1102501171=       ,BARCODE'
      '1102501172=      ) VALUES ('
      '1102501173=       GEN_ID(GEN_ZAKAZ, 1),'
      '1102501174=       :G_TOCHKA_,'
      '1102501175=       :Z_DATE_,'
      '1102501176=       :Z_TIME_,'
      '1102501177=       :G_CLIENT_,'
      '1102501178=       :G_PAYMENT_TYPE_,'
      '1102501179=       :OSNOVANIE_,'
      '1102501180=       :IS_SPISANIE_,'
      '1102501181=       :NOTE_,'
      '1102501182=       :SUMM_,'
      '1102501183=       :SUMM_FACT_1_,'
      '1102501184=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1102501185=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102501186=       ,:G_OFFICIAL_'
      '1102501187=       ,:BY_RECIPE_'
      '1102501188=       ,:SUMM_BONUS_GOT_'
      '1102501189=       ,:IS_RESERVE_'
      '1102501190=       ,COALESCE(:SUMM_CASH_, 0)'
      '1102501191=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1102501192=       ,:NOT_MINUS_OSTATOK_'
      '1102501193=       ,:ADDRESS_'
      '1102501194=       ,:REC_ID_'
      '1102501195=       ,:G_NONCASH_PAY_TYPE_'
      '1102501196=       ,:POS_PAY_METHOD_'
      '1102501197=       ,:POS_PAY_TRANSACTION_ID_'
      '1102501198=       ,:REQUEST_NUMBER_'
      
        '1102501199=       ,'#39'SHO'#39'||LPAD(GEN_ID(GEN_ZAKAZ_BARCODE,  1), 12' +
        ', '#39'0'#39')'
      '1102501200=      )'
      '1102501201=      RETURNING'
      '1102501202=        ZAKAZ'
      '1102501203=      INTO'
      '1102501204=        :ZAKAZ_;'
      '1102501205='
      '1102501206=      PNT_ = '#39'02'#39';'
      
        '1102501207=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1102501208=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM, Z.MARK_CODE'
      '1102501209=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1102501210=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1102501211=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1102501212=              :G_PRODUCT,'
      '1102501213=              :AMOUNT,'
      '1102501214=              :PRICE,'
      '1102501215=              :SUMM,'
      '1102501216=              :DISCOUNT_PERC,'
      '1102501217=              :DISCOUNT_TENGE,'
      '1102501218=              :DISCOUNT_SUMM,'
      '1102501219=              :NDS,'
      '1102501220=              :NDS_SUMM,'
      '1102501221=              :COST_PRICE,'
      '1102501222=              :SALES_COMM_,'
      '1102501223=              :MARK_CODE_'
      '1102501224=      DO BEGIN'
      
        '1102501225=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102501226=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1102501227=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1102501228=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102501229=        END'
      '1102501230='
      '1102501231=        INSERT INTO ZAKAZ_DETAILS'
      '1102501232=        VALUES('
      '1102501233=          :ZAKAZ_DETAILS_TMP_,'
      '1102501234=          :ZAKAZ_,'
      '1102501235=          :G_PRODUCT,'
      '1102501236=          :AMOUNT,'
      '1102501237=          :PRICE,'
      '1102501238=          :SUMM,'
      '1102501239=          :DISCOUNT_PERC,'
      '1102501240=          :DISCOUNT_TENGE,'
      '1102501241=          :DISCOUNT_SUMM,'
      '1102501242=          :NDS,'
      '1102501243=          :NDS_SUMM,'
      '1102501244=          :COST_PRICE,'
      '1102501245=          :SALES_COMM_SUMM_ITER_,'
      '1102501246=          :MARK_CODE_'
      '1102501247=        );'
      '1102501248='
      
        '1102501249=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1102501250=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1102501251=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1102501252=                UPDATE LT_SKLAD_PRODUCT L'
      '1102501253=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102501254=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_  -- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051 +
        #1067' '#1055#1056#1048#1061#1054#1044', '#1061#1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102501255=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102501256=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102501257='
      '1102501258=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1102501259=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102501260=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057 +
        #1051#1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102501261=                -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048 +
        #1071' ('#1053#1040#1055#1056#1048#1052#1045#1056' '#1052#1054#1041#1048#1051#1040'), '#1058#1054' '#1053#1040' '#1052#1048#1053#1059#1057' '#1053#1045' '#1055#1056#1054#1042#1045#1056#1071#1070
      '1102501262=                PNT_ = '#39'04'#39';'
      
        '1102501263=                IF (ROW_COUNT = 0 AND ((SELECT S_VALU' +
        'E FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) AND REC_ID_ IS ' +
        'NULL) then BEGIN'
      '1102501264=                  Err_Code = -20500;'
      
        '1102501265=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_C' +
        'ODE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_' +
        'PRODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072 +
        #1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102501266=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102501267=                  EXIT;'
      '1102501268=                END ELSE if (ROW_COUNT = 0) then'
      
        '1102501269=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102501270=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);  -' +
        '- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067' '#1055#1056#1048#1061#1054#1044', '#1061 +
        #1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102501271=            END'
      '1102501272='
      '1102501273=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102501274=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102501275=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102501276=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :AMOUNT'
      '1102501277=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102501278=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102501279='
      '1102501280='
      '1102501281=        END'
      '1102501282=      END'
      '1102501283='
      '1102501284=      ----------------------------------------'
      
        '1102501285=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1102501286=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1102501287=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1102501288='
      
        '1102501289=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1102501290=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1102501291=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1102501292=                PNT_ = '#39'05'#39';'
      
        '1102501293=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1102501294=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1102501295=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1102501296=                                              :Z_DATE' +
        '_,'
      
        '1102501297=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102501298=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1102501299=                                              NULL,'
      
        '1102501300=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1102501301=                                              :G_TOCH' +
        'KA_,'
      
        '1102501302=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102501303=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102501304=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102501305=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102501306=                  EXIT;'
      '1102501307=                END'
      '1102501308=            END'
      '1102501309='
      '1102501310=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1102501311=        END ELSE BEGIN'
      '1102501312=            PNT_ = '#39'06'#39';'
      
        '1102501313=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1102501314=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1102501315=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1102501316=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102501317=                ELSE'
      
        '1102501318=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102501319='
      
        '1102501320=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1102501321=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102501322='
      
        '1102501323=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102501324='
      '1102501325=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102501326=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102501327=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1102501328=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1102501329=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1102501330=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1102501331=                                                  :ZA' +
        'KAZ_,'
      
        '1102501332=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1102501333=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1102501334=                                                  :G_' +
        'TOCHKA_,'
      
        '1102501335=                                                  :UP' +
        'LOAD_TO_EXT_APP_'
      
        '1102501336=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102501337=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102501338=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1102501339=                      EXIT;'
      '1102501340=                    END'
      '1102501341=                END'
      '1102501342=            END'
      '1102501343=        END'
      '1102501344=      END'
      '1102501345='
      
        '1102501346=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1102501347=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1102501348=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1102501349=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1102501350=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1102501351=          UPDATE G_DISCONT_CARD D'
      
        '1102501352=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1102501353=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1102501354=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1102501355=          RETURNING'
      '1102501356=            D.SUMM_ALL'
      '1102501357=          INTO'
      '1102501358=            :CLIENT_SUMM_ALL_;'
      '1102501359='
      '1102501360=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1102501361=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1102501362=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1102501363=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1102501364=          ORDER BY G.SUMM_FROM'
      '1102501365=          ROWS 1 TO 1'
      '1102501366=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1102501367='
      '1102501368=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1102501369=            UPDATE G_CLIENT G'
      '1102501370=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1102501371=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1102501372=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1102501373='
      '1102501374=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1102501375=            UPDATE G_DISCONT_CARD D'
      '1102501376=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1102501377=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1102501378=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1102501379=      END'
      '1102501380='
      
        '1102501381=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' ' +
        #1057' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', ' +
        #1050#1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '1102501382=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057 +
        #1051#1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102501383=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102501384=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102501385=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102501386=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1102501387=      PNT_ = '#39'07'#39';'
      
        '1102501388=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THE' +
        'N BEGIN'
      '1102501389=        SELECT S.S_VALUE'
      '1102501390=          FROM SYSTEM_SETUP S'
      '1102501391=         WHERE S.SYSTEM_SETUP = 4'
      '1102501392=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102501393='
      '1102501394=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102501395=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102501396=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102501397='
      
        '1102501398=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1102501399=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1102501400=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1102501401='
      '1102501402=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102501403=        ELSE'
      
        '1102501404=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1102501405='
      '1102501406=        KASSA_ZP_ID_ = NULL;'
      '1102501407=        SELECT K.KASSA, K.SUMM'
      '1102501408=        FROM KASSA K'
      '1102501409=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1102501410=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102501411=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102501412=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102501413=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1102501414='
      
        '1102501415=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1102501416='
      '1102501417=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102501418=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102501419=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102501420=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1102501421=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1102501422=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1102501423=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1102501424=                                          NULL,     -' +
        '-:SKLAD_,'
      '1102501425=                                          1,'
      '1102501426=                                          :G_TOCHKA_,'
      
        '1102501427=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102501428=                                          :G_OFFICIAL' +
        '_'
      
        '1102501429=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1102501430=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102501431=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1102501432='
      '1102501433=        END ELSE BEGIN'
      
        '1102501434=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1102501435=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1102501436=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1102501437=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1102501438='
      
        '1102501439=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1102501440=                                          1,     -- A' +
        'CTION_'
      
        '1102501441=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102501442=                                          :SALES_COMM' +
        '_SUMM_ALL_,   --SUMM_'
      
        '1102501443=                                          :ACTION_DAT' +
        'E_ZP_,  -- ACTION_DATE_'
      
        '1102501444=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      
        '1102501445=                                          NULL,      ' +
        '        -- ZAKAZ_'
      
        '1102501446=                                          NULL,      ' +
        '        -- SKLAD_'
      
        '1102501447=                                          1,         ' +
        '        --:PAYMENT_TYPE_,'
      
        '1102501448=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102501449=                                          :G_OFFICIAL' +
        '_'
      
        '1102501450=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102501451='
      '1102501452=        END'
      '1102501453=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102501454=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102501455=          EXIT;'
      '1102501456=        END'
      '1102501457=      END */'
      '1102501458='
      
        '1102501459=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOA' +
        'D_TO_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040 +
        #1058#1053#1054' '#1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102501460=      IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_SPISANIE_ = ' +
        '0) THEN'
      
        '1102501461=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER, IS_LOADED_MOB)'
      
        '1102501462=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1, (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END));  ' +
        ' -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' CASE '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' '#1054#1041#1053#1054#1042#1051#1045#1053 +
        #1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102501463=  END'
      '1102501464=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102501465=  ----------------------------------------'
      '1102501466=  ----------------------------------------'
      '1102501467=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102501468=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1102501469=      PNT_ = '#39'25'#39';'
      
        '1102501470=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1102501471=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1102501472=      RETURNING ZAKAZ_REAL_PARENT'
      '1102501473=      INTO :ZAKAZ_REAL_PARENT_;'
      '1102501474='
      
        '1102501475=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1102501476=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102501477=          INTO :G_PRODUCT,'
      '1102501478=              :AMOUNT,'
      '1102501479=              :PRICE,'
      '1102501480=              :SUMM,'
      '1102501481=              :DISCOUNT_PERC,'
      '1102501482=              :DISCOUNT_TENGE,'
      '1102501483=              :DISCOUNT_SUMM,'
      '1102501484=              :NDS,'
      '1102501485=              :NDS_SUMM'
      '1102501486=      DO BEGIN'
      '1102501487=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102501488=          UPDATE LT_SKLAD_PRODUCT L'
      '1102501489=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102501490=                 L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_AP' +
        'P_'
      '1102501491=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102501492=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102501493='
      
        '1102501494=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102501495=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102501496=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1102501497=            Err_Code = -20500;'
      
        '1102501498=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102501499=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102501500=            EXIT;'
      '1102501501=          END ELSE if (ROW_COUNT = 0) then'
      
        '1102501502=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102501503=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102501504='
      
        '1102501505=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1102501506=                                     G_PRODUCT,'
      '1102501507=                                     PRICE,'
      
        '1102501508=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1102501509=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1102501510=                                     NDS_SUMM)'
      
        '1102501511=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1102501512=                  :G_PRODUCT,'
      
        '1102501513=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1102501514=                  :AMOUNT, :SUMM,'
      '1102501515=                  0, --AMOUNT_PAYED,'
      '1102501516=                  0, --SUMM_PAYED,'
      '1102501517=                  0, --IS_PAYED_ALL,'
      '1102501518=                  :DISCOUNT_PERC,'
      '1102501519=                  :DISCOUNT_TENGE,'
      '1102501520=                  :DISCOUNT_SUMM,'
      '1102501521=                  :NDS,'
      '1102501522=                  :NDS_SUMM)'
      '1102501523=          RETURNING ZAKAZ_NA_REAL'
      '1102501524=          INTO :ZAKAZ_;'
      '1102501525=      END'
      '1102501526=  END'
      '1102501527=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102501528=  ----------------------------------------'
      '1102501529=  ----------------------------------------'
      '1102501530=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1102501531=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1102501532=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102501533=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102501534=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1102501535=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102501536=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102501537=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102501538=      RETURNING SKLAD'
      '1102501539=      INTO :ZAKAZ_;'
      '1102501540='
      '1102501541=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102501542=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102501543=          INTO :G_PRODUCT,'
      '1102501544=              :AMOUNT,'
      '1102501545=              :PRICE,'
      '1102501546=              :SUMM'
      '1102501547=      DO BEGIN'
      '1102501548=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102501549=        UPDATE LT_SKLAD_PRODUCT L'
      '1102501550=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1102501551=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102501552=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102501553=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102501554='
      '1102501555=        IF (ROW_COUNT = 0) THEN'
      
        '1102501556=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102501557=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102501558='
      '1102501559=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102501560=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1102501561=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1102501562=        SELECT MAX(SK.DATE_RECEIPT)'
      '1102501563=            FROM SKLAD SK'
      '1102501564=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102501565=             AND SK.IS_LAST = 1'
      '1102501566=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1102501567=            INTO :DATE_LAST_;'
      '1102501568='
      
        '1102501569=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102501570=            UPDATE SKLAD SK'
      '1102501571=               SET SK.IS_LAST = 0'
      '1102501572=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102501573=               AND SK.IS_LAST = 1'
      '1102501574=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102501575='
      '1102501576=            IS_THIS_LAST_ = 1;'
      '1102501577=        END */'
      '1102501578='
      '1102501579='
      '1102501580=        INSERT INTO SKLAD'
      '1102501581=        ('
      '1102501582=         SKLAD,'
      '1102501583=         SKLAD_PARENT,'
      '1102501584=         DATE_RECEIPT,'
      '1102501585=         G_CLIENT,'
      '1102501586=         G_PRODUCT,'
      '1102501587=         AMOUNT,'
      '1102501588=         PRICE,'
      '1102501589=         SUMM,'
      '1102501590=         G_PAYMENT_TYPE,'
      '1102501591=         OSNOVANIE,'
      '1102501592=         NOTE,'
      '1102501593=         NDS,'
      '1102501594=         NDS_SUMM,'
      '1102501595=         IS_LAST,'
      '1102501596=         IS_VOZVRAT,'
      '1102501597=         G_TOCHKA'
      '1102501598=        ) VALUES ('
      '1102501599=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102501600=         :ZAKAZ_,'
      '1102501601=         :Z_DATE_,'
      '1102501602=         :G_TOCHKA_,'
      '1102501603=         :G_PRODUCT,'
      '1102501604=         :AMOUNT,'
      '1102501605=         :PRICE,'
      '1102501606=         :SUMM,'
      '1102501607=         :G_PAYMENT_TYPE_,'
      '1102501608=         :OSNOVANIE_,'
      '1102501609=         :NOTE_,'
      '1102501610=         0,  --:RNDS_,'
      '1102501611=         0,  --:RNDS_SUMM_,'
      
        '1102501612=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102501613=         3,  --:IS_VOZVRAT_,'
      '1102501614=         :G_CLIENT_'
      '1102501615=        );'
      '1102501616='
      
        '1102501617=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102501618=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102501619=        PNT_ = '#39'02'#39';'
      '1102501620=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102501621=            UPDATE LT_SKLAD_PRODUCT L'
      '1102501622=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102501623=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102501624=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102501625=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102501626='
      '1102501627=            IF (ROW_COUNT = 0) THEN'
      
        '1102501628=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102501629=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102501630=        END'
      '1102501631=      END'
      '1102501632=  END'
      '1102501633='
      '1102501634=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102501635='
      
        '1102501636=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102501637=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102501638=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102501639=                                  G_PRIHOD_,'
      '1102501640=                                  :SUMM_PRIHOD_,'
      '1102501641=                                  :Z_DATE_,'
      
        '1102501642=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102501643=                                  :ZAKAZ_,'
      '1102501644=                                  NULL,'
      '1102501645=                                  :G_PAYMENT_TYPE_,'
      '1102501646=                                  :G_TOCHKA_,'
      '1102501647=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102501648=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102501649=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102501650=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102501651=      EXIT;'
      '1102501652=    END'
      '1102501653=  END'
      '1102501654='
      
        '1102501655=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102501656=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102501657=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102501658=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102501659='
      '1102501660=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102501661=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102501662='
      '1102501663=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102501664=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102501665=end'
      '1102501666=;'
      '1102501667='
      '1102501668=ALTER PROCEDURE INV_GET_INVOICE('
      '1102501669=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '1102501670=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ)'
      '1102501671=RETURNS ('
      '1102501672=  NUM_ TYPE OF COLUMN INVOICE.NUM,'
      '1102501673=  INIT_DATE_ TYPE OF COLUMN INVOICE.INIT_DATE,'
      '1102501674=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1102501675=  POSTAVSHIK_ TYPE OF COLUMN INVOICE.POSTAVSHIK,'
      '1102501676=  IDN_ TYPE OF COLUMN INVOICE.IDN,'
      '1102501677=  ADDRESS_ TYPE OF COLUMN INVOICE.ADDRESS,'
      '1102501678=  IIK_ TYPE OF COLUMN INVOICE.IIK,'
      '1102501679=  AGREEMENT_ TYPE OF COLUMN INVOICE.AGREEMENT,'
      
        '1102501680=  G_PAYMENT_TYPE_ TYPE OF COLUMN INVOICE.G_PAYMENT_TY' +
        'PE,'
      
        '1102501681=  PUNKT_NAZNACHENIYA_ TYPE OF COLUMN INVOICE.PUNKT_NA' +
        'ZNACHENIYA,'
      '1102501682=  DOVERENNOST_ TYPE OF COLUMN INVOICE.DOVERENNOST,'
      
        '1102501683=  SPOSOB_OTPRAVKI_ TYPE OF COLUMN INVOICE.SPOSOB_OTPR' +
        'AVKI,'
      '1102501684=  NAKLADNAYA_ TYPE OF COLUMN INVOICE.NAKLADNAYA,'
      
        '1102501685=  GRUZOOTPRAVITEL_ TYPE OF COLUMN INVOICE.GRUZOOTPRAV' +
        'ITEL,'
      
        '1102501686=  GRUZOPOLUCHATEL_ TYPE OF COLUMN INVOICE.GRUZOPOLUCH' +
        'ATEL,'
      
        '1102501687=  ADDRESS_POLUCHATELYA_ TYPE OF COLUMN INVOICE.ADDRES' +
        'S_POLUCHATELYA,'
      '1102501688=  G_CLIENT_ TYPE OF COLUMN INVOICE.G_CLIENT,'
      '1102501689=  CLIENT_NAME_ TYPE OF COLUMN INVOICE.CLIENT_NAME,'
      '1102501690=  IDN_CLIENT_ TYPE OF COLUMN INVOICE.IDN_CLIENT,'
      
        '1102501691=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE.ADDRESS_P' +
        'OKUPATEL,'
      '1102501692=  IIK_CLIENT_ TYPE OF COLUMN INVOICE.IIK_CLIENT,'
      
        '1102501693=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN INVOICE.G_OFFICI' +
        'AL_RUKOVOD,'
      
        '1102501694=  G_OFFICIAL_GB_ TYPE OF COLUMN INVOICE.G_OFFICIAL_GB' +
        ','
      '1102501695=  G_OFFICIAL_ TYPE OF COLUMN INVOICE.G_OFFICIAL,'
      '1102501696=  ZAKAZ_SAVED_ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1102501697=  ERR_CODE INTEGER,'
      '1102501698=  ERR_MSG VARCHAR(1024))'
      '1102501699=AS'
      
        '1102501700=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INV_GET_INV' +
        'OICE'#39';'
      '1102501701=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102501702=BEGIN'
      '1102501703=  SELECT'
      '1102501704=    t.NUM,'
      '1102501705=    t.INIT_DATE,'
      '1102501706=    T.G_FIRM,'
      '1102501707=    t.POSTAVSHIK,'
      '1102501708=    t.IDN,'
      '1102501709=    t.ADDRESS,'
      '1102501710=    t.IIK,'
      '1102501711=    t.AGREEMENT,'
      '1102501712=    t.G_PAYMENT_TYPE,'
      '1102501713=    t.PUNKT_NAZNACHENIYA,'
      '1102501714=    t.DOVERENNOST,'
      '1102501715=    t.SPOSOB_OTPRAVKI,'
      '1102501716=    t.NAKLADNAYA,'
      '1102501717=    t.GRUZOOTPRAVITEL,'
      '1102501718=    t.GRUZOPOLUCHATEL,'
      '1102501719=    t.ADDRESS_POLUCHATELYA,'
      '1102501720=    t.G_CLIENT,'
      '1102501721=    T.CLIENT_NAME,'
      '1102501722=    t.IDN_CLIENT,'
      '1102501723=    t.ADDRESS_POKUPATEL,'
      '1102501724=    t.IIK_CLIENT,'
      '1102501725=    t.G_OFFICIAL_RUKOVOD,'
      '1102501726=    t.G_OFFICIAL_GB,'
      '1102501727=    t.G_OFFICIAL,'
      '1102501728=    t.ZAKAZ'
      '1102501729=  FROM invoice t'
      '1102501730=  WHERE'
      '1102501731=    t.invoice = :invoice_'
      '1102501732=  INTO'
      '1102501733=    :NUM_,'
      '1102501734=    :INIT_DATE_,'
      '1102501735=    :G_FIRM_,'
      '1102501736=    :POSTAVSHIK_,'
      '1102501737=    :IDN_,'
      '1102501738=    :ADDRESS_,'
      '1102501739=    :IIK_,'
      '1102501740=    :AGREEMENT_,'
      '1102501741=    :G_PAYMENT_TYPE_,'
      '1102501742=    :PUNKT_NAZNACHENIYA_,'
      '1102501743=    :DOVERENNOST_,'
      '1102501744=    :SPOSOB_OTPRAVKI_,'
      '1102501745=    :NAKLADNAYA_,'
      '1102501746=    :GRUZOOTPRAVITEL_,'
      '1102501747=    :GRUZOPOLUCHATEL_,'
      '1102501748=    :ADDRESS_POLUCHATELYA_,'
      '1102501749=    :G_CLIENT_,'
      '1102501750=    :CLIENT_NAME_,'
      '1102501751=    :IDN_CLIENT_,'
      '1102501752=    :ADDRESS_POKUPATEL_,'
      '1102501753=    :IIK_CLIENT_,'
      '1102501754=    :G_OFFICIAL_RUKOVOD_,'
      '1102501755=    :G_OFFICIAL_GB_,'
      '1102501756=    :G_OFFICIAL_,'
      '1102501757=    :ZAKAZ_SAVED_;'
      '1102501758='
      '1102501759=  IF (ROW_COUNT = 0) then BEGIN'
      
        '1102501760=    --***********************************************' +
        '***'
      
        '1102501761=    -- '#1047#1053#1040#1063#1048#1058' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1040' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045 +
        ' '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1102501762=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1102501763=    SELECT'
      '1102501764=      G.g_firm_rekvizIT,'
      
        '1102501765=      G.NAME, --DECODE(G.IP_OR_JUR, 0, '#39#1048#1085#1076#1080#1074#1080#1076#1091#1072#1083#1100#1085#1099 +
        #1081' '#1087#1088#1077#1076#1087#1088#1080#1085#1080#1084#1072#1090#1077#1083#1100' '#39', '#39#1058#1054#1054' '#39')||G.NAME,'
      '1102501766=      G.IDN,'
      '1102501767=      AD.G_ADDRESS,'
      '1102501768=      AC.G_ACCOUNT,'
      
        '1102501769=      DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39': '#39'||' +
        'G.IDN||'#39', '#39'||G.NAME||'#39', '#39'||AD.ADDRESS'
      '1102501770=    FROM G_FIRM_REKVIZIT g'
      '1102501771=           LEFT OUTER JOIN (SELECT *'
      '1102501772=                              FROM G_FIRM_ADDRESS F'
      
        '1102501773=                             WHERE F.IS_DEFAULT = 1) ' +
        'AD ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT'
      '1102501774=           LEFT OUTER JOIN (SELECT A.G_ACCOUNT,'
      '1102501775=                                   A.ACCOUNT,'
      '1102501776=                                   A.G_FIRM_REKVIZIT,'
      '1102501777=                                   A.G_BANK,'
      '1102501778=                                   B.BIK, B.NAME'
      '1102501779=                              FROM G_FIRM_ACCOUNT A,'
      '1102501780=                                   G_BANK B'
      
        '1102501781=                             WHERE A.G_BANK = B.G_BAN' +
        'K'
      
        '1102501782=                               AND A.IS_DEFAULT = 1) ' +
        'AC ON G.G_FIRM_REKVIZIT = AC.G_FIRM_REKVIZIT'
      '1102501783=    WHERE G.IS_DEFAULT = 1'
      '1102501784=    INTO'
      '1102501785=      :g_firm_,'
      '1102501786=      :POSTAVSHIK_,'
      '1102501787=      :IDN_,'
      '1102501788=      :ADDRESS_,'
      '1102501789=      :IIK_,'
      '1102501790=      :GRUZOOTPRAVITEL_;'
      '1102501791='
      '1102501792=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '1102501793=    SELECT'
      '1102501794=      Z.Z_DATE,'
      '1102501795=      C.G_CLIENT,'
      
        '1102501796=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')), ' +
        '0, C.NAME, c.name_FULL),'
      '1102501797=      C.IDN,'
      '1102501798=      AD.G_ADDRESS,'
      
        '1102501799=      DECODE(CHAR_LENGTH(COALESCE(Z.OSNOVANIE, '#39#39')), ' +
        '0,'
      
        '1102501800=        DECODE(CHAR_LENGTH(COALESCE(C.DOGOVOR, '#39#39')), ' +
        '0, '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39', C.DOGOVOR || '#39' '#1086#1090' '#39' ||'
      
        '1102501801=          lpad(EXTRACT(DAY FROM C.DOGOVOR_DATE), 2, '#39 +
        '0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM C.DOGOVOR_DATE), 2, '#39'0'#39')||'
      '1102501802=          '#39'.'#39'||EXTRACT(YEAR FROM C.DOGOVOR_DATE)),'
      '1102501803=        Z.OSNOVANIE'
      '1102501804=      ),'
      '1102501805=      Z.G_PAYMENT_TYPE,'
      '1102501806=      AD.ADDRESS,'
      '1102501807=      AD.ADDRESS,'
      '1102501808=      '#39#1041#1077#1079' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080#39','
      '1102501809=      '#39#1057#1072#1084#1086#1074#1099#1074#1086#1079#39','
      
        '1102501810=      DECODE(CHAR_LENGTH(TRIM(C.IDN)), 0, '#39#39', '#39#1048#1048#1053'/'#1041#1048 +
        #1053': '#39'||TRIM(C.IDN)||'#39', '#39')||DECODE(CHAR_LENGTH(TRIM(COALESCE(C.NAM' +
        'E_FULL, '#39#39'))), 0, C.NAME, TRIM(C.NAME_FULL))||COALESCE('#39', '#39'||AD.' +
        'ADDRESS, '#39#39'),'
      '1102501811=      COALESCE(AC.G_ACCOUNT, null)'
      '1102501812=    FROM ZAKAZ Z LEFT OUTER JOIN (SELECT *'
      '1102501813=                                    FROM G_ADDRESS G'
      
        '1102501814=                                   WHERE G.IS_DEFAULT' +
        ' = 1) AD ON Z.G_CLIENT = AD.G_CLIENT'
      '1102501815=                 LEFT OUTER JOIN (SELECT *'
      '1102501816=                                    FROM G_ACCOUNT G'
      
        '1102501817=                                   WHERE G.IS_DEFAULT' +
        ' = 1) AC ON Z.G_CLIENT = AC.G_CLIENT,'
      '1102501818=         G_CLIENT C'
      '1102501819=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102501820=      AND Z.G_CLIENT = C.G_CLIENT'
      '1102501821=    INTO'
      '1102501822=      :INIT_DATE_,'
      '1102501823=      :G_CLIENT_,'
      '1102501824=      :CLIENT_NAME_,'
      '1102501825=      :IDN_CLIENT_,'
      '1102501826=      :ADDRESS_POKUPATEL_,'
      '1102501827=      :AGREEMENT_,'
      '1102501828=      :G_PAYMENT_TYPE_,'
      '1102501829=      :PUNKT_NAZNACHENIYA_,'
      '1102501830=      :ADDRESS_POLUCHATELYA_,'
      '1102501831=      :DOVERENNOST_,'
      '1102501832=      :SPOSOB_OTPRAVKI_,'
      '1102501833=      :GRUZOPOLUCHATEL_,'
      '1102501834=      :IIK_CLIENT_;'
      '1102501835='
      
        '1102501836=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058 +
        #1054#1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '1102501837=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054 +
        ' '#1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '1102501838=    PNT_ = '#39'05'#39';'
      '1102501839=    SELECT C.id'
      '1102501840=      FROM cur_params C'
      '1102501841=     WHERE C.cur_params = 1'
      '1102501842=    INTO :G_OFFICIAL_;'
      '1102501843='
      '1102501844=    IF (ROW_COUNT = 0) then BEGIN'
      '1102501845=        SELECT MIN(O.G_OFFICIAL)'
      '1102501846=          FROM G_OFFICIAL O'
      '1102501847=          INTO :G_OFFICIAL_;'
      '1102501848=        IF (ROW_COUNT = 0) then BEGIN'
      '1102501849=            Err_Code = -20500;'
      
        '1102501850=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1057#1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '1102501851=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102501852=            EXIT;'
      '1102501853=        END'
      '1102501854=    END'
      '1102501855='
      '1102501856=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '1102501857=    SELECT O.G_OFFICIAL'
      '1102501858=    FROM G_OFFICIAL O'
      '1102501859=    WHERE O.IS_RUKOVODITEL = 1'
      '1102501860=    INTO :G_OFFICIAL_RUKOVOD_;'
      '1102501861='
      '1102501862=    --'#1048#1065#1059' '#1043#1051#1040#1042#1041#1059#1061#1040
      '1102501863=    SELECT O.G_OFFICIAL'
      '1102501864=    FROM G_OFFICIAL O'
      '1102501865=    WHERE O.IS_GLAVBUH = 1'
      '1102501866=    INTO :G_OFFICIAL_GB_;'
      '1102501867='
      
        '1102501868=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059', '#1057#1053#1040#1063#1040#1051#1040 +
        ' '#1057#1044#1045#1051#1040#1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '1102501869=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '1102501870=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VA' +
        'RCHAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '1102501871=      FROM INVOICE P'
      
        '1102501872=     WHERE EXTRACT(YEAR FROM P.INIT_DATE) = EXTRACT(Y' +
        'EAR FROM :INIT_DATE_)'
      
        '1102501873=       AND ((SELECT * FROM IS_NUMERIC(P.NUM)) <> -999' +
        ')  -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070' '#1058#1054#1051#1068#1050#1054' '#1062#1048#1060#1056#1054#1042#1067#1045' '#1053#1054#1052#1045#1056#1040
      '1102501874=      INTO :NUM_;'
      '1102501875='
      
        '1102501876=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059 +
        ' '#1042#1054#1054#1041#1065#1045' '#1053#1045#1058
      '1102501877=      NUM_ = '#39'1'#39';'
      '1102501878=  END'
      '1102501879=END'
      '1102501880=;'
      '1102501881='
      '1102501882=ALTER PROCEDURE INV_GET_INVOICE_PAY('
      
        '1102501883=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY' +
        ','
      '1102501884=  ZAKAZ_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ)'
      '1102501885=RETURNS ('
      '1102501886=  INIT_DATE_ TYPE OF COLUMN INVOICE_PAY.INIT_DATE,'
      '1102501887=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1102501888=  POSTAVSHIK_ TYPE OF COLUMN INVOICE_PAY.POSTAVSHIK,'
      '1102501889=  IDN_ TYPE OF COLUMN INVOICE_PAY.IDN,'
      '1102501890=  ADDRESS_ TYPE OF COLUMN INVOICE_PAY.ADDRESS,'
      '1102501891=  IIK_ TYPE OF COLUMN INVOICE_PAY.IIK,'
      '1102501892=  BANK_NAME_ TYPE OF COLUMN INVOICE_PAY.BANK_NAME,'
      '1102501893=  BIK_ TYPE OF COLUMN INVOICE_PAY.BIK,'
      '1102501894=  KBE_ TYPE OF COLUMN INVOICE_PAY.KBE,'
      '1102501895=  KNP_ TYPE OF COLUMN INVOICE_PAY.KNP,'
      '1102501896=  G_CLIENT_ID_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102501897=  G_CLIENT_ TYPE OF COLUMN INVOICE_PAY.G_CLIENT,'
      '1102501898=  IDN_CLIENT_ TYPE OF COLUMN INVOICE_PAY.IDN_CLIENT,'
      
        '1102501899=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE_PAY.ADDRE' +
        'SS_POKUPATEL,'
      '1102501900=  AGREEMENT_ TYPE OF COLUMN INVOICE_PAY.AGREEMENT,'
      '1102501901=  G_OFFICIAL_ TYPE OF COLUMN INVOICE_PAY.G_OFFICIAL,'
      '1102501902=  NUM_ TYPE OF COLUMN INVOICE_PAY.NUM,'
      '1102501903=  ZAKAZ_SAVED_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ,'
      '1102501904=  ERR_CODE INTEGER,'
      '1102501905=  ERR_MSG VARCHAR(1024))'
      '1102501906=AS'
      
        '1102501907=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INV_GET_INV' +
        'OICE_PAY'#39';'
      '1102501908=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102501909=BEGIN'
      '1102501910=  SELECT'
      '1102501911=    t.INIT_DATE,'
      '1102501912=    T.G_FIRM,'
      '1102501913=    t.POSTAVSHIK,'
      '1102501914=    t.IDN,'
      '1102501915=    t.ADDRESS,'
      '1102501916=    t.IIK,'
      '1102501917=    t.BANK_NAME,'
      '1102501918=    t.BIK,'
      '1102501919=    t.KBE,'
      '1102501920=    t.KNP,'
      '1102501921=    t.G_CLIENT,'
      '1102501922=    t.IDN_CLIENT,'
      '1102501923=    t.ADDRESS_POKUPATEL,'
      '1102501924=    t.AGREEMENT,'
      '1102501925=    t.G_OFFICIAL,'
      '1102501926=    t.ZAKAZ,'
      '1102501927=    t.NUM,'
      '1102501928=    G.g_client'
      
        '1102501929=  FROM invoice_pay t LEFT OUTER JOIN g_address G ON T' +
        '.address_pokupatel = G.g_address'
      '1102501930=  WHERE t.invoice_pay = :invoice_pay_'
      '1102501931=  INTO'
      '1102501932=    INIT_DATE_,'
      '1102501933=    G_FIRM_,'
      '1102501934=    POSTAVSHIK_,'
      '1102501935=    IDN_,'
      '1102501936=    ADDRESS_,'
      '1102501937=    IIK_,'
      '1102501938=    BANK_NAME_,'
      '1102501939=    BIK_,'
      '1102501940=    KBE_,'
      '1102501941=    KNP_,'
      '1102501942=    G_CLIENT_,'
      '1102501943=    IDN_CLIENT_,'
      '1102501944=    ADDRESS_POKUPATEL_,'
      '1102501945=    AGREEMENT_,'
      '1102501946=    G_OFFICIAL_,'
      '1102501947=    ZAKAZ_SAVED_,'
      '1102501948=    NUM_,'
      '1102501949=    G_CLIENT_ID_;'
      '1102501950='
      '1102501951=  IF (ROW_COUNT = 0) then BEGIN'
      
        '1102501952=    --***********************************************' +
        '***'
      
        '1102501953=    -- '#1047#1053#1040#1063#1048#1058' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1040' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045 +
        ' '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1102501954=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1102501955=    SELECT'
      '1102501956=      G.g_firm_rekvizit,'
      '1102501957=      G.NAME,'
      '1102501958=      G.IDN,'
      '1102501959=      AD.G_ADDRESS,'
      '1102501960=      AC.G_ACCOUNT,'
      '1102501961=      AC.NAME,'
      '1102501962=      AC.BIK,'
      '1102501963=      G.KBE'
      '1102501964=    FROM G_FIRM_REKVIZIT g LEFT OUTER JOIN'
      '1102501965=         (SELECT A.G_ACCOUNT,'
      '1102501966=                 A.ACCOUNT,'
      '1102501967=                 A.G_FIRM_REKVIZIT,'
      '1102501968=                 A.G_BANK,'
      '1102501969=                 B.BIK, B.NAME'
      '1102501970=            FROM G_FIRM_ACCOUNT A,'
      '1102501971=                 G_BANK B'
      '1102501972=           WHERE A.G_BANK = B.G_BANK'
      
        '1102501973=             AND A.IS_DEFAULT = 1) AC ON G.G_FIRM_REK' +
        'VIZIT = AC.G_FIRM_REKVIZIT'
      '1102501974=         LEFT OUTER JOIN (SELECT *'
      '1102501975=                            FROM G_FIRM_ADDRESS F'
      
        '1102501976=                           WHERE F.IS_DEFAULT = 1) AD' +
        ' ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT'
      '1102501977=    WHERE G.IS_DEFAULT = 1'
      '1102501978=    INTO'
      '1102501979=      :g_firm_,'
      '1102501980=      :POSTAVSHIK_,'
      '1102501981=      :IDN_,'
      '1102501982=      :ADDRESS_,'
      '1102501983=      :IIK_,'
      '1102501984=      :BANK_NAME_,'
      '1102501985=      :BIK_,'
      '1102501986=      :KBE_;'
      '1102501987='
      '1102501988=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '1102501989=    SELECT'
      '1102501990=      Z.Z_DATE,'
      
        '1102501991=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')), ' +
        '0, C.NAME, c.name_FULL),'
      '1102501992=      C.IDN,'
      '1102501993=      C.g_client,'
      '1102501994=      C.name,'
      '1102501995=      AD.G_ADDRESS,'
      
        '1102501996=      DECODE(CHAR_LENGTH(COALESCE(Z.OSNOVANIE, '#39#39')), ' +
        '0,'
      
        '1102501997=        DECODE(CHAR_LENGTH(COALESCE(C.DOGOVOR, '#39#39')), ' +
        '0, '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39', C.DOGOVOR || '#39' '#1086#1090' '#39' ||'
      
        '1102501998=          lpad(EXTRACT(DAY FROM C.DOGOVOR_DATE), 2, '#39 +
        '0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM C.DOGOVOR_DATE), 2, '#39'0'#39')||'
      '1102501999=          '#39'.'#39'||EXTRACT(YEAR FROM C.DOGOVOR_DATE)),'
      '1102502000=        Z.OSNOVANIE'
      '1102502001=      )'
      '1102502002=    FROM ZAKAZ Z,'
      '1102502003=         G_CLIENT C LEFT OUTER JOIN'
      '1102502004=         (SELECT *'
      '1102502005=            FROM G_ADDRESS G'
      
        '1102502006=           WHERE G.IS_DEFAULT = 1) AD ON C.G_CLIENT =' +
        ' AD.G_CLIENT'
      '1102502007=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102502008=     AND Z.G_CLIENT = C.G_CLIENT'
      '1102502009=    INTO'
      '1102502010=      :INIT_DATE_,'
      '1102502011=      :G_CLIENT_,'
      '1102502012=      :IDN_CLIENT_,'
      '1102502013=      :G_CLIENT_ID_,'
      '1102502014=      :g_client_,'
      '1102502015=      :ADDRESS_POKUPATEL_,'
      '1102502016=      :AGREEMENT_;'
      '1102502017='
      
        '1102502018=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058 +
        #1054#1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '1102502019=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054 +
        ' '#1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '1102502020=    PNT_ = '#39'05'#39';'
      '1102502021=    SELECT C.id'
      '1102502022=      FROM cur_params C'
      '1102502023=     WHERE C.cur_params = 1'
      '1102502024=    INTO :G_OFFICIAL_;'
      '1102502025='
      '1102502026=    IF (ROW_COUNT = 0) then BEGIN'
      '1102502027=        SELECT MIN(O.G_OFFICIAL)'
      '1102502028=          FROM G_OFFICIAL O'
      '1102502029=          INTO :G_OFFICIAL_;'
      '1102502030=        IF (ROW_COUNT = 0) then BEGIN'
      '1102502031=            Err_Code = -20500;'
      
        '1102502032=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1057#1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '1102502033=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102502034=            EXIT;'
      '1102502035=        END'
      '1102502036=    END'
      '1102502037='
      
        '1102502038=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059', '#1057#1053#1040#1063#1040#1051#1040 +
        ' '#1057#1044#1045#1051#1040#1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '1102502039=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '1102502040=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VA' +
        'RCHAR(20)) -- NVL '#1055#1054#1057#1058#1040#1042#1048#1051
      '1102502041=      FROM INVOICE_PAY P'
      
        '1102502042=     WHERE EXTRACT(YEAR FROM P.INIT_DATE) = EXTRACT(Y' +
        'EAR FROM :INIT_DATE_)'
      
        '1102502043=       AND ((SELECT * FROM IS_NUMERIC(P.NUM)) <> -999' +
        ')  -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070' '#1058#1054#1051#1068#1050#1054' '#1062#1048#1060#1056#1054#1042#1067#1045' '#1053#1054#1052#1045#1056#1040
      '1102502044=    INTO :NUM_;'
      '1102502045='
      
        '1102502046=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059 +
        ' '#1042#1054#1054#1041#1065#1045' '#1053#1045#1058
      '1102502047=      NUM_ = '#39'1'#39';'
      '1102502048=  END'
      '1102502049=END'
      '1102502050=;'
      '1102502051='
      '1102502052=ALTER PROCEDURE IS_NUMERIC('
      '1102502053=  VAL_ VARCHAR(50))'
      '1102502054=RETURNS ('
      '1102502055=  DBLVAL_ DM_BIGINT)'
      '1102502056=AS'
      '1102502057=BEGIN'
      '1102502058=  BEGIN'
      '1102502059=      DBLVAL_ = CAST(VAL_ AS DM_BIGINT);'
      '1102502060=  WHEN ANY DO'
      '1102502061=      DBLVAL_ = -999;'
      '1102502062=  END'
      '1102502063='
      '1102502064=  SUSPEND;'
      '1102502065=END'
      '1102502066=;'
      '1102502067='
      '1102502068=ALTER PROCEDURE LOG_INIT'
      '1102502069=AS'
      '1102502070=DECLARE VARIABLE TN VARCHAR(64);'
      '1102502071=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '1102502072=DECLARE VARIABLE FN VARCHAR(64);'
      '1102502073=DECLARE VARIABLE TP INTEGER;'
      
        '1102502074=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102502075=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102502076=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102502077=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80; /* VARCHAR(30000); */'
      '1102502078=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '1102502079=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '1102502080=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '1102502081=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000) */'
      
        '1102502082=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      
        '1102502083=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      '1102502084=DECLARE VARIABLE ANZ INTEGER;'
      '1102502085=DECLARE VARIABLE L INTEGER;'
      '1102502086=DECLARE VARIABLE P INTEGER;'
      '1102502087=DECLARE VARIABLE S INTEGER;'
      '1102502088=DECLARE VARIABLE FT CHAR(1);'
      '1102502089=DECLARE VARIABLE CRLF VARCHAR(10);'
      '1102502090=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '1102502091=BEGIN'
      '1102502092=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '1102502093='
      '1102502094=  TN_ALT='#39#39';'
      '1102502095=  TRGI='#39#39';'
      '1102502096=  TRGU='#39#39';'
      '1102502097=  TRGD='#39#39';'
      '1102502098=  TRGIX='#39#39';'
      '1102502099=  TRGUX='#39#39';'
      '1102502100=  TRGDX='#39#39';'
      '1102502101=  SQLF='#39#39';'
      '1102502102=  SQLV='#39#39';'
      '1102502103=  SQLU='#39#39';'
      '1102502104=  FT='#39#39';'
      '1102502105='
      '1102502106=  FOR SELECT R.RDB$RELATION_NAME,'
      '1102502107=            R.RDB$FIELD_NAME,'
      '1102502108=            F.RDB$FIELD_TYPE,'
      '1102502109=            F.RDB$FIELD_LENGTH,'
      '1102502110=            F.RDB$FIELD_PRECISION,'
      '1102502111=            F.RDB$FIELD_SCALE'
      '1102502112=        FROM RDB$RELATION_FIELDS R,'
      '1102502113=             RDB$FIELDS F'
      '1102502114=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1102502115=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '1102502116=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '1102502117=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39 +
        ', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '1102502118=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1102502119=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1102502120=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1102502121=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1102502122=                                         '#39'RIGHTS_ITEM' +
        #39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1102502123=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PRO' +
        'DUCT_FILL'#39','
      
        '1102502124=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39','#39'REVISION_TMP'#39','#39'UPLOAD_T' +
        'ABLE_TMP'#39','
      
        '1102502125=                                         '#39'KASPI_CITY'#39 +
        ','#39'KASPI_POINT'#39')'
      '1102502126=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '1102502127=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '1102502128=              OR'
      
        '1102502129=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD' +
        '_SUB_TYPE <> 0)'
      '1102502130=             )'
      
        '1102502131=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSIT' +
        'ION'
      '1102502132=        INTO :TN,:FN,:TP,:L,:P,:S'
      '1102502133=  DO BEGIN'
      '1102502134=    TN=TRIM(TN);'
      '1102502135=    FN=TRIM(FN);'
      '1102502136=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '1102502137=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '1102502138=      EXECUTE STATEMENT TRGI;'
      '1102502139=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '1102502140=      EXECUTE STATEMENT TRGU;'
      '1102502141=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '1102502142=      EXECUTE STATEMENT TRGD;'
      '1102502143='
      '1102502144=      SQLF='#39#39';'
      '1102502145=      SQLV='#39#39';'
      '1102502146=      SQLU='#39#39';'
      '1102502147=    END'
      '1102502148=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '1102502149=      ID_COLUMN = FN;'
      '1102502150='
      '1102502151=    S=-S;'
      
        '1102502152=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp' +
        '=27)) then'
      '1102502153=      ft='#39'N'#39';   --numerisch'
      '1102502154=    else'
      '1102502155=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '1102502156=        ft='#39'Z'#39';   --zeit'
      '1102502157=      else'
      '1102502158=        ft='#39'T'#39';'
      '1102502159='
      '1102502160=    IF (SQLF='#39#39') THEN'
      '1102502161=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '1102502162=    ELSE'
      '1102502163=      SQLF=SQLF||'#39','#39'||FN;'
      '1102502164='
      '1102502165=    if (ft='#39'N'#39') then begin'
      '1102502166=      IF (SQLV='#39#39') THEN'
      
        '1102502167=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102502168=      ELSE'
      
        '1102502169=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102502170='
      '1102502171=      IF (SQLU='#39#39') THEN'
      
        '1102502172=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UP' +
        'DATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102502173=      ELSE'
      
        '1102502174=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'|' +
        '|FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102502175=    end'
      '1102502176=    else'
      '1102502177=      if (ft='#39'Z'#39') then begin'
      '1102502178=        IF (SQLV='#39#39') THEN'
      
        '1102502179=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||r' +
        'eplace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102502180=        ELSE'
      
        '1102502181=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||r' +
        'eplace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102502182='
      '1102502183=        IF (SQLU='#39#39') THEN'
      
        '1102502184=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39 +
        'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRI' +
        'M(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39 +
        #39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102502185=        ELSE'
      
        '1102502186=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39',' +
        #39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39 +
        #39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF' +
        ';'
      '1102502187=    end'
      '1102502188=    else begin'
      '1102502189=      IF (SQLV='#39#39') THEN'
      
        '1102502190=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||rep' +
        'lace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CR' +
        'LF;'
      '1102502191=      ELSE'
      
        '1102502192=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||rep' +
        'lace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CR' +
        'LF;'
      '1102502193='
      '1102502194=      IF (SQLU='#39#39') THEN'
      
        '1102502195=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UP' +
        'DATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39 +
        #39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102502196=      ELSE'
      
        '1102502197=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'|' +
        '|FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1102502198=    end'
      '1102502199=    SELECT COUNT(*)'
      '1102502200=      FROM RDB$TRIGGERS'
      '1102502201=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGI'#39
      '1102502202=      INTO :ANZ;'
      '1102502203='
      '1102502204=    IF (ANZ>0) THEN'
      '1102502205=      TRGIX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGI'#39';'
      '1102502206=    ELSE'
      '1102502207=      TRGIX='#39#39';'
      '1102502208='
      
        '1102502209=    TRGI='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGI FOR '#39'||TN||'#39' A' +
        'CTIVE AFTER INSERT POSITION 255 AS '#39'||CRLF||'
      
        '1102502210=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SE' +
        'GMENT SIZE 80;'#39'||CRLF||'
      '1102502211=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '1102502212=         '#39'DECLARE VARIABLE IDS_ BIGINT;'#39'||CRLF||'
      '1102502213=         '#39'BEGIN'#39'||CRLF||'
      
        '1102502214=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39 +
        'REPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39' ||CRLF;'
      '1102502215='
      '1102502216=    IF (TN = '#39'LT_SKLAD_PRODUCT'#39') THEN BEGIN'
      '1102502217='
      
        '1102502218=      /*19.08.2021 '#1050#1054#1056#1054#1063#1045' '#1050#1040#1050' '#1041#1067' '#1071' '#1053#1048' '#1057#1058#1040#1056#1040#1051#1057#1071' - '#1042#1057#1045' ' +
