      '11015747=    G_CLIENT DM_BIGINT NOT NULL,'
      '11015748=    PHONE_NUMBER VR_50,'
      '11015749=    TEXT VARCHAR(500),'
      '11015750=    G_SMS_STATUS INTEGER,'
      '11015751=    SMS_ID DM_INTEGER,'
      '11015752=    ERROR DM_INTEGER);'
      '11015753='
      '11015754='
      
