        '1102503676=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1102503677=                                                  NUL' +
        'L,'
      
        '1102503678=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1102503679=                                                  :G_' +
        'TOCHKA_,'
      
        '1102503680=                                                  :UP' +
        'LOAD_TO_EXT_APP_'
      
        '1102503681=                                                  ) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102503682='
      
        '1102503683=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102503684=                END ELSE BEGIN'
      
        '1102503685=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102503686=                    SELECT 1'
      '1102503687=                      FROM KASSA K'
