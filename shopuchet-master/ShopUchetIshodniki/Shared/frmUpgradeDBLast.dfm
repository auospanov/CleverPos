      '110751400=        INTO :INPUT_;'
      '110751401='
      '110751402=        if (ROW_COUNT = 0) then'
      
        '110751403=          INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040 +
        #1071' '#1047#1040#1055#1048#1057#1068
