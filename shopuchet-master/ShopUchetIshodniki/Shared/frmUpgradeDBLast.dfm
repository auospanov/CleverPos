      '11015824=  IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '11015825=    ERR_CODE = -20500;'
      
        '11015826=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093#1082#1086#1076' '#1087 +
        #1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '11015827=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11015828=    EXIT;'
      '11015829=  END'
      '11015830='
      
        '11015831=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) THE' +
        'N BEGIN'
      '11015832=        SELECT T.G_PRODUCT_PAR,'
      '11015833=               T.G_PRODUCT,'
      '11015834=               T.PRICE,'
      '11015835=               T.VOLUME_PRICE,'
      '11015836=               T.IS_KIT,'
      '11015837=               T.IS_MARKED'
      '11015838=          FROM G_PRODUCT T'
      
        '11015839=          WHERE SUBSTRING(T.BARCODE FROM 3 FOR 5) = SUB' +
        'STRING(:BARCODE_ FROM 3 FOR 5)'
      '11015840=            AND T.IS_ACTIVE = 1'
      '11015841=          INTO :G_PRODUCT_CATEGORY_,'
      '11015842=               :G_PRODUCT_,'
      '11015843=               :PRICE_,'
      '11015844=               :VOLUME_PRICE_,'
      '11015845=               :IS_KIT_,'
      '11015846=               :IS_MARKED_;'
      '11015847='
      
        '11015848=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM 8 ' +
        'FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '11015849=    END ELSE'
      '11015850=        SELECT T.G_PRODUCT_PAR,'
      '11015851=               T.G_PRODUCT,'
      '11015852=               T.PRICE,'
      '11015853=               T.VOLUME_PRICE,'
