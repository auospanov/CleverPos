        'ORY POSITION 15;'
      '1108876='
      
        '1108877=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN TOVAR_NA' +
        'ME POSITION 16;'
      '1108878='
      
        '1108879=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN SORT_COL' +
        ' POSITION 17;'
      '1108880='
      
        '1108881=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN NOTE POS' +
        'ITION 18;'
      '1108882='
      
        '1108883=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN CROSSCOD' +
        'E POSITION 19;'
      '1108884='
      
        '1108885=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN PLACE PO' +
        'SITION 20;'
      '1108886='
      '1108887='
      
        '1108888=/*******************************************************' +
