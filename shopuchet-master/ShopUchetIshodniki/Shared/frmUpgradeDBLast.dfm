        '************************/'
      '11016668=ALTER PROCEDURE G_GET_DCARD_BY_CODE('
      
        '11016669=  G_DISCONT_CARD_ TYPE OF COLUMN G_DISCONT_CARD.G_DISCO' +
        'NT_CARD,'
      '11016670=  CARD_CODE_ VARCHAR(13))'
      '11016671=RETURNS ('
      '11016672=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11016673=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11016674=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11016675=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11016676=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '11016677=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '11016678=  LAST_PURCHASE_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11016679=  ERR_CODE INTEGER,'
      '11016680=  ERR_MSG VARCHAR(1024))'
      '11016681=AS'
      '11016682=/**/'
      
        '11016683=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_GET_DCARD_BY' +
        '_CODE'#39';'
      '11016684=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11016685=BEGIN'
      '11016686=  SELECT'
      '11016687=    C.G_CLIENT,'
      '11016688=    C.NAME,'
      '11016689=    D.BARCODE,'
      '11016690=    D.N_PERCENT,'
      '11016691=    D.SUMM,'
      '11016692=    D.SUMM_ALL'
      '11016693=  FROM G_DISCONT_CARD D, G_CLIENT C'
      '11016694=  WHERE ('
      
        '11016695=            ((BARCODE = :CARD_CODE_ AND CHAR_LENGTH(:CA' +
        'RD_CODE_) > 0)  -- '#1063#1058#1054#1041#1067' '#1057#1058#1056#1054#1050#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1051#1048#1057#1068' '#1055#1054' '#1055#1059#1057#1058#1054#1058#1045
      '11016696=             OR'
      
        '11016697=             (C.PHONE LIKE '#39'%'#39'||:CARD_CODE_||'#39'%'#39' AND CH' +
        'AR_LENGTH(:CARD_CODE_) > 0)'
      '11016698=             )'
      
        '11016699=         or (D.G_DISCONT_CARD = COALESCE(:G_DISCONT_CAR' +
        'D_, 0))'
      '110166100=        )'
      '110166101=    AND D.G_CLIENT = C.G_CLIENT'
      '110166102=  INTO'
      '110166103=    :G_CLIENT_,'
      '110166104=    :CLIENT_NAME_,'
      '110166105=    :BARCODE_,'
      '110166106=    :N_PERCENT_,'
      '110166107=    :SUMM_,'
      '110166108=    :SUMM_ALL_;'
      '110166109='
      '110166110=    SELECT MAX(Z.Z_DATE)'
      '110166111=      FROM ZAKAZ Z'
      '110166112=     WHERE Z.G_CLIENT = :G_CLIENT_'
      '110166113=     INTO :LAST_PURCHASE_DATE_;'
      '110166114=END'
      '110166115=;'
      '110166116='
      '110166117=ALTER PROCEDURE G_GET_G_CLIENT('
      '110166118=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '110166119=RETURNS ('
      
        '110166120=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      
        '110166121=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT,'
      '110166122=  NAME_ VARCHAR(500),'
      '110166123=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110166124=  IDN_ VARCHAR(12),'
      '110166125=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '110166126=  KBE_ VARCHAR(5),'
      '110166127=  SKIDKA_ NUMERIC(15,2),'
      '110166128=  BY_DEFAULT_ INTEGER,'
      '110166129=  IS_BEZNAL_ INTEGER,'
      '110166130=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110166131=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110166132=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110166133=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110166134=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110166135=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110166136=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110166137=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '110166138=  NOTIFY_SKIDKA_ INTEGER,'
      '110166139=  NOTIFY_DR_ INTEGER,'
      '110166140=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110166141=  FM_PROMO_ VARCHAR(50),'
      
        '110166142=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONU' +
        'S_PAY_SUMM,'
      '110166143=  LAST_PURCHASE_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110166144=  ERR_CODE INTEGER,'
      '110166145=  ERR_MSG VARCHAR(1024))'
      '110166146=AS'
      '110166147=/**/'
      '110166148=begin'
      '110166149=    SELECT'
      
        '110166150=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE,' +
        ' SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '110166151=      ,P.G_PROMOTION'
      '110166152=      ,P.NAME'
      '110166153=      ,notify_dr'
      '110166154=      ,notify_skidka'
      '110166155=      ,MAX_BONUS_PAY_SUMM'
      
        '110166156=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T' +
        '.g_promotion = P.g_promotion'
      '110166157=    WHERE T.G_CLIENT = :G_CLIENT_'
      '110166158=    INTO'
      
        '110166159=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_' +
        ', :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :D' +
        'T_, :NAME_FULL_'
      '110166160=      ,:G_PROMOTION_'
      '110166161=      ,:G_PROMOTION_STR_'
      '110166162=      ,:NOTIFY_DR_'
      '110166163=      ,:NOTIFY_SKIDKA_'
      '110166164=      ,:MAX_BONUS_PAY_SUMM_'
      '110166165=      ;'
      '110166166='
      '110166167=    SELECT MAX(Z.Z_DATE)'
      '110166168=      FROM ZAKAZ Z'
      '110166169=     WHERE Z.G_CLIENT = :G_CLIENT_'
      '110166170=     INTO :LAST_PURCHASE_DATE_;'
      '110166171='
      '110166172=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '110166173=    FROM G_DISCONT_CARD'
      '110166174=    WHERE G_CLIENT = :G_CLIENT_'
      '110166175=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '110166176=end'
      '110166177=;'
      '110166178='
      '110166179=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110166180=RETURNS ('
      '110166181=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110166182=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '110166183=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '110166184=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '110166185=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '110166186=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110166187=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110166188=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '110166189=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '110166190=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110166191=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110166192=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110166193=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110166194=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZ' +
        'N_PROC,'
      '110166195=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '110166196=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_' +
        'PROC,'
      '110166197=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '110166198=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_SA' +
        'LE_PRICE,'
      '110166199=  IS_MARKED TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110166200=  MARK_CODE TYPE OF COLUMN SKLAD_TMP.MARK_CODE)'
      '110166201=AS'
      '110166202=begin'
      '110166203=  FOR'
      
        '110166204=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.' +
        'SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '110166205=           ,PRICE_CURRENCY'
      '110166206=           ,SUMM_CURRENCY'
      '110166207=           ,CHARGE_ROZN_PROC'
      '110166208=           ,PRICE_ROZN'
      '110166209=           ,CHARGE_OPT_PROC'
      '110166210=           ,PRICE_OPT'
      '110166211=           ,CHANGE_SALE_PRICE'
      '110166212=           ,P.IS_MARKED'
      '110166213=           ,MARK_CODE'
      '110166214=    FROM SKLAD_TMP T,'
      '110166215=         G_PRODUCT P'
      '110166216=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110166217=    ORDER BY T.sklad'
      
        '110166218=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :' +
        'NDS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '110166219=      ,:PRICE_CURRENCY'
      '110166220=      ,:SUMM_CURRENCY'
      '110166221=      ,:CHARGE_ROZN_PROC'
      '110166222=       ,:PRICE_ROZN'
      '110166223=       ,:CHARGE_OPT_PROC'
      '110166224=       ,:PRICE_OPT'
      '110166225=       ,:CHANGE_SALE_PRICE'
      '110166226=       ,:IS_MARKED'
      '110166227=       ,:MARK_CODE'
      '110166228=  DO'
      '110166229=    suspend;'
      '110166230=end'
      '110166231=;'
      '110166232='
      '110166233='
      
        '110166234=UPDATE SYSTEM_SETUP SET S_VALUE = 110166 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110166235=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110166236=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101670='
      '1101671=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1101672=RETURNS ('
      
        '1101673=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS */ BIGINT,'
      
        '1101674=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ BIG' +
        'INT,'
      
        '1101675=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T */ BIGINT,'
      
        '1101676=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ N' +
        'UMERIC(18,5),'
      
        '1101677=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NUM' +
        'ERIC(15,2),'
      
        '1101678=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUMER' +
        'IC(15,2),'
      
        '1101679=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC */ NUMERIC(15,2),'
      
        '11016710=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE */ NUMERIC(15,2),'
      
        '11016711=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_SUMM */ NUMERIC(15,2),'
      
        '11016712=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMERI' +
        'C(15,2),'
      
        '11016713=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM' +
        ' */ NUMERIC(15,2),'
      
        '11016714=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '11016715=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11016716=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11016717=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11016718=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_P' +
        'RICE */ NUMERIC(15,2),'
      '11016719=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER,'
      '11016720=  IS_MARKED INTEGER,'
      
        '11016721=  MARK_CODE /* TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE *' +
        '/ VARCHAR(100),'
      
        '11016722=  SUM_TO_CHARGE_BONUS /* TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.SUMM */ NUMERIC(15,2),'
      
        '11016723=  ORIGINAL_KIT_ID /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.O' +
        'RIGINAL_KIT_ID */ BIGINT,'
      
        '11016724=  ORIGINAL_KIT_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TM' +
        'P.ORIGINAL_KIT_PRICE */ NUMERIC(15,2))'
      '11016725=AS'
      '11016726=BEGIN'
      '11016727=  SUSPEND;'
      '11016728=END'
      '11016729=;'
      '11016730='
      '11016731='
      
        '11016732=/******************************************************' +
        '************************/'
      
        '11016733=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11016734=/******************************************************' +
        '************************/'
      '11016735=ALTER PROCEDURE GET_SKLAD('
      '11016736=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11016737=  MODE_ INTEGER)'
      '11016738=RETURNS ('
      '11016739=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '11016740=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      
        '11016741=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIP' +
        'T,'
      '11016742=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '11016743=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMENT' +
        '_TYPE,'
      '11016744=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '11016745=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '11016746=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11016747=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11016748=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY,'
      
        '11016749=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_AL' +
        'L,'
      '11016750=  CNT_T_ INTEGER,'
      
        '11016751=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11016752=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11016753=  HAVERIGHT_ INTEGER,'
      '11016754=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11016755=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED,'
      '11016756=  ERR_CODE INTEGER,'
      '11016757=  ERR_MSG VARCHAR(1024))'
      '11016758=AS'
      '11016759=/*'
      
        '11016760=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083#1077 +
        #1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '11016761=*/'
      
        '11016762=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFIC' +
        'IAL.G_OFFICIAL;'
      
        '11016763=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      '11016764=begin'
      
        '11016765=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080' ' +
        'INS '#1080' '#1087#1088#1080' UPD'
      '11016766=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '11016767=  CNT_T_ = 0;'
      '11016768=  SELECT COUNT(*)'
      '11016769=    FROM (SELECT S.SKLAD'
      '11016770=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '11016771=    INTO :CNT_T_;'
      '11016772='
      '11016773=  SELECT'
      '11016774=    T.DATE_RECEIPT,'
      '11016775=    T.TIME_RECEIPT,'
      '11016776=    T.G_CLIENT,'
      '11016777=    T.G_PAYMENT_TYPE,'
      '11016778=    T.OSNOVANIE,'
      '11016779=    T.NOTE,'
      '11016780=    T.SUMM,'
      '11016781=    T.SUMM_FACT,'
      '11016782=    T.IS_PAYED_ALL'
      '11016783=    ,T.SUMM_CURRENCY'
      '11016784=    ,T.is_expected'
      '11016785=    ,T.IS_VOZVRAT'
      '11016786=  FROM SKLAD_PARENT T'
      '11016787=  WHERE T.SKLAD = :SKLAD_'
      '11016788=  INTO'
      '11016789=    :DATE_RECEIPT_,'
      '11016790=    :TIME_RECEIPT_,'
      '11016791=    :G_CLIENT_,'
      '11016792=    :G_PAYMENT_TYPE_,'
      '11016793=    :OSNOVANIE_,'
      '11016794=    :NOTE_,'
      '11016795=    :SUMM_,'
      '11016796=    :SUMM_FACT_,'
      '11016797=    :IS_PAYED_ALL_'
      '11016798=    ,:SUMM_CURRENCY_'
      '11016799=    ,:IS_EXPECTED_'
      '110167100=    ,:IS_VOZVRAT_;'
      '110167101='
      '110167102=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110167103=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1057#1054#1047#1044#1040#1053#1048#1045' '#1050#1054#1055#1048#1048', '#1048' '#1042' '#1048#1057#1061#1054#1044#1053#1054#1052' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1045#1057 +
        #1058#1068' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' - '#1045#1043#1054' '#1042' '#1050#1054#1055#1048#1070' '#1053#1045' '#1044#1054#1041#1040#1042#1051#1071#1070', '#1055#1059#1057#1058#1068' '#1042#1056#1059#1063#1053#1059#1070' ' +
        #1055#1056#1054#1041#1048#1042#1040#1070#1058
      
        '110167104=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY,'
      
        '110167105=                        charge_ROZN_proc, PRICE_ROZN, ' +
        'charge_opt_proc, PRICE_OPT)'
      
        '110167106=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKL' +
        'AD_,'
      '110167107=         PRICE_CURRENCY, SUMM_CURRENCY,'
      
        '110167108=         DECODE(S.PRICE, 0, 0, ROUND((G.PRICE/S.PRICE ' +
        '- 1)*100, 2)),'
      '110167109=         G.PRICE,'
      
        '110167110=         DECODE(S.PRICE, 0, 0, ROUND((G.volume_price/S' +
        '.PRICE - 1)*100, 2)),'
      '110167111=         G.VOLUME_PRICE'
      '110167112=    FROM SKLAD S, G_PRODUCT G'
      '110167113=   WHERE SKLAD_PARENT = :SKLAD_'
      '110167114=     AND S.G_PRODUCT = G.G_PRODUCT'
      '110167115=     AND ((:MODE_ = 0)'
      '110167116=          OR'
      '110167117=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 0)'
      '110167118=          OR'
      
        '110167119=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 1 AND CHAR_LE' +
        'NGTH(S.MARK_CODE) = 0)'
      '110167120=         )'
      '110167121=   ORDER BY SKLAD;'
      '110167122='
      '110167123=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110167124=  SELECT K.G_PRIHOD_RASHOD,'
      '110167125=         K.SUMM'
      
        '110167126=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110167127=   WHERE K.SKLAD = :SKLAD_'
      '110167128=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110167129=    INTO :G_PRIHOD_,'
      '110167130=         :SUMM_PRIHOD_;'
      '110167131='
      
        '110167132=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110167133='
      
        '110167134=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110167135=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110167136=  HaveRight_ = 1;'
      '110167137=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110167138=    SELECT ID'
      '110167139=      FROM CUR_PARAMS'
      '110167140=     WHERE CUR_PARAMS = 1'
      '110167141=      INTO :G_OFFICIAL_CUR_;'
      '110167142='
      
        '110167143=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110167144=      HaveRight_ = 1;'
      '110167145=    else'
      
        '110167146=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110167147=  END'
      '110167148=end'
      '110167149=;'
      '110167150='
      '110167151=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '110167152=RETURNS ('
      
        '110167153=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '110167154=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '110167155=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT' +
        ','
      '110167156=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110167157=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110167158=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110167159=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_PERC,'
      
        '110167160=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_TENGE,'
      
        '110167161=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_SUMM,'
      '110167162=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '110167163=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '110167164=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110167165=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110167166=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110167167=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110167168=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PRI' +
        'CE,'
      '110167169=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110167170=  IS_MARKED INTEGER,'
      '110167171=  MARK_CODE TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE,'
      
        '110167172=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TMP' +
        '.SUMM,'
      
        '110167173=  ORIGINAL_KIT_ID TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ORI' +
        'GINAL_KIT_ID,'
      
        '110167174=  ORIGINAL_KIT_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.' +
        'ORIGINAL_KIT_PRICE)'
      '110167175=AS'
      '110167176=begin'
      '110167177='
      '110167178=  FOR'
      '110167179=    SELECT T.ZAKAZ_DETAILS,'
      '110167180=           T.ZAKAZ,'
      '110167181=           T.G_PRODUCT,'
      '110167182=           T.AMOUNT,'
      '110167183=           T.PRICE,'
      '110167184=           T.SUMM,'
      '110167185=           T.DISCOUNT_PERC,'
      '110167186=           T.DISCOUNT_TENGE,'
      '110167187=           T.DISCOUNT_SUMM,'
      '110167188=           T.NDS,'
      '110167189=           T.NDS_SUMM,'
      '110167190=           P.NAME PRODUCT_NAME'
      '110167191=           ,P.BARCODE'
      '110167192=           ,P.ARTICUL'
      '110167193=           ,P.PRICE'
      '110167194=           ,P.IS_KIT'
      
        '110167195=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_TM' +
        'P TM, G_PRODUCT GP'
      
        '110167196=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.DO' +
        '_NOT_CHARGE_BONUS = 0)'
      '110167197=           ,T.COST_PRICE'
      '110167198=           ,P.IS_MARKED'
      '110167199=           ,T.MARK_CODE'
      '110167200=           ,T.ORIGINAL_KIT_ID'
      '110167201=           ,T.ORIGINAL_KIT_PRICE'
      '110167202=      FROM ZAKAZ_DETAILS_TMP T,'
      '110167203=           G_PRODUCT P'
      '110167204=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110167205=    ORDER BY t.ZAKAZ_DETAILS'
      '110167206=    INTO :ZAKAZ_DETAILS,'
      '110167207=          :ZAKAZ,'
      '110167208=          :G_PRODUCT,'
      '110167209=          :AMOUNT,'
      '110167210=          :PRICE,'
      '110167211=          :SUMM,'
      '110167212=          :DISCOUNT_PERC,'
      '110167213=          :DISCOUNT_TENGE,'
      '110167214=          :DISCOUNT_SUMM,'
      '110167215=          :NDS,'
      '110167216=          :NDS_SUMM,'
      '110167217=          :PRODUCT_NAME'
      '110167218=          ,:BARCODE'
      '110167219=          ,:ARTICUL'
      '110167220=          ,:PRODUCT_PRICE'
      '110167221=          ,:IS_KIT'
      '110167222=          ,:SUM_TO_CHARGE_BONUS'
      '110167223=          ,:COST_PRICE'
      '110167224=          ,:IS_MARKED'
      '110167225=          ,:MARK_CODE'
      '110167226=          ,:ORIGINAL_KIT_ID'
      '110167227=          ,:ORIGINAL_KIT_PRICE'
      '110167228=  DO'
      '110167229=    suspend;'
      '110167230=end'
      '110167231=;'
      '110167232='
      '110167233='
      
        '110167234=UPDATE SYSTEM_SETUP SET S_VALUE = 110167 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110167235=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110167236=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
