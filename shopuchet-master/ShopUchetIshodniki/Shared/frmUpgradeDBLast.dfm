        ' :Z_AMOUNT_, 1, 0)'
      '1101627747=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101627748=      END'
      '1101627749=  END'
      '1101627750=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
