      '11096736=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096737=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '11096738='
      
        '11096739=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054 +
        #1051#1059#1063#1040#1058#1045#1051#1045
      '11096740=                UPDATE LT_SKLAD_PRODUCT L'
      '11096741=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '11096742=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096743=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '11096744='
      '11096745=                IF (ROW_COUNT = 0) THEN'
      
        '11096746=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKLA' +
        'D_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SK' +
        'LAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '11096747='
      
        '11096748=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054#1053' ' +
        #1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058 +
        #1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '11096749=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068 +
        #1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045 +
        #1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '11096750=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKL' +
        'AD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '11096751=                SELECT MAX(SK.DATE_RECEIPT)'
      '11096752=                  FROM SKLAD SK'
      '11096753=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11096754=                   AND SK.IS_LAST = 1'
      '11096755=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '11096756=                  INTO :DATE_LAST_;'
      '11096757='
      
        '11096758=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ >=' +
        ' DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040 +
        #1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11096759=                  UPDATE SKLAD SK'
      '11096760=                     SET SK.IS_LAST = 0'
      '11096761=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11096762=                     AND SK.IS_LAST = 1'
      '11096763=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '11096764='
      '11096765=                  UPDATE SKLAD SK'
      '11096766=                     SET SK.IS_LAST = 1'
      '11096767=                   WHERE SK.SKLAD = :SKLAD_;'
      '11096768=                END'
      '11096769='
      
        '11096770=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067 +
        #1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11096771=            END ELSE BEGIN'
      '11096772=                UPDATE SKLAD S'
      '11096773=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '11096774=                       S.AMOUNT   = :Z_AMOUNT_,'
      '11096775=                       S.PRICE    = :PRICE_,'
      '11096776=                       S.SUMM     = :SUMMM_,'
      '11096777=                       S.OSNOVANIE = :OSNOVANIE_,'
      '11096778=                       S.NOTE      = :NOTE_'
      '11096779=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '11096780='
      '11096781='
      '11096782=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN BEGIN'
      
        '11096783=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '11096784=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '11096785=                     SET L.AMOUNT = L.AMOUNT + (:AMOUNT' +
        '_OLD_ - :Z_AMOUNT_)'
      '11096786=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096787=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '11096788='
      
        '11096789=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '11096790=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '11096791=                     SET L.AMOUNT = L.AMOUNT - (:AMOUNT' +
        '_OLD_ - :Z_AMOUNT_)'
      '11096792=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096793=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '11096794='
      
        '11096795=                END ELSE if (Z_AMOUNT_ > AMOUNT_OLD_) T' +
        'HEN BEGIN'
      
        '11096796=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '11096797=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '11096798=                     SET L.AMOUNT = L.AMOUNT - (:Z_AMOU' +
        'NT_ - :AMOUNT_OLD_)'
      '11096799=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096800=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '11096801='
      
        '11096802=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '11096803=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '11096804=                     SET L.AMOUNT = L.AMOUNT + (:Z_AMOU' +
        'NT_ - :AMOUNT_OLD_)'
      '11096805=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096806=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '11096807=                END'
      '11096808='
      
        '11096809=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' ' +
        #1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '11096810=                IF ((Z_DATE_ > DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 0)) THEN BEGIN'
      '11096811=                    SELECT MAX(SK.DATE_RECEIPT)'
      '11096812=                      FROM SKLAD SK'
      '11096813=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11096814=                       AND SK.IS_LAST = 1'
      '11096815=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '11096816=                      INTO :DATE_LAST_;'
      '11096817='
      
        '11096818=                    IF ((DATE_LAST_ IS NOT NULL) AND (Z' +
        '_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040 +
        #1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11096819=                      UPDATE SKLAD SK'
      '11096820=                         SET SK.IS_LAST = 0'
      '11096821=                       WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11096822=                         AND SK.IS_LAST = 1'
      '11096823=                         AND SK.G_TOCHKA = :G_CLIENT_;'
      '11096824='
      '11096825=                      UPDATE SKLAD SK'
      '11096826=                         SET SK.IS_LAST = 1'
      
        '11096827=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS_' +
        ';'
      '11096828=                    END'
      '11096829=                END'
      '11096830='
      
        '11096831=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' ' +
        #1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054 +
        #1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '11096832=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1)) THEN BEGIN'
      '11096833=                    SELECT MAX(SK.DATE_RECEIPT)'
      '11096834=                      FROM SKLAD SK'
      '11096835=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11096836=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '11096837=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '11096838=                       AND SK.is_vozvrat IN (0,3,4)'
      '11096839=                      INTO :DATE_LAST_;'
      '11096840='
      
        '11096841=                    IF ((DATE_LAST_ IS NOT NULL) AND (Z' +
        '_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11096842=                      UPDATE SKLAD SK'
      '11096843=                         SET SK.IS_LAST = 0'
      
        '11096844=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS_' +
        ';'
      '11096845='
      '11096846=                       UPDATE SKLAD SK'
      '11096847=                         SET SK.IS_LAST = 1'
      '11096848=                       WHERE SK.G_PRODUCT = :G_PRODUCT_'
      
        '11096849=                         AND SK.SKLAD = (SELECT MAX(SS.' +
        'SKLAD)'
      
        '11096850=                                           FROM SKLAD S' +
        'S'
      
        '11096851=                                          WHERE SS.G_PR' +
        'ODUCT = SK.G_PRODUCT'
      
        '11096852=                                            AND SS.DATE' +
        '_RECEIPT = :DATE_LAST_'
      
        '11096853=                                            AND SS.G_TO' +
        'CHKA = :G_CLIENT_'
      
        '11096854=                                            AND SS.is_v' +
        'ozvrat IN (0,3,4));'
      '11096855=                    END'
      '11096856=                END'
      '11096857=            END'
      '11096858=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '11096859=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '11096860='
      '11096861=      UPDATE SKLAD_PARENT'
      '11096862=      SET'
      '11096863=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT),'
      '11096864=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT),'
      
        '11096865=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),     ' +
        '  -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '11096866=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '11096867=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '11096868=       SUMM      = :SUMM_,'
      '11096869=       SUMM_FACT = :SUMM_FACT_'
      '11096870=      WHERE SKLAD  = :ZAKAZ_;'
      '11096871=  END'
      '11096872='
      '11096873=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '11096874=END'
