        ', 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102112339=            END'
      '1102112340=          END'
      '1102112341=      END'
      '1102112342=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1102112343=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1102112344=      ELSE BEGIN'
      
        '1102112345=          -------------------------------------------' +
        '------------------'
      
        '1102112346=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1102112347=          PNT_ = '#39'025'#39';'
      '1102112348=          FOR SELECT SKLAD,'
      '1102112349=                     AMOUNT,'
      '1102112350=                     G_PRODUCT'
      '1102112351=                FROM SKLAD S'
      '1102112352=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1102112353=                 AND NOT EXISTS (SELECT 1'
      
        '1102112354=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1102112355=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1102112356=          INTO :SKLAD_,'
      '1102112357=               :Z_AMOUNT_,'
      '1102112358=               :G_PRODUCT_'
      '1102112359=          DO BEGIN'
      
        '1102112360=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :E' +
        'RR_MSG);'
      '1102112361=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102112362=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102112363=              EXIT;'
      '1102112364=            END'
      '1102112365=          END'
      '1102112366='
      '1102112367=          PNT_ = '#39'030'#39';'
      '1102112368=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1102112369=                     S.G_PRODUCT,'
      '1102112370=                     S.AMOUNT,'
      '1102112371=                     S.PRICE,'
      '1102112372=                     S.SUMM,'
      '1102112373=                     T.SKLAD,'
      '1102112374=                     T.AMOUNT,'
      '1102112375=                     T.IS_LAST,'
      '1102112376=                     T.DATE_RECEIPT'
      
        '1102112377=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1102112378=                INTO :ZAKAZ_DETAILS_,'
      '1102112379=                     :G_PRODUCT_,'
      '1102112380=                     :Z_AMOUNT_,'
      '1102112381=                     :PRICE_,'
      '1102112382=                     :SUMMM_,'
      '1102112383=                     :SKLAD_OLD_,'
      '1102112384=                     :AMOUNT_OLD_,'
      '1102112385=                     :IS_THIS_LAST_,'
      '1102112386=                     :DATE_RECEIPT_OLD_'
      '1102112387=          DO BEGIN'
      
        '1102112388=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102112389=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1102112390=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1102112391=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1102112392=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1102112393=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102112394=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1102112395=                       )'
      '1102112396=                RETURNING'
      '1102112397=                  SKLAD'
      '1102112398=                INTO'
      '1102112399=                  :SKLAD_;'
      '1102112400='
      
        '1102112401=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102112402=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102112403=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1102112404=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102112405=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
