        '.SUMM_BONUS_GOT;'
      
        '1102492668=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM;'
      
        '1102492669=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM;'
      '1102492670=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '1102492671=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1102492672=BEGIN'
      '1102492673='
      '1102492674=  IS_THIS_LAST_ = 0;'
      '1102492675='
      '1102492676=  SELECT S.G_TOCHKA,'
      '1102492677=         S.IS_VOZVRAT,'
      '1102492678=         S.G_PAYMENT_TYPE'
      '1102492679=         ,S.is_expected'
      
        '1102492680=         ,S.ZAKAZ          -- '#1055#1056#1048' '#1040#1055#1044#1045#1049#1058#1045' '#1053#1045' '#1055#1056#1048#1061#1054#1044#1048#1058 +
        ' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040
      '1102492681=    FROM SKLAD_parent S'
      '1102492682=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1102492683=    INTO :G_TOCHKA_,'
      '1102492684=         :IS_VOZVRAT_,'
      '1102492685=         :G_PAYMENT_TYPE_OLD_'
      '1102492686=         ,:IS_EXPECTED_OLD_'
      '1102492687=         ,:ZAKAZ_;'
      '1102492688='
      
        '1102492689=  -- '#1045#1057#1051#1048' '#1054#1060#1054#1056#1052#1051#1071#1045#1058#1057#1071' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1059#1046#1053#1054' '#1059#1063#1045#1057#1058#1068', '#1063#1058#1054#1041#1067 +
        ' '#1042#1054#1047#1042#1056#1040#1058#1054#1042' '#1055#1054' '#1053#1045#1052#1059' '#1053#1045' '#1041#1067#1051#1054' '#1041#1054#1051#1068#1064#1045', '#1063#1045#1052' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1057#1040#1052#1054#1049' '#1055#1056#1054#1044#1040#1046#1045
      '1102492690=  PNT_ = '#39'00.1'#39';'
      
        '1102492691=  IF (IS_VOZVRAT_ = 1 AND COALESCE(ZAKAZ_, 0) <> 0) T' +
        'HEN BEGIN'
      '1102492692=     SELECT COUNT(A.G_PRODUCT)'
      '1102492693=        FROM ('
      '1102492694=            SELECT G_PRODUCT, SUM(AMOUNT) ORDERED'
      '1102492695=            FROM ZAKAZ_DETAILS ZD'
      '1102492696=            WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102492697=            GROUP BY ZD.G_PRODUCT'
      '1102492698=        ) A'
      '1102492699=        INNER JOIN ('
      '1102492700=            SELECT G_PRODUCT, SUM(RETURNED) RETURNED'
      '1102492701=              FROM ('
      
        '1102492702=                    SELECT G_PRODUCT, SUM(AMOUNT) RET' +
        'URNED'
      '1102492703=                    FROM SKLAD O, SKLAD_PARENT SP'
      '1102492704=                    WHERE SP.ZAKAZ = :ZAKAZ_'
      '1102492705=                      AND SP.SKLAD = O.SKLAD_PARENT'
      '1102492706=                      AND SP.IS_VOZVRAT = 1'
      
        '1102492707=                      AND SP.SKLAD <> :SKLAD_PARENT_ ' +
        ' --'#1063#1058#1054#1041#1067' '#1053#1045' '#1055#1056#1054#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1057' '#1057#1040#1052#1048#1052' '#1057#1054#1041#1054#1049
      '1102492708=                    GROUP BY O.G_PRODUCT'
      '1102492709=                    UNION ALL'
      
        '1102492710=                    SELECT T.G_PRODUCT, SUM(T.AMOUNT)' +
        ' RETURNED'
      '1102492711=                    FROM SKLAD_TMP T'
      '1102492712=                    GROUP BY T.G_PRODUCT'
      '1102492713=                    )'
      '1102492714=            GROUP BY G_PRODUCT'
      '1102492715=        ) B ON B.G_PRODUCT = A.G_PRODUCT'
      '1102492716=        WHERE ORDERED < RETURNED'
      '1102492717=     INTO :CNT_;'
      '1102492718='
      '1102492719=     IF (CNT_ > 0) THEN BEGIN'
      '1102492720=         ERR_CODE = -20500;'
      
        '1102492721=         EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' ' +
        #1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1074#1077#1088#1085#1091#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' '#1073#1086#1083#1100#1096#1077', '#1095#1077#1084' '#1074' '#1089#1072#1084#1086#1081' '#1087#1088#1086#1076#1072#1078#1077'!'
      
        '1102492722='#1055#1088#1086#1074#1077#1088#1100#1090#1077' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1074#1086#1079#1074#1088#1072#1097#1072#1077#1084#1086#1075#1086' '#1090#1086#1074#1072#1088#1072', '#1072' '#1090#1072#1082#1078#1077' '#1085#1077 +
        ' '#1073#1099#1083#1080' '#1091#1078#1077' '#1086#1092#1086#1088#1084#1083#1077#1085#1099' '#1074#1086#1079#1074#1088#1072#1090#1099' '#1087#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1095#1077#1082#1091'!'#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      
        '1102492723=         ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '1102492724=         EXIT;'
      '1102492725=     END'
      '1102492726=  END'
      '1102492727='
      '1102492728=  PNT_ = '#39'00'#39';'
      '1102492729=  UPDATE SKLAD_PARENT'
      '1102492730=  SET'
      
        '1102492731=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1102492732=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1102492733=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1102492734=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1102492735=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102492736=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102492737=   SUMM      = :SUMM_,'
      '1102492738=   SUMM_FACT = :SUMM_FACT_,'
      '1102492739=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1102492740=   IS_PAYED_ALL  = CASE WHEN :SUMM_ <= :SUMM_FACT_ TH' +
        'EN 1 ELSE 0 END,  --IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, ' +
        '1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050 +
        #1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102492741=   IS_EXPECTED  = :IS_EXPECTED_'
      '1102492742=   ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102492743=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1102492744='
      
        '1102492745=  ---------------------------------------------------' +
        '----------'
      
        '1102492746=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1102492747=  PNT_ = '#39'02'#39';'
      '1102492748=  FOR SELECT SKLAD'
      '1102492749=        FROM SKLAD S'
      '1102492750=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1102492751=         AND NOT EXISTS (SELECT 1'
      '1102492752=                           FROM SKLAD_TMP T'
      '1102492753=                        WHERE T.SKLAD = S.SKLAD)'
      '1102492754=  INTO :SKLAD_'
      '1102492755=  DO BEGIN'
      
        '1102492756=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1102492757=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102492758=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102492759=      EXIT;'
      '1102492760=    END'
      '1102492761=  END'
      '1102492762='
      
        '1102492763=  ---------------------------------------------------' +
        '----------'
      
        '1102492764=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1102492765=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1102492766=  PNT_ = '#39'03'#39';'
      '1102492767=  FOR SELECT S.SKLAD,'
      '1102492768=             S.G_PRODUCT,'
      '1102492769=             S.AMOUNT,'
      '1102492770=             S.PRICE,'
      '1102492771=             S.SUMM,'
      '1102492772=             S.NDS,'
      '1102492773=             S.NDS_SUMM,'
      '1102492774=             T.SKLAD,'
      '1102492775=             T.AMOUNT,'
      '1102492776=             T.IS_LAST,'
      '1102492777=             T.DATE_RECEIPT'
      '1102492778=             ,S.PRICE_CURRENCY'
      '1102492779=             ,S.SUMM_CURRENCY'
      '1102492780=             ,S.PRICE_ROZN'
      
        '1102492781=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1102492782=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1102492783=  INTO :SKLAD_,'
      '1102492784=       :G_PRODUCT_,'
      '1102492785=       :AMOUNT_,'
      '1102492786=       :PRICE_,'
      '1102492787=       :SUMM_ONE_,'
      '1102492788=       :NDS_,'
      '1102492789=       :NDS_SUMM_,'
      '1102492790=       :SKLAD_OLD_,'
      '1102492791=       :AMOUNT_OLD_,'
      '1102492792=       :IS_THIS_LAST_,'
      '1102492793=       :DATE_RECEIPT_OLD_'
      '1102492794=       ,:PRICE_CURRENCY_'
      '1102492795=       ,:SUMM_CURRENCY_TMP_'
      '1102492796=       ,:SALE_PRICE_'
      '1102492797=       ,:SALE_PRICE_CUR_'
      '1102492798=  DO BEGIN'
      
        '1102492799=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102492800=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1102492801=        PNT_ = '#39'04'#39';'
      
        '1102492802=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1102492803=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1102492804=                          ,PRICE_CURRENCY'
      '1102492805=                          ,SUMM_CURRENCY)'
      
        '1102492806=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1102492807=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102492808=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1102492809=               ,:PRICE_CURRENCY_'
      '1102492810=               ,:SUMM_CURRENCY_TMP_'
      '1102492811=               );'
      '1102492812='
      
        '1102492813=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1102492814=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1102492815=            UPDATE LT_SKLAD_PRODUCT L'
      '1102492816=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102492817=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102492818=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102492819=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102492820='
      '1102492821=            IF (ROW_COUNT = 0) THEN'
      
        '1102492822=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102492823=        END'
      '1102492824='
      
        '1102492825=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102492826=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1102492827=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1102492828=        PNT_ = '#39'05'#39';'
      '1102492829=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1102492830=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102492831=              FROM SKLAD SK'
      '1102492832=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102492833=               AND SK.IS_LAST = 1'
      '1102492834=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102492835=              INTO :DATE_LAST_;'
      '1102492836='
      
        '1102492837=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102492838=              UPDATE SKLAD SK'
      '1102492839=                 SET SK.IS_LAST = 0'
      '1102492840=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102492841=                 AND SK.IS_LAST = 1'
      '1102492842=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102492843='
      '1102492844=              UPDATE SKLAD SK'
      '1102492845=                 SET SK.IS_LAST = 1'
      '1102492846=               WHERE SK.SKLAD = :SKLAD_;'
      '1102492847=            END'
      '1102492848=        END'
      
        '1102492849=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102492850=    END ELSE BEGIN'
      '1102492851=        PNT_ = '#39'06'#39';'
      '1102492852=        UPDATE SKLAD S'
      '1102492853=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1102492854=               S.G_CLIENT = :G_CLIENT_,'
      '1102492855=               S.AMOUNT   = :AMOUNT_,'
      '1102492856=               S.PRICE    = :PRICE_,'
      '1102492857=               S.SUMM     = :SUMM_ONE_,'
      '1102492858=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102492859=               S.NDS      = :NDS_,'
      '1102492860=               S.NDS_SUMM = :NDS_SUMM_,'
      '1102492861=               S.OSNOVANIE = :OSNOVANIE_,'
      '1102492862=               S.NOTE      = :NOTE_'
      '1102492863=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1102492864=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1102492865=         WHERE S.SKLAD = :SKLAD_;'
      '1102492866='
      '1102492867=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102492868=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_ AND IS_EX' +
        'PECTED_ = 0) THEN BEGIN'
      '1102492869=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1102492870=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102492871=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_),'
      
        '1102492872=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102492873=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102492874=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102492875='
      '1102492876=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1102492877=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102492878=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_),'
      
        '1102492879=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102492880=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102492881=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102492882=        END'
      
        '1102492883=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1102492884=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1102492885=            UPDATE LT_SKLAD_PRODUCT L'
      '1102492886=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102492887=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102492888=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102492889=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102492890='
      '1102492891=            IF (ROW_COUNT = 0) THEN'
      
        '1102492892=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102492893=        END'
      
        '1102492894=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1102492895=        ELSE IF (IS_EXPECTED_OLD_ = 0 AND IS_EXPECTED' +
        '_ = 1) THEN BEGIN'
      '1102492896=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1102492897=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_,'
      
        '1102492898=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102492899=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102492900=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102492901=        END'
      '1102492902='
      
        '1102492903=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1102492904=        /*PNT_ = '#39'07'#39';'
      
        '1102492905=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102492906=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102492907=              FROM SKLAD SK'
      '1102492908=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102492909=               AND SK.IS_LAST = 1'
      '1102492910=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102492911=              INTO :DATE_LAST_;'
      '1102492912='
      
        '1102492913=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102492914=              UPDATE SKLAD SK'
      '1102492915=                 SET SK.IS_LAST = 0'
      '1102492916=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102492917=                 AND SK.IS_LAST = 1'
      '1102492918=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102492919='
      '1102492920=              UPDATE SKLAD SK'
      '1102492921=                 SET SK.IS_LAST = 1'
      '1102492922=               WHERE SK.SKLAD = :SKLAD_;'
      '1102492923=            END'
      '1102492924=        END*/'
      '1102492925='
      
        '1102492926=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1102492927=        /*PNT_ = '#39'08'#39';'
      
        '1102492928=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102492929=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102492930=              FROM SKLAD SK'
      '1102492931=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102492932=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1102492933=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102492934=               AND SK.is_vozvrat IN (0,4)'
      '1102492935=              INTO :DATE_LAST_;'
      '1102492936='
      
        '1102492937=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102492938=              UPDATE SKLAD SK'
      '1102492939=                 SET SK.IS_LAST = 0'
      '1102492940=               WHERE SK.SKLAD = :SKLAD_;'
      '1102492941='
      '1102492942=               UPDATE SKLAD SK'
      '1102492943=                 SET SK.IS_LAST = 1'
      '1102492944=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102492945=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1102492946=                                   FROM SKLAD SS'
      
        '1102492947=                                  WHERE SS.G_PRODUCT ' +
        '= SK.G_PRODUCT'
      
        '1102492948=                                    AND SS.DATE_RECEI' +
        'PT = :DATE_LAST_'
      
        '1102492949=                                    AND SS.G_TOCHKA =' +
        ' :G_TOCHKA_'
      
        '1102492950=                                    AND SS.is_vozvrat' +
        ' IN (0,4));'
      '1102492951='
      '1102492952=            END'
      
        '1102492953=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054 +
        #1052' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' ' +
        #1053#1048#1052'.'
      
        '1102492954=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059 +
        #1044#1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '1102492955=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THI' +
        'S_LAST_ = 1)) THEN BEGIN'
      '1102492956=              UPDATE SKLAD SK'
      '1102492957=                 SET SK.IS_LAST = 1'
      '1102492958=               WHERE SK.SKLAD = :SKLAD_;'
      '1102492959=            END'
      '1102492960=        END*/'
      '1102492961=    END'
      '1102492962='
      
        '1102492963=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '1102492964=      UPDATE G_PRODUCT G'
      '1102492965=         SET G.PRICE = :SALE_PRICE_'
      '1102492966=       WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102492967=  END'
      '1102492968='
      
        '1102492969=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057 +
        #1057#1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '1102492970=      ----------------------------------------'
      
