      '110682176=           G.KOD_TNVD,'
      '110682177=           CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '110682178=           REPLACE(CAST(ROUND((ZD.PRICE - COALESCE(ZD.' +
        'DISCOUNT_TENGE, 0))/(1 + :NDS_VALUE_/100), 2) AS VARCHAR(10)), '#39 +
