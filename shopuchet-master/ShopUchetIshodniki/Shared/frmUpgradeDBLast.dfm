      '11053869=  STR_ VARCHAR(500),'
      '11053870=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '11053871=  NAME VARCHAR(1000),'
      
        '11053872=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11053873=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11053874=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      '11053875=  AMOUNT_IN /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      
        '11053876=  AMOUNT_PRIHOD /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT */ NUMERIC(18,5),'
      '11053877=  SUMM_PRIHOD NUMERIC(15,2),'
      
        '11053878=  AMOUNT_UHOD /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        ' */ NUMERIC(18,5),'
      '11053879=  SUMM_UHOD NUMERIC(15,2),'
      
        '11053880=  AMOUNT_SPISANO /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT */ NUMERIC(18,5),'
      '11053881=  SUMM_SPISANO NUMERIC(15,2),'
      
        '11053882=  AMOUNT_VOZVRAT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT */ NUMERIC(18,5),'
      '11053883=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '11053884=  AMOUNT_PRIHOD_SKL /* TYPE OF COLUMN LT_SKLAD_PRODUCT.' +
        'AMOUNT */ NUMERIC(18,5),'
      '11053885=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '11053886=  AMOUNT_UHOD_SKL /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT */ NUMERIC(18,5),'
      '11053887=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '11053888=  AMOUNT_OUT /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      '11053889=  IS_HEAD INTEGER,'
