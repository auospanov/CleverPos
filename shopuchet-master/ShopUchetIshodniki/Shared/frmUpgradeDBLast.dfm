      '1101621731=                FROM G_PRODUCT'
      
        '1101621732=               WHERE G_PRODUCT_PAR = :G_PRODUCT_)) th' +
        'en BEGIN'
      '1101621733=    ERR_CODE = -20500;'
      
        '1101621734=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091 +
        #1076#1072#1083#1080#1090#1100' '#1076#1072#1085#1085#1091#1102' '#1075#1088#1091#1087#1087#1091', '#1090'.'#1082'. '#1074' '#1085#1077#1081' '#1089#1086#1089#1090#1086#1103#1090' '#1090#1086#1074#1072#1088#1099'/'#1075#1088#1091#1087#1087#1099'. '#1059#1076#1072#1083#1080#1090#1077' ' +
        #1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101621735=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621736=    EXIT;'
      '1101621737=  END'
      '1101621738='
      '1101621739='
      
        '1101621740=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', ' +
        #39')'
      '1101621741=                    FROM g_product_kit K, g_product g'
      
        '1101621742=                   WHERE K.g_product_item = :G_PRODUC' +
        'T_'
      
        '1101621743=                     and k.g_product = g.g_product) F' +
        'ROM 1 FOR 999)'
      '1101621744=  FROM RDB$DATABASE'
      '1101621745=   INTO :PROD_NAME_;'
      '1101621746=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '1101621747=    ERR_CODE = -20500;'
      
        '1101621748=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083#1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'. '#1059#1076#1072#1083#1080 +
        #1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '1101621749=                                  '#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080 +
        #1090#1077' '#1077#1075#1086' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1072' '#1090#1086#1074#1072#1088#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101621750=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621751=    EXIT;'
      '1101621752=  END'
      '1101621753='
      
        '1101621754=  SELECT ZA.zakaz||'#39' '#1086#1090' '#39'||lpad(extract(day from ZA.Z' +
        '_DATE),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from ZA.Z_DATE),2,'#39'0'#39 +
        ') || '#39'.'#39' || extract(year from ZA.Z_DATE)'
      '1101621755=    FROM ZAKAZ ZA'
      '1101621756=   WHERE ZA.zakaz = (SELECT MIN(Z.ZAKAZ)'
      '1101621757=                        FROM ZAKAZ_DETAILS Z'
      
        '1101621758=                       WHERE Z.G_PRODUCT = :G_PRODUCT' +
        '_)'
      '1101621759=  INTO :NAKL_PROD_;'
      '1101621760=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '1101621761=    ERR_CODE = -20500;'
      
        '1101621762=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1091#1093#1086#1076#1072' ('#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '1101621763='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086 +
        '.'#39'||'#39
      
        '1101621764='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072 +
        #1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      '1101621765=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621766=    EXIT;'
      '1101621767=  END'
      '1101621768='
      
        '1101621769=  SELECT SP.sklad||'#39' '#1086#1090' '#39'||lpad(extract(day from SP.d' +
        'ate_receipt),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from SP.date_re' +
        'ceipt),2,'#39'0'#39') || '#39'.'#39' || extract(year from SP.date_receipt)'
      '1101621770=    FROM sklad_parent SP'
      '1101621771=   WHERE SP.sklad = ( SELECT MIN(S.sklad_parent)'
      '1101621772=                        FROM sklad s'
      
        '1101621773=                       WHERE s.G_PRODUCT = :G_PRODUCT' +
        '_)'
      '1101621774=    INTO :NAKL_PROD_;'
      '1101621775=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '1101621776=    ERR_CODE = -20500;'
      
        '1101621777=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1087#1088#1080#1093#1086#1076#1072' ('#1086#1087#1088#1080#1093#1086#1076#1086#1074#1072#1085#1080#1077'/'#1074#1086#1079#1074#1088#1072#1090'/'#1087#1077#1088#1077 +
        #1084#1077#1097#1077#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '1101621778='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086 +
        '. '#39'||'#39
      
        '1101621779='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072 +
        #1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      '1101621780=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621781=    EXIT;'
      '1101621782=  END'
      '1101621783='
      
        '1101621784=  SELECT lpad(extract(day from MIN(za.op_date)),2,'#39'0'#39 +
        ') || '#39'.'#39' || lpad(extract(month from MIN(za.op_date)),2,'#39'0'#39') || '#39 +
        '.'#39' || extract(year from MIN(za.op_date))'
      '1101621785=    FROM OTHER ZA, OTHER_DETAILS Z'
      '1101621786=   WHERE ZA.OTHER = Z.other'
      '1101621787=     AND Z.G_PRODUCT = :G_PRODUCT_'
      '1101621788=  INTO :NAKL_PROD_;'
      '1101621789=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '1101621790=    ERR_CODE = -20500;'
      
        '1101621791=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072' '#1086#1090' '#39'||NAKL_PROD_||'#39' '#1095#1080#1089#1083#1072 +
        '. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '1101621792=                                  '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072 +
        #1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083 +
        #1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101621793=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621794=    EXIT;'
      '1101621795=  END'
      '1101621796='
      '1101621797=  SELECT G.NAME'
      '1101621798=    FROM G_PRODUCT G'
      '1101621799=   WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1101621800=    INTO :NAME_;'
      '1101621801='
      '1101621802=  delete from LT_SKLAD_PRODUCT g'
      '1101621803=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101621804='
      '1101621805=  delete from lt_barcode g'
      '1101621806=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101621807='
      '1101621808=  delete from revision g'
      '1101621809=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101621810='
      '1101621811=  delete from g_product_image g'
      '1101621812=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101621813='
      '1101621814=  delete from g_product_KIT g'
      '1101621815=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101621816='
      '1101621817=  delete from G_PRODUCT g'
      '1101621818=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101621819='
      '1101621820=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101621821=  EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_PR' +
        'ODUCT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '1101621822='
      '1101621823=when sqlcode -530 DO'
      '1101621824=  begin'
      '1101621825=    SELECT G.IS_CATEGORY'
      '1101621826=      FROM G_PRODUCT G'
      '1101621827=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1101621828=      INTO :IS_CATEGORY_;'
      '1101621829='
      '1101621830=    ERR_CODE = -20500;'
      '1101621831=    if (IS_CATEGORY_ = 0) then'
      
        '1101621832=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072 +
        #1085#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '1101621833=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089 +
        #1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072 +
        #1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101621834=    ELSE'
      
        '1101621835=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072 +
        #1085#1085#1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101621836=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621837=  end'
      '1101621838=end'
      '1101621839=;'
      '1101621840='
      '1101621841=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '1101621842=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101621843=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101621844=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '1101621845=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101621846=  PREFIX_ VARCHAR(2))'
      '1101621847=RETURNS ('
      '1101621848=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101621849=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT_PAR,'
      '1101621850=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101621851=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101621852=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101621853=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101621854=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '1101621855=  ERR_CODE INTEGER,'
      '1101621856=  ERR_MSG VARCHAR(1024))'
      '1101621857=AS'
      '1101621858=/*'
      '1101621859='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '1101621860=*/'
      
        '1101621861=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PROD' +
        'UCT_BY_BARCODE'#39';'
      '1101621862=BEGIN'
      '1101621863='
      '1101621864=    IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '1101621865=        ERR_CODE = -20500;'
      
        '1101621866=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080 +
        #1093#1082#1086#1076' '#1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101621867=        ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621868=        EXIT;'
      '1101621869=    END'
      '1101621870='
      
        '1101621871=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) T' +
        'HEN BEGIN'
      '1101621872=        SELECT T.G_PRODUCT_PAR,'
      '1101621873=               T.G_PRODUCT,'
      '1101621874=               T.PRICE,'
      '1101621875=               T.VOLUME_PRICE,'
      '1101621876=               T.IS_KIT,'
      '1101621877=               T.IS_MARKED'
      '1101621878=          FROM G_PRODUCT T'
      
        '1101621879=          WHERE SUBSTRING(T.BARCODE FROM 1 FOR 7) = S' +
        'UBSTRING(:BARCODE_ FROM 1 FOR 7)'
      '1101621880=            AND T.IS_ACTIVE = 1'
      '1101621881=          INTO :G_PRODUCT_CATEGORY_,'
      '1101621882=               :G_PRODUCT_,'
      '1101621883=               :PRICE_,'
      '1101621884=               :VOLUME_PRICE_,'
      '1101621885=               :IS_KIT_,'
      '1101621886=               :IS_MARKED_;'
      '1101621887='
      
        '1101621888=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM ' +
        '8 FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '1101621889=    END ELSE'
      '1101621890=        SELECT T.G_PRODUCT_PAR,'
      '1101621891=               T.G_PRODUCT,'
      '1101621892=               T.PRICE,'
      '1101621893=               T.VOLUME_PRICE,'
      '1101621894=               T.IS_KIT,'
      '1101621895=               T.IS_MARKED'
      '1101621896=          FROM G_PRODUCT T'
      '1101621897=          WHERE T.BARCODE = :BARCODE_'
      '1101621898=            AND T.IS_ACTIVE = 1'
      '1101621899=          INTO :G_PRODUCT_CATEGORY_,'
      '1101621900=               :G_PRODUCT_,'
      '1101621901=               :PRICE_,'
      '1101621902=               :VOLUME_PRICE_,'
      '1101621903=               :IS_KIT_,'
      '1101621904=               :IS_MARKED_;'
      '1101621905='
      '1101621906=    IF (ROW_COUNT = 0) THEN BEGIN'
      
        '1101621907=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' ' +
        #1044#1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '1101621908=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_)' +
        ' THEN'
      '1101621909=          SELECT T.G_PRODUCT_PAR,'
      '1101621910=                 T.G_PRODUCT,'
      '1101621911=                 T.PRICE,'
      '1101621912=                 T.VOLUME_PRICE,'
      '1101621913=                 T.IS_KIT,'
      '1101621914=                 T.IS_MARKED'
      '1101621915=            FROM G_PRODUCT T, LT_BARCODE D'
      '1101621916=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1101621917=              AND T.IS_ACTIVE = 1'
      
        '1101621918=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) =' +
        ' SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '1101621919=            INTO'
      '1101621920=                :G_PRODUCT_CATEGORY_,'
      '1101621921=                :G_PRODUCT_,'
      '1101621922=                :PRICE_,'
      '1101621923=                :VOLUME_PRICE_,'
      '1101621924=                :IS_KIT_,'
      '1101621925=                :IS_MARKED_;'
      '1101621926=      ELSE'
      '1101621927=          SELECT T.G_PRODUCT_PAR,'
      '1101621928=                 T.G_PRODUCT,'
      '1101621929=                 T.PRICE,'
      '1101621930=                 T.VOLUME_PRICE,'
      '1101621931=                 T.IS_KIT,'
      '1101621932=                 T.IS_MARKED'
      '1101621933=            FROM G_PRODUCT T, LT_BARCODE D'
      '1101621934=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1101621935=              AND T.IS_ACTIVE = 1'
      '1101621936=              AND D.BARCODE = :BARCODE_'
      '1101621937=            INTO'
      '1101621938=                :G_PRODUCT_CATEGORY_,'
      '1101621939=                :G_PRODUCT_,'
      '1101621940=                :PRICE_,'
      '1101621941=                :VOLUME_PRICE_,'
      '1101621942=                :IS_KIT_,'
      '1101621943=                :IS_MARKED_;'
      '1101621944='
      '1101621945=      IF (ROW_COUNT = 0) THEN BEGIN'
      '1101621946=          ERR_CODE = -20500;'
      
        '1101621947=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1101621948=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621949=          EXIT;'
      '1101621950=      END'
      '1101621951=    END'
      '1101621952='
      
        '1101621953=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) <> PREFIX_) ' +
        'THEN'
      
        '1101621954=        SELECT CASE WHEN LT.AMOUNT < 1 AND LT.AMOUNT ' +
        '> 0 AND ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = ' +
        '2) = 0) THEN LT.AMOUNT ELSE 1 END'
      '1101621955=          FROM LT_SKLAD_PRODUCT LT'
      '1101621956=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      
        '1101621957=           AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '1101621958=          INTO :AMOUNT_;'
      '1101621959=END'
      '1101621960=;'
      '1101621961='
      '1101621962=ALTER PROCEDURE G_INS_G_CLIENT('
      '1101621963=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101621964=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAG' +
        'ENT,'
      '1101621965=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101621966=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '1101621967=  IDN_ VARCHAR(12),'
      '1101621968=  KBE_ VARCHAR(5),'
      '1101621969=  SKIDKA_ NUMERIC(15,2),'
      '1101621970=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '1101621971=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '1101621972=  BY_DEFAULT_ INTEGER,'
      '1101621973=  IS_SUPPLIER_ INTEGER,'
      '1101621974=  IS_CATEGORY_ INTEGER,'
      '1101621975=  IS_BEZNAL_ INTEGER,'
      '1101621976=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '1101621977=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '1101621978=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      
        '1101621979=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ','
      '1101621980=  NOTIFY_SKIDKA_ INTEGER,'
      '1101621981=  NOTIFY_DR_ INTEGER,'
      '1101621982=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '1101621983=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101621984=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BON' +
        'US_PAY_SUMM,'
      
        '1101621985=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101621986=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101621987=RETURNS ('
      '1101621988=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101621989=  ERR_CODE INTEGER,'
      '1101621990=  ERR_MSG VARCHAR(1024))'
      '1101621991=AS'
      '1101621992=DECLARE VARIABLE CNT_ INTEGER;'
      '1101621993=begin'
      
        '1101621994=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT =' +
        ' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '1101621995=    if (BY_DEFAULT_ = 1) then'
      '1101621996=      UPDATE g_client'
      '1101621997=         SET BY_DEFAULT = 0'
      '1101621998=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '1101621999='
      
        '1101622000=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, ' +
        'G_CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '1101622001=                          IS_CATEGORY, IS_BEZNAL, PHO' +
        'NE, NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR, ' +
        'MAX_BONUS_PAY_SUMM)'
      
        '1101622002=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT' +
        '_, :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_' +
        ', :BY_DEFAULT_,'
      
        '1101622003=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOT' +
        'E_, :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_D' +
        'R_, :MAX_BONUS_PAY_SUMM_)'
      '1101622004=    returning G_CLIENT'
      '1101622005=    into :G_CLIENT_;'
      '1101622006='
      '1101622007=    if (IS_CATEGORY_ = 0) then BEGIN'
      '1101622008=        IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '1101622009=            IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '1101622010=                         FROM G_DISCONT_CARD'
      '1101622011=                        WHERE BARCODE = :BARCODE_'
      
        '1101622012=                          AND G_CLIENT <> :G_CLIENT_)' +
        ') THEN BEGIN'
      '1101622013=              ERR_CODE = -20500;'
      
        '1101622014=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE,' +
        ' '#39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39')' +
        ' RETURNING_VALUES (:ERR_MSG);'
      '1101622015=              EXIT;'
      '1101622016=            END'
      '1101622017=        END'
      '1101622018='
      
        '1101622019=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G' +
        '_CLIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '1101622020=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLI' +
        'ENT_, :BARCODE_, :N_PERCENT_, 0, 0);'
      '1101622021=    END'
      '1101622022='
      '1101622023=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101622024=    EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_' +
        'CLIENT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '1101622025=end'
      '1101622026=;'
      '1101622027='
      '1101622028=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '1101622029=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101622030=  ARTICUL_ VARCHAR(30),'
      '1101622031=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101622032=  BARCODE_ VARCHAR(30),'
      '1101622033=  NAME_ VARCHAR(500),'
      '1101622034=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101622035=  PRICE_ NUMERIC(15,2),'
      '1101622036=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101622037=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101622038=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101622039=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101622040=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101622041=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101622042=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101622043=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101622044=  IS_CATEGORY_ INTEGER,'
      '1101622045=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101622046=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101622047=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101622048=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101622049=  IS_MARKED_ INTEGER,'
      
        '1101622050=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101622051=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101622052=RETURNS ('
      '1101622053=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101622054=  ERR_CODE INTEGER,'
      '1101622055=  ERR_MSG VARCHAR(1024))'
      '1101622056=AS'
      
        '1101622057=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PROD' +
        'UCT'#39';'
      '1101622058=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1101622059=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101622060=begin'
      
        '1101622061=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101622062=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1101622063=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101622064=                      FROM G_PRODUCT G'
      
        '1101622065=                     WHERE UPPER(G.ARTICUL) = UPPER(T' +
        'RIM(:ARTICUL_))'
      '1101622066=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '1101622067=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101622068=          ERR_CODE = -20500;'
      
        '1101622069=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1101622070=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101622071=          EXIT;'
      '1101622072=        END'
      '1101622073=    end'
      '1101622074='
      
        '1101622075=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      
        '1101622076=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) the' +
        'n begin'
      '1101622077=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101622078=                     FROM G_PRODUCT G'
      
        '1101622079=                    WHERE UPPER(G.NOMENCLATUR_NUM) = ' +
        'UPPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '1101622080=                      AND TRIM(G.NOMENCLATUR_NUM) <> ' +
        #39#39
      
        '1101622081=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101622082=          ERR_CODE = -20500;'
      
        '1101622083=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1101622084=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101622085=          EXIT;'
      '1101622086=        END'
      '1101622087=    end'
      '1101622088='
      '1101622089=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101622090=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101622091=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '1101622092=                      FROM G_PRODUCT G'
      
        '1101622093=                     WHERE UPPER(G.BARCODE) = UPPER(T' +
        'RIM(:BARCODE_))'
      '1101622094=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '1101622095=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101622096=          ERR_CODE = -20500;'
      
        '1101622097=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101622098=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101622099=          EXIT;'
      '1101622100=        END'
      '1101622101='
      '1101622102=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101622103=                     FROM G_PRODUCT G, LT_BARCODE L'
      '1101622104=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101622105=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '1101622106=                      AND TRIM(L.BARCODE) <> '#39#39
      
        '1101622107=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101622108=          ERR_CODE = -20500;'
      
        '1101622109=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101622110=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101622111=          EXIT;'
      '1101622112=        END'
      '1101622113=    end'
      '1101622114='
      
        '1101622115=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_P' +
        'RICE,'
      
        '1101622116=                           IS_CATEGORY, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_CO' +
        'MM, KOD_TNVD,'
      
        '1101622117=                           FAST_TOVAR, DO_NOT_CHARGE_' +
        'BONUS, IS_MARKED)'
      
        '1101622118=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PR' +
        'ICE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1101622119=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CRO' +
        'SSCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNV' +
        'D_,'
      
        '1101622120=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_' +
        'MARKED_)'
      '1101622121=    RETURNING G_PRODUCT'
      '1101622122=    INTO :G_PRODUCT_;'
      '1101622123='
      '1101622124=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1101622125=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1101622126=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101622127=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1101622128='
      '1101622129=        INSERT INTO LT_BARCODE'
      
        '1101622130=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101622131='
      
        '1101622132=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089 +
        #1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '1101622133=        INSERT into G_PRODUCT_IMAGE'
      
        '1101622134=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TY' +
        'PE from G_PRODUCT_IMAGE_TMP;'
      '1101622135='
      
        '1101622136=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074 +
        #1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '1101622137=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076 +
        #1091#1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '1101622138=        IF (is_kit_ > 0) THEN begin'
      '1101622139=            INSERT INTO G_PRODUCT_KIT'
      
        '1101622140=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP;'
      '1101622141='
      '1101622142=            if (is_kit_ = 1) then begin'
      
        '1101622143=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101622144=                  FROM G_PRODUCT_KIT K,'
      '1101622145=                       LT_SKLAD_PRODUCT L'
      '1101622146=                 WHERE K.g_product = :G_PRODUCT_'
      '1101622147=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101622148=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101622149=                 GROUP BY K.G_PRODUCT'
      '1101622150=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101622151='
      '1101622152=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101622153=                   SET L.AMOUNT = COALESCE(:G_PRODUCT' +
        '_SOSTAV_AMOUNT_, 0)'
      '1101622154=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101622155=            end'
      '1101622156=        END'
      '1101622157=    END'
      '1101622158='
      '1101622159=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101622160=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '1101622161=end'
      '1101622162=;'
      '1101622163='
      '1101622164=ALTER PROCEDURE G_SET_G_PRODUCT_NOT_ACTIVE('
      '1101622165=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101622166=  IS_ACTIVE_ INTEGER,'
      
        '1101622167=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101622168=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101622169=RETURNS ('
      '1101622170=  ERR_CODE INTEGER,'
      '1101622171=  ERR_MSG VARCHAR(1024))'
      '1101622172=AS'
      '1101622173=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1101622174=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1101622175=begin'
      '1101622176=  PROCNAME = '#39'G_SET_G_PRODUCT_NOT_ACTIVE'#39';'
      '1101622177='
      '1101622178=  delete from G_PRODUCT g'
      '1101622179=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101622180='
      '1101622181=  ERR_CODE = -20500;'
      
        '1101622182=  EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086#1074 +
        #1072#1088' '#1085#1077' '#1091#1095#1072#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1076#1072#1078#1072#1093'/'#1087#1088#1080#1093#1086#1076#1072#1093'! '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1077#1075#1086' '#1087#1088#1086#1089#1090#1086' '#1091#1076#1072#1083#1080 +
        #1090#1100'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101622183=  ERR_MSG = PROCNAME||ERR_MSG;'
      '1101622184=  EXIT;'
      '1101622185='
      '1101622186=when sqlcode -530 DO'
      '1101622187=  begin'
      '1101622188=    UPDATE G_PRODUCT g'
      '1101622189=       SET G.IS_ACTIVE = :IS_ACTIVE_'
      '1101622190=     WHERE g.G_PRODUCT = :G_PRODUCT_'
      '1101622191=    RETURNING'
      '1101622192=      G.NAME'
      '1101622193=    INTO'
      '1101622194=      :NAME_;'
      '1101622195='
      '1101622196=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101622197=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1101622198=  end'
      '1101622199=end'
      '1101622200=;'
      '1101622201='
      '1101622202=ALTER PROCEDURE G_UPD_G_CLIENT('
      '1101622203=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101622204=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT,'
      '1101622205=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '1101622206=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101622207=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '1101622208=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '1101622209=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '1101622210=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '1101622211=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '1101622212=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '1101622213=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '1101622214=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '1101622215=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '1101622216=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '1101622217=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '1101622218=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '1101622219=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      
        '1101622220=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ','
      '1101622221=  NOTIFY_SKIDKA_ INTEGER,'
      '1101622222=  NOTIFY_DR_ INTEGER,'
      '1101622223=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '1101622224=  G_CLIENT_PROMO_ INTEGER,'
      
        '1101622225=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BON' +
        'US_PAY_SUMM,'
      
        '1101622226=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101622227=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101622228=RETURNS ('
      '1101622229=  ERR_CODE INTEGER,'
      '1101622230=  ERR_MSG VARCHAR(1024))'
      '1101622231=AS'
      '1101622232=DECLARE VARIABLE CNT_ INTEGER;'
      '1101622233=BEGIN'
      
        '1101622234=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1' +
        ', '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '1101622235=  if (BY_DEFAULT_ = 1) then'
      '1101622236=    UPDATE g_client'
      '1101622237=       SET BY_DEFAULT = 0'
      '1101622238=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '1101622239='
      '1101622240=  UPDATE g_client'
      '1101622241=  SET'
      
        '1101622242=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CL' +
        'IENT_PARENT),'
      
        '1101622243=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTR' +
        'AGENT),'
      '1101622244=   NAME = COALESCE(:NAME_, NAME),'
      '1101622245=   IDN  = COALESCE(:IDN_, IDN),'
      '1101622246=   KBE  = COALESCE(:KBE_, KBE),'
      '1101622247=   PHONE = COALESCE(:PHONE_, PHONE),'
      '1101622248=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '1101622249=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      
        '1101622250=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER)' +
        ','
      '1101622251=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '1101622252=   ,DT    = :DT_ --COALESCE(:DT_, DT)'
      '1101622253=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '1101622254=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '1101622255=   ,G_PROMOTION = :G_PROMOTION_'
      '1101622256=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '1101622257=   ,NOTIFY_DR = :NOTIFY_DR_'
      '1101622258=   ,MAX_BONUS_PAY_SUMM = :MAX_BONUS_PAY_SUMM_'
      '1101622259=  WHERE'
      '1101622260=    g_client = :g_client_;'
      '1101622261='
      '1101622262=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '1101622263=    IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '1101622264=        IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '1101622265=                     FROM G_DISCONT_CARD'
      '1101622266=                    WHERE BARCODE = :BARCODE_'
      
        '1101622267=                      AND G_CLIENT <> :G_CLIENT_)) TH' +
        'EN BEGIN'
      '1101622268=          ERR_CODE = -20500;'
      
        '1101622269=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1050#1072 +
        #1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '1101622270=          EXIT;'
      '1101622271=        END'
      '1101622272=    END'
      '1101622273='
      '1101622274=    UPDATE G_DISCONT_CARD G'
      '1101622275=    SET G.BARCODE = :BARCODE_,'
      '1101622276=        G.N_PERCENT = :N_PERCENT_,'
      '1101622277=        G.summ = COALESCE(G.summ, 0),'
      '1101622278=        G.summ_all = COALESCE(G.summ_all, 0)'
      '1101622279=    WHERE G.G_CLIENT = :g_client_;'
      '1101622280='
      '1101622281=    if (ROW_COUNT = 0) then'
      
        '1101622282=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '1101622283=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, 0, (select Coalesce(sum(SUMM_FACT), ' +
        '0) from zakaz where g_client = :g_client_));'
      '1101622284=  END'
      '1101622285='
      '1101622286=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101622287=  EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_CL' +
        'IENT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1101622288=end'
      '1101622289=;'
      '1101622290='
      '1101622291=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1101622292=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101622293=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101622294=  ARTICUL_ VARCHAR(30),'
      '1101622295=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101622296=  BARCODE_ VARCHAR(30),'
      '1101622297=  NAME_ VARCHAR(500),'
      '1101622298=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101622299=  PRICE_ NUMERIC(15,2),'
      '1101622300=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101622301=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101622302=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101622303=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101622304=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101622305=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101622306=  IS_CATEGORY_ INTEGER,'
      '1101622307=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101622308=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101622309=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101622310=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101622311=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101622312=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101622313=  IS_MARKED_ INTEGER,'
      
        '1101622314=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101622315=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101622316=RETURNS ('
      '1101622317=  ERR_CODE INTEGER,'
      '1101622318=  ERR_MSG VARCHAR(1024))'
      '1101622319=AS'
      
        '1101622320=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      
        '1101622321=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101622322=begin'
      
        '1101622323=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101622324=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '1101622325=                  FROM G_PRODUCT G'
      
        '1101622326=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(' +
        ':ARTICUL_))'
      '1101622327=                   AND TRIM(G.ARTICUL) <> '#39#39
      '1101622328=                   AND TRIM(:ARTICUL_) <> '#39#39
      '1101622329=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101622330=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101622331=      ERR_CODE = -20500;'
      
        '1101622332=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '1101622333=      EXIT;'
      '1101622334=    END'
      '1101622335='
      
        '1101622336=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1101622337=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101622338=                  FROM G_PRODUCT G'
      
        '1101622339=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPP' +
        'ER(TRIM(:NOMENCLATUR_NUM_))'
      '1101622340=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1101622341=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1101622342=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101622343=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101622344=      ERR_CODE = -20500;'
      
        '1101622345=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101622346=      EXIT;'
      '1101622347=    END'
      '1101622348='
      '1101622349=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101622350=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101622351=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101622352=                  FROM G_PRODUCT G'
      
        '1101622353=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(' +
        ':BARCODE_))'
      '1101622354=                   AND TRIM(G.BARCODE) <> '#39#39
      '1101622355=                   AND TRIM(:BARCODE_) <> '#39#39
      '1101622356=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101622357=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101622358=          ERR_CODE = -20500;'
      
        '1101622359=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101622360=          EXIT;'
      '1101622361=        END'
      '1101622362='
      '1101622363=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101622364=                    FROM G_PRODUCT G, LT_BARCODE L'
      '1101622365=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101622366=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '1101622367=                     AND TRIM(L.BARCODE) <> '#39#39
      '1101622368=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101622369=          ERR_CODE = -20500;'
      
        '1101622370=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101622371=          EXIT;'
      '1101622372=        END'
      '1101622373=    END'
      '1101622374='
      '1101622375=    update G_PRODUCT'
      '1101622376=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1101622377=        ARTICUL = :ARTICUL_,'
      '1101622378=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1101622379=        BARCODE = :BARCODE_,'
      '1101622380=        NAME = :NAME_,'
      '1101622381=        G_UNIT = :G_UNIT_,'
      '1101622382=        PRICE = :PRICE_,'
      '1101622383=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101622384=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1101622385=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1101622386=        NOTE         = :NOTE_,'
      '1101622387=        CROSSCODE    = :CROSSCODE_,'
      '1101622388=        IS_KIT       = :IS_KIT_,'
      '1101622389=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1101622390=        PLACE        = :PLACE_,'
      '1101622391=        SALES_COMM   = :SALES_COMM_,'
      '1101622392=        KOD_TNVD     = :KOD_TNVD_,'
      '1101622393=        FAST_TOVAR   = :FAST_TOVAR_,'
      '1101622394=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '1101622395=        IS_MARKED    = :IS_MARKED_'
      '1101622396=    where (G_PRODUCT = :G_PRODUCT_);'
      '1101622397='
      '1101622398=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1101622399=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1101622400='
      '1101622401=        INSERT INTO LT_BARCODE'
      
        '1101622402=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101622403='
      '1101622404=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1101622405=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1101622406=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1101622407='
      
        '1101622408=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1101622409=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101622410='
      '1101622411=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1101622412=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1101622413=            /*INSERT INTO G_PRODUCT_KIT'
      
        '1101622414=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1101622415=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1101622416=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1101622417=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1101622418='
      
        '1101622419=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1101622420=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101622421='
      '1101622422=            UPDATE G_PRODUCT_KIT G'
      
        '1101622423=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1101622424=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1101622425=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1101622426=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1101622427='
      
        '1101622428=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' ' +
        #1074#1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '1101622429=            */'
      
        '1101622430=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PRO' +
        'DUCT = :G_PRODUCT_;'
      '1101622431=            INSERT INTO G_PRODUCT_KIT'
      
        '1101622432=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '1101622433=            FROM G_PRODUCT_KIT_TMP T;'
      '1101622434='
      
        '1101622435=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1101622436=            if (is_kit_ = 1) then begin'
      
        '1101622437=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101622438=                  FROM G_PRODUCT_KIT K,'
      '1101622439=                       LT_SKLAD_PRODUCT L'
      '1101622440=                 WHERE K.g_product = :G_PRODUCT_'
      '1101622441=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101622442=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101622443=                 GROUP BY K.G_PRODUCT'
      '1101622444=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101622445='
      '1101622446=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101622447=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1101622448=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101622449=            end'
      '1101622450=        END'
      '1101622451=    END'
      '1101622452='
      '1101622453=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101622454=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1101622455=end'
      '1101622456=;'
      '1101622457='
      '1101622458=ALTER PROCEDURE INS_SKLAD('
      '1101622459=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1101622460=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1101622461=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1101622462=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1101622463=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1101622464=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101622465=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101622466=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1101622467=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101622468=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1101622469=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101622470=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101622471=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1101622472=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1101622473=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1101622474=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101622475=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101622476=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101622477=RETURNS ('
      '1101622478=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101622479=  ERR_CODE INTEGER,'
      '1101622480=  ERR_MSG VARCHAR(1024))'
      '1101622481=AS'
      '1101622482=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '1101622483=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054 +
        #1042#1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '1101622484=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '1101622485=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '1101622486=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059 +
        #1055#1050#1048
      
        '1101622487=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '1101622488=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053 +
        #1050#1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054 +
        #1047#1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '1101622489=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041 +
        #1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUM' +
        'M '#1041#1059#1044#1059
      '1101622490=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1101622491=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048 +
        #1047#1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053 +
        #1048' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '1101622492=--'
      
        '1101622493=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1101622494=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1101622495=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '1101622496=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101622497=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1101622498=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1101622499=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1101622500=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1101622501=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '1101622502=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_' +
        'SUMM = 0;'
      
        '1101622503=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      '1101622504=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101622505=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PR' +
        'IHOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '1101622506=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101622507=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101622508=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1101622509=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101622510=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101622511=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1101622512=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101622513=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101622514=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1101622515=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1101622516=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101622517=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1101622518=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1101622519=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK' +
        '_CODE;'
      '1101622520=BEGIN'
      '1101622521='
      '1101622522=  PNT_ = '#39'00'#39';'
      '1101622523=  IS_THIS_LAST_ = 0;'
      '1101622524='
      '1101622525=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101622526=    SELECT ID'
      '1101622527=      FROM CUR_PARAMS'
      '1101622528=     WHERE CUR_PARAMS = 2'
      '1101622529=      INTO :G_TOCHKA_;'
      '1101622530='
      '1101622531=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1101622532=  SELECT ID'
      '1101622533=    FROM CUR_PARAMS'
      '1101622534=   WHERE CUR_PARAMS = 1'
      '1101622535=    INTO :G_OFFICIAL_;'
      '1101622536='
      '1101622537=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101622538=                            DATE_RECEIPT,'
      '1101622539=                            TIME_RECEIPT,'
      '1101622540=                            G_CLIENT,'
      '1101622541=                            G_PAYMENT_TYPE,'
      '1101622542=                            OSNOVANIE,'
      '1101622543=                            NOTE,'
      '1101622544=                            SUMM,'
      '1101622545=                            SUMM_FACT,'
      '1101622546=                            SUMM_CURRENCY,'
      '1101622547=                            IS_PAYED_ALL,'
      '1101622548=                            IS_VOZVRAT,'
      '1101622549=                            G_TOCHKA'
      '1101622550=                            ,G_OFFICIAL'
      '1101622551=                            ,IS_EXPECTED)'
      '1101622552=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101622553=          :DATE_RECEIPT_,'
      '1101622554=          :TIME_RECEIPT_,'
      '1101622555=          :G_CLIENT_,'
      '1101622556=          :G_PAYMENT_TYPE_,'
      '1101622557=          :OSNOVANIE_,'
      '1101622558=          :NOTE_,'
      '1101622559=          :SUMM_,'
      '1101622560=          :SUMM_FACT_,'
      '1101622561=          :SUMM_CURRENCY_,'
      
        '1101622562=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_P' +
        'AYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' ' +
        '"'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101622563=          :IS_VOZVRAT_,'
      '1101622564=          :G_TOCHKA_'
      '1101622565=          ,:G_OFFICIAL_'
      '1101622566=          ,:IS_EXPECTED_)'
      '1101622567=  RETURNING'
      '1101622568=    SKLAD'
      '1101622569=  INTO'
      '1101622570=    :SKLAD_;'
      '1101622571='
      '1101622572=  PNT_ = '#39'01'#39';'
      '1101622573=  FOR SELECT SKLAD,'
      '1101622574=             T.G_PRODUCT,'
      '1101622575=             AMOUNT,'
      '1101622576=             T.PRICE,'
      '1101622577=             SUMM,'
      '1101622578=             NDS,'
      '1101622579=             NDS_SUMM'
      '1101622580=             ,PRICE_CURRENCY'
      '1101622581=             ,SUMM_CURRENCY'
      '1101622582=             ,PRICE_ROZN'
      '1101622583=             ,GG.PRICE'
      '1101622584=             ,T.MARK_CODE'
      '1101622585=        FROM SKLAD_TMP T,'
      '1101622586=             G_PRODUCT GG'
      '1101622587=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '1101622588=      ORDER BY 1'
      '1101622589=      INTO :SKLAD_TMP_,'
      '1101622590=           :RG_PRODUCT_,'
      '1101622591=           :RAMOUNT_,'
      '1101622592=           :RPRICE_,'
      '1101622593=           :RSUMM_,'
      '1101622594=           :RNDS_,'
      '1101622595=           :RNDS_SUMM_'
      '1101622596=           ,:PRICE_CURRENCY_'
      '1101622597=           ,:SUMM_CURRENCY_TMP_'
      '1101622598=           ,:SALE_PRICE_'
      '1101622599=           ,:SALE_PRICE_CUR_'
      '1101622600=           ,:MARK_CODE_'
      '1101622601=  DO BEGIN'
      '1101622602=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '1101622603=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST,' +
        ' '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101622604=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051 +
        #1068#1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '1101622605=      IS_THIS_LAST_ = 0;'
      '1101622606=      SELECT MAX(SK.DATE_RECEIPT)'
      '1101622607=        FROM SKLAD SK'
      '1101622608=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101622609=         AND SK.IS_LAST = 1'
      '1101622610=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101622611=        INTO :DATE_LAST_;'
      '1101622612='
      
        '1101622613=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101622614=        UPDATE SKLAD SK'
      '1101622615=           SET SK.IS_LAST = 0'
      '1101622616=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101622617=           AND SK.IS_LAST = 1'
      '1101622618=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101622619='
      '1101622620=        IS_THIS_LAST_ = 1;'
      '1101622621=      END'
      '1101622622=    END'
      '1101622623='
      '1101622624=    INSERT INTO SKLAD'
      '1101622625=    ('
      '1101622626=     SKLAD,'
      '1101622627=     SKLAD_PARENT,'
      '1101622628=     DATE_RECEIPT,'
      '1101622629=     G_CLIENT,'
      '1101622630=     G_PRODUCT,'
      '1101622631=     AMOUNT,'
      '1101622632=     PRICE,'
      '1101622633=     SUMM,'
      '1101622634=     G_PAYMENT_TYPE,'
      '1101622635=     OSNOVANIE,'
      '1101622636=     NOTE,'
      '1101622637=     NDS,'
      '1101622638=     NDS_SUMM,'
      '1101622639=     IS_LAST,'
      '1101622640=     IS_VOZVRAT,'
      '1101622641=     G_TOCHKA'
      '1101622642=     ,PRICE_CURRENCY'
      '1101622643=     ,SUMM_CURRENCY'
      '1101622644=     ,MARK_CODE'
      '1101622645=    ) VALUES ('
      '1101622646=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1101622647=     :SKLAD_,'
      '1101622648=     :DATE_RECEIPT_,'
      '1101622649=     :G_CLIENT_,'
      '1101622650=     :RG_PRODUCT_,'
      '1101622651=     :RAMOUNT_,'
      '1101622652=     :RPRICE_,'
      '1101622653=     :RSUMM_,'
      '1101622654=     :G_PAYMENT_TYPE_,'
      '1101622655=     :OSNOVANIE_,'
      '1101622656=     :NOTE_,'
      '1101622657=     :RNDS_,'
      '1101622658=     :RNDS_SUMM_,'
      
        '1101622659=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056 +
        #1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059 +
        #1044#1045#1058' 0'
      '1101622660=     :IS_VOZVRAT_,'
      '1101622661=     :G_TOCHKA_'
      '1101622662=     ,:PRICE_CURRENCY_'
      '1101622663=     ,:SUMM_CURRENCY_TMP_'
      '1101622664=     ,:MARK_CODE_'
      '1101622665=    );'
      '1101622666='
      
        '1101622667=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1101622668=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101622669=        PNT_ = '#39'02'#39';'
      '1101622670=        UPDATE LT_SKLAD_PRODUCT L'
      '1101622671=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1101622672=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101622673=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101622674='
      '1101622675=        IF (ROW_COUNT = 0) THEN'
      
        '1101622676=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA' +
        '_);'
      '1101622677=    END'
      '1101622678='
      
        '1101622679=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061 +
        #1054#1044#1045
      '1101622680=      UPDATE G_PRODUCT G'
      '1101622681=         SET G.PRICE = :SALE_PRICE_'
      '1101622682=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '1101622683=  END'
      '1101622684=  ----------------------------------------'
      '1101622685='
      
        '1101622686=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1101622687=  PNT_ = '#39'05'#39';'
      
        '1101622688=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1101622689=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1101622690=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101622691=      ELSE'
      '1101622692=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1101622693='
      
        '1101622694=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1101622695=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1101622696=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101622697=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1101622698=                                        :SUMM_FACT_,'
      
        '1101622699=                                        :DATE_RECEIPT' +
        '_,'
      
        '1101622700=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1101622701=                                        NULL,   --ZAK' +
        'AZ_'
      '1101622702=                                        :SKLAD_,'
      
        '1101622703=                                        :G_PAYMENT_TY' +
        'PE_,'
      
        '1101622704=                                        :G_TOCHKA_) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101622705=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101622706=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101622707=            EXIT;'
      '1101622708=          END'
      '1101622709=      END ELSE BEGIN'
      '1101622710=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1101622711=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1101622712=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101622713=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101622714=            ELSE'
      
        '1101622715=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101622716='
      '1101622717=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101622718=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101622719='
      
        '1101622720=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101622721='
      '1101622722=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101622723=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101622724=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1101622725=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1101622726=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1101622727=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101622728=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1101622729=                                              :SKLAD_' +
        ','
      
        '1101622730=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1101622731=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101622732=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101622733=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101622734=                  EXIT;'
      '1101622735=                END'
      '1101622736=            END'
      '1101622737=          END'
      '1101622738=      END'
      '1101622739=  END'
      '1101622740='
      '1101622741=  DELETE FROM SKLAD_TMP;'
      '1101622742='
      
        '1101622743=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1101622744=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101622745=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1101622746=                                  G_PRIHOD_,'
      '1101622747=                                  :SUMM_PRIHOD_,'
      '1101622748=                                  :DATE_RECEIPT_,'
      
        '1101622749=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101622750=                                  NULL,   --:ZAKAZ_,'
      '1101622751=                                  :SKLAD_,'
      '1101622752=                                  :G_PAYMENT_TYPE_,'
      
        '1101622753=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101622754=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101622755=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101622756=      EXIT;'
      '1101622757=    END'
      '1101622758=  END'
      '1101622759='
      '1101622760=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101622761=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THE' +
        'N'
      
        '1101622762=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101622763=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_, ' +
        '1);'
      '1101622764='
      '1101622765=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101622766=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1101622767=END'
      '1101622768=;'
      '1101622769='
      '1101622770=ALTER PROCEDURE INS_ZAKAZ('
      '1101622771=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101622772=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101622773=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101622774=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101622775=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101622776=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101622777=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101622778=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101622779=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101622780=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101622781=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101622782=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101622783=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101622784=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101622785=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101622786=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101622787=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101622788=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101622789=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101622790=  IS_MEBEL_ INTEGER = 0,'
      
        '1101622791=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1101622792=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      '1101622793=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '1101622794=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1101622795=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101622796=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1101622797=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1101622798=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101622799=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101622800=RETURNS ('
      '1101622801=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101622802=  ERR_CODE INTEGER,'
      '1101622803=  ERR_MSG VARCHAR(1024))'
      '1101622804=AS'
      '1101622805=/*'
      '1101622806=IS_SPISANIE_'
      '1101622807=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101622808=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101622809=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101622810=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101622811='
      '1101622812='
      
        '1101622813=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '1101622814=*/'
      '1101622815=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1101622816=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101622817=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101622818=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1101622819=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1101622820=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1101622821=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1101622822=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1101622823=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1101622824=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1101622825=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1101622826=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1101622827=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1101622828=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1101622829=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '1101622830=DECLARE VARIABLE CNT_ INTEGER;'
      '1101622831=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1101622832=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1101622833=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101622834=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101622835=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1101622836=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101622837=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101622838=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1101622839=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101622840=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101622841=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101622842=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1101622843=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1101622844=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101622845=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLI' +
        'ENT.SKIDKA;'
      
        '1101622846=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.N_PERCENT;'
      
        '1101622847=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DI' +
        'SCONT_CARD.SUMM_ALL;'
      
        '1101622848=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.MARK_CODE;'
      '1101622849=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1101622850=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1101622851=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1101622852=BEGIN'
      '1101622853='
      
        '1101622854=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1101622855=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1101622856=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1101622857=  IF (CNT_ = 0) THEN BEGIN'
      '1101622858=    ERR_CODE = -20500;'
      
        '1101622859=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101622860=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1101622861=    EXIT;'
      '1101622862=  END'
      '1101622863='
      '1101622864=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101622865=    SELECT ID'
      '1101622866=      FROM CUR_PARAMS'
      '1101622867=     WHERE CUR_PARAMS = 2'
      '1101622868=      INTO :G_TOCHKA_;'
      '1101622869='
      '1101622870=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101622871=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1101622872=      PNT_ = '#39'01'#39';'
      
        '1101622873=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101622874=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101622875=      ELSE'
      '1101622876=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101622877='
      '1101622878=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1101622879=      SELECT G.G_OFFICIAL,'
      '1101622880=             G.DO_NOT_SALES_COMM,'
      '1101622881=             G.FM||'#39' '#39'||G.NM'
      '1101622882=        FROM G_OFFICIAL G'
      
        '1101622883=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1101622884=        INTO :G_OFFICIAL_,'
      '1101622885=             :DO_NOT_SALES_COMM_,'
      '1101622886=             :OFFICIAL_NAME_;'
      '1101622887='
      '1101622888=      INSERT INTO ZAKAZ'
      '1101622889=      ('
      '1101622890=       ZAKAZ,'
      '1101622891=       G_TOCHKA,'
      '1101622892=       Z_DATE,'
      '1101622893=       Z_TIME,'
      '1101622894=       G_CLIENT,'
      '1101622895=       G_PAYMENT_TYPE,'
      '1101622896=       OSNOVANIE,'
      '1101622897=       IS_SPISANIE,'
      '1101622898=       NOTE,'
      '1101622899=       SUMM,'
      '1101622900=       SUMM_FACT,'
      '1101622901=       SUMM_BONUS,'
      '1101622902=       IS_PAYED_ALL'
      '1101622903=       ,G_OFFICIAL'
      '1101622904=       ,BY_RECIPE'
      '1101622905=       ,SUMM_BONUS_GOT'
      '1101622906=       ,IS_RESERVE'
      '1101622907=       ,SUMM_CASH'
      '1101622908=       ,SUMM_NONCASH'
      '1101622909=       ,NOT_MINUS_OSTATOK'
      '1101622910=      ) VALUES ('
      '1101622911=       GEN_ID(GEN_ZAKAZ, 1),'
      '1101622912=       :G_TOCHKA_,'
      '1101622913=       :Z_DATE_,'
      '1101622914=       :Z_TIME_,'
      '1101622915=       :G_CLIENT_,'
      '1101622916=       :G_PAYMENT_TYPE_,'
      '1101622917=       :OSNOVANIE_,'
      '1101622918=       :IS_SPISANIE_,'
      '1101622919=       :NOTE_,'
      '1101622920=       :SUMM_,'
      '1101622921=       :SUMM_FACT_1_,'
      '1101622922=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1101622923=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101622924=       ,:G_OFFICIAL_'
      '1101622925=       ,:BY_RECIPE_'
      '1101622926=       ,:SUMM_BONUS_GOT_'
      '1101622927=       ,:IS_RESERVE_'
      '1101622928=       ,COALESCE(:SUMM_CASH_, 0)'
      '1101622929=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1101622930=       ,:NOT_MINUS_OSTATOK_'
      '1101622931=      )'
      '1101622932=      RETURNING'
      '1101622933=        ZAKAZ'
      '1101622934=      INTO'
      '1101622935=        :ZAKAZ_;'
      '1101622936='
      '1101622937=      PNT_ = '#39'02'#39';'
      
        '1101622938=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1101622939=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM, Z.MARK_CODE'
      '1101622940=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1101622941=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1101622942=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1101622943=              :G_PRODUCT,'
      '1101622944=              :AMOUNT,'
      '1101622945=              :PRICE,'
      '1101622946=              :SUMM,'
      '1101622947=              :DISCOUNT_PERC,'
      '1101622948=              :DISCOUNT_TENGE,'
      '1101622949=              :DISCOUNT_SUMM,'
      '1101622950=              :NDS,'
      '1101622951=              :NDS_SUMM,'
      '1101622952=              :COST_PRICE,'
      '1101622953=              :SALES_COMM_,'
      '1101622954=              :MARK_CODE_'
      '1101622955=      DO BEGIN'
      
        '1101622956=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101622957=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1101622958=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1101622959=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101622960=        END'
      '1101622961='
      '1101622962=        INSERT INTO ZAKAZ_DETAILS'
      '1101622963=        VALUES('
      '1101622964=          :ZAKAZ_DETAILS_TMP_,'
      '1101622965=          :ZAKAZ_,'
      '1101622966=          :G_PRODUCT,'
      '1101622967=          :AMOUNT,'
      '1101622968=          :PRICE,'
      '1101622969=          :SUMM,'
      '1101622970=          :DISCOUNT_PERC,'
      '1101622971=          :DISCOUNT_TENGE,'
      '1101622972=          :DISCOUNT_SUMM,'
      '1101622973=          :NDS,'
      '1101622974=          :NDS_SUMM,'
      '1101622975=          :COST_PRICE,'
      '1101622976=          :SALES_COMM_SUMM_ITER_,'
      '1101622977=          :MARK_CODE_'
      '1101622978=        );'
      '1101622979='
      
        '1101622980=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1101622981=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1101622982=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1101622983=                UPDATE LT_SKLAD_PRODUCT L'
      '1101622984=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101622985=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101622986=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101622987='
      '1101622988=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101622989=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101622990=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057 +
        #1051#1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '1101622991=                PNT_ = '#39'04'#39';'
      
        '1101622992=                IF ((ROW_COUNT = 0) AND ((SELECT S_VA' +
        'LUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101622993=                  Err_Code = -20500;'
      
        '1101622994=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_C' +
        'ODE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_' +
        'PRODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072 +
        #1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101622995=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101622996=                  EXIT;'
      '1101622997=                END ELSE if (ROW_COUNT = 0) then'
      
        '1101622998=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101622999=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1101623000=            END'
      '1101623001='
      '1101623002=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101623003=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101623004=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101623005=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :AMOUNT'
      '1101623006=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101623007=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101623008='
      '1101623009='
      '1101623010=        END'
      '1101623011=      END'
      '1101623012='
      '1101623013=      ----------------------------------------'
      
        '1101623014=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1101623015=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1101623016=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1101623017='
      
        '1101623018=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1101623019=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1101623020=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1101623021=                PNT_ = '#39'05'#39';'
      
        '1101623022=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1101623023=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101623024=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1101623025=                                              :Z_DATE' +
        '_,'
      
        '1101623026=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101623027=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1101623028=                                              NULL,'
      
        '1101623029=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1101623030=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101623031=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623032=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101623033=                  EXIT;'
      '1101623034=                END'
      '1101623035=            END'
      '1101623036='
      '1101623037=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1101623038=        END ELSE BEGIN'
      '1101623039=            PNT_ = '#39'06'#39';'
      
        '1101623040=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1101623041=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101623042=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101623043=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101623044=                ELSE'
      
        '1101623045=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101623046='
      
        '1101623047=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101623048=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101623049='
      
        '1101623050=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101623051='
      '1101623052=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101623053=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101623054=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1101623055=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101623056=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101623057=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101623058=                                                  :ZA' +
        'KAZ_,'
      
        '1101623059=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1101623060=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101623061=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101623062=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623063=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101623064=                      EXIT;'
      '1101623065=                    END'
      '1101623066=                END'
      '1101623067=            END'
      '1101623068=        END'
      '1101623069=      END'
      '1101623070='
      
        '1101623071=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1101623072=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1101623073=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1101623074=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1101623075=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1101623076=          UPDATE G_DISCONT_CARD D'
      
        '1101623077=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1101623078=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1101623079=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1101623080=          RETURNING'
      '1101623081=            D.SUMM_ALL'
      '1101623082=          INTO'
      '1101623083=            :CLIENT_SUMM_ALL_;'
      '1101623084='
      '1101623085=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1101623086=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1101623087=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1101623088=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1101623089=          ORDER BY G.SUMM_FROM'
      '1101623090=          ROWS 1 TO 1'
      '1101623091=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1101623092='
      '1101623093=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1101623094=            UPDATE G_CLIENT G'
      '1101623095=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1101623096=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1101623097=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1101623098='
      '1101623099=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1101623100=            UPDATE G_DISCONT_CARD D'
      '1101623101=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1101623102=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1101623103=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1101623104=      END'
      '1101623105='
      '1101623106=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1101623107=      PNT_ = '#39'07'#39';'
      
        '1101623108=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN ' +
        'BEGIN'
      '1101623109=        SELECT S.S_VALUE'
      '1101623110=          FROM SYSTEM_SETUP S'
      '1101623111=         WHERE S.SYSTEM_SETUP = 4'
      '1101623112=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101623113='
      '1101623114=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101623115=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101623116=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101623117='
      
        '1101623118=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1101623119=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1101623120=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1101623121='
      '1101623122=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101623123=        ELSE'
      
        '1101623124=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1101623125='
      '1101623126=        KASSA_ZP_ID_ = NULL;'
      '1101623127=        SELECT K.KASSA, K.SUMM'
      '1101623128=        FROM KASSA K'
      '1101623129=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1101623130=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101623131=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101623132=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1101623133=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1101623134='
      
        '1101623135=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1101623136='
      '1101623137=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1101623138=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101623139=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101623140=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101623141=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101623142=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1101623143=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1101623144=                                          NULL,     -' +
        '-:SKLAD_,'
      '1101623145=                                          1,'
      '1101623146=                                          :G_TOCHKA_,'
      
        '1101623147=                                          :G_OFFICIAL' +
        '_'
      
        '1101623148=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1101623149=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101623150=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1101623151='
      '1101623152=        END ELSE BEGIN'
      
        '1101623153=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1101623154=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101623155=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101623156=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101623157='
      
        '1101623158=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1101623159=                                          1,     -- A' +
        'CTION_'
      
        '1101623160=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101623161=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101623162=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101623163=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      '1101623164=                                          NULL,'
      '1101623165=                                          NULL,'
      
        '1101623166=                                          :PAYMENT_TY' +
        'PE_,'
      
        '1101623167=                                          :G_OFFICIAL' +
        '_'
      
        '1101623168=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1101623169='
      '1101623170=        END'
      '1101623171=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623172=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101623173=          EXIT;'
      '1101623174=        END'
      '1101623175=      END'
      '1101623176='
      '1101623177=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101623178=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101623179=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101623180=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1);'
      '1101623181=  END'
      '1101623182=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101623183=  ----------------------------------------'
      '1101623184=  ----------------------------------------'
      '1101623185=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101623186=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1101623187=      PNT_ = '#39'25'#39';'
      
        '1101623188=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1101623189=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1101623190=      RETURNING ZAKAZ_REAL_PARENT'
      '1101623191=      INTO :ZAKAZ_;'
      '1101623192='
      
        '1101623193=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1101623194=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101623195=          INTO :G_PRODUCT,'
      '1101623196=              :AMOUNT,'
      '1101623197=              :PRICE,'
      '1101623198=              :SUMM,'
      '1101623199=              :DISCOUNT_PERC,'
      '1101623200=              :DISCOUNT_TENGE,'
      '1101623201=              :DISCOUNT_SUMM,'
      '1101623202=              :NDS,'
      '1101623203=              :NDS_SUMM'
      '1101623204=      DO BEGIN'
      '1101623205=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101623206=          UPDATE LT_SKLAD_PRODUCT L'
      '1101623207=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101623208=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101623209=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101623210='
      
        '1101623211=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101623212=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1101623213=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101623214=            Err_Code = -20500;'
      
        '1101623215=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101623216=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101623217=            EXIT;'
      '1101623218=          END ELSE if (ROW_COUNT = 0) then'
      
        '1101623219=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101623220=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1101623221='
      
        '1101623222=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1101623223=                                     G_PRODUCT,'
      '1101623224=                                     PRICE,'
      
        '1101623225=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1101623226=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1101623227=                                     NDS_SUMM)'
      
        '1101623228=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_,'
      '1101623229=                  :G_PRODUCT,'
      
        '1101623230=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1101623231=                  :AMOUNT, :SUMM,'
      '1101623232=                  0, --AMOUNT_PAYED,'
      '1101623233=                  0, --SUMM_PAYED,'
      '1101623234=                  0, --IS_PAYED_ALL,'
      '1101623235=                  :DISCOUNT_PERC,'
      '1101623236=                  :DISCOUNT_TENGE,'
      '1101623237=                  :DISCOUNT_SUMM,'
      '1101623238=                  :NDS,'
      '1101623239=                  :NDS_SUMM)'
      '1101623240=          RETURNING ZAKAZ_NA_REAL'
      '1101623241=          INTO :ZAKAZ_;'
      '1101623242=      END'
      '1101623243=  END'
      '1101623244=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101623245=  ----------------------------------------'
      '1101623246=  ----------------------------------------'
      '1101623247=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1101623248=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1101623249=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101623250=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1101623251=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1101623252=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1101623253=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1101623254=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1101623255=      RETURNING SKLAD'
      '1101623256=      INTO :ZAKAZ_;'
      '1101623257='
      '1101623258=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101623259=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101623260=          INTO :G_PRODUCT,'
      '1101623261=              :AMOUNT,'
      '1101623262=              :PRICE,'
      '1101623263=              :SUMM'
      '1101623264=      DO BEGIN'
      '1101623265=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101623266=        UPDATE LT_SKLAD_PRODUCT L'
      '1101623267=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101623268=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101623269=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101623270='
      '1101623271=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101623272=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1101623273=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1101623274=        SELECT MAX(SK.DATE_RECEIPT)'
      '1101623275=            FROM SKLAD SK'
      '1101623276=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101623277=             AND SK.IS_LAST = 1'
      '1101623278=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1101623279=            INTO :DATE_LAST_;'
      '1101623280='
      
        '1101623281=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101623282=            UPDATE SKLAD SK'
      '1101623283=               SET SK.IS_LAST = 0'
      '1101623284=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101623285=               AND SK.IS_LAST = 1'
      '1101623286=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101623287='
      '1101623288=            IS_THIS_LAST_ = 1;'
      '1101623289=        END */'
      '1101623290='
      '1101623291='
      '1101623292=        INSERT INTO SKLAD'
      '1101623293=        ('
      '1101623294=         SKLAD,'
      '1101623295=         SKLAD_PARENT,'
      '1101623296=         DATE_RECEIPT,'
      '1101623297=         G_CLIENT,'
      '1101623298=         G_PRODUCT,'
      '1101623299=         AMOUNT,'
      '1101623300=         PRICE,'
      '1101623301=         SUMM,'
      '1101623302=         G_PAYMENT_TYPE,'
      '1101623303=         OSNOVANIE,'
      '1101623304=         NOTE,'
      '1101623305=         NDS,'
      '1101623306=         NDS_SUMM,'
      '1101623307=         IS_LAST,'
      '1101623308=         IS_VOZVRAT,'
      '1101623309=         G_TOCHKA'
      '1101623310=        ) VALUES ('
      '1101623311=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101623312=         :ZAKAZ_,'
      '1101623313=         :Z_DATE_,'
      '1101623314=         :G_TOCHKA_,'
      '1101623315=         :G_PRODUCT,'
      '1101623316=         :AMOUNT,'
      '1101623317=         :PRICE,'
      '1101623318=         :SUMM,'
      '1101623319=         :G_PAYMENT_TYPE_,'
      '1101623320=         :OSNOVANIE_,'
      '1101623321=         :NOTE_,'
      '1101623322=         0,  --:RNDS_,'
      '1101623323=         0,  --:RNDS_SUMM_,'
      
        '1101623324=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1101623325=         3,  --:IS_VOZVRAT_,'
      '1101623326=         :G_CLIENT_'
      '1101623327=        );'
      '1101623328='
      
        '1101623329=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101623330=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1101623331=        PNT_ = '#39'02'#39';'
      '1101623332=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101623333=            UPDATE LT_SKLAD_PRODUCT L'
      '1101623334=               SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '1101623335=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101623336=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1101623337='
      '1101623338=            IF (ROW_COUNT = 0) THEN'
      
        '1101623339=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLA' +
        'D_PRODUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '1101623340=        END'
      '1101623341=      END'
      '1101623342=  END'
      '1101623343='
      '1101623344=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101623345='
      
        '1101623346=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1101623347=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101623348=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1101623349=                                  G_PRIHOD_,'
      '1101623350=                                  :SUMM_PRIHOD_,'
      '1101623351=                                  :Z_DATE_,'
      
        '1101623352=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101623353=                                  :ZAKAZ_,'
      '1101623354=                                  NULL,'
      '1101623355=                                  :G_PAYMENT_TYPE_,'
      
        '1101623356=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101623357=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623358=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101623359=      EXIT;'
      '1101623360=    END'
      '1101623361=  END'
      '1101623362='
      
        '1101623363=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1101623364=  IF (IS_MEBEL_ = 1) THEN'
      
        '1101623365=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1101623366=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1101623367='
      '1101623368=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101623369=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1101623370='
      '1101623371=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1101623372=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1101623373=end'
      '1101623374=;'
      '1101623375='
      '1101623376=ALTER PROCEDURE K_DEL_KASSA('
      '1101623377=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      
        '1101623378=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      
        '1101623379=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101623380=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101623381=RETURNS ('
      '1101623382=  ERR_CODE INTEGER,'
      '1101623383=  ERR_MSG VARCHAR(1024))'
      '1101623384=AS'
      '1101623385=/*'
      
        '1101623386='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1101623387=*/'
      '1101623388=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1101623389=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101623390=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1101623391=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1101623392=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '1101623393=DECLARE VARIABLE ACTION_DATE_ DATE;'
      
        '1101623394=DECLARE VARIABLE ACTION_ TYPE OF COLUMN KASSA."ACTION' +
        '";'
      
        '1101623395=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101623396=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '1101623397=BEGIN'
      '1101623398=  PROCNAME = '#39'K_DEL_KASSA'#39';'
      '1101623399='
      
        '1101623400=  ---------------------------------------------------' +
        '-------------------'
      '1101623401=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1101623402=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMEN' +
        'T_TYPE_ = 1)) THEN BEGIN'
      '1101623403=      SELECT K.SUMM,'
      '1101623404=             K.ACTION_DATE,'
      '1101623405=             K."ACTION",'
      '1101623406=             K.G_TOCHKA'
      '1101623407=        FROM KASSA K'
      '1101623408=       WHERE K.KASSA = :KASSA_'
      
        '1101623409=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA' +
        '_;'
      '1101623410='
      
        '1101623411=      --*********************************************' +
        '****'
      '1101623412=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '1101623413=      --*********************************************' +
        '****'
      '1101623414=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1101623415=      PNT_ = '#39'02'#39';'
      '1101623416=      IF (:ACTION_ = 0) THEN'
      '1101623417=        CREDIT_ = SUMM_;'
      '1101623418=      ELSE'
      '1101623419=        DEBET_ = SUMM_;'
      '1101623420='
      '1101623421=      UPDATE KASSA_STATE K'
      '1101623422=         SET K.DEBET = K.DEBET - :DEBET_,'
      '1101623423=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '1101623424=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_)' +
        ' + (K.CREDIT - :CREDIT_)'
      '1101623425=       WHERE K.K_DATE = :ACTION_DATE_'
      '1101623426=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '1101623427='
      
        '1101623428=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058 +
        #1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1101623429=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1101623430=        SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '1101623431=                     '#39'SET K.DEBET = K.DEBET - '#39'||COAL' +
        'ESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '1101623432=                          '#39'K.CREDIT = K.CREDIT - '#39'||C' +
        'OALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '1101623433=                          '#39'K.OUTPUT = K.INPUT - (K.DE' +
        'BET - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CRE' +
        'DIT_, 0)||'#39') '#39'||'
      
        '1101623434=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DAT' +
        'E_||'#39#39#39' '#39'||'
      
        '1101623435=                     '#39'AND K.G_TOCHKA = '#39'||G_TOCHKA_||' +
        #39';'#39';'
      
        '1101623436=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSF' +
        'ERED, SYSDATE, ERR_CODE)'
      
        '1101623437=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYS' +
        'DBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1101623438=      END'
      '1101623439='
      
        '1101623440=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1101623441=      PNT_ = '#39'04'#39';'
      
        '1101623442=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_,' +
        ' :G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1101623443=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623444=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101623445=        EXIT;'
      '1101623446=      END'
      '1101623447='
      '1101623448=      DELETE FROM KASSA'
      '1101623449=      WHERE KASSA = :KASSA_;'
      '1101623450=  END'
      
        '1101623451=  ---------------------------------------------------' +
        '-------------------'
      '1101623452=  --*************************************************'
      
        '1101623453=  ---------------------------------------------------' +
        '-------------------'
      
        '1101623454=  ---------------------------------------------------' +
        '-------------------'
      '1101623455=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '1101623456=  ELSE BEGIN'
      '1101623457=      SELECT K.SUMM,'
      '1101623458=             K.ACTION_DATE,'
      '1101623459=             K."ACTION",'
      '1101623460=             K.G_TOCHKA'
      '1101623461=        FROM KASSA_BEZNAL K'
      '1101623462=       WHERE K.KASSA_BEZNAL = :KASSA_'
      
        '1101623463=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA' +
        '_;'
      '1101623464='
      
        '1101623465=      --*********************************************' +
        '****'
      '1101623466=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '1101623467=      --*********************************************' +
        '****'
      '1101623468=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1101623469=      PNT_ = '#39'02'#39';'
      '1101623470=      IF (:ACTION_ = 0) THEN'
      '1101623471=        CREDIT_ = SUMM_;'
      '1101623472=      ELSE'
      '1101623473=        DEBET_ = SUMM_;'
      '1101623474='
      '1101623475=      UPDATE KASSA_BEZNAL_STATE K'
      '1101623476=         SET K.DEBET = K.DEBET - :DEBET_,'
      '1101623477=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '1101623478=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_)' +
        ' + (K.CREDIT - :CREDIT_)'
      '1101623479=       WHERE K.K_DATE = :ACTION_DATE_;'
      '1101623480='
      
        '1101623481=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058 +
        #1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1101623482=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      '1101623483=        SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'||'
      
        '1101623484=                     '#39'SET K.DEBET = K.DEBET - '#39'||COAL' +
        'ESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '1101623485=                         '#39'K.CREDIT = K.CREDIT - '#39'||CO' +
        'ALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '1101623486=                         '#39'K.OUTPUT = K.INPUT - (K.DEB' +
        'ET - '#39'||COALESCE(:DEBET_, 0)||'#39') + (K.CREDIT - '#39'||COALESCE(:CRED' +
        'IT_, 0)||'#39') '#39'||'
      
        '1101623487=                   '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_DAT' +
        'E_||'#39#39#39';'#39';'
      '1101623488='
      
        '1101623489=        INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSF' +
        'ERED, SYSDATE, ERR_CODE)'
      
        '1101623490=        VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYS' +
        'DBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1101623491=      END'
      '1101623492='
      
        '1101623493=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1101623494=      PNT_ = '#39'04'#39';'
      
        '1101623495=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION' +
        '_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1101623496=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623497=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101623498=        EXIT;'
      '1101623499=      END'
      '1101623500='
      '1101623501=      DELETE FROM KASSA_BEZNAL'
      '1101623502=      WHERE KASSA_BEZNAL = :KASSA_;'
      '1101623503=  END'
      
        '1101623504=  ---------------------------------------------------' +
        '-------------------'
      '1101623505=  --*************************************************'
      '1101623506='
      '1101623507=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101623508=  EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :USER' +
        '_ID_, :KASSA_, :ACTION_DATE_, 3, :SUMM_, :LOG_BODY_);'
      '1101623509='
      '1101623510=when sqlcode -530 DO'
      '1101623511=  begin'
      '1101623512=    ERR_CODE = -20500;'
      
        '1101623513=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101623514=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101623515=  end'
      '1101623516=end'
      '1101623517=;'
      '1101623518='
      '1101623519=ALTER PROCEDURE K_GET_KASSA_SUMM('
      '1101623520=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101623521=  DATE_ DATE)'
      '1101623522=RETURNS ('
      '1101623523=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1101623524=  SUMM_BZ_ TYPE OF COLUMN KASSA_BEZNAL.SUMM,'
      '1101623525=  ERR_CODE INTEGER,'
      '1101623526=  ERR_MSG VARCHAR(1024))'
      '1101623527=AS'
      '1101623528=begin'
      '1101623529=      SELECT ID'
      '1101623530=        FROM CUR_PARAMS'
      '1101623531=       WHERE CUR_PARAMS = 2'
      '1101623532=        INTO :G_TOCHKA_;'
      '1101623533='
      '1101623534=      SELECT'
      '1101623535=        T.OUTPUT'
      '1101623536=      FROM KASSA_STATE T'
      '1101623537=      WHERE T.K_DATE = (SELECT MAX(S.K_DATE)'
      '1101623538=                          FROM KASSA_STATE S'
      '1101623539=                         WHERE S.K_DATE <= :DATE_'
      
        '1101623540=                           AND S.G_TOCHKA = :G_TOCHKA' +
        '_)'
      '1101623541=        AND T.G_TOCHKA = :G_TOCHKA_'
      '1101623542=      INTO'
      '1101623543=        SUMM_;'
      '1101623544='
      '1101623545=      SELECT'
      '1101623546=        T.OUTPUT'
      '1101623547=      FROM KASSA_BEZNAL_STATE T'
      '1101623548=      WHERE T.K_DATE = (SELECT MAX(S.K_DATE)'
      '1101623549=                          FROM KASSA_BEZNAL_STATE S'
      '1101623550=                         WHERE S.K_DATE <= :DATE_)'
      '1101623551=      INTO'
      '1101623552=        SUMM_BZ_;'
      '1101623553=end'
      '1101623554=;'
      '1101623555='
      '1101623556=ALTER PROCEDURE K_INS_KASSA('
      '1101623557=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1101623558=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1101623559=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1101623560=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1101623561=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1101623562=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1101623563=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      
        '1101623564=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101623565=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101623566=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL,'
      
        '1101623567=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101623568=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101623569=RETURNS ('
      '1101623570=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1101623571=  ERR_CODE INTEGER,'
      '1101623572=  ERR_MSG VARCHAR(1024))'
      '1101623573=AS'
      '1101623574=/*'
      
        '1101623575='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1101623576=*/'
      '1101623577=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1101623578=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101623579=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1101623580=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1101623581=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '1101623582=begin'
      '1101623583=  PROCNAME = '#39'K_INS_KASSA'#39';'
      '1101623584='
      '1101623585=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101623586=    SELECT ID'
      '1101623587=      FROM CUR_PARAMS'
      '1101623588=     WHERE CUR_PARAMS = 2'
      '1101623589=      INTO :G_TOCHKA_;'
      '1101623590='
      
        '1101623591=  ---------------------------------------------------' +
        '-------------------'
      '1101623592=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1101623593=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMEN' +
        'T_TYPE_ = 1)) THEN BEGIN'
      
        '1101623594=      insert into KASSA (KASSA, "ACTION", G_PRIHOD_RA' +
        'SHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, G_OFFICIA' +
        'L)'
      
        '1101623595=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIH' +
        'OD_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_' +
        'TOCHKA_, :G_OFFICIAL_)'
      '1101623596=      returning KASSA'
      '1101623597=      into :KASSA_;'
      '1101623598='
      '1101623599=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1101623600=      PNT_ = '#39'02'#39';'
      '1101623601=      IF (:ACTION_ = 0) THEN'
      '1101623602=        CREDIT_ = SUMM_;'
      '1101623603=      ELSE'
      '1101623604=        DEBET_ = SUMM_;'
      '1101623605='
      
        '1101623606=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DAT' +
        'E_, :G_TOCHKA_, :DEBET_, :CREDIT_, 1) RETURNING_VALUES (:ERR_COD' +
        'E, :ERR_MSG);'
      '1101623607=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101623608=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101623609=        EXIT;'
      '1101623610=      END'
      '1101623611='
      
        '1101623612=      -----------------------------------------------' +
        '-----------------------'
      
        '1101623613=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1101623614=      PNT_ = '#39'04'#39';'
      
        '1101623615=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_,' +
        ' :G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1101623616=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623617=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101623618=        EXIT;'
      '1101623619=      END'
      '1101623620=  END'
      
        '1101623621=  ---------------------------------------------------' +
        '-------------------'
      
        '1101623622=  ---------------------------------------------------' +
        '-------------------'
      '1101623623=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1101623624=  ---------- '#1042' KASSA_BEZNAL_STATE '#1053#1045' '#1044#1045#1051#1040#1070' '#1056#1040#1047#1044#1045#1051#1045#1053#1048#1045 +
        ' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052', '#1042#1045#1044#1068' '#1056#1040#1057#1063#1045#1058#1053#1067#1049' '#1057#1063#1045#1058' '#1054#1041#1065#1048#1049
      '1101623625=  ELSE BEGIN'
      
        '1101623626=      insert into KASSA_BEZNAL (KASSA_BEZNAL, "ACTION' +
        '", G_PRIHOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOC' +
        'HKA, G_OFFICIAL)'
      
        '1101623627=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIH' +
        'OD_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_' +
        'TOCHKA_, :G_OFFICIAL_)'
      '1101623628=      returning KASSA_BEZNAL'
      '1101623629=      into :KASSA_;'
      '1101623630='
      '1101623631=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1101623632=      PNT_ = '#39'02A'#39';'
      '1101623633=      IF (:ACTION_ = 0) THEN'
      '1101623634=        CREDIT_ = SUMM_;'
      '1101623635=      ELSE'
      '1101623636=        DEBET_ = SUMM_;'
      '1101623637='
      
        '1101623638=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DAT' +
        'E_, :G_TOCHKA_, :DEBET_, :CREDIT_, 0) RETURNING_VALUES (:ERR_COD' +
        'E, :ERR_MSG);'
      '1101623639=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101623640=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101623641=        EXIT;'
      '1101623642=      END'
      '1101623643='
      
        '1101623644=      -----------------------------------------------' +
        '-----------------------'
      
        '1101623645=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1101623646=      PNT_ = '#39'04A'#39';'
      
        '1101623647=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION' +
        '_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1101623648=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623649=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101623650=        EXIT;'
      '1101623651=      END'
      '1101623652=  END'
      
        '1101623653=  ---------------------------------------------------' +
        '-------------------'
      
        '1101623654=  ---------------------------------------------------' +
        '-------------------'
      '1101623655=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101623656=  EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :USER' +
        '_ID_, :KASSA_, :ACTION_DATE_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1101623657=end'
      '1101623658=;'
      '1101623659='
      '1101623660=ALTER PROCEDURE K_PAY_DOLG('
      '1101623661=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1101623662=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1101623663=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1101623664=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1101623665=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1101623666=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1101623667=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      
        '1101623668=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101623669=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101623670=  ZAKAZ_ARR_ BLOB SUB_TYPE 1,'
      
        '1101623671=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101623672=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101623673=RETURNS ('
      '1101623674=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1101623675=  ERR_CODE INTEGER,'
      '1101623676=  ERR_MSG VARCHAR(1024))'
      '1101623677=AS'
      '1101623678=/*'
      
        '1101623679=ZAKAZ_ARR_ - '#1052#1040#1057#1057#1048#1042' '#1055#1056#1054#1044#1040#1046', '#1055#1054' '#1050#1054#1058#1054#1056#1067#1052' '#1050#1051#1048#1045#1053#1058' '#1043#1040#1057#1048#1058' '#1044 +
        #1054#1051#1043#1048
      '1101623680='
      
        '1101623681='#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1055#1051#1040#1058#1040' '#1044#1054#1051#1043#1040' '#1048' '#1054#1058' '#1042#1053#1054#1057#1048#1052#1054#1049' '#1057#1059#1052#1052#1067' '#1063#1058#1054'-'#1058#1054' '#1054#1057#1058#1040 +
