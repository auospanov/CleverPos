      '110960=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110961=  TYPE_ INTEGER = 0,'
      
        '110962=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR =' +
        ' NULL)'
      '110963=RETURNS ('
      '110964=  SORT_COL DM_BIGINT,'
      '110965=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110966=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '110967=  NAME VARCHAR(500))'
      '110968=AS'
      '110969=DECLARE VARIABLE LVL_ INTEGER;'
      '1109610=BEGIN'
      '1109611='
      '1109612=  IF (COALESCE(TYPE_, 0) = 0) THEN'
      '1109613=      FOR'
      '1109614=        SELECT'
      '1109615=            DECODE(T.G_PRODUCT, -1, 0, 1) SORT_COL,'
      '1109616=            T.G_PRODUCT,'
      '1109617=            T.G_PRODUCT_PAR,'
      '1109618=            T.NAME,'
      '1109619=            0'
      '1109620=        FROM G_PRODUCT T'
      '1109621=        WHERE T.IS_CATEGORY = 1'
      '1109622=        ORDER BY 1, T.NAME'
      '1109623=        INTO'
      '1109624=            :SORT_COL,'
      '1109625=            :G_PRODUCT,'
      '1109626=            :G_PRODUCT_PAR,'
      '1109627=            :NAME,'
      '1109628=            :LVL_'
      '1109629=      DO'
      '1109630=        suspend;'
      '1109631='
      
        '1109632=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059#1063#1040 +
        #1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '1109633=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054#1044#1048 +
        #1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '1109634=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1056#1054 +
        #1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '1109635=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048#1046#1045 +
        ' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '1109636=  ELSE'
      '1109637=    FOR'
      '1109638=        SELECT'
      
        '1109639=            DECODE(T.G_PRODUCT, -1, 0, T.g_product) SORT' +
        '_COL,'
      '1109640=            T.G_PRODUCT,'
      '1109641=            T.G_PRODUCT_PAR,'
      '1109642=            T.NAME,'
      '1109643=            0'
      '1109644=        FROM G_PRODUCT T'
      '1109645=        WHERE T.IS_CATEGORY = 1'
      '1109646=        ORDER BY T.NAME'
      '1109647=        INTO'
      '1109648=            :SORT_COL,'
      '1109649=            :G_PRODUCT,'
      '1109650=            :G_PRODUCT_PAR,'
      '1109651=            :NAME,'
      '1109652=            :LVL_'
      '1109653=      DO'
      '1109654=        suspend;'
      '1109655=    /*FOR WITH RECURSIVE TREE AS ('
      
        '1109656=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109657=               T.G_PRODUCT,'
      '1109658=               T.G_PRODUCT_PAR,'
      '1109659=               T.NAME,'
      '1109660=               1 LVL'
      '1109661=          FROM G_PRODUCT T'
      
        '1109662=         WHERE ((T.G_PRODUCT_PAR IS NULL or T.g_product ' +
        '= -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '1109663=               OR'
      '1109664=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_)'
      '1109665=        UNION ALL'
      
        '1109666=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109667=               T.G_PRODUCT,'
      '1109668=               T.G_PRODUCT_PAR,'
      '1109669=               T.NAME,'
      '1109670=               GG.LVL + 1 LVL'
      
        '1109671=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_PR' +
        'ODUCT = T.G_PRODUCT_PAR'
      '1109672=         WHERE T.IS_CATEGORY = 1'
      '1109673=        )'
      '1109674=        SELECT * FROM TREE ORDER BY 1, 5, 3'
      '1109675=        INTO :SORT_COL,'
      '1109676=            :G_PRODUCT,'
      '1109677=            :G_PRODUCT_PAR,'
      '1109678=            :NAME,'
      '1109679=            :LVL_'
      '1109680=    DO'
      '1109681=        suspend;*/'
      '1109682='
      '1109683=    /*'
      
        '1109684=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT, -' +
        '1, T.G_PRODUCT, 0) SORTT,'
      '1109685=                               T.G_PRODUCT,'
      '1109686=                               T.G_PRODUCT_PAR,'
      
        '1109687=                               DECODE(T.G_PRODUCT, -1, '#39 +
        #1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '1109688=                               T.NAME PATH,       --'#1076#1083#1103' ' +
        #1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '1109689=                               1 LVL'
      '1109690=                          FROM G_PRODUCT T'
      
        '1109691=                         WHERE (T.G_PRODUCT_PAR IS NULL ' +
        'or T.g_product = -1)'
      '1109692=                        UNION ALL'
      
        '1109693=                        SELECT DECODE(T.G_PRODUCT, -1, T' +
        '.G_PRODUCT, 0) SORTT,'
      '1109694=                               T.G_PRODUCT,'
      '1109695=                               T.G_PRODUCT_PAR,'
      '1109696=                               GG.LVL||T.NAME NAME,'
      
        '1109697=                               GG.PATH||'#39' - '#39'||T.NAME,  ' +
        '   --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '1109698=                               GG.LVL + 1 LVL'
      
        '1109699=                          FROM G_PRODUCT T INNER JOIN TR' +
        'EE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '11096100=                         WHERE T.IS_CATEGORY = 1'
      '11096101=                        )'
      '11096102=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '11096103=    */'
      '11096104=END'
      '11096105=;'
      '11096106='
      '11096107=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '11096108=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
