        '110173126=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLA' +
        'TUR_NUM */ VARCHAR(150),'
      
        '110173127=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250' +
        '),'
      
        '110173128=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(5' +
        '0),'
      
        '110173129=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(1' +
        '5,2),'
      
        '110173130=  VOLUME_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRIC' +
        'E */ NUMERIC(15,2),'
      
        '110173131=  AMOUNT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '110173132=  AMOUNT_RESERVE /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT_RESERVE */ NUMERIC(18,5),'
      '110173133=  SUMM /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2),'
      
        '110173134=  PRICE_SELF /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(' +
        '15,2),'
      
        '110173135=  SUMM_SELF /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15' +
        ',2),'
      '110173136=  TOVAR_NAME VARCHAR(250),'
      
        '110173137=  CROSSCODE /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ B' +
        'LOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '110173138=  PLACE /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      
        '110173139=  BRAND /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(1' +
        '50),'
      
        '110173140=  NOTE /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300' +
        '),'
      
        '110173141=  IS_CATEGORY /* TYPE OF COLUMN G_PRODUCT.IS_CATEGORY ' +
        '*/ INTEGER,'
      
        '110173142=  CATEGORY_NAME /* TYPE OF COLUMN P_REP_PRICE_LIST_TAB' +
        'LE.CATEGORY_NAME */ VARCHAR(1000),'
      
        '110173143=  PACK_AMOUNT /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT ' +
        '*/ NUMERIC(15,2),'
      
        '110173144=  MF_COUNTRY /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */' +
        ' VARCHAR(150),'
      
        '110173145=  KOD_TNVD /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VAR' +
        'CHAR(50),'
      '110173146=  ERR_CODE INTEGER,'
      '110173147=  ERR_MSG VARCHAR(1024))'
      '110173148=AS'
      '110173149=BEGIN'
      '110173150=  SUSPEND;'
      '110173151=END'
      '110173152=;'
      '110173153='
      '110173154='
      
        '110173155=/*****************************************************' +
        '*************************/'
      
        '110173156=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110173157=/*****************************************************' +
        '*************************/'
      '110173158=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '110173159=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110173160=  INCLUDE_NOL_ INTEGER,'
      '110173161=  INCLUDE_FEW_ INTEGER,'
      '110173162=  SORT_BY_NAME_ INTEGER,'
      '110173163=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110173164=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39','
      '110173165=  IS_EXPORT_ INTEGER = 0)'
      '110173166=RETURNS ('
      '110173167=  PERIOD_ VARCHAR(40),'
      '110173168=  ROW_NUM VARCHAR(15),'
      '110173169=  ARTICUL VARCHAR(1000),'
      '110173170=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110173171=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110173172=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110173173=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110173174=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110173175=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110173176=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110173177=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110173178=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110173179=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110173180=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110173181=  TOVAR_NAME VARCHAR(250),'
      '110173182=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110173183=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110173184=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110173185=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110173186=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      
        '110173187=  CATEGORY_NAME TYPE OF COLUMN P_REP_PRICE_LIST_TABLE.' +
        'CATEGORY_NAME,'
      '110173188=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110173189=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110173190=  KOD_TNVD TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110173191=  ERR_CODE INTEGER,'
      '110173192=  ERR_MSG VARCHAR(1024))'
      '110173193=AS'
      
        '110173194=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK' +
        '_TOVAROV'#39';'
      '110173195=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110173196=DECLARE VARIABLE I INTEGER = 1;'
      '110173197=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110173198=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110173199=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110173200=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110173201=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110173202=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110173203=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110173204=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110173205=BEGIN'
      '110173206='
      
        '110173207=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110173208=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110173209='
      '110173210=  SELECT S.S_VALUE,'
      '110173211=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110173212=    FROM SYSTEM_SETUP S'
      '110173213=   WHERE S.SYSTEM_SETUP = 1'
      '110173214=    INTO :FORMULA_,'
      '110173215=         :PRIHOD_CNT_;'
      '110173216='
      '110173217=  IF (IS_EXPORT_ = 1) THEN'
      
        '110173218=    SELECT '#39'-'#39'||LIST(G_TOCHKA, '#39'-'#39')||'#39'-'#39' FROM G_TOCHKA' +
        ' INTO :G_TOCHKA_ARR_;'
      '110173219='
      '110173220=  FOR SELECT GP.PATH,'
      '110173221=             GP.G_PRODUCT'
      '110173222=        FROM P_REP_TREE GP'
      '110173223=       WHERE EXISTS (SELECT 1'
      '110173224=                       FROM G_PRODUCT'
      '110173225=                      WHERE IS_CATEGORY = 0'
      
        '110173226=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110173227=                    )'
      
        '110173228=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110173229=              OR'
      '110173230=              (:G_CATEGORY_ is NULL)'
      '110173231=             )'
      '110173232=       ORDER BY 1, 2'
      '110173233=       INTO :PATH_NAME_,'
      '110173234=            :G_PRODUCT_'
      '110173235=  DO BEGIN'
      
        '110173236=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110173237=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110173238=      SELECT COUNT(G.G_PRODUCT)'
      
        '110173239=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110173240=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110173241=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110173242=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110173243=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110173244=              OR'
      
        '110173245=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110173246=              or'
      
        '110173247=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110173248=             )'
      '110173249=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110173250=         AND ((EXISTS (SELECT 1'
      '110173251=                       FROM SKLAD S'
      '110173252=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110173253=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110173254=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110173255=              OR'
      '110173256=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110173257=        INTO :CNT_;'
      '110173258='
      '110173259=      IF (CNT_ > 0) THEN BEGIN'
      '110173260=          IF (IS_EXPORT_ = 0) THEN'
      
        '110173261=            INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_' +
        'PRICE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110173262=            VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE,' +
        ' 1), :PATH_NAME_, 1);'
      '110173263='
      
        '110173264=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110173265=                                              ARTICUL,'
      '110173266=                                              BARCODE,'
      
        '110173267=                                              NOMENCLA' +
        'TUR_NUM,'
      '110173268=                                              NAME,'
      
        '110173269=                                              UNIT_NAM' +
        'E,'
      '110173270=                                              PRICE,'
      
        '110173271=                                              VOLUME_P' +
        'RICE,'
      '110173272=                                              AMOUNT,'
      
        '110173273=                                              AMOUNT_R' +
        'ESERVE,'
      '110173274=                                              SUMM,'
      
        '110173275=                                              PRICE_SE' +
        'LF,'
      
        '110173276=                                              SORT_COL' +
        ','
      
        '110173277=                                              IS_CATEG' +
        'ORY,'
      '110173278=                                              NOTE,'
      
        '110173279=                                              CROSSCOD' +
        'E,'
      '110173280=                                              PLACE,'
      '110173281=                                              BRAND,'
      
        '110173282=                                              CATEGORY' +
        '_NAME,'
      
        '110173283=                                              PACK_AMO' +
        'UNT,'
      
        '110173284=                                              MF_COUNT' +
        'RY,'
      
        '110173285=                                              KOD_TNVD' +
        ')'
      
        '110173286=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110173287=                 G.ARTICUL,'
      '110173288=                 G.BARCODE,'
      '110173289=                 G.NOMENCLATUR_NUM,'
      '110173290=                 G.NAME,'
      '110173291=                 U.SHORT_NAME,'
      '110173292=                 G.PRICE,'
      '110173293=                 G.VOLUME_PRICE,'
      '110173294=                 COALESCE(S.AMOUNT, 0),'
      '110173295=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110173296=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110173297=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110173298=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110173299=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110173300=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110173301=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110173302=                  DECODE(:FORMULA_,'
      '110173303=                         1,'
      '110173304=                         (SELECT S.price'
      '110173305=                            FROM SKLAD S'
      
        '110173306=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110173307=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110173308=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110173309=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110173310=                                                     F' +
        'ROM SKLAD DD'
      
        '110173311=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110173312=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110173313=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110173314=                                                    )'
      '110173315=                            ORDER BY 1 DESC'
      '110173316=                            ROWS 1 TO 1'
      '110173317=                         ),'
      
        '110173318=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110173319=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110173320=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110173321=                                         SKLAD S'
      
        '110173322=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110173323=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110173324=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110173325=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110173326=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110173327=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110173328=                         )), 0) spr,'
      
        '110173329=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110173330=                 0'
      '110173331=                 ,G.NOTE'
      
        '110173332=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110173333=                 ,G.PLACE'
      '110173334=                 ,G.BRAND'
      '110173335=                 ,REPLACE(:PATH_NAME_, '#39' - '#39', '#39'~'#39')'
      '110173336=                 ,G.PACK_AMOUNT'
      '110173337=                 ,G.MF_COUNTRY'
      '110173338=                 ,G.KOD_TNVD'
      
        '110173339=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110173340=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110173341=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110173342=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110173343=             AND G.IS_CATEGORY = 0'
      '110173344=             AND G.is_active = 1'
      '110173345=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110173346=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110173347=                  OR'
      
        '110173348=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110173349=                  or'
      
        '110173350=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110173351=                 )'
      '110173352=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110173353=             AND ((EXISTS (SELECT 1'
      '110173354=                           FROM SKLAD S'
      
        '110173355=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110173356=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110173357=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110173358=                  OR'
      '110173359=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110173360=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '110173361=      END'
      '110173362=  END'
      '110173363='
      
        '110173364=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110173365='
      
        '110173366=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, VOLUME_PRIC' +
        'E, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, ' +
        'IS_CATEGORY,'
      
        '110173367=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL), CA' +
        'TEGORY_NAME, PACK_AMOUNT, MF_COUNTRY, KOD_TNVD'
      '110173368=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110173369=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRICE' +
        ', :VOLUME_PRICE,'
      
        '110173370=        :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, ' +
        ':SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME, :CATEGORY_NAME, :PACK_AMO' +
        'UNT, :MF_COUNTRY, :KOD_TNVD'
      '110173371=  DO BEGIN'
      '110173372=    I = I + 1;'
      '110173373=    SUSPEND;'
      '110173374=  END'
      '110173375=WHEN ANY DO BEGIN'
      '110173376=    Err_code = -20500;'
      
        '110173377=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110173378=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110173379=  END'
      '110173380=end'
      '110173381=;'
      '110173382='
      '110173383='
      
        '110173384=UPDATE SYSTEM_SETUP SET S_VALUE = 110173 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110173385=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110173386=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101740='
      '1101741=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101742=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101743=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1101744=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101745=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101746=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101747=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101748=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101749=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11017410=  SELF_PRICE_ NUMERIC(15,2),'
      '11017411=  AMOUNT_ MY_NUMERIC_5,'
      '11017412=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11017413=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11017414=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11017415=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11017416=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11017417=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11017418=  CATEGORY_NAME_ VARCHAR(1000),'
      '11017419=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11017420=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11017421=  IS_THIS_LAST_ INTEGER,'
      '11017422=  UPDATE_IF_EXIST_ INTEGER)'
      '11017423=RETURNS ('
      '11017424=  ERR_CODE INTEGER,'
      '11017425=  ERR_MSG VARCHAR(1024))'
      '11017426=AS'
      
        '11017427=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11017428=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11017429=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11017430=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR;'
      
        '11017431=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11017432=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11017433=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11017434=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11017435=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11017436=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11017437=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11017438=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11017439=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11017440=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11017441=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11017442=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11017443=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11017444=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11017445=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11017446=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11017447=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11017448=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11017449=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11017450=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11017451=BEGIN'
      '11017452=    ERR_MSG = '#39#39';'
      '11017453=    PNT_ = '#39'00'#39';'
      '11017454='
      
        '11017455=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11017456=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11017457=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11017458=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11017459=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11017460=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11017461=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11017462=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11017463=    END ELSE'
      '11017464=        CROSSCODE_ = NULL;'
      '11017465='
      '11017466=    PNT_ = '#39'01'#39';'
      '11017467=    SELECT ID'
      '11017468=      FROM CUR_PARAMS'
      '11017469=    WHERE CUR_PARAMS = 2'
      '11017470=      INTO :G_TOCHKA_;'
      '11017471='
      '11017472=    SELECT G.G_UNIT'
      '11017473=      FROM G_UNIT G'
      
        '11017474=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11017475=      INTO :G_UNIT_;'
      '11017476=    if (ROW_COUNT = 0) then'
      '11017477=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11017478='
      '11017479=    PNT_ = '#39'02'#39';'
      
        '11017480=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11017481=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11017482=        SELECT G.G_PRODUCT,'
      '11017483=               G.NAME'
      '11017484=          FROM G_PRODUCT G'
      
        '11017485=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11017486=           AND TRIM(G.ARTICUL) <> '#39#39
      '11017487=           AND G.IS_ACTIVE = 1'
      '11017488=          INTO :G_PRODUCT_,'
      '11017489=               :G_PRODUCT_NAME_;'
      '11017490='
      
        '11017491=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11017492=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11017493=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11017494=              UPDATE G_PRODUCT G'
      '11017495=                 SET G.NAME = :NAME_,'
      '11017496=                     G.G_UNIT = :G_UNIT_,'
      '11017497=                     G.PRICE  = :PRICE_,'
      '11017498=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11017499=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110174100=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110174101=                     G.PLACE = :PLACE_,'
      
        '110174102=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110174103=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110174104=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110174105=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110174106=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110174107=                     ,G.BRAND          = :BRAND_'
      '110174108=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110174109='
      
        '110174110=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110174111=            END ELSE'
      
        '110174112=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110174113=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110174114=        END'
      '110174115=    END ELSE'
      
        '110174116=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110174117='
      
        '110174118=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      
        '110174119=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110174120=    PNT_ = '#39'02a'#39';'
      
        '110174121=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110174122=        SELECT G.G_PRODUCT,'
      '110174123=               G.NAME'
      '110174124=          FROM G_PRODUCT G'
      
        '110174125=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110174126=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110174127=           AND G.IS_ACTIVE = 1'
      '110174128=          INTO :G_PRODUCT_,'
      '110174129=               :G_PRODUCT_NAME_;'
      '110174130='
      
        '110174131=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110174132=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110174133=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110174134=              UPDATE G_PRODUCT G'
      '110174135=                 SET G.NAME = :NAME_,'
      '110174136=                     G.G_UNIT = :G_UNIT_,'
      '110174137=                     G.PRICE  = :PRICE_,'
      '110174138=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110174139=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110174140=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110174141=                     G.PLACE = :PLACE_,'
      
        '110174142=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110174143=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110174144=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110174145=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110174146=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110174147=                     ,G.BRAND          = :BRAND_'
      '110174148=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110174149='
      
        '110174150=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110174151=            END ELSE'
      
        '110174152=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110174153=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110174154=        END'
      '110174155=    end'
      '110174156=    */'
      '110174157='
      
        '110174158=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110174159=    PNT_ = '#39'02b'#39';'
      
        '110174160=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110174161=        SELECT G.G_PRODUCT,'
      '110174162=               G.NAME'
      '110174163=          FROM G_PRODUCT G'
      '110174164=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110174165=           AND TRIM(G.BARCODE) <> '#39#39
      '110174166=           AND G.IS_ACTIVE = 1'
      '110174167=          INTO :G_PRODUCT_,'
      '110174168=               :G_PRODUCT_NAME_;'
      '110174169='
      '110174170=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110174171=          SELECT G.G_PRODUCT,'
      '110174172=                 G.NAME'
      '110174173=            FROM G_PRODUCT G, LT_BARCODE L'
      '110174174=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110174175=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110174176=             AND TRIM(L.BARCODE) <> '#39#39
      '110174177=            INTO :G_PRODUCT_,'
      '110174178=                 :G_PRODUCT_NAME_;'
      '110174179='
      
        '110174180=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110174181=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110174182=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110174183=              UPDATE G_PRODUCT G'
      '110174184=                 SET G.NAME = :NAME_,'
      '110174185=                     G.G_UNIT = :G_UNIT_,'
      '110174186=                     G.PRICE  = :PRICE_,'
      '110174187=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110174188=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110174189=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110174190=                     G.PLACE = :PLACE_,'
      
        '110174191=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110174192=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110174193=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110174194=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110174195=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110174196=                     ,G.BRAND          = :BRAND_'
      '110174197=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110174198='
      
        '110174199=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110174200=            END ELSE'
      
        '110174201=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110174202=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110174203=        END'
      
        '110174204=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110174205=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110174206='
      
        '110174207=    --================================================' +
        '========='
      '110174208=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110174209=    --================================================' +
        '========='
      '110174210=    PNT_ = '#39'02b'#39';'
      '110174211=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110174212='
      
        '110174213=        ----------------------------------------------' +
        '--------------------'
      
        '110174214=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' ' +
        #1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '110174215=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080 +
        '~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110174216=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110174217=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', ' +
        #1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '110174218=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110174219=            G_PRODUCT_PAR_ = NULL;'
      
        '110174220=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110174221=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110174222=              STR_ = CATEGORY_NAME_;'
      '110174223=              CATEGORY_NAME_ = '#39#39';'
      '110174224=            END ELSE'
      
        '110174225=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110174226='
      '110174227=            SELECT G_PRODUCT'
      '110174228=              FROM G_PRODUCT G'
      '110174229=             WHERE G.NAME = :STR_'
      '110174230=               AND G.IS_CATEGORY = 1'
      
        '110174231=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110174232=                   OR'
      '110174233=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '110174234=              INTO G_PRODUCT_PAR_;'
      '110174235=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110174236=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110174237=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110174238=                RETURNING G_PRODUCT'
      '110174239=                INTO :G_PRODUCT_PAR_;'
      '110174240='
      '110174241=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110174242=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110174243=        END'
      
        '110174244=        ----------------------------------------------' +
        '--------------------'
      '110174245='
      
        '110174246=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110174247=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110174248=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110174249=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110174250=        RETURNING G_PRODUCT'
      '110174251=        INTO :G_PRODUCT_;'
      '110174252='
      
        '110174253=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110174254=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110174255=    end'
      '110174256='
      
        '110174257=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110174258=    PNT_ = '#39'03'#39';'
      '110174259=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110174260=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110174261=                                       :AMOUNT_,'
      '110174262=                                       :SELF_PRICE_,'
      
        '110174263=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110174264=                                       0, --nds_,'
      '110174265=                                       0 --nds_summ_,'
      
        '110174266=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110174267=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110174268=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110174269=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110174270=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110174271=          EXIT;'
      '110174272=        END'
      '110174273=    END'
      '110174274='
      
        '110174275=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110174276=    PNT_ = '#39'04'#39';'
      '110174277=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110174278=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110174279=        FROM SKLAD_TMP T'
      '110174280=        INTO :CNT_;'
      '110174281='
      '110174282=      if (CNT_ > 0) then BEGIN'
      '110174283=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110174284=          FROM SKLAD_TMP T'
      '110174285=          INTO :SUMM_, :SUMM_UE_;'
      '110174286='
      '110174287=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110174288=                                DATE_RECEIPT,'
      '110174289=                                TIME_RECEIPT,'
      '110174290=                                G_CLIENT,'
      '110174291=                                G_PAYMENT_TYPE,'
      '110174292=                                OSNOVANIE,'
      '110174293=                                NOTE,'
      '110174294=                                SUMM,'
      '110174295=                                SUMM_FACT,'
      '110174296=                                SUMM_CURRENCY,'
      '110174297=                                IS_PAYED_ALL,'
      '110174298=                                IS_VOZVRAT,'
      '110174299=                                G_TOCHKA)'
      '110174300=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110174301=                CURRENT_DATE,'
      '110174302=                CURRENT_TIME,'
      '110174303=                :G_CLIENT_,'
      '110174304=                1,'
      '110174305=                NULL,  --:OSNOVANIE_,'
      '110174306=                NULL,  -- :NOTE_,'
      '110174307=                :SUMM_,'
      '110174308=                :SUMM_,'
      '110174309=                :SUMM_UE_,'
      
        '110174310=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110174311=                0,'
      '110174312=                :G_TOCHKA_)'
      '110174313=        RETURNING'
      '110174314=          SKLAD'
      '110174315=        INTO'
      '110174316=          :SKLAD_PARENT_;'
      '110174317='
      '110174318=        PNT_ = '#39'05'#39';'
      '110174319=        FOR SELECT SKLAD,'
      '110174320=                   G_PRODUCT,'
      '110174321=                   AMOUNT,'
      '110174322=                   PRICE,'
      '110174323=                   SUMM'
      '110174324=                   ,PRICE_CURRENCY'
      '110174325=                   ,SUMM_CURRENCY'
      '110174326=              FROM SKLAD_TMP'
      '110174327=             ORDER BY 1'
      '110174328=              INTO :SKLAD_TMP_,'
      '110174329=                   :RG_PRODUCT_,'
      '110174330=                   :RAMOUNT_,'
      '110174331=                   :RPRICE_,'
      '110174332=                   :RSUMM_'
      '110174333=                   ,:RPRICE_UE_'
      '110174334=                   ,:RSUMM_UE_'
      '110174335=        DO BEGIN'
      '110174336='
      '110174337=            UPDATE SKLAD SK'
      '110174338=               SET SK.IS_LAST = 0'
      '110174339=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110174340=               AND SK.IS_LAST = 1;'
      '110174341='
      '110174342=            INSERT INTO SKLAD'
      '110174343=            ('
      '110174344=             SKLAD,'
      '110174345=             SKLAD_PARENT,'
      '110174346=             DATE_RECEIPT,'
      '110174347=             G_CLIENT,'
      '110174348=             G_PRODUCT,'
      '110174349=             AMOUNT,'
      '110174350=             PRICE,'
      '110174351=             SUMM,'
      '110174352=             G_PAYMENT_TYPE,'
      '110174353=             OSNOVANIE,'
      '110174354=             NOTE,'
      '110174355=             NDS,'
      '110174356=             NDS_SUMM,'
      '110174357=             IS_LAST,'
      '110174358=             IS_VOZVRAT,'
      '110174359=             G_TOCHKA'
      '110174360=             ,PRICE_CURRENCY'
      '110174361=             ,SUMM_CURRENCY'
      '110174362=            ) VALUES ('
      '110174363=             :SKLAD_TMP_,'
      '110174364=             :SKLAD_PARENT_,'
      '110174365=             CURRENT_DATE,'
      '110174366=             :G_CLIENT_,'
      '110174367=             :RG_PRODUCT_,'
      '110174368=             :RAMOUNT_,'
      '110174369=             :RPRICE_,'
      '110174370=             :RSUMM_,'
      '110174371=             1,       --:G_PAYMENT_TYPE_,'
      '110174372=             NULL,    --:OSNOVANIE_,'
      '110174373=             NULL,    --:NOTE_,'
      '110174374=             0,       --:RNDS_,'
      '110174375=             0,       --:RNDS_SUMM_,'
      '110174376=             1,       --IS_LAST_'
      '110174377=             0,        --:IS_VOZVRAT_'
      '110174378=             :G_TOCHKA_'
      '110174379=             ,:RPRICE_UE_'
      '110174380=             ,:RSUMM_UE_'
      '110174381=            );'
      '110174382='
      
        '110174383=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110174384=            PNT_ = '#39'06'#39';'
      '110174385=            UPDATE LT_SKLAD_PRODUCT L'
      '110174386=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110174387=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110174388=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110174389='
      '110174390=            PNT_ = '#39'06a'#39';'
      '110174391=            IF (ROW_COUNT = 0) THEN'
      
        '110174392=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110174393=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110174394=        END'
      '110174395='
      '110174396=        PNT_ = '#39'07'#39';'
      
        '110174397=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110174398=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110174399=                                :SUMM_,'
      '110174400=                                CURRENT_DATE,'
      
        '110174401=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110174402=                                NULL,   --ZAKAZ_'
      '110174403=                                :SKLAD_PARENT_,'
      '110174404=                                1,'
      
        '110174405=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110174406=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110174407=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110174408=          EXIT;'
      '110174409=        END'
      '110174410='
      '110174411=        DELETE FROM SKLAD_TMP;'
      '110174412=      END'
      '110174413=    END'
      '110174414='
      
        '110174415=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110174416=    if (ERR_MSG_ IS NOT NULL) then'
      '110174417=      ERR_MSG = ERR_MSG_;'
      '110174418='
      '110174419=WHEN ANY DO BEGIN'
      '110174420=    Err_code = gdscode;'
      
        '110174421=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110174422=  END'
      '110174423=END'
      '110174424=;'
      '110174425='
      '110174426=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '110174427=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110174428=  ARTICUL_ VARCHAR(30),'
      '110174429=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110174430=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110174431=  NAME_ VARCHAR(500),'
      '110174432=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110174433=  PRICE_ NUMERIC(15,2),'
      '110174434=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110174435=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110174436=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110174437=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110174438=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110174439=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110174440=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110174441=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110174442=  IS_CATEGORY_ INTEGER,'
      '110174443=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110174444=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110174445=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110174446=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110174447=  IS_MARKED_ INTEGER,'
      '110174448=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      
        '110174449=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110174450=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110174451=RETURNS ('
      '110174452=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110174453=  ERR_CODE INTEGER,'
      '110174454=  ERR_MSG VARCHAR(1024))'
      '110174455=AS'
      
        '110174456=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODU' +
        'CT'#39';'
      
        '110174457=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110174458=begin'
      
        '110174459=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110174460=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '110174461=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110174462=                      FROM G_PRODUCT G'
      
        '110174463=                     WHERE UPPER(G.ARTICUL) = UPPER(TR' +
        'IM(:ARTICUL_))'
      '110174464=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '110174465=                       AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '110174466=          ERR_CODE = -20500;'
      
        '110174467=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '110174468=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110174469=          EXIT;'
      '110174470=        END'
      '110174471=    end'
      '110174472='
      
        '110174473=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      '110174474=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '110174475=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then' +
        ' begin'
      '110174476=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110174477=                     FROM G_PRODUCT G'
      
        '110174478=                    WHERE UPPER(G.NOMENCLATUR_NUM) = U' +
        'PPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '110174479=                      AND TRIM(G.NOMENCLATUR_NUM) <> '#39 +
        #39
      '110174480=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110174481=          ERR_CODE = -20500;'
      
        '110174482=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '110174483=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110174484=          EXIT;'
      '110174485=        END'
      '110174486=    end*/'
      '110174487='
      '110174488=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110174489=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110174490=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '110174491=                      FROM G_PRODUCT G'
      
        '110174492=                     WHERE UPPER(G.BARCODE) = UPPER(TR' +
        'IM(:BARCODE_))'
      '110174493=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '110174494=                       AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '110174495=          ERR_CODE = -20500;'
      
        '110174496=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110174497=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110174498=          EXIT;'
      '110174499=        END'
      '110174500='
      '110174501=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '110174502=                     FROM G_PRODUCT G, LT_BARCODE L'
      '110174503=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110174504=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '110174505=                      AND TRIM(L.BARCODE) <> '#39#39
      '110174506=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110174507=          ERR_CODE = -20500;'
      
        '110174508=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110174509=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110174510=          EXIT;'
      '110174511=        END'
      '110174512=    end'
      '110174513='
      
        '110174514=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PR' +
        'ICE,'
      
        '110174515=                           IS_CATEGORY, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COM' +
        'M, KOD_TNVD,'
      
        '110174516=                           FAST_TOVAR, DO_NOT_CHARGE_B' +
        'ONUS, IS_MARKED, BRAND)'
      
        '110174517=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRI' +
        'CE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '110174518=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROS' +
        'SCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNVD' +
        '_,'
      
        '110174519=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_M' +
        'ARKED_, :BRAND_)'
      '110174520=    RETURNING G_PRODUCT'
      '110174521=    INTO :G_PRODUCT_;'
      '110174522='
      '110174523=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '110174524=    if (:IS_CATEGORY_ = 0) then begin'
      
        '110174525=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110174526=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '110174527='
      '110174528=        INSERT INTO LT_BARCODE'
      
        '110174529=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110174530='
      
        '110174531=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090 +
        #1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '110174532=        INSERT into G_PRODUCT_IMAGE'
      
        '110174533=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYP' +
        'E from G_PRODUCT_IMAGE_TMP;'
      '110174534='
      
        '110174535=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089 +
        #1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '110174536=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091 +
        #1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '110174537=        IF (is_kit_ > 0) THEN begin'
      '110174538=            INSERT INTO G_PRODUCT_KIT'
      
        '110174539=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP;'
      '110174540='
      '110174541=            if (is_kit_ = 1) then begin'
      
        '110174542=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110174543=                  FROM G_PRODUCT_KIT K,'
      '110174544=                       LT_SKLAD_PRODUCT L'
      '110174545=                 WHERE K.g_product = :G_PRODUCT_'
      '110174546=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110174547=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110174548=                 GROUP BY K.G_PRODUCT'
      '110174549=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110174550='
      '110174551=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110174552=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_' +
        'SOSTAV_AMOUNT_, 0)'
      '110174553=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110174554=            end'
      '110174555=        END'
      '110174556=    END'
      '110174557='
      '110174558=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110174559=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_P' +
        'RODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '110174560=end'
      '110174561=;'
      '110174562='
      '110174563=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110174564=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110174565=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110174566=  ARTICUL_ VARCHAR(30),'
      '110174567=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110174568=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110174569=  NAME_ VARCHAR(500),'
      '110174570=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110174571=  PRICE_ NUMERIC(15,2),'
      '110174572=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110174573=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110174574=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110174575=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110174576=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110174577=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110174578=  IS_CATEGORY_ INTEGER,'
      '110174579=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110174580=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110174581=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110174582=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110174583=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110174584=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110174585=  IS_MARKED_ INTEGER,'
      '110174586=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      
        '110174587=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110174588=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110174589=RETURNS ('
      '110174590=  ERR_CODE INTEGER,'
      '110174591=  ERR_MSG VARCHAR(1024))'
      '110174592=AS'
      
        '110174593=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODU' +
        'CT'#39';'
      
        '110174594=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110174595=begin'
      
        '110174596=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110174597=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '110174598=                  FROM G_PRODUCT G'
      
        '110174599=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:' +
        'ARTICUL_))'
      '110174600=                   AND TRIM(G.ARTICUL) <> '#39#39
      '110174601=                   AND TRIM(:ARTICUL_) <> '#39#39
      '110174602=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110174603=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110174604=      ERR_CODE = -20500;'
      
        '110174605=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      '110174606=      EXIT;'
      '110174607=    END'
      '110174608='
      
        '110174609=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      '110174610=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110174611=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110174612=                  FROM G_PRODUCT G'
      
        '110174613=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPPE' +
        'R(TRIM(:NOMENCLATUR_NUM_))'
      '110174614=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110174615=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '110174616=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110174617=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110174618=      ERR_CODE = -20500;'
      
        '110174619=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110174620=      EXIT;'
      '110174621=    END'
      '110174622=    */'
      '110174623='
      '110174624=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110174625=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110174626=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110174627=                  FROM G_PRODUCT G'
      
        '110174628=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(:' +
        'BARCODE_))'
      '110174629=                   AND TRIM(G.BARCODE) <> '#39#39
      '110174630=                   AND TRIM(:BARCODE_) <> '#39#39
      '110174631=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110174632=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110174633=          ERR_CODE = -20500;'
      
        '110174634=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110174635=          EXIT;'
      '110174636=        END'
      '110174637='
      '110174638=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '110174639=                    FROM G_PRODUCT G, LT_BARCODE L'
      '110174640=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110174641=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '110174642=                     AND TRIM(L.BARCODE) <> '#39#39
      '110174643=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110174644=          ERR_CODE = -20500;'
      
        '110174645=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110174646=          EXIT;'
      '110174647=        END'
      '110174648=    END'
      '110174649='
      '110174650=    update G_PRODUCT'
      '110174651=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110174652=        ARTICUL = :ARTICUL_,'
      '110174653=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110174654=        BARCODE = :BARCODE_,'
      '110174655=        NAME = :NAME_,'
      '110174656=        G_UNIT = :G_UNIT_,'
      '110174657=        PRICE = :PRICE_,'
      '110174658=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110174659=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110174660=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110174661=        NOTE         = :NOTE_,'
      '110174662=        CROSSCODE    = :CROSSCODE_,'
      '110174663=        IS_KIT       = :IS_KIT_,'
      '110174664=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110174665=        PLACE        = :PLACE_,'
      '110174666=        SALES_COMM   = :SALES_COMM_,'
      '110174667=        KOD_TNVD     = :KOD_TNVD_,'
      '110174668=        FAST_TOVAR   = :FAST_TOVAR_,'
      '110174669=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '110174670=        IS_MARKED    = :IS_MARKED_,'
      '110174671=        BRAND        = :BRAND_'
      '110174672=    where (G_PRODUCT = :G_PRODUCT_);'
      '110174673='
      '110174674=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110174675=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110174676='
      '110174677=        INSERT INTO LT_BARCODE'
      
        '110174678=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110174679='
      '110174680=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110174681=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110174682=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110174683='
      
        '110174684=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110174685=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110174686='
      '110174687=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110174688=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110174689=            /*INSERT INTO G_PRODUCT_KIT'
      
        '110174690=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110174691=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110174692=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110174693=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110174694='
      
        '110174695=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110174696=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110174697='
      '110174698=            UPDATE G_PRODUCT_KIT G'
      
        '110174699=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110174700=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110174701=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110174702=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110174703='
      
        '110174704=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' '#1074 +
        #1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '110174705=            */'
      
        '110174706=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PROD' +
        'UCT = :G_PRODUCT_;'
      '110174707=            INSERT INTO G_PRODUCT_KIT'
      
        '110174708=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '110174709=            FROM G_PRODUCT_KIT_TMP T;'
      '110174710='
      
        '110174711=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110174712=            if (is_kit_ = 1) then begin'
      
        '110174713=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110174714=                  FROM G_PRODUCT_KIT K,'
      '110174715=                       LT_SKLAD_PRODUCT L'
      '110174716=                 WHERE K.g_product = :G_PRODUCT_'
      '110174717=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110174718=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110174719=                 GROUP BY K.G_PRODUCT'
      '110174720=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110174721='
      '110174722=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110174723=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110174724=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110174725=            end'
      '110174726=        END'
      '110174727=    END'
      '110174728='
      '110174729=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110174730=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_P' +
        'RODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '110174731=end'
      '110174732=;'
      '110174733='
      '110174734='
      
        '110174735=UPDATE SYSTEM_SETUP SET S_VALUE = 110174 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110174736=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110174737=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101750='
      '1101751=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101752=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101753=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1101754=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101755=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101756=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101757=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101758=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101759=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11017510=  SELF_PRICE_ NUMERIC(15,2),'
      '11017511=  AMOUNT_ MY_NUMERIC_5,'
      '11017512=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11017513=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11017514=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11017515=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11017516=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11017517=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11017518=  CATEGORY_NAME_ VARCHAR(1000),'
      '11017519=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11017520=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11017521=  IS_THIS_LAST_ INTEGER,'
      '11017522=  UPDATE_IF_EXIST_ INTEGER)'
      '11017523=RETURNS ('
      '11017524=  ERR_CODE INTEGER,'
      '11017525=  ERR_MSG VARCHAR(1024))'
      '11017526=AS'
      
        '11017527=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11017528=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11017529=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11017530=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR;'
      
        '11017531=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11017532=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11017533=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11017534=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11017535=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11017536=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11017537=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11017538=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11017539=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11017540=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11017541=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11017542=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11017543=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11017544=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11017545=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11017546=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11017547=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11017548=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11017549=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11017550=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11017551=BEGIN'
      '11017552=    ERR_MSG = '#39#39';'
      '11017553=    PNT_ = '#39'00'#39';'
      '11017554='
      
        '11017555=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11017556=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11017557=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11017558=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11017559=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11017560=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11017561=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11017562=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11017563=    END ELSE'
      '11017564=        CROSSCODE_ = NULL;'
      '11017565='
      '11017566=    PNT_ = '#39'01'#39';'
      '11017567=    SELECT ID'
      '11017568=      FROM CUR_PARAMS'
      '11017569=    WHERE CUR_PARAMS = 2'
      '11017570=      INTO :G_TOCHKA_;'
      '11017571='
      '11017572=    SELECT G.G_UNIT'
      '11017573=      FROM G_UNIT G'
      
        '11017574=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11017575=      INTO :G_UNIT_;'
      '11017576=    if (ROW_COUNT = 0) then'
      '11017577=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11017578='
      '11017579=    PNT_ = '#39'02'#39';'
      
        '11017580=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11017581=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11017582=        SELECT G.G_PRODUCT,'
      '11017583=               G.NAME'
      '11017584=          FROM G_PRODUCT G'
      
        '11017585=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11017586=           AND TRIM(G.ARTICUL) <> '#39#39
      '11017587=           AND G.IS_ACTIVE = 1'
      '11017588=          INTO :G_PRODUCT_,'
      '11017589=               :G_PRODUCT_NAME_;'
      '11017590='
      
        '11017591=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11017592=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11017593=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11017594=              UPDATE G_PRODUCT G'
      '11017595=                 SET G.NAME = COALESCE(:NAME_, G.NAME),'
      '11017596=                     G.G_UNIT = :G_UNIT_,'
      '11017597=                     G.PRICE  = :PRICE_,'
      '11017598=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11017599=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      
        '110175100=                     G.MF_COUNTRY  = COALESCE(:MF_COUN' +
        'TRY_, G.MF_COUNTRY),'
      '110175101=                     G.PLACE = :PLACE_,'
      
        '110175102=                     G.nomenclatur_num = COALESCE(:NOM' +
        'ENCLATUR_NUM_, G.nomenclatur_num),'
      
        '110175103=                     G.barcode         = COALESCE(:BAR' +
        'CODE_, G.BARCODE),'
      
        '110175104=                     G.KOD_TNVD        = COALESCE(:KOD' +
        '_TNVD_, G.KOD_TNVD)'
      
        '110175105=                     ,G.CROSSCODE      = COALESCE(:CRO' +
        'SSCODE_, G.CROSSCODE)'
      
        '110175106=                     ,G.BRAND          = COALESCE(:BRA' +
        'ND_, G.BRAND)'
      '110175107=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110175108='
      
        '110175109=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110175110=            END ELSE'
      
        '110175111=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110175112=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110175113=        END'
      '110175114=    END ELSE'
      
        '110175115=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110175116='
      
        '110175117=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      
        '110175118=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110175119=    PNT_ = '#39'02a'#39';'
      
        '110175120=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110175121=        SELECT G.G_PRODUCT,'
      '110175122=               G.NAME'
      '110175123=          FROM G_PRODUCT G'
      
        '110175124=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110175125=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110175126=           AND G.IS_ACTIVE = 1'
      '110175127=          INTO :G_PRODUCT_,'
      '110175128=               :G_PRODUCT_NAME_;'
      '110175129='
      
        '110175130=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110175131=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110175132=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110175133=              UPDATE G_PRODUCT G'
      '110175134=                 SET G.NAME = :NAME_,'
      '110175135=                     G.G_UNIT = :G_UNIT_,'
      '110175136=                     G.PRICE  = :PRICE_,'
      '110175137=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110175138=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110175139=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110175140=                     G.PLACE = :PLACE_,'
      
        '110175141=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110175142=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110175143=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110175144=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110175145=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110175146=                     ,G.BRAND          = :BRAND_'
      '110175147=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110175148='
      
        '110175149=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110175150=            END ELSE'
      
        '110175151=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110175152=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110175153=        END'
      '110175154=    end'
      '110175155=    */'
      '110175156='
      
        '110175157=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110175158=    PNT_ = '#39'02b'#39';'
      
        '110175159=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110175160=        SELECT G.G_PRODUCT,'
      '110175161=               G.NAME'
      '110175162=          FROM G_PRODUCT G'
      '110175163=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110175164=           AND TRIM(G.BARCODE) <> '#39#39
      '110175165=           AND G.IS_ACTIVE = 1'
      '110175166=          INTO :G_PRODUCT_,'
      '110175167=               :G_PRODUCT_NAME_;'
      '110175168='
      '110175169=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110175170=          SELECT G.G_PRODUCT,'
      '110175171=                 G.NAME'
      '110175172=            FROM G_PRODUCT G, LT_BARCODE L'
      '110175173=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110175174=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110175175=             AND TRIM(L.BARCODE) <> '#39#39
      '110175176=            INTO :G_PRODUCT_,'
      '110175177=                 :G_PRODUCT_NAME_;'
      '110175178='
      
        '110175179=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110175180=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110175181=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110175182=              UPDATE G_PRODUCT G'
      
        '110175183=                 SET G.NAME = COALESCE(:NAME_, G.NAME)' +
        ','
      '110175184=                     G.G_UNIT = :G_UNIT_,'
      '110175185=                     G.PRICE  = :PRICE_,'
      '110175186=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110175187=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      
        '110175188=                     G.MF_COUNTRY  = COALESCE(:MF_COUN' +
        'TRY_, G.MF_COUNTRY),'
      '110175189=                     G.PLACE = :PLACE_,'
      
        '110175190=                     G.articul         = COALESCE(:ART' +
        'ICUL_, G.articul),'
      
        '110175191=                     G.nomenclatur_num = COALESCE(:NOM' +
        'ENCLATUR_NUM_, G.nomenclatur_num),'
      
        '110175192=                     G.KOD_TNVD        = COALESCE(:KOD' +
        '_TNVD_, G.KOD_TNVD)'
      
        '110175193=                     ,G.CROSSCODE      = COALESCE(:CRO' +
        'SSCODE_, G.CROSSCODE)'
      
        '110175194=                     ,G.BRAND          = COALESCE(:BRA' +
        'ND_, G.BRAND)'
      '110175195=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110175196='
      
        '110175197=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110175198=            END ELSE'
      
        '110175199=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110175200=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110175201=        END'
      
        '110175202=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110175203=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110175204='
      
        '110175205=    --================================================' +
        '========='
      '110175206=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110175207=    --================================================' +
        '========='
      '110175208=    PNT_ = '#39'02b'#39';'
      '110175209=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110175210='
      
        '110175211=        ----------------------------------------------' +
        '--------------------'
      
        '110175212=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' ' +
        #1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '110175213=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080 +
        '~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110175214=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110175215=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', ' +
        #1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '110175216=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110175217=            G_PRODUCT_PAR_ = NULL;'
      
        '110175218=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110175219=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110175220=              STR_ = CATEGORY_NAME_;'
      '110175221=              CATEGORY_NAME_ = '#39#39';'
      '110175222=            END ELSE'
      
        '110175223=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110175224='
      '110175225=            SELECT G_PRODUCT'
      '110175226=              FROM G_PRODUCT G'
      '110175227=             WHERE G.NAME = :STR_'
      '110175228=               AND G.IS_CATEGORY = 1'
      
        '110175229=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110175230=                   OR'
      '110175231=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '110175232=              INTO G_PRODUCT_PAR_;'
      '110175233=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110175234=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110175235=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110175236=                RETURNING G_PRODUCT'
      '110175237=                INTO :G_PRODUCT_PAR_;'
      '110175238='
      '110175239=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110175240=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110175241=        END'
      
        '110175242=        ----------------------------------------------' +
        '--------------------'
      '110175243='
      
        '110175244=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110175245=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110175246=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110175247=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110175248=        RETURNING G_PRODUCT'
      '110175249=        INTO :G_PRODUCT_;'
      '110175250='
      
        '110175251=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110175252=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110175253=    end'
      '110175254='
      
        '110175255=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110175256=    PNT_ = '#39'03'#39';'
      '110175257=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110175258=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110175259=                                       :AMOUNT_,'
      '110175260=                                       :SELF_PRICE_,'
      
        '110175261=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110175262=                                       0, --nds_,'
      '110175263=                                       0 --nds_summ_,'
      
        '110175264=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110175265=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110175266=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110175267=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110175268=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110175269=          EXIT;'
      '110175270=        END'
      '110175271=    END'
      '110175272='
      
        '110175273=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110175274=    PNT_ = '#39'04'#39';'
      '110175275=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110175276=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110175277=        FROM SKLAD_TMP T'
      '110175278=        INTO :CNT_;'
      '110175279='
      '110175280=      if (CNT_ > 0) then BEGIN'
      '110175281=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110175282=          FROM SKLAD_TMP T'
      '110175283=          INTO :SUMM_, :SUMM_UE_;'
      '110175284='
      '110175285=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110175286=                                DATE_RECEIPT,'
      '110175287=                                TIME_RECEIPT,'
      '110175288=                                G_CLIENT,'
      '110175289=                                G_PAYMENT_TYPE,'
      '110175290=                                OSNOVANIE,'
      '110175291=                                NOTE,'
      '110175292=                                SUMM,'
      '110175293=                                SUMM_FACT,'
      '110175294=                                SUMM_CURRENCY,'
      '110175295=                                IS_PAYED_ALL,'
      '110175296=                                IS_VOZVRAT,'
      '110175297=                                G_TOCHKA)'
      '110175298=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110175299=                CURRENT_DATE,'
      '110175300=                CURRENT_TIME,'
      '110175301=                :G_CLIENT_,'
      '110175302=                1,'
      '110175303=                NULL,  --:OSNOVANIE_,'
      '110175304=                NULL,  -- :NOTE_,'
      '110175305=                :SUMM_,'
      '110175306=                :SUMM_,'
      '110175307=                :SUMM_UE_,'
      
        '110175308=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110175309=                0,'
      '110175310=                :G_TOCHKA_)'
      '110175311=        RETURNING'
      '110175312=          SKLAD'
      '110175313=        INTO'
      '110175314=          :SKLAD_PARENT_;'
      '110175315='
      '110175316=        PNT_ = '#39'05'#39';'
      '110175317=        FOR SELECT SKLAD,'
      '110175318=                   G_PRODUCT,'
      '110175319=                   AMOUNT,'
      '110175320=                   PRICE,'
      '110175321=                   SUMM'
      '110175322=                   ,PRICE_CURRENCY'
      '110175323=                   ,SUMM_CURRENCY'
      '110175324=              FROM SKLAD_TMP'
      '110175325=             ORDER BY 1'
      '110175326=              INTO :SKLAD_TMP_,'
      '110175327=                   :RG_PRODUCT_,'
      '110175328=                   :RAMOUNT_,'
      '110175329=                   :RPRICE_,'
      '110175330=                   :RSUMM_'
      '110175331=                   ,:RPRICE_UE_'
      '110175332=                   ,:RSUMM_UE_'
      '110175333=        DO BEGIN'
      '110175334='
      '110175335=            UPDATE SKLAD SK'
      '110175336=               SET SK.IS_LAST = 0'
      '110175337=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110175338=               AND SK.IS_LAST = 1;'
      '110175339='
      '110175340=            INSERT INTO SKLAD'
      '110175341=            ('
      '110175342=             SKLAD,'
      '110175343=             SKLAD_PARENT,'
      '110175344=             DATE_RECEIPT,'
      '110175345=             G_CLIENT,'
      '110175346=             G_PRODUCT,'
      '110175347=             AMOUNT,'
      '110175348=             PRICE,'
      '110175349=             SUMM,'
      '110175350=             G_PAYMENT_TYPE,'
      '110175351=             OSNOVANIE,'
      '110175352=             NOTE,'
      '110175353=             NDS,'
      '110175354=             NDS_SUMM,'
      '110175355=             IS_LAST,'
      '110175356=             IS_VOZVRAT,'
      '110175357=             G_TOCHKA'
      '110175358=             ,PRICE_CURRENCY'
      '110175359=             ,SUMM_CURRENCY'
      '110175360=            ) VALUES ('
      '110175361=             :SKLAD_TMP_,'
      '110175362=             :SKLAD_PARENT_,'
      '110175363=             CURRENT_DATE,'
      '110175364=             :G_CLIENT_,'
      '110175365=             :RG_PRODUCT_,'
      '110175366=             :RAMOUNT_,'
      '110175367=             :RPRICE_,'
      '110175368=             :RSUMM_,'
      '110175369=             1,       --:G_PAYMENT_TYPE_,'
      '110175370=             NULL,    --:OSNOVANIE_,'
      '110175371=             NULL,    --:NOTE_,'
      '110175372=             0,       --:RNDS_,'
      '110175373=             0,       --:RNDS_SUMM_,'
      '110175374=             1,       --IS_LAST_'
      '110175375=             0,        --:IS_VOZVRAT_'
      '110175376=             :G_TOCHKA_'
      '110175377=             ,:RPRICE_UE_'
      '110175378=             ,:RSUMM_UE_'
      '110175379=            );'
      '110175380='
      
        '110175381=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110175382=            PNT_ = '#39'06'#39';'
      '110175383=            UPDATE LT_SKLAD_PRODUCT L'
      '110175384=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110175385=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110175386=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110175387='
      '110175388=            PNT_ = '#39'06a'#39';'
      '110175389=            IF (ROW_COUNT = 0) THEN'
      
        '110175390=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110175391=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110175392=        END'
      '110175393='
      '110175394=        PNT_ = '#39'07'#39';'
      
        '110175395=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110175396=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110175397=                                :SUMM_,'
      '110175398=                                CURRENT_DATE,'
      
        '110175399=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110175400=                                NULL,   --ZAKAZ_'
      '110175401=                                :SKLAD_PARENT_,'
      '110175402=                                1,'
      
        '110175403=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110175404=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110175405=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110175406=          EXIT;'
      '110175407=        END'
      '110175408='
      '110175409=        DELETE FROM SKLAD_TMP;'
      '110175410=      END'
      '110175411=    END'
      '110175412='
      
        '110175413=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110175414=    if (ERR_MSG_ IS NOT NULL) then'
      '110175415=      ERR_MSG = ERR_MSG_;'
      '110175416='
      '110175417=WHEN ANY DO BEGIN'
      '110175418=    Err_code = gdscode;'
      
        '110175419=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110175420=  END'
      '110175421=END'
      '110175422=;'
      '110175423='
      '110175424='
      
        '110175425=UPDATE SYSTEM_SETUP SET S_VALUE = 110175 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110175426=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110175427=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101760='
      '1101761=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101762=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101763=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1101764=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101765=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101766=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101767=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101768=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101769=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11017610=  SELF_PRICE_ NUMERIC(15,2),'
      '11017611=  AMOUNT_ MY_NUMERIC_5,'
      '11017612=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11017613=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11017614=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11017615=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11017616=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11017617=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11017618=  CATEGORY_NAME_ VARCHAR(1000),'
      '11017619=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11017620=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11017621=  IS_THIS_LAST_ INTEGER,'
      '11017622=  UPDATE_IF_EXIST_ INTEGER)'
      '11017623=RETURNS ('
      '11017624=  ERR_CODE INTEGER,'
      '11017625=  ERR_MSG VARCHAR(1024))'
      '11017626=AS'
      
        '11017627=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11017628=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11017629=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11017630=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR;'
      
        '11017631=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11017632=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11017633=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11017634=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11017635=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11017636=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11017637=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11017638=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11017639=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11017640=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11017641=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11017642=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11017643=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11017644=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11017645=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11017646=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11017647=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11017648=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11017649=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11017650=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11017651=BEGIN'
      '11017652=    ERR_MSG = '#39#39';'
      '11017653=    PNT_ = '#39'00'#39';'
      '11017654='
      
        '11017655=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11017656=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11017657=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11017658=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11017659=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11017660=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11017661=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11017662=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11017663=    END ELSE'
      '11017664=        CROSSCODE_ = NULL;'
      '11017665='
      '11017666=    PNT_ = '#39'01'#39';'
      '11017667=    SELECT ID'
      '11017668=      FROM CUR_PARAMS'
      '11017669=    WHERE CUR_PARAMS = 2'
      '11017670=      INTO :G_TOCHKA_;'
      '11017671='
      '11017672=    SELECT G.G_UNIT'
      '11017673=      FROM G_UNIT G'
      
        '11017674=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11017675=      INTO :G_UNIT_;'
      '11017676=    if (ROW_COUNT = 0) then'
      '11017677=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11017678='
      '11017679=    PNT_ = '#39'02'#39';'
      
        '11017680=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11017681=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11017682=        SELECT G.G_PRODUCT,'
      '11017683=               G.NAME'
      '11017684=          FROM G_PRODUCT G'
      
        '11017685=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11017686=           AND TRIM(G.ARTICUL) <> '#39#39
      '11017687=           AND G.IS_ACTIVE = 1'
      '11017688=          INTO :G_PRODUCT_,'
      '11017689=               :G_PRODUCT_NAME_;'
      '11017690='
      
        '11017691=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11017692=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11017693=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11017694=              UPDATE G_PRODUCT G'
      '11017695=                 SET G.NAME = COALESCE(:NAME_, G.NAME),'
      '11017696=                     G.G_UNIT = :G_UNIT_,'
      '11017697=                     G.PRICE  = :PRICE_,'
      '11017698=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11017699=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      
        '110176100=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '110176101=                     G.MF_COUNTRY  = DECODE(CHAR_LENGT' +
        'H(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110176102=                     G.PLACE = DECODE(CHAR_LENGTH(:PLA' +
        'CE_), 0, G.PLACE, :PLACE_),'
      
        '110176103=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR_NUM' +
        '_),'
      
        '110176104=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110176105=                     G.CROSSCODE      = COALESCE(:CROS' +
        'SCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, G.CR' +
        'OSSCODE, :CROSSCODE_),'
      
        '110176106=                     G.BRAND          = DECODE(CHAR_LE' +
        'NGTH(:BRAND_), 0, G.BRAND, :BRAND_)'
      '110176107=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110176108='
      
        '110176109=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110176110=            END ELSE'
      
        '110176111=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110176112=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110176113=        END'
      '110176114=    END ELSE'
      
        '110176115=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110176116='
      
        '110176117=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      
        '110176118=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110176119=    PNT_ = '#39'02a'#39';'
      
        '110176120=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110176121=        SELECT G.G_PRODUCT,'
      '110176122=               G.NAME'
      '110176123=          FROM G_PRODUCT G'
      
        '110176124=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110176125=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110176126=           AND G.IS_ACTIVE = 1'
      '110176127=          INTO :G_PRODUCT_,'
      '110176128=               :G_PRODUCT_NAME_;'
      '110176129='
      
        '110176130=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110176131=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110176132=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110176133=              UPDATE G_PRODUCT G'
      '110176134=                 SET G.NAME = :NAME_,'
      '110176135=                     G.G_UNIT = :G_UNIT_,'
      '110176136=                     G.PRICE  = :PRICE_,'
      '110176137=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110176138=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110176139=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110176140=                     G.PLACE = :PLACE_,'
      
        '110176141=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110176142=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110176143=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110176144=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110176145=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110176146=                     ,G.BRAND          = :BRAND_'
      '110176147=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110176148='
      
        '110176149=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110176150=            END ELSE'
      
        '110176151=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110176152=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110176153=        END'
      '110176154=    end'
      '110176155=    */'
      '110176156='
      
        '110176157=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110176158=    PNT_ = '#39'02b'#39';'
      
        '110176159=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110176160=        SELECT G.G_PRODUCT,'
      '110176161=               G.NAME'
      '110176162=          FROM G_PRODUCT G'
      '110176163=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110176164=           AND TRIM(G.BARCODE) <> '#39#39
      '110176165=           AND G.IS_ACTIVE = 1'
      '110176166=          INTO :G_PRODUCT_,'
      '110176167=               :G_PRODUCT_NAME_;'
      '110176168='
      '110176169=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110176170=          SELECT G.G_PRODUCT,'
      '110176171=                 G.NAME'
      '110176172=            FROM G_PRODUCT G, LT_BARCODE L'
      '110176173=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110176174=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110176175=             AND TRIM(L.BARCODE) <> '#39#39
      '110176176=            INTO :G_PRODUCT_,'
      '110176177=                 :G_PRODUCT_NAME_;'
      '110176178='
      
        '110176179=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110176180=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110176181=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110176182=              UPDATE G_PRODUCT G'
      
        '110176183=                 SET G.NAME = COALESCE(:NAME_, G.NAME)' +
        ','
      '110176184=                     G.G_UNIT = :G_UNIT_,'
      '110176185=                     G.PRICE  = :PRICE_,'
      '110176186=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110176187=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      
        '110176188=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '110176189=                     G.MF_COUNTRY  = DECODE(CHAR_LENGT' +
        'H(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110176190=                     G.PLACE = DECODE(CHAR_LENGTH(:PLA' +
        'CE_), 0, G.PLACE, :PLACE_),'
      
        '110176191=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR_NUM' +
        '_),'
      
        '110176192=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110176193=                     G.CROSSCODE      = COALESCE(:CROS' +
        'SCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, G.CR' +
        'OSSCODE, :CROSSCODE_),'
      
        '110176194=                     G.BRAND          = DECODE(CHAR_LE' +
        'NGTH(:BRAND_), 0, G.BRAND, :BRAND_)'
      '110176195=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110176196='
      
        '110176197=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110176198=            END ELSE'
      
        '110176199=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110176200=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110176201=        END'
      
        '110176202=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110176203=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110176204='
      
        '110176205=    --================================================' +
        '========='
      '110176206=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110176207=    --================================================' +
        '========='
      '110176208=    PNT_ = '#39'02b'#39';'
      '110176209=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110176210='
      
        '110176211=        ----------------------------------------------' +
        '--------------------'
      
        '110176212=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' ' +
        #1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '110176213=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080 +
        '~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110176214=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110176215=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', ' +
        #1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '110176216=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110176217=            G_PRODUCT_PAR_ = NULL;'
      
        '110176218=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110176219=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110176220=              STR_ = CATEGORY_NAME_;'
      '110176221=              CATEGORY_NAME_ = '#39#39';'
      '110176222=            END ELSE'
      
        '110176223=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110176224='
      '110176225=            SELECT G_PRODUCT'
      '110176226=              FROM G_PRODUCT G'
      '110176227=             WHERE G.NAME = :STR_'
      '110176228=               AND G.IS_CATEGORY = 1'
      
        '110176229=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110176230=                   OR'
      '110176231=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '110176232=              INTO G_PRODUCT_PAR_;'
      '110176233=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110176234=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110176235=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110176236=                RETURNING G_PRODUCT'
      '110176237=                INTO :G_PRODUCT_PAR_;'
      '110176238='
      '110176239=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110176240=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110176241=        END'
      
        '110176242=        ----------------------------------------------' +
        '--------------------'
      '110176243='
      
        '110176244=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110176245=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110176246=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110176247=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110176248=        RETURNING G_PRODUCT'
      '110176249=        INTO :G_PRODUCT_;'
      '110176250='
      
        '110176251=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110176252=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110176253=    end'
      '110176254='
      
        '110176255=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110176256=    PNT_ = '#39'03'#39';'
      '110176257=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110176258=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110176259=                                       :AMOUNT_,'
      '110176260=                                       :SELF_PRICE_,'
      
        '110176261=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110176262=                                       0, --nds_,'
      '110176263=                                       0 --nds_summ_,'
      
        '110176264=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110176265=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110176266=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110176267=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110176268=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110176269=          EXIT;'
      '110176270=        END'
      '110176271=    END'
      '110176272='
      
        '110176273=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110176274=    PNT_ = '#39'04'#39';'
      '110176275=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110176276=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110176277=        FROM SKLAD_TMP T'
      '110176278=        INTO :CNT_;'
      '110176279='
      '110176280=      if (CNT_ > 0) then BEGIN'
      '110176281=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110176282=          FROM SKLAD_TMP T'
      '110176283=          INTO :SUMM_, :SUMM_UE_;'
      '110176284='
      '110176285=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110176286=                                DATE_RECEIPT,'
      '110176287=                                TIME_RECEIPT,'
      '110176288=                                G_CLIENT,'
      '110176289=                                G_PAYMENT_TYPE,'
      '110176290=                                OSNOVANIE,'
      '110176291=                                NOTE,'
      '110176292=                                SUMM,'
      '110176293=                                SUMM_FACT,'
      '110176294=                                SUMM_CURRENCY,'
      '110176295=                                IS_PAYED_ALL,'
      '110176296=                                IS_VOZVRAT,'
      '110176297=                                G_TOCHKA)'
      '110176298=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110176299=                CURRENT_DATE,'
      '110176300=                CURRENT_TIME,'
      '110176301=                :G_CLIENT_,'
      '110176302=                1,'
      '110176303=                NULL,  --:OSNOVANIE_,'
      '110176304=                NULL,  -- :NOTE_,'
      '110176305=                :SUMM_,'
      '110176306=                :SUMM_,'
      '110176307=                :SUMM_UE_,'
      
        '110176308=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110176309=                0,'
      '110176310=                :G_TOCHKA_)'
      '110176311=        RETURNING'
      '110176312=          SKLAD'
      '110176313=        INTO'
      '110176314=          :SKLAD_PARENT_;'
      '110176315='
      '110176316=        PNT_ = '#39'05'#39';'
      '110176317=        FOR SELECT SKLAD,'
      '110176318=                   G_PRODUCT,'
      '110176319=                   AMOUNT,'
      '110176320=                   PRICE,'
      '110176321=                   SUMM'
      '110176322=                   ,PRICE_CURRENCY'
      '110176323=                   ,SUMM_CURRENCY'
      '110176324=              FROM SKLAD_TMP'
      '110176325=             ORDER BY 1'
      '110176326=              INTO :SKLAD_TMP_,'
      '110176327=                   :RG_PRODUCT_,'
      '110176328=                   :RAMOUNT_,'
      '110176329=                   :RPRICE_,'
      '110176330=                   :RSUMM_'
      '110176331=                   ,:RPRICE_UE_'
      '110176332=                   ,:RSUMM_UE_'
      '110176333=        DO BEGIN'
      '110176334='
      '110176335=            UPDATE SKLAD SK'
      '110176336=               SET SK.IS_LAST = 0'
      '110176337=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110176338=               AND SK.IS_LAST = 1;'
      '110176339='
      '110176340=            INSERT INTO SKLAD'
      '110176341=            ('
      '110176342=             SKLAD,'
      '110176343=             SKLAD_PARENT,'
      '110176344=             DATE_RECEIPT,'
      '110176345=             G_CLIENT,'
      '110176346=             G_PRODUCT,'
      '110176347=             AMOUNT,'
      '110176348=             PRICE,'
      '110176349=             SUMM,'
      '110176350=             G_PAYMENT_TYPE,'
      '110176351=             OSNOVANIE,'
      '110176352=             NOTE,'
      '110176353=             NDS,'
      '110176354=             NDS_SUMM,'
      '110176355=             IS_LAST,'
      '110176356=             IS_VOZVRAT,'
      '110176357=             G_TOCHKA'
      '110176358=             ,PRICE_CURRENCY'
      '110176359=             ,SUMM_CURRENCY'
      '110176360=            ) VALUES ('
      '110176361=             :SKLAD_TMP_,'
      '110176362=             :SKLAD_PARENT_,'
      '110176363=             CURRENT_DATE,'
      '110176364=             :G_CLIENT_,'
      '110176365=             :RG_PRODUCT_,'
      '110176366=             :RAMOUNT_,'
      '110176367=             :RPRICE_,'
      '110176368=             :RSUMM_,'
      '110176369=             1,       --:G_PAYMENT_TYPE_,'
      '110176370=             NULL,    --:OSNOVANIE_,'
      '110176371=             NULL,    --:NOTE_,'
      '110176372=             0,       --:RNDS_,'
      '110176373=             0,       --:RNDS_SUMM_,'
      '110176374=             1,       --IS_LAST_'
      '110176375=             0,        --:IS_VOZVRAT_'
      '110176376=             :G_TOCHKA_'
      '110176377=             ,:RPRICE_UE_'
      '110176378=             ,:RSUMM_UE_'
      '110176379=            );'
      '110176380='
      
        '110176381=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110176382=            PNT_ = '#39'06'#39';'
      '110176383=            UPDATE LT_SKLAD_PRODUCT L'
      '110176384=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110176385=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110176386=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110176387='
      '110176388=            PNT_ = '#39'06a'#39';'
      '110176389=            IF (ROW_COUNT = 0) THEN'
      
        '110176390=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110176391=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110176392=        END'
      '110176393='
      '110176394=        PNT_ = '#39'07'#39';'
      
        '110176395=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110176396=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110176397=                                :SUMM_,'
      '110176398=                                CURRENT_DATE,'
      
        '110176399=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110176400=                                NULL,   --ZAKAZ_'
      '110176401=                                :SKLAD_PARENT_,'
      '110176402=                                1,'
      
        '110176403=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110176404=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110176405=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110176406=          EXIT;'
      '110176407=        END'
      '110176408='
      '110176409=        DELETE FROM SKLAD_TMP;'
      '110176410=      END'
      '110176411=    END'
      '110176412='
      
        '110176413=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110176414=    if (ERR_MSG_ IS NOT NULL) then'
      '110176415=      ERR_MSG = ERR_MSG_;'
      '110176416='
      '110176417=WHEN ANY DO BEGIN'
      '110176418=    Err_code = gdscode;'
      
        '110176419=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110176420=  END'
      '110176421=END'
      '110176422=;'
      '110176423='
      '110176424='
      
        '110176425=UPDATE SYSTEM_SETUP SET S_VALUE = 110176 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110176426=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110176427=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101770='
      '1101771=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101772=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101773=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1101774=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101775=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101776=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101777=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101778=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101779=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11017710=  SELF_PRICE_ NUMERIC(15,2),'
      '11017711=  AMOUNT_ MY_NUMERIC_5,'
      '11017712=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11017713=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11017714=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11017715=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11017716=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11017717=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11017718=  CATEGORY_NAME_ VARCHAR(1000),'
      '11017719=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11017720=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11017721=  IS_THIS_LAST_ INTEGER,'
      '11017722=  UPDATE_IF_EXIST_ INTEGER)'
      '11017723=RETURNS ('
      '11017724=  ERR_CODE INTEGER,'
      '11017725=  ERR_MSG VARCHAR(1024))'
      '11017726=AS'
      
        '11017727=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11017728=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11017729=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11017730=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR;'
      
        '11017731=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11017732=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11017733=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11017734=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11017735=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11017736=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11017737=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11017738=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11017739=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11017740=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11017741=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11017742=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11017743=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11017744=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11017745=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11017746=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11017747=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11017748=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11017749=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11017750=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11017751=BEGIN'
      '11017752=    ERR_MSG = '#39#39';'
      '11017753=    PNT_ = '#39'00'#39';'
      '11017754='
      
        '11017755=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11017756=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11017757=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11017758=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11017759=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11017760=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11017761=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11017762=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11017763=    END ELSE'
      '11017764=        CROSSCODE_ = NULL;'
      '11017765='
      '11017766=    PNT_ = '#39'01'#39';'
      '11017767=    SELECT ID'
      '11017768=      FROM CUR_PARAMS'
      '11017769=    WHERE CUR_PARAMS = 2'
      '11017770=      INTO :G_TOCHKA_;'
      '11017771='
      '11017772=    SELECT G.G_UNIT'
      '11017773=      FROM G_UNIT G'
      
        '11017774=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11017775=      INTO :G_UNIT_;'
      '11017776=    if (ROW_COUNT = 0) then'
      '11017777=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11017778='
      '11017779=    PNT_ = '#39'02'#39';'
      
        '11017780=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11017781=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11017782=        SELECT G.G_PRODUCT,'
      '11017783=               G.NAME'
      '11017784=          FROM G_PRODUCT G'
      
        '11017785=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11017786=           AND TRIM(G.ARTICUL) <> '#39#39
      '11017787=           AND G.IS_ACTIVE = 1'
      '11017788=          INTO :G_PRODUCT_,'
      '11017789=               :G_PRODUCT_NAME_;'
      '11017790='
      
        '11017791=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11017792=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11017793=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11017794=              UPDATE G_PRODUCT G'
      '11017795=                 SET G.NAME = :NAME_,'
      '11017796=                     G.G_UNIT = :G_UNIT_,'
      
        '11017797=                     G.PRICE  = DECODE(:PRICE_, -999, G' +
        '.PRICE, :PRICE_),'
      
        '11017798=                     G.VOLUME_PRICE = DECODE(:VOLUME_PR' +
        'ICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '11017799=                     G.PACK_AMOUNT = DECODE(:PACK_AMOUN' +
        'T_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110177100=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '110177101=                     G.MF_COUNTRY  = DECODE(CHAR_LENGT' +
        'H(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110177102=                     G.PLACE = DECODE(CHAR_LENGTH(:PLA' +
        'CE_), 0, G.PLACE, :PLACE_),'
      
        '110177103=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR_NUM' +
        '_),'
      
        '110177104=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110177105=                     G.CROSSCODE      = COALESCE(:CROS' +
        'SCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, G.CR' +
        'OSSCODE, :CROSSCODE_),'
      
        '110177106=                     G.BRAND          = DECODE(CHAR_LE' +
        'NGTH(:BRAND_), 0, G.BRAND, :BRAND_)'
      '110177107=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110177108='
      
        '110177109=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110177110=            END ELSE'
      
        '110177111=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110177112=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110177113=        END'
      '110177114=    END ELSE'
      
        '110177115=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110177116='
      
        '110177117=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      
        '110177118=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110177119=    PNT_ = '#39'02a'#39';'
      
        '110177120=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110177121=        SELECT G.G_PRODUCT,'
      '110177122=               G.NAME'
      '110177123=          FROM G_PRODUCT G'
      
        '110177124=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110177125=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110177126=           AND G.IS_ACTIVE = 1'
      '110177127=          INTO :G_PRODUCT_,'
      '110177128=               :G_PRODUCT_NAME_;'
      '110177129='
      
        '110177130=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110177131=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110177132=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110177133=              UPDATE G_PRODUCT G'
      '110177134=                 SET G.NAME = :NAME_,'
      '110177135=                     G.G_UNIT = :G_UNIT_,'
      '110177136=                     G.PRICE  = :PRICE_,'
      '110177137=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110177138=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110177139=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110177140=                     G.PLACE = :PLACE_,'
      
        '110177141=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110177142=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110177143=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110177144=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110177145=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110177146=                     ,G.BRAND          = :BRAND_'
      '110177147=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110177148='
      
        '110177149=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110177150=            END ELSE'
      
        '110177151=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110177152=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110177153=        END'
      '110177154=    end'
      '110177155=    */'
      '110177156='
      
        '110177157=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110177158=    PNT_ = '#39'02b'#39';'
      
        '110177159=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110177160=        SELECT G.G_PRODUCT,'
      '110177161=               G.NAME'
      '110177162=          FROM G_PRODUCT G'
      '110177163=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110177164=           AND TRIM(G.BARCODE) <> '#39#39
      '110177165=           AND G.IS_ACTIVE = 1'
      '110177166=          INTO :G_PRODUCT_,'
      '110177167=               :G_PRODUCT_NAME_;'
      '110177168='
      '110177169=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110177170=          SELECT G.G_PRODUCT,'
      '110177171=                 G.NAME'
      '110177172=            FROM G_PRODUCT G, LT_BARCODE L'
      '110177173=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110177174=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110177175=             AND TRIM(L.BARCODE) <> '#39#39
      '110177176=            INTO :G_PRODUCT_,'
      '110177177=                 :G_PRODUCT_NAME_;'
      '110177178='
      
        '110177179=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110177180=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110177181=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110177182=              UPDATE G_PRODUCT G'
      '110177183=                 SET G.NAME = :NAME_,'
      '110177184=                     G.G_UNIT = :G_UNIT_,'
      
        '110177185=                     G.PRICE  = DECODE(:PRICE_, -999, ' +
        'G.PRICE, :PRICE_),'
      
        '110177186=                     G.VOLUME_PRICE = DECODE(:VOLUME_P' +
        'RICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110177187=                     G.PACK_AMOUNT = DECODE(:PACK_AMOU' +
        'NT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110177188=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '110177189=                     G.MF_COUNTRY  = DECODE(CHAR_LENGT' +
        'H(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110177190=                     G.PLACE = DECODE(CHAR_LENGTH(:PLA' +
        'CE_), 0, G.PLACE, :PLACE_),'
      
        '110177191=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR_NUM' +
        '_),'
      
        '110177192=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110177193=                     G.CROSSCODE      = COALESCE(:CROS' +
        'SCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, G.CR' +
        'OSSCODE, :CROSSCODE_),'
      
        '110177194=                     G.BRAND          = DECODE(CHAR_LE' +
        'NGTH(:BRAND_), 0, G.BRAND, :BRAND_)'
      '110177195=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110177196='
      
        '110177197=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110177198=            END ELSE'
      
        '110177199=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110177200=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110177201=        END'
      
        '110177202=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110177203=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110177204='
      
        '110177205=    --================================================' +
        '========='
      '110177206=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110177207=    --================================================' +
        '========='
      '110177208=    PNT_ = '#39'02b'#39';'
      '110177209=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110177210='
      '110177211=        IF (PRICE_ = -999) THEN'
      '110177212=          PRICE_ = 0;'
      '110177213=        IF (VOLUME_PRICE_ = -999) THEN'
      '110177214=          VOLUME_PRICE_ = 0;'
      '110177215=        IF (PACK_AMOUNT_ = -999) THEN'
      '110177216=          PACK_AMOUNT_ = 0;'
      '110177217='
      
        '110177218=        ----------------------------------------------' +
        '--------------------'
      
        '110177219=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' ' +
        #1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '110177220=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080 +
        '~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110177221=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110177222=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', ' +
        #1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '110177223=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110177224=            G_PRODUCT_PAR_ = NULL;'
      
        '110177225=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110177226=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110177227=              STR_ = CATEGORY_NAME_;'
      '110177228=              CATEGORY_NAME_ = '#39#39';'
      '110177229=            END ELSE'
      
        '110177230=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110177231='
      '110177232=            SELECT G_PRODUCT'
      '110177233=              FROM G_PRODUCT G'
      '110177234=             WHERE G.NAME = :STR_'
      '110177235=               AND G.IS_CATEGORY = 1'
      
        '110177236=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110177237=                   OR'
      '110177238=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '110177239=              INTO G_PRODUCT_PAR_;'
      '110177240=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110177241=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110177242=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110177243=                RETURNING G_PRODUCT'
      '110177244=                INTO :G_PRODUCT_PAR_;'
      '110177245='
      '110177246=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110177247=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110177248=        END'
      
        '110177249=        ----------------------------------------------' +
        '--------------------'
      '110177250='
      
        '110177251=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110177252=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110177253=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110177254=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110177255=        RETURNING G_PRODUCT'
      '110177256=        INTO :G_PRODUCT_;'
      '110177257='
      
        '110177258=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110177259=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110177260=    end'
      '110177261='
      
        '110177262=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110177263=    PNT_ = '#39'03'#39';'
      '110177264=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110177265=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110177266=                                       :AMOUNT_,'
      '110177267=                                       :SELF_PRICE_,'
      
        '110177268=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110177269=                                       0, --nds_,'
      '110177270=                                       0 --nds_summ_,'
      
        '110177271=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110177272=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110177273=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110177274=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110177275=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110177276=          EXIT;'
      '110177277=        END'
      '110177278=    END'
      '110177279='
      
        '110177280=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110177281=    PNT_ = '#39'04'#39';'
      '110177282=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110177283=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110177284=        FROM SKLAD_TMP T'
      '110177285=        INTO :CNT_;'
      '110177286='
      '110177287=      if (CNT_ > 0) then BEGIN'
      '110177288=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110177289=          FROM SKLAD_TMP T'
      '110177290=          INTO :SUMM_, :SUMM_UE_;'
      '110177291='
      '110177292=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110177293=                                DATE_RECEIPT,'
      '110177294=                                TIME_RECEIPT,'
      '110177295=                                G_CLIENT,'
      '110177296=                                G_PAYMENT_TYPE,'
      '110177297=                                OSNOVANIE,'
      '110177298=                                NOTE,'
      '110177299=                                SUMM,'
      '110177300=                                SUMM_FACT,'
      '110177301=                                SUMM_CURRENCY,'
      '110177302=                                IS_PAYED_ALL,'
      '110177303=                                IS_VOZVRAT,'
      '110177304=                                G_TOCHKA)'
      '110177305=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110177306=                CURRENT_DATE,'
      '110177307=                CURRENT_TIME,'
      '110177308=                :G_CLIENT_,'
      '110177309=                1,'
      '110177310=                NULL,  --:OSNOVANIE_,'
      '110177311=                NULL,  -- :NOTE_,'
      '110177312=                :SUMM_,'
      '110177313=                :SUMM_,'
      '110177314=                :SUMM_UE_,'
      
        '110177315=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110177316=                0,'
      '110177317=                :G_TOCHKA_)'
      '110177318=        RETURNING'
      '110177319=          SKLAD'
      '110177320=        INTO'
      '110177321=          :SKLAD_PARENT_;'
      '110177322='
      '110177323=        PNT_ = '#39'05'#39';'
      '110177324=        FOR SELECT SKLAD,'
      '110177325=                   G_PRODUCT,'
      '110177326=                   AMOUNT,'
      '110177327=                   PRICE,'
      '110177328=                   SUMM'
      '110177329=                   ,PRICE_CURRENCY'
      '110177330=                   ,SUMM_CURRENCY'
      '110177331=              FROM SKLAD_TMP'
      '110177332=             ORDER BY 1'
      '110177333=              INTO :SKLAD_TMP_,'
      '110177334=                   :RG_PRODUCT_,'
      '110177335=                   :RAMOUNT_,'
      '110177336=                   :RPRICE_,'
      '110177337=                   :RSUMM_'
      '110177338=                   ,:RPRICE_UE_'
      '110177339=                   ,:RSUMM_UE_'
      '110177340=        DO BEGIN'
      '110177341='
      '110177342=            UPDATE SKLAD SK'
      '110177343=               SET SK.IS_LAST = 0'
      '110177344=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110177345=               AND SK.IS_LAST = 1;'
      '110177346='
      '110177347=            INSERT INTO SKLAD'
      '110177348=            ('
      '110177349=             SKLAD,'
      '110177350=             SKLAD_PARENT,'
      '110177351=             DATE_RECEIPT,'
      '110177352=             G_CLIENT,'
      '110177353=             G_PRODUCT,'
      '110177354=             AMOUNT,'
      '110177355=             PRICE,'
      '110177356=             SUMM,'
      '110177357=             G_PAYMENT_TYPE,'
      '110177358=             OSNOVANIE,'
      '110177359=             NOTE,'
      '110177360=             NDS,'
      '110177361=             NDS_SUMM,'
      '110177362=             IS_LAST,'
      '110177363=             IS_VOZVRAT,'
      '110177364=             G_TOCHKA'
      '110177365=             ,PRICE_CURRENCY'
      '110177366=             ,SUMM_CURRENCY'
      '110177367=            ) VALUES ('
      '110177368=             :SKLAD_TMP_,'
      '110177369=             :SKLAD_PARENT_,'
      '110177370=             CURRENT_DATE,'
      '110177371=             :G_CLIENT_,'
      '110177372=             :RG_PRODUCT_,'
      '110177373=             :RAMOUNT_,'
      '110177374=             :RPRICE_,'
      '110177375=             :RSUMM_,'
      '110177376=             1,       --:G_PAYMENT_TYPE_,'
      '110177377=             NULL,    --:OSNOVANIE_,'
      '110177378=             NULL,    --:NOTE_,'
      '110177379=             0,       --:RNDS_,'
      '110177380=             0,       --:RNDS_SUMM_,'
      '110177381=             1,       --IS_LAST_'
      '110177382=             0,        --:IS_VOZVRAT_'
      '110177383=             :G_TOCHKA_'
      '110177384=             ,:RPRICE_UE_'
      '110177385=             ,:RSUMM_UE_'
      '110177386=            );'
      '110177387='
      
        '110177388=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110177389=            PNT_ = '#39'06'#39';'
      '110177390=            UPDATE LT_SKLAD_PRODUCT L'
      '110177391=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110177392=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110177393=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110177394='
      '110177395=            PNT_ = '#39'06a'#39';'
      '110177396=            IF (ROW_COUNT = 0) THEN'
      
        '110177397=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110177398=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110177399=        END'
      '110177400='
      '110177401=        PNT_ = '#39'07'#39';'
      
        '110177402=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110177403=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110177404=                                :SUMM_,'
      '110177405=                                CURRENT_DATE,'
      
        '110177406=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110177407=                                NULL,   --ZAKAZ_'
      '110177408=                                :SKLAD_PARENT_,'
      '110177409=                                1,'
      
        '110177410=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110177411=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110177412=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110177413=          EXIT;'
      '110177414=        END'
      '110177415='
      '110177416=        DELETE FROM SKLAD_TMP;'
      '110177417=      END'
      '110177418=    END'
      '110177419='
      
        '110177420=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110177421=    if (ERR_MSG_ IS NOT NULL) then'
      '110177422=      ERR_MSG = ERR_MSG_;'
      '110177423='
      '110177424=WHEN ANY DO BEGIN'
      '110177425=    Err_code = gdscode;'
      
        '110177426=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110177427=  END'
      '110177428=END'
      '110177429=;'
      '110177430='
      '110177431='
      
        '110177432=UPDATE SYSTEM_SETUP SET S_VALUE = 110177 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110177433=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110177434=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101780='
      '1101781=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101782=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101783=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1101784=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101785=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101786=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101787=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101788=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101789=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11017810=  SELF_PRICE_ NUMERIC(15,2),'
      '11017811=  AMOUNT_ MY_NUMERIC_5,'
      '11017812=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11017813=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11017814=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11017815=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11017816=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11017817=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11017818=  CATEGORY_NAME_ VARCHAR(1000),'
      '11017819=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11017820=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11017821=  IS_THIS_LAST_ INTEGER,'
      '11017822=  UPDATE_IF_EXIST_ INTEGER)'
      '11017823=RETURNS ('
      '11017824=  ERR_CODE INTEGER,'
      '11017825=  ERR_MSG VARCHAR(1024))'
      '11017826=AS'
      
        '11017827=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11017828=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11017829=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11017830=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR = NULL;'
      
        '11017831=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11017832=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11017833=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11017834=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11017835=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11017836=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11017837=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11017838=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11017839=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11017840=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11017841=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11017842=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11017843=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11017844=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11017845=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11017846=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11017847=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11017848=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11017849=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11017850=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11017851=BEGIN'
      '11017852=    ERR_MSG = '#39#39';'
      '11017853=    PNT_ = '#39'00'#39';'
      '11017854='
      
        '11017855=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11017856=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11017857=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11017858=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11017859=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11017860=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11017861=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11017862=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11017863=    END ELSE'
      '11017864=        CROSSCODE_ = NULL;'
      '11017865='
      
        '11017866=    ---------------------------------------------------' +
        '---------------'
      
        '11017867=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049 +
        ' '#1053#1045#1058
      
        '11017868=    -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~'#1052#1103#1075#1082 +
        #1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '11017869=    -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '11017870=    -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053#1054' '#1058#1040 +
        #1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      '11017871=    WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEGIN'
      '11017872=        G_PRODUCT_PAR_ = NULL;'
      '11017873=        POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME_);'
      '11017874=        IF (POS_TILDA_ = 0) THEN BEGIN'
      '11017875=          STR_ = CATEGORY_NAME_;'
      '11017876=          CATEGORY_NAME_ = '#39#39';'
      '11017877=        END ELSE'
      
        '11017878=          STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '11017879='
      '11017880=        SELECT G_PRODUCT'
      '11017881=          FROM G_PRODUCT G'
      '11017882=         WHERE G.NAME = :STR_'
      '11017883=           AND G.IS_CATEGORY = 1'
      
        '11017884=           AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_PREV_' +
        ' AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '11017885=               OR'
      
        '11017886=               (G.G_PRODUCT_PAR IS NULL AND :G_PRODUCT_' +
        'PAR_PREV_ IS NULL))'
      '11017887=          INTO G_PRODUCT_PAR_;'
      '11017888=        IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '11017889=            INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT' +
        '_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '11017890=            VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUC' +
        'T_PAR_PREV_, :STR_, 1, 0)'
      '11017891=            RETURNING G_PRODUCT'
      '11017892=            INTO :G_PRODUCT_PAR_;'
      '11017893='
      '11017894=        G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '11017895=        CATEGORY_NAME_      = SUBSTRING(CATEGORY_NAME_ ' +
        'FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '11017896=    END'
      
        '11017897=    ---------------------------------------------------' +
        '---------------'
      '11017898='
      '11017899=    PNT_ = '#39'01'#39';'
      '110178100=    SELECT ID'
      '110178101=      FROM CUR_PARAMS'
      '110178102=    WHERE CUR_PARAMS = 2'
      '110178103=      INTO :G_TOCHKA_;'
      '110178104='
      '110178105=    SELECT G.G_UNIT'
      '110178106=      FROM G_UNIT G'
      
        '110178107=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME' +
        '_G_UNIT_))'
      '110178108=      INTO :G_UNIT_;'
      '110178109=    if (ROW_COUNT = 0) then'
      '110178110=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110178111='
      '110178112=    PNT_ = '#39'02'#39';'
      
        '110178113=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110178114=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '110178115=        SELECT G.G_PRODUCT,'
      '110178116=               G.NAME'
      '110178117=          FROM G_PRODUCT G'
      
        '110178118=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110178119=           AND TRIM(G.ARTICUL) <> '#39#39
      '110178120=           AND G.IS_ACTIVE = 1'
      '110178121=          INTO :G_PRODUCT_,'
      '110178122=               :G_PRODUCT_NAME_;'
      '110178123='
      
        '110178124=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110178125=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110178126=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110178127=              UPDATE G_PRODUCT G'
      '110178128=                 SET G.NAME = :NAME_,'
      '110178129=                     G.G_UNIT = :G_UNIT_,'
      
        '110178130=                     G.PRICE  = DECODE(:PRICE_, -999, ' +
        'G.PRICE, :PRICE_),'
      
        '110178131=                     G.VOLUME_PRICE = DECODE(:VOLUME_P' +
        'RICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110178132=                     G.PACK_AMOUNT = DECODE(:PACK_AMOU' +
        'NT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110178133=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '110178134=                     G.MF_COUNTRY  = DECODE(CHAR_LENGT' +
        'H(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110178135=                     G.PLACE = DECODE(CHAR_LENGTH(:PLA' +
        'CE_), 0, G.PLACE, :PLACE_),'
      
        '110178136=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR_NUM' +
        '_),'
      
        '110178137=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110178138=                     G.CROSSCODE      = COALESCE(:CROS' +
        'SCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, G.CR' +
        'OSSCODE, :CROSSCODE_),'
      
        '110178139=                     G.BRAND          = DECODE(CHAR_LE' +
        'NGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '110178140=                     G.G_PRODUCT_PAR  = COALESCE(:G_PR' +
        'ODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110178141=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110178142='
      
        '110178143=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110178144=            END ELSE'
      
        '110178145=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110178146=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110178147=        END'
      '110178148=    END ELSE'
      
        '110178149=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110178150='
      
        '110178151=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      
        '110178152=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110178153=    PNT_ = '#39'02a'#39';'
      
        '110178154=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110178155=        SELECT G.G_PRODUCT,'
      '110178156=               G.NAME'
      '110178157=          FROM G_PRODUCT G'
      
        '110178158=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110178159=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110178160=           AND G.IS_ACTIVE = 1'
      '110178161=          INTO :G_PRODUCT_,'
      '110178162=               :G_PRODUCT_NAME_;'
      '110178163='
      
        '110178164=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110178165=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110178166=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110178167=              UPDATE G_PRODUCT G'
      '110178168=                 SET G.NAME = :NAME_,'
      '110178169=                     G.G_UNIT = :G_UNIT_,'
      '110178170=                     G.PRICE  = :PRICE_,'
      '110178171=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110178172=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110178173=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110178174=                     G.PLACE = :PLACE_,'
      
        '110178175=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110178176=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110178177=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110178178=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110178179=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110178180=                     ,G.BRAND          = :BRAND_'
      '110178181=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110178182='
      
        '110178183=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110178184=            END ELSE'
      
        '110178185=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110178186=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110178187=        END'
      '110178188=    end'
      '110178189=    */'
      '110178190='
      
        '110178191=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110178192=    PNT_ = '#39'02b'#39';'
      
        '110178193=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110178194=        SELECT G.G_PRODUCT,'
      '110178195=               G.NAME'
      '110178196=          FROM G_PRODUCT G'
      '110178197=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110178198=           AND TRIM(G.BARCODE) <> '#39#39
      '110178199=           AND G.IS_ACTIVE = 1'
      '110178200=          INTO :G_PRODUCT_,'
      '110178201=               :G_PRODUCT_NAME_;'
      '110178202='
      '110178203=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110178204=          SELECT G.G_PRODUCT,'
      '110178205=                 G.NAME'
      '110178206=            FROM G_PRODUCT G, LT_BARCODE L'
      '110178207=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110178208=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110178209=             AND TRIM(L.BARCODE) <> '#39#39
      '110178210=            INTO :G_PRODUCT_,'
      '110178211=                 :G_PRODUCT_NAME_;'
      '110178212='
      
        '110178213=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110178214=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110178215=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110178216=              UPDATE G_PRODUCT G'
      '110178217=                 SET G.NAME = :NAME_,'
      '110178218=                     G.G_UNIT = :G_UNIT_,'
      
        '110178219=                     G.PRICE  = DECODE(:PRICE_, -999, ' +
        'G.PRICE, :PRICE_),'
      
        '110178220=                     G.VOLUME_PRICE = DECODE(:VOLUME_P' +
        'RICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110178221=                     G.PACK_AMOUNT = DECODE(:PACK_AMOU' +
        'NT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110178222=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '110178223=                     G.MF_COUNTRY  = DECODE(CHAR_LENGT' +
        'H(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110178224=                     G.PLACE = DECODE(CHAR_LENGTH(:PLA' +
        'CE_), 0, G.PLACE, :PLACE_),'
      
        '110178225=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR_NUM' +
        '_),'
      
        '110178226=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110178227=                     G.CROSSCODE      = COALESCE(:CROS' +
        'SCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, G.CR' +
        'OSSCODE, :CROSSCODE_),'
      
        '110178228=                     G.BRAND          = DECODE(CHAR_LE' +
        'NGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '110178229=                     G.G_PRODUCT_PAR  = COALESCE(:G_PR' +
        'ODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110178230=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110178231='
      
        '110178232=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110178233=            END ELSE'
      
        '110178234=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110178235=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110178236=        END'
      
        '110178237=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110178238=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110178239='
      
        '110178240=    --================================================' +
        '========='
      '110178241=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110178242=    --================================================' +
        '========='
      '110178243=    PNT_ = '#39'02b'#39';'
      '110178244=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110178245='
      '110178246=        IF (PRICE_ = -999) THEN'
      '110178247=          PRICE_ = 0;'
      '110178248=        IF (VOLUME_PRICE_ = -999) THEN'
      '110178249=          VOLUME_PRICE_ = 0;'
      '110178250=        IF (PACK_AMOUNT_ = -999) THEN'
      '110178251=          PACK_AMOUNT_ = 0;'
      '110178252='
      
        '110178253=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110178254=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110178255=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110178256=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110178257=        RETURNING G_PRODUCT'
      '110178258=        INTO :G_PRODUCT_;'
      '110178259='
      
        '110178260=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110178261=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110178262=    end'
      '110178263='
      
        '110178264=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110178265=    PNT_ = '#39'03'#39';'
      '110178266=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110178267=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110178268=                                       :AMOUNT_,'
      '110178269=                                       :SELF_PRICE_,'
      
        '110178270=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110178271=                                       0, --nds_,'
      '110178272=                                       0 --nds_summ_,'
      
        '110178273=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110178274=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110178275=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110178276=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110178277=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110178278=          EXIT;'
      '110178279=        END'
      '110178280=    END'
      '110178281='
      
        '110178282=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110178283=    PNT_ = '#39'04'#39';'
      '110178284=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110178285=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110178286=        FROM SKLAD_TMP T'
      '110178287=        INTO :CNT_;'
      '110178288='
      '110178289=      if (CNT_ > 0) then BEGIN'
      '110178290=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110178291=          FROM SKLAD_TMP T'
      '110178292=          INTO :SUMM_, :SUMM_UE_;'
      '110178293='
      '110178294=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110178295=                                DATE_RECEIPT,'
      '110178296=                                TIME_RECEIPT,'
      '110178297=                                G_CLIENT,'
      '110178298=                                G_PAYMENT_TYPE,'
      '110178299=                                OSNOVANIE,'
      '110178300=                                NOTE,'
      '110178301=                                SUMM,'
      '110178302=                                SUMM_FACT,'
      '110178303=                                SUMM_CURRENCY,'
      '110178304=                                IS_PAYED_ALL,'
      '110178305=                                IS_VOZVRAT,'
      '110178306=                                G_TOCHKA)'
      '110178307=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110178308=                CURRENT_DATE,'
      '110178309=                CURRENT_TIME,'
      '110178310=                :G_CLIENT_,'
      '110178311=                1,'
      '110178312=                NULL,  --:OSNOVANIE_,'
      '110178313=                NULL,  -- :NOTE_,'
      '110178314=                :SUMM_,'
      '110178315=                :SUMM_,'
      '110178316=                :SUMM_UE_,'
      
        '110178317=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110178318=                0,'
      '110178319=                :G_TOCHKA_)'
      '110178320=        RETURNING'
      '110178321=          SKLAD'
      '110178322=        INTO'
      '110178323=          :SKLAD_PARENT_;'
      '110178324='
      '110178325=        PNT_ = '#39'05'#39';'
      '110178326=        FOR SELECT SKLAD,'
      '110178327=                   G_PRODUCT,'
      '110178328=                   AMOUNT,'
      '110178329=                   PRICE,'
      '110178330=                   SUMM'
      '110178331=                   ,PRICE_CURRENCY'
      '110178332=                   ,SUMM_CURRENCY'
      '110178333=              FROM SKLAD_TMP'
      '110178334=             ORDER BY 1'
      '110178335=              INTO :SKLAD_TMP_,'
      '110178336=                   :RG_PRODUCT_,'
      '110178337=                   :RAMOUNT_,'
      '110178338=                   :RPRICE_,'
      '110178339=                   :RSUMM_'
      '110178340=                   ,:RPRICE_UE_'
      '110178341=                   ,:RSUMM_UE_'
      '110178342=        DO BEGIN'
      '110178343='
      '110178344=            UPDATE SKLAD SK'
      '110178345=               SET SK.IS_LAST = 0'
      '110178346=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110178347=               AND SK.IS_LAST = 1;'
      '110178348='
      '110178349=            INSERT INTO SKLAD'
      '110178350=            ('
      '110178351=             SKLAD,'
      '110178352=             SKLAD_PARENT,'
      '110178353=             DATE_RECEIPT,'
      '110178354=             G_CLIENT,'
      '110178355=             G_PRODUCT,'
      '110178356=             AMOUNT,'
      '110178357=             PRICE,'
      '110178358=             SUMM,'
      '110178359=             G_PAYMENT_TYPE,'
      '110178360=             OSNOVANIE,'
      '110178361=             NOTE,'
      '110178362=             NDS,'
      '110178363=             NDS_SUMM,'
      '110178364=             IS_LAST,'
      '110178365=             IS_VOZVRAT,'
      '110178366=             G_TOCHKA'
      '110178367=             ,PRICE_CURRENCY'
      '110178368=             ,SUMM_CURRENCY'
      '110178369=            ) VALUES ('
      '110178370=             :SKLAD_TMP_,'
      '110178371=             :SKLAD_PARENT_,'
      '110178372=             CURRENT_DATE,'
      '110178373=             :G_CLIENT_,'
      '110178374=             :RG_PRODUCT_,'
      '110178375=             :RAMOUNT_,'
      '110178376=             :RPRICE_,'
      '110178377=             :RSUMM_,'
      '110178378=             1,       --:G_PAYMENT_TYPE_,'
      '110178379=             NULL,    --:OSNOVANIE_,'
      '110178380=             NULL,    --:NOTE_,'
      '110178381=             0,       --:RNDS_,'
      '110178382=             0,       --:RNDS_SUMM_,'
      '110178383=             1,       --IS_LAST_'
      '110178384=             0,        --:IS_VOZVRAT_'
      '110178385=             :G_TOCHKA_'
      '110178386=             ,:RPRICE_UE_'
      '110178387=             ,:RSUMM_UE_'
      '110178388=            );'
      '110178389='
      
        '110178390=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110178391=            PNT_ = '#39'06'#39';'
      '110178392=            UPDATE LT_SKLAD_PRODUCT L'
      '110178393=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110178394=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110178395=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110178396='
      '110178397=            PNT_ = '#39'06a'#39';'
      '110178398=            IF (ROW_COUNT = 0) THEN'
      
        '110178399=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110178400=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110178401=        END'
      '110178402='
      '110178403=        PNT_ = '#39'07'#39';'
      
        '110178404=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110178405=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110178406=                                :SUMM_,'
      '110178407=                                CURRENT_DATE,'
      
        '110178408=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110178409=                                NULL,   --ZAKAZ_'
      '110178410=                                :SKLAD_PARENT_,'
      '110178411=                                1,'
      
        '110178412=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110178413=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110178414=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110178415=          EXIT;'
      '110178416=        END'
      '110178417='
      '110178418=        DELETE FROM SKLAD_TMP;'
      '110178419=      END'
      '110178420=    END'
      '110178421='
      
        '110178422=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110178423=    if (ERR_MSG_ IS NOT NULL) then'
      '110178424=      ERR_MSG = ERR_MSG_;'
      '110178425='
      '110178426=WHEN ANY DO BEGIN'
      '110178427=    Err_code = gdscode;'
      
        '110178428=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110178429=  END'
      '110178430=END'
      '110178431=;'
      '110178432='
      '110178433='
      
        '110178434=UPDATE SYSTEM_SETUP SET S_VALUE = 110178 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110178435=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110178436=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101790='
      '1101791=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '1101792=  ARTICUL_ /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '1101793=  NOMENCLATUR_NUM_ /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '1101794=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '1101795=  NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '1101796=  NAME_G_UNIT_ /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(' +
        '50),'
      
        '1101797=  PRICE_ /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      
        '1101798=  VOLUME_PRICE_ /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ' */ NUMERIC(15,2),'
      
        '1101799=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      '11017910=  SELF_PRICE_ NUMERIC(15,2),'
      '11017911=  AMOUNT_ /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      
        '11017912=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT ' +
        '*/ NUMERIC(15,2),'
      
        '11017913=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */' +
        ' VARCHAR(150),'
      
        '11017914=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300' +
        '),'
      
        '11017915=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      '11017916=  SELF_PRICE_UE_ NUMERIC(15,2),'
      
        '11017917=  KOD_TNVD_ /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VAR' +
        'CHAR(50),'
      '11017918=  CATEGORY_NAME_ VARCHAR(1000),'
      
        '11017919=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ B' +
        'LOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '11017920=  BRAND_ /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(1' +
        '50),'
      '11017921=  IS_THIS_LAST_ INTEGER,'
      '11017922=  UPDATE_IF_EXIST_ INTEGER,'
      '11017923=  DO_SEARCH_CATEGORY_ INTEGER,'
      '11017924=  BARCODE_IS_MAIN_ INTEGER)'
      '11017925=RETURNS ('
      '11017926=  ERR_CODE INTEGER,'
      '11017927=  ERR_MSG VARCHAR(1024))'
      '11017928=AS'
      '11017929=BEGIN'
      '11017930=  SUSPEND;'
      '11017931=END'
      '11017932=;'
      '11017933='
      '11017934='
      
        '11017935=/******************************************************' +
        '************************/'
      
        '11017936=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11017937=/******************************************************' +
        '************************/'
      '11017938=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '11017939=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11017940=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '11017941=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11017942=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11017943=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '11017944=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11017945=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11017946=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11017947=  SELF_PRICE_ NUMERIC(15,2),'
      '11017948=  AMOUNT_ MY_NUMERIC_5,'
      '11017949=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11017950=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11017951=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11017952=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11017953=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11017954=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11017955=  CATEGORY_NAME_ VARCHAR(1000),'
      '11017956=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11017957=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11017958=  IS_THIS_LAST_ INTEGER,'
      '11017959=  UPDATE_IF_EXIST_ INTEGER,'
      '11017960=  DO_SEARCH_CATEGORY_ INTEGER,'
      '11017961=  BARCODE_IS_MAIN_ INTEGER)'
      '11017962=RETURNS ('
      '11017963=  ERR_CODE INTEGER,'
      '11017964=  ERR_MSG VARCHAR(1024))'
      '11017965=AS'
      
        '11017966=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11017967=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11017968=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11017969=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR = NULL;'
      
        '11017970=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11017971=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11017972=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11017973=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11017974=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11017975=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11017976=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11017977=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11017978=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11017979=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11017980=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11017981=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11017982=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11017983=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11017984=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11017985=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11017986=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11017987=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11017988=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11017989=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11017990=BEGIN'
      '11017991=    ERR_MSG = '#39#39';'
      '11017992=    PNT_ = '#39'00'#39';'
      '11017993='
      
        '11017994=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11017995=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11017996=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11017997=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11017998=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11017999=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '110179100=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '110179101=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '110179102=    END ELSE'
      '110179103=        CROSSCODE_ = NULL;'
      '110179104='
      
        '110179105=    --------------------------------------------------' +
        '----------------'
      
        '110179106=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058#1040#1050#1054 +
        #1049' '#1053#1045#1058
      
        '110179107=    -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~'#1052#1103#1075 +
        #1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110179108=    -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110179109=    -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053#1054' '#1058 +
        #1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      '110179110=    IF (DO_SEARCH_CATEGORY_ = 1) THEN BEGIN'
      
        '110179111=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110179112=            G_PRODUCT_PAR_ = NULL;'
      
        '110179113=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110179114=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110179115=              STR_ = CATEGORY_NAME_;'
      '110179116=              CATEGORY_NAME_ = '#39#39';'
      '110179117=            END ELSE'
      
        '110179118=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110179119='
      '110179120=            SELECT G_PRODUCT'
      '110179121=              FROM G_PRODUCT G'
      '110179122=             WHERE G.NAME = :STR_'
      '110179123=               AND G.IS_CATEGORY = 1'
      
        '110179124=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110179125=                   OR'
      
        '110179126=                   (G.G_PRODUCT_PAR IS NULL AND :G_PRO' +
        'DUCT_PAR_PREV_ IS NULL))'
      '110179127=              INTO G_PRODUCT_PAR_;'
      '110179128=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110179129=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110179130=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110179131=                RETURNING G_PRODUCT'
      '110179132=                INTO :G_PRODUCT_PAR_;'
      '110179133='
      '110179134=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110179135=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110179136=        END'
      '110179137=    END'
      
        '110179138=    --------------------------------------------------' +
        '----------------'
      '110179139='
      '110179140=    PNT_ = '#39'01'#39';'
      '110179141=    SELECT ID'
      '110179142=      FROM CUR_PARAMS'
      '110179143=    WHERE CUR_PARAMS = 2'
      '110179144=      INTO :G_TOCHKA_;'
      '110179145='
      '110179146=    SELECT G.G_UNIT'
      '110179147=      FROM G_UNIT G'
      
        '110179148=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME' +
        '_G_UNIT_))'
      '110179149=      INTO :G_UNIT_;'
      '110179150=    if (ROW_COUNT = 0) then'
      '110179151=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110179152='
      '110179153=    PNT_ = '#39'02'#39';'
      
        '110179154=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110179155=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '110179156=        SELECT G.G_PRODUCT,'
      '110179157=               G.NAME'
      '110179158=          FROM G_PRODUCT G'
      
        '110179159=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110179160=           AND TRIM(G.ARTICUL) <> '#39#39
      '110179161=           AND G.IS_ACTIVE = 1'
      '110179162=          INTO :G_PRODUCT_,'
      '110179163=               :G_PRODUCT_NAME_;'
      '110179164='
      '110179165=        PNT_ = '#39'02.1'#39';'
      
        '110179166=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110179167=        IF (COALESCE(G_PRODUCT_, 0) <> 0) THEN BEGIN'
      '110179168=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110179169=              IF (BARCODE_IS_MAIN_ = 0) THEN BEGIN'
      '110179170=                  UPDATE G_PRODUCT G'
      '110179171=                     SET G.NAME = :NAME_,'
      '110179172=                         G.G_UNIT = :G_UNIT_,'
      
        '110179173=                         G.PRICE  = DECODE(:PRICE_, -9' +
        '99, G.PRICE, :PRICE_),'
      
        '110179174=                         G.VOLUME_PRICE = DECODE(:VOLU' +
        'ME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110179175=                         G.PACK_AMOUNT = DECODE(:PACK_' +
        'AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110179176=                         G.barcode         = DECODE(CH' +
        'AR_LENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '110179177=                         G.MF_COUNTRY  = DECODE(CHAR_L' +
        'ENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110179178=                         G.PLACE = DECODE(CHAR_LENGTH(' +
        ':PLACE_), 0, G.PLACE, :PLACE_),'
      
        '110179179=                         G.nomenclatur_num = DECODE(CH' +
        'AR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR' +
        '_NUM_),'
      
        '110179180=                         G.KOD_TNVD        = DECODE(CH' +
        'AR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110179181=                         G.CROSSCODE      = COALESCE(:' +
        'CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, ' +
        'G.CROSSCODE, :CROSSCODE_),'
      
        '110179182=                         G.BRAND          = DECODE(CHA' +
        'R_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '110179183=                         G.G_PRODUCT_PAR  = COALESCE(:' +
        'G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110179184=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110179185='
      
        '110179186=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086 +
        #1084' '#39'||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110179187=              END'
      '110179188=              ELSE'
      '110179189=                G_PRODUCT_ = 0;'
      '110179190=            END ELSE'
      
        '110179191=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110179192=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110179193=        END'
      '110179194=    END ELSE'
      
        '110179195=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110179196='
      
        '110179197=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      
        '110179198=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110179199=    PNT_ = '#39'02a'#39';'
      
        '110179200=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110179201=        SELECT G.G_PRODUCT,'
      '110179202=               G.NAME'
      '110179203=          FROM G_PRODUCT G'
      
        '110179204=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110179205=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110179206=           AND G.IS_ACTIVE = 1'
      '110179207=          INTO :G_PRODUCT_,'
      '110179208=               :G_PRODUCT_NAME_;'
      '110179209='
      
        '110179210=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110179211=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110179212=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110179213=              UPDATE G_PRODUCT G'
      '110179214=                 SET G.NAME = :NAME_,'
      '110179215=                     G.G_UNIT = :G_UNIT_,'
      '110179216=                     G.PRICE  = :PRICE_,'
      '110179217=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110179218=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110179219=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110179220=                     G.PLACE = :PLACE_,'
      
        '110179221=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110179222=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110179223=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110179224=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110179225=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110179226=                     ,G.BRAND          = :BRAND_'
      '110179227=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110179228='
      
        '110179229=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110179230=            END ELSE'
      
        '110179231=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110179232=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110179233=        END'
      '110179234=    end'
      '110179235=    */'
      '110179236='
      
        '110179237=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110179238=    PNT_ = '#39'02.2'#39';'
      
        '110179239=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110179240=        SELECT G.G_PRODUCT,'
      '110179241=               G.NAME'
      '110179242=          FROM G_PRODUCT G'
      '110179243=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110179244=           AND TRIM(G.BARCODE) <> '#39#39
      '110179245=           AND G.IS_ACTIVE = 1'
      '110179246=          INTO :G_PRODUCT_,'
      '110179247=               :G_PRODUCT_NAME_;'
      '110179248='
      '110179249=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110179250=          SELECT G.G_PRODUCT,'
      '110179251=                 G.NAME'
      '110179252=            FROM G_PRODUCT G, LT_BARCODE L'
      '110179253=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110179254=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110179255=             AND TRIM(L.BARCODE) <> '#39#39
      '110179256=            INTO :G_PRODUCT_,'
      '110179257=                 :G_PRODUCT_NAME_;'
      '110179258='
      
        '110179259=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110179260=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110179261=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110179262=              IF (BARCODE_IS_MAIN_ = 1) THEN BEGIN'
      '110179263=                  UPDATE G_PRODUCT G'
      '110179264=                     SET G.NAME = :NAME_,'
      '110179265=                         G.G_UNIT = :G_UNIT_,'
      
        '110179266=                         G.PRICE  = DECODE(:PRICE_, -9' +
        '99, G.PRICE, :PRICE_),'
      
        '110179267=                         G.VOLUME_PRICE = DECODE(:VOLU' +
        'ME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110179268=                         G.PACK_AMOUNT = DECODE(:PACK_' +
        'AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110179269=                         G.articul         = DECODE(CH' +
        'AR_LENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '110179270=                         G.MF_COUNTRY  = DECODE(CHAR_L' +
        'ENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110179271=                         G.PLACE = DECODE(CHAR_LENGTH(' +
        ':PLACE_), 0, G.PLACE, :PLACE_),'
      
        '110179272=                         G.nomenclatur_num = DECODE(CH' +
        'AR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR' +
        '_NUM_),'
      
        '110179273=                         G.KOD_TNVD        = DECODE(CH' +
        'AR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110179274=                         G.CROSSCODE      = COALESCE(:' +
        'CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, ' +
        'G.CROSSCODE, :CROSSCODE_),'
      
        '110179275=                         G.BRAND          = DECODE(CHA' +
        'R_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '110179276=                         G.G_PRODUCT_PAR  = COALESCE(:' +
        'G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110179277=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110179278='
      
        '110179279=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076 +
        #1086#1084' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110179280=              END'
      '110179281=              ELSE'
      '110179282=                G_PRODUCT_ = 0;'
      '110179283=            END ELSE'
      
        '110179284=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110179285=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110179286=        END'
      
        '110179287=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110179288=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110179289='
      
        '110179290=    --================================================' +
        '========='
      '110179291=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110179292=    --================================================' +
        '========='
      '110179293=    PNT_ = '#39'02b'#39';'
      '110179294=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110179295='
      '110179296=        IF (PRICE_ = -999) THEN'
      '110179297=          PRICE_ = 0;'
      '110179298=        IF (VOLUME_PRICE_ = -999) THEN'
      '110179299=          VOLUME_PRICE_ = 0;'
      '110179300=        IF (PACK_AMOUNT_ = -999) THEN'
      '110179301=          PACK_AMOUNT_ = 0;'
      '110179302='
      
        '110179303=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110179304=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110179305=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110179306=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110179307=        RETURNING G_PRODUCT'
      '110179308=        INTO :G_PRODUCT_;'
      '110179309='
      
        '110179310=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110179311=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110179312=    end'
      '110179313='
      
        '110179314=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110179315=    PNT_ = '#39'03'#39';'
      '110179316=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110179317=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110179318=                                       :AMOUNT_,'
      '110179319=                                       :SELF_PRICE_,'
      
        '110179320=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110179321=                                       0, --nds_,'
      '110179322=                                       0 --nds_summ_,'
      
        '110179323=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110179324=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110179325=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110179326=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110179327=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110179328=          EXIT;'
      '110179329=        END'
      '110179330=    END'
      '110179331='
      
        '110179332=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110179333=    PNT_ = '#39'04'#39';'
      '110179334=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110179335=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110179336=        FROM SKLAD_TMP T'
      '110179337=        INTO :CNT_;'
      '110179338='
      '110179339=      if (CNT_ > 0) then BEGIN'
      '110179340=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110179341=          FROM SKLAD_TMP T'
      '110179342=          INTO :SUMM_, :SUMM_UE_;'
      '110179343='
      '110179344=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110179345=                                DATE_RECEIPT,'
      '110179346=                                TIME_RECEIPT,'
      '110179347=                                G_CLIENT,'
      '110179348=                                G_PAYMENT_TYPE,'
      '110179349=                                OSNOVANIE,'
      '110179350=                                NOTE,'
      '110179351=                                SUMM,'
      '110179352=                                SUMM_FACT,'
      '110179353=                                SUMM_CURRENCY,'
      '110179354=                                IS_PAYED_ALL,'
      '110179355=                                IS_VOZVRAT,'
      '110179356=                                G_TOCHKA)'
      '110179357=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110179358=                CURRENT_DATE,'
      '110179359=                CURRENT_TIME,'
      '110179360=                :G_CLIENT_,'
      '110179361=                1,'
      '110179362=                NULL,  --:OSNOVANIE_,'
      '110179363=                NULL,  -- :NOTE_,'
      '110179364=                :SUMM_,'
      '110179365=                :SUMM_,'
      '110179366=                :SUMM_UE_,'
      
        '110179367=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110179368=                0,'
      '110179369=                :G_TOCHKA_)'
      '110179370=        RETURNING'
      '110179371=          SKLAD'
      '110179372=        INTO'
      '110179373=          :SKLAD_PARENT_;'
      '110179374='
      '110179375=        PNT_ = '#39'05'#39';'
      '110179376=        FOR SELECT SKLAD,'
      '110179377=                   G_PRODUCT,'
      '110179378=                   AMOUNT,'
      '110179379=                   PRICE,'
      '110179380=                   SUMM'
      '110179381=                   ,PRICE_CURRENCY'
      '110179382=                   ,SUMM_CURRENCY'
      '110179383=              FROM SKLAD_TMP'
      '110179384=             ORDER BY 1'
      '110179385=              INTO :SKLAD_TMP_,'
      '110179386=                   :RG_PRODUCT_,'
      '110179387=                   :RAMOUNT_,'
      '110179388=                   :RPRICE_,'
      '110179389=                   :RSUMM_'
      '110179390=                   ,:RPRICE_UE_'
      '110179391=                   ,:RSUMM_UE_'
      '110179392=        DO BEGIN'
      '110179393='
      '110179394=            UPDATE SKLAD SK'
      '110179395=               SET SK.IS_LAST = 0'
      '110179396=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110179397=               AND SK.IS_LAST = 1;'
      '110179398='
      '110179399=            INSERT INTO SKLAD'
      '110179400=            ('
      '110179401=             SKLAD,'
      '110179402=             SKLAD_PARENT,'
      '110179403=             DATE_RECEIPT,'
      '110179404=             G_CLIENT,'
      '110179405=             G_PRODUCT,'
      '110179406=             AMOUNT,'
      '110179407=             PRICE,'
      '110179408=             SUMM,'
      '110179409=             G_PAYMENT_TYPE,'
      '110179410=             OSNOVANIE,'
      '110179411=             NOTE,'
      '110179412=             NDS,'
      '110179413=             NDS_SUMM,'
      '110179414=             IS_LAST,'
      '110179415=             IS_VOZVRAT,'
      '110179416=             G_TOCHKA'
      '110179417=             ,PRICE_CURRENCY'
      '110179418=             ,SUMM_CURRENCY'
      '110179419=            ) VALUES ('
      '110179420=             :SKLAD_TMP_,'
      '110179421=             :SKLAD_PARENT_,'
      '110179422=             CURRENT_DATE,'
      '110179423=             :G_CLIENT_,'
      '110179424=             :RG_PRODUCT_,'
      '110179425=             :RAMOUNT_,'
      '110179426=             :RPRICE_,'
      '110179427=             :RSUMM_,'
      '110179428=             1,       --:G_PAYMENT_TYPE_,'
      '110179429=             NULL,    --:OSNOVANIE_,'
      '110179430=             NULL,    --:NOTE_,'
      '110179431=             0,       --:RNDS_,'
      '110179432=             0,       --:RNDS_SUMM_,'
      '110179433=             1,       --IS_LAST_'
      '110179434=             0,        --:IS_VOZVRAT_'
      '110179435=             :G_TOCHKA_'
      '110179436=             ,:RPRICE_UE_'
      '110179437=             ,:RSUMM_UE_'
      '110179438=            );'
      '110179439='
      
        '110179440=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110179441=            PNT_ = '#39'06'#39';'
      '110179442=            UPDATE LT_SKLAD_PRODUCT L'
      '110179443=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110179444=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110179445=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110179446='
      '110179447=            PNT_ = '#39'06a'#39';'
      '110179448=            IF (ROW_COUNT = 0) THEN'
      
        '110179449=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110179450=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110179451=        END'
      '110179452='
      '110179453=        PNT_ = '#39'07'#39';'
      
        '110179454=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110179455=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110179456=                                :SUMM_,'
      '110179457=                                CURRENT_DATE,'
      
        '110179458=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110179459=                                NULL,   --ZAKAZ_'
      '110179460=                                :SKLAD_PARENT_,'
      '110179461=                                1,'
      
        '110179462=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110179463=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110179464=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110179465=          EXIT;'
      '110179466=        END'
      '110179467='
      '110179468=        DELETE FROM SKLAD_TMP;'
      '110179469=      END'
      '110179470=    END'
      '110179471='
      
        '110179472=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110179473=    if (ERR_MSG_ IS NOT NULL) then'
      '110179474=      ERR_MSG = ERR_MSG_;'
      '110179475='
      '110179476=WHEN ANY DO BEGIN'
      '110179477=    IF (GDSCODE = 335544652) THEN BEGIN'
      '110179478=        Err_code = GDSCODE;'
      
        '110179479=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1042#1099' '#1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1080#1084 +
        #1087#1086#1088#1090#1080#1088#1086#1074#1072#1090#1100' '#1090#1086#1074#1072#1088#1099' '#1089' '#1086#1076#1080#1085#1072#1082#1086#1074#1099#1084' '#1079#1085#1072#1095#1077#1085#1080#1077#1084'!'#39';'
      '110179480=        IF (PNT_ = '#39'02'#39') THEN'
      
        '110179481=            ERR_MSG = ERR_MSG || '#39' '#1040#1088#1090#1080#1082#1091#1083' '#39' || ARTICU' +
        'L_ || '#39'.'#39';'
      '110179482=        ELSE'
      
        '110179483=            ERR_MSG = ERR_MSG || '#39' '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110179484=    END ELSE BEGIN'
      '110179485=        Err_code = gdscode;'
      
        '110179486=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode|' +
        '|'#39' --> PNT_ '#39'||PNT_;'
      '110179487=    END'
      '110179488=  END'
      '110179489=END'
      '110179490=;'
      '110179491='
      '110179492=ALTER PROCEDURE P_REP_PRIHOD('
      '110179493=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110179494=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110179495=  DATE_BEGIN_ DATE,'
      '110179496=  DATE_END_ DATE,'
      '110179497=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110179498=RETURNS ('
      '110179499=  PERIOD_ VARCHAR(40),'
      
        '110179500=  P_REP_PRIHOD_TABLE TYPE OF COLUMN P_REP_PRIHOD_TABLE' +
        '.P_REP_PRIHOD_TABLE,'
      
        '110179501=  TOVAR_NAME TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR_N' +
        'AME,'
      '110179502=  AMOUNT TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT,'
      
        '110179503=  POSTAVSHIK TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTAVS' +
        'HIK,'
      
        '110179504=  SELF_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_PR' +
        'ICE,'
      
        '110179505=  SELF_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_SUM' +
        'M,'
      
        '110179506=  SELF_PRICE_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'PRICE_B,'
      
        '110179507=  SELF_SUMM_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_S' +
        'UMM_B,'
      
        '110179508=  SALE_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_PR' +
        'ICE,'
      
        '110179509=  SALE_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_SUM' +
        'M,'
      '110179510=  IS_HEAD TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD,'
      '110179511=  ERR_CODE INTEGER,'
      '110179512=  ERR_MSG VARCHAR(1024))'
      '110179513=AS'
      '110179514=/*'
      '110179515='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110179516='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050 +
        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110179517='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110179518='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110179519='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110179520='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110179521='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110179522=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110179523=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110179524=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110179525='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110179526='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110179527=*/'
      
        '110179528=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD'#39 +
        ';'
      '110179529=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110179530=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN P_REP_PRIH' +
        'OD_TABLE.SALE_PRICE = 0;'
      
        '110179531=DECLARE VARIABLE SUM_SALE_PRICE_ TYPE OF COLUMN P_REP_' +
        'PRIHOD_TABLE.SALE_PRICE = 0;'
      
        '110179532=DECLARE VARIABLE SUM_SALE_PRICE_ALL_ TYPE OF COLUMN P_' +
        'REP_PRIHOD_TABLE.SALE_PRICE = 0;'
      '110179533=DECLARE VARIABLE SUM_NAL_ NUMERIC(15,2) = 0;'
      '110179534=DECLARE VARIABLE SUM_BEZNAL_ NUMERIC(15,2) = 0;'
      '110179535=DECLARE VARIABLE AMOUNT_CATEGORY_ MY_NUMERIC_5 = 0;'
      '110179536=DECLARE VARIABLE SUM_NAL_CATEGORY_ NUMERIC(15,2) = 0;'
      
        '110179537=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ NUMERIC(15,2) = ' +
        '0;'
      '110179538=DECLARE VARIABLE SUM_FACT_NAL_ALL_ NUMERIC(15,2) = 0;'
      
        '110179539=DECLARE VARIABLE SUM_FACT_BEZNAL_ALL_ NUMERIC(15,2) = ' +
        '0;'
      '110179540=DECLARE VARIABLE SUM_FACT_NAL_ NUMERIC(15,2) = 0;'
      '110179541=DECLARE VARIABLE SUM_FACT_BEZNAL_ NUMERIC(15,2) = 0;'
      '110179542=DECLARE VARIABLE PRICE_NAL_ NUMERIC(15,2) = 0;'
      '110179543=DECLARE VARIABLE PRICE_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '110179544=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110179545=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      '110179546=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110179547=DECLARE VARIABLE AMOUNT_CATEGORY_ALL_ MY_NUMERIC_5 = 0' +
        ';'
      
        '110179548=DECLARE VARIABLE SUM_NAL_CATEGORY_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '110179549=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ALL_ NUMERIC(15,2' +
        ') = 0;'
      
        '110179550=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110179551=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      '110179552=DECLARE VARIABLE I INTEGER = 1;'
      '110179553=DECLARE VARIABLE K INTEGER = 1;'
      '110179554=BEGIN'
      
        '110179555=  DELETE FROM P_REP_PRIHOD_TABLE WHERE P_REP_PRIHOD_TA' +
        'BLE = P_REP_PRIHOD_TABLE;'
      '110179556='
      '110179557=  DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '110179558=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110179559='
      
        '110179560=  FOR SELECT DECODE(GP.g_product, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', GP' +
        '.NAME),'
      '110179561=             GP.G_PRODUCT'
      '110179562=       FROM G_PRODUCT GP'
      '110179563=      WHERE GP.IS_CATEGORY = 1'
      
        '110179564=        AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110179565=             OR'
      '110179566=             (:G_CATEGORY_ IS NULL)'
      '110179567=            )'
      '110179568=        AND EXISTS (SELECT 1'
      
        '110179569=                      FROM SKLAD_PARENT Z, SKLAD ZD, G' +
        '_PRODUCT G'
      
        '110179570=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110179571=                       AND Z.SKLAD =  ZD.SKLAD_PARENT'
      '110179572=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110179573=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110179574=                       AND Z.IS_VOZVRAT = 0'
      '110179575=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110179576=                       AND Z.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      
        '110179577=                       AND ((:G_PRODUCT_ CONTAINING '#39'~' +
        #39'||ZD.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110179578=                             OR'
      '110179579=                             (:G_PRODUCT_ IS NULL)'
      '110179580=                           )'
      '110179581=                   )'
      '110179582=      ORDER BY 1'
      '110179583=  INTO :RECCAT_NAME_,'
      '110179584=       :RECCAT_PRODUCT_'
      '110179585=  DO BEGIN'
      '110179586=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110179587=    insert into P_REP_PRIHOD_TABLE'
      '110179588=      (P_REP_PRIHOD_TABLE, tovar_name, IS_HEAD)'
      '110179589=    values'
      '110179590=      (:I, :RECCAT_NAME_, 1);'
      '110179591='
      '110179592=    I = I + 1;'
      '110179593='
      '110179594=    FOR SELECT G.NAME,'
      '110179595=               G.PRICE,'
      '110179596=               SD.AMOUNT,'
      '110179597=               C.NAME CLIENT_NAME,'
      
        '110179598=               DECODE(S.G_PAYMENT_TYPE, 1, SD.PRICE, 0' +
        ') PRICE_NAL,'
      
        '110179599=               DECODE(S.G_PAYMENT_TYPE, 1, SD.SUMM, 0)' +
        ' SUMM_NAL,'
      
        '110179600=               DECODE(S.G_PAYMENT_TYPE, 2, SD.PRICE, 0' +
        ') PRICE_BEZNAL,'
      
        '110179601=               DECODE(S.G_PAYMENT_TYPE, 2, SD.SUMM, 0)' +
        ' SUMM_BEZNAL'
      
        '110179602=               --DECODE(S.G_PAYMENT_TYPE, 1, S.SUMM_FA' +
        'CT, 0) SUMM_FACT_NAL,'
      
        '110179603=               --,DECODE(S.G_PAYMENT_TYPE, 2, S.SUMM_F' +
        'ACT, 0) SUMM_FACT_BEZNAL'
      
        '110179604=          FROM SKLAD_PARENT S LEFT OUTER JOIN G_CLIENT' +
        ' C ON S.G_CLIENT = C.G_CLIENT,'
      '110179605=               SKLAD SD,'
      '110179606=               G_PRODUCT G'
      
        '110179607=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110179608=           AND S.SKLAD = SD.SKLAD_PARENT'
      '110179609=           AND SD.G_PRODUCT = G.G_PRODUCT'
      
        '110179610=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '110179611=           AND S.IS_VOZVRAT = 0'
      '110179612=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110179613=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110179614=           AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.G_PROD' +
        'UCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110179615=                 OR'
      '110179616=                 (:G_PRODUCT_ IS NULL)'
      '110179617=               )'
      
        '110179618=        ORDER BY G.G_PRODUCT_PAR, S.DATE_RECEIPT, S.SK' +
        'LAD, SD.SKLAD, G.NAME'
      '110179619=    INTO :TOVAR_NAME_,'
      '110179620=         :SALE_PRICE_,'
      '110179621=         :AMOUNT_,'
      '110179622=         :CLIENT_NAME_,'
      '110179623=         :PRICE_NAL_,'
      '110179624=         :SUM_NAL_,'
      '110179625=         :PRICE_BEZNAL_,'
      '110179626=         :SUM_BEZNAL_'
      '110179627=         --,:SUM_FACT_NAL_,'
      '110179628=         --,:SUM_FACT_BEZNAL_'
      '110179629=    DO BEGIN'
      
        '110179630=      INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TAB' +
        'LE, TOVAR_NAME, SALE_PRICE, SALE_SUMM, AMOUNT, POSTAVSHIK, SELF_' +
        'PRICE, SELF_SUMM, SELF_PRICE_B,'
      
        '110179631=                                      SELF_SUMM_B, IS_' +
        'HEAD)'
      
        '110179632=      VALUES (:I, :TOVAR_NAME_, :SALE_PRICE_, :SALE_PR' +
        'ICE_ * :AMOUNT_, :AMOUNT_, :CLIENT_NAME_, :PRICE_NAL_, :SUM_NAL_' +
        ', :PRICE_BEZNAL_, :SUM_BEZNAL_, 0);'
      '110179633='
      '110179634=      I = I +1;'
      '110179635='
      
        '110179636=      AMOUNT_CATEGORY_ = AMOUNT_CATEGORY_ + COALESCE(A' +
        'MOUNT_, 0);'
      
        '110179637=      SUM_NAL_CATEGORY_ = SUM_NAL_CATEGORY_ + COALESCE' +
        '(SUM_NAL_, 0);'
      
        '110179638=      SUM_BEZNAL_CATEGORY_ = SUM_BEZNAL_CATEGORY_ + CO' +
        'ALESCE(SUM_BEZNAL_, 0);'
      
        '110179639=      SUM_SALE_PRICE_ = SUM_SALE_PRICE_ + SALE_PRICE_ ' +
        '* AMOUNT_;'
      '110179640='
      '110179641=      /*IF (K = 1) THEN BEGIN'
      
        '110179642=          SUM_FACT_NAL_ALL_ = SUM_FACT_NAL_ALL_ + SUM_' +
        'FACT_NAL_;'
      
        '110179643=          SUM_FACT_BEZNAL_ALL_ = SUM_FACT_BEZNAL_ALL_ ' +
        '+ SUM_FACT_BEZNAL_;'
      '110179644='
      '110179645=          K = 2;'
      '110179646=      END*/'
      '110179647=    END'
      '110179648='
      '110179649=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110179650=    INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE' +
        ', TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD' +
        ')'
      
        '110179651=    VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :SUM_SALE_PRICE_' +
        ', :AMOUNT_CATEGORY_, :SUM_NAL_CATEGORY_, :SUM_BEZNAL_CATEGORY_, ' +
        '2);'
      '110179652='
      '110179653='
      
        '110179654=    AMOUNT_CATEGORY_ALL_ = AMOUNT_CATEGORY_ALL_ + AMOU' +
        'NT_CATEGORY_;'
      
        '110179655=    SUM_NAL_CATEGORY_ALL_ = SUM_NAL_CATEGORY_ALL_ + SU' +
        'M_NAL_CATEGORY_;'
      
        '110179656=    SUM_BEZNAL_CATEGORY_ALL_ = SUM_BEZNAL_CATEGORY_ALL' +
        '_ + SUM_BEZNAL_CATEGORY_;'
      
        '110179657=    SUM_SALE_PRICE_ALL_ = SUM_SALE_PRICE_ALL_ + SUM_SA' +
        'LE_PRICE_;'
      '110179658='
      '110179659=    AMOUNT_CATEGORY_ = 0;'
      '110179660=    SUM_NAL_CATEGORY_ = 0;'
      '110179661=    SUM_BEZNAL_CATEGORY_  = 0;'
      '110179662=    SUM_SALE_PRICE_ = 0;'
      '110179663='
      '110179664=    I = I + 1;'
      '110179665=    K = 1;'
      '110179666=  END'
      '110179667='
      '110179668=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '110179669=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110179670=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUM_SALE_PRICE_ALL_, :AMOUNT_C' +
        'ATEGORY_ALL_, :SUM_NAL_CATEGORY_ALL_, :SUM_BEZNAL_CATEGORY_ALL_,' +
        ' 3);'
      '110179671='
      '110179672=  I = I + 1;'
      '110179673='
      '110179674=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1059#1055#1051#1040#1063#1045#1053#1054
      '110179675=  SELECT COALESCE(SUM(K.SUMM), 0)'
      '110179676=  FROM KASSA K,'
      '110179677=       SKLAD_PARENT S'
      '110179678= WHERE K.SKLAD = S.SKLAD'
      '110179679=   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      '110179680=   AND S.IS_VOZVRAT = 0'
      
        '110179681=   AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110179682=   AND EXISTS (SELECT 1'
      '110179683=                 FROM SKLAD SD'
      '110179684=                WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '110179685=                 AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||SD' +
        '.G_PRODUCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110179686=                       OR'
      '110179687=                       (:G_CATEGORY_ IS NULL)'
      '110179688=                     )'
      
        '110179689=                 AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.' +
        'G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110179690=                       OR'
      '110179691=                       (:G_PRODUCT_ IS NULL)'
      '110179692=                     )'
      '110179693=              )'
      '110179694=    INTO :SUM_FACT_NAL_ALL_;'
      '110179695='
      '110179696=  SELECT COALESCE(SUM(K.SUMM), 0)'
      '110179697=  FROM KASSA_BEZNAL K,'
      '110179698=       SKLAD_PARENT S'
      '110179699= WHERE K.SKLAD = S.SKLAD'
      '110179700=   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      '110179701=   AND S.IS_VOZVRAT = 0'
      
        '110179702=   AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110179703=   AND EXISTS (SELECT 1'
      '110179704=                 FROM SKLAD SD'
      '110179705=                WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '110179706=                 AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||SD' +
        '.G_PRODUCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110179707=                       OR'
      '110179708=                       (:G_CATEGORY_ IS NULL)'
      '110179709=                     )'
      
        '110179710=                 AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.' +
        'G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110179711=                       OR'
      '110179712=                       (:G_PRODUCT_ IS NULL)'
      '110179713=                     )'
      '110179714=              )'
      '110179715=    INTO :SUM_FACT_BEZNAL_ALL_;'
      '110179716='
      
        '110179717=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110179718=  VALUES (:I, '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077#1085#1086#39', :SUM_FACT_NAL_ALL_, ' +
        ':SUM_FACT_BEZNAL_ALL_, 1);'
      '110179719='
      
        '110179720=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110179721=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110179722='
      
        '110179723=  FOR SELECT P_REP_PRIHOD_TABLE, TOVAR_NAME, SALE_PRIC' +
        'E, SALE_SUMM, AMOUNT, POSTAVSHIK, SELF_PRICE, SELF_SUMM, SELF_PR' +
        'ICE_B, SELF_SUMM_B,'
      '110179724=             IS_HEAD'
      '110179725=      FROM P_REP_PRIHOD_TABLE'
      
        '110179726=      INTO :P_REP_PRIHOD_TABLE, :TOVAR_NAME, :SALE_PRI' +
        'CE, :SALE_SUMM, :AMOUNT, :POSTAVSHIK, :SELF_PRICE, :SELF_SUMM, :' +
        'SELF_PRICE_B, :SELF_SUMM_B, :IS_HEAD'
      '110179727=  DO'
      '110179728=    suspend;'
      '110179729='
      '110179730=WHEN ANY DO BEGIN'
      '110179731=    Err_code = -20500;'
      
        '110179732=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110179733=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110179734=  END'
      '110179735=end'
      '110179736=;'
      '110179737='
      '110179738='
      
        '110179739=UPDATE SYSTEM_SETUP SET S_VALUE = 110179 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110179740=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110179741=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101800='
      '1101801=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST('
      '1101802=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      
        '1101803=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ IN' +
        'TEGER)'
      '1101804=RETURNS ('
      '1101805=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ */ BIGINT,'
      
        '1101806=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS */ BIGINT,'
      
        '1101807=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT */' +
        ' BIGINT,'
      
        '1101808=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUMER' +
        'IC(18,5),'
      
        '1101809=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERIC' +
        '(15,2),'
      
        '11018010=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11018011=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_PERC */ NUMERIC(15,2),'
      
        '11018012=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOU' +
        'NT_TENGE */ NUMERIC(15,2),'
      
        '11018013=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11018014=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11018015=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11018016=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11018017=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      '11018018=  ED_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50),'
      
        '11018019=  OSTATOK_SKLAD /* TYPE OF COLUMN SKLAD.AMOUNT */ NUMER' +
        'IC(18,5))'
      '11018020=AS'
      '11018021=BEGIN'
      '11018022=  SUSPEND;'
      '11018023=END'
      '11018024=;'
      '11018025='
      '11018026='
      
        '11018027=/******************************************************' +
        '************************/'
      
        '11018028=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11018029=/******************************************************' +
        '************************/'
      '11018030=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST('
      '11018031=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11018032=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE)'
      '11018033=RETURNS ('
      '11018034=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '11018035=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DETA' +
        'ILS,'
      '11018036=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '11018037=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11018038=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11018039=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '11018040=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_P' +
        'ERC,'
      
        '11018041=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'TENGE,'
      
        '11018042=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_S' +
        'UMM,'
      '11018043=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11018044=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11018045=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11018046=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11018047=  ED_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11018048=  OSTATOK_SKLAD TYPE OF COLUMN SKLAD.AMOUNT)'
      '11018049=AS'
      '11018050=begin'
      '11018051='
      '11018052=  FOR'
      '11018053=    SELECT D.ZAKAZ,'
      '11018054=           D.ZAKAZ_DETAILS,'
      '11018055=           D.G_PRODUCT,'
      '11018056=           D.AMOUNT,'
      '11018057=           D.PRICE,'
      '11018058=           D.SUMM,'
      '11018059=           D.DISCOUNT_PERC,'
      '11018060=           D.DISCOUNT_TENGE,'
      '11018061=           D.DISCOUNT_SUMM,'
      '11018062=           G.ARTICUL,'
      '11018063=           G.NOMENCLATUR_NUM,'
      '11018064=           G.BARCODE,'
      '11018065=           G.NAME,'
      '11018066=           COALESCE(GU.SHORT_NAME, GU.NAME),'
      '11018067=           LT.AMOUNT OSTATOK_SKLAD'
      '11018068=      FROM ZAKAZ_DETAILS D,'
      '11018069=           G_PRODUCT G,'
      '11018070=           G_UNIT GU,'
      '11018071=           LT_SKLAD_PRODUCT LT'
      '11018072=     WHERE D.ZAKAZ = :ZAKAZ_'
      '11018073=       AND D.G_PRODUCT = G.G_PRODUCT'
      '11018074=       AND LT.G_PRODUCT = G.G_PRODUCT'
      
        '11018075=       AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHE' +
        'RE CUR_PARAMS = 2)'
      '11018076=       AND G.G_UNIT = GU.G_UNIT'
      '11018077=       AND :IS_SPISANIE_ <> 3'
      '11018078=    UNION ALL'
      '11018079=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '11018080=           D.SKLAD ZAKAZ_DETAILS,'
      '11018081=           D.G_PRODUCT,'
      '11018082=           D.AMOUNT,'
      '11018083=           D.PRICE,'
      '11018084=           D.SUMM,'
      '11018085=           0 DISCOUNT_PERC,'
      '11018086=           0 DISCOUNT_TENGE,'
      '11018087=           0 DISCOUNT_SUMM,'
      '11018088=           G.ARTICUL,'
      '11018089=           G.NOMENCLATUR_NUM,'
      '11018090=           G.BARCODE,'
      '11018091=           G.NAME,'
      '11018092=           GU.NAME,'
      '11018093=           LT.AMOUNT OSTATOK_SKLAD'
      '11018094=      FROM SKLAD D,'
      '11018095=           G_PRODUCT G,'
      '11018096=           G_UNIT GU,'
      '11018097=           LT_SKLAD_PRODUCT LT'
      '11018098=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '11018099=       AND D.G_PRODUCT = G.G_PRODUCT'
      '110180100=       AND LT.G_PRODUCT = G.G_PRODUCT'
      
        '110180101=       AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '110180102=       AND G.G_UNIT = GU.G_UNIT'
      '110180103=       AND :IS_SPISANIE_ = 3'
      '110180104=    ORDER BY 1'
      '110180105=    INTO  :ZAKAZ,'
      '110180106=          :ZAKAZ_DETAILS,'
      '110180107=          :G_PRODUCT,'
      '110180108=          :AMOUNT,'
      '110180109=          :PRICE,'
      '110180110=          :SUMM,'
      '110180111=          :DISCOUNT_PERC,'
      '110180112=          :DISCOUNT_TENGE,'
      '110180113=          :DISCOUNT_SUMM,'
      '110180114=          :ARTICUL,'
      '110180115=          :NOMENCLATUR_NUM,'
      '110180116=          :BARCODE,'
      '110180117=          :PRODUCT_NAME,'
      '110180118=          :ED_NAME,'
      '110180119=          :OSTATOK_SKLAD'
      '110180120=  DO'
      '110180121=    suspend;'
      '110180122=end'
      '110180123=;'
      '110180124='
      '110180125='
      
        '110180126=UPDATE SYSTEM_SETUP SET S_VALUE = 110180 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110180127=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110180128=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101810='
      '1101811=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1101812=RETURNS ('
      
        '1101813=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS */ BIGINT,'
      
        '1101814=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ BIG' +
        'INT,'
      
        '1101815=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T */ BIGINT,'
      
        '1101816=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ N' +
        'UMERIC(18,5),'
      
        '1101817=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NUM' +
        'ERIC(15,2),'
      
        '1101818=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUMER' +
        'IC(15,2),'
      
        '1101819=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC */ NUMERIC(15,2),'
      
        '11018110=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE */ NUMERIC(15,2),'
      
        '11018111=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_SUMM */ NUMERIC(15,2),'
      
        '11018112=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMERI' +
        'C(15,2),'
      
        '11018113=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM' +
        ' */ NUMERIC(15,2),'
      
        '11018114=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '11018115=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11018116=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11018117=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11018118=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_P' +
        'RICE */ NUMERIC(15,2),'
      '11018119=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER,'
      '11018120=  IS_MARKED INTEGER,'
      
        '11018121=  MARK_CODE /* TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE *' +
        '/ VARCHAR(100),'
      
        '11018122=  SUM_TO_CHARGE_BONUS /* TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.SUMM */ NUMERIC(15,2),'
      
        '11018123=  ORIGINAL_KIT_ID /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.O' +
        'RIGINAL_KIT_ID */ BIGINT,'
      
        '11018124=  ORIGINAL_KIT_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TM' +
        'P.ORIGINAL_KIT_PRICE */ NUMERIC(15,2),'
      
        '11018125=  BRAND /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(15' +
        '0))'
      '11018126=AS'
      '11018127=BEGIN'
      '11018128=  SUSPEND;'
      '11018129=END'
      '11018130=;'
      '11018131='
      '11018132='
      
        '11018133=/******************************************************' +
        '************************/'
      
        '11018134=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11018135=/******************************************************' +
        '************************/'
      '11018136=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '11018137=RETURNS ('
      
        '11018138=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ_' +
        'DETAILS,'
      '11018139=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      '11018140=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT,'
      '11018141=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11018142=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11018143=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '11018144=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_PERC,'
      
        '11018145=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_TENGE,'
      
        '11018146=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_SUMM,'
      '11018147=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '11018148=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '11018149=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11018150=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11018151=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11018152=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '11018153=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PRIC' +
        'E,'
      '11018154=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11018155=  IS_MARKED INTEGER,'
      '11018156=  MARK_CODE TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE,'
      
        '11018157=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.' +
        'SUMM,'
      
        '11018158=  ORIGINAL_KIT_ID TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ORIG' +
        'INAL_KIT_ID,'
      
        '11018159=  ORIGINAL_KIT_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.O' +
        'RIGINAL_KIT_PRICE,'
      '11018160=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND)'
      '11018161=AS'
      '11018162=begin'
      '11018163='
      '11018164=  FOR'
      '11018165=    SELECT T.ZAKAZ_DETAILS,'
      '11018166=           T.ZAKAZ,'
      '11018167=           T.G_PRODUCT,'
      '11018168=           T.AMOUNT,'
      '11018169=           T.PRICE,'
      '11018170=           T.SUMM,'
      '11018171=           T.DISCOUNT_PERC,'
      '11018172=           T.DISCOUNT_TENGE,'
      '11018173=           T.DISCOUNT_SUMM,'
      '11018174=           T.NDS,'
      '11018175=           T.NDS_SUMM,'
      '11018176=           P.NAME PRODUCT_NAME'
      '11018177=           ,P.BARCODE'
      '11018178=           ,P.ARTICUL'
      '11018179=           ,P.PRICE'
      '11018180=           ,P.IS_KIT'
      
        '11018181=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_TMP' +
        ' TM, G_PRODUCT GP'
      
        '11018182=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.DO_' +
        'NOT_CHARGE_BONUS = 0)'
      '11018183=           ,T.COST_PRICE'
      '11018184=           ,P.IS_MARKED'
      '11018185=           ,T.MARK_CODE'
      '11018186=           ,T.ORIGINAL_KIT_ID'
      '11018187=           ,T.ORIGINAL_KIT_PRICE'
      '11018188=           ,P.BRAND'
      '11018189=      FROM ZAKAZ_DETAILS_TMP T,'
      '11018190=           G_PRODUCT P'
      '11018191=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11018192=    ORDER BY t.ZAKAZ_DETAILS'
      '11018193=    INTO :ZAKAZ_DETAILS,'
      '11018194=          :ZAKAZ,'
      '11018195=          :G_PRODUCT,'
      '11018196=          :AMOUNT,'
      '11018197=          :PRICE,'
      '11018198=          :SUMM,'
      '11018199=          :DISCOUNT_PERC,'
      '110181100=          :DISCOUNT_TENGE,'
      '110181101=          :DISCOUNT_SUMM,'
      '110181102=          :NDS,'
      '110181103=          :NDS_SUMM,'
      '110181104=          :PRODUCT_NAME'
      '110181105=          ,:BARCODE'
      '110181106=          ,:ARTICUL'
      '110181107=          ,:PRODUCT_PRICE'
      '110181108=          ,:IS_KIT'
