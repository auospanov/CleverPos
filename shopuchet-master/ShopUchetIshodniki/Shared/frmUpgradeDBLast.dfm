        '110411326=      -- '#1055#1054#1057#1051#1045' '#1054#1050#1054#1053#1063#1040#1053#1048#1071' '#1055#1056#1054#1061#1054#1044#1040' '#1055#1054' '#1042#1057#1045#1052' '#1047#1040#1055#1048#1057#1071#1052' '#1053#1045#1054#1041#1061 +
        #1054#1044#1048#1052#1054' '#1055#1056#1054#1042#1045#1057#1058#1048' '#1042#1057#1058#1040#1042#1050#1059' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110411327=      IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
