        '110152117=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ ' +
        'BIGINT,'
      
        '110152118=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT' +
        '_PAR */ BIGINT,'
      '110152119=  ARTICUL_ VARCHAR(30),'
      '110152120=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110152121=  BARCODE_ VARCHAR(30),'
      '110152122=  NAME_ VARCHAR(500),'
      '110152123=  G_UNIT_ /* TYPE OF COLUMN G_UNIT.G_UNIT */ BIGINT,'
      '110152124=  PRICE_ NUMERIC(15,2),'
      '110152125=  VOLUME_PRICE_ NUMERIC(15,2),'
      
        '110152126=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT' +
        ' */ NUMERIC(15,2),'
      
        '110152127=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY *' +
        '/ VARCHAR(150),'
      
        '110152128=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(30' +
        '0),'
      
        '110152129=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ ' +
        'BLOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '110152130=  IS_KIT_ /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGE' +
        'R,'
      '110152131=  IS_CATEGORY_ INTEGER,'
      
        '110152132=  MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT *' +
        '/ NUMERIC(15,2),'
      
        '110152133=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(' +
        '250),'
      
        '110152134=  SALES_COMM_ /* TYPE OF COLUMN G_PRODUCT.SALES_COMM *' +
        '/ NUMERIC(15,2),'
      
