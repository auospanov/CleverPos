      '110170101='
      
        '110170102=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN BARCOD' +
        'E'
      '110170103=  TYPE VR_DOC_OSNOVANIE;'
      '110170104='
      '110170105='
      
        '110170106=/*****************************************************' +
