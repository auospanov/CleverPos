      '110237165=              INTO :G_TOCHKA_;'
      '110237166='
      '110237167=            IF (WHAT_PRICE_ = 0) THEN BEGIN'
      
        '110237168=              SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND((' +
