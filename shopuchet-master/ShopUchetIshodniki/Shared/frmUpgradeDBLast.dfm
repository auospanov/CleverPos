      '110243139=  SPISANO_TOVAROV_NAME_CNT_ INTEGER,'
      
        '110243140=  PRIHOD_TOVAROV_CNT_ /* TYPE OF COLUMN REVISION.AMOUN' +
        'T_BD */ NUMERIC(18,5),'
