      '110212300=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110212301=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110212302=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110212303=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110212304=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110212305=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110212306=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110212307=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0,'
      '110212308=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110212309=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110212310=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '110212311=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110212312=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL)'
      '110212313=RETURNS ('
      '110212314=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110212315=  ERR_CODE INTEGER,'
      '110212316=  ERR_MSG VARCHAR(1024))'
      '110212317=AS'
      '110212318=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110212319=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110212320=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110212321=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110212322=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110212323=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110212324=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110212325=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110212326=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110212327=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110212328=--'
      
        '110212329=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110212330=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110212331='
      
        '110212332=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056 +
        #1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110212333=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110212334=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110212335=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110212336=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110212337=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110212338=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110212339=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110212340=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110212341=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110212342=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110212343=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110212344=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110212345=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110212346=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110212347=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110212348=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110212349=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110212350=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110212351=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110212352=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110212353=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110212354=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110212355=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      
        '110212356=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK_' +
        'CODE;'
      
        '110212357=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COST' +
        '_PRICE;'
      '110212358=BEGIN'
      '110212359='
      '110212360=  PNT_ = '#39'00'#39';'
      '110212361=  IS_THIS_LAST_ = 0;'
      '110212362='
      '110212363=  IF (G_TOCHKA_ IS NULL) THEN'
      '110212364=    SELECT ID'
      '110212365=      FROM CUR_PARAMS'
      '110212366=     WHERE CUR_PARAMS = 2'
      '110212367=      INTO :G_TOCHKA_;'
      '110212368='
      '110212369=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110212370=  IF (G_OFFICIAL_ IS NULL) THEN'
      '110212371=      SELECT ID'
      '110212372=        FROM CUR_PARAMS'
      '110212373=       WHERE CUR_PARAMS = 1'
      '110212374=        INTO :G_OFFICIAL_;'
      '110212375='
      '110212376=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110212377=                            DATE_RECEIPT,'
      '110212378=                            TIME_RECEIPT,'
      '110212379=                            G_CLIENT,'
      '110212380=                            G_PAYMENT_TYPE,'
      '110212381=                            OSNOVANIE,'
      '110212382=                            NOTE,'
      '110212383=                            SUMM,'
      '110212384=                            SUMM_FACT,'
      '110212385=                            SUMM_CURRENCY,'
      '110212386=                            IS_PAYED_ALL,'
      '110212387=                            IS_VOZVRAT,'
      '110212388=                            G_TOCHKA'
      '110212389=                            ,G_OFFICIAL'
      '110212390=                            ,IS_EXPECTED'
      '110212391=                            ,REC_ID)'
      '110212392=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110212393=          :DATE_RECEIPT_,'
      '110212394=          :TIME_RECEIPT_,'
      '110212395=          :G_CLIENT_,'
      '110212396=          :G_PAYMENT_TYPE_,'
      '110212397=          :OSNOVANIE_,'
      '110212398=          :NOTE_,'
      '110212399=          :SUMM_,'
      '110212400=          :SUMM_FACT_,'
      '110212401=          :SUMM_CURRENCY_,'
      
        '110212402=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE ' +
        '0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057 +
        #1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110212403=          :IS_VOZVRAT_,'
      '110212404=          :G_TOCHKA_'
      '110212405=          ,:G_OFFICIAL_'
      '110212406=          ,:IS_EXPECTED_'
      '110212407=          ,:REC_ID_)'
      '110212408=  RETURNING'
      '110212409=    SKLAD'
      '110212410=  INTO'
      '110212411=    :SKLAD_;'
      '110212412='
      '110212413=  PNT_ = '#39'01'#39';'
      '110212414=  FOR SELECT SKLAD,'
      '110212415=             T.G_PRODUCT,'
      '110212416=             AMOUNT,'
      '110212417=             T.PRICE,'
      '110212418=             SUMM,'
      '110212419=             NDS,'
      '110212420=             NDS_SUMM'
      '110212421=             ,PRICE_CURRENCY'
      '110212422=             ,SUMM_CURRENCY'
      '110212423=             ,PRICE_ROZN'
      '110212424=             ,GG.PRICE'
      '110212425=             ,T.MARK_CODE'
      '110212426=             ,T.COST_PRICE'
      '110212427=        FROM SKLAD_TMP T,'
      '110212428=             G_PRODUCT GG'
      '110212429=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110212430=      ORDER BY 1'
      '110212431=      INTO :SKLAD_TMP_,'
      '110212432=           :RG_PRODUCT_,'
      '110212433=           :RAMOUNT_,'
      '110212434=           :RPRICE_,'
      '110212435=           :RSUMM_,'
      '110212436=           :RNDS_,'
      '110212437=           :RNDS_SUMM_'
      '110212438=           ,:PRICE_CURRENCY_'
      '110212439=           ,:SUMM_CURRENCY_TMP_'
      '110212440=           ,:SALE_PRICE_'
      '110212441=           ,:SALE_PRICE_CUR_'
      '110212442=           ,:MARK_CODE_'
      '110212443=           ,:COST_PRICE_'
      '110212444=  DO BEGIN'
      '110212445=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110212446=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110212447=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110212448=      IS_THIS_LAST_ = 0;'
      '110212449=      SELECT MAX(SK.DATE_RECEIPT)'
      '110212450=        FROM SKLAD SK'
      '110212451=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110212452=         AND SK.IS_LAST = 1'
      '110212453=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110212454=        INTO :DATE_LAST_;'
      '110212455='
      
        '110212456=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110212457=        UPDATE SKLAD SK'
      '110212458=           SET SK.IS_LAST = 0'
      '110212459=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110212460=           AND SK.IS_LAST = 1'
      '110212461=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110212462='
      '110212463=        IS_THIS_LAST_ = 1;'
      '110212464=      END'
      '110212465=    END'
      '110212466='
      '110212467=    INSERT INTO SKLAD'
      '110212468=    ('
      '110212469=     SKLAD,'
      '110212470=     SKLAD_PARENT,'
      '110212471=     DATE_RECEIPT,'
      '110212472=     G_CLIENT,'
      '110212473=     G_PRODUCT,'
      '110212474=     AMOUNT,'
      '110212475=     PRICE,'
      '110212476=     SUMM,'
      '110212477=     G_PAYMENT_TYPE,'
      '110212478=     OSNOVANIE,'
      '110212479=     NOTE,'
      '110212480=     NDS,'
      '110212481=     NDS_SUMM,'
      '110212482=     IS_LAST,'
      '110212483=     IS_VOZVRAT,'
      '110212484=     G_TOCHKA'
      '110212485=     ,PRICE_CURRENCY'
      '110212486=     ,SUMM_CURRENCY'
      '110212487=     ,MARK_CODE'
      '110212488=     ,COST_PRICE'
      '110212489=    ) VALUES ('
      '110212490=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110212491=     :SKLAD_,'
      '110212492=     :DATE_RECEIPT_,'
      '110212493=     :G_CLIENT_,'
      '110212494=     :RG_PRODUCT_,'
      '110212495=     :RAMOUNT_,'
      '110212496=     :RPRICE_,'
      '110212497=     :RSUMM_,'
      '110212498=     :G_PAYMENT_TYPE_,'
      '110212499=     :OSNOVANIE_,'
      '110212500=     :NOTE_,'
      '110212501=     :RNDS_,'
      '110212502=     :RNDS_SUMM_,'
      
        '110212503=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110212504=     :IS_VOZVRAT_,'
      '110212505=     :G_TOCHKA_'
      '110212506=     ,:PRICE_CURRENCY_'
      '110212507=     ,:SUMM_CURRENCY_TMP_'
      '110212508=     ,:MARK_CODE_'
      '110212509=     ,:COST_PRICE_'
      '110212510=    );'
      '110212511='
      
        '110212512=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110212513=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110212514=        PNT_ = '#39'02'#39';'
      '110212515=        UPDATE LT_SKLAD_PRODUCT L'
      '110212516=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '110212517=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110212518=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110212519=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110212520='
      '110212521=        IF (ROW_COUNT = 0) THEN'
      
        '110212522=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110212523=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :RG' +
        '_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110212524=    END'
      '110212525='
      
        '110212526=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054 +
        #1044#1045
      '110212527=      UPDATE G_PRODUCT G'
      '110212528=         SET G.PRICE = :SALE_PRICE_'
      '110212529=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110212530=  END'
      '110212531=  ----------------------------------------'
      '110212532='
      
        '110212533=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110212534=  PNT_ = '#39'05'#39';'
      
        '110212535=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110212536=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110212537=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110212538=      ELSE'
      '110212539=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110212540='
      
        '110212541=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110212542=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110212543=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110212544=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110212545=                                        :SUMM_FACT_,'
      
        '110212546=                                        :DATE_RECEIPT_' +
        ','
      
        '110212547=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110212548=                                        NULL,   --ZAKA' +
        'Z_'
      '110212549=                                        :SKLAD_,'
      
        '110212550=                                        :G_PAYMENT_TYP' +
        'E_,'
      '110212551=                                        :G_TOCHKA_,'
      
        '110212552=                                        :UPLOAD_TO_EXT' +
        '_APP_'
      
        '110212553=                                        ) RETURNING_VA' +
        'LUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110212554=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110212555=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110212556=            EXIT;'
      '110212557=          END'
      '110212558=      END ELSE BEGIN'
      '110212559=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110212560=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110212561=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110212562=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110212563=            ELSE'
      
        '110212564=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110212565='
      '110212566=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110212567=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110212568='
      
        '110212569=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110212570='
      '110212571=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110212572=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110212573=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110212574=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110212575=                                              :PAYMENT' +
        '_DATE_,'
      
        '110212576=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110212577=                                              NULL,   ' +
        '--ZAKAZ_'
      '110212578=                                              :SKLAD_,'
      
        '110212579=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110212580=                                              :G_TOCHK' +
        'A_,'
      
        '110212581=                                              :UPLOAD_' +
        'TO_EXT_APP_'
      
        '110212582=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110212583=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110212584=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110212585=                  EXIT;'
      '110212586=                END'
      '110212587=            END'
      '110212588=          END'
      '110212589=      END'
      '110212590=  END'
      '110212591='
      '110212592=  DELETE FROM SKLAD_TMP;'
      '110212593='
      
        '110212594=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110212595=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110212596=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110212597=                                  G_PRIHOD_,'
      '110212598=                                  :SUMM_PRIHOD_,'
      '110212599=                                  :DATE_RECEIPT_,'
      
        '110212600=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110212601=                                  NULL,   --:ZAKAZ_,'
      '110212602=                                  :SKLAD_,'
      '110212603=                                  :G_PAYMENT_TYPE_,'
      '110212604=                                  :G_TOCHKA_,'
      '110212605=                                  :UPLOAD_TO_EXT_APP_'
      
        '110212606=                                  ) RETURNING_VALUES (' +
        ':KASSA_, :ERR_CODE, :ERR_MSG);'
      '110212607=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110212608=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110212609=      EXIT;'
      '110212610=    END'
      '110212611=  END'
      '110212612='
      
        '110212613=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO_' +
        'EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1043 +
        #1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '110212614=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, 1' +
        ', 2)) THEN'
      
        '110212615=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER, IS_LOADED_MOB)'
      '110212616=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '110212617=            2,'
      '110212618=            :SKLAD_,'
      '110212619=            1,'
      
        '110212620=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ' +
        'ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' ' +
        #1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '110212621=           );'
      '110212622='
      '110212623=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110212624=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_I' +
        'D_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '110212625=END'
      '110212626=;'
      '110212627='
      '110212628=ALTER PROCEDURE INS_SKLAD_TMP('
      '110212629=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110212630=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110212631=  PRICE_ NUMERIC(15,2),'
      '110212632=  SUMM_ NUMERIC(15,2),'
      '110212633=  NDS_ NUMERIC(15,2),'
      '110212634=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110212635=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110212636=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0,'
      
        '110212637=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC = 0,'
      '110212638=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0,'
      
        '110212639=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC = 0,'
      '110212640=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0,'
      
        '110212641=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE = 0,'
      '110212642=  MARK_CODE_ TYPE OF COLUMN SKLAD_TMP.MARK_CODE = '#39#39','
      
        '110212643=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT =' +
        ' 0)'
      '110212644=RETURNS ('
      '110212645=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110212646=  ERR_CODE INTEGER,'
      '110212647=  ERR_MSG VARCHAR(1024))'
      '110212648=AS'
      
        '110212649=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      
        '110212650=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ' = 0;'
      '110212651=BEGIN'
      '110212652='
      '110212653=  IF (CHAR_LENGTH(MARK_CODE_) = 0) THEN'
      '110212654=      SELECT T.SKLAD'
      '110212655=        FROM SKLAD_TMP T'
      '110212656=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110212657=         AND T.PRICE = :PRICE_'
      '110212658=        INTO :SKLAD_;'
      '110212659='
      '110212660=  IF (SKLAD_ IS NOT NULL) THEN'
      '110212661=    UPDATE SKLAD_TMP T'
      '110212662=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110212663=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110212664=     WHERE T.SKLAD = :SKLAD_;'
      '110212665='
      '110212666=  ELSE BEGIN'
      '110212667=      IF (PRICE_ = 0) THEN BEGIN'
      '110212668=        CHARGE_ROZN_PROC_ = 0;'
      '110212669=        CHARGE_OPT_PROC_ = 0;'
      '110212670=      END ELSE BEGIN'
      
        '110212671=        CHARGE_ROZN_PROC_ = ROUND((:PRICE_ROZN_ - :PRI' +
        'CE_) * 100 / :PRICE_, 2);'
      
        '110212672=        CHARGE_OPT_PROC_ = ROUND((:PRICE_OPT_ - :PRICE' +
        '_) * 100 / :PRICE_, 2);'
      '110212673=      END'
      '110212674='
      '110212675=      IF (IS_VOZVRAT_ = 1) THEN BEGIN'
      
        '110212676=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODU' +
        'CT_, NULL, 1)'
      '110212677=          RETURNING_VALUES :SELF_PRICE_;'
      '110212678=      END'
      '110212679='
      
        '110212680=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '110212681=                            CHARGE_ROZN_PROC,'
      '110212682=                            PRICE_ROZN,'
      '110212683=                            CHARGE_OPT_PROC,'
      
        '110212684=                            PRICE_OPT, CHANGE_SALE_PRI' +
        'CE, MARK_CODE, COST_PRICE)'
      
        '110212685=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110212686=        ,:PRICE_CURRENCY_'
      '110212687=        ,:SUMM_CURRENCY_'
      '110212688=        ,:CHARGE_ROZN_PROC_'
      '110212689=        ,:PRICE_ROZN_'
      '110212690=        ,:CHARGE_OPT_PROC_'
      '110212691=        ,:PRICE_OPT_'
      
        '110212692=        ,0        -- :CHANGE_SALE_PRICE_ '#1055#1054' '#1048#1044#1045#1045' '#1059#1046#1045' '#1053 +
        #1045' '#1053#1059#1046#1053#1054', '#1062#1045#1053#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1048' '#1058#1040#1050', '#1058#1045#1055#1045#1056#1068' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1042#1054#1054#1041#1065#1045' '#1053#1048#1063#1045#1043#1054' '#1053 +
        #1045' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071', '#1055#1054#1047#1046#1045' '#1053#1040#1044#1054' '#1059#1041#1056#1040#1058#1068' 15.10.2021'
      '110212693=        ,:MARK_CODE_'
      '110212694=        ,:SELF_PRICE_)'
      '110212695=      RETURNING SKLAD'
      '110212696=      INTO :SKLAD_;'
      '110212697=  END'
      '110212698=end'
      '110212699=;'
      '110212700='
      '110212701=ALTER PROCEDURE P_REP_PROFIT('
      '110212702=  DATE_BEGIN_ DATE,'
      '110212703=  DATE_END_ DATE,'
      '110212704=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110212705=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110212706=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110212707=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '110212708=RETURNS ('
      '110212709=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110212710=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110212711=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
      '110212712=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110212713=  SUMM_ALL_ NUMERIC(15,2),'
      '110212714=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110212715=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110212716=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110212717=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110212718=  PROFIT_ALL_ NUMERIC(15,2),'
      '110212719=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110212720=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      '110212721=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '110212722=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '110212723=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '110212724=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '110212725=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT' +
        '_NAME,'
      
        '110212726=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_P' +
        'AYMENT_TYPE,'
      
        '110212727=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYME' +
        'NT_NAME,'
      
        '110212728=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANI' +
        'E,'
      
        '110212729=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUC' +
        'T,'
      
        '110212730=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PR' +
        'ODUCT_PAR,'
      
        '110212731=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110212732=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110212733=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110212734=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110212735=  AMOUNT MY_NUMERIC_5,'
      '110212736=  PRICE NUMERIC(15,2),'
      '110212737=  SUMM NUMERIC(15,2),'
      '110212738=  DISCOUNT_PERC NUMERIC(15,2),'
      '110212739=  DISCOUNT_SUMM NUMERIC(15,2),'
      '110212740=  NDS NUMERIC(15,2),'
      '110212741=  NDS_SUMM NUMERIC(15,2),'
      '110212742=  PRICE_SELF NUMERIC(15,2),'
      '110212743=  SUM_SELF NUMERIC(15,2),'
      '110212744=  PROFIT NUMERIC(15,2),'
      '110212745=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110212746=  ERR_CODE INTEGER,'
      '110212747=  ERR_MSG VARCHAR(1024))'
      '110212748=AS'
      '110212749=/*'
      '110212750='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110212751='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050 +
        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110212752='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110212753='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110212754='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110212755='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110212756='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110212757=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110212758=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110212759=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110212760='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110212761='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110212762=*'
      '110212763=*/'
      
        '110212764=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39 +
        ';'
      '110212765=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110212766=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110212767=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110212768=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110212769=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110212770=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110212771=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '110212772=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '110212773=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '110212774=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '110212775=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110212776=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110212777=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110212778=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110212779=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110212780=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110212781=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110212782=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110212783=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110212784=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110212785=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110212786=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110212787=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110212788=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110212789=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110212790=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110212791=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110212792=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110212793=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110212794=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110212795=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110212796=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110212797=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110212798=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110212799=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110212800=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110212801=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110212802=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110212803=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110212804=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110212805=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110212806=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110212807=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110212808=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110212809=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110212810=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110212811=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110212812=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '110212813=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM_FACT;'
      
        '110212814=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN S' +
        'KLAD_PARENT.SUMM_FACT;'
      '110212815=BEGIN'
      
        '110212816=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110212817=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110212818='
      '110212819=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110212820=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110212821=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110212822='
      '110212823=  FOR SELECT GP.PATH,'
      '110212824=             GP.G_PRODUCT'
      '110212825=       FROM P_REP_TREE GP'
      '110212826=      WHERE EXISTS (SELECT 1'
      
        '110212827=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110212828=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110212829=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110212830=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110212831=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110212832=                       AND Z.IS_SPISANIE = 0'
      '110212833=                       AND Z.is_reserve = 0'
      '110212834=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110212835=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110212836=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110212837=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110212838=                       AND ((EXISTS (SELECT 1'
      
        '110212839=                                       FROM SKLAD S, G' +
        '_PRODUCT G'
      
        '110212840=                                      WHERE S.G_CLIENT' +
        ' = :G_SUPPLIER_'
      
        '110212841=                                        AND S.G_PRODUC' +
        'T = G.G_PRODUCT'
      
        '110212842=                                        AND G.G_PRODUC' +
        'T_PAR = GP.G_PRODUCT'
      
        '110212843=                                        AND :G_TOCHKA_' +
        'ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_,' +
        ' 0) <> 0)'
      '110212844=                              OR'
      
        '110212845=                              COALESCE(:G_SUPPLIER_, 0' +
        ') = 0)'
      '110212846=                       )'
      '110212847=      ORDER BY 1, 2'
      '110212848=  INTO :RECCAT_NAME_,'
      '110212849=       :RECCAT_PRODUCT_'
      '110212850=  DO BEGIN'
      '110212851=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110212852=    insert into p_rep_profit_table'
      '110212853=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110212854=    values'
      
        '110212855=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110212856='
      '110212857=    FOR SELECT Z.ZAKAZ,'
      '110212858=               Z.G_TOCHKA,'
      '110212859=               Z.Z_DATE,'
      '110212860=               Z.G_CLIENT,'
      '110212861=               C.NAME CLIENT_NAME,'
      '110212862=               Z.G_PAYMENT_TYPE,'
      '110212863=               P.NAME PAYMENT_NAME,'
      '110212864=               Z.OSNOVANIE,'
      '110212865=               G.G_PRODUCT,'
      '110212866=               G.G_PRODUCT_PAR,'
      '110212867=               G.NAME TOVAR_NAME,'
      '110212868=               ZD.AMOUNT,'
      '110212869=               ZD.PRICE,'
      '110212870=               ZD.SUMM,'
      '110212871=               ZD.DISCOUNT_PERC,'
      '110212872=               ZD.DISCOUNT_SUMM,'
      '110212873=               ZD.NDS,'
      '110212874=               ZD.NDS_SUMM,'
      '110212875=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110212876=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110212877=               ZAKAZ_DETAILS ZD,'
      '110212878=               G_PRODUCT G,'
      '110212879=               G_PAYMENT_TYPE P'
      
        '110212880=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110212881=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110212882=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110212883=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110212884=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110212885=           AND Z.IS_SPISANIE = 0                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '110212886=           AND Z.IS_RESERVE = 0                    -- ' +
        #1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '110212887=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110212888=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110212889=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110212890=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110212891=           AND ((EXISTS (SELECT 1'
      '110212892=                       FROM SKLAD S'
      '110212893=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110212894=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110212895=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110212896=              OR'
      '110212897=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110212898=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110212899=    INTO :REC_ZAKAZ_,'
      '110212900=        :REC_G_TOCHKA_,'
      '110212901=        :REC_Z_DATE_,'
      '110212902=        :REC_G_CLIENT_,'
      '110212903=        :REC_CLIENT_NAME_,'
      '110212904=        :REC_G_PAYMENT_TYPE_,'
      '110212905=        :REC_PAYMENT_NAME_,'
      '110212906=        :REC_OSNOVANIE_,'
      '110212907=        :REC_G_PRODUCT_,'
      '110212908=        :REC_G_PRODUCT_PAR_,'
      '110212909=        :REC_TOVAR_NAME_,'
      '110212910=        :REC_AMOUNT_,'
      '110212911=        :REC_PRICE_,'
      '110212912=        :REC_SUMM_,'
      '110212913=        :REC_DISCOUNT_PERC_,'
      '110212914=        :REC_DISCOUNT_SUMM_,'
      '110212915=        :REC_NDS_,'
      '110212916=        :REC_NDS_SUMM_,'
      '110212917=        :REC_PRICE_SELF_'
      '110212918=    DO BEGIN'
      '110212919=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110212920=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110212921='
      '110212922=      insert into p_rep_profit_table'
      
        '110212923=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110212924=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110212925=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110212926=      values'
      '110212927=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110212928=        :REC_ZAKAZ_,'
      '110212929=        :REC_g_tochka_,'
      
        '110212930=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110212931=         :REC_osnovanie_,'
      '110212932=         :REC_g_product_,'
      '110212933=         :REC_g_product_par_,'
      '110212934=         :REC_tovar_name_,'
      '110212935=         :REC_amount_,'
      '110212936=         :REC_price_,'
      '110212937=         :REC_summ_,'
      '110212938=         :REC_discount_perc_,'
      '110212939=         :REC_discount_summ_,'
      
        '110212940=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110212941='
      
        '110212942=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110212943=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110212944=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110212945=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110212946=    END'
      '110212947='
      '110212948=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110212949=    insert into p_rep_profit_table'
      
        '110212950=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110212951=    values'
      
        '110212952=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110212953='
      '110212954=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110212955=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110212956=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110212957=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110212958='
      '110212959=    SUM_ZAKAZ_ = 0;'
      '110212960=    SUM_COST_  = 0;'
      '110212961=    NDS_SUMM_  = 0;'
      '110212962=    PROFIT_    = 0;'
      '110212963=  END'
      '110212964='
      '110212965=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110212966=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110212967=      insert into p_rep_profit_table'
      
        '110212968=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110212969=      values'
      
        '110212970=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110212971='
      
        '110212972=  --**************************************************' +
        '***************************************'
      '110212973=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110212974=  ----------------------------------------------------' +
        '---'
      '110212975=  SELECT COUNT(*)'
      
        '110212976=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110212977=          UNION ALL'
      
        '110212978=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110212979=         G_PRIHOD_RASHOD G'
      
        '110212980=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110212981=    AND K.ACTION = 1'
      
        '110212982=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110212983=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110212984=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053#1045 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110212985=  INTO :CNT_;'
      '110212986='
      '110212987=  IF (CNT_ > 0) THEN BEGIN'
      '110212988=    SUM_COST_  = 0;'
      '110212989=    PROFIT_    = 0;'
      '110212990='
      '110212991=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110212992=    INSERT INTO P_REP_PROFIT_TABLE'
      '110212993=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110212994=    VALUES'
      
        '110212995=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', 1' +
        ');'
      '110212996='
      '110212997=    FOR SELECT K.ACTION_DATE,'
      '110212998=               K.SUMM,'
      
        '110212999=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, '#39 +
        ' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '1102121000=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZ' +
        'NAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '1102121001=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39
      '1102121002=              UNION ALL'
      
        '1102121003=              SELECT KASSA_BEZNAL kassa, ACTION_DATE,' +
        ' SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM ka' +
        'ssa_beznal'
      
        '1102121004=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39') k,'
      '1102121005=              G_PRIHOD_RASHOD G'
      '1102121006=        WHERE K.ACTION = 1'
      
        '1102121007=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1102121008=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1102121009=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)  ' +
        '  -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102121010=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1102121011=    INTO :ACTION_DATE_,'
      '1102121012=         :SUMM_,'
      '1102121013=         :ACTION_NAME_'
      '1102121014=    DO BEGIN'
      '1102121015=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102121016=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1102121017=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1102121018=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1102121019=        VALUES'
      
        '1102121020=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, 0,'
      
        '1102121021=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALE' +
        'SCE(:SUMM_, 0), 0);'
      '1102121022='
      '1102121023=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1102121024=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1102121025=    END'
      '1102121026='
      '1102121027=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1102121028=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102121029=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1102121030=    insert into p_rep_profit_table'
      
        '1102121031=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102121032=    values'
      
        '1102121033=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1102121034=  END'
      '1102121035=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1102121036=  --*************************************************' +
        '****************************************'
      '1102121037='
      
        '1102121038=  --*************************************************' +
        '****************************************'
      '1102121039=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102121040=  ---------------------------------------------------' +
        '----'
      '1102121041=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121042=  SELECT COUNT(*)'
      
        '1102121043=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1102121044=          UNION ALL'
      
        '1102121045=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUM' +
        'M NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BE' +
        'ZNAL) K,'
      '1102121046=         G_PRIHOD_RASHOD G'
      
        '1102121047=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39 +
        '-'#39
      '1102121048=    AND K.ACTION = 0'
      
        '1102121049=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1102121050=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1102121051=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056 +
        #1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102121052=  INTO :CNT_;'
      '1102121053='
      '1102121054=  IF (CNT_ > 0) THEN BEGIN'
      '1102121055=    PRIHOD_ALL_  = 0;'
      '1102121056=    PRIHOD_ALL_NAL_  = 0;'
      '1102121057=    PRIHOD_ALL_BEZNAL_  = 0;'
      '1102121058=    PROFIT_     = 0;'
      '1102121059='
      '1102121060=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121061=    INSERT INTO P_REP_PROFIT_TABLE'
      '1102121062=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1102121063=    VALUES'
      
        '1102121064=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', ' +
        '1);'
      '1102121065='
      '1102121066=    FOR SELECT K.ACTION_DATE,'
      '1102121067=               K.NAL,'
      '1102121068=               K.BEZNAL,'
      '1102121069=               G.NAME'
      
        '1102121070=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0' +
        ' BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1102121071=               UNION ALL'
      
        '1102121072=               SELECT kassa_BEZNAL KASSA, ACTION_DATE' +
        ', 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kas' +
        'sa_beznal) K,'
      '1102121073=              G_PRIHOD_RASHOD G'
      
        '1102121074=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCH' +
        'KA||'#39'-'#39
      '1102121075=          AND K.ACTION = 0'
      
        '1102121076=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1102121077=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1102121078=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102121079=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1102121080=    INTO :ACTION_DATE_,'
      '1102121081=         :SUMM_NAL_,'
      '1102121082=         :SUMM_BEZNAL_,'
      '1102121083=         :ACTION_NAME_'
      '1102121084=    DO BEGIN'
      '1102121085=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102121086=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1102121087=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1102121088=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1102121089=        VALUES'
      
        '1102121090=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '1102121091=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNA' +
        'L_, 0);'
      '1102121092='
      
        '1102121093=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_' +
        ';'
      
        '1102121094=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUM' +
        'M_BEZNAL_;'
      
        '1102121095=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_' +
        'BEZNAL_;'
      
        '1102121096=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BE' +
        'ZNAL_;'
      '1102121097=    END'
      '1102121098='
      '1102121099=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1102121100=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102121101=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1102121102=    insert into p_rep_profit_table'
      
        '1102121103=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102121104=    values'
      
        '1102121105=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1102121106=  END'
      '1102121107='
      '1102121108=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1102121109=  --*************************************************' +
        '****************************************'
      '1102121110='
      
        '1102121111=  --*************************************************' +
        '****************************************'
      '1102121112=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102121113=  --*************************************************' +
        '****************************************'
      '1102121114=  SELECT COUNT(*)'
      '1102121115=    FROM ZAKAZ Z'
      
        '1102121116=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1102121117=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1102121118=     AND Z.IS_SPISANIE = 1'
      
        '1102121119=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1102121120=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102121121=  INTO :CNT_;'
      '1102121122='
      '1102121123=  IF (CNT_ > 0) THEN BEGIN'
      '1102121124=      SUM_ZAKAZ_ = 0;'
      '1102121125=      SUM_COST_  = 0;'
      '1102121126=      PROFIT_    = 0;'
      '1102121127='
      '1102121128=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121129=      insert into p_rep_profit_table'
      '1102121130=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102121131=      values'
      
        '1102121132=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1102121133='
      '1102121134=      FOR SELECT Z.ZAKAZ,'
      '1102121135=                 Z.G_TOCHKA,'
      '1102121136=                 Z.Z_DATE,'
      '1102121137=                 Z.G_CLIENT,'
      '1102121138=                 '#39#39' CLIENT_NAME,'
      '1102121139=                 Z.G_PAYMENT_TYPE,'
      '1102121140=                 '#39#39' PAYMENT_NAME,'
      '1102121141=                 Z.OSNOVANIE,'
      '1102121142=                 G.G_PRODUCT,'
      '1102121143=                 G.G_PRODUCT_PAR,'
      '1102121144=                 G.NAME TOVAR_NAME,'
      '1102121145=                 ZD.AMOUNT,'
      '1102121146=                 ZD.PRICE,'
      '1102121147=                 ZD.SUMM,'
      '1102121148=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '1102121149=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '1102121150=                 0 NDS, --ZD.NDS,'
      '1102121151=                 0 NDS_SUMM'
      
        '1102121152=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT' +
        ' G'
      
        '1102121153=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_T' +
        'OCHKA||'#39'-'#39
      '1102121154=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102121155=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102121156=             AND Z.IS_SPISANIE = 1                   ' +
        ' -- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '1102121157=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102121158=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '1102121159=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:' +
        'G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '1102121160=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COAL' +
        'ESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102121161=             AND ((EXISTS (SELECT 1'
      '1102121162=                           FROM SKLAD S'
      
        '1102121163=                          WHERE S.G_CLIENT = :G_SUPPL' +
        'IER_'
      
        '1102121164=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1102121165=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102121166=                  OR'
      '1102121167=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1102121168=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKA' +
        'Z_DETAILS'
      '1102121169=      INTO :REC_ZAKAZ_,'
      '1102121170=            :REC_G_TOCHKA_,'
      '1102121171=            :REC_Z_DATE_,'
      '1102121172=            :REC_G_CLIENT_,'
      '1102121173=            :REC_CLIENT_NAME_,'
      '1102121174=            :REC_G_PAYMENT_TYPE_,'
      '1102121175=            :REC_PAYMENT_NAME_,'
      '1102121176=            :REC_OSNOVANIE_,'
      '1102121177=            :REC_G_PRODUCT_,'
      '1102121178=            :REC_G_PRODUCT_PAR_,'
      '1102121179=            :REC_TOVAR_NAME_,'
      '1102121180=            :REC_AMOUNT_,'
      '1102121181=            :REC_PRICE_,'
      '1102121182=            :REC_SUMM_,'
      '1102121183=            :REC_DISCOUNT_PERC_,'
      '1102121184=            :REC_DISCOUNT_SUMM_,'
      '1102121185=            :REC_NDS_,'
      '1102121186=            :REC_NDS_SUMM_'
      '1102121187=      DO BEGIN'
      '1102121188=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1102121189=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053 +
        #1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '1102121190=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '1102121191=        REC_profit_   = -REC_SUMM_;'
      '1102121192='
      '1102121193=        insert into p_rep_profit_table'
      
        '1102121194=          (p_rep_profit_table, zakaz, g_tochka, z_dat' +
        'e, g_client, client_name, g_payment_type, payment_name,'
      
        '1102121195=           osnovanie, g_product, g_product_par, tovar' +
        '_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1102121196=           nds, nds_summ, price_self, sum_self, profi' +
        't, is_head)'
      '1102121197=        values'
      
        '1102121198=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZA' +
        'KAZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '1102121199=         :REC_osnovanie_, :REC_g_product_, :REC_g_pro' +
        'duct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_p' +
        'erc_, :REC_discount_summ_,'
      
        '1102121200=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC' +
        '_SUM_COST_, :REC_profit_, 0);'
      '1102121201='
      
        '1102121202=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COS' +
        'T_, 0);'
      
        '1102121203=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_,' +
        ' 0);'
      '1102121204=      END'
      '1102121205='
      '1102121206=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121207=      insert into p_rep_profit_table'
      
        '1102121208=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1102121209=      values'
      
        '1102121210=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', ' +
        '0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1102121211='
      '1102121212=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1102121213=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1102121214=  END'
      '1102121215=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1102121216=  --*************************************************' +
