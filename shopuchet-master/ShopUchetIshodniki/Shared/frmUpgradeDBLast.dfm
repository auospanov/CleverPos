        #39'||ERR_MSG;'
      '11096695=              EXIT;'
      '11096696=            END'
      '11096697=          END'
      '11096698='
      '11096699=          PNT_ = '#39'030'#39';'
      '11096700=          FOR SELECT S.ZAKAZ_DETAILS,'
      '11096701=                     S.G_PRODUCT,'
