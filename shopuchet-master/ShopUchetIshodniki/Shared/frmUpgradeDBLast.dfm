      '11068939=          INTO :G_PRODUCT_,'
      '11068940=               :G_PRODUCT_NAME_;'
      '11068941='
      
        '11068942=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11068943=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
