        '1102012770=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102012771='
      '1102012772=        END'
      '1102012773=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102012774=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102012775=          EXIT;'
      '1102012776=        END'
      '1102012777=      END */'
      '1102012778='
      
        '1102012779=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOA' +
        'D_TO_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040 +
        #1058#1053#1054' '#1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102012780=      IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_SPISANIE_ = ' +
        '0) THEN'
      
        '1102012781=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER, IS_LOADED_MOB)'
      
        '1102012782=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1, (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END));  ' +
        ' -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' CASE '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' '#1054#1041#1053#1054#1042#1051#1045#1053 +
        #1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102012783=  END'
      '1102012784=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102012785=  ----------------------------------------'
      '1102012786=  ----------------------------------------'
      '1102012787=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102012788=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1102012789=      PNT_ = '#39'25'#39';'
      
        '1102012790=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1102012791=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1102012792=      RETURNING ZAKAZ_REAL_PARENT'
      '1102012793=      INTO :ZAKAZ_;'
      '1102012794='
      
        '1102012795=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1102012796=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102012797=          INTO :G_PRODUCT,'
      '1102012798=              :AMOUNT,'
      '1102012799=              :PRICE,'
      '1102012800=              :SUMM,'
      '1102012801=              :DISCOUNT_PERC,'
      '1102012802=              :DISCOUNT_TENGE,'
      '1102012803=              :DISCOUNT_SUMM,'
      '1102012804=              :NDS,'
      '1102012805=              :NDS_SUMM'
      '1102012806=      DO BEGIN'
      '1102012807=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102012808=          UPDATE LT_SKLAD_PRODUCT L'
      '1102012809=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102012810=                 L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_AP' +
        'P_'
      '1102012811=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102012812=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102012813='
      
        '1102012814=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102012815=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102012816=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1102012817=            Err_Code = -20500;'
      
        '1102012818=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102012819=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102012820=            EXIT;'
      '1102012821=          END ELSE if (ROW_COUNT = 0) then'
      
        '1102012822=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102012823=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102012824='
      
        '1102012825=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1102012826=                                     G_PRODUCT,'
      '1102012827=                                     PRICE,'
      
