        '1101623866=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101623867=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623868=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101623869=            EXIT;'
      '1101623870=          END'
      '1101623871='
      '1101623872=          PNT_ = '#39'02A'#39';'
      '1101623873=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '1101623874=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1101623875=                                        :SUMM_,'
      
        '1101623876=                                        :ACTION_DATE_' +
        ','
      '1101623877=                                        :NOTE_,'
      '1101623878=                                        :ZAKAZ_,'
      '1101623879=                                        :SKLAD_,'
      
        '1101623880=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1101623881=                                        :G_TOCHKA_,'
      
        '1101623882=                                        :G_OFFICIAL_)' +
        ' RETURNING_VALUES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '1101623883=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623884=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101623885=            EXIT;'
      '1101623886=          END'
      '1101623887='
      
        '1101623888=          -- '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1053#1045' '#1041#1067#1051#1054' '#1055#1056#1054#1041#1051#1045#1052' '#1042' ' +
        #1042#1067#1047#1067#1042#1040#1070#1065#1045#1049' '#1055#1056#1054#1062#1045#1044#1059#1056#1045', '#1048#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1052#1045#1053#1071#1070' '#1053#1054#1042#1067#1049' ID '#1050#1040#1057#1057#1067' '#1053#1040' '#1057 +
        #1058#1040#1056#1067#1049','
      
        '1101623889=          -- '#1042#1045#1044#1068' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1042#1067#1047#1067#1042#1040#1051#1057#1071' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1056#1040#1047#1059#1052#1045 +
        #1042#1040#1045#1058#1057#1071' '#1063#1058#1054' ID '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071
      '1101623890=          UPDATE KASSA_BEZNAL SS'
      '1101623891=             SET SS.KASSA_BEZNAL = :KASSA_'
      '1101623892=           WHERE SS.KASSA_BEZNAL = :KASSA_NEW_;'
      '1101623893='
      
        '1101623894=          EXECUTE procedure K_RECALC_KASSA_BEZNAL(:AC' +
        'TION_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1101623895=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101623896=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101623897=            EXIT;'
      '1101623898=          END'
      '1101623899=      END'
      '1101623900=      UPDATE KASSA_BEZNAL'
      '1101623901=         SET ACTION = :ACTION_,'
      '1101623902=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '1101623903=             SUMM = :SUMM_,'
      '1101623904=             ACTION_DATE = :ACTION_DATE_,'
      '1101623905=             NOTE = COALESCE(:NOTE_, NOTE)'
      '1101623906=      WHERE KASSA_BEZNAL = :KASSA_;'
      '1101623907=  END'
      '1101623908='
      '1101623909=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101623910=  EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :USER' +
        '_ID_, :KASSA_, :ACTION_DATE_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1101623911=end'
      '1101623912=;'
      '1101623913='
      '1101623914=ALTER PROCEDURE LOG_OPER_INS('
      '1101623915=  ITEM_TYPE_ INTEGER,'
      '1101623916=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1101623917=  ITEM_ID_ TYPE OF DM_BIGINT,'
      '1101623918=  OPER_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101623919=  OPER_TYPE_ TYPE OF COLUMN LOG_OPER.OPERATION,'
      '1101623920=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101623921=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY,'
      '1101623922=  IS_PRIHOD_ INTEGER = 0,'
      '1101623923=  PARAM1_ VARCHAR(500) = '#39#39')'
      '1101623924=AS'
      
        '1101623925=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1101623926=DECLARE VARIABLE STR_ VARCHAR(50);'
      '1101623927=BEGIN'
      '1101623928='
      '1101623929=  IF (ITEM_TYPE_ < 10) THEN BEGIN'
      '1101623930=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1101623931='
      '1101623932=          IF (IS_PRIHOD_ = 0) THEN BEGIN'
      '1101623933=              IF (ITEM_TYPE_ = 0) THEN BEGIN'
      '1101623934=                LOG_ITEM_TYPE_ = 1;'
      '1101623935=                STR_ = '#39#1055#1088#1086#1076#1072#1078#1072#39';'
      '1101623936=              END ELSE IF (ITEM_TYPE_ = 1) THEN BEGIN'
      '1101623937=                LOG_ITEM_TYPE_ = 2;'
      '1101623938=                STR_ = '#39#1057#1087#1080#1089#1072#1085#1080#1077#39';'
      '1101623939=              END ELSE IF (ITEM_TYPE_ = 2) THEN BEGIN'
      '1101623940=                LOG_ITEM_TYPE_ = 3;'
      '1101623941=                STR_ = '#39#1042#1099#1076#1072#1095#1072' '#1087#1086#1076' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102#39';'
      '1101623942=              END ELSE IF (ITEM_TYPE_ = 3) THEN BEGIN'
      '1101623943=                LOG_ITEM_TYPE_ = 6;'
      '1101623944=                STR_ = '#39#1055#1077#1088#1077#1084#1077#1097#1077#1085#1080#1077#39';'
      '1101623945=              END ELSE IF (ITEM_TYPE_ = 4) THEN BEGIN'
      '1101623946=                LOG_ITEM_TYPE_ = 7;'
      '1101623947=                STR_ = '#39#1042#1086#1079#1074#1088#1072#1090' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39';'
      '1101623948=              END'
      '1101623949=          END'
      '1101623950=          ELSE BEGIN'
      '1101623951=              IF (ITEM_TYPE_ = 0) THEN BEGIN'
      '1101623952=                LOG_ITEM_TYPE_ = 4;'
      '1101623953=                STR_ = '#39#1055#1088#1080#1093#1086#1076#39';'
      '1101623954=              END ELSE IF (ITEM_TYPE_ = 1) THEN BEGIN'
      '1101623955=                LOG_ITEM_TYPE_ = 5;'
      '1101623956=                STR_ = '#39#1042#1086#1079#1074#1088#1072#1090#39';'
      '1101623957=              END ELSE IF (ITEM_TYPE_ = 2) THEN BEGIN'
      '1101623958=                LOG_ITEM_TYPE_ = 8;'
      '1101623959=                STR_ = '#39#1042#1086#1079#1074#1088#1072#1090' '#1074#1099#1076#1072#1095#1080' '#1087#1086#1076' '#1088#1077#1072#1083'.'#39';'
      '1101623960=              END ELSE IF (ITEM_TYPE_ = 4) THEN BEGIN'
      '1101623961=                LOG_ITEM_TYPE_ = 9;'
      '1101623962=                STR_ = '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086#39';'
      '1101623963=              END'
      '1101623964=          END'
      '1101623965='
      
        '1101623966=          INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPER' +
        'ATION, G_OFFICIAL,'
      '1101623967=            ITEM_TYPE,'
      '1101623968=            ITEM_ID, HEADER, BODY)'
      
        '1101623969=          VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TI' +
        'MESTAMP, :OPER_TYPE_, :USER_ID_,'
      '1101623970=            :LOG_ITEM_TYPE_,'
      '1101623971=            :ITEM_ID_,'
      '1101623972=            :STR_ ||'#39' '#39'|| :ITEM_ID_ || '#39' '#1086#1090' '#39' ||'
      
        '1101623973=            EXTRACT(day FROM :OPER_DATE_) || '#39'.'#39' || E' +
        'XTRACT(month FROM :OPER_DATE_)||'#39'.'#39' || EXTRACT(year FROM :OPER_D' +
        'ATE_) || '#39' '#1085#1072' '#1089#1091#1084#1084#1091' '#39' || :SUMM_, :LOG_BODY_);'
      '1101623974=      END'
      '1101623975=  END'
      
        '1101623976=  --=================================================' +
        '============='
      '1101623977=  -- '#1050#1040#1057#1057#1040
      '1101623978=  ELSE IF (ITEM_TYPE_ IN (10, 11)) THEN BEGIN'
      '1101623979=    IF (ITEM_TYPE_ = 10) THEN BEGIN'
      '1101623980=        STR_ = '#39#1055#1088#1080#1093#1086#1076' '#39';'
      '1101623981=    END ELSE IF (ITEM_TYPE_ = 11) THEN BEGIN'
      '1101623982=        STR_ = '#39#1056#1072#1089#1093#1086#1076' '#39';'
      '1101623983=    END'
      '1101623984='
      
        '1101623985=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1101623986=      ITEM_TYPE,'
      '1101623987=      ITEM_ID, HEADER, BODY)'
      
        '1101623988=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1101623989=      :ITEM_TYPE_,'
      '1101623990=      :ITEM_ID_,'
      '1101623991=      :STR_ || :ITEM_ID_ || '#39' '#1086#1090' '#39' ||'
      
        '1101623992=      EXTRACT(day FROM :OPER_DATE_) || '#39'.'#39' || EXTRACT' +
        '(month FROM :OPER_DATE_)||'#39'.'#39' || EXTRACT(year FROM :OPER_DATE_) ' +
        '|| '#39' '#1085#1072' '#1089#1091#1084#1084#1091' '#39' || :SUMM_, :LOG_BODY_);'
      '1101623993=  END'
      
        '1101623994=  --=================================================' +
        '============='
      '1101623995=  -- '#1050#1051#1048#1045#1053#1058#1067
      '1101623996=  ELSE IF (ITEM_TYPE_ = 12) THEN BEGIN'
      
        '1101623997=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1101623998=      ITEM_TYPE,'
      '1101623999=      ITEM_ID, HEADER, BODY)'
      
        '1101624000=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1101624001=      :ITEM_TYPE_,'
      '1101624002=      :ITEM_ID_,'
      '1101624003=      '#39#1050#1083#1080#1077#1085#1090' '#39'|| :PARAM1_ , :LOG_BODY_);'
      '1101624004=  END'
      
        '1101624005=  --=================================================' +
        '============='
      '1101624006=  -- '#1058#1054#1042#1040#1056#1067
      '1101624007=  ELSE IF (ITEM_TYPE_ = 13) THEN BEGIN'
      
        '1101624008=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1101624009=      ITEM_TYPE,'
      '1101624010=      ITEM_ID, HEADER, BODY)'
      
        '1101624011=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1101624012=      :ITEM_TYPE_,'
      '1101624013=      :ITEM_ID_,'
      '1101624014=      '#39#1058#1086#1074#1072#1088' '#39'|| :PARAM1_ , :LOG_BODY_);'
      '1101624015=  END'
      
        '1101624016=  --=================================================' +
        '============='
      '1101624017=  -- '#1053#1040#1057#1058#1056#1054#1049#1050#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1067
      '1101624018=  ELSE IF (ITEM_TYPE_ = 14) THEN BEGIN'
      
        '1101624019=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION,' +
        ' G_OFFICIAL,'
      '1101624020=      ITEM_TYPE,'
      '1101624021=      ITEM_ID, HEADER, BODY)'
      
        '1101624022=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAM' +
        'P, :OPER_TYPE_, :USER_ID_,'
      '1101624023=      :ITEM_TYPE_,'
      '1101624024=      NULL,'
      '1101624025=      '#39#1053#1072#1089#1090#1088#1086#1081#1082#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099#39', :LOG_BODY_);'
      '1101624026=  END'
      '1101624027=END'
      '1101624028=;'
      '1101624029='
      '1101624030=ALTER PROCEDURE LOG_OPER_READ_LIST('
      '1101624031=  DATE_BEGIN_ DATE,'
      '1101624032=  DATE_END_ DATE)'
      '1101624033=RETURNS ('
      '1101624034=  LOG_OPER TYPE OF COLUMN LOG_OPER.LOG_OPER,'
      '1101624035=  ODATE TYPE OF COLUMN LOG_OPER.ODATE,'
      '1101624036=  OPERATION VARCHAR(30),'
      '1101624037=  HEADER TYPE OF COLUMN LOG_OPER.HEADER,'
      '1101624038=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101624039=  ITEM_TYPE VARCHAR(30))'
      '1101624040=AS'
      
        '1101624041=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1101624042=DECLARE VARIABLE STR_ VARCHAR(50);'
      '1101624043=BEGIN'
      '1101624044='
      '1101624045=  FOR SELECT LO.LOG_OPER,'
      '1101624046=           LO.ODATE,'
      '1101624047=           DECODE(LO.OPERATION,'
      '1101624048=                  1, '#39#1057#1086#1079#1076#1072#1085#1080#1077#39','
      '1101624049=                  2, '#39#1048#1079#1084#1077#1085#1077#1085#1080#1077#39','
      '1101624050=                  3, '#39#1059#1076#1072#1083#1077#1085#1080#1077#39') OPERATION,'
      '1101624051=           LO.HEADER,'
      '1101624052=           G.FIO_DOC,'
      '1101624053=           DECODE(LO.ITEM_TYPE,'
      '1101624054=                    1, '#39#1055#1088#1086#1076#1072#1078#1080#39','
      '1101624055=                    2, '#39#1057#1087#1080#1089#1072#1085#1080#1103#39','
      '1101624056=                    3, '#39#1042#1099#1076#1072#1095#1072' '#1087#1086#1076' '#1088#1077#1072#1083'.'#39','
      '1101624057=                    4, '#39#1055#1088#1080#1093#1086#1076#1099#39','
      '1101624058=                    5, '#39#1042#1086#1079#1074#1088#1072#1090' '#1082#1083#1080#1077#1085#1090#1091#39','
      '1101624059=                    6, '#39#1055#1077#1088#1077#1084#1077#1097#1077#1085#1080#1103#39','
      '1101624060=                    7, '#39#1042#1086#1079#1074#1088#1072#1090' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39','
      '1101624061=                    8, '#39#1042#1086#1079#1074#1088#1072#1090' '#1087#1086#1076' '#1088#1077#1072#1083'.'#39','
      '1101624062=                    9, '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086#39','
      '1101624063=                    10, '#39#1050#1072#1089#1089#1072#39','
      '1101624064=                    11, '#39#1050#1072#1089#1089#1072#39','
      '1101624065=                    12, '#39#1050#1083#1080#1077#1085#1090#1099#39','
      '1101624066=                    13, '#39#1058#1086#1074#1072#1088#1099#39','
      '1101624067=                    14, '#39#1053#1072#1089#1090#1088#1086#1081#1082#1080#39
      '1101624068=                 ) ITEM_TYPE'
      '1101624069='
      '1101624070=      FROM LOG_OPER LO,'
      '1101624071=           G_OFFICIAL G'
      '1101624072=    WHERE LO.G_OFFICIAL = G.G_OFFICIAL'
      
        '1101624073=      AND CAST(LO.ODATE AS DATE) BETWEEN :DATE_BEGIN_' +
        ' AND :DATE_END_'
      '1101624074=    ORDER BY 2 DESC'
      '1101624075=    INTO :LOG_OPER,'
      '1101624076=        :ODATE,'
      '1101624077=        :OPERATION,'
      '1101624078=        :HEADER,'
      '1101624079=        :G_OFFICIAL_FIO,'
      '1101624080=        :ITEM_TYPE'
      '1101624081=  DO'
      '1101624082=    SUSPEND;'
      '1101624083=END'
      '1101624084=;'
      '1101624085='
      '1101624086=ALTER PROCEDURE OTHER_READ('
      '1101624087=  DATE_BEGIN_ DATE,'
      '1101624088=  DATE_END_ DATE,'
      '1101624089=  OP_TYPE_ TYPE OF COLUMN OTHER.OP_TYPE,'
      '1101624090=  ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.ARRIVAL_TYPE)'
      '1101624091=RETURNS ('
      '1101624092=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '1101624093=  OP_DATE TYPE OF COLUMN OTHER.OP_DATE,'
      '1101624094=  OP_TIME TYPE OF COLUMN OTHER.OP_TIME,'
      '1101624095=  NOTE TYPE OF COLUMN OTHER.NOTE,'
      '1101624096=  STRING_DTLS VARCHAR(1000),'
      '1101624097=  OTHER TYPE OF COLUMN OTHER.OTHER,'
      '1101624098=  AMOUNT TYPE OF COLUMN OTHER_DETAILS.AMOUNT,'
      '1101624099=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1101624100=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME)'
      '1101624101=AS'
      '1101624102=DECLARE VARIABLE CNT_ INTEGER;'
      '1101624103=BEGIN'
      '1101624104=  SELECT COUNT(*)'
      '1101624105=    FROM SKLAD T'
      '1101624106=   WHERE T.IS_VOZVRAT = 4'
      
        '1101624107=    AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '1101624108=    AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHERE' +
        ' CUR_PARAMS = 2)'
      '1101624109=    INTO CNT_;'
      '1101624110='
      '1101624111=  if (CNT_ = 0) then'
      '1101624112=    SELECT MAX(T.DATE_RECEIPT)'
      '1101624113=      FROM SKLAD T'
      '1101624114=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1101624115=       AND T.IS_VOZVRAT = 4'
      
        '1101624116=       AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1101624117=      INTO :DATE_BEGIN_;'
      '1101624118='
      '1101624119=  FOR SELECT S.SKLAD,'
      '1101624120=             S.DATE_RECEIPT,'
      '1101624121=             S.NOTE,'
      '1101624122=             G.NAME||'#39', '#1089#1077#1073#1077#1089#1090'-'#1090#1100' '#39'||SS.PRICE,'
      '1101624123=             SS.AMOUNT,'
      
        '1101624124=             /*SUBSTRING((SELECT LIST(G.NAME||'#39', '#1089#1077#1073#1077 +
        #1089#1090'-'#1090#1100' '#39'||D.PRICE, '#39', '#39')'
      '1101624125=                          FROM SKLAD D, G_PRODUCT G'
      
        '1101624126=                         WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '1101624127=                           AND D.SKLAD_PARENT = S.SKL' +
        'AD'
      
        '1101624128=                         GROUP BY SKLAD_PARENT) FROM ' +
        '1 FOR 999) DETAILS_STR*/'
      '1101624129=             O.OTHER,'
      '1101624130=             S.SUMM,'
      '1101624131=             G.NAME'
      '1101624132=      FROM SKLAD_PARENT S,'
      '1101624133=           SKLAD SS,'
      '1101624134=           OTHER O,'
      '1101624135=           G_PRODUCT G'
      
        '1101624136=      WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1101624137=        AND S.is_vozvrat = 4'
      
        '1101624138=        AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1101624139=        AND S.sklad = O.sklad_parent_id'
      '1101624140=        AND S.SKLAD = SS.SKLAD_PARENT'
      '1101624141=        AND SS.G_PRODUCT = G.G_PRODUCT'
      '1101624142=      INTO :SKLAD,'
      '1101624143=           :OP_DATE,'
      '1101624144=           :NOTE,'
      '1101624145=           :STRING_DTLS'
      '1101624146=           ,:AMOUNT'
      '1101624147=           ,:OTHER'
      '1101624148=           ,:SUMM'
      '1101624149=           ,:PRODUCT_NAME'
      '1101624150=  DO'
      '1101624151=    SUSPEND;'
      '1101624152='
      '1101624153=  /*FOR SELECT OTHER,'
      '1101624154=             OP_DATE,'
      '1101624155=             OP_TYPE,'
      '1101624156=             ARRIVAL_TYPE,'
      '1101624157=             NOTE,'
      '1101624158=             SKLAD_PARENT_ID,'
      '1101624159=             G_TOCHKA,'
      '1101624160=             SUBSTRING((SELECT'
      
        '1101624161=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT|' +
        '|'#39')'#39', '#39', '#39')'
      
        '1101624162=                        FROM OTHER_DETAILS D, G_PRODU' +
        'CT G'
      
        '1101624163=                        WHERE D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '1101624164=                          AND D.OTHER = T.OTHER'
      
        '1101624165=                          GROUP BY OTHER) FROM 1 FOR ' +
        '999) DETAILS_STR'
      '1101624166=      FROM OTHER T'
      
        '1101624167=      WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      
        '1101624168=        AND T.OP_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1101624169=        AND T.OP_TYPE = :OP_TYPE_'
      '1101624170=        AND T.ARRIVAL_TYPE = :ARRIVAL_TYPE_'
      '1101624171=      INTO :OTHER,'
      '1101624172=           :OP_DATE,'
      '1101624173=           :OP_TYPE,'
      '1101624174=           :ARRIVAL_TYPE,'
      '1101624175=           :NOTE,'
      '1101624176=           :SKLAD_PARENT_ID,'
      '1101624177=           :G_TOCHKA,'
      '1101624178=           :STRING_DTLS'
      '1101624179=  DO BEGIN'
      '1101624180=    SUSPEND;'
      '1101624181=  END*/'
      '1101624182=END'
      '1101624183=;'
      '1101624184='
      '1101624185=ALTER PROCEDURE P_REP_PRICE_LIST('
      '1101624186=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101624187=  INCLUDE_NOL_ INTEGER,'
      '1101624188=  INCLUDE_FEW_ INTEGER,'
      '1101624189=  SORT_BY_NAME_ INTEGER,'
      '1101624190=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101624191=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101624192=RETURNS ('
      '1101624193=  PERIOD_ VARCHAR(40),'
      '1101624194=  ROW_NUM VARCHAR(15),'
      '1101624195=  ARTICUL VARCHAR(1000),'
      '1101624196=  BARCODE VARCHAR(30),'
      
        '1101624197=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101624198=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101624199=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101624200=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101624201=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101624202=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101624203=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1101624204=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      '1101624205=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1101624206=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1101624207=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1101624208=  TOVAR_NAME VARCHAR(250),'
      '1101624209=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101624210=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101624211=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1101624212=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101624213=  ERR_CODE INTEGER,'
      '1101624214=  ERR_MSG VARCHAR(1024))'
      '1101624215=AS'
      '1101624216=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '1101624217=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_' +
        'LIST'#39';'
      '1101624218=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101624219=DECLARE VARIABLE I INTEGER = 1;'
      '1101624220=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101624221=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101624222=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1101624223=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1101624224=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1101624225=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1101624226=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1101624227=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1101624228=BEGIN'
      '1101624229='
      
        '1101624230=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1101624231=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101624232='
      '1101624233=  SELECT S.S_VALUE,'
      '1101624234=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1101624235=    FROM SYSTEM_SETUP S'
      '1101624236=   WHERE S.SYSTEM_SETUP = 1'
      '1101624237=    INTO :FORMULA_,'
      '1101624238=         :PRIHOD_CNT_;'
      '1101624239='
      '1101624240=  FOR SELECT GP.PATH,'
      '1101624241=             GP.G_PRODUCT'
      '1101624242=        FROM P_REP_TREE GP'
      '1101624243=       WHERE EXISTS (SELECT 1'
      '1101624244=                       FROM G_PRODUCT'
      '1101624245=                      WHERE IS_CATEGORY = 0'
      
        '1101624246=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1101624247=                    )'
      
        '1101624248=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101624249=              OR'
      '1101624250=              (:G_CATEGORY_ is NULL)'
      '1101624251=             )'
      '1101624252=       ORDER BY 1, 2'
      '1101624253=       INTO :PATH_NAME_,'
      '1101624254=            :G_PRODUCT_'
      '1101624255=  DO BEGIN'
      
        '1101624256=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1101624257=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1101624258=      SELECT COUNT(G.G_PRODUCT)'
      
        '1101624259=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101624260=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1101624261=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101624262=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101624263=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101624264=              OR'
      
        '1101624265=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1101624266=              or'
      
        '1101624267=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1101624268=             )'
      '1101624269=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101624270=         AND ((EXISTS (SELECT 1'
      '1101624271=                       FROM SKLAD S'
      '1101624272=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1101624273=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1101624274=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101624275=              OR'
      '1101624276=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1101624277=        INTO :CNT_;'
      '1101624278='
      '1101624279=      IF (CNT_ > 0) THEN BEGIN'
      
        '1101624280=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1101624281=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1101624282='
      
        '1101624283=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1101624284=                                              ARTICUL' +
        ','
      
        '1101624285=                                              BARCODE' +
        ','
      
        '1101624286=                                              NOMENCL' +
        'ATUR_NUM,'
      '1101624287=                                              NAME,'
      
        '1101624288=                                              UNIT_NA' +
        'ME,'
      '1101624289=                                              PRICE,'
      
        '1101624290=                                              VOLUME_' +
        'PRICE,'
      
        '1101624291=                                              SKIDKA_' +
        'PRICE,'
      '1101624292=                                              AMOUNT,'
      
        '1101624293=                                              AMOUNT_' +
        'RESERVE,'
      '1101624294=                                              SUMM,'
      
        '1101624295=                                              PRICE_S' +
        'ELF,'
      
        '1101624296=                                              SORT_CO' +
        'L,'
      
        '1101624297=                                              IS_CATE' +
        'GORY,'
      '1101624298=                                              NOTE,'
      
        '1101624299=                                              CROSSCO' +
        'DE,'
      '1101624300=                                              PLACE)'
      
        '1101624301=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1101624302=                 G.ARTICUL,'
      '1101624303=                 G.BARCODE,'
      '1101624304=                 G.NOMENCLATUR_NUM,'
      '1101624305=                 G.NAME,'
      '1101624306=                 U.SHORT_NAME,'
      '1101624307=                 G.PRICE,'
      '1101624308=                 G.VOLUME_PRICE,'
      '1101624309=                 G.PRICE - GD.SKIDKA_SUM,'
      '1101624310=                 COALESCE(S.AMOUNT, 0),'
      '1101624311=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1101624312=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1101624313=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1101624314=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1101624315=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1101624316=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '1101624317=                  DECODE(:FORMULA_,'
      '1101624318=                         1,'
      
        '1101624319=                         (SELECT CAST(S.price AS MY_N' +
        'UMERIC)'
      '1101624320=                            FROM SKLAD S'
      
        '1101624321=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101624322=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1101624323=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1101624324=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1101624325=                                                     ' +
        'FROM SKLAD DD'
      
        '1101624326=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1101624327=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1101624328=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1101624329=                                                    )'
      '1101624330=                            ORDER BY 1 DESC'
      '1101624331=                            ROWS 1 TO 1'
      '1101624332=                         ),'
      
        '1101624333=                         (SELECT CAST(ROUND(SUM(T.AMO' +
        'UNT * T.PRICE)/SUM(T.AMOUNT), 2) AS MY_NUMERIC)'
      
        '1101624334=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1101624335=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1101624336=                                         SKLAD S'
      
        '1101624337=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1101624338=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1101624339=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1101624340=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1101624341=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1101624342=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '1101624343=                        )), 0) spr,'
      
        '1101624344=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1101624345=                 0'
      '1101624346=                 ,G.NOTE'
      
        '1101624347=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      '1101624348=                 ,G.PLACE'
      
        '1101624349=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '1101624350=                                                FROM ' +
        'G_DISCOUNT D'
      
        '1101624351=                                                WHERE' +
        ' ((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '1101624352=                                                     ' +
        '   AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '1101624353=                                                     ' +
        '   AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '1101624354=                                                     ' +
        ' )'
      
        '1101624355=                                                     ' +
        ' OR'
      
        '1101624356=                                                     ' +
        ' (D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '1101624357=                                                 AND ' +
        '((:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '1101624358=                                                     ' +
        'OR'
      
        '1101624359=                                                     ' +
        '(D.G_TOCHKA IS NULL))'
      
        '1101624360=                                              ) GD ON' +
        ' G.G_PRODUCT = GD.G_PRODUCT'
      
        '1101624361=                             LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1101624362=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101624363=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1101624364=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101624365=             AND G.IS_CATEGORY = 0'
      '1101624366=             AND G.is_active = 1'
      '1101624367=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101624368=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101624369=                  OR'
      
        '1101624370=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1101624371=                  or'
      
        '1101624372=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1101624373=                 )'
      '1101624374=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101624375=             AND ((EXISTS (SELECT 1'
      '1101624376=                           FROM SKLAD S'
      
        '1101624377=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1101624378=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101624379=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101624380=                  OR'
      '1101624381=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1101624382=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '1101624383=      END'
      '1101624384=  END'
      '1101624385='
      
        '1101624386=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1101624387='
      
        '1101624388=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKI' +
        'DKA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRIC' +
        'E_SELF, IS_CATEGORY,'
      '1101624389=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '1101624390=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1101624391=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOL' +
        'UME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRIC' +
        'E_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '1101624392=  DO BEGIN'
      '1101624393=    I = I + 1;'
      '1101624394=    SUSPEND;'
      '1101624395=  END'
      '1101624396='
      '1101624397=     /*'
      '1101624398=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '1101624399='
      '1101624400=     SELECT :I,'
      
        '1101624401=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045 +
        #1044#1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      
        '1101624402=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058 +
        #1054
      '1101624403=             U.SHORT_NAME UNIT_NAME,'
      '1101624404=             SS.PRICE,'
      '1101624405=             SS.VOLUME_PRICE,'
      '1101624406=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '1101624407=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE' +
        '(S.AMOUNT, 0)),'
      '1101624408=             SS.IS_CATEGORY'
      '1101624409=        FROM (WITH RECURSIVE TREE'
      '1101624410=              AS (SELECT T.G_PRODUCT,'
      '1101624411=                       T.NAME AS ARTICUL,'
      
        '1101624412=                       CAST(NULL AS VARCHAR(500)) NAM' +
        'E,'
      
        '1101624413=                       CAST(NULL AS NUMERIC(15,2)) PR' +
        'ICE,'
      
        '1101624414=                       CAST(NULL AS NUMERIC(15,2)) VO' +
        'LUME_PRICE,'
      '1101624415=                       T.IS_CATEGORY,'
      '1101624416=                       NULL G_UNIT'
      '1101624417=                  FROM G_PRODUCT T'
      '1101624418=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '1101624419=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T' +
        '.G_PRODUCT||'#39'~'#39
      '1101624420=                UNION ALL'
      '1101624421=                SELECT T.G_PRODUCT,'
      '1101624422=                       DECODE(T. T.ARTICUL,'
      '1101624423=                       T.NAME,'
      '1101624424=                       T.PRICE,'
      '1101624425=                       T.VOLUME_PRICE,'
      '1101624426=                       T.IS_CATEGORY,'
      '1101624427=                       T.G_UNIT'
      
        '1101624428=                  FROM G_PRODUCT T INNER JOIN TREE PR' +
        'IOR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '1101624429=                 WHERE T.IS_ACTIVE = 1'
      '1101624430=                )'
      '1101624431=             SELECT * FROM TREE) SS'
      
        '1101624432=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS' +
        '.G_PRODUCT = S.G_PRODUCT'
      
        '1101624433=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = ' +
        'U.G_UNIT'
      
        '1101624434=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PR' +
        'ODUCT = GD.G_PRODUCT'
      '1101624435=    INTO :ROW_NUM,'
      '1101624436=        :ARTICUL,'
      '1101624437=        :NAME,'
      '1101624438=        :UNIT_NAME,'
      '1101624439=        :PRICE,'
      '1101624440=        :VOLUME_PRICE,'
      '1101624441=        :SKIDKA_PRICE,'
      '1101624442=        :AMOUNT,'
      '1101624443=        :IS_CATEGORY'
      '1101624444=    DO BEGIN'
      '1101624445=      I = I + 1;'
      '1101624446=      SUSPEND;'
      '1101624447=    END  */'
      '1101624448=WHEN ANY DO BEGIN'
      '1101624449=    Err_code = -20500;'
      
        '1101624450=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101624451=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101624452=  END'
      '1101624453=end'
      '1101624454=;'
      '1101624455='
      '1101624456=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1101624457=RETURNS ('
      '1101624458=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1101624459=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '1101624460=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '1101624461=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '1101624462=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '1101624463=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1101624464=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1101624465=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '1101624466=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '1101624467=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101624468=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101624469=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101624470=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101624471=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC,'
      '1101624472=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101624473=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC,'
      '1101624474=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101624475=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE)'
      '1101624476=AS'
      '1101624477=begin'
      '1101624478=  FOR'
      
        '1101624479=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T' +
        '.SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '1101624480=           ,PRICE_CURRENCY'
      '1101624481=           ,SUMM_CURRENCY'
      '1101624482=           ,CHARGE_ROZN_PROC'
      '1101624483=           ,PRICE_ROZN'
      '1101624484=           ,CHARGE_OPT_PROC'
      '1101624485=           ,PRICE_OPT'
      '1101624486=           ,CHANGE_SALE_PRICE'
      '1101624487=    FROM SKLAD_TMP T,'
      '1101624488=         G_PRODUCT P'
      '1101624489=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101624490=    ORDER BY T.sklad'
      
        '1101624491=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, ' +
        ':NDS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '1101624492=      ,:PRICE_CURRENCY'
      '1101624493=      ,:SUMM_CURRENCY'
      '1101624494=      ,:CHARGE_ROZN_PROC'
      '1101624495=       ,:PRICE_ROZN'
      '1101624496=       ,:CHARGE_OPT_PROC'
      '1101624497=       ,:PRICE_OPT'
      '1101624498=       ,:CHANGE_SALE_PRICE'
      '1101624499=  DO'
      '1101624500=    suspend;'
      '1101624501=end'
      '1101624502=;'
      '1101624503='
      '1101624504=ALTER PROCEDURE READ_SKLAD_PARENT_LIST('
      '1101624505=  DATE_BEGIN_ DATE,'
      '1101624506=  DATE_END_ DATE,'
      '1101624507=  IS_VOZVRAT_ INTEGER)'
      '1101624508=RETURNS ('
      '1101624509=  SKLAD TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      
        '1101624510=  DATE_RECEIPT TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '1101624511=  TIME_RECEIPT TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '1101624512=  G_CLIENT TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      '1101624513=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '1101624514=  G_PAYMENT_TYPE TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '1101624515=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1101624516=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '1101624517=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '1101624518=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101624519=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1101624520=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '1101624521=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '1101624522=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1101624523=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101624524=  DETAILS_STR VARCHAR(1000))'
      '1101624525=AS'
      '1101624526=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101624527=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101624528=BEGIN'
      '1101624529='
      '1101624530=  SELECT ID'
      '1101624531=    FROM CUR_PARAMS'
      '1101624532=   WHERE CUR_PARAMS = 2'
      '1101624533=    INTO :G_TOCHKA_;'
      '1101624534='
      '1101624535=  SELECT COUNT(*)'
      '1101624536=    FROM SKLAD_PARENT T'
      
        '1101624537=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101624538=     AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :IS_' +
        'VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '1101624539=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1101624540=     AND T.G_TOCHKA = :G_TOCHKA_'
      '1101624541=    INTO CNT_;'
      '1101624542='
      '1101624543=  if (CNT_ = 0) then'
      '1101624544=    SELECT MAX(T.DATE_RECEIPT)'
      '1101624545=      FROM SKLAD_PARENT T'
      '1101624546=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1101624547=       AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :I' +
        'S_VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '1101624548=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1101624549=       AND T.G_TOCHKA = :G_TOCHKA_'
      '1101624550=      INTO :DATE_BEGIN_;'
      '1101624551='
      '1101624552=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1101624553=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1101624554=      FOR'
      '1101624555=        SELECT T.SKLAD,'
      '1101624556=               T.DATE_RECEIPT,'
      '1101624557=               T.TIME_RECEIPT,'
      '1101624558=               T.G_CLIENT,'
      '1101624559=               GC.NAME,'
      '1101624560=               T.G_PAYMENT_TYPE,'
      '1101624561=               PT.NAME,'
      
        '1101624562=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1101624563=                            FROM SKLAD D, G_PRODUCT G'
      
        '1101624564=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1101624565=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1101624566=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR,*/'
      '1101624567=               T.OSNOVANIE,'
      '1101624568=               T.NOTE,'
      '1101624569=               T.SUMM,'
      '1101624570=               T.SUMM_FACT,'
      '1101624571=               T.IS_PAYED_ALL,'
      '1101624572=               T.IS_VOZVRAT,'
      '1101624573=               T.g_official,'
      
        '1101624574=               COALESCE(GO.fio_doc, GO.FM||'#39' '#39'||GO.nm' +
        ')'
      '1101624575=          FROM SKLAD_PARENT T'
      
        '1101624576=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1101624577=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT' +
        ' ON T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '1101624578=                    LEFT OUTER JOIN G_OFFICIAL GO ON ' +
        'T.g_official = GO.G_OFFICIAL'
      
        '1101624579=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVR' +
        'AT_ = 0)'
      
        '1101624580=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZV' +
        'RAT_ = 1))'
      '1101624581=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '1101624582=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1101624583=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '1101624584=        INTO :SKLAD,'
      '1101624585=             :DATE_RECEIPT,'
      '1101624586=             :TIME_RECEIPT,'
      '1101624587=             :G_CLIENT,'
      '1101624588=             :CLIENT_NAME,'
      '1101624589=             :G_PAYMENT_TYPE,'
      '1101624590=             :PAYMENT_NAME,'
      '1101624591=             --:DETAILS_STR,'
      '1101624592=             :OSNOVANIE,'
      '1101624593=             :NOTE,'
      '1101624594=             :SUMM,'
      '1101624595=             :SUMM_FACT,'
      '1101624596=             :IS_PAYED_ALL,'
      '1101624597=             :IS_VOZVRAT,'
      '1101624598=             :G_OFFICIAL,'
      '1101624599=             :G_OFFICIAL_FIO'
      '1101624600=      DO'
      '1101624601=        suspend;'
      '1101624602='
      
        '1101624603=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1047#1044#1045#1057#1068' '#1044#1040#1053#1053#1067#1049' '#1057#1050#1051#1040#1044' '#1057#1058#1054#1048#1058 +
        ' '#1050#1040#1050' '#1050#1051#1048#1045#1053#1058', '#1040' '#1042' G_TOCHKA '#1057#1058#1054#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '1101624604=  END ELSE BEGIN'
      '1101624605=      FOR'
      '1101624606=        SELECT T.SKLAD,'
      '1101624607=               T.DATE_RECEIPT,'
      '1101624608=               T.G_TOCHKA,'
      '1101624609=               G.NAME,'
      
        '1101624610=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1101624611=                            FROM SKLAD D, G_PRODUCT G'
      
        '1101624612=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1101624613=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1101624614=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR, */'
      '1101624615=               T.OSNOVANIE,'
      '1101624616=               T.NOTE,'
      '1101624617=               T.SUMM'
      
        '1101624618=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHK' +
        'A G ON T.G_CLIENT = G.G_TOCHKA'
      '1101624619=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '1101624620=           AND T.IS_VOZVRAT = 3'
      
        '1101624621=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1101624622=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '1101624623=        INTO :SKLAD,'
      '1101624624=             :DATE_RECEIPT,'
      '1101624625=             :G_CLIENT,'
      '1101624626=             :CLIENT_NAME,'
      '1101624627=             --:DETAILS_STR,'
      '1101624628=             :OSNOVANIE,'
      '1101624629=             :NOTE,'
      '1101624630=             :SUMM'
      '1101624631=      DO'
      '1101624632=        suspend;'
      '1101624633=  END'
      '1101624634=end'
      '1101624635=;'
      '1101624636='
      '1101624637=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST('
      '1101624638=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101624639=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE)'
      '1101624640=RETURNS ('
      '1101624641=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '1101624642=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS,'
      '1101624643=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '1101624644=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101624645=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101624646=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101624647=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_PERC,'
      
        '1101624648=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1101624649=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1101624650=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101624651=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101624652=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101624653=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101624654=  ED_NAME TYPE OF COLUMN G_UNIT.NAME)'
      '1101624655=AS'
      '1101624656=begin'
      '1101624657='
      '1101624658=  FOR'
      '1101624659=    SELECT D.ZAKAZ,'
      '1101624660=           D.ZAKAZ_DETAILS,'
      '1101624661=           D.G_PRODUCT,'
      '1101624662=           D.AMOUNT,'
      '1101624663=           D.PRICE,'
      '1101624664=           D.SUMM,'
      '1101624665=           D.DISCOUNT_PERC,'
      '1101624666=           D.DISCOUNT_TENGE,'
      '1101624667=           D.DISCOUNT_SUMM,'
      '1101624668=           G.ARTICUL,'
      '1101624669=           G.NOMENCLATUR_NUM,'
      '1101624670=           G.BARCODE,'
      '1101624671=           G.NAME,'
      '1101624672=           COALESCE(GU.SHORT_NAME, GU.NAME)'
      '1101624673=      FROM ZAKAZ_DETAILS D,'
      '1101624674=           G_PRODUCT G,'
      '1101624675=           G_UNIT GU'
      '1101624676=     WHERE D.ZAKAZ = :ZAKAZ_'
      '1101624677=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101624678=       AND G.G_UNIT = GU.G_UNIT'
      '1101624679=       AND :IS_SPISANIE_ <> 3'
      '1101624680=    UNION ALL'
      '1101624681=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '1101624682=           D.SKLAD ZAKAZ_DETAILS,'
      '1101624683=           D.G_PRODUCT,'
      '1101624684=           D.AMOUNT,'
      '1101624685=           D.PRICE,'
      '1101624686=           D.SUMM,'
      '1101624687=           0 DISCOUNT_PERC,'
      '1101624688=           0 DISCOUNT_TENGE,'
      '1101624689=           0 DISCOUNT_SUMM,'
      '1101624690=           G.ARTICUL,'
      '1101624691=           G.NOMENCLATUR_NUM,'
      '1101624692=           G.BARCODE,'
      '1101624693=           G.NAME,'
      '1101624694=           GU.NAME'
      '1101624695=      FROM SKLAD D,'
      '1101624696=           G_PRODUCT G,'
      '1101624697=           G_UNIT GU'
      '1101624698=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '1101624699=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101624700=       AND G.G_UNIT = GU.G_UNIT'
      '1101624701=       AND :IS_SPISANIE_ = 3'
      '1101624702=    ORDER BY 1'
      '1101624703=    INTO  :ZAKAZ,'
      '1101624704=          :ZAKAZ_DETAILS,'
      '1101624705=          :G_PRODUCT,'
      '1101624706=          :AMOUNT,'
      '1101624707=          :PRICE,'
      '1101624708=          :SUMM,'
      '1101624709=          :DISCOUNT_PERC,'
      '1101624710=          :DISCOUNT_TENGE,'
      '1101624711=          :DISCOUNT_SUMM,'
      '1101624712=          :ARTICUL,'
      '1101624713=          :NOMENCLATUR_NUM,'
      '1101624714=          :BARCODE,'
      '1101624715=          :PRODUCT_NAME,'
      '1101624716=          :ED_NAME'
      '1101624717=  DO'
      '1101624718=    suspend;'
      '1101624719=end'
      '1101624720=;'
      '1101624721='
      '1101624722=ALTER PROCEDURE UPD_SKLAD('
      '1101624723=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101624724=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1101624725=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1101624726=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1101624727=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1101624728=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101624729=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101624730=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101624731=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1101624732=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101624733=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101624734=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1101624735=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1101624736=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1101624737=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101624738=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101624739=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101624740=RETURNS ('
      '1101624741=  ERR_CODE INTEGER,'
      '1101624742=  ERR_MSG VARCHAR(1024))'
      '1101624743=AS'
      
        '1101624744=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1101624745=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1101624746=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101624747=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101624748=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1101624749=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101624750=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101624751=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1101624752=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1101624753=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1101624754=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101624755=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1101624756=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101624757=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1101624758=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101624759=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1101624760=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1101624761=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101624762=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1101624763=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101624764=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101624765=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101624766=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101624767=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101624768=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101624769=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101624770=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101624771=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101624772=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101624773=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101624774=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1101624775=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1101624776=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1101624777=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      '1101624778=BEGIN'
      '1101624779='
      '1101624780=  IS_THIS_LAST_ = 0;'
      '1101624781='
      '1101624782=  SELECT S.G_TOCHKA,'
      '1101624783=         S.IS_VOZVRAT,'
      '1101624784=         S.G_PAYMENT_TYPE'
      '1101624785=         ,S.is_expected'
      '1101624786=    FROM SKLAD_parent S'
      '1101624787=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1101624788=    INTO :G_TOCHKA_,'
      '1101624789=         :IS_VOZVRAT_,'
      '1101624790=         :G_PAYMENT_TYPE_OLD_'
      '1101624791=         ,:IS_EXPECTED_OLD_;'
      '1101624792='
      '1101624793=  PNT_ = '#39'00'#39';'
      '1101624794=  UPDATE SKLAD_PARENT'
      '1101624795=  SET'
      
        '1101624796=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1101624797=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1101624798=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1101624799=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1101624800=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101624801=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101624802=   SUMM      = :SUMM_,'
      '1101624803=   SUMM_FACT = :SUMM_FACT_,'
      '1101624804=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1101624805=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0) ' +
        ' -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054 +
        ' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101624806=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '1101624807=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1101624808='
      
        '1101624809=  ---------------------------------------------------' +
        '----------'
      
        '1101624810=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1101624811=  PNT_ = '#39'02'#39';'
      '1101624812=  FOR SELECT SKLAD'
      '1101624813=        FROM SKLAD S'
      '1101624814=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101624815=         AND NOT EXISTS (SELECT 1'
      '1101624816=                           FROM SKLAD_TMP T'
      '1101624817=                        WHERE T.SKLAD = S.SKLAD)'
      '1101624818=  INTO :SKLAD_'
      '1101624819=  DO BEGIN'
      
        '1101624820=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101624821=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101624822=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101624823=      EXIT;'
      '1101624824=    END'
      '1101624825=  END'
      '1101624826='
      
        '1101624827=  ---------------------------------------------------' +
        '----------'
      
        '1101624828=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1101624829=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1101624830=  PNT_ = '#39'03'#39';'
      '1101624831=  FOR SELECT S.SKLAD,'
      '1101624832=             S.G_PRODUCT,'
      '1101624833=             S.AMOUNT,'
      '1101624834=             S.PRICE,'
      '1101624835=             S.SUMM,'
      '1101624836=             S.NDS,'
      '1101624837=             S.NDS_SUMM,'
      '1101624838=             T.SKLAD,'
      '1101624839=             T.AMOUNT,'
      '1101624840=             T.IS_LAST,'
      '1101624841=             T.DATE_RECEIPT'
      '1101624842=             ,S.PRICE_CURRENCY'
      '1101624843=             ,S.SUMM_CURRENCY'
      '1101624844=             ,S.PRICE_ROZN'
      
        '1101624845=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1101624846=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1101624847=  INTO :SKLAD_,'
      '1101624848=       :G_PRODUCT_,'
      '1101624849=       :AMOUNT_,'
      '1101624850=       :PRICE_,'
      '1101624851=       :SUMM_ONE_,'
      '1101624852=       :NDS_,'
      '1101624853=       :NDS_SUMM_,'
      '1101624854=       :SKLAD_OLD_,'
      '1101624855=       :AMOUNT_OLD_,'
      '1101624856=       :IS_THIS_LAST_,'
      '1101624857=       :DATE_RECEIPT_OLD_'
      '1101624858=       ,:PRICE_CURRENCY_'
      '1101624859=       ,:SUMM_CURRENCY_TMP_'
      '1101624860=       ,:SALE_PRICE_'
      '1101624861=       ,:SALE_PRICE_CUR_'
      '1101624862=  DO BEGIN'
      
        '1101624863=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101624864=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1101624865=        PNT_ = '#39'04'#39';'
      
        '1101624866=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1101624867=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1101624868=                          ,PRICE_CURRENCY'
      '1101624869=                          ,SUMM_CURRENCY)'
      
        '1101624870=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1101624871=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101624872=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1101624873=               ,:PRICE_CURRENCY_'
      '1101624874=               ,:SUMM_CURRENCY_TMP_'
      '1101624875=               );'
      '1101624876='
      
        '1101624877=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1101624878=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1101624879=            UPDATE LT_SKLAD_PRODUCT L'
      '1101624880=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101624881=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101624882=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101624883='
      '1101624884=            IF (ROW_COUNT = 0) THEN'
      
        '1101624885=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_);'
      '1101624886=        END'
      '1101624887='
      
        '1101624888=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101624889=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1101624890=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1101624891=        PNT_ = '#39'05'#39';'
      '1101624892=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1101624893=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101624894=              FROM SKLAD SK'
      '1101624895=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101624896=               AND SK.IS_LAST = 1'
      '1101624897=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101624898=              INTO :DATE_LAST_;'
      '1101624899='
      
        '1101624900=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101624901=              UPDATE SKLAD SK'
      '1101624902=                 SET SK.IS_LAST = 0'
      '1101624903=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101624904=                 AND SK.IS_LAST = 1'
      '1101624905=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101624906='
      '1101624907=              UPDATE SKLAD SK'
      '1101624908=                 SET SK.IS_LAST = 1'
      '1101624909=               WHERE SK.SKLAD = :SKLAD_;'
      '1101624910=            END'
      '1101624911=        END'
      
        '1101624912=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101624913=    END ELSE BEGIN'
      '1101624914=        PNT_ = '#39'06'#39';'
      '1101624915=        UPDATE SKLAD S'
      '1101624916=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1101624917=               S.G_CLIENT = :G_CLIENT_,'
      '1101624918=               S.AMOUNT   = :AMOUNT_,'
      '1101624919=               S.PRICE    = :PRICE_,'
      '1101624920=               S.SUMM     = :SUMM_ONE_,'
      '1101624921=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101624922=               S.NDS      = :NDS_,'
      '1101624923=               S.NDS_SUMM = :NDS_SUMM_,'
      '1101624924=               S.OSNOVANIE = :OSNOVANIE_,'
      '1101624925=               S.NOTE      = :NOTE_'
      '1101624926=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1101624927=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1101624928=         WHERE S.SKLAD = :SKLAD_;'
      '1101624929='
      '1101624930=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1101624931=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_ AND IS_EX' +
        'PECTED_ = 0) THEN BEGIN'
      '1101624932=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1101624933=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1101624934=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_)'
      '1101624935=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101624936=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101624937='
      '1101624938=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1101624939=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1101624940=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_)'
      '1101624941=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101624942=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101624943=        END'
      
        '1101624944=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1101624945=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1101624946=            UPDATE LT_SKLAD_PRODUCT L'
      '1101624947=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101624948=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101624949=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101624950='
      '1101624951=            IF (ROW_COUNT = 0) THEN'
      
        '1101624952=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_);'
      '1101624953=        END'
      
        '1101624954=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1101624955=        ELSE IF (IS_EXPECTED_OLD_ = 0 AND IS_EXPECTED' +
        '_ = 1) THEN BEGIN'
      '1101624956=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1101624957=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_'
      '1101624958=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101624959=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101624960=        END'
      '1101624961='
      
        '1101624962=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1101624963=        PNT_ = '#39'07'#39';'
      
        '1101624964=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1101624965=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101624966=              FROM SKLAD SK'
      '1101624967=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101624968=               AND SK.IS_LAST = 1'
      '1101624969=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101624970=              INTO :DATE_LAST_;'
      '1101624971='
      
        '1101624972=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101624973=              UPDATE SKLAD SK'
      '1101624974=                 SET SK.IS_LAST = 0'
      '1101624975=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101624976=                 AND SK.IS_LAST = 1'
      '1101624977=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101624978='
      '1101624979=              UPDATE SKLAD SK'
      '1101624980=                 SET SK.IS_LAST = 1'
      '1101624981=               WHERE SK.SKLAD = :SKLAD_;'
      '1101624982=            END'
      '1101624983=        END'
      '1101624984='
      
        '1101624985=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1101624986=        PNT_ = '#39'08'#39';'
      
        '1101624987=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1101624988=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101624989=              FROM SKLAD SK'
      '1101624990=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101624991=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1101624992=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101624993=               AND SK.is_vozvrat IN (0,4)'
      '1101624994=              INTO :DATE_LAST_;'
      '1101624995='
      
        '1101624996=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101624997=              UPDATE SKLAD SK'
      '1101624998=                 SET SK.IS_LAST = 0'
      '1101624999=               WHERE SK.SKLAD = :SKLAD_;'
      '1101625000='
      '1101625001=               UPDATE SKLAD SK'
      '1101625002=                 SET SK.IS_LAST = 1'
      '1101625003=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101625004=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1101625005=                                   FROM SKLAD SS'
      
        '1101625006=                                  WHERE SS.G_PRODUCT ' +
        '= SK.G_PRODUCT'
      
        '1101625007=                                    AND SS.DATE_RECEI' +
        'PT = :DATE_LAST_'
      
        '1101625008=                                    AND SS.G_TOCHKA =' +
        ' :G_TOCHKA_'
      
        '1101625009=                                    AND SS.is_vozvrat' +
        ' IN (0,4));'
      '1101625010='
      '1101625011=            END'
      
        '1101625012=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054 +
        #1052' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' ' +
        #1053#1048#1052'.'
      
        '1101625013=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059 +
        #1044#1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '1101625014=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THI' +
        'S_LAST_ = 1)) THEN BEGIN'
      '1101625015=              UPDATE SKLAD SK'
      '1101625016=                 SET SK.IS_LAST = 1'
      '1101625017=               WHERE SK.SKLAD = :SKLAD_;'
      '1101625018=            END'
      '1101625019=        END'
      '1101625020=    END'
      '1101625021='
      
        '1101625022=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '1101625023=      UPDATE G_PRODUCT G'
      '1101625024=         SET G.PRICE = :SALE_PRICE_'
      '1101625025=       WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101625026=  END'
      '1101625027='
      
        '1101625028=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057 +
        #1057#1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '1101625029=      ----------------------------------------'
      
        '1101625030=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1055#1056#1048#1061#1054#1044#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101625031=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052'  - '#1058#1045#1055#1045#1056#1068' '#1069#1058#1054' '#1044#1045#1051#1040#1045#1058#1057#1071' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' K_UPD_KASSA'
      '1101625032=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101625033=      -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' ' +
        #1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054 +
        #1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101625034=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057 +
        #1058#1042#1045#1053#1053#1054')'
      
        '1101625035=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101625036=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101625037='
      
        '1101625038=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056 +
        ' '#1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '1101625039=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053 +
        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1101625040=      IF (IS_VOZVRAT_ = 0) THEN'
      '1101625041=        G_PRIHOD_RASHOD_ = 2;'
      '1101625042=      ELSE'
      '1101625043=        G_PRIHOD_RASHOD_ = 3;'
      '1101625044='
      '1101625045=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1101625046=            PNT_ = '#39'09'#39';'
      '1101625047=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1101625048=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101625049=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101625050=            ELSE'
      
        '1101625051=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101625052='
      '1101625053=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101625054=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101625055='
      
        '1101625056=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1101625057=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1101625058=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101625059=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1101625060=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1101625061=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1101625062=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101625063=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1101625064=                                              :SKLAD_' +
        'PARENT_,'
      
        '1101625065=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1101625066=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101625067='
      
        '1101625068=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101625069=            ELSE BEGIN'
      
        '1101625070=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101625071=                SELECT 1'
      '1101625072=                  FROM KASSA K'
      '1101625073=                 WHERE K.KASSA = :KASSA_'
      '1101625074=                UNION ALL'
      '1101625075=                SELECT 2'
      '1101625076=                  FROM KASSA_BEZNAL KB'
      '1101625077=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101625078=                 INTO :PAYMENT_TYPE_OLD_;'
      '1101625079='
      
        '1101625080=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101625081=                      PNT_ = '#39'010'#39';'
      
        '1101625082=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1101625083=                                                    1' +
        ',     -- ACTION_'
      
        '1101625084=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1101625085=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1101625086=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1101625087=                                                    N' +
        'ULL,   --NOTE_'
      
        '1101625088=                                                    N' +
        'ULL,  --ZAKAZ'
      
        '1101625089=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1101625090=                                                    :' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101625091='
      
        '1101625092=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101625093=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101625094=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101625095=                      PNT_ = '#39'011'#39';'
      
        '1101625096=                      EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '1101625097=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625098=                        ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101625099=                        EXIT;'
      '1101625100=                      END'
      '1101625101='
      
        '1101625102=                      EXECUTE PROCEDURE K_INS_KASSA(1' +
        ',     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101625103=                                                    :' +
        'G_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1101625104=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1101625105=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1101625106=                                                    N' +
        'ULL,   --NOTE_ => :NOTE_,'
      
        '1101625107=                                                    N' +
        'ULL,   --ZAKAZ_'
      
        '1101625108=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1101625109=                                                    :' +
        'PAYMENT_TYPE_,'
      
        '1101625110=                                                    :' +
        'G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101625111=                END'
      '1101625112=            END'
      '1101625113=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625114=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101625115=              EXIT;'
      '1101625116=            END'
      '1101625117='
      
        '1101625118=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101625119=      END'
      '1101625120='
      
        '1101625121=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101625122=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101625123=            FROM KASSA K'
      '1101625124=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101625125=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1101625126=           UNION'
      '1101625127=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1101625128=            FROM KASSA K'
      '1101625129=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101625130=             AND K.SUMM = 0'
      '1101625131=          UNION'
      '1101625132=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101625133=            FROM KASSA_BEZNAL K'
      '1101625134=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101625135=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1101625136=          UNION'
      '1101625137=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101625138=            FROM KASSA_BEZNAL K'
      '1101625139=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101625140=             AND K.SUMM = 0'
      '1101625141=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101625142=      DO BEGIN'
      '1101625143=        PNT_ = '#39'011A'#39';'
      
        '1101625144=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101625145=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625146=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101625147=          EXIT;'
      '1101625148=        END'
      '1101625149=      END'
      '1101625150=  END'
      '1101625151='
      
        '1101625152=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1101625153=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101625154=    SELECT K.KASSA'
      '1101625155=      FROM KASSA K'
      '1101625156=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101625157=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101625158=      INTO :KASSA_POP_;'
      '1101625159=  ELSE'
      '1101625160=    SELECT K.KASSA_BEZNAL'
      '1101625161=      FROM KASSA_BEZNAL K'
      '1101625162=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101625163=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101625164=       INTO :KASSA_POP_;'
      '1101625165='
      
        '1101625166=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1101625167=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1101625168=      PNT_ = '#39'012'#39';'
      '1101625169=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1101625170=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1101625171=                                          1,     -- A' +
        'CTION_'
      '1101625172=                                          :G_PRIHOD_,'
      
        '1101625173=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101625174=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101625175=                                          NULL,   --N' +
        'OTE_'
      '1101625176=                                          NULL,'
      
        '1101625177=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101625178=                                          :G_PAYMENT_' +
        'TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101625179=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101625180=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101625181=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1101625182=                                          :G_PRIHOD_,'
      
        '1101625183=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101625184=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101625185=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1101625186=                                          NULL,'
      
        '1101625187=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101625188=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101625189=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101625190=      END'
      '1101625191=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625192=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101625193=        EXIT;'
      '1101625194=      END'
      '1101625195='
      
        '1101625196=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101625197=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101625198=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101625199=        PNT_ = '#39'013'#39';'
      
        '1101625200=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101625201=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625202=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101625203=          EXIT;'
      '1101625204=        END'
      '1101625205=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101625206=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1101625207=                                          :G_PRIHOD_,'
      
        '1101625208=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101625209=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101625210=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1101625211=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1101625212=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101625213=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101625214=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101625215=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625216=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101625217=              EXIT;'
      '1101625218=            END'
      '1101625219=        END'
      '1101625220=  END'
      '1101625221='
      '1101625222=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101625223=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THE' +
        'N'
      
        '1101625224=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101625225=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PA' +
        'RENT_, 2);'
      '1101625226='
      '1101625227=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101625228=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_PARENT_, :DATE_RECEIPT_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1101625229=end'
      '1101625230=;'
      '1101625231='
      '1101625232=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1101625233=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101625234=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101625235=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101625236=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101625237=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101625238=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101625239=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101625240=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101625241=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101625242=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101625243=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101625244=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101625245=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101625246=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101625247=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101625248=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101625249=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101625250=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101625251=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101625252=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1101625253=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1101625254=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101625255=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101625256=RETURNS ('
      '1101625257=  ERR_CODE INTEGER,'
      '1101625258=  ERR_MSG VARCHAR(1024))'
      '1101625259=AS'
      '1101625260=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1101625261='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1101625262=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1101625263=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1101625264='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1101625265=*/'
      
        '1101625266=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1101625267=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101625268=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101625269=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1101625270=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101625271=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1101625272=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1101625273=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1101625274=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1101625275=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101625276=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      '1101625277=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101625278=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101625279=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101625280=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      
        '1101625281=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101625282=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101625283=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101625284=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;' +
        ' /* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '1101625285=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '1101625286=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '1101625287=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1101625288=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101625289=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101625290=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101625291=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101625292=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101625293=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101625294=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101625295=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1101625296=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1101625297=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101625298=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101625299=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101625300=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1101625301=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1101625302=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1101625303=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101625304=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1101625305=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1101625306=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101625307=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1101625308=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1101625309=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1101625310=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1101625311=BEGIN'
      '1101625312='
      '1101625313=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101625314=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101625315=      SELECT Z.G_PAYMENT_TYPE,'
      '1101625316=             Z.G_TOCHKA,'
      '1101625317=             Z.SUMM,'
      '1101625318=             Z.SUMM_BONUS,'
      '1101625319=             Z.SUMM_BONUS_GOT,'
      '1101625320=             z.g_client,'
      '1101625321=             Z.G_OFFICIAL,'
      '1101625322=             G.DO_NOT_SALES_COMM,'
      '1101625323=             G.FM||'#39' '#39'||G.NM'
      
        '1101625324=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101625325=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101625326=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1101625327=             :G_TOCHKA_,'
      '1101625328=             :SUMM_OLD_,'
      '1101625329=             :SUMM_BONUS_OLD_,'
      '1101625330=             :SUMM_BONUS_GOT_OLD_,'
      '1101625331=             :g_client_old_,'
      '1101625332=             :G_OFFICIAL_,'
      '1101625333=             :DO_NOT_SALES_COMM_,'
      '1101625334=             :OFFICIAL_NAME_;'
      '1101625335='
      
        '1101625336=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101625337=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1101625338=        SELECT SUM(ZD.SALES_COMM)'
      '1101625339=          FROM ZAKAZ_DETAILS ZD'
      '1101625340=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101625341=          INTO :SALES_COMM_OLD_;'
      '1101625342='
      '1101625343=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101625344=      PNT_ = '#39'02'#39';'
      
        '1101625345=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101625346=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625347=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101625348=        EXIT;'
      '1101625349=      END'
      '1101625350='
      
        '1101625351=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101625352=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101625353=      ELSE'
      '1101625354=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101625355='
      '1101625356=      PNT_ = '#39'01'#39';'
      '1101625357=      UPDATE zakaz'
      '1101625358=      SET'
      '1101625359=       G_TOCHKA = :G_TOCHKA_,'
      '1101625360=       Z_DATE = :Z_DATE_,'
      '1101625361=       Z_TIME = :Z_TIME_,'
      '1101625362=       G_CLIENT = :G_CLIENT_,'
      '1101625363=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101625364=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101625365=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1101625366=       SUMM = :SUMM_,'
      '1101625367=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1101625368=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101625369=       ,BY_RECIPE = :BY_RECIPE_'
      '1101625370=       ,IS_RESERVE = :IS_RESERVE_'
      '1101625371=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1101625372=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1101625373=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1101625374=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1101625375=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1101625376=      WHERE'
      '1101625377=        zakaz = :zakaz_;'
      '1101625378='
      
        '1101625379=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1101625380=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1101625381=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1101625382=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1101625383=          UPDATE G_DISCONT_CARD D'
      '1101625384=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1101625385=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1101625386=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1101625387='
      
        '1101625388=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1101625389=          SUMM_OLD_           = 0;'
      '1101625390=      END'
      '1101625391=      UPDATE G_DISCONT_CARD D'
      
        '1101625392=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1101625393=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1101625394=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1101625395='
      '1101625396=      PNT_ = '#39'03'#39';'
      '1101625397=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1101625398=                 T.G_PRODUCT,'
      '1101625399=                 T.AMOUNT,'
      '1101625400=                 T.SUMM,'
      '1101625401=                 G.SALES_COMM'
      '1101625402=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1101625403=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1101625404=      INTO :ZAKAZ_DETAILS_,'
      '1101625405=           :G_PRODUCT_,'
      '1101625406=           :Z_AMOUNT_,'
      '1101625407=           :DETAILS_SUMM_,'
      '1101625408=           :SALES_COMM_'
      '1101625409=      DO BEGIN'
      
        '1101625410=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101625411=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1101625412=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1101625413=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101625414=        END'
      '1101625415='
      
        '1101625416=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101625417=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1101625418=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101625419=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1101625420=          FROM ZAKAZ_DETAILS_TMP Z'
      '1101625421=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1101625422='
      '1101625423=        -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1101625424=        IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1101625425=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' ' +
        #1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1101625426=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN'
      '1101625427=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625428=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_'
      '1101625429=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625430=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101625431='
      '1101625432=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101625433=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101625434=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625435=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :Z_AMOUNT_'
      '1101625436=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625437=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101625438=        END'
      '1101625439=      END'
      '1101625440='
      '1101625441=      ----------------------------------------'
      
        '1101625442=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101625443=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1101625444=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1101625445=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101625446=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101625447=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1101625448=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101625449=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101625450=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1101625451=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1101625452=                PNT_ = '#39'04'#39';'
      
        '1101625453=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101625454=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101625455=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101625456=                ELSE'
      
        '1101625457=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101625458='
      
        '1101625459=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101625460=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101625461='
      
        '1101625462=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101625463='
      '1101625464=                PNT_ = '#39'05'#39';'
      
        '1101625465=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN BEGIN'
      
        '1101625466=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101625467=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101625468=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101625469=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101625470=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101625471=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1101625472=                                                  NUL' +
        'L,'
      
        '1101625473=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101625474=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101625475='
      
        '1101625476=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101625477=                END ELSE BEGIN'
      
        '1101625478=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101625479=                    SELECT 1'
      '1101625480=                      FROM KASSA K'
      '1101625481=                     WHERE K.KASSA = :KASSA_'
      '1101625482=                    UNION ALL'
      '1101625483=                    SELECT 2'
      '1101625484=                      FROM KASSA_BEZNAL KB'
      '1101625485=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101625486=                     INTO :PAYMENT_TYPE_OLD_;'
      '1101625487='
      '1101625488=                    PNT_ = '#39'06'#39';'
      
        '1101625489=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
        'YPE_) THEN'
      
        '1101625490=                        EXECUTE PROCEDURE K_UPD_KASSA' +
        '(:KASSA_,'
      
        '1101625491=                                                     ' +
        ' 0,     -- ACTION_'
      
        '1101625492=                                                     ' +
        ' 1,     --:G_PRIHOD_RASHOD_,'
      
        '1101625493=                                                     ' +
        ' :PAYMENT_SUMM_,'
      
        '1101625494=                                                     ' +
        ' :PAYMENT_DATE_,'
      
        '1101625495=                                                     ' +
        ' NULL,   --NOTE_'
      
        '1101625496=                                                     ' +
        ' :ZAKAZ_,'
      
        '1101625497=                                                     ' +
        ' NULL,'
      
        '1101625498=                                                     ' +
        ' :PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '1101625499=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' ' +
        #1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101625500=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' ' +
        #1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101625501=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101625502=                        PNT_ = '#39'07'#39';'
      
        '1101625503=                        EXECUTE PROCEDURE K_DEL_KASSA' +
        '(:KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_' +
        'MSG);'
      
        '1101625504=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1101625505=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101625506=                          EXIT;'
      '1101625507=                        END'
      '1101625508='
      '1101625509=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '1101625510=                           EXECUTE PROCEDURE K_INS_KA' +
        'SSA(0,     -- ACTION_ => :ACTION_'
      
        '1101625511=                                                     ' +
        '     1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101625512=                                                     ' +
        '     :PAYMENT_SUMM_,'
      
        '1101625513=                                                     ' +
