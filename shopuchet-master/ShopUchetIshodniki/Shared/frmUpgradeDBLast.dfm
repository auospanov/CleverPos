        '1102251879=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39
      '1102251880=                   AND Z.summ_bonus > 0) K,'
      '1102251881=               zakaz zz'
