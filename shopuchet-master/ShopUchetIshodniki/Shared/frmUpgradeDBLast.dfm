      '1106023169=  -- '#1056#1040#1057#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1048#1047' '#1050#1040#1057#1057#1067
      '1106023170=  FIRST_ITER = 0;'
      '1106023171=  SUMM_RASHOD_ = 0;'
      
        '1106023172=  FOR SELECT lpad(EXTRACT(DAY FROM K.action_date), 2,' +
        ' '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39'.'#39 +
        '||EXTRACT(YEAR FROM K.action_date),'
      '1106023173=             K.action_date,'
      
        '1106023174=             G.name||DECODE(CHAR_LENGTH(K.NOTE), 0, '#39 +
        #39', '#39' ('#39'||K.NOTE||'#39')'#39')'
      '1106023175=             ,SUM(K.summ)'
      '1106023176=        FROM KASSA k, g_prihod_rashod G'
      
        '1106023177=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106023178=         AND K.ACTION = 1'
      
        '1106023179=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1106023180=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '1106023181=         AND K.g_tochka = :G_TOCHKA_'
      '1106023182=        GROUP BY 2, 3'
      '1106023183=        UNION ALL'
      
        '1106023184=        SELECT lpad(EXTRACT(DAY FROM K.action_date), ' +
        '2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM K.action_date),'
      '1106023185=             K.action_date,'
      '1106023186=             '#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1091'/'#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39' name'
      '1106023187=             ,SUM(K.summ)'
      '1106023188=        FROM KASSA k'
      '1106023189=        WHERE K.G_PRIHOD_RASHOD in (2,3)'
      
        '1106023190=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '1106023191=         AND K.action_date <> (SELECT DATE_RECEIPT FR' +
        'OM SKLAD_PARENT WHERE SKLAD = K.sklad)'
      '1106023192=         AND K.g_tochka = :G_TOCHKA_'
      '1106023193=        GROUP BY 2, 3'
      '1106023194=        INTO :date_str,'
      '1106023195=           :Z_DATE,'
      '1106023196=           :NAME,'
      '1106023197=           :SUMM'
      '1106023198=  DO BEGIN'
      '1106023199=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1106023200=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1106023201=      VALUES (24, 1, '#39#1056#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1080#1079' '#1082#1072#1089#1089#1099#39');'
      '1106023202=      FIRST_ITER = 1;'
      '1106023203=    END'
      '1106023204='
      
        '1106023205=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '1106023206=      VALUES (25, 2, :DATE_STR, :z_date, :NAME, :SUMM' +
        ');'
      '1106023207='
      '1106023208=    SUMM_RASHOD_ = SUMM_RASHOD_ + SUMM;'
      '1106023209=  END'
      '1106023210='
      '1106023211=  IF (FIRST_ITER = 1) THEN'
      
        '1106023212=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '1106023213=    VALUES (26, 3, '#39#1048#1090#1086#1075#1086' '#1088#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075#39', :SUMM_RASHOD' +
        '_);'
      '1106023214=  SUMM_RASHOD_ALL_ = SUMM_RASHOD_ALL_ + SUMM_RASHOD_;'
      '1106023215='
      '1106023216=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '1106023217=  VALUES(27, 1);'
      '1106023218='
      
        '1106023219=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, SUMM)'
      
        '1106023220=  VALUES (28, 1, '#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' '#1085#1072' '#1089#1091#1084#1084#1091#39 +
        ', :SUMM_PRIHOD_ALL_);'
      '1106023221='
      
        '1106023222=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, SUMM)'
      
        '1106023223=  VALUES (29, 1, '#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1085#1072' '#1089#1091#1084#1084#1091#39', :SUM' +
        'M_RASHOD_ALL_);'
      '1106023224='
      '1106023225=  FOR SELECT SORT_COL'
      '1106023226=            ,ROW_COL'
      '1106023227=            ,Z_DATE'
      '1106023228=            ,Z_DATE_STR'
      '1106023229=            ,ARTICUL'
      '1106023230=            ,BARCODE'
      '1106023231=            ,NAME'
      '1106023232=            ,AMOUNT'
      '1106023233=            ,SUMM'
      '1106023234=        FROM P_REP_KASSIR_TABLE'
      '1106023235=    ORDER BY 1, 3, 7'
      '1106023236=    INTO :SORT_COL,'
      '1106023237=        :ROWCOL,'
      '1106023238=        :Z_DATE_LOC,'
      '1106023239=        :Z_DATE,'
      '1106023240=        :ARTICUL,'
      '1106023241=        :BARCODE,'
      '1106023242=        :NAME,'
      '1106023243=        :AMOUNT,'
      '1106023244=        :SUMM'
      '1106023245=  DO'
      '1106023246=    suspend;'
      '1106023247=end'
      '1106023248=;'
      '1106023249='
      '1106023250=ALTER PROCEDURE P_REP_OFFICIAL_SALARY('
      '1106023251=  DATE_BEGIN_ DATE,'
      '1106023252=  DATE_END_ DATE,'
      '1106023253=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106023254=  MODE_ INTEGER)'
      '1106023255=RETURNS ('
      '1106023256=  ROW_SORT INTEGER,'
      '1106023257=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106023258=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106023259=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106023260=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1106023261=  SALES_COMM TYPE OF COLUMN ZAKAZ_DETAILS.SALES_COMM,'
      '1106023262=  SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM,'
      
        '1106023263=  SALES_COMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAILS.SALES_' +
        'COMM,'
      '1106023264=  ERR_CODE INTEGER,'
      '1106023265=  ERR_MSG VARCHAR(1024))'
      '1106023266=AS'
      '1106023267=/*'
      '1106023268=MODE_: 0 - '#1044#1045#1058#1040#1051#1068#1053#1054', 1 - '#1055#1054' '#1043#1056#1059#1055#1055#1040#1052' '#1058#1054#1042#1040#1056#1054#1042
      '1106023269=*/'
      
        '1106023270=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OFFICI' +
        'AL_SALARY'#39';'
      '1106023271=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106023272=BEGIN'
      '1106023273='
      '1106023274=  SUMM_ALL_ = 0;'
      '1106023275=  SALES_COMM_ALL_ = 0;'
      '1106023276='
      '1106023277=  IF (MODE_ = 1) THEN BEGIN'
      
        '1106023278=    DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT' +
        '_TABLE = P_REP_PROFIT_TABLE;'
      '1106023279=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1106023280=  END'
      '1106023281='
      '1106023282=  FOR SELECT   1 ROW_SORT,'
      '1106023283=               Z.Z_DATE,'
      '1106023284=               G.NAME,'
      '1106023285=               ZD.AMOUNT,'
      '1106023286=               ZD.SUMM,'
      '1106023287=               ZD.SALES_COMM'
      '1106023288=          FROM ZAKAZ Z,'
      '1106023289=               ZAKAZ_DETAILS ZD,'
      '1106023290=               G_PRODUCT G'
      
        '1106023291=         WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1106023292=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106023293=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106023294=           AND ZD.SALES_COMM > 0'
      '1106023295=           AND Z.G_OFFICIAL = :G_OFFICIAL_'
      '1106023296=           AND :MODE_ = 0'
      '1106023297=        UNION ALL'
      '1106023298=        SELECT 2 ROW_SORT,'
      '1106023299=               Z.Z_DATE,'
      '1106023300=               TR.PATH,'
      '1106023301=               SUM(ZD.AMOUNT),'
      '1106023302=               SUM(ZD.SUMM),'
      '1106023303=               SUM(ZD.SALES_COMM)'
      '1106023304=          FROM ZAKAZ Z,'
      '1106023305=               ZAKAZ_DETAILS ZD,'
      '1106023306=               G_PRODUCT G,'
      '1106023307=               P_REP_TREE TR'
      
        '1106023308=         WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1106023309=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106023310=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106023311=           AND ZD.SALES_COMM > 0'
      '1106023312=           AND Z.G_OFFICIAL = :G_OFFICIAL_'
      '1106023313=           AND G.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106023314=           AND :MODE_ = 1'
      '1106023315=          GROUP BY Z.Z_DATE, TR.PATH'
      '1106023316=        UNION ALL'
      '1106023317=        SELECT 3 ROW_SORT,'
      '1106023318=               K.ACTION_DATE Z_DATE,'
      '1106023319=               '#39#1042#1099#1087#1083#1072#1090#1072' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1091#39','
      '1106023320=               NULL AMOUNT,'
      '1106023321=               NULL SUMM,'
      '1106023322=               K.SUMM SALES_COMM'
      '1106023323=          FROM KASSA K'
      
        '1106023324=         WHERE K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1106023325=           AND K.G_PRIHOD_RASHOD = -1'
      '1106023326=           AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1106023327=        ORDER BY 1, 2'
      '1106023328=       INTO :ROW_SORT,'
      '1106023329=            :Z_DATE,'
      '1106023330=            :NAME,'
      '1106023331=            :AMOUNT,'
      '1106023332=            :SUMM,'
      '1106023333=            :SALES_COMM'
      '1106023334=  DO BEGIN'
      '1106023335=    IF (ROW_SORT <> 3) THEN'
      '1106023336=      SUMM_ALL_ = SUMM_ALL_ + SALES_COMM;'
      '1106023337=    ELSE'
      '1106023338=      SALES_COMM_ALL_ = SALES_COMM_ALL_ + SALES_COMM;'
      '1106023339='
      '1106023340=    SUSPEND;'
      '1106023341=  END'
      '1106023342=WHEN ANY DO BEGIN'
      '1106023343=    Err_code = -20500;'
      
        '1106023344=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'!'#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      
        '1106023345=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106023346=  END'
      '1106023347=end'
      '1106023348=;'
      '1106023349='
      '1106023350=ALTER PROCEDURE P_REP_PRIHOD('
      '1106023351=  DATE_BEGIN_ DATE,'
      '1106023352=  DATE_END_ DATE,'
      '1106023353=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '1106023354=RETURNS ('
      '1106023355=  PERIOD_ VARCHAR(40),'
      
        '1106023356=  P_REP_PRIHOD_TABLE TYPE OF COLUMN P_REP_PRIHOD_TABL' +
        'E.P_REP_PRIHOD_TABLE,'
      
        '1106023357=  TOVAR_NAME TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR_' +
        'NAME,'
      '1106023358=  AMOUNT TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT,'
      
        '1106023359=  POSTAVSHIK TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTAV' +
        'SHIK,'
      
        '1106023360=  SELF_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_P' +
        'RICE,'
      
        '1106023361=  SELF_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_SU' +
        'MM,'
      
        '1106023362=  SELF_PRICE_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF' +
        '_PRICE_B,'
      
        '1106023363=  SELF_SUMM_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'SUMM_B,'
      '1106023364=  IS_HEAD TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD,'
      '1106023365=  ERR_CODE INTEGER,'
      '1106023366=  ERR_MSG VARCHAR(1024))'
      '1106023367=AS'
      '1106023368=/*'
      '1106023369='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1106023370='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1106023371='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1106023372='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1106023373='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1106023374='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1106023375='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1106023376=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1106023377=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1106023378=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1106023379='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1106023380='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1106023381=*/'
      
        '1106023382=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD' +
        #39';'
      '1106023383=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106023384=DECLARE VARIABLE SUM_NAL_ NUMERIC(15,2) = 0;'
      '1106023385=DECLARE VARIABLE SUM_BEZNAL_ NUMERIC(15,2) = 0;'
      '1106023386=DECLARE VARIABLE AMOUNT_CATEGORY_ MY_NUMERIC_5 = 0;'
      '1106023387=DECLARE VARIABLE SUM_NAL_CATEGORY_ NUMERIC(15,2) = 0;'
      
        '1106023388=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ NUMERIC(15,2) =' +
        ' 0;'
      '1106023389=DECLARE VARIABLE SUM_FACT_NAL_ALL_ NUMERIC(15,2) = 0;'
      
        '1106023390=DECLARE VARIABLE SUM_FACT_BEZNAL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      '1106023391=DECLARE VARIABLE PRICE_NAL_ NUMERIC(15,2) = 0;'
      '1106023392=DECLARE VARIABLE PRICE_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '1106023393=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1106023394=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      '1106023395=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1106023396=DECLARE VARIABLE AMOUNT_CATEGORY_ALL_ MY_NUMERIC_5 = ' +
        '0;'
      
        '1106023397=DECLARE VARIABLE SUM_NAL_CATEGORY_ALL_ NUMERIC(15,2) ' +
        '= 0;'
      
        '1106023398=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ALL_ NUMERIC(15,' +
        '2) = 0;'
      
        '1106023399=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '1106023400=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      '1106023401=DECLARE VARIABLE I INTEGER = 1;'
      '1106023402=BEGIN'
      
        '1106023403=  DELETE FROM P_REP_PRIHOD_TABLE WHERE P_REP_PRIHOD_T' +
        'ABLE = P_REP_PRIHOD_TABLE;'
      '1106023404='
      
        '1106023405=  FOR SELECT DECODE(GP.g_product, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', G' +
        'P.NAME),'
      '1106023406=             GP.G_PRODUCT'
      '1106023407=       FROM G_PRODUCT GP'
      '1106023408=      WHERE IS_CATEGORY = 1'
      '1106023409=        AND EXISTS (SELECT 1'
      
        '1106023410=                      FROM SKLAD_PARENT Z, SKLAD ZD, ' +
        'G_PRODUCT G'
      
        '1106023411=                     WHERE :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1106023412=                       AND Z.SKLAD =  ZD.SKLAD_PARENT'
      '1106023413=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1106023414=                       AND G.G_PRODUCT_PAR = GP.G_PRO' +
        'DUCT'
      '1106023415=                       AND Z.IS_VOZVRAT = 0'
      '1106023416=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106023417=                       AND Z.DATE_RECEIPT BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_)'
      '1106023418=      ORDER BY 1'
      '1106023419=  INTO :RECCAT_NAME_,'
      '1106023420=       :RECCAT_PRODUCT_'
      '1106023421=  DO BEGIN'
      '1106023422=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106023423=    insert into P_REP_PRIHOD_TABLE'
      '1106023424=      (P_REP_PRIHOD_TABLE, tovar_name, IS_HEAD)'
      '1106023425=    values'
      '1106023426=      (:I, :RECCAT_NAME_, 1);'
      '1106023427='
      '1106023428=    I = I + 1;'
      '1106023429='
      '1106023430=    FOR SELECT G.NAME,'
      '1106023431=               SD.AMOUNT,'
      '1106023432=               C.NAME CLIENT_NAME,'
      
        '1106023433=               DECODE(S.G_PAYMENT_TYPE, 1, SD.PRICE, ' +
        '0) PRICE_NAL,'
      
        '1106023434=               DECODE(S.G_PAYMENT_TYPE, 1, SD.SUMM, 0' +
        ') SUMM_NAL,'
      
        '1106023435=               DECODE(S.G_PAYMENT_TYPE, 2, SD.PRICE, ' +
        '0) PRICE_BEZNAL,'
      
        '1106023436=               DECODE(S.G_PAYMENT_TYPE, 2, SD.SUMM, 0' +
        ') SUMM_BEZNAL'
      
        '1106023437=          FROM SKLAD_PARENT S LEFT OUTER JOIN G_CLIEN' +
        'T C ON S.G_CLIENT = C.G_CLIENT,'
      '1106023438=               SKLAD SD,'
      '1106023439=               G_PRODUCT G'
      
        '1106023440=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOC' +
        'HKA||'#39'-'#39
      '1106023441=           AND S.SKLAD = SD.SKLAD_PARENT'
      '1106023442=           AND SD.G_PRODUCT = G.G_PRODUCT'
      
        '1106023443=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '1106023444=           AND S.IS_VOZVRAT = 0'
      '1106023445=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106023446=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1106023447=        ORDER BY G.G_PRODUCT_PAR, S.DATE_RECEIPT, S.S' +
        'KLAD, SD.SKLAD, G.NAME'
      '1106023448=    INTO :TOVAR_NAME_,'
      '1106023449=         :AMOUNT_,'
      '1106023450=         :CLIENT_NAME_,'
      '1106023451=         :PRICE_NAL_,'
      '1106023452=         :SUM_NAL_,'
      '1106023453=         :PRICE_BEZNAL_,'
      '1106023454=         :SUM_BEZNAL_'
      '1106023455=    DO BEGIN'
      
        '1106023456=      INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TA' +
        'BLE, TOVAR_NAME, AMOUNT, POSTAVSHIK, SELF_PRICE, SELF_SUMM, SELF' +
        '_PRICE_B,'
      
        '1106023457=                                      SELF_SUMM_B, IS' +
        '_HEAD)'
      
        '1106023458=      VALUES (:I, :TOVAR_NAME_, :AMOUNT_, :CLIENT_NAM' +
        'E_, :PRICE_NAL_, :SUM_NAL_, :PRICE_BEZNAL_, :SUM_BEZNAL_, 0);'
      '1106023459='
      '1106023460=      I = I +1;'
      '1106023461='
      
        '1106023462=      AMOUNT_CATEGORY_ = AMOUNT_CATEGORY_ + COALESCE(' +
        'AMOUNT_, 0);'
      
        '1106023463=      SUM_NAL_CATEGORY_ = SUM_NAL_CATEGORY_ + COALESC' +
        'E(SUM_NAL_, 0);'
      
        '1106023464=      SUM_BEZNAL_CATEGORY_ = SUM_BEZNAL_CATEGORY_ + C' +
        'OALESCE(SUM_BEZNAL_, 0);'
      '1106023465=    END'
      '1106023466='
      '1106023467=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106023468=    INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABL' +
        'E, TOVAR_NAME, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '1106023469=    VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :AMOUNT_CATEGOR' +
        'Y_, :SUM_NAL_CATEGORY_, :SUM_BEZNAL_CATEGORY_, 2);'
      '1106023470='
      '1106023471='
      
        '1106023472=    AMOUNT_CATEGORY_ALL_ = AMOUNT_CATEGORY_ALL_ + AMO' +
        'UNT_CATEGORY_;'
      
        '1106023473=    SUM_NAL_CATEGORY_ALL_ = SUM_NAL_CATEGORY_ALL_ + S' +
        'UM_NAL_CATEGORY_;'
      
        '1106023474=    SUM_BEZNAL_CATEGORY_ALL_ = SUM_BEZNAL_CATEGORY_AL' +
        'L_ + SUM_BEZNAL_CATEGORY_;'
      '1106023475='
      '1106023476=    AMOUNT_CATEGORY_ = 0;'
      '1106023477=    SUM_NAL_CATEGORY_ = 0;'
      '1106023478=    SUM_BEZNAL_CATEGORY_  = 0;'
      '1106023479='
      '1106023480=    I = I + 1;'
      '1106023481=  END'
      '1106023482='
      '1106023483=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '1106023484=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE,' +
        ' TOVAR_NAME, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '1106023485=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :AMOUNT_CATEGORY_ALL_, :SUM_NA' +
        'L_CATEGORY_ALL_, :SUM_BEZNAL_CATEGORY_ALL_, 3);'
      '1106023486='
      '1106023487=  I = I + 1;'
      '1106023488='
      '1106023489=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1059#1055#1051#1040#1063#1045#1053#1054
      '1106023490=  SELECT COALESCE(SUM(S.SUMM_FACT), 0)'
      '1106023491=    FROM SKLAD_PARENT S'
      
        '1106023492=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      '1106023493=     AND S.G_PAYMENT_TYPE = 1'
      '1106023494=     AND S.IS_VOZVRAT = 0'
      
        '1106023495=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1106023496=    INTO :SUM_FACT_NAL_ALL_;'
      '1106023497='
      '1106023498=  SELECT COALESCE(SUM(S.SUMM_FACT), 0)'
      '1106023499=    FROM SKLAD_PARENT S'
      
        '1106023500=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      '1106023501=     AND S.G_PAYMENT_TYPE = 2'
      '1106023502=     AND S.IS_VOZVRAT = 0'
      
        '1106023503=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1106023504=    INTO :SUM_FACT_BEZNAL_ALL_;'
      '1106023505='
      
        '1106023506=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE,' +
        ' TOVAR_NAME, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '1106023507=  VALUES (:I, '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077#1085#1086#39', :SUM_FACT_NAL_ALL_,' +
        ' :SUM_FACT_BEZNAL_ALL_, 1);'
      '1106023508='
      
        '1106023509=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1106023510=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1106023511='
      
        '1106023512=  FOR SELECT P_REP_PRIHOD_TABLE, TOVAR_NAME, AMOUNT, ' +
        'POSTAVSHIK, SELF_PRICE, SELF_SUMM, SELF_PRICE_B, SELF_SUMM_B,'
      '1106023513=             IS_HEAD'
      '1106023514=      FROM P_REP_PRIHOD_TABLE'
      
        '1106023515=      INTO :P_REP_PRIHOD_TABLE, :TOVAR_NAME, :AMOUNT,' +
        ' :POSTAVSHIK, :SELF_PRICE, :SELF_SUMM, :SELF_PRICE_B, :SELF_SUMM' +
        '_B, :IS_HEAD'
      '1106023516=  DO'
      '1106023517=    suspend;'
      '1106023518='
      '1106023519=WHEN ANY DO BEGIN'
      '1106023520=    Err_code = -20500;'
      
        '1106023521=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106023522=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106023523=  END'
      '1106023524=end'
      '1106023525=;'
      '1106023526='
      '1106023527=ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      '1106023528=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106023529=  CURRENCY_ INTEGER)'
      '1106023530=RETURNS ('
      '1106023531=  NUMBER_STR_ VARCHAR(200),'
      '1106023532=  ROW_NUM INTEGER,'
      '1106023533=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106023534=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106023535=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1106023536=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1106023537=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1106023538=  AMOUNT MY_NUMERIC_5,'
      '1106023539=  PRICE_N VARCHAR(50),'
      '1106023540=  SUMM_N VARCHAR(50),'
      '1106023541=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1106023542=  SUMM_VSEGO_ VARCHAR(50),'
      '1106023543=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106023544=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1106023545=  SUMM_STR_ VARCHAR(500),'
      '1106023546=  ERR_CODE NUMERIC(15,2),'
      '1106023547=  ERR_MSG VARCHAR(1024))'
      '1106023548=AS'
      '1106023549=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '1106023550=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD' +
        '_WAYBILL'#39';'
      '1106023551=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106023552=DECLARE VARIABLE I INTEGER = 1;'
      
        '1106023553=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1106023554=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      '1106023555=BEGIN'
      '1106023556='
      
        '1106023557=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.sklad||'#39' '#1086#1090' '#39'||lpad(EXTRACT' +
        '(DAY FROM P.date_receipt), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM' +
        ' P.date_receipt), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.date_receipt),'
      '1106023558=         G.name,'
      '1106023559=         P.IS_VOZVRAT'
      
        '1106023560=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON' +
        ' P.g_client = G.G_CLIENT'
      '1106023561=   WHERE P.sklad = :sklad_parent_'
      '1106023562=    INTO :NUMBER_STR_,'
      '1106023563=         :POSTAVSHIK_NAME_,'
      '1106023564=         :IS_VOZVRAT_;'
      '1106023565='
      
        '1106023566=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058 +
        #1068' '#1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      '1106023567=  IF (IS_VOZVRAT_ = 3) THEN'
      '1106023568=    SELECT G.NAME'
      '1106023569=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '1106023570=     WHERE P.SKLAD = :sklad_parent_'
      '1106023571=       AND P.G_TOCHKA = G.G_TOCHKA'
      '1106023572=      INTO :POSTAVSHIK_NAME_;'
      '1106023573='
      
        '1106023574=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1106023575=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39 +
        '.'#39', '#39','#39')'
      
        '1106023576=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.sum' +
        'm), :CURRENCY_))'
      '1106023577=    FROM SKLAD S'
      '1106023578=   WHERE S.sklad_parent = :sklad_parent_'
      '1106023579=   GROUP BY S.sklad_parent'
      '1106023580=    INTO :AMOUNT_VSEGO_,'
      '1106023581=         :SUMM_VSEGO_,'
      '1106023582=         :summ_str_;'
      '1106023583='
      '1106023584=  SELECT NAME'
      '1106023585=    FROM CUR_PARAMS'
      '1106023586=   WHERE CUR_PARAMS = 1'
      '1106023587=    INTO :G_OFFICIAL_FM_;'
      '1106023588='
      '1106023589=  FOR SELECT :I,'
      '1106023590=             G.name,'
      '1106023591=             G.ARTICUL,'
      '1106023592=             G.BARCODE,'
      '1106023593=             G.NOMENCLATUR_NUM,'
      '1106023594=             U.short_name,'
      
        '1106023595=             S.amount,    --REPLACE(CAST(S.amount AS ' +
        'VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1106023596=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39'.' +
        #39', '#39','#39'),'
      
        '1106023597=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39'.'#39 +
        ', '#39','#39')'
      '1106023598=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '1106023599=       WHERE S.sklad_parent = :sklad_parent_'
      '1106023600=         AND S.g_product = G.g_product'
      '1106023601=         AND G.g_unit = U.g_unit'
      '1106023602=        INTO :ROW_NUM,'
      '1106023603=            :NAME,'
      '1106023604=            :ARTICUL,'
      '1106023605=            :BARCODE,'
      '1106023606=            :NOMENCLATUR_NUM,'
      '1106023607=            :SHORT_NAME,'
      '1106023608=            :AMOUNT,'
      '1106023609=            :PRICE_N,'
      '1106023610=            :SUMM_N'
      '1106023611=  DO BEGIN'
      '1106023612=    I = I + 1;'
      '1106023613=    SUSPEND;'
      '1106023614=  END'
      '1106023615=WHEN ANY DO BEGIN'
      '1106023616=    Err_code = -20500;'
      
        '1106023617=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106023618=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106023619=  END'
      '1106023620=end'
      '1106023621=;'
      '1106023622='
      '1106023623=ALTER PROCEDURE P_REP_PRODAZHA_WAYBILL('
      '1106023624=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106023625=  CURRENCY_ INTEGER)'
      '1106023626=RETURNS ('
      '1106023627=  NUMBER_STR_ VARCHAR(200),'
      '1106023628=  ROW_NUM INTEGER,'
      '1106023629=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106023630=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106023631=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106023632=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1106023633=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1106023634=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1106023635=  AMOUNT MY_NUMERIC_5,'
      '1106023636=  PRICE_N VARCHAR(50),'
      '1106023637=  SUMM_N VARCHAR(50),'
      '1106023638=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1106023639=  SUMM_VSEGO_ VARCHAR(50),'
      '1106023640=  NDS_SUMM_ VARCHAR(50),'
      '1106023641=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106023642=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1106023643=  SUMM_STR_ VARCHAR(500),'
      '1106023644=  NDS_SUMM_STR_ VARCHAR(500),'
      '1106023645=  ERR_CODE NUMERIC(15,2),'
      '1106023646=  ERR_MSG VARCHAR(1024))'
      '1106023647=AS'
      '1106023648=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '1106023649=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRODAZ' +
        'HA_WAYBILL'#39';'
      '1106023650=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106023651=DECLARE VARIABLE I INTEGER = 1;'
      
        '1106023652=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1106023653=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S_SUMM;'
      '1106023654=BEGIN'
      '1106023655='
      
        '1106023656=  SELECT decode(P.is_spisanie, 1, '#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39', '#39#1053#1072#1082#1083#1072 +
        #1076#1085#1072#1103' '#8470#39'||P.ZAKAZ)||'#39' '#1086#1090' '#39'||lpad(EXTRACT(DAY FROM P.z_date), 2, '#39 +
        '0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39'.'#39'||EXTRACT' +
        '(YEAR FROM P.z_date),'
      '1106023657=         G.name'
      '1106023658=    FROM ZAKAZ P,'
      '1106023659=         G_CLIENT G'
      '1106023660=   WHERE P.ZAKAZ = :ZAKAZ_'
      '1106023661=     AND P.g_client = G.G_CLIENT'
      '1106023662=    INTO :NUMBER_STR_,'
      '1106023663=         :CLIENT_NAME_;'
      '1106023664='
      
        '1106023665=  SELECT SUM(S.amount)--REPLACE(CAST(SUM(S.amount) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1106023666=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39 +
        '.'#39', '#39','#39')'
      
        '1106023667=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.sum' +
        'm), :CURRENCY_))'
      
        '1106023668=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39')'
      '1106023669=         ,SUM(S.nds_summ)'
      '1106023670=    FROM ZAKAZ_DETAILS S'
      '1106023671=   WHERE S.ZAKAZ = :ZAKAZ_'
      '1106023672=   GROUP BY S.ZAKAZ'
      '1106023673=    INTO :AMOUNT_VSEGO_,'
      '1106023674=         :SUMM_VSEGO_,'
      '1106023675=         :summ_str_,'
      '1106023676=         :NDS_SUMM_,'
      '1106023677=         :NDS_;'
      '1106023678='
      '1106023679=  if (NDS_ > 0) then'
      
        '1106023680=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENC' +
        'YSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '1106023681='
      '1106023682=  SELECT NAME'
      '1106023683=    FROM CUR_PARAMS'
      '1106023684=   WHERE CUR_PARAMS = 1'
      '1106023685=    INTO :G_OFFICIAL_FM_;'
      '1106023686='
      '1106023687=  FOR SELECT :I,'
      '1106023688=             C.NAME,'
      '1106023689=             G.name,'
      '1106023690=             G.ARTICUL,'
      '1106023691=             G.BARCODE,'
      '1106023692=             G.NOMENCLATUR_NUM,'
      '1106023693=             U.short_name,'
      
        '1106023694=             S.amount,--REPLACE(CAST(S.amount AS VARC' +
        'HAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1106023695=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39'.' +
        #39', '#39','#39'),'
      
        '1106023696=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39'.'#39 +
        ', '#39','#39')'
      
        '1106023697=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, ' +
        'G_PRODUCT C'
      '1106023698=       WHERE S.ZAKAZ = :ZAKAZ_'
      '1106023699=         AND S.g_product = G.g_product'
      '1106023700=         AND G.g_unit = U.g_unit'
      '1106023701=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '1106023702=        INTO :ROW_NUM,'
      '1106023703=            :CATEGORY_NAME,'
      '1106023704=            :NAME,'
      '1106023705=            :ARTICUL,'
      '1106023706=            :BARCODE,'
      '1106023707=            :NOMENCLATUR_NUM,'
      '1106023708=            :SHORT_NAME,'
      '1106023709=            :AMOUNT,'
      '1106023710=            :PRICE_N,'
      '1106023711=            :SUMM_N'
      '1106023712=  DO BEGIN'
      '1106023713=    I = I + 1;'
      '1106023714=    SUSPEND;'
      '1106023715=  END'
      '1106023716=WHEN ANY DO BEGIN'
      '1106023717=    Err_code = -20500;'
      
        '1106023718=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106023719=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106023720=  END'
      '1106023721=end'
      '1106023722=;'
      '1106023723='
      '1106023724=ALTER PROCEDURE P_REP_ZAYAVKA_POSTAVSHIK('
      '1106023725=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106023726=  BEGIN_DATE_ DATE,'
      '1106023727=  END_DATE_ DATE,'
      '1106023728=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1106023729=  DO_SKLAD_ INTEGER,'
      '1106023730=  MODE_ INTEGER,'
      '1106023731=  MODE_VYBOR_ INTEGER,'
      '1106023732=  MODE_VAL_ INTEGER,'
      '1106023733=  NEW_VAL_ MY_NUMERIC_5,'
      '1106023734=  ROUND_MODE_ INTEGER)'
      '1106023735=RETURNS ('
      '1106023736=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1106023737=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '1106023738=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106023739=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106023740=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1106023741=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1106023742=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1106023743=  ERR_CODE INTEGER,'
      '1106023744=  ERR_MSG VARCHAR(1024))'
      '1106023745=AS'
      '1106023746=/*'
      
        '1106023747='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057 +
        #1056#1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '1106023748='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055 +
        #1054#1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '1106023749=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055 +
        #1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '1106023750=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 -' +
        ' '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '1106023751=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058 +
        #1054#1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045 +
        ' '#1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1106023752=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '1106023753=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067 +
        #1042#1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      
        '1106023754=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' *' +
        '/'
      '1106023755=DECLARE VARIABLE ROUND_ INTEGER;'
      '1106023756=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '1106023757=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      
        '1106023758=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PA' +
        'RENT;'
      '1106023759=BEGIN'
      '1106023760=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1106023761='
      '1106023762=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106023763=    SELECT ID'
      '1106023764=      FROM CUR_PARAMS'
      '1106023765=     WHERE CUR_PARAMS = 2'
      '1106023766=      INTO :G_TOCHKA_;'
      '1106023767='
      '1106023768=  IF (ROUND_MODE_ = 0) THEN'
      '1106023769=      ROUND_ = 0;'
      '1106023770=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '1106023771=      ROUND_ = -1;'
      '1106023772=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '1106023773=      ROUND_ = -2;'
      '1106023774=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '1106023775=      ROUND_ = -3;'
      '1106023776=  ELSE IF (ROUND_MODE_ = -1) THEN'
      '1106023777=      ROUND_ = 5;'
      '1106023778='
      
        '1106023779=  SQL_STR_ = '#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39';'
      '1106023780='
      
        '1106023781=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040 +
        ' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1106023782=  IF (MODE_ = 0) THEN BEGIN'
      
        '1106023783=    SQL_STR_ = SQL_STR_ || '#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39';'
      '1106023784=    IF (MODE_VAL_ = 0) THEN'
      '1106023785=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1106023786=    ELSE'
      
        '1106023787=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1106023788='
      '1106023789=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1106023790=  END'
      '1106023791=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '1106023792=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '1106023793=    SQL_STR_ = SQL_STR_ || '#39'ROUND(ABS(LT.AMOUNT)'#39';'
      '1106023794=    IF (MODE_VAL_ = 0) THEN'
      '1106023795=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1106023796=    ELSE'
      
        '1106023797=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1106023798='
      '1106023799=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1106023800=  END'
      '1106023801='
      
        '1106023802=  SQL_STR_ = SQL_STR_ || '#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39'||'
      
        '1106023803=            '#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39';'
      '1106023804='
      '1106023805=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '1106023806=    SQL_STR_ = SQL_STR_ ||'#39'AND EXISTS (SELECT 1'#39'||'
      
        '1106023807=                                        '#39' FROM SKLAD ' +
        'S'#39'||'
      
        '1106023808=                                        '#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39'||'
      
        '1106023809=                                        '#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39'||'
      
        '1106023810=                                        '#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39';'
      '1106023811=    IF (MODE_VYBOR_ = 2) THEN'
      
        '1106023812=      SQL_STR_ = SQL_STR_ ||'#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39';'
      '1106023813=    ELSE'
      
        '1106023814=      SQL_STR_ = SQL_STR_ ||'#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053 +
        #1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042#1057 +
        #1045#1043#1044#1040
      '1106023815=    SQL_STR_ = SQL_STR_ ||'#39') '#39';'
      '1106023816=  END ELSE BEGIN'
      
        '1106023817=    SQL_STR_ = SQL_STR_ ||'#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39';  --' +
        ' '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '1106023818=  END'
      '1106023819='
      '1106023820=  IF (MODE_ = 0) THEN'
      
        '1106023821=    SQL_STR_ = SQL_STR_ || '#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39';'
      '1106023822=  ELSE IF (MODE_ = 1) THEN'
      '1106023823=    SQL_STR_ = SQL_STR_ || '#39' AND LT.AMOUNT < 0'#39';'
      
        '1106023824=  SQL_STR_ = SQL_STR_ || '#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39';'
      '1106023825='
      '1106023826=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '1106023827=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '1106023828=      FOR EXECUTE STATEMENT'
      
        '1106023829=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1106023830=          INTO :G_PRODUCT,'
      '1106023831=               :CATEGORY_NAME,'
      '1106023832=               :NAME,'
      '1106023833=               :ARTICUL,'
      '1106023834=               :AMOUNT_CUR,'
      '1106023835=               :MIN_AMOUNT,'
      '1106023836=               :AMOUNT_TO_ZAKAZ'
      '1106023837=        DO BEGIN'
      
        '1106023838=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_' +
        'PRODUCT, :G_TOCHKA_, 0)'
      '1106023839=              RETURNING_VALUES :COST_PRICE_;'
      '1106023840='
      
        '1106023841=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, ' +
        'AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1106023842=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_' +
        'PRODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO' +
        '_ZAKAZ, 0, 0);'
      '1106023843=        END'
      '1106023844='
      '1106023845=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1106023846=                                      CURRENT_DATE,'
      '1106023847=                                      CURRENT_TIME,'
      '1106023848=                                      :G_CLIENT_,'
      '1106023849=                                      1,'
      
        '1106023850=                                      NULL, --:OSNOVA' +
        'NIE__,'
      
        '1106023851=                                      NULL, --:NOTE__' +
        ','
      
        '1106023852=                                      0, --:IS_VOZVRA' +
        'T_,'
      
        '1106023853=                                      (SELECT SUM(S.S' +
        'UMM) FROM SKLAD_TMP S),'
      
        '1106023854=                                      0, -- :SUMM_FAC' +
        'T_'
      
        '1106023855=                                      0, --:G_PRIHOD_' +
        ','
      
        '1106023856=                                      0 --:SUMM_PRIHO' +
        'D_)'
      
        '1106023857=                                      ,NULL --PAYMENT' +
        'S'
      
        '1106023858=                                     )RETURNING_VALUE' +
        'S :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1106023859=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1106023860=          ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39'||ERR_MSG;'
      '1106023861=          EXIT;'
      '1106023862=        END'
      '1106023863=  END'
      '1106023864=  ELSE BEGIN'
      '1106023865=      FOR EXECUTE STATEMENT'
      
        '1106023866=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1106023867=      INTO :G_PRODUCT,'
      '1106023868=           :CATEGORY_NAME,'
      '1106023869=           :NAME,'
      '1106023870=           :ARTICUL,'
      '1106023871=           :AMOUNT_CUR,'
      '1106023872=           :MIN_AMOUNT,'
      '1106023873=           :AMOUNT_TO_ZAKAZ'
      '1106023874=      DO SUSPEND;'
      '1106023875=  END'
      '1106023876=END'
      '1106023877=;'
      '1106023878='
      '1106023879=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1106023880=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106023881=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106023882=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106023883=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1106023884=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106023885=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106023886=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1106023887=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106023888=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1106023889=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED)'
      '1106023890=RETURNS ('
      '1106023891=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106023892=  ERR_CODE INTEGER,'
      '1106023893=  ERR_MSG VARCHAR(1024))'
      '1106023894=AS'
      
        '1106023895=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1106023896=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1106023897=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1106023898=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1106023899='
      
        '1106023900=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106023901=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1106023902=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106023903=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1106023904=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106023905=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1106023906=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1106023907=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1106023908=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1106023909=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1106023910=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1106023911=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1106023912=BEGIN'
      '1106023913='
      '1106023914=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106023915=    SELECT ID'
      '1106023916=      FROM CUR_PARAMS'
      '1106023917=     WHERE CUR_PARAMS = 2'
      '1106023918=      INTO :G_TOCHKA_;'
      '1106023919='
      
        '1106023920=  --*************************************************' +
        '*************************************************'
      
        '1106023921=  --*************************************************' +
        '*************************************************'
      '1106023922=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106023923=  --*************************************************' +
        '*************************************************'
      
        '1106023924=  --*************************************************' +
        '*************************************************'
      '1106023925=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1106023926=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1106023927=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1106023928=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1106023929=            INTO :AMOUNT_,'
      '1106023930=                 :G_PRODUCT_'
      '1106023931=      DO BEGIN'
      '1106023932=          UPDATE LT_SKLAD_PRODUCT L'
      '1106023933=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1106023934=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106023935=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106023936=      END'
      '1106023937='
      '1106023938=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1106023939=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1106023940=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1106023941=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1106023942=             NDS_SUMM, COST_PRICE'
      '1106023943=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1106023944='
      '1106023945=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1106023946=                                  :Z_DATE_,'
      '1106023947=                                  :Z_TIME_,'
      '1106023948=                                  :G_CLIENT_,'
      '1106023949=                                  :G_PAYMENT_TYPE_,'
      '1106023950=                                  :OSNOVANIE_,'
      
        '1106023951=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1106023952=                                  :NOTE_,'
      
        '1106023953=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1106023954=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1106023955=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1106023956=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1106023957=                                  0, --SUMM_BONUS_'
      
        '1106023958=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1106023959=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1106023960=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1106023961=                                  0,    --BY_RECIPE'
      '1106023962=                                  0     --IS_RESERVE'
      '1106023963=                                  ,NULL  -- PAYMENTS_'
      '1106023964=                                  )'
      '1106023965=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1106023966='
      '1106023967=      if (ERR_CODE <> 0) then BEGIN'
      '1106023968=        ERR_CODE = -20500;'
      '1106023969=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1106023970=        Exit;'
      '1106023971=      END'
      '1106023972='
      
        '1106023973=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1106023974=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1106023975=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1106023976=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1106023977=      UPDATE ZAKAZ'
      '1106023978=         SET IS_SPISANIE = 2'
      '1106023979=       WHERE ZAKAZ = :ZAKAZ_;'
      '1106023980='
      
        '1106023981=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1106023982=      FOR SELECT T.AMOUNT,'
      '1106023983=                 T.SUMM,'
      '1106023984=                 T.G_PRODUCT,'
      '1106023985=                 T.ZAKAZ_NA_REAL,'
      '1106023986=                 T.ZAKAZ_DETAILS'
      '1106023987=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1106023988=            INTO :AMOUNT_,'
      '1106023989=                 :Z_SUMM_,'
      '1106023990=                 :G_PRODUCT_,'
      '1106023991=                 :ZAKAZ_NA_REAL_,'
      '1106023992=                 :ZAKAZ_DETAILS_'
      '1106023993=      DO BEGIN'
      '1106023994=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1106023995=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1106023996=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1106023997=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1106023998=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106023999='
      
        '1106024000=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1106024001=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1106024002=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1106024003=      END'
      '1106024004=  END'
      '1106024005=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106024006=  --*************************************************' +
        '*************************************************'
      
        '1106024007=  --*************************************************' +
        '*************************************************'
      '1106024008='
      
        '1106024009=  --*************************************************' +
        '*************************************************'
      
        '1106024010=  --*************************************************' +
        '*************************************************'
      '1106024011=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106024012=  --*************************************************' +
        '*************************************************'
      
        '1106024013=  --*************************************************' +
        '*************************************************'
      '1106024014=  ELSE BEGIN'
      '1106024015=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1106024016=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1106024017=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1106024018=      FOR SELECT T.AMOUNT,'
      '1106024019=                 T.SUMM,'
      '1106024020=                 T.G_PRODUCT,'
      '1106024021=                 T.ZAKAZ_NA_REAL,'
      '1106024022=                 T.ZAKAZ_DETAILS'
      '1106024023=                 ,T.PRICE'
      '1106024024=                 ,T.NDS'
      '1106024025=                 ,T.NDS_SUMM'
      '1106024026=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1106024027=            INTO :AMOUNT_,'
      '1106024028=                 :Z_SUMM_,'
      '1106024029=                 :G_PRODUCT_,'
      '1106024030=                 :ZAKAZ_NA_REAL_,'
      '1106024031=                 :ZAKAZ_DETAILS_'
      '1106024032=                 ,:PRICE_'
      '1106024033=                 ,:NDS_'
      '1106024034=                 ,:NDS_SUMM_'
      '1106024035=      DO BEGIN'
      
        '1106024036=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1106024037=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1106024038='
      
        '1106024039=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1106024040=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1106024041='
      '1106024042=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1106024043=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1106024044=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1106024045=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1106024046=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106024047=      END'
      '1106024048='
      '1106024049=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1106024050=                                  :Z_DATE_,'
      '1106024051=                                  :Z_TIME_,'
      '1106024052=                                  :G_CLIENT_,'
      '1106024053=                                  :G_PAYMENT_TYPE_,'
      '1106024054=                                  :OSNOVANIE_,'
      '1106024055=                                  :NOTE_,'
      
        '1106024056=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1106024057=                                  :SUMM_,'
      '1106024058=                                  :SUMM_FACT_,'
      
        '1106024059=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1106024060=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1106024061=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1106024062=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1106024063='
      '1106024064=      if (ERR_CODE <> 0) then BEGIN'
      '1106024065=        ERR_CODE = -20500;'
      '1106024066=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1106024067=        Exit;'
      '1106024068=      END'
      '1106024069=  END'
      '1106024070=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106024071=  --*************************************************' +
        '*************************************************'
      
        '1106024072=  --*************************************************' +
        '*************************************************'
      '1106024073='
      '1106024074=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1106024075=END'
      '1106024076=;'
      '1106024077='
      '1106024078=ALTER PROCEDURE R_READ_REVISION_LIST'
      '1106024079=RETURNS ('
      '1106024080=  REVISION TYPE OF COLUMN REVISION.REVISION,'
      '1106024081=  SKLAD TYPE OF COLUMN REVISION.SKLAD,'
      '1106024082=  G_PRODUCT TYPE OF COLUMN REVISION.G_PRODUCT,'
      '1106024083=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106024084=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106024085=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106024086=  AMOUNT_BD TYPE OF COLUMN REVISION.AMOUNT_BD,'
      '1106024087=  AMOUNT_REAL TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '1106024088=  IS_UNIFIED TYPE OF COLUMN REVISION.IS_UNIFIED)'
      '1106024089=AS'
      '1106024090=begin'
      '1106024091=  FOR'
      '1106024092=    SELECT R.REVISION,'
      '1106024093=           R.SKLAD,'
      '1106024094=           R.G_PRODUCT,'
      '1106024095=           G.NAME,'
      '1106024096=           G.BARCODE,'
      '1106024097=           G.ARTICUL,'
      '1106024098=           R.AMOUNT_BD,'
      '1106024099=           R.AMOUNT_REAL,'
      '1106024100=           R.IS_UNIFIED'
      '1106024101=    FROM REVISION R, G_PRODUCT G'
      '1106024102=   WHERE R.G_PRODUCT = G.G_PRODUCT'
      
        '1106024103=     AND R.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      '1106024104=   ORDER BY G.NAME'
      '1106024105=    into :REVISION,'
      '1106024106=         :SKLAD,'
      '1106024107=         :G_PRODUCT,'
      '1106024108=         :G_PRODUCT_NAME,'
      '1106024109=         :BARCODE,'
      '1106024110=         :ARTICUL,'
      '1106024111=         :AMOUNT_BD,'
      '1106024112=         :AMOUNT_REAL,'
      '1106024113=         :IS_UNIFIED'
      '1106024114=  DO'
      '1106024115=    suspend;'
      '1106024116=end'
      '1106024117=;'
      '1106024118='
      '1106024119=ALTER PROCEDURE R_UNIFICATION('
      '1106024120=  MODE_ INTEGER)'
      '1106024121=RETURNS ('
      '1106024122=  COUNT_SPIS_ INTEGER,'
      '1106024123=  COUNT_PRIH_ INTEGER,'
      '1106024124=  ERR_CODE INTEGER,'
      '1106024125=  ERR_MSG VARCHAR(1024))'
      '1106024126=AS'
      
        '1106024127=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1106024128=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106024129=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1106024130=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1106024131=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1106024132=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1106024133=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1106024134=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1106024135=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1106024136=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1106024137=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1106024138=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1106024139=BEGIN'
      '1106024140='
      '1106024141=  COUNT_SPIS_ = 0;'
      '1106024142=  COUNT_PRIH_ = 0;'
      '1106024143='
      '1106024144=  SELECT ID'
      '1106024145=    FROM CUR_PARAMS'
      '1106024146=   WHERE CUR_PARAMS = 2'
      '1106024147=    INTO :G_TOCHKA_;'
      '1106024148='
      
        '1106024149=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1106024150=      FROM REVISION'
      
        '1106024151=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1106024152=  DO BEGIN'
      
        '1106024153=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1106024154=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1106024155=        RETURNING_VALUES :COST_PRICE_;'
      '1106024156='
      
        '1106024157=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1106024158=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1106024159=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1106024160='
      '1106024161=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1106024162=    END'
      '1106024163='
      
        '1106024164=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1106024165=      SELECT S.PRICE'
      '1106024166=        FROM SKLAD S'
      '1106024167=       WHERE S.IS_LAST = 1'
      '1106024168=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1106024169=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1106024170=        INTO :PRICE_LAST_;'
      '1106024171='
      
        '1106024172=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1106024173='
      
        '1106024174=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1106024175=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1106024176='
      '1106024177=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1106024178=    END'
      '1106024179='
      '1106024180=    UPDATE REVISION R'
      '1106024181=       SET R.IS_UNIFIED = 1'
      '1106024182=     WHERE R.REVISION = :REVISION_;'
      '1106024183=  END'
      '1106024184='
      '1106024185=  PNT_ = '#39'01'#39';'
      '1106024186=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1106024187=    SELECT SUM(S.SUMM)'
      '1106024188=      FROM ZAKAZ_DETAILS_TMP S'
      '1106024189=      INTO :SUMM_;'
      '1106024190='
      '1106024191=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1106024192=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1106024193=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1106024194=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1106024195=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1106024196=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1106024197=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1106024198=                                NULL,           --:NO' +
        'TE_,'
      
        '1106024199=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1106024200=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1106024201=                                0,              --SUM' +
        'M_BONUS_'
      
        '1106024202=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1106024203=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1106024204=                                NULL,'
      
        '1106024205=                                0,        -- BY_RECIP' +
        'E'
      
        '1106024206=                                0         -- IS_RESER' +
        'VE'
      '1106024207=                                ,NULL  -- PAYMENTS_'
      '1106024208=                                ,0     -- SUMM_CASH'
      
        '1106024209=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1106024210=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1106024211=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106024212=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106024213=      EXIT;'
      '1106024214=    END'
      '1106024215=  END'
      '1106024216='
      '1106024217=  PNT_ = '#39'02'#39';'
      '1106024218=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1106024219=    SELECT SUM(S.SUMM)'
      '1106024220=      FROM SKLAD_TMP S'
      '1106024221=      INTO :SUMM_;'
      '1106024222='
      '1106024223=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1106024224=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1106024225=                                CURRENT_TIME,'
      
        '1106024226=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1106024227=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1106024228=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1106024229=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1106024230=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1106024231=                                :SUMM_,'
      '1106024232=                                :SUMM_,'
      
        '1106024233=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1106024234=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1106024235=                                ,NULL  --PAYMENTS'
      '1106024236=                                )'
      
        '1106024237=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1106024238=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106024239=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106024240=      EXIT;'
      '1106024241=    END'
      '1106024242=  END'
      '1106024243=END'
      '1106024244=;'
      '1106024245='
      '1106024246=ALTER PROCEDURE R_UPD_REVISION('
      '1106024247=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '1106024248=  AMOUNT_REAL_ TYPE OF COLUMN REVISION.AMOUNT_REAL)'
      '1106024249=RETURNS ('
      '1106024250=  ERR_CODE INTEGER,'
      '1106024251=  ERR_MSG VARCHAR(1024))'
      '1106024252=AS'
      '1106024253=begin'
      '1106024254=   UPDATE REVISION'
      '1106024255=   SET AMOUNT_REAL = :AMOUNT_REAL_'
      '1106024256=   WHERE REVISION = :REVISION_;'
      '1106024257=end'
      '1106024258=;'
      '1106024259='
      '1106024260=ALTER PROCEDURE READ_SKLAD_LIST('
      '1106024261=  DATE_BEGIN_ DATE,'
      '1106024262=  DATE_END_ DATE,'
      '1106024263=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106024264=  IS_VOZVRAT_ INTEGER)'
      '1106024265=RETURNS ('
      '1106024266=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '1106024267=  SKLAD_PARENT TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106024268=  DATE_RECEIPT TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '1106024269=  G_PRODUCT TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1106024270=  AMOUNT TYPE OF COLUMN SKLAD.AMOUNT,'
      '1106024271=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '1106024272=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1106024273=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1106024274=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1106024275=  NDS TYPE OF COLUMN SKLAD.NDS,'
      '1106024276=  NDS_SUMM TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1106024277=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1106024278=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1106024279=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106024280=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106024281=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106024282=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1106024283=  IS_VOZVRAT TYPE OF COLUMN SKLAD.IS_VOZVRAT)'
      '1106024284=AS'
      '1106024285=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1106024286=BEGIN'
      '1106024287='
      '1106024288=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1106024289=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1106024290=      IF (sklad_parent_ is null) THEN begin'
      '1106024291=        SELECT COUNT(*)'
      '1106024292=          FROM SKLAD_PARENT T'
      
        '1106024293=         WHERE T.date_receipt BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1106024294=          AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '1106024295=          AND T.IS_vozvrat <> 3'
      '1106024296=          INTO CNT_;'
      '1106024297='
      '1106024298=        if (CNT_ = 0) then'
      '1106024299=          SELECT MAX(T.date_receipt)'
      '1106024300=            FROM SKLAD_PARENT T'
      '1106024301=           WHERE T.date_receipt < :DATE_BEGIN_'
      '1106024302=             AND T.IS_vozvrat <> 3'
      
        '1106024303=             AND T.G_TOCHKA = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 2)'
      '1106024304=            INTO :DATE_BEGIN_;'
      '1106024305=      end'
      '1106024306='
      '1106024307=      FOR SELECT T.sklad sklad_detail,'
      '1106024308=               T.SKLAD_PARENT sklad,'
      '1106024309=               T.date_receipt,'
      '1106024310=               T.g_product,'
      '1106024311=               T.amount,'
      '1106024312=               T.PRICE,'
      '1106024313=               T.SUMM,'
      '1106024314=               T.PRICE_CURRENCY,'
      '1106024315=               T.SUMM_CURRENCY,'
      '1106024316=               T.nds,'
      '1106024317=               T.nds_summ,'
      '1106024318=               P.NAME PRODUCT_NAME,'
      '1106024319=               C.NAME CLIENT_NAME,'
      '1106024320=               PT.NAME PAYMENT_NAME,'
      '1106024321=               P.ARTICUL,'
      '1106024322=               P.NOMENCLATUR_NUM,'
      '1106024323=               P.BARCODE,'
      '1106024324=               T.IS_VOZVRAT'
      '1106024325=          FROM SKLAD T'
      
        '1106024326=               LEFT OUTER JOIN G_CLIENT C ON T.G_CLIE' +
        'NT = C.G_CLIENT'
      
        '1106024327=               LEFT OUTER JOIN G_PAYMENT_TYPE PT ON T' +
        '.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '1106024328=               G_PRODUCT P'
      
        '1106024329=         WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1106024330=           AND T.G_PRODUCT = P.G_PRODUCT'
      
        '1106024331=           AND ((T.IS_VOZVRAT = 0 AND :IS_VOZVRAT_ IS' +
        ' NULL)'
      
        '1106024332=                OR (T.IS_VOZVRAT IN (0, 5) AND :IS_VO' +
        'ZVRAT_ = 0)'
      
        '1106024333=                OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZ' +
        'VRAT_ IN (1,2))'
      '1106024334=               )'
      '1106024335=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1106024336=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1106024337=                OR'
      
        '1106024338=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1106024339=               )'
      '1106024340=        ORDER BY T.DATE_RECEIPT DESC'
      '1106024341=      INTO :sklad,'
      '1106024342=        :SKLAD_PARENT,'
      '1106024343=        :date_receipt,'
      '1106024344=        :g_product,'
      '1106024345=        :amount,'
      '1106024346=        :PRICE,'
      '1106024347=        :SUMM,'
      '1106024348=        :PRICE_CURRENCY,'
      '1106024349=        :SUMM_CURRENCY,'
      '1106024350=        :nds,'
      '1106024351=        :nds_summ,'
      '1106024352=        :PRODUCT_NAME,'
      '1106024353=        :CLIENT_NAME,'
      '1106024354=        :PAYMENT_NAME,'
      '1106024355=        :ARTICUL,'
      '1106024356=        :NOMENCLATUR_NUM,'
      '1106024357=        :BARCODE,'
      '1106024358=        :IS_VOZVRAT'
      '1106024359=      DO'
      '1106024360=        suspend;'
      '1106024361='
      '1106024362=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040
      '1106024363=  END ELSE BEGIN'
      '1106024364=    FOR SELECT T.SKLAD_PARENT,'
      '1106024365=               T.SKLAD,'
      '1106024366=               TR.DATE_RECEIPT,'
      '1106024367=               T.g_product,'
      '1106024368=               T.amount,'
      '1106024369=               T.PRICE,'
      '1106024370=               T.SUMM,'
      '1106024371=               P.NAME PRODUCT_NAME,'
      '1106024372=               G.NAME CLIENT_NAME,'
      '1106024373=               P.ARTICUL,'
      '1106024374=               P.NOMENCLATUR_NUM,'
      '1106024375=               P.BARCODE'
      
        '1106024376=          FROM SKLAD_PARENT TR LEFT OUTER JOIN G_TOCH' +
        'KA G ON TR.G_CLIENT = G.G_TOCHKA,'
      '1106024377=               SKLAD T,'
      '1106024378=               G_PRODUCT P'
      
        '1106024379=         WHERE TR.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '1106024380=           AND TR.SKLAD = T.SKLAD_PARENT'
      '1106024381=           AND T.G_PRODUCT = P.G_PRODUCT'
      '1106024382=           AND T.IS_VOZVRAT = 3'
      '1106024383=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1106024384=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1106024385=                OR'
      
        '1106024386=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1106024387=               )'
      '1106024388=        ORDER BY TR.SKLAD DESC'
      '1106024389=      INTO :sklad,'
      '1106024390=        :SKLAD_PARENT,'
      '1106024391=        :date_receipt,'
      '1106024392=        :g_product,'
      '1106024393=        :amount,'
      '1106024394=        :PRICE,'
      '1106024395=        :SUMM,'
      '1106024396=        :PRODUCT_NAME,'
      '1106024397=        :CLIENT_NAME,'
      '1106024398=        :ARTICUL,'
      '1106024399=        :NOMENCLATUR_NUM,'
      '1106024400=        :BARCODE'
      '1106024401=      DO'
      '1106024402=        suspend;'
      '1106024403=  END'
      '1106024404=end'
      '1106024405=;'
      '1106024406='
      '1106024407=ALTER PROCEDURE READ_SKLAD_LIST_FOR_REVIS'
      '1106024408=RETURNS ('
      '1106024409=  SKLAD_PARENT TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106024410=  STR VARCHAR(500))'
      '1106024411=AS'
      '1106024412=begin'
      '1106024413=  FOR SELECT T.SKLAD,'
      
        '1106024414=             /*CAST(T.SKLAD AS VARCHAR(50))||*/'#39#1086#1090' '#39'|' +
        '|lpad(EXTRACT(DAY FROM T.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRA' +
        'CT(MONTH FROM T.DATE_RECEIPT), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM T.D' +
        'ATE_RECEIPT)||'#39', '#1087#1086#1089#1090#1072#1074#1097#1080#1082' '#39'||COALESCE(G.NAME, '#39#1085#1077' '#1091#1089#1090#1072#1085#1086#1074#1083#1077#1085#39')'
      
        '1106024415=      FROM SKLAD_PARENT T LEFT OUTER JOIN G_client G ' +
        'ON T.G_CLIENT = G.G_CLIENT'
      
        '1106024416=     WHERE T.DATE_RECEIPT BETWEEN (CURRENT_DATE - 30)' +
        ' AND CURRENT_DATE'
      '1106024417=       AND T.IS_VOZVRAT = 0'
      
        '1106024418=       AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1106024419=    ORDER BY 2 DESC'
      '1106024420=  INTO :SKLAD_PARENT,'
      '1106024421=       :STR'
      '1106024422=  DO'
      '1106024423=    suspend;'
      '1106024424=end'
      '1106024425=;'
      '1106024426='
      '1106024427=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1106024428=RETURNS ('
      '1106024429=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1106024430=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '1106024431=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '1106024432=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '1106024433=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '1106024434=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1106024435=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1106024436=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '1106024437=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '1106024438=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106024439=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106024440=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106024441=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE)'
      '1106024442=AS'
      '1106024443=begin'
      '1106024444=  FOR'
      
        '1106024445=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T' +
        '.SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.PRICE, P.ARTICUL'
      '1106024446=           ,PRICE_CURRENCY'
      '1106024447=           ,SUMM_CURRENCY'
      '1106024448=    FROM SKLAD_TMP T,'
      '1106024449=         G_PRODUCT P'
      '1106024450=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1106024451=    ORDER BY T.sklad'
      
        '1106024452=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, ' +
        ':NDS, :NDS_SUMM, :NAME, :BARCODE, :PRODUCT_PRICE, :ARTICUL'
      '1106024453=      ,:PRICE_CURRENCY'
      '1106024454=      ,:SUMM_CURRENCY'
      '1106024455=  DO'
      '1106024456=    suspend;'
      '1106024457=end'
      '1106024458=;'
      '1106024459='
      '1106024460=ALTER PROCEDURE READ_SKLAD_PARENT_LIST('
      '1106024461=  DATE_BEGIN_ DATE,'
      '1106024462=  DATE_END_ DATE,'
      '1106024463=  IS_VOZVRAT_ INTEGER)'
      '1106024464=RETURNS ('
      '1106024465=  SKLAD TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      
        '1106024466=  DATE_RECEIPT TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      '1106024467=  G_CLIENT TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      '1106024468=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '1106024469=  G_PAYMENT_TYPE TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '1106024470=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1106024471=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '1106024472=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '1106024473=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1106024474=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1106024475=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '1106024476=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '1106024477=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106024478=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106024479=  DETAILS_STR VARCHAR(1000))'
      '1106024480=AS'
      '1106024481=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1106024482=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106024483=BEGIN'
      '1106024484='
      '1106024485=  SELECT ID'
      '1106024486=    FROM CUR_PARAMS'
      '1106024487=   WHERE CUR_PARAMS = 2'
      '1106024488=    INTO :G_TOCHKA_;'
      '1106024489='
      '1106024490=  SELECT COUNT(*)'
      '1106024491=    FROM SKLAD_PARENT T'
      
        '1106024492=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1106024493=     AND ((T.IS_VOZVRAT = :IS_VOZVRAT_ AND :IS_VOZVRA' +
        'T_ <> 1)'
      
        '1106024494=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1106024495=     AND T.G_TOCHKA = :G_TOCHKA_'
      '1106024496=    INTO CNT_;'
      '1106024497='
      '1106024498=  if (CNT_ = 0) then'
      '1106024499=    SELECT MAX(T.DATE_RECEIPT)'
      '1106024500=      FROM SKLAD_PARENT T'
      '1106024501=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1106024502=       AND ((T.IS_VOZVRAT = :IS_VOZVRAT_ AND :IS_VOZV' +
        'RAT_ <> 1)'
      
        '1106024503=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1106024504=       AND T.G_TOCHKA = :G_TOCHKA_'
      '1106024505=      INTO :DATE_BEGIN_;'
      '1106024506='
      '1106024507=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1106024508=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1106024509=      FOR'
      '1106024510=        SELECT T.SKLAD,'
      '1106024511=               T.DATE_RECEIPT,'
      '1106024512=               T.G_CLIENT,'
      '1106024513=               GC.NAME,'
      '1106024514=               T.G_PAYMENT_TYPE,'
      '1106024515=               PT.NAME,'
      
        '1106024516=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1106024517=                            FROM SKLAD D, G_PRODUCT G'
      
        '1106024518=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1106024519=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1106024520=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR,*/'
      '1106024521=               T.OSNOVANIE,'
      '1106024522=               T.NOTE,'
      '1106024523=               T.SUMM,'
      '1106024524=               T.SUMM_FACT,'
      '1106024525=               T.IS_PAYED_ALL,'
      '1106024526=               T.IS_VOZVRAT,'
      '1106024527=               T.g_official,'
      
        '1106024528=               COALESCE(GO.fio_doc, GO.FM||'#39' '#39'||GO.nm' +
        ')'
      '1106024529=          FROM SKLAD_PARENT T'
      
        '1106024530=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1106024531=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT' +
        ' ON T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '1106024532=                    LEFT OUTER JOIN G_OFFICIAL GO ON ' +
        'T.g_official = GO.G_OFFICIAL'
      
        '1106024533=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVR' +
        'AT_ = 0)'
      
        '1106024534=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZV' +
        'RAT_ = 1))'
      '1106024535=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '1106024536=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1106024537=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '1106024538=        INTO :SKLAD,'
      '1106024539=             :DATE_RECEIPT,'
      '1106024540=             :G_CLIENT,'
      '1106024541=             :CLIENT_NAME,'
      '1106024542=             :G_PAYMENT_TYPE,'
      '1106024543=             :PAYMENT_NAME,'
      '1106024544=             --:DETAILS_STR,'
      '1106024545=             :OSNOVANIE,'
      '1106024546=             :NOTE,'
      '1106024547=             :SUMM,'
      '1106024548=             :SUMM_FACT,'
      '1106024549=             :IS_PAYED_ALL,'
      '1106024550=             :IS_VOZVRAT,'
      '1106024551=             :G_OFFICIAL,'
      '1106024552=             :G_OFFICIAL_FIO'
      '1106024553=      DO'
      '1106024554=        suspend;'
      '1106024555='
      
        '1106024556=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1047#1044#1045#1057#1068' '#1044#1040#1053#1053#1067#1049' '#1057#1050#1051#1040#1044' '#1057#1058#1054#1048#1058 +
        ' '#1050#1040#1050' '#1050#1051#1048#1045#1053#1058', '#1040' '#1042' G_TOCHKA '#1057#1058#1054#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '1106024557=  END ELSE BEGIN'
      '1106024558=      FOR'
      '1106024559=        SELECT T.SKLAD,'
      '1106024560=               T.DATE_RECEIPT,'
      '1106024561=               T.G_TOCHKA,'
      '1106024562=               G.NAME,'
      
        '1106024563=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1106024564=                            FROM SKLAD D, G_PRODUCT G'
      
        '1106024565=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1106024566=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1106024567=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR, */'
      '1106024568=               T.OSNOVANIE,'
      '1106024569=               T.NOTE,'
      '1106024570=               T.SUMM'
      
        '1106024571=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHK' +
        'A G ON T.G_CLIENT = G.G_TOCHKA'
      '1106024572=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '1106024573=           AND T.IS_VOZVRAT = 3'
      
        '1106024574=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1106024575=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '1106024576=        INTO :SKLAD,'
      '1106024577=             :DATE_RECEIPT,'
      '1106024578=             :G_CLIENT,'
      '1106024579=             :CLIENT_NAME,'
      '1106024580=             --:DETAILS_STR,'
      '1106024581=             :OSNOVANIE,'
      '1106024582=             :NOTE,'
      '1106024583=             :SUMM'
      '1106024584=      DO'
      '1106024585=        suspend;'
      '1106024586=  END'
      '1106024587=end'
      '1106024588=;'
      '1106024589='
      '1106024590=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST('
      '1106024591=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106024592=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE)'
      '1106024593=RETURNS ('
      '1106024594=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '1106024595=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS,'
      '1106024596=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '1106024597=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106024598=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1106024599=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1106024600=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_PERC,'
      
        '1106024601=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1106024602=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1106024603=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1106024604=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1106024605=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106024606=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106024607=  ED_NAME TYPE OF COLUMN G_UNIT.NAME)'
      '1106024608=AS'
      '1106024609=begin'
      '1106024610='
      '1106024611=  FOR'
      '1106024612=    SELECT D.ZAKAZ,'
      '1106024613=           D.ZAKAZ_DETAILS,'
      '1106024614=           D.G_PRODUCT,'
      '1106024615=           D.AMOUNT,'
      '1106024616=           D.PRICE,'
      '1106024617=           D.SUMM,'
      '1106024618=           D.DISCOUNT_PERC,'
      '1106024619=           D.DISCOUNT_TENGE,'
      '1106024620=           D.DISCOUNT_SUMM,'
      '1106024621=           G.ARTICUL,'
      '1106024622=           G.NOMENCLATUR_NUM,'
      '1106024623=           G.BARCODE,'
      '1106024624=           G.NAME,'
      '1106024625=           COALESCE(GU.SHORT_NAME, GU.NAME)'
      '1106024626=      FROM ZAKAZ_DETAILS D,'
      '1106024627=           G_PRODUCT G,'
      '1106024628=           G_UNIT GU'
      '1106024629=     WHERE D.ZAKAZ = :ZAKAZ_'
      '1106024630=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1106024631=       AND G.G_UNIT = GU.G_UNIT'
      '1106024632=       AND :IS_SPISANIE_ <> 3'
      '1106024633=    UNION ALL'
      '1106024634=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '1106024635=           D.SKLAD ZAKAZ_DETAILS,'
      '1106024636=           D.G_PRODUCT,'
      '1106024637=           D.AMOUNT,'
      '1106024638=           D.PRICE,'
      '1106024639=           D.SUMM,'
      '1106024640=           0 DISCOUNT_PERC,'
      '1106024641=           0 DISCOUNT_TENGE,'
      '1106024642=           0 DISCOUNT_SUMM,'
      '1106024643=           G.ARTICUL,'
      '1106024644=           G.NOMENCLATUR_NUM,'
      '1106024645=           G.BARCODE,'
      '1106024646=           G.NAME,'
      '1106024647=           GU.NAME'
      '1106024648=      FROM SKLAD D,'
      '1106024649=           G_PRODUCT G,'
      '1106024650=           G_UNIT GU'
      '1106024651=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '1106024652=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1106024653=       AND G.G_UNIT = GU.G_UNIT'
      '1106024654=       AND :IS_SPISANIE_ = 3'
      '1106024655=    ORDER BY 1'
      '1106024656=    INTO  :ZAKAZ,'
      '1106024657=          :ZAKAZ_DETAILS,'
      '1106024658=          :G_PRODUCT,'
      '1106024659=          :AMOUNT,'
      '1106024660=          :PRICE,'
      '1106024661=          :SUMM,'
      '1106024662=          :DISCOUNT_PERC,'
      '1106024663=          :DISCOUNT_TENGE,'
      '1106024664=          :DISCOUNT_SUMM,'
      '1106024665=          :ARTICUL,'
      '1106024666=          :NOMENCLATUR_NUM,'
      '1106024667=          :BARCODE,'
      '1106024668=          :TOVAR_NAME,'
      '1106024669=          :ED_NAME'
      '1106024670=  DO'
      '1106024671=    suspend;'
      '1106024672=end'
      '1106024673=;'
      '1106024674='
      '1106024675=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_REAL('
      '1106024676=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106024677=  IS_VOZVRAT_ INTEGER)'
      '1106024678=RETURNS ('
      '1106024679=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '1106024680=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS,'
      '1106024681=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '1106024682=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106024683=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1106024684=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1106024685=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_PERC,'
      
        '1106024686=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1106024687=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1106024688=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1106024689=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106024690=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106024691=  ED_NAME TYPE OF COLUMN G_UNIT.NAME)'
      '1106024692=AS'
      '1106024693=begin'
      '1106024694=  FOR'
      '1106024695=    SELECT D.ZAKAZ,'
      '1106024696=           D.ZAKAZ_DETAILS,'
      '1106024697=           D.G_PRODUCT,'
      '1106024698=           D.AMOUNT,'
      '1106024699=           D.PRICE,'
      '1106024700=           D.SUMM,'
      '1106024701=           D.DISCOUNT_PERC,'
      '1106024702=           D.DISCOUNT_SUMM,'
      '1106024703=           G.ARTICUL,'
      '1106024704=           G.NOMENCLATUR_NUM,'
      '1106024705=           G.BARCODE,'
      '1106024706=           G.NAME,'
      '1106024707=           GU.NAME'
      '1106024708=      FROM ZAKAZ_DETAILS D,'
      '1106024709=           G_PRODUCT G,'
      '1106024710=           G_UNIT GU'
      '1106024711=     WHERE D.ZAKAZ = :ZAKAZ_'
      '1106024712=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1106024713=       AND G.G_UNIT = GU.G_UNIT'
      '1106024714=       AND :IS_VOZVRAT_ = 0'
      '1106024715=    UNION ALL'
      '1106024716=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '1106024717=           D.SKLAD ZAKAZ_DETAILS,'
      '1106024718=           D.G_PRODUCT,'
      '1106024719=           D.AMOUNT,'
      '1106024720=           D.PRICE,'
      '1106024721=           D.SUMM,'
      '1106024722=           0 DISCOUNT_PERC,'
      '1106024723=           0 DISCOUNT_SUMM,'
      '1106024724=           G.ARTICUL,'
      '1106024725=           G.NOMENCLATUR_NUM,'
      '1106024726=           G.BARCODE,'
      '1106024727=           G.NAME,'
      '1106024728=           GU.NAME'
      '1106024729=      FROM SKLAD D,'
      '1106024730=           G_PRODUCT G,'
      '1106024731=           G_UNIT GU'
      '1106024732=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '1106024733=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1106024734=       AND G.G_UNIT = GU.G_UNIT'
      '1106024735=       AND :IS_VOZVRAT_ = 1'
      '1106024736=    ORDER BY 2'
      '1106024737=    INTO  :ZAKAZ,'
      '1106024738=          :ZAKAZ_DETAILS,'
      '1106024739=          :G_PRODUCT,'
      '1106024740=          :AMOUNT,'
      '1106024741=          :PRICE,'
      '1106024742=          :SUMM,'
      '1106024743=          :DISCOUNT_PERC,'
      '1106024744=          :DISCOUNT_SUMM,'
      '1106024745=          :ARTICUL,'
      '1106024746=          :NOMENCLATUR_NUM,'
      '1106024747=          :BARCODE,'
      '1106024748=          :TOVAR_NAME,'
      '1106024749=          :ED_NAME'
      '1106024750=  DO'
      '1106024751=    suspend;'
      '1106024752=end'
      '1106024753=;'
      '1106024754='
      '1106024755=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1106024756=RETURNS ('
      
        '1106024757=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '1106024758=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '1106024759=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '1106024760=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1106024761=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1106024762=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1106024763=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '1106024764=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '1106024765=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1106024766=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1106024767=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106024768=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106024769=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL)'
      '1106024770=AS'
      '1106024771=begin'
      '1106024772='
      '1106024773=  FOR'
      '1106024774=    SELECT T.ZAKAZ_DETAILS,'
      '1106024775=           T.ZAKAZ,'
      '1106024776=           T.G_PRODUCT,'
      '1106024777=           T.AMOUNT,'
      '1106024778=           T.PRICE,'
      '1106024779=           T.SUMM,'
      '1106024780=           T.DISCOUNT_PERC,'
      '1106024781=           T.DISCOUNT_SUMM,'
      '1106024782=           T.NDS,'
      '1106024783=           T.NDS_SUMM,'
      '1106024784=           P.NAME PRODUCT_NAME'
      '1106024785=           ,P.BARCODE'
      '1106024786=           ,P.ARTICUL'
      '1106024787=      FROM ZAKAZ_DETAILS_TMP T,'
      '1106024788=           G_PRODUCT P'
      '1106024789=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1106024790=    ORDER BY t.ZAKAZ_DETAILS'
      '1106024791=    INTO :ZAKAZ_DETAILS,'
      '1106024792=          :ZAKAZ,'
      '1106024793=          :G_PRODUCT,'
      '1106024794=          :AMOUNT,'
      '1106024795=          :PRICE,'
      '1106024796=          :SUMM,'
      '1106024797=          :DISCOUNT_PERC,'
      '1106024798=          :DISCOUNT_SUMM,'
      '1106024799=          :NDS,'
      '1106024800=          :NDS_SUMM,'
      '1106024801=          :PRODUCT_NAME'
      '1106024802=          ,:BARCODE'
      '1106024803=          ,:ARTICUL'
      '1106024804=  DO'
      '1106024805=    suspend;'
      '1106024806=end'
      '1106024807=;'
      '1106024808='
      '1106024809=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '1106024810=  DATE_BEGIN_ DATE,'
      '1106024811=  DATE_END_ DATE,'
      '1106024812=  IS_SPISANIE_ INTEGER)'
      '1106024813=RETURNS ('
      '1106024814=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106024815=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106024816=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1106024817=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106024818=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106024819=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1106024820=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106024821=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106024822=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106024823=  DETAILS_STR VARCHAR(3000),'
      '1106024824=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1106024825=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1106024826=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '1106024827=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '1106024828=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1106024829=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106024830=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106024831=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1106024832=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1106024833=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1106024834=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '1106024835=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1106024836=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1106024837=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106024838=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC)'
      '1106024839=AS'
      '1106024840=/*'
      '1106024841=IS_SPISANIE_'
      '1106024842=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1106024843=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1106024844=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1106024845=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1106024846=*/'
      '1106024847=declare variable CNT_ integer = 0;'
      '1106024848=BEGIN'
      '1106024849='
      '1106024850=  if (IS_SPISANIE_ <> 3) then BEGIN'
      '1106024851=      SELECT COUNT(*)'
      '1106024852=        FROM ZAKAZ T'
      
        '1106024853=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '1106024854=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1106024855=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '1106024856=        INTO CNT_;'
      '1106024857='
      '1106024858=      if (CNT_ = 0) then'
      '1106024859=        SELECT MAX(T.Z_DATE)'
      '1106024860=          FROM ZAKAZ T'
      '1106024861=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '1106024862=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '1106024863=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1106024864=          INTO :DATE_BEGIN_;'
      '1106024865='
      '1106024866=  END ELSE BEGIN'
      '1106024867=      SELECT COUNT(*)'
      '1106024868=        FROM SKLAD_PARENT T'
      
        '1106024869=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1106024870=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1106024871=        INTO CNT_;'
      '1106024872='
      '1106024873=      if (CNT_ = 0) then'
      '1106024874=        SELECT MAX(T.DATE_RECEIPT)'
      '1106024875=          FROM SKLAD_PARENT T'
      '1106024876=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1106024877=           AND T.IS_VOZVRAT = 3'
      
        '1106024878=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1106024879=          INTO :DATE_BEGIN_;'
      '1106024880=  END'
      '1106024881='
      '1106024882=  -- '#1055#1056#1054#1044#1040#1046#1048
      '1106024883=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '1106024884=      FOR'
      '1106024885=        SELECT T.ZAKAZ,'
      
        '1106024886=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1106024887=               T.G_TOCHKA,'
      '1106024888=               T.Z_DATE,'
      '1106024889=               T.Z_TIME,'
      '1106024890=               T.G_CLIENT,'
      '1106024891=               T.OSNOVANIE,'
      '1106024892=               T.NOTE,'
      '1106024893=               gc.name,'
      
        '1106024894=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AM' +
        'OUNT||'#39')'#39', '#39', '#39')'
      
        '1106024895=                            FROM (SELECT G.name, SUM(' +
        'D.amount) AMOUNT'
      
        '1106024896=                                    FROM ZAKAZ Z, ZAK' +
        'AZ_DETAILS D, G_PRODUCT G'
      
        '1106024897=                                   WHERE D.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1106024898=                                     AND D.ZAKAZ = Z.' +
        'ZAKAZ'
      
        '1106024899=                                     AND Z.ZAKAZ = T.' +
        'ZAKAZ'
      '1106024900=                                   GROUP BY G.name)'
      
        '1106024901=                          ) FROM 1 FOR 1500)*/'#39' '#39' DET' +
        'AILS_STR,'
      '1106024902=               T.IS_SPISANIE,'
      
        '1106024903=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_A' +
        'LL,'
      '1106024904=               IP.INVOICE_PAY,'
      '1106024905=               I.INVOICE,'
      '1106024906=               W.WAYBILL,'
      '1106024907=               T.SUMM,'
      '1106024908=               T.SUMM_FACT,'
      '1106024909=               COALESCE(t.SUMM_BONUS, 0),'
      '1106024910=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '1106024911=               COALESCE(T.BY_RECIPE, 0)'
      '1106024912=               ,IS_RESERVE'
      '1106024913=               ,T.SUMM_CASH'
      '1106024914=               ,T.SUMM_NONCASH'
      '1106024915=               ,O.g_official'
      '1106024916=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '1106024917=          FROM ZAKAZ T'
      
        '1106024918=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1106024919=                    LEFT OUTER JOIN INVOICE_PAY IP ON' +
        ' T.ZAKAZ = IP.ZAKAZ'
      
        '1106024920=                    LEFT OUTER JOIN INVOICE I ON T.ZA' +
        'KAZ = I.ZAKAZ'
      
        '1106024921=                    LEFT OUTER JOIN WAYBILL W ON T.ZA' +
        'KAZ = W.ZAKAZ'
      
        '1106024922=                    LEFT OUTER JOIN G_OFFICIAL O ON T' +
        '.g_official = O.g_official'
      
        '1106024923=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1106024924=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISA' +
        'NIE_ = 0) or (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS_SPISANIE_ <>' +
        ' 0))'
      
        '1106024925=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1106024926=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1106024927=        INTO :ZAKAZ,'
      '1106024928=             :Z_NUM,'
      '1106024929=             :G_TOCHKA,'
      '1106024930=             :Z_DATE,'
      '1106024931=             :Z_TIME,'
      '1106024932=             :G_CLIENT,'
      '1106024933=             :OSNOVANIE,'
      '1106024934=             :NOTE,'
      '1106024935=             :CLIENT_NAME,'
      '1106024936=             :DETAILS_STR,'
      '1106024937=             :IS_SPISANIE,'
      '1106024938=             :IS_PAYED_ALL,'
      '1106024939=             :INVOICE_PAY,'
      '1106024940=             :INVOICE,'
      '1106024941=             :WAYBILL,'
      '1106024942=             :SUM_ZAKAZ,'
      '1106024943=             :SUM_FACT,'
      '1106024944=             :SUMM_PAY_BONUS,'
      '1106024945=             :SUMM_BONUS_GOT,'
      '1106024946=             :BY_RECIPE'
      '1106024947=             ,:IS_RESERVE'
      '1106024948=             ,:summ_cash'
      '1106024949=             ,:SUMM_NONCASH'
      '1106024950=             ,:G_OFFICIAL'
      '1106024951=             ,:G_OFFICIAL_FIO'
      '1106024952=      DO'
      '1106024953=        suspend;'
      '1106024954='
      '1106024955=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '1106024956=  END ELSE IF (IS_SPISANIE_ = 1) THEN BEGIN'
      '1106024957=      FOR'
      '1106024958=        SELECT T.ZAKAZ,'
      
        '1106024959=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1106024960=               T.G_TOCHKA,'
      '1106024961=               T.Z_DATE,'
      '1106024962=               T.Z_TIME,'
      '1106024963=               T.G_CLIENT,'
      '1106024964=               T.OSNOVANIE,'
      '1106024965=               T.NOTE,'
      '1106024966=               NULL,'
      '1106024967=               SUBSTRING((SELECT'
      
        '1106024968=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT|' +
        '|'#39')'#39', '#39', '#39')'
      
        '1106024969=                        FROM ZAKAZ_DETAILS D, G_PRODU' +
        'CT G'
      
        '1106024970=                        WHERE D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '1106024971=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '1106024972=                          GROUP BY ZAKAZ) FROM 1 FOR ' +
        '999) DETAILS_STR,'
      '1106024973=               T.IS_SPISANIE,'
      '1106024974=               0,'
      '1106024975=               NULL,'
      '1106024976=               NULL,'
      '1106024977=               NULL,'
      '1106024978=               T.SUMM,'
      '1106024979=               T.SUMM_FACT,'
      '1106024980=               0,'
      '1106024981=               0'
      '1106024982=          FROM ZAKAZ T'
      
        '1106024983=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1106024984=           AND T.IS_SPISANIE  = 1'
      
        '1106024985=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1106024986=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1106024987=        INTO :ZAKAZ,'
      '1106024988=             :Z_NUM,'
      '1106024989=             :G_TOCHKA,'
      '1106024990=             :Z_DATE,'
      '1106024991=             :Z_TIME,'
      '1106024992=             :G_CLIENT,'
      '1106024993=             :OSNOVANIE,'
      '1106024994=             :NOTE,'
      '1106024995=             :CLIENT_NAME,'
      '1106024996=             :DETAILS_STR,'
      '1106024997=             :IS_SPISANIE,'
      '1106024998=             :IS_PAYED_ALL,'
      '1106024999=             :INVOICE_PAY,'
      '1106025000=             :INVOICE,'
      '1106025001=             :WAYBILL,'
      '1106025002=             :SUM_ZAKAZ,'
      '1106025003=             :SUM_FACT,'
      '1106025004=             :SUMM_PAY_BONUS,'
      '1106025005=             :SUMM_BONUS_GOT'
      '1106025006=      DO'
      '1106025007=        suspend;'
      '1106025008='
      '1106025009=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1106025010=  END ELSE BEGIN'
      '1106025011=      FOR'
      '1106025012=        SELECT T.SKLAD,'
      
        '1106025013=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1106025014=               T.G_TOCHKA,'
      '1106025015=               T.DATE_RECEIPT,'
      '1106025016=               T.TIME_RECEIPT,'
      '1106025017=               T.G_CLIENT,'
      '1106025018=               T.OSNOVANIE,'
      '1106025019=               T.NOTE,'
      '1106025020=               gc.name,'
      '1106025021=               SUBSTRING((SELECT'
      
        '1106025022=                            LIST(G.NAME||'#39'('#39'||D.AMOUN' +
        'T||'#39')'#39', '#39', '#39')'
      '1106025023=                            FROM SKLAD D, G_PRODUCT G'
      
        '1106025024=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1106025025=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1106025026=                            GROUP BY SKLAD_PARENT) FR' +
        'OM 1 FOR 999) DETAILS_STR,'
      '1106025027=               T.SUMM,'
      '1106025028=               T.IS_VOZVRAT,'
      '1106025029=               W.WAYBILL'
      
        '1106025030=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL' +
        ' W ON T.SKLAD = W.ZAKAZ,'
      '1106025031=               G_TOCHKA GC'
      
        '1106025032=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1106025033=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1106025034=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '1106025035=           AND T.IS_VOZVRAT = 3'
      '1106025036=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '1106025037=        INTO :ZAKAZ,'
      '1106025038=             :Z_NUM,'
      '1106025039=             :G_TOCHKA,'
      '1106025040=             :Z_DATE,'
      '1106025041=             :Z_TIME,'
      '1106025042=             :G_CLIENT,'
      '1106025043=             :OSNOVANIE,'
      '1106025044=             :NOTE,'
      '1106025045=             :CLIENT_NAME,'
      '1106025046=             :DETAILS_STR,'
      '1106025047=             :SUM_ZAKAZ,'
      '1106025048=             :IS_SPISANIE,'
      '1106025049=             :WAYBILL'
      '1106025050=      DO'
      '1106025051=        suspend;'
      '1106025052=  END'
      '1106025053=end'
      '1106025054=;'
      '1106025055='
      '1106025056=ALTER PROCEDURE READ_ZAKAZ_NA_REAL_LIST('
      '1106025057=  MODE_ INTEGER)'
      '1106025058=RETURNS ('
      
        '1106025059=  ZAKAZ_NA_REAL TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL,'
      '1106025060=  G_CLIENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_CLIENT,'
      '1106025061=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '1106025062=  ZAKAZ_NUM TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVANI' +
        'E,'
      
        '1106025063=  ZAKAZ_DATE TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_D' +
        'ATE,'
      
        '1106025064=  ZAKAZ_REAL_PARENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.' +
        'ZAKAZ_REAL_PARENT,'
      '1106025065=  G_PRODUCT TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '1106025066=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106025067=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106025068=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106025069=  PRICE TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      '1106025070=  AMOUNT_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1106025071=  SUMM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      
        '1106025072=  AMOUNT_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PA' +
        'YED,'
      '1106025073=  SUMM_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '1106025074=  AMOUNT_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT' +
        '_RETURNED,'
      
        '1106025075=  SUMM_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAY' +
        'ED,'
      
        '1106025076=  AMOUNT_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PAY' +
        'ED,'
      '1106025077=  SUMM_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '1106025078=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.IS_PAYED_' +
        'ALL,'
      
        '1106025079=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '1106025080=  PRODCAT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106025081=  AM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1106025082=  SU_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL)'
      '1106025083=AS'
      '1106025084=begin'
      '1106025085=  FOR SELECT Z.ZAKAZ_NA_REAL,'
      '1106025086=             ZP.G_CLIENT,'
      '1106025087=             C.NAME,'
      '1106025088=             ZP.ZAKAZ_DATE,'
      '1106025089=             Z.G_PRODUCT,'
      '1106025090=             P.NAME,'
      '1106025091=             P.ARTICUL,'
      '1106025092=             P.BARCODE,'
      '1106025093=             Z.PRICE,'
      '1106025094=             Z.AMOUNT_ALL,'
      '1106025095=             Z.SUMM_ALL,'
      '1106025096=             Z.AMOUNT_PAYED,'
      '1106025097=             Z.SUMM_PAYED,'
      '1106025098=             COALESCE(Z.AMOUNT_RETURNED, 0),'
      '1106025099=             COALESCE(Z.SUMM_RETURNED, 0),'
      
        '1106025100=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE' +
        '(Z.AMOUNT_RETURNED, 0),'
      
        '1106025101=             Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.S' +
        'UMM_RETURNED, 0),'
      '1106025102=             Z.IS_PAYED_ALL,'
      '1106025103=             P.G_PRODUCT_PAR,'
      '1106025104=             CAT.NAME,'
      '1106025105=             ZP.ZAKAZ_REAL_PARENT,'
      '1106025106=             ZP.OSNOVANIE,'
      '1106025107=             ZT.AM_ALL,'
      '1106025108=             ZT.SU_ALL'
      
        '1106025109=        FROM ZAKAZ_REAL_PARENT ZP, ZAKAZ_NA_REAL Z, G' +
        '_CLIENT C, G_PRODUCT P, g_product CAT/*(select -1 g_product, '#39#1041#1077 +
        #1079' '#1075#1088#1091#1087#1087#1099#39' NAME FROM RDB$DATABASE'
      
        '1106025110=                                                     ' +
        '                         UNION ALL'
      
        '1106025111=                                                     ' +
        '                         SELECT g_product,  NAME FROM G_PRODUCT ' +
        'WHERE IS_CATEGORY = 1) CAT*/,'
      
        '1106025112=             (SELECT SUM(ZZ.AMOUNT_ALL - ZZ.amount_pa' +
        'yed - ZZ.amount_returned) AM_ALL,'
      
        '1106025113=                     SUM(ZZ.SUMM_ALL - ZZ.summ_payed ' +
        '- ZZ.summ_returned) SU_ALL,'
      '1106025114=                     ZPP.G_CLIENT,'
      '1106025115=                     ZPP.OSNOVANIE'
      '1106025116=                FROM ZAKAZ_REAL_PARENT ZPP,'
      '1106025117=                     ZAKAZ_NA_REAL ZZ'
      
        '1106025118=               WHERE ZPP.ZAKAZ_REAL_PARENT = ZZ.ZAKAZ' +
        '_REAL_PARENT'
      
        '1106025119=               GROUP BY ZPP.G_CLIENT, ZPP.OSNOVANIE) ' +
        'ZT'
      
        '1106025120=       WHERE ZP.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '1106025121=         AND ZP.G_CLIENT = C.G_CLIENT'
      
        '1106025122=         AND ZP.ZAKAZ_REAL_PARENT = Z.ZAKAZ_REAL_PARE' +
        'NT'
      '1106025123=         AND Z.G_PRODUCT = P.G_PRODUCT'
      '1106025124=         AND P.G_PRODUCT_par = CAT.G_PRODUCT'
      '1106025125=         AND ZP.G_CLIENT = ZT.G_CLIENT'
      '1106025126=         AND ZP.OSNOVANIE = ZT.OSNOVANIE'
      '1106025127=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      '1106025128=         AND ((Z.IS_PAYED_ALL = 0 AND :MODE_ = 0)'
      '1106025129=              OR'
      
        '1106025130=              (Z.IS_PAYED_ALL = 1 AND Z.AMOUNT_PAYED ' +
        '> 0 AND :MODE_ = 1)'
      '1106025131=              OR'
      
        '1106025132=              (COALESCE(Z.AMOUNT_RETURNED, 0) > 0 AND' +
        ' :MODE_ = 2)'
      '1106025133=              OR'
      '1106025134=              :MODE_ = 3)'
      '1106025135=       ORDER BY C.NAME, ZP.ZAKAZ_DATE'
      '1106025136=      INTO :ZAKAZ_NA_REAL,'
      '1106025137=           :G_CLIENT,'
      '1106025138=           :CLIENT_NAME,'
      '1106025139=           :ZAKAZ_DATE,'
      '1106025140=           :G_PRODUCT,'
      '1106025141=           :PRODUCT_NAME,'
      '1106025142=           :ARTICUL,'
      '1106025143=           :BARCODE,'
      '1106025144=           :PRICE,'
      '1106025145=           :AMOUNT_ALL,'
      '1106025146=           :SUMM_ALL,'
      '1106025147=           :AMOUNT_PAYED,'
      '1106025148=           :SUMM_PAYED,'
      '1106025149=           :AMOUNT_RETURNED,'
      '1106025150=           :SUMM_RETURNED,'
      '1106025151=           :AMOUNT_LEFT,'
      '1106025152=           :SUMM_LEFT,'
      '1106025153=           :IS_PAYED_ALL,'
      '1106025154=           :G_PRODUCT_PAR,'
      '1106025155=           :PRODCAT_NAME,'
      '1106025156=           :ZAKAZ_REAL_PARENT,'
      '1106025157=           :ZAKAZ_NUM,'
      '1106025158=           :AM_ALL,'
      '1106025159=           :SU_ALL'
      '1106025160=  DO'
      '1106025161=    suspend;'
      '1106025162=end'
      '1106025163=;'
      '1106025164='
      '1106025165=ALTER PROCEDURE READ_ZAKAZ_NR_OPLATA_LIST('
      '1106025166=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '1106025167=RETURNS ('
      '1106025168=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106025169=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106025170=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106025171=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1106025172=  G_PAYMENT_TYPE TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '1106025173=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106025174=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106025175=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106025176=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1106025177=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1106025178=  IS_VOZVRAT INTEGER,'
      '1106025179=  TYPE_STR VARCHAR(10))'
      '1106025180=AS'
      '1106025181=/*'
      '1106025182='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1063#1058#1045#1053#1048#1071' '#1054#1055#1051#1040#1058' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048'.'
      
        '1106025183='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1060#1054#1056#1052#1045' TZakazNaRealListForm, '#1042#1061#1054#1044#1053#1054#1049' '#1055#1040#1056#1040 +
        #1052#1045#1058#1056' ZAKAZ_NA_REAL'
      '1106025184=*/'
      '1106025185=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1106025186=BEGIN'
      '1106025187='
      '1106025188=  FOR'
      '1106025189=    SELECT T.ZAKAZ,'
      
        '1106025190=           T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044#1056#1059 +
        #1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1106025191=           T.Z_DATE,'
      '1106025192=           T.G_CLIENT,'
      '1106025193=           T.G_PAYMENT_TYPE,'
      '1106025194=           T.OSNOVANIE,'
      '1106025195=           T.NOTE,'
      '1106025196=           gc.name,'
      '1106025197=           PT.NAME,'
      
        '1106025198=           (SELECT SUM(Z.SUMM) FROM ZAKAZ_DETAILS Z W' +
        'HERE Z.ZAKAZ = T.ZAKAZ)'
      '1106025199=           ,'#39#1054#1087#1083#1072#1090#1072#39' TYPE_STR'
      '1106025200=           ,0'
      
        '1106025201=      FROM ZAKAZ T LEFT OUTER JOIN G_PAYMENT_TYPE PT ' +
        'ON T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '1106025202=           G_CLIENT GC'
      
        '1106025203=     WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1106025204=       AND T.G_CLIENT = GC.G_CLIENT'
      '1106025205=       AND GC.G_CLIENT = :G_CLIENT_'
      '1106025206=       AND T.IS_SPISANIE = 2'
      '1106025207=    UNION ALL'
      '1106025208=    SELECT S.SKLAD ZAKAZ,'
      
        '1106025209=           S.SKLAD ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049 +
        ', '#1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1106025210=           S.DATE_RECEIPT Z_DATE,'
      '1106025211=           S.G_CLIENT,'
      '1106025212=           S.G_PAYMENT_TYPE,'
      '1106025213=           S.OSNOVANIE,'
      '1106025214=           S.NOTE,'
      '1106025215=           gc.name,'
      '1106025216=           PT.NAME,'
      
        '1106025217=           (SELECT SUM(SD.SUMM) FROM SKLAD SD WHERE S' +
        'D.SKLAD_PARENT = S.SKLAD)'
      '1106025218=           ,'#39#1042#1086#1079#1074#1088#1072#1090#39' TYPE_STR'
      '1106025219=           ,1'
      
        '1106025220=      FROM SKLAD_PARENT S LEFT OUTER JOIN G_PAYMENT_T' +
        'YPE PT ON S.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '1106025221=           G_CLIENT GC'
      
        '1106025222=     WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1106025223=       AND S.G_CLIENT = GC.G_CLIENT'
      '1106025224=       AND GC.G_CLIENT = :G_CLIENT_'
      '1106025225=       AND S.IS_VOZVRAT = 2'
      '1106025226=    ORDER BY 3, 1'
      '1106025227=    INTO :ZAKAZ,'
      '1106025228=         :Z_NUM,'
      '1106025229=         :Z_DATE,'
      '1106025230=         :G_CLIENT,'
      '1106025231=         :G_PAYMENT_TYPE,'
      '1106025232=         :OSNOVANIE,'
      '1106025233=         :NOTE,'
      '1106025234=         :CLIENT_NAME,'
      '1106025235=         :PAYMENT_NAME,'
      '1106025236=         :SUM_ZAKAZ'
      '1106025237=         ,:TYPE_STR'
      '1106025238=         ,IS_VOZVRAT'
      '1106025239=  DO'
      '1106025240=    suspend;'
      '1106025241=end'
      '1106025242=;'
      '1106025243='
      '1106025244=ALTER PROCEDURE READ_ZDETAILS_LIST_TMP_REAL'
      '1106025245=RETURNS ('
      
        '1106025246=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '1106025247=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '1106025248=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '1106025249=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1106025250=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1106025251=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1106025252=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '1106025253=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '1106025254=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1106025255=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1106025256=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '1106025257=  ZAKAZ_NA_REAL TYPE OF COLUMN ZAKAZ_DETAILS_TMP_REAL' +
        '.ZAKAZ_NA_REAL)'
      '1106025258=AS'
      '1106025259=begin'
      '1106025260='
      '1106025261=  FOR'
      '1106025262=    SELECT T.ZAKAZ_DETAILS,'
      '1106025263=           T.ZAKAZ,'
      '1106025264=           T.G_PRODUCT,'
      '1106025265=           T.AMOUNT,'
      '1106025266=           T.PRICE,'
      '1106025267=           T.SUMM,'
      '1106025268=           T.DISCOUNT_PERC,'
      '1106025269=           T.DISCOUNT_SUMM,'
      '1106025270=           T.NDS,'
      '1106025271=           T.NDS_SUMM,'
      '1106025272=           P.NAME PRODUCT_NAME,'
      '1106025273=           ZAKAZ_NA_REAL'
      '1106025274=      FROM ZAKAZ_DETAILS_TMP_REAL T,'
      '1106025275=           G_PRODUCT P'
      '1106025276=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1106025277=    ORDER BY t.ZAKAZ_DETAILS'
      '1106025278=    INTO :ZAKAZ_DETAILS,'
      '1106025279=          :ZAKAZ,'
      '1106025280=          :G_PRODUCT,'
      '1106025281=          :AMOUNT,'
      '1106025282=          :PRICE,'
      '1106025283=          :SUMM,'
      '1106025284=          :DISCOUNT_PERC,'
      '1106025285=          :DISCOUNT_SUMM,'
      '1106025286=          :NDS,'
      '1106025287=          :NDS_SUMM,'
      '1106025288=          :PRODUCT_NAME,'
      '1106025289=          :ZAKAZ_NA_REAL'
      '1106025290=  DO'
      '1106025291=    suspend;'
      '1106025292=end'
      '1106025293=;'
      '1106025294='
      '1106025295=ALTER PROCEDURE RECALC_SELF_PRICES('
      '1106025296=  DATE_ DATE)'
      '1106025297=AS'
      '1106025298=/*'
      
        '1106025299='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048', '#1063#1058#1054#1041#1067' '#1055#1045#1056#1045#1057 +
        #1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1067#1045' '#1062#1045#1053#1067' '#1055#1054' '#1040#1050#1058#1059#1040#1051#1068#1053#1067#1052' '#1047#1053#1040#1063#1045#1053#1048#1071#1052'.'
      
        '1106025300='#1069#1058#1054' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1052#1040#1043#1040#1047#1048#1053#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1055#1056#1054#1044#1040#1070#1058' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1047 +
        #1040#1050#1040#1047'. '#1058#1054' '#1045#1057#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1054#1060#1054#1056#1052#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059', '#1040' '#1055#1054#1058#1054#1052' '#1050#1059#1055#1048#1051#1048' '#1058#1054#1042#1040#1056' '#1048' '#1054 +
        #1060#1054#1056#1052#1048#1051#1048' '#1055#1056#1048#1061#1054#1044','
      
        '1106025301='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1046#1045' '#1054#1058' '#1069#1058#1054#1043#1054' '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057 +
        #1071', '#1045#1045' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054'.'
      '1106025302='#1055#1056#1048' '#1056#1040#1057#1063#1045#1058#1045' '#1041#1059#1044#1059' '#1054#1058#1058#1040#1051#1050#1048#1042#1040#1058#1068#1057#1071' '#1054#1058' '#1044#1040#1058#1067' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106025303=*/'
      
        '1106025304=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE;'
      
        '1106025305=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.G_PRODUCT;'
      
        '1106025306=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1106025307=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'COST_PRICE;'
      '1106025308=BEGIN'
      '1106025309=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106025310=    SELECT ID'
      '1106025311=      FROM CUR_PARAMS'
      '1106025312=     WHERE CUR_PARAMS = 2'
      '1106025313=      INTO :G_TOCHKA_;'
      '1106025314='
      '1106025315=  SELECT S.S_VALUE'
      '1106025316=    FROM SYSTEM_SETUP S'
      '1106025317=   WHERE S.SYSTEM_SETUP = 1'
      '1106025318=    INTO :FORMULA_;'
      '1106025319='
      '1106025320=  FOR SELECT T.G_PRODUCT'
      '1106025321=        FROM ZAKAZ_DETAILS_TMP T'
      '1106025322=       GROUP BY T.G_PRODUCT'
      '1106025323=        INTO :G_PRODUCT_'
      '1106025324=  DO BEGIN'
      
        '1106025325=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1106025326=        RETURNING_VALUES :PRICE_;'
      '1106025327='
      '1106025328=    UPDATE ZAKAZ_DETAILS_TMP M'
      '1106025329=       SET M.COST_PRICE = :PRICE_'
      '1106025330=     WHERE M.G_PRODUCT = :G_PRODUCT_;'
      '1106025331=  END'
      '1106025332=END'
      '1106025333=;'
      '1106025334='
      '1106025335=ALTER PROCEDURE UPD_SKLAD('
      '1106025336=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106025337=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1106025338=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1106025339=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1106025340=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1106025341=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1106025342=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1106025343=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106025344=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1106025345=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1106025346=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106025347=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1106025348=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1106025349=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0)'
      '1106025350=RETURNS ('
      '1106025351=  ERR_CODE INTEGER,'
      '1106025352=  ERR_MSG VARCHAR(1024))'
      '1106025353=AS'
      
        '1106025354=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1106025355=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1106025356=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1106025357=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106025358=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1106025359=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1106025360=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1106025361=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1106025362=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1106025363=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1106025364=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1106025365=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1106025366=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1106025367=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1106025368=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1106025369=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1106025370=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1106025371=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1106025372=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1106025373=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1106025374=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1106025375=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106025376=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106025377=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1106025378=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1106025379=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1106025380=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1106025381=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1106025382=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1106025383=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1106025384=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1106025385=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      '1106025386=BEGIN'
      '1106025387='
      '1106025388=  IS_THIS_LAST_ = 0;'
      '1106025389='
      '1106025390=  SELECT S.G_TOCHKA,'
      '1106025391=         S.IS_VOZVRAT,'
      '1106025392=         S.G_PAYMENT_TYPE'
      '1106025393=         ,S.is_expected'
      '1106025394=    FROM SKLAD_parent S'
      '1106025395=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1106025396=    INTO :G_TOCHKA_,'
      '1106025397=         :IS_VOZVRAT_,'
      '1106025398=         :G_PAYMENT_TYPE_OLD_'
      '1106025399=         ,:IS_EXPECTED_OLD_;'
      '1106025400='
      '1106025401=  PNT_ = '#39'00'#39';'
      '1106025402=  UPDATE SKLAD_PARENT'
      '1106025403=  SET'
      
        '1106025404=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1106025405=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1106025406=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1106025407=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1106025408=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1106025409=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1106025410=   SUMM      = :SUMM_,'
      '1106025411=   SUMM_FACT = :SUMM_FACT_,'
      '1106025412=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1106025413=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0) ' +
        ' -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054 +
        ' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1106025414=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '1106025415=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1106025416='
      
        '1106025417=  ---------------------------------------------------' +
        '----------'
      
        '1106025418=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1106025419=  PNT_ = '#39'02'#39';'
      '1106025420=  FOR SELECT SKLAD'
      '1106025421=        FROM SKLAD S'
      '1106025422=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1106025423=         AND NOT EXISTS (SELECT 1'
      '1106025424=                           FROM SKLAD_TMP T'
      '1106025425=                        WHERE T.SKLAD = S.SKLAD)'
      '1106025426=  INTO :SKLAD_'
      '1106025427=  DO BEGIN'
      
        '1106025428=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106025429=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106025430=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106025431=      EXIT;'
      '1106025432=    END'
      '1106025433=  END'
      '1106025434='
      
        '1106025435=  ---------------------------------------------------' +
        '----------'
      
        '1106025436=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1106025437=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1106025438=  PNT_ = '#39'03'#39';'
      '1106025439=  FOR SELECT S.SKLAD,'
      '1106025440=             S.G_PRODUCT,'
      '1106025441=             S.AMOUNT,'
      '1106025442=             S.PRICE,'
      '1106025443=             S.SUMM,'
      '1106025444=             S.NDS,'
      '1106025445=             S.NDS_SUMM,'
      '1106025446=             T.SKLAD,'
      '1106025447=             T.AMOUNT,'
      '1106025448=             T.IS_LAST,'
      '1106025449=             T.DATE_RECEIPT'
      '1106025450=             ,S.PRICE_CURRENCY'
      '1106025451=             ,S.SUMM_CURRENCY'
      
        '1106025452=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1106025453=  INTO :SKLAD_,'
      '1106025454=       :G_PRODUCT_,'
      '1106025455=       :AMOUNT_,'
      '1106025456=       :PRICE_,'
      '1106025457=       :SUMM_ONE_,'
      '1106025458=       :NDS_,'
      '1106025459=       :NDS_SUMM_,'
      '1106025460=       :SKLAD_OLD_,'
      '1106025461=       :AMOUNT_OLD_,'
      '1106025462=       :IS_THIS_LAST_,'
      '1106025463=       :DATE_RECEIPT_OLD_'
      '1106025464=       ,:PRICE_CURRENCY_'
      '1106025465=       ,:SUMM_CURRENCY_TMP_'
      '1106025466=  DO BEGIN'
      
        '1106025467=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106025468=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1106025469=        PNT_ = '#39'04'#39';'
      
        '1106025470=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1106025471=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1106025472=                          ,PRICE_CURRENCY'
      '1106025473=                          ,SUMM_CURRENCY)'
      
        '1106025474=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1106025475=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1106025476=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1106025477=               ,:PRICE_CURRENCY_'
      '1106025478=               ,:SUMM_CURRENCY_TMP_'
      '1106025479=               );'
      '1106025480='
      
        '1106025481=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1106025482=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1106025483=            UPDATE LT_SKLAD_PRODUCT L'
      '1106025484=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1106025485=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106025486=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106025487='
      '1106025488=            IF (ROW_COUNT = 0) THEN'
      
        '1106025489=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_);'
      '1106025490=        END'
      '1106025491='
      
        '1106025492=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1106025493=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1106025494=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1106025495=        PNT_ = '#39'05'#39';'
      '1106025496=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1106025497=            SELECT MAX(SK.DATE_RECEIPT)'
      '1106025498=              FROM SKLAD SK'
      '1106025499=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106025500=               AND SK.IS_LAST = 1'
      '1106025501=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1106025502=              INTO :DATE_LAST_;'
      '1106025503='
      
        '1106025504=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106025505=              UPDATE SKLAD SK'
      '1106025506=                 SET SK.IS_LAST = 0'
      '1106025507=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106025508=                 AND SK.IS_LAST = 1'
      '1106025509=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1106025510='
      '1106025511=              UPDATE SKLAD SK'
      '1106025512=                 SET SK.IS_LAST = 1'
      '1106025513=               WHERE SK.SKLAD = :SKLAD_;'
      '1106025514=            END'
      '1106025515=        END'
      
        '1106025516=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106025517=    END ELSE BEGIN'
      '1106025518=        PNT_ = '#39'06'#39';'
      '1106025519=        UPDATE SKLAD S'
      '1106025520=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1106025521=               S.G_CLIENT = :G_CLIENT_,'
      '1106025522=               S.AMOUNT   = :AMOUNT_,'
      '1106025523=               S.PRICE    = :PRICE_,'
      '1106025524=               S.SUMM     = :SUMM_ONE_,'
      '1106025525=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1106025526=               S.NDS      = :NDS_,'
      '1106025527=               S.NDS_SUMM = :NDS_SUMM_,'
      '1106025528=               S.OSNOVANIE = :OSNOVANIE_,'
      '1106025529=               S.NOTE      = :NOTE_'
      '1106025530=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1106025531=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1106025532=         WHERE S.SKLAD = :SKLAD_;'
      '1106025533='
      '1106025534=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1106025535=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_) THEN BEG' +
        'IN'
      '1106025536=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1106025537=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1106025538=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_)'
      '1106025539=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106025540=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106025541='
      '1106025542=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1106025543=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1106025544=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_)'
      '1106025545=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106025546=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106025547=        END'
      
        '1106025548=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1106025549=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1106025550=            UPDATE LT_SKLAD_PRODUCT L'
      '1106025551=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1106025552=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106025553=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106025554='
      '1106025555=            IF (ROW_COUNT = 0) THEN'
      
        '1106025556=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_);'
      '1106025557=        END'
      
        '1106025558=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      '1106025559=        ELSE BEGIN'
      '1106025560=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1106025561=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_'
      '1106025562=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106025563=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106025564=        END'
      '1106025565='
      
        '1106025566=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1106025567=        PNT_ = '#39'07'#39';'
      
        '1106025568=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1106025569=            SELECT MAX(SK.DATE_RECEIPT)'
      '1106025570=              FROM SKLAD SK'
      '1106025571=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106025572=               AND SK.IS_LAST = 1'
      '1106025573=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1106025574=              INTO :DATE_LAST_;'
      '1106025575='
      
        '1106025576=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106025577=              UPDATE SKLAD SK'
      '1106025578=                 SET SK.IS_LAST = 0'
      '1106025579=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106025580=                 AND SK.IS_LAST = 1'
      '1106025581=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1106025582='
      '1106025583=              UPDATE SKLAD SK'
      '1106025584=                 SET SK.IS_LAST = 1'
      '1106025585=               WHERE SK.SKLAD = :SKLAD_;'
      '1106025586=            END'
      '1106025587=        END'
      '1106025588='
      
        '1106025589=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1106025590=        PNT_ = '#39'08'#39';'
      
        '1106025591=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1106025592=            SELECT MAX(SK.DATE_RECEIPT)'
      '1106025593=              FROM SKLAD SK'
      '1106025594=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106025595=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1106025596=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1106025597=               AND SK.is_vozvrat IN (0,4)'
      '1106025598=              INTO :DATE_LAST_;'
      '1106025599='
      
        '1106025600=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106025601=              UPDATE SKLAD SK'
      '1106025602=                 SET SK.IS_LAST = 0'
      '1106025603=               WHERE SK.SKLAD = :SKLAD_;'
      '1106025604='
      '1106025605=               UPDATE SKLAD SK'
      '1106025606=                 SET SK.IS_LAST = 1'
      '1106025607=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106025608=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1106025609=                                   FROM SKLAD SS'
      
        '1106025610=                                  WHERE SS.G_PRODUCT ' +
        '= SK.G_PRODUCT'
      
        '1106025611=                                    AND SS.DATE_RECEI' +
        'PT = :DATE_LAST_'
      
        '1106025612=                                    AND SS.G_TOCHKA =' +
        ' :G_TOCHKA_'
      
        '1106025613=                                    AND SS.is_vozvrat' +
        ' IN (0,4));'
      '1106025614='
      '1106025615=            END'
      
        '1106025616=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054 +
        #1052' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' ' +
        #1053#1048#1052'.'
      
        '1106025617=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059 +
        #1044#1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '1106025618=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THI' +
        'S_LAST_ = 1)) THEN BEGIN'
      '1106025619=              UPDATE SKLAD SK'
      '1106025620=                 SET SK.IS_LAST = 1'
      '1106025621=               WHERE SK.SKLAD = :SKLAD_;'
      '1106025622=            END'
      '1106025623=        END'
      '1106025624=    END'
      '1106025625=  END'
      '1106025626='
      
        '1106025627=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057 +
        #1057#1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '1106025628=      ----------------------------------------'
      
        '1106025629=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1055#1056#1048#1061#1054#1044#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1106025630=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052'  - '#1058#1045#1055#1045#1056#1068' '#1069#1058#1054' '#1044#1045#1051#1040#1045#1058#1057#1071' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' K_UPD_KASSA'
      '1106025631=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1106025632=      -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' ' +
        #1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054 +
        #1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1106025633=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057 +
        #1058#1042#1045#1053#1053#1054')'
      
        '1106025634=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106025635=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1106025636='
      
        '1106025637=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056 +
        ' '#1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '1106025638=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053 +
        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1106025639=      IF (IS_VOZVRAT_ = 0) THEN'
      '1106025640=        G_PRIHOD_RASHOD_ = 2;'
      '1106025641=      ELSE'
      '1106025642=        G_PRIHOD_RASHOD_ = 3;'
      '1106025643='
      '1106025644=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1106025645=            PNT_ = '#39'09'#39';'
      '1106025646=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1106025647=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1106025648=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1106025649=            ELSE'
      
        '1106025650=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1106025651='
      '1106025652=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1106025653=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1106025654='
      
        '1106025655=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1106025656=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1106025657=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106025658=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1106025659=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1106025660=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1106025661=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1106025662=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1106025663=                                              :SKLAD_' +
        'PARENT_,'
      
        '1106025664=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1106025665=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106025666='
      
        '1106025667=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1106025668=            ELSE BEGIN'
      
        '1106025669=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1106025670=                SELECT 1'
      '1106025671=                  FROM KASSA K'
      '1106025672=                 WHERE K.KASSA = :KASSA_'
      '1106025673=                UNION ALL'
      '1106025674=                SELECT 2'
      '1106025675=                  FROM KASSA_BEZNAL KB'
      '1106025676=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1106025677=                 INTO :PAYMENT_TYPE_OLD_;'
      '1106025678='
      
        '1106025679=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1106025680=                      PNT_ = '#39'010'#39';'
      
        '1106025681=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1106025682=                                                    1' +
        ',     -- ACTION_'
      
        '1106025683=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1106025684=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1106025685=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1106025686=                                                    N' +
        'ULL,   --NOTE_'
      
        '1106025687=                                                    N' +
        'ULL,  --ZAKAZ'
      
        '1106025688=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1106025689=                                                    :' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1106025690='
      
        '1106025691=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106025692=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1106025693=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1106025694=                      PNT_ = '#39'011'#39';'
      
        '1106025695=                      EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '1106025696=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106025697=                        ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1106025698=                        EXIT;'
      '1106025699=                      END'
      '1106025700='
      
        '1106025701=                      EXECUTE PROCEDURE K_INS_KASSA(1' +
        ',     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106025702=                                                    :' +
        'G_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1106025703=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1106025704=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1106025705=                                                    N' +
        'ULL,   --NOTE_ => :NOTE_,'
      
        '1106025706=                                                    N' +
        'ULL,   --ZAKAZ_'
      
        '1106025707=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1106025708=                                                    :' +
        'PAYMENT_TYPE_,'
      
        '1106025709=                                                    :' +
        'G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106025710=                END'
      '1106025711=            END'
      '1106025712=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106025713=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106025714=              EXIT;'
      '1106025715=            END'
      '1106025716='
      
        '1106025717=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1106025718=      END'
      '1106025719='
      
        '1106025720=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1106025721=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1106025722=            FROM KASSA K'
      '1106025723=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1106025724=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1106025725=           UNION'
      '1106025726=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1106025727=            FROM KASSA K'
      '1106025728=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1106025729=             AND K.SUMM = 0'
      '1106025730=          UNION'
      '1106025731=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1106025732=            FROM KASSA_BEZNAL K'
      '1106025733=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1106025734=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1106025735=          UNION'
      '1106025736=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1106025737=            FROM KASSA_BEZNAL K'
      '1106025738=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1106025739=             AND K.SUMM = 0'
      '1106025740=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1106025741=      DO BEGIN'
      '1106025742=        PNT_ = '#39'011A'#39';'
      
        '1106025743=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106025744=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106025745=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1106025746=          EXIT;'
      '1106025747=        END'
      '1106025748=      END'
      '1106025749=  END'
      '1106025750='
      
        '1106025751=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1106025752=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1106025753=    SELECT K.KASSA'
      '1106025754=      FROM KASSA K'
      '1106025755=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1106025756=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1106025757=      INTO :KASSA_POP_;'
      '1106025758=  ELSE'
      '1106025759=    SELECT K.KASSA_BEZNAL'
      '1106025760=      FROM KASSA_BEZNAL K'
      '1106025761=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1106025762=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1106025763=       INTO :KASSA_POP_;'
      '1106025764='
      
        '1106025765=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1106025766=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1106025767=      PNT_ = '#39'012'#39';'
      '1106025768=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1106025769=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1106025770=                                          1,     -- A' +
        'CTION_'
      '1106025771=                                          :G_PRIHOD_,'
      
        '1106025772=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1106025773=                                          :DATE_RECEI' +
        'PT_,'
      
        '1106025774=                                          NULL,   --N' +
        'OTE_'
      '1106025775=                                          NULL,'
      
        '1106025776=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1106025777=                                          :G_PAYMENT_' +
        'TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1106025778=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1106025779=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1106025780=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1106025781=                                          :G_PRIHOD_,'
      
        '1106025782=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1106025783=                                          :DATE_RECEI' +
        'PT_,'
      
        '1106025784=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1106025785=                                          NULL,'
      
        '1106025786=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1106025787=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1106025788=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106025789=      END'
      '1106025790=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106025791=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106025792=        EXIT;'
      '1106025793=      END'
      '1106025794='
      
        '1106025795=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106025796=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1106025797=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1106025798=        PNT_ = '#39'013'#39';'
      
        '1106025799=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106025800=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106025801=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1106025802=          EXIT;'
      '1106025803=        END'
      '1106025804=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1106025805=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1106025806=                                          :G_PRIHOD_,'
      
        '1106025807=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1106025808=                                          :DATE_RECEI' +
        'PT_,'
      
        '1106025809=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1106025810=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1106025811=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1106025812=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1106025813=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106025814=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106025815=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106025816=              EXIT;'
      '1106025817=            END'
      '1106025818=        END'
      '1106025819=  END'
      '1106025820=end'
      '1106025821=;'
      '1106025822='
      '1106025823=ALTER PROCEDURE UPD_ZAKAZ_NA_REAL('
      
        '1106025824=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_N' +
        'A_REAL,'
      '1106025825=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '1106025826=  PRICE_ TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      
        '1106025827=  AMOUNT_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL' +
        ','
      '1106025828=  SUMM_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      '1106025829=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '1106025830=RETURNS ('
      '1106025831=  ERR_CODE INTEGER,'
      '1106025832=  ERR_MSG VARCHAR(1024))'
      '1106025833=AS'
      '1106025834=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '1106025835=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPD_ZAKAZ_NA' +
        '_REAL'#39';'
      
        '1106025836=DECLARE VARIABLE AMOUNT_ALL_OLD_ TYPE OF COLUMN ZAKAZ' +
        '_NA_REAL.AMOUNT_ALL;'
      
        '1106025837=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1106025838=declare variable TOVAR_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.PRICE;  -- '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058' '#1057#1050#1048#1044#1050#1048
      '1106025839=BEGIN'
      '1106025840='
      '1106025841=  SELECT Z.G_TOCHKA'
      '1106025842=    FROM ZAKAZ_REAL_PARENT Z,'
      '1106025843=         ZAKAZ_NA_REAL ZR'
      '1106025844=   WHERE Z.ZAKAZ_REAL_PARENT = ZR.ZAKAZ_REAL_PARENT'
      '1106025845=     AND ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '1106025846=    INTO :G_TOCHKA_;'
      '1106025847='
      
        '1106025848=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1042#1044#1056#1059#1043' '#1055#1054#1051#1068#1047 +
        #1054#1042#1040#1058#1045#1051#1068' '#1059#1042#1045#1051#1048#1063#1048#1051' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1041#1054#1051#1068#1064#1045#1045
      '1106025849=  if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '1106025850=      SELECT L.AMOUNT + (S.AMOUNT_ALL - :AMOUNT_ALL_)'
      '1106025851=        FROM ZAKAZ_NA_REAL S,'
      '1106025852=             LT_SKLAD_PRODUCT L'
      '1106025853=       WHERE S.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '1106025854=         AND S.G_PRODUCT = L.G_PRODUCT'
      '1106025855=         AND L.G_TOCHKA = :G_TOCHKA_'
      '1106025856=        INTO :AMOUNT_ALL_OLD_;'
      '1106025857='
      '1106025858=      IF (:AMOUNT_ALL_OLD_ < 0) THEN BEGIN'
      '1106025859=        Err_Code = -20500;'
      
        '1106025860=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1050#1086#1083#1080 +
        #1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1106025861=                                      '#39#1058#1072#1082#1072#1103' '#1087#1088#1086#1076#1072#1078#1072' ' +
        #1090#1086#1074#1072#1088#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39') RETURNING_VALUES (:ER' +
        'R_MSG);'
      '1106025862=        ERR_MSG = PROCNAME||ERR_MSG;'
      '1106025863=        EXIT;'
      '1106025864=      END'
      '1106025865=  END'
      '1106025866='
      '1106025867=  SELECT Z.AMOUNT_ALL'
      '1106025868=    FROM ZAKAZ_NA_REAL Z'
      '1106025869=   WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '1106025870=    INTO :AMOUNT_ALL_OLD_;'
      '1106025871='
      '1106025872=  SELECT PRICE'
      '1106025873=    FROM G_PRODUCT'
      '1106025874=   WHERE G_PRODUCT = :G_PRODUCT_'
      '1106025875=    INTO :TOVAR_PRICE_;'
      '1106025876='
      '1106025877=  UPDATE ZAKAZ_NA_REAL'
      '1106025878=  SET G_PRODUCT = :G_PRODUCT_,'
      '1106025879=      PRICE = :PRICE_,'
      
        '1106025880=      -- 14.11.2016, '#1055#1054#1050#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1042#1054#1058' '#1058#1040#1050#1054 +
        #1049' '#1050#1054#1057#1058#1067#1040#1051#1068', '#1054#1050#1057#1040#1053#1050#1040' '#1041#1045#1056#1045#1058' '#1048' '#1052#1045#1053#1071#1045#1058' '#1062#1045#1053#1059' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1063#1045#1056#1045#1047' '#1050#1053#1054#1055#1050#1059 +
        ' '#1048#1047#1052#1045#1053#1048#1058#1068', '#1040' '#1057#1050#1048#1044#1050#1040' '#1055#1056#1048' '#1069#1058#1054#1052' '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071','
      
        '1106025881=      -- '#1058'.'#1050'. '#1058#1040#1052' '#1053#1045#1058' '#1058#1040#1050#1054#1043#1054' '#1055#1054#1051#1071', '#1055#1054#1069#1058#1054#1052#1059' '#1041#1059#1044#1059' '#1058#1059#1058' '#1042 +
        #1067#1050#1056#1059#1063#1048#1042#1040#1058#1068#1057#1071' '#1058#1040#1050' - '#1054#1058' '#1062#1045#1053#1067' '#1058#1054#1042#1040#1056#1040' '#1054#1058#1053#1048#1052#1059' '#1062#1045#1053#1059', '#1050#1054#1058#1054#1056#1059#1070' '#1054#1053#1040' '#1055#1054#1057#1058#1040 +
        #1042#1048#1051#1040' - '#1069#1058#1054' '#1048' '#1041#1059#1044#1045#1058' '#1057#1050#1048#1044#1050#1040' '#1042' '#1058#1045#1053#1043#1045
      
        '1106025882=      -- '#1050#1054#1053#1045#1063#1053#1054' '#1053#1048#1050#1058#1054' '#1045#1049' '#1053#1045' '#1047#1040#1055#1056#1045#1065#1040#1045#1058', '#1055#1051#1071#1057#1040#1058#1068' '#1053#1045' '#1054#1058 +
        ' '#1062#1045#1053#1067' '#1058#1054#1042#1040#1056#1040', '#1040' '#1054#1058' '#1050#1040#1050#1054#1049'-'#1058#1054' '#1057#1042#1054#1045#1049' '#1062#1045#1053#1067', '#1053#1054' '#1042' '#1050#1054#1053#1045#1063#1053#1054#1052' '#1048#1058#1054#1043#1045', '#1069#1058#1054 +
        ' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1042#1067#1051#1068#1045#1058#1057#1071' '#1042' '#1057#1050#1048#1044#1050#1059'.'
      '1106025883=      DISCOUNT_TENGE = :TOVAR_PRICE_ - :PRICE_,'
      
        '1106025884=      DISCOUNT_PERC = ROUND((:TOVAR_PRICE_ - :PRICE_)' +
        '*100/:TOVAR_PRICE_, 2),'
      
        '1106025885=      DISCOUNT_SUMM = (:TOVAR_PRICE_ - :PRICE_) * :AM' +
        'OUNT_ALL_,'
      '1106025886=      AMOUNT_ALL = :AMOUNT_ALL_,'
      '1106025887=      SUMM_ALL = :SUMM_ALL_,'
      
        '1106025888=      IS_PAYED_ALL = DECODE(:AMOUNT_ALL_, AMOUNT_PAYE' +
        'D, 1, 0)  -- '#1045#1057#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045#1043#1054', '#1056#1040#1042#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1054#1055#1051#1040#1063#1045#1053#1053#1054#1052#1059 +
        ' - '#1057#1058#1040#1042#1051#1070' '#1043#1040#1051#1054#1063#1050#1059' "'#1054#1055#1051#1040#1063#1045#1053'"'
      '1106025889=  WHERE ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106025890='
      
        '1106025891=  -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1058#1068' '#1050' '#1054#1041#1065#1045#1052#1059' '#1054#1057#1058#1040#1058#1050#1059' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1057#1058#1040#1056#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054','
      '1106025892=  -- '#1040' '#1047#1040#1058#1045#1052' '#1055#1056#1048#1041#1040#1042#1051#1071#1058#1068' '#1053#1054#1042#1054#1045
      '1106025893=  IF (AMOUNT_ALL_OLD_ <> AMOUNT_ALL_) THEN'
      '1106025894=    UPDATE LT_SKLAD_PRODUCT L'
      
        '1106025895=       SET L.AMOUNT = L.AMOUNT + :AMOUNT_ALL_OLD_ - :' +
        'AMOUNT_ALL_'
      '1106025896=     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106025897=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106025898=end'
      '1106025899=;'
      '1106025900='
      '1106025901=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1106025902=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106025903=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106025904=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106025905=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1106025906=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106025907=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106025908=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106025909=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106025910=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106025911=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1106025912=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1106025913=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1106025914=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1106025915=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1106025916=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106025917=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1106025918=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1106025919=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1106025920=  PAYMENTS_ BLOB SUB_TYPE 1)'
      '1106025921=RETURNS ('
      '1106025922=  ERR_CODE INTEGER,'
      '1106025923=  ERR_MSG VARCHAR(1024))'
      '1106025924=AS'
      '1106025925=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1106025926='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1106025927=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1106025928=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1106025929='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1106025930=*/'
      
        '1106025931=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1106025932=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106025933=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106025934=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1106025935=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1106025936=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1106025937=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1106025938=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1106025939=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1106025940=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1106025941=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      '1106025942=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1106025943=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106025944=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1106025945=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      
        '1106025946=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1106025947=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1106025948=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1106025949=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;' +
        ' /* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '1106025950=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '1106025951=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '1106025952=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1106025953=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1106025954=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1106025955=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1106025956=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1106025957=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1106025958=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1106025959=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1106025960=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1106025961=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1106025962=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1106025963=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1106025964=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1106025965=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1106025966=DECLARE VARIABLE SALES_COMM_SUMM_ALL_  TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1106025967=DECLARE VARIABLE SALES_COMM_OLD_       TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM;'
      
        '1106025968=DECLARE VARIABLE ACTION_DATE_ZP_       TYPE OF COLUMN' +
        ' KASSA.ACTION_DATE;'
      
        '1106025969=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1106025970=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      '1106025971=BEGIN'
      '1106025972='
      '1106025973=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1106025974=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1106025975=      SELECT Z.G_PAYMENT_TYPE,'
      '1106025976=             Z.G_TOCHKA,'
      '1106025977=             Z.SUMM,'
      '1106025978=             Z.SUMM_BONUS,'
      '1106025979=             Z.SUMM_BONUS_GOT,'
      '1106025980=             z.g_client,'
      '1106025981=             Z.G_OFFICIAL,'
      '1106025982=             G.DO_NOT_SALES_COMM,'
      '1106025983=             G.FM||'#39' '#39'||G.NM'
      
        '1106025984=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1106025985=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106025986=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1106025987=             :G_TOCHKA_,'
      '1106025988=             :SUMM_OLD_,'
      '1106025989=             :SUMM_BONUS_OLD_,'
      '1106025990=             :SUMM_BONUS_GOT_OLD_,'
      '1106025991=             :g_client_old_,'
      '1106025992=             :G_OFFICIAL_,'
      '1106025993=             :DO_NOT_SALES_COMM_,'
      '1106025994=             :OFFICIAL_NAME_;'
      '1106025995='
      
        '1106025996=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1106025997=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1106025998=        SELECT SUM(ZD.SALES_COMM)'
      '1106025999=          FROM ZAKAZ_DETAILS ZD'
      '1106026000=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1106026001=          INTO :SALES_COMM_OLD_;'
      '1106026002='
      '1106026003=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1106026004=      PNT_ = '#39'02'#39';'
      
        '1106026005=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106026006=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026007=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106026008=        EXIT;'
      '1106026009=      END'
      '1106026010='
      
        '1106026011=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1106026012=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1106026013=      ELSE'
      '1106026014=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1106026015='
      '1106026016=      PNT_ = '#39'01'#39';'
      '1106026017=      UPDATE zakaz'
      '1106026018=      SET'
      '1106026019=       G_TOCHKA = :G_TOCHKA_,'
      '1106026020=       Z_DATE = :Z_DATE_,'
      '1106026021=       Z_TIME = :Z_TIME_,'
      '1106026022=       G_CLIENT = :G_CLIENT_,'
      '1106026023=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1106026024=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1106026025=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1106026026=       SUMM = :SUMM_,'
      '1106026027=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1106026028=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1106026029=       ,BY_RECIPE = :BY_RECIPE_'
      '1106026030=       ,IS_RESERVE = :IS_RESERVE_'
      '1106026031=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1106026032=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1106026033=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1106026034=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1106026035=      WHERE'
      '1106026036=        zakaz = :zakaz_;'
      '1106026037='
      
        '1106026038=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1106026039=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1106026040=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1106026041=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1106026042=          UPDATE G_DISCONT_CARD D'
      '1106026043=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1106026044=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1106026045=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1106026046='
      
        '1106026047=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1106026048=          SUMM_OLD_           = 0;'
      '1106026049=      END'
      '1106026050=      UPDATE G_DISCONT_CARD D'
      
        '1106026051=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1106026052=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1106026053=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1106026054='
      '1106026055=      PNT_ = '#39'03'#39';'
      '1106026056=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1106026057=                 T.G_PRODUCT,'
      '1106026058=                 T.AMOUNT,'
      '1106026059=                 T.SUMM,'
      '1106026060=                 G.SALES_COMM'
      '1106026061=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1106026062=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1106026063=      INTO :ZAKAZ_DETAILS_,'
      '1106026064=           :G_PRODUCT_,'
      '1106026065=           :Z_AMOUNT_,'
      '1106026066=           :DETAILS_SUMM_,'
      '1106026067=           :SALES_COMM_'
      '1106026068=      DO BEGIN'
      
        '1106026069=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1106026070=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1106026071=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1106026072=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1106026073=        END'
      '1106026074='
      
        '1106026075=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1106026076=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1106026077=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1106026078=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1106026079=          FROM ZAKAZ_DETAILS_TMP Z'
      '1106026080=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1106026081='
      
        '1106026082=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057 +
        #1050#1051#1040#1044#1040
      '1106026083=        IF (IS_RESERVE_ = 0) THEN'
      '1106026084=            UPDATE LT_SKLAD_PRODUCT L'
      '1106026085=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '1106026086=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026087=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106026088='
      '1106026089=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1106026090=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '1106026091=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1106026092=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERV' +
        'E + :Z_AMOUNT_'
      '1106026093=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026094=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106026095=      END'
      '1106026096='
      '1106026097=      ----------------------------------------'
      
        '1106026098=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1106026099=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1106026100=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1106026101=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1106026102=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1106026103=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1106026104=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106026105=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1106026106=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1106026107=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1106026108=                PNT_ = '#39'04'#39';'
      
        '1106026109=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1106026110=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1106026111=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1106026112=                ELSE'
      
        '1106026113=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1106026114='
      
        '1106026115=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1106026116=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1106026117='
      
        '1106026118=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1106026119='
      '1106026120=                PNT_ = '#39'05'#39';'
      
        '1106026121=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN'
      
        '1106026122=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1106026123=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1106026124=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1106026125=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1106026126=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1106026127=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1106026128=                                                  NUL' +
        'L,'
      
        '1106026129=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1106026130=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106026131='
      
        '1106026132=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1106026133=                ELSE BEGIN'
      
        '1106026134=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1106026135=                    SELECT 1'
      '1106026136=                      FROM KASSA K'
      '1106026137=                     WHERE K.KASSA = :KASSA_'
      '1106026138=                    UNION ALL'
      '1106026139=                    SELECT 2'
      '1106026140=                      FROM KASSA_BEZNAL KB'
      '1106026141=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1106026142=                     INTO :PAYMENT_TYPE_OLD_;'
      '1106026143='
      '1106026144=                    PNT_ = '#39'06'#39';'
      
        '1106026145=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
        'YPE_) THEN'
      
        '1106026146=                        EXECUTE PROCEDURE K_UPD_KASSA' +
        '(:KASSA_,'
      
        '1106026147=                                                     ' +
        ' 0,     -- ACTION_'
      
        '1106026148=                                                     ' +
        ' 1,     --:G_PRIHOD_RASHOD_,'
      
        '1106026149=                                                     ' +
        ' :PAYMENT_SUMM_,'
      
        '1106026150=                                                     ' +
        ' :PAYMENT_DATE_,'
      
        '1106026151=                                                     ' +
        ' NULL,   --NOTE_'
      
        '1106026152=                                                     ' +
        ' :ZAKAZ_,'
      
        '1106026153=                                                     ' +
        ' NULL,'
      
        '1106026154=                                                     ' +
        ' :PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '1106026155=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' ' +
        #1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106026156=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' ' +
        #1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1106026157=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1106026158=                        PNT_ = '#39'07'#39';'
      
        '1106026159=                        EXECUTE PROCEDURE K_DEL_KASSA' +
        '(:KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_' +
        'MSG);'
      
        '1106026160=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1106026161=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1106026162=                          EXIT;'
      '1106026163=                        END'
      '1106026164='
      '1106026165=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '1106026166=                           EXECUTE PROCEDURE K_INS_KA' +
        'SSA(0,     -- ACTION_ => :ACTION_'
      
        '1106026167=                                                     ' +
        '     1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1106026168=                                                     ' +
        '     :PAYMENT_SUMM_,'
      
        '1106026169=                                                     ' +
        '     :PAYMENT_DATE_,'
      
        '1106026170=                                                     ' +
        '     NULL,   --NOTE_ => :NOTE_,'
      
        '1106026171=                                                     ' +
        '     :ZAKAZ_,   --ZAKAZ_'
      
        '1106026172=                                                     ' +
        '     NULL,'
      
        '1106026173=                                                     ' +
        '     :PAYMENT_TYPE_,'
      
        '1106026174=                                                     ' +
        '     :G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG)' +
        ';'
      '1106026175=                    END'
      '1106026176=                END'
      '1106026177=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026178=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1106026179=                  EXIT;'
      '1106026180=                END'
      '1106026181='
      
        '1106026182=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1106026183=            END'
      '1106026184='
      
        '1106026185=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1106026186=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1106026187=                FROM KASSA K'
      '1106026188=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1106026189=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
      '1106026190=                UNION'
      '1106026191=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1106026192=                  FROM KASSA K'
      '1106026193=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1106026194=                   AND K.SUMM = 0'
      '1106026195=                UNION'
      
        '1106026196=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1106026197=                FROM KASSA_BEZNAL K'
      '1106026198=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1106026199=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA_BEZNAL||'#39'~'#39
      '1106026200=                UNION'
      
        '1106026201=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1106026202=                FROM KASSA_BEZNAL K'
      '1106026203=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1106026204=                 AND K.SUMM = 0'
      '1106026205=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1106026206=            DO BEGIN'
      '1106026207=                PNT_ = '#39'08'#39';'
      
        '1106026208=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_' +
        ', :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106026209=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026210=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '1106026211=                    EXIT;'
      '1106026212=                END'
      '1106026213=            END'
      '1106026214='
      
        '1106026215=            --=======================================' +
        '=========================='
      '1106026216=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1106026217=            --=======================================' +
        '=========================='
      
        '1106026218=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057 +
        #1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1106026219=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040 +
        #1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '1106026220=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055 +
        #1054' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1106026221=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1106026222=                SELECT K.KASSA'
      '1106026223=                FROM KASSA K'
      '1106026224=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1106026225=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1106026226=                 INTO :KASSA_POP_;'
      '1106026227=            ELSE'
      '1106026228=                SELECT K.KASSA_BEZNAL'
      '1106026229=                FROM KASSA_BEZNAL K'
      '1106026230=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1106026231=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1106026232=                 INTO :KASSA_POP_;'
      '1106026233='
      
        '1106026234=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1106026235=              PNT_ = '#39'09'#39';'
      
        '1106026236=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' ' +
        #1054#1053#1040' '#1045#1057#1058#1068
      '1106026237=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '1106026238=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_POP_,'
      
        '1106026239=                                                  0, ' +
        '    -- ACTION_'
      
        '1106026240=                                                  :G_' +
        'PRIHOD_,'
      
        '1106026241=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1106026242=                                                  :Z_' +
        'DATE_,'
      
        '1106026243=                                                  NUL' +
        'L,   --NOTE_'
      
        '1106026244=                                                  :ZA' +
        'KAZ_,'
      
        '1106026245=                                                  NUL' +
        'L,'
      
        '1106026246=                                                  :G_' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1106026247=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1106026248=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '1106026249=                    PNT_ = '#39'10'#39';'
      
        '1106026250=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1106026251=                                                  :G_' +
        'PRIHOD_,'
      
        '1106026252=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1106026253=                                                  :Z_' +
        'DATE_,'
      
        '1106026254=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1106026255=                                                  :ZA' +
        'KAZ_,'
      
        '1106026256=                                                  NUL' +
        'L,'
      
        '1106026257=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1106026258=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106026259=              END'
      '1106026260='
      
        '1106026261=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106026262=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1106026263=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1106026264=                PNT_ = '#39'11'#39';'
      '1106026265=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1106026266=                    EXECUTE PROCEDURE K_DEL_KASSA(:KA' +
        'SSA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1106026267=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026268=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1106026269=                      EXIT;'
      '1106026270=                    END'
      '1106026271='
      
        '1106026272=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106026273=                                                  :G_' +
        'PRIHOD_,'
      
        '1106026274=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1106026275=                                                  :Z_' +
        'DATE_,'
      
        '1106026276=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1106026277=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1106026278=                                                  NUL' +
        'L,'
      
        '1106026279=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1106026280=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106026281=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026282=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1106026283=                      EXIT;'
      '1106026284=                    END'
      '1106026285=                END'
      '1106026286=            END'
      
        '1106026287=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      
        '1106026288=            --=======================================' +
        '=========================='
      '1106026289='
      
        '1106026290=            --=======================================' +
        '=========================='
      '1106026291=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1106026292=            --=======================================' +
        '=========================='
      '1106026293=            PNT_ = '#39'12'#39';'
      
        '1106026294=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1106026295=                KASSA_ = NULL;'
      '1106026296='
      '1106026297=                SELECT S.S_VALUE'
      '1106026298=                  FROM SYSTEM_SETUP S'
      '1106026299=                 WHERE S.SYSTEM_SETUP = 4'
      '1106026300=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1106026301='
      '1106026302=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1106026303=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1106026304=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1106026305='
      
        '1106026306=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1106026307=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1106026308=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1106026309='
      '1106026310=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1106026311=                ELSE'
      
        '1106026312=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1106026313='
      '1106026314=                SELECT K.KASSA, K.SUMM'
      '1106026315=                FROM KASSA K'
      '1106026316=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1106026317=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1106026318=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      
        '1106026319=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_' +
        ';'
      '1106026320='
      '1106026321=                IF (KASSA_ IS NULL) THEN'
      
        '1106026322=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106026323=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1106026324=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1106026325=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1106026326=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1106026327=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1106026328=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1106026329=                                                  1,'
      
        '1106026330=                                                  :G_' +
        'TOCHKA_,'
      
        '1106026331=                                                  :G_' +
        'OFFICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106026332=                ELSE BEGIN'
      
        '1106026333=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_,'
      
        '1106026334=                                                  1, ' +
        '    -- ACTION_'
      
        '1106026335=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1106026336=                                                  :SA' +
        'LES_COMM_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_ - :SALES_COMM_OLD_,'
      
        '1106026337=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1106026338=                                                  :OF' +
        'FICIAL_NAME_,   --NOTE_'
      
        '1106026339=                                                  NUL' +
        'L,'
      
        '1106026340=                                                  NUL' +
        'L,'
      
        '1106026341=                                                  1, ' +
        '  --:PAYMENT_TYPE_,'
      
        '1106026342=                                                  :G_' +
        'OFFICIAL_'
      
        '1106026343=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1106026344=                END'
      '1106026345=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026346=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1106026347=                  EXIT;'
      '1106026348=                END'
      '1106026349=            END'
      
        '1106026350=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1106026351=            --=======================================' +
        '=========================='
      '1106026352='
      '1106026353=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1106026354=  END'
      '1106026355=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1106026356=  ---------------------------------------------------' +
        '------------'
      
        '1106026357=  --*************************************************' +
        '************'
      
        '1106026358=  ---------------------------------------------------' +
        '------------'
      '1106026359=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1106026360=  ELSE BEGIN'
      '1106026361=      PNT_ = '#39'020'#39';'
      '1106026362=      SELECT SP.G_TOCHKA,'
      '1106026363=             SP.G_CLIENT'
      '1106026364=        FROM SKLAD_PARENT SP'
      '1106026365=       WHERE SP.SKLAD = :ZAKAZ_'
      '1106026366=        INTO :G_TOCHKA_OLD_,'
      '1106026367=             :G_TOCHKA_;'
      '1106026368='
      
        '1106026369=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1106026370=      PNT_ = '#39'021'#39';'
      '1106026371=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '1106026372=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106026373=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026374=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106026375=            EXIT;'
      '1106026376=          END'
      '1106026377='
      '1106026378=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1106026379=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1106026380=                FROM ZAKAZ_DETAILS_TMP Z'
      '1106026381=              INTO :G_PRODUCT_,'
      '1106026382=                  :Z_AMOUNT_,'
      '1106026383=                  :PRICE_,'
      '1106026384=                  :SUMMM_'
      '1106026385=          DO BEGIN'
      '1106026386=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1106026387=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1106026388=            IS_THIS_LAST_ = 0;'
      '1106026389=            SELECT MAX(SK.DATE_RECEIPT)'
      '1106026390=                FROM SKLAD SK'
      '1106026391=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106026392=                 AND SK.IS_LAST = 1'
      '1106026393=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1106026394=                INTO :DATE_LAST_;'
      '1106026395='
      
        '1106026396=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106026397=                UPDATE SKLAD SK'
      '1106026398=                   SET SK.IS_LAST = 0'
      '1106026399=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106026400=                   AND SK.IS_LAST = 1'
      '1106026401=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1106026402='
      '1106026403=                IS_THIS_LAST_ = 1;'
      '1106026404=            END'
      '1106026405='
      '1106026406='
      '1106026407=            INSERT INTO SKLAD'
      '1106026408=            ('
      '1106026409=             SKLAD,'
      '1106026410=             SKLAD_PARENT,'
      '1106026411=             DATE_RECEIPT,'
      '1106026412=             G_CLIENT,'
      '1106026413=             G_PRODUCT,'
      '1106026414=             AMOUNT,'
      '1106026415=             PRICE,'
      '1106026416=             SUMM,'
      '1106026417=             G_PAYMENT_TYPE,'
      '1106026418=             OSNOVANIE,'
      '1106026419=             NOTE,'
      '1106026420=             NDS,'
      '1106026421=             NDS_SUMM,'
      '1106026422=             IS_LAST,'
      '1106026423=             IS_VOZVRAT,'
      '1106026424=             G_TOCHKA'
      '1106026425=            ) VALUES ('
      '1106026426=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1106026427=             :ZAKAZ_,'
      '1106026428=             :Z_DATE_,'
      '1106026429=             :G_TOCHKA_,'
      '1106026430=             :G_PRODUCT_,'
      '1106026431=             :Z_AMOUNT_,'
      '1106026432=             :PRICE_,'
      '1106026433=             :SUMMM_,'
      '1106026434=             :G_PAYMENT_TYPE_,'
      '1106026435=             :OSNOVANIE_,'
      '1106026436=             :NOTE_,'
      '1106026437=             0,  --:RNDS_,'
      '1106026438=             0,  --:RNDS_SUMM_,'
      
        '1106026439=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1106026440=             3,  --:IS_VOZVRAT_,'
      '1106026441=             :G_CLIENT_'
      '1106026442=            );'
      '1106026443='
      
        '1106026444=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1106026445=            PNT_ = '#39'023'#39';'
      '1106026446=            UPDATE LT_SKLAD_PRODUCT L'
      '1106026447=               SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '1106026448=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026449=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1106026450='
      '1106026451=            IF (ROW_COUNT = 0) THEN'
      
        '1106026452=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLA' +
        'D_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1106026453=          END'
      '1106026454=      END'
      '1106026455=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1106026456=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1106026457=      ELSE BEGIN'
      
        '1106026458=          -------------------------------------------' +
        '------------------'
      
        '1106026459=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1106026460=          PNT_ = '#39'025'#39';'
      '1106026461=          FOR SELECT SKLAD,'
      '1106026462=                     AMOUNT,'
      '1106026463=                     G_PRODUCT'
      '1106026464=                FROM SKLAD S'
      '1106026465=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1106026466=                 AND NOT EXISTS (SELECT 1'
      
        '1106026467=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1106026468=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1106026469=          INTO :SKLAD_,'
      '1106026470=               :Z_AMOUNT_,'
      '1106026471=               :G_PRODUCT_'
      '1106026472=          DO BEGIN'
      
        '1106026473=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106026474=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106026475=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106026476=              EXIT;'
      '1106026477=            END'
      '1106026478=          END'
      '1106026479='
      '1106026480=          PNT_ = '#39'030'#39';'
      '1106026481=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1106026482=                     S.G_PRODUCT,'
      '1106026483=                     S.AMOUNT,'
      '1106026484=                     S.PRICE,'
      '1106026485=                     S.SUMM,'
      '1106026486=                     T.SKLAD,'
      '1106026487=                     T.AMOUNT,'
      '1106026488=                     T.IS_LAST,'
      '1106026489=                     T.DATE_RECEIPT'
      
        '1106026490=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1106026491=                INTO :ZAKAZ_DETAILS_,'
      '1106026492=                     :G_PRODUCT_,'
      '1106026493=                     :Z_AMOUNT_,'
      '1106026494=                     :PRICE_,'
      '1106026495=                     :SUMMM_,'
      '1106026496=                     :SKLAD_OLD_,'
      '1106026497=                     :AMOUNT_OLD_,'
      '1106026498=                     :IS_THIS_LAST_,'
      '1106026499=                     :DATE_RECEIPT_OLD_'
      '1106026500=          DO BEGIN'
      
        '1106026501=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106026502=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1106026503=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1106026504=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1106026505=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1106026506=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1106026507=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1106026508=                       )'
      '1106026509=                RETURNING'
      '1106026510=                  SKLAD'
      '1106026511=                INTO'
      '1106026512=                  :SKLAD_;'
      '1106026513='
      
        '1106026514=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1106026515=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1106026516=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_'
      '1106026517=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026518=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106026519='
      
        '1106026520=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1106026521=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1106026522=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_'
      '1106026523=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026524=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1106026525='
      '1106026526=                IF (ROW_COUNT = 0) THEN'
      
        '1106026527=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_' +
        'SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1106026528='
      
        '1106026529=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1106026530=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045 +
        #1053#1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042 +
        #1051#1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1106026531=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_S' +
        'KLAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1106026532=                SELECT MAX(SK.DATE_RECEIPT)'
      '1106026533=                  FROM SKLAD SK'
      '1106026534=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106026535=                   AND SK.IS_LAST = 1'
      '1106026536=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '1106026537=                  INTO :DATE_LAST_;'
      '1106026538='
      
        '1106026539=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ ' +
        '>= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106026540=                  UPDATE SKLAD SK'
      '1106026541=                     SET SK.IS_LAST = 0'
      '1106026542=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106026543=                     AND SK.IS_LAST = 1'
      '1106026544=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '1106026545='
      '1106026546=                  UPDATE SKLAD SK'
      '1106026547=                     SET SK.IS_LAST = 1'
      '1106026548=                   WHERE SK.SKLAD = :SKLAD_;'
      '1106026549=                END'
      '1106026550='
      
        '1106026551=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106026552=            END ELSE BEGIN'
      '1106026553=                UPDATE SKLAD S'
      '1106026554=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1106026555=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1106026556=                       S.PRICE    = :PRICE_,'
      '1106026557=                       S.SUMM     = :SUMMM_,'
      '1106026558=                       S.OSNOVANIE = :OSNOVANIE_,'
      '1106026559=                       S.NOTE      = :NOTE_'
      '1106026560=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1106026561='
      '1106026562='
      
        '1106026563=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN BEG' +
        'IN'
      
        '1106026564=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044 +
        #1045'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1106026565=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1106026566=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_)'
      '1106026567=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026568=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106026569='
      
        '1106026570=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044 +
        #1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1106026571=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1106026572=                     SET L.AMOUNT = L.AMOUNT - (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_)'
      '1106026573=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026574=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '1106026575='
      
        '1106026576=                END ELSE if (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN BEGIN'
      
        '1106026577=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044 +
        #1045'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1106026578=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1106026579=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_)'
      '1106026580=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026581=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106026582='
      
        '1106026583=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044 +
        #1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1106026584=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1106026585=                     SET L.AMOUNT = L.AMOUNT + (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_)'
      '1106026586=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106026587=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '1106026588=                END'
      '1106026589='
      
        '1106026590=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1106026591=                IF ((Z_DATE_ > DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1106026592=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1106026593=                      FROM SKLAD SK'
      '1106026594=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106026595=                       AND SK.IS_LAST = 1'
      '1106026596=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1106026597=                      INTO :DATE_LAST_;'
      '1106026598='
      
        '1106026599=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106026600=                      UPDATE SKLAD SK'
      '1106026601=                         SET SK.IS_LAST = 0'
      
        '1106026602=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1106026603=                         AND SK.IS_LAST = 1'
      
        '1106026604=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1106026605='
      '1106026606=                      UPDATE SKLAD SK'
      '1106026607=                         SET SK.IS_LAST = 1'
      
        '1106026608=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1106026609=                    END'
      '1106026610=                END'
      '1106026611='
      
        '1106026612=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1106026613=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1106026614=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1106026615=                      FROM SKLAD SK'
      '1106026616=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1106026617=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1106026618=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1106026619=                       AND SK.is_vozvrat IN (0,3,4)'
      '1106026620=                      INTO :DATE_LAST_;'
      '1106026621='
      
        '1106026622=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106026623=                      UPDATE SKLAD SK'
      '1106026624=                         SET SK.IS_LAST = 0'
      
        '1106026625=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1106026626='
      '1106026627=                       UPDATE SKLAD SK'
      '1106026628=                         SET SK.IS_LAST = 1'
      
        '1106026629=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1106026630=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1106026631=                                           FROM SKLAD' +
        ' SS'
      
        '1106026632=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1106026633=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1106026634=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1106026635=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1106026636=                    END'
      '1106026637=                END'
      '1106026638=            END'
      '1106026639=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1106026640=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1106026641='
      '1106026642=      UPDATE SKLAD_PARENT'
      '1106026643=      SET'
      
        '1106026644=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1106026645=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1106026646=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1106026647=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1106026648=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1106026649=       SUMM      = :SUMM_,'
      '1106026650=       SUMM_FACT = :SUMM_FACT_'
      '1106026651=      WHERE SKLAD  = :ZAKAZ_;'
      '1106026652=  END'
      '1106026653='
      '1106026654=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1106026655=END'
      '1106026656=;'
      '1106026657='
      '1106026658=ALTER PROCEDURE W_DEL_WAYBILL('
      '1106026659=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL)'
      '1106026660=RETURNS ('
      '1106026661=  ERR_CODE INTEGER,'
      '1106026662=  ERR_MSG VARCHAR(1024))'
      '1106026663=AS'
      
        '1106026664=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_WAYBIL' +
        'L'#39';'
      '1106026665=  DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106026666=BEGIN'
      '1106026667=  DELETE FROM WAYBILL'
      '1106026668=  WHERE WAYBILL =  :WAYBILL_;'
      '1106026669=WHEN SQLCODE -530 DO'
      '1106026670=  BEGIN'
      '1106026671=    ERR_CODE = -20500;'
      
        '1106026672=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106026673=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106026674=  END'
      '1106026675=END'
      '1106026676=;'
      '1106026677='
      '1106026678=ALTER PROCEDURE W_GET_WAYBILL('
      '1106026679=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1106026680=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1106026681=  CURRENCY_ INTEGER,'
      '1106026682=  MODE_ INTEGER)'
      '1106026683=RETURNS ('
      '1106026684=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '1106026685=  INIT_DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1106026686=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106026687=  POSTAVSHIK_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '1106026688=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '1106026689=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCH' +
        'ATEL,'
      
        '1106026690=  OTVETST_ZA_POST_ TYPE OF COLUMN WAYBILL.OTVETST_ZA_' +
        'POST,'
      '1106026691=  TRANSP_ORG_ TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      
        '1106026692=  TRANSP_NAKLAD_ TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD' +
        ','
      
        '1106026693=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN WAYBILL.G_OFFICI' +
        'AL_RUKOVOD,'
      '1106026694=  G_OFFICIAL_ TYPE OF COLUMN WAYBILL.G_OFFICIAL,'
      '1106026695=  ZAKAZ_SAVED_ TYPE OF COLUMN WAYBILL.ZAKAZ,'
      '1106026696=  GLAVBUH_ TYPE OF COLUMN WAYBILL.GLAVBUH,'
      '1106026697=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
        '1106026698=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST' +
        '_FIO,'
      '1106026699=  ERR_CODE INTEGER,'
      '1106026700=  ERR_MSG VARCHAR(1024))'
      '1106026701=AS'
      
        '1106026702=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'W_GET_WAYBIL' +
        'L'#39';'
      '1106026703=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106026704=BEGIN'
      '1106026705=  SELECT'
      '1106026706=    NUM,'
      '1106026707=    INIT_DATE,'
      '1106026708=    G_FIRM,'
      '1106026709=    POSTAVSHIK,'
      '1106026710=    IDN,'
      '1106026711=    GRUZOPOLUCHATEL,'
      '1106026712=    OTVETST_ZA_POST,'
      '1106026713=    TRANSP_ORG,'
      '1106026714=    TRANSP_NAKLAD,'
      '1106026715=    G_OFFICIAL_RUKOVOD,'
      '1106026716=    G_OFFICIAL,'
      '1106026717=    ZAKAZ,'
      '1106026718=    GLAVBUH,'
      '1106026719=    doverennost,'
      '1106026720=    doverennost_FIO'
      '1106026721=  FROM WAYBILL'
      '1106026722=  WHERE WAYBILL = :WAYBILL_'
      '1106026723=  INTO'
      '1106026724=    :NUM_,'
      '1106026725=    :INIT_DATE_,'
      '1106026726=    :G_FIRM_,'
      '1106026727=    :POSTAVSHIK_,'
      '1106026728=    :IDN_,'
      '1106026729=    :GRUZOPOLUCHATEL_,'
      '1106026730=    :OTVETST_ZA_POST_,'
      '1106026731=    :TRANSP_ORG_,'
      '1106026732=    :TRANSP_NAKLAD_,'
      '1106026733=    :G_OFFICIAL_RUKOVOD_,'
      '1106026734=    :G_OFFICIAL_,'
      '1106026735=    :ZAKAZ_SAVED_'
      '1106026736=    ,:GLAVBUH_'
      '1106026737=    ,:doverennost_'
      '1106026738=    ,:doverennost_fio_;'
      '1106026739='
      '1106026740=  IF (ROW_COUNT = 0) then BEGIN'
      
        '1106026741=  --*************************************************' +
        '*'
      
        '1106026742=    -- '#1047#1053#1040#1063#1048#1058' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056 +
        #1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1106026743=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1106026744=    SELECT'
      '1106026745=      G.G_FIRM_REKVIZIT,'
      '1106026746=      G.NAME||DECODE(:CURRENCY_, 0, '#39#39','
      
        '1106026747=                     '#39', '#1048#1053#1053#39'||COALESCE(G.IDN, '#39#39')||'#39',' +
        ' '#1050#1055#1055#39'||COALESCE(G.KPP, '#39#39')||'#39', '#39'||COALESCE(GF.ADDRESS,'#39#39')||'#39', '#1090#1077 +
        #1083'.'#39'||COALESCE(GF.PHONE, '#39#39')||'
      
        '1106026748=                     '#39', '#1088'/'#1089' '#39'||COALESCE(GB.ACCOUNT, '#39 +
        #39')||'#39' '#1074' '#1073#1072#1085#1082#1077' '#39'||GB.BANK_NAME||'#39' '#1041#1048#1050' '#39'||GB.BIK||'#39' '#1082'/'#1089' '#39'),'
      '1106026749=      G.IDN'
      '1106026750=    FROM G_FIRM_REKVIZIT g'
      
        '1106026751=           LEFT OUTER JOIN (SELECT * FROM G_FIRM_ADDR' +
        'ESS WHERE IS_DEFAULT = 1) GF ON G.G_FIRM_REKVIZIT = GF.G_FIRM_RE' +
        'KVIZIT'
      
        '1106026752=           LEFT OUTER JOIN (SELECT B.BIK, B.NAME BANK' +
        '_NAME, A.ACCOUNT, A.G_FIRM_REKVIZIT'
      
        '1106026753=                              FROM G_BANK B, G_FIRM_A' +
        'CCOUNT A'
      
        '1106026754=                             WHERE A.G_BANK = B.G_BAN' +
        'K AND A.IS_DEFAULT = 1) GB ON G.G_FIRM_REKVIZIT = GB.G_FIRM_REKV' +
        'IZIT'
      '1106026755=    WHERE G.IS_DEFAULT = 1'
      '1106026756=    INTO'
      '1106026757=      :G_FIRM_,'
      '1106026758=      :POSTAVSHIK_,'
      '1106026759=      :IDN_;'
      '1106026760='
      '1106026761=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '1106026762=    SELECT'
      
        '1106026763=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')), ' +
        '0, C.NAME, c.name_FULL)||COALESCE(DECODE(:CURRENCY_, 0, '#39#39','
      
        '1106026764=                             '#39', '#1048#1053#1053#39'||COALESCE(C.IDN,' +
        ' '#39#39')||'#39', '#1050#1055#1055' , '#39'||COALESCE(GA.ADDRESS,'#39#39')||'#39', '#1090#1077#1083'.'#39'||COALESCE(GA' +
        '.PHONE, '#39#39')||'
      
        '1106026765=                             '#39', '#1088'/'#1089' '#39'||COALESCE(GB.AC' +
        'COUNT, '#39#39')||'#39' '#1074' '#1073#1072#1085#1082#1077' '#39'||GB.BANK_NAME||'#39' '#1041#1048#1050' '#39'||GB.BIK||'#39' '#1082'/'#1089' '#39')' +
        ','
      '1106026766=                       '#39#39'),'
      '1106026767=      z.Z_DATE'
      '1106026768=    FROM ZAKAZ Z,'
      '1106026769=         G_CLIENT C'
      
        '1106026770=           LEFT OUTER JOIN (SELECT * FROM G_ADDRESS W' +
        'HERE IS_DEFAULT = 1) GA ON C.G_CLIENT = GA.G_CLIENT'
      
        '1106026771=           LEFT OUTER JOIN (SELECT B.BIK, B.NAME BANK' +
        '_NAME, A.ACCOUNT, A.G_CLIENT FROM G_BANK B, G_ACCOUNT A'
      
        '1106026772=                            WHERE A.G_BANK = B.G_BANK' +
        ' AND A.IS_DEFAULT = 1) GB ON C.G_CLIENT = GB.G_CLIENT'
      '1106026773=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106026774=      AND Z.G_CLIENT = C.G_CLIENT'
      '1106026775=      AND :MODE_ <> 3'
      '1106026776=    UNION ALL'
      '1106026777=    SELECT'
      '1106026778=      c.name||COALESCE(DECODE(:CURRENCY_, 0, '#39#39','
      
        '1106026779=                             '#39', '#1048#1053#1053#39'||COALESCE(R.IDN,' +
        ' '#39#39')||'#39', '#1050#1055#1055' , '#39'||COALESCE(AD.ADDRESS,'#39#39')||'
      
        '1106026780=                             '#39', '#1088'/'#1089' '#39'||COALESCE(GF.AC' +
        'COUNT, '#39#39')),'
      '1106026781=                       '#39#39'),'
      '1106026782=      S.DATE_RECEIPT Z_DATE'
      '1106026783=    FROM SKLAD_PARENT S,'
      '1106026784=         G_TOCHKA C,'
      
        '1106026785=         G_FIRM_REKVIZIT R LEFT OUTER JOIN G_FIRM_ADD' +
        'RESS AD ON AD.G_FIRM_REKVIZIT = R.G_FIRM_REKVIZIT AND AD.IS_DEFA' +
        'ULT = 1'
      
        '1106026786=           LEFT OUTER JOIN G_FIRM_ACCOUNT GF ON GF.G_' +
        'FIRM_REKVIZIT = R.G_FIRM_REKVIZIT AND GF.IS_DEFAULT = 1'
      '1106026787=    WHERE S.SKLAD = :ZAKAZ_'
      '1106026788=      AND S.G_TOCHKA = C.G_TOCHKA'
      '1106026789=      AND R.IS_DEFAULT = 1'
      '1106026790=      AND :MODE_ = 3'
      '1106026791=    INTO'
      '1106026792=      :GRUZOPOLUCHATEL_,'
      '1106026793=      :INIT_DATE_;'
      '1106026794='
      
        '1106026795=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058 +
        #1054#1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '1106026796=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054 +
        ' '#1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '1106026797=    PNT_ = '#39'05'#39';'
      '1106026798=    SELECT C.id'
      '1106026799=      FROM cur_params C'
      '1106026800=     WHERE C.cur_params = 1'
      '1106026801=    INTO :G_OFFICIAL_;'
      '1106026802='
      '1106026803=    IF (ROW_COUNT = 0) then BEGIN'
      '1106026804=        SELECT MIN(O.G_OFFICIAL)'
      '1106026805=          FROM G_OFFICIAL O'
      '1106026806=          INTO :G_OFFICIAL_;'
      '1106026807=        IF (ROW_COUNT = 0) then BEGIN'
      '1106026808=            Err_Code = -20500;'
      
        '1106026809=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1057#1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '1106026810=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106026811=            EXIT;'
      '1106026812=        END'
      '1106026813=    END'
      '1106026814='
      '1106026815=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '1106026816=    SELECT O.G_OFFICIAL'
      '1106026817=    FROM G_OFFICIAL O'
      '1106026818=    WHERE O.IS_RUKOVODITEL = 1'
      '1106026819=    INTO :G_OFFICIAL_RUKOVOD_;'
      '1106026820='
      '1106026821=    --'#1048#1065#1059' '#1075#1083#1072#1074#1073#1091#1093#1072
      '1106026822=    SELECT O.G_OFFICIAL'
      '1106026823=    FROM G_OFFICIAL O'
      '1106026824=    WHERE O.IS_GLAVBUH = 1'
      '1106026825=    INTO :GLAVBUH_;'
      '1106026826='
      
        '1106026827=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1053#1040#1050#1051#1040#1044#1053#1054#1049', '#1057#1053#1040#1063#1040#1051#1040' '#1057#1044#1045#1051#1040 +
        #1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '1106026828=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '1106026829=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VA' +
        'RCHAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '1106026830=      FROM WAYBILL P'
      '1106026831=    INTO :NUM_;'
      '1106026832='
      
        '1106026833=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1042#1054#1054#1041#1065#1045 +
        ' '#1053#1045#1058
      '1106026834=      NUM_ = '#39'1'#39';'
      '1106026835=  END'
      '1106026836=END'
      '1106026837=;'
      '1106026838='
      '1106026839=ALTER PROCEDURE W_INS_WAYBILL('
      '1106026840=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '1106026841=  INIT_DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1106026842=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106026843=  POSTAVSHIK_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '1106026844=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '1106026845=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCH' +
        'ATEL,'
      
        '1106026846=  OTVETST_ZA_POST_ TYPE OF COLUMN WAYBILL.OTVETST_ZA_' +
        'POST,'
      '1106026847=  TRANSP_ORG_ TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      
        '1106026848=  TRANSP_NAKLAD_ TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD' +
        ','
      
        '1106026849=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN WAYBILL.G_OFFICI' +
        'AL_RUKOVOD,'
      '1106026850=  G_OFFICIAL_ TYPE OF COLUMN WAYBILL.G_OFFICIAL,'
      '1106026851=  GLAVBUH_ TYPE OF COLUMN WAYBILL.GLAVBUH,'
      '1106026852=  ZAKAZ_ TYPE OF COLUMN WAYBILL.ZAKAZ,'
      '1106026853=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
        '1106026854=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST' +
        '_FIO)'
      '1106026855=RETURNS ('
      '1106026856=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1106026857=  ERR_CODE INTEGER,'
      '1106026858=  ERR_MSG VARCHAR(1024))'
      '1106026859=AS'
      
        '1106026860=declare variable PROCNAME varchar(30) = '#39'G_INS_WAYBIL' +
        'L'#39';'
      '1106026861=declare variable PNT_ varchar(5);'
      '1106026862=BEGIN'
      '1106026863=  INSERT INTO WAYBILL ('
      '1106026864=    WAYBILL,'
      '1106026865=    NUM,'
      '1106026866=    INIT_DATE,'
      '1106026867=    G_FIRM,'
      '1106026868=    POSTAVSHIK,'
      '1106026869=    IDN,'
      '1106026870=    GRUZOPOLUCHATEL,'
      '1106026871=    OTVETST_ZA_POST,'
      '1106026872=    TRANSP_ORG,'
      '1106026873=    TRANSP_NAKLAD,'
      '1106026874=    G_OFFICIAL_RUKOVOD,'
      '1106026875=    G_OFFICIAL,'
      '1106026876=    ZAKAZ,'
      '1106026877=    GLAVBUH,'
      '1106026878=    doverennost,'
      '1106026879=    doverennost_FIO'
      '1106026880=  )  VALUES ('
      '1106026881=    GEN_ID(GEN_WAYBILL, 1),'
      '1106026882=    :NUM_,'
      '1106026883=    :INIT_DATE_,'
      '1106026884=    :G_FIRM_,'
      '1106026885=    :POSTAVSHIK_,'
      '1106026886=    :IDN_,'
      '1106026887=    :GRUZOPOLUCHATEL_,'
      '1106026888=    :OTVETST_ZA_POST_,'
      '1106026889=    :TRANSP_ORG_,'
      '1106026890=    :TRANSP_NAKLAD_,'
      '1106026891=    :G_OFFICIAL_RUKOVOD_,'
      '1106026892=    :G_OFFICIAL_,'
      '1106026893=    :ZAKAZ_,'
      '1106026894=    :GLAVBUH_'
      '1106026895=    ,:doverennost_'
      '1106026896=    ,:doverennost_fio_'
      '1106026897=  )'
      '1106026898=  RETURNING WAYBILL'
      '1106026899=  INTO :WAYBILL_;'
      '1106026900=END'
      '1106026901=;'
      '1106026902='
      '1106026903=ALTER PROCEDURE W_READ_WAYBILL_LIST'
      '1106026904=RETURNS ('
      '1106026905=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1106026906=  NUM TYPE OF COLUMN WAYBILL.NUM,'
      '1106026907=  INIT_DATE TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1106026908=  POSTAVSHIK TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '1106026909=  IDN TYPE OF COLUMN WAYBILL.IDN,'
      
        '1106026910=  GRUZOPOLUCHATEL TYPE OF COLUMN WAYBILL.GRUZOPOLUCHA' +
        'TEL,'
      
        '1106026911=  OTVETST_ZA_POST TYPE OF COLUMN WAYBILL.OTVETST_ZA_P' +
        'OST,'
      '1106026912=  TRANSP_ORG TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      '1106026913=  TRANSP_NAKLAD TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD,'
      
        '1106026914=  G_OFFICIAL_RUKOVOD TYPE OF COLUMN WAYBILL.G_OFFICIA' +
        'L_RUKOVOD,'
      '1106026915=  G_OFFICIAL TYPE OF COLUMN WAYBILL.G_OFFICIAL,'
      '1106026916=  GLAVBUH TYPE OF COLUMN WAYBILL.GLAVBUH,'
      '1106026917=  ZAKAZ TYPE OF COLUMN WAYBILL.ZAKAZ)'
      '1106026918=AS'
      
        '1106026919=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_READ_WAYBI' +
        'LL_LIST'#39';'
      '1106026920=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106026921=BEGIN'
      '1106026922=  FOR SELECT'
      '1106026923=    W.WAYBILL,'
      '1106026924=    W.NUM,'
      '1106026925=    W.INIT_DATE,'
      '1106026926=    W.POSTAVSHIK,'
      '1106026927=    W.IDN,'
      '1106026928=    W.GRUZOPOLUCHATEL,'
      '1106026929=    W.OTVETST_ZA_POST,'
      '1106026930=    W.TRANSP_ORG,'
      '1106026931=    W.TRANSP_NAKLAD,'
      '1106026932=    W.G_OFFICIAL_RUKOVOD,'
      '1106026933=    W.G_OFFICIAL,'
      '1106026934=    W.ZAKAZ,'
      '1106026935=    W.GLAVBUH'
      '1106026936=  FROM WAYBILL W,'
      '1106026937=       ZAKAZ Z'
      '1106026938=  WHERE W.ZAKAZ = Z.ZAKAZ'
      
        '1106026939=    AND Z.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHERE' +
        ' CUR_PARAMS = 2)'
      '1106026940=  ORDER BY WAYBILL'
      '1106026941=  INTO'
      '1106026942=    :WAYBILL,'
      '1106026943=    :NUM,'
      '1106026944=    :INIT_DATE,'
      '1106026945=    :POSTAVSHIK,'
      '1106026946=    :IDN,'
      '1106026947=    :GRUZOPOLUCHATEL,'
      '1106026948=    :OTVETST_ZA_POST,'
      '1106026949=    :TRANSP_ORG,'
      '1106026950=    :TRANSP_NAKLAD,'
      '1106026951=    :G_OFFICIAL_RUKOVOD,'
      '1106026952=    :G_OFFICIAL,'
      '1106026953=    :ZAKAZ'
      '1106026954=    ,:GLAVBUH'
      '1106026955=  DO SUSPEND;'
      '1106026956=END'
      '1106026957=;'
      '1106026958='
      '1106026959=ALTER PROCEDURE W_UPD_WAYBILL('
      '1106026960=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1106026961=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '1106026962=  INIT_DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1106026963=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106026964=  POSTAVSHIK_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '1106026965=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '1106026966=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCH' +
        'ATEL,'
      
        '1106026967=  OTVETST_ZA_POST_ TYPE OF COLUMN WAYBILL.OTVETST_ZA_' +
        'POST,'
      '1106026968=  TRANSP_ORG_ TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      
        '1106026969=  TRANSP_NAKLAD_ TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD' +
        ','
      
        '1106026970=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN WAYBILL.G_OFFICI' +
        'AL_RUKOVOD,'
      '1106026971=  G_OFFICIAL_ TYPE OF COLUMN WAYBILL.G_OFFICIAL,'
      '1106026972=  GLAVBUH_ TYPE OF COLUMN WAYBILL.GLAVBUH,'
      '1106026973=  ZAKAZ_ TYPE OF COLUMN WAYBILL.ZAKAZ,'
      '1106026974=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
        '1106026975=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST' +
        '_FIO)'
      '1106026976=RETURNS ('
      '1106026977=  ERR_CODE INTEGER,'
      '1106026978=  ERR_MSG VARCHAR(1024))'
      '1106026979=AS'
      
        '1106026980=declare variable PROCNAME varchar(30) = '#39'G_UPD_WAYBIL' +
        'L'#39';'
      '1106026981=declare variable PNT_ varchar(5);'
      '1106026982=BEGIN'
      '1106026983=  UPDATE WAYBILL SET'
      '1106026984=    NUM = :NUM_,'
      '1106026985=    INIT_DATE = :INIT_DATE_,'
      '1106026986=    G_FIRM = :G_FIRM_,'
      '1106026987=    POSTAVSHIK = :POSTAVSHIK_,'
      '1106026988=    IDN = :IDN_,'
      '1106026989=    GRUZOPOLUCHATEL = :GRUZOPOLUCHATEL_,'
      '1106026990=    OTVETST_ZA_POST = :OTVETST_ZA_POST_,'
      '1106026991=    TRANSP_ORG = :TRANSP_ORG_,'
      '1106026992=    TRANSP_NAKLAD = :TRANSP_NAKLAD_,'
      '1106026993=    G_OFFICIAL_RUKOVOD = :G_OFFICIAL_RUKOVOD_,'
      '1106026994=    G_OFFICIAL = :G_OFFICIAL_,'
      '1106026995=    ZAKAZ = :ZAKAZ_'
      '1106026996=    ,GLAVBUH = :GLAVBUH_'
      '1106026997=    ,doverennost = :doverennost_'
      '1106026998=    ,doverennost_FIO = :doverennost_FIO_'
      '1106026999=  WHERE WAYBILL =  :WAYBILL_;'
      '1106027000=END'
      '1106027001=;'
      '1106027002='
      '1106027003=ALTER PROCEDURE ZR_DEL_ZAKAZ_REAL_PARENT('
      
        '1106027004=  ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKAZ_REAL_PARENT' +
        '.ZAKAZ_REAL_PARENT)'
      '1106027005=RETURNS ('
      '1106027006=  ERR_CODE INTEGER,'
      '1106027007=  ERR_MSG VARCHAR(1024))'
      '1106027008=AS'
      
        '1106027009=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'ZR_DEL_ZAKAZ' +
        '_REAL_PARENT'#39';'
      '1106027010=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106027011=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106027012=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1106027013=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106027014=BEGIN'
      '1106027015='
      
        '1106027016=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040 +
        #1044#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1054#1053' '#1059#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1063#1045#1053
      '1106027017=  FOR SELECT G_PRODUCT,'
      '1106027018=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED,'
      '1106027019=             ZP.G_TOCHKA'
      '1106027020=        FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      
        '1106027021=       WHERE Z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT' +
        '_'
      '1106027022=         AND Z.IS_PAYED_ALL = 0'
      
        '1106027023=         AND ZP.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PAREN' +
        'T_'
      '1106027024=       INTO :G_PRODUCT_,'
      '1106027025=            :AMOUNT_,'
      '1106027026=            :G_TOCHKA_'
      '1106027027=  DO BEGIN'
      '1106027028=    UPDATE LT_SKLAD_PRODUCT LT'
      '1106027029=       SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_'
      '1106027030=     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1106027031=       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1106027032=  END'
      '1106027033='
      '1106027034=  -- '#1059#1044#1040#1051#1071#1070' '#1058#1054#1042#1040#1056' '#1048#1047' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1106027035=  PNT_ = '#39'03'#39';'
      '1106027036=  DELETE from ZAKAZ_NA_REAL z'
      '1106027037=  WHERE z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_;'
      '1106027038='
      '1106027039=  DELETE FROM ZAKAZ_REAL_PARENT'
      '1106027040=  WHERE ZAKAZ_REAL_PARENT =  :ZAKAZ_REAL_PARENT_;'
      '1106027041=WHEN SQLCODE -530 DO'
      '1106027042=  BEGIN'
      '1106027043=    ERR_CODE = -20500;'
      
        '1106027044=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106027045=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106027046=  END'
      '1106027047=END'
      '1106027048=;'
      '1106027049='
      '1106027050=ALTER PROCEDURE ZR_GET_ZAKAZ_REAL_PARENT('
      
        '1106027051=  ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKAZ_REAL_PARENT' +
        '.ZAKAZ_REAL_PARENT)'
      '1106027052=RETURNS ('
      
        '1106027053=  G_CLIENT_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_CLIENT' +
        ','
      
        '1106027054=  ZAKAZ_DATE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_' +
        'DATE,'
      
        '1106027055=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_' +
        'PAYMENT_TYPE,'
      
        '1106027056=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVAN' +
        'IE,'
      '1106027057=  NOTE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.NOTE,'
      '1106027058=  ERR_CODE INTEGER,'
      '1106027059=  ERR_MSG VARCHAR(1024))'
      '1106027060=AS'
      
        '1106027061=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_GET_ZAKAZ_' +
        'REAL_PARENT'#39';'
      '1106027062=  DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106027063=BEGIN'
      '1106027064=  SELECT'
      '1106027065=    G_CLIENT,'
      '1106027066=    ZAKAZ_DATE,'
      '1106027067=    G_PAYMENT_TYPE,'
      '1106027068=    OSNOVANIE,'
      '1106027069=    NOTE'
      '1106027070=  FROM ZAKAZ_REAL_PARENT'
      '1106027071=  WHERE ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_'
      '1106027072=  INTO'
      '1106027073=    :G_CLIENT_,'
      '1106027074=    :ZAKAZ_DATE_,'
      '1106027075=    :G_PAYMENT_TYPE_,'
      '1106027076=    :OSNOVANIE_,'
      '1106027077=    :NOTE_;'
      '1106027078=END'
      '1106027079=;'
      '1106027080='
      '1106027081=ALTER PROCEDURE ZR_UPD_ZAKAZ_REAL_PARENT('
      
        '1106027082=  ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKAZ_REAL_PARENT' +
        '.ZAKAZ_REAL_PARENT,'
      
        '1106027083=  G_CLIENT_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_CLIENT' +
        ','
      
        '1106027084=  ZAKAZ_DATE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_' +
        'DATE,'
      
        '1106027085=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_' +
        'PAYMENT_TYPE,'
      
        '1106027086=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVAN' +
        'IE,'
      '1106027087=  NOTE_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.NOTE)'
      '1106027088=RETURNS ('
      '1106027089=  ERR_CODE INTEGER,'
      '1106027090=  ERR_MSG VARCHAR(1024))'
      '1106027091=AS'
      
        '1106027092=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_UPD_ZAKAZ_' +
        'REAL_PARENT'#39';'
      '1106027093=  DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106027094=BEGIN'
      '1106027095=  UPDATE ZAKAZ_REAL_PARENT SET'
      '1106027096=    G_CLIENT = :G_CLIENT_,'
      '1106027097=    ZAKAZ_DATE = :ZAKAZ_DATE_,'
      '1106027098=    G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1106027099=    OSNOVANIE = :OSNOVANIE_,'
      '1106027100=    NOTE = :NOTE_'
      '1106027101=  WHERE ZAKAZ_REAL_PARENT =  :ZAKAZ_REAL_PARENT_;'
      '1106027102=END'
      '1106027103=;'
      '1106027104=ALTER PROCEDURE P_REP_BILL ('
      '1106027105=    ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106027106=    SUMM_DANO_ NUMERIC(15,2),'
      '1106027107=    SUMM_SDACHA_ NUMERIC(15,2),'
      '1106027108=    CURRENCY_ INTEGER,'
      '1106027109=    MODE_ INTEGER,'
      '1106027110=    PRINT_SLOGAN_ VARCHAR(80),'
      '1106027111=    DECIMAL_ INTEGER)'
      '1106027112=RETURNS ('
      '1106027113=    FIRM_NAME_ VARCHAR(600),'
      '1106027114=    IDN_STR_ VARCHAR(30),'
      '1106027115=    FIRM_IDN_ VARCHAR(50),'
      '1106027116=    FIRM_ADDRESS_ VARCHAR(550),'
      '1106027117=    NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106027118=    DATE_ VARCHAR(100),'
      '1106027119=    PAYMENT_TYPE_  VARCHAR(100),'
      '1106027120=    G_CLIENT_NAME_ VARCHAR(300),'
      '1106027121=    G_OFFICIAL_FM_ VARCHAR(300),'
      '1106027122=    SUMM_VSEGO_ VARCHAR(50),'
      '1106027123=    SUMM_VSEGO_N_ VARCHAR(50),'
      '1106027124=    AMOUNT_VSEGO_ VARCHAR(50),'
      '1106027125=    ROW_NUM INTEGER,'
      '1106027126=    NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106027127=    AMOUNT VARCHAR(50),'
      '1106027128=    SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1106027129=    PRICE VARCHAR(50),'
      '1106027130=    PRICE_N VARCHAR(50),'
      '1106027131=    SUMM VARCHAR(50),'
      '1106027132=    SUMM_N VARCHAR(50),'
      '1106027133=    SUMM_POLUCH_ VARCHAR(50),'
      '1106027134=    SUMM_SDACH_ VARCHAR(50),'
      '1106027135=    SUMM_STR_ VARCHAR(200),'
      '1106027136=    SLOGAN_ VARCHAR(80),'
      '1106027137=    SUMM_SKIDKA_ VARCHAR(50),'
      '1106027138=    ERR_CODE NUMERIC(15,2),'
      '1106027139=    ERR_MSG VARCHAR(1024))'
      '1106027140=AS'
      '1106027141=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '1106027142=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '1106027143=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106027144=DECLARE VARIABLE I INTEGER = 1;'
      
        '1106027145=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1106027146=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1106027147=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.AMOUNT;'
      
        '1106027148=DECLARE VARIABLE SUMM_NONCASH_  TYPE OF COLUMN ZAKAZ.' +
        'SUMM_NONCASH;'
      
        '1106027149=DECLARE VARIABLE SUMM_CASH_  TYPE OF COLUMN ZAKAZ.SUM' +
        'M_CASH;'
      '1106027150=BEGIN'
      '1106027151='
      '1106027152=  SLOGAN_ = PRINT_SLOGAN_;'
      '1106027153='
      '1106027154=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1106027155=  SELECT z.ZAKAZ'
      '1106027156=         ,P.NAME'
      
        '1106027157=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM Z.Z_DATE)||'#39'  '#39'||EXTRACT(HOUR FROM Z.Z_TIME)||'#39':'#39'||EXTRAC' +
        'T(MINUTE FROM Z.Z_TIME)'
      '1106027158=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '1106027159=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COA' +
        'LESCE(O.NM, '#39#39')'
      '1106027160=         ,Z.summ_noncash'
      '1106027161=         ,Z.summ_cash'
      
        '1106027162=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_' +
        'OFFICIAL = O.G_OFFICIAL,'
      '1106027163=         G_CLIENT G,'
      '1106027164=         G_PAYMENT_TYPE P'
      '1106027165=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106027166=     AND Z.G_CLIENT = G.G_CLIENT'
      '1106027167=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1106027168=    INTO :NUM_'
      '1106027169=        ,:PAYMENT_TYPE_'
      '1106027170=        ,:DATE_'
      '1106027171=        ,:G_CLIENT_NAME_'
      '1106027172=        ,:G_OFFICIAL_FM_'
      '1106027173=        ,:SUMM_NONCASH_'
      '1106027174=        ,:SUMM_CASH_'
      '1106027175=        ;'
      '1106027176='
      '1106027177=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '1106027178=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '1106027179='
      '1106027180=  SELECT R.G_FIRM_REKVIZIT,'
      '1106027181=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '1106027182=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086 +
        #1088#1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '1106027183=    FROM G_FIRM_REKVIZIT R'
      '1106027184=   WHERE R.is_default = 1'
      '1106027185=    INTO :G_FIRM_REKVIZIT_,'
      '1106027186=         :FIRM_NAME_,'
      '1106027187=         :FIRM_IDN_;'
      '1106027188='
      '1106027189=  SELECT SUM(ZD.AMOUNT),'
      '1106027190=         CAST(SUM(ZD.DISCOUNT_SUMM) AS VARCHAR(100)),'
      
        '1106027191=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), ' +
        '2) AS VARCHAR(100)),'
      '1106027192=         CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '1106027193=  FROM ZAKAZ_DETAILS ZD'
      '1106027194=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1106027195=  INTO :AMOUNT_VSEGO_NUM_,'
      '1106027196=       :SUMM_SKIDKA_,'
      '1106027197=       :SUMM_VSEGO_,'
      '1106027198=       :SUMM_VSEGO_N_;'
      '1106027199='
      '1106027200=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '1106027201=    FROM G_FIRM_ADDRESS R'
      '1106027202=   WHERE R.IS_DEFAULT = 1'
      '1106027203=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '1106027204=    INTO :FIRM_ADDRESS_;'
      '1106027205='
      
        '1106027206=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047 +
        #1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '1106027207=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':' +
        #39');'
      '1106027208=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '1106027209=    IF (CURRENCY_ = 0) THEN'
      '1106027210=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '1106027211=    ELSE'
      '1106027212=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '1106027213=  END'
      '1106027214='
      '1106027215=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '1106027216='
      
        '1106027217=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR' +
        '(100));'
      
        '1106027218=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCH' +
        'AR(100));'
      '1106027219='
      '1106027220=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '1106027221=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '1106027222=  INTO :SUMM_STR_;'
      '1106027223='
      '1106027224=  FOR'
      '1106027225=    SELECT :I,'
      '1106027226=           G.NAME,'
      '1106027227=           ZD.AMOUNT,'
      '1106027228=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '1106027229=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) ' +
        'AS VARCHAR(100))'
      '1106027230=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '1106027231=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENG' +
        'E, 0) AS VARCHAR(100))'
      '1106027232=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '1106027233=      FROM ZAKAZ Z,'
      '1106027234=           ZAKAZ_DETAILS ZD,'
      '1106027235=           G_PRODUCT G,'
      '1106027236=           G_UNIT U'
      '1106027237=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106027238=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106027239=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106027240=       AND G.G_UNIT = U.G_UNIT'
      '1106027241=     ORDER BY ZD.zakaz_details'
      '1106027242=    INTO :ROW_NUM,'
      '1106027243=        :NAME,'
      '1106027244=        :AMOUNT_NUM_,'
      '1106027245=        :PRICE,'
      '1106027246=        :SUMM'
      '1106027247=        ,:SHORT_NAME'
      '1106027248=        ,:PRICE_N'
      '1106027249=        ,:SUMM_N'
      '1106027250=  DO BEGIN'
      '1106027251=    I = I + 1;'
      '1106027252='
      
        '1106027253=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068 +
        ' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '1106027254=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '1106027255=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '1106027256=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '1106027257=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '1106027258=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '1106027259=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE)-1);'
      '1106027260=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '1106027261=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR P' +
        'OSITION('#39'.00'#39' IN PRICE_N)-1);'
      '1106027262=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '1106027263=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM)-1);'
      '1106027264=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '1106027265=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN SUMM_N)-1);'
      '1106027266=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '1106027267=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '1106027268=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '1106027269=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '1106027270='
      '1106027271=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1106027272=    IF (DECIMAL_ = 2) THEN BEGIN'
      '1106027273=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '1106027274=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,2));'
      '1106027275=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '1106027276=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '1106027277=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,3));'
      '1106027278=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '1106027279=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '1106027280=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,4));'
      '1106027281=    END ELSE BEGIN'
      '1106027282=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '1106027283=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,5));'
      '1106027284=    END'
      '1106027285='
      
        '1106027286=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT) > 0) then'
      
        '1106027287=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR PO' +
        'SITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '1106027288='
      
        '1106027289=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT_VSEGO_) > 0) then'
      
        '1106027290=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1' +
        ' FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '1106027291='
      '1106027292=    SUSPEND;'
      '1106027293=  END'
      '1106027294=WHEN ANY DO BEGIN'
      '1106027295=    Err_code = -20500;'
      
        '1106027296=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106027297=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106027298=  END'
      '1106027299=end'
      '1106027300=;'
      '1106027301=ALTER PROCEDURE G_UPD_G_PRODUCT ('
      
        '1106027302=    G_PRODUCT_      TYPE OF COLUMN G_PRODUCT.G_PRODUC' +
        'T,'
      
        '1106027303=    G_PRODUCT_PAR_  TYPE OF COLUMN G_PRODUCT.G_PRODUC' +
        'T_PAR,'
      '1106027304=    ARTICUL_            VARCHAR(30),'
      '1106027305=    NOMENCLATUR_NUM_    VARCHAR(30),'
      '1106027306=    BARCODE_            VARCHAR(30),'
      '1106027307=    NAME_               VARCHAR(500),'
      '1106027308=    G_UNIT_             TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1106027309=    PRICE_ NUMERIC(15,2),'
      '1106027310=    VOLUME_PRICE_ NUMERIC(15,2),'
      
        '1106027311=    PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT' +
        ','
      '1106027312=    MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1106027313=    NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1106027314=    CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1106027315=    IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1106027316=    IS_CATEGORY_ INTEGER,'
      '1106027317=    MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1106027318=    PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1106027319=    SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '1106027320=RETURNS ('
      '1106027321=    ERR_CODE INTEGER,'
      '1106027322=    ERR_MSG VARCHAR(1024))'
      '1106027323=AS'
      
        '1106027324=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      '1106027325=DECLARE VARIABLE N_CURR_ INTEGER;'
      '1106027326=DECLARE VARIABLE N INTEGER;'
      '1106027327=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1106027328=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1106027329=begin'
      
        '1106027330=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1106027331=    SELECT COUNT(*)'
      '1106027332=      FROM G_PRODUCT G'
      '1106027333=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '1106027334=       AND TRIM(G.ARTICUL) <> '#39#39
      '1106027335=       AND TRIM(:ARTICUL_) <> '#39#39
      '1106027336=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '1106027337=      INTO :CNT_;'
      '1106027338='
      '1106027339=    IF (CNT_ > 0) THEN BEGIN'
      '1106027340=      ERR_CODE = -20500;'
      
        '1106027341=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078 +
        #1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '1106027342=      EXIT;'
      '1106027343=    END'
      '1106027344='
      
        '1106027345=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1106027346=    SELECT COUNT(*)'
      '1106027347=      FROM G_PRODUCT G'
      
        '1106027348=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOM' +
        'ENCLATUR_NUM_))'
      '1106027349=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1106027350=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1106027351=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '1106027352=    INTO :CNT_;'
      '1106027353=    IF (CNT_ > 0) THEN BEGIN'
      '1106027354=      ERR_CODE = -20500;'
      
        '1106027355=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCL' +
        'ATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '1106027356=      EXIT;'
      '1106027357=    END'
      '1106027358='
      '1106027359=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1106027360=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1106027361=        SELECT COUNT(*)'
      '1106027362=          FROM G_PRODUCT G'
      
        '1106027363=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE' +
        '_))'
      '1106027364=           AND TRIM(G.BARCODE) <> '#39#39
      '1106027365=           AND TRIM(:BARCODE_) <> '#39#39
      '1106027366=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '1106027367=          INTO :CNT_;'
      '1106027368='
      '1106027369=        IF (CNT_ = 0) then'
      '1106027370=          SELECT COUNT(*)'
      '1106027371=            FROM G_PRODUCT G, LT_BARCODE L'
      '1106027372=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1106027373=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1106027374=             AND TRIM(L.BARCODE) <> '#39#39
      '1106027375=            INTO :CNT_;'
      '1106027376='
      '1106027377=        IF (CNT_ > 0) THEN BEGIN'
      '1106027378=          ERR_CODE = -20500;'
      
        '1106027379=          ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE' +
        '_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '1106027380=          EXIT;'
      '1106027381=        END'
      '1106027382=    END'
      '1106027383='
      '1106027384=    update G_PRODUCT'
      '1106027385=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1106027386=        ARTICUL = :ARTICUL_,'
      '1106027387=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1106027388=        BARCODE = :BARCODE_,'
      '1106027389=        NAME = :NAME_,'
      '1106027390=        G_UNIT = :G_UNIT_,'
      '1106027391=        PRICE = :PRICE_,'
      '1106027392=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1106027393=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1106027394=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1106027395=        NOTE         = :NOTE_,'
      '1106027396=        CROSSCODE    = :CROSSCODE_,'
      '1106027397=        IS_KIT       = :IS_KIT_,'
      '1106027398=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1106027399=        PLACE        = :PLACE_,'
      '1106027400=        SALES_COMM   = :SALES_COMM_'
      '1106027401=    where (G_PRODUCT = :G_PRODUCT_);'
      '1106027402='
      '1106027403=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1106027404=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1106027405='
      '1106027406=        INSERT INTO LT_BARCODE'
      
        '1106027407=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1106027408='
      '1106027409=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1106027410=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1106027411=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1106027412='
      
        '1106027413=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1106027414=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1106027415='
      '1106027416=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1106027417=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1106027418=            INSERT INTO G_PRODUCT_KIT'
      
        '1106027419=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1106027420=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1106027421=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1106027422=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1106027423='
      
        '1106027424=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1106027425=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1106027426='
      '1106027427=            UPDATE G_PRODUCT_KIT G'
      
        '1106027428=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1106027429=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1106027430=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1106027431=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1106027432='
      
        '1106027433=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1106027434=            if (is_kit_ = 1) then begin'
      '1106027435=                SELECT MIN(L.AMOUNT)'
      '1106027436=                  FROM G_PRODUCT_KIT K,'
      '1106027437=                       LT_SKLAD_PRODUCT L'
      '1106027438=                 WHERE K.g_product = :G_PRODUCT_'
      '1106027439=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1106027440=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1106027441=                 GROUP BY K.G_PRODUCT'
      '1106027442=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1106027443='
      '1106027444=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1106027445=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1106027446=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1106027447=            end'
      '1106027448=        END'
      '1106027449=    END'
      '1106027450=end'
      '1106027451=;'
      '1106027452='
      '1106027453=ALTER PROCEDURE P_REP_DOC ('
      '1106027454=    DOC_ TYPE OF COLUMN DOCS.DOCS,'
      '1106027455=    CURRENCY_ INTEGER,'
      '1106027456=    ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106027457=    DOC_TYPE_ INTEGER)'
      '1106027458=RETURNS ('
      '1106027459=    NUM_ VARCHAR(50),'
      '1106027460=    DOCS_DATE_ VARCHAR(20),'
      '1106027461=    G_FIRM_ VARCHAR(1000),'
      '1106027462=    G_FIRM_ADDRESS_ VARCHAR(1000),'
      '1106027463=    G_FIRM_ACCOUNT_ VARCHAR(1000),'
      '1106027464=    G_FIRM_BANK_ VARCHAR(1000),'
      '1106027465=    G_FIRM_AND_ADDRESS_ VARCHAR(1000),'
      '1106027466=    G_FIRM_OKPO_ TYPE OF COLUMN G_FIRM_REKVIZIT.OKPO,'
      '1106027467=    G_FIRM_BIN_ TYPE OF COLUMN G_FIRM_REKVIZIT.IDN,'
      '1106027468=    G_CLIENT_ VARCHAR(1000),'
      '1106027469=    G_CLIENT_ADDRESS_ VARCHAR(1000),'
      '1106027470=    G_CLIENT_ACCOUNT_ VARCHAR(1000),'
      '1106027471=    G_CLIENT_AND_ADDRESS_ VARCHAR(1000),'
      '1106027472=    G_CLIENT_BIN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '1106027473=    G_OFFICIAL_ VARCHAR(1000),'
      '1106027474=    G_OFFICIAL_ID_KIND_ VARCHAR(1000),'
      '1106027475=    G_OFFICIAL_ID_NUM_ VARCHAR(1000),'
      '1106027476=    G_OFFICIAL_ID_DATE_ VARCHAR(1000),'
      '1106027477=    G_OFFICIAL_ID_ISSUER_ VARCHAR(1000),'
      '1106027478=    APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '1106027479=    RUKOVODITEL_ VARCHAR(1000),'
      '1106027480=    GLAVBUH_ VARCHAR(1000),'
      '1106027481=    NOTE_ TYPE OF COLUMN DOCS.NOTE,'
      '1106027482=    PARAM1_ TYPE OF COLUMN DOCS.PARAM1,'
      '1106027483=    PARAM2_ TYPE OF COLUMN DOCS.PARAM2,'
      '1106027484=    PARAM3_ TYPE OF COLUMN DOCS.PARAM3,'
      '1106027485=    PARAM4_ TYPE OF COLUMN DOCS.PARAM4,'
      '1106027486=    PARAM5_ TYPE OF COLUMN DOCS.PARAM5,'
      '1106027487=    SUMM_ VARCHAR(1000),'
      '1106027488=    SUMM_STR_ VARCHAR(1000),'
      '1106027489=    AMOUNT_ MY_NUMERIC_5,'
      '1106027490=    ROW_NUM VARCHAR(10),'
      '1106027491=    NAME VARCHAR(1000),'
      '1106027492=    UNIT_NAME VARCHAR(1000),'
      '1106027493=    BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106027494=    ZDATE VARCHAR(20),'
      '1106027495=    AMOUNT MY_NUMERIC_5,'
      '1106027496=    PRICE VARCHAR(500),'
      '1106027497=    SUMM VARCHAR(500),'
      '1106027498=    ERR_CODE INTEGER,'
      '1106027499=    ERR_MSG VARCHAR(1024))'
      '1106027500=AS'
      '1106027501=/*'
      '1106027502=DOC_:'
      '1106027503=- 0 '#1069#1058#1054' '#1055#1050#1054';'
      '1106027504=- 1 '#1069#1058#1054' '#1040#1050#1058' '#1042#1067#1055#1054#1051#1053#1045#1053#1053#1067#1061' '#1056#1040#1041#1054#1058
      '1106027505=- 2 '#1069#1058#1054' '#1044#1054#1042#1045#1056#1050#1040';'
      '1106027506=- 3 '#1069#1058#1054' '#1044#1045#1060#1045#1050#1058#1054#1042#1054#1063#1053#1067#1049' '#1040#1050#1058
      '1106027507='
      '1106027508='#1042#1067#1061#1054#1044#1053#1067#1045' '#1055#1040#1056#1040#1052#1045#1058#1056#1067':'
      
        '1106027509='#1055#1050#1054', '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1063#1045#1058' '#1044#1045#1041#1045#1058', '#1055#1040#1056#1040#1052#1045#1058#1056' 2 - '#1057#1063#1045#1058' '#1050#1056#1045#1044#1048 +
        #1058
      '1106027510='#1040#1050#1058'  '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1074#1077#1076#1077#1085#1080#1103' '#1086#1073' '#1080#1089#1087#1086#1083#1100#1079#1086#1074#1072#1085#1080#1080' '#1079#1072#1087#1072#1089#1086#1074
      
        '1106027511='#1044#1054#1042#1045#1056#1045#1053#1053#1054#1057#1058#1068' '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1056#1054#1050' '#1044#1045#1049#1057#1058#1042#1048#1071' '#1044#1054#1042#1045#1056#1050#1048', '#1055#1040#1056#1040 +
        #1052#1045#1058#1056' 2 - '#1057#1063#1045#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1050#1054#1058#1054#1056#1054#1043#1054' '#1044#1045#1051#1040#1051#1048
      '1106027512=*/'
      '1106027513=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_DOC'#39';'
      '1106027514=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106027515=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NOL_VMESTO_BEZ;'
      '1106027516=DECLARE VARIABLE I INTEGER = 1;'
      '1106027517=DECLARE VARIABLE BL_ TYPE OF COLUMN DOCS.PARAM6;'
      '1106027518=DECLARE VARIABLE STR_ VARCHAR(500);'
      
        '1106027519=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106027520=DECLARE VARIABLE AMOUNT_ITOG_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0;'
      '1106027521=DECLARE VARIABLE STR_NAME_ VARCHAR(500);'
      '1106027522=DECLARE VARIABLE STR_AMOUNT_ VARCHAR(500);'
      '1106027523=DECLARE VARIABLE STR_UNIT_ VARCHAR(500);'
      '1106027524=DECLARE VARIABLE POS_ INTEGER;'
      '1106027525=DECLARE VARIABLE POS2_ INTEGER;'
      '1106027526=BEGIN'
      '1106027527='
      '1106027528=  select D.num,'
      
        '1106027529=         lpad(EXTRACT(DAY FROM D.DOCS_DATE), 2, '#39'0'#39')|' +
        '|'#39'.'#39'||lpad(EXTRACT(MONTH FROM D.DOCS_DATE), 2, 0)||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM D.DOCS_DATE),'
      '1106027530=         F.name,'
      '1106027531=         FD.address,'
      '1106027532=         FA.account,'
      '1106027533=         FA.BANK_NAME,'
      '1106027534=         F.OKPO,'
      '1106027535=         F.IDN,'
      
        '1106027536=         COALESCE(F.NAME, '#39#39')||DECODE(D.doc_type, 3, ' +
        'COALESCE('#39', '#1048#1048#1053'/'#1041#1048#1053#39'||F.idn, '#39#39'), '#39#39')||COALESCE('#39', '#39'||FD.ADDRESS' +
        ', '#39#39'),'
      
        '1106027537=         DECODE(COALESCE(c.name_FULL, '#39#39'), '#39#39', C.NAME' +
        ', c.name_FULL),'
      '1106027538=         GD.address,'
      '1106027539=         GA.account,'
      '1106027540=         C.IDN,'
      
        '1106027541=         DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')' +
        '), 0, C.NAME, c.name_FULL)||DECODE(D.doc_type, 3, COALESCE('#39', '#1048#1048 +
        #1053'/'#1041#1048#1053#39'||C.idn, '#39#39'), '#39#39')||COALESCE('#39', '#39'||GD.ADDRESS, '#39#39'),'
      
        '1106027542=         DECODE(D.doc_type, 2, O.APP_NAME||'#39' '#39', '#39#39')||' +
        'O.fio_doc,'
      '1106027543=         O.G_ID_KIND,'
      '1106027544=         O.ID_NUM,'
      
        '1106027545=         lpad(EXTRACT(DAY FROM O.ID_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM O.ID_DATE), 2, 0)||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM O.ID_DATE),'
      '1106027546=         '#39#1074#1099#1076#1072#1085' '#39'||O.ID_ISSUER,'
      '1106027547=         O.APP_NAME,'
      '1106027548=         O1.FIO_DOC,'
      '1106027549=         COALESCE(O2.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '1106027550=         D.note,'
      '1106027551=         D.param1,'
      '1106027552=         D.param2,'
      '1106027553=         D.param3,'
      '1106027554=         D.param4,'
      '1106027555=         D.param5,'
      '1106027556=         D.PARAM6'
      '1106027557=  FROM docs D'
      
        '1106027558=       LEFT OUTER JOIN G_FIRM_ADDRESS FD ON FD.g_addr' +
        'ess = D.g_firm_address'
      
        '1106027559=       LEFT outer JOIN (SELECT GG.G_ACCOUNT, GG.accou' +
        'nt, GB.name||'#39', '#1041#1048#1050' '#39'||GB.BIK BANK_NAME FROM G_FIRM_ACCOUNT GG, ' +
        'G_BANK GB WHERE GG.g_bank = GB.g_bank) FA ON FA.g_account = D.g_' +
        'firm_account'
      
        '1106027560=       LEFT outer JOIN G_ADDRESS GD ON GD.g_address =' +
        ' D.g_client_address'
      
        '1106027561=       LEFT outer JOIN G_ACCOUNT GA ON GA.g_account =' +
        ' D.g_client_account'
      
        '1106027562=       LEFT outer JOIN (SELECT OO.G_OFFICIAL, OO.FIO_' +
        'DOC, OO.G_ID_KIND, OO.ID_NUM, OO.ID_DATE, OO.ID_ISSUER, APP.NAME' +
        ' APP_NAME FROM G_OFFICIAL OO, G_APPOINTMENT APP WHERE OO.G_APPOI' +
        'NTMENT = APP.G_APPOINTMENT) O ON O.g_official = D.g_official'
      
        '1106027563=       LEFT outer JOIN G_OFFICIAL O1 ON O1.g_official' +
        ' = D.G_OFFICIAL_RUKOVOD'
      
        '1106027564=       LEFT outer JOIN G_OFFICIAL O2 ON O2.g_official' +
        ' = D.GLAVBUH,'
      '1106027565=       G_FIRM_REKVIZIT F,'
      '1106027566=       g_client C'
      '1106027567= WHERE D.DOCS = :DOC_'
      '1106027568=   AND D.g_firm = F.g_firm_rekvizit'
      '1106027569=   AND D.G_CLIENT = C.g_client'
      '1106027570=  into :num_,'
      '1106027571=       :DOCS_DATE_,'
      '1106027572=       :g_firm_,'
      '1106027573=       :g_firm_address_,'
      '1106027574=       :g_firm_account_,'
      '1106027575=       :G_FIRM_BANK_,'
      '1106027576=       :G_FIRM_OKPO_,'
      '1106027577=       :G_FIRM_BIN_,'
      '1106027578=       :g_firm_AND_ADDRESS_,'
      '1106027579=       :g_client_,'
      '1106027580=       :g_client_address_,'
      '1106027581=       :g_client_account_,'
      '1106027582=       :G_CLIENT_BIN_,'
      '1106027583=       :G_CLIENT_AND_ADDRESS_,'
      '1106027584=       :g_official_,'
      '1106027585=       :G_OFFICIAL_ID_KIND_,'
      '1106027586=       :G_OFFICIAL_ID_NUM_,'
      '1106027587=       :G_OFFICIAL_ID_DATE_,'
      '1106027588=       :G_OFFICIAL_ID_ISSUER_,'
      '1106027589=       :APPOINTMENT_,'
      '1106027590=       :RUKOVODITEL_,'
      '1106027591=       :GLAVBUH_,'
      '1106027592=       :note_,'
      '1106027593=       :param1_,'
      '1106027594=       :param2_,'
      '1106027595=       :param3_,'
      '1106027596=       :param4_,'
      '1106027597=       :param5_,'
      '1106027598=       :BL_;'
      '1106027599='
      '1106027600=  IF (DOC_TYPE_ <> 2) THEN BEGIN'
      
        '1106027601=      -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088 +
        #1086#1074' ('#1088#1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083 +
        #1080#1079#1072#1094#1080#1080'"'
      
        '1106027602=      -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054 +
        #1052#1059' '#1063#1058#1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063 +
        #1048#1058#1040#1045#1058#1057#1071
      
        '1106027603=      SELECT REPLACE(CAST(SUM(ZD.SUMM) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39'),'
      '1106027604=             SUM(ZD.AMOUNT),'
      
        '1106027605=             (SELECT CURR_STR from CURRENCYSTR(SUM(ZD' +
        '.SUMM), :CURRENCY_))'
      '1106027606=        FROM ZAKAZ Z,'
      '1106027607=             ZAKAZ_DETAILS ZD'
      '1106027608=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106027609=         AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106027610=        INTO :SUMM_,'
      '1106027611=             :AMOUNT_,'
      '1106027612=             :SUMM_STR_;'
      '1106027613='
      '1106027614=      FOR'
      '1106027615=        SELECT :I,'
      '1106027616=               G.NAME||DECODE(G.articul,'
      '1106027617=                              NULL, '#39#39','
      '1106027618=                              '#39#39', '#39#39','
      '1106027619=                              '#39', '#1072#1088#1090'. '#39'||G.articul),'
      '1106027620=               U.SHORT_NAME,'
      '1106027621=               G.barcode,'
      '1106027622=               CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '1106027623=               REPLACE(CAST((ZD.PRICE - COALESCE(ZD.D' +
        'ISCOUNT_TENGE, 0)) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1106027624=               REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1106027625=               lpad(EXTRACT(DAY FROM Z.z_date), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.z_date), 2, 0)||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM Z.z_date)'
      '1106027626=          FROM ZAKAZ Z,'
      '1106027627=               ZAKAZ_DETAILS ZD,'
      '1106027628=               G_PRODUCT G,'
      '1106027629=               G_UNIT U'
      '1106027630=         WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106027631=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106027632=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106027633=           AND G.G_UNIT = U.G_UNIT'
      '1106027634=        INTO :ROW_NUM,'
      '1106027635=            :NAME,'
      '1106027636=            :UNIT_NAME,'
      '1106027637=            :BARCODE,'
      '1106027638=            :AMOUNT,'
      '1106027639=            :PRICE,'
      '1106027640=            :SUMM,'
      '1106027641=            :ZDATE'
      '1106027642=      DO BEGIN'
      '1106027643=        I = I + 1;'
      '1106027644=        SUSPEND;'
      '1106027645=      END'
      '1106027646=  END'
      '1106027647='
      '1106027648=  -- '#1044#1054#1042#1045#1056#1050#1040
      '1106027649=  ELSE BEGIN'
      
        '1106027650=          -- '#1057#1053#1040#1063#1040#1051#1040' '#1059#1047#1053#1040#1070' '#1048#1058#1054#1043#1054#1042#1059#1070' '#1057#1059#1052#1052#1059', '#1063#1058#1054#1041#1067' '#1042#1067#1042#1045 +
        #1057#1058#1048' '#1045#1045' '#1057#1056#1040#1047#1059' '#1042' SUSPEND'
      
        '1106027651=          POS_ = POSITION('#39'<amount_itog_val>'#39' IN BL_)' +
        ';       --'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1106027652=          POS2_ = POSITION('#39'</amount_itog_val>'#39' IN BL' +
        '_);     --'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1106027653=          STR_  = SUBSTRING(BL_ FROM POS_+17 FOR POS2' +
        '_ - POS_-17);'
      
        '1106027654=          SUMM_STR_ = STR_||'#39' ('#39'||(SELECT CURR_STR fr' +
        'om CURRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39')'#39'; -- -1 - ' +
        #1053#1045' '#1055#1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '1106027655='
      '1106027656=          WHILE (I > 0) DO BEGIN'
      '1106027657=            ROW_NUM = I;'
      
        '1106027658=            POS_ = POSITION('#39'<id>'#39' IN BL_);     --'#1055#1056#1054 +
        #1055#1059#1057#1050#1040#1070' '#1042#1057#1045', '#1048' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1061#1054#1046#1059' '#1050' ID'
      
        '1106027659=            POS2_ = POSITION('#39'</id>'#39' IN BL_);     --'#1047 +
        #1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1106027660=            STR_ = SUBSTRING(BL_ FROM POS_+4 FOR POS2' +
        '_ - POS_-4);'
      '1106027661=            g_product_ = CAST(STR_ AS DM_BIGINT);'
      '1106027662='
      
        '1106027663=            POS_ = POSITION('#39'<name>'#39' IN BL_);       -' +
        '-'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1106027664=            POS2_ = POSITION('#39'</name>'#39' IN BL_);     -' +
        '-'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1106027665=            NAME = SUBSTRING(BL_ FROM POS_+6 FOR POS2' +
        '_ - POS_-6);'
      '1106027666='
      
        '1106027667=            POS_ = POSITION('#39'<amount>'#39' IN BL_);      ' +
        ' --'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1106027668=            POS2_ = POSITION('#39'</amount>'#39' IN BL_);    ' +
        ' --'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1106027669=            STR_  = SUBSTRING(BL_ FROM POS_+8 FOR POS' +
        '2_ - POS_-8);'
      
        '1106027670=            SUMM = STR_||'#39' ('#39'||(SELECT CURR_STR from ' +
        'CURRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39')'#39'; -- -1 - '#1053#1045' ' +
        #1055#1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '1106027671='
      '1106027672=            SELECT U.short_name'
      '1106027673=              FROM G_PRODUCT G, G_UNIT U'
      '1106027674=             WHERE G.g_unit = U.g_unit'
      '1106027675=               AND G.g_product = :G_PRODUCT_'
      '1106027676=              INTO :UNIT_NAME;'
      '1106027677='
      
        '1106027678=            --'#1085#1072#1093#1086#1078#1091' '#1090#1077#1075', '#1079#1072#1082#1088#1099#1074#1072#1102#1097#1080#1081' '#1090#1077#1075' '#1090#1086#1074#1072#1088#1072', '#1080' '#1091 +
        #1076#1072#1083#1103#1102' '#1101#1090#1086#1090' '#1090#1086#1074#1072#1088' '#1080#1079' '#1089#1087#1080#1089#1082#1072
      '1106027679=            I = I + 1;'
      '1106027680=            POS_ = POSITION('#39'</tovar>'#39' IN BL_);'
      
        '1106027681=            BL_ = SUBSTRING(BL_ FROM POS_ + 8 FOR cha' +
        'r_length(BL_)-POS_);'
      '1106027682=            IF (POSITION('#39'<tovar>'#39' IN BL_) = 0) THEN'
      '1106027683=              I = -1;'
      '1106027684='
      '1106027685=            SUSPEND;'
      '1106027686=          END'
      '1106027687=  END'
      '1106027688='
      '1106027689=WHEN ANY DO BEGIN'
      '1106027690=    Err_code = -20500;'
      
        '1106027691=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106027692=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106027693=  END'
      '1106027694=end'
      '1106027695=;'
      '1106027696=CREATE PROCEDURE RECREATE_TRGS'
      '1106027697=AS'
      '1106027698=BEGIN'
      '1106027699=  EXECUTE PROCEDURE LOG_DEINIT;'
      '1106027700=  EXECUTE PROCEDURE LOG_INIT;'
      '1106027701=END'
      '1106027702=;'
      
        '1106027703=UPDATE SYSTEM_SETUP SET S_VALUE = 11060 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '1106027704=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1106027705=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '110610=UPDATE SYSTEM_SETUP SET S_VALUE = 11061 WHERE SYSTEM_SETU' +
        'P = 3;'
      '110620=CREATE TABLE SYNC_EXT_APP ('
      '110621=    SYNC_EXT_APP BIGINT NOT NULL,'
      '110622=    OBJECT_TYPE INTEGER,'
      '110623=    ID BIGINT,'
      '110624=    OPER INTEGER);'
      '110625='
      '110626=CREATE OR ALTER PROCEDURE SYNC_EXT_APP_UPLOAD'
      '110627=RETURNS ('
      '110628=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '110629=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106210=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106211=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106212=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106213=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '1106214=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1106215=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1106216=  SUMM_SERT MY_NUMERIC,'
      '1106217=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106218=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1106219=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_N' +
        'UM,'
      '1106220=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106221=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1106222=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1106223=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_APP)'
      '1106224=AS'
      '1106225=BEGIN'
      '1106226=  FOR  SELECT S.OPER'
      '1106227=              ,Z.ZAKAZ'
      '1106228=              ,Z.Z_DATE'
      '1106229=              ,Z.Z_TIME'
      '1106230=              ,C.NAME CLIENT_NAME'
      '1106231=              ,G.NAME SKLAD_NAME'
      '1106232=              ,Z.SUMM_CASH'
      '1106233=              ,Z.SUMM_NONCASH'
      '1106234=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1106235=              ,P.ARTICUL'
      '1106236=              ,P.BARCODE'
      '1106237=              ,P.NOMENCLATUR_NUM'
      '1106238=              ,ZD.AMOUNT'
      '1106239=              ,ZD.PRICE - ZD.DISCOUNT_TENGE PRICE'
      '1106240=              ,ZD.SUMM'
      '1106241=              ,S.SYNC_EXT_APP'
      '1106242=         FROM SYNC_EXT_APP S'
      '1106243=              ,ZAKAZ Z'
      '1106244=              ,ZAKAZ_DETAILS ZD'
      '1106245=              ,G_TOCHKA G'
      '1106246=              ,G_CLIENT C'
      '1106247=              ,G_PRODUCT P'
      '1106248=        WHERE S.OBJECT_TYPE = 1'
      '1106249=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1106250=          AND S.ID = Z.ZAKAZ'
      '1106251=          AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106252=          AND Z.G_TOCHKA = G.G_TOCHKA'
      '1106253=          AND Z.G_CLIENT = C.G_CLIENT'
      '1106254=          AND ZD.G_PRODUCT = P.G_PRODUCT'
      '1106255=        UNION ALL'
      '1106256=        SELECT S.OPER'
      '1106257=               ,Z.ZAKAZ'
      '1106258=               ,NULL Z_DATE'
      '1106259=               ,NULL Z_TIME'
      '1106260=               ,NULL CLIENT_NAME'
      '1106261=               ,NULL SKLAD_NAME'
      '1106262=               ,0 SUMM_CASH'
      '1106263=               ,0 SUMM_NONCASH'
      '1106264=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1106265=               ,NULL ARTICUL'
      '1106266=               ,NULL BARCODE'
      '1106267=               ,NULL NOMENCLATUR_NUM'
      '1106268=               ,0 AMOUNT'
      '1106269=               ,0 PRICE'
      '1106270=               ,0 SUMM'
      '1106271=               ,S.SYNC_EXT_APP'
      '1106272=          FROM SYNC_EXT_APP S'
      '1106273=              ,ZAKAZ Z'
      '1106274=         WHERE S.ID = Z.ZAKAZ'
      '1106275=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1106276=        ORDER BY 1, 3, 4, 2, 10'
      '1106277=         INTO :OPER,'
      '1106278=              :ZAKAZ,'
      '1106279=              :Z_DATE,'
      '1106280=              :Z_TIME,'
      '1106281=              :CLIENT_NAME,'
      '1106282=              :SKLAD_NAME,'
      '1106283=              :SUMM_CASH,'
      '1106284=              :SUMM_NONCASH,'
      '1106285=              :SUMM_SERT,'
      '1106286=              :ARTICUL,'
      '1106287=              :BARCODE,'
      '1106288=              :NOMENCLATUR_NUM,'
      '1106289=              :AMOUNT,'
      '1106290=              :PRICE,'
      '1106291=              :SUMM,'
      '1106292=              :SYNC_EXT_APP'
      '1106293=  DO'
      '1106294=    SUSPEND;'
      '1106295=END;'
      '1106296='
      '1106297=CREATE GENERATOR GEN_SYNC_EXT_APP;'
      '1106298='
      
        '1106299=ALTER TABLE SYNC_EXT_APP ADD CONSTRAINT PK_SYNC_EXT_APP ' +
        'PRIMARY KEY (SYNC_EXT_APP) ;'
      '11062100='
      '11062101=CREATE OR ALTER PROCEDURE DEL_ZAKAZ ('
      '11062102=    ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11062103=    IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0,'
      '11062104=    UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '11062105=RETURNS ('
      '11062106=    ERR_CODE INTEGER,'
      '11062107=    ERR_MSG VARCHAR(1024))'
      '11062108=AS'
      '11062109=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '11062110=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11062111=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '11062112=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUMM;'
      
        '11062113=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS;'
      
        '11062114=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS_GOT;'
      
        '11062115=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CL' +
        'IENT;'
      
        '11062116=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11062117=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11062118=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11062119=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM;'
      
        '11062120=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRODU' +
        'CT.SALES_COMM;'
      
        '11062121=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '11062122=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11062123=BEGIN'
      
        '11062124=  --***************************************************' +
        '*************'
      '11062125=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '11062126=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '11062127=      SELECT Z.SUMM,'
      '11062128=             Z.SUMM_BONUS,'
      '11062129=             Z.SUMM_BONUS_GOT,'
      '11062130=             Z.G_CLIENT,'
      '11062131=             Z.G_OFFICIAL,'
      '11062132=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '11062133=             G.FM'
      
        '11062134=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z.' +
        'G_OFFICIAL = G.G_OFFICIAL'
      '11062135=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '11062136=        INTO :SUMM_ZAKAZ_,'
      '11062137=             :SUMM_PAY_BONUS_,'
      '11062138=             :SUMM_BONUS_GOT_,'
      '11062139=             :G_CLIENT_,'
      '11062140=             :G_OFFICIAL_,'
      '11062141=             :DO_NOT_SALES_COMM_,'
      '11062142=             :OFFICIAL_NAME_;'
      '11062143='
      
        '11062144=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059
      
        '11062145=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      '11062146=        SELECT SUM(ZD.SALES_COMM)'
      '11062147=          FROM ZAKAZ_DETAILS ZD'
      '11062148=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '11062149=          INTO :SALES_COMM_OLD_;'
      '11062150='
      '11062151=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '11062152=      PNT_ = '#39'01'#39';'
      
        '11062153=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETUR' +
        'NING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11062154=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062155=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11062156=        EXIT;'
      '11062157=      END'
      '11062158='
      '11062159=      -------------------------------------'
      '11062160=      PNT_ = '#39'02'#39';'
      '11062161=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '11062162=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048 +
        #1063#1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048 +
        #1071' '#1055#1054#1044#1056#1071#1044
      '11062163=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '11062164=      FOR SELECT S.KASSA'
      '11062165=            FROM KASSA S'
      '11062166=           WHERE S.ZAKAZ = :ZAKAZ_'
      '11062167=            INTO :KASSA_'
      '11062168=      DO BEGIN'
      
        '11062169=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11062170=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062171=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11062172=            EXIT;'
      '11062173=          END'
      '11062174=      END'
      '11062175='
      '11062176=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '11062177=      PNT_ = '#39'03'#39';'
      '11062178=      FOR SELECT S.KASSA_BEZNAL'
      '11062179=            FROM KASSA_BEZNAL S'
      '11062180=           WHERE S.ZAKAZ = :ZAKAZ_'
      '11062181=            INTO :KASSA_'
      '11062182=      DO BEGIN'
      
        '11062183=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11062184=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062185=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11062186=            EXIT;'
      '11062187=          END'
      '11062188=      END'
      '11062189=      -------------------------------------'
      '11062190='
      
        '11062191=      --===============================================' +
        '=================='
      '11062192=      -- '#1041#1051#1054#1050' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040
      
        '11062193=      --===============================================' +
        '=================='
      '11062194=      PNT_ = '#39'03.1'#39';'
      
        '11062195=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0 A' +
        'ND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '11062196=            KASSA_ = NULL;'
      '11062197='
      '11062198=            SELECT S.S_VALUE'
      '11062199=              FROM SYSTEM_SETUP S'
      '11062200=             WHERE S.SYSTEM_SETUP = 4'
      '11062201=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '11062202='
      '11062203=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11062204=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11062205=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11062206='
      
        '11062207=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040 +
        #1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11062208=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11062209=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DEC' +
        'ODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FR' +
        'OM CURRENT_DATE)));'
      '11062210='
      '11062211=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11062212=            ELSE'
      
        '11062213=               ACTION_DATE_ZP_ = Current_date - EXTRACT' +
        '(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - E' +
        'XTRACT(DAY FROM current_date) + 32);'
      '11062214='
      '11062215=            SELECT K.KASSA, K.SUMM'
      '11062216=            FROM KASSA K'
      '11062217=            WHERE K.G_PRIHOD_RASHOD = -1'
      '11062218=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '11062219=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '11062220=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '11062221='
      '11062222=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '11062223=                EXECUTE PROCEDURE K_INS_KASSA(1,     --' +
        ' ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11062224=                                              -1,     -' +
        '-:G_PRIHOD_RASHOD_,'
      
        '11062225=                                              -:SALES_C' +
        'OMM_OLD_,'
      
        '11062226=                                              :ACTION_D' +
        'ATE_ZP_,'
      
        '11062227=                                              :OFFICIAL' +
        '_NAME_,'
      
        '11062228=                                              NULL,    ' +
        ' --:ZAKAZ_,'
      
        '11062229=                                              NULL,    ' +
        ' --:SKLAD_,'
      '11062230=                                              1,'
      
        '11062231=                                              (SELECT I' +
        'D FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '11062232=                                              :G_OFFICI' +
        'AL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11062233=            END ELSE'
      '11062234=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '11062235=                                              1,     --' +
        ' ACTION_'
      
        '11062236=                                              -1,     -' +
        '-:G_PRIHOD_RASHOD_,'
      
        '11062237=                                              :SALES_CO' +
        'MM_SUMM_ITER_ - :SALES_COMM_OLD_,'
      
        '11062238=                                              :ACTION_D' +
        'ATE_ZP_,'
      
        '11062239=                                              :OFFICIAL' +
        '_NAME_,   --NOTE_'
      '11062240=                                              NULL,'
      '11062241=                                              NULL,'
      '11062242=                                              1,'
      
        '11062243=                                              G_OFFICIA' +
        'L_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '11062244='
      '11062245=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062246=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11062247=              EXIT;'
      '11062248=            END'
      '11062249=      END'
      '11062250=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '11062251=      --===============================================' +
        '=================='
      '11062252='
      
        '11062253=      -- '#1045#1057#1051#1048' '#1050#1040#1050#1040#1071'-'#1058#1054' '#1063#1040#1057#1058#1068' '#1041#1067#1051#1040' '#1054#1055#1051#1040#1063#1045#1053#1040' '#1041#1054#1053#1059#1057#1040#1052#1048' - '#1042 +
        #1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1048#1061', '#1058#1054' '#1045#1057#1058#1068' '#1047#1040#1050#1048#1044#1067#1042#1040#1070' '#1050#1051#1048#1045#1053#1058#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1053#1040' '#1053#1040#1050#1054#1055#1051#1045#1053#1048 +
        #1071
      '11062254=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '11062255=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054 +
        #1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '11062256=      UPDATE G_DISCONT_CARD G'
      
        '11062257=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_, ' +
        '0) - :SUMM_BONUS_GOT_,'
      
        '11062258=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0), ' +
        '0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '11062259=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '11062260='
      '11062261=      PNT_ = '#39'04'#39';'
      '11062262=      UPDATE INVOICE I'
      '11062263=         SET I.ZAKAZ = NULL'
      '11062264=       WHERE I.ZAKAZ = :zakaz_;'
      '11062265='
      '11062266=      UPDATE INVOICE_PAY I'
      '11062267=         SET I.ZAKAZ = NULL'
      '11062268=       WHERE I.ZAKAZ = :zakaz_;'
      '11062269='
      '11062270=      UPDATE WAYBILL W'
      '11062271=         SET W.ZAKAZ = NULL'
      '11062272=       WHERE W.ZAKAZ = :zakaz_;'
      '11062273=      --********************************************'
      '11062274='
      '11062275=      PNT_ = '#39'015'#39';'
      '11062276=      DELETE FROM zakaz'
      '11062277=      WHERE zakaz = :zakaz_;'
      '11062278='
      '11062279=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '11062280=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      
        '11062281=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_' +
        'TYPE, ID, OPER)'
      
        '11062282=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ_' +
        ', 3);'
      '11062283=  END'
      '11062284=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '11062285=  --***************************************************' +
        '*************************'
      '11062286=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11062287=  ELSE BEGIN'
      '11062288=    PNT_ = '#39'20'#39';'
      
        '11062289=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '11062290=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062291=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11062292=      EXIT;'
      '11062293=    END'
      '11062294=  END'
      '11062295='
      '11062296=when sqlcode -530 DO'
      '11062297=  begin'
      '11062298=    ERR_CODE = -20500;'
      
        '11062299=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' '#1079 +
        #1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11062300=    ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '11062301=  end'
      '11062302=end'
      '11062303=;'
      '11062304=CREATE OR ALTER PROCEDURE INS_ZAKAZ ('
      '11062305=    G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11062306=    Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11062307=    Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11062308=    G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '11062309=    G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '11062310=    OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11062311=    IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11062312=    NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11062313=    SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11062314=    SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11062315=    SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11062316=    SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11062317=    SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '11062318=    SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '11062319=    G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '11062320=    SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11062321=    BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11062322=    IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11062323=    PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZE 80,'
      '11062324=    IS_MEBEL_ INTEGER = 0,'
      
        '11062325=    DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '11062326=    DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      '11062327=    ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '11062328=    PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '11062329=    UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '11062330=RETURNS ('
      '11062331=    ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11062332=    ERR_CODE INTEGER,'
      '11062333=    ERR_MSG VARCHAR(1024))'
      '11062334=AS'
      '11062335=/*'
      '11062336=IS_SPISANIE_'
      '11062337=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11062338=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11062339=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11062340=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11062341='
      '11062342='
      
        '11062343=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '11062344=*/'
      '11062345=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '11062346=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11062347=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11062348=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '11062349=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '11062350=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '11062351=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ';'
      
        '11062352=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      
        '11062353=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '11062354=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM;'
      '11062355=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11062356=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS_SUMM;'
      
        '11062357=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      
        '11062358=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11062359=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '11062360=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKA' +
        'Z_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      
        '11062361=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11062362=DECLARE VARIABLE CNT_ INTEGER;'
      '11062363=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11062364=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '11062365=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11062366=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11062367=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11062368=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11062369=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11062370=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11062371=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.S' +
        'ALES_COMM;'
      
        '11062372=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11062373=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11062374=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11062375=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '11062376=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM = 0;'
      
        '11062377=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      '11062378=BEGIN'
      '11062379='
      
        '11062380=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057#1048 +
        #1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055#1054 +
        #1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '11062381=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '11062382=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '11062383=  IF (CNT_ = 0) THEN BEGIN'
      '11062384=    ERR_CODE = -20500;'
      
        '11062385=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088#1086 +
        #1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090#1077 +
        ' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11062386=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '11062387=    EXIT;'
      '11062388=  END'
      '11062389='
      '11062390=  IF (G_TOCHKA_ IS NULL) THEN'
      '11062391=    SELECT ID'
      '11062392=      FROM CUR_PARAMS'
      '11062393=     WHERE CUR_PARAMS = 2'
      '11062394=      INTO :G_TOCHKA_;'
      '11062395='
      '11062396=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11062397=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '11062398=      PNT_ = '#39'01'#39';'
      
        '11062399=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11062400=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11062401=      ELSE'
      '11062402=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11062403='
      '11062404=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11062405=      SELECT ID,'
      '11062406=             G.DO_NOT_SALES_COMM,'
      '11062407=             G.FM||'#39' '#39'||G.NM'
      '11062408=        FROM CUR_PARAMS, G_OFFICIAL G'
      '11062409=       WHERE CUR_PARAMS = 1'
      '11062410=         AND ID = G.G_OFFICIAL'
      '11062411=        INTO :G_OFFICIAL_,'
      '11062412=             :DO_NOT_SALES_COMM_,'
      '11062413=             :OFFICIAL_NAME_;'
      '11062414='
      '11062415=      INSERT INTO ZAKAZ'
      '11062416=      ('
      '11062417=       ZAKAZ,'
      '11062418=       G_TOCHKA,'
      '11062419=       Z_DATE,'
      '11062420=       Z_TIME,'
      '11062421=       G_CLIENT,'
      '11062422=       G_PAYMENT_TYPE,'
      '11062423=       OSNOVANIE,'
      '11062424=       IS_SPISANIE,'
      '11062425=       NOTE,'
      '11062426=       SUMM,'
      '11062427=       SUMM_FACT,'
      '11062428=       SUMM_BONUS,'
      '11062429=       IS_PAYED_ALL'
      '11062430=       ,G_OFFICIAL'
      '11062431=       ,BY_RECIPE'
      '11062432=       ,SUMM_BONUS_GOT'
      '11062433=       ,IS_RESERVE'
      '11062434=       ,SUMM_CASH'
      '11062435=       ,SUMM_NONCASH'
      '11062436=      ) VALUES ('
      '11062437=       GEN_ID(GEN_ZAKAZ, 1),'
      '11062438=       :G_TOCHKA_,'
      '11062439=       :Z_DATE_,'
      '11062440=       :Z_TIME_,'
      '11062441=       :G_CLIENT_,'
      '11062442=       :G_PAYMENT_TYPE_,'
      '11062443=       :OSNOVANIE_,'
      '11062444=       :IS_SPISANIE_,'
      '11062445=       :NOTE_,'
      '11062446=       :SUMM_,'
      '11062447=       :SUMM_FACT_1_,'
      '11062448=       COALESCE(:SUMM_BONUS_, 0),'
      
        '11062449=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_B' +
        'ONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052 +
        #1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11062450=       ,:G_OFFICIAL_'
      '11062451=       ,:BY_RECIPE_'
      '11062452=       ,:SUMM_BONUS_GOT_'
      '11062453=       ,:IS_RESERVE_'
      '11062454=       ,COALESCE(:SUMM_CASH_, 0)'
      '11062455=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '11062456=      )'
      '11062457=      RETURNING'
      '11062458=        ZAKAZ'
      '11062459=      INTO'
      '11062460=        :ZAKAZ_;'
      '11062461='
      '11062462=      PNT_ = '#39'02'#39';'
      
        '11062463=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUNT' +
        ', Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUNT' +
        '_SUMM,'
      
        '11062464=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SAL' +
        'ES_COMM'
      '11062465=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '11062466=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '11062467=          INTO :ZAKAZ_DETAILS_TMP_,'
      '11062468=              :G_PRODUCT,'
      '11062469=              :AMOUNT,'
      '11062470=              :PRICE,'
      '11062471=              :SUMM,'
      '11062472=              :DISCOUNT_PERC,'
      '11062473=              :DISCOUNT_TENGE,'
      '11062474=              :DISCOUNT_SUMM,'
      '11062475=              :NDS,'
      '11062476=              :NDS_SUMM,'
      '11062477=              :COST_PRICE,'
      '11062478=              :SALES_COMM_'
      '11062479=      DO BEGIN'
      
        '11062480=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056 +
        #1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040 +
        #1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '11062481=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '11062482=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/10' +
        '0;'
      
        '11062483=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_ ' +
        '+ SALES_COMM_SUMM_ITER_;'
      '11062484=        END'
      '11062485='
      '11062486=        INSERT INTO ZAKAZ_DETAILS'
      '11062487=        VALUES('
      '11062488=          :ZAKAZ_DETAILS_TMP_,'
      '11062489=          :ZAKAZ_,'
      '11062490=          :G_PRODUCT,'
      '11062491=          :AMOUNT,'
      '11062492=          :PRICE,'
      '11062493=          :SUMM,'
      '11062494=          :DISCOUNT_PERC,'
      '11062495=          :DISCOUNT_TENGE,'
      '11062496=          :DISCOUNT_SUMM,'
      '11062497=          :NDS,'
      '11062498=          :NDS_SUMM,'
      '11062499=          :COST_PRICE,'
      '11062500=          :SALES_COMM_SUMM_ITER_'
      '11062501=        );'
      '11062502='
      '11062503=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11062504=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '11062505=            UPDATE LT_SKLAD_PRODUCT L'
      '11062506=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11062507=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11062508=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11062509='
      '11062510=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '11062511=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11062512=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '11062513=            PNT_ = '#39'04'#39';'
      
        '11062514=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11062515=              Err_Code = -20500;'
      
        '11062516=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11062517=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11062518=              EXIT;'
      '11062519=            END ELSE if (ROW_COUNT = 0) then'
      
        '11062520=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11062521=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11062522=        END'
      '11062523='
      '11062524=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '11062525=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '11062526=            UPDATE LT_SKLAD_PRODUCT L'
      
        '11062527=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE ' +
        '+ :AMOUNT'
      '11062528=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11062529=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11062530=      END'
      '11062531='
      '11062532=      ----------------------------------------'
      
        '11062533=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053 +
        #1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '11062534=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '11062535=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '11062536='
      
        '11062537=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '11062538=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '11062539=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '11062540=                PNT_ = '#39'05'#39';'
      
        '11062541=                EXECUTE PROCEDURE K_INS_KASSA(0,     --' +
        ' ACTION_ => :ACTION_'
      
        '11062542=                                              1,     --' +
        ' G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '11062543=                                              :SUMM_FAC' +
        'T_1_,'
      '11062544=                                              :Z_DATE_,'
      
        '11062545=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11062546=                                              ZAKAZ_,  ' +
        ' --ZAKAZ_'
      '11062547=                                              NULL,'
      
        '11062548=                                              :G_PAYMEN' +
        'T_TYPE_,'
      
        '11062549=                                              :G_TOCHKA' +
        '_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11062550=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062551=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_' +
        '||'#39' '#39'||ERR_MSG;'
      '11062552=                  EXIT;'
      '11062553=                END'
      '11062554=            END'
      '11062555='
      '11062556=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '11062557=        END ELSE BEGIN'
      '11062558=            PNT_ = '#39'06'#39';'
      '11062559=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      
        '11062560=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_)' +
        ';'
      
        '11062561=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA' +
        '_) THEN'
      
        '11062562=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' POS_TILDA_ - 1);'
      '11062563=                ELSE'
      
        '11062564=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' CHAR_LENGTH(PAYMENTS_) - 1);'
      '11062565='
      
        '11062566=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR' +
        '_)'
      
        '11062567=                    RETURNING_VALUES :PAYMENT_ID_, :PAY' +
        'MENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11062568='
      
        '11062569=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM ' +
        '(POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '11062570='
      '11062571=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11062572=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11062573=                                                  1,   ' +
        '  --:G_PRIHOD_RASHOD_,'
      
        '11062574=                                                  :PAYM' +
        'ENT_SUMM_,'
      
        '11062575=                                                  :PAYM' +
        'ENT_DATE_,'
      
        '11062576=                                                  NULL,' +
        '   --NOTE_ => :NOTE_,'
      
        '11062577=                                                  :ZAKA' +
        'Z_,'
      
        '11062578=                                                  NULL,' +
        '     --:SKLAD_,'
      
        '11062579=                                                  :PAYM' +
        'ENT_TYPE_,'
      
        '11062580=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11062581=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062582=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '11062583=                      EXIT;'
      '11062584=                    END'
      '11062585=                END'
      '11062586=            END'
      '11062587=        END'
      '11062588=      END'
      '11062589='
      
        '11062590=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '11062591=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041#1054 +
        #1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '11062592=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052' ' +
        #1057#1051#1059#1063#1040#1045
      '11062593=      UPDATE G_DISCONT_CARD D'
      
        '11062594=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0) +' +
        ' :SUMM_BONUS_GOT_,'
      '11062595=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '11062596=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '11062597='
      '11062598=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '11062599=      PNT_ = '#39'07'#39';'
      
        '11062600=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COMM' +
        '_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN BE' +
        'GIN'
      '11062601=        SELECT S.S_VALUE'
      '11062602=          FROM SYSTEM_SETUP S'
      '11062603=         WHERE S.SYSTEM_SETUP = 4'
      '11062604=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '11062605='
      '11062606=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11062607=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11062608=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11062609='
      
        '11062610=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' '#1041 +
        #1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11062611=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11062612=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE(' +
        'EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM C' +
        'URRENT_DATE)));'
      '11062613='
      '11062614=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11062615=        ELSE'
      
        '11062616=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DAY' +
        ' FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32);'
      '11062617='
      '11062618=        KASSA_ = NULL;'
      '11062619=        SELECT K.KASSA, K.SUMM'
      '11062620=        FROM KASSA K'
      '11062621=        WHERE K.G_PRIHOD_RASHOD = -1'
      '11062622=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '11062623=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '11062624=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '11062625='
      '11062626=        IF (KASSA_ IS NULL) THEN'
      
        '11062627=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11062628=                                          -1,     --:G_' +
        'PRIHOD_RASHOD_,'
      
        '11062629=                                          :SALES_COMM_S' +
        'UMM_ALL_,'
      
        '11062630=                                          :ACTION_DATE_' +
        'ZP_,'
      
        '11062631=                                          :OFFICIAL_NAM' +
        'E_,'
      
        '11062632=                                          NULL,     --:' +
        'ZAKAZ_,'
      
        '11062633=                                          NULL,     --:' +
        'SKLAD_,'
      '11062634=                                          1,'
      '11062635=                                          :G_TOCHKA_,'
      '11062636=                                          :G_OFFICIAL_'
      
        '11062637=                                          ) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11062638=        ELSE'
      '11062639=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '11062640=                                          1,     -- ACT' +
        'ION_'
      
        '11062641=                                          -1,     --:G_' +
        'PRIHOD_RASHOD_,'
      
        '11062642=                                          :SALES_COMM_S' +
        'UMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '11062643=                                          :ACTION_DATE_' +
        'ZP_,'
      
        '11062644=                                          :OFFICIAL_NAM' +
        'E_,   --NOTE_'
      '11062645=                                          NULL,'
      '11062646=                                          NULL,'
      
        '11062647=                                          :PAYMENT_TYPE' +
        '_,'
      '11062648=                                          :G_OFFICIAL_'
      
        '11062649=                                          ) RETURNING_V' +
        'ALUES :ERR_CODE, :ERR_MSG;'
      '11062650='
      '11062651=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062652=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11062653=          EXIT;'
      '11062654=        END'
      '11062655=      END'
      '11062656='
      '11062657=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '11062658=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      
        '11062659=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_' +
        'TYPE, ID, OPER)'
      
        '11062660=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ_' +
        ', 1);'
      '11062661=  END'
      '11062662=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11062663=  ----------------------------------------'
      '11062664=  ----------------------------------------'
      '11062665=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11062666=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '11062667=      PNT_ = '#39'25'#39';'
      
        '11062668=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT,' +
        ' G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHKA' +
        ')'
      
        '11062669=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLIE' +
        'NT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA_' +
        ')'
      '11062670=      RETURNING ZAKAZ_REAL_PARENT'
      '11062671=      INTO :ZAKAZ_REAL_PARENT_;'
      '11062672='
      
        '11062673=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOU' +
        'NT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '11062674=            FROM ZAKAZ_DETAILS_TMP Z'
      '11062675=          INTO :G_PRODUCT,'
      '11062676=              :AMOUNT,'
      '11062677=              :PRICE,'
      '11062678=              :SUMM,'
      '11062679=              :DISCOUNT_PERC,'
      '11062680=              :DISCOUNT_TENGE,'
      '11062681=              :DISCOUNT_SUMM,'
      '11062682=              :NDS,'
      '11062683=              :NDS_SUMM'
      '11062684=      DO BEGIN'
      '11062685=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11062686=          UPDATE LT_SKLAD_PRODUCT L'
      '11062687=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11062688=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '11062689=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '11062690='
      
        '11062691=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053#1054' ' +
        #1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045' '#1047 +
        #1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11062692=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048#1057 +
        #1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '11062693=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FROM' +
        ' SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11062694=            Err_Code = -20500;'
      
        '11062695=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1055#1086 +
        ' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUCT ' +
        '= :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088 +
        #1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11062696=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11062697=            EXIT;'
      '11062698=          END ELSE if (ROW_COUNT = 0) then'
      
        '11062699=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11062700=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11062701='
      
        '11062702=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZAK' +
        'AZ_REAL_PARENT,'
      '11062703=                                     G_PRODUCT,'
      '11062704=                                     PRICE,'
      
        '11062705=                                     AMOUNT_ALL, SUMM_A' +
        'LL,'
      
        '11062706=                                     AMOUNT_PAYED, SUMM' +
        '_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SU' +
        'MM, NDS,'
      '11062707=                                     NDS_SUMM)'
      
        '11062708=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ_' +
        'REAL_PARENT_,'
      '11062709=                  :G_PRODUCT,'
      
        '11062710=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040#1070 +
        ' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '11062711=                  :AMOUNT, :SUMM,'
      '11062712=                  0, --AMOUNT_PAYED,'
      '11062713=                  0, --SUMM_PAYED,'
      '11062714=                  0, --IS_PAYED_ALL,'
      '11062715=                  :DISCOUNT_PERC,'
      '11062716=                  :DISCOUNT_TENGE,'
      '11062717=                  :DISCOUNT_SUMM,'
      '11062718=                  :NDS,'
      '11062719=                  :NDS_SUMM)'
      '11062720=          RETURNING ZAKAZ_NA_REAL'
      '11062721=          INTO :ZAKAZ_;'
      '11062722=      END'
      '11062723=  END'
      '11062724=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11062725=  ----------------------------------------'
      '11062726=  ----------------------------------------'
      '11062727=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '11062728=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046#1040 +
        #1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '11062729=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', '#1040 +
        ' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11062730=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '11062731=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, TI' +
        'ME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SUM' +
        'M_FACT,'
      
        '11062732=                                IS_PAYED_ALL, IS_VOZVRA' +
        'T, G_TOCHKA)'
      
        '11062733=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_,' +
        ' :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SUM' +
        'M_FACT_,'
      '11062734=              1, 3, :G_CLIENT_)'
      '11062735=      RETURNING SKLAD'
      '11062736=      INTO :SKLAD_;'
      '11062737='
      '11062738=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '11062739=            FROM ZAKAZ_DETAILS_TMP Z'
      '11062740=          INTO :G_PRODUCT,'
      '11062741=              :AMOUNT,'
      '11062742=              :PRICE,'
      '11062743=              :SUMM'
      '11062744=      DO BEGIN'
      '11062745=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11062746=        UPDATE LT_SKLAD_PRODUCT L'
      '11062747=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11062748=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11062749=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '11062750='
      '11062751=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '11062752=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1053#1045#1058
      
        '11062753=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045#1064#1048 +
        #1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' '#1062#1045 +
        #1053#1059
      '11062754=        SELECT MAX(SK.DATE_RECEIPT)'
      '11062755=            FROM SKLAD SK'
      '11062756=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11062757=             AND SK.IS_LAST = 1'
      '11062758=             AND SK.G_TOCHKA = :G_CLIENT_'
      '11062759=            INTO :DATE_LAST_;'
      '11062760='
      
        '11062761=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048 +
        ' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11062762=            UPDATE SKLAD SK'
      '11062763=               SET SK.IS_LAST = 0'
      '11062764=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11062765=               AND SK.IS_LAST = 1'
      '11062766=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '11062767='
      '11062768=            IS_THIS_LAST_ = 1;'
      '11062769=        END */'
      '11062770='
      '11062771='
      '11062772=        INSERT INTO SKLAD'
      '11062773=        ('
      '11062774=         SKLAD,'
      '11062775=         SKLAD_PARENT,'
      '11062776=         DATE_RECEIPT,'
      '11062777=         G_CLIENT,'
      '11062778=         G_PRODUCT,'
      '11062779=         AMOUNT,'
      '11062780=         PRICE,'
      '11062781=         SUMM,'
      '11062782=         G_PAYMENT_TYPE,'
      '11062783=         OSNOVANIE,'
      '11062784=         NOTE,'
      '11062785=         NDS,'
      '11062786=         NDS_SUMM,'
      '11062787=         IS_LAST,'
      '11062788=         IS_VOZVRAT,'
      '11062789=         G_TOCHKA'
      '11062790=        ) VALUES ('
      '11062791=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '11062792=         :SKLAD_,'
      '11062793=         :Z_DATE_,'
      '11062794=         :G_TOCHKA_,'
      '11062795=         :G_PRODUCT,'
      '11062796=         :AMOUNT,'
      '11062797=         :PRICE,'
      '11062798=         :SUMM,'
      '11062799=         :G_PAYMENT_TYPE_,'
      '11062800=         :OSNOVANIE_,'
      '11062801=         :NOTE_,'
      '11062802=         0,  --:RNDS_,'
      '11062803=         0,  --:RNDS_SUMM_,'
      
        '11062804=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' ' +
        #1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' ' +
        #1041#1059#1044#1045#1058' 0'
      '11062805=         3,  --:IS_VOZVRAT_,'
      '11062806=         :G_CLIENT_'
      '11062807=        );'
      '11062808='
      
        '11062809=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' '#1045 +
        #1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '11062810=        PNT_ = '#39'02'#39';'
      '11062811=        UPDATE LT_SKLAD_PRODUCT L'
      '11062812=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '11062813=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11062814=           AND L.G_TOCHKA = :G_CLIENT_;'
      '11062815='
      '11062816=        IF (ROW_COUNT = 0) THEN'
      
        '11062817=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PROD' +
        'UCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '11062818=      END'
      '11062819=  END'
      '11062820='
      '11062821=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '11062822='
      
        '11062823=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054 +
        #1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '11062824=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11062825=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ => ' +
        ':ACTION_'
      '11062826=                                  G_PRIHOD_,'
      '11062827=                                  :SUMM_PRIHOD_,'
      '11062828=                                  :Z_DATE_,'
      
        '11062829=                                  NULL,   --NOTE_ => :N' +
        'OTE_,'
      '11062830=                                  :ZAKAZ_,'
      '11062831=                                  NULL,'
      '11062832=                                  :G_PAYMENT_TYPE_,'
      
        '11062833=                                  :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11062834=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062835=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11062836=      EXIT;'
      '11062837=    END'
      '11062838=  END'
      '11062839='
      
        '11062840=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057#1058 +
        #1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '11062841=  IF (IS_MEBEL_ = 1) THEN'
      
        '11062842=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS,' +
        ' ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '11062843=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, :' +
        'ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '11062844=end'
      '11062845=;'
      '11062846=CREATE OR ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL ('
      '11062847=    ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11062848=    Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11062849=    Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11062850=    G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '11062851=    G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '11062852=    OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11062853=    NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11062854=    SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11062855=    SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11062856=    SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11062857=    SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11062858=    SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '11062859=    SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '11062860=    G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '11062861=    SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11062862=    IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11062863=    BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11062864=    IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11062865=    PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZE 80,'
      '11062866=    UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '11062867=RETURNS ('
      '11062868=    ERR_CODE INTEGER,'
      '11062869=    ERR_MSG VARCHAR(1024))'
      '11062870=AS'
      '11062871=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '11062872='#1055#1056#1048' '#1069#1058#1054#1052':'
      '11062873=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '11062874=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041#1067#1051 +
        #1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '11062875='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040#1058#1054 +
        #1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057#1048#1048 +
        ' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '11062876=*/'
      
        '11062877=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ_D' +
        'ETAIL'#39';'
      '11062878=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11062879=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '11062880=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11062881=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZAK' +
        'AZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '11062882=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.ZAKAZ_DETAILS;'
      
        '11062883=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '11062884=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '11062885=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '11062886=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11062887=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA.' +
        'G_TOCHKA;'
      '11062888=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '11062889=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11062890=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOUN' +
        'T;'
      
        '11062891=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLAD' +
        '.DATE_RECEIPT;'
      
        '11062892=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      '11062893=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '11062894=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11062895=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM; /' +
        '* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '11062896=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '11062897=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN ZAK' +
        'AZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '11062898=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11062899=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11062900=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11062901=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      
        '11062902=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      '11062903=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11062904=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11062905=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044#1051#1071 +
        ' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '11062906=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIENT.' +
        'G_CLIENT;'
      
        '11062907=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.S' +
        'ALES_COMM;'
      
        '11062908=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11062909=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11062910=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11062911=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '11062912=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM = 0;'
      
        '11062913=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRODU' +
        'CT.SALES_COMM;'
      
        '11062914=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '11062915=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.SUMM;'
      
        '11062916=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11062917=BEGIN'
      '11062918='
      '11062919=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11062920=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '11062921=      SELECT Z.G_PAYMENT_TYPE,'
      '11062922=             Z.G_TOCHKA,'
      '11062923=             Z.SUMM,'
      '11062924=             Z.SUMM_BONUS,'
      '11062925=             Z.SUMM_BONUS_GOT,'
      '11062926=             z.g_client,'
      '11062927=             Z.G_OFFICIAL,'
      '11062928=             G.DO_NOT_SALES_COMM,'
      '11062929=             G.FM||'#39' '#39'||G.NM'
      
        '11062930=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z.' +
        'G_OFFICIAL = G.G_OFFICIAL'
      '11062931=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '11062932=        INTO :G_PAYMENT_TYPE_OLD_,'
      '11062933=             :G_TOCHKA_,'
      '11062934=             :SUMM_OLD_,'
      '11062935=             :SUMM_BONUS_OLD_,'
      '11062936=             :SUMM_BONUS_GOT_OLD_,'
      '11062937=             :g_client_old_,'
      '11062938=             :G_OFFICIAL_,'
      '11062939=             :DO_NOT_SALES_COMM_,'
      '11062940=             :OFFICIAL_NAME_;'
      '11062941='
      
        '11062942=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059
      
        '11062943=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COMM' +
        '_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '11062944=        SELECT SUM(ZD.SALES_COMM)'
      '11062945=          FROM ZAKAZ_DETAILS ZD'
      '11062946=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '11062947=          INTO :SALES_COMM_OLD_;'
      '11062948='
      '11062949=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '11062950=      PNT_ = '#39'02'#39';'
      
        '11062951=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETUR' +
        'NING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11062952=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11062953=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11062954=        EXIT;'
      '11062955=      END'
      '11062956='
      
        '11062957=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11062958=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11062959=      ELSE'
      '11062960=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11062961='
      '11062962=      PNT_ = '#39'01'#39';'
      '11062963=      UPDATE zakaz'
      '11062964=      SET'
      '11062965=       G_TOCHKA = :G_TOCHKA_,'
      '11062966=       Z_DATE = :Z_DATE_,'
      '11062967=       Z_TIME = :Z_TIME_,'
      '11062968=       G_CLIENT = :G_CLIENT_,'
      '11062969=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '11062970=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '11062971=       NOTE = COALESCE(:NOTE_, NOTE),'
      '11062972=       SUMM = :SUMM_,'
      '11062973=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '11062974=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ + :' +
        'SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11062975=       ,BY_RECIPE = :BY_RECIPE_'
      '11062976=       ,IS_RESERVE = :IS_RESERVE_'
      '11062977=       ,SUMM_BONUS = :SUMM_BONUS_'
      '11062978=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '11062979=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '11062980=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '11062981=      WHERE'
      '11062982=        zakaz = :zakaz_;'
      '11062983='
      
        '11062984=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059','
      '11062985=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '11062986=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058' '#1053 +
        #1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052#1040#1058 +
        #1068
      '11062987=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '11062988=          UPDATE G_DISCONT_CARD D'
      '11062989=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '11062990=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '11062991=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '11062992='
      
        '11062993=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059' '#1054 +
        #1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '11062994=          SUMM_OLD_           = 0;'
      '11062995=      END'
      '11062996=      UPDATE G_DISCONT_CARD D'
      
        '11062997=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM_B' +
        'ONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '11062998=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :SUM' +
        'M_'
      '11062999=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110621000='
      '110621001=      PNT_ = '#39'03'#39';'
      '110621002=      FOR SELECT T.ZAKAZ_DETAILS,'
      '110621003=                 T.G_PRODUCT,'
      '110621004=                 T.AMOUNT,'
      '110621005=                 T.SUMM,'
      '110621006=                 G.SALES_COMM'
      '110621007=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '110621008=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '110621009=      INTO :ZAKAZ_DETAILS_,'
      '110621010=           :G_PRODUCT_,'
      '110621011=           :Z_AMOUNT_,'
      '110621012=           :DETAILS_SUMM_,'
      '110621013=           :SALES_COMM_'
      '110621014=      DO BEGIN'
      
        '110621015=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110621016=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = ' +
        '0) THEN BEGIN'
      
        '110621017=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SALE' +
        'S_COMM_/100;'
      
        '110621018=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110621019=        END'
      '110621020='
      
        '110621021=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110621022=                                   DISCOUNT_TENGE, DIS' +
        'COUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '110621023=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110621024=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS' +
        '_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '110621025=          FROM ZAKAZ_DETAILS_TMP Z'
      '110621026=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '110621027='
      
        '110621028=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050 +
        #1051#1040#1044#1040
      '110621029=        IF (IS_RESERVE_ = 0) THEN'
      '110621030=            UPDATE LT_SKLAD_PRODUCT L'
      '110621031=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '110621032=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621033=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110621034='
      '110621035=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110621036=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110621037=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110621038=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :Z_AMOUNT_'
      '110621039=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621040=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110621041=      END'
      '110621042='
      '110621043=      ----------------------------------------'
      
        '110621044=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058#1068 +
        ' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '110621045=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048' ' +
        #1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '110621046=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048 +
        #1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110621047=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '110621048=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047 +
        #1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068 +
        ' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '110621049=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042 +
        #1045#1053#1053#1054')'
      
        '110621050=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110621051=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '110621052=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '110621053=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      '110621054=                PNT_ = '#39'04'#39';'
      
        '110621055=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110621056=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110621057=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110621058=                ELSE'
      
        '110621059=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110621060='
      
        '110621061=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110621062=                    RETURNING_VALUES :KASSA_, :PAYMENT' +
        '_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110621063='
      
        '110621064=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110621065='
      '110621066=                PNT_ = '#39'05'#39';'
      
        '110621067=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) ' +
        'THEN'
      
        '110621068=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_'
      
        '110621069=                                                  1,  ' +
        '   -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110621070=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110621071=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110621072=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110621073=                                                  :ZAK' +
        'AZ_,   --ZAKAZ_'
      
        '110621074=                                                  NULL' +
        ','
      
        '110621075=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110621076=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110621077='
      
        '110621078=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057 +
        #1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '110621079=                ELSE BEGIN'
      
        '110621080=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053 +
        #1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '110621081=                    SELECT 1'
      '110621082=                      FROM KASSA K'
      '110621083=                     WHERE K.KASSA = :KASSA_'
      '110621084=                    UNION ALL'
      '110621085=                    SELECT 2'
      '110621086=                      FROM KASSA_BEZNAL KB'
      '110621087=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110621088=                     INTO :PAYMENT_TYPE_OLD_;'
      '110621089='
      '110621090=                    PNT_ = '#39'06'#39';'
      
        '110621091=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_TY' +
        'PE_) THEN'
      
        '110621092=                        EXECUTE PROCEDURE K_UPD_KASSA(' +
        ':KASSA_,'
      
        '110621093=                                                      ' +
