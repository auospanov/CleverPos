        '110752522=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067 +
        #1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110752523=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '110752524=                INSERT INTO SKLAD (SKLAD, SKLAD_PARENT' +
        ', DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYM' +
        'ENT_TYPE, NDS, NDS_SUMM,'
      
