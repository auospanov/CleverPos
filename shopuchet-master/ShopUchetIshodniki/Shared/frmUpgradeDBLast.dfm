        '11020253=  SYNC_COMPS_ /* TYPE OF COLUMN SYNC_COMPS.SYNC_COMPS *' +
        '/ INTEGER)'
      '11020254=RETURNS ('
      '11020255=  ID /* TYPE OF COLUMN LOGS.ID */ BIGINT,'
      
        '11020256=  SQLSTMT /* TYPE OF COLUMN LOGS.SQLSTMT */ VARCHAR(300' +
        '00),'
      '11020257=  USR /* TYPE OF COLUMN LOGS.USR */ VARCHAR(50),'
      '11020258=  RR /* TYPE OF COLUMN LOGS.RR */ VARCHAR(50),'
      
        '11020259=  DAT /* TYPE OF COLUMN LOGS.DAT */ BLOB SEGMENT SIZE 1' +
        '6384)'
      '11020260=AS'
      '11020261=BEGIN'
