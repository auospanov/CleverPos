      '110246637=  BONUS_STR_ VARCHAR(100),'
      '110246638=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110246639=  ERR_CODE NUMERIC(15,2),'
      '110246640=  ERR_MSG VARCHAR(1024),'
      '110246641=  NAME_MARKER VARCHAR(1000),'
      '110246642=  BONUSALL_STR_ VARCHAR(100))'
      '110246643=AS'
      '110246644=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045
      '110246645='
      '110246646=26.09.2022'
      
        '110246647='#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1054#1041#1065#1040#1071' '#1057#1050#1048#1044#1050#1040' '#1042' '#1050#1054#1053#1062#1045' '#1063#1045#1050#1040', '#1063#1058#1054' '#1041#1067#1051#1054' ' +
        #1053#1045#1059#1044#1054#1041#1053#1054', '#1053#1045#1055#1054#1053#1071#1058#1053#1054' '#1053#1040' '#1050#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1041#1067#1051#1040' '#1057#1050#1048#1044#1050#1040
      
        '110246648='#1058#1045#1055#1045#1056#1068' '#1046#1045' '#1057#1050#1048#1044#1050#1040' '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1055#1054#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1054#1042#1040#1056#1054#1052'. '#1048#1057#1061#1054#1044#1071 +
        ' '#1048#1047' '#1069#1058#1054#1043#1054' '#1053#1045#1050#1054#1058#1054#1056#1067#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1067#1045' '#1059#1055#1056#1040#1047#1044#1053#1048#1051#1048#1057#1068
      '110246649='
      
        '110246650='#1058#1045#1055#1045#1056#1068' '#1057#1058#1056#1054#1050#1040' "'#1057#1059#1052#1052#1040'" '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1041#1067#1051#1054' '#1044#1054#1041#1040 +
        #1042#1051#1045#1053#1054' "'#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%"'
      '110246651='
      
        '110246652=SUMM_VSEGO_ - '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054#1050 +
        ', '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '110246653=SUMM_VSEGO_WITHOUT_SERVICE_ - '#1058#1045#1055#1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053 +
        #1053#1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '110246654='
      '110246655='
      
        '110246656=SUMM_POLUCH_  - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1055#1054#1051#1059#1063#1045#1053#1054' ' +
        #1054#1058' '#1050#1051#1048#1045#1053#1058#1040' '#1053#1040#1051#1048#1063#1053#1067#1052#1048' = SUMM_DANO_, '#1055#1056#1048#1061#1054#1044#1048#1058' '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040
      
        '110246657=SUMM_NONCASH_ - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1054#1055#1051#1040#1063#1045#1053#1054' ' +
        #1055#1054' '#1041#1045#1047#1053#1040#1051#1059
      '110246658=SUMM_BONUS_   - '#1057#1050#1054#1051#1068#1050#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1041#1054#1053#1059#1057#1040#1052#1048
      '110246659='
      
        '110246660=PAYMENT_TYPE_ - '#1059#1055#1056#1040#1047#1044#1053#1045#1053#1040', '#1058'.'#1050'. '#1057#1058#1056#1054#1050#1040' "'#1057#1055#1054#1057#1054#1041' '#1054#1055#1051#1040#1058#1067 +
        '" '#1059#1041#1056#1040#1053#1040', '#1058#1045#1055#1045#1056#1068' '#1042#1053#1048#1047#1059' '#1041#1059#1044#1045#1058' '#1044#1042#1045' '#1057#1058#1056#1054#1050#1048':'
      '110246661="'#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '110246662="'#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '110246663='
      '110246664=----'
      '110246665=*/'
      '110246666=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '110246667=DECLARE VARIABLE PNT_ VARCHAR(5) = '#39'00'#39';'
      '110246668=DECLARE VARIABLE I INTEGER = 1;'
      
        '110246669=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110246670=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110246671=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.AMOUNT;'
      
        '110246672=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.SUMM;'
      '110246673=BEGIN'
      '110246674=  SLOGAN_ = PRINT_SLOGAN_;'
      '110246675=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '110246676=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '110246677=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_' +
        ';'
      '110246678=  END'
      '110246679='
      '110246680=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110246681=  SELECT z.ZAKAZ'
      '110246682=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '110246683=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')' +
        '||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '110246684=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '110246685=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COAL' +
        'ESCE(O.NM, '#39#39')'
      '110246686=         ,Z.NOTE'
      
        '110246687=         ,CAST(ROUND(Z.summ_noncash, 2) AS VARCHAR(100' +
        '))'
      '110246688=         ,CAST(ROUND(:SUMM_DANO_, 2) AS VARCHAR(100))'
      
        '110246689=         ,CAST(ROUND(:SUMM_SDACHA_, 2) AS VARCHAR(100)' +
        ')'
      '110246690=         ,CAST(ROUND(Z.SUMM_BONUS, 2) AS VARCHAR(100))'
      
        '110246691=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '110246692=         G_CLIENT G,'
      '110246693=         G_PAYMENT_TYPE P'
      '110246694=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110246695=     AND Z.G_CLIENT = G.G_CLIENT'
      '110246696=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110246697=    INTO :NUM_'
      '110246698=        ,:PAYMENT_TYPE_'
      '110246699=        ,:DATE_'
      '110246700=        ,:G_CLIENT_NAME_'
      '110246701=        ,:G_OFFICIAL_FM_'
      '110246702=        ,:NOTE_'
      '110246703=        ,:SUMM_NONCASH_'
      '110246704=        ,:SUMM_POLUCH_'
      '110246705=        ,:SUMM_SDACH_'
      '110246706=        ,:SUMM_BONUS_'
      '110246707=        ;'
      '110246708='
      '110246709=  --'#1041#1054#1053#1059#1057#1067' '#1042' '#1063#1045#1050#1045
      '110246710=  IF (BONUS_ > 0) THEN'
      '110246711=  BEGIN'
      
        '110246712=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_, 2) AS VARCHAR(100));'
      '110246713=  END'
      '110246714='
      '110246715=  if (BONUS_ALL_ > 0) then'
      '110246716=  BEGIN'
      
        '110246717=    BONUSALL_STR_ = '#39#1042#1089#1077#1075#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(BO' +
        'NUS_ALL_, 2) AS VARCHAR(100));'
      '110246718=  END'
      '110246719='
      '110246720=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110246721=  --IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110246722=  --  PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110246723='
      '110246724=  SELECT R.G_FIRM_REKVIZIT,'
      '110246725=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110246726=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110246727=    FROM G_FIRM_REKVIZIT R'
      '110246728=   WHERE R.is_default = 1'
      '110246729=    INTO :G_FIRM_REKVIZIT_,'
      '110246730=         :FIRM_NAME_,'
      '110246731=         :FIRM_IDN_;'
      '110246732='
      '110246733=  SELECT ZD.SUMM'
      '110246734=    FROM ZAKAZ_DETAILS ZD'
      '110246735=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110246736=    AND ZD.G_PRODUCT = -2'
      '110246737=    INTO :SERVICE_SUMM_;'
      '110246738=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110246739='
      '110246740=  SELECT SUM(ZD.AMOUNT),'
      
        '110246741=         CAST(ROUND(SUM((CASE WHEN ZD.DISCOUNT_SUMM>0 ' +
        'THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)),'
      
        '110246742=         CAST(ROUND(SUM(ZD.SUMM + (CASE WHEN ZD.DISCOU' +
        'NT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50))' +
        ','
      '110246743=         CAST(SUM(ZD.SUMM) AS VARCHAR(50)),'
      
        '110246744=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110246745=         CAST(:SERVICE_SUMM_  AS VARCHAR(50)),'
      '110246746=         CAST(SUM(ZD.NDS_SUMM) AS VARCHAR(50))'
      '110246747=  FROM ZAKAZ_DETAILS ZD'
      '110246748=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110246749=    AND ZD.G_PRODUCT <> -2'
      '110246750=  INTO :AMOUNT_VSEGO_NUM_,'
      '110246751=       :SUMM_SKIDKA_,'
      
        '110246752=       :SUMM_VSEGO_,     -- 26.09.2022 '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040 +
        #1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054#1050', '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042#1057 +
        #1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '110246753=       :SUMM_VSEGO_WITHOUT_SERVICE_, -- 26.09.2022 '#1058#1045#1055 +
        #1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '110246754=       :SUMM_VSEGO_N_,'
      '110246755=       :SUMM_SERVICE_,'
      '110246756=       :SUMM_NDS_;'
      '110246757='
      '110246758=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110246759=    FROM G_FIRM_ADDRESS R'
      '110246760=   WHERE R.IS_DEFAULT = 1'
      '110246761=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110246762=    INTO :FIRM_ADDRESS_;'
      '110246763='
      
        '110246764=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110246765=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110246766=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110246767=    IF (CURRENCY_ = 0) THEN'
      '110246768=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110246769=    ELSE'
      '110246770=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110246771=  END'
      '110246772='
      '110246773=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110246774='
      '110246775=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110246776=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110246777=  INTO :SUMM_STR_;'
      '110246778='
      '110246779=  FOR'
      '110246780=    SELECT :I || '#39'. '#39' || G.NAME,'
      
        '110246781=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.MA' +
        'RK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||Z' +
        'D.MARK_CODE END),'
      
        '110246782=           (CASE WHEN (G.ARTICUL is null) or (G.ARTICU' +
        'L = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '110246783=           ZD.AMOUNT,'
      
        '110246784=           CAST(ROUND(ZD.PRICE - (CASE WHEN ZD.DISCOUN' +
        'T_SUMM<0 THEN ZD.DISCOUNT_SUMM else 0 END)/ZD.AMOUNT, 2) AS VARC' +
        'HAR(100)),'
      
        '110246785=           CAST(ROUND(ZD.SUMM + (CASE WHEN ZD.DISCOUNT' +
        '_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END) , 2) AS VARCHAR(100))'
      '110246786=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110246787=           ,CAST(ZD.PRICE AS VARCHAR(100))--CAST(ZD.PR' +
        'ICE - ZD.DISCOUNT_TENGE AS VARCHAR(100))'
      '110246788=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110246789=           ,CAST(ZD.DISCOUNT_SUMM AS VARCHAR(100))'
      '110246790=      FROM ZAKAZ Z,'
      '110246791=           ZAKAZ_DETAILS ZD,'
      '110246792=           G_PRODUCT G,'
      '110246793=           G_UNIT U'
      '110246794=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110246795=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110246796=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110246797=       AND G.G_UNIT = U.G_UNIT'
      '110246798=       AND G.G_PRODUCT <> -2'
      '110246799=     ORDER BY ZD.zakaz_details'
      '110246800=    INTO :NAME,'
      '110246801=        :NAME_MARKER,'
      '110246802=        :NAME_ART,'
      '110246803=        :AMOUNT_NUM_,'
      '110246804=        :PRICE,'
      '110246805=        :SUMM'
      '110246806=        ,:SHORT_NAME'
      '110246807=        ,:PRICE_N'
      '110246808=        ,:SUMM_N'
      '110246809=        ,:DISCOUNT'
      '110246810='
      '110246811=  DO BEGIN'
      '110246812=    I = I + 1;'
      '110246813='
      
        '110246814=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110246815=    /*if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110246816=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110246817=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110246818=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110246819=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110246820=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110246821=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110246822=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110246823=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110246824=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110246825=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110246826=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110246827=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110246828=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110246829=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110246830=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110246831=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110246832=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110246833=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110246834=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110246835=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110246836=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);*/'
      '110246837='
      '110246838=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110246839=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110246840=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110246841=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110246842=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110246843=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110246844=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110246845=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110246846=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110246847=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110246848=    END ELSE BEGIN'
      '110246849=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110246850=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110246851=    END'
      '110246852='
      
        '110246853=    --if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMO' +
        'UNT) > 0) then'
      
        '110246854=    --  AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR P' +
        'OSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110246855='
      
        '110246856=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110246857=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110246858='
      
        '110246859=    SUMM_TXT = AMOUNT || '#39' x '#39' || PRICE_N || '#39' = '#39' || ' +
        'SUMM;--SUMM_N;'
      '110246860='
      '110246861=    SUSPEND;'
      '110246862=  END'
      '110246863=WHEN ANY DO BEGIN'
      '110246864=    Err_code = -20500;'
      
        '110246865=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110246866=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110246867=  END'
      '110246868=end'
      '110246869=;'
      '110246870='
      '110246871='
      
        '110246872=/*****************************************************' +
        '*************************/'
      
        '110246873=/****                   Restoring deactivated procedur' +
        'es                   ****/'
      
        '110246874=/*****************************************************' +
        '*************************/'
      '110246875=ALTER PROCEDURE GET_SKLAD('
      '110246876=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110246877=  MODE_ INTEGER)'
      '110246878=RETURNS ('
      '110246879=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '110246880=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110246881=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110246882=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '110246883=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '110246884=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110246885=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110246886=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110246887=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110246888=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY,'
      
        '110246889=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '110246890=  CNT_T_ INTEGER,'
      
        '110246891=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110246892=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110246893=  HAVERIGHT_ INTEGER,'
      '110246894=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110246895=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ','
      
        '110246896=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      '110246897=  ZAKAZ_ TYPE OF COLUMN SKLAD_PARENT.ZAKAZ,'
      '110246898=  ERR_CODE INTEGER,'
      '110246899=  ERR_MSG VARCHAR(1024))'
      '110246900=AS'
      '110246901=/*'
      
        '110246902=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083 +
        #1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '110246903=*/'
      
        '110246904=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      
        '110246905=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      '110246906=begin'
      
        '110246907=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080 +
        ' INS '#1080' '#1087#1088#1080' UPD'
      '110246908=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110246909=  CNT_T_ = 0;'
      '110246910=  SELECT COUNT(*)'
      '110246911=    FROM (SELECT S.SKLAD'
      '110246912=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '110246913=    INTO :CNT_T_;'
      '110246914='
      '110246915=  SELECT'
      '110246916=    T.DATE_RECEIPT,'
      '110246917=    T.TIME_RECEIPT,'
      '110246918=    T.G_CLIENT,'
      '110246919=    T.G_PAYMENT_TYPE,'
      '110246920=    T.G_NONCASH_PAY_TYPE,'
      '110246921=    T.OSNOVANIE,'
      '110246922=    T.NOTE,'
      '110246923=    T.SUMM,'
      '110246924=    T.SUMM_FACT,'
      '110246925=    T.IS_PAYED_ALL'
      '110246926=    ,T.SUMM_CURRENCY'
      '110246927=    ,T.is_expected'
      '110246928=    ,T.IS_VOZVRAT'
      '110246929=    ,T.ZAKAZ'
      '110246930=  FROM SKLAD_PARENT T'
      '110246931=  WHERE T.SKLAD = :SKLAD_'
      '110246932=  INTO'
      '110246933=    :DATE_RECEIPT_,'
      '110246934=    :TIME_RECEIPT_,'
      '110246935=    :G_CLIENT_,'
      '110246936=    :G_PAYMENT_TYPE_,'
      '110246937=    :G_NONCASH_PAY_TYPE_,'
      '110246938=    :OSNOVANIE_,'
      '110246939=    :NOTE_,'
      '110246940=    :SUMM_,'
      '110246941=    :SUMM_FACT_,'
      '110246942=    :IS_PAYED_ALL_'
      '110246943=    ,:SUMM_CURRENCY_'
      '110246944=    ,:IS_EXPECTED_'
      '110246945=    ,:IS_VOZVRAT_'
      '110246946=    ,:ZAKAZ_;'
      '110246947='
      '110246948=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110246949=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1057#1054#1047#1044#1040#1053#1048#1045' '#1050#1054#1055#1048#1048', '#1048' '#1042' '#1048#1057#1061#1054#1044#1053#1054#1052' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1045#1057 +
        #1058#1068' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' - '#1045#1043#1054' '#1042' '#1050#1054#1055#1048#1070' '#1053#1045' '#1044#1054#1041#1040#1042#1051#1071#1070', '#1055#1059#1057#1058#1068' '#1042#1056#1059#1063#1053#1059#1070' ' +
        #1055#1056#1054#1041#1048#1042#1040#1070#1058
      
        '110246950=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY,'
      
        '110246951=                        charge_ROZN_proc, PRICE_ROZN, ' +
        'charge_opt_proc, PRICE_OPT)'
      
        '110246952=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKL' +
        'AD_,'
      '110246953=         PRICE_CURRENCY, SUMM_CURRENCY,'
      
        '110246954=         DECODE(S.PRICE, 0, 0, ROUND((G.PRICE/S.PRICE ' +
        '- 1)*100, 2)),'
      '110246955=         G.PRICE,'
      
        '110246956=         DECODE(S.PRICE, 0, 0, ROUND((G.volume_price/S' +
        '.PRICE - 1)*100, 2)),'
      '110246957=         G.VOLUME_PRICE'
      '110246958=    FROM SKLAD S, G_PRODUCT G'
      '110246959=   WHERE SKLAD_PARENT = :SKLAD_'
      '110246960=     AND S.G_PRODUCT = G.G_PRODUCT'
      '110246961=     AND ((:MODE_ = 0)'
      '110246962=          OR'
      '110246963=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 0)'
      '110246964=          OR'
      
        '110246965=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 1 AND CHAR_LE' +
        'NGTH(S.MARK_CODE) = 0)'
      '110246966=         )'
      '110246967=   ORDER BY SKLAD;'
      '110246968='
      '110246969=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110246970=  SELECT K.G_PRIHOD_RASHOD,'
      '110246971=         K.SUMM'
      
        '110246972=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110246973=   WHERE K.SKLAD = :SKLAD_'
      '110246974=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110246975=    INTO :G_PRIHOD_,'
      '110246976=         :SUMM_PRIHOD_;'
      '110246977='
      
        '110246978=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110246979='
      
        '110246980=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110246981=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110246982=  HaveRight_ = 1;'
      '110246983=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110246984=    SELECT ID'
      '110246985=      FROM CUR_PARAMS'
      '110246986=     WHERE CUR_PARAMS = 1'
      '110246987=      INTO :G_OFFICIAL_CUR_;'
      '110246988='
      
        '110246989=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110246990=      HaveRight_ = 1;'
      '110246991=    else'
      
        '110246992=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110246993=  END'
      '110246994=end'
      '110246995=;'
      '110246996='
      '110246997=ALTER PROCEDURE INS_SKLAD('
      '110246998=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110246999=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '1102461000=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102461001=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102461002=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102461003=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102461004=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102461005=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1102461006=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102461007=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1102461008=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102461009=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102461010=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102461011=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102461012=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102461013=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102461014=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102461015=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102461016=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102461017=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '1102461018=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL,'
      '1102461019=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = NULL)'
      '1102461020=RETURNS ('
      '1102461021=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102461022=  ERR_CODE INTEGER,'
      '1102461023=  ERR_MSG VARCHAR(1024))'
      '1102461024=AS'
      '1102461025=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '1102461026=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054 +
        #1042#1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '1102461027=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '1102461028=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '1102461029=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059 +
        #1055#1050#1048
      
        '1102461030=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '1102461031=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053 +
        #1050#1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054 +
        #1047#1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '1102461032=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041 +
        #1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUM' +
        'M '#1041#1059#1044#1059
      '1102461033=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1102461034=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048 +
        #1047#1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053 +
        #1048' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '1102461035=--'
      
        '1102461036=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1102461037=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1102461038='
      
        '1102461039=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057 +
        #1056#1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102461040=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '1102461041=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102461042=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1102461043=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1102461044=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1102461045=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1102461046=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '1102461047=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_' +
        'SUMM = 0;'
      
        '1102461048=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      '1102461049=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102461050=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PR' +
        'IHOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '1102461051=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102461052=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102461053=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1102461054=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102461055=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102461056=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1102461057=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102461058=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102461059=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1102461060=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1102461061=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1102461062=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1102461063=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK' +
        '_CODE;'
      
        '1102461064=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COS' +
        'T_PRICE;'
      
        '1102461065=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1102461066=DECLARE VARIABLE SUMM_BONUS_ TYPE OF COLUMN G_DISCONT' +
        '_CARD.SUMM;'
      
        '1102461067=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM;'
      
        '1102461068=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM;'
      '1102461069=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '1102461070=BEGIN'
      '1102461071='
      '1102461072=  PNT_ = '#39'00'#39';'
      '1102461073=  IS_THIS_LAST_ = 0;'
      '1102461074='
      '1102461075=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102461076=    SELECT ID'
      '1102461077=      FROM CUR_PARAMS'
      '1102461078=     WHERE CUR_PARAMS = 2'
      '1102461079=      INTO :G_TOCHKA_;'
      '1102461080='
      '1102461081=  IF (G_TOCHKA_ IS NULL) THEN BEGIN'
      '1102461082=    ERR_CODE = -20500;'
      
        '1102461083=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077' '#1091#1082#1072#1079#1072 +
        #1085' '#1089#1082#1083#1072#1076' '#1087#1088#1086#1076#1072#1078#1080'! '#1054#1073#1088#1072#1090#1080#1090#1077#1089#1100' '#1082' '#1088#1072#1079#1088#1072#1073#1086#1090#1095#1080#1082#1091'!'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1102461084=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1102461085=    EXIT;'
      '1102461086=  END'
      '1102461087='
      '1102461088=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1102461089=  IF (G_OFFICIAL_ IS NULL) THEN'
      '1102461090=      SELECT ID'
      '1102461091=        FROM CUR_PARAMS'
      '1102461092=       WHERE CUR_PARAMS = 1'
      '1102461093=        INTO :G_OFFICIAL_;'
      '1102461094='
      '1102461095=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '1102461096=                            DATE_RECEIPT,'
      '1102461097=                            TIME_RECEIPT,'
      '1102461098=                            G_CLIENT,'
      '1102461099=                            G_PAYMENT_TYPE,'
      '1102461100=                            OSNOVANIE,'
      '1102461101=                            NOTE,'
      '1102461102=                            SUMM,'
      '1102461103=                            SUMM_FACT,'
      '1102461104=                            SUMM_CURRENCY,'
      '1102461105=                            IS_PAYED_ALL,'
      '1102461106=                            IS_VOZVRAT,'
      '1102461107=                            G_TOCHKA'
      '1102461108=                            ,G_OFFICIAL'
      '1102461109=                            ,IS_EXPECTED'
      '1102461110=                            ,G_NONCASH_PAY_TYPE'
      '1102461111=                            ,REC_ID'
      '1102461112=                            ,ZAKAZ)'
      '1102461113=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1102461114=          :DATE_RECEIPT_,'
      '1102461115=          :TIME_RECEIPT_,'
      '1102461116=          :G_CLIENT_,'
      '1102461117=          :G_PAYMENT_TYPE_,'
      '1102461118=          :OSNOVANIE_,'
      '1102461119=          :NOTE_,'
      '1102461120=          :SUMM_,'
      '1102461121=          :SUMM_FACT_,'
      '1102461122=          :SUMM_CURRENCY_,'
      
        '1102461123=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE' +
        ' 0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045 +
        #1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102461124=          :IS_VOZVRAT_,'
      '1102461125=          :G_TOCHKA_'
      '1102461126=          ,:G_OFFICIAL_'
      '1102461127=          ,:IS_EXPECTED_'
      '1102461128=          ,:G_NONCASH_PAY_TYPE_'
      '1102461129=          ,:REC_ID_'
      '1102461130=          ,:ZAKAZ_)'
      '1102461131=  RETURNING'
      '1102461132=    SKLAD'
      '1102461133=  INTO'
      '1102461134=    :SKLAD_;'
      '1102461135='
      '1102461136=  PNT_ = '#39'01'#39';'
      '1102461137=  FOR SELECT SKLAD,'
      '1102461138=             T.G_PRODUCT,'
      '1102461139=             AMOUNT,'
      '1102461140=             T.PRICE,'
      '1102461141=             SUMM,'
      '1102461142=             NDS,'
      '1102461143=             NDS_SUMM'
      '1102461144=             ,PRICE_CURRENCY'
      '1102461145=             ,SUMM_CURRENCY'
      '1102461146=             ,PRICE_ROZN'
      '1102461147=             ,GG.PRICE'
      '1102461148=             ,T.MARK_CODE'
      '1102461149=             ,T.COST_PRICE'
      '1102461150=        FROM SKLAD_TMP T,'
      '1102461151=             G_PRODUCT GG'
      '1102461152=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '1102461153=      ORDER BY 1'
      '1102461154=      INTO :SKLAD_TMP_,'
      '1102461155=           :RG_PRODUCT_,'
      '1102461156=           :RAMOUNT_,'
      '1102461157=           :RPRICE_,'
      '1102461158=           :RSUMM_,'
      '1102461159=           :RNDS_,'
      '1102461160=           :RNDS_SUMM_'
      '1102461161=           ,:PRICE_CURRENCY_'
      '1102461162=           ,:SUMM_CURRENCY_TMP_'
      '1102461163=           ,:SALE_PRICE_'
      '1102461164=           ,:SALE_PRICE_CUR_'
      '1102461165=           ,:MARK_CODE_'
      '1102461166=           ,:COST_PRICE_'
      '1102461167=  DO BEGIN'
      '1102461168=    INSERT INTO SKLAD'
      '1102461169=    ('
      '1102461170=     SKLAD,'
      '1102461171=     SKLAD_PARENT,'
      '1102461172=     DATE_RECEIPT,'
      '1102461173=     G_CLIENT,'
      '1102461174=     G_PRODUCT,'
      '1102461175=     AMOUNT,'
      '1102461176=     PRICE,'
      '1102461177=     SUMM,'
      '1102461178=     G_PAYMENT_TYPE,'
      '1102461179=     OSNOVANIE,'
      '1102461180=     NOTE,'
      '1102461181=     NDS,'
      '1102461182=     NDS_SUMM,'
      '1102461183=     IS_LAST,'
      '1102461184=     IS_VOZVRAT,'
      '1102461185=     G_TOCHKA'
      '1102461186=     ,PRICE_CURRENCY'
      '1102461187=     ,SUMM_CURRENCY'
      '1102461188=     ,MARK_CODE'
      '1102461189=     ,COST_PRICE'
      '1102461190=    ) VALUES ('
      '1102461191=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1102461192=     :SKLAD_,'
      '1102461193=     :DATE_RECEIPT_,'
      '1102461194=     :G_CLIENT_,'
      '1102461195=     :RG_PRODUCT_,'
      '1102461196=     :RAMOUNT_,'
      '1102461197=     :RPRICE_,'
      '1102461198=     :RSUMM_,'
      '1102461199=     :G_PAYMENT_TYPE_,'
      '1102461200=     :OSNOVANIE_,'
      '1102461201=     :NOTE_,'
      '1102461202=     COALESCE(:RNDS_, 0),'
      '1102461203=     COALESCE(:RNDS_SUMM_, 0),'
      
        '1102461204=     0, --DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069 +
        #1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' ' +
        #1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043 +
        #1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1102461205=     :IS_VOZVRAT_,'
      '1102461206=     :G_TOCHKA_'
      '1102461207=     ,:PRICE_CURRENCY_'
      '1102461208=     ,:SUMM_CURRENCY_TMP_'
      '1102461209=     ,:MARK_CODE_'
      '1102461210=     ,:COST_PRICE_'
      '1102461211=    );'
      '1102461212='
      
        '1102461213=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1102461214=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102461215=        PNT_ = '#39'02'#39';'
      '1102461216=        UPDATE LT_SKLAD_PRODUCT L'
      '1102461217=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '1102461218=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102461219=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1102461220=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102461221='
      '1102461222=        IF (ROW_COUNT = 0) THEN'
      
        '1102461223=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT' +
        ')'
      
        '1102461224=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :R' +
        'G_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102461225=    END'
      '1102461226='
      
        '1102461227=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061 +
        #1054#1044#1045
      '1102461228=      UPDATE G_PRODUCT G'
      '1102461229=         SET G.PRICE = :SALE_PRICE_'
      '1102461230=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '1102461231=  END'
      '1102461232=  ----------------------------------------'
      '1102461233='
      
        '1102461234=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1102461235=  PNT_ = '#39'05'#39';'
      
        '1102461236=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1102461237=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1102461238=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102461239=      ELSE'
      '1102461240=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1102461241='
      
        '1102461242=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1102461243=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1102461244=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102461245=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1102461246=                                        :SUMM_FACT_,'
      
        '1102461247=                                        :DATE_RECEIPT' +
        '_,'
      
        '1102461248=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1102461249=                                        NULL,   --ZAK' +
        'AZ_'
      '1102461250=                                        :SKLAD_,'
      
        '1102461251=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1102461252=                                        :G_TOCHKA_,'
      
        '1102461253=                                        :UPLOAD_TO_EX' +
        'T_APP_'
      
        '1102461254=                                        ) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102461255=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102461256=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102461257=            EXIT;'
      '1102461258=          END'
      '1102461259=      END ELSE BEGIN'
      '1102461260=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102461261=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102461262=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102461263=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102461264=            ELSE'
      
        '1102461265=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102461266='
      '1102461267=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102461268=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102461269='
      
        '1102461270=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102461271='
      '1102461272=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102461273=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102461274=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1102461275=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1102461276=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1102461277=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102461278=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1102461279=                                              :SKLAD_' +
        ','
      
        '1102461280=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1102461281=                                              :G_TOCH' +
        'KA_,'
      
        '1102461282=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102461283=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102461284=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102461285=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102461286=                  EXIT;'
      '1102461287=                END'
      '1102461288=            END'
      '1102461289=          END'
      '1102461290=      END'
      '1102461291=  END'
      '1102461292='
      '1102461293=  -- 28.04.2022'
      
        '1102461294=  -- '#1045#1057#1051#1048' '#1054#1060#1054#1056#1052#1051#1071#1045#1058#1057#1071' '#1042#1054#1047#1042#1056#1040#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1058#1054' '#1053 +
        #1040#1044#1054' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042' '#1047#1040' '#1069#1058#1059' '#1055#1056#1054#1044#1040#1046#1059
      
        '1102461295=  -- '#1055#1056#1048#1063#1045#1052' '#1042#1045#1056#1053#1059#1058#1068' '#1048#1047' '#1042#1057#1045#1049' '#1055#1056#1054#1044#1040#1046#1048' '#1052#1054#1043#1059#1058' '#1058#1054#1051#1068#1050#1054' '#1063#1040#1057#1058 +
        #1068', '#1055#1054#1069#1058#1054#1052#1059' '#1053#1040#1044#1054' '#1057#1063#1048#1058#1040#1058#1068
      
        '1102461296=  -- '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1050' '#1052#1054#1052#1045#1053#1058#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1052#1054#1046#1045#1058' '#1048#1047#1052#1045#1053#1048#1058#1068 +
        #1057#1071', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1050#1040#1050#1054#1049' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1058#1054#1043#1044#1040' '#1041#1067#1051
      
        '1102461297=  -- '#1055#1054' '#1061#1054#1056#1054#1064#1045#1052#1059' '#1045#1065#1045' '#1053#1040#1044#1054' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1043#1054' '#1055#1056#1054 +
        #1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1042' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1048#1048' '#1057' '#1051#1045#1057#1045#1053#1050#1054#1049', '#1053#1054' '#1055#1054#1050#1040' '#1053#1045' '#1041#1059#1044#1059' '#1069#1058#1054#1043#1054' '#1044#1045#1051 +
        #1040#1058#1068
      
        '1102461298=  IF (ZAKAZ_ IS NOT NULL AND IS_VOZVRAT_ = 1) THEN BE' +
        'GIN'
      '1102461299=     /*SELECT Z.SUMM_BONUS_GOT,'
      '1102461300=            Z.SUMM'
      '1102461301=       FROM ZAKAZ Z'
      '1102461302=      WHERE ZAKAZ = :ZAKAZ_'
      '1102461303=       INTO :SUMM_BONUS_GOT_,'
      '1102461304=            :ZAKAZ_SUMM_;'
      '1102461305='
      '1102461306=     IF (ZAKAZ_SUMM_ = SUMM_) THEN'
      '1102461307=       BONUS_TO_MINUS_ = SUMM_BONUS_GOT_;'
      '1102461308='
      '1102461309=     ELSE BEGIN'
      
        '1102461310=       BONUS_PERCENT_ = SUMM_BONUS_GOT_ / ZAKAZ_SUMM_' +
        ';  -- '#1053#1040#1061#1054#1046#1059' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058
      '1102461311='
      
        '1102461312=       BONUS_TO_MINUS_ = ROUND(SUMM_ * BONUS_PERCENT_' +
        ', 2);   -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040#1058#1040
      '1102461313=     END'
      '1102461314='
      '1102461315=     UPDATE G_DISCONT_CARD G'
      '1102461316=        SET G.SUMM = G.SUMM - :BONUS_TO_MINUS_,'
      '1102461317=            G.SUMM_ALL = G.SUMM_ALL - :SUMM_'
      '1102461318=      WHERE G.G_CLIENT = :G_CLIENT_;*/'
      '1102461319='
      '1102461320=    SELECT G.SUMM'
      '1102461321=      FROM G_DISCONT_CARD G'
      '1102461322=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102461323=      INTO :SUMM_BONUS_;'
      '1102461324='
      '1102461325=    IF (:SUMM_BONUS_ > 0) THEN BEGIN'
      '1102461326=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '1102461327=              SUM(Z.SUMM)'
      '1102461328=         FROM ZAKAZ Z'
      '1102461329=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '1102461330=         INTO :SUMM_BONUS_GOT_,'
      '1102461331=              :SUMM_ALL_;'
      '1102461332='
      
        '1102461333=       SELECT ROUND( SUM(SP.SUMM * (Z.SUMM_BONUS_GOT ' +
        '/ Z.SUMM)), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042 +
        #1056#1040#1058#1040
      '1102461334=              SUM(SP.SUMM)'
      '1102461335=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '1102461336=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '1102461337=          AND SP.ZAKAZ = Z.ZAKAZ'
      '1102461338=         INTO :BONUS_TO_MINUS_,'
      '1102461339=              :SUMM_TO_MINUS_;'
      '1102461340='
      '1102461341=       UPDATE G_DISCONT_CARD G'
      
        '1102461342=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_M' +
        'INUS_,'
      
        '1102461343=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINU' +
        'S_'
      '1102461344=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '1102461345=    END'
      '1102461346=  END'
      '1102461347='
      '1102461348=  DELETE FROM SKLAD_TMP;'
      '1102461349='
      
        '1102461350=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1102461351=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102461352=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1102461353=                                  G_PRIHOD_,'
      '1102461354=                                  :SUMM_PRIHOD_,'
      '1102461355=                                  :DATE_RECEIPT_,'
      
        '1102461356=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102461357=                                  NULL,   --:ZAKAZ_,'
      '1102461358=                                  :SKLAD_,'
      '1102461359=                                  :G_PAYMENT_TYPE_,'
      '1102461360=                                  :G_TOCHKA_,'
      '1102461361=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102461362=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102461363=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102461364=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102461365=      EXIT;'
      '1102461366=    END'
      '1102461367=  END'
      '1102461368='
      
        '1102461369=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102461370=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, ' +
        '1, 2)) THEN'
      
        '1102461371=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      '1102461372=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '1102461373=            2,'
      '1102461374=            :SKLAD_,'
      '1102461375=            1,'
      
        '1102461376=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1' +
        ' ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052 +
        ' '#1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102461377=           );'
      '1102461378='
      '1102461379=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102461380=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1102461381=END'
      '1102461382=;'
      '1102461383='
      '1102461384=ALTER PROCEDURE INS_SKLAD_BASED_ON_ZAKAZ('
      '1102461385=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '1102461386=RETURNS ('
      '1102461387=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102461388=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      
        '1102461389=  G_NON_CASH_PAY_TYPE_ TYPE OF COLUMN ZAKAZ.G_NONCASH' +
        '_PAY_TYPE,'
      
        '1102461390=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD' +
        ','
      
        '1102461391=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PA' +
        'Y_TRANSACTION_ID)'
      '1102461392=AS'
      '1102461393=BEGIN'
      '1102461394='
      '1102461395=  SELECT Z.G_PAYMENT_TYPE,'
      '1102461396=         Z.G_NONCASH_PAY_TYPE,'
      '1102461397=         Z.POS_PAY_METHOD,'
      '1102461398=         Z.POS_PAY_TRANSACTION_ID,'
      '1102461399=         Z.G_CLIENT'
      '1102461400=    FROM ZAKAZ Z'
      '1102461401=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102461402=    INTO :G_PAYMENT_TYPE_,'
      '1102461403=         :G_NON_CASH_PAY_TYPE_,'
      '1102461404=         :POS_PAY_METHOD_,'
      '1102461405=         :POS_PAY_TRANSACTION_ID_,'
      '1102461406=         :G_CLIENT_;'
      '1102461407='
      '1102461408=  insert into sklad_tmp'
      '1102461409=  select GEN_ID(gen_details_tmp, 1),'
      '1102461410=       zd.g_product,'
      '1102461411=       zd.amount,'
      '1102461412=       zd.price - zd.discount_tenge,'
      '1102461413=       zd.summ,'
      '1102461414=       zd.NDS, zd.NDS_SUMM, NULL, 0, 0, 0, 0, 0,0,0,'
      '1102461415=       zd.mark_code,'
      '1102461416=       zd.cost_price'
      '1102461417=   from zakaz_details zd'
      '1102461418=  where zd.zakaz = :ZAKAZ_;'
      '1102461419=END'
      '1102461420=;'
      '1102461421='
      '1102461422=ALTER PROCEDURE INS_SKLAD_TMP('
      '1102461423=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1102461424=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1102461425=  PRICE_ NUMERIC(15,2),'
      '1102461426=  SUMM_ NUMERIC(15,2),'
      '1102461427=  NDS_ NUMERIC(15,2) = 0,'
      '1102461428=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM = 0,'
      
        '1102461429=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1102461430=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0,'
      
        '1102461431=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC = 0,'
      
        '1102461432=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0' +
        ','
      
        '1102461433=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OP' +
        'T_PROC = 0,'
      '1102461434=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0,'
      
        '1102461435=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0,'
      '1102461436=  MARK_CODE_ TYPE OF COLUMN SKLAD_TMP.MARK_CODE = '#39#39','
      
        '1102461437=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT ' +
        '= 0)'
      '1102461438=RETURNS ('
      '1102461439=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1102461440=  ERR_CODE INTEGER,'
      '1102461441=  ERR_MSG VARCHAR(1024))'
      '1102461442=AS'
      
        '1102461443=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_T' +
        'MP'#39';'
      
        '1102461444=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M = 0;'
      '1102461445=BEGIN'
      '1102461446='
      '1102461447=  IF (CHAR_LENGTH(MARK_CODE_) = 0) THEN'
      '1102461448=      SELECT T.SKLAD'
      '1102461449=        FROM SKLAD_TMP T'
      '1102461450=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102461451=         AND T.PRICE = :PRICE_'
      '1102461452=        INTO :SKLAD_;'
      '1102461453='
      '1102461454=  IF (SKLAD_ IS NOT NULL) THEN'
      '1102461455=    UPDATE SKLAD_TMP T'
      '1102461456=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1102461457=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1102461458=     WHERE T.SKLAD = :SKLAD_;'
      '1102461459='
      '1102461460=  ELSE BEGIN'
      '1102461461=      IF (PRICE_ = 0) THEN BEGIN'
      '1102461462=        CHARGE_ROZN_PROC_ = 0;'
      '1102461463=        CHARGE_OPT_PROC_ = 0;'
      '1102461464=      END ELSE BEGIN'
      
        '1102461465=        CHARGE_ROZN_PROC_ = ROUND((:PRICE_ROZN_ - :PR' +
        'ICE_) * 100 / :PRICE_, 2);'
      
        '1102461466=        CHARGE_OPT_PROC_ = ROUND((:PRICE_OPT_ - :PRIC' +
        'E_) * 100 / :PRICE_, 2);'
      '1102461467=      END'
      '1102461468='
      '1102461469=      IF (IS_VOZVRAT_ = 1) THEN BEGIN'
      
        '1102461470=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_, NULL, 1)'
      '1102461471=          RETURNING_VALUES :SELF_PRICE_;'
      '1102461472=      END'
      '1102461473='
      
        '1102461474=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '1102461475=                            CHARGE_ROZN_PROC,'
      '1102461476=                            PRICE_ROZN,'
      '1102461477=                            CHARGE_OPT_PROC,'
      
        '1102461478=                            PRICE_OPT, CHANGE_SALE_PR' +
        'ICE, MARK_CODE, COST_PRICE)'
      
        '1102461479=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '1102461480=        ,:PRICE_CURRENCY_'
      '1102461481=        ,:SUMM_CURRENCY_'
      '1102461482=        ,:CHARGE_ROZN_PROC_'
      '1102461483=        ,:PRICE_ROZN_'
      '1102461484=        ,:CHARGE_OPT_PROC_'
      '1102461485=        ,:PRICE_OPT_'
      
        '1102461486=        ,0        -- :CHANGE_SALE_PRICE_ '#1055#1054' '#1048#1044#1045#1045' '#1059#1046#1045' ' +
        #1053#1045' '#1053#1059#1046#1053#1054', '#1062#1045#1053#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1048' '#1058#1040#1050', '#1058#1045#1055#1045#1056#1068' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1042#1054#1054#1041#1065#1045' '#1053#1048#1063#1045#1043#1054' ' +
        #1053#1045' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071', '#1055#1054#1047#1046#1045' '#1053#1040#1044#1054' '#1059#1041#1056#1040#1058#1068' 15.10.2021'
      '1102461487=        ,:MARK_CODE_'
      '1102461488=        ,:SELF_PRICE_)'
      '1102461489=      RETURNING SKLAD'
      '1102461490=      INTO :SKLAD_;'
      '1102461491=  END'
      '1102461492=end'
      '1102461493=;'
      '1102461494='
      '1102461495=ALTER PROCEDURE INS_ZAKAZ('
      '1102461496=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102461497=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102461498=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102461499=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102461500=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102461501=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102461502=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102461503=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102461504=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102461505=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102461506=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102461507=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102461508=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102461509=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102461510=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102461511=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102461512=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102461513=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102461514=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102461515=  IS_MEBEL_ INTEGER = 0,'
      
        '1102461516=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1102461517=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      
        '1102461518=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      '1102461519=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1102461520=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102461521=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102461522=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102461523=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102461524=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102461525=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '1102461526=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL,'
      
        '1102461527=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD' +
        ' = NULL,'
      
        '1102461528=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PA' +
        'Y_TRANSACTION_ID = NULL,'
      
        '1102461529=  REQUEST_NUMBER_ TYPE OF COLUMN ZAKAZ.REQUEST_NUMBER' +
        ' = NULL)'
      '1102461530=RETURNS ('
      '1102461531=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102461532=  ERR_CODE INTEGER,'
      '1102461533=  ERR_MSG VARCHAR(1024))'
      '1102461534=AS'
      '1102461535=/*'
      '1102461536=IS_SPISANIE_'
      '1102461537=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102461538=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102461539=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102461540=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102461541='
      '1102461542='
      
        '1102461543=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102461544=*/'
      '1102461545=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1102461546=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102461547=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102461548=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1102461549=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1102461550=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1102461551=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1102461552=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1102461553=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1102461554=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1102461555=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1102461556=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1102461557=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1102461558=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1102461559=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '1102461560=DECLARE VARIABLE CNT_ INTEGER;'
      '1102461561=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1102461562=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1102461563=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102461564=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102461565=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1102461566=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102461567=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102461568=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1102461569=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102461570=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1102461571=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1102461572=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102461573=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102461574=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102461575=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLI' +
        'ENT.SKIDKA;'
      
        '1102461576=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.N_PERCENT;'
      
        '1102461577=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DI' +
        'SCONT_CARD.SUMM_ALL;'
      
        '1102461578=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.MARK_CODE;'
      '1102461579=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102461580=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1102461581=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      
        '1102461582=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '1102461583=BEGIN'
      '1102461584='
      
        '1102461585=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1102461586=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1102461587=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1102461588=  IF (CNT_ = 0) THEN BEGIN'
      '1102461589=    ERR_CODE = -20500;'
      
        '1102461590=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1102461591=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1102461592=    EXIT;'
      '1102461593=  END'
      '1102461594='
      '1102461595=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102461596=    SELECT ID'
      '1102461597=      FROM CUR_PARAMS'
      '1102461598=     WHERE CUR_PARAMS = 2'
      '1102461599=      INTO :G_TOCHKA_;'
      '1102461600='
      '1102461601=  IF (G_TOCHKA_ IS NULL) THEN BEGIN'
      '1102461602=    ERR_CODE = -20500;'
      
        '1102461603=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077' '#1091#1082#1072#1079#1072 +
        #1085' '#1089#1082#1083#1072#1076' '#1087#1088#1086#1076#1072#1078#1080'! '#1054#1073#1088#1072#1090#1080#1090#1077#1089#1100' '#1082' '#1088#1072#1079#1088#1072#1073#1086#1090#1095#1080#1082#1091'!'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1102461604=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1102461605=    EXIT;'
      '1102461606=  END'
      '1102461607='
      '1102461608=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102461609=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1102461610=      PNT_ = '#39'01'#39';'
      
        '1102461611=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102461612=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102461613=      ELSE'
      '1102461614=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102461615='
      '1102461616=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1102461617=      SELECT G.G_OFFICIAL,'
      '1102461618=             G.DO_NOT_SALES_COMM,'
      '1102461619=             G.FM||'#39' '#39'||G.NM'
      '1102461620=        FROM G_OFFICIAL G'
      
        '1102461621=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1102461622=        INTO :G_OFFICIAL_,'
      '1102461623=             :DO_NOT_SALES_COMM_,'
      '1102461624=             :OFFICIAL_NAME_;'
      '1102461625='
      '1102461626=      INSERT INTO ZAKAZ'
      '1102461627=      ('
      '1102461628=       ZAKAZ,'
      '1102461629=       G_TOCHKA,'
      '1102461630=       Z_DATE,'
      '1102461631=       Z_TIME,'
      '1102461632=       G_CLIENT,'
      '1102461633=       G_PAYMENT_TYPE,'
      '1102461634=       OSNOVANIE,'
      '1102461635=       IS_SPISANIE,'
      '1102461636=       NOTE,'
      '1102461637=       SUMM,'
      '1102461638=       SUMM_FACT,'
      '1102461639=       SUMM_BONUS,'
      '1102461640=       IS_PAYED_ALL'
      '1102461641=       ,G_OFFICIAL'
      '1102461642=       ,BY_RECIPE'
      '1102461643=       ,SUMM_BONUS_GOT'
      '1102461644=       ,IS_RESERVE'
      '1102461645=       ,SUMM_CASH'
      '1102461646=       ,SUMM_NONCASH'
      '1102461647=       ,NOT_MINUS_OSTATOK'
      '1102461648=       ,DELIVERY_ADDRESS'
      '1102461649=       ,REC_ID'
      '1102461650=       ,G_NONCASH_PAY_TYPE'
      '1102461651=       ,POS_PAY_METHOD'
      '1102461652=       ,POS_PAY_TRANSACTION_ID'
      '1102461653=       ,REQUEST_NUMBER'
      '1102461654=      ) VALUES ('
      '1102461655=       GEN_ID(GEN_ZAKAZ, 1),'
      '1102461656=       :G_TOCHKA_,'
      '1102461657=       :Z_DATE_,'
      '1102461658=       :Z_TIME_,'
      '1102461659=       :G_CLIENT_,'
      '1102461660=       :G_PAYMENT_TYPE_,'
      '1102461661=       :OSNOVANIE_,'
      '1102461662=       :IS_SPISANIE_,'
      '1102461663=       :NOTE_,'
      '1102461664=       :SUMM_,'
      '1102461665=       :SUMM_FACT_1_,'
      '1102461666=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1102461667=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102461668=       ,:G_OFFICIAL_'
      '1102461669=       ,:BY_RECIPE_'
      '1102461670=       ,:SUMM_BONUS_GOT_'
      '1102461671=       ,:IS_RESERVE_'
      '1102461672=       ,COALESCE(:SUMM_CASH_, 0)'
      '1102461673=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1102461674=       ,:NOT_MINUS_OSTATOK_'
      '1102461675=       ,:ADDRESS_'
      '1102461676=       ,:REC_ID_'
      '1102461677=       ,:G_NONCASH_PAY_TYPE_'
      '1102461678=       ,:POS_PAY_METHOD_'
      '1102461679=       ,:POS_PAY_TRANSACTION_ID_'
      '1102461680=       ,:REQUEST_NUMBER_'
      '1102461681=      )'
      '1102461682=      RETURNING'
      '1102461683=        ZAKAZ'
      '1102461684=      INTO'
      '1102461685=        :ZAKAZ_;'
      '1102461686='
      '1102461687=      PNT_ = '#39'02'#39';'
      
        '1102461688=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1102461689=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM, Z.MARK_CODE'
      '1102461690=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1102461691=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1102461692=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1102461693=              :G_PRODUCT,'
      '1102461694=              :AMOUNT,'
      '1102461695=              :PRICE,'
      '1102461696=              :SUMM,'
      '1102461697=              :DISCOUNT_PERC,'
      '1102461698=              :DISCOUNT_TENGE,'
      '1102461699=              :DISCOUNT_SUMM,'
      '1102461700=              :NDS,'
      '1102461701=              :NDS_SUMM,'
      '1102461702=              :COST_PRICE,'
      '1102461703=              :SALES_COMM_,'
      '1102461704=              :MARK_CODE_'
      '1102461705=      DO BEGIN'
      
        '1102461706=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102461707=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1102461708=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1102461709=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102461710=        END'
      '1102461711='
      '1102461712=        INSERT INTO ZAKAZ_DETAILS'
      '1102461713=        VALUES('
      '1102461714=          :ZAKAZ_DETAILS_TMP_,'
      '1102461715=          :ZAKAZ_,'
      '1102461716=          :G_PRODUCT,'
      '1102461717=          :AMOUNT,'
      '1102461718=          :PRICE,'
      '1102461719=          :SUMM,'
      '1102461720=          :DISCOUNT_PERC,'
      '1102461721=          :DISCOUNT_TENGE,'
      '1102461722=          :DISCOUNT_SUMM,'
      '1102461723=          :NDS,'
      '1102461724=          :NDS_SUMM,'
      '1102461725=          :COST_PRICE,'
      '1102461726=          :SALES_COMM_SUMM_ITER_,'
      '1102461727=          :MARK_CODE_'
      '1102461728=        );'
      '1102461729='
      
        '1102461730=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1102461731=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1102461732=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1102461733=                UPDATE LT_SKLAD_PRODUCT L'
      '1102461734=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102461735=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_  -- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051 +
        #1067' '#1055#1056#1048#1061#1054#1044', '#1061#1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102461736=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102461737=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102461738='
      '1102461739=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1102461740=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102461741=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057 +
        #1051#1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102461742=                -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048 +
        #1071' ('#1053#1040#1055#1056#1048#1052#1045#1056' '#1052#1054#1041#1048#1051#1040'), '#1058#1054' '#1053#1040' '#1052#1048#1053#1059#1057' '#1053#1045' '#1055#1056#1054#1042#1045#1056#1071#1070
      '1102461743=                PNT_ = '#39'04'#39';'
      
        '1102461744=                IF (ROW_COUNT = 0 AND ((SELECT S_VALU' +
        'E FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) AND REC_ID_ IS ' +
        'NULL) then BEGIN'
      '1102461745=                  Err_Code = -20500;'
      
        '1102461746=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_C' +
        'ODE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_' +
        'PRODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072 +
        #1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102461747=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102461748=                  EXIT;'
      '1102461749=                END ELSE if (ROW_COUNT = 0) then'
      
        '1102461750=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102461751=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);  -' +
        '- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067' '#1055#1056#1048#1061#1054#1044', '#1061 +
        #1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102461752=            END'
      '1102461753='
      '1102461754=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102461755=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102461756=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102461757=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :AMOUNT'
      '1102461758=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102461759=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102461760='
      '1102461761='
      '1102461762=        END'
      '1102461763=      END'
