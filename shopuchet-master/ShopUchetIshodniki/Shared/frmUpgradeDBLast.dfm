      '1102503746=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1102503747=                  FROM KASSA K'
      '1102503748=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1102503749=                   AND K.SUMM = 0'
