      '1102112555=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1102112556='
      '1102112557=      UPDATE SKLAD_PARENT'
      '1102112558=      SET'
      
        '1102112559=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
