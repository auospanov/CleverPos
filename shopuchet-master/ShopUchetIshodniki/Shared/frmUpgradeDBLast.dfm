      '1106017566=RETURNS ('
      
        '1106017567=  G_PAYMENT_TYPE TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '1106017568=  NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME)'
