        #1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM ' +
        #1041#1059#1044#1059
      '11011029=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '11011030=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047#1053 +
        #1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048' ' +
        #1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '11011031=--'
      
        '11011032=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTED' +
        ' = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '11011033=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056#1054 +
        #1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1059 +
        #1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '11011034=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '11011035=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11011036=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11011037=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11011038=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11011039=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11011040=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '11011041=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM = 0;'
      
        '11011042=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      '11011043=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11011044=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIH' +
        'OD_RASHOD.G_PRIHOD_RASHOD;'
      
        '11011045=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11011046=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '11011047=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11011048=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11011049=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11011050=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11011051=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11011052=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11011053=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.P' +
        'RICE_CURRENCY;'
      
        '11011054=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKLA' +
        'D.SUMM_CURRENCY;'
      
        '11011055=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      
        '11011056=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.P' +
        'RICE_ROZN;'
      
        '11011057=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRODU' +
        'CT.PRICE;'
      '11011058=BEGIN'
      '11011059='
      '11011060=  PNT_ = '#39'00'#39';'
      '11011061=  IS_THIS_LAST_ = 0;'
      '11011062='
      '11011063=  IF (G_TOCHKA_ IS NULL) THEN'
      '11011064=    SELECT ID'
      '11011065=      FROM CUR_PARAMS'
      '11011066=     WHERE CUR_PARAMS = 2'
      '11011067=      INTO :G_TOCHKA_;'
      '11011068='
      '11011069=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11011070=  SELECT ID'
      '11011071=    FROM CUR_PARAMS'
      '11011072=   WHERE CUR_PARAMS = 1'
      '11011073=    INTO :G_OFFICIAL_;'
      '11011074='
      '11011075=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '11011076=                            DATE_RECEIPT,'
      '11011077=                            TIME_RECEIPT,'
      '11011078=                            G_CLIENT,'
      '11011079=                            G_PAYMENT_TYPE,'
      '11011080=                            OSNOVANIE,'
      '11011081=                            NOTE,'
      '11011082=                            SUMM,'
      '11011083=                            SUMM_FACT,'
      '11011084=                            SUMM_CURRENCY,'
      '11011085=                            IS_PAYED_ALL,'
      '11011086=                            IS_VOZVRAT,'
      '11011087=                            G_TOCHKA'
      '11011088=                            ,G_OFFICIAL'
      '11011089=                            ,IS_EXPECTED)'
      '11011090=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11011091=          :DATE_RECEIPT_,'
      '11011092=          :TIME_RECEIPT_,'
      '11011093=          :G_CLIENT_,'
      '11011094=          :G_PAYMENT_TYPE_,'
      '11011095=          :OSNOVANIE_,'
      '11011096=          :NOTE_,'
      '11011097=          :SUMM_,'
      '11011098=          :SUMM_FACT_,'
      '11011099=          :SUMM_CURRENCY_,'
      
        '110110100=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PA' +
        'YED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "' +
        #1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110110101=          :IS_VOZVRAT_,'
      '110110102=          :G_TOCHKA_'
      '110110103=          ,:G_OFFICIAL_'
      '110110104=          ,:IS_EXPECTED_)'
      '110110105=  RETURNING'
      '110110106=    SKLAD'
      '110110107=  INTO'
      '110110108=    :SKLAD_;'
      '110110109='
      '110110110=  PNT_ = '#39'01'#39';'
      '110110111=  FOR SELECT SKLAD,'
      '110110112=             T.G_PRODUCT,'
      '110110113=             AMOUNT,'
      '110110114=             T.PRICE,'
      '110110115=             SUMM,'
      '110110116=             NDS,'
      '110110117=             NDS_SUMM'
      '110110118=             ,PRICE_CURRENCY'
      '110110119=             ,SUMM_CURRENCY'
      '110110120=             ,PRICE_ROZN'
      '110110121=             ,GG.PRICE'
      '110110122=        FROM SKLAD_TMP T,'
      '110110123=             G_PRODUCT GG'
      '110110124=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110110125=      ORDER BY 1'
      '110110126=      INTO :SKLAD_TMP_,'
      '110110127=           :RG_PRODUCT_,'
      '110110128=           :RAMOUNT_,'
      '110110129=           :RPRICE_,'
      '110110130=           :RSUMM_,'
      '110110131=           :RNDS_,'
      '110110132=           :RNDS_SUMM_'
      '110110133=           ,:PRICE_CURRENCY_'
      '110110134=           ,:SUMM_CURRENCY_TMP_'
      '110110135=           ,:SALE_PRICE_'
      '110110136=           ,:SALE_PRICE_CUR_'
      '110110137=  DO BEGIN'
      '110110138=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110110139=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110110140=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110110141=      IS_THIS_LAST_ = 0;'
      '110110142=      SELECT MAX(SK.DATE_RECEIPT)'
      '110110143=        FROM SKLAD SK'
      '110110144=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110110145=         AND SK.IS_LAST = 1'
      '110110146=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110110147=        INTO :DATE_LAST_;'
      '110110148='
      
        '110110149=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110110150=        UPDATE SKLAD SK'
      '110110151=           SET SK.IS_LAST = 0'
      '110110152=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110110153=           AND SK.IS_LAST = 1'
      '110110154=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110110155='
      '110110156=        IS_THIS_LAST_ = 1;'
      '110110157=      END'
      '110110158=    END'
      '110110159='
      '110110160=    INSERT INTO SKLAD'
      '110110161=    ('
      '110110162=     SKLAD,'
      '110110163=     SKLAD_PARENT,'
      '110110164=     DATE_RECEIPT,'
      '110110165=     G_CLIENT,'
      '110110166=     G_PRODUCT,'
      '110110167=     AMOUNT,'
      '110110168=     PRICE,'
      '110110169=     SUMM,'
      '110110170=     G_PAYMENT_TYPE,'
      '110110171=     OSNOVANIE,'
      '110110172=     NOTE,'
      '110110173=     NDS,'
      '110110174=     NDS_SUMM,'
      '110110175=     IS_LAST,'
      '110110176=     IS_VOZVRAT,'
      '110110177=     G_TOCHKA'
      '110110178=     ,PRICE_CURRENCY'
      '110110179=     ,SUMM_CURRENCY'
      '110110180=    ) VALUES ('
      '110110181=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110110182=     :SKLAD_,'
      '110110183=     :DATE_RECEIPT_,'
      '110110184=     :G_CLIENT_,'
      '110110185=     :RG_PRODUCT_,'
      '110110186=     :RAMOUNT_,'
      '110110187=     :RPRICE_,'
      '110110188=     :RSUMM_,'
      '110110189=     :G_PAYMENT_TYPE_,'
      '110110190=     :OSNOVANIE_,'
      '110110191=     :NOTE_,'
      '110110192=     :RNDS_,'
      '110110193=     :RNDS_SUMM_,'
      
        '110110194=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110110195=     :IS_VOZVRAT_,'
      '110110196=     :G_TOCHKA_'
      '110110197=     ,:PRICE_CURRENCY_'
      '110110198=     ,:SUMM_CURRENCY_TMP_'
      '110110199=    );'
      '110110200='
      
        '110110201=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110110202=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110110203=        PNT_ = '#39'02'#39';'
      '110110204=        UPDATE LT_SKLAD_PRODUCT L'
      '110110205=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110110206=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110110207=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110110208='
      '110110209=        IF (ROW_COUNT = 0) THEN'
      
        '110110210=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110110211=    END'
      '110110212='
      
        '110110213=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '110110214=      UPDATE G_PRODUCT G'
      '110110215=         SET G.PRICE = :SALE_PRICE_'
      '110110216=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110110217=  END'
      '110110218=  ----------------------------------------'
      '110110219='
      
        '110110220=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110110221=  PNT_ = '#39'05'#39';'
      
        '110110222=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110110223=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110110224=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110110225=      ELSE'
      '110110226=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110110227='
      
        '110110228=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110110229=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110110230=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110110231=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110110232=                                        :SUMM_FACT_,'
      
        '110110233=                                        :DATE_RECEIPT_' +
        ','
      
        '110110234=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110110235=                                        NULL,   --ZAKA' +
        'Z_'
      '110110236=                                        :SKLAD_,'
      
        '110110237=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110110238=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110110239=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110110240=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110110241=            EXIT;'
      '110110242=          END'
      '110110243=      END ELSE BEGIN'
      '110110244=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110110245=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110110246=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110110247=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110110248=            ELSE'
      
        '110110249=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110110250='
      '110110251=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110110252=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110110253='
      
        '110110254=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110110255='
      '110110256=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110110257=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110110258=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110110259=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110110260=                                              :PAYMENT' +
        '_DATE_,'
      
        '110110261=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110110262=                                              NULL,   ' +
        '--ZAKAZ_'
      '110110263=                                              :SKLAD_,'
      
        '110110264=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110110265=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110110266=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110110267=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110110268=                  EXIT;'
      '110110269=                END'
      '110110270=            END'
      '110110271=          END'
      '110110272=      END'
      '110110273=  END'
      '110110274='
      '110110275=  DELETE FROM SKLAD_TMP;'
      '110110276='
      
        '110110277=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110110278=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110110279=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110110280=                                  G_PRIHOD_,'
      '110110281=                                  :SUMM_PRIHOD_,'
      '110110282=                                  :DATE_RECEIPT_,'
      
        '110110283=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110110284=                                  NULL,   --:ZAKAZ_,'
      '110110285=                                  :SKLAD_,'
      '110110286=                                  :G_PAYMENT_TYPE_,'
      
        '110110287=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110110288=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110110289=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110110290=      EXIT;'
      '110110291=    END'
      '110110292=  END'
      '110110293=end'
      '110110294=;'
      '110110295='
      '110110296=ALTER PROCEDURE LOG_INIT'
      '110110297=AS'
      '110110298=DECLARE VARIABLE TN VARCHAR(64);'
      '110110299=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110110300=DECLARE VARIABLE FN VARCHAR(64);'
      '110110301=DECLARE VARIABLE TP INTEGER;'
      
        '110110302=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110110303=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110110304=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110110305=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110110306=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110110307=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110110308=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110110309=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000) */'
      '110110310=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110110311=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110110312=DECLARE VARIABLE ANZ INTEGER;'
      '110110313=DECLARE VARIABLE L INTEGER;'
      '110110314=DECLARE VARIABLE P INTEGER;'
      '110110315=DECLARE VARIABLE S INTEGER;'
      '110110316=DECLARE VARIABLE FT CHAR(1);'
      '110110317=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110110318=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110110319=BEGIN'
      '110110320=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110110321='
      '110110322=  TN_ALT='#39#39';'
      '110110323=  TRGI='#39#39';'
      '110110324=  TRGU='#39#39';'
      '110110325=  TRGD='#39#39';'
      '110110326=  TRGIX='#39#39';'
      '110110327=  TRGUX='#39#39';'
      '110110328=  TRGDX='#39#39';'
      '110110329=  SQLF='#39#39';'
      '110110330=  SQLV='#39#39';'
      '110110331=  SQLU='#39#39';'
      '110110332=  FT='#39#39';'
      '110110333='
      '110110334=  FOR SELECT R.RDB$RELATION_NAME,'
      '110110335=            R.RDB$FIELD_NAME,'
      '110110336=            F.RDB$FIELD_TYPE,'
      '110110337=            F.RDB$FIELD_LENGTH,'
      '110110338=            F.RDB$FIELD_PRECISION,'
      '110110339=            F.RDB$FIELD_SCALE'
      '110110340=        FROM RDB$RELATION_FIELDS R,'
      '110110341=             RDB$FIELDS F'
      '110110342=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110110343=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110110344=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110110345=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110110346=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110110347=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110110348=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110110349=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110110350=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110110351=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110110352=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39')'
      '110110353=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110110354=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110110355=              OR'
      
        '110110356=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110110357=             )'
      
        '110110358=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110110359=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110110360=  DO BEGIN'
      '110110361=    TN=TRIM(TN);'
      '110110362=    FN=TRIM(FN);'
      '110110363=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110110364=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110110365=      EXECUTE STATEMENT TRGI;'
      '110110366=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110110367=      EXECUTE STATEMENT TRGU;'
      '110110368=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110110369=      EXECUTE STATEMENT TRGD;'
      '110110370='
      '110110371=      SQLF='#39#39';'
      '110110372=      SQLV='#39#39';'
      '110110373=      SQLU='#39#39';'
      '110110374=    END'
      '110110375=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110110376=      ID_COLUMN = FN;'
      '110110377='
      '110110378=    S=-S;'
      
        '110110379=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110110380=      ft='#39'N'#39';   --numerisch'
      '110110381=    else'
      '110110382=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110110383=        ft='#39'Z'#39';   --zeit'
      '110110384=      else'
      '110110385=        ft='#39'T'#39';'
      '110110386='
      '110110387=    IF (SQLF='#39#39') THEN'
      '110110388=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110110389=    ELSE'
      '110110390=      SQLF=SQLF||'#39','#39'||FN;'
      '110110391='
      '110110392=    if (ft='#39'N'#39') then begin'
      '110110393=      IF (SQLV='#39#39') THEN'
      
        '110110394=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110110395=      ELSE'
      
        '110110396=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110110397='
      '110110398=      IF (SQLU='#39#39') THEN'
      
        '110110399=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110110400=      ELSE'
      
        '110110401=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110110402=    end'
      '110110403=    else'
      '110110404=      if (ft='#39'Z'#39') then begin'
      '110110405=        IF (SQLV='#39#39') THEN'
      
        '110110406=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110110407=        ELSE'
      
        '110110408=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110110409='
      '110110410=        IF (SQLU='#39#39') THEN'
      
        '110110411=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'U' +
        'PDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||' +
        'FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110110412=        ELSE'
      
        '110110413=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39 +
        '||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),' +
        #39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110110414=    end'
      '110110415=    else begin'
      '110110416=      IF (SQLV='#39#39') THEN'
      
        '110110417=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||TRIM' +
        '(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110110418=      ELSE'
      
        '110110419=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||TRIM' +
        '(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110110420='
      '110110421=      IF (SQLU='#39#39') THEN'
      
        '110110422=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||TRIM(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39 +
        '||CRLF;'
      '110110423=      ELSE'
      
        '110110424=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39#39#39#39#39'||TRIM(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110110425=    end'
      '110110426=    SELECT COUNT(*)'
      '110110427=      FROM RDB$TRIGGERS'
      '110110428=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGI'#39
      '110110429=      INTO :ANZ;'
      '110110430='
      '110110431=    IF (ANZ>0) THEN'
      '110110432=      TRGIX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGI'#39';'
      '110110433=    ELSE'
      '110110434=      TRGIX='#39#39';'
      '110110435='
      
        '110110436=    TRGI='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGI FOR '#39'||TN||'#39' AC' +
        'TIVE AFTER INSERT POSITION 255 AS '#39'||CRLF||'
      
        '110110437=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEG' +
        'MENT SIZE 80;'#39'||CRLF||'
      '110110438=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '110110439=         '#39'BEGIN'#39'||CRLF||'
      
        '110110440=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39' ||CRLF;'
      '110110441='
      '110110442=    IF (TN = '#39'KASSA_STATE'#39') THEN BEGIN'
      '110110443=      TRGI = TRGI||'
      '110110444=         '#39'  SQLSTMT='#39#39#39'||'#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110110445=                           '#39'USING (select CAST('#39#39#39#39#39#39'|' +
        '|NEW.K_DATE ||'#39#39#39#39#39#39' AS DATE) as K_DATE, '#39#39'||NEW.G_TOCHKA||'#39#39' AS' +
        ' G_TOCHKA '#39'||'
      '110110446=                           '#39' from RDB$DATABASE) cd '#39'||'
      
        '110110447=                           '#39'ON (c.K_DATE = cd.K_DATE A' +
        'ND C.G_TOCHKA = CD.G_TOCHKA) '#39'||'
      '110110448=                           '#39'WHEN MATCHED THEN '#39'||'
      '110110449=                           '#39' UPDATE SET '#39'||'
      
        '110110450=                           '#39'  C.INPUT  = COALESCE((SEL' +
        'ECT "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE)' +
        ' '#39'||'
      
        '110110451=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110110452=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110110453=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0), '#39'||'
      
        '110110454=                           '#39'  C.DEBET  = C.DEBET + '#39#39'|' +
        '|NEW.DEBET||'#39#39', '#39'||'
      
        '110110455=                           '#39'  C.CREDIT = C.CREDIT + '#39#39 +
        '||NEW.CREDIT||'#39#39', '#39'||'
      
        '110110456=                           '#39'  C.OUTPUT = COALESCE((SEL' +
        'ECT "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE)' +
        ' '#39'||'
      
        '110110457=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110110458=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110110459=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0) - (C.DEBET + '#39#39'||NEW.DEBET||'#39#39') + (C.CREDIT + '#39#39 +
        '||NEW.CREDIT||'#39#39') '#39'||'
      '110110460=                           '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110110461=                           '#39' INSERT (KASSA_STATE, K_DA' +
        'TE, "INPUT", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '110110462=                           '#39' VALUES ('#39#39'||NEW.KASSA_STA' +
        'TE||'#39#39', '#39#39#39#39#39#39'||NEW.K_DATE||'#39#39#39#39#39#39', COALESCE((SELECT "OUTPUT" FR' +
        'OM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110110463=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110110464=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110110465=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0), '#39#39'||NEW.DEBET||'#39#39', '#39#39'||NEW.CREDIT||'#39#39', COALESCE' +
        '((SELECT "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_' +
        'DATE) '#39'||'
      
        '110110466=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110110467=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110110468=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0) - '#39#39'||NEW.DEBET||'#39#39' + '#39#39'||NEW.CREDIT||'#39#39', '#39#39'||NE' +
