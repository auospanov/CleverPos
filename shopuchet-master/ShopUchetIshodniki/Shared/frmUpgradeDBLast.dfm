        '110210120=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN SUMM_S' +
        'ELF POSITION 14;'
      '110210121='
      
        '110210122=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN IS_CAT' +
        'EGORY POSITION 15;'
      '110210123='
      
        '110210124=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN TOVAR_' +
        'NAME POSITION 16;'
      '110210125='
      
        '110210126=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN SORT_C' +
        'OL POSITION 17;'
      '110210127='
      
        '110210128=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN NOTE P' +
        'OSITION 18;'
      '110210129='
      
        '110210130=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN PLACE ' +
        'POSITION 19;'
      '110210131='
      
        '110210132=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN BRAND ' +
        'POSITION 20;'
      '110210133='
      
        '110210134=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN CATEGO' +
        'RY_NAME POSITION 21;'
      '110210135='
      
        '110210136=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN PACK_A' +
        'MOUNT POSITION 22;'
      '110210137='
      
        '110210138=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN MF_COU' +
        'NTRY POSITION 23;'
      '110210139='
      
        '110210140=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN KOD_TN' +
        'VD POSITION 24;'
      '110210141='
      
        '110210142=ALTER TABLE P_REP_PRICE_LIST_TABLE ALTER COLUMN CROSSC' +
        'ODE_BLOB_TXT POSITION 25;'
      '110210143='
      '110210144='
      
        '110210145=/*****************************************************' +
        '*************************/'
      
        '110210146=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110210147=/*****************************************************' +
        '*************************/'
      '110210148='
      '110210149=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '110210150=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110210151=  INCLUDE_NOL_ INTEGER,'
      '110210152=  INCLUDE_FEW_ INTEGER,'
      '110210153=  SORT_BY_NAME_ INTEGER,'
      '110210154=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110210155=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39','
      '110210156=  IS_EXPORT_ INTEGER = 0)'
      '110210157=RETURNS ('
      '110210158=  PERIOD_ VARCHAR(40),'
      '110210159=  ROW_NUM VARCHAR(15),'
      '110210160=  ARTICUL VARCHAR(1000),'
      '110210161=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110210162=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110210163=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110210164=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110210165=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110210166=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110210167=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110210168=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110210169=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110210170=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110210171=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110210172=  TOVAR_NAME VARCHAR(250),'
      '110210173=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110210174=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110210175=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110210176=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110210177=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      
        '110210178=  CATEGORY_NAME TYPE OF COLUMN P_REP_PRICE_LIST_TABLE.' +
        'CATEGORY_NAME,'
      '110210179=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110210180=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110210181=  KOD_TNVD TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110210182=  ERR_CODE INTEGER,'
      '110210183=  ERR_MSG VARCHAR(1024))'
      '110210184=AS'
      
        '110210185=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK' +
        '_TOVAROV'#39';'
      '110210186=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110210187=DECLARE VARIABLE I INTEGER = 1;'
      '110210188=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110210189=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110210190=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110210191=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110210192=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110210193=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110210194=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110210195=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110210196=BEGIN'
      '110210197='
      
        '110210198=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110210199=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110210200='
      '110210201=  SELECT S.S_VALUE,'
      '110210202=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110210203=    FROM SYSTEM_SETUP S'
      '110210204=   WHERE S.SYSTEM_SETUP = 1'
      '110210205=    INTO :FORMULA_,'
      '110210206=         :PRIHOD_CNT_;'
      '110210207='
      '110210208=  IF (IS_EXPORT_ = 1) THEN'
      
        '110210209=    SELECT '#39'-'#39'||LIST(G_TOCHKA, '#39'-'#39')||'#39'-'#39' FROM G_TOCHKA' +
        ' INTO :G_TOCHKA_ARR_;'
      '110210210='
      '110210211=  FOR SELECT GP.PATH,'
      '110210212=             GP.G_PRODUCT'
      '110210213=        FROM P_REP_TREE GP'
      '110210214=       WHERE EXISTS (SELECT 1'
      '110210215=                       FROM G_PRODUCT'
      '110210216=                      WHERE IS_CATEGORY = 0'
      
        '110210217=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110210218=                    )'
      
        '110210219=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110210220=              OR'
      '110210221=              (:G_CATEGORY_ is NULL)'
      '110210222=             )'
      '110210223=       ORDER BY 1, 2'
      '110210224=       INTO :PATH_NAME_,'
      '110210225=            :G_PRODUCT_'
      '110210226=  DO BEGIN'
      
        '110210227=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110210228=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110210229=      SELECT COUNT(G.G_PRODUCT)'
      
        '110210230=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110210231=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110210232=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110210233=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110210234=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110210235=              OR'
      
        '110210236=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110210237=              or'
      
        '110210238=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110210239=             )'
      '110210240=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110210241=         AND ((EXISTS (SELECT 1'
      '110210242=                       FROM SKLAD S'
      '110210243=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110210244=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110210245=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110210246=              OR'
      '110210247=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110210248=        INTO :CNT_;'
      '110210249='
      '110210250=      IF (CNT_ > 0) THEN BEGIN'
      '110210251=          IF (IS_EXPORT_ = 0) THEN'
      
        '110210252=            INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_' +
        'PRICE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110210253=            VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE,' +
        ' 1), :PATH_NAME_, 1);'
      '110210254='
      
        '110210255=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110210256=                                              ARTICUL,'
      '110210257=                                              BARCODE,'
      
        '110210258=                                              NOMENCLA' +
        'TUR_NUM,'
      '110210259=                                              NAME,'
      
        '110210260=                                              UNIT_NAM' +
        'E,'
      '110210261=                                              PRICE,'
      
        '110210262=                                              VOLUME_P' +
        'RICE,'
      '110210263=                                              AMOUNT,'
      
        '110210264=                                              AMOUNT_R' +
        'ESERVE,'
      '110210265=                                              SUMM,'
      
        '110210266=                                              PRICE_SE' +
        'LF,'
      
        '110210267=                                              SORT_COL' +
        ','
      
        '110210268=                                              IS_CATEG' +
        'ORY,'
      '110210269=                                              NOTE,'
      
        '110210270=                                              CROSSCOD' +
        'E_BLOB_TXT,'
      '110210271=                                              PLACE,'
      '110210272=                                              BRAND,'
      
        '110210273=                                              CATEGORY' +
        '_NAME,'
      
        '110210274=                                              PACK_AMO' +
        'UNT,'
      
        '110210275=                                              MF_COUNT' +
        'RY,'
      
        '110210276=                                              KOD_TNVD' +
        ')'
      
        '110210277=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110210278=                 G.ARTICUL,'
      '110210279=                 G.BARCODE,'
      '110210280=                 G.NOMENCLATUR_NUM,'
      '110210281=                 G.NAME,'
      '110210282=                 U.SHORT_NAME,'
      '110210283=                 G.PRICE,'
      '110210284=                 G.VOLUME_PRICE,'
      '110210285=                 COALESCE(S.AMOUNT, 0),'
      '110210286=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110210287=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110210288=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110210289=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110210290=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110210291=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110210292=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110210293=                  DECODE(:FORMULA_,'
      '110210294=                         1,'
      '110210295=                         (SELECT S.price'
      '110210296=                            FROM SKLAD S'
      
        '110210297=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110210298=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110210299=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110210300=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110210301=                                                     F' +
        'ROM SKLAD DD'
      
        '110210302=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110210303=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110210304=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110210305=                                                    )'
      '110210306=                            ORDER BY 1 DESC'
      '110210307=                            ROWS 1 TO 1'
      '110210308=                         ),'
      
        '110210309=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110210310=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110210311=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110210312=                                         SKLAD S'
      
        '110210313=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110210314=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110210315=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110210316=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110210317=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110210318=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110210319=                         )), 0) spr,'
      
        '110210320=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110210321=                 0'
      '110210322=                 ,G.NOTE'
      
        '110210323=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110210324=                 ,G.PLACE'
      '110210325=                 ,G.BRAND'
      '110210326=                 ,REPLACE(:PATH_NAME_, '#39' - '#39', '#39'~'#39')'
      '110210327=                 ,G.PACK_AMOUNT'
      '110210328=                 ,G.MF_COUNTRY'
      '110210329=                 ,G.KOD_TNVD'
      
        '110210330=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110210331=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110210332=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110210333=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110210334=             AND G.IS_CATEGORY = 0'
      '110210335=             AND G.is_active = 1'
      '110210336=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110210337=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110210338=                  OR'
      
        '110210339=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110210340=                  or'
      
        '110210341=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110210342=                 )'
      '110210343=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110210344=             AND ((EXISTS (SELECT 1'
      '110210345=                           FROM SKLAD S'
      
        '110210346=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110210347=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110210348=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110210349=                  OR'
      '110210350=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110210351=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '110210352=      END'
      '110210353=  END'
      '110210354='
      
        '110210355=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110210356='
      
        '110210357=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE_BLOB_TXT, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, VO' +
        'LUME_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRI' +
        'CE_SELF, IS_CATEGORY,'
      
        '110210358=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL), CA' +
        'TEGORY_NAME, PACK_AMOUNT, MF_COUNTRY, KOD_TNVD'
      '110210359=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110210360=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRICE' +
        ', :VOLUME_PRICE,'
      
        '110210361=        :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, ' +
        ':SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME, :CATEGORY_NAME, :PACK_AMO' +
        'UNT, :MF_COUNTRY, :KOD_TNVD'
      '110210362=  DO BEGIN'
      '110210363=    I = I + 1;'
      '110210364=    SUSPEND;'
      '110210365=  END'
      '110210366=WHEN ANY DO BEGIN'
      '110210367=    Err_code = -20500;'
      
        '110210368=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110210369=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110210370=  END'
      '110210371=end'
      '110210372=;'
      '110210373='
      '110210374=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110210375=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110210376=  INCLUDE_NOL_ INTEGER,'
      '110210377=  INCLUDE_FEW_ INTEGER,'
      '110210378=  SORT_BY_NAME_ INTEGER,'
      '110210379=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110210380=  SCALE_PREFIX_ VARCHAR(2) = '#39#39','
      '110210381=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110210382=RETURNS ('
      '110210383=  PERIOD_ VARCHAR(40),'
      '110210384=  ROW_NUM VARCHAR(15),'
      '110210385=  ARTICUL VARCHAR(1000),'
      '110210386=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110210387=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110210388=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110210389=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110210390=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110210391=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110210392=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110210393=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110210394=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110210395=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110210396=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110210397=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110210398=  TOVAR_NAME VARCHAR(250),'
      '110210399=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110210400=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110210401=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110210402=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110210403=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110210404=  ERR_CODE INTEGER,'
      '110210405=  ERR_MSG VARCHAR(1024))'
      '110210406=AS'
      '110210407=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '110210408=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110210409=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110210410=DECLARE VARIABLE I INTEGER = 1;'
      '110210411=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110210412=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110210413=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110210414=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110210415=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110210416=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110210417=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110210418=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110210419=BEGIN'
      '110210420='
      
        '110210421=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110210422=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110210423='
      '110210424=  SELECT S.S_VALUE,'
      '110210425=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110210426=    FROM SYSTEM_SETUP S'
      '110210427=   WHERE S.SYSTEM_SETUP = 1'
      '110210428=    INTO :FORMULA_,'
      '110210429=         :PRIHOD_CNT_;'
      '110210430='
      '110210431=  FOR SELECT GP.PATH,'
      '110210432=             GP.G_PRODUCT'
      '110210433=        FROM P_REP_TREE GP'
      '110210434=       WHERE EXISTS (SELECT 1'
      '110210435=                       FROM G_PRODUCT'
      '110210436=                      WHERE IS_CATEGORY = 0'
      
        '110210437=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110210438=                    )'
      
        '110210439=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110210440=              OR'
      '110210441=              (:G_CATEGORY_ is NULL)'
      '110210442=             )'
      '110210443=       ORDER BY 1, 2'
      '110210444=       INTO :PATH_NAME_,'
      '110210445=            :G_PRODUCT_'
      '110210446=  DO BEGIN'
      
        '110210447=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110210448=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110210449=      SELECT COUNT(G.G_PRODUCT)'
      
        '110210450=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110210451=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110210452=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110210453=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110210454=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110210455=              OR'
      
        '110210456=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110210457=              or'
      
        '110210458=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110210459=             )'
      '110210460=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110210461=         AND ((EXISTS (SELECT 1'
      '110210462=                       FROM SKLAD S'
      '110210463=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110210464=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110210465=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110210466=              OR'
      '110210467=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110210468=        INTO :CNT_;'
      '110210469='
      '110210470=      IF (CNT_ > 0) THEN BEGIN'
      
        '110210471=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110210472=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110210473='
      
        '110210474=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110210475=                                              ARTICUL,'
      '110210476=                                              BARCODE,'
      
        '110210477=                                              NOMENCLA' +
        'TUR_NUM,'
      '110210478=                                              NAME,'
      
        '110210479=                                              UNIT_NAM' +
        'E,'
      '110210480=                                              PRICE,'
      
        '110210481=                                              VOLUME_P' +
        'RICE,'
      
        '110210482=                                              SKIDKA_P' +
        'RICE,'
      '110210483=                                              AMOUNT,'
      
        '110210484=                                              AMOUNT_R' +
        'ESERVE,'
      '110210485=                                              SUMM,'
      
        '110210486=                                              PRICE_SE' +
        'LF,'
      
        '110210487=                                              SORT_COL' +
        ','
      
        '110210488=                                              IS_CATEG' +
        'ORY,'
      '110210489=                                              NOTE,'
      
        '110210490=                                              CROSSCOD' +
        'E_BLOB_TXT,'
      '110210491=                                              PLACE,'
      '110210492=                                              BRAND)'
      
        '110210493=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110210494=                 G.ARTICUL,'
      '110210495=                 G.BARCODE,'
      '110210496=                 G.NOMENCLATUR_NUM,'
      '110210497=                 G.NAME,'
      '110210498=                 U.SHORT_NAME,'
      '110210499=                 G.PRICE,'
      '110210500=                 G.VOLUME_PRICE,'
      '110210501=                 G.PRICE - GD.SKIDKA_SUM,'
      '110210502=                 COALESCE(S.AMOUNT, 0),'
      '110210503=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110210504=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110210505=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110210506=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110210507=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110210508=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110210509=                  DECODE(:FORMULA_,'
      '110210510=                         1,'
      
        '110210511=                         (SELECT CAST(S.price AS MY_NU' +
        'MERIC)'
      '110210512=                            FROM SKLAD S'
      
        '110210513=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110210514=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110210515=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110210516=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110210517=                                                     F' +
        'ROM SKLAD DD'
      
        '110210518=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110210519=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110210520=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110210521=                                                    )'
      '110210522=                            ORDER BY 1 DESC'
      '110210523=                            ROWS 1 TO 1'
      '110210524=                         ),'
      
        '110210525=                         (SELECT CAST(ROUND(SUM(T.AMOU' +
        'NT * T.PRICE)/SUM(T.AMOUNT), 2) AS MY_NUMERIC)'
      
        '110210526=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110210527=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110210528=                                         SKLAD S'
      
        '110210529=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110210530=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110210531=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110210532=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110210533=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110210534=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '110210535=                        )), 0) spr,'
      
        '110210536=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110210537=                 0'
      '110210538=                 ,G.NOTE'
      
        '110210539=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110210540=                 ,G.PLACE'
      '110210541=                 ,G.BRAND'
      
        '110210542=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '110210543=                                                FROM G' +
        '_DISCOUNT D'
      
        '110210544=                                                WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110210545=                                                      ' +
        '  AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '110210546=                                                      ' +
        '  AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '110210547=                                                      ' +
        ')'
      
        '110210548=                                                      ' +
        'OR'
      
        '110210549=                                                      ' +
        '(D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '110210550=                                                 AND (' +
        '(:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '110210551=                                                     O' +
        'R'
      
        '110210552=                                                     (' +
        'D.G_TOCHKA IS NULL))'
      
        '110210553=                                              ) GD ON ' +
        'G.G_PRODUCT = GD.G_PRODUCT'
      
        '110210554=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110210555=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110210556=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110210557=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110210558=             AND G.IS_CATEGORY = 0'
      '110210559=             AND G.is_active = 1'
      '110210560=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110210561=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110210562=                  OR'
      
        '110210563=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110210564=                  or'
      
        '110210565=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110210566=                 )'
      '110210567=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110210568=             AND ((EXISTS (SELECT 1'
      '110210569=                           FROM SKLAD S'
      
        '110210570=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110210571=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110210572=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110210573=                  OR'
      '110210574=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110210575=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '110210576=      END'
      '110210577=  END'
      '110210578='
      
        '110210579=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110210580='
      
        '110210581=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE_BLOB_TXT, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, VO' +
        'LUME_PRICE, SKIDKA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SE' +
        'LF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '110210582=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110210583=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110210584=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, :CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRIC' +
        'E, :VOLUME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM' +
        ', :PRICE_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110210585=  DO BEGIN'
      '110210586=    I = I + 1;'
      '110210587=    SUSPEND;'
      '110210588=  END'
      '110210589='
      '110210590=     /*'
      '110210591=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110210592='
      '110210593=     SELECT :I,'
      
        '110210594=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110210595=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110210596=             U.SHORT_NAME UNIT_NAME,'
      '110210597=             SS.PRICE,'
      '110210598=             SS.VOLUME_PRICE,'
      '110210599=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110210600=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110210601=             SS.IS_CATEGORY'
      '110210602=        FROM (WITH RECURSIVE TREE'
      '110210603=              AS (SELECT T.G_PRODUCT,'
      '110210604=                       T.NAME AS ARTICUL,'
      
        '110210605=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110210606=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110210607=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110210608=                       T.IS_CATEGORY,'
      '110210609=                       NULL G_UNIT'
      '110210610=                  FROM G_PRODUCT T'
      '110210611=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110210612=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110210613=                UNION ALL'
      '110210614=                SELECT T.G_PRODUCT,'
      '110210615=                       DECODE(T. T.ARTICUL,'
      '110210616=                       T.NAME,'
      '110210617=                       T.PRICE,'
      '110210618=                       T.VOLUME_PRICE,'
      '110210619=                       T.IS_CATEGORY,'
      '110210620=                       T.G_UNIT'
      
        '110210621=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110210622=                 WHERE T.IS_ACTIVE = 1'
      '110210623=                )'
      '110210624=             SELECT * FROM TREE) SS'
      
        '110210625=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110210626=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110210627=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110210628=    INTO :ROW_NUM,'
      '110210629=        :ARTICUL,'
      '110210630=        :NAME,'
      '110210631=        :UNIT_NAME,'
      '110210632=        :PRICE,'
      '110210633=        :VOLUME_PRICE,'
      '110210634=        :SKIDKA_PRICE,'
      '110210635=        :AMOUNT,'
      '110210636=        :IS_CATEGORY'
      '110210637=    DO BEGIN'
      '110210638=      I = I + 1;'
      '110210639=      SUSPEND;'
      '110210640=    END  */'
      '110210641=WHEN ANY DO BEGIN'
      '110210642=    Err_code = -20500;'
      
        '110210643=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110210644=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110210645=  END'
      '110210646=end'
      '110210647=;'
      '110210648='
      '110210649='
      
