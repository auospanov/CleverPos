        'Z'
      
        '11026934=                                           WHERE Z.z_da' +
        'te BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11026935=                                             AND Z.G_TO' +
        'CHKA = :G_TOCHKA_'
      
        '11026936=                                             AND Z.is_s' +
        'pisanie in (0, 2))'
      '11026937=               );'
      '11026938='
      
