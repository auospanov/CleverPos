      '1102015282=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102015283=        INSERT INTO P_REP_TOVAR_MOVE_TABLE'
