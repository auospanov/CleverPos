      '110190300=RETURNS ('
      
        '110190301=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ ' +
        'BIGINT,'
      '110190302=  ERR_CODE INTEGER,'
      '110190303=  ERR_MSG VARCHAR(1024))'
      '110190304=AS'
      '110190305=BEGIN'
      '110190306=  SUSPEND;'
      '110190307=END'
      '110190308=;'
      '110190309='
      '110190310=ALTER PROCEDURE G_UPD_G_PRODUCT('
      
        '110190311=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ ' +
        'BIGINT,'
      
        '110190312=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT' +
        '_PAR */ BIGINT,'
      '110190313=  ARTICUL_ VARCHAR(30),'
      '110190314=  NOMENCLATUR_NUM_ VARCHAR(30),'
      
        '110190315=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARC' +
        'HAR(150),'
      '110190316=  NAME_ VARCHAR(500),'
      '110190317=  G_UNIT_ /* TYPE OF COLUMN G_UNIT.G_UNIT */ BIGINT,'
      '110190318=  PRICE_ NUMERIC(15,2),'
      '110190319=  VOLUME_PRICE_ NUMERIC(15,2),'
      
        '110190320=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT' +
        ' */ NUMERIC(15,2),'
      
        '110190321=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY *' +
        '/ VARCHAR(150),'
      
        '110190322=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(30' +
        '0),'
      
        '110190323=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ ' +
        'BLOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '110190324=  IS_KIT_ /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGE' +
        'R,'
      '110190325=  IS_CATEGORY_ INTEGER,'
      
        '110190326=  MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT *' +
        '/ NUMERIC(15,2),'
      
        '110190327=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(' +
        '250),'
      
        '110190328=  SALES_COMM_ /* TYPE OF COLUMN G_PRODUCT.SALES_COMM *' +
        '/ NUMERIC(15,2),'
      
        '110190329=  KOD_TNVD_ /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VA' +
        'RCHAR(50),'
      
        '110190330=  FAST_TOVAR_ /* TYPE OF COLUMN G_PRODUCT.FAST_TOVAR *' +
        '/ INTEGER,'
      
        '110190331=  DO_NOT_CHARGE_BONUS_ /* TYPE OF COLUMN G_PRODUCT.DO_' +
        'NOT_CHARGE_BONUS */ INTEGER,'
      '110190332=  IS_MARKED_ INTEGER,'
      
        '110190333=  BRAND_ /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(' +
        '150),'
      
        '110190334=  IS_WEIGHT_ /* TYPE OF COLUMN G_PRODUCT.IS_WEIGHT */ ' +
        'SMALLINT,'
      
        '110190335=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT = NULL,'
      
        '110190336=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SU' +
        'B_TYPE 1 SEGMENT SIZE 16384 = NULL,'
      '110190337=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110190338=RETURNS ('
      '110190339=  ERR_CODE INTEGER,'
      '110190340=  ERR_MSG VARCHAR(1024))'
      '110190341=AS'
      '110190342=BEGIN'
      '110190343=  SUSPEND;'
      '110190344=END'
      '110190345=;'
      '110190346='
      '110190347=ALTER PROCEDURE P_REP_PROFIT('
      '110190348=  DATE_BEGIN_ DATE,'
      '110190349=  DATE_END_ DATE,'
      
        '110190350=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIG' +
        'INT,'
      
        '110190351=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN G_PAYMENT_TYPE.G_P' +
        'AYMENT_TYPE */ BIGINT,'
      '110190352=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '110190353=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ B' +
        'IGINT = 0)'
      '110190354=RETURNS ('
      
        '110190355=  CLIENT_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARC' +
        'HAR(250),'
      
        '110190356=  PAYMENT_NAME_ /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME ' +
        '*/ VARCHAR(256),'
      
        '110190357=  SUMM_COST_ALL_ /* TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'SUMM */ NUMERIC(15,2),'
      '110190358=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110190359=  SUMM_ALL_ NUMERIC(15,2),'
      '110190360=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110190361=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110190362=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110190363=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110190364=  PROFIT_ALL_ NUMERIC(15,2),'
      '110190365=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110190366=  P_REP_PROFIT_TABLE /* TYPE OF COLUMN P_REP_PROFIT_TA' +
        'BLE.P_REP_PROFIT_TABLE */ INTEGER,'
      
        '110190367=  ZAKAZ /* TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ */ ' +
        'BIGINT,'
      
        '110190368=  G_TOCHKA /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCH' +
        'KA */ BIGINT,'
      
        '110190369=  Z_DATE /* TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE *' +
        '/ DATE,'
      
        '110190370=  G_CLIENT /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIE' +
        'NT */ BIGINT,'
      
        '110190371=  CLIENT_NAME /* TYPE OF COLUMN P_REP_PROFIT_TABLE.CLI' +
        'ENT_NAME */ VARCHAR(500),'
      
        '110190372=  G_PAYMENT_TYPE /* TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'G_PAYMENT_TYPE */ BIGINT,'
      
        '110190373=  PAYMENT_NAME /* TYPE OF COLUMN P_REP_PROFIT_TABLE.PA' +
        'YMENT_NAME */ VARCHAR(256),'
      
        '110190374=  OSNOVANIE /* TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOV' +
        'ANIE */ VARCHAR(500),'
      
        '110190375=  G_PRODUCT /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRO' +
        'DUCT */ BIGINT,'
      
        '110190376=  G_PRODUCT_PAR /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G' +
        '_PRODUCT_PAR */ BIGINT,'
      
        '110190377=  TOVAR_NAME /* TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVA' +
        'R_NAME */ VARCHAR(500),'
      
        '110190378=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110190379=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLA' +
        'TUR_NUM */ VARCHAR(150),'
      '110190380=  AMOUNT /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      '110190381=  PRICE NUMERIC(15,2),'
      '110190382=  SUMM NUMERIC(15,2),'
      '110190383=  DISCOUNT_PERC NUMERIC(15,2),'
      '110190384=  DISCOUNT_SUMM NUMERIC(15,2),'
      '110190385=  NDS NUMERIC(15,2),'
      '110190386=  NDS_SUMM NUMERIC(15,2),'
      '110190387=  PRICE_SELF NUMERIC(15,2),'
      '110190388=  SUM_SELF NUMERIC(15,2),'
      '110190389=  PROFIT NUMERIC(15,2),'
      
        '110190390=  IS_HEAD /* TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD' +
        ' */ INTEGER,'
      '110190391=  ERR_CODE INTEGER,'
      '110190392=  ERR_MSG VARCHAR(1024))'
      '110190393=AS'
      '110190394=BEGIN'
      '110190395=  SUSPEND;'
      '110190396=END'
      '110190397=;'
      '110190398='
      '110190399=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '110190400=  DATE_BEGIN_ DATE,'
      '110190401=  DATE_END_ DATE,'
      
        '110190402=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIG' +
        'INT,'
      
        '110190403=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN G_PAYMENT_TYPE.G_P' +
        'AYMENT_TYPE */ BIGINT,'
      '110190404=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '110190405=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ B' +
        'IGINT = 0)'
      '110190406=RETURNS ('
      
        '110190407=  CLIENT_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARC' +
        'HAR(250),'
      
        '110190408=  PAYMENT_NAME_ /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME ' +
        '*/ VARCHAR(256),'
      
        '110190409=  SUMM_COST_ALL_ /* TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'SUMM */ NUMERIC(15,2),'
      '110190410=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110190411=  SUMM_ALL_ NUMERIC(15,2),'
      '110190412=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110190413=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110190414=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110190415=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110190416=  PROFIT_ALL_ NUMERIC(15,2),'
      '110190417=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110190418=  P_REP_PROFIT_TABLE /* TYPE OF COLUMN P_REP_PROFIT_TA' +
        'BLE.P_REP_PROFIT_TABLE */ INTEGER,'
      
        '110190419=  TOVAR_NAME /* TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVA' +
        'R_NAME */ VARCHAR(500),'
      '110190420=  SUMM NUMERIC(15,2),'
      '110190421=  NDS_SUMM NUMERIC(15,2),'
      '110190422=  SUM_SELF NUMERIC(15,2),'
      '110190423=  PROFIT NUMERIC(15,2),'
      
        '110190424=  IS_HEAD /* TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD' +
        ' */ INTEGER,'
      '110190425=  ERR_CODE INTEGER,'
      '110190426=  ERR_MSG VARCHAR(1024))'
      '110190427=AS'
      '110190428=BEGIN'
      '110190429=  SUSPEND;'
      '110190430=END'
      '110190431=;'
      '110190432='
      '110190433='
      
        '110190434=/*****************************************************' +
        '*************************/'
      
        '110190435=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110190436=/*****************************************************' +
        '*************************/'
      '110190437=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110190438=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110190439=  MODE_ INTEGER = 0)'
      '110190440=RETURNS ('
      
        '110190441=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110190442=  ARTICUL_ VARCHAR(30),'
      '110190443=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110190444=  BARCODE_ VARCHAR(30),'
      '110190445=  NAME_ VARCHAR(500),'
      '110190446=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110190447=  PRICE_ NUMERIC(15,2),'
      '110190448=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110190449=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110190450=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110190451=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110190452=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110190453=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110190454=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110190455=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110190456=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110190457=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110190458=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110190459=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      
        '110190460=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110190461=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110190462=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110190463=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110190464=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '110190465=  ERR_CODE INTEGER,'
      '110190466=  ERR_MSG VARCHAR(1024))'
      '110190467=AS'
      '110190468=begin'
      '110190469=    SELECT'
      '110190470=        G_PRODUCT_PAR,'
      '110190471=        ARTICUL,'
      '110190472=        NOMENCLATUR_NUM,'
      '110190473=        BARCODE,'
      '110190474=        NAME,'
      '110190475=        G_UNIT,'
      '110190476=        PRICE,'
      '110190477=        VOLUME_PRICE,'
      '110190478=        PACK_AMOUNT,'
      '110190479=        MF_COUNTRY,'
      '110190480=        NOTE,'
      '110190481=        CROSSCODE,'
      '110190482=        IS_KIT,'
      '110190483=        MIN_AMOUNT,'
      '110190484=        PLACE,'
      '110190485=        SALES_COMM,'
      '110190486=        KOD_TNVD,'
      '110190487=        FAST_TOVAR,'
      '110190488=        DO_NOT_SHOW_RMK,'
      '110190489=        DO_NOT_CHARGE_BONUS,'
      '110190490=        IS_MARKED,'
      '110190491=        BRAND,'
      
        '110190492=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1)),'
      '110190493=        IS_WEIGHT'
      '110190494=    FROM G_PRODUCT T'
      '110190495=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110190496=    INTO'
      '110190497=        :G_PRODUCT_PAR_,'
      '110190498=        :ARTICUL_,'
      '110190499=        :NOMENCLATUR_NUM_,'
      '110190500=        :BARCODE_,'
      '110190501=        :NAME_,'
      '110190502=        :G_UNIT_,'
      '110190503=        :PRICE_,'
      '110190504=        :VOLUME_PRICE_,'
      '110190505=        :PACK_AMOUNT_,'
      '110190506=        :MF_COUNTRY_,'
      '110190507=        :NOTE_,'
      '110190508=        :CROSSCODE_,'
      '110190509=        :IS_KIT_,'
      '110190510=        :MIN_AMOUNT_,'
      '110190511=        :PLACE_,'
      '110190512=        :SALES_COMM_,'
      '110190513=        :KOD_TNVD_,'
      '110190514=        :FAST_TOVAR_,'
      '110190515=        :DO_NOT_SHOW_RMK_,'
      '110190516=        :DO_NOT_CHARGE_BONUS_,'
      '110190517=        :IS_MARKED_,'
      '110190518=        :BRAND_,'
      '110190519=        :LAST_PRICE_,'
      '110190520=        :IS_WEIGHT_;'
      '110190521='
      '110190522=    INSERT INTO LT_BARCODE_TMP'
      
        '110190523=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110190524='
      '110190525=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110190526=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110190527='
      
        '110190528=    INSERT INTO G_PRODUCT_KIT_TMP (G_PRODUCT_KIT, G_PR' +
        'ODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3)'
      
        '110190529=    SELECT DECODE(:MODE_, 0, G_PRODUCT_KIT, GEN_ID(GEN' +
        '_G_PRODUCT_KIT, 1)), G_PRODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, P' +
        'RICE1, PRICE2, PRICE3'
      '110190530=    FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRODUCT_;'
      '110190531=end'
      '110190532=;'
      '110190533='
      '110190534=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '110190535=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110190536=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110190537=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '110190538=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110190539=  PREFIX_ VARCHAR(2))'
      '110190540=RETURNS ('
      '110190541=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110190542=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT_PAR,'
      '110190543=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110190544=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110190545=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110190546=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110190547=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110190548=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '110190549=  ERR_CODE INTEGER,'
      '110190550=  ERR_MSG VARCHAR(1024))'
      '110190551=AS'
      '110190552=/*'
      '110190553='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '110190554=*/'
      
        '110190555=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PRODU' +
        'CT_BY_BARCODE'#39';'
      '110190556=BEGIN'
      '110190557='
      '110190558=    IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '110190559=        ERR_CODE = -20500;'
      
        '110190560=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093 +
        #1082#1086#1076' '#1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110190561=        ERR_MSG = PROCNAME||ERR_MSG;'
      '110190562=        EXIT;'
      '110190563=    END'
      '110190564='
      
        '110190565=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) TH' +
        'EN BEGIN'
      '110190566=        SELECT T.G_PRODUCT_PAR,'
      '110190567=               T.G_PRODUCT,'
      '110190568=               T.PRICE,'
      '110190569=               T.VOLUME_PRICE,'
      '110190570=               T.IS_KIT,'
      '110190571=               T.IS_MARKED,'
      '110190572=               T.IS_WEIGHT'
      '110190573=          FROM G_PRODUCT T'
      
        '110190574=          WHERE SUBSTRING(T.BARCODE FROM 1 FOR 7) = SU' +
        'BSTRING(:BARCODE_ FROM 1 FOR 7)'
      '110190575=            AND T.IS_ACTIVE = 1'
      '110190576=          INTO :G_PRODUCT_CATEGORY_,'
      '110190577=               :G_PRODUCT_,'
      '110190578=               :PRICE_,'
      '110190579=               :VOLUME_PRICE_,'
      '110190580=               :IS_KIT_,'
      '110190581=               :IS_MARKED_,'
      '110190582=               :IS_WEIGHT_;'
      '110190583='
      
        '110190584=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM 8' +
        ' FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '110190585=    END ELSE'
      '110190586=        SELECT T.G_PRODUCT_PAR,'
      '110190587=               T.G_PRODUCT,'
      '110190588=               T.PRICE,'
      '110190589=               T.VOLUME_PRICE,'
      '110190590=               T.IS_KIT,'
      '110190591=               T.IS_MARKED,'
      '110190592=               T.IS_WEIGHT'
      '110190593=          FROM G_PRODUCT T'
      '110190594=          WHERE T.BARCODE = :BARCODE_'
      '110190595=            AND T.IS_ACTIVE = 1'
      '110190596=          INTO :G_PRODUCT_CATEGORY_,'
      '110190597=               :G_PRODUCT_,'
      '110190598=               :PRICE_,'
      '110190599=               :VOLUME_PRICE_,'
      '110190600=               :IS_KIT_,'
      '110190601=               :IS_MARKED_,'
      '110190602=               :IS_WEIGHT_;'
      '110190603='
      '110190604=    IF (ROW_COUNT = 0) THEN BEGIN'
      
        '110190605=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' '#1044 +
        #1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '110190606=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) ' +
        'THEN'
      '110190607=          SELECT T.G_PRODUCT_PAR,'
      '110190608=                 T.G_PRODUCT,'
      '110190609=                 T.PRICE,'
      '110190610=                 T.VOLUME_PRICE,'
      '110190611=                 T.IS_KIT,'
      '110190612=                 T.IS_MARKED,'
      '110190613=                 T.IS_WEIGHT'
      '110190614=            FROM G_PRODUCT T, LT_BARCODE D'
      '110190615=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110190616=              AND T.IS_ACTIVE = 1'
      
        '110190617=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) = ' +
        'SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '110190618=            INTO'
      '110190619=                :G_PRODUCT_CATEGORY_,'
      '110190620=                :G_PRODUCT_,'
      '110190621=                :PRICE_,'
      '110190622=                :VOLUME_PRICE_,'
      '110190623=                :IS_KIT_,'
      '110190624=                :IS_MARKED_,'
      '110190625=                :IS_WEIGHT_;'
      '110190626=      ELSE'
      '110190627=          SELECT T.G_PRODUCT_PAR,'
      '110190628=                 T.G_PRODUCT,'
      '110190629=                 T.PRICE,'
      '110190630=                 T.VOLUME_PRICE,'
      '110190631=                 T.IS_KIT,'
      '110190632=                 T.IS_MARKED,'
      '110190633=                 T.IS_WEIGHT'
      '110190634=            FROM G_PRODUCT T, LT_BARCODE D'
      '110190635=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110190636=              AND T.IS_ACTIVE = 1'
      '110190637=              AND D.BARCODE = :BARCODE_'
      '110190638=            INTO'
      '110190639=                :G_PRODUCT_CATEGORY_,'
      '110190640=                :G_PRODUCT_,'
      '110190641=                :PRICE_,'
      '110190642=                :VOLUME_PRICE_,'
      '110190643=                :IS_KIT_,'
      '110190644=                :IS_MARKED_,'
      '110190645=                :IS_WEIGHT_;'
      '110190646='
      '110190647=      IF (ROW_COUNT = 0) THEN BEGIN'
      '110190648=          ERR_CODE = -20500;'
      
        '110190649=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110190650=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110190651=          EXIT;'
      '110190652=      END'
      '110190653=    END'
      '110190654='
      
        '110190655=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) <> PREFIX_) T' +
        'HEN'
      
        '110190656=        SELECT CASE WHEN LT.AMOUNT < 1 AND LT.AMOUNT >' +
        ' 0 AND ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2' +
        ') = 0) THEN LT.AMOUNT ELSE 1 END'
      '110190657=          FROM LT_SKLAD_PRODUCT LT'
      '110190658=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      
        '110190659=           AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '110190660=          INTO :AMOUNT_;'
      '110190661=END'
      '110190662=;'
      '110190663='
      '110190664=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '110190665=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110190666=  ARTICUL_ VARCHAR(30),'
      '110190667=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110190668=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110190669=  NAME_ VARCHAR(500),'
      '110190670=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110190671=  PRICE_ NUMERIC(15,2),'
      '110190672=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110190673=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110190674=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110190675=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110190676=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110190677=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110190678=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110190679=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110190680=  IS_CATEGORY_ INTEGER,'
      '110190681=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110190682=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110190683=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110190684=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110190685=  IS_MARKED_ INTEGER,'
      '110190686=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110190687=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      
        '110190688=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110190689=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110190690=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110190691=RETURNS ('
      '110190692=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110190693=  ERR_CODE INTEGER,'
      '110190694=  ERR_MSG VARCHAR(1024))'
      '110190695=AS'
      
        '110190696=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODU' +
        'CT'#39';'
      
        '110190697=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110190698=begin'
      
        '110190699=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110190700=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '110190701=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110190702=                      FROM G_PRODUCT G'
      
        '110190703=                     WHERE UPPER(G.ARTICUL) = UPPER(TR' +
        'IM(:ARTICUL_))'
      '110190704=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '110190705=                       AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '110190706=          ERR_CODE = -20500;'
      
        '110190707=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '110190708=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110190709=          EXIT;'
      '110190710=        END'
      '110190711=    end'
      '110190712='
      
        '110190713=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      '110190714=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '110190715=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then' +
        ' begin'
      '110190716=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110190717=                     FROM G_PRODUCT G'
      
        '110190718=                    WHERE UPPER(G.NOMENCLATUR_NUM) = U' +
        'PPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '110190719=                      AND TRIM(G.NOMENCLATUR_NUM) <> '#39 +
        #39
      '110190720=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110190721=          ERR_CODE = -20500;'
      
        '110190722=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '110190723=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110190724=          EXIT;'
      '110190725=        END'
      '110190726=    end*/'
      '110190727='
      '110190728=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110190729=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110190730=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '110190731=                      FROM G_PRODUCT G'
      
        '110190732=                     WHERE UPPER(G.BARCODE) = UPPER(TR' +
        'IM(:BARCODE_))'
      '110190733=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '110190734=                       AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '110190735=          ERR_CODE = -20500;'
      
        '110190736=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110190737=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110190738=          EXIT;'
      '110190739=        END'
      '110190740='
      '110190741=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '110190742=                     FROM G_PRODUCT G, LT_BARCODE L'
      '110190743=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110190744=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '110190745=                      AND TRIM(L.BARCODE) <> '#39#39
      '110190746=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110190747=          ERR_CODE = -20500;'
      
        '110190748=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110190749=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110190750=          EXIT;'
      '110190751=        END'
      '110190752=    end'
      '110190753='
      
        '110190754=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PR' +
        'ICE,'
      
        '110190755=                           IS_CATEGORY, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COM' +
        'M, KOD_TNVD,'
      
        '110190756=                           FAST_TOVAR, DO_NOT_CHARGE_B' +
        'ONUS, IS_MARKED, BRAND, IS_WEIGHT)'
      
        '110190757=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRI' +
        'CE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '110190758=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROS' +
        'SCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNVD' +
        '_,'
      
        '110190759=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_M' +
        'ARKED_, :BRAND_, :IS_WEIGHT_)'
      '110190760=    RETURNING G_PRODUCT'
      '110190761=    INTO :G_PRODUCT_;'
      '110190762='
      '110190763=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '110190764=    if (:IS_CATEGORY_ = 0) then begin'
      
        '110190765=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110190766=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '110190767='
      '110190768=        INSERT INTO LT_BARCODE'
      
        '110190769=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110190770='
      
        '110190771=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090 +
        #1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '110190772=        INSERT into G_PRODUCT_IMAGE'
      
        '110190773=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYP' +
        'E from G_PRODUCT_IMAGE_TMP;'
      '110190774='
      
        '110190775=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089 +
        #1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '110190776=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091 +
        #1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '110190777=        IF (is_kit_ > 0) THEN begin'
      '110190778=            INSERT INTO G_PRODUCT_KIT'
      
        '110190779=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP;'
      '110190780='
      '110190781=            if (is_kit_ = 1) then begin'
      
        '110190782=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110190783=                  FROM G_PRODUCT_KIT K,'
      '110190784=                       LT_SKLAD_PRODUCT L'
      '110190785=                 WHERE K.g_product = :G_PRODUCT_'
      '110190786=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110190787=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110190788=                 GROUP BY K.G_PRODUCT'
      '110190789=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110190790='
      '110190791=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110190792=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_' +
        'SOSTAV_AMOUNT_, 0)'
      '110190793=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110190794=            end'
      '110190795=        END'
      '110190796=    END'
      '110190797='
      '110190798=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110190799=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_P' +
        'RODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '110190800='
      '110190801=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110190802=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110190803=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110190804=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 1);'
      '110190805=end'
      '110190806=;'
      '110190807='
      '110190808=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110190809=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110190810=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110190811=  ARTICUL_ VARCHAR(30),'
      '110190812=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110190813=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110190814=  NAME_ VARCHAR(500),'
      '110190815=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110190816=  PRICE_ NUMERIC(15,2),'
      '110190817=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110190818=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110190819=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110190820=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110190821=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110190822=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110190823=  IS_CATEGORY_ INTEGER,'
      '110190824=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110190825=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110190826=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110190827=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110190828=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110190829=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110190830=  IS_MARKED_ INTEGER,'
      '110190831=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110190832=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      
        '110190833=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110190834=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110190835=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110190836=RETURNS ('
      '110190837=  ERR_CODE INTEGER,'
      '110190838=  ERR_MSG VARCHAR(1024))'
      '110190839=AS'
      
        '110190840=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODU' +
        'CT'#39';'
      
        '110190841=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110190842=begin'
      
        '110190843=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110190844=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '110190845=                  FROM G_PRODUCT G'
      
        '110190846=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:' +
        'ARTICUL_))'
      '110190847=                   AND TRIM(G.ARTICUL) <> '#39#39
      '110190848=                   AND TRIM(:ARTICUL_) <> '#39#39
      '110190849=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110190850=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110190851=      ERR_CODE = -20500;'
      
        '110190852=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      '110190853=      EXIT;'
      '110190854=    END'
      '110190855='
      
        '110190856=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      '110190857=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110190858=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110190859=                  FROM G_PRODUCT G'
      
        '110190860=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPPE' +
        'R(TRIM(:NOMENCLATUR_NUM_))'
      '110190861=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110190862=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '110190863=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110190864=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110190865=      ERR_CODE = -20500;'
      
        '110190866=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110190867=      EXIT;'
      '110190868=    END'
      '110190869=    */'
      '110190870='
      '110190871=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110190872=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110190873=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110190874=                  FROM G_PRODUCT G'
      
        '110190875=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(:' +
        'BARCODE_))'
      '110190876=                   AND TRIM(G.BARCODE) <> '#39#39
      '110190877=                   AND TRIM(:BARCODE_) <> '#39#39
      '110190878=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110190879=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110190880=          ERR_CODE = -20500;'
      
        '110190881=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110190882=          EXIT;'
      '110190883=        END'
      '110190884='
      '110190885=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '110190886=                    FROM G_PRODUCT G, LT_BARCODE L'
      '110190887=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110190888=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '110190889=                     AND TRIM(L.BARCODE) <> '#39#39
      '110190890=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110190891=          ERR_CODE = -20500;'
      
        '110190892=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110190893=          EXIT;'
      '110190894=        END'
      '110190895=    END'
      '110190896='
      '110190897=    update G_PRODUCT'
      '110190898=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110190899=        ARTICUL = :ARTICUL_,'
      '110190900=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110190901=        BARCODE = :BARCODE_,'
      '110190902=        NAME = :NAME_,'
      '110190903=        G_UNIT = :G_UNIT_,'
      '110190904=        PRICE = :PRICE_,'
      '110190905=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110190906=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110190907=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110190908=        NOTE         = :NOTE_,'
      '110190909=        CROSSCODE    = :CROSSCODE_,'
      '110190910=        IS_KIT       = :IS_KIT_,'
      '110190911=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110190912=        PLACE        = :PLACE_,'
      '110190913=        SALES_COMM   = :SALES_COMM_,'
      '110190914=        KOD_TNVD     = :KOD_TNVD_,'
      '110190915=        FAST_TOVAR   = :FAST_TOVAR_,'
      '110190916=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '110190917=        IS_MARKED    = :IS_MARKED_,'
      '110190918=        BRAND        = :BRAND_,'
      '110190919=        IS_WEIGHT    = :IS_WEIGHT_'
      '110190920=    where (G_PRODUCT = :G_PRODUCT_);'
      '110190921='
      '110190922=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110190923=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110190924='
      '110190925=        INSERT INTO LT_BARCODE'
      
        '110190926=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110190927='
      '110190928=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110190929=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110190930=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110190931='
      
        '110190932=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110190933=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110190934='
      '110190935=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110190936=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110190937=            /*INSERT INTO G_PRODUCT_KIT'
      
        '110190938=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110190939=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110190940=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110190941=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110190942='
      
        '110190943=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110190944=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110190945='
      '110190946=            UPDATE G_PRODUCT_KIT G'
      
        '110190947=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110190948=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110190949=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110190950=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110190951='
      
        '110190952=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' '#1074 +
        #1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '110190953=            */'
      
        '110190954=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PROD' +
        'UCT = :G_PRODUCT_;'
      '110190955=            INSERT INTO G_PRODUCT_KIT'
      
        '110190956=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '110190957=            FROM G_PRODUCT_KIT_TMP T;'
      '110190958='
      
        '110190959=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110190960=            if (is_kit_ = 1) then begin'
      
        '110190961=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110190962=                  FROM G_PRODUCT_KIT K,'
      '110190963=                       LT_SKLAD_PRODUCT L'
      '110190964=                 WHERE K.g_product = :G_PRODUCT_'
      '110190965=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110190966=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110190967=                 GROUP BY K.G_PRODUCT'
      '110190968=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110190969='
      '110190970=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110190971=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110190972=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110190973=            end'
      '110190974=        END'
      '110190975=    END'
      '110190976='
      '110190977=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110190978=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_P' +
        'RODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '110190979='
      
        '110190980=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110190981=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110190982=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110190983=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PROD' +
        'UCT_, 2'
      '110190984=          FROM RDB$DATABASE'
      
        '110190985=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP ' +
        'AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_LO' +
        'ADING = 0);'
      '110190986=end'
      '110190987=;'
      '110190988='
      '110190989=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '110190990=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110190991=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110190992=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT =' +
        ' 0,'
      
        '110190993=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE = 0)'
      '110190994=RETURNS ('
      '110190995=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110190996=  ERR_CODE INTEGER,'
      '110190997=  ERR_MSG VARCHAR(1024))'
      '110190998=AS'
      '110190999=/*'
      '1101901000='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '1101901001=*/'
      
        '1101901002=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_T' +
        'MP'#39';'
      '1101901003=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101901004=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '1101901005=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      '1101901006=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '1101901007=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT' +
        '.PRICE;'
      
        '1101901008=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODU' +
        'CT.VOLUME_PRICE;'
      '1101901009=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '1101901010=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '1101901011=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101901012=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      
        '1101901013=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101901014=DECLARE VARIABLE IS_MARKED_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_MARKED;'
      
        '1101901015=DECLARE VARIABLE IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_WEIGHT;'
      '1101901016=BEGIN'
      '1101901017='
      '1101901018=  PNT_ = '#39'01'#39';'
      
        '1101901019=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCO' +
        'DE_, NULL, NULL, NULL, NULL)'
      
        '1101901020=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGO' +
        'RY_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :IS_MARKE' +
        'D_, :IS_WEIGHT_, :ERR_CODE, :ERR_MSG;'
      '1101901021='
      '1101901022=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101901023=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101901024=    EXIT;'
      '1101901025=  END'
      '1101901026='
      '1101901027=  PNT_ = '#39'02'#39';'
      '1101901028=  IF (IS_VOZVRAT_ = 0) THEN BEGIN'
      
        '1101901029=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, :G_TOCHKA_, 0)'
      '1101901030=          RETURNING_VALUES :PRICE_;'
      '1101901031='
      '1101901032=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101901033=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101901034=        EXIT;'
      '1101901035=      END'
      '1101901036=  END ELSE'
      '1101901037=    PRICE_ = SALE_PRICE_;'
      '1101901038='
      '1101901039=  AMOUNT_ = 1;'
      '1101901040='
      '1101901041=  SELECT T.SKLAD'
      '1101901042=    FROM SKLAD_TMP T'
      '1101901043=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101901044=     AND T.PRICE = :PRICE_'
      '1101901045=    INTO :SKLAD_;'
      '1101901046='
      '1101901047=  IF (SKLAD_ IS NOT NULL) THEN'
      '1101901048=    UPDATE SKLAD_TMP T'
      '1101901049=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1101901050=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1101901051=     WHERE T.SKLAD = :SKLAD_;'
      '1101901052='
      '1101901053=  ELSE'
      
        '1101901054=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PR' +
        'ICE_OPT, CHANGE_SALE_PRICE)'
      
        '1101901055=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_,'
      
        '1101901056=             DECODE(:PRICE_, 0, 0, ROUND((:SALE_PRICE' +
        '_/:PRICE_ - 1)*100, 2)),'
      '1101901057=             :SALE_PRICE_,'
      
        '1101901058=             DECODE(:PRICE_, 0, 0, ROUND((:VOLUME_PRI' +
        'CE_/:PRICE_ - 1)*100, 2)),'
      '1101901059=             :VOLUME_PRICE_,'
      '1101901060=             :CHANGE_SALE_PRICE_)'
      '1101901061=      RETURNING SKLAD'
      '1101901062=      INTO :SKLAD_;'
      '1101901063=end'
      '1101901064=;'
      '1101901065='
      '1101901066=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '1101901067=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT,'
      '1101901068=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101901069=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101901070=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1101901071=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1101901072=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1101901073=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1101901074=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101901075=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101901076=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ','
      '1101901077=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1101901078=  IS_SPISANIE_ INTEGER,'
      '1101901079=  NEW_LINE_SALE_ INTEGER = 0,'
      '1101901080=  MODE_ INTEGER = 0,'
      '1101901081=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '1101901082=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '1101901083=  MARK_CODE_ VARCHAR(100) = '#39#39')'
      '1101901084=RETURNS ('
      
        '1101901085=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1101901086=  ERR_CODE INTEGER,'
      '1101901087=  ERR_MSG VARCHAR(1024))'
      '1101901088=AS'
      '1101901089=/*'
      
        '1101901090=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063 +
        #1048#1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '1101901091=*/'
      
        '1101901092=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39';'
      '1101901093=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '1101901094=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0;'
      
        '1101901095=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0;'
      
        '1101901096=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1101901097=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1101901098=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '1101901099=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      
        '1101901100=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.PRICE;'
      
        '1101901101=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.COST_PRICE;'
      
        '1101901102=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '1101901103=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101901104=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040 +
        #1041#1051#1048#1062#1045' */'
      
        '1101901105=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058 +
        ' '#1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '1101901106=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101901107=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '1101901108=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '1101901109=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUM' +
        'N G_PRODUCT.G_PRODUCT;'
      '1101901110=BEGIN'
      '1101901111=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '1101901112='
      
        '1101901113=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071 +
        #1070#1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '1101901114=  SELECT T.ZAKAZ, T.Z_TYPE'
      '1101901115=    FROM ZAKAZ_DETAILS_TMP T'
      '1101901116=   WHERE T.ZAKAZ IS NOT NULL'
      
        '1101901117=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' ' +
        #1089#1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082 +
        #1072' MULTIPLE ROWS IN SINGLETON SELECT'
      '1101901118=    INTO :ZAKAZ_, :Z_TYPE_;'
      '1101901119='
      
        '1101901120=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045 +
        #1051#1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101901121=           ,G.IS_KIT'
      '1101901122=           ,K.AMOUNT * :AMOUNT_'
      '1101901123=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '1101901124=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PR' +
        'ICE)'
      '1101901125=           ,(CASE'
      
        '1101901126=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANI' +
        'E_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT *' +
        ' FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '1101901127=             ELSE K.PRICE'
      '1101901128=           END) COST_PRICE'
      
        '1101901129=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_' +
        'LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '1101901130=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE' +
        ' G_PRODUCT = :G_PRODUCT_) CNT'
      
        '1101901131=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT ' +
        'K ON G.G_PRODUCT = K.G_PRODUCT'
      '1101901132=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101901133=       AND G.IS_KIT = 1'
      '1101901134=    UNION'
      
        '1101901135=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056 +
        #1054#1044#1040#1046
      '1101901136=           ,G.IS_KIT'
      '1101901137=           ,:AMOUNT_'
      '1101901138=           ,:PRICE_'
      '1101901139=           ,0'
      '1101901140=           ,:COST_PRICE_'
      '1101901141=           ,0'
      '1101901142=      FROM G_PRODUCT G'
      '1101901143=     WHERE G_PRODUCT = :G_PRODUCT_'
      '1101901144=       AND G.IS_KIT <> 1'
      '1101901145=      INTO :G_PRODUCT_'
      '1101901146=           ,:IS_KIT_'
      '1101901147=           ,:AMOUNT_'
      '1101901148=           ,:PRICE__'
      '1101901149=           ,:SOSTAV_PRICE_'
      '1101901150=           ,:COST_PRICE__'
      '1101901151=           ,:SOSTAV_COUNT_'
      '1101901152=  DO BEGIN'
      '1101901153=      ZAKAZ_DTLS_TMP_ = NULL;'
      '1101901154='
      
        '1101901155=      --=============================================' +
        '=============='
      '1101901156=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101901157=      SELECT AMOUNT - AMOUNT_RESERVE'
      '1101901158=        FROM LT_SKLAD_PRODUCT L'
      '1101901159=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '1101901160=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101901161=       INTO :AMOUNT_CUR_;'
      '1101901162='
      
        '1101901163=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1101901164=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1101901165=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1101901166=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1101901167=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101901168=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '1101901169=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1101901170=          SELECT SUM(AMOUNT)'
      '1101901171=            FROM ZAKAZ_DETAILS T'
      '1101901172=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101901173=             AND T.ZAKAZ = :ZAKAZ_'
      '1101901174=            INTO :AMOUNT_OLD_;'
      '1101901175=        ELSE'
      '1101901176=          SELECT SUM(AMOUNT)'
      '1101901177=            FROM SKLAD T'
      '1101901178=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101901179=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1101901180=            INTO :AMOUNT_OLD_;'
      '1101901181=      END'
      '1101901182='
      '1101901183=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1101901184=      SELECT SUM(AMOUNT)'
      '1101901185=        FROM ZAKAZ_DETAILS_TMP T'
      '1101901186=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101901187=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1101901188='
      
        '1101901189=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_,' +
        ' 0) + :AMOUNT_;'
      '1101901190=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '1101901191='
      
        '1101901192=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042 +
        ' '#1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1101901193='
      
        '1101901194=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1101901195=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047 +
        #1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1101901196=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) ' +
        'THEN BEGIN'
      '1101901197=            PNT_ = '#39'01'#39';'
      
        '1101901198=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID F' +
        'ROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101901199=                                         CURRENT_DATE' +
        ','
      '1101901200=                                         :G_PRODUCT_,'
      
        '1101901201=                                         ABS(AMOUNT_C' +
        'UR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOU' +
        'NT_,'
      
        '1101901202=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074 +
        #1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1101901203=                                         )'
      
        '1101901204=                RETURNING_VALUES :SKLAD_, :COST_PRICE' +
        '__, :ERR_CODE, :ERR_MSG;'
      '1101901205=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101901206=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101901207=              EXIT;'
      '1101901208=            END'
      '1101901209=        END'
      
        '1101901210=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_P' +
        'RODUCT_ <> -2) THEN BEGIN'
      '1101901211=            SELECT NAME'
      '1101901212=            FROM G_PRODUCT'
      '1101901213=            WHERE G_PRODUCT = :G_PRODUCT_'
      '1101901214=            INTO :PRODUCT_NAME_;'
      '1101901215='
      '1101901216=            ERR_CODE = -20500;'
      
        '1101901217=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_' +
        'NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1101901218=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1101901219=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1101901220=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1101901221=            EXIT;'
      '1101901222=        END'
      '1101901223=      END'
      '1101901224=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101901225=      --=============================================' +
        '=============='
      '1101901226='
      
        '1101901227=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077 +
        #1090#1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087 +
        #1083#1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '1101901228=      IF (IS_KIT_ = 1) THEN BEGIN'
      '1101901229='
      '1101901230=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '1101901231=        --    PRICE__ = SOSTAV_PRICE_;'
      '1101901232=        --END ELSE BEGIN'
      '1101901233=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '1101901234=              PRICE__ = COST_PRICE__;'
      '1101901235='
      
        '1101901236=            END ELSE IF (Discount_perc_ <> 0) THEN BE' +
        'GIN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '1101901237=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PE' +
        'RC_/100;'
      '1101901238='
      '1101901239='
      
        '1101901240=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THE' +
        'N BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '1101901241=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / S' +
        'OSTAV_PRICE_;'
      
        '1101901242=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE' +
        '_;'
      '1101901243=            END'
      '1101901244='
      
        '1101901245=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUN' +
        'T_;'
      
        '1101901246=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMO' +
        'UNT_;'
      '1101901247=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '1101901248=        --END'
      '1101901249=      END'
      '1101901250='
      
        '1101901251=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' ' +
        #1045#1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '1101901252=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041 +
        #1048#1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '1101901253=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_COD' +
        'E_) = 0) THEN'
      '1101901254=          SELECT ZD.zakaz_details'
      '1101901255=            FROM zakaz_details_tmp ZD'
      '1101901256=           WHERE ZD.G_PRODUCT = :g_product_'
      '1101901257=             AND ZD.PRICE = :PRICE__'
      '1101901258=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '1101901259=            INTO :ZAKAZ_DTLS_TMP_;'
      '1101901260='
      '1101901261='
      '1101901262=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN BEGIN'
      '1101901263=        UPDATE ZAKAZ_DETAILS_TMP P'
      '1101901264=           SET P.amount = P.amount + :amount_'
      
        '1101901265=               ,P.summ = (P.price - P.discount_TENGE)' +
        ' * (P.amount + :AMOUNT_)'
      
        '1101901266=               ,P.discount_summ = P.discount_TENGE * ' +
        '(P.amount + :AMOUNT_)'
      '1101901267=               ,P.NDS = :NDS_'
      '1101901268=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '1101901269=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '1101901270=        ZAKAZ_DETAILS_ = :ZAKAZ_DTLS_TMP_;'
      '1101901271='
      '1101901272=      END ELSE BEGIN'
      
        '1101901273=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN' +
        ' BEGIN'
      
        '1101901274=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_' +
        ';'
      '1101901275=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '1101901276=          END'
      '1101901277='
      '1101901278=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '1101901279=          ('
      '1101901280=           ZAKAZ_DETAILS,'
      '1101901281=           ZAKAZ,'
      '1101901282=           G_PRODUCT,'
      '1101901283=           AMOUNT,'
      '1101901284=           PRICE,'
      '1101901285=           SUMM,'
      '1101901286=           DISCOUNT_PERC,'
      '1101901287=           DISCOUNT_TENGE,'
      '1101901288=           DISCOUNT_SUMM,'
      '1101901289=           NDS,'
      '1101901290=           NDS_SUMM,'
      '1101901291=           COST_PRICE,'
      '1101901292=           MARK_CODE,'
      '1101901293=           ORIGINAL_KIT_ID,'
      '1101901294=           ORIGINAL_KIT_PRICE'
      '1101901295=          ) VALUES ('
      '1101901296=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101901297=           :ZAKAZ_,'
      '1101901298=           :G_PRODUCT_,'
      '1101901299=           :AMOUNT_,'
      '1101901300=           :PRICE__,'
      '1101901301=           :SUMM_,'
      '1101901302=           :DISCOUNT_PERC_,'
      '1101901303=           :DISCOUNT_TENGE_,'
      '1101901304=           :DISCOUNT_SUMM_,'
      '1101901305=           :NDS_,'
      '1101901306=           :NDS_SUMM_,'
      '1101901307=           :COST_PRICE__,'
      '1101901308=           :MARK_CODE_,'
      '1101901309=           :ORIGINAL_KIT_ID_,'
      '1101901310=           :ORIGINAL_KIT_PRICE_'
      '1101901311=          )'
      '1101901312=          RETURNING'
      '1101901313=            ZAKAZ_DETAILS'
      '1101901314=          INTO'
      '1101901315=            :ZAKAZ_DETAILS_;'
      '1101901316=      END'
      '1101901317=  END'
      '1101901318=end'
      '1101901319=;'
      '1101901320='
      '1101901321=ALTER PROCEDURE P_REP_PROFIT('
      '1101901322=  DATE_BEGIN_ DATE,'
      '1101901323=  DATE_END_ DATE,'
      '1101901324=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101901325=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      '1101901326=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1101901327=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '1101901328=RETURNS ('
      '1101901329=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101901330=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '1101901331=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SU' +
        'MM,'
      '1101901332=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1101901333=  SUMM_ALL_ NUMERIC(15,2),'
      '1101901334=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1101901335=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1101901336=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1101901337=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1101901338=  PROFIT_ALL_ NUMERIC(15,2),'
      '1101901339=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1101901340=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABL' +
        'E.P_REP_PROFIT_TABLE,'
      '1101901341=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      
        '1101901342=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA' +
        ','
      '1101901343=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      
        '1101901344=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT' +
        ','
      
        '1101901345=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIEN' +
        'T_NAME,'
      
        '1101901346=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_' +
        'PAYMENT_TYPE,'
      
        '1101901347=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYM' +
        'ENT_NAME,'
      
        '1101901348=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVAN' +
        'IE,'
      
        '1101901349=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODU' +
        'CT,'
      
        '1101901350=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_P' +
        'RODUCT_PAR,'
      
        '1101901351=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_' +
        'NAME,'
      '1101901352=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101901353=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101901354=  AMOUNT MY_NUMERIC_5,'
      '1101901355=  PRICE NUMERIC(15,2),'
      '1101901356=  SUMM NUMERIC(15,2),'
      '1101901357=  DISCOUNT_PERC NUMERIC(15,2),'
      '1101901358=  DISCOUNT_SUMM NUMERIC(15,2),'
      '1101901359=  NDS NUMERIC(15,2),'
      '1101901360=  NDS_SUMM NUMERIC(15,2),'
      '1101901361=  PRICE_SELF NUMERIC(15,2),'
      '1101901362=  SUM_SELF NUMERIC(15,2),'
      '1101901363=  PROFIT NUMERIC(15,2),'
      '1101901364=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1101901365=  ERR_CODE INTEGER,'
      '1101901366=  ERR_MSG VARCHAR(1024))'
      '1101901367=AS'
      '1101901368=/*'
      '1101901369='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1101901370='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1101901371='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1101901372='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1101901373='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1101901374='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1101901375='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1101901376=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1101901377=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1101901378=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1101901379='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1101901380='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1101901381=*'
      '1101901382=*/'
      
        '1101901383=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT' +
        #39';'
      '1101901384=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101901385=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1101901386=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1101901387=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1101901388=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1101901389=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1101901390=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '1101901391=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '1101901392=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '1101901393=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '1101901394=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1101901395=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '1101901396=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      
        '1101901397=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKA' +
        'Z;'
      
        '1101901398=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G' +
        '_TOCHKA;'
      
        '1101901399=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_D' +
        'ATE;'
      
        '1101901400=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G' +
        '_CLIENT;'
      
        '1101901401=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CL' +
        'IENT.NAME;'
      
        '1101901402=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE;'
      
        '1101901403=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.NAME;'
      
        '1101901404=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.' +
        'OSNOVANIE;'
      
        '1101901405=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101901406=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      
        '1101901407=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1101901408=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1101901409=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.PRICE;'
      
        '1101901410=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM;'
      
        '1101901411=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_PERC;'
      
        '1101901412=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM;'
      
        '1101901413=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS;'
      
        '1101901414=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.NDS_SUMM;'
      
        '1101901415=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD' +
        '.PRICE;'
      
        '1101901416=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.S' +
        'UMM;'
      '1101901417=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '1101901418=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '1101901419=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD' +
        '_RASHOD.NAME;'
      '1101901420=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1101901421=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD' +
        '.DATE_RECEIPT;'
      
        '1101901422=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_' +
        'PRODUCT;'
      
        '1101901423=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '1101901424=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUN' +
        'T;'
      '1101901425=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101901426=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1101901427=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059 +
        #1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1101901428=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /' +
        '* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1101901429=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0' +
        '; /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '1101901430=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1101901431=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '1101901432=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKL' +
        'AD_PARENT.SUMM_FACT;'
      
        '1101901433=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN ' +
        'SKLAD_PARENT.SUMM_FACT;'
      '1101901434=BEGIN'
      
        '1101901435=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_T' +
        'ABLE = P_REP_PROFIT_TABLE;'
      '1101901436=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101901437='
      '1101901438=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '1101901439=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '1101901440=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '1101901441='
      '1101901442=  FOR SELECT GP.PATH,'
      '1101901443=             GP.G_PRODUCT'
      '1101901444=       FROM P_REP_TREE GP'
      '1101901445=      WHERE EXISTS (SELECT 1'
      
        '1101901446=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD,' +
        ' G_PRODUCT G'
      
        '1101901447=                     WHERE :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1101901448=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101901449=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101901450=                       AND G.G_PRODUCT_PAR = GP.G_PRO' +
        'DUCT'
      '1101901451=                       AND Z.IS_SPISANIE = 0'
      '1101901452=                       AND Z.is_reserve = 0'
      '1101901453=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101901454=                       AND Z.Z_DATE BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      
        '1101901455=                       AND COALESCE(Z.G_CLIENT, 0) = ' +
        'COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054 +
        #1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101901456=                       AND COALESCE(Z.G_PAYMENT_TYPE,' +
        ' 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101901457=                       AND ((EXISTS (SELECT 1'
      
        '1101901458=                                       FROM SKLAD S, ' +
        'G_PRODUCT G'
      
        '1101901459=                                      WHERE S.G_CLIEN' +
        'T = :G_SUPPLIER_'
      
        '1101901460=                                        AND S.G_PRODU' +
        'CT = G.G_PRODUCT'
      
        '1101901461=                                        AND G.G_PRODU' +
        'CT_PAR = GP.G_PRODUCT'
      
        '1101901462=                                        AND :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_' +
        ', 0) <> 0)'
      '1101901463=                              OR'
      
        '1101901464=                              COALESCE(:G_SUPPLIER_, ' +
        '0) = 0)'
      '1101901465=                       )'
      '1101901466=      ORDER BY 1, 2'
      '1101901467=  INTO :RECCAT_NAME_,'
      '1101901468=       :RECCAT_PRODUCT_'
      '1101901469=  DO BEGIN'
      '1101901470=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901471=    insert into p_rep_profit_table'
      '1101901472=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101901473=    values'
      
        '1101901474=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAM' +
        'E_, 1);'
      '1101901475='
      '1101901476=    FOR SELECT Z.ZAKAZ,'
      '1101901477=               Z.G_TOCHKA,'
      '1101901478=               Z.Z_DATE,'
      '1101901479=               Z.G_CLIENT,'
      '1101901480=               C.NAME CLIENT_NAME,'
      '1101901481=               Z.G_PAYMENT_TYPE,'
      '1101901482=               P.NAME PAYMENT_NAME,'
      '1101901483=               Z.OSNOVANIE,'
      '1101901484=               G.G_PRODUCT,'
      '1101901485=               G.G_PRODUCT_PAR,'
      '1101901486=               G.NAME TOVAR_NAME,'
      '1101901487=               ZD.AMOUNT,'
      '1101901488=               ZD.PRICE,'
      '1101901489=               ZD.SUMM,'
      '1101901490=               ZD.DISCOUNT_PERC,'
      '1101901491=               ZD.DISCOUNT_SUMM,'
      '1101901492=               ZD.NDS,'
      '1101901493=               ZD.NDS_SUMM,'
      '1101901494=               COALESCE(ZD.COST_PRICE, 0)'
      
        '1101901495=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON ' +
        'Z.G_CLIENT = C.G_CLIENT,'
      '1101901496=               ZAKAZ_DETAILS ZD,'
      '1101901497=               G_PRODUCT G,'
      '1101901498=               G_PAYMENT_TYPE P'
      
        '1101901499=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1101901500=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101901501=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101901502=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '1101901503=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1101901504=           AND Z.IS_SPISANIE = 0                   --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '1101901505=           AND Z.IS_RESERVE = 0                    --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '1101901506=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101901507=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101901508=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '1101901509=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101901510=           AND ((EXISTS (SELECT 1'
      '1101901511=                       FROM SKLAD S'
      '1101901512=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '1101901513=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1101901514=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101901515=              OR'
      '1101901516=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1101901517=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ' +
        'ZD.ZAKAZ_DETAILS, G.NAME'
      '1101901518=    INTO :REC_ZAKAZ_,'
      '1101901519=        :REC_G_TOCHKA_,'
      '1101901520=        :REC_Z_DATE_,'
      '1101901521=        :REC_G_CLIENT_,'
      '1101901522=        :REC_CLIENT_NAME_,'
      '1101901523=        :REC_G_PAYMENT_TYPE_,'
      '1101901524=        :REC_PAYMENT_NAME_,'
      '1101901525=        :REC_OSNOVANIE_,'
      '1101901526=        :REC_G_PRODUCT_,'
      '1101901527=        :REC_G_PRODUCT_PAR_,'
      '1101901528=        :REC_TOVAR_NAME_,'
      '1101901529=        :REC_AMOUNT_,'
      '1101901530=        :REC_PRICE_,'
      '1101901531=        :REC_SUMM_,'
      '1101901532=        :REC_DISCOUNT_PERC_,'
      '1101901533=        :REC_DISCOUNT_SUMM_,'
      '1101901534=        :REC_NDS_,'
      '1101901535=        :REC_NDS_SUMM_,'
      '1101901536=        :REC_PRICE_SELF_'
      '1101901537=    DO BEGIN'
      '1101901538=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '1101901539=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_' +
        'SUM_COST_;'
      '1101901540='
      '1101901541=      insert into p_rep_profit_table'
      
        '1101901542=        (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '1101901543=         osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '1101901544=         nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '1101901545=      values'
      '1101901546=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1101901547=        :REC_ZAKAZ_,'
      '1101901548=        :REC_g_tochka_,'
      
        '1101901549=        :REC_z_date_, :REC_g_client_, :REC_client_nam' +
        'e_, :REC_g_payment_type_, :REC_payment_name_,'
      '1101901550=         :REC_osnovanie_,'
      '1101901551=         :REC_g_product_,'
      '1101901552=         :REC_g_product_par_,'
      '1101901553=         :REC_tovar_name_,'
      '1101901554=         :REC_amount_,'
      '1101901555=         :REC_price_,'
      '1101901556=         :REC_summ_,'
      '1101901557=         :REC_discount_perc_,'
      '1101901558=         :REC_discount_summ_,'
      
        '1101901559=         :REC_nds_, :REC_nds_summ_, :REC_price_self_,' +
        ' :REC_SUM_COST_, :REC_profit_, 0);'
      '1101901560='
      
        '1101901561=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0' +
        ');'
      
        '1101901562=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_' +
        ', 0);'
      
        '1101901563=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1101901564=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0)' +
        ';'
      '1101901565=    END'
      '1101901566='
      '1101901567=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901568=    insert into p_rep_profit_table'
      
        '1101901569=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101901570=    values'
      
        '1101901571=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1101901572='
      '1101901573=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101901574=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1101901575=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101901576=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101901577='
      '1101901578=    SUM_ZAKAZ_ = 0;'
      '1101901579=    SUM_COST_  = 0;'
      '1101901580=    NDS_SUMM_  = 0;'
      '1101901581=    PROFIT_    = 0;'
      '1101901582=  END'
      '1101901583='
      '1101901584=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1101901585=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1101901586=      insert into p_rep_profit_table'
      
        '1101901587=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101901588=      values'
      
        '1101901589=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1101901590='
      
        '1101901591=  --*************************************************' +
        '****************************************'
      '1101901592=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1101901593=  ---------------------------------------------------' +
        '----'
      '1101901594=  SELECT COUNT(*)'
      
        '1101901595=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101901596=          UNION ALL'
      
        '1101901597=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUM' +
        'M NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BE' +
        'ZNAL) K,'
      '1101901598=         G_PRIHOD_RASHOD G'
      
        '1101901599=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39 +
        '-'#39
      '1101901600=    AND K.ACTION = 1'
      
        '1101901601=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1101901602=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101901603=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053 +
        #1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101901604=  INTO :CNT_;'
      '1101901605='
      '1101901606=  IF (CNT_ > 0) THEN BEGIN'
      '1101901607=    SUM_COST_  = 0;'
      '1101901608=    PROFIT_    = 0;'
      '1101901609='
      '1101901610=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901611=    INSERT INTO P_REP_PROFIT_TABLE'
      '1101901612=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101901613=    VALUES'
      
        '1101901614=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', ' +
        '1);'
      '1101901615='
      '1101901616=    FOR SELECT K.ACTION_DATE,'
      '1101901617=               K.SUMM,'
      
        '1101901618=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, ' +
        #39' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '1101901619=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZ' +
        'NAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '1101901620=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39
      '1101901621=              UNION ALL'
      
        '1101901622=              SELECT KASSA_BEZNAL kassa, ACTION_DATE,' +
        ' SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM ka' +
        'ssa_beznal'
      
        '1101901623=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39') k,'
      '1101901624=              G_PRIHOD_RASHOD G'
      '1101901625=        WHERE K.ACTION = 1'
      
        '1101901626=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1101901627=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101901628=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)  ' +
        '  -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101901629=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1101901630=    INTO :ACTION_DATE_,'
      '1101901631=         :SUMM_,'
      '1101901632=         :ACTION_NAME_'
      '1101901633=    DO BEGIN'
      '1101901634=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101901635=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1101901636=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1101901637=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1101901638=        VALUES'
      
        '1101901639=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, 0,'
      
        '1101901640=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALE' +
        'SCE(:SUMM_, 0), 0);'
      '1101901641='
      '1101901642=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1101901643=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1101901644=    END'
      '1101901645='
      '1101901646=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101901647=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101901648=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1101901649=    insert into p_rep_profit_table'
      
        '1101901650=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101901651=    values'
      
        '1101901652=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1101901653=  END'
      '1101901654=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1101901655=  --*************************************************' +
        '****************************************'
      '1101901656='
      
        '1101901657=  --*************************************************' +
        '****************************************'
      '1101901658=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101901659=  ---------------------------------------------------' +
        '----'
      '1101901660=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901661=  SELECT COUNT(*)'
      
        '1101901662=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101901663=          UNION ALL'
      
        '1101901664=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUM' +
        'M NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BE' +
        'ZNAL) K,'
      '1101901665=         G_PRIHOD_RASHOD G'
      
        '1101901666=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39 +
        '-'#39
      '1101901667=    AND K.ACTION = 0'
      
        '1101901668=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1101901669=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101901670=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056 +
        #1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101901671=  INTO :CNT_;'
      '1101901672='
      '1101901673=  IF (CNT_ > 0) THEN BEGIN'
      '1101901674=    PRIHOD_ALL_  = 0;'
      '1101901675=    PRIHOD_ALL_NAL_  = 0;'
      '1101901676=    PRIHOD_ALL_BEZNAL_  = 0;'
      '1101901677=    PROFIT_     = 0;'
      '1101901678='
      '1101901679=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901680=    INSERT INTO P_REP_PROFIT_TABLE'
      '1101901681=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101901682=    VALUES'
      
        '1101901683=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', ' +
        '1);'
      '1101901684='
      '1101901685=    FOR SELECT K.ACTION_DATE,'
      '1101901686=               K.NAL,'
      '1101901687=               K.BEZNAL,'
      '1101901688=               G.NAME'
      
        '1101901689=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0' +
        ' BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101901690=               UNION ALL'
      
        '1101901691=               SELECT kassa_BEZNAL KASSA, ACTION_DATE' +
        ', 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kas' +
        'sa_beznal) K,'
      '1101901692=              G_PRIHOD_RASHOD G'
      
        '1101901693=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCH' +
        'KA||'#39'-'#39
      '1101901694=          AND K.ACTION = 0'
      
        '1101901695=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1101901696=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101901697=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101901698=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1101901699=    INTO :ACTION_DATE_,'
      '1101901700=         :SUMM_NAL_,'
      '1101901701=         :SUMM_BEZNAL_,'
      '1101901702=         :ACTION_NAME_'
      '1101901703=    DO BEGIN'
      '1101901704=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101901705=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1101901706=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1101901707=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1101901708=        VALUES'
      
        '1101901709=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '1101901710=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNA' +
        'L_, 0);'
      '1101901711='
      
        '1101901712=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_' +
        ';'
      
        '1101901713=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUM' +
        'M_BEZNAL_;'
      
        '1101901714=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_' +
        'BEZNAL_;'
      
        '1101901715=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BE' +
        'ZNAL_;'
      '1101901716=    END'
      '1101901717='
      '1101901718=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1101901719=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101901720=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1101901721=    insert into p_rep_profit_table'
      
        '1101901722=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101901723=    values'
      
        '1101901724=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1101901725=  END'
      '1101901726='
      '1101901727=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1101901728=  --*************************************************' +
        '****************************************'
      '1101901729='
      
        '1101901730=  --*************************************************' +
        '****************************************'
      '1101901731=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101901732=  --*************************************************' +
        '****************************************'
      '1101901733=  SELECT COUNT(*)'
      '1101901734=    FROM ZAKAZ Z'
      
        '1101901735=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1101901736=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1101901737=     AND Z.IS_SPISANIE = 1'
      
        '1101901738=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1101901739=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101901740=  INTO :CNT_;'
      '1101901741='
      '1101901742=  IF (CNT_ > 0) THEN BEGIN'
      '1101901743=      SUM_ZAKAZ_ = 0;'
      '1101901744=      SUM_COST_  = 0;'
      '1101901745=      PROFIT_    = 0;'
      '1101901746='
      '1101901747=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901748=      insert into p_rep_profit_table'
      '1101901749=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101901750=      values'
      
        '1101901751=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1101901752='
      '1101901753=      FOR SELECT Z.ZAKAZ,'
      '1101901754=                 Z.G_TOCHKA,'
      '1101901755=                 Z.Z_DATE,'
      '1101901756=                 Z.G_CLIENT,'
      '1101901757=                 '#39#39' CLIENT_NAME,'
      '1101901758=                 Z.G_PAYMENT_TYPE,'
      '1101901759=                 '#39#39' PAYMENT_NAME,'
      '1101901760=                 Z.OSNOVANIE,'
      '1101901761=                 G.G_PRODUCT,'
      '1101901762=                 G.G_PRODUCT_PAR,'
      '1101901763=                 G.NAME TOVAR_NAME,'
      '1101901764=                 ZD.AMOUNT,'
      '1101901765=                 ZD.PRICE,'
      '1101901766=                 ZD.SUMM,'
      '1101901767=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '1101901768=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '1101901769=                 0 NDS, --ZD.NDS,'
      '1101901770=                 0 NDS_SUMM'
      
        '1101901771=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT' +
        ' G'
      
        '1101901772=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_T' +
        'OCHKA||'#39'-'#39
      '1101901773=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101901774=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101901775=             AND Z.IS_SPISANIE = 1                   ' +
        ' -- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '1101901776=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101901777=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '1101901778=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:' +
        'G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '1101901779=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COAL' +
        'ESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101901780=             AND ((EXISTS (SELECT 1'
      '1101901781=                           FROM SKLAD S'
      
        '1101901782=                          WHERE S.G_CLIENT = :G_SUPPL' +
        'IER_'
      
        '1101901783=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101901784=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101901785=                  OR'
      '1101901786=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1101901787=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKA' +
        'Z_DETAILS'
      '1101901788=      INTO :REC_ZAKAZ_,'
      '1101901789=            :REC_G_TOCHKA_,'
      '1101901790=            :REC_Z_DATE_,'
      '1101901791=            :REC_G_CLIENT_,'
      '1101901792=            :REC_CLIENT_NAME_,'
      '1101901793=            :REC_G_PAYMENT_TYPE_,'
      '1101901794=            :REC_PAYMENT_NAME_,'
      '1101901795=            :REC_OSNOVANIE_,'
      '1101901796=            :REC_G_PRODUCT_,'
      '1101901797=            :REC_G_PRODUCT_PAR_,'
      '1101901798=            :REC_TOVAR_NAME_,'
      '1101901799=            :REC_AMOUNT_,'
      '1101901800=            :REC_PRICE_,'
      '1101901801=            :REC_SUMM_,'
      '1101901802=            :REC_DISCOUNT_PERC_,'
      '1101901803=            :REC_DISCOUNT_SUMM_,'
      '1101901804=            :REC_NDS_,'
      '1101901805=            :REC_NDS_SUMM_'
      '1101901806=      DO BEGIN'
      '1101901807=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1101901808=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053 +
        #1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '1101901809=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '1101901810=        REC_profit_   = -REC_SUMM_;'
      '1101901811='
      '1101901812=        insert into p_rep_profit_table'
      
        '1101901813=          (p_rep_profit_table, zakaz, g_tochka, z_dat' +
        'e, g_client, client_name, g_payment_type, payment_name,'
      
        '1101901814=           osnovanie, g_product, g_product_par, tovar' +
        '_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1101901815=           nds, nds_summ, price_self, sum_self, profi' +
        't, is_head)'
      '1101901816=        values'
      
        '1101901817=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZA' +
        'KAZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '1101901818=         :REC_osnovanie_, :REC_g_product_, :REC_g_pro' +
        'duct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_p' +
        'erc_, :REC_discount_summ_,'
      
        '1101901819=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC' +
        '_SUM_COST_, :REC_profit_, 0);'
      '1101901820='
      
        '1101901821=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COS' +
        'T_, 0);'
      
        '1101901822=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_,' +
        ' 0);'
      '1101901823=      END'
      '1101901824='
      '1101901825=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901826=      insert into p_rep_profit_table'
      
        '1101901827=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101901828=      values'
      
        '1101901829=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', ' +
        '0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1101901830='
      '1101901831=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101901832=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101901833=  END'
      '1101901834=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101901835=  --*************************************************' +
        '****************************************'
      '1101901836='
      
        '1101901837=  --*************************************************' +
        '****************************************'
      '1101901838=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101901839=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1101901840=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1101901841=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1101901842='
      
        '1101901843=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1101901844=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1101901845=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1101901846=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '1101901847='
      
        '1101901848=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059 +
        #1063#1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '1101901849=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058 +
        '. - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '1101901850=  --*************************************************' +
        '****************************************'
      '1101901851=  SELECT COUNT(*)'
      '1101901852=    FROM SKLAD S'
      
        '1101901853=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      
        '1101901854=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1101901855=     AND S.IS_VOZVRAT IN (1,2)'
      
        '1101901856=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S' +
        '.G_CLIENT, 0))'
      
        '1101901857=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_' +
        ', COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101901858=     AND ((EXISTS (SELECT 1'
      '1101901859=                   FROM SKLAD SS'
      '1101901860=                  WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '1101901861=                    AND SS.G_PRODUCT = S.G_PRODUCT'
      
        '1101901862=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101901863=          OR'
      '1101901864=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101901865=  INTO :CNT_;'
      '1101901866='
      '1101901867=  IF (CNT_ > 0) THEN BEGIN'
      '1101901868=    SUM_ZAKAZ_ = 0;'
      '1101901869=    PROFIT_    = 0;'
      '1101901870=    SUM_COST_  = 0;'
      '1101901871='
      '1101901872=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901873=    insert into p_rep_profit_table'
      '1101901874=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101901875=    values'
      
        '1101901876=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054 +
        #1042#1040#1056#1040#39', 1);'
      '1101901877='
      '1101901878=    FOR SELECT S.DATE_RECEIPT,'
      '1101901879=               S.G_PRODUCT,'
      '1101901880=               G.NAME TOVAR_NAME,'
      '1101901881=               S.AMOUNT,'
      '1101901882=               S.PRICE,'
      '1101901883=               S.SUMM,'
      '1101901884=               SP.G_TOCHKA'
      '1101901885=         FROM SKLAD_PARENT SP,'
      '1101901886=              SKLAD S,'
      '1101901887=              G_PRODUCT G'
      
        '1101901888=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOC' +
        'HKA||'#39'-'#39
      
        '1101901889=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1101901890=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '1101901891=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COAL' +
        'ESCE(S.G_CLIENT, 0))'
      
        '1101901892=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT' +
        '_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101901893=          AND SP.SKLAD = S.SKLAD_PARENT'
      '1101901894=          AND S.G_PRODUCT = G.G_PRODUCT'
      '1101901895=          AND ((EXISTS (SELECT 1'
      '1101901896=                           FROM SKLAD SS'
      
        '1101901897=                          WHERE SS.G_CLIENT = :G_SUPP' +
        'LIER_'
      
        '1101901898=                            AND SS.G_PRODUCT = S.G_PR' +
        'ODUCT'
      
        '1101901899=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101901900=                  OR'
      '1101901901=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101901902=        ORDER BY 1'
      '1101901903=    INTO :V_DATE_RECEIPT_,'
      '1101901904=         :V_G_PRODUCT_,'
      '1101901905=         :V_TOVAR_NAME_,'
      '1101901906=         :V_AMOUNT_,'
      '1101901907=         :V_PRICE_,'
      '1101901908=         :V_SUMM_,'
      '1101901909=         :REC_G_TOCHKA_'
      '1101901910=    DO BEGIN'
      '1101901911=      --REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '1101901912=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;  ' +
        '  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054 +
        #1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' ' +
        #1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101901913='
      '1101901914='
      '1101901915=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101901916=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR' +
        '_NAME, AMOUNT, PRICE, SUMM,'
      '1101901917=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1101901918=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, ' +
        'sum_self)'
      '1101901919=      VALUES'
      
        '1101901920=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_R' +
        'ECEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, -' +
        ':V_SUMM_,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045 +
        #1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, ' +
        #1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101901921=         0, 0, 0, 0, :REC_profit_, 0, 0, 0);'
      '1101901922='
      
        '1101901923=      --SUM_COST_  = SUM_COST_  + COALESCE(REC_SUM_CO' +
        'ST_, 0);     -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101901924=      SUM_COST_ = 0;'
      '1101901925=      SUM_ZAKAZ_ = SUM_ZAKAZ_ - COALESCE(V_SUMM_, 0);'
      
        '1101901926=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0)' +
        ';'
      '1101901927=    END'
      '1101901928='
      '1101901929='
      
        '1101901930=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_; --S' +
        'UM_COST_;'
      '1101901931=    --SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1101901932=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101901933='
      '1101901934=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901935=    insert into p_rep_profit_table'
      
        '1101901936=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101901937=    values'
      
        '1101901938=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, 0, 0, :PROFIT_, 2);'
      '1101901939=  END'
      '1101901940=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101901941=  --*************************************************' +
        '****************************************'
      '1101901942='
      
        '1101901943=  --*************************************************' +
        '****************************************'
      
        '1101901944=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045 +
        #1051#1054' '#1052#1045#1057#1058#1054
      '1101901945=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '1101901946=  --*************************************************' +
        '****************************************'
      '1101901947=  /*SELECT COUNT(*)'
      '1101901948=    FROM ZAKAZ Z'
      
        '1101901949=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1101901950=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1101901951=     AND Z.IS_SPISANIE = 4'
      
        '1101901952=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1101901953=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101901954=  INTO :CNT_;'
      '1101901955='
      '1101901956=  IF (CNT_ > 0) THEN BEGIN'
      '1101901957=      SUM_ZAKAZ_ = 0;'
      '1101901958=      SUM_COST_  = 0;'
      '1101901959=      PROFIT_    = 0;'
      '1101901960=      NDS_SUMM_  = 0;'
      '1101901961='
      '1101901962=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101901963=      insert into p_rep_profit_table'
      '1101901964=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101901965=      values'
      
        '1101901966=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '1101901967='
      '1101901968=      FOR SELECT Z.ZAKAZ,'
      '1101901969=               Z.G_TOCHKA,'
      '1101901970=               Z.Z_DATE,'
      '1101901971=               Z.G_CLIENT,'
      '1101901972=               C.NAME CLIENT_NAME,'
      '1101901973=               Z.G_PAYMENT_TYPE,'
      '1101901974=               P.NAME PAYMENT_NAME,'
      '1101901975=               Z.OSNOVANIE,'
      '1101901976=               G.G_PRODUCT,'
      '1101901977=               G.G_PRODUCT_PAR,'
      '1101901978=               G.NAME TOVAR_NAME,'
      '1101901979=               ZD.AMOUNT,'
      '1101901980=               ZD.PRICE,'
      '1101901981=               ZD.SUMM,'
      '1101901982=               ZD.DISCOUNT_PERC,'
      '1101901983=               ZD.DISCOUNT_SUMM,'
      '1101901984=               ZD.NDS,'
      '1101901985=               ZD.NDS_SUMM,'
      '1101901986=               COALESCE(ZD.COST_PRICE, 0)'
      
        '1101901987=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON ' +
        'Z.G_CLIENT = C.G_CLIENT,'
      '1101901988=               ZAKAZ_DETAILS ZD,'
      '1101901989=               G_PRODUCT G,'
      '1101901990=               G_PAYMENT_TYPE P'
      
        '1101901991=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1101901992=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101901993=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101901994=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '1101901995=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1101901996=           AND Z.IS_SPISANIE = 4                   --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101901997=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101901998=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101901999=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '1101902000=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '1101902001=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ' +
        'ZD.ZAKAZ_DETAILS, G.NAME'
      '1101902002=    INTO :REC_ZAKAZ_,'
      '1101902003=        :REC_G_TOCHKA_,'
      '1101902004=        :REC_Z_DATE_,'
      '1101902005=        :REC_G_CLIENT_,'
      '1101902006=        :REC_CLIENT_NAME_,'
      '1101902007=        :REC_G_PAYMENT_TYPE_,'
      '1101902008=        :REC_PAYMENT_NAME_,'
      '1101902009=        :REC_OSNOVANIE_,'
      '1101902010=        :REC_G_PRODUCT_,'
      '1101902011=        :REC_G_PRODUCT_PAR_,'
      '1101902012=        :REC_TOVAR_NAME_,'
      '1101902013=        :REC_AMOUNT_,'
      '1101902014=        :REC_PRICE_,'
      '1101902015=        :REC_SUMM_,'
      '1101902016=        :REC_DISCOUNT_PERC_,'
      '1101902017=        :REC_DISCOUNT_SUMM_,'
      '1101902018=        :REC_NDS_,'
      '1101902019=        :REC_NDS_SUMM_,'
      '1101902020=        :REC_PRICE_SELF_'
      '1101902021=    DO BEGIN'
      '1101902022=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '1101902023=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '1101902024='
      '1101902025=      insert into p_rep_profit_table'
      
        '1101902026=        (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '1101902027=         osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '1101902028=         nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '1101902029=      values'
      '1101902030=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1101902031=        :REC_ZAKAZ_,'
      '1101902032=        :REC_g_tochka_,'
      
        '1101902033=        :REC_z_date_, :REC_g_client_, :REC_client_nam' +
        'e_, :REC_g_payment_type_, :REC_payment_name_,'
      '1101902034=         :REC_osnovanie_,'
      '1101902035=         :REC_g_product_,'
      '1101902036=         :REC_g_product_par_,'
      '1101902037=         :REC_tovar_name_,'
      '1101902038=         :REC_amount_,'
      '1101902039=         :REC_price_,'
      '1101902040=         :REC_summ_,'
      '1101902041=         :REC_discount_perc_,'
      '1101902042=         :REC_discount_summ_,'
      
        '1101902043=         :REC_nds_, :REC_nds_summ_, :REC_price_self_,' +
        ' :REC_SUM_COST_, :REC_profit_, 0);'
      '1101902044='
      
        '1101902045=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0' +
        ');'
      
        '1101902046=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_' +
        ', 0);'
      
        '1101902047=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1101902048=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0)' +
        ';'
      '1101902049=    END'
      '1101902050='
      '1101902051=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101902052=    insert into p_rep_profit_table'
      
        '1101902053=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101902054=    values'
      
        '1101902055=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1101902056='
      '1101902057=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101902058=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '1101902059=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101902060=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101902061='
      '1101902062=    SUM_ZAKAZ_ = 0;'
      '1101902063=    SUM_COST_  = 0;'
      '1101902064=    NDS_SUMM_  = 0;'
      '1101902065=    PROFIT_    = 0;'
      '1101902066=  END'
      '1101902067=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '1101902068=  --*************************************************' +
        '****************************************'
      '1101902069='
      
        '1101902070=  --*************************************************' +
        '****************************************'
      
        '1101902071=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101902072=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101902073=  --*************************************************' +
        '****************************************'
      '1101902074=  SELECT COUNT(*)'
      '1101902075=    FROM ZAKAZ S'
      
        '1101902076=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      '1101902077=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101902078=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101902079=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101902080=     AND S.IS_SPISANIE = 2'
      '1101902081=  INTO :CNT_;'
      '1101902082='
      '1101902083=  IF (CNT_ > 0) THEN BEGIN'
      '1101902084=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101902085=      insert into p_rep_profit_table'
      '1101902086=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101902087=      values'
      
        '1101902088=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1101902089='
      '1101902090=      SUM_ZAKAZ_ = 0;'
      '1101902091=      SUM_COST_  = 0;'
      '1101902092=      NDS_SUMM_  = 0;'
      '1101902093=      PROFIT_    = 0;'
      '1101902094=      FOR SELECT GP.NAME,'
      '1101902095=                 GP.G_PRODUCT'
      '1101902096=           FROM G_PRODUCT GP'
      '1101902097=          WHERE IS_CATEGORY = 1'
      '1101902098=            AND EXISTS (SELECT 1'
      
        '1101902099=                          FROM ZAKAZ Z, ZAKAZ_DETAILS' +
        ' ZD, G_PRODUCT G'
      
        '1101902100=                         WHERE :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1101902101=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '1101902102=                           AND ZD.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101902103=                           AND G.G_PRODUCT_PAR = GP.G' +
        '_PRODUCT'
      '1101902104=                           AND Z.IS_SPISANIE = 2'
      '1101902105=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101902106=                           AND Z.Z_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '1101902107=                           AND COALESCE(Z.G_CLIENT, 0' +
        ') = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053 +
        #1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101902108=                           AND COALESCE(Z.G_PAYMENT_T' +
        'YPE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0))'
      '1101902109=                           AND ((EXISTS (SELECT 1'
      
        '1101902110=                                           FROM SKLAD' +
        ' S'
      
        '1101902111=                                          WHERE S.G_C' +
        'LIENT = :G_SUPPLIER_'
      
        '1101902112=                                            AND S.G_P' +
        'RODUCT = G.G_PRODUCT'
      
        '1101902113=                                            AND :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPL' +
        'IER_, 0) <> 0)'
      '1101902114=                                  OR'
      
        '1101902115=                                  COALESCE(:G_SUPPLIE' +
        'R_, 0) = 0)'
      '1101902116=                           )'
      '1101902117=          ORDER BY 1'
      '1101902118=      INTO :RECCAT_NAME_,'
      '1101902119=           :RECCAT_PRODUCT_'
      '1101902120=      DO BEGIN'
      '1101902121=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101902122=        insert into p_rep_profit_table'
      '1101902123=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101902124=        values'
      
        '1101902125=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT' +
        '_NAME_, 1);'
      '1101902126='
      '1101902127=        FOR SELECT Z.ZAKAZ,'
      '1101902128=                   Z.G_TOCHKA,'
      '1101902129=                   Z.Z_DATE,'
      '1101902130=                   Z.G_CLIENT,'
      '1101902131=                   C.NAME CLIENT_NAME,'
      '1101902132=                   Z.G_PAYMENT_TYPE,'
      '1101902133=                   P.NAME PAYMENT_NAME,'
      '1101902134=                   Z.OSNOVANIE,'
      '1101902135=                   G.G_PRODUCT,'
      '1101902136=                   G.G_PRODUCT_PAR,'
      '1101902137=                   G.NAME TOVAR_NAME,'
      '1101902138=                   ZD.AMOUNT,'
      '1101902139=                   ZD.PRICE,'
      '1101902140=                   ZD.SUMM,'
      '1101902141=                   ZD.DISCOUNT_PERC,'
      '1101902142=                   ZD.DISCOUNT_SUMM,'
      '1101902143=                   ZD.NDS,'
      '1101902144=                   ZD.NDS_SUMM,'
      '1101902145=                   ZD.COST_PRICE'
      
        '1101902146=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C' +
        ' ON Z.G_CLIENT = C.G_CLIENT,'
      '1101902147=                   ZAKAZ_DETAILS ZD,'
      '1101902148=                   G_PRODUCT G,'
      '1101902149=                   G_PAYMENT_TYPE P'
      
        '1101902150=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G' +
        '_TOCHKA||'#39'-'#39
      '1101902151=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101902152=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101902153=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYP' +
        'E'
      
        '1101902154=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_' +
        '  -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1101902155=               AND Z.IS_SPISANIE = 2                 ' +
        '   -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '1101902156=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101902157=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1101902158=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE' +
        '(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '1101902159=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = CO' +
        'ALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101902160=               AND ((EXISTS (SELECT 1'
      '1101902161=                               FROM SKLAD S'
      
        '1101902162=                              WHERE S.G_CLIENT = :G_S' +
        'UPPLIER_'
      
        '1101902163=                                AND S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '1101902164=                                AND :G_TOCHKA_ARR_ CO' +
        'NTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> ' +
        '0)'
      '1101902165=                      OR'
      '1101902166=                      COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1101902167=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAK' +
        'AZ, ZD.ZAKAZ_DETAILS, G.NAME'
      '1101902168=        INTO :REC_ZAKAZ_,'
      '1101902169=            :REC_G_TOCHKA_,'
      '1101902170=            :REC_Z_DATE_,'
      '1101902171=            :REC_G_CLIENT_,'
      '1101902172=            :REC_CLIENT_NAME_,'
      '1101902173=            :REC_G_PAYMENT_TYPE_,'
      '1101902174=            :REC_PAYMENT_NAME_,'
      '1101902175=            :REC_OSNOVANIE_,'
      '1101902176=            :REC_G_PRODUCT_,'
      '1101902177=            :REC_G_PRODUCT_PAR_,'
      '1101902178=            :REC_TOVAR_NAME_,'
      '1101902179=            :REC_AMOUNT_,'
      '1101902180=            :REC_PRICE_,'
      '1101902181=            :REC_SUMM_,'
      '1101902182=            :REC_DISCOUNT_PERC_,'
      '1101902183=            :REC_DISCOUNT_SUMM_,'
      '1101902184=            :REC_NDS_,'
      '1101902185=            :REC_NDS_SUMM_,'
      '1101902186=            :REC_PRICE_SELF_'
      '1101902187=        DO BEGIN'
      
        '1101902188=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SEL' +
        'F_;'
      
        '1101902189=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ -' +
        ' REC_NDS_SUMM_;'
      '1101902190='
      '1101902191=          insert into p_rep_profit_table'
      
        '1101902192=            (p_rep_profit_table, zakaz, g_tochka, z_d' +
        'ate, g_client, client_name, g_payment_type, payment_name,'
      
        '1101902193=             osnovanie, g_product, g_product_par, tov' +
        'ar_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1101902194=             nds, nds_summ, price_self, sum_self, pro' +
        'fit, is_head)'
      '1101902195=          values'
      '1101902196=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1101902197=            :REC_ZAKAZ_,'
      '1101902198=            :REC_g_tochka_,'
      
        '1101902199=            :REC_z_date_, :REC_g_client_, :REC_client' +
        '_name_, :REC_g_payment_type_, :REC_payment_name_,'
      '1101902200=             :REC_osnovanie_,'
      '1101902201=             :REC_g_product_,'
      '1101902202=             :REC_g_product_par_,'
      '1101902203=             :REC_tovar_name_,'
      '1101902204=             :REC_amount_,'
      '1101902205=             :REC_price_,'
      '1101902206=             :REC_summ_,'
      '1101902207=             :REC_discount_perc_,'
      '1101902208=             :REC_discount_summ_,'
      
        '1101902209=             :REC_nds_, :REC_nds_summ_, :REC_price_se' +
        'lf_, :REC_SUM_COST_, :REC_profit_, 0);'
      '1101902210='
      
        '1101902211=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM' +
        '_, 0);'
      
        '1101902212=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_C' +
        'OST_, 0);'
      
        '1101902213=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_S' +
        'UMM_, 0);'
      
        '1101902214=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_' +
        ', 0);'
      '1101902215=        END'
      '1101902216='
      '1101902217=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101902218=        insert into p_rep_profit_table'
      
        '1101902219=          (p_rep_profit_table, tovar_name, summ, sum_' +
        'self, NDS_SUMM, profit, is_head)'
      '1101902220=        values'
      
        '1101902221=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1101902222='
      
        '1101902223=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ' +
        '_;'
      '1101902224=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '1101902225=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '1101902226=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '1101902227='
      '1101902228=        SUM_ZAKAZ_ = 0;'
      '1101902229=        SUM_COST_  = 0;'
      '1101902230=        NDS_SUMM_  = 0;'
      '1101902231=        PROFIT_    = 0;'
      '1101902232=      END'
      '1101902233='
      '1101902234=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1101902235=      insert into p_rep_profit_table'
      
        '1101902236=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101902237=      values'
      
        '1101902238=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '1101902239='
      
        '1101902240=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REA' +
        'L_;'
      
        '1101902241=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REA' +
        'L_;'
      
        '1101902242=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_' +
        ';'
      '1101902243=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '1101902244=  END'
      '1101902245=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101902246=  --*************************************************' +
        '****************************************'
      '1101902247=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '1101902248='
      '1101902249=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1101902250=  insert into p_rep_profit_table'
      '1101902251=    (p_rep_profit_table, is_head)'
      '1101902252=  values'
      '1101902253=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1101902254='
      '1101902255=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1101902256=  insert into p_rep_profit_table'
      
        '1101902257=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101902258=  values'
      
        '1101902259=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1101902260='
      '1101902261=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1101902262=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1101902263=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1101902264=         SUM(Z.SUMM_BONUS)'
      '1101902265=    FROM ZAKAZ Z'
      
        '1101902266=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1101902267=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1101902268=     AND Z.IS_RESERVE = 0'
      '1101902269=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101902270=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101902271=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101902272=     AND ((EXISTS (SELECT 1'
      '1101902273=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1101902274=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1101902275=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1101902276=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1101902277=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101902278=          OR'
      '1101902279=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101902280=    INTO :SUMM_CASH_ALL_,'
      '1101902281=         :SUMM_NONCASH_ALL_,'
      '1101902282=         :SUMM_BONUS_ALL_;'
      '1101902283='
      '1101902284=  SELECT SUM(NAL),'
      '1101902285=         SUM(BEZNAL)'
      
        '1101902286=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHE' +
        'RE K.SKLAD = SP.SKLAD) NAL,'
      
        '1101902287=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL' +
        ' KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '1101902288=           FROM SKLAD_PARENT SP'
      
        '1101902289=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '1101902290=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101902291=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '1101902292=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, CO' +
        'ALESCE(SP.G_CLIENT, 0))'
      
        '1101902293=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYME' +
        'NT_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '1101902294=        )'
      '1101902295=  INTO :SUMM_VOZVRAT_NAL_,'
      '1101902296=       :SUMM_VOZVRAT_BEZNAL_;'
      '1101902297='
      
        '1101902298=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COAL' +
        'ESCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '1101902299=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) ' +
        '- COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '1101902300=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1101902301='
      '1101902302=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1101902303='
      
        '1101902304=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1101902305=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1101902306='
      '1101902307=/*  insert into p_rep_profit_table'
      
        '1101902308=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101902309=  values'
      
        '1101902310=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1101902311='
      '1101902312=  insert into p_rep_profit_table'
      '1101902313=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1101902314=  values'
      
        '1101902315=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1101902316='
      '1101902317=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1101902318=    SELECT G.NAME'
      '1101902319=      FROM G_CLIENT G'
      '1101902320=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1101902321=    INTO :CLIENT_NAME_;'
      '1101902322=  ELSE'
      '1101902323=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101902324='
      '1101902325=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1101902326=    SELECT G.NAME'
      '1101902327=      FROM G_PAYMENT_TYPE G'
      '1101902328=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1101902329=    INTO :PAYMENT_NAME_;'
      '1101902330=  ELSE'
      '1101902331=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101902332='
      '1101902333=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1101902334=        P.ZAKAZ,'
      '1101902335=        P.G_TOCHKA,'
      '1101902336=        P.Z_DATE,'
      '1101902337=        P.G_CLIENT,'
      '1101902338=        P.CLIENT_NAME,'
      '1101902339=        P.G_PAYMENT_TYPE,'
      '1101902340=        P.PAYMENT_NAME,'
      '1101902341=        P.OSNOVANIE,'
      '1101902342=        P.G_PRODUCT,'
      '1101902343=        P.G_PRODUCT_PAR,'
      '1101902344=        P.TOVAR_NAME,'
      '1101902345=        G.ARTICUL,'
      '1101902346=        G.NOMENCLATUR_NUM,'
      '1101902347=        P.AMOUNT,'
      
        '1101902348=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1101902349=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101902350=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101902351=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101902352=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101902353=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101902354=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101902355=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101902356=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1101902357=        P.IS_HEAD'
      
        '1101902358=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1101902359=    ORDER BY 1'
      '1101902360=  INTO :P_REP_PROFIT_TABLE,'
      '1101902361=       :ZAKAZ,'
      '1101902362=       :G_TOCHKA,'
      '1101902363=       :Z_DATE,'
      '1101902364=       :G_CLIENT,'
      '1101902365=       :CLIENT_NAME,'
      '1101902366=       :G_PAYMENT_TYPE,'
      '1101902367=       :PAYMENT_NAME,'
      '1101902368=       :OSNOVANIE,'
      '1101902369=       :G_PRODUCT,'
      '1101902370=       :G_PRODUCT_PAR,'
      '1101902371=       :TOVAR_NAME,'
      '1101902372=       :ARTICUL,'
      '1101902373=       :NOMENCLATUR_NUM,'
      '1101902374=       :AMOUNT,'
      '1101902375=       :PRICE,'
      '1101902376=       :SUMM,'
      '1101902377=       :DISCOUNT_PERC,'
      '1101902378=       :DISCOUNT_SUMM,'
      '1101902379=       :NDS,'
      '1101902380=       :NDS_SUMM,'
      '1101902381=       :PRICE_SELF,'
      '1101902382=       :SUM_SELF,'
      '1101902383=       :PROFIT,'
      '1101902384=       :IS_HEAD'
      '1101902385=  DO'
      '1101902386=    suspend;'
      '1101902387='
      '1101902388=WHEN ANY DO BEGIN'
      '1101902389=    Err_code = -20500;'
      
        '1101902390=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101902391=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101902392=  END'
      '1101902393=end'
      '1101902394=;'
      '1101902395='
      '1101902396=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '1101902397=  DATE_BEGIN_ DATE,'
      '1101902398=  DATE_END_ DATE,'
      '1101902399=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101902400=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      '1101902401=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1101902402=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '1101902403=RETURNS ('
      '1101902404=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101902405=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '1101902406=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SU' +
        'MM,'
      '1101902407=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1101902408=  SUMM_ALL_ NUMERIC(15,2),'
      '1101902409=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1101902410=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1101902411=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1101902412=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1101902413=  PROFIT_ALL_ NUMERIC(15,2),'
      '1101902414=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1101902415=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABL' +
        'E.P_REP_PROFIT_TABLE,'
      
        '1101902416=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_' +
        'NAME,'
      '1101902417=  SUMM NUMERIC(15,2),'
      '1101902418=  NDS_SUMM NUMERIC(15,2),'
      '1101902419=  SUM_SELF NUMERIC(15,2),'
      '1101902420=  PROFIT NUMERIC(15,2),'
      '1101902421=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1101902422=  ERR_CODE INTEGER,'
      '1101902423=  ERR_MSG VARCHAR(1024))'
      '1101902424=AS'
      '1101902425=/*'
      '1101902426='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1101902427='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1101902428='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1101902429='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1101902430='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1101902431='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1101902432='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1101902433=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1101902434=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1101902435=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1101902436='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1101902437='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1101902438=*/'
      
        '1101902439=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT' +
        #39';'
      '1101902440=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101902441=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1101902442=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1101902443=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1101902444=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1101902445=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1101902446=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1101902447=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1101902448=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM;'
      
        '1101902449=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.NDS_SUMM;'
      
        '1101902450=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.S' +
        'UMM;'
      '1101902451=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '1101902452=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '1101902453=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1101902454=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059 +
        #1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1101902455=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /' +
        '* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1101902456=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0' +
        '; /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '1101902457=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1101902458=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      '1101902459=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '1101902460=BEGIN'
      
        '1101902461=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_T' +
        'ABLE = P_REP_PROFIT_TABLE;'
      '1101902462=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101902463='
      '1101902464=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '1101902465=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '1101902466=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '1101902467='
      '1101902468=  FOR SELECT SUM(ZD.SUMM)'
      '1101902469=           ,TR.PATH'
      '1101902470=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1101902471=           ,SUM(ZD.nds_summ)'
      '1101902472=      FROM ZAKAZ Z,'
      '1101902473=           ZAKAZ_DETAILS ZD,'
      '1101902474=           G_PRODUCT GP,'
      '1101902475=           P_REP_TREE TR'
      
        '1101902476=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101902477=       AND Z.IS_SPISANIE = 0'
      '1101902478=       AND Z.IS_RESERVE = 0'
      '1101902479=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101902480=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101902481=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101902482=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101902483=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1101902484=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101902485=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101902486=       AND ((EXISTS (SELECT 1'
      '1101902487=                       FROM SKLAD S'
      '1101902488=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1101902489=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1101902490=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101902491=              OR'
      '1101902492=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101902493=     GROUP BY TR.PATH'
      '1101902494=     ORDER BY TR.PATH'
      
        '1101902495=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, ' +
        'NDS_SUMM_'
      '1101902496=  DO BEGIN'
      '1101902497=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '1101902498='
      '1101902499=    insert into p_rep_profit_table'
      
        '1101902500=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1101902501=    values'
      '1101902502=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1101902503=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :S' +
        'UM_COST_, :PROFIT_, 0);'
      '1101902504='
      '1101902505=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101902506=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1101902507=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101902508=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101902509=  END'
      '1101902510='
      '1101902511=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1101902512=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1101902513=      insert into p_rep_profit_table'
      
        '1101902514=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101902515=      values'
      
        '1101902516=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1101902517='
      
        '1101902518=  --*************************************************' +
        '****************************************'
      '1101902519=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1101902520=  ---------------------------------------------------' +
        '----'
      '1101902521=  IS_FIRST_ = 1;'
      '1101902522=  SUM_COST_ = 0;'
      '1101902523=  PROFIT_   = 0;'
      '1101902524='
      '1101902525=  FOR SELECT G.NAME,'
      '1101902526=             SUM(K.SUMM)'
      
        '1101902527=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRI' +
        'HOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101902528=              UNION ALL'
      
        '1101902529=              SELECT ACTION_DATE, SUMM NAL, ACTION, G' +
        '_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1101902530=             G_PRIHOD_RASHOD G'
      
        '1101902531=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1101902532=        AND K.ACTION = 1'
      
        '1101902533=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1101902534=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101902535=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    ' +
        '-- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101902536=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1101902537=        INTO :REC_TOVAR_NAME_'
      '1101902538=             ,:SUMM_'
      '1101902539=  DO BEGIN'
      '1101902540=    IF (IS_FIRST_ = 1) then BEGIN'
      '1101902541=      INSERT INTO P_REP_PROFIT_TABLE'
      '1101902542=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101902543=      VALUES'
      
        '1101902544=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39 +
        ', 1);'
      '1101902545='
      '1101902546=      IS_FIRST_ = 0;'
      '1101902547=    END'
      '1101902548='
      '1101902549=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101902550=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1101902551=    VALUES'
      
        '1101902552=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '1101902553='
      '1101902554=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1101902555=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1101902556=  END'
      '1101902557='
      '1101902558=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1101902559=  IF (SUM_COST_ > 0) then BEGIN'
      '1101902560=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101902561=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101902562=    insert into p_rep_profit_table'
      
        '1101902563=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101902564=    values'
      
        '1101902565=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1101902566=  END'
      '1101902567=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1101902568=  --*************************************************' +
        '****************************************'
      '1101902569='
      
        '1101902570=  --*************************************************' +
        '****************************************'
      '1101902571=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101902572=  ---------------------------------------------------' +
        '----'
      '1101902573=  IS_FIRST_ = 1;'
      '1101902574=  PROFIT_   = 0;'
      '1101902575=  PRIHOD_ALL_  = 0;'
      '1101902576=  PRIHOD_ALL_NAL_  = 0;'
      '1101902577=  PRIHOD_ALL_BEZNAL_  = 0;'
      '1101902578='
      '1101902579=  FOR SELECT G.NAME,'
      '1101902580=             SUM(K.NAL),'
      '1101902581=             SUM(K.BEZNAL)'
      
        '1101902582=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101902583=              UNION ALL'
      
        '1101902584=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1101902585=             G_PRIHOD_RASHOD G'
      
        '1101902586=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1101902587=        AND K.ACTION = 0'
      
        '1101902588=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1101902589=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101902590=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101902591=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1101902592=        INTO :REC_TOVAR_NAME_'
      '1101902593=             ,:SUMM_NAL_'
      '1101902594=             ,:SUMM_BEZNAL_'
      '1101902595=  DO BEGIN'
      '1101902596=    IF (IS_FIRST_ = 1) then BEGIN'
      '1101902597=      INSERT INTO P_REP_PROFIT_TABLE'
      '1101902598=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101902599=      VALUES'
      
        '1101902600=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39 +
        ', 1);'
      '1101902601='
      '1101902602=      IS_FIRST_ = 0;'
      '1101902603=    END'
      '1101902604='
      '1101902605=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101902606=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_' +
        'SUMM, SUMM, PROFIT, IS_HEAD)'
      '1101902607=    VALUES'
      
        '1101902608=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZN' +
        'AL_, 0);'
      '1101902609='
      '1101902610=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '1101902611=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BE' +
        'ZNAL_;'
      
        '1101902612=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      
        '1101902613=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL' +
        '_;'
      '1101902614=  END'
      '1101902615='
      '1101902616=  IF (PROFIT_ > 0) then BEGIN'
      '1101902617=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1101902618=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101902619=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1101902620=    insert into p_rep_profit_table'
      
        '1101902621=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101902622=    values'
      
        '1101902623=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1101902624=  END'
      '1101902625=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1101902626=  --*************************************************' +
        '****************************************'
      '1101902627='
      
        '1101902628=  --*************************************************' +
        '****************************************'
      '1101902629=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101902630=  --*************************************************' +
        '****************************************'
      '1101902631=  IS_FIRST_ = 1;'
      '1101902632=  SUM_COST_ = 0;'
      '1101902633=  PROFIT_   = 0;'
      
        '1101902634=  FOR SELECT SUM(ZD.SUMM)        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040 +
        #1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040 +
        #1044#1054
      '1101902635=           ,TR.PATH'
      '1101902636=      FROM ZAKAZ Z,'
      '1101902637=           ZAKAZ_DETAILS ZD,'
      '1101902638=           G_PRODUCT GP,'
      '1101902639=           P_REP_TREE TR'
      
        '1101902640=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101902641=       AND Z.IS_SPISANIE = 1'
      '1101902642=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101902643=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101902644=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101902645=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101902646=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1101902647=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101902648=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101902649=     GROUP BY TR.PATH'
      '1101902650=     ORDER BY TR.PATH'
      '1101902651=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '1101902652=  DO BEGIN'
      '1101902653='
      '1101902654=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1101902655=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101902656=      insert into p_rep_profit_table'
      '1101902657=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101902658=      values'
      
        '1101902659=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1101902660='
      '1101902661=      IS_FIRST_ = 0;'
      '1101902662=    END'
      '1101902663='
      '1101902664=    insert into p_rep_profit_table'
      
        '1101902665=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1101902666=    values'
      '1101902667=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1101902668=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZA' +
        'KAZ_, 0);'
      '1101902669='
      '1101902670=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '1101902671=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '1101902672=  END'
      '1101902673='
      '1101902674=  if (SUM_COST_ > 0) then BEGIN'
      '1101902675=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101902676=    insert into p_rep_profit_table'
      
        '1101902677=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101902678=    values'
      
        '1101902679=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0,' +
        ' :SUM_COST_, 0, :PROFIT_, 2);'
      '1101902680='
      '1101902681=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101902682=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101902683=  END'
      '1101902684=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101902685=  --*************************************************' +
        '****************************************'
      '1101902686='
      
        '1101902687=  --*************************************************' +
        '****************************************'
      '1101902688=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101902689=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1101902690=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1101902691=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1101902692='
      
        '1101902693=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1101902694=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1101902695=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1101902696=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      
        '1101902697=  --*************************************************' +
        '****************************************'
      '1101902698=  IS_FIRST_  = 1;'
      '1101902699=  SUM_ZAKAZ_ = 0;'
      '1101902700=  PROFIT_    = 0;'
      '1101902701=  FOR SELECT SUM(S.SUMM)'
      '1101902702=             ,TR.PATH'
      '1101902703=     FROM SKLAD_PARENT SP,'
      '1101902704=          SKLAD S,'
      '1101902705=          G_PRODUCT G,'
      '1101902706=          P_REP_TREE TR'
      
        '1101902707=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA|' +
        '|'#39'-'#39
      
        '1101902708=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1101902709=      AND SP.IS_VOZVRAT IN (1,2)'
      '1101902710=      and G.g_product_PAR = TR.g_product'
      
        '1101902711=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(S.G_CLIENT, 0))'
      
        '1101902712=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYP' +
        'E_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101902713=      AND SP.SKLAD = S.SKLAD_PARENT'
      '1101902714=      AND S.G_PRODUCT = G.G_PRODUCT'
      '1101902715=      AND ((EXISTS (SELECT 1'
      '1101902716=                       FROM SKLAD SS'
      
        '1101902717=                      WHERE SS.G_CLIENT = :G_SUPPLIER' +
        '_'
      
        '1101902718=                        AND SS.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '1101902719=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101902720=              OR'
      '1101902721=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101902722=     GROUP BY TR.PATH'
      '1101902723=     ORDER BY TR.PATH'
      '1101902724=     INTO :V_SUMM_,'
      '1101902725=          :REC_TOVAR_NAME_'
      '1101902726=  DO BEGIN'
      '1101902727=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1101902728=      insert into p_rep_profit_table'
      '1101902729=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101902730=      values'
      
        '1101902731=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040#39', 1);'
      '1101902732='
      '1101902733=      IS_FIRST_ = 0;'
      '1101902734=    END'
      '1101902735='
      
        '1101902736=    REC_profit_   = 0 - V_SUMM_;    -- 26.05.2016 '#1055#1054#1057 +
        #1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050 +
        #1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101902737=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101902738=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1101902739=    VALUES'
      
        '1101902740=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :V_SUMM_, :REC_profit_, 0);'
      '1101902741='
      '1101902742=    SUM_COST_ = 0;'
      '1101902743=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '1101902744=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '1101902745=  END'
      '1101902746='
      '1101902747=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1101902748=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1101902749=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101902750='
      '1101902751=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101902752=    insert into p_rep_profit_table'
      
        '1101902753=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101902754=    values'
      
        '1101902755=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '1101902756=  END'
      '1101902757=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101902758=  --*************************************************' +
        '****************************************'
      '1101902759='
      
        '1101902760=  --*************************************************' +
        '****************************************'
      
        '1101902761=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101902762=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101902763=  --*************************************************' +
        '****************************************'
      '1101902764=  IS_FIRST_  = 1;'
      '1101902765=  SUM_ZAKAZ_ = 0;'
      '1101902766=  SUM_COST_  = 0;'
      '1101902767=  PROFIT_    = 0;'
      '1101902768=  NDS_SUMM_  = 0;'
      '1101902769=  FOR SELECT SUM(ZD.SUMM)'
      '1101902770=           ,TR.PATH'
      '1101902771=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1101902772=           ,SUM(ZD.nds_summ)'
      '1101902773=      FROM ZAKAZ Z,'
      '1101902774=           ZAKAZ_DETAILS ZD,'
      '1101902775=           G_PRODUCT GP,'
      '1101902776=           P_REP_TREE TR'
      
        '1101902777=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101902778=       AND Z.IS_SPISANIE = 2'
      '1101902779=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101902780=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101902781=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101902782=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101902783=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1101902784=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101902785=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101902786=       AND ((EXISTS (SELECT 1'
      '1101902787=                       FROM SKLAD S'
      '1101902788=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1101902789=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1101902790=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101902791=              OR'
      '1101902792=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101902793=     GROUP BY TR.PATH'
      '1101902794=     ORDER BY TR.PATH'
      
        '1101902795=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST' +
        '_, REC_NDS_SUMM_'
      '1101902796=  DO BEGIN'
      '1101902797=    IF (IS_FIRST_ = 1) then BEGIN'
      '1101902798=      insert into p_rep_profit_table'
      '1101902799=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101902800=      values'
      
        '1101902801=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1101902802='
      '1101902803=      IS_FIRST_ = 0;'
      '1101902804=    END'
      '1101902805='
      
        '1101902806=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS' +
        '_SUMM_;'
      '1101902807='
      '1101902808=    insert into p_rep_profit_table'
      
        '1101902809=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1101902810=    values'
      '1101902811=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1101902812=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_,' +
        ' :REC_SUM_COST_, :REC_PROFIT_, 0);'
      '1101902813='
      '1101902814=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '1101902815=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '1101902816=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '1101902817=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '1101902818=  END'
      '1101902819='
      '1101902820=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1101902821=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1101902822=    insert into p_rep_profit_table'
      
        '1101902823=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101902824=    values'
      
        '1101902825=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFI' +
        'T_, 2);'
      '1101902826='
      '1101902827=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101902828=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1101902829=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101902830=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '1101902831=  END'
      '1101902832=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101902833=  --*************************************************' +
        '****************************************'
      '1101902834=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1101902835=  insert into p_rep_profit_table'
      '1101902836=    (p_rep_profit_table, is_head)'
      '1101902837=  values'
      '1101902838=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1101902839='
      '1101902840=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1101902841=  insert into p_rep_profit_table'
      
        '1101902842=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101902843=  values'
      
        '1101902844=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1101902845='
      '1101902846=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1101902847=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1101902848=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1101902849=         SUM(Z.SUMM_BONUS)'
      '1101902850=    FROM ZAKAZ Z'
      
        '1101902851=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1101902852=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1101902853=     AND Z.IS_RESERVE = 0'
      '1101902854=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101902855=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101902856=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101902857=     AND ((EXISTS (SELECT 1'
      '1101902858=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1101902859=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1101902860=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1101902861=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1101902862=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101902863=          OR'
      '1101902864=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101902865=    INTO :SUMM_CASH_ALL_,'
      '1101902866=         :SUMM_NONCASH_ALL_,'
      '1101902867=         :SUMM_BONUS_ALL_;'
      '1101902868='
      '1101902869=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '1101902870=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '1101902871=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1101902872='
      '1101902873=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1101902874='
      
        '1101902875=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1101902876=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1101902877='
      '1101902878=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1101902879=    SELECT G.NAME'
      '1101902880=      FROM G_CLIENT G'
      '1101902881=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1101902882=    INTO :CLIENT_NAME_;'
      '1101902883=  ELSE'
      '1101902884=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101902885='
      '1101902886=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1101902887=    SELECT G.NAME'
      '1101902888=      FROM G_PAYMENT_TYPE G'
      '1101902889=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1101902890=    INTO :PAYMENT_NAME_;'
      '1101902891=  ELSE'
      '1101902892=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101902893='
      '1101902894=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1101902895=        P.TOVAR_NAME,'
      
        '1101902896=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101902897=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101902898=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101902899=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1101902900=        P.IS_HEAD'
      
        '1101902901=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1101902902=    ORDER BY 1'
      '1101902903=  INTO :P_REP_PROFIT_TABLE,'
      '1101902904=       :TOVAR_NAME,'
      '1101902905=       :SUMM,'
      '1101902906=       :NDS_SUMM,'
      '1101902907=       :SUM_SELF,'
      '1101902908=       :PROFIT,'
      '1101902909=       :IS_HEAD'
      '1101902910=  DO'
      '1101902911=    suspend;'
      '1101902912='
      '1101902913=WHEN ANY DO BEGIN'
      '1101902914=    Err_code = -20500;'
      
        '1101902915=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101902916=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101902917=  END'
      '1101902918=end'
      '1101902919=;'
      '1101902920='
      '1101902921='
      
        '1101902922=UPDATE SYSTEM_SETUP SET S_VALUE = 110190 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101902923=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101902924=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101910=UPDATE SYSTEM_SETUP SET S_VALUE = 110190 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101911=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101912=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101920='
      '1101921=CREATE PROCEDURE G_DEL_G_PRODUCT_CAT('
      
        '1101922=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT,'
      '1101923=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101924=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ BI' +
        'GINT = NULL,'
      
        '1101925=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SUB_' +
        'TYPE 1 SEGMENT SIZE 16384 = NULL)'
      '1101926=RETURNS ('
      '1101927=  LOG_ BLOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      '1101928=  SUCCESS_CNT_ INTEGER,'
      '1101929=  FAIL_CNT_ INTEGER,'
      '11019210=  ERR_CODE INTEGER,'
      '11019211=  ERR_MSG VARCHAR(1024))'
      '11019212=AS'
      '11019213=BEGIN'
      '11019214=  SUSPEND;'
      '11019215=END'
      '11019216=;'
      '11019217='
      '11019218='
      
        '11019219=/******************************************************' +
        '************************/'
      
        '11019220=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11019221=/******************************************************' +
        '************************/'
      '11019222=ALTER PROCEDURE G_DEL_G_CLIENT('
      '11019223=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11019224=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '11019225=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '11019226=RETURNS ('
      '11019227=  ERR_CODE INTEGER,'
      '11019228=  ERR_MSG VARCHAR(1024))'
      '11019229=AS'
      '11019230=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '11019231=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11019232=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_CLIENT.NAME;'
      '11019233=DECLARE VARIABLE CNT_ INTEGER;'
      '11019234=BEGIN'
      '11019235=  PROCNAME = '#39'G_DEL_G_CLIENT'#39';'
      '11019236='
      '11019237=  if (G_CLIENT_ in (9, 10)) then begin'
      '11019238=    ERR_CODE = -20500;'
      
        '11019239=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1079#1072#1087 +
        #1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '11019240=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '11019241=    EXIT;'
      '11019242=  end'
      '11019243='
      '11019244=  SELECT NAME'
      '11019245=    FROM G_CLIENT G'
      '11019246=   WHERE G.G_CLIENT = :G_CLIENT_'
      '11019247=     INTO :NAME_;'
      '11019248='
      '11019249=  SELECT COUNT(*)'
      '11019250=    FROM ZAKAZ Z'
      '11019251=   WHERE Z.G_CLIENT = :G_CLIENT_'
      '11019252=    INTO :CNT_;'
      '11019253='
      '11019254=  if (CNT_ > 0) then begin'
      '11019255=    ERR_CODE = -20500;'
      
        '11019256=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, NAME_ || '#39' ' +
        #1091#1095#1072#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1076#1072#1078#1072#1093'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '11019257=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '11019258=    EXIT;'
      '11019259=  end'
      '11019260='
      '11019261=  SELECT COUNT(*)'
      '11019262=    FROM SKLAD S'
      '11019263=   WHERE S.G_CLIENT = :G_CLIENT_'
      '11019264=    INTO :CNT_;'
      '11019265='
      '11019266=  if (CNT_ > 0) then begin'
      '11019267=    ERR_CODE = -20500;'
      
        '11019268=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, NAME_ || '#39' ' +
        #1091#1095#1072#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1074#1086#1079#1074#1088#1072#1090#1072'/'#1087#1088#1080#1093#1086#1076#1072'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '11019269=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '11019270=    EXIT;'
      '11019271=  end'
      '11019272='
      '11019273=  delete from G_discont_card g'
      '11019274=    where g.G_CLIENT = :G_CLIENT_;'
      '11019275='
      '11019276=  update sms_history h'
      '11019277=     set h.G_CLIENT = null'
      '11019278=   where h.G_CLIENT = :G_CLIENT_;'
      '11019279='
      '11019280=  delete from G_client g'
      '11019281=    where g.G_CLIENT = :G_CLIENT_;'
      '11019282='
      '11019283=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '11019284=  EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_CLIE' +
        'NT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '11019285='
      '11019286=when sqlcode -530 DO'
      '11019287=  begin'
      '11019288=    ERR_CODE = -20500;'
      
        '11019289=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' '#1082 +
        #1072#1090#1077#1075#1086#1088#1080#1080'/'#1082#1083#1080#1077#1085#1090#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RET' +
        'URNING_VALUES (:ERR_MSG);'
      '11019290=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11019291=  end'
      '11019292=end'
      '11019293=;'
      '11019294='
      '11019295=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '11019296=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11019297=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '11019298=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '11019299=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110192100=RETURNS ('
      '110192101=  ERR_CODE INTEGER,'
      '110192102=  ERR_MSG VARCHAR(1024))'
      '110192103=AS'
      
        '110192104=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODU' +
        'CT'#39';'
      '110192105=DECLARE VARIABLE CNT_ INTEGER;'
      '110192106=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110192107=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110192108=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110192109=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110192110=BEGIN'
      '110192111=  /*IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110192112=                FROM G_PRODUCT'
      
        '110192113=               WHERE G_PRODUCT_PAR = :G_PRODUCT_)) the' +
        'n BEGIN'
      '110192114=    ERR_CODE = -20500;'
      
        '110192115=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076 +
        #1072#1083#1080#1090#1100' '#1076#1072#1085#1085#1091#1102' '#1075#1088#1091#1087#1087#1091', '#1090'.'#1082'. '#1074' '#1085#1077#1081' '#1089#1086#1089#1090#1086#1103#1090' '#1090#1086#1074#1072#1088#1099'/'#1075#1088#1091#1087#1087#1099'. '#1059#1076#1072#1083#1080#1090#1077' '#1074 +
        #1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110192116=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110192117=    EXIT;'
      '110192118=  END'
      '110192119=  */'
      '110192120='
      
        '110192121=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', '#39 +
        ')'
      '110192122=                    FROM g_product_kit K, g_product g'
      
        '110192123=                   WHERE K.g_product_item = :G_PRODUCT' +
        '_'
      
        '110192124=                     and k.g_product = g.g_product) FR' +
        'OM 1 FOR 999)'
      '110192125=  FROM RDB$DATABASE'
      '110192126=   INTO :PROD_NAME_;'
      '110192127=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '110192128=    ERR_CODE = -20500;'
      
        '110192129=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083#1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'. '#1059#1076#1072#1083#1080#1090 +
        #1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110192130=                                  '#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090 +
        #1077' '#1077#1075#1086' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1072' '#1090#1086#1074#1072#1088#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110192131=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110192132=    EXIT;'
      '110192133=  END'
      '110192134='
      
        '110192135=  /*SELECT ZA.zakaz||'#39' '#1086#1090' '#39'||lpad(extract(day from ZA.' +
        'Z_DATE),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from ZA.Z_DATE),2,'#39'0' +
        #39') || '#39'.'#39' || extract(year from ZA.Z_DATE)'
      '110192136=    FROM ZAKAZ ZA'
      '110192137=   WHERE ZA.zakaz = (SELECT MIN(Z.ZAKAZ)'
      '110192138=                        FROM ZAKAZ_DETAILS Z'
      
        '110192139=                       WHERE Z.G_PRODUCT = :G_PRODUCT_' +
        ')'
      '110192140=  INTO :NAKL_PROD_;'
      '110192141=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110192142=    ERR_CODE = -20500;'
      
        '110192143=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1091#1093#1086#1076#1072' ('#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110192144='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        #39'||'#39
      
        '110192145='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110192146=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110192147=    EXIT;'
      '110192148=  END'
      '110192149='
      
        '110192150=  SELECT SP.sklad||'#39' '#1086#1090' '#39'||lpad(extract(day from SP.da' +
        'te_receipt),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from SP.date_rec' +
        'eipt),2,'#39'0'#39') || '#39'.'#39' || extract(year from SP.date_receipt)'
      '110192151=    FROM sklad_parent SP'
      '110192152=   WHERE SP.sklad = ( SELECT MIN(S.sklad_parent)'
      '110192153=                        FROM sklad s'
      
        '110192154=                       WHERE s.G_PRODUCT = :G_PRODUCT_' +
        ')'
      '110192155=    INTO :NAKL_PROD_;'
      '110192156=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110192157=    ERR_CODE = -20500;'
      
        '110192158=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1087#1088#1080#1093#1086#1076#1072' ('#1086#1087#1088#1080#1093#1086#1076#1086#1074#1072#1085#1080#1077'/'#1074#1086#1079#1074#1088#1072#1090'/'#1087#1077#1088#1077#1084 +
        #1077#1097#1077#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110192159='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        ' '#39'||'#39
      
        '110192160='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110192161=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110192162=    EXIT;'
      '110192163=  END'
      '110192164='
      
        '110192165=  SELECT lpad(extract(day from MIN(za.op_date)),2,'#39'0'#39')' +
        ' || '#39'.'#39' || lpad(extract(month from MIN(za.op_date)),2,'#39'0'#39') || '#39'.' +
        #39' || extract(year from MIN(za.op_date))'
      '110192166=    FROM OTHER ZA, OTHER_DETAILS Z'
      '110192167=   WHERE ZA.OTHER = Z.other'
      '110192168=     AND Z.G_PRODUCT = :G_PRODUCT_'
      '110192169=  INTO :NAKL_PROD_;'
      '110192170=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110192171=    ERR_CODE = -20500;'
      
        '110192172=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072' '#1086#1090' '#39'||NAKL_PROD_||'#39' '#1095#1080#1089#1083#1072'.' +
        ' '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110192173=                                  '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090 +
        #1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080 +
        #1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110192174=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110192175=    EXIT;'
      '110192176=  END'
      '110192177=  */'
      '110192178='
      '110192179=  SELECT G.NAME'
      '110192180=    FROM G_PRODUCT G'
      '110192181=   WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110192182=    INTO :NAME_;'
      '110192183='
      '110192184=  delete from LT_SKLAD_PRODUCT g'
      '110192185=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110192186='
      '110192187=  delete from lt_barcode g'
      '110192188=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110192189='
      '110192190=  delete from revision g'
      '110192191=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110192192='
      '110192193=  delete from g_product_image g'
      '110192194=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110192195='
      '110192196=  delete from g_product_KIT g'
      '110192197=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110192198='
      '110192199=  delete from G_DISCOUNT g'
      '110192200=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110192201='
      '110192202=  SELECT ('
      
        '110192203=          (SELECT COUNT(*) FROM ZAKAZ_DETAILS ZD WHERE' +
        ' ZD.G_PRODUCT = :G_PRODUCT_)'
      '110192204=          +'
      
        '110192205=          (SELECT COUNT(*) FROM SKLAD SD WHERE SD.G_PR' +
        'ODUCT = :G_PRODUCT_)'
      '110192206=          +'
      
        '110192207=          (SELECT COUNT(*) FROM OTHER_DETAILS OD WHERE' +
        ' OD.G_PRODUCT = :G_PRODUCT_)'
      '110192208=          +'
      
        '110192209=          (SELECT COUNT(*) FROM ZAKAZ_NA_REAL RD WHERE' +
        ' RD.G_PRODUCT = :G_PRODUCT_)'
      '110192210=         )'
      '110192211=    FROM RDB$DATABASE'
      '110192212=    INTO :CNT_;'
      '110192213='
      '110192214=  IF (CNT_ = 0) THEN'
      
        '110192215=    delete from G_PRODUCT g where g.G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '110192216=  ELSE'
      '110192217=    UPDATE G_PRODUCT G'
      '110192218=       SET G.IS_ACTIVE = 0,'
      '110192219=           G.G_PRODUCT_PAR = -1'
      '110192220=     WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110192221='
      '110192222=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110192223=  EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_PRO' +
        'DUCT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '110192224='
      
        '110192225=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051 +
        #1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110192226=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110192227=    UPDATE SYNC_EXT_APP AP'
      '110192228=       SET AP.OPER = 3'
      '110192229=     WHERE AP.OBJECT_TYPE = 4'
      '110192230=       AND AP.ID = :G_PRODUCT_'
      '110192231=       AND AP.IS_LOADING = 0;'
      '110192232='
      '110192233=    IF (ROW_COUNT = 0) THEN'
      
        '110192234=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110192235=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 3);'
      '110192236=  END'
      '110192237='
      '110192238=when sqlcode -530 DO'
      '110192239=  begin'
      '110192240=    SELECT G.IS_CATEGORY'
      '110192241=      FROM G_PRODUCT G'
      '110192242=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110192243=      INTO :IS_CATEGORY_;'
      '110192244='
      '110192245=    ERR_CODE = -20500;'
      '110192246=    if (IS_CATEGORY_ = 0) then'
      
        '110192247=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '110192248=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076 +
        #1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081 +
        #1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110192249=    ELSE'
      
        '110192250=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110192251=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110192252=  end'
      '110192253=end'
      '110192254=;'
      '110192255='
      '110192256=ALTER PROCEDURE G_DEL_G_PRODUCT_CAT('
      '110192257=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110192258=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110192259=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110192260=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110192261=RETURNS ('
      '110192262=  LOG_ BLOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      '110192263=  SUCCESS_CNT_ INTEGER,'
      '110192264=  FAIL_CNT_ INTEGER,'
      '110192265=  ERR_CODE INTEGER,'
      '110192266=  ERR_MSG VARCHAR(1024))'
      '110192267=AS'
      
        '110192268=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODU' +
        'CT_CAT'#39';'
      '110192269=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110192270=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110192271=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110192272=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110192273=DECLARE VARIABLE G_PRODUCT_CAT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110192274=DECLARE VARIABLE G_PRODUCT_LOC_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      '110192275=DECLARE VARIABLE LVL_ INTEGER;'
      '110192276=DECLARE VARIABLE STR1_ VARCHAR(500);'
      '110192277=DECLARE VARIABLE STR2_ VARCHAR(500);'
      
        '110192278=DECLARE VARIABLE CATEGORY_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      '110192279=DECLARE VARIABLE CRLF VARCHAR(5);'
      '110192280=BEGIN'
      '110192281=  LOG_ = '#39#39';'
      '110192282=  SUCCESS_CNT_ = 0;'
      '110192283=  FAIL_CNT_ = 0;'
      '110192284=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110192285='
      '110192286=  FOR WITH RECURSIVE TREE AS (SELECT T.G_PRODUCT,'
      '110192287=                                   1 LVL,'
      '110192288=                                   T.NAME'
      '110192289=                              FROM G_PRODUCT T'
      '110192290=                             WHERE T.IS_CATEGORY = 1'
      
        '110192291=                               AND T.G_PRODUCT = :G_PR' +
        'ODUCT_'
      '110192292=                            UNION ALL'
      '110192293=                            SELECT T.G_PRODUCT,'
      '110192294=                                   (GG.LVL + 1) LVL,'
      '110192295=                                   T.NAME'
      
        '110192296=                              FROM G_PRODUCT T INNER J' +
        'OIN TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '110192297=                             WHERE T.IS_CATEGORY = 1'
      '110192298=                        )'
      
        '110192299=    SELECT G_PRODUCT, LVL, NAME FROM TREE ORDER BY 2 D' +
        'ESC'
      '110192300=    INTO :G_PRODUCT_CAT_, :LVL_, :CATEGORY_NAME_'
      '110192301=  DO BEGIN'
      '110192302='
      
        '110192303=    -- '#1059#1044#1040#1051#1071#1070' '#1057#1053#1040#1063#1040#1051#1040' '#1058#1045#1061', '#1063#1058#1054' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061'/' +
        #1055#1056#1048#1061#1054#1044#1040#1061
      '110192304=    FOR SELECT P.G_PRODUCT,'
      '110192305=               '#39#1058#1086#1074#1072#1088' '#39'|| P.NAME,'
      
        '110192306=               '#39#1058#1086#1074#1072#1088' '#39'||P.NAME||'#39' (ID'#39' || P.G_PRODUCT' +
        ' || '#39'), '#1072#1088#1090#1080#1082#1091#1083' '#39'||P.ARTICUL'
      '110192307=        FROM G_PRODUCT P'
      '110192308=        WHERE G_PRODUCT_PAR = :G_PRODUCT_CAT_'
      
        '110192309=        AND EXISTS (SELECT 1 FROM ZAKAZ_DETAILS WHERE ' +
        'G_PRODUCT = P.G_PRODUCT'
      '110192310=                  UNION ALL'
      
        '110192311=                  SELECT 1 FROM SKLAD SD WHERE SD.G_PR' +
        'ODUCT = P.G_PRODUCT'
