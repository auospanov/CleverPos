      '11042792=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '11042793=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046#1040 +
