        '1101825611=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101825612=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825613=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
