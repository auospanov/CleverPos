        '1102112598='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1102112599='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1102112600='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1102112601=*/'
      
        '1102112602=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1102112603=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102112604=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1102112605=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1102112606=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1102112607=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1102112608=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1102112609=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1102112610=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1102112611=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102112612=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1102112613=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1102112614=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1102112615=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1102112616=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102112617=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102112618=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102112619=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102112620=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1102112621=BEGIN'
      '1102112622='
      '1102112623=  PNT_ = '#39'00'#39';'
      '1102112624=  CLRF = ascii_char( 10 );'
      '1102112625='
      '1102112626=  SELECT S.S_VALUE'
      '1102112627=    FROM SYSTEM_SETUP S'
      '1102112628=   WHERE S.SYSTEM_SETUP = 2'
      '1102112629=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1102112630='
      '1102112631=  PNT_ = '#39'01'#39';'
      '1102112632=  SELECT G.nds_value'
      '1102112633=    FROM G_FIRM_REKVIZIT G'
      '1102112634=   WHERE G.is_default = 1'
      '1102112635=    INTO :NDS_;'
      '1102112636='
      '1102112637=  PNT_ = '#39'02'#39';'
      
        '1102112638=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1102112639=        FROM IMPORT_TBL_TMP'
      
        '1102112640=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1102112641=  DO BEGIN'
      '1102112642=    SELECT G_PRODUCT,'
      '1102112643=           PRICE'
      '1102112644=      FROM ('
      '1102112645=            SELECT P.G_PRODUCT, P.price'
      '1102112646=              FROM G_PRODUCT P'
      
        '1102112647=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1102112648=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1102112649=            UNION'
      '1102112650=            SELECT LT.G_PRODUCT, P.PRICE'
      '1102112651=              FROM LT_BARCODE LT, g_product P'
      
        '1102112652=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1102112653=               AND LT.g_product = P.g_product'
      '1102112654=           )'
      '1102112655=      INTO :G_PRODUCT_,'
      '1102112656=           :PRICE_OUR_;'
      '1102112657='
      '1102112658=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1102112659=      ERR_CODE = -20500;'
      
        '1102112660=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1102112661=      Exit;'
      '1102112662=    END'
      '1102112663='
      '1102112664=    PNT_ = '#39'03'#39';'
      
        '1102112665=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1102112666=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1102112667=      RETURNING_VALUES :COST_PRICE_;'
      '1102112668='
      '1102112669=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1102112670=    IF (price_ IS NULL) THEN'
      '1102112671=      PRICE_ = PRICE_OUR_;'
      '1102112672='
      '1102112673=    PNT_ = '#39'04'#39';'
      
        '1102112674=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1102112675=                                              :AMOUNT' +
        '_,'
      
        '1102112676=                                              :PRICE_' +
        ','
      
        '1102112677=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1102112678=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1102112679=                                              :DISCOU' +
        'NT_,'
      
        '1102112680=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1102112681=                                              :NDS_,'
      
        '1102112682=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1102112683=                                              :COST_P' +
        'RICE_,'
      
        '1102112684=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1102112685=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1102112686=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1102112687=                                              0     -' +
        '-MODE_'
      
        '1102112688=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1102112689=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102112690=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102112691=      EXIT;'
      '1102112692=    END'
      '1102112693='
      '1102112694=    G_PRODUCT_ = NULL;'
      '1102112695=  END'
      '1102112696='
      '1102112697=  PNT_ = '#39'05'#39';'
      '1102112698=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1102112699=    SELECT SUM(T.summ)'
      '1102112700=      FROM ZAKAZ_DETAILS_TMP T'
      '1102112701=      INTO :SUMM_;'
      '1102112702=    SUMM_FACT_ = SUMM_;'
      '1102112703=  END'
      '1102112704='
      '1102112705=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1102112706=  if (G_PAYMENT_TYPE_ = 1) then'
      '1102112707=    SUMM_CASH_ = summ_fact_;'
      '1102112708=  ELSE'
      '1102112709=    SUMM_NONCASH_ = summ_fact_;'
      '1102112710='
      '1102112711=  PNT_ = '#39'06'#39';'
      '1102112712=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1102112713=    G_CLIENT_ = 10;'
      '1102112714='
      '1102112715=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102112716=                              :Z_DATE_,'
      '1102112717=                              :Z_TIME_,'
      '1102112718=                              :G_CLIENT_,'
      '1102112719=                              :G_PAYMENT_TYPE_,'
      '1102112720=                              '#39#39', --:OSNOVANIE_,'
      '1102112721=                              0,  -- IS_SPISANIE'
      
        '1102112722=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1102112723=                              :SUMM_,'
      '1102112724=                              :SUMM_FACT_,'
      '1102112725=                              :SUMM_CASH_,'
      '1102112726=                              :SUMM_NONCASH_,'
      
        '1102112727=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1102112728=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1102112729=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1102112730=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1102112731=                              0,    -- :BY_RECIPE__,'
      '1102112732=                              0,    -- IS_RESERVE__'
      '1102112733=                              NULL -- :PAYMENTS__'
      '1102112734=                              )'
      
        '1102112735=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102112736=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102112737=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102112738=    EXIT;'
      '1102112739=  END'
      '1102112740='
      '1102112741=  DELETE FROM import_tbl_tmp;'
      '1102112742='
      '1102112743=WHEN ANY DO BEGIN'
      '1102112744=    ERR_CODE = gdscode;'
      
        '1102112745=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1102112746=  END'
      '1102112747=end'
      '1102112748=;'
      '1102112749='
      '1102112750=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1102112751=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102112752=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102112753=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102112754=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102112755=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102112756=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102112757=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102112758=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102112759=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102112760=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102112761=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102112762=RETURNS ('
      '1102112763=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102112764=  ERR_CODE INTEGER,'
      '1102112765=  ERR_MSG VARCHAR(1024))'
      '1102112766=AS'
      
        '1102112767=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1102112768=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1102112769=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102112770=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1102112771='
      
        '1102112772=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102112773=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1102112774=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1102112775=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102112776=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102112777=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102112778=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1102112779=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1102112780=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1102112781=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1102112782=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102112783=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1102112784=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1102112785=BEGIN'
      '1102112786='
      '1102112787=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102112788=    SELECT ID'
      '1102112789=      FROM CUR_PARAMS'
      '1102112790=     WHERE CUR_PARAMS = 2'
      '1102112791=      INTO :G_TOCHKA_;'
      '1102112792='
      
        '1102112793=  --*************************************************' +
        '*************************************************'
      
        '1102112794=  --*************************************************' +
        '*************************************************'
      '1102112795=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102112796=  --*************************************************' +
        '*************************************************'
      
        '1102112797=  --*************************************************' +
        '*************************************************'
      '1102112798=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1102112799=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1102112800=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1102112801=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102112802=            INTO :AMOUNT_,'
      '1102112803=                 :G_PRODUCT_'
      '1102112804=      DO BEGIN'
      '1102112805=          UPDATE LT_SKLAD_PRODUCT L'
      
        '1102112806=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_      ' +
        '-- 03.03.2021 '#1057#1070#1044#1040' '#1053#1045' '#1057#1058#1040#1051' '#1057#1058#1040#1042#1048#1058#1068' NEED_TO_REPLACE '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1047#1040 +
        #1063#1045#1052
      '1102112807=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102112808=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102112809=      END'
      '1102112810='
      '1102112811=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1102112812=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1102112813=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1102112814=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1102112815=             NDS_SUMM, COST_PRICE'
      '1102112816=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102112817='
      '1102112818=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102112819=                                  :Z_DATE_,'
      '1102112820=                                  :Z_TIME_,'
      '1102112821=                                  :G_CLIENT_,'
      '1102112822=                                  :G_PAYMENT_TYPE_,'
      '1102112823=                                  :OSNOVANIE_,'
      
        '1102112824=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1102112825=                                  :NOTE_,'
      
        '1102112826=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1102112827=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1102112828=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1102112829=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1102112830=                                  0, --SUMM_BONUS_'
      
        '1102112831=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1102112832=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102112833=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1102112834=                                  0,    --BY_RECIPE'
      '1102112835=                                  0     --IS_RESERVE'
      '1102112836=                                  ,NULL  -- PAYMENTS_'
      '1102112837=                                  ,0     --IS_MEBEL_'
      
        '1102112838=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1102112839=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1102112840=                                  ,NULL  --ADDRESS_'
      '1102112841=                                  ,NULL  --PRICE_'
      
        '1102112842=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      '1102112843=                                  )'
      '1102112844=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102112845='
      '1102112846=      if (ERR_CODE <> 0) then BEGIN'
      '1102112847=        ERR_CODE = -20500;'
      '1102112848=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102112849=        Exit;'
      '1102112850=      END'
      '1102112851='
      
        '1102112852=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102112853=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1102112854=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1102112855=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1102112856=      UPDATE ZAKAZ'
      '1102112857=         SET IS_SPISANIE = 2'
      '1102112858=       WHERE ZAKAZ = :ZAKAZ_;'
      '1102112859='
      
        '1102112860=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102112861=      FOR SELECT T.AMOUNT,'
      '1102112862=                 T.SUMM,'
      '1102112863=                 T.G_PRODUCT,'
      '1102112864=                 T.ZAKAZ_NA_REAL,'
      '1102112865=                 T.ZAKAZ_DETAILS'
      '1102112866=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102112867=            INTO :AMOUNT_,'
      '1102112868=                 :Z_SUMM_,'
      '1102112869=                 :G_PRODUCT_,'
      '1102112870=                 :ZAKAZ_NA_REAL_,'
      '1102112871=                 :ZAKAZ_DETAILS_'
      '1102112872=      DO BEGIN'
      '1102112873=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102112874=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1102112875=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1102112876=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102112877=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102112878='
      
        '1102112879=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102112880=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1102112881=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1102112882=      END'
      '1102112883=  END'
      '1102112884=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102112885=  --*************************************************' +
        '*************************************************'
      
        '1102112886=  --*************************************************' +
        '*************************************************'
      '1102112887='
      
        '1102112888=  --*************************************************' +
        '*************************************************'
      
        '1102112889=  --*************************************************' +
        '*************************************************'
      '1102112890=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102112891=  --*************************************************' +
        '*************************************************'
      
        '1102112892=  --*************************************************' +
        '*************************************************'
      '1102112893=  ELSE BEGIN'
      '1102112894=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1102112895=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102112896=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102112897=      FOR SELECT T.AMOUNT,'
      '1102112898=                 T.SUMM,'
      '1102112899=                 T.G_PRODUCT,'
      '1102112900=                 T.ZAKAZ_NA_REAL,'
      '1102112901=                 T.ZAKAZ_DETAILS'
      '1102112902=                 ,T.PRICE'
      '1102112903=                 ,T.NDS'
      '1102112904=                 ,T.NDS_SUMM'
      '1102112905=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102112906=            INTO :AMOUNT_,'
      '1102112907=                 :Z_SUMM_,'
      '1102112908=                 :G_PRODUCT_,'
      '1102112909=                 :ZAKAZ_NA_REAL_,'
      '1102112910=                 :ZAKAZ_DETAILS_'
      '1102112911=                 ,:PRICE_'
      '1102112912=                 ,:NDS_'
      '1102112913=                 ,:NDS_SUMM_'
      '1102112914=      DO BEGIN'
      
        '1102112915=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102112916=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1102112917='
      
        '1102112918=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1102112919=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1102112920='
      '1102112921=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102112922=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1102112923=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1102112924=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102112925=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102112926=      END'
      '1102112927='
      '1102112928=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102112929=                                  :Z_DATE_,'
      '1102112930=                                  :Z_TIME_,'
      '1102112931=                                  :G_CLIENT_,'
      '1102112932=                                  :G_PAYMENT_TYPE_,'
      '1102112933=                                  :OSNOVANIE_,'
      '1102112934=                                  :NOTE_,'
      
        '1102112935=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1102112936=                                  :SUMM_,'
      '1102112937=                                  :SUMM_FACT_,'
      
        '1102112938=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1102112939=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1102112940=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1102112941=                                  ,0        --SUMM_CU' +
        'RRENCY_'
      
        '1102112942=                                  ,0        --IS_EXPE' +
        'CTED_'
      
        '1102112943=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      
        '1102112944=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102112945='
      '1102112946=      if (ERR_CODE <> 0) then BEGIN'
      '1102112947=        ERR_CODE = -20500;'
      '1102112948=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102112949=        Exit;'
      '1102112950=      END'
      '1102112951=  END'
      '1102112952=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102112953=  --*************************************************' +
        '*************************************************'
      
        '1102112954=  --*************************************************' +
        '*************************************************'
      '1102112955='
      '1102112956=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102112957=END'
      '1102112958=;'
      '1102112959='
      '1102112960=ALTER PROCEDURE R_MADE_REVISION('
      
        '1102112961=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102112962=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102112963=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102112964=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102112965=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102112966=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '1102112967=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102112968=RETURNS ('
      '1102112969=  COUNT_SPIS_ INTEGER,'
      '1102112970=  COUNT_PRIH_ INTEGER,'
      
        '1102112971=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT' +
        '.REVISION_PARENT,'
      '1102112972=  ERR_CODE INTEGER,'
      '1102112973=  ERR_MSG VARCHAR(1024))'
      '1102112974=AS'
      
        '1102112975=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVIS' +
        'ION'#39';'
      '1102112976=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102112977=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102112978=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102112979=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102112980=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102112981=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102112982=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102112983=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102112984=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102112985=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      
        '1102112986=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REV' +
        'ISION.DATETIME_CREATED;'
      
        '1102112987=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.AMOUNT;'
      '1102112988=BEGIN'
      '1102112989='
      '1102112990=  COUNT_SPIS_ = 0;'
      '1102112991=  COUNT_PRIH_ = 0;'
      '1102112992='
      '1102112993=  PNT_ = '#39'00'#39';'
      '1102112994=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '1102112995=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGI' +
        'N_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '1102112996=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102112997='
      '1102112998=     IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102112999=       ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '1102113000=       EXIT;'
      '1102113001=     END'
      '1102113002=  END'
      '1102113003='
      '1102113004=  PNT_ = '#39'01'#39';'
      
        '1102113005=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL, DATETIME_CREATED'
      '1102113006=      FROM REVISION_TMP'
      '1102113007=      --WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102113008=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_, :DATETIME_CREATED_'
      '1102113009=  DO BEGIN'
      '1102113010=    /*SELECT SUM(ZD.AMOUNT)'
      '1102113011=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102113012=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ A' +
        'S DATE) AND CURRENT_DATE'
      
        '1102113013=       AND Z.Z_TIME >= CAST(:DATETIME_CREATED_ AS TIM' +
        'E)'
      '1102113014=       AND Z.Z_TIME <= CURRENT_TIME'
      '1102113015=       AND Z.IS_SPISANIE IN (0, 1)'
      '1102113016=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102113017=      INTO :AMOUNT_SALED_;*/'
      '1102113018='
      '1102113019=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '1102113020=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102113021=        RETURNING_VALUES :COST_PRICE_;'
      '1102113022='
      
        '1102113023=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102113024=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102113025=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/, :COST_PRICE_' +
        ', :COST_PRICE_ * (:AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_' +
        '*/), 0, 0, 0, 0, 0);'
      '1102113026='
      '1102113027=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102113028=    END'
      '1102113029='
      '1102113030=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      '1102113031=      SELECT S.price'
      '1102113032=        FROM SKLAD S'
      '1102113033=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102113034=         AND S.g_product = :G_PRODUCT_'
      '1102113035=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102113036=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102113037=                                 FROM SKLAD DD'
      
        '1102113038=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102113039=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102113040=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102113041=                                )'
      '1102113042=        ORDER BY s.sklad DESC'
      '1102113043=        ROWS 1 TO 1'
      '1102113044=        INTO :PRICE_LAST_;'
      '1102113045='
      
        '1102113046=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102113047='
      
        '1102113048=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102113049=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/, :PRICE_LAST_' +
        ', (:AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/) * :PRICE_LA' +
        'ST_, 0, 0);'
      '1102113050='
      '1102113051=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102113052=    END'
      '1102113053=  END'
      '1102113054='
      '1102113055=  PNT_ = '#39'01A'#39';'
      '1102113056=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102113057=    SELECT SUM(S.SUMM)'
      '1102113058=      FROM ZAKAZ_DETAILS_TMP S'
      '1102113059=      INTO :SUMM_;'
      '1102113060='
      '1102113061=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102113062=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102113063=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102113064=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102113065=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102113066=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102113067=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102113068=                                NULL,           --:NO' +
        'TE_,'
      
        '1102113069=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102113070=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102113071=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102113072=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102113073=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102113074=                                NULL,'
      
        '1102113075=                                0,        -- BY_RECIP' +
        'E'
      
        '1102113076=                                0         -- IS_RESER' +
        'VE'
      '1102113077=                                ,NULL  -- PAYMENTS_'
      '1102113078=                                ,0     -- SUMM_CASH'
      
        '1102113079=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102113080=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102113081=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102113082=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102113083=      EXIT;'
      '1102113084=    END'
      '1102113085=  END'
      '1102113086='
      '1102113087=  PNT_ = '#39'02'#39';'
      '1102113088=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102113089=    SELECT SUM(S.SUMM)'
      '1102113090=      FROM SKLAD_TMP S'
      '1102113091=      INTO :SUMM_;'
      '1102113092='
      '1102113093=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102113094=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102113095=                                CURRENT_TIME,'
      
        '1102113096=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102113097=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102113098=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102113099=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102113100=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102113101=                                :SUMM_,'
      '1102113102=                                :SUMM_,'
      
        '1102113103=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102113104=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102113105=                                ,NULL  --PAYMENTS'
      '1102113106=                                )'
      
        '1102113107=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102113108=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102113109=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102113110=      EXIT;'
      '1102113111=    END'
      '1102113112=  END'
      '1102113113='
      '1102113114=  UPDATE REVISION_PARENT RP'
      '1102113115=     SET RP.IS_MADE = 1,'
      '1102113116=         RP.DATE_END = :DATE_END_,'
      '1102113117=         RP.TIME_END = :TIME_END_'
      '1102113118=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '1102113119='
      '1102113120=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '1102113121=END'
      '1102113122=;'
      '1102113123='
      '1102113124=ALTER PROCEDURE R_UNIFICATION('
      '1102113125=  MODE_ INTEGER)'
      '1102113126=RETURNS ('
      '1102113127=  COUNT_SPIS_ INTEGER,'
      '1102113128=  COUNT_PRIH_ INTEGER,'
      '1102113129=  ERR_CODE INTEGER,'
      '1102113130=  ERR_MSG VARCHAR(1024))'
      '1102113131=AS'
      
        '1102113132=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1102113133=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102113134=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102113135=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102113136=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102113137=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102113138=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102113139=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102113140=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102113141=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102113142=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102113143=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102113144=BEGIN'
      '1102113145='
      '1102113146=  COUNT_SPIS_ = 0;'
      '1102113147=  COUNT_PRIH_ = 0;'
      '1102113148='
      '1102113149=  SELECT ID'
      '1102113150=    FROM CUR_PARAMS'
      '1102113151=   WHERE CUR_PARAMS = 2'
      '1102113152=    INTO :G_TOCHKA_;'
      '1102113153='
      
        '1102113154=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1102113155=      FROM REVISION'
      '1102113156=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1102113157=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1102113158=  DO BEGIN'
      
        '1102113159=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1102113160=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102113161=        RETURNING_VALUES :COST_PRICE_;'
      '1102113162='
      
        '1102113163=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102113164=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102113165=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1102113166='
      '1102113167=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102113168=    END'
      '1102113169='
      
        '1102113170=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1102113171=      SELECT S.price'
      '1102113172=        FROM SKLAD S'
      '1102113173=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102113174=         AND S.g_product = :G_PRODUCT_'
      '1102113175=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102113176=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102113177=                                 FROM SKLAD DD'
      
        '1102113178=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102113179=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102113180=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102113181=                                )'
      '1102113182=        ORDER BY s.sklad DESC'
      '1102113183=        ROWS 1 TO 1'
      '1102113184=        INTO :PRICE_LAST_;'
      '1102113185='
      '1102113186=    /* SELECT S.PRICE'
      '1102113187=        FROM SKLAD S'
      '1102113188=       WHERE S.IS_LAST = 1'
      '1102113189=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1102113190=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1102113191=        INTO :PRICE_LAST_; */'
      '1102113192='
      
        '1102113193=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102113194='
      
        '1102113195=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102113196=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1102113197='
      '1102113198=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102113199=    END'
      '1102113200='
      '1102113201=    UPDATE REVISION R'
      '1102113202=       SET R.IS_UNIFIED = 1'
      '1102113203=     WHERE R.REVISION = :REVISION_;'
      '1102113204=  END'
      '1102113205='
      '1102113206=  PNT_ = '#39'01'#39';'
      '1102113207=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102113208=    SELECT SUM(S.SUMM)'
      '1102113209=      FROM ZAKAZ_DETAILS_TMP S'
      '1102113210=      INTO :SUMM_;'
      '1102113211='
      '1102113212=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102113213=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102113214=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102113215=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102113216=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102113217=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102113218=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102113219=                                NULL,           --:NO' +
        'TE_,'
      
        '1102113220=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102113221=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102113222=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102113223=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102113224=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102113225=                                NULL,'
      
        '1102113226=                                0,        -- BY_RECIP' +
        'E'
      
        '1102113227=                                0         -- IS_RESER' +
        'VE'
      '1102113228=                                ,NULL  -- PAYMENTS_'
      '1102113229=                                ,0     -- SUMM_CASH'
      
        '1102113230=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102113231=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102113232=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102113233=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102113234=      EXIT;'
      '1102113235=    END'
      '1102113236=  END'
      '1102113237='
      '1102113238=  PNT_ = '#39'02'#39';'
      '1102113239=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102113240=    SELECT SUM(S.SUMM)'
      '1102113241=      FROM SKLAD_TMP S'
      '1102113242=      INTO :SUMM_;'
      '1102113243='
      '1102113244=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102113245=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102113246=                                CURRENT_TIME,'
      
        '1102113247=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102113248=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102113249=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102113250=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102113251=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102113252=                                :SUMM_,'
      '1102113253=                                :SUMM_,'
      
        '1102113254=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102113255=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102113256=                                ,NULL  --PAYMENTS'
      '1102113257=                                )'
      
        '1102113258=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102113259=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102113260=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102113261=      EXIT;'
      '1102113262=    END'
      '1102113263=  END'
      '1102113264=END'
      '1102113265=;'
      '1102113266='
      '1102113267=ALTER PROCEDURE UPSERT_ZAKAZ_EXT_LOAD('
      '1102113268=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102113269=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102113270=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102113271=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102113272=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102113273=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102113274=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102113275=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102113276=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102113277=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102113278=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102113279=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102113280=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102113281=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102113282=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102113283=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102113284=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102113285=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102113286=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102113287=  IS_MEBEL_ INTEGER = 0,'
      
        '1102113288=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1102113289=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      
        '1102113290=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      '1102113291=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1102113292=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102113293=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102113294=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102113295=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102113296=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102113297=  REC_ID_ TYPE OF COLUMN ZAKAZ.REC_ID = NULL)'
      '1102113298=RETURNS ('
      '1102113299=  ERR_CODE INTEGER,'
      '1102113300=  ERR_MSG VARCHAR(1024))'
      '1102113301=AS'
      '1102113302=/*'
      
        '1102113303=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1055#1056#1048#1061#1054#1044#1040' '#1048#1047' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071' ' +
        '- '#1052#1054#1041#1048#1051#1050#1048' '#1048#1051#1048' '#1057#1040#1049#1058#1040
      
        '1102113304=-- '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1058#1040#1050#1054#1049' ID - '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1054' '#1054#1041#1053 +
        #1054#1042#1051#1071#1070', '#1053#1045#1058' - '#1058#1040#1050' '#1042#1057#1058#1040#1042#1051#1071#1070
      '1102113305=*/'
      
        '1102113306=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'UPSERT_ZAKAZ' +
        '_EXT_LOAD'#39';'
      '1102113307=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102113308=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        'NULL;'
      '1102113309=BEGIN'
      '1102113310='
      '1102113311=  PNT_ = '#39'00'#39';'
      '1102113312='
      '1102113313=  SELECT SP.ZAKAZ'
      '1102113314=    FROM ZAKAZ SP'
      '1102113315=   WHERE SP.REC_ID = :REC_ID_'
      '1102113316=    INTO :ZAKAZ_;'
      '1102113317='
      '1102113318=  IF (ZAKAZ_ IS NULL) THEN BEGIN'
      '1102113319='
      '1102113320=    PNT_ = '#39'01'#39';'
      
        '1102113321=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_, :Z_DATE_,' +
        ' :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :IS_SPISAN' +
        'IE_,'
      
        '1102113322=        :NOTE_, :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SU' +
        'MM_NONCASH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_P' +
        'RIHOD_,'
      
        '1102113323=        :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_, :IS_ME' +
        'BEL_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_,'
      
        '1102113324=        :UPLOAD_TO_EXT_APP_, :G_OFFICIAL_, :NOT_MINUS' +
        '_OSTATOK_, :USER_ID_, :LOG_BODY_, :REC_ID_)'
      
        '1102113325=        RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102113326='
      '1102113327=  END'
      '1102113328=  ELSE BEGIN'
      '1102113329='
      '1102113330=    PNT_ = '#39'02'#39';'
      
        '1102113331=    EXECUTE PROCEDURE UPDATE_ZAKAZ_DETAIL(:ZAKAZ_, :Z' +
        '_DATE_, :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NO' +
        'TE_,'
      
        '1102113332=        :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SUMM_NONCA' +
        'SH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_PRIHOD_,'
      
        '1102113333=        :IS_SPISANIE_, :BY_RECIPE_, :IS_RESERVE_, :PA' +
        'YMENTS_, :UPLOAD_TO_EXT_APP_, :NOT_MINUS_OSTATOK_, :ADDRESS_,'
      '1102113334=        :USER_ID_, :LOG_BODY_)'
      '1102113335=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102113336='
      '1102113337=  END'
      '1102113338='
      '1102113339=  IF (:ERR_CODE <> 0) THEN'
      
        '1102113340=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102113341='
      '1102113342=END'
      '1102113343=;'
      
        '1102113344=ALTER TABLE G_NONCASH_PAY_TYPE ADD CONSTRAINT PK_G_NO' +
        'NCASH_PAY_TYPE PRIMARY KEY (G_NONCASH_PAY_TYPE);'
      '1102113345='
      
        '1102113346=UPDATE SYSTEM_SETUP SET S_VALUE = 110211 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102113347=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
