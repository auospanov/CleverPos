      '11074681=                          WHERE S.G_CLIENT = :G_CLIENT_'
      
        '11074682=                            AND S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11074683=                            AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '11074684=                            AND S.DATE_RECEIPT BETWEEN ' +
        ':DATE_BEGIN_ AND :DATE_END_) AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11074685=                  OR'
      '11074686=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '11074687=       ORDER BY 2, 3, 1'
      '11074688=    INTO :REC_G_PRODUCT_,'
      '11074689=        :PATH_,'
      '11074690=        :GNAME_,'
      '11074691=        :REC_AMOUNT_IN_,'
      '11074692=        :REC_AMOUNT_PRIHOD_,'
      '11074693=        :REC_SUMM_PRIHOD_,'
      '11074694=        :REC_AMOUNT_UHOD_,'
      '11074695=        :REC_SUMM_UHOD_,'
      '11074696=        :REC_AMOUNT_SPISANO_,'
      '11074697=        :REC_SUMM_SPISANO_,'
      '11074698=        :REC_AMOUNT_VOZVRAT_,'
      '11074699=        :REC_SUMM_VOZVRAT_,'
      '11074700=        :REC_AMOUNT_PRIHOD_SKL_,'
      '11074701=        :REC_SUMM_PRIHOD_SKL_,'
      '11074702=        :REC_AMOUNT_UHOD_SKL_,'
      '11074703=        :REC_SUMM_UHOD_SKL_,'
      '11074704=        :REC_AMOUNT_OUT_'
      '11074705=    DO BEGIN'
      '11074706=      IF (PATH_OLD_ <> PATH_) THEN BEGIN'
      
        '11074707=        IF (PATH_OLD_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1053 +
        #1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11074708=            -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11074709=            INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11074710=              (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUN' +
        'T_PRIHOD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, S' +
        'UMM_SPISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '11074711=              AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUN' +
        'T_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '11074712=            VALUES'
      
        '11074713=              (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -' +
        '100, :AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_,' +
        ' :AMOUNT_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVR' +
        'AT_,'
      
        '11074714=              :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :' +
        'AMOUNT_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '11074715='
      '11074716=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '11074717=            AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + A' +
        'MOUNT_PRIHOD_;'
      
        '11074718=            SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUM' +
        'M_PRIHOD_;'
      
        '11074719=            AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMO' +
        'UNT_UHOD_;'
      
        '11074720=            SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_' +
        'UHOD_;'
      
        '11074721=            AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ +' +
        ' AMOUNT_SPISANO_;'
      
        '11074722=            SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + S' +
        'UMM_SPISANO_;'
      
        '11074723=            AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ +' +
        ' AMOUNT_VOZVRAT_;'
      
        '11074724=            SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + S' +
        'UMM_VOZVRAT_;'
      
        '11074725=            AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_' +
        'ALL_ + AMOUNT_PRIHOD_SKL_;'
      
        '11074726=            SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_AL' +
        'L_ + SUMM_PRIHOD_SKL_;'
      
        '11074727=            AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_AL' +
        'L_ + AMOUNT_UHOD_SKL_;'
      
        '11074728=            SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_' +
        ' + SUMM_UHOD_SKL_;'
      '11074729='
      '11074730=            AMOUNT_PRIHOD_  = 0;'
      '11074731=            SUMM_PRIHOD_    = 0;'
      '11074732=            AMOUNT_UHOD_    = 0;'
      '11074733=            SUMM_UHOD_      = 0;'
      '11074734=            AMOUNT_SPISANO_ = 0;'
      '11074735=            SUMM_SPISANO_   = 0;'
      '11074736=            AMOUNT_VOZVRAT_ = 0;'
      '11074737=            SUMM_VOZVRAT_   = 0;'
      '11074738=            AMOUNT_PRIHOD_SKL_ = 0;'
      '11074739=            SUMM_PRIHOD_SKL_   = 0;'
      '11074740=            AMOUNT_UHOD_SKL_   = 0;'
      '11074741=            SUMM_UHOD_SKL_     = 0;'
      '11074742=        END'
      '11074743='
      '11074744=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11074745=        INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      '11074746=          (P_REP_TOVAR_MOVE_TABLE, NAME, IS_HEAD)'
      '11074747=        VALUES'
      
        '11074748=          (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), :PATH' +
        '_, 1);'
      '11074749=      END'
      '11074750='
      '11074751=      INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11074752=        (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, NAME, AMOUN' +
        'T_IN, AMOUNT_PRIHOD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT' +
        '_SPISANO, SUMM_SPISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '11074753=        AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHOD' +
        '_SKL, SUMM_UHOD_SKL,  AMOUNT_OUT, IS_HEAD)'
      '11074754=      VALUES'
      
        '11074755=        (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), :REC_G_' +
        'PRODUCT_, :GNAME_, :REC_AMOUNT_IN_, :REC_AMOUNT_PRIHOD_, :REC_SU' +
        'MM_PRIHOD_, :REC_AMOUNT_UHOD_, :REC_SUMM_UHOD_, :REC_AMOUNT_SPIS' +
        'ANO_, :REC_SUMM_SPISANO_, :REC_AMOUNT_VOZVRAT_, :REC_SUMM_VOZVRA' +
        'T_,'
      
        '11074756=        :REC_AMOUNT_PRIHOD_SKL_, :REC_SUMM_PRIHOD_SKL_,' +
        ' :REC_AMOUNT_UHOD_SKL_, :REC_SUMM_UHOD_SKL_,'
      '11074757=        :REC_AMOUNT_OUT_,'
      '11074758=        0);'
      '11074759='
      
        '11074760=      AMOUNT_PRIHOD_  = AMOUNT_PRIHOD_ + REC_AMOUNT_PRI' +
        'HOD_;'
      
        '11074761=      SUMM_PRIHOD_    = SUMM_PRIHOD_   + REC_SUMM_PRIHO' +
        'D_;'
      
        '11074762=      AMOUNT_UHOD_    = AMOUNT_UHOD_   + REC_AMOUNT_UHO' +
        'D_;'
      
        '11074763=      SUMM_UHOD_      = SUMM_UHOD_     + REC_SUMM_UHOD_' +
        ';'
      
        '11074764=      AMOUNT_SPISANO_ = AMOUNT_SPISANO_  + REC_AMOUNT_S' +
        'PISANO_;'
      
        '11074765=      SUMM_SPISANO_   = SUMM_SPISANO_    + REC_SUMM_SPI' +
        'SANO_;'
      
        '11074766=      AMOUNT_VOZVRAT_ = AMOUNT_VOZVRAT_  + REC_AMOUNT_V' +
        'OZVRAT_;'
      
        '11074767=      SUMM_VOZVRAT_      = SUMM_VOZVRAT_    + REC_SUMM_' +
        'VOZVRAT_;'
      
        '11074768=      AMOUNT_PRIHOD_SKL_ = AMOUNT_PRIHOD_SKL_ + REC_AMO' +
        'UNT_PRIHOD_SKL_;'
      
        '11074769=      SUMM_PRIHOD_SKL_   = SUMM_PRIHOD_SKL_ + REC_SUMM_' +
        'PRIHOD_SKL_;'
      
        '11074770=      AMOUNT_UHOD_SKL_   = AMOUNT_UHOD_SKL_ + REC_AMOUN' +
        'T_UHOD_SKL_;'
      
        '11074771=      SUMM_UHOD_SKL_     = SUMM_UHOD_SKL_ + REC_SUMM_UH' +
        'OD_SKL_;'
      '11074772='
      '11074773=      PATH_OLD_ = PATH_;'
      '11074774=    END'
      '11074775='
      '11074776=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11074777=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11074778=      (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '11074779=       AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHOD_' +
        'SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '11074780=    VALUES'
      
        '11074781=      (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AM' +
        'OUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_, :AMOUNT' +
        '_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVRAT_,'
      
        '11074782=       :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :AMOUNT_' +
        'UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '11074783='
      '11074784=    -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '11074785=    AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + AMOUNT_PR' +
        'IHOD_;'
      
        '11074786=    SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD' +
        '_;'
      
        '11074787=    AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMOUNT_UHOD' +
        '_;'
      '11074788=    SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_UHOD_;'
      
        '11074789=    AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ + AMOUNT_' +
        'SPISANO_;'
      
        '11074790=    SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + SUMM_SPIS' +
        'ANO_;'
      
        '11074791=    AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ + AMOUNT_' +
        'VOZVRAT_;'
      
        '11074792=    SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + SUMM_VOZV' +
        'RAT_;'
      
        '11074793=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ + A' +
        'MOUNT_PRIHOD_SKL_;'
      
        '11074794=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + SUM' +
        'M_PRIHOD_SKL_;'
      
        '11074795=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + AMO' +
        'UNT_UHOD_SKL_;'
      
        '11074796=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUMM_' +
        'UHOD_SKL_;'
      '11074797='
      '11074798=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '11074799=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11074800=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD, ' +
        'SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPISAN' +
        'O, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_' +
        'SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '11074801=    VALUES'
      
        '11074802=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AMOU' +
        'NT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UHOD' +
        '_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVRAT' +
        '_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIHOD' +
        '_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '11074803='
      
        '11074804=    STR_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE_B' +
        'EGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '11074805=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM DATE_END_);'
      '11074806='
      '11074807=  FOR'
      '11074808=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '11074809=           DECODE(T.IS_HEAD,'
      '11074810=                  0, T.NAME,'
      '11074811=                  1, T.NAME,'
      '11074812=                  2, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39','
      '11074813=                  3, '#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39'),'
      '11074814=           G.ARTICUL,'
      '11074815=           G.BARCODE,'
      '11074816=           G.PRICE,'
      '11074817=           T.AMOUNT_IN,'
      '11074818=           T.AMOUNT_PRIHOD,'
      '11074819=           T.SUMM_PRIHOD,'
      '11074820=           T.AMOUNT_UHOD,'
      '11074821=           T.SUMM_UHOD,'
      '11074822=           T.AMOUNT_SPISANO,'
      '11074823=           T.SUMM_SPISANO,'
      '11074824=           T.AMOUNT_VOZVRAT,'
      '11074825=           T.SUMM_VOZVRAT,'
      '11074826=           T.AMOUNT_PRIHOD_SKL,'
      '11074827=           T.SUMM_PRIHOD_SKL,'
      '11074828=           T.AMOUNT_UHOD_SKL,'
      '11074829=           T.SUMM_UHOD_SKL,'
      '11074830=           T.AMOUNT_OUT,'
      '11074831=           T.IS_HEAD'
      
        '11074832=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G_P' +
        'RODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '11074833=     ORDER BY 1'
      '11074834=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '11074835=       :NAME,'
      '11074836=       :ARTICUL,'
      '11074837=       :BARCODE,'
      '11074838=       :PRICE,'
      '11074839=       :AMOUNT_IN,'
      '11074840=       :AMOUNT_PRIHOD,'
      '11074841=       :SUMM_PRIHOD,'
      '11074842=       :AMOUNT_UHOD,'
      '11074843=       :SUMM_UHOD,'
      '11074844=       :AMOUNT_SPISANO,'
      '11074845=       :SUMM_SPISANO,'
      '11074846=       :AMOUNT_VOZVRAT,'
      '11074847=       :SUMM_VOZVRAT,'
      '11074848=       :AMOUNT_PRIHOD_SKL,'
      '11074849=       :SUMM_PRIHOD_SKL,'
      '11074850=       :AMOUNT_UHOD_SKL,'
      '11074851=       :SUMM_UHOD_SKL,'
      '11074852=       :AMOUNT_OUT,'
      '11074853=       :IS_HEAD'
      '11074854=  DO SUSPEND;'
      '11074855='
      '11074856=WHEN ANY DO BEGIN'
      '11074857=    Err_code = -20500;'
      
        '11074858=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11074859=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11074860=  END'
      '11074861=end'
      '11074862=;'
      '11074863='
      '11074864=ALTER PROCEDURE P_REP_TOVAR_OSTATOK_ON_DATE('
      '11074865=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11074866=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11074867=  DATE_ DATE,'
      '11074868=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11074869=RETURNS ('
      '11074870=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11074871=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11074872=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11074873=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '11074874=  SUMM MY_NUMERIC,'
      '11074875=  ERR_CODE INTEGER,'
      '11074876=  ERR_MSG VARCHAR(1024))'
      '11074877=AS'
      
        '11074878=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_OS' +
        'TATOK_ON_DATE'#39';'
      '11074879=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11074880=DECLARE VARIABLE G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT_PAR;'
      '11074881=BEGIN'
      '11074882='
      '11074883=  FOR WITH OSTATOK_ARR AS (SELECT GP.NAME,'
      '11074884=                               GP.BARCODE,'
      '11074885=                               GP.ARTICUL,'
      '11074886=                               GP.G_PRODUCT,'
      '11074887=                               GP.G_PRODUCT_PAR,'
      
        '11074888=                               (select (select sum(amou' +
        'nt) from lt_sklad_product where g_product = GP.G_PRODUCT'
      
        '11074889=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||g_tochka||'#39'-'#39')'
      
        '11074890=                                        +  -- '#1090#1086#1074#1072#1088' '#1085#1072' ' +
        #1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '11074891=                                       (select COALESCE' +
        '(sum(zr.AMOUNT_ALL), 0) from zakaz_na_real zr, zakaz_real_parent' +
        ' zrp'
      
        '11074892=                                        where zr.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCH' +
        'KA||'#39'-'#39
      
        '11074893=                                        and zr.ZAKAZ_RE' +
        'AL_PARENT = zrp.ZAKAZ_REAL_PARENT'
      
        '11074894=                                        and zrp.ZAKAZ_D' +
        'ATE > :DATE_)'
      '11074895=                                       +'
      
        '11074896=                                       (select COALESCE' +
        '(sum(zd.amount), 0) from zakaz_details zd, zakaz z'
      
        '11074897=                                        where zd.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA' +
        '||'#39'-'#39
      
        '11074898=                                        and zd.zakaz = ' +
        'z.zakaz and z.z_date > :DATE_'
      
        '11074899=                                        and z.IS_SPISAN' +
        'IE <> 2)   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088 +
        ' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      '11074900=                                       +'
      
        '11074901=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and s.is_vozvrat = 3'
      
        '11074902=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt > :DATE_)'
      '11074903=                                       +'
      
        '11074904=                                       (select COALESCE' +
        '(sum(od.amount), 0) from other_details od, other o'
      
        '11074905=                                        where od.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA' +
        '||'#39'-'#39
      
        '11074906=                                        and od.other = ' +
        'o.other and o.op_date > :DATE_)'
      '11074907=                                       -'
      
        '11074908=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '11074909=                                        and s.is_vozvra' +
        't <> 3 and s.date_receipt > :DATE_)'
      '11074910=                                       -'
      
        '11074911=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and s.is_vozvrat = 3'
      
        '11074912=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt > :DATE_)'
      
        '11074913=                                  from rdb$database) AM' +
        'OUNT'
      '11074914=                          FROM G_PRODUCT GP'
      '11074915=                         WHERE GP.IS_ACTIVE = 1'
      '11074916=                           AND GP.IS_CATEGORY = 0'
      
        '11074917=                           AND ((:G_CATEGORY_ CONTAININ' +
        'G '#39'~'#39'||GP.G_PRODUCT_PAR||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11074918=                                 OR'
      '11074919=                                 (:G_CATEGORY_ IS NULL)'
      '11074920=                               )'
      
        '11074921=                           AND ((:G_PRODUCT_ CONTAINING' +
        ' '#39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11074922=                                 OR'
      '11074923=                                 (:G_PRODUCT_ IS NULL)'
      '11074924=                               )'
      '11074925=                           --AND GP.G_PRODUCT = 2874'
      '11074926=                               )'
      
        '11074927=    SELECT (SELECT NAME FROM G_PRODUCT GG WHERE GG.G_PR' +
        'ODUCT = A.G_PRODUCT_PAR)||'#39' / '#39'||A.NAME,'
      '11074928=           A.BARCODE,'
      '11074929=           A.ARTICUL,'
      '11074930=           A.G_PRODUCT_PAR,'
      '11074931=           COALESCE(A.AMOUNT, 0) AMOUNT'
      
        '11074932=           ,COALESCE(CAST(A.AMOUNT AS NUMERIC), 0) * DE' +
        'CODE((SELECT S.S_VALUE'
      
        '11074933=                                             FROM SYSTE' +
        'M_SETUP S'
      
        '11074934=                                            WHERE S.SYS' +
        'TEM_SETUP = 1),'
      '11074935=                                           1,'
      
        '11074936=                                           (SELECT SS.P' +
        'RICE'
      
        '11074937=                                              FROM SKLA' +
        'D SS'
      
        '11074938=                                             WHERE SS.D' +
        'ATE_RECEIPT = (SELECT MAX(DATE_RECEIPT)'
      
        '11074939=                                                       ' +
        '                 FROM SKLAD'
      
        '11074940=                                                       ' +
        '                WHERE DATE_RECEIPT < :DATE_'
      
        '11074941=                                                       ' +
        '                  AND G_PRODUCT = A.G_PRODUCT'
      
        '11074942=                                                       ' +
        '                  AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||g_tochka||'#39 +
        '-'#39
      
        '11074943=                                                       ' +
        '                  AND IS_VOZVRAT IN (0, 4))'
      
        '11074944=                                               AND SS.G' +
        '_PRODUCT = A.G_PRODUCT'
      
        '11074945=                                               AND :G_T' +
        'OCHKA_ARR_ CONTAINING '#39'-'#39'||SS.g_tochka||'#39'-'#39
      
        '11074946=                                               AND SS.I' +
        'S_VOZVRAT IN (0, 4)'
      
        '11074947=                                            ORDER BY SS' +
        '.SKLAD DESC ROWS 1 TO 1),'
      
        '11074948=                                           (SELECT ROUN' +
        'D(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '11074949=                                            FROM (SELEC' +
        'T CAST(S.AMOUNT AS MY_NUMERIC) AMOUNT, S.PRICE'
      
        '11074950=                                                    FRO' +
        'M SKLAD S'
      
        '11074951=                                                   WHER' +
        'E S.DATE_RECEIPT <= :DATE_'
      
        '11074952=                                                     AN' +
        'D S.G_PRODUCT = A.G_PRODUCT'
      
        '11074953=                                                     AN' +
        'D S.IS_VOZVRAT IN (0, 4)'
      
        '11074954=                                                     AN' +
        'D :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39
      
        '11074955=                                                    ORD' +
        'ER BY S.DATE_RECEIPT DESC ROWS 1 TO 5) T)'
      '11074956=                                         )'
      '11074957=      FROM OSTATOK_ARR A'
      '11074958=    ORDER BY NAME, G_PRODUCT_PAR'
      '11074959=    INTO :NAME,'
      '11074960=         :BARCODE,'
      '11074961=         :ARTICUL,'
      '11074962=         :G_PRODUCT_PAR,'
      '11074963=         :AMOUNT,'
      '11074964=         :SUMM'
      '11074965=  DO'
      '11074966=    SUSPEND;'
      '11074967='
      '11074968=WHEN ANY DO BEGIN'
      '11074969=    Err_code = -20500;'
      
        '11074970=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11074971=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11074972=  END'
      '11074973=end'
      '11074974=;'
      
        '11074975=UPDATE SYSTEM_SETUP SET S_VALUE = 11074 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11074976=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11074977=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110750=CREATE PROCEDURE K_UPD_KASSA_STATE('
      
        '110751=  ACTION_DATE_ /* TYPE OF COLUMN KASSA.ACTION_DATE */ DAT' +
        'E,'
      
        '110752=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGINT' +
        ','
      '110753=  DEBET_ /* MY_NUMERIC */ NUMERIC(15,2),'
      '110754=  CREDIT_ /* MY_NUMERIC */ NUMERIC(15,2),'
      '110755=  NAL_BEZNAL_ INTEGER)'
      '110756=RETURNS ('
      '110757=  ERR_CODE INTEGER,'
      '110758=  ERR_MSG VARCHAR(1024))'
      '110759=AS'
      '1107510=BEGIN'
      '1107511=  SUSPEND;'
      '1107512=END'
      '1107513=;'
      '1107514='
      '1107515='
      
        '1107516=/*******************************************************' +
        '***********************/'
      
        '1107517=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1107518=/*******************************************************' +
        '***********************/'
      '1107519=ALTER PROCEDURE DEL_ZAKAZ('
      '1107520=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1107521=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0,'
      '1107522=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1107523=RETURNS ('
      '1107524=  ERR_CODE INTEGER,'
      '1107525=  ERR_MSG VARCHAR(1024))'
      '1107526=AS'
      '1107527=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '1107528=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1107529=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '1107530=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUMM;'
      
        '1107531=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_BONUS;'
      
        '1107532=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_BONUS_GOT;'
      
        '1107533=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLI' +
        'ENT;'
      
        '1107534=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFF' +
        'ICIAL.DO_NOT_SALES_COMM;'
      
        '1107535=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICIA' +
        'L.FM;'
      
        '1107536=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN ' +
        'SYSTEM_SETUP.S_VALUE;'
      
        '1107537=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM;'
      
        '1107538=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRODUC' +
        'T.SALES_COMM;'
      
        '1107539=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '1107540=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G' +
        '_OFFICIAL;'
      
        '1107541=DECLARE VARIABLE G_TOCHKA_   TYPE OF COLUMN ZAKAZ.G_TOCH' +
        'KA;'
      '1107542=BEGIN'
      
        '1107543=  --****************************************************' +
        '************'
      '1107544=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1107545=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1107546=      SELECT Z.SUMM,'
      '1107547=             Z.SUMM_BONUS,'
      '1107548=             Z.SUMM_BONUS_GOT,'
      '1107549=             Z.G_CLIENT,'
      '1107550=             Z.G_OFFICIAL,'
      '1107551=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '1107552=             G.FM'
      
        '1107553=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z.G' +
        '_OFFICIAL = G.G_OFFICIAL'
      '1107554=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1107555=        INTO :SUMM_ZAKAZ_,'
      '1107556=             :SUMM_PAY_BONUS_,'
      '1107557=             :SUMM_BONUS_GOT_,'
      '1107558=             :G_CLIENT_,'
      '1107559=             :G_OFFICIAL_,'
      '1107560=             :DO_NOT_SALES_COMM_,'
      '1107561=             :OFFICIAL_NAME_;'
      '1107562='
      
        '1107563=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' '#1055#1056#1054 +
        #1044#1040#1042#1062#1059
      
        '1107564=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0) T' +
        'HEN'
      '1107565=        SELECT SUM(ZD.SALES_COMM)'
      '1107566=          FROM ZAKAZ_DETAILS ZD'
      '1107567=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1107568=          INTO :SALES_COMM_OLD_;'
      '1107569='
      '1107570=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1107571=      PNT_ = '#39'01'#39';'
      
        '1107572=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETURN' +
        'ING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1107573=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1107574=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '1107575=        EXIT;'
      '1107576=      END'
      '1107577='
      '1107578=      -------------------------------------'
      '1107579=      PNT_ = '#39'02'#39';'
      '1107580=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '1107581=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063 +
        #1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071 +
        ' '#1055#1054#1044#1056#1071#1044
      '1107582=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '1107583=      FOR SELECT S.KASSA'
      '1107584=            FROM KASSA S'
      '1107585=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1107586=            INTO :KASSA_'
      '1107587=      DO BEGIN'
      
        '1107588=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1107589=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1107590=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '1107591=            EXIT;'
      '1107592=          END'
      '1107593=      END'
      '1107594='
      '1107595=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '1107596=      PNT_ = '#39'03'#39';'
      '1107597=      FOR SELECT S.KASSA_BEZNAL'
      '1107598=            FROM KASSA_BEZNAL S'
      '1107599=           WHERE S.ZAKAZ = :ZAKAZ_'
      '11075100=            INTO :KASSA_'
      '11075101=      DO BEGIN'
      
        '11075102=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11075103=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075104=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11075105=            EXIT;'
      '11075106=          END'
      '11075107=      END'
      '11075108=      -------------------------------------'
      '11075109='
      
        '11075110=      --===============================================' +
        '=================='
      '11075111=      -- '#1041#1051#1054#1050' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040
      
        '11075112=      --===============================================' +
        '=================='
      '11075113=      PNT_ = '#39'03.1'#39';'
      
        '11075114=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0 A' +
        'ND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '11075115=            KASSA_ = NULL;'
      '11075116='
      '11075117=            SELECT S.S_VALUE'
      '11075118=              FROM SYSTEM_SETUP S'
      '11075119=             WHERE S.SYSTEM_SETUP = 4'
      '11075120=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '11075121='
      '11075122=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11075123=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11075124=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11075125='
      
        '11075126=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040 +
        #1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11075127=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11075128=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DEC' +
        'ODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FR' +
        'OM CURRENT_DATE)));'
      '11075129='
      '11075130=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11075131=            ELSE'
      
        '11075132=               ACTION_DATE_ZP_ = Current_date - EXTRACT' +
        '(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - E' +
        'XTRACT(DAY FROM current_date) + 32);'
      '11075133='
      '11075134=            SELECT K.KASSA, K.SUMM'
      '11075135=            FROM KASSA K'
      '11075136=            WHERE K.G_PRIHOD_RASHOD = -1'
      '11075137=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '11075138=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '11075139=             AND K.G_TOCHKA = :G_TOCHKA_'
      '11075140=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '11075141='
      '11075142=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '11075143=                EXECUTE PROCEDURE K_INS_KASSA(1,     --' +
        ' ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11075144=                                              -1,     -' +
        '-:G_PRIHOD_RASHOD_,'
      
        '11075145=                                              -:SALES_C' +
        'OMM_OLD_,'
      
        '11075146=                                              :ACTION_D' +
        'ATE_ZP_,'
      
        '11075147=                                              :OFFICIAL' +
        '_NAME_,'
      
        '11075148=                                              NULL,    ' +
        ' --:ZAKAZ_,'
      
        '11075149=                                              NULL,    ' +
        ' --:SKLAD_,'
      '11075150=                                              1,'
      
        '11075151=                                              (SELECT I' +
        'D FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '11075152=                                              :G_OFFICI' +
        'AL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11075153=            END ELSE'
      '11075154=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '11075155=                                              1,     --' +
        ' ACTION_'
      
        '11075156=                                              -1,     -' +
        '-:G_PRIHOD_RASHOD_,'
      
        '11075157=                                              :SALES_CO' +
        'MM_SUMM_ITER_ - :SALES_COMM_OLD_,'
      
        '11075158=                                              :ACTION_D' +
        'ATE_ZP_,'
      
        '11075159=                                              :OFFICIAL' +
        '_NAME_,   --NOTE_'
      '11075160=                                              NULL,'
      '11075161=                                              NULL,'
      '11075162=                                              1,'
      
        '11075163=                                              G_OFFICIA' +
        'L_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '11075164='
      '11075165=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075166=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11075167=              EXIT;'
      '11075168=            END'
      '11075169=      END'
      '11075170=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '11075171=      --===============================================' +
        '=================='
      '11075172='
      
        '11075173=      -- '#1045#1057#1051#1048' '#1050#1040#1050#1040#1071'-'#1058#1054' '#1063#1040#1057#1058#1068' '#1041#1067#1051#1040' '#1054#1055#1051#1040#1063#1045#1053#1040' '#1041#1054#1053#1059#1057#1040#1052#1048' - '#1042 +
        #1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1048#1061', '#1058#1054' '#1045#1057#1058#1068' '#1047#1040#1050#1048#1044#1067#1042#1040#1070' '#1050#1051#1048#1045#1053#1058#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1053#1040' '#1053#1040#1050#1054#1055#1051#1045#1053#1048 +
        #1071
      '11075174=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '11075175=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054 +
        #1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '11075176=      UPDATE G_DISCONT_CARD G'
      
        '11075177=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_, ' +
        '0) - :SUMM_BONUS_GOT_,'
      
        '11075178=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0), ' +
        '0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '11075179=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '11075180='
      '11075181=      PNT_ = '#39'04'#39';'
      '11075182=      UPDATE INVOICE I'
      '11075183=         SET I.ZAKAZ = NULL'
      '11075184=       WHERE I.ZAKAZ = :zakaz_;'
      '11075185='
      '11075186=      UPDATE INVOICE_PAY I'
      '11075187=         SET I.ZAKAZ = NULL'
      '11075188=       WHERE I.ZAKAZ = :zakaz_;'
      '11075189='
      '11075190=      UPDATE WAYBILL W'
      '11075191=         SET W.ZAKAZ = NULL'
      '11075192=       WHERE W.ZAKAZ = :zakaz_;'
      '11075193=      --********************************************'
      '11075194='
      '11075195=      PNT_ = '#39'015'#39';'
      '11075196=      DELETE FROM zakaz'
      '11075197=      WHERE zakaz = :zakaz_;'
      '11075198='
      '11075199=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '11075200=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      
        '11075201=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_' +
        'TYPE, ID, OPER)'
      
        '11075202=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ_' +
        ', 3);'
      '11075203=  END'
      '11075204=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '11075205=  --***************************************************' +
        '*************************'
      '11075206=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11075207=  ELSE BEGIN'
      '11075208=    PNT_ = '#39'20'#39';'
      
        '11075209=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '11075210=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075211=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11075212=      EXIT;'
      '11075213=    END'
      '11075214=  END'
      '11075215='
      '11075216=when sqlcode -530 DO'
      '11075217=  begin'
      '11075218=    ERR_CODE = -20500;'
      
        '11075219=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' '#1079 +
        #1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11075220=    ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '11075221=  end'
      '11075222=end'
      '11075223=;'
      '11075224='
      '11075225=ALTER PROCEDURE G_TOCHKA_DEL('
      '11075226=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11075227=RETURNS ('
      '11075228=  ERR_CODE INTEGER,'
      '11075229=  ERR_MSG VARCHAR(1024))'
      '11075230=AS'
      '11075231=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '11075232=BEGIN'
      '11075233=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '11075234=    ERR_CODE = -20500;'
      
        '11075235=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076#1072 +
        #1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '11075236=    EXIT;'
      '11075237=  END'
      '11075238='
      '11075239=  DELETE FROM KASSA_STATE S'
      '11075240=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '11075241='
      
        '11075242=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040#1041#1051 +
        #1048#1062#1059' LOGS'
      
        '11075243=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SE' +
        'TUP = 5) > 0) THEN'
      
        '11075244=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERED' +
        ', SYSDATE, ERR_CODE)'
      
        '11075245=      VALUES (GEN_ID(GEN_LOGS, 1), '#39'DELETE FROM KASSA_S' +
        'TATE S WHERE S.G_TOCHKA = '#39'||:G_TOCHKA_||'#39';'#39', '#39'SYSDBA'#39', 0, CURRE' +
        'NT_TIMESTAMP, :ERR_CODE);'
      '11075246='
      '11075247=  DELETE FROM KASSA S'
      '11075248=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '11075249='
      '11075250=  FOR SELECT KASSA_BEZNAL'
      '11075251=        FROM KASSA_BEZNAL'
      '11075252=       WHERE G_TOCHKA = :G_TOCHKA_'
      '11075253=        INTO :KASSA_'
      '11075254=  DO BEGIN'
      
        '11075255=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNING' +
        '_VALUES (:ERR_CODE, :ERR_MSG);'
      '11075256=    IF (:ERR_CODE <> 0) THEN'
      '11075257=      EXIT;'
      '11075258=  END'
      '11075259='
      '11075260=  UPDATE G_OFFICIAL O'
      '11075261=     SET O.G_TOCHKA = NULL'
      '11075262=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '11075263='
      '11075264=  DELETE FROM INVOICE I'
      '11075265=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '11075266=                      FROM ZAKAZ'
      '11075267=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11075268='
      '11075269=  DELETE FROM INVOICE_PAY I'
      '11075270=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '11075271=                      FROM ZAKAZ'
      '11075272=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11075273='
      '11075274=  DELETE FROM WAYBILL I'
      '11075275=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '11075276=                      FROM ZAKAZ'
      '11075277=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11075278='
      '11075279=  DELETE FROM LT_ZAKAZ_REAL R'
      '11075280=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '11075281=                              FROM ZAKAZ Z, ZAKAZ_DETAI' +
        'LS ZD'
      
        '11075282=                             WHERE Z.G_TOCHKA = :G_TOCH' +
        'KA_'
      '11075283=                               AND Z.ZAKAZ = ZD.ZAKAZ);'
      '11075284='
      '11075285=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '11075286=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PAREN' +
        'T'
      
        '11075287=                                  FROM ZAKAZ_REAL_PAREN' +
        'T'
      
        '11075288=                                 WHERE G_TOCHKA = :G_TO' +
        'CHKA_);'
      '11075289='
      '11075290=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '11075291=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11075292='
      '11075293=  DELETE FROM ZAKAZ_DETAILS D'
      '11075294=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '11075295=                      FROM ZAKAZ'
      '11075296=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11075297='
      '11075298=  DELETE FROM ZAKAZ D'
      '11075299=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11075300='
      '11075301=  DELETE FROM SKLAD D'
      '11075302=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11075303='
      '11075304=  DELETE FROM SKLAD_PARENT D'
      '11075305=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11075306='
      '11075307=  DELETE FROM ZAKAZ_DETAILS D'
      '11075308=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '11075309=                      FROM ZAKAZ'
      '11075310=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11075311='
      '11075312=  DELETE FROM LT_SKLAD_PRODUCT'
      '11075313=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '11075314='
      '11075315=  DELETE FROM G_TOCHKA'
      '11075316=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '11075317=END'
      '11075318=;'
      '11075319='
      '11075320=ALTER PROCEDURE INS_ZAKAZ('
      '11075321=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11075322=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11075323=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11075324=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11075325=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11075326=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11075327=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11075328=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11075329=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11075330=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11075331=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11075332=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11075333=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11075334=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '11075335=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11075336=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11075337=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11075338=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11075339=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11075340=  IS_MEBEL_ INTEGER = 0,'
      
        '11075341=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NULL' +
        ','
      
        '11075342=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE ' +
        '= NULL,'
      '11075343=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '11075344=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '11075345=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '11075346=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NU' +
        'LL)'
      '11075347=RETURNS ('
      '11075348=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11075349=  ERR_CODE INTEGER,'
      '11075350=  ERR_MSG VARCHAR(1024))'
      '11075351=AS'
      '11075352=/*'
      '11075353=IS_SPISANIE_'
      '11075354=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11075355=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11075356=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11075357=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11075358='
      '11075359='
      
        '11075360=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '11075361=*/'
      '11075362=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '11075363=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11075364=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11075365=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '11075366=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '11075367=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '11075368=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ';'
      
        '11075369=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      
        '11075370=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '11075371=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM;'
      '11075372=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11075373=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS_SUMM;'
      
        '11075374=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      
        '11075375=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11075376=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '11075377=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKA' +
        'Z_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '11075378=DECLARE VARIABLE CNT_ INTEGER;'
      '11075379=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11075380=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '11075381=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11075382=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11075383=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11075384=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11075385=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11075386=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11075387=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.S' +
        'ALES_COMM;'
      
        '11075388=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11075389=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11075390=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11075391=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '11075392=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM = 0;'
      
        '11075393=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      '11075394=BEGIN'
      '11075395='
      
        '11075396=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057#1048 +
        #1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055#1054 +
        #1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '11075397=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '11075398=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '11075399=  IF (CNT_ = 0) THEN BEGIN'
      '11075400=    ERR_CODE = -20500;'
      
        '11075401=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088#1086 +
        #1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090#1077 +
        ' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11075402=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '11075403=    EXIT;'
      '11075404=  END'
      '11075405='
      '11075406=  IF (G_TOCHKA_ IS NULL) THEN'
      '11075407=    SELECT ID'
      '11075408=      FROM CUR_PARAMS'
      '11075409=     WHERE CUR_PARAMS = 2'
      '11075410=      INTO :G_TOCHKA_;'
      '11075411='
      '11075412=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11075413=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '11075414=      PNT_ = '#39'01'#39';'
      
        '11075415=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11075416=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11075417=      ELSE'
      '11075418=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11075419='
      '11075420=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11075421=      SELECT G.G_OFFICIAL,'
      '11075422=             G.DO_NOT_SALES_COMM,'
      '11075423=             G.FM||'#39' '#39'||G.NM'
      '11075424=        FROM G_OFFICIAL G'
      
        '11075425=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SEL' +
        'ECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '11075426=        INTO :G_OFFICIAL_,'
      '11075427=             :DO_NOT_SALES_COMM_,'
      '11075428=             :OFFICIAL_NAME_;'
      '11075429='
      '11075430=      INSERT INTO ZAKAZ'
      '11075431=      ('
      '11075432=       ZAKAZ,'
      '11075433=       G_TOCHKA,'
      '11075434=       Z_DATE,'
      '11075435=       Z_TIME,'
      '11075436=       G_CLIENT,'
      '11075437=       G_PAYMENT_TYPE,'
      '11075438=       OSNOVANIE,'
      '11075439=       IS_SPISANIE,'
      '11075440=       NOTE,'
      '11075441=       SUMM,'
      '11075442=       SUMM_FACT,'
      '11075443=       SUMM_BONUS,'
      '11075444=       IS_PAYED_ALL'
      '11075445=       ,G_OFFICIAL'
      '11075446=       ,BY_RECIPE'
      '11075447=       ,SUMM_BONUS_GOT'
      '11075448=       ,IS_RESERVE'
      '11075449=       ,SUMM_CASH'
      '11075450=       ,SUMM_NONCASH'
      '11075451=      ) VALUES ('
      '11075452=       GEN_ID(GEN_ZAKAZ, 1),'
      '11075453=       :G_TOCHKA_,'
      '11075454=       :Z_DATE_,'
      '11075455=       :Z_TIME_,'
      '11075456=       :G_CLIENT_,'
      '11075457=       :G_PAYMENT_TYPE_,'
      '11075458=       :OSNOVANIE_,'
      '11075459=       :IS_SPISANIE_,'
      '11075460=       :NOTE_,'
      '11075461=       :SUMM_,'
      '11075462=       :SUMM_FACT_1_,'
      '11075463=       COALESCE(:SUMM_BONUS_, 0),'
      
        '11075464=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_B' +
        'ONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052 +
        #1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11075465=       ,:G_OFFICIAL_'
      '11075466=       ,:BY_RECIPE_'
      '11075467=       ,:SUMM_BONUS_GOT_'
      '11075468=       ,:IS_RESERVE_'
      '11075469=       ,COALESCE(:SUMM_CASH_, 0)'
      '11075470=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '11075471=      )'
      '11075472=      RETURNING'
      '11075473=        ZAKAZ'
      '11075474=      INTO'
      '11075475=        :ZAKAZ_;'
      '11075476='
      '11075477=      PNT_ = '#39'02'#39';'
      
        '11075478=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUNT' +
        ', Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUNT' +
        '_SUMM,'
      
        '11075479=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SAL' +
        'ES_COMM'
      '11075480=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '11075481=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '11075482=          INTO :ZAKAZ_DETAILS_TMP_,'
      '11075483=              :G_PRODUCT,'
      '11075484=              :AMOUNT,'
      '11075485=              :PRICE,'
      '11075486=              :SUMM,'
      '11075487=              :DISCOUNT_PERC,'
      '11075488=              :DISCOUNT_TENGE,'
      '11075489=              :DISCOUNT_SUMM,'
      '11075490=              :NDS,'
      '11075491=              :NDS_SUMM,'
      '11075492=              :COST_PRICE,'
      '11075493=              :SALES_COMM_'
      '11075494=      DO BEGIN'
      
        '11075495=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056 +
        #1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040 +
        #1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '11075496=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '11075497=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/10' +
        '0;'
      
        '11075498=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_ ' +
        '+ SALES_COMM_SUMM_ITER_;'
      '11075499=        END'
      '11075500='
      '11075501=        INSERT INTO ZAKAZ_DETAILS'
      '11075502=        VALUES('
      '11075503=          :ZAKAZ_DETAILS_TMP_,'
      '11075504=          :ZAKAZ_,'
      '11075505=          :G_PRODUCT,'
      '11075506=          :AMOUNT,'
      '11075507=          :PRICE,'
      '11075508=          :SUMM,'
      '11075509=          :DISCOUNT_PERC,'
      '11075510=          :DISCOUNT_TENGE,'
      '11075511=          :DISCOUNT_SUMM,'
      '11075512=          :NDS,'
      '11075513=          :NDS_SUMM,'
      '11075514=          :COST_PRICE,'
      '11075515=          :SALES_COMM_SUMM_ITER_'
      '11075516=        );'
      '11075517='
      '11075518=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11075519=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '11075520=            UPDATE LT_SKLAD_PRODUCT L'
      '11075521=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11075522=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11075523=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11075524='
      '11075525=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '11075526=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11075527=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '11075528=            PNT_ = '#39'04'#39';'
      
        '11075529=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11075530=              Err_Code = -20500;'
      
        '11075531=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11075532=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11075533=              EXIT;'
      '11075534=            END ELSE if (ROW_COUNT = 0) then'
      
        '11075535=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11075536=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11075537=        END'
      '11075538='
      '11075539=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '11075540=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '11075541=            UPDATE LT_SKLAD_PRODUCT L'
      
        '11075542=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE ' +
        '+ :AMOUNT'
      '11075543=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11075544=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11075545=      END'
      '11075546='
      '11075547=      ----------------------------------------'
      
        '11075548=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053 +
        #1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '11075549=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '11075550=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '11075551='
      
        '11075552=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '11075553=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '11075554=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '11075555=                PNT_ = '#39'05'#39';'
      
        '11075556=                EXECUTE PROCEDURE K_INS_KASSA(0,     --' +
        ' ACTION_ => :ACTION_'
      
        '11075557=                                              1,     --' +
        ' G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '11075558=                                              :SUMM_FAC' +
        'T_1_,'
      '11075559=                                              :Z_DATE_,'
      
        '11075560=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11075561=                                              ZAKAZ_,  ' +
        ' --ZAKAZ_'
      '11075562=                                              NULL,'
      
        '11075563=                                              :G_PAYMEN' +
        'T_TYPE_,'
      
        '11075564=                                              :G_TOCHKA' +
        '_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11075565=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075566=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_' +
        '||'#39' '#39'||ERR_MSG;'
      '11075567=                  EXIT;'
      '11075568=                END'
      '11075569=            END'
      '11075570='
      '11075571=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '11075572=        END ELSE BEGIN'
      '11075573=            PNT_ = '#39'06'#39';'
      '11075574=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      
        '11075575=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_)' +
        ';'
      
        '11075576=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA' +
        '_) THEN'
      
        '11075577=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' POS_TILDA_ - 1);'
      '11075578=                ELSE'
      
        '11075579=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' CHAR_LENGTH(PAYMENTS_) - 1);'
      '11075580='
      
        '11075581=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR' +
        '_)'
      
        '11075582=                    RETURNING_VALUES :PAYMENT_ID_, :PAY' +
        'MENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11075583='
      
        '11075584=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM ' +
        '(POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '11075585='
      '11075586=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11075587=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11075588=                                                  1,   ' +
        '  --:G_PRIHOD_RASHOD_,'
      
        '11075589=                                                  :PAYM' +
        'ENT_SUMM_,'
      
        '11075590=                                                  :PAYM' +
        'ENT_DATE_,'
      
        '11075591=                                                  NULL,' +
        '   --NOTE_ => :NOTE_,'
      
        '11075592=                                                  :ZAKA' +
        'Z_,'
      
        '11075593=                                                  NULL,' +
        '     --:SKLAD_,'
      
        '11075594=                                                  :PAYM' +
        'ENT_TYPE_,'
      
        '11075595=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11075596=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075597=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '11075598=                      EXIT;'
      '11075599=                    END'
      '11075600=                END'
      '11075601=            END'
      '11075602=        END'
      '11075603=      END'
      '11075604='
      
        '11075605=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '11075606=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041#1054 +
        #1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '11075607=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052' ' +
        #1057#1051#1059#1063#1040#1045
      '11075608=      UPDATE G_DISCONT_CARD D'
      
        '11075609=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0) +' +
        ' :SUMM_BONUS_GOT_,'
      '11075610=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '11075611=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '11075612='
      '11075613=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '11075614=      PNT_ = '#39'07'#39';'
      
        '11075615=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COMM' +
        '_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN BE' +
        'GIN'
      '11075616=        SELECT S.S_VALUE'
      '11075617=          FROM SYSTEM_SETUP S'
      '11075618=         WHERE S.SYSTEM_SETUP = 4'
      '11075619=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '11075620='
      '11075621=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11075622=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11075623=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11075624='
      
        '11075625=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' '#1041 +
        #1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11075626=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11075627=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE(' +
        'EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM C' +
        'URRENT_DATE)));'
      '11075628='
      '11075629=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11075630=        ELSE'
      
        '11075631=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DAY' +
        ' FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32);'
      '11075632='
      '11075633=        KASSA_ = NULL;'
      '11075634=        SELECT K.KASSA, K.SUMM'
      '11075635=        FROM KASSA K'
      '11075636=        WHERE K.G_PRIHOD_RASHOD = -1'
      '11075637=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '11075638=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '11075639=         AND K.G_TOCHKA = :G_TOCHKA_'
      '11075640=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '11075641='
      '11075642=        IF (KASSA_ IS NULL) THEN'
      
        '11075643=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11075644=                                          -1,     --:G_' +
        'PRIHOD_RASHOD_,'
      
        '11075645=                                          :SALES_COMM_S' +
        'UMM_ALL_,'
      
        '11075646=                                          :ACTION_DATE_' +
        'ZP_,'
      
        '11075647=                                          :OFFICIAL_NAM' +
        'E_,'
      
        '11075648=                                          NULL,     --:' +
        'ZAKAZ_,'
      
        '11075649=                                          NULL,     --:' +
        'SKLAD_,'
      '11075650=                                          1,'
      '11075651=                                          :G_TOCHKA_,'
      '11075652=                                          :G_OFFICIAL_'
      
        '11075653=                                          ) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11075654=        ELSE'
      '11075655=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '11075656=                                          1,     -- ACT' +
        'ION_'
      
        '11075657=                                          -1,     --:G_' +
        'PRIHOD_RASHOD_,'
      
        '11075658=                                          :SALES_COMM_S' +
        'UMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '11075659=                                          :ACTION_DATE_' +
        'ZP_,'
      
        '11075660=                                          :OFFICIAL_NAM' +
        'E_,   --NOTE_'
      '11075661=                                          NULL,'
      '11075662=                                          NULL,'
      
        '11075663=                                          :PAYMENT_TYPE' +
        '_,'
      '11075664=                                          :G_OFFICIAL_'
      
        '11075665=                                          ) RETURNING_V' +
        'ALUES :ERR_CODE, :ERR_MSG;'
      '11075666='
      '11075667=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11075668=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11075669=          EXIT;'
      '11075670=        END'
      '11075671=      END'
      '11075672='
      '11075673=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '11075674=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      
        '11075675=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_' +
        'TYPE, ID, OPER)'
      
        '11075676=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ_' +
        ', 1);'
      '11075677=  END'
      '11075678=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11075679=  ----------------------------------------'
      '11075680=  ----------------------------------------'
      '11075681=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11075682=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '11075683=      PNT_ = '#39'25'#39';'
      
        '11075684=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT,' +
        ' G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHKA' +
        ')'
      
        '11075685=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLIE' +
        'NT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA_' +
        ')'
      '11075686=      RETURNING ZAKAZ_REAL_PARENT'
      '11075687=      INTO :ZAKAZ_REAL_PARENT_;'
      '11075688='
      
        '11075689=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOU' +
        'NT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '11075690=            FROM ZAKAZ_DETAILS_TMP Z'
      '11075691=          INTO :G_PRODUCT,'
      '11075692=              :AMOUNT,'
      '11075693=              :PRICE,'
      '11075694=              :SUMM,'
      '11075695=              :DISCOUNT_PERC,'
      '11075696=              :DISCOUNT_TENGE,'
      '11075697=              :DISCOUNT_SUMM,'
      '11075698=              :NDS,'
      '11075699=              :NDS_SUMM'
      '11075700=      DO BEGIN'
      '11075701=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11075702=          UPDATE LT_SKLAD_PRODUCT L'
      '11075703=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11075704=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '11075705=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '11075706='
      
        '11075707=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053#1054' ' +
        #1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045' '#1047 +
        #1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11075708=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048#1057 +
        #1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '11075709=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FROM' +
        ' SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11075710=            Err_Code = -20500;'
      
        '11075711=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1055#1086 +
        ' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUCT ' +
        '= :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088 +
        #1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11075712=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11075713=            EXIT;'
      '11075714=          END ELSE if (ROW_COUNT = 0) then'
      
        '11075715=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11075716=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11075717='
      
        '11075718=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZAK' +
        'AZ_REAL_PARENT,'
      '11075719=                                     G_PRODUCT,'
      '11075720=                                     PRICE,'
      
        '11075721=                                     AMOUNT_ALL, SUMM_A' +
        'LL,'
      
        '11075722=                                     AMOUNT_PAYED, SUMM' +
        '_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SU' +
        'MM, NDS,'
      '11075723=                                     NDS_SUMM)'
      
        '11075724=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ_' +
        'REAL_PARENT_,'
      '11075725=                  :G_PRODUCT,'
      
        '11075726=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040#1070 +
        ' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '11075727=                  :AMOUNT, :SUMM,'
      '11075728=                  0, --AMOUNT_PAYED,'
      '11075729=                  0, --SUMM_PAYED,'
      '11075730=                  0, --IS_PAYED_ALL,'
      '11075731=                  :DISCOUNT_PERC,'
      '11075732=                  :DISCOUNT_TENGE,'
      '11075733=                  :DISCOUNT_SUMM,'
      '11075734=                  :NDS,'
      '11075735=                  :NDS_SUMM)'
      '11075736=          RETURNING ZAKAZ_NA_REAL'
      '11075737=          INTO :ZAKAZ_;'
      '11075738=      END'
      '11075739=  END'
      '11075740=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11075741=  ----------------------------------------'
      '11075742=  ----------------------------------------'
      '11075743=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '11075744=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046#1040 +
        #1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '11075745=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', '#1040 +
        ' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11075746=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '11075747=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, TI' +
        'ME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SUM' +
        'M_FACT,'
      
        '11075748=                                IS_PAYED_ALL, IS_VOZVRA' +
        'T, G_TOCHKA)'
      
        '11075749=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_,' +
        ' :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SUM' +
        'M_FACT_,'
      '11075750=              1, 3, :G_CLIENT_)'
      '11075751=      RETURNING SKLAD'
      '11075752=      INTO :SKLAD_;'
      '11075753='
      '11075754=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '11075755=            FROM ZAKAZ_DETAILS_TMP Z'
      '11075756=          INTO :G_PRODUCT,'
      '11075757=              :AMOUNT,'
      '11075758=              :PRICE,'
      '11075759=              :SUMM'
      '11075760=      DO BEGIN'
      '11075761=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11075762=        UPDATE LT_SKLAD_PRODUCT L'
      '11075763=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11075764=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11075765=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '11075766='
      '11075767=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '11075768=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1053#1045#1058
      
        '11075769=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045#1064#1048 +
        #1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' '#1062#1045 +
        #1053#1059
      '11075770=        SELECT MAX(SK.DATE_RECEIPT)'
      '11075771=            FROM SKLAD SK'
      '11075772=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11075773=             AND SK.IS_LAST = 1'
      '11075774=             AND SK.G_TOCHKA = :G_CLIENT_'
      '11075775=            INTO :DATE_LAST_;'
      '11075776='
      
        '11075777=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
