      '1102371585=     END'
      '1102371586='
      '1102371587=     UPDATE G_DISCONT_CARD G'
      '1102371588=        SET G.SUMM = G.SUMM - :BONUS_TO_MINUS_,'
      '1102371589=            G.SUMM_ALL = G.SUMM_ALL - :SUMM_'
      '1102371590=      WHERE G.G_CLIENT = :G_CLIENT_;*/'
      '1102371591='
      '1102371592=    SELECT G.SUMM'
      '1102371593=      FROM G_DISCONT_CARD G'
      '1102371594=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102371595=      INTO :SUMM_BONUS_;'
      '1102371596='
      '1102371597=    IF (:SUMM_BONUS_ > 0) THEN BEGIN'
      '1102371598=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '1102371599=              SUM(Z.SUMM)'
      '1102371600=         FROM ZAKAZ Z'
      '1102371601=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '1102371602=         INTO :SUMM_BONUS_GOT_,'
      '1102371603=              :SUMM_ALL_;'
      '1102371604='
      
        '1102371605=       SELECT ROUND( SUM(SP.SUMM * (Z.SUMM_BONUS_GOT ' +
        '/ Z.SUMM)), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042 +
        #1056#1040#1058#1040
      '1102371606=              SUM(SP.SUMM)'
      '1102371607=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '1102371608=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '1102371609=          AND SP.ZAKAZ = Z.ZAKAZ'
      '1102371610=         INTO :BONUS_TO_MINUS_,'
      '1102371611=              :SUMM_TO_MINUS_;'
      '1102371612='
      '1102371613=       UPDATE G_DISCONT_CARD G'
      
        '1102371614=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_M' +
        'INUS_,'
      
        '1102371615=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINU' +
        'S_'
      '1102371616=        WHERE G.G_CLIENT = :G_CLIENT_;'
