        '110242397=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYMEN' +
        'T_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110242398=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110242399=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
