      '1102015250=            VALUES'
      
        '1102015251=              (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1),' +
        ' -100, :AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD' +
