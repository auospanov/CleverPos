      '110411312=          OSNOVANIE__      = OSNOVANIE_;'
      '110411313=          NOTE__           = NOTE_;'
      '110411314=          SUMM__           = SUMM_ALL_;'
      '110411315=          SUMM_FACT__      = SUMM_FACT_ALL_;'
      '110411316=          SUMM_PAY_BONUS__ = SUMM_PAY_BONUS_;'
      '110411317=          SUMM_BONUS_GOT__ = SUMM_BONUS_GOT_;'
