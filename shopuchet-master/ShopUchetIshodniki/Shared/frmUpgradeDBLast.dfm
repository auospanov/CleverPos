      '1101823539=BEGIN'
      '1101823540='
      
        '1101823541=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1101823542=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1101823543=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1101823544=  IF (CNT_ = 0) THEN BEGIN'
      '1101823545=    ERR_CODE = -20500;'
      
        '1101823546=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101823547=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1101823548=    EXIT;'
      '1101823549=  END'
      '1101823550='
      '1101823551=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101823552=    SELECT ID'
      '1101823553=      FROM CUR_PARAMS'
      '1101823554=     WHERE CUR_PARAMS = 2'
      '1101823555=      INTO :G_TOCHKA_;'
      '1101823556='
      '1101823557=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101823558=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1101823559=      PNT_ = '#39'01'#39';'
      
        '1101823560=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101823561=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101823562=      ELSE'
      '1101823563=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101823564='
      '1101823565=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1101823566=      SELECT G.G_OFFICIAL,'
      '1101823567=             G.DO_NOT_SALES_COMM,'
      '1101823568=             G.FM||'#39' '#39'||G.NM'
      '1101823569=        FROM G_OFFICIAL G'
      
        '1101823570=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1101823571=        INTO :G_OFFICIAL_,'
      '1101823572=             :DO_NOT_SALES_COMM_,'
      '1101823573=             :OFFICIAL_NAME_;'
      '1101823574='
      '1101823575=      INSERT INTO ZAKAZ'
      '1101823576=      ('
      '1101823577=       ZAKAZ,'
      '1101823578=       G_TOCHKA,'
      '1101823579=       Z_DATE,'
      '1101823580=       Z_TIME,'
      '1101823581=       G_CLIENT,'
      '1101823582=       G_PAYMENT_TYPE,'
      '1101823583=       OSNOVANIE,'
      '1101823584=       IS_SPISANIE,'
      '1101823585=       NOTE,'
      '1101823586=       SUMM,'
      '1101823587=       SUMM_FACT,'
      '1101823588=       SUMM_BONUS,'
      '1101823589=       IS_PAYED_ALL'
      '1101823590=       ,G_OFFICIAL'
      '1101823591=       ,BY_RECIPE'
      '1101823592=       ,SUMM_BONUS_GOT'
      '1101823593=       ,IS_RESERVE'
      '1101823594=       ,SUMM_CASH'
      '1101823595=       ,SUMM_NONCASH'
      '1101823596=       ,NOT_MINUS_OSTATOK'
      '1101823597=      ) VALUES ('
      '1101823598=       GEN_ID(GEN_ZAKAZ, 1),'
      '1101823599=       :G_TOCHKA_,'
      '1101823600=       :Z_DATE_,'
      '1101823601=       :Z_TIME_,'
      '1101823602=       :G_CLIENT_,'
      '1101823603=       :G_PAYMENT_TYPE_,'
      '1101823604=       :OSNOVANIE_,'
      '1101823605=       :IS_SPISANIE_,'
      '1101823606=       :NOTE_,'
      '1101823607=       :SUMM_,'
      '1101823608=       :SUMM_FACT_1_,'
      '1101823609=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1101823610=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101823611=       ,:G_OFFICIAL_'
      '1101823612=       ,:BY_RECIPE_'
      '1101823613=       ,:SUMM_BONUS_GOT_'
      '1101823614=       ,:IS_RESERVE_'
      '1101823615=       ,COALESCE(:SUMM_CASH_, 0)'
      '1101823616=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1101823617=       ,:NOT_MINUS_OSTATOK_'
      '1101823618=      )'
      '1101823619=      RETURNING'
      '1101823620=        ZAKAZ'
      '1101823621=      INTO'
      '1101823622=        :ZAKAZ_;'
      '1101823623='
      '1101823624=      PNT_ = '#39'02'#39';'
      
        '1101823625=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1101823626=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM, Z.MARK_CODE'
      '1101823627=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1101823628=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1101823629=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1101823630=              :G_PRODUCT,'
      '1101823631=              :AMOUNT,'
      '1101823632=              :PRICE,'
      '1101823633=              :SUMM,'
      '1101823634=              :DISCOUNT_PERC,'
      '1101823635=              :DISCOUNT_TENGE,'
      '1101823636=              :DISCOUNT_SUMM,'
      '1101823637=              :NDS,'
      '1101823638=              :NDS_SUMM,'
      '1101823639=              :COST_PRICE,'
      '1101823640=              :SALES_COMM_,'
      '1101823641=              :MARK_CODE_'
      '1101823642=      DO BEGIN'
      
        '1101823643=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101823644=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1101823645=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1101823646=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101823647=        END'
      '1101823648='
      '1101823649=        INSERT INTO ZAKAZ_DETAILS'
      '1101823650=        VALUES('
      '1101823651=          :ZAKAZ_DETAILS_TMP_,'
      '1101823652=          :ZAKAZ_,'
      '1101823653=          :G_PRODUCT,'
      '1101823654=          :AMOUNT,'
      '1101823655=          :PRICE,'
      '1101823656=          :SUMM,'
      '1101823657=          :DISCOUNT_PERC,'
      '1101823658=          :DISCOUNT_TENGE,'
      '1101823659=          :DISCOUNT_SUMM,'
      '1101823660=          :NDS,'
      '1101823661=          :NDS_SUMM,'
      '1101823662=          :COST_PRICE,'
      '1101823663=          :SALES_COMM_SUMM_ITER_,'
      '1101823664=          :MARK_CODE_'
      '1101823665=        );'
      '1101823666='
      
        '1101823667=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1101823668=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1101823669=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1101823670=                UPDATE LT_SKLAD_PRODUCT L'
      '1101823671=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1101823672=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1101823673=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101823674=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101823675='
      '1101823676=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101823677=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101823678=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057 +
        #1051#1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '1101823679=                PNT_ = '#39'04'#39';'
      
        '1101823680=                IF ((ROW_COUNT = 0) AND ((SELECT S_VA' +
        'LUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101823681=                  Err_Code = -20500;'
      
        '1101823682=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_C' +
        'ODE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_' +
        'PRODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072 +
        #1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101823683=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101823684=                  EXIT;'
      '1101823685=                END ELSE if (ROW_COUNT = 0) then'
      
        '1101823686=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101823687=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1101823688=            END'
      '1101823689='
      '1101823690=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101823691=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101823692=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101823693=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :AMOUNT'
      '1101823694=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101823695=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101823696='
      '1101823697='
      '1101823698=        END'
      '1101823699=      END'
      '1101823700='
      '1101823701=      ----------------------------------------'
      
        '1101823702=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1101823703=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1101823704=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1101823705='
      
        '1101823706=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1101823707=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1101823708=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1101823709=                PNT_ = '#39'05'#39';'
      
        '1101823710=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1101823711=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101823712=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1101823713=                                              :Z_DATE' +
        '_,'
      
        '1101823714=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101823715=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1101823716=                                              NULL,'
      
        '1101823717=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1101823718=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101823719=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101823720=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101823721=                  EXIT;'
      '1101823722=                END'
      '1101823723=            END'
      '1101823724='
      '1101823725=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1101823726=        END ELSE BEGIN'
      '1101823727=            PNT_ = '#39'06'#39';'
      
        '1101823728=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1101823729=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101823730=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101823731=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101823732=                ELSE'
      
        '1101823733=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101823734='
      
        '1101823735=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101823736=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101823737='
      
        '1101823738=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101823739='
      '1101823740=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101823741=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101823742=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1101823743=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101823744=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101823745=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101823746=                                                  :ZA' +
        'KAZ_,'
      
        '1101823747=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1101823748=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101823749=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101823750=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101823751=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101823752=                      EXIT;'
      '1101823753=                    END'
      '1101823754=                END'
      '1101823755=            END'
      '1101823756=        END'
      '1101823757=      END'
      '1101823758='
      
        '1101823759=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1101823760=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1101823761=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1101823762=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1101823763=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1101823764=          UPDATE G_DISCONT_CARD D'
      
        '1101823765=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1101823766=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1101823767=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1101823768=          RETURNING'
      '1101823769=            D.SUMM_ALL'
      '1101823770=          INTO'
      '1101823771=            :CLIENT_SUMM_ALL_;'
      '1101823772='
      '1101823773=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1101823774=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1101823775=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1101823776=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1101823777=          ORDER BY G.SUMM_FROM'
      '1101823778=          ROWS 1 TO 1'
      '1101823779=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1101823780='
      '1101823781=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1101823782=            UPDATE G_CLIENT G'
      '1101823783=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1101823784=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1101823785=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1101823786='
      '1101823787=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1101823788=            UPDATE G_DISCONT_CARD D'
      '1101823789=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1101823790=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1101823791=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1101823792=      END'
      '1101823793='
      '1101823794=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1101823795=      PNT_ = '#39'07'#39';'
      
        '1101823796=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN ' +
        'BEGIN'
      '1101823797=        SELECT S.S_VALUE'
      '1101823798=          FROM SYSTEM_SETUP S'
      '1101823799=         WHERE S.SYSTEM_SETUP = 4'
      '1101823800=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101823801='
      '1101823802=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101823803=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101823804=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101823805='
      
        '1101823806=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1101823807=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1101823808=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1101823809='
      '1101823810=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101823811=        ELSE'
      
        '1101823812=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1101823813='
      '1101823814=        KASSA_ZP_ID_ = NULL;'
      '1101823815=        SELECT K.KASSA, K.SUMM'
      '1101823816=        FROM KASSA K'
      '1101823817=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1101823818=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101823819=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101823820=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1101823821=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1101823822='
      
        '1101823823=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1101823824='
      '1101823825=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1101823826=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101823827=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101823828=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101823829=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101823830=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1101823831=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1101823832=                                          NULL,     -' +
        '-:SKLAD_,'
      '1101823833=                                          1,'
      '1101823834=                                          :G_TOCHKA_,'
      
        '1101823835=                                          :G_OFFICIAL' +
        '_'
      
        '1101823836=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1101823837=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101823838=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1101823839='
      '1101823840=        END ELSE BEGIN'
      
        '1101823841=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1101823842=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101823843=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101823844=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101823845='
      
        '1101823846=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1101823847=                                          1,     -- A' +
        'CTION_'
      
        '1101823848=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101823849=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101823850=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101823851=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      '1101823852=                                          NULL,'
      '1101823853=                                          NULL,'
      
        '1101823854=                                          :PAYMENT_TY' +
        'PE_,'
      
        '1101823855=                                          :G_OFFICIAL' +
        '_'
      
        '1101823856=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1101823857='
      '1101823858=        END'
      '1101823859=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101823860=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101823861=          EXIT;'
      '1101823862=        END'
      '1101823863=      END'
      '1101823864='
      '1101823865=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101823866=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101823867=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101823868=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1);'
      '1101823869=  END'
      '1101823870=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101823871=  ----------------------------------------'
      '1101823872=  ----------------------------------------'
      '1101823873=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101823874=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1101823875=      PNT_ = '#39'25'#39';'
      
        '1101823876=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1101823877=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1101823878=      RETURNING ZAKAZ_REAL_PARENT'
      '1101823879=      INTO :ZAKAZ_;'
      '1101823880='
      
        '1101823881=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1101823882=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101823883=          INTO :G_PRODUCT,'
      '1101823884=              :AMOUNT,'
      '1101823885=              :PRICE,'
      '1101823886=              :SUMM,'
      '1101823887=              :DISCOUNT_PERC,'
      '1101823888=              :DISCOUNT_TENGE,'
      '1101823889=              :DISCOUNT_SUMM,'
      '1101823890=              :NDS,'
      '1101823891=              :NDS_SUMM'
      '1101823892=      DO BEGIN'
      '1101823893=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101823894=          UPDATE LT_SKLAD_PRODUCT L'
      '1101823895=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1101823896=                 L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_AP' +
        'P_'
      '1101823897=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101823898=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101823899='
      
        '1101823900=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101823901=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1101823902=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101823903=            Err_Code = -20500;'
      
        '1101823904=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101823905=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101823906=            EXIT;'
      '1101823907=          END ELSE if (ROW_COUNT = 0) then'
      
        '1101823908=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101823909=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1101823910='
      
        '1101823911=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1101823912=                                     G_PRODUCT,'
      '1101823913=                                     PRICE,'
      
        '1101823914=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1101823915=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1101823916=                                     NDS_SUMM)'
      
        '1101823917=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_,'
      '1101823918=                  :G_PRODUCT,'
      
        '1101823919=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1101823920=                  :AMOUNT, :SUMM,'
      '1101823921=                  0, --AMOUNT_PAYED,'
      '1101823922=                  0, --SUMM_PAYED,'
      '1101823923=                  0, --IS_PAYED_ALL,'
      '1101823924=                  :DISCOUNT_PERC,'
      '1101823925=                  :DISCOUNT_TENGE,'
      '1101823926=                  :DISCOUNT_SUMM,'
      '1101823927=                  :NDS,'
      '1101823928=                  :NDS_SUMM)'
      '1101823929=          RETURNING ZAKAZ_NA_REAL'
      '1101823930=          INTO :ZAKAZ_;'
      '1101823931=      END'
      '1101823932=  END'
      '1101823933=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101823934=  ----------------------------------------'
      '1101823935=  ----------------------------------------'
      '1101823936=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1101823937=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1101823938=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101823939=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1101823940=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1101823941=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1101823942=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1101823943=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1101823944=      RETURNING SKLAD'
      '1101823945=      INTO :ZAKAZ_;'
      '1101823946='
      '1101823947=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101823948=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101823949=          INTO :G_PRODUCT,'
      '1101823950=              :AMOUNT,'
      '1101823951=              :PRICE,'
      '1101823952=              :SUMM'
      '1101823953=      DO BEGIN'
      '1101823954=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101823955=        UPDATE LT_SKLAD_PRODUCT L'
      '1101823956=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1101823957=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101823958=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101823959=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101823960='
      '1101823961=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101823962=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1101823963=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1101823964=        SELECT MAX(SK.DATE_RECEIPT)'
      '1101823965=            FROM SKLAD SK'
      '1101823966=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101823967=             AND SK.IS_LAST = 1'
      '1101823968=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1101823969=            INTO :DATE_LAST_;'
      '1101823970='
      
        '1101823971=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101823972=            UPDATE SKLAD SK'
      '1101823973=               SET SK.IS_LAST = 0'
      '1101823974=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101823975=               AND SK.IS_LAST = 1'
      '1101823976=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101823977='
      '1101823978=            IS_THIS_LAST_ = 1;'
      '1101823979=        END */'
      '1101823980='
      '1101823981='
      '1101823982=        INSERT INTO SKLAD'
      '1101823983=        ('
      '1101823984=         SKLAD,'
      '1101823985=         SKLAD_PARENT,'
      '1101823986=         DATE_RECEIPT,'
      '1101823987=         G_CLIENT,'
      '1101823988=         G_PRODUCT,'
      '1101823989=         AMOUNT,'
      '1101823990=         PRICE,'
      '1101823991=         SUMM,'
      '1101823992=         G_PAYMENT_TYPE,'
      '1101823993=         OSNOVANIE,'
      '1101823994=         NOTE,'
      '1101823995=         NDS,'
      '1101823996=         NDS_SUMM,'
      '1101823997=         IS_LAST,'
      '1101823998=         IS_VOZVRAT,'
      '1101823999=         G_TOCHKA'
      '1101824000=        ) VALUES ('
      '1101824001=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101824002=         :ZAKAZ_,'
      '1101824003=         :Z_DATE_,'
      '1101824004=         :G_TOCHKA_,'
      '1101824005=         :G_PRODUCT,'
      '1101824006=         :AMOUNT,'
      '1101824007=         :PRICE,'
      '1101824008=         :SUMM,'
      '1101824009=         :G_PAYMENT_TYPE_,'
      '1101824010=         :OSNOVANIE_,'
      '1101824011=         :NOTE_,'
      '1101824012=         0,  --:RNDS_,'
      '1101824013=         0,  --:RNDS_SUMM_,'
      
        '1101824014=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1101824015=         3,  --:IS_VOZVRAT_,'
      '1101824016=         :G_CLIENT_'
      '1101824017=        );'
      '1101824018='
      
        '1101824019=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101824020=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1101824021=        PNT_ = '#39'02'#39';'
      '1101824022=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101824023=            UPDATE LT_SKLAD_PRODUCT L'
      '1101824024=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1101824025=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101824026=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101824027=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1101824028='
      '1101824029=            IF (ROW_COUNT = 0) THEN'
      
        '1101824030=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101824031=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1101824032=        END'
      '1101824033=      END'
      '1101824034=  END'
      '1101824035='
      '1101824036=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101824037='
      
        '1101824038=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1101824039=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101824040=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1101824041=                                  G_PRIHOD_,'
      '1101824042=                                  :SUMM_PRIHOD_,'
      '1101824043=                                  :Z_DATE_,'
      
        '1101824044=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101824045=                                  :ZAKAZ_,'
      '1101824046=                                  NULL,'
      '1101824047=                                  :G_PAYMENT_TYPE_,'
      
        '1101824048=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101824049=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101824050=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101824051=      EXIT;'
      '1101824052=    END'
      '1101824053=  END'
      '1101824054='
      
        '1101824055=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1101824056=  IF (IS_MEBEL_ = 1) THEN'
      
        '1101824057=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1101824058=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1101824059='
      '1101824060=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101824061=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1101824062='
      '1101824063=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1101824064=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1101824065=end'
      '1101824066=;'
      '1101824067='
      '1101824068=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1101824069=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101824070=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101824071=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101824072=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101824073=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101824074=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101824075=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101824076=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101824077=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101824078=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101824079=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101824080=RETURNS ('
      '1101824081=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101824082=  ERR_CODE INTEGER,'
      '1101824083=  ERR_MSG VARCHAR(1024))'
      '1101824084=AS'
      
        '1101824085=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1101824086=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1101824087=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1101824088=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1101824089='
      
        '1101824090=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101824091=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1101824092=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1101824093=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101824094=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101824095=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101824096=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1101824097=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1101824098=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1101824099=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1101824100=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101824101=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101824102=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1101824103=BEGIN'
      '1101824104='
      '1101824105=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101824106=    SELECT ID'
      '1101824107=      FROM CUR_PARAMS'
      '1101824108=     WHERE CUR_PARAMS = 2'
      '1101824109=      INTO :G_TOCHKA_;'
      '1101824110='
      
        '1101824111=  --*************************************************' +
        '*************************************************'
      
        '1101824112=  --*************************************************' +
        '*************************************************'
      '1101824113=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101824114=  --*************************************************' +
        '*************************************************'
      
        '1101824115=  --*************************************************' +
        '*************************************************'
      '1101824116=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1101824117=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1101824118=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1101824119=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101824120=            INTO :AMOUNT_,'
      '1101824121=                 :G_PRODUCT_'
      '1101824122=      DO BEGIN'
      '1101824123=          UPDATE LT_SKLAD_PRODUCT L'
      
        '1101824124=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_      ' +
        '-- 03.03.2021 '#1057#1070#1044#1040' '#1053#1045' '#1057#1058#1040#1051' '#1057#1058#1040#1042#1048#1058#1068' NEED_TO_REPLACE '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1047#1040 +
        #1063#1045#1052
      '1101824125=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101824126=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101824127=      END'
      '1101824128='
      '1101824129=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1101824130=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1101824131=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1101824132=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1101824133=             NDS_SUMM, COST_PRICE'
      '1101824134=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101824135='
      '1101824136=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101824137=                                  :Z_DATE_,'
      '1101824138=                                  :Z_TIME_,'
      '1101824139=                                  :G_CLIENT_,'
      '1101824140=                                  :G_PAYMENT_TYPE_,'
      '1101824141=                                  :OSNOVANIE_,'
      
        '1101824142=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1101824143=                                  :NOTE_,'
      
        '1101824144=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1101824145=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1101824146=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1101824147=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1101824148=                                  0, --SUMM_BONUS_'
      
        '1101824149=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1101824150=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101824151=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1101824152=                                  0,    --BY_RECIPE'
      '1101824153=                                  0     --IS_RESERVE'
      '1101824154=                                  ,NULL  -- PAYMENTS_'
      '1101824155=                                  ,0     --IS_MEBEL_'
      
        '1101824156=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1101824157=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1101824158=                                  ,NULL  --ADDRESS_'
      '1101824159=                                  ,NULL  --PRICE_'
      
        '1101824160=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      '1101824161=                                  )'
      '1101824162=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1101824163='
      '1101824164=      if (ERR_CODE <> 0) then BEGIN'
      '1101824165=        ERR_CODE = -20500;'
      '1101824166=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101824167=        Exit;'
      '1101824168=      END'
      '1101824169='
      
        '1101824170=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101824171=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1101824172=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1101824173=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1101824174=      UPDATE ZAKAZ'
      '1101824175=         SET IS_SPISANIE = 2'
      '1101824176=       WHERE ZAKAZ = :ZAKAZ_;'
      '1101824177='
      
        '1101824178=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101824179=      FOR SELECT T.AMOUNT,'
      '1101824180=                 T.SUMM,'
      '1101824181=                 T.G_PRODUCT,'
      '1101824182=                 T.ZAKAZ_NA_REAL,'
      '1101824183=                 T.ZAKAZ_DETAILS'
      '1101824184=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101824185=            INTO :AMOUNT_,'
      '1101824186=                 :Z_SUMM_,'
      '1101824187=                 :G_PRODUCT_,'
      '1101824188=                 :ZAKAZ_NA_REAL_,'
      '1101824189=                 :ZAKAZ_DETAILS_'
      '1101824190=      DO BEGIN'
      '1101824191=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101824192=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1101824193=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1101824194=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101824195=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101824196='
      
        '1101824197=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101824198=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1101824199=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1101824200=      END'
      '1101824201=  END'
      '1101824202=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101824203=  --*************************************************' +
        '*************************************************'
      
        '1101824204=  --*************************************************' +
        '*************************************************'
      '1101824205='
      
        '1101824206=  --*************************************************' +
        '*************************************************'
      
        '1101824207=  --*************************************************' +
        '*************************************************'
      '1101824208=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101824209=  --*************************************************' +
        '*************************************************'
      
        '1101824210=  --*************************************************' +
        '*************************************************'
      '1101824211=  ELSE BEGIN'
      '1101824212=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1101824213=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101824214=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101824215=      FOR SELECT T.AMOUNT,'
      '1101824216=                 T.SUMM,'
      '1101824217=                 T.G_PRODUCT,'
      '1101824218=                 T.ZAKAZ_NA_REAL,'
      '1101824219=                 T.ZAKAZ_DETAILS'
      '1101824220=                 ,T.PRICE'
      '1101824221=                 ,T.NDS'
      '1101824222=                 ,T.NDS_SUMM'
      '1101824223=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101824224=            INTO :AMOUNT_,'
      '1101824225=                 :Z_SUMM_,'
      '1101824226=                 :G_PRODUCT_,'
      '1101824227=                 :ZAKAZ_NA_REAL_,'
      '1101824228=                 :ZAKAZ_DETAILS_'
      '1101824229=                 ,:PRICE_'
      '1101824230=                 ,:NDS_'
      '1101824231=                 ,:NDS_SUMM_'
      '1101824232=      DO BEGIN'
      
        '1101824233=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101824234=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1101824235='
      
        '1101824236=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1101824237=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1101824238='
      '1101824239=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101824240=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1101824241=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1101824242=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101824243=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101824244=      END'
      '1101824245='
      '1101824246=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101824247=                                  :Z_DATE_,'
      '1101824248=                                  :Z_TIME_,'
      '1101824249=                                  :G_CLIENT_,'
      '1101824250=                                  :G_PAYMENT_TYPE_,'
      '1101824251=                                  :OSNOVANIE_,'
      '1101824252=                                  :NOTE_,'
      
        '1101824253=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1101824254=                                  :SUMM_,'
      '1101824255=                                  :SUMM_FACT_,'
      
        '1101824256=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1101824257=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1101824258=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1101824259=                                  ,0        --SUMM_CU' +
        'RRENCY_'
      
        '1101824260=                                  ,0        --IS_EXPE' +
        'CTED_'
      
        '1101824261=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      
        '1101824262=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1101824263='
      '1101824264=      if (ERR_CODE <> 0) then BEGIN'
      '1101824265=        ERR_CODE = -20500;'
      '1101824266=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101824267=        Exit;'
      '1101824268=      END'
      '1101824269=  END'
      '1101824270=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101824271=  --*************************************************' +
        '*************************************************'
      
        '1101824272=  --*************************************************' +
        '*************************************************'
      '1101824273='
      '1101824274=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101824275=END'
      '1101824276=;'
      '1101824277='
      '1101824278=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD('
      '1101824279=  OBJECT_TYPE_ INTEGER,'
      '1101824280=  LOAD_TYPE_ INTEGER = 0,'
      '1101824281=  OPER_ INTEGER = 0)'
      '1101824282=RETURNS ('
      '1101824283=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '1101824284=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101824285=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101824286=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101824287=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101824288=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101824289=  CLIENT_ID TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101824290=  IDN TYPE OF COLUMN G_CLIENT.IDN,'
      '1101824291=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101824292=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '1101824293=  SUMM_ALL TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101824294=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101824295=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101824296=  SUMM_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1101824297=  SUMM_SERT MY_NUMERIC,'
      '1101824298=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101824299=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101824300=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101824301=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101824302=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101824303=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101824304=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101824305=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101824306=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_A' +
        'PP,'
      '1101824307=  PARENT_ID TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1101824308=  ITEM_ID TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DETAILS,'
      '1101824309=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1101824310=  G_TOCHKA TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101824311=  RTYPE TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '1101824312=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE)'
      '1101824313=AS'
      '1101824314=/*'
      
        '1101824315=OPER_      : '#1058#1048#1055' '#1054#1055#1045#1056#1040#1062#1048#1048', 1 - '#1042#1057#1058#1040#1042#1050#1040', 2 - '#1048#1047#1052#1045#1053#1045#1053#1048#1045 +
        ', 3 - '#1059#1044#1040#1051#1045#1053#1048#1045
      
        '1101824316=LOAD_TYPE_ : '#1058#1048#1055' '#1042#1067#1043#1056#1059#1047#1050#1048'  0 - '#1054#1041#1067#1063#1053#1040#1071', 1 - '#1044#1051#1071' '#1052#1054#1041#1048#1051 +
        #1050#1048
      '1101824317=*/'
      '1101824318=BEGIN'
      '1101824319='
      
        '1101824320=-- G_PRODUCT, '#1058#1054#1051#1068#1050#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1071', '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1054 +
        #1050#1040' '#1055#1054#1057#1067#1051#1040#1058#1068' '#1042' '#1052#1054#1041#1048#1051#1050#1059' '#1053#1045' '#1041#1059#1044#1059
      '1101824321=  IF (OBJECT_TYPE_ = 4) THEN BEGIN'
      '1101824322=    FOR SELECT TT.ARTICUL'
      '1101824323=              ,TT.BARCODE'
      '1101824324=              ,TT.NOMENCLATUR_NUM'
      '1101824325=              ,TT.NAME'
      '1101824326=              ,TT.PRICE'
      '1101824327=              ,TT.SYNC_EXT_APP'
      '1101824328=              ,TT.G_PRODUCT_PAR'
      '1101824329=              ,TT.IS_CATEGORY'
      '1101824330=              ,TT.G_PRODUCT'
      '1101824331=          FROM ('
      
        '1101824332=                WITH RECURSIVE TREE AS (SELECT T.G_PR' +
        'ODUCT,'
      '1101824333=                               T.G_PRODUCT_PAR,'
      '1101824334=                               T.NAME,'
      '1101824335=                               1 LVL'
      '1101824336=                          FROM G_PRODUCT T'
      
        '1101824337=                         WHERE T.G_PRODUCT_PAR IS NUL' +
        'L'
      '1101824338=                           AND T.IS_CATEGORY = 1'
      '1101824339=                           AND T.IS_ACTIVE = 1'
      '1101824340=                        UNION ALL'
      '1101824341=                        SELECT T.G_PRODUCT,'
      '1101824342=                               T.G_PRODUCT_PAR,'
      '1101824343=                               T.NAME,'
      '1101824344=                               GG.LVL + 1'
      
        '1101824345=                          FROM G_PRODUCT T INNER JOIN' +
        ' TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '1101824346=                         WHERE T.IS_CATEGORY = 1'
      '1101824347=                           AND T.IS_ACTIVE = 1'
      '1101824348=                       )'
      
        '1101824349=                SELECT AP.OPER, TR.G_PRODUCT, '#39#39' ARTI' +
        'CUL, '#39#39' BARCODE, '#39#39' NOMENCLATUR_NUM, TR.NAME, 0 PRICE, AP.SYNC_E' +
        'XT_APP, TR.G_PRODUCT_PAR, 1 IS_CATEGORY, TR.LVL'
      '1101824350=                FROM TREE TR,'
      '1101824351=                     SYNC_EXT_APP AP'
      '1101824352=                WHERE TR.G_PRODUCT = AP.ID'
      '1101824353=                AND AP.IS_LOADING = 1'
      '1101824354=                AND AP.OBJECT_TYPE = 4'
      
        '1101824355=                AND AP.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051 +
        #1045#1053#1048#1071
      '1101824356=                AND :OPER_ <> 3'
      '1101824357=                UNION ALL'
      '1101824358=                SELECT S.OPER'
      '1101824359=                      ,P.G_PRODUCT'
      '1101824360=                      ,P.ARTICUL'
      '1101824361=                      ,P.BARCODE'
      '1101824362=                      ,P.NOMENCLATUR_NUM'
      '1101824363=                      ,P.NAME'
      '1101824364=                      ,P.PRICE'
      '1101824365=                      ,S.SYNC_EXT_APP'
      '1101824366=                      ,P.G_PRODUCT_PAR'
      '1101824367=                      ,P.IS_CATEGORY'
      '1101824368=                      ,10000 LVL'
      '1101824369=                 FROM SYNC_EXT_APP S'
      '1101824370=                      ,G_PRODUCT P'
      '1101824371=                WHERE S.IS_LOADING = 1'
      
        '1101824372=                  AND ((S.IS_LOADED = 0 AND :LOAD_TYP' +
        'E_ = 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '1101824373=                  AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1101824374=                  AND S.OBJECT_TYPE = 4'
      '1101824375=                  AND S.ID = P.G_PRODUCT'
      '1101824376=                  AND P.IS_CATEGORY = 0'
      
        '1101824377=                  AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040 +
        #1051#1045#1053#1048#1071
      '1101824378=                  AND :OPER_ <> 3'
      '1101824379=                UNION ALL'
      '1101824380=                SELECT S.OPER'
      '1101824381=                      ,S.ID G_PRODUCT'
      '1101824382=                      ,'#39#39' ARTICUL'
