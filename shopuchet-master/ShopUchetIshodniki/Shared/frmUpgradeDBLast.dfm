      '1102283387=      END'
      '1102283388=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1102283389=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1102283390=      ELSE BEGIN'
      
        '1102283391=          -------------------------------------------' +
        '------------------'
      
        '1102283392=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1102283393=          PNT_ = '#39'025'#39';'
      '1102283394=          FOR SELECT SKLAD,'
      '1102283395=                     AMOUNT,'
      '1102283396=                     G_PRODUCT'
      '1102283397=                FROM SKLAD S'
      '1102283398=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1102283399=                 AND NOT EXISTS (SELECT 1'
      
        '1102283400=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1102283401=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1102283402=          INTO :SKLAD_,'
      '1102283403=               :Z_AMOUNT_,'
      '1102283404=               :G_PRODUCT_'
      '1102283405=          DO BEGIN'
      
        '1102283406=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :E' +
        'RR_MSG);'
      '1102283407=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102283408=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102283409=              EXIT;'
      '1102283410=            END'
      '1102283411=          END'
      '1102283412='
      '1102283413=          PNT_ = '#39'030'#39';'
      '1102283414=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1102283415=                     S.G_PRODUCT,'
      '1102283416=                     S.AMOUNT,'
      '1102283417=                     S.PRICE,'
      '1102283418=                     S.SUMM,'
      '1102283419=                     T.SKLAD,'
      '1102283420=                     T.AMOUNT,'
      '1102283421=                     T.IS_LAST,'
      '1102283422=                     T.DATE_RECEIPT'
      
        '1102283423=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1102283424=                INTO :ZAKAZ_DETAILS_,'
