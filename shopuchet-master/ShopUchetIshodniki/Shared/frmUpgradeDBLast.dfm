        '110588=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERIC' +
        '(15,2),'
      
        '110589=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTEGE' +
