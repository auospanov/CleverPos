      '1102503480=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102503481=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1102503482=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1102503483=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1102503484=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102503485=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1102503486=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1102503487=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102503488=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102503489=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1102503490=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102503491=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1102503492=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1102503493=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1102503494=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1102503495=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102503496=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1102503497=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1102503498=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1102503499=BEGIN'
      '1102503500='
      
        '1102503501=  -- '#1050#1040#1050#1048#1052'-'#1058#1054' '#1054#1041#1056#1040#1047#1054#1052' '#1055#1056#1054#1055#1040#1044#1040#1070#1058' '#1044#1045#1058#1040#1051#1048' '#1048#1047' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1045 +
        #1055#1054#1053#1071#1058#1053#1054
      '1102503502=  PNT_ = '#39'00'#39';'
      '1102503503=  SELECT COUNT(*)'
      '1102503504=    FROM ZAKAZ_DETAILS_TMP T'
      '1102503505=    INTO :CNT_;'
      '1102503506=  IF (CNT_ = 0) THEN BEGIN'
      '1102503507=     ERR_CODE = -20500;'
      
        '1102503508=     EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074 +
        #1072#1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'. '#1055#1088#1086#1076#1086#1083#1078#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      
        '1102503509=     ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '1102503510=     EXIT;'
      '1102503511=  END'
      '1102503512='
      '1102503513=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102503514=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102503515=      SELECT Z.G_PAYMENT_TYPE,'
      '1102503516=             Z.G_TOCHKA,'
      '1102503517=             Z.SUMM,'
      '1102503518=             Z.SUMM_BONUS,'
      '1102503519=             Z.SUMM_BONUS_GOT,'
      '1102503520=             z.g_client,'
      '1102503521=             Z.G_OFFICIAL,'
      '1102503522=             G.DO_NOT_SALES_COMM,'
      
        '1102503523=             COALESCE(G.FM, '#39#39')||'#39' '#39'||COALESCE(G.NM, ' +
        #39#39')'
      
        '1102503524=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1102503525=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102503526=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1102503527=             :G_TOCHKA_,'
      '1102503528=             :SUMM_OLD_,'
      '1102503529=             :SUMM_BONUS_OLD_,'
      '1102503530=             :SUMM_BONUS_GOT_OLD_,'
      '1102503531=             :g_client_old_,'
      '1102503532=             :G_OFFICIAL_,'
      '1102503533=             :DO_NOT_SALES_COMM_,'
      '1102503534=             :OFFICIAL_NAME_;'
      '1102503535='
      
        '1102503536=      -- 07.09.2021 '#1055#1054#1050#1040' '#1059#1041#1056#1040#1051' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059', '#1041#1059#1044#1059#1058' '#1054#1058#1063#1045#1058#1067' '#1044#1045#1056#1043#1040#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047
      
        '1102503537=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1102503538=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1102503539=        SELECT SUM(ZD.SALES_COMM)'
      '1102503540=          FROM ZAKAZ_DETAILS ZD'
      '1102503541=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102503542=          INTO :SALES_COMM_OLD_;'
      '1102503543=      */'
      '1102503544='
      '1102503545=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1102503546=      PNT_ = '#39'01'#39';'
      
        '1102503547=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102503548=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102503549=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102503550=        EXIT;'
      '1102503551=      END'
      '1102503552='
      
        '1102503553=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102503554=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102503555=      ELSE'
      '1102503556=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102503557='
      '1102503558=      PNT_ = '#39'02'#39';'
      '1102503559=      UPDATE zakaz'
      '1102503560=      SET'
      '1102503561=       G_TOCHKA = :G_TOCHKA_,'
      '1102503562=       Z_DATE = :Z_DATE_,'
      '1102503563=       Z_TIME = :Z_TIME_,'
      '1102503564=       G_CLIENT = :G_CLIENT_,'
      '1102503565=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102503566=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102503567=       NOTE = COALESCE(:NOTE_, NOTE),'
      
        '1102503568=       DELIVERY_ADDRESS = COALESCE(:ADDRESS_, DELIVER' +
        'Y_ADDRESS),'
      '1102503569=       SUMM = :SUMM_,'
      '1102503570=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1102503571=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102503572=       ,BY_RECIPE = :BY_RECIPE_'
      '1102503573=       ,IS_RESERVE = :IS_RESERVE_'
      '1102503574=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1102503575=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1102503576=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1102503577=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1102503578=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1102503579=       ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102503580=      WHERE'
      '1102503581=        zakaz = :zakaz_;'
      '1102503582='
      
        '1102503583=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1102503584=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1102503585=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1102503586=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1102503587=          UPDATE G_DISCONT_CARD D'
      '1102503588=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1102503589=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1102503590=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1102503591='
      
        '1102503592=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1102503593=          SUMM_OLD_           = 0;'
      '1102503594=      END'
      '1102503595=      UPDATE G_DISCONT_CARD D'
      
        '1102503596=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1102503597=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1102503598=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1102503599='
      '1102503600=      PNT_ = '#39'03'#39';'
      '1102503601=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1102503602=                 T.G_PRODUCT,'
      '1102503603=                 T.AMOUNT,'
      '1102503604=                 T.SUMM,'
      '1102503605=                 G.SALES_COMM'
      '1102503606=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1102503607=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1102503608=      INTO :ZAKAZ_DETAILS_,'
      '1102503609=           :G_PRODUCT_,'
      '1102503610=           :Z_AMOUNT_,'
      '1102503611=           :DETAILS_SUMM_,'
      '1102503612=           :SALES_COMM_'
      '1102503613=      DO BEGIN'
      
        '1102503614=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102503615=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1102503616=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1102503617=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102503618=        END'
      '1102503619='
      
        '1102503620=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102503621=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1102503622=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102503623=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1102503624=          FROM ZAKAZ_DETAILS_TMP Z'
      '1102503625=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1102503626='
      '1102503627=        -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1102503628=        IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1102503629=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' ' +
        #1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1102503630=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN'
      '1102503631=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102503632=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1102503633=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102503634=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102503635=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102503636='
      '1102503637=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102503638=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102503639=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102503640=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :Z_AMOUNT_'
      '1102503641=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102503642=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102503643=        END'
      '1102503644=      END'
      '1102503645='
      '1102503646=      ----------------------------------------'
      
        '1102503647=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102503648=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1102503649=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1102503650=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102503651=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1102503652=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
