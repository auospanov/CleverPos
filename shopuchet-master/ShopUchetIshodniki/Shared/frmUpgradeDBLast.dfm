      '1101852608=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101852609=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
