      '1101521972='
      '1101521973=      ----------------------------------------'
      
        '1101521974=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1101521975=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1101521976=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1101521977='
      
        '1101521978=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1101521979=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1101521980=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1101521981=                PNT_ = '#39'05'#39';'
      
        '1101521982=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1101521983=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101521984=                                              :SUMM_F' +
