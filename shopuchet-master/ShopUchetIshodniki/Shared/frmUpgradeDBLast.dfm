      '11019422=ALTER PROCEDURE P_REP_PROFIT('
      '11019423=  DATE_BEGIN_ DATE,'
      '11019424=  DATE_END_ DATE,'
      
        '11019425=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
