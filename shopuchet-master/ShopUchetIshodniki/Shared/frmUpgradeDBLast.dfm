        '1102111116=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1102111117=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1102111118=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1102111119=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1102111120=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1102111121=          UPDATE G_DISCONT_CARD D'
      
        '1102111122=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1102111123=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1102111124=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1102111125=          RETURNING'
      '1102111126=            D.SUMM_ALL'
      '1102111127=          INTO'
      '1102111128=            :CLIENT_SUMM_ALL_;'
      '1102111129='
      '1102111130=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1102111131=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1102111132=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1102111133=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1102111134=          ORDER BY G.SUMM_FROM'
      '1102111135=          ROWS 1 TO 1'
      '1102111136=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1102111137='
      '1102111138=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1102111139=            UPDATE G_CLIENT G'
      '1102111140=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1102111141=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1102111142=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1102111143='
      '1102111144=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1102111145=            UPDATE G_DISCONT_CARD D'
      '1102111146=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1102111147=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1102111148=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1102111149=      END'
      '1102111150='
      
        '1102111151=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' ' +
        #1057' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', ' +
        #1050#1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '1102111152=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057 +
        #1051#1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102111153=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102111154=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102111155=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102111156=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1102111157=      PNT_ = '#39'07'#39';'
      
        '1102111158=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THE' +
        'N BEGIN'
      '1102111159=        SELECT S.S_VALUE'
      '1102111160=          FROM SYSTEM_SETUP S'
      '1102111161=         WHERE S.SYSTEM_SETUP = 4'
      '1102111162=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102111163='
      '1102111164=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102111165=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102111166=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102111167='
      
        '1102111168=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1102111169=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1102111170=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1102111171='
      '1102111172=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102111173=        ELSE'
      
        '1102111174=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1102111175='
      '1102111176=        KASSA_ZP_ID_ = NULL;'
      '1102111177=        SELECT K.KASSA, K.SUMM'
      '1102111178=        FROM KASSA K'
      '1102111179=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1102111180=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102111181=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102111182=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102111183=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1102111184='
      
        '1102111185=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1102111186='
      '1102111187=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102111188=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102111189=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102111190=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1102111191=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1102111192=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1102111193=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1102111194=                                          NULL,     -' +
        '-:SKLAD_,'
      '1102111195=                                          1,'
      '1102111196=                                          :G_TOCHKA_,'
      
        '1102111197=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102111198=                                          :G_OFFICIAL' +
        '_'
      
        '1102111199=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1102111200=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102111201=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1102111202='
      '1102111203=        END ELSE BEGIN'
      
        '1102111204=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1102111205=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1102111206=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1102111207=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1102111208='
      
        '1102111209=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1102111210=                                          1,     -- A' +
        'CTION_'
      
        '1102111211=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102111212=                                          :SALES_COMM' +
        '_SUMM_ALL_,   --SUMM_'
      
        '1102111213=                                          :ACTION_DAT' +
        'E_ZP_,  -- ACTION_DATE_'
      
        '1102111214=                                          :OFFICIAL_N' +
