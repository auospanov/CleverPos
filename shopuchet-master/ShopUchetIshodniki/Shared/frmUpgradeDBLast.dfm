        '11071301=  IS_CATEGORY_ /* TYPE OF COLUMN G_CLIENT.IS_CATEGORY *' +
        '/ INTEGER,'
      
        '11071302=  IS_BEZNAL_ /* TYPE OF COLUMN G_CLIENT.IS_BEZNAL */ IN' +
        'TEGER,'
      
        '11071303=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ ' +
        'VARCHAR(13),'
      
        '11071304=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT' +
        ' */ NUMERIC(15,2),'
      
        '11071305=  NOTE_ /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200)' +
        ','
      
        '11071306=  G_PROMOTION_ /* TYPE OF COLUMN G_PROMOTION.G_PROMOTIO' +
        'N */ BIGINT,'
