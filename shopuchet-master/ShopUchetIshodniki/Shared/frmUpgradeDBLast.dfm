      '110248334=                       -'
      
        '110248335=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s, sklad_parent sp'
      
        '110248336=                        where s.SKLAD_PARENT = sp.SKLA' +
        'D and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '110248337=                        and :G_TOCHKA_ARR_ CONTAINING ' +
