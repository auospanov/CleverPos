        '(:CREDIT_, 0),'
      
        '110202490=           K.OUTPUT = COALESCE(K.INPUT, 0) - (COALESCE' +
        '(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) + ' +
        'COALESCE(:CREDIT_, 0))'
      '110202491=     WHERE K.K_DATE = :ACTION_DATE_;'
      '110202492='
      
        '110202493=    IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' ' +
        #1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '110202494=      -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '110202495=      PNT_ = '#39'03A'#39';'
      '110202496=      BEGIN'
