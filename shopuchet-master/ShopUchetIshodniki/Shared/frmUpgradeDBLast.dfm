        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102462014=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102462015=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
