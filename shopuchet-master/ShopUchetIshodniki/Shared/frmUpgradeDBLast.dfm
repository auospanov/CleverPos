      '1102122109=;'
      '1102122110='
      '1102122111='
      
        '1102122112=/****************************************************' +
        '**************************/'
      
        '1102122113=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102122114=/****************************************************' +
        '**************************/'
      '1102122115=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1102122116=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102122117=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM,'
      '1102122118=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102122119=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102122120=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1102122121=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1102122122=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1102122123=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102122124=  SELF_PRICE_ NUMERIC(15,2),'
      '1102122125=  AMOUNT_ MY_NUMERIC_5,'
      '1102122126=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1102122127=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1102122128=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102122129=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102122130=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1102122131=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1102122132=  CATEGORY_NAME_ VARCHAR(1000),'
      '1102122133=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102122134=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102122135=  IS_THIS_LAST_ INTEGER,'
      '1102122136=  UPDATE_IF_EXIST_ INTEGER,'
      '1102122137=  DO_SEARCH_CATEGORY_ INTEGER,'
      '1102122138=  BARCODE_IS_MAIN_ INTEGER,'
      '1102122139=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102122140=RETURNS ('
      '1102122141=  ERR_CODE INTEGER,'
      '1102122142=  ERR_MSG VARCHAR(1024))'
      '1102122143=AS'
      
        '1102122144=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_P' +
        'RODUCT'#39';'
      '1102122145=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102122146=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102122147=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT_PAR = NULL;'
      
        '1102122148=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1102122149=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT' +
        ';'
      
        '1102122150=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT = 0;'
      
        '1102122151=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1102122152=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD;'
      
        '1102122153=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102122154=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM_CURRENCY;'
      '1102122155=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1102122156=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102122157=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      
        '1102122158=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1102122159=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1102122160=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1102122161=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1102122162=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1102122163=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1102122164=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1102122165=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102122166=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1102122167=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1102122168=BEGIN'
      '1102122169=    ERR_MSG = '#39#39';'
      '1102122170=    PNT_ = '#39'00'#39';'
      '1102122171='
      
        '1102122172=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044 +
        #1045#1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '1102122173=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS889' +
        '88~98888~"'
      
        '1102122174=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' ' +
        #1053#1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '1102122175=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '1102122176=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39 +
        '~'#39');'
      '1102122177=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '1102122178=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '1102122179=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '1102122180=    END ELSE'
      '1102122181=        CROSSCODE_ = NULL;'
      '1102122182='
      
        '1102122183=    -------------------------------------------------' +
        '-----------------'
      
        '1102122184=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058#1040#1050 +
        #1054#1049' '#1053#1045#1058
      
        '1102122185=    -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~'#1052#1103 +
        #1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '1102122186=    -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '1102122187=    -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053#1054' ' +
        #1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      '1102122188=    IF (DO_SEARCH_CATEGORY_ = 1) THEN BEGIN'
      
        '1102122189=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BE' +
        'GIN'
      '1102122190=            G_PRODUCT_PAR_ = NULL;'
      
        '1102122191=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAM' +
        'E_);'
      '1102122192=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '1102122193=              STR_ = CATEGORY_NAME_;'
      '1102122194=              CATEGORY_NAME_ = '#39#39';'
      '1102122195=            END ELSE'
      
        '1102122196=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1102122197='
      '1102122198=            SELECT G_PRODUCT'
      '1102122199=              FROM G_PRODUCT G'
      '1102122200=             WHERE G.NAME = :STR_'
      '1102122201=               AND G.IS_CATEGORY = 1'
      
        '1102122202=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1102122203=                   OR'
      
        '1102122204=                   (G.G_PRODUCT_PAR IS NULL AND :G_PR' +
        'ODUCT_PAR_PREV_ IS NULL))'
      '1102122205=              INTO G_PRODUCT_PAR_;'
      '1102122206=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1102122207=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1102122208=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1102122209=                RETURNING G_PRODUCT'
      '1102122210=                INTO :G_PRODUCT_PAR_;'
      '1102122211='
      '1102122212=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1102122213=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1102122214=        END'
      '1102122215=    END'
      
        '1102122216=    -------------------------------------------------' +
        '-----------------'
      '1102122217='
      '1102122218=    PNT_ = '#39'01'#39';'
      '1102122219=    SELECT ID'
      '1102122220=      FROM CUR_PARAMS'
      '1102122221=    WHERE CUR_PARAMS = 2'
      '1102122222=      INTO :G_TOCHKA_;'
      '1102122223='
      '1102122224=    SELECT G.G_UNIT'
      '1102122225=      FROM G_UNIT G'
      
        '1102122226=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAM' +
        'E_G_UNIT_))'
      '1102122227=      INTO :G_UNIT_;'
      '1102122228=    if (ROW_COUNT = 0) then'
      '1102122229=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1102122230='
      '1102122231=    PNT_ = '#39'02'#39';'
      
        '1102122232=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1102122233=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1102122234=        SELECT G.G_PRODUCT,'
      '1102122235=               G.NAME'
      '1102122236=          FROM G_PRODUCT G'
      
        '1102122237=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1102122238=           AND TRIM(G.ARTICUL) <> '#39#39
      '1102122239=           AND G.IS_ACTIVE = 1'
      '1102122240=          INTO :G_PRODUCT_,'
      '1102122241=               :G_PRODUCT_NAME_;'
      '1102122242='
      '1102122243=        PNT_ = '#39'02.1'#39';'
      
        '1102122244=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1102122245=        IF (COALESCE(G_PRODUCT_, 0) <> 0) THEN BEGIN'
      '1102122246=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1102122247=              IF (BARCODE_IS_MAIN_ = 0) THEN BEGIN'
      '1102122248=                  UPDATE G_PRODUCT G'
      '1102122249=                     SET G.NAME = :NAME_,'
      '1102122250=                         G.G_UNIT = :G_UNIT_,'
      
        '1102122251=                         G.PRICE  = DECODE(:PRICE_, -' +
        '999, G.PRICE, :PRICE_),'
      
        '1102122252=                         G.VOLUME_PRICE = DECODE(:VOL' +
        'UME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '1102122253=                         G.PACK_AMOUNT = DECODE(:PACK' +
        '_AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '1102122254=                         G.barcode         = DECODE(C' +
        'HAR_LENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '1102122255=                         G.MF_COUNTRY  = DECODE(CHAR_' +
        'LENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '1102122256=                         G.PLACE = DECODE(CHAR_LENGTH' +
        '(:PLACE_), 0, G.PLACE, :PLACE_),'
      
        '1102122257=                         G.nomenclatur_num = DECODE(C' +
        'HAR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATU' +
        'R_NUM_),'
      
        '1102122258=                         G.KOD_TNVD        = DECODE(C' +
        'HAR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '1102122259=                         G.CROSSCODE      = COALESCE(' +
        ':CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0,' +
        ' G.CROSSCODE, :CROSSCODE_),'
      
        '1102122260=                         G.BRAND          = DECODE(CH' +
        'AR_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '1102122261=                         G.G_PRODUCT_PAR  = COALESCE(' +
        ':G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '1102122262=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102122263='
      
        '1102122264=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083 +
        #1086#1084' '#39'||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1102122265='
      
        '1102122266=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051 +
        #1048
      '1102122267=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102122268=                      INSERT INTO SYNC_EXT_APP (SYNC_' +
        'EXT_APP, OBJECT_TYPE, ID, OPER)'
      
        '1102122269=                      SELECT GEN_ID(GEN_SYNC_EXT_APP,' +
        ' 1), 4, :G_PRODUCT_, 2'
      '1102122270=                        FROM RDB$DATABASE'
      
        '1102122271=                       WHERE NOT EXISTS (SELECT 1 FRO' +
        'M SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUC' +
        'T_ AND AP.IS_LOADING = 0);'
      '1102122272=              END'
      '1102122273=              ELSE'
      '1102122274=                G_PRODUCT_ = 0;'
      '1102122275=            END ELSE'
      
        '1102122276=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1102122277=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAM' +
        'E_||'#39'.'#39';'
      '1102122278=        END'
      '1102122279=    END ELSE'
      
        '1102122280=      EXECUTE PROCEDURE get_free_articul RETURNING_VA' +
        'LUES (:ARTICUL_);'
      '1102122281='
      
        '1102122282=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1102122283=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '1102122284=    PNT_ = '#39'02a'#39';'
      
        '1102122285=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '1102122286=        SELECT G.G_PRODUCT,'
      '1102122287=               G.NAME'
      '1102122288=          FROM G_PRODUCT G'
      
        '1102122289=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_' +
        'NUM_)'
      '1102122290=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '1102122291=           AND G.IS_ACTIVE = 1'
      '1102122292=          INTO :G_PRODUCT_,'
      '1102122293=               :G_PRODUCT_NAME_;'
      '1102122294='
      
        '1102122295=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1102122296=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1102122297=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1102122298=              UPDATE G_PRODUCT G'
      '1102122299=                 SET G.NAME = :NAME_,'
      '1102122300=                     G.G_UNIT = :G_UNIT_,'
      '1102122301=                     G.PRICE  = :PRICE_,'
      '1102122302=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1102122303=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1102122304=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1102122305=                     G.PLACE = :PLACE_,'
      
        '1102122306=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1102122307=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1102122308=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1102122309=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1102122310=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1102122311=                     ,G.BRAND          = :BRAND_'
      '1102122312=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102122313='
      
        '1102122314=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1102122315=            END ELSE'
      
        '1102122316=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1102122317=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1102122318=        END'
      '1102122319=    end'
      '1102122320=    */'
      '1102122321='
      
        '1102122322=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1102122323=    PNT_ = '#39'02.2'#39';'
      
        '1102122324=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1102122325=        SELECT G.G_PRODUCT,'
      '1102122326=               G.NAME'
      '1102122327=          FROM G_PRODUCT G'
      '1102122328=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1102122329=           AND TRIM(G.BARCODE) <> '#39#39
      '1102122330=           AND G.IS_ACTIVE = 1'
      '1102122331=          INTO :G_PRODUCT_,'
      '1102122332=               :G_PRODUCT_NAME_;'
      '1102122333='
      '1102122334=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1102122335=          SELECT G.G_PRODUCT,'
      '1102122336=                 G.NAME'
      '1102122337=            FROM G_PRODUCT G, LT_BARCODE L'
      '1102122338=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1102122339=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1102122340=             AND TRIM(L.BARCODE) <> '#39#39
      '1102122341=            INTO :G_PRODUCT_,'
      '1102122342=                 :G_PRODUCT_NAME_;'
      '1102122343='
      
        '1102122344=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1102122345=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1102122346=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1102122347=              IF (BARCODE_IS_MAIN_ = 1) THEN BEGIN'
      '1102122348=                  UPDATE G_PRODUCT G'
      '1102122349=                     SET G.NAME = :NAME_,'
      '1102122350=                         G.G_UNIT = :G_UNIT_,'
      
        '1102122351=                         G.PRICE  = DECODE(:PRICE_, -' +
        '999, G.PRICE, :PRICE_),'
      
        '1102122352=                         G.VOLUME_PRICE = DECODE(:VOL' +
        'UME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '1102122353=                         G.PACK_AMOUNT = DECODE(:PACK' +
        '_AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '1102122354=                         G.articul         = DECODE(C' +
        'HAR_LENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '1102122355=                         G.MF_COUNTRY  = DECODE(CHAR_' +
        'LENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '1102122356=                         G.PLACE = DECODE(CHAR_LENGTH' +
        '(:PLACE_), 0, G.PLACE, :PLACE_),'
      
        '1102122357=                         G.nomenclatur_num = DECODE(C' +
        'HAR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATU' +
        'R_NUM_),'
      
        '1102122358=                         G.KOD_TNVD        = DECODE(C' +
        'HAR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '1102122359=                         G.CROSSCODE      = COALESCE(' +
        ':CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0,' +
        ' G.CROSSCODE, :CROSSCODE_),'
      
        '1102122360=                         G.BRAND          = DECODE(CH' +
        'AR_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '1102122361=                         G.G_PRODUCT_PAR  = COALESCE(' +
        ':G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '1102122362=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102122363='
      
        '1102122364=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086 +
        #1076#1086#1084' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1102122365='
      
        '1102122366=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051 +
        #1048
      '1102122367=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102122368=                      INSERT INTO SYNC_EXT_APP (SYNC_' +
        'EXT_APP, OBJECT_TYPE, ID, OPER)'
      
        '1102122369=                      SELECT GEN_ID(GEN_SYNC_EXT_APP,' +
        ' 1), 4, :G_PRODUCT_, 2'
      '1102122370=                        FROM RDB$DATABASE'
      
        '1102122371=                       WHERE NOT EXISTS (SELECT 1 FRO' +
        'M SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUC' +
        'T_ AND AP.IS_LOADING = 0);'
      '1102122372=              END'
      '1102122373=              ELSE'
      '1102122374=                G_PRODUCT_ = 0;'
      '1102122375=            END ELSE'
      
        '1102122376=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1102122377=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1102122378=        END'
      
        '1102122379=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1102122380=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1102122381='
      
        '1102122382=    --===============================================' +
        '=========='
      '1102122383=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '1102122384=    --===============================================' +
        '=========='
      '1102122385=    PNT_ = '#39'02b'#39';'
      '1102122386=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '1102122387='
      '1102122388=        IF (PRICE_ = -999) THEN'
      '1102122389=          PRICE_ = 0;'
      '1102122390=        IF (VOLUME_PRICE_ = -999) THEN'
      '1102122391=          VOLUME_PRICE_ = 0;'
      '1102122392=        IF (PACK_AMOUNT_ = -999) THEN'
      '1102122393=          PACK_AMOUNT_ = 0;'
      '1102122394='
      
        '1102122395=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1102122396=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '1102122397=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1102122398=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '1102122399=        RETURNING G_PRODUCT'
      '1102122400=        INTO :G_PRODUCT_;'
      '1102122401='
      
        '1102122402=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102122403=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102122404='
      '1102122405=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1102122406=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102122407=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, O' +
        'BJECT_TYPE, ID, OPER)'
      
        '1102122408=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :' +
        'G_PRODUCT_, 1);'
      '1102122409=    end'
      '1102122410='
      
        '1102122411=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102122412=    PNT_ = '#39'03'#39';'
      '1102122413=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1102122414=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1102122415=                                       :AMOUNT_,'
      '1102122416=                                       :SELF_PRICE_,'
      
        '1102122417=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1102122418=                                       0, --nds_,'
      '1102122419=                                       0 --nds_summ_,'
      
        '1102122420=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1102122421=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1102122422=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1102122423=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1102122424=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1102122425=          EXIT;'
      '1102122426=        END'
      '1102122427=    END'
      '1102122428='
      
        '1102122429=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1102122430=    PNT_ = '#39'04'#39';'
      '1102122431=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1102122432=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1102122433=        FROM SKLAD_TMP T'
      '1102122434=        INTO :CNT_;'
      '1102122435='
      '1102122436=      if (CNT_ > 0) then BEGIN'
      '1102122437=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1102122438=          FROM SKLAD_TMP T'
      '1102122439=          INTO :SUMM_, :SUMM_UE_;'
      '1102122440='
      '1102122441=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1102122442=                                DATE_RECEIPT,'
      '1102122443=                                TIME_RECEIPT,'
      '1102122444=                                G_CLIENT,'
      '1102122445=                                G_PAYMENT_TYPE,'
      '1102122446=                                OSNOVANIE,'
      '1102122447=                                NOTE,'
      '1102122448=                                SUMM,'
      '1102122449=                                SUMM_FACT,'
      '1102122450=                                SUMM_CURRENCY,'
      '1102122451=                                IS_PAYED_ALL,'
      '1102122452=                                IS_VOZVRAT,'
      '1102122453=                                G_TOCHKA)'
      '1102122454=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1102122455=                CURRENT_DATE,'
      '1102122456=                CURRENT_TIME,'
      '1102122457=                :G_CLIENT_,'
      '1102122458=                1,'
      '1102122459=                NULL,  --:OSNOVANIE_,'
      '1102122460=                NULL,  -- :NOTE_,'
      '1102122461=                :SUMM_,'
      '1102122462=                :SUMM_,'
      '1102122463=                :SUMM_UE_,'
      
        '1102122464=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1102122465=                0,'
      '1102122466=                :G_TOCHKA_)'
      '1102122467=        RETURNING'
      '1102122468=          SKLAD'
      '1102122469=        INTO'
      '1102122470=          :SKLAD_PARENT_;'
      '1102122471='
      '1102122472=        PNT_ = '#39'05'#39';'
      '1102122473=        FOR SELECT SKLAD,'
      '1102122474=                   G_PRODUCT,'
      '1102122475=                   AMOUNT,'
      '1102122476=                   PRICE,'
      '1102122477=                   SUMM'
      '1102122478=                   ,PRICE_CURRENCY'
      '1102122479=                   ,SUMM_CURRENCY'
      '1102122480=              FROM SKLAD_TMP'
      '1102122481=             ORDER BY 1'
      '1102122482=              INTO :SKLAD_TMP_,'
      '1102122483=                   :RG_PRODUCT_,'
      '1102122484=                   :RAMOUNT_,'
      '1102122485=                   :RPRICE_,'
      '1102122486=                   :RSUMM_'
      '1102122487=                   ,:RPRICE_UE_'
      '1102122488=                   ,:RSUMM_UE_'
      '1102122489=        DO BEGIN'
      '1102122490='
      '1102122491=            UPDATE SKLAD SK'
      '1102122492=               SET SK.IS_LAST = 0'
      '1102122493=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1102122494=               AND SK.IS_LAST = 1;'
      '1102122495='
      '1102122496=            INSERT INTO SKLAD'
      '1102122497=            ('
      '1102122498=             SKLAD,'
      '1102122499=             SKLAD_PARENT,'
      '1102122500=             DATE_RECEIPT,'
      '1102122501=             G_CLIENT,'
      '1102122502=             G_PRODUCT,'
      '1102122503=             AMOUNT,'
      '1102122504=             PRICE,'
      '1102122505=             SUMM,'
      '1102122506=             G_PAYMENT_TYPE,'
      '1102122507=             OSNOVANIE,'
      '1102122508=             NOTE,'
      '1102122509=             NDS,'
      '1102122510=             NDS_SUMM,'
      '1102122511=             IS_LAST,'
      '1102122512=             IS_VOZVRAT,'
      '1102122513=             G_TOCHKA'
      '1102122514=             ,PRICE_CURRENCY'
      '1102122515=             ,SUMM_CURRENCY'
      '1102122516=            ) VALUES ('
      '1102122517=             :SKLAD_TMP_,'
      '1102122518=             :SKLAD_PARENT_,'
      '1102122519=             CURRENT_DATE,'
      '1102122520=             :G_CLIENT_,'
      '1102122521=             :RG_PRODUCT_,'
      '1102122522=             :RAMOUNT_,'
      '1102122523=             :RPRICE_,'
      '1102122524=             :RSUMM_,'
      '1102122525=             1,       --:G_PAYMENT_TYPE_,'
      '1102122526=             NULL,    --:OSNOVANIE_,'
      '1102122527=             NULL,    --:NOTE_,'
      '1102122528=             0,       --:RNDS_,'
      '1102122529=             0,       --:RNDS_SUMM_,'
      '1102122530=             1,       --IS_LAST_'
      '1102122531=             0,        --:IS_VOZVRAT_'
      '1102122532=             :G_TOCHKA_'
      '1102122533=             ,:RPRICE_UE_'
      '1102122534=             ,:RSUMM_UE_'
      '1102122535=            );'
      '1102122536='
      
        '1102122537=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1102122538=            PNT_ = '#39'06'#39';'
      '1102122539=            UPDATE LT_SKLAD_PRODUCT L'
      '1102122540=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      
        '1102122541=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102122542=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1102122543=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102122544='
      '1102122545=            PNT_ = '#39'06a'#39';'
      '1102122546=            IF (ROW_COUNT = 0) THEN'
      
        '1102122547=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EX' +
        'PORT)'
      
        '1102122548=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102122549=        END'
      '1102122550='
      '1102122551=        PNT_ = '#39'07'#39';'
      
        '1102122552=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102122553=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1102122554=                                :SUMM_,'
      '1102122555=                                CURRENT_DATE,'
      
        '1102122556=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1102122557=                                NULL,   --ZAKAZ_'
      '1102122558=                                :SKLAD_PARENT_,'
      '1102122559=                                1,'
      '1102122560=                                :G_TOCHKA_,'
      
        '1102122561=                                :UPLOAD_TO_EXT_APP_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102122562=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102122563=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102122564=          EXIT;'
      '1102122565=        END'
      '1102122566='
      '1102122567=        DELETE FROM SKLAD_TMP;'
      '1102122568='
      '1102122569=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1102122570=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102122571=          INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJ' +
        'ECT_TYPE, ID, OPER)'
      
        '1102122572=          VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SK' +
        'LAD_, 1);'
      '1102122573=      END'
      '1102122574=    END'
      '1102122575='
      
        '1102122576=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1102122577=    if (ERR_MSG_ IS NOT NULL) then'
      '1102122578=      ERR_MSG = ERR_MSG_;'
      '1102122579='
      '1102122580=WHEN ANY DO BEGIN'
      '1102122581=    IF (GDSCODE = 335544652) THEN BEGIN'
      '1102122582=        Err_code = GDSCODE;'
      
        '1102122583=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1042#1099' '#1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1080 +
        #1084#1087#1086#1088#1090#1080#1088#1086#1074#1072#1090#1100' '#1090#1086#1074#1072#1088#1099' '#1089' '#1086#1076#1080#1085#1072#1082#1086#1074#1099#1084' '#1079#1085#1072#1095#1077#1085#1080#1077#1084'!'#39';'
      '1102122584=        IF (PNT_ = '#39'02'#39') THEN'
      
        '1102122585=            ERR_MSG = ERR_MSG || '#39' '#1040#1088#1090#1080#1082#1091#1083' '#39' || ARTIC' +
        'UL_ || '#39'.'#39';'
      '1102122586=        ELSE'
      
        '1102122587=            ERR_MSG = ERR_MSG || '#39' '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1102122588=    END ELSE BEGIN'
      '1102122589=        Err_code = gdscode;'
      
        '1102122590=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode' +
        '||'#39' --> PNT_ '#39'||PNT_;'
      '1102122591=    END'
      '1102122592=  END'
      '1102122593=END'
      '1102122594=;'
      '1102122595='
      '1102122596=ALTER PROCEDURE P_REP_KASSIR('
      '1102122597=  DATE_BEGIN_ DATE,'
      '1102122598=  DATE_END_ DATE,'
      '1102122599=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102122600=RETURNS ('
      '1102122601=  PERIOD_ VARCHAR(40),'
      '1102122602=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '1102122603=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '1102122604=  ROWCOL INTEGER,'
      '1102122605=  Z_DATE VARCHAR(40),'
      '1102122606=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102122607=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102122608=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102122609=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102122610=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '1102122611=AS'
      '1102122612=/*'
      
        '1102122613='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071 +
        ', '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '1102122614=*/'
      '1102122615=DECLARE VARIABLE SORT_COL INTEGER;'
      '1102122616=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '1102122617=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '1102122618=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '1102122619=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102122620=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102122621=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '1102122622=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      '1102122623=BEGIN'
      
        '1102122624=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102122625=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102122626='
      '1102122627=  SELECT S."INPUT"'
      '1102122628=    FROM kassa_state S'
      '1102122629=   WHERE S.k_date = :DATE_BEGIN_'
      '1102122630=     AND S.g_tochka = :G_TOCHKA_'
      '1102122631=    INTO :IN_SUMM_;'
      '1102122632='
      '1102122633=  IF (ROW_COUNT = 0) THEN'
      '1102122634=    SELECT S."OUTPUT"'
      '1102122635=      FROM kassa_state S'
      '1102122636=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102122637=                         FROM KASSA_STATE ST'
      
        '1102122638=                        WHERE ST.k_date < :DATE_BEGIN' +
        '_'
      
        '1102122639=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1102122640=      AND S.g_tochka = :G_TOCHKA_'
      '1102122641=      INTO :IN_SUMM_;'
      '1102122642='
      '1102122643=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '1102122644='
      
        '1102122645=  /* '#1050#1054#1056#1054#1063#1045' '#1048#1047'-'#1047#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048' '#1063#1058#1054'-'#1058#1054' '#1050#1056#1048#1042#1054' '#1057' '#1044#1042#1048#1046#1045#1053 +
        #1048#1045#1052' '#1044#1045#1053#1045#1043', '#1071' '#1061#1059#1049' '#1055#1054#1049#1052#1048' '#1055#1054#1063#1045#1052#1059' '#1048' '#1048#1047'-'#1047#1040' '#1063#1045#1043#1054' '#1047#1040#1045#1041#1040#1051#1054' '#1057#1059#1050#1040
      
        '1102122646=     '#1055#1054#1058#1054#1052#1059' '#1056#1045#1064#1048#1051' '#1055#1056#1054#1057#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1057#1045' '#1054#1055#1045#1056 +
        #1040#1062#1048#1048
      '1102122647=  SELECT S."OUTPUT"'
      '1102122648=    FROM kassa_state S'
      '1102122649=   WHERE S.k_date = :DATE_END_'
      '1102122650=     AND S.g_tochka = :G_TOCHKA_'
      '1102122651=    INTO :OUT_SUMM_;'
      '1102122652='
      '1102122653=  IF (ROW_COUNT = 0) THEN'
      '1102122654=    SELECT S."OUTPUT"'
      '1102122655=      FROM kassa_state S'
      '1102122656=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102122657=                         FROM KASSA_STATE ST'
      '1102122658=                        WHERE ST.k_date < :DATE_END_'
      
        '1102122659=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1102122660=      AND S.g_tochka = :G_TOCHKA_'
      '1102122661=      INTO :OUT_SUMM_;'
      '1102122662='
      '1102122663=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '1102122664=  */'
      '1102122665='
      '1102122666=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '1102122667=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')' +
        '||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_STR'
      '1102122668=           ,Z.Z_DATE'
      '1102122669=           ,GP.ARTICUL'
      '1102122670=           ,GP.BARCODE'
      '1102122671=           ,GP.NAME'
      '1102122672=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '1102122673=           ,SUM(ZD.summ)    SUMM'
      '1102122674=      FROM ZAKAZ Z'
      '1102122675=           ,ZAKAZ_DETAILS ZD'
      '1102122676=           ,G_PRODUCT GP'
      '1102122677=     WHERE Z.is_spisanie in (0, 2)'
      '1102122678=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102122679=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102122680=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102122681=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '1102122682=       AND Z.G_TOCHKA = :G_TOCHKA_'
      
        '1102122683=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NA' +
        'ME'
      '1102122684=      INTO :date_str,'
      '1102122685=           :Z_DATE,'
      '1102122686=           :ARTICUL,'
      '1102122687=           :BARCODE,'
      '1102122688=           :NAME,'
      '1102122689=           :AMOUNT,'
      '1102122690=           :SUMM'
      '1102122691=  DO BEGIN'
      '1102122692=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1102122693=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1102122694=      VALUES (1, 1, '#39#1055#1088#1086#1076#1072#1078#1072#39');'
      '1102122695=      FIRST_ITER = 1;'
      '1102122696=    END'
      '1102122697='
      
        '1102122698=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '1102122699=      VALUES (2, 2, :DATE_STR, :z_date,  :ARTICUL, :B' +
        'ARCODE, :NAME, :AMOUNT, :SUMM);'
      '1102122700=  END'
      '1102122701='
      '1102122702=  IF (first_iter > 0) THEN BEGIN'
      
        '1102122703=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102122704=        VALUES (3, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', (SELECT SUM(K.S' +
        'UMM)'
      
        '1102122705=                                         FROM KASSA K' +
        ','
      '1102122706=                                              ZAKAZ Z'
      
        '1102122707=                                        WHERE K.G_TOC' +
        'HKA = :G_TOCHKA_'
      
        '1102122708=                                          AND K.ZAKAZ' +
        ' = Z.ZAKAZ'
      
        '1102122709=                                          AND Z.z_dat' +
        'e BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102122710=                                          AND Z.G_TOC' +
        'HKA = :G_TOCHKA_'
      
        '1102122711=                                          AND Z.is_sp' +
        'isanie in (0, 2)'
      
        '1102122712=                                          AND K.ACTIO' +
        'N_DATE = Z.Z_DATE)'
      '1102122713=               )'
      '1102122714=      RETURNING'
      '1102122715=        SUMM'
      '1102122716=      INTO'
      '1102122717=        :SUMM_PRIHOD_ALL_;'
      '1102122718='
      
        '1102122719=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102122720=        VALUES (4, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', (SELECT SUM(' +
        'K.SUMM)'
      
        '1102122721=                                             FROM KAS' +
        'SA_BEZNAL K,'
      
        '1102122722=                                                  ZAK' +
        'AZ Z'
      
        '1102122723=                                            WHERE K.G' +
        '_TOCHKA = :G_TOCHKA_'
      
        '1102122724=                                              AND K.Z' +
        'AKAZ = Z.ZAKAZ'
      
        '1102122725=                                              AND Z.z' +
        '_date BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102122726=                                              AND Z.G' +
        '_TOCHKA = :G_TOCHKA_'
      
        '1102122727=                                              AND Z.i' +
        's_spisanie in (0, 2)'
      
        '1102122728=                                              AND K.A' +
        'CTION_DATE = Z.Z_DATE)'
      '1102122729=               );'
      '1102122730='
      
        '1102122731=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL)'
      '1102122732=      VALUES(5, 1);'
      '1102122733=  END'
      '1102122734='
      '1102122735=  -- '#1055#1056#1048#1061#1054#1044
      '1102122736=  FIRST_ITER = 0;'
      
        '1102122737=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt AS VA' +
        'RCHAR(10)) DATE_STR'
      '1102122738=           ,S.date_receipt'
      '1102122739=           ,GP.ARTICUL'
      '1102122740=           ,GP.BARCODE'
      '1102122741=           ,GP.NAME'
      '1102122742=           ,SUM(SD.AMOUNT)  AMOUNT'
      '1102122743=           ,SUM(SD.summ)    SUMM'
      '1102122744=      FROM SKLAD_PARENT S'
      '1102122745=           ,SKLAD SD'
      '1102122746=           ,G_PRODUCT GP'
      '1102122747=     WHERE S.is_vozvrat = 0'
      '1102122748=       AND S.sklad = SD.sklad_parent'
      '1102122749=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '1102122750=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102122751=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102122752=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102122753=     GROUP BY S.date_receipt, GP.articul, GP.barcode,' +
        ' GP.NAME'
      '1102122754=     INTO :date_str,'
      '1102122755=           :Z_DATE,'
      '1102122756=           :ARTICUL,'
      '1102122757=           :BARCODE,'
      '1102122758=           :NAME,'
      '1102122759=           :AMOUNT,'
      '1102122760=           :SUMM'
      '1102122761=  DO BEGIN'
      '1102122762=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1102122763=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1102122764=      VALUES (6, 1, '#39#1055#1088#1080#1093#1086#1076' '#1090#1086#1074#1072#1088#1072#39');'
      '1102122765=      FIRST_ITER = 1;'
      '1102122766=    END'
      '1102122767='
      
        '1102122768=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '1102122769=      VALUES (7, 2, :DATE_STR, :z_date,  :ARTICUL, :B' +
        'ARCODE, :NAME, :AMOUNT, :SUMM);'
      '1102122770=  END'
      '1102122771='
      '1102122772=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '1102122773=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102122774=        VALUES (8, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', COALESCE((SELEC' +
        'T SUM(K.summ)'
      
        '1102122775=                                                 FROM' +
        ' KASSA K'
      
        '1102122776=                                                WHERE' +
        ' EXISTS (SELECT 1'
      
        '1102122777=                                                     ' +
        '           FROM sklad_parent P'
      
        '1102122778=                                                     ' +
        '          WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102122779=                                                     ' +
        '            AND P.G_TOCHKA = :G_TOCHKA_'
      
        '1102122780=                                                     ' +
        '            AND P.is_vozvrat = 0'
      
        '1102122781=                                                     ' +
        '            AND P.sklad = K.SKLAD'
      
        '1102122782=                                                     ' +
        '            AND P.date_receipt = K.action_date)),0)'
      '1102122783=               )'
      '1102122784=      RETURNING'
      '1102122785=        SUMM'
      '1102122786=      INTO'
      '1102122787=        :summ_rashod_all_;'
      '1102122788='
      
        '1102122789=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1102122790=        VALUES (9, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', COALESCE((SE' +
        'LECT SUM(K.summ)'
      
        '1102122791=                                                     ' +
        'FROM KASSA_BEZNAL K'
      
        '1102122792=                                                    W' +
        'HERE EXISTS (SELECT 1'
      
        '1102122793=                                                     ' +
        '               FROM sklad_parent P'
      
        '1102122794=                                                     ' +
        '              WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102122795=                                                     ' +
        '                AND P.G_TOCHKA = :G_TOCHKA_'
      
        '1102122796=                                                     ' +
        '                AND P.is_vozvrat = 0'
      
        '1102122797=                                                     ' +
        '                AND P.sklad = K.SKLAD'
      
        '1102122798=                                                     ' +
        '                AND P.date_receipt = K.action_date)), 0)'
      '1102122799=               );'
      
        '1102122800=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL)'
      '1102122801=        VALUES(10, 1);'
      '1102122802=  END'
      '1102122803='
      '1102122804=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1050#1051#1048#1045#1053#1058#1054#1052
      '1102122805=  FIRST_ITER = 0;'
      
        '1102122806=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt AS VA' +
        'RCHAR(10)) DATE_STR'
      '1102122807=           ,S.date_receipt'
      '1102122808=           ,GP.ARTICUL'
      '1102122809=           ,GP.BARCODE'
      '1102122810=           ,GP.NAME'
      '1102122811=           ,SUM(SD.AMOUNT)  AMOUNT'
      '1102122812=           ,SUM(SD.summ)    SUMM'
      '1102122813=      FROM SKLAD_PARENT S'
      '1102122814=           ,SKLAD SD'
      '1102122815=           ,G_PRODUCT GP'
      '1102122816=     WHERE S.is_vozvrat = 1'
      '1102122817=       AND S.sklad = SD.sklad_parent'
      '1102122818=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '1102122819=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102122820=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102122821=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102122822=     GROUP BY S.date_receipt, GP.articul, GP.barcode,' +
        ' GP.NAME'
      '1102122823=     INTO :date_str,'
      '1102122824=           :Z_DATE,'
      '1102122825=           :ARTICUL,'
      '1102122826=           :BARCODE,'
      '1102122827=           :NAME,'
      '1102122828=           :AMOUNT,'
      '1102122829=           :SUMM'
      '1102122830=  DO BEGIN'
      '1102122831=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1102122832=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1102122833=      VALUES (11, 1, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1082#1083#1080#1077#1085#1090#1086#1084#39');'
      '1102122834=      FIRST_ITER = 1;'
      '1102122835=    END'
      '1102122836='
      
        '1102122837=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '1102122838=      VALUES (12, 2, :DATE_STR, :z_date,  :ARTICUL, :' +
        'BARCODE, :NAME, :AMOUNT, :SUMM);'
      '1102122839=  END'
      '1102122840='
      '1102122841=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '1102122842=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
