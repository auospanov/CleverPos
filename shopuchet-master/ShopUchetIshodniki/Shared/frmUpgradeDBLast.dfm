        't = 3'
      
        '110533862=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '110533863=                  from rdb$database) AMOUNT_OUT'
