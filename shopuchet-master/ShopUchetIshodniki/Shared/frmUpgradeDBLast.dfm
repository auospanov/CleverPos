      '110228539=                 :G_PRODUCT_NAME_;'
      '110228540='
      
        '110228541=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110228542=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110228543=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110228544=              IF (BARCODE_IS_MAIN_ = 1) THEN BEGIN'
      '110228545=                  UPDATE G_PRODUCT G'
      '110228546=                     SET G.NAME = :NAME_,'
      '110228547=                         G.G_UNIT = :G_UNIT_,'
      
        '110228548=                         G.PRICE  = DECODE(:PRICE_, -9' +
        '99, G.PRICE, :PRICE_),'
      
        '110228549=                         G.VOLUME_PRICE = DECODE(:VOLU' +
        'ME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110228550=                         G.PACK_AMOUNT = DECODE(:PACK_' +
        'AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110228551=                         G.articul         = DECODE(CH' +
        'AR_LENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '110228552=                         G.MF_COUNTRY  = DECODE(CHAR_L' +
        'ENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110228553=                         G.PLACE = DECODE(CHAR_LENGTH(' +
        ':PLACE_), 0, G.PLACE, :PLACE_),'
      
        '110228554=                         G.nomenclatur_num = DECODE(CH' +
        'AR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR' +
        '_NUM_),'
      
        '110228555=                         G.KOD_TNVD        = DECODE(CH' +
        'AR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110228556=                         G.CROSSCODE      = COALESCE(:' +
        'CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, ' +
        'G.CROSSCODE, :CROSSCODE_),'
      
        '110228557=                         G.BRAND          = DECODE(CHA' +
        'R_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '110228558=                         G.G_PRODUCT_PAR  = COALESCE(:' +
        'G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110228559=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110228560='
      
        '110228561=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076 +
        #1086#1084' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110228562='
      
        '110228563=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110228564=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110228565=                      INSERT INTO SYNC_EXT_APP (SYNC_E' +
        'XT_APP, OBJECT_TYPE, ID, OPER)'
      
        '110228566=                      SELECT GEN_ID(GEN_SYNC_EXT_APP, ' +
        '1), 4, :G_PRODUCT_, 2'
      '110228567=                        FROM RDB$DATABASE'
      
        '110228568=                       WHERE NOT EXISTS (SELECT 1 FROM' +
        ' SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT' +
        '_ AND AP.IS_LOADING = 0);'
      '110228569=              END'
      '110228570=              ELSE'
      '110228571=                G_PRODUCT_ = 0;'
      '110228572=            END ELSE'
      
        '110228573=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110228574=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110228575=        END'
      
        '110228576=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110228577=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110228578='
      
        '110228579=    --================================================' +
        '========='
      '110228580=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110228581=    --================================================' +
        '========='
      '110228582=    PNT_ = '#39'02b'#39';'
      '110228583=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110228584='
      '110228585=        IF (PRICE_ = -999) THEN'
      '110228586=          PRICE_ = 0;'
      '110228587=        IF (VOLUME_PRICE_ = -999) THEN'
      '110228588=          VOLUME_PRICE_ = 0;'
      '110228589=        IF (PACK_AMOUNT_ = -999) THEN'
      '110228590=          PACK_AMOUNT_ = 0;'
      '110228591='
      
        '110228592=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110228593=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110228594=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110228595=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110228596=        RETURNING G_PRODUCT'
      '110228597=        INTO :G_PRODUCT_;'
      '110228598='
      
        '110228599=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110228600=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110228601='
      '110228602=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110228603=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110228604=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110228605=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G' +
        '_PRODUCT_, 1);'
      '110228606=    end'
      '110228607='
      
        '110228608=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110228609=    PNT_ = '#39'03'#39';'
      '110228610=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110228611=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110228612=                                       :AMOUNT_,'
      '110228613=                                       :SELF_PRICE_,'
      
        '110228614=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110228615=                                       0, --nds_,'
      '110228616=                                       0 --nds_summ_,'
      
        '110228617=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110228618=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110228619=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110228620=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110228621=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110228622=          EXIT;'
      '110228623=        END'
      '110228624=    END'
      '110228625='
      
        '110228626=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110228627=    PNT_ = '#39'04'#39';'
      '110228628=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110228629=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110228630=        FROM SKLAD_TMP T'
      '110228631=        INTO :CNT_;'
      '110228632='
      '110228633=      if (CNT_ > 0) then BEGIN'
      '110228634=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110228635=          FROM SKLAD_TMP T'
      '110228636=          INTO :SUMM_, :SUMM_UE_;'
      '110228637='
      '110228638=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110228639=                                DATE_RECEIPT,'
      '110228640=                                TIME_RECEIPT,'
      '110228641=                                G_CLIENT,'
      '110228642=                                G_PAYMENT_TYPE,'
      '110228643=                                OSNOVANIE,'
      '110228644=                                NOTE,'
      '110228645=                                SUMM,'
      '110228646=                                SUMM_FACT,'
      '110228647=                                SUMM_CURRENCY,'
      '110228648=                                IS_PAYED_ALL,'
      '110228649=                                IS_VOZVRAT,'
      '110228650=                                G_TOCHKA)'
      '110228651=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110228652=                CURRENT_DATE,'
      '110228653=                CURRENT_TIME,'
      '110228654=                :G_CLIENT_,'
      '110228655=                1,'
      '110228656=                NULL,  --:OSNOVANIE_,'
      '110228657=                NULL,  -- :NOTE_,'
      '110228658=                :SUMM_,'
      '110228659=                :SUMM_,'
      '110228660=                :SUMM_UE_,'
      
        '110228661=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110228662=                0,'
      '110228663=                :G_TOCHKA_)'
      '110228664=        RETURNING'
      '110228665=          SKLAD'
      '110228666=        INTO'
      '110228667=          :SKLAD_PARENT_;'
      '110228668='
      '110228669=        PNT_ = '#39'05'#39';'
      '110228670=        FOR SELECT SKLAD,'
      '110228671=                   G_PRODUCT,'
      '110228672=                   AMOUNT,'
      '110228673=                   PRICE,'
      '110228674=                   SUMM'
      '110228675=                   ,PRICE_CURRENCY'
      '110228676=                   ,SUMM_CURRENCY'
      '110228677=              FROM SKLAD_TMP'
      '110228678=             ORDER BY 1'
      '110228679=              INTO :SKLAD_TMP_,'
      '110228680=                   :RG_PRODUCT_,'
      '110228681=                   :RAMOUNT_,'
      '110228682=                   :RPRICE_,'
      '110228683=                   :RSUMM_'
      '110228684=                   ,:RPRICE_UE_'
      '110228685=                   ,:RSUMM_UE_'
      '110228686=        DO BEGIN'
      '110228687='
      '110228688=            /*UPDATE SKLAD SK'
      '110228689=               SET SK.IS_LAST = 0'
      '110228690=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110228691=               AND SK.IS_LAST = 1;*/'
      '110228692='
      '110228693=            INSERT INTO SKLAD'
      '110228694=            ('
      '110228695=             SKLAD,'
      '110228696=             SKLAD_PARENT,'
      '110228697=             DATE_RECEIPT,'
      '110228698=             G_CLIENT,'
      '110228699=             G_PRODUCT,'
      '110228700=             AMOUNT,'
      '110228701=             PRICE,'
      '110228702=             SUMM,'
      '110228703=             G_PAYMENT_TYPE,'
      '110228704=             OSNOVANIE,'
      '110228705=             NOTE,'
      '110228706=             NDS,'
      '110228707=             NDS_SUMM,'
      '110228708=             IS_LAST,'
      '110228709=             IS_VOZVRAT,'
      '110228710=             G_TOCHKA'
      '110228711=             ,PRICE_CURRENCY'
      '110228712=             ,SUMM_CURRENCY'
      '110228713=            ) VALUES ('
      '110228714=             :SKLAD_TMP_,'
      '110228715=             :SKLAD_PARENT_,'
      '110228716=             CURRENT_DATE,'
      '110228717=             :G_CLIENT_,'
      '110228718=             :RG_PRODUCT_,'
      '110228719=             :RAMOUNT_,'
      '110228720=             :RPRICE_,'
      '110228721=             :RSUMM_,'
      '110228722=             1,       --:G_PAYMENT_TYPE_,'
      '110228723=             NULL,    --:OSNOVANIE_,'
      '110228724=             NULL,    --:NOTE_,'
      '110228725=             0,       --:RNDS_,'
      '110228726=             0,       --:RNDS_SUMM_,'
      '110228727=             0,       --IS_LAST_'
      '110228728=             0,        --:IS_VOZVRAT_'
      '110228729=             :G_TOCHKA_'
      '110228730=             ,:RPRICE_UE_'
      '110228731=             ,:RSUMM_UE_'
      '110228732=            );'
      '110228733='
      
        '110228734=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110228735=            PNT_ = '#39'06'#39';'
      '110228736=            UPDATE LT_SKLAD_PRODUCT L'
      '110228737=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      
        '110228738=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_A' +
        'PP_'
      '110228739=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110228740=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110228741='
      '110228742=            PNT_ = '#39'06a'#39';'
      '110228743=            IF (ROW_COUNT = 0) THEN'
      
        '110228744=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXP' +
        'ORT)'
      
        '110228745=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110228746=        END'
      '110228747='
      '110228748=        PNT_ = '#39'07'#39';'
      
        '110228749=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110228750=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110228751=                                :SUMM_,'
      '110228752=                                CURRENT_DATE,'
      
        '110228753=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110228754=                                NULL,   --ZAKAZ_'
      '110228755=                                :SKLAD_PARENT_,'
      '110228756=                                1,'
      '110228757=                                :G_TOCHKA_,'
      
        '110228758=                                :UPLOAD_TO_EXT_APP_) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110228759=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110228760=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110228761=          EXIT;'
      '110228762=        END'
      '110228763='
      '110228764=        DELETE FROM SKLAD_TMP;'
      '110228765='
      '110228766=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110228767=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110228768=          INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJE' +
        'CT_TYPE, ID, OPER)'
      
        '110228769=          VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKL' +
        'AD_, 1);'
      '110228770=      END'
      '110228771=    END'
      '110228772='
      
        '110228773=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110228774=    if (ERR_MSG_ IS NOT NULL) then'
      '110228775=      ERR_MSG = ERR_MSG_;'
      '110228776='
      '110228777=WHEN ANY DO BEGIN'
      '110228778=    IF (GDSCODE = 335544652) THEN BEGIN'
      '110228779=        Err_code = GDSCODE;'
      
        '110228780=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1042#1099' '#1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1080#1084 +
        #1087#1086#1088#1090#1080#1088#1086#1074#1072#1090#1100' '#1090#1086#1074#1072#1088#1099' '#1089' '#1086#1076#1080#1085#1072#1082#1086#1074#1099#1084' '#1079#1085#1072#1095#1077#1085#1080#1077#1084'!'#39';'
      '110228781=        IF (PNT_ = '#39'02'#39') THEN'
      
        '110228782=            ERR_MSG = ERR_MSG || '#39' '#1040#1088#1090#1080#1082#1091#1083' '#39' || ARTICU' +
        'L_ || '#39'.'#39';'
      '110228783=        ELSE'
      
        '110228784=            ERR_MSG = ERR_MSG || '#39' '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110228785=    END ELSE BEGIN'
      '110228786=        Err_code = gdscode;'
      
        '110228787=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode|' +
        '|'#39' --> PNT_ '#39'||PNT_;'
      '110228788=    END'
      '110228789=  END'
      '110228790=END'
      '110228791=;'
      '110228792='
      '110228793=ALTER PROCEDURE INS_SKLAD('
      '110228794=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110228795=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110228796=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110228797=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110228798=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110228799=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110228800=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110228801=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110228802=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110228803=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110228804=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110228805=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110228806=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110228807=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110228808=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0,'
      '110228809=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110228810=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110228811=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '110228812=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110228813=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '110228814=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE = NULL,'
      '110228815=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = NULL)'
      '110228816=RETURNS ('
      '110228817=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110228818=  ERR_CODE INTEGER,'
      '110228819=  ERR_MSG VARCHAR(1024))'
      '110228820=AS'
      '110228821=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110228822=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110228823=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110228824=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110228825=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110228826=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110228827=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110228828=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110228829=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110228830=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110228831=--'
      
        '110228832=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110228833=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110228834='
      
        '110228835=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056 +
        #1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110228836=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110228837=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110228838=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110228839=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110228840=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110228841=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110228842=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110228843=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110228844=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110228845=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110228846=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110228847=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110228848=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110228849=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110228850=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110228851=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110228852=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110228853=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110228854=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110228855=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110228856=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110228857=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110228858=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      
        '110228859=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK_' +
        'CODE;'
      
        '110228860=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COST' +
        '_PRICE;'
      
        '110228861=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110228862=DECLARE VARIABLE SUMM_BONUS_ TYPE OF COLUMN G_DISCONT_' +
        'CARD.SUMM;'
      
        '110228863=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.SUMM;'
      
        '110228864=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM;'
      '110228865=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '110228866=BEGIN'
      '110228867='
      '110228868=  PNT_ = '#39'00'#39';'
      '110228869=  IS_THIS_LAST_ = 0;'
      '110228870='
      '110228871=  IF (G_TOCHKA_ IS NULL) THEN'
      '110228872=    SELECT ID'
      '110228873=      FROM CUR_PARAMS'
      '110228874=     WHERE CUR_PARAMS = 2'
      '110228875=      INTO :G_TOCHKA_;'
      '110228876='
      '110228877=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110228878=  IF (G_OFFICIAL_ IS NULL) THEN'
      '110228879=      SELECT ID'
      '110228880=        FROM CUR_PARAMS'
      '110228881=       WHERE CUR_PARAMS = 1'
      '110228882=        INTO :G_OFFICIAL_;'
      '110228883='
      '110228884=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110228885=                            DATE_RECEIPT,'
      '110228886=                            TIME_RECEIPT,'
      '110228887=                            G_CLIENT,'
      '110228888=                            G_PAYMENT_TYPE,'
      '110228889=                            OSNOVANIE,'
      '110228890=                            NOTE,'
      '110228891=                            SUMM,'
      '110228892=                            SUMM_FACT,'
      '110228893=                            SUMM_CURRENCY,'
      '110228894=                            IS_PAYED_ALL,'
      '110228895=                            IS_VOZVRAT,'
      '110228896=                            G_TOCHKA'
      '110228897=                            ,G_OFFICIAL'
      '110228898=                            ,IS_EXPECTED'
      '110228899=                            ,G_NONCASH_PAY_TYPE'
      '110228900=                            ,REC_ID'
      '110228901=                            ,ZAKAZ)'
      '110228902=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110228903=          :DATE_RECEIPT_,'
      '110228904=          :TIME_RECEIPT_,'
      '110228905=          :G_CLIENT_,'
      '110228906=          :G_PAYMENT_TYPE_,'
      '110228907=          :OSNOVANIE_,'
      '110228908=          :NOTE_,'
      '110228909=          :SUMM_,'
      '110228910=          :SUMM_FACT_,'
      '110228911=          :SUMM_CURRENCY_,'
      
        '110228912=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE ' +
        '0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057 +
        #1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110228913=          :IS_VOZVRAT_,'
      '110228914=          :G_TOCHKA_'
      '110228915=          ,:G_OFFICIAL_'
      '110228916=          ,:IS_EXPECTED_'
      '110228917=          ,:G_NONCASH_PAY_TYPE_'
      '110228918=          ,:REC_ID_'
      '110228919=          ,:ZAKAZ_)'
      '110228920=  RETURNING'
      '110228921=    SKLAD'
      '110228922=  INTO'
      '110228923=    :SKLAD_;'
      '110228924='
      '110228925=  PNT_ = '#39'01'#39';'
      '110228926=  FOR SELECT SKLAD,'
      '110228927=             T.G_PRODUCT,'
      '110228928=             AMOUNT,'
      '110228929=             T.PRICE,'
      '110228930=             SUMM,'
      '110228931=             NDS,'
      '110228932=             NDS_SUMM'
      '110228933=             ,PRICE_CURRENCY'
      '110228934=             ,SUMM_CURRENCY'
      '110228935=             ,PRICE_ROZN'
      '110228936=             ,GG.PRICE'
      '110228937=             ,T.MARK_CODE'
      '110228938=             ,T.COST_PRICE'
      '110228939=        FROM SKLAD_TMP T,'
      '110228940=             G_PRODUCT GG'
      '110228941=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110228942=      ORDER BY 1'
      '110228943=      INTO :SKLAD_TMP_,'
      '110228944=           :RG_PRODUCT_,'
      '110228945=           :RAMOUNT_,'
      '110228946=           :RPRICE_,'
      '110228947=           :RSUMM_,'
      '110228948=           :RNDS_,'
      '110228949=           :RNDS_SUMM_'
      '110228950=           ,:PRICE_CURRENCY_'
      '110228951=           ,:SUMM_CURRENCY_TMP_'
      '110228952=           ,:SALE_PRICE_'
      '110228953=           ,:SALE_PRICE_CUR_'
      '110228954=           ,:MARK_CODE_'
      '110228955=           ,:COST_PRICE_'
      '110228956=  DO BEGIN'
      '110228957=    /*IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110228958=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110228959=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110228960=      IS_THIS_LAST_ = 0;'
      '110228961=      SELECT MAX(SK.DATE_RECEIPT)'
      '110228962=        FROM SKLAD SK'
      '110228963=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110228964=         AND SK.IS_LAST = 1'
      '110228965=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110228966=        INTO :DATE_LAST_;'
      '110228967='
      
        '110228968=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110228969=        UPDATE SKLAD SK'
      '110228970=           SET SK.IS_LAST = 0'
      '110228971=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110228972=           AND SK.IS_LAST = 1'
      '110228973=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110228974='
      '110228975=        IS_THIS_LAST_ = 1;'
      '110228976=      END'
      '110228977=    END*/'
      '110228978='
      '110228979=    INSERT INTO SKLAD'
      '110228980=    ('
      '110228981=     SKLAD,'
      '110228982=     SKLAD_PARENT,'
      '110228983=     DATE_RECEIPT,'
      '110228984=     G_CLIENT,'
      '110228985=     G_PRODUCT,'
      '110228986=     AMOUNT,'
      '110228987=     PRICE,'
      '110228988=     SUMM,'
      '110228989=     G_PAYMENT_TYPE,'
      '110228990=     OSNOVANIE,'
      '110228991=     NOTE,'
      '110228992=     NDS,'
      '110228993=     NDS_SUMM,'
      '110228994=     IS_LAST,'
      '110228995=     IS_VOZVRAT,'
      '110228996=     G_TOCHKA'
      '110228997=     ,PRICE_CURRENCY'
      '110228998=     ,SUMM_CURRENCY'
      '110228999=     ,MARK_CODE'
      '1102281000=     ,COST_PRICE'
      '1102281001=    ) VALUES ('
      '1102281002=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1102281003=     :SKLAD_,'
      '1102281004=     :DATE_RECEIPT_,'
      '1102281005=     :G_CLIENT_,'
      '1102281006=     :RG_PRODUCT_,'
      '1102281007=     :RAMOUNT_,'
      '1102281008=     :RPRICE_,'
      '1102281009=     :RSUMM_,'
      '1102281010=     :G_PAYMENT_TYPE_,'
      '1102281011=     :OSNOVANIE_,'
      '1102281012=     :NOTE_,'
      '1102281013=     :RNDS_,'
      '1102281014=     :RNDS_SUMM_,'
      
        '1102281015=     0, --DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069 +
        #1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' ' +
        #1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043 +
        #1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1102281016=     :IS_VOZVRAT_,'
      '1102281017=     :G_TOCHKA_'
      '1102281018=     ,:PRICE_CURRENCY_'
      '1102281019=     ,:SUMM_CURRENCY_TMP_'
      '1102281020=     ,:MARK_CODE_'
      '1102281021=     ,:COST_PRICE_'
      '1102281022=    );'
      '1102281023='
      
        '1102281024=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1102281025=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102281026=        PNT_ = '#39'02'#39';'
      '1102281027=        UPDATE LT_SKLAD_PRODUCT L'
      '1102281028=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '1102281029=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102281030=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1102281031=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102281032='
      '1102281033=        IF (ROW_COUNT = 0) THEN'
      
        '1102281034=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT' +
        ')'
      
        '1102281035=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :R' +
        'G_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102281036=    END'
      '1102281037='
      
        '1102281038=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061 +
        #1054#1044#1045
      '1102281039=      UPDATE G_PRODUCT G'
      '1102281040=         SET G.PRICE = :SALE_PRICE_'
      '1102281041=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '1102281042=  END'
      '1102281043=  ----------------------------------------'
      '1102281044='
      
        '1102281045=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1102281046=  PNT_ = '#39'05'#39';'
      
        '1102281047=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1102281048=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1102281049=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102281050=      ELSE'
      '1102281051=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1102281052='
      
        '1102281053=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1102281054=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1102281055=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102281056=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1102281057=                                        :SUMM_FACT_,'
      
        '1102281058=                                        :DATE_RECEIPT' +
        '_,'
      
        '1102281059=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1102281060=                                        NULL,   --ZAK' +
        'AZ_'
      '1102281061=                                        :SKLAD_,'
      
        '1102281062=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1102281063=                                        :G_TOCHKA_,'
      
        '1102281064=                                        :UPLOAD_TO_EX' +
        'T_APP_'
      
        '1102281065=                                        ) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102281066=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102281067=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102281068=            EXIT;'
      '1102281069=          END'
      '1102281070=      END ELSE BEGIN'
      '1102281071=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102281072=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102281073=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102281074=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102281075=            ELSE'
      
        '1102281076=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102281077='
      '1102281078=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102281079=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102281080='
      
        '1102281081=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102281082='
      '1102281083=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102281084=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102281085=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1102281086=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1102281087=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1102281088=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102281089=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1102281090=                                              :SKLAD_' +
        ','
      
        '1102281091=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1102281092=                                              :G_TOCH' +
        'KA_,'
      
        '1102281093=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102281094=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102281095=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102281096=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102281097=                  EXIT;'
      '1102281098=                END'
      '1102281099=            END'
      '1102281100=          END'
      '1102281101=      END'
      '1102281102=  END'
      '1102281103='
      '1102281104=  -- 28.04.2022'
      
        '1102281105=  -- '#1045#1057#1051#1048' '#1054#1060#1054#1056#1052#1051#1071#1045#1058#1057#1071' '#1042#1054#1047#1042#1056#1040#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1058#1054' '#1053 +
        #1040#1044#1054' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042' '#1047#1040' '#1069#1058#1059' '#1055#1056#1054#1044#1040#1046#1059
      
        '1102281106=  -- '#1055#1056#1048#1063#1045#1052' '#1042#1045#1056#1053#1059#1058#1068' '#1048#1047' '#1042#1057#1045#1049' '#1055#1056#1054#1044#1040#1046#1048' '#1052#1054#1043#1059#1058' '#1058#1054#1051#1068#1050#1054' '#1063#1040#1057#1058 +
        #1068', '#1055#1054#1069#1058#1054#1052#1059' '#1053#1040#1044#1054' '#1057#1063#1048#1058#1040#1058#1068
      
        '1102281107=  -- '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1050' '#1052#1054#1052#1045#1053#1058#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1052#1054#1046#1045#1058' '#1048#1047#1052#1045#1053#1048#1058#1068 +
        #1057#1071', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1050#1040#1050#1054#1049' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1058#1054#1043#1044#1040' '#1041#1067#1051
      
        '1102281108=  -- '#1055#1054' '#1061#1054#1056#1054#1064#1045#1052#1059' '#1045#1065#1045' '#1053#1040#1044#1054' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1043#1054' '#1055#1056#1054 +
        #1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1042' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1048#1048' '#1057' '#1051#1045#1057#1045#1053#1050#1054#1049', '#1053#1054' '#1055#1054#1050#1040' '#1053#1045' '#1041#1059#1044#1059' '#1069#1058#1054#1043#1054' '#1044#1045#1051 +
        #1040#1058#1068
      
        '1102281109=  IF (ZAKAZ_ IS NOT NULL AND IS_VOZVRAT_ = 1) THEN BE' +
        'GIN'
      '1102281110=     /*SELECT Z.SUMM_BONUS_GOT,'
      '1102281111=            Z.SUMM'
      '1102281112=       FROM ZAKAZ Z'
      '1102281113=      WHERE ZAKAZ = :ZAKAZ_'
      '1102281114=       INTO :SUMM_BONUS_GOT_,'
      '1102281115=            :ZAKAZ_SUMM_;'
      '1102281116='
      '1102281117=     IF (ZAKAZ_SUMM_ = SUMM_) THEN'
      '1102281118=       BONUS_TO_MINUS_ = SUMM_BONUS_GOT_;'
      '1102281119='
      '1102281120=     ELSE BEGIN'
      
        '1102281121=       BONUS_PERCENT_ = SUMM_BONUS_GOT_ / ZAKAZ_SUMM_' +
        ';  -- '#1053#1040#1061#1054#1046#1059' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058
      '1102281122='
      
        '1102281123=       BONUS_TO_MINUS_ = ROUND(SUMM_ * BONUS_PERCENT_' +
        ', 2);   -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040#1058#1040
      '1102281124=     END'
      '1102281125='
      '1102281126=     UPDATE G_DISCONT_CARD G'
      '1102281127=        SET G.SUMM = G.SUMM - :BONUS_TO_MINUS_,'
      '1102281128=            G.SUMM_ALL = G.SUMM_ALL - :SUMM_'
      '1102281129=      WHERE G.G_CLIENT = :G_CLIENT_;*/'
      '1102281130='
      '1102281131=    SELECT G.SUMM'
      '1102281132=      FROM G_DISCONT_CARD G'
      '1102281133=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102281134=      INTO :SUMM_BONUS_;'
      '1102281135='
      '1102281136=    IF (:SUMM_BONUS_ > 0) THEN BEGIN'
      '1102281137=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '1102281138=              SUM(Z.SUMM)'
      '1102281139=         FROM ZAKAZ Z'
      '1102281140=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '1102281141=         INTO :SUMM_BONUS_GOT_,'
      '1102281142=              :SUMM_ALL_;'
      '1102281143='
      
        '1102281144=       SELECT ROUND( SUM(SP.SUMM * (Z.SUMM_BONUS_GOT ' +
        '/ Z.SUMM)), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042 +
        #1056#1040#1058#1040
      '1102281145=              SUM(SP.SUMM)'
      '1102281146=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '1102281147=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '1102281148=          AND SP.ZAKAZ = Z.ZAKAZ'
      '1102281149=         INTO :BONUS_TO_MINUS_,'
      '1102281150=              :SUMM_TO_MINUS_;'
      '1102281151='
      '1102281152=       UPDATE G_DISCONT_CARD G'
      
        '1102281153=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_M' +
        'INUS_,'
      
        '1102281154=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINU' +
        'S_'
      '1102281155=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '1102281156=    END'
      '1102281157=  END'
      '1102281158='
      '1102281159=  DELETE FROM SKLAD_TMP;'
      '1102281160='
      
        '1102281161=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1102281162=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102281163=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1102281164=                                  G_PRIHOD_,'
      '1102281165=                                  :SUMM_PRIHOD_,'
      '1102281166=                                  :DATE_RECEIPT_,'
      
        '1102281167=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102281168=                                  NULL,   --:ZAKAZ_,'
      '1102281169=                                  :SKLAD_,'
      '1102281170=                                  :G_PAYMENT_TYPE_,'
      '1102281171=                                  :G_TOCHKA_,'
      '1102281172=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102281173=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102281174=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102281175=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102281176=      EXIT;'
      '1102281177=    END'
      '1102281178=  END'
      '1102281179='
      
        '1102281180=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102281181=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, ' +
        '1, 2)) THEN'
      
        '1102281182=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      '1102281183=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '1102281184=            2,'
      '1102281185=            :SKLAD_,'
      '1102281186=            1,'
      
        '1102281187=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1' +
        ' ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052 +
        ' '#1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102281188=           );'
      '1102281189='
      '1102281190=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102281191=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1102281192=END'
      '1102281193=;'
      '1102281194='
      '1102281195=ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '1102281196=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102281197=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102281198=  DATE_BEGIN_ DATE,'
      '1102281199=  DATE_END_ DATE,'
      '1102281200=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102281201=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1102281202=RETURNS ('
      '1102281203=  DATE_BEGIN_OUT_ DATE,'
      '1102281204=  DATE_END_OUT_ DATE,'
      '1102281205=  STR_ VARCHAR(500),'
      '1102281206=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '1102281207=  NAME VARCHAR(1000),'
      '1102281208=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102281209=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102281210=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102281211=  AMOUNT_IN MY_NUMERIC_5,'
      
        '1102281212=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '1102281213=  SUMM_PRIHOD NUMERIC(15,2),'
      '1102281214=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1102281215=  SUMM_UHOD NUMERIC(15,2),'
      
        '1102281216=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1102281217=  SUMM_SPISANO NUMERIC(15,2),'
      
        '1102281218=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1102281219=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '1102281220=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.A' +
        'MOUNT,'
      '1102281221=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '1102281222=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1102281223=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '1102281224=  AMOUNT_OUT MY_NUMERIC_5,'
      '1102281225=  LAST_SUPPLIER TYPE OF COLUMN G_CLIENT.NAME,'
      '1102281226=  IS_HEAD INTEGER,'
      '1102281227=  ERR_CODE INTEGER,'
      '1102281228=  ERR_MSG VARCHAR(1024))'
      '1102281229=AS'
      
        '1102281230=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1102281231=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102281232=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '1102281233=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1102281234=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT = 0;'
      '1102281235=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1102281236=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1102281237=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1102281238=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1102281239=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1102281240=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102281241=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1102281242=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102281243=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1102281244=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1102281245=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1102281246=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102281247=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1102281248=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102281249=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1102281250=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102281251=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1102281252=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102281253=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1102281254=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102281255=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1102281256=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102281257=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0' +
        ';'
      
        '1102281258=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102281259=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1102281260=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102281261=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1102281262=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102281263=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '1102281264=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102281265=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '1102281266=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102281267=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1102281268=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102281269=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      '1102281270=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '1102281271=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39';'
      
        '1102281272=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '1102281273=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '1102281274=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      
        '1102281275=DECLARE VARIABLE REC_LAST_SUPPLIER_ TYPE OF COLUMN G_' +
        'CLIENT.NAME;'
      '1102281276=BEGIN'
      '1102281277='
      '1102281278=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '1102281279=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1102281280='
      '1102281281=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '1102281282=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '1102281283=               (select (select COALESCE(sum(amount), ' +
        '0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1102281284=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1102281285=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1102281286=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102281287=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1102281288=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1102281289=                        and zrp.ZAKAZ_DATE >= :DATE_B' +
        'EGIN_)'
      '1102281290=                       +'
      
        '1102281291=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1102281292=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1102281293=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      '1102281294=                        and z.IS_RESERVE = 0'
      
        '1102281295=                        and z.IS_SPISANIE <> 2   -- '#1085 +
        #1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' ' +
        #1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102281296=                        and not (z.IS_SPISANIE = 0 an' +
        'd z.NOT_MINUS_OSTATOK = 1))'
      '1102281297=                       +'
      
        '1102281298=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1102281299=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1102281300=                       +'
      
        '1102281301=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1102281302=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1102281303=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1102281304=                       -'
      
        '1102281305=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102281306=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102281307=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_ and not (sp.IS_VOZVRAT = 0 and sp.IS' +
        '_EXPECTED = 1))'
      '1102281308=                       -'
      
        '1102281309=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102281310=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1102281311=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||Sp.g_tochka||'#39'-'#39' and sp.date_receipt >= :DATE_BEGIN_ and s' +
        'p.IS_EXPECTED = 0)'
      '1102281312=                  from rdb$database) AMOUNT_OUT,'
      '1102281313=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1102281314=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1102281315=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102281316=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102281317=                   AND SP.IS_VOZVRAT = 0'
      '1102281318=                   AND SP.IS_EXPECTED = 0'
      
        '1102281319=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') AMOUNT_PRIHOD,'
      '1102281320=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1102281321=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102281322=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102281323=                   AND SP.IS_VOZVRAT = 0'
      '1102281324=                   AND SP.IS_EXPECTED = 0'
      
        '1102281325=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') SUMM_PRIHOD,'
      '1102281326=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '1102281327=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1102281328=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102281329=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102281330=                   AND Z.IS_SPISANIE = 0'
      '1102281331=                   AND Z.IS_RESERVE = 0'
      '1102281332=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1102281333=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_UHOD,'
      '1102281334=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1102281335=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102281336=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102281337=                   AND Z.IS_SPISANIE = 0'
      '1102281338=                   AND Z.IS_RESERVE = 0'
      '1102281339=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1102281340=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_UHOD,'
      '1102281341=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102281342=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1102281343=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102281344=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102281345=                   AND Z.IS_SPISANIE = 1'
      
        '1102281346=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_SPISANO,'
      '1102281347=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1102281348=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102281349=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102281350=                   AND Z.IS_SPISANIE = 1'
      
        '1102281351=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_SPISANO,'
      '1102281352=               -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102281353=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1102281354=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1102281355=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1102281356=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1102281357=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') AMOUNT_VOZVRAT,'
      '1102281358=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1102281359=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1102281360=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1102281361=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1102281362=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') SUMM_VOZVRAT,'
      
        '1102281363=               -- '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059 +
        #1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1067#1056#1040#1042#1053#1048#1042#1040#1053#1048#1045' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1042' '#1056#1045#1047#1059#1051 +
        #1068#1058#1040#1058#1045' '#1056#1045#1042#1048#1047#1048#1048
      '1102281364=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      '1102281365=                  FROM SKLAD S, SKLAD_PARENT SP'
      '1102281366=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      '1102281367=                   AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102281368=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102281369=                   AND SP.IS_VOZVRAT IN (3, 4, 5)'
      
        '1102281370=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39
      
        '1102281371=                   AND NOT (SP.IS_VOZVRAT = 3 AND SP.' +
