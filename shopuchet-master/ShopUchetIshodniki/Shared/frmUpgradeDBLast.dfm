        '110102934=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053 +
