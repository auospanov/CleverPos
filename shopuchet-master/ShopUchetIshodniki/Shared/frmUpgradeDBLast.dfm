        'L_ + SUMM_PRIHOD_SKL_;'
      
        '11056866=            AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_AL' +
        'L_ + AMOUNT_UHOD_SKL_;'
      
        '11056867=            SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_' +
        ' + SUMM_UHOD_SKL_;'
      '11056868='
      '11056869=            AMOUNT_PRIHOD_  = 0;'
      '11056870=            SUMM_PRIHOD_    = 0;'
      '11056871=            AMOUNT_UHOD_    = 0;'
      '11056872=            SUMM_UHOD_      = 0;'
      '11056873=            AMOUNT_SPISANO_ = 0;'
      '11056874=            SUMM_SPISANO_   = 0;'
      '11056875=            AMOUNT_VOZVRAT_ = 0;'
      '11056876=            SUMM_VOZVRAT_   = 0;'
      '11056877=            AMOUNT_PRIHOD_SKL_ = 0;'
      '11056878=            SUMM_PRIHOD_SKL_   = 0;'
      '11056879=            AMOUNT_UHOD_SKL_   = 0;'
      '11056880=            SUMM_UHOD_SKL_     = 0;'
      '11056881=        END'
      '11056882='
      '11056883=        INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      '11056884=          (P_REP_TOVAR_MOVE_TABLE, NAME, IS_HEAD)'
      '11056885=        VALUES'
      
        '11056886=          (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), :PATH' +
        '_, 1);'
      '11056887=      END'
      '11056888='
      '11056889=      INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11056890=        (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, NAME, AMOUN' +
        'T_IN, AMOUNT_PRIHOD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT' +
        '_SPISANO, SUMM_SPISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '11056891=        AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHOD' +
        '_SKL, SUMM_UHOD_SKL,  AMOUNT_OUT, IS_HEAD)'
      '11056892=      VALUES'
      
        '11056893=        (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), :REC_G_' +
        'PRODUCT_, :GNAME_, :REC_AMOUNT_IN_, :REC_AMOUNT_PRIHOD_, :REC_SU' +
        'MM_PRIHOD_, :REC_AMOUNT_UHOD_, :REC_SUMM_UHOD_, :REC_AMOUNT_SPIS' +
        'ANO_, :REC_SUMM_SPISANO_, :REC_AMOUNT_VOZVRAT_, :REC_SUMM_VOZVRA' +
        'T_,'
      
        '11056894=        :REC_AMOUNT_PRIHOD_SKL_, :REC_SUMM_PRIHOD_SKL_,' +
        ' :REC_AMOUNT_UHOD_SKL_, :REC_SUMM_UHOD_SKL_,'
      '11056895=        :REC_AMOUNT_OUT_,'
      '11056896=        0);'
      '11056897='
      
        '11056898=      AMOUNT_PRIHOD_  = AMOUNT_PRIHOD_ + REC_AMOUNT_PRI' +
        'HOD_;'
      
        '11056899=      SUMM_PRIHOD_    = SUMM_PRIHOD_   + REC_SUMM_PRIHO' +
        'D_;'
      
        '11056900=      AMOUNT_UHOD_    = AMOUNT_UHOD_   + REC_AMOUNT_UHO' +
        'D_;'
      
        '11056901=      SUMM_UHOD_      = SUMM_UHOD_     + REC_SUMM_UHOD_' +
        ';'
      
        '11056902=      AMOUNT_SPISANO_ = AMOUNT_SPISANO_  + REC_AMOUNT_S' +
        'PISANO_;'
      
        '11056903=      SUMM_SPISANO_   = SUMM_SPISANO_    + REC_SUMM_SPI' +
        'SANO_;'
      
        '11056904=      AMOUNT_VOZVRAT_ = AMOUNT_VOZVRAT_  + REC_AMOUNT_V' +
        'OZVRAT_;'
      
        '11056905=      SUMM_VOZVRAT_      = SUMM_VOZVRAT_    + REC_SUMM_' +
        'VOZVRAT_;'
      
        '11056906=      AMOUNT_PRIHOD_SKL_ = AMOUNT_PRIHOD_SKL_ + REC_AMO' +
        'UNT_PRIHOD_SKL_;'
      
        '11056907=      SUMM_PRIHOD_SKL_   = SUMM_PRIHOD_SKL_ + REC_SUMM_' +
        'PRIHOD_SKL_;'
      
        '11056908=      AMOUNT_UHOD_SKL_   = AMOUNT_UHOD_SKL_ + REC_AMOUN' +
        'T_UHOD_SKL_;'
      
        '11056909=      SUMM_UHOD_SKL_     = SUMM_UHOD_SKL_ + REC_SUMM_UH' +
        'OD_SKL_;'
      '11056910='
      '11056911=      PATH_OLD_ = PATH_;'
      '11056912=    END'
      '11056913='
      '11056914=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11056915=      (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '11056916=       AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHOD_' +
        'SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '11056917=    VALUES'
      
        '11056918=      (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AM' +
        'OUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_, :AMOUNT' +
        '_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVRAT_,'
      
        '11056919=       :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :AMOUNT_' +
        'UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '11056920='
      
        '11056921=    AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + AMOUNT_PR' +
        'IHOD_;'
      
        '11056922=    SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD' +
        '_;'
      
        '11056923=    AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMOUNT_UHOD' +
        '_;'
      '11056924=    SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_UHOD_;'
      
        '11056925=    AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ + AMOUNT_' +
        'SPISANO_;'
      
        '11056926=    SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + SUMM_SPIS' +
        'ANO_;'
      
        '11056927=    AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ + AMOUNT_' +
        'VOZVRAT_;'
      
        '11056928=    SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + SUMM_VOZV' +
        'RAT_;'
      
        '11056929=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ + A' +
        'MOUNT_PRIHOD_SKL_;'
      
        '11056930=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + SUM' +
        'M_PRIHOD_SKL_;'
      
        '11056931=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + AMO' +
        'UNT_UHOD_SKL_;'
      
        '11056932=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUMM_' +
        'UHOD_SKL_;'
      '11056933='
      '11056934=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11056935=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD, ' +
        'SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPISAN' +
        'O, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_' +
        'SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '11056936=    VALUES'
      
        '11056937=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AMOU' +
        'NT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UHOD' +
        '_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVRAT' +
        '_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIHOD' +
        '_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '11056938='
      
        '11056939=    STR_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_)' +
        ', 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '11056940=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39 +
        #39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXTR' +
        'ACT(YEAR FROM DATE_END_);'
      '11056941='
      '11056942=  FOR'
      '11056943=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '11056944=           DECODE(T.IS_HEAD,'
      '11056945=                  0, T.NAME,'
      '11056946=                  1, T.NAME,'
      '11056947=                  2, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39','
      '11056948=                  3, '#39#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39#39'),'
      '11056949=           G.ARTICUL,'
      '11056950=           G.BARCODE,'
      '11056951=           G.PRICE,'
      '11056952=           T.AMOUNT_IN,'
      '11056953=           T.AMOUNT_PRIHOD,'
      '11056954=           T.SUMM_PRIHOD,'
      '11056955=           T.AMOUNT_UHOD,'
      '11056956=           T.SUMM_UHOD,'
      '11056957=           T.AMOUNT_SPISANO,'
      '11056958=           T.SUMM_SPISANO,'
      '11056959=           T.AMOUNT_VOZVRAT,'
      '11056960=           T.SUMM_VOZVRAT,'
      '11056961=           T.AMOUNT_PRIHOD_SKL,'
      '11056962=           T.SUMM_PRIHOD_SKL,'
      '11056963=           T.AMOUNT_UHOD_SKL,'
      '11056964=           T.SUMM_UHOD_SKL,'
      '11056965=           T.AMOUNT_OUT,'
      '11056966=           T.IS_HEAD'
      
        '11056967=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G_P' +
        'RODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '11056968=     ORDER BY 1'
      '11056969=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '11056970=       :NAME,'
      '11056971=       :ARTICUL,'
      '11056972=       :BARCODE,'
      '11056973=       :PRICE,'
      '11056974=       :AMOUNT_IN,'
      '11056975=       :AMOUNT_PRIHOD,'
      '11056976=       :SUMM_PRIHOD,'
      '11056977=       :AMOUNT_UHOD,'
      '11056978=       :SUMM_UHOD,'
      '11056979=       :AMOUNT_SPISANO,'
      '11056980=       :SUMM_SPISANO,'
      '11056981=       :AMOUNT_VOZVRAT,'
      '11056982=       :SUMM_VOZVRAT,'
      '11056983=       :AMOUNT_PRIHOD_SKL,'
      '11056984=       :SUMM_PRIHOD_SKL,'
      '11056985=       :AMOUNT_UHOD_SKL,'
      '11056986=       :SUMM_UHOD_SKL,'
      '11056987=       :AMOUNT_OUT,'
      '11056988=       :IS_HEAD'
      '11056989=  DO SUSPEND;'
      '11056990='
      '11056991=WHEN ANY DO BEGIN'
      '11056992=    Err_code = -20500;'
      
        '11056993=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11056994=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11056995=  END'
      '11056996=end'
      '11056997='#39';'
      '11056998=END  --END_EXECUTE_BLOCK'
      '11056999=EXECUTE BLOCK AS BEGIN'
      '110561000='
      
        '110561001=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_DETAILS_' +
        'LIST('
      '110561002=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110561003=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE)'
      '110561004=RETURNS ('
      '110561005=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '110561006=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DET' +
        'AILS,'
      '110561007=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '110561008=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110561009=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110561010=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110561011=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'PERC,'
      
        '110561012=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_TENGE,'
      
        '110561013=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110561014=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110561015=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110561016=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110561017=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110561018=  ED_NAME TYPE OF COLUMN G_UNIT.NAME)'
      '110561019=AS'
      '110561020=begin'
      '110561021='
      '110561022=  FOR'
      '110561023=    SELECT D.ZAKAZ,'
      '110561024=           D.ZAKAZ_DETAILS,'
      '110561025=           D.G_PRODUCT,'
      '110561026=           D.AMOUNT,'
      '110561027=           D.PRICE,'
      '110561028=           D.SUMM,'
      '110561029=           D.DISCOUNT_PERC,'
      '110561030=           D.DISCOUNT_TENGE,'
      '110561031=           D.DISCOUNT_SUMM,'
      '110561032=           G.ARTICUL,'
      '110561033=           G.NOMENCLATUR_NUM,'
      '110561034=           G.BARCODE,'
      '110561035=           G.NAME,'
      '110561036=           COALESCE(GU.SHORT_NAME, GU.NAME)'
      '110561037=      FROM ZAKAZ_DETAILS D,'
      '110561038=           G_PRODUCT G,'
      '110561039=           G_UNIT GU'
      '110561040=     WHERE D.ZAKAZ = :ZAKAZ_'
      '110561041=       AND D.G_PRODUCT = G.G_PRODUCT'
      '110561042=       AND G.G_UNIT = GU.G_UNIT'
      '110561043=       AND :IS_SPISANIE_ <> 3'
      '110561044=    UNION ALL'
      '110561045=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '110561046=           D.SKLAD ZAKAZ_DETAILS,'
      '110561047=           D.G_PRODUCT,'
      '110561048=           D.AMOUNT,'
      '110561049=           D.PRICE,'
      '110561050=           D.SUMM,'
      '110561051=           0 DISCOUNT_PERC,'
      '110561052=           0 DISCOUNT_TENGE,'
      '110561053=           0 DISCOUNT_SUMM,'
      '110561054=           G.ARTICUL,'
      '110561055=           G.NOMENCLATUR_NUM,'
      '110561056=           G.BARCODE,'
      '110561057=           G.NAME,'
      '110561058=           GU.NAME'
      '110561059=      FROM SKLAD D,'
      '110561060=           G_PRODUCT G,'
      '110561061=           G_UNIT GU'
      '110561062=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '110561063=       AND D.G_PRODUCT = G.G_PRODUCT'
      '110561064=       AND G.G_UNIT = GU.G_UNIT'
      '110561065=       AND :IS_SPISANIE_ = 3'
      '110561066=    ORDER BY 1'
      '110561067=    INTO  :ZAKAZ,'
      '110561068=          :ZAKAZ_DETAILS,'
      '110561069=          :G_PRODUCT,'
      '110561070=          :AMOUNT,'
      '110561071=          :PRICE,'
      '110561072=          :SUMM,'
      '110561073=          :DISCOUNT_PERC,'
      '110561074=          :DISCOUNT_TENGE,'
      '110561075=          :DISCOUNT_SUMM,'
      '110561076=          :ARTICUL,'
      '110561077=          :NOMENCLATUR_NUM,'
      '110561078=          :BARCODE,'
      '110561079=          :TOVAR_NAME,'
      '110561080=          :ED_NAME'
      '110561081=  DO'
      '110561082=    suspend;'
      '110561083=end'
      '110561084='#39';'
      
        '110561085=UPDATE SYSTEM_SETUP SET S_VALUE = 11056 WHERE SYSTEM_S' +
        'ETUP = 3;'
      '110561086=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110570=EXECUTE BLOCK AS BEGIN'
      '110571=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_DISCOUNT('
      '110572=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '110573=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '110574=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '110575=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '110576=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '110577=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '110578=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '110579=  G_TOCHKA_ VARCHAR(500))'
      '1105710=RETURNS ('
      '1105711=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '1105712=  ERR_CODE INTEGER,'
      '1105713=  ERR_MSG VARCHAR(1024))'
      '1105714=AS'
      '1105715=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1105716=DECLARE VARIABLE G_PRODUCT_REC_ TYPE OF COLUMN G_DISCOUN' +
        'T.G_PRODUCT;'
      
        '1105717=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_DISCOUNT.G_' +
        'PRODUCT;'
      
        '1105718=DECLARE VARIABLE SKIDKA_PROC_R_ TYPE OF COLUMN G_DISCOUN' +
        'T.SKIDKA_PROC;'
      
        '1105719=DECLARE VARIABLE SKIDKA_SUM_R_ TYPE OF COLUMN G_DISCOUNT' +
        '.SKIDKA_SUM;'
      
        '1105720=DECLARE VARIABLE G_TOCHKA_ID_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1105721=BEGIN'
      '1105722='
      '1105723=    FOR SELECT NULL G_TOCHKA'
      '1105724=          FROM RDB$DATABASE'
      '1105725=         WHERE :G_TOCHKA_ IS NULL'
      '1105726=        UNION ALL'
      '1105727=        SELECT G.G_TOCHKA'
      '1105728=          FROM G_TOCHKA G'
      
        '1105729=         WHERE :G_TOCHKA_ CONTAINING '#39#39'~'#39#39'||G.G_TOCHKA||' +
        #39#39'~'#39#39
      '1105730=        ORDER BY 1'
      '1105731=          INTO :G_TOCHKA_ID_'
      '1105732=    DO BEGIN'
      '1105733=            FOR SELECT G.G_PRODUCT,'
      '1105734=                       G.PRICE'
      '1105735=                  FROM G_PRODUCT G'
      
        '1105736=                 WHERE G.G_PRODUCT_PAR = DECODE(:G_PRODU' +
        'CT_PAR_, -1, G.G_PRODUCT_PAR, :G_PRODUCT_PAR_)'
      
        '1105737=                   AND G.G_PRODUCT = COALESCE(:G_PRODUCT' +
        '_, G.G_PRODUCT)'
      '1105738=                   AND G.IS_ACTIVE = 1'
      '1105739=                   AND G.IS_CATEGORY = 0'
      '1105740=                   AND G.PRICE > 0'
      '1105741=                  INTO :G_PRODUCT_REC_,'
      '1105742=                       :PRICE_REC_'
      '1105743=            DO BEGIN'
      '1105744=                if (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1105745=                  DELETE FROM G_DISCOUNT'
      
        '1105746=                   WHERE COALESCE(DATE_BEGIN, CURRENT_DA' +
        'TE) <= CURRENT_DATE AND COALESCE(DATE_END, CURRENT_DATE) >= CURR' +
        'ENT_DATE'
      '1105747=                     AND G_PRODUCT = :G_PRODUCT_REC_'
      '1105748=                     AND G_TOCHKA = :G_TOCHKA_ID_;'
      '1105749=                ELSE BEGIN'
      '1105750=                    SELECT COUNT(*)'
      '1105751=                      FROM G_DISCOUNT'
      '1105752=                     WHERE G_PRODUCT = :G_PRODUCT_REC_'
      
        '1105753=                       AND COALESCE(DATE_BEGIN, CURRENT_' +
        'DATE) <= CURRENT_DATE'
      
        '1105754=                       AND COALESCE(DATE_END, CURRENT_DA' +
        'TE) >= CURRENT_DATE'
      
        '1105755=                       AND ((G_TOCHKA = COALESCE(:G_TOCH' +
        'KA_ID_, 0))'
      '1105756=                            OR'
      
        '1105757=                            (G_TOCHKA IS NOT NULL AND :G' +
        '_TOCHKA_ID_ IS NULL)'
      '1105758=                            OR'
      '1105759=                            (G_TOCHKA IS NULL)'
      '1105760=                           )'
      '1105761=                      INTO CNT_;'
      '1105762='
      '1105763=                    IF (CNT_ <> 0) THEN BEGIN'
      '1105764=                      ERR_CODE = -20500;'
      
        '1105765=                      EXECUTE PROCEDURE GET_ERR_MSG(ERR_' +
        'CODE, '#39#39#1053#1072' '#1076#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39#39') RETURNIN' +
        'G_VALUES (:ERR_MSG);'
      '1105766=                      EXIT;'
      '1105767=                    END'
      '1105768=                END'
      '1105769='
      '1105770=                SKIDKA_PROC_R_ = SKIDKA_PROC_;'
      '1105771=                SKIDKA_SUM_R_  = SKIDKA_SUM_;'
      '1105772=                IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '1105773=                  IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '1105774=                    SKIDKA_PROC_R_ = ROUND(SKIDKA_SUM_ *' +
        ' 100 / PRICE_REC_ , 2);'
      '1105775=                  IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '1105776=                    SKIDKA_SUM_R_ = ROUND(PRICE_REC_ * S' +
        'KIDKA_PROC_ / 100 , 2);'
      '1105777=                END'
      '1105778='
      
        '1105779=                INSERT INTO G_DISCOUNT (G_DISCOUNT, G_PR' +
        'ODUCT, DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA_SU' +
        'M, G_TOCHKA)'
      
        '1105780=                VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G_PR' +
        'ODUCT_REC_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :SKID' +
        'KA_PROC_R_, :SKIDKA_SUM_R_'
      '1105781=                        ,:G_TOCHKA_ID_)'
      '1105782=                RETURNING G_DISCOUNT'
      '1105783=                INTO :G_DISCOUNT_;'
      '1105784=            END'
      '1105785=    END'
      '1105786=end'
      '1105787='#39';'
      
        '1105788=UPDATE SYSTEM_SETUP SET S_VALUE = 11057 WHERE SYSTEM_SET' +
        'UP = 3;'
      
        '110740=INSERT INTO REPORT (REPORT, BODY, SQL, DESCRIPTION, FILEN' +
        'AME, COORD)'
      
        '110741=  VALUES (56, NULL, '#39'SELECT * FROM P_REP_TOVAR_OSTATOK_ON' +
        '_DATE(:G_CATEGORY_, :G_PRODUCT_, :DATE_, :G_TOCHKA_ARR_)'#39', '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1090#1086#1074#1072#1088#1072' '#1085#1072' '#1076#1072#1090#1091#39', '#39'tovar_ostatok_on_date.xls'#39', '#39'8:4'#39');'
      
        '110743=INSERT INTO RIGHTS_ITEM (RIGHTS_ITEM, RIGHTS_GROUP, NAME,' +
        ' IS_CATEGORY)'
      '110744=  VALUES (84, 3, '#39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1086#1074' '#1085#1072' '#1076#1072#1090#1091#39', 0);'
      ''
      ''
      ''
      '')
    TabOrder = 5
    ColWidths = (
      150
      1828)
  end
