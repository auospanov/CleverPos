        '110411401=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110411402=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110411403=  END'
      '110411404=end'
      '110411405='#39';'
      '110411406=END  --END_EXECUTE_BLOCK'
      '110420=EXECUTE BLOCK AS BEGIN'
      
        '110421=EXECUTE STATEMENT '#39'CREATE TRIGGER PRODUCT_AMOUNT_AI0 FOR ' +
        'LT_SKLAD_PRODUCT'
      '110422=ACTIVE'
      '110423=AFTER INSERT'
      '110424=POSITION 0'
      '110425=AS'
      
        '110426=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058 +
        #1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', ' +
        #1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '110427=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050' '#1055#1056 +
        #1048#1052#1045#1056#1059' '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1057#1058#1040#1050#1040#1053#1040' (5 '#1064#1058') '#1048' '#1050#1056#1067#1064#1050#1048' (4 '#1064#1058'), '#1057 +
        #1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110428=  -- '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' = 4'
      
        '110429=  -- '#1053#1040#1042#1045#1057#1048#1051' '#1053#1040' '#1058#1056#1048#1043#1043#1045#1056', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1053#1054#1043#1054' '#1043#1044#1045' '#1053#1040#1044#1054' '#1069#1058#1054' '#1044#1045 +
        #1051#1040#1058#1068' - '#1055#1056#1048#1061#1054#1044', '#1055#1056#1054#1044#1040#1046#1048', '#1056#1045#1044#1040#1050#1058#1048#1056#1042#1054#1040#1053#1048#1045' '#1055#1056#1048#1061#1054#1044#1054#1042'/'#1055#1056#1054#1044#1040#1046
      
        '1104210=DECLARE VARIABLE G_PRODUCT_SOSTAV_  TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      
        '1104211=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUMN' +
        ' LT_SKLAD_PRODUCT.AMOUNT;'
      '1104212=DECLARE VARIABLE CNT_ INTEGER;'
      '1104213=BEGIN'
      '1104214=  FOR SELECT K.G_PRODUCT'
      '1104215=        FROM G_PRODUCT_KIT K, G_PRODUCT G'
      '1104216=       WHERE K.G_PRODUCT_ITEM = NEW.g_product'
      '1104217=         AND K.g_product = G.g_product'
      '1104218=         AND G.is_kit = 1'
      
        '1104219=         AND (SELECT COUNT(1)               -- '#1042#1057#1045' '#1057#1054#1057#1058#1040 +
        #1042#1051#1071#1070#1065#1048#1045' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1048#1061' '#1052#1054#1046#1045#1058' '#1053#1045' '#1041#1067#1058#1068' '#1045#1057#1051#1048' '#1057#1050#1051#1040#1044' '#1053#1054#1042#1067#1049 +
        ', '#1058#1054#1043#1044' '#1042' LT_SKLAD_PRODUCT '#1058#1059#1055#1054' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049
      '1104220=                FROM G_PRODUCT_KIT KK'
      '1104221=               WHERE KK.g_product = K.G_PRODUCT'
      
        '1104222=                 AND NOT EXISTS (SELECT 1 FROM LT_SKLAD_' +
        'PRODUCT L WHERE L.G_TOCHKA = NEW.g_tochka AND L.G_PRODUCT = KK.G' +
        '_PRODUCT_ITEM)) = 0'
      '1104223=       INTO :G_PRODUCT_SOSTAV_'
      '1104224=  DO BEGIN'
      '1104225=    SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE)/K.amount)'
      '1104226=      FROM G_PRODUCT_KIT K,'
      '1104227=           LT_SKLAD_PRODUCT L'
      '1104228=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '1104229=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '1104230=       AND L.G_TOCHKA = NEW.g_tochka'
      '1104231=     GROUP BY K.G_PRODUCT'
      '1104232=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1104233='
      '1104234=    UPDATE LT_SKLAD_PRODUCT L'
      '1104235=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '1104236=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_'
      '1104237=       AND L.G_TOCHKA = NEW.g_tochka;'
      '1104238='
      '1104239=    IF (ROW_COUNT = 0) THEN'
      
        '1104240=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, G_' +
        'PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1104241=      VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUC' +
        'T_SOSTAV_, :G_PRODUCT_SOSTAV_AMOUNT_, 0, NEW.G_TOCHKA);'
      '1104242=  END'
      '1104243=end'
      '1104244='#39';'
      '1104245='
      '1104246='
      '1104247=EXECUTE STATEMENT '#39'ALTER TRIGGER LT_SKLAD_PRODUCT_BU0'
      '1104248=AS'
      '1104249=declare variable G_NAME_  TYPE OF COLUMN G_PRODUCT.NAME;'
      '1104250=declare variable CNT_     INTEGER;'
      
        '1104251=declare variable T_NAME_  TYPE OF COLUMN G_TOCHKA.NAME =' +
        ' '#39#39#39#39';'
      '1104252=begin'
      
        '1104253=  if (((NEW.AMOUNT - NEW.AMOUNT_RESERVE) < 0) AND (SELEC' +
        'T S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) then BE' +
        'GIN'
      '1104254=    SELECT G.NAME'
      '1104255=      FROM G_PRODUCT G'
      '1104256=     WHERE G.G_PRODUCT = NEW.G_PRODUCT'
      '1104257=      INTO :G_NAME_;'
      '1104258='
      '1104259=    if ((SELECT COUNT(*) FROM G_TOCHKA) > 1) then'
      '1104260=      SELECT '#39#39' '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39#39'||G.NAME||'#39#39'"'#39#39
      '1104261=        FROM G_TOCHKA G'
      '1104262=       WHERE G.G_TOCHKA = NEW.G_TOCHKA'
      '1104263=        INTO :T_NAME_;'
      '1104264='
      
        '1104265=    --'#39#39'/Q\'#39#39' - '#1041#1059#1044#1059' '#1042' '#1044#1045#1051#1068#1060#1071#1061' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1050#1040#1050' '#1050#1054#1053#1045#1062' '#1057#1054 +
        #1054#1041#1065#1045#1053#1048#1071', '#1048' '#1042#1057#1045' '#1063#1058#1054' '#1044#1040#1051#1068#1064#1045' - '#1042#1067#1056#1045#1047#1040#1058#1068', '#1040' '#1058#1054' FIREBIRD '#1057#1040#1052' '#1044#1054#1041#1040#1042#1051#1071#1045 +
        #1058
      '1104266=    -- '#1055#1054#1058#1054#1052' '#1043#1044#1045' '#1048' '#1042' '#1050#1040#1050#1054#1052' '#1058#1056#1048#1043#1043#1045#1056#1045' '#1055#1056#1054#1048#1047#1054#1064#1051#1040' '#1054#1064#1048#1041#1050#1040
      
        '1104267=    EXCEPTION NOL_EXCEPTION '#39#39'/R\'#1042' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1086 +
        #1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39#39'||G_NAME_||'#39#39'"'#39#39'||T_NAME_||'#39#39' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100 +
        #1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'./Q\'#39#39';'
      '1104268=  END'
      '1104269=end'
      '1104270='#39';'
      '1104271='
      '1104272=EXECUTE STATEMENT '#39'ALTER TRIGGER PRODUCT_AMOUNT_BI0'
      '1104273=AS'
      
        '1104274=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057 +
        #1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040',' +
        ' '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '1104275=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050' '#1055 +
        #1056#1048#1052#1045#1056#1059' '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1057#1058#1040#1050#1040#1053#1040' (5 '#1064#1058') '#1048' '#1050#1056#1067#1064#1050#1048' (4 '#1064#1058'), ' +
        #1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1104276=  -- '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' = 4'
      
        '1104277=  -- '#1053#1040#1042#1045#1057#1048#1051' '#1053#1040' '#1058#1056#1048#1043#1043#1045#1056', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1053#1054#1043#1054' '#1043#1044#1045' '#1053#1040#1044#1054' '#1069#1058#1054' '#1044 +
        #1045#1051#1040#1058#1068' - '#1055#1056#1048#1061#1054#1044', '#1055#1056#1054#1044#1040#1046#1048', '#1056#1045#1044#1040#1050#1058#1048#1056#1042#1054#1040#1053#1048#1045' '#1055#1056#1048#1061#1054#1044#1054#1042'/'#1055#1056#1054#1044#1040#1046
      
        '1104278=DECLARE VARIABLE G_PRODUCT_SOSTAV_  TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      
        '1104279=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUMN' +
        ' LT_SKLAD_PRODUCT.AMOUNT;'
      '1104280=DECLARE VARIABLE CNT_ INTEGER;'
      '1104281=BEGIN'
      '1104282=  FOR SELECT K.G_PRODUCT'
      '1104283=        FROM G_PRODUCT_KIT K, G_PRODUCT G'
      '1104284=       WHERE K.G_PRODUCT_ITEM = NEW.g_product'
      '1104285=         AND K.g_product = G.g_product'
      '1104286=         AND G.is_kit = 1'
      
        '1104287=         AND (SELECT COUNT(1)               -- '#1042#1057#1045' '#1057#1054#1057#1058#1040 +
        #1042#1051#1071#1070#1065#1048#1045' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1048#1061' '#1052#1054#1046#1045#1058' '#1053#1045' '#1041#1067#1058#1068' '#1045#1057#1051#1048' '#1057#1050#1051#1040#1044' '#1053#1054#1042#1067#1049 +
        ', '#1058#1054#1043#1044' '#1042' LT_SKLAD_PRODUCT '#1058#1059#1055#1054' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049
      '1104288=                FROM G_PRODUCT_KIT KK'
      '1104289=               WHERE KK.g_product = K.G_PRODUCT'
      
        '1104290=                 AND NOT EXISTS (SELECT 1 FROM LT_SKLAD_' +
        'PRODUCT L WHERE L.G_TOCHKA = NEW.g_tochka AND L.G_PRODUCT = KK.G' +
        '_PRODUCT_ITEM)) = 0'
      '1104291=       INTO :G_PRODUCT_SOSTAV_'
      '1104292=  DO BEGIN'
      '1104293=    SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE)/K.amount)'
      '1104294=      FROM G_PRODUCT_KIT K,'
      '1104295=           LT_SKLAD_PRODUCT L'
      '1104296=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '1104297=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '1104298=       AND L.G_TOCHKA = NEW.g_tochka'
      '1104299=     GROUP BY K.G_PRODUCT'
      '11042100=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11042101='
      '11042102=    UPDATE LT_SKLAD_PRODUCT L'
      '11042103=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '11042104=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_'
      '11042105=       AND L.G_TOCHKA = NEW.g_tochka;'
      '11042106='
      '11042107=    IF (ROW_COUNT = 0) THEN'
      
        '11042108=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, G' +
        '_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11042109=      VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODU' +
        'CT_SOSTAV_, :G_PRODUCT_SOSTAV_AMOUNT_, 0, NEW.G_TOCHKA);'
      '11042110=  END'
      '11042111=end'
      '11042112='#39';'
      '11042113='
      '11042114='
      '11042115=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD('
      '11042116=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '11042117=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '11042118=RETURNS ('
      '11042119=  ERR_CODE INTEGER,'
      '11042120=  ERR_MSG VARCHAR(1024))'
      '11042121=AS'
      '11042122=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD'#39#39';'
      '11042123=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11042124=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11042125=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '11042126=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      '11042127=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11042128=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      
        '11042129=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11042130=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071')' +
        ' */'
      
        '11042131=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA.N' +
        'AME;'
      '11042132=BEGIN'
      '11042133='
      '11042134=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '11042135=    SELECT S_VALUE'
      '11042136=      FROM SYSTEM_SETUP'
      '11042137=     WHERE SYSTEM_SETUP = 2'
      '11042138=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11042139='
      '11042140=  SELECT SP.IS_VOZVRAT,'
      
        '11042141=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TOCH' +
        'KA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '11042142=         ,G.NAME'
      '11042143=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '11042144=   WHERE SP.SKLAD = :SKLAD_'
      '11042145=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '11042146=    INTO :IS_VOZVRAT_,'
      '11042147=         :G_TOCHKA_'
      '11042148=         ,:TOCHKA_NAME_;'
      '11042149='
      '11042150=  PNT_ = '#39#39'02'#39#39';'
      '11042151=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '11042152=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        ' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '11042153=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040#1045#1058 +
        ' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      '11042154=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '11042155=      FOR SELECT S.G_PRODUCT,'
      '11042156=                 SUM(S.AMOUNT)'
      '11042157=            FROM SKLAD S'
      '11042158=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '11042159=           GROUP BY S.G_PRODUCT'
      '11042160=            INTO :G_PRODUCT_,'
      '11042161=                 :AMOUNT_PRIHOD_'
      '11042162=      DO BEGIN'
      '11042163=          SELECT L.AMOUNT,'
      '11042164=                 G.NAME'
      '11042165=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '11042166=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11042167=             AND L.G_PRODUCT = G.G_PRODUCT'
      '11042168=             AND L.G_TOCHKA = :G_TOCHKA_'
      '11042169=            INTO :AMOUNT_LAST_,'
      '11042170=                 :NAME_;'
      '11042171='
      
        '11042172=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) TH' +
        'EN BEGIN'
      '11042173=              ERR_CODE = -20500;'
      
        '11042174=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39#39'||NAME_||'#39#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39#39'||TOCHKA_NAME_||'#39#39'"' +
        ' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') R' +
        'ETURNING_VALUES (:ERR_MSG);'
      
        '11042175=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||' +
        #39#39' '#39#39'||ERR_MSG;'
      '11042176=              EXIT;'
      '11042177=          END'
      '11042178=      END'
      '11042179=  END'
      '11042180='
      
        '11042181=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11042182=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11042183=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11042184=    EXIT;'
      '11042185=  END'
      '11042186='
      '11042187=  -------------------------------------'
      
        '11042188=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069 +
        #1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040 +
        #1044#1040
      
        '11042189=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053#1067#1045 +
        ' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1055#1054 +
        #1044#1056#1071#1044
      '11042190=  PNT_ = '#39#39'05'#39#39';'
      '11042191=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '11042192=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '11042193=      FOR SELECT S.KASSA'
      '11042194=            FROM KASSA S'
      '11042195=           WHERE S.SKLAD = :SKLAD_'
      '11042196=            INTO :KASSA_'
      '11042197=      DO BEGIN'
      
        '11042198=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11042199=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11042200=             ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '11042201=             EXIT;'
      '11042202=          END'
      '11042203=      END'
      '11042204='
      '11042205=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '11042206=      FOR SELECT S.KASSA_BEZNAL'
      '11042207=            FROM KASSA_BEZNAL S'
      '11042208=           WHERE S.SKLAD = :SKLAD_'
      '11042209=            INTO :KASSA_'
      '11042210=      DO BEGIN'
      
        '11042211=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11042212=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11042213=             ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '11042214=             EXIT;'
      '11042215=          END'
      '11042216=      END'
      '11042217=  END'
      '11042218=  -------------------------------------'
      '11042219='
      '11042220=  PNT_ = '#39#39'06'#39#39';'
      '11042221=  DELETE FROM sklad_PARENT'
      '11042222=  WHERE sklad = :sklad_;'
      '11042223='
      '11042224=when sqlcode -530 DO'
      '11042225=  begin'
      '11042226=    ERR_CODE = -20500;'
      
        '11042227=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11042228=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11042229=  end'
      '11042230=end'
      '11042231='#39';'
      '11042232='
      '11042233=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD_DETAIL('
      '11042234=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11042235=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '11042236=RETURNS ('
      '11042237=  ERR_CODE INTEGER,'
      '11042238=  ERR_MSG VARCHAR(1024))'
      '11042239=AS'
      
        '11042240=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD_DET' +
        'AIL'#39#39';'
      '11042241=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '11042242=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      '11042243=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '11042244=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '11042245=DECLARE VARIABLE IS_LAST_ TYPE OF COLUMN SKLAD.IS_LAST;'
      
        '11042246=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      
        '11042247=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA' +
        '_REAL.ZAKAZ_NA_REAL;'
      
        '11042248=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11042249=DECLARE VARIABLE G_PRODUCT_SOSTAV_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      
        '11042250=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      
        '11042251=DECLARE VARIABLE IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_EXPECTED;'
      
        '11042252=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071')' +
        ' */'
      
        '11042253=DECLARE VARIABLE G_TOCHKA_PROVIDER_ TYPE OF COLUMN G_TO' +
        'CHKA.G_TOCHKA;'
      '11042254=BEGIN'
      '11042255=  PNT_ = '#39#39'01'#39#39';'
      '11042256=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1053#1048#1052#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11042257=  FOR SELECT S.G_PRODUCT,'
      '11042258=             S.AMOUNT,'
      '11042259=             S.IS_LAST'
      '11042260=             ,SP.IS_VOZVRAT'
      '11042261=             ,SP.G_TOCHKA'
      '11042262=             ,SP.IS_EXPECTED'
      '11042263=             ,SP.G_CLIENT'
      '11042264=        FROM SKLAD S, SKLAD_PARENT SP'
      '11042265=       WHERE SP.SKLAD = S.SKLAD_PARENT'
      '11042266=         AND S.SKLAD_PARENT = :SKLAD_PARENT_'
      '11042267=         AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '11042268=       INTO :G_PRODUCT_,'
      '11042269=            :AMOUNT_,'
      '11042270=            :IS_LAST_'
      '11042271=            ,:IS_VOZVRAT_'
      '11042272=            ,:G_TOCHKA_'
      '11042273=            ,:IS_EXPECTED_'
      '11042274=            ,:G_TOCHKA_PROVIDER_'
      '11042275=  DO BEGIN'
      '11042276=    IF (IS_EXPECTED_ = 0) THEN'
      '11042277=        UPDATE LT_SKLAD_PRODUCT LT'
      '11042278=           SET LT.AMOUNT = LT.AMOUNT - :AMOUNT_'
      '11042279=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '11042280=           AND LT.G_TOCHKA = :G_TOCHKA_;'
      '11042281='
      
        '11042282=    IF (IS_LAST_ = 1) then    -- '#1045#1057#1051#1048' '#1057#1058#1054#1048#1058' IS_LAST, '#1058#1054 +
        ' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1045#1043#1054' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048', '#1063#1058#1054#1041#1067' '#1053#1045' '#1058#1045#1056#1071#1058#1068' '#1055#1054#1057#1051#1045#1044#1053#1070#1070 +
        ' '#1055#1054#1057#1058#1040#1042#1050#1059
      '11042283=        UPDATE SKLAD SK'
      '11042284=             SET SK.IS_LAST = 1'
      '11042285=           WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11042286=             AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '11042287=                               FROM SKLAD SS'
      
        '11042288=                              WHERE SS.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '11042289=                                AND SS.G_PRODUCT = SK.G' +
        '_PRODUCT'
      
        '11042290=                                AND SS.SKLAD_PARENT <> ' +
        ':SKLAD_PARENT_'
      
        '11042291=                                AND SS.DATE_RECEIPT = (' +
        'SELECT MAX(SSS.DATE_RECEIPT)'
      
        '11042292=                                                       ' +
        '  FROM SKLAD SSS'
      
        '11042293=                                                       ' +
        ' WHERE SSS.G_PRODUCT = SS.G_PRODUCT'
      
        '11042294=                                                       ' +
        '   AND SSS.IS_VOZVRAT in (0, 4)'
      
        '11042295=                                                       ' +
        '   AND SSS.SKLAD_PARENT <> :SKLAD_PARENT_'
      
        '11042296=                                                       ' +
        '   AND SSS.G_TOCHKA = :G_TOCHKA_));'
      '11042297='
      '11042298=  END'
      '11042299='
      '11042300=  PNT_ = '#39#39'02'#39#39';'
      
        '11042301=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051'. '#1042' '#1069#1058 +
        #1054#1052' '#1057#1051#1059#1063#1040#1045' '#1050#1054#1051'-'#1042#1054' '#1053#1040#1044#1054' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1058#1068' '#1050#1054#1051'-'#1042#1054' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1048' '#1059#1044#1040#1051#1071 +
        #1058#1068' '#1044#1040#1053#1053#1067#1045
      '11042302=  -- '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067' LT_ZAKAZ_REAL'
      '11042303=  IF (IS_VOZVRAT_ = 2) THEN BEGIN'
      '11042304=    FOR SELECT ZD.AMOUNT,'
      '11042305=             ZD.PRICE,'
      '11042306=             LZ.ZAKAZ_NA_REAL'
      '11042307=        FROM SKLAD ZD,'
      '11042308=             LT_ZAKAZ_REAL LZ'
      '11042309=       WHERE ZD.SKLAD_PARENT = :SKLAD_PARENT_'
      '11042310=         AND ZD.SKLAD = COALESCE(:SKLAD_, ZD.SKLAD)'
      '11042311=         AND ZD.SKLAD = LZ.SKLAD'
      '11042312=       INTO :AMOUNT_,'
      '11042313=            :PRICE_,'
      '11042314=            :ZAKAZ_NA_REAL_'
      '11042315=    DO BEGIN'
      '11042316=      UPDATE ZAKAZ_NA_REAL ZRR'
      
        '11042317=         SET ZRR.AMOUNT_RETURNED = ZRR.AMOUNT_RETURNED ' +
        '- :AMOUNT_,'
      
        '11042318=             ZRR.SUMM_RETURNED = ZRR.SUMM_RETURNED - :A' +
        'MOUNT_ * :PRICE_,'
      '11042319=             ZRR.IS_PAYED_ALL = 0'
      '11042320=       WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '11042321=    END'
      '11042322='
      '11042323=    IF (SKLAD_ IS NOT NULL) THEN'
      
        '11042324=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD = :SKLA' +
        'D_;'
      '11042325=    ELSE'
      
        '11042326=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD IN (SEL' +
        'ECT SKLAD FROM SKLAD WHERE SKLAD_PARENT = :SKLAD_PARENT_);'
      '11042327=  END'
      
        '11042328=  -- '#1055#1056#1048#1041#1040#1042#1051#1070' '#1048#1061' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050', '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1058#1056#1040 +
        #1053#1057#1060#1045#1056' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11042329=  ELSE IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '11042330=    FOR SELECT S.G_PRODUCT,'
      '11042331=               S.AMOUNT'
      '11042332=          FROM SKLAD S'
      '11042333=         WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '11042334=           AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '11042335=          INTO :G_PRODUCT_,'
      '11042336=               :AMOUNT_PRIHOD_'
      '11042337=    DO BEGIN'
      '11042338=      UPDATE LT_SKLAD_PRODUCT L'
      '11042339=         SET L.AMOUNT = L.AMOUNT + :AMOUNT_PRIHOD_'
      '11042340=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11042341=         AND L.G_TOCHKA = :G_TOCHKA_PROVIDER_;'
      '11042342=    END'
      '11042343=  END'
      '11042344='
      '11042345=  PNT_ = '#39#39'03'#39#39';'
      
        '11042346=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054 +
        #1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040 +
        ', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '11042347=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050' ' +
        #1055#1056#1048#1052#1045#1056#1059' '#1058#1045#1057#1058#1054' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1052#1059#1050#1048' (5 '#1064#1058') '#1048' '#1057#1040#1061#1040#1056#1040' (4 '#1064#1058'), '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042 +
        #1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1045#1057#1058#1040' = 4'
      '11042348=  /*FOR SELECT K.G_PRODUCT'
      '11042349=        FROM SKLAD ZD,'
      '11042350=             G_PRODUCT_KIT K'
      '11042351=       WHERE ZD.G_PRODUCT = K.G_PRODUCT_ITEM'
      '11042352=         AND ZD.sklad_parent = :SKLAD_PARENT_'
      '11042353=       GROUP BY K.G_PRODUCT'
      '11042354=       INTO :G_PRODUCT_SOSTAV_'
      '11042355=  DO BEGIN'
      '11042356=    SELECT MIN(L.AMOUNT)'
      '11042357=      FROM G_PRODUCT_KIT K,'
      '11042358=           LT_SKLAD_PRODUCT L'
      '11042359=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '11042360=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '11042361=       AND L.G_TOCHKA = :G_TOCHKA_'
      '11042362=     GROUP BY K.G_PRODUCT'
      '11042363=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11042364='
      '11042365=    UPDATE LT_SKLAD_PRODUCT L'
      '11042366=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '11042367=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_;'
      '11042368=  END*/'
      '11042369='
      '11042370=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '11042371=  PNT_ = '#39#39'04'#39#39';'
      '11042372=  DELETE from SKLAD S'
      '11042373=  WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '11042374=    AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD);'
      '11042375='
      '11042376=when sqlcode -530 DO'
      '11042377=  begin'
      '11042378=    ERR_CODE = -20500;'
      
        '11042379=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11042380=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11042381=  end'
      '11042382=end'
      '11042383='#39';'
      '11042384='
      '11042385=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '11042386=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11042387=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11042388=  MODE_ INTEGER)'
      '11042389=RETURNS ('
      '11042390=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '11042391=AS'
      
        '11042392=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE;'
      '11042393=BEGIN'
      '11042394=  IF (G_TOCHKA_ IS NULL) THEN'
      '11042395=    SELECT ID'
      '11042396=      FROM CUR_PARAMS'
      '11042397=     WHERE CUR_PARAMS = 2'
      '11042398=      INTO :G_TOCHKA_;'
      '11042399='
      '11042400=  if (COALESCE(MODE_, 0) = 0) then'
      '11042401=      SELECT S.PRICE'
      '11042402=        FROM SKLAD S'
      '11042403=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '11042404=         AND S.IS_LAST = 1'
      '11042405=         AND S.G_PRODUCT = :G_PRODUCT_'
      '11042406=        INTO :PRICE_;'
      '11042407='
      
        '11042408=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047#1040 +
        #1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '11042409=  ELSE BEGIN'
      '11042410=    SELECT S.S_VALUE'
      '11042411=      FROM SYSTEM_SETUP S'
      '11042412=     WHERE S.SYSTEM_SETUP = 1'
      '11042413=      INTO :FORMULA_;'
      '11042414='
      '11042415=    IF (FORMULA_ = 1) THEN BEGIN'
      '11042416=      SELECT S.PRICE'
      '11042417=        FROM SKLAD S'
      '11042418=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '11042419=         AND S.IS_LAST = 1'
      '11042420=         AND S.G_PRODUCT = :G_PRODUCT_'
      '11042421=        INTO :PRICE_;'
      '11042422='
      
        '11042423=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045#1058 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048 +
        '" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '11042424=      IF (ROW_COUNT = 0) THEN'
      '11042425=        SELECT S.PRICE'
      '11042426=          FROM SKLAD S'
      '11042427=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '11042428=                            FROM SKLAD SS'
      
        '11042429=                           WHERE /*SS.G_TOCHKA = :G_TOC' +
        'HKA_'
      
        '11042430=                             AND */SS.G_PRODUCT = :G_PR' +
        'ODUCT_'
      
        '11042431=                             AND SS.DATE_RECEIPT = (SEL' +
        'ECT MAX(SSS.DATE_RECEIPT)'
      
        '11042432=                                                      F' +
        'ROM SKLAD SSS'
      
        '11042433=                                                     WH' +
        'ERE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '11042434=                                                       ' +
        'AND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '11042435=                                                       ' +
        'AND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '11042436=                                                   )'
      
        '11042437=                             AND SS.IS_VOZVRAT IN (0, 4' +
        ') --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '11042438=                         )'
      '11042439=          INTO :PRICE_;'
      '11042440=    END ELSE'
      
        '11042441=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT' +
        '), 2)'
      '11042442=        FROM (SELECT S.AMOUNT, S.PRICE'
      '11042443=                FROM SKLAD_PARENT SP,'
      '11042444=                     SKLAD S'
      '11042445=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '11042446=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '11042447=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '11042448=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '11042449=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.I' +
        'S_VOZVRAT IN (0, 3, 4)'
      
        '11042450=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO ' +
        '5) T'
      '11042451=        INTO :PRICE_;'
      '11042452=  END'
      '11042453='
      '11042454=  PRICE_ = COALESCE(:PRICE_, 0);'
      '11042455=  SUSPEND;'
      '11042456=END'
      '11042457='#39';'
      '11042458='
      '11042459=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ('
      '11042460=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11042461=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11042462=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11042463=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11042464=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11042465=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11042466=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11042467=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11042468=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11042469=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11042470=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11042471=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11042472=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11042473=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '11042474=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11042475=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11042476=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11042477=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11042478=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11042479=  IS_MEBEL_ INTEGER = 0,'
      
        '11042480=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NULL' +
        ','
      
        '11042481=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE ' +
        '= NULL,'
      '11042482=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '11042483=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL)'
      '11042484=RETURNS ('
      '11042485=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11042486=  ERR_CODE INTEGER,'
      '11042487=  ERR_MSG VARCHAR(1024))'
      '11042488=AS'
      '11042489=/*'
      '11042490=IS_SPISANIE_'
      '11042491=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11042492=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11042493=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11042494=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11042495=*/'
      '11042496=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'INS_ZAKAZ'#39#39';'
      '11042497=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11042498=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11042499=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '11042500=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '11042501=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '11042502=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ';'
      
        '11042503=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      
        '11042504=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '11042505=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM;'
      '11042506=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11042507=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS_SUMM;'
      
        '11042508=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      
        '11042509=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11042510=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '11042511=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKA' +
        'Z_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      
        '11042512=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11042513=DECLARE VARIABLE CNT_ INTEGER;'
      '11042514=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11042515=DECLARE VARIABLE DATE_LAST_ DATE;'
      '11042516=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '11042517=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11042518=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11042519=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11042520=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11042521=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11042522=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11042523=BEGIN'
      '11042524='
      
        '11042525=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057#1048 +
        #1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055#1054 +
        #1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '11042526=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '11042527=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '11042528=  IF (CNT_ = 0) THEN BEGIN'
      '11042529=    ERR_CODE = -20500;'
      
        '11042530=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '11042531=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ 00 '#39#39'||ERR_MSG;'
      '11042532=    EXIT;'
      '11042533=  END'
      '11042534='
      '11042535=  IF (G_TOCHKA_ IS NULL) THEN'
      '11042536=    SELECT ID'
      '11042537=      FROM CUR_PARAMS'
      '11042538=     WHERE CUR_PARAMS = 2'
      '11042539=      INTO :G_TOCHKA_;'
      '11042540='
      '11042541=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11042542=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '11042543=      PNT_ = '#39#39'01'#39#39';'
      
        '11042544=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11042545=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11042546=      ELSE'
      '11042547=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11042548='
      '11042549=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11042550=      SELECT ID'
      '11042551=        FROM CUR_PARAMS'
      '11042552=       WHERE CUR_PARAMS = 1'
      '11042553=        INTO :G_OFFICIAL_;'
      '11042554='
      '11042555=      INSERT INTO ZAKAZ'
      '11042556=      ('
      '11042557=       ZAKAZ,'
      '11042558=       G_TOCHKA,'
      '11042559=       Z_DATE,'
      '11042560=       Z_TIME,'
      '11042561=       G_CLIENT,'
      '11042562=       G_PAYMENT_TYPE,'
      '11042563=       OSNOVANIE,'
      '11042564=       IS_SPISANIE,'
      '11042565=       NOTE,'
      '11042566=       SUMM,'
      '11042567=       SUMM_FACT,'
      '11042568=       SUMM_BONUS,'
      '11042569=       IS_PAYED_ALL'
      '11042570=       ,G_OFFICIAL'
      '11042571=       ,BY_RECIPE'
      '11042572=       ,SUMM_BONUS_GOT'
      '11042573=       ,IS_RESERVE'
      '11042574=       ,SUMM_CASH'
      '11042575=       ,SUMM_NONCASH'
      '11042576=      ) VALUES ('
      '11042577=       GEN_ID(GEN_ZAKAZ, 1),'
      '11042578=       :G_TOCHKA_,'
      '11042579=       :Z_DATE_,'
      '11042580=       :Z_TIME_,'
      '11042581=       :G_CLIENT_,'
      '11042582=       :G_PAYMENT_TYPE_,'
      '11042583=       :OSNOVANIE_,'
      '11042584=       :IS_SPISANIE_,'
      '11042585=       :NOTE_,'
      '11042586=       :SUMM_,'
      '11042587=       :SUMM_FACT_1_,'
      '11042588=       COALESCE(:SUMM_BONUS_, 0),'
      
        '11042589=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_B' +
        'ONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052 +
        #1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11042590=       ,:G_OFFICIAL_'
      '11042591=       ,:BY_RECIPE_'
      '11042592=       ,:SUMM_BONUS_GOT_'
      '11042593=       ,:IS_RESERVE_'
      '11042594=       ,COALESCE(:SUMM_CASH_, 0)'
      '11042595=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '11042596=      )'
      '11042597=      RETURNING'
      '11042598=        ZAKAZ'
      '11042599=      INTO'
      '11042600=        :ZAKAZ_;'
      '11042601='
      '11042602=      PNT_ = '#39#39'02'#39#39';'
      
        '11042603=      FOR SELECT ZAKAZ_DETAILS, G_PRODUCT, AMOUNT, PRIC' +
        'E, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_' +
        'SUMM, COST_PRICE'
      '11042604=            FROM ZAKAZ_DETAILS_TMP Z'
      '11042605=          INTO :ZAKAZ_DETAILS_TMP_,'
      '11042606=              :G_PRODUCT,'
      '11042607=              :AMOUNT,'
      '11042608=              :PRICE,'
      '11042609=              :SUMM,'
      '11042610=              :DISCOUNT_PERC,'
      '11042611=              :DISCOUNT_TENGE,'
      '11042612=              :DISCOUNT_SUMM,'
      '11042613=              :NDS,'
      '11042614=              :NDS_SUMM,'
      '11042615=              :COST_PRICE'
      '11042616=      DO BEGIN'
      '11042617=        INSERT INTO ZAKAZ_DETAILS'
      '11042618=        VALUES('
      '11042619=          :ZAKAZ_DETAILS_TMP_,'
      '11042620=          :ZAKAZ_,'
      '11042621=          :G_PRODUCT,'
      '11042622=          :AMOUNT,'
      '11042623=          :PRICE,'
      '11042624=          :SUMM,'
      '11042625=          :DISCOUNT_PERC,'
      '11042626=          :DISCOUNT_TENGE,'
      '11042627=          :DISCOUNT_SUMM,'
      '11042628=          :NDS,'
      '11042629=          :NDS_SUMM,'
      '11042630=          :COST_PRICE'
      '11042631=        );'
      '11042632='
      '11042633=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11042634=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '11042635=            UPDATE LT_SKLAD_PRODUCT L'
      '11042636=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11042637=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11042638=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11042639='
      '11042640=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '11042641=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11042642=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '11042643=            PNT_ = '#39#39'04'#39#39';'
      
        '11042644=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11042645=              Err_Code = -20500;'
      
        '11042646=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PROD' +
        'UCT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' ' +
        #1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11042647=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||' +
        #39#39' '#39#39'||ERR_MSG;'
      '11042648=              EXIT;'
      '11042649=            END ELSE if (ROW_COUNT = 0) then'
      
        '11042650=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11042651=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11042652=        END'
      '11042653='
      '11042654=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '11042655=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '11042656=            UPDATE LT_SKLAD_PRODUCT L'
      
        '11042657=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE ' +
        '+ :AMOUNT'
      '11042658=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11042659=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11042660=      END'
      '11042661='
      '11042662=      ----------------------------------------'
      
        '11042663=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053 +
        #1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '11042664=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '11042665=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '11042666='
      
        '11042667=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '11042668=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '11042669=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '11042670=                PNT_ = '#39#39'05'#39#39';'
      
        '11042671=                EXECUTE PROCEDURE K_INS_KASSA(0,     --' +
        ' ACTION_ => :ACTION_'
      
        '11042672=                                              1,     --' +
        ' G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '11042673=                                              :SUMM_FAC' +
        'T_1_,'
      '11042674=                                              :Z_DATE_,'
      
        '11042675=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11042676=                                              ZAKAZ_,  ' +
