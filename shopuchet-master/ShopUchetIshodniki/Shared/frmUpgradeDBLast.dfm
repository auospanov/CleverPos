      '11096666=               SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '11096667=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096668=               AND L.G_TOCHKA = :G_CLIENT_;'
      '11096669='
      '11096670=            IF (ROW_COUNT = 0) THEN'
      
        '11096671=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_' +
        'PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '11096672=          END'
      '11096673=      END'
      '11096674=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '11096675=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '11096676=      ELSE BEGIN'
      
        '11096677=          ---------------------------------------------' +
        '----------------'
      
        '11096678=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' ' +
        #1055#1056#1048#1061#1054#1044#1040
      '11096679=          PNT_ = '#39'025'#39';'
      '11096680=          FOR SELECT SKLAD,'
      '11096681=                     AMOUNT,'
      '11096682=                     G_PRODUCT'
      '11096683=                FROM SKLAD S'
      '11096684=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '11096685=                 AND NOT EXISTS (SELECT 1'
      
        '11096686=                                   FROM ZAKAZ_DETAILS_T' +
        'MP T'
      
        '11096687=                                  WHERE T.ZAKAZ_DETAILS' +
        ' = S.SKLAD)'
      '11096688=          INTO :SKLAD_,'
      '11096689=               :Z_AMOUNT_,'
      '11096690=               :G_PRODUCT_'
      '11096691=          DO BEGIN'
      
        '11096692=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11096693=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
