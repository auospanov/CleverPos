      '1106015791=ALTER PROCEDURE G_DEL_G_ACCOUNT('
      '1106015792=  G_ACCOUNT_ TYPE OF COLUMN G_ACCOUNT.G_ACCOUNT)'
      '1106015793=RETURNS ('
      '1106015794=  ERR_CODE INTEGER,'
      '1106015795=  ERR_MSG VARCHAR(1024))'
      '1106015796=AS'
      '1106015797=declare variable PROCNAME varchar(30);'
      '1106015798=begin'
      '1106015799=  PROCNAME = '#39'G_DEL_G_ACCOUNT'#39';'
