      '1102271512=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1102271513=  END'
      '1102271514=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1102271515=  --*************************************************' +
        '****************************************'
      '1102271516='
      
        '1102271517=  --*************************************************' +
        '****************************************'
      '1102271518=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102271519=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1102271520=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1102271521=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1102271522='
      
        '1102271523=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1102271524=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1102271525=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1102271526=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      
        '1102271527=  --*************************************************' +
        '****************************************'
      '1102271528=  IS_FIRST_  = 1;'
      '1102271529=  SUM_ZAKAZ_ = 0;'
      '1102271530=  PROFIT_    = 0;'
      '1102271531=  FOR SELECT SUM(S.SUMM)'
      '1102271532=             ,TR.PATH'
      '1102271533=     FROM SKLAD_PARENT SP,'
      '1102271534=          SKLAD S,'
      '1102271535=          G_PRODUCT G,'
      '1102271536=          P_REP_TREE TR'
      
        '1102271537=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA|' +
        '|'#39'-'#39
      
        '1102271538=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102271539=      AND SP.IS_VOZVRAT IN (1,2)'
      '1102271540=      and G.g_product_PAR = TR.g_product'
      
        '1102271541=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(S.G_CLIENT, 0))'
      
        '1102271542=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYP' +
        'E_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1102271543=      AND SP.SKLAD = S.SKLAD_PARENT'
      '1102271544=      AND S.G_PRODUCT = G.G_PRODUCT'
      '1102271545=      AND ((EXISTS (SELECT 1'
      '1102271546=                       FROM SKLAD SS'
      
        '1102271547=                      WHERE SS.G_CLIENT = :G_SUPPLIER' +
        '_'
      
        '1102271548=                        AND SS.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '1102271549=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102271550=              OR'
      '1102271551=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102271552=     GROUP BY TR.PATH'
      '1102271553=     ORDER BY TR.PATH'
      '1102271554=     INTO :V_SUMM_,'
      '1102271555=          :REC_TOVAR_NAME_'
      '1102271556=  DO BEGIN'
      '1102271557=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1102271558=      insert into p_rep_profit_table'
      '1102271559=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102271560=      values'
      
        '1102271561=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040#39', 1);'
      '1102271562='
      '1102271563=      IS_FIRST_ = 0;'
      '1102271564=    END'
      '1102271565='
      
        '1102271566=    REC_profit_   = 0 - V_SUMM_;    -- 26.05.2016 '#1055#1054#1057 +
        #1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050 +
        #1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1102271567=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102271568=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1102271569=    VALUES'
      
        '1102271570=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :V_SUMM_, :REC_profit_, 0);'
      '1102271571='
      '1102271572=    SUM_COST_ = 0;'
      '1102271573=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '1102271574=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '1102271575=  END'
      '1102271576='
      '1102271577=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1102271578=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1102271579=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1102271580='
      '1102271581=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102271582=    insert into p_rep_profit_table'
      
        '1102271583=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102271584=    values'
      
        '1102271585=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '1102271586=  END'
      '1102271587=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1102271588=  --*************************************************' +
        '****************************************'
      '1102271589='
      
        '1102271590=  --*************************************************' +
        '****************************************'
      
        '1102271591=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102271592=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102271593=  --*************************************************' +
        '****************************************'
      '1102271594=  IS_FIRST_  = 1;'
      '1102271595=  SUM_ZAKAZ_ = 0;'
      '1102271596=  SUM_COST_  = 0;'
      '1102271597=  PROFIT_    = 0;'
      '1102271598=  NDS_SUMM_  = 0;'
      '1102271599=  FOR SELECT SUM(ZD.SUMM)'
      '1102271600=           ,TR.PATH'
      '1102271601=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1102271602=           ,SUM(ZD.nds_summ)'
      '1102271603=      FROM ZAKAZ Z,'
      '1102271604=           ZAKAZ_DETAILS ZD,'
      '1102271605=           G_PRODUCT GP,'
      '1102271606=           P_REP_TREE TR'
      
        '1102271607=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102271608=       AND Z.IS_SPISANIE = 2'
      '1102271609=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102271610=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102271611=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102271612=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102271613=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102271614=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271615=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058 +
        #1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271616=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102271617=       AND ((EXISTS (SELECT 1'
      '1102271618=                       FROM SKLAD S'
      '1102271619=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1102271620=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1102271621=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102271622=              OR'
      '1102271623=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102271624=     GROUP BY TR.PATH'
      '1102271625=     ORDER BY TR.PATH'
      
        '1102271626=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST' +
        '_, REC_NDS_SUMM_'
      '1102271627=  DO BEGIN'
      '1102271628=    IF (IS_FIRST_ = 1) then BEGIN'
      '1102271629=      insert into p_rep_profit_table'
      '1102271630=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102271631=      values'
      
        '1102271632=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1102271633='
      '1102271634=      IS_FIRST_ = 0;'
      '1102271635=    END'
      '1102271636='
      
        '1102271637=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS' +
        '_SUMM_;'
      '1102271638='
      '1102271639=    insert into p_rep_profit_table'
      
        '1102271640=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1102271641=    values'
      '1102271642=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1102271643=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_,' +
        ' :REC_SUM_COST_, :REC_PROFIT_, 0);'
      '1102271644='
      '1102271645=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '1102271646=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '1102271647=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '1102271648=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '1102271649=  END'
      '1102271650='
      '1102271651=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1102271652=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1102271653=    insert into p_rep_profit_table'
      
        '1102271654=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102271655=    values'
      
        '1102271656=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFI' +
        'T_, 2);'
      '1102271657='
      '1102271658=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1102271659=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1102271660=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1102271661=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '1102271662=  END'
      '1102271663=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102271664=  --*************************************************' +
        '****************************************'
      '1102271665=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1102271666=  insert into p_rep_profit_table'
      '1102271667=    (p_rep_profit_table, is_head)'
      '1102271668=  values'
      '1102271669=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1102271670='
      '1102271671=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1102271672=  insert into p_rep_profit_table'
      
        '1102271673=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102271674=  values'
      
        '1102271675=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1102271676='
      '1102271677=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1102271678=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1102271679=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1102271680=         SUM(Z.SUMM_BONUS)'
      '1102271681=    FROM ZAKAZ Z'
      
        '1102271682=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1102271683=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1102271684=     AND Z.IS_RESERVE = 0'
      '1102271685=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102271686=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102271687=     AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '1102271688=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102271689=     AND ((EXISTS (SELECT 1'
      '1102271690=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1102271691=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1102271692=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1102271693=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1102271694=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102271695=          OR'
      '1102271696=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102271697=    INTO :SUMM_CASH_ALL_,'
      '1102271698=         :SUMM_NONCASH_ALL_,'
      '1102271699=         :SUMM_BONUS_ALL_;'
      '1102271700='
      '1102271701=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '1102271702=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '1102271703=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1102271704='
      '1102271705=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1102271706='
      
        '1102271707=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1102271708=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1102271709='
      '1102271710=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1102271711=    SELECT G.NAME'
      '1102271712=      FROM G_CLIENT G'
      '1102271713=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102271714=    INTO :CLIENT_NAME_;'
      '1102271715=  ELSE'
      '1102271716=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102271717='
      '1102271718=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1102271719=    SELECT G.NAME'
      '1102271720=      FROM G_PAYMENT_TYPE G'
      '1102271721=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1102271722=    INTO :PAYMENT_NAME_;'
      '1102271723=  ELSE'
      '1102271724=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102271725='
      '1102271726=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1102271727=        P.TOVAR_NAME,'
      
        '1102271728=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1102271729=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102271730=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102271731=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1102271732=        P.IS_HEAD'
      
        '1102271733=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1102271734=    ORDER BY 1'
      '1102271735=  INTO :P_REP_PROFIT_TABLE,'
      '1102271736=       :TOVAR_NAME,'
      '1102271737=       :SUMM,'
      '1102271738=       :NDS_SUMM,'
      '1102271739=       :SUM_SELF,'
      '1102271740=       :PROFIT,'
      '1102271741=       :IS_HEAD'
      '1102271742=  DO'
      '1102271743=    suspend;'
      '1102271744='
      '1102271745=WHEN ANY DO BEGIN'
      '1102271746=    Err_code = -20500;'
      
        '1102271747=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102271748=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102271749=  END'
      '1102271750=end'
      '1102271751=;'
      '1102271752='
      '1102271753='
      
        '1102271754=UPDATE SYSTEM_SETUP SET S_VALUE = 110227 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102271755=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102271756=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102280='
      '1102281=ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '1102282=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102283=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102284=  DATE_BEGIN_ DATE,'
      '1102285=  DATE_END_ DATE,'
      
        '1102286=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      '1102287=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1102288=RETURNS ('
      '1102289=  DATE_BEGIN_OUT_ DATE,'
      '11022810=  DATE_END_OUT_ DATE,'
      '11022811=  STR_ VARCHAR(500),'
      '11022812=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '11022813=  NAME VARCHAR(1000),'
      
        '11022814=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11022815=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11022816=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      '11022817=  AMOUNT_IN /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      
        '11022818=  AMOUNT_PRIHOD /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT */ NUMERIC(18,5),'
      '11022819=  SUMM_PRIHOD NUMERIC(15,2),'
      
        '11022820=  AMOUNT_UHOD /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        ' */ NUMERIC(18,5),'
      '11022821=  SUMM_UHOD NUMERIC(15,2),'
      
        '11022822=  AMOUNT_SPISANO /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT */ NUMERIC(18,5),'
      '11022823=  SUMM_SPISANO NUMERIC(15,2),'
      
        '11022824=  AMOUNT_VOZVRAT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT */ NUMERIC(18,5),'
      '11022825=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '11022826=  AMOUNT_PRIHOD_SKL /* TYPE OF COLUMN LT_SKLAD_PRODUCT.' +
        'AMOUNT */ NUMERIC(18,5),'
      '11022827=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '11022828=  AMOUNT_UHOD_SKL /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT */ NUMERIC(18,5),'
      '11022829=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '11022830=  AMOUNT_OUT /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      '11022831=  IS_HEAD INTEGER,'
      '11022832=  ERR_CODE INTEGER,'
      '11022833=  ERR_MSG VARCHAR(1024))'
      '11022834=AS'
      '11022835=BEGIN'
      '11022836=  SUSPEND;'
      '11022837=END'
      '11022838=;'
