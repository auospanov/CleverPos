        'OD_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '1101322370='
      
        '1101322371=    STR_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1101322372=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1101322373='
      '1101322374=  FOR'
      '1101322375=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '1101322376=           DECODE(T.IS_HEAD,'
      '1101322377=                  0, T.NAME,'
      '1101322378=                  1, T.NAME,'
      '1101322379=                  2, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39','
      '1101322380=                  3, '#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39'),'
      '1101322381=           G.ARTICUL,'
      '1101322382=           G.BARCODE,'
      '1101322383=           G.PRICE,'
      '1101322384=           T.AMOUNT_IN,'
      '1101322385=           T.AMOUNT_PRIHOD,'
      '1101322386=           T.SUMM_PRIHOD,'
      '1101322387=           T.AMOUNT_UHOD,'
      '1101322388=           T.SUMM_UHOD,'
      '1101322389=           T.AMOUNT_SPISANO,'
      '1101322390=           T.SUMM_SPISANO,'
      '1101322391=           T.AMOUNT_VOZVRAT,'
      '1101322392=           T.SUMM_VOZVRAT,'
      '1101322393=           T.AMOUNT_PRIHOD_SKL,'
      '1101322394=           T.SUMM_PRIHOD_SKL,'
      '1101322395=           T.AMOUNT_UHOD_SKL,'
      '1101322396=           T.SUMM_UHOD_SKL,'
      '1101322397=           T.AMOUNT_OUT,'
      '1101322398=           T.IS_HEAD'
      
        '1101322399=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1101322400=     ORDER BY 1'
      '1101322401=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1101322402=       :NAME,'
      '1101322403=       :ARTICUL,'
      '1101322404=       :BARCODE,'
      '1101322405=       :PRICE,'
      '1101322406=       :AMOUNT_IN,'
      '1101322407=       :AMOUNT_PRIHOD,'
      '1101322408=       :SUMM_PRIHOD,'
      '1101322409=       :AMOUNT_UHOD,'
      '1101322410=       :SUMM_UHOD,'
      '1101322411=       :AMOUNT_SPISANO,'
      '1101322412=       :SUMM_SPISANO,'
      '1101322413=       :AMOUNT_VOZVRAT,'
      '1101322414=       :SUMM_VOZVRAT,'
      '1101322415=       :AMOUNT_PRIHOD_SKL,'
      '1101322416=       :SUMM_PRIHOD_SKL,'
      '1101322417=       :AMOUNT_UHOD_SKL,'
      '1101322418=       :SUMM_UHOD_SKL,'
      '1101322419=       :AMOUNT_OUT,'
      '1101322420=       :IS_HEAD'
      '1101322421=  DO SUSPEND;'
      '1101322422='
      '1101322423=WHEN ANY DO BEGIN'
      '1101322424=    Err_code = -20500;'
      
        '1101322425=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101322426=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101322427=  END'
      '1101322428=end'
      '1101322429=;'
      '1101322430='
      '1101322431=ALTER PROCEDURE UPD_SKLAD('
      '1101322432=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101322433=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1101322434=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1101322435=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1101322436=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1101322437=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101322438=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101322439=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101322440=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1101322441=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101322442=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101322443=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1101322444=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1101322445=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1101322446=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101322447=RETURNS ('
      '1101322448=  ERR_CODE INTEGER,'
      '1101322449=  ERR_MSG VARCHAR(1024))'
      '1101322450=AS'
      
        '1101322451=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1101322452=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1101322453=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101322454=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101322455=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1101322456=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101322457=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101322458=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1101322459=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1101322460=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1101322461=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101322462=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1101322463=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101322464=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1101322465=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101322466=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1101322467=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1101322468=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101322469=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1101322470=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101322471=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101322472=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101322473=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101322474=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101322475=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101322476=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101322477=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101322478=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101322479=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101322480=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101322481=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1101322482=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1101322483=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1101322484=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      '1101322485=BEGIN'
      '1101322486='
      '1101322487=  IS_THIS_LAST_ = 0;'
      '1101322488='
      '1101322489=  SELECT S.G_TOCHKA,'
      '1101322490=         S.IS_VOZVRAT,'
      '1101322491=         S.G_PAYMENT_TYPE'
      '1101322492=         ,S.is_expected'
      '1101322493=    FROM SKLAD_parent S'
      '1101322494=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1101322495=    INTO :G_TOCHKA_,'
      '1101322496=         :IS_VOZVRAT_,'
      '1101322497=         :G_PAYMENT_TYPE_OLD_'
      '1101322498=         ,:IS_EXPECTED_OLD_;'
      '1101322499='
      '1101322500=  PNT_ = '#39'00'#39';'
      '1101322501=  UPDATE SKLAD_PARENT'
      '1101322502=  SET'
      
        '1101322503=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1101322504=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1101322505=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1101322506=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1101322507=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101322508=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101322509=   SUMM      = :SUMM_,'
      '1101322510=   SUMM_FACT = :SUMM_FACT_,'
      '1101322511=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1101322512=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0) ' +
        ' -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054 +
        ' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101322513=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '1101322514=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1101322515='
      
        '1101322516=  ---------------------------------------------------' +
        '----------'
      
        '1101322517=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1101322518=  PNT_ = '#39'02'#39';'
      '1101322519=  FOR SELECT SKLAD'
      '1101322520=        FROM SKLAD S'
      '1101322521=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101322522=         AND NOT EXISTS (SELECT 1'
      '1101322523=                           FROM SKLAD_TMP T'
      '1101322524=                        WHERE T.SKLAD = S.SKLAD)'
      '1101322525=  INTO :SKLAD_'
      '1101322526=  DO BEGIN'
      
        '1101322527=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101322528=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322529=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101322530=      EXIT;'
      '1101322531=    END'
      '1101322532=  END'
      '1101322533='
      
        '1101322534=  ---------------------------------------------------' +
        '----------'
      
        '1101322535=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1101322536=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1101322537=  PNT_ = '#39'03'#39';'
      '1101322538=  FOR SELECT S.SKLAD,'
      '1101322539=             S.G_PRODUCT,'
      '1101322540=             S.AMOUNT,'
      '1101322541=             S.PRICE,'
      '1101322542=             S.SUMM,'
      '1101322543=             S.NDS,'
      '1101322544=             S.NDS_SUMM,'
      '1101322545=             T.SKLAD,'
      '1101322546=             T.AMOUNT,'
      '1101322547=             T.IS_LAST,'
      '1101322548=             T.DATE_RECEIPT'
      '1101322549=             ,S.PRICE_CURRENCY'
      '1101322550=             ,S.SUMM_CURRENCY'
      '1101322551=             ,S.PRICE_ROZN'
      
        '1101322552=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1101322553=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1101322554=  INTO :SKLAD_,'
      '1101322555=       :G_PRODUCT_,'
      '1101322556=       :AMOUNT_,'
      '1101322557=       :PRICE_,'
      '1101322558=       :SUMM_ONE_,'
      '1101322559=       :NDS_,'
      '1101322560=       :NDS_SUMM_,'
      '1101322561=       :SKLAD_OLD_,'
      '1101322562=       :AMOUNT_OLD_,'
      '1101322563=       :IS_THIS_LAST_,'
      '1101322564=       :DATE_RECEIPT_OLD_'
      '1101322565=       ,:PRICE_CURRENCY_'
      '1101322566=       ,:SUMM_CURRENCY_TMP_'
      '1101322567=       ,:SALE_PRICE_'
      '1101322568=       ,:SALE_PRICE_CUR_'
      '1101322569=  DO BEGIN'
      
        '1101322570=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101322571=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1101322572=        PNT_ = '#39'04'#39';'
      
        '1101322573=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1101322574=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1101322575=                          ,PRICE_CURRENCY'
      '1101322576=                          ,SUMM_CURRENCY)'
      
        '1101322577=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1101322578=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101322579=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1101322580=               ,:PRICE_CURRENCY_'
      '1101322581=               ,:SUMM_CURRENCY_TMP_'
      '1101322582=               );'
      '1101322583='
      
        '1101322584=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1101322585=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1101322586=            UPDATE LT_SKLAD_PRODUCT L'
      '1101322587=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101322588=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101322589=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101322590='
      '1101322591=            IF (ROW_COUNT = 0) THEN'
      
        '1101322592=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_);'
      '1101322593=        END'
      '1101322594='
      
        '1101322595=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101322596=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1101322597=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1101322598=        PNT_ = '#39'05'#39';'
      '1101322599=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1101322600=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101322601=              FROM SKLAD SK'
      '1101322602=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101322603=               AND SK.IS_LAST = 1'
      '1101322604=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101322605=              INTO :DATE_LAST_;'
      '1101322606='
      
        '1101322607=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101322608=              UPDATE SKLAD SK'
      '1101322609=                 SET SK.IS_LAST = 0'
      '1101322610=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101322611=                 AND SK.IS_LAST = 1'
      '1101322612=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101322613='
      '1101322614=              UPDATE SKLAD SK'
      '1101322615=                 SET SK.IS_LAST = 1'
      '1101322616=               WHERE SK.SKLAD = :SKLAD_;'
      '1101322617=            END'
      '1101322618=        END'
      
        '1101322619=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101322620=    END ELSE BEGIN'
      '1101322621=        PNT_ = '#39'06'#39';'
      '1101322622=        UPDATE SKLAD S'
      '1101322623=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1101322624=               S.G_CLIENT = :G_CLIENT_,'
      '1101322625=               S.AMOUNT   = :AMOUNT_,'
      '1101322626=               S.PRICE    = :PRICE_,'
      '1101322627=               S.SUMM     = :SUMM_ONE_,'
      '1101322628=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101322629=               S.NDS      = :NDS_,'
      '1101322630=               S.NDS_SUMM = :NDS_SUMM_,'
      '1101322631=               S.OSNOVANIE = :OSNOVANIE_,'
      '1101322632=               S.NOTE      = :NOTE_'
      '1101322633=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1101322634=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1101322635=         WHERE S.SKLAD = :SKLAD_;'
      '1101322636='
      '1101322637=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1101322638=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_ AND IS_EX' +
        'PECTED_ = 0) THEN BEGIN'
      '1101322639=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1101322640=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1101322641=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_)'
      '1101322642=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101322643=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101322644='
      '1101322645=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1101322646=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1101322647=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_)'
      '1101322648=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101322649=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101322650=        END'
      
        '1101322651=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1101322652=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1101322653=            UPDATE LT_SKLAD_PRODUCT L'
      '1101322654=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101322655=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101322656=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101322657='
      '1101322658=            IF (ROW_COUNT = 0) THEN'
      
        '1101322659=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_);'
      '1101322660=        END'
      
        '1101322661=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1101322662=        ELSE IF (IS_EXPECTED_OLD_ = 0 AND IS_EXPECTED' +
        '_ = 1) THEN BEGIN'
      '1101322663=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1101322664=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_'
      '1101322665=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101322666=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101322667=        END'
      '1101322668='
      
        '1101322669=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1101322670=        PNT_ = '#39'07'#39';'
      
        '1101322671=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1101322672=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101322673=              FROM SKLAD SK'
      '1101322674=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101322675=               AND SK.IS_LAST = 1'
      '1101322676=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101322677=              INTO :DATE_LAST_;'
      '1101322678='
      
        '1101322679=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101322680=              UPDATE SKLAD SK'
      '1101322681=                 SET SK.IS_LAST = 0'
      '1101322682=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101322683=                 AND SK.IS_LAST = 1'
      '1101322684=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101322685='
      '1101322686=              UPDATE SKLAD SK'
      '1101322687=                 SET SK.IS_LAST = 1'
      '1101322688=               WHERE SK.SKLAD = :SKLAD_;'
      '1101322689=            END'
      '1101322690=        END'
      '1101322691='
      
        '1101322692=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1101322693=        PNT_ = '#39'08'#39';'
      
        '1101322694=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1101322695=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101322696=              FROM SKLAD SK'
      '1101322697=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101322698=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1101322699=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101322700=               AND SK.is_vozvrat IN (0,4)'
      '1101322701=              INTO :DATE_LAST_;'
      '1101322702='
      
        '1101322703=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101322704=              UPDATE SKLAD SK'
      '1101322705=                 SET SK.IS_LAST = 0'
      '1101322706=               WHERE SK.SKLAD = :SKLAD_;'
      '1101322707='
      '1101322708=               UPDATE SKLAD SK'
      '1101322709=                 SET SK.IS_LAST = 1'
      '1101322710=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101322711=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1101322712=                                   FROM SKLAD SS'
      
        '1101322713=                                  WHERE SS.G_PRODUCT ' +
