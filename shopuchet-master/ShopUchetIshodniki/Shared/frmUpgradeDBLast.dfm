      '1101322723=                 SET SK.IS_LAST = 1'
      '1101322724=               WHERE SK.SKLAD = :SKLAD_;'
      '1101322725=            END'
      '1101322726=        END'
      '1101322727=    END'
      '1101322728='
      
        '1101322729=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '1101322730=      UPDATE G_PRODUCT G'
      '1101322731=         SET G.PRICE = :SALE_PRICE_'
