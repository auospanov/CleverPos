      '1102283497=                       S.NOTE      = :NOTE_'
      '1102283498=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1102283499='
      
        '1102283500=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102283501=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102283502=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102283503=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_),'
      
        '1102283504=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102283505=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102283506=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1102283507=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1102283508=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102283509=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_),'
      
        '1102283510=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102283511=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102283512=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102283513='
      
        '1102283514=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1102283515=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102283516=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102283517=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102283518=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_),'
      
        '1102283519=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1102283520=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1102283521=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1102283522='
      
        '1102283523=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1102283524=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102283525=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_),'
      
        '1102283526=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
