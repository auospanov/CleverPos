      '110606366='
      '110606367=ALTER PROCEDURE G_GET_G_CLIENT('
      '110606368=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '110606369=RETURNS ('
      
        '110606370=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      
        '110606371=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT,'
      '110606372=  NAME_ VARCHAR(500),'
      '110606373=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110606374=  IDN_ VARCHAR(12),'
      '110606375=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
