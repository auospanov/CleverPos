      '1102251817=        SELECT 2 ROW,'
      
        '1102251818=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1085#1072#1082#1083#1072#1076#1085#1091#1102' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090 +
        ' '#39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT' +
        '(MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DAT' +
        'E) STR,'
      '1102251819=               K.ZAKAZ ID,'
      '1102251820=               K.ACTION_DATE OPER_DATE,'
      '1102251821=               NULL SUMM_DEBET,'
      '1102251822=               K.SUMM SUMM_CREDIT,'
      '1102251823=               K.ACTION_DATE SORT_ROW'
      
        '1102251824=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA, G_PRIHOD_RASHOD'
      '1102251825=                  from KASSA'
      
        '1102251826=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39
      '1102251827=                union all'
      
        '1102251828=                select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA_BEZNAL KASSA, G_PRIHOD_RASHOD'
      '1102251829=                  from kassa_beznal'
      
        '1102251830=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
