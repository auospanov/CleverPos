        '110533848=                        where zd.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110533849=                        and zd.zakaz = z.zakaz and z.z' +
        '_date > :DATE_END_)'
      '110533850=                       +'
      
        '110533851=                       (select COALESCE(sum(s.amount),' +
