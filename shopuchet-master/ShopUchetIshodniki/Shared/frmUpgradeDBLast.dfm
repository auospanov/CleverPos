        '||'#39#39' - (C.DEBET + '#39#39'||NEW.DEBET||'#39#39' - '#39#39'||OLD.DEBET||'#39#39') + (C.CR' +
        'EDIT + '#39#39'||NEW.CREDIT||'#39#39' - '#39#39'||OLD.CREDIT||'#39#39') '#39'||'
      
        '110751698=                           '#39'WHERE C.K_DATE = '#39#39#39#39#39#39'||N' +
