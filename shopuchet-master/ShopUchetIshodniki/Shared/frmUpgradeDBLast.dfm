        'HOD_;'
      
        '1102291582=      AMOUNT_UHOD_    = AMOUNT_UHOD_   + REC_AMOUNT_U' +
        'HOD_;'
      
        '1102291583=      SUMM_UHOD_      = SUMM_UHOD_     + REC_SUMM_UHO' +
        'D_;'
      
        '1102291584=      AMOUNT_SPISANO_ = AMOUNT_SPISANO_  + REC_AMOUNT' +
        '_SPISANO_;'
      
        '1102291585=      SUMM_SPISANO_   = SUMM_SPISANO_    + REC_SUMM_S' +
        'PISANO_;'
      
        '1102291586=      AMOUNT_VOZVRAT_ = AMOUNT_VOZVRAT_  + REC_AMOUNT' +
        '_VOZVRAT_;'
      
        '1102291587=      SUMM_VOZVRAT_      = SUMM_VOZVRAT_    + REC_SUM' +
        'M_VOZVRAT_;'
      
        '1102291588=      AMOUNT_PRIHOD_SKL_ = AMOUNT_PRIHOD_SKL_ + REC_A' +
        'MOUNT_PRIHOD_SKL_;'
      
        '1102291589=      SUMM_PRIHOD_SKL_   = SUMM_PRIHOD_SKL_ + REC_SUM' +
        'M_PRIHOD_SKL_;'
      
        '1102291590=      AMOUNT_UHOD_SKL_   = AMOUNT_UHOD_SKL_ + REC_AMO' +
        'UNT_UHOD_SKL_;'
      
        '1102291591=      SUMM_UHOD_SKL_     = SUMM_UHOD_SKL_ + REC_SUMM_' +
        'UHOD_SKL_;'
      '1102291592='
      '1102291593=      PATH_OLD_ = PATH_;'
      '1102291594=    END'
      '1102291595='
      '1102291596=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102291597=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1102291598=      (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIH' +
        'OD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SP' +
        'ISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '1102291599=       AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHO' +
        'D_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1102291600=    VALUES'
      
        '1102291601=      (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :' +
        'AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_, :AMOU' +
        'NT_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVRAT_,'
      
        '1102291602=       :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :AMOUN' +
        'T_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '1102291603='
      '1102291604=    -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '1102291605=    AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + AMOUNT_' +
        'PRIHOD_;'
      
        '1102291606=    SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUMM_PRIH' +
        'OD_;'
      
        '1102291607=    AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMOUNT_UH' +
        'OD_;'
      '1102291608=    SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_UHOD_;'
      
        '1102291609=    AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ + AMOUN' +
        'T_SPISANO_;'
      
        '1102291610=    SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + SUMM_SP' +
        'ISANO_;'
      
        '1102291611=    AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ + AMOUN' +
        'T_VOZVRAT_;'
      
        '1102291612=    SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + SUMM_VO' +
        'ZVRAT_;'
      
        '1102291613=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ +' +
        ' AMOUNT_PRIHOD_SKL_;'
      
        '1102291614=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + S' +
        'UMM_PRIHOD_SKL_;'
      
        '1102291615=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + A' +
        'MOUNT_UHOD_SKL_;'
      
        '1102291616=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUM' +
        'M_UHOD_SKL_;'
      '1102291617='
      '1102291618=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '1102291619=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1102291620=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHO' +
        'D_SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1102291621=    VALUES'
      
        '1102291622=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AM' +
        'OUNT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UH' +
        'OD_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVR' +
        'AT_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIH' +
        'OD_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '1102291623='
      
        '1102291624=    STR_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102291625=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102291626='
      '1102291627=  FOR'
      '1102291628=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '1102291629=           DECODE(T.IS_HEAD,'
      '1102291630=                  0, T.NAME,'
      '1102291631=                  1, T.NAME,'
      '1102291632=                  2, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39','
      '1102291633=                  3, '#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39'),'
      '1102291634=           G.ARTICUL,'
      '1102291635=           G.BARCODE,'
      '1102291636=           G.PRICE,'
      '1102291637=           T.AMOUNT_IN,'
      '1102291638=           T.AMOUNT_PRIHOD,'
      '1102291639=           T.SUMM_PRIHOD,'
      '1102291640=           T.AMOUNT_UHOD,'
      '1102291641=           T.SUMM_UHOD,'
      '1102291642=           T.AMOUNT_SPISANO,'
      '1102291643=           T.SUMM_SPISANO,'
      '1102291644=           T.AMOUNT_VOZVRAT,'
      '1102291645=           T.SUMM_VOZVRAT,'
      '1102291646=           T.AMOUNT_PRIHOD_SKL,'
      '1102291647=           T.SUMM_PRIHOD_SKL,'
      '1102291648=           T.AMOUNT_UHOD_SKL,'
      '1102291649=           T.SUMM_UHOD_SKL,'
      '1102291650=           T.AMOUNT_OUT,'
      '1102291651=           T.LAST_SUPPLIER,'
      '1102291652=           T.IS_HEAD'
      
        '1102291653=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1102291654=     ORDER BY 1'
      '1102291655=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1102291656=       :NAME,'
      '1102291657=       :ARTICUL,'
      '1102291658=       :BARCODE,'
      '1102291659=       :PRICE,'
      '1102291660=       :AMOUNT_IN,'
      '1102291661=       :AMOUNT_PRIHOD,'
      '1102291662=       :SUMM_PRIHOD,'
      '1102291663=       :AMOUNT_UHOD,'
      '1102291664=       :SUMM_UHOD,'
      '1102291665=       :AMOUNT_SPISANO,'
      '1102291666=       :SUMM_SPISANO,'
      '1102291667=       :AMOUNT_VOZVRAT,'
      '1102291668=       :SUMM_VOZVRAT,'
      '1102291669=       :AMOUNT_PRIHOD_SKL,'
      '1102291670=       :SUMM_PRIHOD_SKL,'
      '1102291671=       :AMOUNT_UHOD_SKL,'
      '1102291672=       :SUMM_UHOD_SKL,'
      '1102291673=       :AMOUNT_OUT,'
      '1102291674=       :LAST_SUPPLIER,'
      '1102291675=       :IS_HEAD'
      '1102291676=  DO SUSPEND;'
      '1102291677='
      '1102291678=WHEN ANY DO BEGIN'
      '1102291679=    Err_code = -20500;'
      
        '1102291680=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102291681=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102291682=  END'
      '1102291683=end'
      '1102291684=;'
      '1102291685='
      '1102291686=ALTER PROCEDURE UPDATE_ZAKAZ_DETAILS_TMP('
      
        '1102291687=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1102291688=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1102291689=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1102291690=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1102291691=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC,'
      
        '1102291692=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE,'
      
        '1102291693=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC,'
      '1102291694=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1102291695=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1102291696=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '1102291697=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE,'
      '1102291698=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '1102291699=  NOT_MINUS_OSTATOK_ SMALLINT = 0)'
      '1102291700=RETURNS ('
      '1102291701=  ERR_CODE INTEGER,'
      '1102291702=  ERR_MSG VARCHAR(1024))'
      '1102291703=AS'
      '1102291704=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '1102291705=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL_TMP'#39';'
      '1102291706=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102291707=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102291708=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1102291709=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053 +
        #1054#1052' '#1047#1040#1050#1040#1047#1045' */'
      
        '1102291710=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1102291711=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1102291712=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      
        '1102291713=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1102291714=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102291715=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.COST_PRICE;'
      '1102291716=BEGIN'
      '1102291717='
      '1102291718=  SELECT G.IS_KIT'
      '1102291719=    FROM G_PRODUCT G, ZAKAZ_DETAILS_TMP T'
      '1102291720=   WHERE T.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1102291721=     AND G.G_PRODUCT = T.G_PRODUCT'
      '1102291722=    INTO :IS_KIT_;'
      '1102291723='
      
        '1102291724=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070', '#1040' '#1047#1040#1058#1045#1052' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1040#1053#1040 +
        #1051#1048#1047' '#1055#1054' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1045#1053#1053#1054#1052#1059' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059','
      
        '1102291725=  -- '#1048' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1045#1043#1054' '#1057' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045'. '#1045#1057#1051#1048' '#1063#1058#1054',' +
        ' '#1055#1056#1048' '#1043#1045#1053#1045#1056#1040#1062#1048#1048' '#1054#1064#1048#1041#1050#1048', '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1041#1059#1044#1045#1058' ROLLBACK'
      '1102291726=  PNT_ = '#39'01'#39';'
      '1102291727=  UPDATE ZAKAZ_DETAILS_TMP t'
      '1102291728=     SET t.AMOUNT = :AMOUNT_,'
      '1102291729=        t.PRICE = :PRICE_,'
      '1102291730=        t.SUMM = :SUMM_,'
      '1102291731=        t.DISCOUNT_PERC = :DISCOUNT_PERC_,'
      '1102291732=        t.DISCOUNT_TENGE = :DISCOUNT_TENGE_,'
      '1102291733=        T.DISCOUNT_SUMM = :DISCOUNT_SUMM_,'
      '1102291734=        T.NDS = :NDS_,'
      '1102291735=        T.NDS_SUMM = :NDS_SUMM_,'
      '1102291736=        T.VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '1102291737=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1102291738=  RETURNING'
      '1102291739=    ZAKAZ, Z_TYPE'
      '1102291740=  INTO'
      '1102291741=    :ZAKAZ_, :Z_TYPE_;'
      '1102291742='
      
        '1102291743=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054 +
        #1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1102291744=  PNT_ = '#39'02'#39';'
      '1102291745=  SELECT L.G_PRODUCT,'
      '1102291746=         L.AMOUNT - L.AMOUNT_RESERVE'
      '1102291747=    FROM ZAKAZ_DETAILS_TMP S,'
      '1102291748=         LT_SKLAD_PRODUCT L'
      '1102291749=   WHERE S.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1102291750=     AND S.G_PRODUCT = L.G_PRODUCT'
      
        '1102291751=     AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      '1102291752=    INTO :G_PRODUCT_,'
      '1102291753=         :AMOUNT_CUR_;'
      '1102291754='
      
        '1102291755=  -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042 +
        #1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1102291756=  -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1102291757=  -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048#1063#1045#1057 +
        #1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1102291758=  -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051#1054', ' +
        #1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068#1050#1054
      
        '1102291759=  -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068' '#1055#1056 +
        #1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1102291760=  PNT_ = '#39'04'#39';'
      '1102291761=  IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1102291762=      SELECT SUM(AMOUNT)'
      '1102291763=        FROM ZAKAZ_DETAILS T'
      '1102291764=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102291765=         AND T.ZAKAZ = :ZAKAZ_'
      '1102291766=        INTO :AMOUNT_OLD_;'
      '1102291767=  ELSE'
      '1102291768=      SELECT SUM(AMOUNT)'
      '1102291769=        FROM SKLAD T'
      '1102291770=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102291771=         AND T.SKLAD_PARENT = :ZAKAZ_'
      '1102291772=        INTO :AMOUNT_OLD_;'
      '1102291773='
      '1102291774=  -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1102291775=  PNT_ = '#39'05'#39';'
      '1102291776=  SELECT SUM(AMOUNT)'
      '1102291777=    FROM ZAKAZ_DETAILS_TMP T'
      '1102291778=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102291779=   INTO :AMOUNT_CUR_ZAKAZ_;'
      '1102291780='
      
        '1102291781=  IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:' +
        'AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1102291782=    -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042#1054#1044#1048 +
        #1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1102291783=    IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) THEN' +
        ' BEGIN'
      '1102291784=        PNT_ = '#39'01'#39';'
      
        '1102291785=        EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FROM ' +
        'CUR_PARAMS WHERE CUR_PARAMS = 2),'
      '1102291786=                                     CURRENT_DATE,'
      '1102291787=                                     :G_PRODUCT_,'
      
        '1102291788=                                     ABS(AMOUNT_CUR_ ' +
        '- (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUNT_,'
      
        '1102291789=                                     '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086' '#1087#1088 +
        #1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1102291790=                                     )'
      
        '1102291791=            RETURNING_VALUES :SKLAD_, :COST_PRICE__, ' +
        ':ERR_CODE, :ERR_MSG;'
      '1102291792=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102291793=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102291794=          EXIT;'
      '1102291795=        END'
      '1102291796=    END'
      
        '1102291797=    ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND NOT_MIN' +
        'US_OSTATOK_ = 0) THEN BEGIN'
      '1102291798=        ERR_CODE = -20500;'
      
        '1102291799=        ERR_MSG = '#39#1055#1086#1089#1083#1077' '#1076#1072#1085#1085#1086#1081' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090 +
        #1086#1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39'||ASCII_CHAR(10)||'
      
        '1102291800=                  '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082#1086#1084' ' +
        #1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1102291801=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_M' +
        'SG) RETURNING_VALUES (:ERR_MSG);'
      '1102291802=        ERR_MSG = PROCNAME||ERR_MSG;'
      '1102291803=        EXIT;'
      '1102291804=    END'
      '1102291805=  END'
      '1102291806=when sqlcode -811 DO'
      '1102291807=  begin'
      '1102291808=    ERR_CODE = -20500;'
      
        '1102291809=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1052#1085#1086#1078#1077#1089#1090#1074 +
        #1086' '#1089#1090#1088#1086#1082' '#1074' '#1086#1076#1080#1085#1086#1095#1085#1086#1084' SELECT!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102291810=    ERR_MSG = PROCNAME||'#39' ->  PNT_ '#39'||PNT_||'#39'. '#39'||ERR' +
        '_MSG;'
      '1102291811=  end'
      '1102291812=END'
      '1102291813=;'
      '1102291814='
      '1102291815='
      
        '1102291816=/****************************************************' +
        '**************************/'
      
        '1102291817=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102291818=/****************************************************' +
        '**************************/'
      '1102291819=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1102291820=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102291821=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102291822=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102291823=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102291824=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102291825=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102291826=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102291827=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102291828=RETURNS ('
      '1102291829=  ERR_CODE INTEGER,'
      '1102291830=  ERR_MSG VARCHAR(1024))'
      '1102291831=AS'
      '1102291832=/*'
      
        '1102291833='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1102291834='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1102291835='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1102291836=*/'
      
        '1102291837=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1102291838=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102291839=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1102291840=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1102291841=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1102291842=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1102291843=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1102291844=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1102291845=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1102291846=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102291847=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1102291848=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1102291849=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1102291850=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1102291851=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102291852=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102291853=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102291854=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102291855=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1102291856=BEGIN'
      '1102291857='
      '1102291858=  PNT_ = '#39'00'#39';'
      '1102291859=  CLRF = ascii_char( 10 );'
      '1102291860='
      '1102291861=  SELECT S.S_VALUE'
      '1102291862=    FROM SYSTEM_SETUP S'
      '1102291863=   WHERE S.SYSTEM_SETUP = 2'
      '1102291864=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1102291865='
      '1102291866=  PNT_ = '#39'01'#39';'
      '1102291867=  SELECT G.nds_value'
      '1102291868=    FROM G_FIRM_REKVIZIT G'
      '1102291869=   WHERE G.is_default = 1'
      '1102291870=    INTO :NDS_;'
      '1102291871='
      '1102291872=  PNT_ = '#39'02'#39';'
      
        '1102291873=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1102291874=        FROM IMPORT_TBL_TMP'
      
        '1102291875=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1102291876=  DO BEGIN'
      '1102291877=    SELECT G_PRODUCT,'
      '1102291878=           PRICE'
      '1102291879=      FROM ('
      '1102291880=            SELECT P.G_PRODUCT, P.price'
      '1102291881=              FROM G_PRODUCT P'
      
        '1102291882=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1102291883=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1102291884=            UNION'
      '1102291885=            SELECT LT.G_PRODUCT, P.PRICE'
      '1102291886=              FROM LT_BARCODE LT, g_product P'
      
        '1102291887=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1102291888=               AND LT.g_product = P.g_product'
      '1102291889=           )'
      '1102291890=      INTO :G_PRODUCT_,'
      '1102291891=           :PRICE_OUR_;'
      '1102291892='
      '1102291893=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1102291894=      ERR_CODE = -20500;'
      
        '1102291895=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1102291896=      Exit;'
      '1102291897=    END'
      '1102291898='
      '1102291899=    PNT_ = '#39'03'#39';'
      
        '1102291900=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1102291901=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1102291902=      RETURNING_VALUES :COST_PRICE_;'
      '1102291903='
      '1102291904=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1102291905=    IF (price_ IS NULL) THEN'
      '1102291906=      PRICE_ = PRICE_OUR_;'
      '1102291907='
      '1102291908=    PNT_ = '#39'04'#39';'
      
        '1102291909=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1102291910=                                              :AMOUNT' +
        '_,'
      
        '1102291911=                                              :PRICE_' +
        ','
      
        '1102291912=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1102291913=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1102291914=                                              :DISCOU' +
        'NT_,'
      
        '1102291915=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1102291916=                                              :NDS_,'
      
        '1102291917=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1102291918=                                              :COST_P' +
        'RICE_,'
      
        '1102291919=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1102291920=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1102291921=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1102291922=                                              0     -' +
        '-MODE_'
      
        '1102291923=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1102291924=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102291925=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102291926=      EXIT;'
      '1102291927=    END'
      '1102291928='
      '1102291929=    G_PRODUCT_ = NULL;'
      '1102291930=  END'
      '1102291931='
      '1102291932=  PNT_ = '#39'05'#39';'
      '1102291933=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1102291934=    SELECT SUM(T.summ)'
      '1102291935=      FROM ZAKAZ_DETAILS_TMP T'
      '1102291936=      INTO :SUMM_;'
      '1102291937=    SUMM_FACT_ = SUMM_;'
      '1102291938=  END'
      '1102291939='
      '1102291940=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1102291941=  if (G_PAYMENT_TYPE_ = 1) then'
      '1102291942=    SUMM_CASH_ = summ_fact_;'
      '1102291943=  ELSE'
      '1102291944=    SUMM_NONCASH_ = summ_fact_;'
      '1102291945='
      '1102291946=  PNT_ = '#39'06'#39';'
      '1102291947=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1102291948=    G_CLIENT_ = 10;'
      '1102291949='
      '1102291950=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102291951=                              :Z_DATE_,'
      '1102291952=                              :Z_TIME_,'
      '1102291953=                              :G_CLIENT_,'
      '1102291954=                              :G_PAYMENT_TYPE_,'
      '1102291955=                              '#39#39', --:OSNOVANIE_,'
      '1102291956=                              0,  -- IS_SPISANIE'
      
        '1102291957=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1102291958=                              :SUMM_,'
      '1102291959=                              :SUMM_FACT_,'
      '1102291960=                              :SUMM_CASH_,'
      '1102291961=                              :SUMM_NONCASH_,'
      
        '1102291962=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1102291963=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1102291964=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1102291965=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1102291966=                              0,    -- :BY_RECIPE__,'
      '1102291967=                              0,    -- IS_RESERVE__'
      '1102291968=                              NULL -- :PAYMENTS__'
      '1102291969=                              )'
      
        '1102291970=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102291971=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102291972=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102291973=    EXIT;'
      '1102291974=  END'
      '1102291975='
      '1102291976=  DELETE FROM import_tbl_tmp;'
      '1102291977='
      '1102291978=WHEN ANY DO BEGIN'
      '1102291979=    ERR_CODE = gdscode;'
      
        '1102291980=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1102291981=  END'
      '1102291982=end'
      '1102291983=;'
      '1102291984='
      '1102291985='
      
        '1102291986=UPDATE SYSTEM_SETUP SET S_VALUE = 110229 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102291987=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102291988=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102300='
      '1102301=ALTER PROCEDURE P_REP_PROFIT('
      '1102302=  DATE_BEGIN_ DATE,'
      '1102303=  DATE_END_ DATE,'
      '1102304=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1102305=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYMEN' +
        'T_TYPE,'
      '1102306=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1102307=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0,'
      
        '1102308=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      
        '1102309=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIH' +
        'OD_RASHOD = NULL)'
      '11023010=RETURNS ('
      '11023011=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11023012=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '11023013=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUMM' +
        ','
      '11023014=  SUMM_COST_ALL_STR VARCHAR(50),'
      '11023015=  SUMM_ALL_ NUMERIC(15,2),'
      '11023016=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '11023017=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '11023018=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '11023019=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '11023020=  PROFIT_ALL_ NUMERIC(15,2),'
      '11023021=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '11023022=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'P_REP_PROFIT_TABLE,'
      '11023023=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '11023024=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '11023025=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '11023026=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '11023027=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT_' +
        'NAME,'
      
        '11023028=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PA' +
        'YMENT_TYPE,'
      
        '11023029=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYMEN' +
        'T_NAME,'
      
        '11023030=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANIE' +
        ','
      
        '11023031=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUCT' +
        ','
      
        '11023032=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRO' +
        'DUCT_PAR,'
      
        '11023033=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_NA' +
        'ME,'
      '11023034=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11023035=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11023036=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11023037=  AMOUNT MY_NUMERIC_5,'
      '11023038=  PRICE NUMERIC(15,2),'
      '11023039=  SUMM NUMERIC(15,2),'
      '11023040=  DISCOUNT_PERC NUMERIC(15,2),'
      '11023041=  DISCOUNT_SUMM NUMERIC(15,2),'
      '11023042=  NDS NUMERIC(15,2),'
      '11023043=  NDS_SUMM NUMERIC(15,2),'
      '11023044=  PRICE_SELF NUMERIC(15,2),'
      '11023045=  SUM_SELF NUMERIC(15,2),'
      '11023046=  PROFIT NUMERIC(15,2),'
      '11023047=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '11023048=  ERR_CODE INTEGER,'
      '11023049=  ERR_MSG VARCHAR(1024))'
      '11023050=AS'
      '11023051=/*'
      '11023052='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '11023053='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050#1054 +
        ' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048#1054 +
        #1044
      
        '11023054='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055#1071 +
        #1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '11023055='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069#1058 +
        #1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053#1045 +
        #1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '11023056='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '11023057='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '11023058='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '11023059=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '11023060=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '11023061=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '11023062='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*1750' +
        ' + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '11023063='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' '#1047 +
        #1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '11023064='
      '11023065='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = NULL, '#1058#1054' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '11023066='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = -100, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057 +
        #1057#1059' '#1042#1054#1054#1041#1065#1045
      
        '11023067='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = ID, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1050#1054#1053#1050#1056#1045#1058#1053#1059#1070' '#1057#1058#1040 +
        #1058#1068#1070' '#1055#1056#1048#1061#1054#1044#1040' '#1042' '#1050#1040#1057#1057#1059
      '11023068=*'
      '11023069=*/'
      '11023070=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39';'
      '11023071=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11023072=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '11023073=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '11023074=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '11023075=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '11023076=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '11023077=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '11023078=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '11023079=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '11023080=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '11023081=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '11023082=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '11023083=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      '11023084=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11023085=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_T' +
        'OCHKA;'
      
        '11023086=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DAT' +
        'E;'
      
        '11023087=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_C' +
        'LIENT;'
      
        '11023088=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLIE' +
        'NT.NAME;'
      
        '11023089=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZAK' +
        'AZ.G_PAYMENT_TYPE;'
      
        '11023090=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.NAME;'
      
        '11023091=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OS' +
        'NOVANIE;'
      
        '11023092=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      
        '11023093=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT_PAR;'
      
        '11023094=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11023095=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11023096=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.PRICE;'
      
        '11023097=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '11023098=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_PERC;'
      
        '11023099=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM;'
      
        '110230100=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110230101=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110230102=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110230103=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110230104=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110230105=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110230106=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110230107=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110230108=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110230109=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110230110=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110230111=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110230112=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110230113=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110230114=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110230115=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110230116=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110230117=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110230118=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '110230119=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM_FACT;'
      
        '110230120=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN S' +
        'KLAD_PARENT.SUMM_FACT;'
      '110230121=BEGIN'
      
        '110230122=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110230123=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110230124='
      '110230125=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110230126=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110230127=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110230128='
      '110230129=  FOR SELECT GP.PATH,'
      '110230130=             GP.G_PRODUCT'
      '110230131=       FROM P_REP_TREE GP'
      '110230132=      WHERE EXISTS (SELECT 1'
      
        '110230133=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110230134=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110230135=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110230136=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110230137=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110230138=                       AND Z.IS_SPISANIE = 0'
      '110230139=                       AND Z.is_reserve = 0'
      '110230140=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110230141=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110230142=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230143=                       AND COALESCE(Z.G_OFFICIAL, 0) =' +
        ' COALESCE(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056 +
        #1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230144=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110230145=                    )'
      '110230146=        AND EXISTS ('
      '110230147=                    SELECT 1'
      '110230148=                       FROM SKLAD S, G_PRODUCT GGG'
      '110230149=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '110230150=                        AND S.G_PRODUCT = GGG.G_PRODUC' +
        'T'
      
        '110230151=                        AND GGG.G_PRODUCT_PAR = GP.G_P' +
        'RODUCT'
      
        '110230152=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39
      '110230153=                        AND :G_SUPPLIER_ <> 0'
      '110230154=                    UNION'
      '110230155=                    SELECT 1'
      '110230156=                      FROM RDB$DATABASE'
      '110230157=                      WHERE :G_SUPPLIER_ = 0'
      '110230158=                )'
      '110230159=      ORDER BY 1, 2'
      '110230160=  INTO :RECCAT_NAME_,'
      '110230161=       :RECCAT_PRODUCT_'
      '110230162=  DO BEGIN'
      '110230163=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230164=    insert into p_rep_profit_table'
      '110230165=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110230166=    values'
      
        '110230167=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110230168='
      '110230169=    FOR SELECT Z.ZAKAZ,'
      '110230170=               Z.G_TOCHKA,'
      '110230171=               Z.Z_DATE,'
      '110230172=               Z.G_CLIENT,'
      '110230173=               C.NAME CLIENT_NAME,'
      '110230174=               Z.G_PAYMENT_TYPE,'
      '110230175=               P.NAME PAYMENT_NAME,'
      '110230176=               Z.OSNOVANIE,'
      '110230177=               G.G_PRODUCT,'
      '110230178=               G.G_PRODUCT_PAR,'
      '110230179=               G.NAME TOVAR_NAME,'
      '110230180=               ZD.AMOUNT,'
      '110230181=               ZD.PRICE,'
      '110230182=               ZD.SUMM,'
      '110230183=               ZD.DISCOUNT_PERC,'
      '110230184=               ZD.DISCOUNT_SUMM,'
      '110230185=               ZD.NDS,'
      '110230186=               ZD.NDS_SUMM,'
      '110230187=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110230188=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110230189=               ZAKAZ_DETAILS ZD,'
      '110230190=               G_PRODUCT G,'
      '110230191=               G_PAYMENT_TYPE P'
      
        '110230192=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110230193=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110230194=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110230195=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110230196=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110230197=           AND Z.IS_SPISANIE = 0                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '110230198=           AND Z.IS_RESERVE = 0                    -- ' +
        #1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '110230199=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110230200=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110230201=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110230202=           AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G' +
        '_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' ' +
        #1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230203=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110230204=           AND ((EXISTS (SELECT 1'
      '110230205=                           FROM SKLAD S'
      
        '110230206=                          WHERE S.G_CLIENT = :G_SUPPLI' +
        'ER_'
      
        '110230207=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110230208=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110230209=                OR'
      '110230210=                COALESCE(:G_SUPPLIER_, 0) = 0'
      '110230211=               )'
      
        '110230212=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110230213=    INTO :REC_ZAKAZ_,'
      '110230214=        :REC_G_TOCHKA_,'
      '110230215=        :REC_Z_DATE_,'
      '110230216=        :REC_G_CLIENT_,'
      '110230217=        :REC_CLIENT_NAME_,'
      '110230218=        :REC_G_PAYMENT_TYPE_,'
      '110230219=        :REC_PAYMENT_NAME_,'
      '110230220=        :REC_OSNOVANIE_,'
      '110230221=        :REC_G_PRODUCT_,'
      '110230222=        :REC_G_PRODUCT_PAR_,'
      '110230223=        :REC_TOVAR_NAME_,'
      '110230224=        :REC_AMOUNT_,'
      '110230225=        :REC_PRICE_,'
      '110230226=        :REC_SUMM_,'
      '110230227=        :REC_DISCOUNT_PERC_,'
      '110230228=        :REC_DISCOUNT_SUMM_,'
      '110230229=        :REC_NDS_,'
      '110230230=        :REC_NDS_SUMM_,'
      '110230231=        :REC_PRICE_SELF_'
      '110230232=    DO BEGIN'
      '110230233=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110230234=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110230235='
      '110230236=      insert into p_rep_profit_table'
      
        '110230237=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110230238=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110230239=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110230240=      values'
      '110230241=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110230242=        :REC_ZAKAZ_,'
      '110230243=        :REC_g_tochka_,'
      
        '110230244=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110230245=         :REC_osnovanie_,'
      '110230246=         :REC_g_product_,'
      '110230247=         :REC_g_product_par_,'
      '110230248=         :REC_tovar_name_,'
      '110230249=         :REC_amount_,'
      '110230250=         :REC_price_,'
      '110230251=         :REC_summ_,'
      '110230252=         :REC_discount_perc_,'
      '110230253=         :REC_discount_summ_,'
      
        '110230254=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110230255='
      
        '110230256=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110230257=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110230258=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110230259=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110230260=    END'
      '110230261='
      '110230262=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230263=    insert into p_rep_profit_table'
      
        '110230264=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110230265=    values'
      
        '110230266=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110230267='
      '110230268=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110230269=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110230270=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110230271=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110230272='
      '110230273=    SUM_ZAKAZ_ = 0;'
      '110230274=    SUM_COST_  = 0;'
      '110230275=    NDS_SUMM_  = 0;'
      '110230276=    PROFIT_    = 0;'
      '110230277=  END'
      '110230278='
      '110230279=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110230280=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110230281=      insert into p_rep_profit_table'
      
        '110230282=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110230283=      values'
      
        '110230284=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110230285='
      
        '110230286=  --**************************************************' +
        '***************************************'
      '110230287=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110230288=  ----------------------------------------------------' +
        '---'
      '110230289=  SELECT COUNT(*)'
      
        '110230290=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110230291=          UNION ALL'
      
        '110230292=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110230293=         G_PRIHOD_RASHOD G'
      
        '110230294=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110230295=    AND K.ACTION = 1'
      
        '110230296=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110230297=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110230298=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053#1045 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110230299=  INTO :CNT_;'
      '110230300='
      '110230301=  IF (CNT_ > 0) THEN BEGIN'
      '110230302=    SUM_COST_  = 0;'
      '110230303=    PROFIT_    = 0;'
      '110230304='
      '110230305=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230306=    INSERT INTO P_REP_PROFIT_TABLE'
      '110230307=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110230308=    VALUES'
      
        '110230309=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', 1' +
        ');'
      '110230310='
      '110230311=    FOR SELECT K.ACTION_DATE,'
      '110230312=               K.SUMM,'
      
        '110230313=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, '#39 +
        ' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '110230314=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '110230315=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39
      '110230316=              UNION ALL'
      
        '110230317=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, ' +
        'SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM kas' +
        'sa_beznal'
      
        '110230318=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39') k,'
      '110230319=              G_PRIHOD_RASHOD G'
      '110230320=        WHERE K.ACTION = 1'
      
        '110230321=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110230322=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110230323=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)   ' +
        ' -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110230324=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110230325=    INTO :ACTION_DATE_,'
      '110230326=         :SUMM_,'
      '110230327=         :ACTION_NAME_'
      '110230328=    DO BEGIN'
      '110230329=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110230330=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110230331=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110230332=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110230333=        VALUES'
      
        '110230334=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, 0,'
      
        '110230335=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALES' +
        'CE(:SUMM_, 0), 0);'
      '110230336='
      '110230337=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110230338=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110230339=    END'
      '110230340='
      '110230341=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110230342=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110230343=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110230344=    insert into p_rep_profit_table'
      
        '110230345=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110230346=    values'
      
        '110230347=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110230348=  END'
      '110230349=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '110230350=  --**************************************************' +
        '***************************************'
      '110230351='
      
        '110230352=  --**************************************************' +
        '***************************************'
      '110230353=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '110230354=  ----------------------------------------------------' +
        '---'
      '110230355=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230356=  SELECT COUNT(*)'
      
        '110230357=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110230358=          UNION ALL'
      
        '110230359=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110230360=         G_PRIHOD_RASHOD G'
      
        '110230361=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110230362=    AND K.ACTION = 0'
      
        '110230363=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110230364=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110230365=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056#1045 +
        #1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110230366=    AND ((:G_PRIHOD_RASHOD_ IS NULL)'
      '110230367=         OR'
      
        '110230368=         (G.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_ AND :G' +
        '_PRIHOD_RASHOD_ = -100)'
      '110230369=         OR'
      
        '110230370=         (G.G_PRIHOD_RASHOD <> :G_PRIHOD_RASHOD_ AND :' +
        'G_PRIHOD_RASHOD_ <> -100)'
      '110230371=        )'
      '110230372=  INTO :CNT_;'
      '110230373='
      '110230374=  IF (CNT_ > 0) THEN BEGIN'
      '110230375=    PRIHOD_ALL_  = 0;'
      '110230376=    PRIHOD_ALL_NAL_  = 0;'
      '110230377=    PRIHOD_ALL_BEZNAL_  = 0;'
      '110230378=    PROFIT_     = 0;'
      '110230379='
      '110230380=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230381=    INSERT INTO P_REP_PROFIT_TABLE'
      '110230382=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110230383=    VALUES'
      
        '110230384=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', 1' +
        ');'
      '110230385='
      '110230386=    FOR SELECT K.ACTION_DATE,'
      '110230387=               K.NAL,'
      '110230388=               K.BEZNAL,'
      '110230389=               G.NAME'
      
        '110230390=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 ' +
        'BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110230391=               UNION ALL'
      
        '110230392=               SELECT kassa_BEZNAL KASSA, ACTION_DATE,' +
        ' 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kass' +
        'a_beznal) K,'
      '110230393=              G_PRIHOD_RASHOD G'
      
        '110230394=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '110230395=          AND K.ACTION = 0'
      
        '110230396=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110230397=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110230398=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110230399=          AND ((:G_PRIHOD_RASHOD_ IS NULL)'
      '110230400=               OR'
      
        '110230401=               (G.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_ ' +
        'AND :G_PRIHOD_RASHOD_ = -100)'
      '110230402=               OR'
      
        '110230403=               (G.G_PRIHOD_RASHOD <> :G_PRIHOD_RASHOD_' +
        ' AND :G_PRIHOD_RASHOD_ <> -100)'
      '110230404=              )'
      '110230405=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110230406=    INTO :ACTION_DATE_,'
      '110230407=         :SUMM_NAL_,'
      '110230408=         :SUMM_BEZNAL_,'
      '110230409=         :ACTION_NAME_'
      '110230410=    DO BEGIN'
      '110230411=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110230412=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110230413=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110230414=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110230415=        VALUES'
      
        '110230416=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '110230417=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '110230418='
      '110230419=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110230420=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM' +
        '_BEZNAL_;'
      
        '110230421=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_B' +
        'EZNAL_;'
      
        '110230422=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZ' +
        'NAL_;'
      '110230423=    END'
      '110230424='
      '110230425=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110230426=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110230427=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '110230428=    insert into p_rep_profit_table'
      
        '110230429=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110230430=    values'
      
        '110230431=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110230432=  END'
      '110230433='
      '110230434=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '110230435=  --**************************************************' +
        '***************************************'
      '110230436='
      
        '110230437=  --**************************************************' +
        '***************************************'
      '110230438=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110230439=  --**************************************************' +
        '***************************************'
      '110230440=  SELECT COUNT(*)'
      '110230441=    FROM ZAKAZ Z'
      
        '110230442=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110230443=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110230444=     AND Z.IS_SPISANIE = 1'
      
        '110230445=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110230446=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110230447=  INTO :CNT_;'
      '110230448='
      '110230449=  IF (CNT_ > 0) THEN BEGIN'
      '110230450=      SUM_ZAKAZ_ = 0;'
      '110230451=      SUM_COST_  = 0;'
      '110230452=      PROFIT_    = 0;'
      '110230453='
      '110230454=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230455=      insert into p_rep_profit_table'
      '110230456=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110230457=      values'
      
        '110230458=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39', 1);'
      '110230459='
      '110230460=      FOR SELECT Z.ZAKAZ,'
      '110230461=                 Z.G_TOCHKA,'
      '110230462=                 Z.Z_DATE,'
      '110230463=                 Z.G_CLIENT,'
      '110230464=                 '#39#39' CLIENT_NAME,'
      '110230465=                 Z.G_PAYMENT_TYPE,'
      '110230466=                 '#39#39' PAYMENT_NAME,'
      '110230467=                 Z.OSNOVANIE,'
      '110230468=                 G.G_PRODUCT,'
      '110230469=                 G.G_PRODUCT_PAR,'
      '110230470=                 G.NAME TOVAR_NAME,'
      '110230471=                 ZD.AMOUNT,'
      '110230472=                 ZD.PRICE,'
      '110230473=                 ZD.SUMM,'
      '110230474=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '110230475=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '110230476=                 0 NDS, --ZD.NDS,'
      '110230477=                 0 NDS_SUMM'
      
        '110230478=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT ' +
        'G'
      
        '110230479=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TO' +
        'CHKA||'#39'-'#39
      '110230480=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110230481=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110230482=             AND Z.IS_SPISANIE = 1                    ' +
        '-- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '110230483=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110230484=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '110230485=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G' +
        '_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059 +
        #1057#1058#1067#1052
      
        '110230486=             AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(' +
        ':G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045 +
        #1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230487=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALE' +
        'SCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110230488=             AND ((EXISTS (SELECT 1'
      '110230489=                           FROM SKLAD S'
      
        '110230490=                          WHERE S.G_CLIENT = :G_SUPPLI' +
        'ER_'
      
        '110230491=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110230492=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110230493=                  OR'
      '110230494=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110230495=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS'
      '110230496=      INTO :REC_ZAKAZ_,'
      '110230497=            :REC_G_TOCHKA_,'
      '110230498=            :REC_Z_DATE_,'
      '110230499=            :REC_G_CLIENT_,'
      '110230500=            :REC_CLIENT_NAME_,'
      '110230501=            :REC_G_PAYMENT_TYPE_,'
      '110230502=            :REC_PAYMENT_NAME_,'
      '110230503=            :REC_OSNOVANIE_,'
      '110230504=            :REC_G_PRODUCT_,'
      '110230505=            :REC_G_PRODUCT_PAR_,'
      '110230506=            :REC_TOVAR_NAME_,'
      '110230507=            :REC_AMOUNT_,'
      '110230508=            :REC_PRICE_,'
      '110230509=            :REC_SUMM_,'
      '110230510=            :REC_DISCOUNT_PERC_,'
      '110230511=            :REC_DISCOUNT_SUMM_,'
      '110230512=            :REC_NDS_,'
      '110230513=            :REC_NDS_SUMM_'
      '110230514=      DO BEGIN'
      '110230515=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110230516=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067 +
        ' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '110230517=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '110230518=        REC_profit_   = -REC_SUMM_;'
      '110230519='
      '110230520=        insert into p_rep_profit_table'
      
        '110230521=          (p_rep_profit_table, zakaz, g_tochka, z_date' +
        ', g_client, client_name, g_payment_type, payment_name,'
      
        '110230522=           osnovanie, g_product, g_product_par, tovar_' +
        'name, amount, price, summ, discount_perc, discount_summ,'
      
        '110230523=           nds, nds_summ, price_self, sum_self, profit' +
        ', is_head)'
      '110230524=        values'
      
        '110230525=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAK' +
        'AZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '110230526=         :REC_osnovanie_, :REC_g_product_, :REC_g_prod' +
        'uct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_pe' +
        'rc_, :REC_discount_summ_,'
      
        '110230527=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_' +
        'SUM_COST_, :REC_profit_, 0);'
      '110230528='
      
        '110230529=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST' +
        '_, 0);'
      
        '110230530=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, ' +
        '0);'
      '110230531=      END'
      '110230532='
      '110230533=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230534=      insert into p_rep_profit_table'
      
        '110230535=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110230536=      values'
      
        '110230537=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0' +
        ', :SUM_COST_, 0, :PROFIT_, 2);'
      '110230538='
      '110230539=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110230540=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110230541=  END'
      '110230542=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110230543=  --**************************************************' +
        '***************************************'
      '110230544='
      
        '110230545=  --**************************************************' +
        '***************************************'
      '110230546=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110230547=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048#1045 +
        #1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '110230548=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053#1054 +
        '", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '110230549=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' '#1055 +
        #1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '110230550='
      
        '110230551=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '110230552=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 45' +
        '00'
      
        '110230553=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056#1048 +
        #1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057#1054 +
        #1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '110230554=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070#1047 +
        #1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054' ' +
        #1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '110230555='
      
        '110230556=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059#1063 +
        #1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '110230557=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058'.' +
        ' - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '110230558=  --**************************************************' +
        '***************************************'
      '110230559=  SELECT COUNT(*)'
      '110230560=    FROM SKLAD S'
      
        '110230561=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      
        '110230562=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110230563=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110230564=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110230565=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110230566=     AND ((EXISTS (SELECT 1'
      '110230567=                   FROM SKLAD SS'
      '110230568=                  WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '110230569=                    AND SS.G_PRODUCT = S.G_PRODUCT'
      
        '110230570=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110230571=          OR'
      '110230572=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110230573=  INTO :CNT_;'
      '110230574='
      '110230575=  IF (CNT_ > 0) THEN BEGIN'
      '110230576=    SUM_ZAKAZ_ = 0;'
      '110230577=    PROFIT_    = 0;'
      '110230578=    SUM_COST_  = 0;'
      '110230579=    NDS_SUMM_  = 0;'
      '110230580='
      '110230581=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230582=    insert into p_rep_profit_table'
      '110230583=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110230584=    values'
      
        '110230585=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39', 1);'
      '110230586='
      '110230587=    FOR SELECT S.DATE_RECEIPT,'
      '110230588=               S.G_PRODUCT,'
      '110230589=               G.NAME TOVAR_NAME,'
      '110230590=               S.AMOUNT,'
      '110230591=               -S.PRICE,'
      '110230592=               -S.SUMM,'
      '110230593=               SP.G_TOCHKA,'
      '110230594=               S.COST_PRICE,'
      '110230595=               S.NDS,'
      '110230596=               S.NDS_SUMM'
      '110230597=         FROM SKLAD_PARENT SP,'
      '110230598=              SKLAD S,'
      '110230599=              G_PRODUCT G'
      
        '110230600=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCH' +
        'KA||'#39'-'#39
      
        '110230601=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110230602=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110230603=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110230604=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110230605=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110230606=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110230607=          AND ((EXISTS (SELECT 1'
      '110230608=                           FROM SKLAD SS'
      
        '110230609=                          WHERE SS.G_CLIENT = :G_SUPPL' +
        'IER_'
      
        '110230610=                            AND SS.G_PRODUCT = S.G_PRO' +
        'DUCT'
      
        '110230611=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110230612=                  OR'
      '110230613=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110230614=        ORDER BY 1'
      '110230615=    INTO :V_DATE_RECEIPT_,'
      '110230616=         :V_G_PRODUCT_,'
      '110230617=         :V_TOVAR_NAME_,'
      '110230618=         :V_AMOUNT_,'
      '110230619=         :V_PRICE_,'
      '110230620=         :V_SUMM_,'
      '110230621=         :REC_G_TOCHKA_,'
      '110230622=         :REC_PRICE_SELF_,'
      '110230623=         :REC_NDS_,'
      '110230624=         :REC_NDS_SUMM_'
      '110230625=    DO BEGIN'
      '110230626=      REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110230627=      REC_profit_   = V_SUMM_ + REC_SUM_COST_ + REC_ND' +
        'S_SUMM_;'
      '110230628='
      '110230629=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110230630=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110230631=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110230632=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, s' +
        'um_self)'
      '110230633=      VALUES'
      
        '110230634=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, :V' +
        '_SUMM_,'
      
        '110230635=         0, 0, :REC_NDS_, :REC_NDS_SUMM_, :REC_profit_' +
        ', 0, :REC_PRICE_SELF_, :REC_SUM_COST_);'
      '110230636='
      '110230637=      SUM_COST_  = SUM_COST_  + REC_SUM_COST_;'
      '110230638=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      
        '110230639=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110230640=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110230641=    END'
      '110230642='
      '110230643='
      '110230644=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110230645=    SUMM_COST_All_ = SUMM_COST_All_ - SUM_COST_;'
      '110230646=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ - NDS_SUMM_;'
      '110230647=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110230648='
      '110230649=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230650=    insert into p_rep_profit_table'
      
        '110230651=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110230652=    values'
      
        '110230653=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110230654='
      '110230655=    SUM_COST_  = 0;'
      '110230656=    SUM_ZAKAZ_ = 0;'
      '110230657=    NDS_SUMM_  = 0;'
      '110230658=    PROFIT_    = 0;'
      '110230659=  END'
      '110230660=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110230661=  --**************************************************' +
        '***************************************'
      '110230662='
      
        '110230663=  --**************************************************' +
        '***************************************'
      
        '110230664=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045#1051 +
        #1054' '#1052#1045#1057#1058#1054
      '110230665=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '110230666=  --**************************************************' +
        '***************************************'
      '110230667=  /*SELECT COUNT(*)'
      '110230668=    FROM ZAKAZ Z'
      
        '110230669=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110230670=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110230671=     AND Z.IS_SPISANIE = 4'
      
        '110230672=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110230673=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110230674=  INTO :CNT_;'
      '110230675='
      '110230676=  IF (CNT_ > 0) THEN BEGIN'
      '110230677=      SUM_ZAKAZ_ = 0;'
      '110230678=      SUM_COST_  = 0;'
      '110230679=      PROFIT_    = 0;'
      '110230680=      NDS_SUMM_  = 0;'
      '110230681='
      '110230682=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230683=      insert into p_rep_profit_table'
      '110230684=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110230685=      values'
      
        '110230686=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058 +
        #1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '110230687='
      '110230688=      FOR SELECT Z.ZAKAZ,'
      '110230689=               Z.G_TOCHKA,'
      '110230690=               Z.Z_DATE,'
      '110230691=               Z.G_CLIENT,'
      '110230692=               C.NAME CLIENT_NAME,'
      '110230693=               Z.G_PAYMENT_TYPE,'
      '110230694=               P.NAME PAYMENT_NAME,'
      '110230695=               Z.OSNOVANIE,'
      '110230696=               G.G_PRODUCT,'
      '110230697=               G.G_PRODUCT_PAR,'
      '110230698=               G.NAME TOVAR_NAME,'
      '110230699=               ZD.AMOUNT,'
      '110230700=               ZD.PRICE,'
      '110230701=               ZD.SUMM,'
      '110230702=               ZD.DISCOUNT_PERC,'
      '110230703=               ZD.DISCOUNT_SUMM,'
      '110230704=               ZD.NDS,'
      '110230705=               ZD.NDS_SUMM,'
      '110230706=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110230707=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110230708=               ZAKAZ_DETAILS ZD,'
      '110230709=               G_PRODUCT G,'
      '110230710=               G_PAYMENT_TYPE P'
      
        '110230711=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110230712=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110230713=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110230714=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110230715=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110230716=           AND Z.IS_SPISANIE = 4                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110230717=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110230718=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110230719=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110230720=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110230721=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110230722=    INTO :REC_ZAKAZ_,'
      '110230723=        :REC_G_TOCHKA_,'
      '110230724=        :REC_Z_DATE_,'
      '110230725=        :REC_G_CLIENT_,'
      '110230726=        :REC_CLIENT_NAME_,'
      '110230727=        :REC_G_PAYMENT_TYPE_,'
      '110230728=        :REC_PAYMENT_NAME_,'
      '110230729=        :REC_OSNOVANIE_,'
      '110230730=        :REC_G_PRODUCT_,'
      '110230731=        :REC_G_PRODUCT_PAR_,'
      '110230732=        :REC_TOVAR_NAME_,'
      '110230733=        :REC_AMOUNT_,'
      '110230734=        :REC_PRICE_,'
      '110230735=        :REC_SUMM_,'
      '110230736=        :REC_DISCOUNT_PERC_,'
      '110230737=        :REC_DISCOUNT_SUMM_,'
      '110230738=        :REC_NDS_,'
      '110230739=        :REC_NDS_SUMM_,'
      '110230740=        :REC_PRICE_SELF_'
      '110230741=    DO BEGIN'
      '110230742=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '110230743=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '110230744='
      '110230745=      insert into p_rep_profit_table'
      
        '110230746=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110230747=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110230748=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110230749=      values'
      '110230750=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110230751=        :REC_ZAKAZ_,'
      '110230752=        :REC_g_tochka_,'
      
        '110230753=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110230754=         :REC_osnovanie_,'
      '110230755=         :REC_g_product_,'
      '110230756=         :REC_g_product_par_,'
      '110230757=         :REC_tovar_name_,'
      '110230758=         :REC_amount_,'
      '110230759=         :REC_price_,'
      '110230760=         :REC_summ_,'
      '110230761=         :REC_discount_perc_,'
      '110230762=         :REC_discount_summ_,'
      
        '110230763=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110230764='
      
        '110230765=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110230766=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110230767=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110230768=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110230769=    END'
      '110230770='
      '110230771=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230772=    insert into p_rep_profit_table'
      
        '110230773=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110230774=    values'
      
        '110230775=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110230776='
      '110230777=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110230778=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '110230779=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110230780=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110230781='
      '110230782=    SUM_ZAKAZ_ = 0;'
      '110230783=    SUM_COST_  = 0;'
      '110230784=    NDS_SUMM_  = 0;'
      '110230785=    PROFIT_    = 0;'
      '110230786=  END'
      '110230787=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '110230788=  --**************************************************' +
        '***************************************'
      '110230789='
      
        '110230790=  --**************************************************' +
        '***************************************'
      
        '110230791=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048 +
        #1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110230792=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054 +
        #1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110230793=  --**************************************************' +
        '***************************************'
      '110230794=  SELECT COUNT(*)'
      '110230795=    FROM ZAKAZ S'
      
        '110230796=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110230797=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110230798=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230799=     AND COALESCE(S.G_OFFICIAL, 0) = COALESCE(:G_OFFIC' +
        'IAL_, COALESCE(S.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '110230800=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110230801=     AND S.IS_SPISANIE = 2'
      '110230802=  INTO :CNT_;'
      '110230803='
      '110230804=  IF (CNT_ > 0) THEN BEGIN'
      '110230805=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230806=      insert into p_rep_profit_table'
      '110230807=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110230808=      values'
      
        '110230809=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '110230810='
      '110230811=      SUM_ZAKAZ_ = 0;'
      '110230812=      SUM_COST_  = 0;'
      '110230813=      NDS_SUMM_  = 0;'
      '110230814=      PROFIT_    = 0;'
      '110230815=      FOR SELECT GP.NAME,'
      '110230816=                 GP.G_PRODUCT'
      '110230817=           FROM G_PRODUCT GP'
      '110230818=          WHERE IS_CATEGORY = 1'
      '110230819=            AND EXISTS (SELECT 1'
      
        '110230820=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110230821=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110230822=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110230823=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110230824=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110230825=                           AND Z.IS_SPISANIE = 2'
      '110230826=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110230827=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110230828=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058 +
        ' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230829=                           AND COALESCE(Z.G_OFFICIAL, ' +
        '0) = COALESCE(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' ' +
        #1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230830=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110230831=                           AND ((EXISTS (SELECT 1'
      
        '110230832=                                           FROM SKLAD ' +
        'S'
      
        '110230833=                                          WHERE S.G_CL' +
        'IENT = :G_SUPPLIER_'
      
        '110230834=                                            AND S.G_PR' +
        'ODUCT = G.G_PRODUCT'
      
        '110230835=                                            AND :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLI' +
        'ER_, 0) <> 0)'
      '110230836=                                  OR'
      
        '110230837=                                  COALESCE(:G_SUPPLIER' +
        '_, 0) = 0)'
      '110230838=                           )'
      '110230839=          ORDER BY 1'
      '110230840=      INTO :RECCAT_NAME_,'
      '110230841=           :RECCAT_PRODUCT_'
      '110230842=      DO BEGIN'
      '110230843=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230844=        insert into p_rep_profit_table'
      '110230845=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110230846=        values'
      
        '110230847=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110230848='
      '110230849=        FOR SELECT Z.ZAKAZ,'
      '110230850=                   Z.G_TOCHKA,'
      '110230851=                   Z.Z_DATE,'
      '110230852=                   Z.G_CLIENT,'
      '110230853=                   C.NAME CLIENT_NAME,'
      '110230854=                   Z.G_PAYMENT_TYPE,'
      '110230855=                   P.NAME PAYMENT_NAME,'
      '110230856=                   Z.OSNOVANIE,'
      '110230857=                   G.G_PRODUCT,'
      '110230858=                   G.G_PRODUCT_PAR,'
      '110230859=                   G.NAME TOVAR_NAME,'
      '110230860=                   ZD.AMOUNT,'
      '110230861=                   ZD.PRICE,'
      '110230862=                   ZD.SUMM,'
      '110230863=                   ZD.DISCOUNT_PERC,'
      '110230864=                   ZD.DISCOUNT_SUMM,'
      '110230865=                   ZD.NDS,'
      '110230866=                   ZD.NDS_SUMM,'
      '110230867=                   ZD.COST_PRICE'
      
        '110230868=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110230869=                   ZAKAZ_DETAILS ZD,'
      '110230870=                   G_PRODUCT G,'
      '110230871=                   G_PAYMENT_TYPE P'
      
        '110230872=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_' +
        'TOCHKA||'#39'-'#39
      '110230873=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110230874=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110230875=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110230876=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_ ' +
        ' -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110230877=               AND Z.IS_SPISANIE = 2                  ' +
        '  -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '110230878=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110230879=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110230880=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '110230881=               AND COALESCE(Z.G_OFFICIAL, 0) = COALESC' +
        'E(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054 +
        #1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230882=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110230883=               AND ((EXISTS (SELECT 1'
      '110230884=                               FROM SKLAD S'
      
        '110230885=                              WHERE S.G_CLIENT = :G_SU' +
        'PPLIER_'
      
        '110230886=                                AND S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '110230887=                                AND :G_TOCHKA_ARR_ CON' +
        'TAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0' +
        ')'
      '110230888=                      OR'
      '110230889=                      COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110230890=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110230891=        INTO :REC_ZAKAZ_,'
      '110230892=            :REC_G_TOCHKA_,'
      '110230893=            :REC_Z_DATE_,'
      '110230894=            :REC_G_CLIENT_,'
      '110230895=            :REC_CLIENT_NAME_,'
      '110230896=            :REC_G_PAYMENT_TYPE_,'
      '110230897=            :REC_PAYMENT_NAME_,'
      '110230898=            :REC_OSNOVANIE_,'
      '110230899=            :REC_G_PRODUCT_,'
      '110230900=            :REC_G_PRODUCT_PAR_,'
      '110230901=            :REC_TOVAR_NAME_,'
      '110230902=            :REC_AMOUNT_,'
      '110230903=            :REC_PRICE_,'
      '110230904=            :REC_SUMM_,'
      '110230905=            :REC_DISCOUNT_PERC_,'
      '110230906=            :REC_DISCOUNT_SUMM_,'
      '110230907=            :REC_NDS_,'
      '110230908=            :REC_NDS_SUMM_,'
      '110230909=            :REC_PRICE_SELF_'
      '110230910=        DO BEGIN'
      
        '110230911=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF' +
        '_;'
      
        '110230912=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - ' +
        'REC_NDS_SUMM_;'
      '110230913='
      '110230914=          insert into p_rep_profit_table'
      
        '110230915=            (p_rep_profit_table, zakaz, g_tochka, z_da' +
        'te, g_client, client_name, g_payment_type, payment_name,'
      
        '110230916=             osnovanie, g_product, g_product_par, tova' +
        'r_name, amount, price, summ, discount_perc, discount_summ,'
      
        '110230917=             nds, nds_summ, price_self, sum_self, prof' +
        'it, is_head)'
      '110230918=          values'
      '110230919=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110230920=            :REC_ZAKAZ_,'
      '110230921=            :REC_g_tochka_,'
      
        '110230922=            :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      '110230923=             :REC_osnovanie_,'
      '110230924=             :REC_g_product_,'
      '110230925=             :REC_g_product_par_,'
      '110230926=             :REC_tovar_name_,'
      '110230927=             :REC_amount_,'
      '110230928=             :REC_price_,'
      '110230929=             :REC_summ_,'
      '110230930=             :REC_discount_perc_,'
      '110230931=             :REC_discount_summ_,'
      
        '110230932=             :REC_nds_, :REC_nds_summ_, :REC_price_sel' +
        'f_, :REC_SUM_COST_, :REC_profit_, 0);'
      '110230933='
      
        '110230934=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_' +
        ', 0);'
      
        '110230935=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_CO' +
        'ST_, 0);'
      
        '110230936=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SU' +
        'MM_, 0);'
      
        '110230937=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_,' +
        ' 0);'
      '110230938=        END'
      '110230939='
      '110230940=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110230941=        insert into p_rep_profit_table'
      
        '110230942=          (p_rep_profit_table, tovar_name, summ, sum_s' +
        'elf, NDS_SUMM, profit, is_head)'
      '110230943=        values'
      
        '110230944=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39',' +
        ' :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110230945='
      
        '110230946=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_' +
        ';'
      '110230947=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '110230948=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '110230949=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '110230950='
      '110230951=        SUM_ZAKAZ_ = 0;'
      '110230952=        SUM_COST_  = 0;'
      '110230953=        NDS_SUMM_  = 0;'
      '110230954=        PROFIT_    = 0;'
      '110230955=      END'
      '110230956='
      '110230957=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110230958=      insert into p_rep_profit_table'
      
        '110230959=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110230960=      values'
      
        '110230961=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SUM' +
        'M_REAL_, :PROFIT_REAL_, 2);'
      '110230962='
      
        '110230963=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL' +
        '_;'
      
        '110230964=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL' +
        '_;'
      '110230965=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '110230966=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '110230967=  END'
      '110230968=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110230969=  --**************************************************' +
        '***************************************'
      '110230970=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '110230971='
      '110230972=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '110230973=  insert into p_rep_profit_table'
      '110230974=    (p_rep_profit_table, is_head)'
      '110230975=  values'
      '110230976=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110230977='
      '110230978=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '110230979=  insert into p_rep_profit_table'
      
        '110230980=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110230981=  values'
      
        '110230982=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072#1079 +
        #1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT_' +
        'ALL_, 1);'
      '110230983='
      '110230984=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '110230985=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110230986=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110230987=         SUM(Z.SUMM_BONUS)'
      '110230988=    FROM ZAKAZ Z'
      
        '110230989=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      
        '110230990=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1089 +
        #1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '110230991=     AND Z.IS_RESERVE = 0'
      '110230992=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110230993=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110230994=     AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFFIC' +
        'IAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '110230995=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110230996=     AND ((EXISTS (SELECT 1'
      '110230997=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '110230998=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '110230999=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1102301000=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1102301001=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102301002=          OR'
      '1102301003=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102301004=    INTO :SUMM_CASH_ALL_,'
      '1102301005=         :SUMM_NONCASH_ALL_,'
      '1102301006=         :SUMM_BONUS_ALL_;'
      '1102301007='
      '1102301008=  SELECT SUM(NAL),'
      '1102301009=         SUM(BEZNAL)'
      
        '1102301010=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHE' +
        'RE K.SKLAD = SP.SKLAD) NAL,'
      
        '1102301011=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL' +
        ' KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '1102301012=           FROM SKLAD_PARENT SP'
      
        '1102301013=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '1102301014=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102301015=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '1102301016=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, CO' +
        'ALESCE(SP.G_CLIENT, 0))'
      
        '1102301017=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYME' +
        'NT_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '1102301018=        )'
      '1102301019=  INTO :SUMM_VOZVRAT_NAL_,'
      '1102301020=       :SUMM_VOZVRAT_BEZNAL_;'
      '1102301021='
      
        '1102301022=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COAL' +
        'ESCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '1102301023=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) ' +
        '- COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '1102301024=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1102301025='
      '1102301026=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1102301027='
      
        '1102301028=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1102301029=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1102301030='
      '1102301031=/*  insert into p_rep_profit_table'
      
        '1102301032=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102301033=  values'
      
        '1102301034=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1102301035='
      '1102301036=  insert into p_rep_profit_table'
      '1102301037=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1102301038=  values'
      
        '1102301039=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1102301040='
      '1102301041=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1102301042=    SELECT G.NAME'
      '1102301043=      FROM G_CLIENT G'
      '1102301044=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102301045=    INTO :CLIENT_NAME_;'
      '1102301046=  ELSE'
      '1102301047=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102301048='
      '1102301049=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1102301050=    SELECT G.NAME'
      '1102301051=      FROM G_PAYMENT_TYPE G'
      '1102301052=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1102301053=    INTO :PAYMENT_NAME_;'
      '1102301054=  ELSE'
      '1102301055=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102301056='
      '1102301057=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1102301058=        P.ZAKAZ,'
      '1102301059=        P.G_TOCHKA,'
      '1102301060=        P.Z_DATE,'
      '1102301061=        P.G_CLIENT,'
      '1102301062=        P.CLIENT_NAME,'
      '1102301063=        P.G_PAYMENT_TYPE,'
      '1102301064=        P.PAYMENT_NAME,'
      '1102301065=        P.OSNOVANIE,'
      '1102301066=        P.G_PRODUCT,'
      '1102301067=        P.G_PRODUCT_PAR,'
      '1102301068=        P.TOVAR_NAME,'
      '1102301069=        G.ARTICUL,'
      '1102301070=        G.NOMENCLATUR_NUM,'
      '1102301071=        G.BARCODE,'
      '1102301072=        P.AMOUNT,'
      
        '1102301073=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1102301074=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1102301075=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102301076=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102301077=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1102301078=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102301079=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102301080=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102301081=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1102301082=        P.IS_HEAD'
      
        '1102301083=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1102301084=    ORDER BY 1'
      '1102301085=  INTO :P_REP_PROFIT_TABLE,'
      '1102301086=       :ZAKAZ,'
      '1102301087=       :G_TOCHKA,'
      '1102301088=       :Z_DATE,'
      '1102301089=       :G_CLIENT,'
      '1102301090=       :CLIENT_NAME,'
      '1102301091=       :G_PAYMENT_TYPE,'
      '1102301092=       :PAYMENT_NAME,'
      '1102301093=       :OSNOVANIE,'
      '1102301094=       :G_PRODUCT,'
      '1102301095=       :G_PRODUCT_PAR,'
      '1102301096=       :TOVAR_NAME,'
      '1102301097=       :ARTICUL,'
      '1102301098=       :NOMENCLATUR_NUM,'
      '1102301099=       :BARCODE,'
      '1102301100=       :AMOUNT,'
      '1102301101=       :PRICE,'
      '1102301102=       :SUMM,'
      '1102301103=       :DISCOUNT_PERC,'
      '1102301104=       :DISCOUNT_SUMM,'
      '1102301105=       :NDS,'
      '1102301106=       :NDS_SUMM,'
      '1102301107=       :PRICE_SELF,'
      '1102301108=       :SUM_SELF,'
      '1102301109=       :PROFIT,'
      '1102301110=       :IS_HEAD'
      '1102301111=  DO'
      '1102301112=    suspend;'
      '1102301113='
      '1102301114=WHEN ANY DO BEGIN'
      '1102301115=    Err_code = -20500;'
      
        '1102301116=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102301117=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102301118=  END'
      '1102301119=end'
      '1102301120=;'
      '1102301121='
      '1102301122='
      
        '1102301123=UPDATE SYSTEM_SETUP SET S_VALUE = 110230 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102301124=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102301125=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102310='
      '1102311=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1102312=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102313=  INCLUDE_NOL_ INTEGER,'
      '1102314=  INCLUDE_FEW_ INTEGER,'
      '1102315=  SORT_BY_NAME_ INTEGER,'
      
        '1102316=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      '1102317=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39','
      '1102318=  IS_EXPORT_ INTEGER = 0)'
      '1102319=RETURNS ('
      '11023110=  PERIOD_ VARCHAR(40),'
      '11023111=  ROW_NUM VARCHAR(15),'
      '11023112=  ARTICUL VARCHAR(1000),'
      
        '11023113=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11023114=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11023115=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
