      '11014718=RETURNS ('
      '11014719=  ERR_CODE INTEGER,'
      '11014720=  ERR_MSG VARCHAR(1000))'
      '11014721=AS'
      
        '11014722=/*ROUND_MODE_ 0 - '#1076#1077#1089#1103#1090#1099#1077', 1 - '#1094#1077#1083#1099#1077', 2 '#1076#1077#1089#1103#1090#1082#1080', 3 '#1089#1086#1090#1085 +
        #1080', 4 '#1090#1099#1089#1103#1095#1080
      '11014723='
      '11014724=CHANGE_KIT_TYPE_ - '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040
      '11014725=*/'
      
        '11014726=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '11014727=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE;'
      
        '11014728=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.VO' +
        'LUME_PRICE;'
      '11014729=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '11014730=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '11014731=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11014732=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '11014733=BEGIN'
      '11014734='
      '11014735=  SQL_STR_ = '#39'UPDATE G_PRODUCT P'#39'||'
      '11014736=               '#39' SET '#39';'
      '11014737='
      '11014738=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '11014739='
      '11014740=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '11014741=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '11014742=      IF (ROUND_MODE_ = 0) THEN'
      '11014743=          ROUND_ = 1;'
      '11014744=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '11014745=          ROUND_ = 0;'
      '11014746=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '11014747=          ROUND_ = -1;'
      '11014748=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '11014749=          ROUND_ = -2;'
      '11014750=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '11014751=          ROUND_ = -3;'
      '11014752='
      '11014753=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' %'
      '11014754=      IF (MODE_ = 0) THEN'
      
        '11014755=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE ' +
        '* (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '11014756=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '11014757='
      '11014758=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '11014759=      ELSE IF (MODE_ = 1) THEN'
      
        '11014760=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE ' +
        '+ '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '11014761=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '11014762='
      '11014763=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' %'
      '11014764=      ELSE IF (MODE_ = 2) THEN'
      
        '11014765=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE ' +
        '* (1 - '#39'||:NEW_VAL_||'#39'/100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '11014766=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE * (1 - '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '11014767='
      '11014768=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '11014769=      ELSE IF (MODE_ = 3) THEN'
      
        '11014770=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE ' +
        '- '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '11014771=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '11014772='
      '11014773=      --'#1048#1047#1052#1045#1053#1048#1058#1068' '#1055#1054' '#1042#1040#1051#1070#1058#1045
      '11014774=      ELSE IF (MODE_ = 4) THEN'
      
        '11014775=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE/' +
        #39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '11014776=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '11014777='
      '11014778=      ELSE BEGIN'
      '11014779=        SELECT ID'
      '11014780=          FROM CUR_PARAMS'
      '11014781=         WHERE CUR_PARAMS = 2'
      '11014782=          INTO :G_TOCHKA_;'
      '11014783='
      '11014784=        IF (WHAT_PRICE_ = 0) THEN'
      
        '11014785=          SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND((SELEC' +
        'T * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_||'#39', 0)) ' +
        '* (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '11014786=        ELSE'
      
        '11014787=          SQL_STR_ = SQL_STR_ ||'#39'P.VOLUME_PRICE = ROUND' +
        '((SELECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_||' +
        #39', 0)) * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '11014788=      END'
      '11014789=  END'
      '11014790='
      '11014791=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '11014792=  IF (CHANGE_CATEGORY_ = 1) THEN BEGIN'
      '11014793=    IF (CHANGE_PRICE_ = 1) THEN'
      '11014794=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '11014795='
      
        '11014796=    SQL_STR_ = SQL_STR_ ||'#39'P.G_PRODUCT_PAR = '#39'||:NEW_CA' +
        'TEGORY_;'
      '11014797=  END'
      '11014798='
      '11014799=  -- '#1052#1045#1053#1071#1070' '#1052#1048#1053' '#1054#1057#1058#1040#1058#1054#1050
      '110147100=  IF (CHANGE_MIN_AMOUNT_ = 1) THEN BEGIN'
      '110147101=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_) > 0) THEN'
      '110147102=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110147103='
      
        '110147104=    SQL_STR_ = SQL_STR_ ||'#39'P.MIN_AMOUNT = '#39'||:NEW_MIN_' +
        'AMOUNT_;'
      '110147105=  END'
      '110147106='
      '110147107=  -- '#1052#1045#1053#1071#1070' '#1050#1054#1052#1048#1057#1057#1048#1070' '#1055#1056#1054#1044#1040#1042#1062#1040
      '110147108=  IF (CHANGE_SALES_COMM_ = 1) THEN BEGIN'
      
        '110147109=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_) > 0) THEN'
      '110147110=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110147111='
      
        '110147112=    SQL_STR_ = SQL_STR_ ||'#39'P.SALES_COMM = '#39'||:NEW_SALE' +
        'S_COMM_;'
      '110147113=  END'
      '110147114='
      
        '110147115=  -- '#1052#1045#1053#1071#1070' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040' - '#1057' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1053#1040' '#1055#1056#1054#1044#1059#1050#1058' '#1048#1051#1048' '#1053 +
        #1040#1054#1041#1054#1056#1054#1058
      '110147116=  IF (CHANGE_KIT_TYPE_ > 1) THEN BEGIN'
      
        '110147117=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_ + CHANGE_SALES_COMM_) > 0) THEN'
      '110147118=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110147119='
      
        '110147120=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KIT = '#39'||:CHANGE_KIT_T' +
        'YPE_;'
      '110147121='
      
        '110147122=    -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1058#1048#1055' '#1058#1054#1042#1040#1056#1040' '#1057' "'#1057#1054#1057#1058#1040#1042#1053#1054#1049'" '#1053#1040' "'#1055#1056#1054#1044 +
        #1059#1050#1058'", '#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1053#1059#1051#1048#1058#1068' '#1042#1057#1045' '#1054#1057#1058#1040#1058#1050#1048' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042
      '110147123=    IF (CHANGE_KIT_TYPE_ = 2) THEN'
      '110147124=      UPDATE LT_SKLAD_PRODUCT P'
      '110147125=         SET P.AMOUNT = 0'
      '110147126=       WHERE EXISTS (SELECT 1'
      '110147127=                       FROM G_PRODUCT GP'
      '110147128=                      WHERE GP.G_PRODUCT = P.G_PRODUCT'
      '110147129=                        AND GP.IS_KIT = 1'
      
        '110147130=                        AND ((:G_PRODUCT_ CONTAINING '#39 +
        '~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110147131=                             OR'
      
        '110147132=                             (GP.G_PRODUCT = GP.G_PROD' +
        'UCT AND :G_PRODUCT_ IS NULL)'
      '110147133=                            )'
      '110147134=                        AND ('
      
        '110147135=                             ((GP.G_PRODUCT_PAR IN (SE' +
        'LECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE :G_CATEGORY_ CONTAINI' +
        'NG '#39'~'#39'||PT.G_PRODUCT||'#39'~'#39')) AND :g_category_ IS NOT NULL)'
      '110147136=                              OR'
      
        '110147137=                             (GP.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT AND :g_category_ IS NULL)'
      '110147138=                            )'
      '110147139=                    );'
      '110147140=  END'
      '110147141='
      '110147142=  SQL_STR_ = SQL_STR_ ||'#39' WHERE P.IS_ACTIVE = 1'#39';'
      '110147143='
      '110147144=  IF (CHANGE_KIT_TYPE_ = 0) THEN'
      '110147145=    SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_KIT <> 1'#39';'
      '110147146='
      '110147147=  SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_CATEGORY = 0'#39';'
      '110147148='
      '110147149=  IF (g_category_ IS NOT NULL) THEN'
      
        '110147150=    SQL_STR_ = SQL_STR_ ||'#39' AND P.G_PRODUCT_PAR IN (SE' +
        'LECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE '#39#39#39'||G_CATEGORY_||'#39#39#39 +
        ' CONTAINING '#39#39'~'#39#39'||PT.G_PRODUCT||'#39#39'~'#39#39')'#39';'
      '110147151='
      '110147152='
      '110147153=  IF (G_PRODUCT_ IS NOT NULL) THEN'
      
        '110147154=    SQL_STR_ = SQL_STR_ ||'#39' AND '#39#39#39'||G_PRODUCT_||'#39#39#39' C' +
        'ONTAINING '#39#39'~'#39#39'||P.G_PRODUCT||'#39#39'~'#39#39#39';'
      '110147155='
      '110147156=  --ERR_CODE = -20500;'
      '110147157=  --ERR_MSG = SQL_STR_; EXIT;'
      '110147158='
      '110147159=  EXECUTE STATEMENT :SQL_STR_;'
      '110147160=END'
      '110147161=;'
      '110147162='
      '110147163='
      
        '110147164=UPDATE SYSTEM_SETUP SET S_VALUE = 110147 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110147165=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110147166=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101480='
      '1101481=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      '1101482=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT,'
      '1101483=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101484=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101485=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1101486=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1101487=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1101488=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1101489=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '11014810=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '11014811=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '11014812=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '11014813=  IS_SPISANIE_ INTEGER,'
      '11014814=  NEW_LINE_SALE_ INTEGER = 0,'
      '11014815=  MODE_ INTEGER = 0,'
      '11014816=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '11014817=  DO_PRODUCT_IN_SALE_ INTEGER = 0)'
      '11014818=RETURNS ('
      
        '11014819=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '11014820=  ERR_CODE INTEGER,'
      '11014821=  ERR_MSG VARCHAR(1024))'
      '11014822=AS'
      '11014823=/*'
      
        '11014824=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048#1058 +
        #1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '11014825=*/'
      
        '11014826=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DETA' +
        'ILS_TMP'#39';'
      '11014827=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '11014828=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0;'
      
        '11014829=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.AMOUNT = 0;'
      
        '11014830=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0;' +
        ' /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047#1040 +
        #1050#1040#1047' */'
      
        '11014831=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' */'
      
        '11014832=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '11014833=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.Z_TYPE = 0;'
      
        '11014834=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.PRICE;'
      
        '11014835=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.COST_PRICE;'
      
        '11014836=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '11014837=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KI' +
        'T;'
      
        '11014838=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051 +
        #1048#1062#1045' */'
      
        '11014839=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040 +
        #1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' '#1062 +
        #1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '11014840=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKL' +
        'AD;'
      '11014841=BEGIN'
      '11014842='
      
        '11014843=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070#1058 +
        ' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '11014844=  SELECT T.ZAKAZ, T.Z_TYPE'
      '11014845=    FROM ZAKAZ_DETAILS_TMP T'
      '11014846=   WHERE T.ZAKAZ IS NOT NULL'
      
        '11014847=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089#1090 +
        #1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072' ' +
        'MULTIPLE ROWS IN SINGLETON SELECT'
      '11014848=    INTO :ZAKAZ_, :Z_TYPE_;'
      '11014849='
      
        '11014850=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051#1045 +
        #1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11014851=           ,G.IS_KIT'
      '11014852=           ,K.AMOUNT * :AMOUNT_'
      '11014853=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '11014854=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRIC' +
        'E)'
      '11014855=           ,(CASE'
      
        '11014856=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE_' +
        ' in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * F' +
        'ROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '11014857=             ELSE K.PRICE'
      '11014858=           END) COST_PRICE'
      
        '11014859=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_LA' +
        'ST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '11014860=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE G' +
        '_PRODUCT = :G_PRODUCT_) CNT'
      
        '11014861=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K ' +
        'ON G.G_PRODUCT = K.G_PRODUCT'
      '11014862=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11014863=       AND G.IS_KIT = 1'
      '11014864=    UNION'
      
        '11014865=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054#1044 +
        #1040#1046
      '11014866=           ,G.IS_KIT'
      '11014867=           ,:AMOUNT_'
      '11014868=           ,:PRICE_'
      '11014869=           ,0'
      '11014870=           ,:COST_PRICE_'
      '11014871=           ,0'
      '11014872=      FROM G_PRODUCT G'
      '11014873=     WHERE G_PRODUCT = :G_PRODUCT_'
      '11014874=       AND G.IS_KIT <> 1'
      '11014875=      INTO :G_PRODUCT_'
      '11014876=           ,:IS_KIT_'
      '11014877=           ,:AMOUNT_'
      '11014878=           ,:PRICE__'
      '11014879=           ,:SOSTAV_PRICE_'
      '11014880=           ,:COST_PRICE__'
      '11014881=           ,:SOSTAV_COUNT_'
      '11014882=  DO BEGIN'
      '11014883=      ZAKAZ_DTLS_TMP_ = NULL;'
      '11014884='
      
        '11014885=      --===============================================' +
        '============'
      '11014886=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11014887=      SELECT AMOUNT - AMOUNT_RESERVE'
      '11014888=        FROM LT_SKLAD_PRODUCT L'
      '11014889=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '11014890=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11014891=       INTO :AMOUNT_CUR_;'
      '11014892='
      
        '11014893=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056 +
        #1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '11014894=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040#1050 +
        #1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '11014895=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '11014896=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051#1054 +
        ', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068#1050 +
        #1054
      
        '11014897=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068' ' +
        #1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11014898=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '11014899=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110148100=          SELECT SUM(AMOUNT)'
      '110148101=            FROM ZAKAZ_DETAILS T'
      '110148102=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110148103=             AND T.ZAKAZ = :ZAKAZ_'
      '110148104=            INTO :AMOUNT_OLD_;'
      '110148105=        ELSE'
      '110148106=          SELECT SUM(AMOUNT)'
      '110148107=            FROM SKLAD T'
      '110148108=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110148109=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110148110=            INTO :AMOUNT_OLD_;'
      '110148111=      END'
      '110148112='
      '110148113=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110148114=      SELECT SUM(AMOUNT)'
      '110148115=        FROM ZAKAZ_DETAILS_TMP T'
      '110148116=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110148117=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110148118='
      
        '110148119=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_, ' +
        '0) + :AMOUNT_;'
      '110148120=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '110148121='
      
        '110148122=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110148123='
      
        '110148124=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '110148125=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042 +
        #1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110148126=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) T' +
        'HEN BEGIN'
      '110148127=            PNT_ = '#39'01'#39';'
      
        '110148128=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FR' +
        'OM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      '110148129=                                         CURRENT_DATE,'
      '110148130=                                         :G_PRODUCT_,'
      
        '110148131=                                         ABS(AMOUNT_CU' +
        'R_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUN' +
        'T_,'
      
        '110148132=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086 +
        ' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110148133=                                         )'
      
        '110148134=                RETURNING_VALUES :SKLAD_, :COST_PRICE_' +
        '_, :ERR_CODE, :ERR_MSG;'
      '110148135=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110148136=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110148137=              EXIT;'
      '110148138=            END'
      '110148139=        END'
      
        '110148140=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_PR' +
        'ODUCT_ <> -2) THEN BEGIN'
      '110148141=            SELECT NAME'
      '110148142=            FROM G_PRODUCT'
      '110148143=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110148144=            INTO :PRODUCT_NAME_;'
      '110148145='
      '110148146=            ERR_CODE = -20500;'
      
        '110148147=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110148148=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110148149=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110148150=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110148151=            EXIT;'
      '110148152=        END'
      '110148153=      END'
      '110148154=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110148155=      --==============================================' +
        '============='
      '110148156='
      
        '110148157=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110148158=      IF (IS_KIT_ = 1) THEN BEGIN'
      
        '110148159=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN    06.10.2' +
        '020 - '#1103' '#1085#1077' '#1087#1086#1085#1103#1083' '#1085#1072#1093' '#1101#1090#1086' '#1073#1099#1083#1086' '#1085#1091#1078#1085#1086' '#1074#1086#1086#1073#1097#1077
      '110148160=        --    PRICE__ = SOSTAV_PRICE_;'
      '110148161=        --END ELSE BEGIN'
      '110148162=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110148163=              PRICE__ = COST_PRICE__;'
      '110148164='
      
        '110148165=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110148166=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110148167='
      '110148168='
      
        '110148169=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110148170=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110148171=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110148172=            END'
      '110148173='
      
        '110148174=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110148175=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110148176=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110148177=        --END'
      '110148178=      END'
      '110148179='
      
        '110148180=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '110148181=      IF (NEW_LINE_SALE_ = 0) THEN'
      '110148182=          SELECT ZD.zakaz_details'
      '110148183=            FROM zakaz_details_tmp ZD'
      '110148184=           WHERE ZD.G_PRODUCT = :g_product_'
      '110148185=             AND ZD.PRICE = :PRICE__'
      '110148186=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110148187=            INTO :ZAKAZ_DTLS_TMP_;'
      '110148188='
      '110148189='
      '110148190=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110148191=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110148192=           SET P.amount = P.amount + :amount_'
      
        '110148193=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110148194=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110148195=               ,P.NDS = :NDS_'
      '110148196=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110148197=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110148198='
      '110148199=      ELSE BEGIN'
      '110148200=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110148201=          ('
      '110148202=           ZAKAZ_DETAILS,'
      '110148203=           ZAKAZ,'
      '110148204=           G_PRODUCT,'
      '110148205=           AMOUNT,'
      '110148206=           PRICE,'
      '110148207=           SUMM,'
      '110148208=           DISCOUNT_PERC,'
      '110148209=           DISCOUNT_TENGE,'
      '110148210=           DISCOUNT_SUMM,'
      '110148211=           NDS,'
      '110148212=           NDS_SUMM,'
      '110148213=           COST_PRICE'
      '110148214=          ) VALUES ('
      '110148215=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110148216=           :ZAKAZ_,'
      '110148217=           :G_PRODUCT_,'
      '110148218=           :AMOUNT_,'
      '110148219=           :PRICE__,'
      '110148220=           :SUMM_,'
      '110148221=           :DISCOUNT_PERC_,'
      '110148222=           :DISCOUNT_TENGE_,'
      '110148223=           :DISCOUNT_SUMM_,'
      '110148224=           :NDS_,'
      '110148225=           :NDS_SUMM_,'
      '110148226=           :COST_PRICE__'
      '110148227=          )'
      '110148228=          RETURNING'
      '110148229=            ZAKAZ_DETAILS'
      '110148230=          INTO'
      '110148231=            :ZAKAZ_DETAILS_;'
      '110148232=      END'
      '110148233=  END'
      '110148234=end'
      '110148235=;'
      '110148236='
      '110148237='
      
        '110148238=UPDATE SYSTEM_SETUP SET S_VALUE = 110148 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110148239=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110148240=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101490=UPDATE SYSTEM_SETUP SET S_VALUE = 110149 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101491=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101492=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101500=UPDATE SYSTEM_SETUP SET S_VALUE = 110150 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101501=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101502=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101510='
      '1101511=ALTER PROCEDURE P_REP_TOVAR_OSTATOK_ON_DATE('
      '1101512=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101513=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101514=  DATE_ DATE,'
      '1101515=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101516=RETURNS ('
      '1101517=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101518=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101519=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11015110=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11015111=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '11015112=  SUMM MY_NUMERIC,'
      '11015113=  ERR_CODE INTEGER,'
      '11015114=  ERR_MSG VARCHAR(1024))'
      '11015115=AS'
      
        '11015116=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_OS' +
        'TATOK_ON_DATE'#39';'
      '11015117=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11015118=DECLARE VARIABLE G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT_PAR;'
      
        '11015119=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      '11015120=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '11015121=BEGIN'
      '11015122='
      '11015123=  SELECT S.S_VALUE,'
      '11015124=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '11015125=    FROM SYSTEM_SETUP S'
      '11015126=   WHERE S.SYSTEM_SETUP = 1'
      '11015127=    INTO :FORMULA_,'
      '11015128=         :PRIHOD_CNT_;'
      '11015129='
      '11015130=  FOR WITH OSTATOK_ARR AS (SELECT GP.NAME,'
      '11015131=                               GP.BARCODE,'
      '11015132=                               GP.ARTICUL,'
      '11015133=                               GP.PRICE,'
      '11015134=                               GP.G_PRODUCT,'
      '11015135=                               GP.G_PRODUCT_PAR,'
      
        '11015136=                               (select (select sum(amou' +
        'nt) from lt_sklad_product where g_product = GP.G_PRODUCT'
      
        '11015137=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||g_tochka||'#39'-'#39')'
      
        '11015138=                                        +  -- '#1090#1086#1074#1072#1088' '#1085#1072' ' +
        #1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '11015139=                                       (select COALESCE' +
        '(sum(zr.AMOUNT_ALL), 0) from zakaz_na_real zr, zakaz_real_parent' +
        ' zrp'
      
        '11015140=                                        where zr.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCH' +
        'KA||'#39'-'#39
      
        '11015141=                                        and zr.ZAKAZ_RE' +
        'AL_PARENT = zrp.ZAKAZ_REAL_PARENT'
      
        '11015142=                                        and zrp.ZAKAZ_D' +
        'ATE > :DATE_)'
      '11015143=                                       +'
      
        '11015144=                                       (select COALESCE' +
        '(sum(zd.amount), 0) from zakaz_details zd, zakaz z'
      
        '11015145=                                        where zd.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA' +
        '||'#39'-'#39
      
        '11015146=                                        and zd.zakaz = ' +
        'z.zakaz and z.z_date > :DATE_'
      
        '11015147=                                        and z.IS_SPISAN' +
        'IE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' ' +
        #1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '11015148=                                        and not (z.IS_S' +
        'PISANIE = 0 and z.NOT_MINUS_OSTATOK = 1))'
      '11015149=                                       +'
      
        '11015150=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and s.is_vozvrat = 3'
      
        '11015151=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt > :DATE_)'
      '11015152=                                       +'
      
        '11015153=                                       (select COALESCE' +
        '(sum(od.amount), 0) from other_details od, other o'
      
        '11015154=                                        where od.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA' +
        '||'#39'-'#39
      
        '11015155=                                        and od.other = ' +
        'o.other and o.op_date > :DATE_)'
      '11015156=                                       -'
      
        '11015157=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '11015158=                                        and s.is_vozvra' +
        't <> 3 and s.date_receipt > :DATE_)'
      '11015159=                                       -'
      
        '11015160=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and s.is_vozvrat = 3'
      
        '11015161=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt > :DATE_)'
      
        '11015162=                                  from rdb$database) AM' +
        'OUNT'
      '11015163=                          FROM G_PRODUCT GP'
      '11015164=                         WHERE GP.IS_ACTIVE = 1'
      '11015165=                           AND GP.IS_CATEGORY = 0'
      
        '11015166=                           AND ((:G_CATEGORY_ CONTAININ' +
        'G '#39'~'#39'||GP.G_PRODUCT_PAR||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11015167=                                 OR'
      '11015168=                                 (:G_CATEGORY_ IS NULL)'
      '11015169=                               )'
      
        '11015170=                           AND ((:G_PRODUCT_ CONTAINING' +
        ' '#39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11015171=                                 OR'
      '11015172=                                 (:G_PRODUCT_ IS NULL)'
      '11015173=                               )'
      '11015174=                           --AND GP.G_PRODUCT = 2874'
      '11015175=                               )'
      
        '11015176=    SELECT (SELECT NAME FROM G_PRODUCT GG WHERE GG.G_PR' +
        'ODUCT = A.G_PRODUCT_PAR)||'#39' / '#39'||A.NAME,'
      '11015177=           A.BARCODE,'
      '11015178=           A.ARTICUL,'
      '11015179=           COALESCE(A.AMOUNT, 0) * A.PRICE,'
      '11015180=           A.G_PRODUCT_PAR,'
      '11015181=           COALESCE(A.AMOUNT, 0) AMOUNT'
      
        '11015182=           ,COALESCE(CAST(A.AMOUNT AS NUMERIC), 0) * CO' +
        'ALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '11015183=                                                       ' +
        '       -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058 +
        #1068#1057#1071' '#1058#1040#1050
      
        '11015184=                                                       ' +
        '       -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 '#1047#1040#1050#1059#1055#1054#1050
      
        '11015185=                                                       ' +
        '       -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '11015186=                                                       ' +
        '       -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 200 '#1047#1040#1050#1059#1055#1054#1050
      
        '11015187=                                                       ' +
        '       DECODE(:FORMULA_,'
      
        '11015188=                                                       ' +
        '              1,'
      
        '11015189=                                                       ' +
        '              (SELECT S.price'
      
        '11015190=                                                       ' +
        '                 FROM SKLAD S'
      
        '11015191=                                                       ' +
        '                WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      
        '11015192=                                                       ' +
        '                  AND S.g_product = A.G_PRODUCT'
      
        '11015193=                                                       ' +
        '                  AND S.IS_VOZVRAT IN (0, 3, 4)'
      
        '11015194=                                                       ' +
        '                  AND S.date_receipt = (SELECT MAX(DD.DATE_RECEI' +
        'PT)'
      
        '11015195=                                                       ' +
        '                                          FROM SKLAD DD'
      
        '11015196=                                                       ' +
        '                                         WHERE DD.DATE_RECEIPT <' +
        '= :DATE_'
      
        '11015197=                                                       ' +
        '                                           AND DD.g_product = A.' +
        'G_PRODUCT'
      
        '11015198=                                                       ' +
        '                                           AND :G_TOCHKA_ARR_ CO' +
        'NTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '11015199=                                                       ' +
        '                                           AND DD.IS_VOZVRAT IN ' +
        '(0, 3, 4)'
      
        '110151100=                                                      ' +
        '                                          )'
      
        '110151101=                                                      ' +
        '                  ORDER BY 1 DESC'
      
        '110151102=                                                      ' +
        '                  ROWS 1 TO 1'
      
        '110151103=                                                      ' +
        '               ),'
      
        '110151104=                                                      ' +
        '               (SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUN' +
        'T), 2)'
      
        '110151105=                                                      ' +
        '                  FROM (SELECT S.AMOUNT, S.PRICE'
      
        '110151106=                                                      ' +
        '                          FROM SKLAD_PARENT SP,'
      
        '110151107=                                                      ' +
        '                               SKLAD S'
      
        '110151108=                                                      ' +
        '                         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP' +
        '.G_TOCHKA||'#39'-'#39
      
        '110151109=                                                      ' +
        '                           AND SP.DATE_RECEIPT <= :DATE_'
      
        '110151110=                                                      ' +
        '                           AND SP.SKLAD = S.SKLAD_PARENT'
      
        '110151111=                                                      ' +
        '                           AND S.G_PRODUCT = A.G_PRODUCT'
      
        '110151112=                                                      ' +
        '                           AND SP.IS_VOZVRAT IN (0, 3, 4)'
      
        '110151113=                                                      ' +
        '                          ORDER BY S.DATE_RECEIPT DESC, S.SKLAD ' +
        'DESC ROWS 1 TO 5) T)'
      
        '110151114=                                                      ' +
        '               ))'
      
        '110151115=                                                      ' +
        '        , 0'
      
        '110151116=                                                      ' +
        '        )'
      '110151117=      FROM OSTATOK_ARR A'
      '110151118=    ORDER BY NAME, G_PRODUCT_PAR'
      '110151119=    INTO :NAME,'
      '110151120=         :BARCODE,'
      '110151121=         :ARTICUL,'
      '110151122=         :PRICE,'
      '110151123=         :G_PRODUCT_PAR,'
      '110151124=         :AMOUNT,'
      '110151125=         :SUMM'
      '110151126=  DO'
      '110151127=    SUSPEND;'
      '110151128='
      '110151129=WHEN ANY DO BEGIN'
      '110151130=    Err_code = -20500;'
      
        '110151131=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110151132=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110151133=  END'
      '110151134=end'
      '110151135=;'
      '110151136='
      '110151137='
      
        '110151138=UPDATE SYSTEM_SETUP SET S_VALUE = 110151 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110151139=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110151140=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
