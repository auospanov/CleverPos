      '11022058=END'
      '11022059=;'
      '11022060='
      '11022061=ALTER PROCEDURE P_REP_ZAYAVKA_POSTAVSHIK('
      
        '11022062=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT,'
      '11022063=  BEGIN_DATE_ DATE,'
      '11022064=  END_DATE_ DATE,'
      
        '11022065=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      '11022066=  DO_SKLAD_ INTEGER,'
      '11022067=  MODE_ INTEGER,'
      '11022068=  MODE_VYBOR_ INTEGER,'
      '11022069=  MODE_VAL_ INTEGER,'
      '11022070=  NEW_VAL_ /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      '11022071=  ROUND_MODE_ INTEGER)'
      '11022072=RETURNS ('
      
        '11022073=  G_PRODUCT /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT,'
      
        '11022074=  CATEGORY_NAME /* TYPE OF COLUMN P_REP_TREE.PATH */ BL' +
        'OB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
