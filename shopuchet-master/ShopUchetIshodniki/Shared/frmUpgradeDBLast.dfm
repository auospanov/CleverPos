      '1102491258=              :AMOUNT,'
      '1102491259=              :PRICE,'
      '1102491260=              :SUMM,'
      '1102491261=              :DISCOUNT_PERC,'
      '1102491262=              :DISCOUNT_TENGE,'
      '1102491263=              :DISCOUNT_SUMM,'
      '1102491264=              :NDS,'
      '1102491265=              :NDS_SUMM'
      '1102491266=      DO BEGIN'
      '1102491267=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102491268=          UPDATE LT_SKLAD_PRODUCT L'
      '1102491269=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
