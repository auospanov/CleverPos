      '1102420='
      '1102421=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1102422=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102423=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
