        #39'||NEW.CREDIT||'#39#39' - '#39#39'||OLD.CREDIT||'#39#39', '#39'||'
      
        '1101351412=                           '#39'  C.OUTPUT = '#39#39'||NEW.INPU' +
        'T||'#39#39' - (C.DEBET + '#39#39'||NEW.DEBET||'#39#39' - '#39#39'||OLD.DEBET||'#39#39') + (C.C' +
        'REDIT + '#39#39'||NEW.CREDIT||'#39#39' - '#39#39'||OLD.CREDIT||'#39#39') '#39'||'
      
        '1101351413=                           '#39'WHERE C.K_DATE = '#39#39#39#39#39#39'||' +
        'NEW.K_DATE ||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1101351414='
      '1101351415=    END ELSE IF (TN = '#39'LT_SKLAD_PRODUCT'#39') THEN BEGIN'
      '1101351416=      TRGU = TRGU||'
      
        '1101351417=         '#39'  SQLSTMT='#39#39#39'||'#39'UPDATE LT_SKLAD_PRODUCT C S' +
        'ET '#39'||'
      
        '1101351418=                           '#39'  C.AMOUNT = C.AMOUNT + (' +
        #39#39'||NEW.AMOUNT||'#39#39' - '#39#39'||OLD.AMOUNT||'#39#39'), '#39'||'
      
        '1101351419=                           '#39'  C.AMOUNT_RESERVE = C.AM' +
        'OUNT_RESERVE + ('#39#39'||NEW.AMOUNT_RESERVE||'#39#39' - '#39#39'||OLD.AMOUNT_RESE' +
        'RVE||'#39#39') '#39'||'
      
        '1101351420=                           '#39'WHERE C.G_PRODUCT = '#39#39'||N' +
        'EW.G_PRODUCT ||'#39#39' AND C.G_TOCHKA = '#39#39'||NEW.G_TOCHKA;'#39'||CRLF;'
      '1101351421=    END ELSE BEGIN'
      '1101351422=      TRGU = TRGU||'
      '1101351423=         SQLU||'
      
        '1101351424=         '#39'  SQLSTMT=SQLSTMT||'#39#39' WHERE '#39'||ID_COLUMN||'#39 +
        '='#39#39'||OLD.'#39'||ID_COLUMN||'#39';'#39' ||CRLF;'
      '1101351425=    END'
      '1101351426=    TRGU = TRGU||'#39'  ID=GEN_ID(GEN_LOGS,1);'#39'||CRLF||'
      
        '1101351427=         '#39'  INSERT INTO LOGS(ID,SQLSTMT,USR) VALUES (' +
        ':ID,:SQLSTMT, '#39#39'SYSDBA'#39#39');'#39' ||CRLF||'
      '1101351428=         '#39'END'#39';'
      '1101351429=    SELECT COUNT(*)'
      '1101351430=      FROM RDB$TRIGGERS'
      '1101351431=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGD'#39
      '1101351432=      INTO :ANZ;'
      '1101351433=    IF (ANZ>0) THEN'
      '1101351434=      TRGDX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGD'#39';'
      '1101351435=    ELSE'
      '1101351436=      TRGDX='#39#39';'
      
        '1101351437=    TRGD='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGD FOR '#39'||TN||'#39' A' +
        'CTIVE AFTER DELETE POSITION 255 AS '#39'||CRLF||'
      
        '1101351438=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SE' +
        'GMENT SIZE 80;'#39'||CRLF||'
      '1101351439=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '1101351440=         '#39'BEGIN'#39'||CRLF||'
      
        '1101351441=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39 +
        'REPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1101351442=         '#39'  SQLSTMT='#39#39'DELETE FROM '#39'||TN||'#39' WHERE '#39'||I' +
        'D_COLUMN||'#39'='#39#39'||OLD.'#39'||ID_COLUMN||'#39';'#39'||CRLF||'
      '1101351443=         '#39'  ID=GEN_ID(GEN_LOGS,1);'#39'||CRLF||'
      
        '1101351444=         '#39'  INSERT INTO LOGS(ID,SQLSTMT,USR) VALUES (' +
        ':ID, :SQLSTMT, '#39#39'SYSDBA'#39#39');'#39'||CRLF||'
      '1101351445=         '#39'END'#39';'
      '1101351446=    TN_ALT=TN;'
      '1101351447=  END'
      '1101351448=  IF (TRGIX<>'#39#39') THEN'
      '1101351449=    EXECUTE STATEMENT TRGIX;'
      '1101351450='
      '1101351451=  EXECUTE STATEMENT TRGI;'
      '1101351452=  IF (TRGUX<>'#39#39') THEN'
      '1101351453=    EXECUTE STATEMENT TRGUX;'
      '1101351454='
      '1101351455=  EXECUTE STATEMENT TRGU;'
      '1101351456='
      '1101351457=  IF (TRGDX<>'#39#39') THEN'
      '1101351458=    EXECUTE STATEMENT TRGDX;'
      '1101351459=  EXECUTE STATEMENT TRGD;'
      '1101351460='
      '1101351461=  -- BLOB-'#1055#1054#1051#1071' '#1054#1058#1044#1045#1051#1068#1053#1067#1045' '#1058#1056#1048#1043#1043#1045#1056#1067
      '1101351462=  TN_ALT    = '#39#39';'
      '1101351463=  ID_COLUMN = '#39#39';'
      
        '1101351464=  FOR SELECT TRIM(RDB$RELATION_FIELDS.RDB$RELATION_NA' +
        'ME),'
      '1101351465=             TRIM(RDB$RELATION_FIELDS.RDB$FIELD_NAME)'
      
        '1101351466=        FROM RDB$RELATION_FIELDS JOIN RDB$FIELDS ON R' +
        'DB$RELATION_FIELDS.RDB$FIELD_SOURCE=RDB$FIELDS.RDB$FIELD_NAME'
      
        '1101351467=       WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T CONTAINING '#39'$'#39
      '1101351468=         AND RDB$FIELDS.RDB$FIELD_TYPE = 261'
      '1101351469=         AND RDB$FIELDS.RDB$FIELD_SUB_TYPE = 0'
      
        '1101351470=         AND RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T IN ('#39'CUR_PARAMS'#39', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_' +
        'SIZES'#39','
      
        '1101351471=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1101351472=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1101351473=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1101351474=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1101351475=                                         '#39'REVISION'#39', ' +
        #39'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1101351476=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_TOC' +
        'HKA'#39', '#39'G_PRODUCT_FILL'#39','
      
        '1101351477=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39')'
      '1101351478=        INTO :TN,'
      '1101351479=             :FN'
      '1101351480=  DO BEGIN'
      '1101351481=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN BEGIN'
      '1101351482=      SELECT TRIM(F.RDB$FIELD_NAME)'
      '1101351483=        FROM RDB$RELATION_FIELDS F'
      '1101351484=       WHERE F.RDB$RELATION_NAME = :TN'
      '1101351485=         AND F.RDB$FIELD_POSITION = 0'
      '1101351486=        INTO :ID_COLUMN;'
      '1101351487=    END'
      '1101351488='
      
        '1101351489=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1101351490=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '1101351491=        '#39'AS '#39'||CRLF||'
      '1101351492=        '#39'BEGIN '#39'||CRLF||'
      
        '1101351493=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1101351494=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF|' +
        '|'
      
        '1101351495=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1101351496=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1101351497=        '#39'END;'#39';'
      '1101351498=    EXECUTE STATEMENT :TRGI;'
      '1101351499='
      
        '1101351500=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1101351501=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '1101351502=        '#39'AS '#39'||CRLF||'
      '1101351503=        '#39'BEGIN '#39'||CRLF||'
      
        '1101351504=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1101351505=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRL' +
        'F||'
      
        '1101351506=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1101351507=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1101351508=        '#39'END;'#39';'
      '1101351509=    EXECUTE STATEMENT :TRGI;'
      '1101351510='
      '1101351511=    TN_ALT = TN;'
      '1101351512=  END'
      '1101351513=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '1101351514=        FROM RDB$RELATIONS R'
      '1101351515=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1101351516=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '1101351517=       ORDER BY R.RDB$RELATION_NAME'
      '1101351518=        INTO :TN'
      '1101351519=  DO BEGIN'
      '1101351520=    TN=TRIM(TN);'
      '1101351521=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '1101351522='
      '1101351523=    EXECUTE STATEMENT :SQLSTMT;'
      '1101351524=  END'
      '1101351525=END'
      '1101351526=;'
      '1101351527='
      '1101351528=ALTER PROCEDURE P_REP_TOVAR_HISTORY('
      '1101351529=  G_PRODUCT_ARR_ BLOB SUB_TYPE 1,'
      '1101351530=  DATE_BEGIN_ DATE,'
      '1101351531=  DATE_END_ DATE,'
      '1101351532=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101351533=RETURNS ('
      '1101351534=  ROW INTEGER,'
      '1101351535=  DATE_ACT DATE,'
      '1101351536=  OPER VARCHAR(500),'
      '1101351537=  PRICE_PRIHOD NUMERIC(15,2),'
      '1101351538=  AMOUNT_PRIHOD MY_NUMERIC_5,'
      '1101351539=  SUMM_PRIHOD NUMERIC(15,2),'
      '1101351540=  PRICE_UHOD NUMERIC(15,2),'
      '1101351541=  AMOUNT_UHOD MY_NUMERIC_5,'
      '1101351542=  SUMM_UHOD NUMERIC(15,2),'
      '1101351543=  ERR_CODE INTEGER,'
      '1101351544=  ERR_MSG VARCHAR(1024))'
      '1101351545=AS'
      
        '1101351546=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1101351547=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101351548=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      '1101351549=DECLARE VARIABLE DATE_SORT DATE;'
      '1101351550=BEGIN'
      '1101351551='
      '1101351552=  FOR SELECT F.G_PRODUCT'
      '1101351553=        FROM G_PRODUCT F'
      
        '1101351554=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39'~'#39'||F.G_PROD' +
        'UCT||'#39'~'#39
      '1101351555=       AND EXISTS (SELECT 1'
      '1101351556=                     FROM SKLAD SS'
      
        '1101351557=                    WHERE SS.DATE_RECEIPT BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      '1101351558=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '1101351559=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||SS.G_TOCHKA||'#39'-'#39
      '1101351560=                   UNION ALL'
      '1101351561=                   SELECT 1'
      '1101351562=                     FROM SKLAD SS'
      
        '1101351563=                    WHERE SS.DATE_RECEIPT BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      '1101351564=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '1101351565=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||SS.G_CLIENT||'#39'-'#39
      '1101351566=                   UNION ALL'
      '1101351567=                   SELECT 1'
      '1101351568=                     FROM ZAKAZ ZZ,'
      '1101351569=                          ZAKAZ_DETAILS ZZD'
      '1101351570=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '1101351571=                      AND ZZ.IS_RESERVE = 0'
      
        '1101351572=                      AND ZZ.Z_DATE BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '1101351573=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      '1101351574=                      AND ZZ.IS_SPISANIE <> 2'
      
        '1101351575=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||ZZ.G_TOCHKA||'#39'-'#39
      '1101351576=                   UNION ALL'
      '1101351577=                   SELECT 1'
      '1101351578=                     FROM ZAKAZ_REAL_PARENT Z,'
      '1101351579=                          ZAKAZ_NA_REAL D'
      
        '1101351580=                    WHERE Z.ZAKAZ_REAL_PARENT = D.ZAK' +
        'AZ_REAL_PARENT'
      
        '1101351581=                      AND Z.ZAKAZ_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1101351582=                      AND D.G_PRODUCT = F.G_PRODUCT'
      
        '1101351583=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1101351584=                   UNION ALL'
      '1101351585=                   SELECT 1'
      '1101351586=                     FROM OTHER ZZ,'
      '1101351587=                          OTHER_DETAILS ZZD'
      '1101351588=                    WHERE ZZ.OTHER = ZZD.OTHER'
      
        '1101351589=                      AND ZZ.OP_DATE BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '1101351590=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      
        '1101351591=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||ZZ.G_TOCHKA||'#39'-'#39
      '1101351592=                   )'
      '1101351593=       ORDER BY F.NAME'
      '1101351594=       INTO :G_PRODUCT_'
      '1101351595=  DO BEGIN'
      '1101351596=      FOR SELECT -2,'
      
        '1101351597=                 CAST('#39'01.01.1985'#39' AS DATE) DATE_SORT' +
        ','
      '1101351598=                 NULL,'
      '1101351599=                 NAME,'
      '1101351600=                 NULL,'
      '1101351601=                 NULL,'
      '1101351602=                 NULL,'
      '1101351603=                 NULL,'
      '1101351604=                 NULL,'
      '1101351605=                 NULL'
      '1101351606=            FROM G_PRODUCT G'
      '1101351607=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1101351608=          UNION ALL'
      '1101351609=          SELECT -1,'
      
        '1101351610=                 CAST('#39'01.01.1990'#39' AS DATE) DATE_SORT' +
        ','
      '1101351611=                 NULL,'
      '1101351612=                 '#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1085#1072#1095#1072#1083#1086#39','
      '1101351613=                 NULL,'
      
        '1101351614=                 (select (select COALESCE(sum(amount)' +
        ', 0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1101351615=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1101351616=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1101351617=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1101351618=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1101351619=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1101351620=                        and zrp.ZAKAZ_DATE >= :DATE_B' +
        'EGIN_)'
      '1101351621=                       +'
      
        '1101351622=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1101351623=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1101351624=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      
        '1101351625=                        and z.IS_SPISANIE <> 2   -- '#1085 +
        #1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' ' +
        #1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1101351626=                        and not (z.IS_SPISANIE = 0 an' +
        'd z.NOT_MINUS_OSTATOK = 1))'
      '1101351627=                       +'
      
        '1101351628=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1101351629=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1101351630=                       +'
      
        '1101351631=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1101351632=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1101351633=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1101351634=                       -'
      
        '1101351635=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1101351636=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1101351637=                        and sp.is_vozvrat <> 3 and sp' +
        '.date_receipt >= :DATE_BEGIN_ and not (sp.IS_VOZVRAT = 0 and sp.' +
        'IS_EXPECTED = 1))'
      '1101351638=                       -'
      
        '1101351639=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1101351640=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1101351641=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||Sp.g_tochka||'#39'-'#39' and sp.date_receipt >= :DATE_BEGIN_ and s' +
        'p.IS_EXPECTED = 0)'
      '1101351642=                  from rdb$database) PRICE,'
      '1101351643=                 NULL,'
      '1101351644=                 NULL,'
      '1101351645=                 NULL,'
      '1101351646=                 NULL'
      '1101351647=            FROM G_PRODUCT G'
      '1101351648=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1101351649=          UNION ALL'
      '1101351650=          SELECT SP.IS_VOZVRAT,'
      '1101351651=                 SP.DATE_RECEIPT DATE_SORT,'
