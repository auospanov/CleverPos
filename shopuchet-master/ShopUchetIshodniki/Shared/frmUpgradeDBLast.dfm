        '110621105=                        EXECUTE PROCEDURE K_DEL_KASSA(' +
        ':KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_M' +
        'SG);'
      '110621106=                        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621107=                          ERR_MSG = PROCNAME||'#39' -> PNT' +
        '_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '110621108=                          EXIT;'
      '110621109=                        END'
      '110621110='
      '110621111=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '110621112=                           EXECUTE PROCEDURE K_INS_KAS' +
        'SA(0,     -- ACTION_ => :ACTION_'
      
        '110621113=                                                      ' +
        '    1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
