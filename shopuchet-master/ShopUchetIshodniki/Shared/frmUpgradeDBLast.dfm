        #1049', '#1058#1054#1043#1044' '#1042' LT_SKLAD_PRODUCT '#1058#1059#1055#1054' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049
      '11012186=                FROM G_PRODUCT_KIT KK'
      '11012187=               WHERE KK.g_product = K.G_PRODUCT'
      
        '11012188=                 AND NOT EXISTS (SELECT 1 FROM LT_SKLAD' +
        '_PRODUCT L WHERE L.G_TOCHKA = NEW.g_tochka AND L.G_PRODUCT = KK.' +
        'G_PRODUCT_ITEM)) = 0'
      '11012189=       INTO :G_PRODUCT_SOSTAV_'
      '11012190=  DO BEGIN'
      '11012191=    SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE)/K.amount)'
      '11012192=      FROM G_PRODUCT_KIT K,'
      '11012193=           LT_SKLAD_PRODUCT L'
      '11012194=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '11012195=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '11012196=       AND L.G_TOCHKA = NEW.g_tochka'
      '11012197=     GROUP BY K.G_PRODUCT'
      '11012198=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11012199='
