      '110236924=           AND T.IS_SPISANIE  = 1'
      
        '110236925=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110236926=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '110236927=        INTO :ZAKAZ,'
      '110236928=             :Z_NUM,'
      '110236929=             :G_TOCHKA,'
      '110236930=             :Z_DATE,'
      '110236931=             :Z_TIME,'
      '110236932=             :G_CLIENT,'
      '110236933=             :OSNOVANIE,'
      '110236934=             :NOTE,'
      '110236935=             :CLIENT_NAME,'
      '110236936=             :DETAILS_STR,'
      '110236937=             :IS_SPISANIE,'
      '110236938=             :IS_PAYED_ALL,'
      '110236939=             :INVOICE_PAY,'
      '110236940=             :INVOICE,'
      '110236941=             :WAYBILL,'
      '110236942=             :SUM_ZAKAZ,'
      '110236943=             :SUM_FACT,'
      '110236944=             :SUMM_PAY_BONUS,'
      '110236945=             :SUMM_BONUS_GOT,'
      '110236946=             :BONUSALL'
      '110236947=      DO'
      '110236948=        suspend;'
      '110236949='
      '110236950=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110236951=  END ELSE'
      '110236952=  BEGIN'
      '110236953=      FOR'
      '110236954=        SELECT T.SKLAD,'
      
        '110236955=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042 +
        #1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '110236956=               T.G_TOCHKA,'
      '110236957=               T.DATE_RECEIPT,'
      '110236958=               T.TIME_RECEIPT,'
      '110236959=               T.G_CLIENT,'
      '110236960=               T.OSNOVANIE,'
      '110236961=               T.NOTE,'
      '110236962=               gc.name,'
      '110236963=               /*SUBSTRING((SELECT'
      
        '110236964=                            LIST(G.NAME||'#39'('#39'||D.AMOUNT' +
        '||'#39')'#39', '#39', '#39')'
      '110236965=                            FROM SKLAD D, G_PRODUCT G'
      
        '110236966=                           WHERE D.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '110236967=                             AND D.SKLAD_PARENT = T.SK' +
        'LAD'
      
        '110236968=                            GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999)*/ '#39#39' DETAILS_STR,'
      '110236969=               T.SUMM,'
      '110236970=               T.IS_VOZVRAT,'
      '110236971=               W.WAYBILL'
      
        '110236972=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL ' +
        'W ON T.SKLAD = W.ZAKAZ,'
      '110236973=               G_TOCHKA GC'
      
        '110236974=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110236975=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110236976=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '110236977=           AND T.IS_VOZVRAT = 3'
      '110236978=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '110236979=        INTO :ZAKAZ,'
      '110236980=             :Z_NUM,'
      '110236981=             :G_TOCHKA,'
      '110236982=             :Z_DATE,'
      '110236983=             :Z_TIME,'
      '110236984=             :G_CLIENT,'
      '110236985=             :OSNOVANIE,'
      '110236986=             :NOTE,'
      '110236987=             :CLIENT_NAME,'
      '110236988=             :DETAILS_STR,'
      '110236989=             :SUM_ZAKAZ,'
      '110236990=             :IS_SPISANIE,'
      '110236991=             :WAYBILL'
      '110236992=      DO'
      '110236993=        suspend;'
      '110236994=  END'
      '110236995='
