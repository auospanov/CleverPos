      '110752564=                     AND SK.IS_LAST = 1'
      '110752565=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '110752566='
      '110752567=                  UPDATE SKLAD SK'
      '110752568=                     SET SK.IS_LAST = 1'
      '110752569=                   WHERE SK.SKLAD = :SKLAD_;'
      '110752570=                END'
      '110752571='
      
        '110752572=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041 +
        #1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110752573=            END ELSE BEGIN'
      '110752574=                UPDATE SKLAD S'
