        'OD_SKL, SUMM_UHOD_SKL,  AMOUNT_OUT, IS_HEAD)'
      '1101684505=      VALUES'
      
        '1101684506=        (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), :REC_' +
        'G_PRODUCT_, :GNAME_, :REC_AMOUNT_IN_, :REC_AMOUNT_PRIHOD_, :REC_' +
        'SUMM_PRIHOD_, :REC_AMOUNT_UHOD_, :REC_SUMM_UHOD_, :REC_AMOUNT_SP' +
        'ISANO_, :REC_SUMM_SPISANO_, :REC_AMOUNT_VOZVRAT_, :REC_SUMM_VOZV' +
        'RAT_,'
      
        '1101684507=        :REC_AMOUNT_PRIHOD_SKL_, :REC_SUMM_PRIHOD_SKL' +
        '_, :REC_AMOUNT_UHOD_SKL_, :REC_SUMM_UHOD_SKL_,'
      '1101684508=        :REC_AMOUNT_OUT_,'
      '1101684509=        0);'
      '1101684510='
      
        '1101684511=      AMOUNT_PRIHOD_  = AMOUNT_PRIHOD_ + REC_AMOUNT_P' +
        'RIHOD_;'
      
        '1101684512=      SUMM_PRIHOD_    = SUMM_PRIHOD_   + REC_SUMM_PRI' +
        'HOD_;'
      
        '1101684513=      AMOUNT_UHOD_    = AMOUNT_UHOD_   + REC_AMOUNT_U' +
        'HOD_;'
      
        '1101684514=      SUMM_UHOD_      = SUMM_UHOD_     + REC_SUMM_UHO' +
        'D_;'
      
        '1101684515=      AMOUNT_SPISANO_ = AMOUNT_SPISANO_  + REC_AMOUNT' +
        '_SPISANO_;'
      
        '1101684516=      SUMM_SPISANO_   = SUMM_SPISANO_    + REC_SUMM_S' +
        'PISANO_;'
      
        '1101684517=      AMOUNT_VOZVRAT_ = AMOUNT_VOZVRAT_  + REC_AMOUNT' +
        '_VOZVRAT_;'
      
        '1101684518=      SUMM_VOZVRAT_      = SUMM_VOZVRAT_    + REC_SUM' +
        'M_VOZVRAT_;'
      
        '1101684519=      AMOUNT_PRIHOD_SKL_ = AMOUNT_PRIHOD_SKL_ + REC_A' +
        'MOUNT_PRIHOD_SKL_;'
      
        '1101684520=      SUMM_PRIHOD_SKL_   = SUMM_PRIHOD_SKL_ + REC_SUM' +
        'M_PRIHOD_SKL_;'
      
        '1101684521=      AMOUNT_UHOD_SKL_   = AMOUNT_UHOD_SKL_ + REC_AMO' +
        'UNT_UHOD_SKL_;'
      
        '1101684522=      SUMM_UHOD_SKL_     = SUMM_UHOD_SKL_ + REC_SUMM_' +
        'UHOD_SKL_;'
      '1101684523='
      '1101684524=      PATH_OLD_ = PATH_;'
      '1101684525=    END'
      '1101684526='
      '1101684527=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101684528=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1101684529=      (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIH' +
        'OD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SP' +
        'ISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '1101684530=       AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHO' +
        'D_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1101684531=    VALUES'
      
        '1101684532=      (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :' +
        'AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_, :AMOU' +
        'NT_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVRAT_,'
      
        '1101684533=       :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :AMOUN' +
        'T_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '1101684534='
      '1101684535=    -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '1101684536=    AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + AMOUNT_' +
        'PRIHOD_;'
      
        '1101684537=    SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUMM_PRIH' +
        'OD_;'
      
        '1101684538=    AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMOUNT_UH' +
        'OD_;'
      '1101684539=    SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_UHOD_;'
      
        '1101684540=    AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ + AMOUN' +
        'T_SPISANO_;'
      
        '1101684541=    SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + SUMM_SP' +
        'ISANO_;'
      
        '1101684542=    AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ + AMOUN' +
        'T_VOZVRAT_;'
      
        '1101684543=    SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + SUMM_VO' +
        'ZVRAT_;'
      
        '1101684544=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ +' +
        ' AMOUNT_PRIHOD_SKL_;'
      
        '1101684545=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + S' +
        'UMM_PRIHOD_SKL_;'
      
        '1101684546=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + A' +
        'MOUNT_UHOD_SKL_;'
      
        '1101684547=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUM' +
        'M_UHOD_SKL_;'
      '1101684548='
      '1101684549=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '1101684550=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1101684551=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHO' +
        'D_SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1101684552=    VALUES'
      
        '1101684553=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AM' +
        'OUNT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UH' +
        'OD_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVR' +
        'AT_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIH' +
        'OD_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '1101684554='
      
        '1101684555=    STR_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1101684556=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1101684557='
      '1101684558=  FOR'
      '1101684559=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '1101684560=           DECODE(T.IS_HEAD,'
      '1101684561=                  0, T.NAME,'
      '1101684562=                  1, T.NAME,'
      '1101684563=                  2, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39','
      '1101684564=                  3, '#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39'),'
      '1101684565=           G.ARTICUL,'
      '1101684566=           G.BARCODE,'
      '1101684567=           G.PRICE,'
      '1101684568=           T.AMOUNT_IN,'
      '1101684569=           T.AMOUNT_PRIHOD,'
      '1101684570=           T.SUMM_PRIHOD,'
      '1101684571=           T.AMOUNT_UHOD,'
      '1101684572=           T.SUMM_UHOD,'
      '1101684573=           T.AMOUNT_SPISANO,'
      '1101684574=           T.SUMM_SPISANO,'
      '1101684575=           T.AMOUNT_VOZVRAT,'
      '1101684576=           T.SUMM_VOZVRAT,'
      '1101684577=           T.AMOUNT_PRIHOD_SKL,'
      '1101684578=           T.SUMM_PRIHOD_SKL,'
      '1101684579=           T.AMOUNT_UHOD_SKL,'
      '1101684580=           T.SUMM_UHOD_SKL,'
      '1101684581=           T.AMOUNT_OUT,'
      '1101684582=           T.IS_HEAD'
      
        '1101684583=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1101684584=     ORDER BY 1'
      '1101684585=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1101684586=       :NAME,'
      '1101684587=       :ARTICUL,'
      '1101684588=       :BARCODE,'
      '1101684589=       :PRICE,'
      '1101684590=       :AMOUNT_IN,'
      '1101684591=       :AMOUNT_PRIHOD,'
      '1101684592=       :SUMM_PRIHOD,'
      '1101684593=       :AMOUNT_UHOD,'
      '1101684594=       :SUMM_UHOD,'
      '1101684595=       :AMOUNT_SPISANO,'
      '1101684596=       :SUMM_SPISANO,'
      '1101684597=       :AMOUNT_VOZVRAT,'
      '1101684598=       :SUMM_VOZVRAT,'
      '1101684599=       :AMOUNT_PRIHOD_SKL,'
      '1101684600=       :SUMM_PRIHOD_SKL,'
      '1101684601=       :AMOUNT_UHOD_SKL,'
      '1101684602=       :SUMM_UHOD_SKL,'
      '1101684603=       :AMOUNT_OUT,'
      '1101684604=       :IS_HEAD'
      '1101684605=  DO SUSPEND;'
      '1101684606='
      '1101684607=WHEN ANY DO BEGIN'
      '1101684608=    Err_code = -20500;'
      
        '1101684609=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101684610=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101684611=  END'
      '1101684612=end'
      '1101684613=;'
      '1101684614='
      '1101684615=ALTER PROCEDURE P_REP_TOVAR_OSTATOK_ON_DATE('
      '1101684616=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101684617=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101684618=  DATE_ DATE,'
      '1101684619=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101684620=RETURNS ('
      '1101684621=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101684622=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101684623=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101684624=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101684625=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101684626=  SUMM MY_NUMERIC,'
      '1101684627=  ERR_CODE INTEGER,'
      '1101684628=  ERR_MSG VARCHAR(1024))'
      '1101684629=AS'
      
        '1101684630=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'OSTATOK_ON_DATE'#39';'
      '1101684631=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101684632=DECLARE VARIABLE G_PRODUCT_PAR TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR;'
      
        '1101684633=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      '1101684634=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1101684635=BEGIN'
      '1101684636='
      '1101684637=  SELECT S.S_VALUE,'
      '1101684638=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1101684639=    FROM SYSTEM_SETUP S'
      '1101684640=   WHERE S.SYSTEM_SETUP = 1'
      '1101684641=    INTO :FORMULA_,'
      '1101684642=         :PRIHOD_CNT_;'
      '1101684643='
      '1101684644=  FOR WITH OSTATOK_ARR AS (SELECT GP.NAME,'
      '1101684645=                               GP.BARCODE,'
      '1101684646=                               GP.ARTICUL,'
      '1101684647=                               GP.PRICE,'
      '1101684648=                               GP.G_PRODUCT,'
      '1101684649=                               GP.G_PRODUCT_PAR,'
      
        '1101684650=                               (select (select sum(am' +
        'ount) from lt_sklad_product where g_product = GP.G_PRODUCT'
      
        '1101684651=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||g_tochka||'#39'-'#39')'
      
        '1101684652=                                        +  -- '#1090#1086#1074#1072#1088' '#1085 +
        #1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1101684653=                                       (select COALES' +
        'CE(sum(zr.AMOUNT_ALL), 0) from zakaz_na_real zr, zakaz_real_pare' +
        'nt zrp'
      
        '1101684654=                                        where zr.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TO' +
        'CHKA||'#39'-'#39
      
        '1101684655=                                        and zr.ZAKAZ_' +
        'REAL_PARENT = zrp.ZAKAZ_REAL_PARENT'
      
        '1101684656=                                        and zrp.ZAKAZ' +
        '_DATE > :DATE_)'
      '1101684657=                                       +'
      
        '1101684658=                                       (select COALES' +
        'CE(sum(zd.amount), 0) from zakaz_details zd, zakaz z'
      
        '1101684659=                                        where zd.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      
        '1101684660=                                        and zd.zakaz ' +
        '= z.zakaz and z.z_date > :DATE_'
      
        '1101684661=                                        and z.IS_SPIS' +
        'ANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072 +
        #1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1101684662=                                        and not (z.IS' +
        '_SPISANIE = 0 and z.NOT_MINUS_OSTATOK = 1))'
      '1101684663=                                       +'
      
        '1101684664=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and s.is_vozvrat = 3'
      
        '1101684665=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt > :DATE' +
        '_)'
      '1101684666=                                       +'
      
        '1101684667=                                       (select COALES' +
        'CE(sum(od.amount), 0) from other_details od, other o'
      
        '1101684668=                                        where od.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCH' +
        'KA||'#39'-'#39
      
        '1101684669=                                        and od.other ' +
        '= o.other and o.op_date > :DATE_)'
      '1101684670=                                       -'
      
        '1101684671=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101684672=                                        and s.is_vozv' +
        'rat <> 3 and s.date_receipt > :DATE_)'
      '1101684673=                                       -'
      
        '1101684674=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and s.is_vozvrat = 3'
      
        '1101684675=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt > :DATE' +
        '_)'
      
        '1101684676=                                  from rdb$database) ' +
        'AMOUNT'
      '1101684677=                          FROM G_PRODUCT GP'
      '1101684678=                         WHERE GP.IS_ACTIVE = 1'
      '1101684679=                           AND GP.IS_CATEGORY = 0'
      
        '1101684680=                           AND ((:G_CATEGORY_ CONTAIN' +
        'ING '#39'~'#39'||GP.G_PRODUCT_PAR||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101684681=                                 OR'
      
        '1101684682=                                 (:G_CATEGORY_ IS NUL' +
        'L)'
      '1101684683=                               )'
      
        '1101684684=                           AND ((:G_PRODUCT_ CONTAINI' +
        'NG '#39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101684685=                                 OR'
      
        '1101684686=                                 (:G_PRODUCT_ IS NULL' +
        ')'
      '1101684687=                               )'
      '1101684688=                           --AND GP.G_PRODUCT = 2874'
      '1101684689=                               )'
      
        '1101684690=    SELECT (SELECT NAME FROM G_PRODUCT GG WHERE GG.G_' +
        'PRODUCT = A.G_PRODUCT_PAR)||'#39' / '#39'||A.NAME,'
      '1101684691=           A.BARCODE,'
      '1101684692=           A.ARTICUL,'
      '1101684693=           COALESCE(A.AMOUNT, 0) * A.PRICE,'
      '1101684694=           A.G_PRODUCT_PAR,'
      '1101684695=           COALESCE(A.AMOUNT, 0) AMOUNT'
      
        '1101684696=           ,COALESCE(CAST(A.AMOUNT AS NUMERIC), 0) * ' +
        'COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1101684697=                                                     ' +
        '         -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058 +
        #1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1101684698=                                                     ' +
        '         -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 '#1047#1040#1050#1059#1055#1054#1050
      
        '1101684699=                                                     ' +
        '         -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '1101684700=                                                     ' +
        '         -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 200 '#1047#1040#1050#1059#1055#1054#1050
      
        '1101684701=                                                     ' +
        '         DECODE(:FORMULA_,'
      
        '1101684702=                                                     ' +
        '                1,'
      
        '1101684703=                                                     ' +
        '                (SELECT S.price'
      
        '1101684704=                                                     ' +
        '                   FROM SKLAD S'
      
        '1101684705=                                                     ' +
        '                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHK' +
        'A||'#39'-'#39
      
        '1101684706=                                                     ' +
        '                    AND S.g_product = A.G_PRODUCT'
      
        '1101684707=                                                     ' +
        '                    AND S.IS_VOZVRAT IN (0, 3, 4)'
      
        '1101684708=                                                     ' +
        '                    AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      
        '1101684709=                                                     ' +
        '                                            FROM SKLAD DD'
      
        '1101684710=                                                     ' +
        '                                           WHERE DD.DATE_RECEIPT' +
        ' <= :DATE_'
      
        '1101684711=                                                     ' +
        '                                             AND DD.g_product = ' +
        'A.G_PRODUCT'
      
        '1101684712=                                                     ' +
        '                                             AND :G_TOCHKA_ARR_ ' +
        'CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1101684713=                                                     ' +
        '                                             AND DD.IS_VOZVRAT I' +
        'N (0, 3, 4)'
      
        '1101684714=                                                     ' +
        '                                           )'
      
        '1101684715=                                                     ' +
        '                   ORDER BY 1 DESC'
      
        '1101684716=                                                     ' +
        '                   ROWS 1 TO 1'
      
        '1101684717=                                                     ' +
        '                ),'
      
        '1101684718=                                                     ' +
        '                (SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOU' +
        'NT), 2)'
      
        '1101684719=                                                     ' +
        '                   FROM (SELECT S.AMOUNT, S.PRICE'
      
        '1101684720=                                                     ' +
        '                           FROM SKLAD_PARENT SP,'
      
        '1101684721=                                                     ' +
        '                                SKLAD S'
      
        '1101684722=                                                     ' +
        '                          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S' +
        'P.G_TOCHKA||'#39'-'#39
      
        '1101684723=                                                     ' +
        '                            AND SP.DATE_RECEIPT <= :DATE_'
      
        '1101684724=                                                     ' +
        '                            AND SP.SKLAD = S.SKLAD_PARENT'
      
        '1101684725=                                                     ' +
        '                            AND S.G_PRODUCT = A.G_PRODUCT'
      
        '1101684726=                                                     ' +
        '                            AND SP.IS_VOZVRAT IN (0, 3, 4)'
      
        '1101684727=                                                     ' +
        '                           ORDER BY S.DATE_RECEIPT DESC, S.SKLAD' +
        ' DESC ROWS 1 TO 5) T)'
      
        '1101684728=                                                     ' +
        '                ))'
      
        '1101684729=                                                     ' +
        '         , 0'
      
        '1101684730=                                                     ' +
        '         )'
      '1101684731=      FROM OSTATOK_ARR A'
      '1101684732=    ORDER BY NAME, G_PRODUCT_PAR'
      '1101684733=    INTO :NAME,'
      '1101684734=         :BARCODE,'
      '1101684735=         :ARTICUL,'
      '1101684736=         :PRICE,'
      '1101684737=         :G_PRODUCT_PAR,'
      '1101684738=         :AMOUNT,'
      '1101684739=         :SUMM'
      '1101684740=  DO'
      '1101684741=    SUSPEND;'
      '1101684742='
      '1101684743=WHEN ANY DO BEGIN'
      '1101684744=    Err_code = -20500;'
      
        '1101684745=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101684746=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101684747=  END'
      '1101684748=end'
      '1101684749=;'
      '1101684750='
      '1101684751=ALTER PROCEDURE P_REP_WAYBILL('
      '1101684752=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1101684753=  CURRENCY_ INTEGER,'
      '1101684754=  MODE_ INTEGER)'
      '1101684755=RETURNS ('
      '1101684756=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '1101684757=  DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1101684758=  OTPRAVITEL_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '1101684759=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '1101684760=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCH' +
        'ATEL,'
      '1101684761=  OTVETST_ZA_POST_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101684762=  TRANSP_ORG_ TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      
        '1101684763=  TRANSP_NAKLAD_ TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD' +
        ','
      
        '1101684764=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN G_OFFICIAL.FIO_D' +
        'OC,'
      '1101684765=  APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '1101684766=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101684767=  GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101684768=  SUMM_VSEGO_ VARCHAR(50),'
      '1101684769=  SUMM_NDS_VSEGO_ VARCHAR(50),'
      '1101684770=  COUNT_VSEGO_ VARCHAR(500),'
      '1101684771=  STR_VSEGO_ VARCHAR(500),'
      '1101684772=  ROW_NUM INTEGER,'
      '1101684773=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '1101684774=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101684775=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101684776=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101684777=  SHORT_NAME TYPE OF COLUMN G_UNIT.SHORT_NAME,'
      '1101684778=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101684779=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101684780=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1101684781=  SUMM_NDS VARCHAR(50),'
      '1101684782=  NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS,'
      '1101684783=  SUMM_WO_NDS TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1101684784=  NDS_HEADER_ VARCHAR(50),'
      '1101684785=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
        '1101684786=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST' +
        '_FIO,'
      '1101684787=  ERR_CODE INTEGER,'
      '1101684788=  ERR_MSG VARCHAR(1024))'
      '1101684789=AS'
      
        '1101684790=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_WAYBIL' +
        'L'#39';'
      '1101684791=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101684792=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101684793=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NOL_VMESTO_BEZ;'
      
        '1101684794=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REK' +
        'VIZIT.NDS_VALUE;'
      '1101684795=DECLARE VARIABLE I INTEGER;'
      
        '1101684796=DECLARE VARIABLE DETAILS TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.ZAKAZ_DETAILS;'
      '1101684797=BEGIN'
      '1101684798='
      '1101684799=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101684800=  SELECT W.NUM,'
      '1101684801=         W.INIT_DATE,'
      '1101684802=         W.POSTAVSHIK,'
      '1101684803=         W.IDN,'
      '1101684804=         W.GRUZOPOLUCHATEL,'
      
        '1101684805=         DECODE(CHAR_LENGTH(G.FIO_DOC), 0, G.FM||'#39' '#39'|' +
        '|G.NM||'#39' '#39'||G.FT, G.FIO_DOC) OTVETST_ZA_POST,'
      '1101684806=         W.TRANSP_ORG,'
      '1101684807=         W.TRANSP_NAKLAD,'
      
        '1101684808=         DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FIO, G' +
        'G.FIO_DOC) G_OFFICIAL_RUKOVOD,'
      '1101684809=         GG.APPOINT,'
      
        '1101684810=         DECODE(CHAR_LENGTH(G2.FIO_DOC), 0, G2.FM||'#39' ' +
        #39'||G2.NM||'#39' '#39'||G2.FT, G2.FIO_DOC) G_OFFICIAL,'
      '1101684811=         W.ZAKAZ,'
      '1101684812=         GF.NOL_VMESTO_BEZ,'
      '1101684813=         GF.NDS_VALUE,'
      '1101684814=         COALESCE(GO.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '1101684815=         W.doverennost,'
      '1101684816=         W.doverennost_FIO'
      
        '1101684817=    FROM WAYBILL W LEFT OUTER JOIN G_OFFICIAL G ON W.' +
        'OTVETST_ZA_POST = G.G_OFFICIAL'
      
        '1101684818=                   LEFT OUTER JOIN (SELECT G1.G_OFFIC' +
        'IAL, G1.FIO_DOC, G1.FM||'#39' '#39'||G1.NM||'#39' '#39'||G1.FT FIO, A.NAME APPOI' +
        'NT'
      
        '1101684819=                                      FROM G_OFFICIAL' +
        ' G1 LEFT OUTER JOIN G_APPOINTMENT A ON G1.G_APPOINTMENT = A.G_AP' +
        'POINTMENT) GG ON W.G_OFFICIAL_RUKOVOD = GG.G_OFFICIAL'
      
        '1101684820=                   LEFT OUTER JOIN G_OFFICIAL G2 ON W' +
        '.G_OFFICIAL = G2.G_OFFICIAL'
      
        '1101684821=                   LEFT OUTER JOIN G_OFFICIAL GO ON W' +
        '.GLAVBUH = GO.G_OFFICIAL,'
      '1101684822='
      '1101684823=         G_FIRM_REKVIZIT GF'
      '1101684824=   WHERE W.WAYBILL = :WAYBILL_'
      
        '1101684825=     AND ((W.g_firm = GF.g_firm_rekvizit AND W.g_firm' +
        ' IS NOT NULL) OR (GF.is_default = 1 AND W.g_firm IS NULL))  -- '#1044 +
        #1054' 02.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '1101684826=    INTO :NUM_,'
      '1101684827=        :DATE_,'
      '1101684828=        :OTPRAVITEL_,'
      '1101684829=        :IDN_,'
      '1101684830=        :GRUZOPOLUCHATEL_,'
      '1101684831=        :OTVETST_ZA_POST_,'
      '1101684832=        :TRANSP_ORG_,'
      '1101684833=        :TRANSP_NAKLAD_,'
      '1101684834=        :G_OFFICIAL_RUKOVOD_,'
      '1101684835=        :APPOINTMENT_,'
      '1101684836=        :G_OFFICIAL_,'
      '1101684837=        :ZAKAZ_,'
      '1101684838=        :BEZ_NDS_,'
      '1101684839=        :NDS_VALUE_,'
      '1101684840=        :GLAVBUH_,'
      '1101684841=        :doverennost_,'
      '1101684842=        :doverennost_fio_;'
      '1101684843='
      '1101684844=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '1101684845=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' (' +
        #1088#1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080#1079#1072#1094 +
        #1080#1080'"'
      
        '1101684846=  -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052#1059' '#1063 +
        #1058#1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048#1058#1040#1045 +
        #1058#1057#1071
      '1101684847=  IF (MODE_ <> 3) THEN'
      
        '1101684848=      SELECT REPLACE(CAST(MAX(Z.SUMM) AS VARCHAR(10))' +
        ', '#39'.'#39', '#39','#39'),'
      '1101684849=             DECODE(:NDS_VALUE_,'
      
        '1101684850=                     0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048 +
        ' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1101684851=                               0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1101684852=                               '#39'0,00'#39'),'
      
        '1101684853=                     REPLACE(CAST(MAX(Z.SUMM) - CAST(' +
        'ROUND(MAX(Z.SUMM)/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      '1101684854=                    ),'
      
        '1101684855=             (SELECT CURR_STR from CURRENCYSTR(SUM(ZD' +
        '.AMOUNT), -1)),'
      
        '1101684856=             (SELECT CURR_STR from CURRENCYSTR(MAX(Z.' +
        'SUMM), :CURRENCY_)),'
      
        '1101684857=             DECODE(:NDS_VALUE_, 0, '#39#1057#1091#1084#1084#1072' '#1073#1077#1079' '#1053#1044#1057', '#1074 +
        ' KZT'#39', '#39#1057#1091#1084#1084#1072' '#1089' '#1053#1044#1057', '#1074' KZT'#39')'
      '1101684858=        FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      '1101684859=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101684860=         AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101684861=        INTO :SUMM_VSEGO_,'
      '1101684862=             :SUMM_NDS_VSEGO_,'
      '1101684863=             :COUNT_VSEGO_,'
      '1101684864=             :STR_VSEGO_,'
      '1101684865=             :NDS_HEADER_;'
      '1101684866=  ELSE'
      
        '1101684867=      SELECT REPLACE(CAST(MAX(SP.SUMM) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39'),'
      '1101684868=             DECODE(:NDS_VALUE_,'
      
        '1101684869=                     0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048 +
        ' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1101684870=                               0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1101684871=                               '#39'0,00'#39'),'
      
        '1101684872=                     REPLACE(CAST(MAX(SP.SUMM) - CAST' +
        '(ROUND(MAX(SP.SUMM)/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      '1101684873=                    ),'
      
        '1101684874=             (SELECT CURR_STR from CURRENCYSTR(SUM(S.' +
        'AMOUNT), -1)),'
      
        '1101684875=             (SELECT CURR_STR from CURRENCYSTR(MAX(SP' +
        '.SUMM), :CURRENCY_)),'
      
        '1101684876=             DECODE(:NDS_VALUE_, 0, '#39#1057#1091#1084#1084#1072' '#1073#1077#1079' '#1053#1044#1057', '#1074 +
        ' KZT'#39', '#39#1057#1091#1084#1084#1072' '#1089' '#1053#1044#1057', '#1074' KZT'#39')'
      '1101684877=        FROM SKLAD_PARENT SP, SKLAD S'
      '1101684878=       WHERE SP.SKLAD = :ZAKAZ_'
      '1101684879=         AND SP.SKLAD = S.SKLAD_PARENT'
      '1101684880=        INTO :SUMM_VSEGO_,'
      '1101684881=             :SUMM_NDS_VSEGO_,'
      '1101684882=             :COUNT_VSEGO_,'
      '1101684883=             :STR_VSEGO_,'
      '1101684884=             :NDS_HEADER_;'
      '1101684885='
      '1101684886=  ROW_NUM = 0;'
      '1101684887=  FOR'
      '1101684888=    SELECT --:I,'
      '1101684889=           G.NAME,'
      '1101684890=           G.NOMENCLATUR_NUM,'
      '1101684891=           G.articul,'
      '1101684892=           G.BARCODE,'
      '1101684893=           U.SHORT_NAME,'
      '1101684894=           ZD.AMOUNT,'
      '1101684895=           ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE, 0),'
      '1101684896=           ZD.SUMM,'
      '1101684897=           DECODE(:NDS_VALUE_,'
      
        '1101684898=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1101684899=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1101684900=                             '#39'0,00'#39'),'
      
        '1101684901=                   REPLACE(CAST(ZD.SUMM - CAST(ROUND(' +
        'ZD.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS VARCHAR(1' +
        '0)), '#39'.'#39', '#39','#39')'
      '1101684902=                   ),'
      '1101684903=           :NDS_VALUE_,'
      '1101684904=          ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2),'
      '1101684905=          ZD.ZAKAZ_DETAILS'
      '1101684906=      FROM ZAKAZ Z,'
      '1101684907=           ZAKAZ_DETAILS ZD,'
      '1101684908=           G_PRODUCT G,'
      '1101684909=           G_UNIT U'
      '1101684910=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101684911=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101684912=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101684913=       AND G.G_UNIT = U.G_UNIT'
      '1101684914=       AND :MODE_ <> 3'
      '1101684915=    UNION ALL'
      '1101684916=    SELECT --:I,'
      '1101684917=           G.NAME,'
      '1101684918=           G.NOMENCLATUR_NUM,'
      '1101684919=           G.articul,'
      '1101684920=           G.BARCODE,'
      '1101684921=           U.SHORT_NAME,'
      '1101684922=           S.AMOUNT,'
      '1101684923=           S.PRICE,'
      '1101684924=           S.SUMM,'
      '1101684925=           DECODE(:NDS_VALUE_,'
      
        '1101684926=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1101684927=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1101684928=                             '#39'0,00'#39'),'
      
        '1101684929=                   REPLACE(CAST(S.SUMM - CAST(ROUND(S' +
        '.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39')'
      '1101684930=                   ),'
      '1101684931=           :NDS_VALUE_,'
      '1101684932=          ROUND(S.SUMM/(1 + :NDS_VALUE_/100), 2),'
      '1101684933=          S.SKLAD ZAKAZ_DETAILS'
      '1101684934=      FROM SKLAD_PARENT SP,'
      '1101684935=           SKLAD S,'
      '1101684936=           G_PRODUCT G,'
      '1101684937=           G_UNIT U'
      '1101684938=     WHERE SP.SKLAD = :ZAKAZ_'
      '1101684939=       AND SP.SKLAD = S.SKLAD_PARENT'
      '1101684940=       AND S.G_PRODUCT = G.G_PRODUCT'
      '1101684941=       AND G.G_UNIT = U.G_UNIT'
      '1101684942=       AND :MODE_ = 3'
      '1101684943=     ORDER BY 1'
      '1101684944=    INTO --:ROW_NUM,'
      '1101684945=        :NAME,'
      '1101684946=        :NOMENCLATUR_NUM,'
      '1101684947=        :ARTICUL,'
      '1101684948=        :BARCODE,'
      '1101684949=        :SHORT_NAME,'
      '1101684950=        :AMOUNT,'
      '1101684951=        :PRICE,'
      '1101684952=        :SUMM,'
      '1101684953=        :SUMM_NDS,'
      '1101684954=        :NDS,'
      '1101684955=        :SUMM_WO_NDS,'
      '1101684956=        :DETAILS'
      '1101684957=  DO BEGIN'
      '1101684958=    ROW_NUM = ROW_NUM + 1;'
      '1101684959=    SUSPEND;'
      '1101684960=  END'
      '1101684961='
      '1101684962=WHEN ANY DO BEGIN'
      '1101684963=    Err_code = -20500;'
      
        '1101684964=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101684965=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101684966=  END'
      '1101684967=end'
      '1101684968=;'
      '1101684969='
      '1101684970=ALTER PROCEDURE P_REP_ZAKAZ_NA_REAL_WAYBILL('
      
        '1101684971=  ZAKAZ_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_REAL_' +
        'PARENT,'
      '1101684972=  CURRENCY_ INTEGER)'
      '1101684973=RETURNS ('
      '1101684974=  NUMBER_STR_ VARCHAR(200),'
      '1101684975=  ROW_NUM INTEGER,'
      '1101684976=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101684977=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101684978=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101684979=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101684980=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101684981=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101684982=  AMOUNT MY_NUMERIC_5,'
      '1101684983=  PRICE_N VARCHAR(50),'
      '1101684984=  SUMM_N VARCHAR(50),'
      '1101684985=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1101684986=  SUMM_VSEGO_ VARCHAR(50),'
      '1101684987=  NDS_SUMM_ VARCHAR(50),'
      '1101684988=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101684989=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101684990=  SUMM_STR_ VARCHAR(500),'
      '1101684991=  NDS_SUMM_STR_ VARCHAR(500),'
      '1101684992=  ERR_CODE NUMERIC(15,2),'
      '1101684993=  ERR_MSG VARCHAR(1024))'
      '1101684994=AS'
      
        '1101684995=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042#1067#1044#1040#1063#1048' '#1055#1054#1044' '#1056#1045 +
        #1040#1051
      '1101684996=*/'
      
        '1101684997=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZ_' +
        'NA_REAL_WAYBILL'#39';'
      '1101684998=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101684999=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101685000=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101685001=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S_SUMM;'
      '1101685002=BEGIN'
      '1101685003='
      
        '1101685004=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.OSNOVANIE||'#39' '#1086#1090' '#39'||lpad(EXT' +
        'RACT(DAY FROM P.ZAKAZ_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FR' +
        'OM P.ZAKAZ_DATE), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.ZAKAZ_DATE),'
      '1101685005=         G.name'
      '1101685006=    FROM ZAKAZ_REAL_PARENT P,'
      '1101685007=         G_CLIENT G'
      '1101685008=   WHERE P.ZAKAZ_REAL_PARENT = :ZAKAZ_'
      '1101685009=     AND P.g_client = G.G_CLIENT'
      '1101685010=    INTO :NUMBER_STR_,'
      '1101685011=         :CLIENT_NAME_;'
      '1101685012='
      
        '1101685013=  SELECT SUM(S.amount_ALL)--REPLACE(CAST(SUM(S.amount' +
        ') AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1101685014=         ,REPLACE(CAST(SUM(S.summ_ALL) AS VARCHAR(50)' +
        '), '#39'.'#39', '#39','#39')'
      
        '1101685015=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.sum' +
        'm_ALL), :CURRENCY_))'
      
        '1101685016=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(50)' +
        '), '#39'.'#39', '#39','#39')'
      '1101685017=         ,SUM(S.nds_summ)'
      '1101685018=    FROM ZAKAZ_NA_REAL S'
      '1101685019=   WHERE S.ZAKAZ_REAL_PARENT = :ZAKAZ_'
      '1101685020=   GROUP BY S.ZAKAZ_REAL_PARENT'
      '1101685021=    INTO :AMOUNT_VSEGO_,'
      '1101685022=         :SUMM_VSEGO_,'
      '1101685023=         :summ_str_,'
      '1101685024=         :NDS_SUMM_,'
      '1101685025=         :NDS_;'
      '1101685026='
      '1101685027=  if (NDS_ > 0) then'
      
        '1101685028=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENC' +
        'YSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '1101685029='
      '1101685030=  SELECT NAME'
      '1101685031=    FROM CUR_PARAMS'
      '1101685032=   WHERE CUR_PARAMS = 1'
      '1101685033=    INTO :G_OFFICIAL_FM_;'
      '1101685034='
      '1101685035=  FOR SELECT :I,'
      '1101685036=             C.NAME,'
      '1101685037=             G.name,'
      '1101685038=             G.ARTICUL,'
      '1101685039=             G.BARCODE,'
      '1101685040=             G.NOMENCLATUR_NUM,'
      '1101685041=             U.short_name,'
      '1101685042=             S.AMOUNT_ALL,'
      
        '1101685043=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101685044=             REPLACE(CAST(S.SUMM_ALL AS VARCHAR(50)),' +
        ' '#39'.'#39', '#39','#39')'
      
        '1101685045=        FROM ZAKAZ_NA_REAL S, G_PRODUCT G, G_UNIT U, ' +
        'G_PRODUCT C'
      '1101685046=       WHERE S.ZAKAZ_REAL_PARENT = :ZAKAZ_'
      '1101685047=         AND S.g_product = G.g_product'
      '1101685048=         AND G.g_unit = U.g_unit'
      '1101685049=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '1101685050=        INTO :ROW_NUM,'
      '1101685051=            :CATEGORY_NAME,'
      '1101685052=            :NAME,'
      '1101685053=            :ARTICUL,'
      '1101685054=            :BARCODE,'
      '1101685055=            :NOMENCLATUR_NUM,'
      '1101685056=            :SHORT_NAME,'
      '1101685057=            :AMOUNT,'
      '1101685058=            :PRICE_N,'
      '1101685059=            :SUMM_N'
      '1101685060=  DO BEGIN'
      '1101685061=    I = I + 1;'
      '1101685062=    SUSPEND;'
      '1101685063=  END'
      '1101685064=WHEN ANY DO BEGIN'
      '1101685065=    Err_code = -20500;'
      
        '1101685066=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101685067=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101685068=  END'
      '1101685069=end'
      '1101685070=;'
      '1101685071='
      '1101685072=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '1101685073=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101685074=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1101685075=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1101685076=  DATE_BEGIN_ DATE,'
      '1101685077=  DATE_END_ DATE,'
      '1101685078=  TIME_BEGIN_ TIME,'
      '1101685079=  TIME_END_ TIME,'
      '1101685080=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101685081=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101685082=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101685083=RETURNS ('
      '1101685084=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101685085=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101685086=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101685087=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1101685088=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1101685089=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101685090=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1101685091=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101685092=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101685093=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101685094=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101685095=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101685096=  Z_DATE BLOB SUB_TYPE 1,'
      '1101685097=  ROW INTEGER,'
      '1101685098=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101685099=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101685100=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101685101=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101685102=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101685103=  ERR_CODE INTEGER,'
      '1101685104=  ERR_MSG VARCHAR(1024))'
      '1101685105=AS'
      
        '1101685106=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST'#39';'
      '1101685107=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101685108=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1101685109=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '1101685110=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1101685111=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BA' +
        'RCODE;'
      
        '1101685112=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PR' +
        'ODUCT.BARCODE;'
      
        '1101685113=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101685114=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1101685115=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.NAME;'
      
        '1101685116=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '1101685117=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1101685118=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM = 0;'
      
        '1101685119=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1101685120=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1101685121=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1101685122=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_SUMM = 0;'
      
        '1101685123=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1101685124=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1101685125=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1101685126=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1101685127=DECLARE VARIABLE I INTEGER = 1;'
      '1101685128=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      
        '1101685129=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAM' +
        'E;'
      
        '1101685130=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101685131=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101685132=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FIO_DOC;'
      '1101685133=BEGIN'
      '1101685134=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1101685135=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1101685136='
      
        '1101685137=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') |' +
        '| '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extr' +
        'act(year from Z.Z_DATE),'
      '1101685138=             Z.Z_TIME,'
      '1101685139=             GP.ARTICUL,'
      '1101685140=             GP.BARCODE,'
      '1101685141=             GP.NOMENCLATUR_NUM,'
      '1101685142=             GP.NAME,'
      '1101685143=             ZD.AMOUNT,'
      '1101685144=             ZD.PRICE,'
      '1101685145=             ZD.DISCOUNT_TENGE,'
      '1101685146=             ZD.SUMM,'
      '1101685147=             ZD.DISCOUNT_SUMM,'
      '1101685148=             GC.NAME,'
      '1101685149=             P.NAME,'
      '1101685150=             TR.PATH,'
      '1101685151=             Z.NOTE,'
      '1101685152=             U.SHORT_NAME,'
      '1101685153=             Z.SUMM_CASH,'
      '1101685154=             Z.SUMM_NONCASH,'
      
        '1101685155=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, ' +
        #39#39')'
      
        '1101685156=      FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.' +
        'G_OFFICIAL = O.G_OFFICIAL,'
      '1101685157=           ZAKAZ_DETAILS ZD,'
      '1101685158=           G_CLIENT GC,'
      '1101685159=           G_PAYMENT_TYPE P,'
      '1101685160=           G_PRODUCT GP,'
      '1101685161=           G_UNIT U,'
      '1101685162=           P_REP_TREE TR'
      
        '1101685163=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101685164=       AND Z.IS_SPISANIE IN (0,2)'
      '1101685165=       AND Z.IS_RESERVE = 0'
      '1101685166=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101685167=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1101685168=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1101685169=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101685170=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101685171=       AND GP.G_UNIT = U.G_UNIT'
      '1101685172=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101685173=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1101685174=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1101685175=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1101685176=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1101685177=            OR'
      
        '1101685178=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1101685179=           )/*'
      
        '1101685180=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_' +
        'END_ AND :TIME_BEGIN_ IS NOT NULL)'
      '1101685181=            OR'
      '1101685182=            :TIME_BEGIN_ IS NULL)*/'
      
        '1101685183=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101685184=             OR'
      '1101685185=             (:G_CATEGORY_ IS NULL)'
      '1101685186=           )'
      
        '1101685187=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101685188=             OR'
      '1101685189=            (:G_PRODUCT_ IS NULL)'
      '1101685190=           )'
      '1101685191=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '1101685192=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :' +
        'NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '1101685193=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, ' +
        ':CLIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_,'
      
        '1101685194=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME' +
        '_'
      '1101685195=  DO BEGIN'
      '1101685196=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1101685197=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101685198=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1101685199=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, ' +
        '"DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '1101685200=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL' +
        '_, :DISCOUNT_SUMM_ROLL_, 1);'
      '1101685201='
      '1101685202=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1101685203=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1101685204=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ +' +
        ' DISCOUNT_SUMM_ROLL_;'
      '1101685205=            SUMM_ROLL_ = 0;'
      '1101685206=            DISCOUNT_SUMM_ROLL_ = 0;'
      '1101685207=            I = I + 1;'
      '1101685208=        END'
      '1101685209='
      '1101685210=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1101685211=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DAT' +
        'E", ROW)'
      '1101685212=        VALUES (:I, :PATH_, 1);'
      '1101685213=        I = I + 1;'
      '1101685214=    END'
      '1101685215='
      
        '1101685216=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", ' +
        '"TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, ' +
        'DISCOUNT, SUMM,'
      
        '1101685217=                                         DISCOUNT_SUM' +
        'M, CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME,'
      
        '1101685218=                                         SUMM_CASH, S' +
        'UMM_NONCASH, OFFICIAL_NAME)'
      
        '1101685219=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCO' +
        'DE_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOU' +
        'NT_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '1101685220=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0,' +
        ' :UNIT_NAME_,'
      
        '1101685221=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NA' +
        'ME_);'
      '1101685222='
      '1101685223=    I = I + 1;'
      '1101685224=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '1101685225=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCO' +
        'UNT_SUMM_;'
      '1101685226=    LAST_PATH_ = PATH_;'
      '1101685227=  END'
      '1101685228='
      '1101685229=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1101685230=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1101685231=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOU' +
        'NT_SUMM_ROLL_, 1);'
      '1101685232='
      '1101685233=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1101685234=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1101685235=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_' +
        'SUMM_ROLL_;'
      '1101685236='
      
        '1101685237=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1101685238=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1101685239='
      
        '1101685240=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENC' +
        'LATUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, C' +
        'LIENT_NAME,'
      
        '1101685241=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME, SUMM' +
        '_CASH, SUMM_NONCASH, OFFICIAL_NAME'
      '1101685242=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1101685243=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOM' +
        'ENCLATUR_NUM, :TOVAR_NAME,'
      
        '1101685244=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :' +
        'DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      
        '1101685245=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCA' +
        'SH, :OFFICIAL_NAME'
      '1101685246=  do suspend;'
      '1101685247='
      '1101685248=WHEN ANY DO BEGIN'
      '1101685249=    Err_code = -20500;'
      
        '1101685250=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1101685251=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101685252=  END'
      '1101685253=end'
      '1101685254=;'
      '1101685255='
      '1101685256=ALTER PROCEDURE P_REP_ZAKAZI_LIST_TOVARY('
      '1101685257=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101685258=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1101685259=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1101685260=  DATE_BEGIN_ DATE,'
      '1101685261=  DATE_END_ DATE,'
      '1101685262=  TIME_BEGIN_ TIME,'
      '1101685263=  TIME_END_ TIME,'
      '1101685264=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101685265=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101685266=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101685267=RETURNS ('
      '1101685268=  PERIOD_ VARCHAR(40),'
      '1101685269=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101685270=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101685271=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101685272=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1101685273=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101685274=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101685275=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101685276=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101685277=  PATH BLOB SUB_TYPE 1,'
      '1101685278=  ROW INTEGER,'
      '1101685279=  ERR_CODE INTEGER,'
      '1101685280=  ERR_MSG VARCHAR(1024))'
      '1101685281=AS'
      
        '1101685282=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST_TOVARY'#39';'
      '1101685283=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101685284=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1101685285=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '1101685286=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1101685287=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BA' +
        'RCODE;'
      
        '1101685288=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101685289=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1101685290=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.NAME;'
      
        '1101685291=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '1101685292=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1101685293=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM = 0;'
      
        '1101685294=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1101685295=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1101685296=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1101685297=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_SUMM = 0;'
      
        '1101685298=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1101685299=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1101685300=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1101685301=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1101685302=DECLARE VARIABLE I INTEGER = 1;'
      '1101685303=BEGIN'
      '1101685304=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1101685305=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1101685306='
      
        '1101685307=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1101685308=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1101685309='
      '1101685310=  FOR SELECT GP.ARTICUL'
      '1101685311=             ,GP.BARCODE'
      '1101685312=             ,GP.NAME'
      '1101685313=             ,SUM(ZD.AMOUNT)'
      '1101685314=             ,MIN(ZD.PRICE)'
      '1101685315=             ,SUM(ZD.SUMM)'
      '1101685316=             ,SUM(ZD.DISCOUNT_SUMM)'
      '1101685317=             ,MIN(TR.PATH)'
      '1101685318=      FROM ZAKAZ Z'
      '1101685319=           ,ZAKAZ_DETAILS ZD'
      '1101685320=           ,G_PRODUCT GP'
      '1101685321=           ,P_REP_TREE TR'
      '1101685322=           ,G_CLIENT GC'
      
        '1101685323=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101685324=       AND Z.IS_SPISANIE IN (0,2)'
      '1101685325=       AND Z.IS_RESERVE = 0'
      '1101685326=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101685327=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101685328=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101685329=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1101685330=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101685331=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1101685332=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1101685333=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1101685334=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1101685335=            OR'
      
        '1101685336=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1101685337=           )'
      
        '1101685338=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101685339=             OR'
      '1101685340=             (:G_CATEGORY_ IS NULL)'
      '1101685341=           )'
      
        '1101685342=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101685343=             OR'
      '1101685344=            (:G_PRODUCT_ IS NULL)'
      '1101685345=           )'
      '1101685346=     GROUP BY GP.articul, GP.barcode, GP.NAME'
      '1101685347=     ORDER BY MIN(TR.PATH), GP.NAME'
      
        '1101685348=     INTO :ARTICUL, :BARCODE, :TOVAR_NAME, :AMOUNT, :' +
        'PRICE, :SUMM, :DISCOUNT_SUMM, :PATH'
      '1101685349=  DO /*BEGIN'
      '1101685350=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1101685351=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101685352=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1101685353=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, ' +
        '"DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '1101685354=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL' +
        '_, :DISCOUNT_SUMM_ROLL_, 1);'
      '1101685355='
      '1101685356=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1101685357=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1101685358=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ +' +
        ' DISCOUNT_SUMM_ROLL_;'
      '1101685359=            SUMM_ROLL_ = 0;'
      '1101685360=            DISCOUNT_SUMM_ROLL_ = 0;'
      '1101685361=            I = I + 1;'
      '1101685362=        END'
      '1101685363='
      '1101685364=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1101685365=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DAT' +
        'E", ROW)'
      '1101685366=        VALUES (:I, :PATH_, 1);'
      '1101685367=        I = I + 1;'
      '1101685368=    END'
      '1101685369='
      
        '1101685370=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", ' +
        'ARTICUL, BARCODE, NAME, AMOUNT, PRICE, SUMM,'
      
        '1101685371=                                         DISCOUNT_SUM' +
        'M, ROW)'
      
        '1101685372=    VALUES (:I, :Z_DATE_, :ARTICUL_, :BARCODE_, :TOVA' +
        'R_NAME_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_SUMM_,'
      '1101685373=            0);'
      '1101685374='
      '1101685375=    I = I + 1;'
      '1101685376=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '1101685377=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCO' +
        'UNT_SUMM_;'
      '1101685378=    LAST_PATH_ = PATH_;'
      '1101685379=  END'
      '1101685380='
      '1101685381=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1101685382=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1101685383=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOU' +
        'NT_SUMM_ROLL_, 1);'
      '1101685384='
      '1101685385=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1101685386=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1101685387=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_' +
        'SUMM_ROLL_;'
      '1101685388='
      
        '1101685389=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1101685390=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1101685391='
      
        '1101685392=  FOR SELECT "DATE", ARTICUL, BARCODE, NAME, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_SUMM, ROW'
      '1101685393=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1101685394=      INTO :Z_DATE, :ARTICUL, :BARCODE, :TOVAR_NAME, ' +
        ':AMOUNT, :PRICE, :SUMM, :DISCOUNT_SUMM, :ROW'
      '1101685395=  do */suspend;'
      '1101685396='
      '1101685397=WHEN ANY DO BEGIN'
      '1101685398=    Err_code = -20500;'
      
        '1101685399=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1101685400=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101685401=  END'
      '1101685402=end'
      '1101685403=;'
      '1101685404='
      '1101685405=ALTER PROCEDURE R_IMPORT_REVISION('
      '1101685406=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101685407=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101685408=  AMOUNT_ TYPE OF COLUMN REVISION.AMOUNT_REAL)'
      '1101685409=RETURNS ('
      '1101685410=  ERR_CODE INTEGER,'
      '1101685411=  ERR_MSG VARCHAR(1024))'
      '1101685412=AS'
      
        '1101685413=DECLARE VARIABLE G_PRODUCT_     TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.G_PRODUCT = NULL;'
      
        '1101685414=DECLARE VARIABLE ID_            TYPE OF COLUMN REVISI' +
        'ON.REVISION;'
      '1101685415=DECLARE VARIABLE POS_           INTEGER;'
      '1101685416=DECLARE VARIABLE POS2_          INTEGER;'
      '1101685417=DECLARE VARIABLE POS3_          INTEGER;'
      '1101685418=DECLARE VARIABLE STRR           VARCHAR(100);'
      '1101685419=BEGIN'
      '1101685420=  SELECT G_PRODUCT'
      '1101685421=    FROM G_PRODUCT G'
      '1101685422=   WHERE G.BARCODE = :BARCODE_'
      '1101685423=     AND G.IS_ACTIVE = 1'
      '1101685424=    INTO :G_PRODUCT_;'
      '1101685425='
      '1101685426=  IF (G_PRODUCT_ IS NOT NULL) THEN BEGIN'
      '1101685427=      UPDATE REVISION R'
      '1101685428=         SET R.AMOUNT_REAL = :AMOUNT_'
      '1101685429=       WHERE R.G_PRODUCT = :G_PRODUCT_'
      '1101685430=         AND R.G_TOCHKA = :G_TOCHKA_;'
      '1101685431='
      '1101685432=      IF (ROW_COUNT = 0) THEN BEGIN'
      
        '1101685433=        INSERT INTO REVISION (REVISION, G_PRODUCT, AM' +
        'OUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1101685434=        VALUES ((SELECT COALESCE(MAX(REVISION), 0) + ' +
        '1 FROM REVISION),'
      '1101685435=                :G_PRODUCT_,'
      '1101685436=                COALESCE((SELECT AMOUNT'
      '1101685437=                            FROM LT_SKLAD_PRODUCT'
      
        '1101685438=                           WHERE G_TOCHKA = :G_TOCHKA' +
        '_ AND G_PRODUCT = :G_PRODUCT_), 0),'
      '1101685439=                :AMOUNT_,'
      '1101685440=                0,'
      '1101685441=                :G_TOCHKA_);'
      '1101685442=      END'
      '1101685443=  END ELSE BEGIN'
      '1101685444=    ERR_CODE = 0;'
      
        '1101685445=    ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077 +
        ' '#1085#1072#1081#1076#1077#1085'.'#39';'
      '1101685446=  END'
      '1101685447='
      '1101685448=WHEN ANY DO BEGIN'
      '1101685449=    IF (gdscode = 335544652) THEN BEGIN'
      '1101685450=      ERR_CODE = 0;'
      
        '1101685451=      ERR_MSG = '#39#1053#1072#1081#1076#1077#1085#1086' '#1085#1077#1089#1082#1086#1083#1100#1082#1086' '#1090#1086#1074#1072#1088#1086#1074' '#1089' '#1090#1072#1082#1080#1084' '#1096#1090 +
        #1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_;'
      '1101685452=    END ELSE BEGIN'
      '1101685453=      ERR_CODE = 0;'
      
        '1101685454=      ERR_MSG = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1096#1090#1088#1080#1093#1082#1086#1076#1072' '#39'||BAR' +
        'CODE_||'#39'. '#1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||gdscode;'
      '1101685455=    END'
      '1101685456=  END'
      '1101685457=END'
      '1101685458=;'
      '1101685459='
      '1101685460=ALTER PROCEDURE R_READ_REVISION_LIST'
      '1101685461=RETURNS ('
      '1101685462=  REVISION TYPE OF COLUMN REVISION.REVISION,'
      '1101685463=  SKLAD TYPE OF COLUMN REVISION.SKLAD,'
      '1101685464=  G_PRODUCT TYPE OF COLUMN REVISION.G_PRODUCT,'
      '1101685465=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101685466=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101685467=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101685468=  AMOUNT_BD TYPE OF COLUMN REVISION.AMOUNT_BD,'
      '1101685469=  AMOUNT_REAL TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '1101685470=  IS_UNIFIED TYPE OF COLUMN REVISION.IS_UNIFIED)'
      '1101685471=AS'
      '1101685472=begin'
      '1101685473=  FOR'
      '1101685474=    SELECT R.REVISION,'
      '1101685475=           R.SKLAD,'
      '1101685476=           R.G_PRODUCT,'
      '1101685477=           G.NAME,'
      '1101685478=           G.BARCODE,'
      '1101685479=           G.ARTICUL,'
      '1101685480=           R.AMOUNT_BD,'
      '1101685481=           R.AMOUNT_REAL,'
      '1101685482=           R.IS_UNIFIED'
      '1101685483=    FROM REVISION R, G_PRODUCT G'
      '1101685484=   WHERE R.G_PRODUCT = G.G_PRODUCT'
      
        '1101685485=     AND R.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      '1101685486=   ORDER BY G.NAME'
      '1101685487=    into :REVISION,'
      '1101685488=         :SKLAD,'
      '1101685489=         :G_PRODUCT,'
      '1101685490=         :G_PRODUCT_NAME,'
      '1101685491=         :BARCODE,'
      '1101685492=         :ARTICUL,'
      '1101685493=         :AMOUNT_BD,'
      '1101685494=         :AMOUNT_REAL,'
      '1101685495=         :IS_UNIFIED'
      '1101685496=  DO'
      '1101685497=    suspend;'
      '1101685498=end'
      '1101685499=;'
      '1101685500='
      '1101685501=ALTER PROCEDURE READ_PRODCAT_FOR_REAL_LIST('
      '1101685502=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '1101685503=RETURNS ('
      '1101685504=  SORT_COL INTEGER,'
      '1101685505=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101685506=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101685507=  ARTICUL VARCHAR(30),'
      '1101685508=  NOMENCLATUR_NUM VARCHAR(30),'
      '1101685509=  BARCODE VARCHAR(30),'
      '1101685510=  NAME VARCHAR(500),'
      '1101685511=  G_UNIT TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101685512=  PRICE NUMERIC(15,2),'
      '1101685513=  VOLUME_PRICE NUMERIC(15,2),'
      '1101685514=  IS_CATEGORY INTEGER)'
      '1101685515=AS'
      '1101685516=begin'
      '1101685517=    FOR'
      '1101685518=    SELECT'
      '1101685519=        1 SORT_COL,'
      '1101685520=        T.G_PRODUCT,'
      '1101685521=        T.G_PRODUCT_PAR,'
      '1101685522=        T.ARTICUL,'
      '1101685523=        T.NOMENCLATUR_NUM,'
      '1101685524=        T.BARCODE,'
      '1101685525=        T.NAME,'
      '1101685526=        T.G_UNIT,'
      '1101685527=        T.PRICE,'
      '1101685528=        T.VOLUME_PRICE,'
      '1101685529=        T.IS_CATEGORY'
      '1101685530=    FROM G_PRODUCT T'
      '1101685531=    WHERE T.IS_CATEGORY = 1'
      '1101685532=      AND EXISTS (SELECT 1'
      '1101685533=                    FROM ZAKAZ_REAL_PARENT ZP,'
      '1101685534=                         ZAKAZ_NA_REAL Z,'
      '1101685535=                         G_PRODUCT G'
      
        '1101685536=                   WHERE ZP.G_TOCHKA = (SELECT ID FRO' +
        'M CUR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101685537=                     AND Z.G_PRODUCT = G.G_PRODUCT'
      
        '1101685538=                     AND G.G_PRODUCT_PAR = T.G_PRODUC' +
        'T'
      
        '1101685539=                     AND Z.ZAKAZ_REAL_PARENT = ZP.ZAK' +
        'AZ_REAL_PARENT'
      '1101685540=                     AND ZP.G_CLIENT = :G_CLIENT_'
      
        '1101685541=                     AND Z.IS_PAYED_ALL = 0)   -- '#1058#1054#1051 +
        #1068#1050#1054' '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1045
      '1101685542=    UNION ALL'
      '1101685543=    SELECT'
      '1101685544=        0 SORT_COL,'
      '1101685545=        -1 G_PRODUCT,'
      '1101685546=        NULL G_PRODUCT_PAR,'
      '1101685547=        NULL ARTICUL,'
      '1101685548=        NULL NOMENCLATUR_NUM,'
      '1101685549=        NULL BARCODE,'
      '1101685550=        '#39#1042#1089#1077' '#1090#1086#1074#1072#1088#1099#39' NAME,'
      '1101685551=        NULL G_UNIT,'
      '1101685552=        NULL PRICE,'
      '1101685553=        NULL VOLUME_PRICE,'
      '1101685554=        1 IS_CATEGORY'
      '1101685555=    FROM RDB$DATABASE'
      '1101685556=    ORDER BY 1, 7, 2'
      '1101685557=    INTO'
      '1101685558=        :SORT_COL,'
      '1101685559=        :G_PRODUCT,'
      '1101685560=        :G_PRODUCT_PAR,'
      '1101685561=        :ARTICUL,'
      '1101685562=        :NOMENCLATUR_NUM,'
      '1101685563=        :BARCODE,'
      '1101685564=        :NAME,'
      '1101685565=        :G_UNIT,'
      '1101685566=        :PRICE,'
      '1101685567=        :VOLUME_PRICE,'
      '1101685568=        :IS_CATEGORY'
      '1101685569=  DO'
      '1101685570=    suspend;'
      '1101685571=end'
      '1101685572=;'
      '1101685573='
      '1101685574=ALTER PROCEDURE READ_PRODUCT_FOR_REAL_LIST('
      
        '1101685575=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101685576=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '1101685577=RETURNS ('
      '1101685578=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101685579=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101685580=  ARTICUL VARCHAR(30),'
      '1101685581=  NOMENCLATUR_NUM VARCHAR(30),'
      '1101685582=  BARCODE VARCHAR(30),'
      '1101685583=  NAME VARCHAR(500),'
      '1101685584=  G_UNIT VARCHAR(150),'
      '1101685585=  PRICE NUMERIC(15,2),'
      '1101685586=  VOLUME_PRICE NUMERIC(15,2),'
      '1101685587=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101685588=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101685589=  IS_CATEGORY INTEGER,'
      '1101685590=  IS_ACTIVE INTEGER,'
      '1101685591=  AMOUNT TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1101685592=  SKIDKA_PROC NUMERIC(15,2),'
      '1101685593=  SKIDKA_SUM NUMERIC(15,2),'
      
        '1101685594=  ZAKAZ_NA_REAL TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL,'
      
        '1101685595=  OSNOVANIE TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVANI' +
        'E)'
      '1101685596=AS'
      '1101685597=/*'
      
        '1101685598='#1054#1058#1056#1040#1046#1040#1045#1058' '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1056#1040#1047#1056#1045#1047#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1042' '#1060#1054#1056#1052#1045' ' +
        #1055#1056#1048' '#1054#1055#1051#1040#1058#1045' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' (frmProdazhaTovara)'
      '1101685599=*/'
      '1101685600=BEGIN'
      '1101685601='
      '1101685602=  FOR SELECT'
      '1101685603=        T.G_PRODUCT,'
      '1101685604=        T.G_PRODUCT_PAR,'
      '1101685605=        T.ARTICUL,'
      '1101685606=        T.NOMENCLATUR_NUM,'
      '1101685607=        T.BARCODE,'
      '1101685608=        T.NAME,'
      '1101685609=        GU.NAME AS G_UNIT,'
      
        '1101685610=        T.PRICE, --Z.PRICE + Z.DISCOUNT_TENGE,  -- '#1061#1047 +
        ' '#1047#1040#1063#1045#1052' '#1058#1040#1050' '#1057#1044#1045#1051#1040#1051', 23.05.2016'
      '1101685611=        T.VOLUME_PRICE,'
      '1101685612=        T.PACK_AMOUNT,'
      '1101685613=        T.MF_COUNTRY,'
      '1101685614=        T.IS_CATEGORY,'
      '1101685615=        T.IS_ACTIVE,'
      
        '1101685616=        (Z.AMOUNT_ALL - COALESCE(Z.AMOUNT_PAYED, 0) -' +
        ' COALESCE(Z.AMOUNT_RETURNED, 0)) AMOUNT,'
      '1101685617=        Z.DISCOUNT_PERC,'
      '1101685618=        Z.DISCOUNT_TENGE,'
      '1101685619=        Z.ZAKAZ_NA_REAL,'
      '1101685620=        ZP.OSNOVANIE'
      '1101685621=    FROM G_PRODUCT T,'
      '1101685622=         ZAKAZ_REAL_PARENT ZP,'
      '1101685623=         ZAKAZ_NA_REAL Z,'
      '1101685624=         G_UNIT GU'
      
        '1101685625=    WHERE T.G_PRODUCT_PAR = DECODE(:G_PRODUCT_PAR_, -' +
        '1, T.G_PRODUCT_PAR, :G_PRODUCT_PAR_)  -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067' ' +
        #1048#1051#1048' '#1057#1058#1056#1054#1043#1054' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '1101685626=    AND T.IS_CATEGORY = 0'
      '1101685627=    AND T.G_PRODUCT = Z.G_PRODUCT'
      '1101685628=    AND Z.IS_PAYED_ALL = 0   -- '#1058#1054#1051#1068#1050#1054' '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1045
      '1101685629=    AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PARENT'
      '1101685630=    AND ZP.G_CLIENT = :G_CLIENT_'
      
        '1101685631=    AND ZP.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      '1101685632=    AND T.G_UNIT = GU.G_UNIT'
      '1101685633=    ORDER BY T.NAME'
      '1101685634=    INTO'
      '1101685635=        :G_PRODUCT,'
      '1101685636=        :G_PRODUCT_PAR,'
      '1101685637=        :ARTICUL,'
      '1101685638=        :NOMENCLATUR_NUM,'
      '1101685639=        :BARCODE,'
      '1101685640=        :NAME,'
      '1101685641=        :G_UNIT,'
      '1101685642=        :PRICE,'
      '1101685643=        :VOLUME_PRICE,'
      '1101685644=        :PACK_AMOUNT,'
      '1101685645=        :MF_COUNTRY,'
      '1101685646=        :IS_CATEGORY,'
      '1101685647=        :IS_ACTIVE,'
      '1101685648=        :AMOUNT,'
      '1101685649=        :SKIDKA_PROC,'
      '1101685650=        :SKIDKA_SUM,'
      '1101685651=        :ZAKAZ_NA_REAL,'
      '1101685652=        :OSNOVANIE'
      '1101685653=  DO'
      '1101685654=    suspend;'
      '1101685655=end'
      '1101685656=;'
      '1101685657='
      '1101685658=ALTER PROCEDURE READ_SKLAD_LIST('
      '1101685659=  DATE_BEGIN_ DATE,'
      '1101685660=  DATE_END_ DATE,'
      '1101685661=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101685662=  IS_VOZVRAT_ INTEGER)'
      '1101685663=RETURNS ('
      '1101685664=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '1101685665=  SKLAD_PARENT TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101685666=  DATE_RECEIPT TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '1101685667=  G_PRODUCT TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101685668=  AMOUNT TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101685669=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '1101685670=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1101685671=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1101685672=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1101685673=  NDS TYPE OF COLUMN SKLAD.NDS,'
      '1101685674=  NDS_SUMM TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1101685675=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101685676=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101685677=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101685678=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101685679=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101685680=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1101685681=  IS_VOZVRAT TYPE OF COLUMN SKLAD.IS_VOZVRAT)'
      '1101685682=AS'
      '1101685683=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1101685684=BEGIN'
      '1101685685='
      '1101685686=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1101685687=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1101685688=      IF (sklad_parent_ is null) THEN begin'
      '1101685689=        SELECT COUNT(*)'
      '1101685690=          FROM SKLAD_PARENT T'
      
        '1101685691=         WHERE T.date_receipt BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1101685692=          AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '1101685693=          AND T.IS_vozvrat <> 3'
      '1101685694=          INTO CNT_;'
      '1101685695='
      '1101685696=        if (CNT_ = 0) then'
      '1101685697=          SELECT MAX(T.date_receipt)'
      '1101685698=            FROM SKLAD_PARENT T'
      '1101685699=           WHERE T.date_receipt < :DATE_BEGIN_'
      '1101685700=             AND T.IS_vozvrat <> 3'
      
        '1101685701=             AND T.G_TOCHKA = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 2)'
      '1101685702=            INTO :DATE_BEGIN_;'
      '1101685703=      end'
      '1101685704='
      '1101685705=      FOR SELECT T.sklad sklad_detail,'
      '1101685706=               T.SKLAD_PARENT sklad,'
      '1101685707=               T.date_receipt,'
      '1101685708=               T.g_product,'
      '1101685709=               T.amount,'
      '1101685710=               T.PRICE,'
      '1101685711=               T.SUMM,'
      '1101685712=               T.PRICE_CURRENCY,'
      '1101685713=               T.SUMM_CURRENCY,'
      '1101685714=               T.nds,'
      '1101685715=               T.nds_summ,'
      '1101685716=               P.NAME PRODUCT_NAME,'
      '1101685717=               C.NAME CLIENT_NAME,'
      '1101685718=               PT.NAME PAYMENT_NAME,'
      '1101685719=               P.ARTICUL,'
      '1101685720=               P.NOMENCLATUR_NUM,'
      '1101685721=               P.BARCODE,'
      '1101685722=               T.IS_VOZVRAT'
      '1101685723=          FROM SKLAD T'
      
        '1101685724=               LEFT OUTER JOIN G_CLIENT C ON T.G_CLIE' +
        'NT = C.G_CLIENT'
      
        '1101685725=               LEFT OUTER JOIN G_PAYMENT_TYPE PT ON T' +
        '.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '1101685726=               G_PRODUCT P'
      
        '1101685727=         WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1101685728=           AND T.G_PRODUCT = P.G_PRODUCT'
      
        '1101685729=           AND ((T.IS_VOZVRAT = 0 AND :IS_VOZVRAT_ IS' +
        ' NULL)'
      
        '1101685730=                OR (T.IS_VOZVRAT IN (0, 5) AND :IS_VO' +
        'ZVRAT_ = 0)'
      
        '1101685731=                OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZ' +
        'VRAT_ IN (1,2))'
      '1101685732=               )'
      '1101685733=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1101685734=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1101685735=                OR'
      
        '1101685736=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1101685737=               )'
      '1101685738=        ORDER BY T.DATE_RECEIPT DESC'
      '1101685739=      INTO :sklad,'
      '1101685740=        :SKLAD_PARENT,'
      '1101685741=        :date_receipt,'
      '1101685742=        :g_product,'
      '1101685743=        :amount,'
      '1101685744=        :PRICE,'
      '1101685745=        :SUMM,'
      '1101685746=        :PRICE_CURRENCY,'
      '1101685747=        :SUMM_CURRENCY,'
      '1101685748=        :nds,'
      '1101685749=        :nds_summ,'
      '1101685750=        :PRODUCT_NAME,'
      '1101685751=        :CLIENT_NAME,'
      '1101685752=        :PAYMENT_NAME,'
      '1101685753=        :ARTICUL,'
      '1101685754=        :NOMENCLATUR_NUM,'
      '1101685755=        :BARCODE,'
      '1101685756=        :IS_VOZVRAT'
      '1101685757=      DO'
      '1101685758=        suspend;'
      '1101685759='
      '1101685760=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040
      '1101685761=  END ELSE BEGIN'
      '1101685762=    FOR SELECT T.SKLAD_PARENT,'
      '1101685763=               T.SKLAD,'
      '1101685764=               TR.DATE_RECEIPT,'
      '1101685765=               T.g_product,'
      '1101685766=               T.amount,'
      '1101685767=               T.PRICE,'
      '1101685768=               T.SUMM,'
      '1101685769=               P.NAME PRODUCT_NAME,'
      '1101685770=               G.NAME CLIENT_NAME,'
      '1101685771=               P.ARTICUL,'
      '1101685772=               P.NOMENCLATUR_NUM,'
      '1101685773=               P.BARCODE'
      
        '1101685774=          FROM SKLAD_PARENT TR LEFT OUTER JOIN G_TOCH' +
        'KA G ON TR.G_CLIENT = G.G_TOCHKA,'
      '1101685775=               SKLAD T,'
      '1101685776=               G_PRODUCT P'
      
        '1101685777=         WHERE TR.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '1101685778=           AND TR.SKLAD = T.SKLAD_PARENT'
      '1101685779=           AND T.G_PRODUCT = P.G_PRODUCT'
      '1101685780=           AND T.IS_VOZVRAT = 3'
      '1101685781=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1101685782=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1101685783=                OR'
      
        '1101685784=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1101685785=               )'
      '1101685786=        ORDER BY TR.SKLAD DESC'
      '1101685787=      INTO :sklad,'
      '1101685788=        :SKLAD_PARENT,'
      '1101685789=        :date_receipt,'
      '1101685790=        :g_product,'
      '1101685791=        :amount,'
      '1101685792=        :PRICE,'
      '1101685793=        :SUMM,'
      '1101685794=        :PRODUCT_NAME,'
      '1101685795=        :CLIENT_NAME,'
      '1101685796=        :ARTICUL,'
      '1101685797=        :NOMENCLATUR_NUM,'
      '1101685798=        :BARCODE'
      '1101685799=      DO'
      '1101685800=        suspend;'
      '1101685801=  END'
      '1101685802=end'
      '1101685803=;'
      '1101685804='
      '1101685805=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1101685806=RETURNS ('
      '1101685807=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1101685808=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '1101685809=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '1101685810=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '1101685811=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '1101685812=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1101685813=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1101685814=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '1101685815=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '1101685816=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101685817=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101685818=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101685819=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101685820=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC,'
      '1101685821=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101685822=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC,'
      '1101685823=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101685824=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE,'
      '1101685825=  IS_MARKED TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '1101685826=  MARK_CODE TYPE OF COLUMN SKLAD_TMP.MARK_CODE)'
      '1101685827=AS'
      '1101685828=begin'
      '1101685829=  FOR'
      
        '1101685830=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T' +
        '.SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '1101685831=           ,PRICE_CURRENCY'
      '1101685832=           ,SUMM_CURRENCY'
      '1101685833=           ,CHARGE_ROZN_PROC'
      '1101685834=           ,PRICE_ROZN'
      '1101685835=           ,CHARGE_OPT_PROC'
      '1101685836=           ,PRICE_OPT'
      '1101685837=           ,CHANGE_SALE_PRICE'
      '1101685838=           ,P.IS_MARKED'
      '1101685839=           ,MARK_CODE'
      '1101685840=    FROM SKLAD_TMP T,'
      '1101685841=         G_PRODUCT P'
      '1101685842=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101685843=    ORDER BY T.sklad'
      
        '1101685844=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, ' +
        ':NDS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '1101685845=      ,:PRICE_CURRENCY'
      '1101685846=      ,:SUMM_CURRENCY'
      '1101685847=      ,:CHARGE_ROZN_PROC'
      '1101685848=       ,:PRICE_ROZN'
      '1101685849=       ,:CHARGE_OPT_PROC'
      '1101685850=       ,:PRICE_OPT'
      '1101685851=       ,:CHANGE_SALE_PRICE'
      '1101685852=       ,:IS_MARKED'
      '1101685853=       ,:MARK_CODE'
      '1101685854=  DO'
      '1101685855=    suspend;'
      '1101685856=end'
      '1101685857=;'
      '1101685858='
      '1101685859=ALTER PROCEDURE READ_UNIVERS_LIST('
      '1101685860=  POPUP_CODE_ VARCHAR(20),'
      '1101685861=  PARAM1_ VARCHAR(20),'
      '1101685862=  PARAM2_ VARCHAR(20))'
      '1101685863=RETURNS ('
      '1101685864=  ID DM_BIGINT,'
      '1101685865=  NAME VARCHAR(250),'
      '1101685866=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101685867=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE)'
      '1101685868=AS'
      '1101685869=begin'
      '1101685870=  IF (POPUP_CODE_ = '#39'peTovar'#39') THEN'
      '1101685871=    FOR SELECT G_PRODUCT,'
      '1101685872=               NAME,'
      '1101685873=               ARTICUL,'
      '1101685874=               BARCODE'
      '1101685875=          FROM G_PRODUCT G'
      
        '1101685876=         WHERE G.G_PRODUCT_PAR = CAST(:PARAM1_ AS INT' +
        'EGER)'
      '1101685877=           AND G.IS_ACTIVE = 1'
      '1101685878=          INTO :ID,'
      '1101685879=               :NAME,'
      '1101685880=               :ARTICUL,'
      '1101685881=               :BARCODE'
      '1101685882=    DO'
      '1101685883=      SUSPEND;'
      '1101685884=end'
      '1101685885=;'
      '1101685886='
      '1101685887=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST('
      '1101685888=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101685889=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE)'
      '1101685890=RETURNS ('
      '1101685891=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '1101685892=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS,'
      '1101685893=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '1101685894=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101685895=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101685896=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101685897=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_PERC,'
      
        '1101685898=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1101685899=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1101685900=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101685901=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101685902=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101685903=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101685904=  ED_NAME TYPE OF COLUMN G_UNIT.NAME)'
      '1101685905=AS'
      '1101685906=begin'
      '1101685907='
      '1101685908=  FOR'
      '1101685909=    SELECT D.ZAKAZ,'
      '1101685910=           D.ZAKAZ_DETAILS,'
      '1101685911=           D.G_PRODUCT,'
      '1101685912=           D.AMOUNT,'
      '1101685913=           D.PRICE,'
      '1101685914=           D.SUMM,'
      '1101685915=           D.DISCOUNT_PERC,'
      '1101685916=           D.DISCOUNT_TENGE,'
      '1101685917=           D.DISCOUNT_SUMM,'
      '1101685918=           G.ARTICUL,'
      '1101685919=           G.NOMENCLATUR_NUM,'
      '1101685920=           G.BARCODE,'
      '1101685921=           G.NAME,'
      '1101685922=           COALESCE(GU.SHORT_NAME, GU.NAME)'
      '1101685923=      FROM ZAKAZ_DETAILS D,'
      '1101685924=           G_PRODUCT G,'
      '1101685925=           G_UNIT GU'
      '1101685926=     WHERE D.ZAKAZ = :ZAKAZ_'
      '1101685927=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101685928=       AND G.G_UNIT = GU.G_UNIT'
      '1101685929=       AND :IS_SPISANIE_ <> 3'
      '1101685930=    UNION ALL'
      '1101685931=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '1101685932=           D.SKLAD ZAKAZ_DETAILS,'
      '1101685933=           D.G_PRODUCT,'
      '1101685934=           D.AMOUNT,'
      '1101685935=           D.PRICE,'
      '1101685936=           D.SUMM,'
      '1101685937=           0 DISCOUNT_PERC,'
      '1101685938=           0 DISCOUNT_TENGE,'
      '1101685939=           0 DISCOUNT_SUMM,'
      '1101685940=           G.ARTICUL,'
      '1101685941=           G.NOMENCLATUR_NUM,'
      '1101685942=           G.BARCODE,'
      '1101685943=           G.NAME,'
      '1101685944=           GU.NAME'
      '1101685945=      FROM SKLAD D,'
      '1101685946=           G_PRODUCT G,'
      '1101685947=           G_UNIT GU'
      '1101685948=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '1101685949=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101685950=       AND G.G_UNIT = GU.G_UNIT'
      '1101685951=       AND :IS_SPISANIE_ = 3'
      '1101685952=    ORDER BY 1'
      '1101685953=    INTO  :ZAKAZ,'
      '1101685954=          :ZAKAZ_DETAILS,'
      '1101685955=          :G_PRODUCT,'
      '1101685956=          :AMOUNT,'
      '1101685957=          :PRICE,'
      '1101685958=          :SUMM,'
      '1101685959=          :DISCOUNT_PERC,'
      '1101685960=          :DISCOUNT_TENGE,'
      '1101685961=          :DISCOUNT_SUMM,'
      '1101685962=          :ARTICUL,'
      '1101685963=          :NOMENCLATUR_NUM,'
      '1101685964=          :BARCODE,'
      '1101685965=          :PRODUCT_NAME,'
      '1101685966=          :ED_NAME'
      '1101685967=  DO'
      '1101685968=    suspend;'
      '1101685969=end'
      '1101685970=;'
      '1101685971='
      '1101685972=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_REAL('
      '1101685973=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101685974=  IS_VOZVRAT_ INTEGER)'
      '1101685975=RETURNS ('
      '1101685976=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '1101685977=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS,'
      '1101685978=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '1101685979=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101685980=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101685981=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101685982=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_PERC,'
      
        '1101685983=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1101685984=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101685985=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101685986=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101685987=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101685988=  ED_NAME TYPE OF COLUMN G_UNIT.NAME)'
      '1101685989=AS'
      '1101685990=begin'
      '1101685991=  FOR'
      '1101685992=    SELECT D.ZAKAZ,'
      '1101685993=           D.ZAKAZ_DETAILS,'
      '1101685994=           D.G_PRODUCT,'
      '1101685995=           D.AMOUNT,'
      '1101685996=           D.PRICE,'
      '1101685997=           D.SUMM,'
      '1101685998=           D.DISCOUNT_PERC,'
      '1101685999=           D.DISCOUNT_SUMM,'
      '1101686000=           G.ARTICUL,'
      '1101686001=           G.NOMENCLATUR_NUM,'
      '1101686002=           G.BARCODE,'
      '1101686003=           G.NAME,'
      '1101686004=           GU.NAME'
      '1101686005=      FROM ZAKAZ_DETAILS D,'
      '1101686006=           G_PRODUCT G,'
      '1101686007=           G_UNIT GU'
      '1101686008=     WHERE D.ZAKAZ = :ZAKAZ_'
      '1101686009=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101686010=       AND G.G_UNIT = GU.G_UNIT'
      '1101686011=       AND :IS_VOZVRAT_ = 0'
      '1101686012=    UNION ALL'
      '1101686013=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '1101686014=           D.SKLAD ZAKAZ_DETAILS,'
      '1101686015=           D.G_PRODUCT,'
      '1101686016=           D.AMOUNT,'
      '1101686017=           D.PRICE,'
      '1101686018=           D.SUMM,'
      '1101686019=           0 DISCOUNT_PERC,'
      '1101686020=           0 DISCOUNT_SUMM,'
      '1101686021=           G.ARTICUL,'
      '1101686022=           G.NOMENCLATUR_NUM,'
      '1101686023=           G.BARCODE,'
      '1101686024=           G.NAME,'
      '1101686025=           GU.NAME'
      '1101686026=      FROM SKLAD D,'
      '1101686027=           G_PRODUCT G,'
      '1101686028=           G_UNIT GU'
      '1101686029=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '1101686030=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101686031=       AND G.G_UNIT = GU.G_UNIT'
      '1101686032=       AND :IS_VOZVRAT_ = 1'
      '1101686033=    ORDER BY 2'
      '1101686034=    INTO  :ZAKAZ,'
      '1101686035=          :ZAKAZ_DETAILS,'
      '1101686036=          :G_PRODUCT,'
      '1101686037=          :AMOUNT,'
      '1101686038=          :PRICE,'
      '1101686039=          :SUMM,'
      '1101686040=          :DISCOUNT_PERC,'
      '1101686041=          :DISCOUNT_SUMM,'
      '1101686042=          :ARTICUL,'
      '1101686043=          :NOMENCLATUR_NUM,'
      '1101686044=          :BARCODE,'
      '1101686045=          :TOVAR_NAME,'
      '1101686046=          :ED_NAME'
      '1101686047=  DO'
      '1101686048=    suspend;'
      '1101686049=end'
      '1101686050=;'
      '1101686051='
      '1101686052=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1101686053=RETURNS ('
      
        '1101686054=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '1101686055=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '1101686056=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '1101686057=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101686058=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101686059=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1101686060=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '1101686061=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '1101686062=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '1101686063=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1101686064=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1101686065=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101686066=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101686067=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101686068=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101686069=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PR' +
        'ICE,'
      '1101686070=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101686071=  IS_MARKED INTEGER,'
      '1101686072=  MARK_CODE TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE,'
      
        '1101686073=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TM' +
        'P.SUMM,'
      
        '1101686074=  ORIGINAL_KIT_ID TYPE OF COLUMN ZAKAZ_DETAILS_TMP.OR' +
        'IGINAL_KIT_ID,'
      
        '1101686075=  ORIGINAL_KIT_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP' +
        '.ORIGINAL_KIT_PRICE)'
      '1101686076=AS'
      '1101686077=begin'
      '1101686078='
      '1101686079=  FOR'
      '1101686080=    SELECT T.ZAKAZ_DETAILS,'
      '1101686081=           T.ZAKAZ,'
      '1101686082=           T.G_PRODUCT,'
      '1101686083=           T.AMOUNT,'
      '1101686084=           T.PRICE,'
      '1101686085=           T.SUMM,'
      '1101686086=           T.DISCOUNT_PERC,'
      '1101686087=           T.DISCOUNT_TENGE,'
      '1101686088=           T.DISCOUNT_SUMM,'
      '1101686089=           T.NDS,'
      '1101686090=           T.NDS_SUMM,'
      '1101686091=           P.NAME PRODUCT_NAME'
      '1101686092=           ,P.BARCODE'
      '1101686093=           ,P.ARTICUL'
      '1101686094=           ,P.PRICE'
      '1101686095=           ,P.IS_KIT'
      
        '1101686096=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_T' +
        'MP TM, G_PRODUCT GP'
      
        '1101686097=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.D' +
        'O_NOT_CHARGE_BONUS = 0)'
      '1101686098=           ,T.COST_PRICE'
      '1101686099=           ,P.IS_MARKED'
      '1101686100=           ,T.MARK_CODE'
      '1101686101=           ,T.ORIGINAL_KIT_ID'
      '1101686102=           ,T.ORIGINAL_KIT_PRICE'
      '1101686103=      FROM ZAKAZ_DETAILS_TMP T,'
      '1101686104=           G_PRODUCT P'
      '1101686105=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101686106=    ORDER BY t.ZAKAZ_DETAILS'
      '1101686107=    INTO :ZAKAZ_DETAILS,'
      '1101686108=          :ZAKAZ,'
      '1101686109=          :G_PRODUCT,'
      '1101686110=          :AMOUNT,'
      '1101686111=          :PRICE,'
      '1101686112=          :SUMM,'
      '1101686113=          :DISCOUNT_PERC,'
      '1101686114=          :DISCOUNT_TENGE,'
      '1101686115=          :DISCOUNT_SUMM,'
      '1101686116=          :NDS,'
      '1101686117=          :NDS_SUMM,'
      '1101686118=          :PRODUCT_NAME'
      '1101686119=          ,:BARCODE'
      '1101686120=          ,:ARTICUL'
      '1101686121=          ,:PRODUCT_PRICE'
      '1101686122=          ,:IS_KIT'
      '1101686123=          ,:SUM_TO_CHARGE_BONUS'
      '1101686124=          ,:COST_PRICE'
      '1101686125=          ,:IS_MARKED'
      '1101686126=          ,:MARK_CODE'
      '1101686127=          ,:ORIGINAL_KIT_ID'
      '1101686128=          ,:ORIGINAL_KIT_PRICE'
      '1101686129=  DO'
      '1101686130=    suspend;'
      '1101686131=end'
      '1101686132=;'
      '1101686133='
      '1101686134=ALTER PROCEDURE READ_ZAKAZ_NA_REAL_LIST('
      '1101686135=  MODE_ INTEGER)'
      '1101686136=RETURNS ('
      
        '1101686137=  ZAKAZ_NA_REAL TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL,'
      '1101686138=  G_CLIENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_CLIENT,'
      '1101686139=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '1101686140=  ZAKAZ_NUM TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVANI' +
        'E,'
      
        '1101686141=  ZAKAZ_DATE TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_D' +
        'ATE,'
      
        '1101686142=  ZAKAZ_REAL_PARENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.' +
        'ZAKAZ_REAL_PARENT,'
      '1101686143=  G_PRODUCT TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '1101686144=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101686145=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101686146=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101686147=  PRICE TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      '1101686148=  AMOUNT_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1101686149=  SUMM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      
        '1101686150=  AMOUNT_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PA' +
        'YED,'
      '1101686151=  SUMM_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '1101686152=  AMOUNT_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT' +
        '_RETURNED,'
      
        '1101686153=  SUMM_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAY' +
        'ED,'
      
        '1101686154=  AMOUNT_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PAY' +
        'ED,'
      '1101686155=  SUMM_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '1101686156=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.IS_PAYED_' +
        'ALL,'
      
        '1101686157=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '1101686158=  PRODCAT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101686159=  AM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1101686160=  SU_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL)'
      '1101686161=AS'
      '1101686162=begin'
      '1101686163=  FOR SELECT Z.ZAKAZ_NA_REAL,'
      '1101686164=             ZP.G_CLIENT,'
      '1101686165=             C.NAME,'
      '1101686166=             ZP.ZAKAZ_DATE,'
      '1101686167=             Z.G_PRODUCT,'
      '1101686168=             P.NAME,'
      '1101686169=             P.ARTICUL,'
      '1101686170=             P.BARCODE,'
      '1101686171=             Z.PRICE,'
      '1101686172=             Z.AMOUNT_ALL,'
      '1101686173=             Z.SUMM_ALL,'
      '1101686174=             Z.AMOUNT_PAYED,'
      '1101686175=             Z.SUMM_PAYED,'
      '1101686176=             COALESCE(Z.AMOUNT_RETURNED, 0),'
      '1101686177=             COALESCE(Z.SUMM_RETURNED, 0),'
      
        '1101686178=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE' +
        '(Z.AMOUNT_RETURNED, 0),'
      
        '1101686179=             Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.S' +
        'UMM_RETURNED, 0),'
      '1101686180=             Z.IS_PAYED_ALL,'
      '1101686181=             P.G_PRODUCT_PAR,'
      '1101686182=             CAT.NAME,'
      '1101686183=             ZP.ZAKAZ_REAL_PARENT,'
      '1101686184=             ZP.OSNOVANIE,'
      '1101686185=             ZT.AM_ALL,'
      '1101686186=             ZT.SU_ALL'
      
        '1101686187=        FROM ZAKAZ_REAL_PARENT ZP, ZAKAZ_NA_REAL Z, G' +
        '_CLIENT C, G_PRODUCT P, g_product CAT/*(select -1 g_product, '#39#1041#1077 +
        #1079' '#1075#1088#1091#1087#1087#1099#39' NAME FROM RDB$DATABASE'
      
        '1101686188=                                                     ' +
        '                         UNION ALL'
      
        '1101686189=                                                     ' +
        '                         SELECT g_product,  NAME FROM G_PRODUCT ' +
        'WHERE IS_CATEGORY = 1) CAT*/,'
      
        '1101686190=             (SELECT SUM(ZZ.AMOUNT_ALL - ZZ.amount_pa' +
        'yed - ZZ.amount_returned) AM_ALL,'
      
        '1101686191=                     SUM(ZZ.SUMM_ALL - ZZ.summ_payed ' +
        '- ZZ.summ_returned) SU_ALL,'
      '1101686192=                     ZPP.G_CLIENT,'
      '1101686193=                     ZPP.OSNOVANIE'
      '1101686194=                FROM ZAKAZ_REAL_PARENT ZPP,'
      '1101686195=                     ZAKAZ_NA_REAL ZZ'
      
        '1101686196=               WHERE ZPP.ZAKAZ_REAL_PARENT = ZZ.ZAKAZ' +
        '_REAL_PARENT'
      
        '1101686197=               GROUP BY ZPP.G_CLIENT, ZPP.OSNOVANIE) ' +
        'ZT'
      
        '1101686198=       WHERE ZP.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '1101686199=         AND ZP.G_CLIENT = C.G_CLIENT'
      
        '1101686200=         AND ZP.ZAKAZ_REAL_PARENT = Z.ZAKAZ_REAL_PARE' +
        'NT'
      '1101686201=         AND Z.G_PRODUCT = P.G_PRODUCT'
      '1101686202=         AND P.G_PRODUCT_par = CAT.G_PRODUCT'
      '1101686203=         AND ZP.G_CLIENT = ZT.G_CLIENT'
      '1101686204=         AND ZP.OSNOVANIE = ZT.OSNOVANIE'
      '1101686205=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      '1101686206=         AND ((Z.IS_PAYED_ALL = 0 AND :MODE_ = 0)'
      '1101686207=              OR'
      
        '1101686208=              (Z.IS_PAYED_ALL = 1 AND Z.AMOUNT_PAYED ' +
        '> 0 AND :MODE_ = 1)'
      '1101686209=              OR'
      
        '1101686210=              (COALESCE(Z.AMOUNT_RETURNED, 0) > 0 AND' +
        ' :MODE_ = 2)'
      '1101686211=              OR'
      '1101686212=              :MODE_ = 3)'
      '1101686213=       ORDER BY C.NAME, ZP.ZAKAZ_DATE'
      '1101686214=      INTO :ZAKAZ_NA_REAL,'
      '1101686215=           :G_CLIENT,'
      '1101686216=           :CLIENT_NAME,'
      '1101686217=           :ZAKAZ_DATE,'
      '1101686218=           :G_PRODUCT,'
      '1101686219=           :PRODUCT_NAME,'
      '1101686220=           :ARTICUL,'
      '1101686221=           :BARCODE,'
      '1101686222=           :PRICE,'
      '1101686223=           :AMOUNT_ALL,'
      '1101686224=           :SUMM_ALL,'
      '1101686225=           :AMOUNT_PAYED,'
      '1101686226=           :SUMM_PAYED,'
      '1101686227=           :AMOUNT_RETURNED,'
      '1101686228=           :SUMM_RETURNED,'
      '1101686229=           :AMOUNT_LEFT,'
      '1101686230=           :SUMM_LEFT,'
      '1101686231=           :IS_PAYED_ALL,'
      '1101686232=           :G_PRODUCT_PAR,'
      '1101686233=           :PRODCAT_NAME,'
      '1101686234=           :ZAKAZ_REAL_PARENT,'
      '1101686235=           :ZAKAZ_NUM,'
      '1101686236=           :AM_ALL,'
      '1101686237=           :SU_ALL'
      '1101686238=  DO'
      '1101686239=    suspend;'
      '1101686240=end'
      '1101686241=;'
      '1101686242='
      '1101686243=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD('
      '1101686244=  OBJECT_TYPE_ INTEGER)'
      '1101686245=RETURNS ('
      '1101686246=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '1101686247=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101686248=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101686249=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101686250=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101686251=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101686252=  CLIENT_ID TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101686253=  IDN TYPE OF COLUMN G_CLIENT.IDN,'
      '1101686254=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101686255=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '1101686256=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101686257=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101686258=  SUMM_SERT MY_NUMERIC,'
      '1101686259=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101686260=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101686261=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101686262=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101686263=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101686264=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101686265=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101686266=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_A' +
        'PP)'
      '1101686267=AS'
      '1101686268=/*'
      '1101686269=*/'
      '1101686270=BEGIN'
      '1101686271=  FOR SELECT S.OPER'
      '1101686272=              ,Z.ZAKAZ'
      '1101686273=              ,Z.Z_DATE'
      '1101686274=              ,Z.Z_TIME'
      '1101686275=              ,C.G_CLIENT ID'
      '1101686276=              ,C.IDN'
      '1101686277=              ,C.NAME CLIENT_NAME'
      '1101686278=              ,G.NAME SKLAD_NAME'
      '1101686279=              ,Z.SUMM_CASH'
      '1101686280=              ,Z.SUMM_NONCASH'
      '1101686281=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1101686282=              ,P.ARTICUL'
      '1101686283=              ,P.BARCODE'
      '1101686284=              ,P.NOMENCLATUR_NUM'
      '1101686285=              ,P.NAME'
      '1101686286=              ,ZD.AMOUNT'
      '1101686287=              ,ZD.PRICE - ZD.DISCOUNT_TENGE PRICE'
      '1101686288=              ,ZD.SUMM'
      '1101686289=              ,S.SYNC_EXT_APP'
      '1101686290=              ,Z.OSNOVANIE'
      '1101686291=              ,Z.NOTE'
      '1101686292=         FROM SYNC_EXT_APP S'
      '1101686293=              ,ZAKAZ Z'
      '1101686294=              ,ZAKAZ_DETAILS ZD'
      '1101686295=              ,G_TOCHKA G'
      '1101686296=              ,G_CLIENT C'
      '1101686297=              ,G_PRODUCT P'
      '1101686298=        WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1101686299=          AND S.OBJECT_TYPE = 1'
      '1101686300=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1101686301=          AND S.ID = Z.ZAKAZ'
      '1101686302=          AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101686303=          AND Z.G_TOCHKA = G.G_TOCHKA'
      '1101686304=          AND Z.G_CLIENT = C.G_CLIENT'
      '1101686305=          AND ZD.G_PRODUCT = P.G_PRODUCT'
      '1101686306=        UNION ALL'
      '1101686307=        SELECT S.OPER'
      '1101686308=               ,S.ID'
      '1101686309=               ,NULL Z_DATE'
      '1101686310=               ,NULL Z_TIME'
      '1101686311=               ,NULL ID'
      '1101686312=               ,NULL IDN'
      '1101686313=               ,NULL CLIENT_NAME'
      '1101686314=               ,NULL SKLAD_NAME'
      '1101686315=               ,0 SUMM_CASH'
      '1101686316=               ,0 SUMM_NONCASH'
      '1101686317=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1101686318=               ,NULL ARTICUL'
      '1101686319=               ,NULL BARCODE'
      '1101686320=               ,NULL NOMENCLATUR_NUM'
      '1101686321=               ,NULL'
      '1101686322=               ,0 AMOUNT'
      '1101686323=               ,0 PRICE'
      '1101686324=               ,0 SUMM'
      '1101686325=               ,S.SYNC_EXT_APP'
      '1101686326=               ,NULL OSNOVANIE'
      '1101686327=               ,NULL NOTE'
      '1101686328=          FROM SYNC_EXT_APP S'
      '1101686329=         WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1101686330=           AND S.OBJECT_TYPE = 1'
      '1101686331=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1101686332=        UNION ALL'
      '1101686333=        SELECT S.OPER'
      '1101686334=              ,SP.SKLAD ZAKAZ'
      '1101686335=              ,SP.DATE_RECEIPT Z_DATE'
      '1101686336=              ,NULL Z_TIME'
      '1101686337=              ,C.G_CLIENT ID'
      '1101686338=              ,C.IDN'
      '1101686339=              ,C.NAME CLIENT_NAME'
      '1101686340=              ,G.NAME SKLAD_NAME'
      
        '1101686341=              ,(SELECT SUM(KS.SUMM) FROM KASSA KS WHE' +
        'RE KS.SKLAD = SP.SKLAD) SUMM_CASH'
      
        '1101686342=              ,(SELECT SUM(KS.SUMM) FROM KASSA_BEZNAL' +
        ' KS WHERE KS.SKLAD = SP.SKLAD) SUMM_NONCASH'
      '1101686343=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1101686344=              ,P.ARTICUL'
      '1101686345=              ,P.BARCODE'
      '1101686346=              ,P.NOMENCLATUR_NUM'
      '1101686347=              ,P.NAME'
      '1101686348=              ,SD.AMOUNT'
      '1101686349=              ,SD.PRICE'
      '1101686350=              ,SD.SUMM'
      '1101686351=              ,S.SYNC_EXT_APP'
      '1101686352=              ,SP.OSNOVANIE'
      '1101686353=              ,SP.NOTE'
      '1101686354=         FROM SYNC_EXT_APP S'
      '1101686355=              ,SKLAD_PARENT SP'
      '1101686356=              ,SKLAD SD'
      '1101686357=              ,G_TOCHKA G'
      '1101686358=              ,G_CLIENT C'
      '1101686359=              ,G_PRODUCT P'
      '1101686360=        WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1101686361=          AND S.OBJECT_TYPE = 2'
      '1101686362=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1101686363=          AND S.ID = SP.SKLAD'
      '1101686364=          AND SP.SKLAD = SD.SKLAD_PARENT'
      '1101686365=          AND SP.G_TOCHKA = G.G_TOCHKA'
      '1101686366=          AND SP.G_CLIENT = C.G_CLIENT'
      '1101686367=          AND SD.G_PRODUCT = P.G_PRODUCT'
      '1101686368=        UNION ALL'
      '1101686369=        SELECT S.OPER'
      '1101686370=               ,S.ID'
      '1101686371=               ,NULL Z_DATE'
      '1101686372=               ,NULL Z_TIME'
      '1101686373=               ,NULL ID'
      '1101686374=               ,NULL IDN'
      '1101686375=               ,NULL CLIENT_NAME'
      '1101686376=               ,NULL SKLAD_NAME'
      '1101686377=               ,0 SUMM_CASH'
      '1101686378=               ,0 SUMM_NONCASH'
      '1101686379=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '1101686380=               ,NULL ARTICUL'
      '1101686381=               ,NULL BARCODE'
      '1101686382=               ,NULL NOMENCLATUR_NUM'
      '1101686383=               ,NULL'
      '1101686384=               ,0 AMOUNT'
      '1101686385=               ,0 PRICE'
      '1101686386=               ,0 SUMM'
      '1101686387=               ,S.SYNC_EXT_APP'
      '1101686388=               ,NULL OSNOVANIE'
      '1101686389=               ,NULL NOTE'
      '1101686390=          FROM SYNC_EXT_APP S'
      '1101686391=         WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '1101686392=           AND S.OBJECT_TYPE = 2'
      '1101686393=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '1101686394=        ORDER BY 1, 3, 4, 2, 10'
      '1101686395=         INTO :OPER,'
      '1101686396=              :ZAKAZ,'
      '1101686397=              :Z_DATE,'
      '1101686398=              :Z_TIME,'
      '1101686399=              :CLIENT_ID,'
      '1101686400=              :IDN,'
      '1101686401=              :CLIENT_NAME,'
      '1101686402=              :SKLAD_NAME,'
      '1101686403=              :SUMM_CASH,'
      '1101686404=              :SUMM_NONCASH,'
      '1101686405=              :SUMM_SERT,'
      '1101686406=              :ARTICUL,'
      '1101686407=              :BARCODE,'
      '1101686408=              :NOMENCLATUR_NUM,'
      '1101686409=              :TOVAR_NAME,'
      '1101686410=              :AMOUNT,'
      '1101686411=              :PRICE,'
      '1101686412=              :SUMM,'
      '1101686413=              :SYNC_EXT_APP,'
      '1101686414=              :OSNOVANIE,'
      '1101686415=              :NOTE'
      '1101686416=  DO'
      '1101686417=    SUSPEND;'
      '1101686418=END'
      '1101686419=;'
      '1101686420='
      '1101686421='
      
        '1101686422=UPDATE SYSTEM_SETUP SET S_VALUE = 110168 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101686423=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101686424=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
