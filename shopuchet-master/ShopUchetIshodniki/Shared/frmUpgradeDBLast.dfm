        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1102111280=                                     NDS_SUMM)'
      
        '1102111281=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1102111282=                  :G_PRODUCT,'
      
        '1102111283=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1102111284=                  :AMOUNT, :SUMM,'
      '1102111285=                  0, --AMOUNT_PAYED,'
      '1102111286=                  0, --SUMM_PAYED,'
      '1102111287=                  0, --IS_PAYED_ALL,'
      '1102111288=                  :DISCOUNT_PERC,'
      '1102111289=                  :DISCOUNT_TENGE,'
