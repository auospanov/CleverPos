      '1102014499='
      
        '1102014500=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1102014501=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '1102014502=        '#39'AS '#39'||CRLF||'
      '1102014503=        '#39'BEGIN '#39'||CRLF||'
      
        '1102014504=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1102014505=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRL' +
        'F||'
      
        '1102014506=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1102014507=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1102014508=        '#39'END;'#39';'
      '1102014509=    EXECUTE STATEMENT :TRGI;'
      '1102014510='
      '1102014511=    TN_ALT = TN;'
      '1102014512=  END'
      '1102014513=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '1102014514=        FROM RDB$RELATIONS R'
      '1102014515=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1102014516=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '1102014517=       ORDER BY R.RDB$RELATION_NAME'
      '1102014518=        INTO :TN'
      '1102014519=  DO BEGIN'
      '1102014520=    TN=TRIM(TN);'
      '1102014521=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '1102014522='
      '1102014523=    EXECUTE STATEMENT :SQLSTMT;'
      '1102014524=  END'
      '1102014525=END'
      '1102014526=;'
      '1102014527='
      '1102014528=ALTER PROCEDURE P_REP_TOVAR_HISTORY('
      '1102014529=  G_PRODUCT_ARR_ BLOB SUB_TYPE 1,'
      '1102014530=  DATE_BEGIN_ DATE,'
      '1102014531=  DATE_END_ DATE,'
      '1102014532=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1102014533=RETURNS ('
      '1102014534=  ROW INTEGER,'
      '1102014535=  DATE_ACT DATE,'
      '1102014536=  OPER VARCHAR(500),'
      '1102014537=  PRICE_PRIHOD NUMERIC(15,2),'
      '1102014538=  AMOUNT_PRIHOD MY_NUMERIC_5,'
      '1102014539=  SUMM_PRIHOD NUMERIC(15,2),'
      '1102014540=  PRICE_UHOD NUMERIC(15,2),'
      '1102014541=  AMOUNT_UHOD MY_NUMERIC_5,'
      '1102014542=  SUMM_UHOD NUMERIC(15,2),'
      '1102014543=  ERR_CODE INTEGER,'
      '1102014544=  ERR_MSG VARCHAR(1024))'
      '1102014545=AS'
      
        '1102014546=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1102014547=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102014548=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      '1102014549=DECLARE VARIABLE DATE_SORT DATE;'
      '1102014550=BEGIN'
      '1102014551='
      '1102014552=  FOR SELECT F.G_PRODUCT'
      '1102014553=        FROM G_PRODUCT F'
      
        '1102014554=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39'~'#39'||F.G_PROD' +
        'UCT||'#39'~'#39
      '1102014555=       AND EXISTS (SELECT 1'
      '1102014556=                     FROM SKLAD SS'
      
        '1102014557=                    WHERE SS.DATE_RECEIPT BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      '1102014558=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '1102014559=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||SS.G_TOCHKA||'#39'-'#39
      '1102014560=                   UNION ALL'
      '1102014561=                   SELECT 1'
      '1102014562=                     FROM SKLAD SS'
      
        '1102014563=                    WHERE SS.DATE_RECEIPT BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      '1102014564=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '1102014565=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||SS.G_CLIENT||'#39'-'#39
      '1102014566=                   UNION ALL'
      '1102014567=                   SELECT 1'
      '1102014568=                     FROM ZAKAZ ZZ,'
      '1102014569=                          ZAKAZ_DETAILS ZZD'
      '1102014570=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '1102014571=                      AND ZZ.IS_RESERVE = 0'
      
        '1102014572=                      AND ZZ.Z_DATE BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '1102014573=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      '1102014574=                      AND ZZ.IS_SPISANIE <> 2'
      
        '1102014575=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||ZZ.G_TOCHKA||'#39'-'#39
      '1102014576=                   UNION ALL'
      '1102014577=                   SELECT 1'
      '1102014578=                     FROM ZAKAZ_REAL_PARENT Z,'
      '1102014579=                          ZAKAZ_NA_REAL D'
      
        '1102014580=                    WHERE Z.ZAKAZ_REAL_PARENT = D.ZAK' +
        'AZ_REAL_PARENT'
      
        '1102014581=                      AND Z.ZAKAZ_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102014582=                      AND D.G_PRODUCT = F.G_PRODUCT'
      
        '1102014583=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1102014584=                   UNION ALL'
      '1102014585=                   SELECT 1'
      '1102014586=                     FROM OTHER ZZ,'
      '1102014587=                          OTHER_DETAILS ZZD'
      '1102014588=                    WHERE ZZ.OTHER = ZZD.OTHER'
      
        '1102014589=                      AND ZZ.OP_DATE BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '1102014590=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      
        '1102014591=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||ZZ.G_TOCHKA||'#39'-'#39
      '1102014592=                   )'
      '1102014593=       ORDER BY F.NAME'
      '1102014594=       INTO :G_PRODUCT_'
      '1102014595=  DO BEGIN'
      '1102014596=      FOR SELECT -2,'
      
        '1102014597=                 CAST('#39'01.01.1985'#39' AS DATE) DATE_SORT' +
        ','
      '1102014598=                 NULL,'
      '1102014599=                 NAME,'
      '1102014600=                 NULL,'
      '1102014601=                 NULL,'
      '1102014602=                 NULL,'
      '1102014603=                 NULL,'
