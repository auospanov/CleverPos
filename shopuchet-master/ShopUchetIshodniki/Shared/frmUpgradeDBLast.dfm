        'APP_'
      '1102112324=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102112325=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102112326='
      
        '1102112327=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1102112328=            PNT_ = '#39'023'#39';'
      '1102112329=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102112330=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102112331=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_,'
      
        '1102112332=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102112333=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102112334=                   AND L.G_TOCHKA = :G_CLIENT_;'
