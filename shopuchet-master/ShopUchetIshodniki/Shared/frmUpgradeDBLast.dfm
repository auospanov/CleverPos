      '11096365=                        PNT_ = '#39'07'#39';'
      
        '11096366=                        EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '11096367=                        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11096368=                          ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '11096369=                          EXIT;'
      '11096370=                        END'
      '11096371='
      '11096372=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '11096373=                           EXECUTE PROCEDURE K_INS_KASS' +
        'A(0,     -- ACTION_ => :ACTION_'
      
        '11096374=                                                       ' +
        '   1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
