      '110169441=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110169442=  INCLUDE_NOL_ INTEGER,'
      '110169443=  INCLUDE_FEW_ INTEGER,'
      '110169444=  SORT_BY_NAME_ INTEGER,'
      
        '110169445=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIG' +
        'INT,'
      '110169446=  SCALE_PREFIX_ VARCHAR(2) = '#39#39','
      '110169447=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110169448=RETURNS ('
      '110169449=  PERIOD_ VARCHAR(40),'
      '110169450=  ROW_NUM VARCHAR(15),'
      '110169451=  ARTICUL VARCHAR(1000),'
      '110169452=  BARCODE VARCHAR(30),'
      
        '110169453=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLA' +
        'TUR_NUM */ VARCHAR(150),'
      
        '110169454=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250' +
        '),'
      
        '110169455=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(5' +
        '0),'
      
        '110169456=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(1' +
        '5,2),'
      
        '110169457=  VOLUME_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRIC' +
        'E */ NUMERIC(15,2),'
      
        '110169458=  SKIDKA_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRIC' +
        'E */ NUMERIC(15,2),'
      
        '110169459=  AMOUNT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '110169460=  AMOUNT_RESERVE /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT_RESERVE */ NUMERIC(18,5),'
      '110169461=  SUMM /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2),'
      
        '110169462=  PRICE_SELF /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(' +
        '15,2),'
      
        '110169463=  SUMM_SELF /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15' +
        ',2),'
      '110169464=  TOVAR_NAME VARCHAR(250),'
      
        '110169465=  CROSSCODE /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ B' +
        'LOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '110169466=  NOTE /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300' +
        '),'
      
        '110169467=  IS_CATEGORY /* TYPE OF COLUMN G_PRODUCT.IS_CATEGORY ' +
        '*/ INTEGER,'
      
        '110169468=  PLACE /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      
        '110169469=  BRAND /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(1' +
        '50),'
      '110169470=  ERR_CODE INTEGER,'
      '110169471=  ERR_MSG VARCHAR(1024))'
      '110169472=AS'
      '110169473=BEGIN'
      '110169474=  SUSPEND;'
      '110169475=END'
      '110169476=;'
      '110169477='
      '110169478='
      
        '110169479=/*****************************************************' +
        '*************************/'
      
        '110169480=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110169481=/*****************************************************' +
        '*************************/'
      '110169482=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110169483=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110169484=  MODE_ INTEGER = 0)'
      '110169485=RETURNS ('
      
        '110169486=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110169487=  ARTICUL_ VARCHAR(30),'
      '110169488=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110169489=  BARCODE_ VARCHAR(30),'
      '110169490=  NAME_ VARCHAR(500),'
      '110169491=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110169492=  PRICE_ NUMERIC(15,2),'
      '110169493=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110169494=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110169495=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110169496=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110169497=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110169498=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110169499=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110169500=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110169501=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110169502=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110169503=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110169504=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      
        '110169505=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110169506=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110169507=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110169508=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110169509=  ERR_CODE INTEGER,'
      '110169510=  ERR_MSG VARCHAR(1024))'
      '110169511=AS'
      '110169512=begin'
      '110169513=    SELECT'
      '110169514=        G_PRODUCT_PAR,'
      '110169515=        ARTICUL,'
      '110169516=        NOMENCLATUR_NUM,'
      '110169517=        BARCODE,'
      '110169518=        NAME,'
      '110169519=        G_UNIT,'
      '110169520=        PRICE,'
      '110169521=        VOLUME_PRICE,'
      '110169522=        PACK_AMOUNT,'
      '110169523=        MF_COUNTRY,'
      '110169524=        NOTE,'
      '110169525=        CROSSCODE,'
      '110169526=        IS_KIT,'
      '110169527=        MIN_AMOUNT,'
      '110169528=        PLACE,'
      '110169529=        SALES_COMM,'
      '110169530=        KOD_TNVD,'
      '110169531=        FAST_TOVAR,'
      '110169532=        DO_NOT_SHOW_RMK,'
      '110169533=        DO_NOT_CHARGE_BONUS,'
      '110169534=        IS_MARKED,'
      '110169535=        BRAND,'
      
        '110169536=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1))'
      '110169537=    FROM G_PRODUCT T'
      '110169538=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110169539=    INTO'
      '110169540=        :G_PRODUCT_PAR_,'
      '110169541=        :ARTICUL_,'
      '110169542=        :NOMENCLATUR_NUM_,'
      '110169543=        :BARCODE_,'
      '110169544=        :NAME_,'
      '110169545=        :G_UNIT_,'
      '110169546=        :PRICE_,'
      '110169547=        :VOLUME_PRICE_,'
      '110169548=        :PACK_AMOUNT_,'
      '110169549=        :MF_COUNTRY_,'
      '110169550=        :NOTE_,'
      '110169551=        :CROSSCODE_,'
      '110169552=        :IS_KIT_,'
      '110169553=        :MIN_AMOUNT_,'
      '110169554=        :PLACE_,'
      '110169555=        :SALES_COMM_,'
      '110169556=        :KOD_TNVD_,'
      '110169557=        :FAST_TOVAR_,'
      '110169558=        :DO_NOT_SHOW_RMK_,'
      '110169559=        :DO_NOT_CHARGE_BONUS_,'
      '110169560=        :IS_MARKED_,'
      '110169561=        :BRAND_,'
      '110169562=        :LAST_PRICE_;'
      '110169563='
      '110169564=    INSERT INTO LT_BARCODE_TMP'
      
        '110169565=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110169566='
      '110169567=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110169568=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110169569='
      
        '110169570=    INSERT INTO G_PRODUCT_KIT_TMP (G_PRODUCT_KIT, G_PR' +
        'ODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3)'
      
        '110169571=    SELECT DECODE(:MODE_, 0, G_PRODUCT_KIT, GEN_ID(GEN' +
        '_G_PRODUCT_KIT, 1)), G_PRODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, P' +
        'RICE1, PRICE2, PRICE3'
      '110169572=    FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRODUCT_;'
      '110169573=end'
      '110169574=;'
      '110169575='
      '110169576=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '110169577=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110169578=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110169579=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110169580=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110169581=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110169582=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110169583=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110169584=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110169585=  SELF_PRICE_ NUMERIC(15,2),'
      '110169586=  AMOUNT_ MY_NUMERIC_5,'
      '110169587=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110169588=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110169589=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110169590=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110169591=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '110169592=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110169593=  CATEGORY_NAME_ VARCHAR(1000),'
      '110169594=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110169595=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110169596=  IS_THIS_LAST_ INTEGER,'
      '110169597=  UPDATE_IF_EXIST_ INTEGER)'
      '110169598=RETURNS ('
      '110169599=  ERR_CODE INTEGER,'
      '110169600=  ERR_MSG VARCHAR(1024))'
      '110169601=AS'
      
        '110169602=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PR' +
        'ODUCT'#39';'
      '110169603=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110169604=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110169605=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR;'
      
        '110169606=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110169607=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110169608=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110169609=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110169610=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110169611=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110169612=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM_CURRENCY;'
      '110169613=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110169614=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110169615=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110169616=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110169617=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110169618=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110169619=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '110169620=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110169621=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '110169622=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110169623=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110169624=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110169625=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110169626=BEGIN'
      '110169627=    ERR_MSG = '#39#39';'
      '110169628=    PNT_ = '#39'00'#39';'
      '110169629='
      
        '110169630=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045 +
        #1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '110169631=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS8898' +
        '8~98888~"'
      
        '110169632=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053 +
        #1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '110169633=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '110169634=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~' +
        #39');'
      '110169635=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '110169636=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '110169637=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '110169638=    END ELSE'
      '110169639=        CROSSCODE_ = NULL;'
      '110169640='
      '110169641=    PNT_ = '#39'01'#39';'
      '110169642=    SELECT ID'
      '110169643=      FROM CUR_PARAMS'
      '110169644=    WHERE CUR_PARAMS = 2'
      '110169645=      INTO :G_TOCHKA_;'
      '110169646='
      '110169647=    SELECT G.G_UNIT'
      '110169648=      FROM G_UNIT G'
      
        '110169649=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME' +
        '_G_UNIT_))'
      '110169650=      INTO :G_UNIT_;'
      '110169651=    if (ROW_COUNT = 0) then'
      '110169652=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110169653='
      '110169654=    PNT_ = '#39'02'#39';'
      
        '110169655=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110169656=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '110169657=        SELECT G.G_PRODUCT,'
      '110169658=               G.NAME'
      '110169659=          FROM G_PRODUCT G'
      
        '110169660=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110169661=           AND TRIM(G.ARTICUL) <> '#39#39
      '110169662=           AND G.IS_ACTIVE = 1'
      '110169663=          INTO :G_PRODUCT_,'
      '110169664=               :G_PRODUCT_NAME_;'
      '110169665='
      
        '110169666=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110169667=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110169668=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110169669=              UPDATE G_PRODUCT G'
      '110169670=                 SET G.NAME = :NAME_,'
      '110169671=                     G.G_UNIT = :G_UNIT_,'
      '110169672=                     G.PRICE  = :PRICE_,'
      '110169673=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110169674=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110169675=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110169676=                     G.PLACE = :PLACE_,'
      
        '110169677=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110169678=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110169679=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110169680=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110169681=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110169682=                     ,G.BRAND          = :BRAND_'
      '110169683=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110169684='
      
        '110169685=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110169686=            END ELSE'
      
        '110169687=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110169688=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110169689=        END'
      '110169690=    END ELSE'
      
        '110169691=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110169692='
      
        '110169693=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110169694=    PNT_ = '#39'02a'#39';'
      
        '110169695=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110169696=        SELECT G.G_PRODUCT,'
      '110169697=               G.NAME'
      '110169698=          FROM G_PRODUCT G'
      
        '110169699=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110169700=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110169701=           AND G.IS_ACTIVE = 1'
      '110169702=          INTO :G_PRODUCT_,'
      '110169703=               :G_PRODUCT_NAME_;'
      '110169704='
      
        '110169705=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110169706=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110169707=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110169708=              UPDATE G_PRODUCT G'
      '110169709=                 SET G.NAME = :NAME_,'
      '110169710=                     G.G_UNIT = :G_UNIT_,'
      '110169711=                     G.PRICE  = :PRICE_,'
      '110169712=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110169713=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110169714=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110169715=                     G.PLACE = :PLACE_,'
      
        '110169716=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110169717=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110169718=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110169719=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110169720=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110169721=                     ,G.BRAND          = :BRAND_'
      '110169722=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110169723='
      
        '110169724=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110169725=            END ELSE'
      
        '110169726=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110169727=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110169728=        END'
      '110169729=    end'
      '110169730='
      
        '110169731=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110169732=    PNT_ = '#39'02b'#39';'
      
        '110169733=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110169734=        SELECT G.G_PRODUCT,'
      '110169735=               G.NAME'
      '110169736=          FROM G_PRODUCT G'
      '110169737=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110169738=           AND TRIM(G.BARCODE) <> '#39#39
      '110169739=           AND G.IS_ACTIVE = 1'
      '110169740=          INTO :G_PRODUCT_,'
      '110169741=               :G_PRODUCT_NAME_;'
      '110169742='
      '110169743=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110169744=          SELECT G.G_PRODUCT,'
      '110169745=                 G.NAME'
      '110169746=            FROM G_PRODUCT G, LT_BARCODE L'
      '110169747=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110169748=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110169749=             AND TRIM(L.BARCODE) <> '#39#39
      '110169750=            INTO :G_PRODUCT_,'
      '110169751=                 :G_PRODUCT_NAME_;'
      '110169752='
      
        '110169753=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110169754=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110169755=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110169756=              UPDATE G_PRODUCT G'
      '110169757=                 SET G.NAME = :NAME_,'
      '110169758=                     G.G_UNIT = :G_UNIT_,'
      '110169759=                     G.PRICE  = :PRICE_,'
      '110169760=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110169761=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110169762=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110169763=                     G.PLACE = :PLACE_,'
      
        '110169764=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110169765=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110169766=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110169767=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110169768=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110169769=                     ,G.BRAND          = :BRAND_'
      '110169770=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110169771='
      
        '110169772=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110169773=            END ELSE'
      
        '110169774=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110169775=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110169776=        END'
      
        '110169777=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110169778=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110169779='
      
        '110169780=    --================================================' +
        '========='
      '110169781=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110169782=    --================================================' +
        '========='
      '110169783=    PNT_ = '#39'02b'#39';'
      '110169784=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110169785='
      
        '110169786=        ----------------------------------------------' +
        '--------------------'
      
        '110169787=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' ' +
        #1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '110169788=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080 +
        '~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110169789=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110169790=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', ' +
        #1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '110169791=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110169792=            G_PRODUCT_PAR_ = NULL;'
      
        '110169793=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110169794=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110169795=              STR_ = CATEGORY_NAME_;'
      '110169796=              CATEGORY_NAME_ = '#39#39';'
      '110169797=            END ELSE'
      
        '110169798=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110169799='
      '110169800=            SELECT G_PRODUCT'
      '110169801=              FROM G_PRODUCT G'
      '110169802=             WHERE G.NAME = :STR_'
      '110169803=               AND G.IS_CATEGORY = 1'
      
        '110169804=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110169805=                   OR'
      '110169806=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '110169807=              INTO G_PRODUCT_PAR_;'
      '110169808=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110169809=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110169810=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110169811=                RETURNING G_PRODUCT'
      '110169812=                INTO :G_PRODUCT_PAR_;'
      '110169813='
      '110169814=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110169815=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110169816=        END'
      
        '110169817=        ----------------------------------------------' +
        '--------------------'
      '110169818='
      
        '110169819=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110169820=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110169821=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110169822=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110169823=        RETURNING G_PRODUCT'
      '110169824=        INTO :G_PRODUCT_;'
      '110169825='
      
        '110169826=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110169827=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110169828=    end'
      '110169829='
      
        '110169830=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110169831=    PNT_ = '#39'03'#39';'
      '110169832=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110169833=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110169834=                                       :AMOUNT_,'
      '110169835=                                       :SELF_PRICE_,'
      
        '110169836=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110169837=                                       0, --nds_,'
      '110169838=                                       0 --nds_summ_,'
      
        '110169839=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110169840=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110169841=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110169842=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110169843=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110169844=          EXIT;'
      '110169845=        END'
      '110169846=    END'
      '110169847='
      
        '110169848=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110169849=    PNT_ = '#39'04'#39';'
      '110169850=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110169851=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110169852=        FROM SKLAD_TMP T'
      '110169853=        INTO :CNT_;'
      '110169854='
      '110169855=      if (CNT_ > 0) then BEGIN'
      '110169856=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110169857=          FROM SKLAD_TMP T'
      '110169858=          INTO :SUMM_, :SUMM_UE_;'
      '110169859='
      '110169860=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110169861=                                DATE_RECEIPT,'
      '110169862=                                TIME_RECEIPT,'
      '110169863=                                G_CLIENT,'
      '110169864=                                G_PAYMENT_TYPE,'
      '110169865=                                OSNOVANIE,'
      '110169866=                                NOTE,'
      '110169867=                                SUMM,'
      '110169868=                                SUMM_FACT,'
      '110169869=                                SUMM_CURRENCY,'
      '110169870=                                IS_PAYED_ALL,'
      '110169871=                                IS_VOZVRAT,'
      '110169872=                                G_TOCHKA)'
      '110169873=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110169874=                CURRENT_DATE,'
      '110169875=                CURRENT_TIME,'
      '110169876=                :G_CLIENT_,'
      '110169877=                1,'
      '110169878=                NULL,  --:OSNOVANIE_,'
      '110169879=                NULL,  -- :NOTE_,'
      '110169880=                :SUMM_,'
      '110169881=                :SUMM_,'
      '110169882=                :SUMM_UE_,'
      
        '110169883=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110169884=                0,'
      '110169885=                :G_TOCHKA_)'
      '110169886=        RETURNING'
      '110169887=          SKLAD'
      '110169888=        INTO'
      '110169889=          :SKLAD_PARENT_;'
      '110169890='
      '110169891=        PNT_ = '#39'05'#39';'
      '110169892=        FOR SELECT SKLAD,'
      '110169893=                   G_PRODUCT,'
      '110169894=                   AMOUNT,'
      '110169895=                   PRICE,'
      '110169896=                   SUMM'
      '110169897=                   ,PRICE_CURRENCY'
      '110169898=                   ,SUMM_CURRENCY'
      '110169899=              FROM SKLAD_TMP'
      '110169900=             ORDER BY 1'
      '110169901=              INTO :SKLAD_TMP_,'
      '110169902=                   :RG_PRODUCT_,'
      '110169903=                   :RAMOUNT_,'
      '110169904=                   :RPRICE_,'
      '110169905=                   :RSUMM_'
      '110169906=                   ,:RPRICE_UE_'
      '110169907=                   ,:RSUMM_UE_'
      '110169908=        DO BEGIN'
      '110169909='
      '110169910=            UPDATE SKLAD SK'
      '110169911=               SET SK.IS_LAST = 0'
      '110169912=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110169913=               AND SK.IS_LAST = 1;'
      '110169914='
      '110169915=            INSERT INTO SKLAD'
      '110169916=            ('
      '110169917=             SKLAD,'
      '110169918=             SKLAD_PARENT,'
      '110169919=             DATE_RECEIPT,'
      '110169920=             G_CLIENT,'
      '110169921=             G_PRODUCT,'
      '110169922=             AMOUNT,'
      '110169923=             PRICE,'
      '110169924=             SUMM,'
      '110169925=             G_PAYMENT_TYPE,'
      '110169926=             OSNOVANIE,'
      '110169927=             NOTE,'
      '110169928=             NDS,'
      '110169929=             NDS_SUMM,'
      '110169930=             IS_LAST,'
      '110169931=             IS_VOZVRAT,'
      '110169932=             G_TOCHKA'
      '110169933=             ,PRICE_CURRENCY'
      '110169934=             ,SUMM_CURRENCY'
      '110169935=            ) VALUES ('
      '110169936=             :SKLAD_TMP_,'
      '110169937=             :SKLAD_PARENT_,'
      '110169938=             CURRENT_DATE,'
      '110169939=             :G_CLIENT_,'
      '110169940=             :RG_PRODUCT_,'
      '110169941=             :RAMOUNT_,'
      '110169942=             :RPRICE_,'
      '110169943=             :RSUMM_,'
      '110169944=             1,       --:G_PAYMENT_TYPE_,'
      '110169945=             NULL,    --:OSNOVANIE_,'
      '110169946=             NULL,    --:NOTE_,'
      '110169947=             0,       --:RNDS_,'
      '110169948=             0,       --:RNDS_SUMM_,'
      '110169949=             1,       --IS_LAST_'
      '110169950=             0,        --:IS_VOZVRAT_'
      '110169951=             :G_TOCHKA_'
      '110169952=             ,:RPRICE_UE_'
      '110169953=             ,:RSUMM_UE_'
      '110169954=            );'
      '110169955='
      
        '110169956=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110169957=            PNT_ = '#39'06'#39';'
      '110169958=            UPDATE LT_SKLAD_PRODUCT L'
      '110169959=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110169960=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110169961=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110169962='
      '110169963=            PNT_ = '#39'06a'#39';'
      '110169964=            IF (ROW_COUNT = 0) THEN'
      
        '110169965=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110169966=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110169967=        END'
      '110169968='
      '110169969=        PNT_ = '#39'07'#39';'
      
        '110169970=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110169971=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110169972=                                :SUMM_,'
      '110169973=                                CURRENT_DATE,'
      
        '110169974=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110169975=                                NULL,   --ZAKAZ_'
      '110169976=                                :SKLAD_PARENT_,'
      '110169977=                                1,'
      
        '110169978=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110169979=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110169980=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110169981=          EXIT;'
      '110169982=        END'
      '110169983='
      '110169984=        DELETE FROM SKLAD_TMP;'
      '110169985=      END'
      '110169986=    END'
      '110169987='
      
        '110169988=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110169989=    if (ERR_MSG_ IS NOT NULL) then'
      '110169990=      ERR_MSG = ERR_MSG_;'
      '110169991='
      '110169992=WHEN ANY DO BEGIN'
      '110169993=    Err_code = gdscode;'
      
        '110169994=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110169995=  END'
      '110169996=END'
      '110169997=;'
      '110169998='
      '110169999=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '1101691000=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101691001=  ARTICUL_ VARCHAR(30),'
      '1101691002=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101691003=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101691004=  NAME_ VARCHAR(500),'
      '1101691005=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101691006=  PRICE_ NUMERIC(15,2),'
      '1101691007=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101691008=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101691009=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101691010=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101691011=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101691012=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101691013=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101691014=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101691015=  IS_CATEGORY_ INTEGER,'
      '1101691016=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101691017=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101691018=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101691019=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101691020=  IS_MARKED_ INTEGER,'
      '1101691021=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      
        '1101691022=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101691023=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101691024=RETURNS ('
      '1101691025=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101691026=  ERR_CODE INTEGER,'
      '1101691027=  ERR_MSG VARCHAR(1024))'
      '1101691028=AS'
      
        '1101691029=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PROD' +
        'UCT'#39';'
      
        '1101691030=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101691031=begin'
      
        '1101691032=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101691033=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1101691034=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101691035=                      FROM G_PRODUCT G'
      
        '1101691036=                     WHERE UPPER(G.ARTICUL) = UPPER(T' +
        'RIM(:ARTICUL_))'
      '1101691037=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '1101691038=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101691039=          ERR_CODE = -20500;'
      
        '1101691040=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1101691041=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101691042=          EXIT;'
      '1101691043=        END'
      '1101691044=    end'
      '1101691045='
      
        '1101691046=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      
        '1101691047=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) the' +
        'n begin'
      '1101691048=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101691049=                     FROM G_PRODUCT G'
      
        '1101691050=                    WHERE UPPER(G.NOMENCLATUR_NUM) = ' +
        'UPPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '1101691051=                      AND TRIM(G.NOMENCLATUR_NUM) <> ' +
        #39#39
      
        '1101691052=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101691053=          ERR_CODE = -20500;'
      
        '1101691054=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1101691055=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101691056=          EXIT;'
      '1101691057=        END'
      '1101691058=    end'
      '1101691059='
      '1101691060=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101691061=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101691062=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '1101691063=                      FROM G_PRODUCT G'
      
        '1101691064=                     WHERE UPPER(G.BARCODE) = UPPER(T' +
        'RIM(:BARCODE_))'
      '1101691065=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '1101691066=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101691067=          ERR_CODE = -20500;'
      
        '1101691068=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101691069=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101691070=          EXIT;'
      '1101691071=        END'
      '1101691072='
      '1101691073=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101691074=                     FROM G_PRODUCT G, LT_BARCODE L'
      '1101691075=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101691076=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '1101691077=                      AND TRIM(L.BARCODE) <> '#39#39
      
        '1101691078=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101691079=          ERR_CODE = -20500;'
      
        '1101691080=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101691081=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101691082=          EXIT;'
      '1101691083=        END'
      '1101691084=    end'
      '1101691085='
      
        '1101691086=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_P' +
        'RICE,'
      
        '1101691087=                           IS_CATEGORY, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_CO' +
        'MM, KOD_TNVD,'
      
        '1101691088=                           FAST_TOVAR, DO_NOT_CHARGE_' +
        'BONUS, IS_MARKED, BRAND)'
      
        '1101691089=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PR' +
        'ICE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1101691090=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CRO' +
        'SSCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNV' +
        'D_,'
      
        '1101691091=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_' +
        'MARKED_, :BRAND_)'
      '1101691092=    RETURNING G_PRODUCT'
      '1101691093=    INTO :G_PRODUCT_;'
      '1101691094='
      '1101691095=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1101691096=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1101691097=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101691098=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1101691099='
      '1101691100=        INSERT INTO LT_BARCODE'
      
        '1101691101=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101691102='
      
        '1101691103=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089 +
        #1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '1101691104=        INSERT into G_PRODUCT_IMAGE'
      
        '1101691105=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TY' +
        'PE from G_PRODUCT_IMAGE_TMP;'
      '1101691106='
      
        '1101691107=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074 +
        #1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '1101691108=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076 +
        #1091#1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '1101691109=        IF (is_kit_ > 0) THEN begin'
      '1101691110=            INSERT INTO G_PRODUCT_KIT'
      
        '1101691111=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP;'
      '1101691112='
      '1101691113=            if (is_kit_ = 1) then begin'
      
        '1101691114=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101691115=                  FROM G_PRODUCT_KIT K,'
      '1101691116=                       LT_SKLAD_PRODUCT L'
      '1101691117=                 WHERE K.g_product = :G_PRODUCT_'
      '1101691118=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101691119=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101691120=                 GROUP BY K.G_PRODUCT'
      '1101691121=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101691122='
      '1101691123=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101691124=                   SET L.AMOUNT = COALESCE(:G_PRODUCT' +
        '_SOSTAV_AMOUNT_, 0)'
      '1101691125=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101691126=            end'
      '1101691127=        END'
      '1101691128=    END'
      '1101691129='
      '1101691130=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101691131=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '1101691132=end'
      '1101691133=;'
      '1101691134='
      '1101691135=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1101691136=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101691137=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101691138=  ARTICUL_ VARCHAR(30),'
      '1101691139=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101691140=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101691141=  NAME_ VARCHAR(500),'
      '1101691142=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101691143=  PRICE_ NUMERIC(15,2),'
      '1101691144=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101691145=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101691146=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101691147=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101691148=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101691149=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101691150=  IS_CATEGORY_ INTEGER,'
      '1101691151=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101691152=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101691153=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101691154=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101691155=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101691156=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101691157=  IS_MARKED_ INTEGER,'
      '1101691158=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      
        '1101691159=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101691160=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101691161=RETURNS ('
      '1101691162=  ERR_CODE INTEGER,'
      '1101691163=  ERR_MSG VARCHAR(1024))'
      '1101691164=AS'
      
        '1101691165=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      
        '1101691166=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101691167=begin'
      
        '1101691168=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101691169=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '1101691170=                  FROM G_PRODUCT G'
      
        '1101691171=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(' +
        ':ARTICUL_))'
      '1101691172=                   AND TRIM(G.ARTICUL) <> '#39#39
      '1101691173=                   AND TRIM(:ARTICUL_) <> '#39#39
      '1101691174=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101691175=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101691176=      ERR_CODE = -20500;'
      
        '1101691177=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '1101691178=      EXIT;'
      '1101691179=    END'
      '1101691180='
      
        '1101691181=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1101691182=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101691183=                  FROM G_PRODUCT G'
      
        '1101691184=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPP' +
        'ER(TRIM(:NOMENCLATUR_NUM_))'
      '1101691185=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1101691186=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1101691187=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101691188=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101691189=      ERR_CODE = -20500;'
      
        '1101691190=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101691191=      EXIT;'
      '1101691192=    END'
      '1101691193='
      '1101691194=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101691195=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101691196=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101691197=                  FROM G_PRODUCT G'
      
        '1101691198=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(' +
        ':BARCODE_))'
      '1101691199=                   AND TRIM(G.BARCODE) <> '#39#39
      '1101691200=                   AND TRIM(:BARCODE_) <> '#39#39
      '1101691201=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101691202=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101691203=          ERR_CODE = -20500;'
      
        '1101691204=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101691205=          EXIT;'
      '1101691206=        END'
      '1101691207='
      '1101691208=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101691209=                    FROM G_PRODUCT G, LT_BARCODE L'
      '1101691210=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101691211=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '1101691212=                     AND TRIM(L.BARCODE) <> '#39#39
      '1101691213=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101691214=          ERR_CODE = -20500;'
      
        '1101691215=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101691216=          EXIT;'
      '1101691217=        END'
      '1101691218=    END'
      '1101691219='
      '1101691220=    update G_PRODUCT'
      '1101691221=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1101691222=        ARTICUL = :ARTICUL_,'
      '1101691223=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1101691224=        BARCODE = :BARCODE_,'
      '1101691225=        NAME = :NAME_,'
      '1101691226=        G_UNIT = :G_UNIT_,'
      '1101691227=        PRICE = :PRICE_,'
      '1101691228=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101691229=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1101691230=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1101691231=        NOTE         = :NOTE_,'
      '1101691232=        CROSSCODE    = :CROSSCODE_,'
      '1101691233=        IS_KIT       = :IS_KIT_,'
      '1101691234=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1101691235=        PLACE        = :PLACE_,'
      '1101691236=        SALES_COMM   = :SALES_COMM_,'
      '1101691237=        KOD_TNVD     = :KOD_TNVD_,'
      '1101691238=        FAST_TOVAR   = :FAST_TOVAR_,'
      '1101691239=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '1101691240=        IS_MARKED    = :IS_MARKED_,'
      '1101691241=        BRAND        = :BRAND_'
      '1101691242=    where (G_PRODUCT = :G_PRODUCT_);'
      '1101691243='
      '1101691244=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1101691245=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1101691246='
      '1101691247=        INSERT INTO LT_BARCODE'
      
        '1101691248=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101691249='
      '1101691250=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1101691251=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1101691252=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1101691253='
      
        '1101691254=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1101691255=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101691256='
      '1101691257=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1101691258=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1101691259=            /*INSERT INTO G_PRODUCT_KIT'
      
        '1101691260=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1101691261=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1101691262=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1101691263=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1101691264='
      
        '1101691265=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1101691266=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101691267='
      '1101691268=            UPDATE G_PRODUCT_KIT G'
      
        '1101691269=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1101691270=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1101691271=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1101691272=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1101691273='
      
        '1101691274=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' ' +
        #1074#1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '1101691275=            */'
      
        '1101691276=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PRO' +
        'DUCT = :G_PRODUCT_;'
      '1101691277=            INSERT INTO G_PRODUCT_KIT'
      
        '1101691278=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '1101691279=            FROM G_PRODUCT_KIT_TMP T;'
      '1101691280='
      
        '1101691281=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1101691282=            if (is_kit_ = 1) then begin'
      
        '1101691283=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101691284=                  FROM G_PRODUCT_KIT K,'
      '1101691285=                       LT_SKLAD_PRODUCT L'
      '1101691286=                 WHERE K.g_product = :G_PRODUCT_'
      '1101691287=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101691288=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101691289=                 GROUP BY K.G_PRODUCT'
      '1101691290=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101691291='
      '1101691292=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101691293=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1101691294=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101691295=            end'
      '1101691296=        END'
      '1101691297=    END'
      '1101691298='
      '1101691299=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101691300=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1101691301=end'
      '1101691302=;'
      '1101691303='
      '1101691304=ALTER PROCEDURE P_REP_PLU_LIST('
      '1101691305=  SCALE_PREFIX_ VARCHAR(2))'
      '1101691306=RETURNS ('
      '1101691307=  ROW_NUM VARCHAR(15),'
      '1101691308=  ARTICUL VARCHAR(1000),'
      '1101691309=  PLUCODE TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101691310=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101691311=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101691312=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101691313=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101691314=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1101691315=  ERR_CODE INTEGER,'
      '1101691316=  ERR_MSG VARCHAR(1024))'
      '1101691317=AS'
      '1101691318=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1057#1055#1048#1057#1054#1050#1040' '#1055#1051#1059' '#1050#1054#1044#1054#1042
      
        '1101691319=-- '#1052#1054#1046#1053#1054' '#1041#1067#1051#1054' '#1042#1057#1045' '#1047#1040#1055#1048#1061#1053#1059#1058#1068' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1059' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040', '#1053 +
        #1054' '#1056#1045#1064#1048#1051' '#1063#1058#1054' '#1054#1053' '#1048' '#1058#1040#1050' '#1055#1045#1056#1045#1043#1056#1059#1046#1045#1053', '#1044#1054#1051#1043#1054' '#1041#1059#1044#1045#1058' '#1056#1040#1041#1054#1058#1040#1058#1068
      
        '1101691320=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PLU_LI' +
        'ST'#39';'
      '1101691321=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101691322=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101691323=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101691324=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      '1101691325=BEGIN'
      '1101691326='
      
        '1101691327=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1101691328=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101691329='
      '1101691330=  FOR SELECT GP.PATH,'
      '1101691331=             GP.G_PRODUCT'
      '1101691332=        FROM P_REP_TREE GP'
      '1101691333=       WHERE EXISTS (SELECT 1'
      '1101691334=                       FROM G_PRODUCT'
      '1101691335=                      WHERE IS_CATEGORY = 0'
      
        '1101691336=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      
        '1101691337=                        AND SUBSTRING(BARCODE FROM 1 ' +
        'FOR 2) = :SCALE_PREFIX_'
      '1101691338=                    )'
      '1101691339=       ORDER BY 1, 2'
      '1101691340=       INTO :PATH_NAME_,'
      '1101691341=            :G_PRODUCT_'
      '1101691342=  DO BEGIN'
      
        '1101691343=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, BARCODE, IS_CATEGORY)'
      
        '1101691344=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1101691345='
      
        '1101691346=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1101691347=                                              ARTICUL' +
        ','
      
        '1101691348=                                              BARCODE' +
        ','
      '1101691349=                                              NAME,'
      
        '1101691350=                                              UNIT_NA' +
        'ME,'
      '1101691351=                                              PRICE)'
      
        '1101691352=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1101691353=                 G.ARTICUL,'
      '1101691354=                 SUBSTRING(G.BARCODE FROM 3 FOR 5),'
      '1101691355=                 G.NAME,'
      '1101691356=                 U.SHORT_NAME,'
      '1101691357=                 G.PRICE'
      
        '1101691358=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      '1101691359=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101691360=             AND G.IS_CATEGORY = 0'
      '1101691361=             AND G.is_active = 1'
      
        '1101691362=             AND SUBSTRING(BARCODE FROM 1 FOR 2) = :S' +
        'CALE_PREFIX_'
      '1101691363=           ORDER BY G.NAME, 3, G.G_PRODUCT;'
      '1101691364=  END'
      '1101691365='
      
        '1101691366=  FOR SELECT :I, ARTICUL, BARCODE, NAME, UNIT_NAME, P' +
        'RICE, AMOUNT, IS_CATEGORY'
      '1101691367=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1101691368=      INTO :ROW_NUM, :ARTICUL, :PLUCODE, :NAME, :UNIT' +
        '_NAME, :PRICE, :AMOUNT, :IS_CATEGORY'
      '1101691369=  DO BEGIN'
      '1101691370=    I = I + 1;'
      '1101691371=    SUSPEND;'
      '1101691372=  END'
      '1101691373=WHEN ANY DO BEGIN'
      '1101691374=    Err_code = -20500;'
      
        '1101691375=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101691376=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101691377=  END'
      '1101691378=end'
      '1101691379=;'
      '1101691380='
      '1101691381=ALTER PROCEDURE P_REP_PRICE_LIST('
      '1101691382=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101691383=  INCLUDE_NOL_ INTEGER,'
      '1101691384=  INCLUDE_FEW_ INTEGER,'
      '1101691385=  SORT_BY_NAME_ INTEGER,'
      '1101691386=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101691387=  SCALE_PREFIX_ VARCHAR(2) = '#39#39','
      '1101691388=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101691389=RETURNS ('
      '1101691390=  PERIOD_ VARCHAR(40),'
      '1101691391=  ROW_NUM VARCHAR(15),'
      '1101691392=  ARTICUL VARCHAR(1000),'
      '1101691393=  BARCODE VARCHAR(30),'
      
        '1101691394=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101691395=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101691396=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101691397=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101691398=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101691399=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101691400=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1101691401=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      '1101691402=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1101691403=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1101691404=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1101691405=  TOVAR_NAME VARCHAR(250),'
      '1101691406=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101691407=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101691408=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1101691409=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101691410=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1101691411=  ERR_CODE INTEGER,'
      '1101691412=  ERR_MSG VARCHAR(1024))'
      '1101691413=AS'
      '1101691414=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '1101691415=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_' +
        'LIST'#39';'
      '1101691416=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101691417=DECLARE VARIABLE I INTEGER = 1;'
      '1101691418=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101691419=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101691420=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1101691421=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1101691422=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1101691423=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1101691424=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1101691425=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1101691426=BEGIN'
      '1101691427='
      
        '1101691428=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1101691429=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101691430='
      '1101691431=  SELECT S.S_VALUE,'
      '1101691432=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1101691433=    FROM SYSTEM_SETUP S'
      '1101691434=   WHERE S.SYSTEM_SETUP = 1'
      '1101691435=    INTO :FORMULA_,'
      '1101691436=         :PRIHOD_CNT_;'
      '1101691437='
      '1101691438=  FOR SELECT GP.PATH,'
      '1101691439=             GP.G_PRODUCT'
      '1101691440=        FROM P_REP_TREE GP'
      '1101691441=       WHERE EXISTS (SELECT 1'
      '1101691442=                       FROM G_PRODUCT'
      '1101691443=                      WHERE IS_CATEGORY = 0'
      
        '1101691444=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1101691445=                    )'
      
        '1101691446=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101691447=              OR'
      '1101691448=              (:G_CATEGORY_ is NULL)'
      '1101691449=             )'
      '1101691450=       ORDER BY 1, 2'
      '1101691451=       INTO :PATH_NAME_,'
      '1101691452=            :G_PRODUCT_'
      '1101691453=  DO BEGIN'
      
        '1101691454=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1101691455=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1101691456=      SELECT COUNT(G.G_PRODUCT)'
      
        '1101691457=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101691458=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1101691459=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101691460=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101691461=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101691462=              OR'
      
        '1101691463=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1101691464=              or'
      
        '1101691465=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1101691466=             )'
      '1101691467=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101691468=         AND ((EXISTS (SELECT 1'
      '1101691469=                       FROM SKLAD S'
      '1101691470=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1101691471=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1101691472=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101691473=              OR'
      '1101691474=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1101691475=        INTO :CNT_;'
      '1101691476='
      '1101691477=      IF (CNT_ > 0) THEN BEGIN'
      
        '1101691478=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1101691479=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1101691480='
      
        '1101691481=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1101691482=                                              ARTICUL' +
        ','
      
        '1101691483=                                              BARCODE' +
        ','
      
        '1101691484=                                              NOMENCL' +
        'ATUR_NUM,'
      '1101691485=                                              NAME,'
      
        '1101691486=                                              UNIT_NA' +
        'ME,'
      '1101691487=                                              PRICE,'
      
        '1101691488=                                              VOLUME_' +
        'PRICE,'
      
        '1101691489=                                              SKIDKA_' +
        'PRICE,'
      '1101691490=                                              AMOUNT,'
      
        '1101691491=                                              AMOUNT_' +
        'RESERVE,'
      '1101691492=                                              SUMM,'
      
        '1101691493=                                              PRICE_S' +
        'ELF,'
      
        '1101691494=                                              SORT_CO' +
        'L,'
      
        '1101691495=                                              IS_CATE' +
        'GORY,'
      '1101691496=                                              NOTE,'
      
        '1101691497=                                              CROSSCO' +
        'DE,'
      '1101691498=                                              PLACE,'
      '1101691499=                                              BRAND)'
      
        '1101691500=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1101691501=                 G.ARTICUL,'
      '1101691502=                 G.BARCODE,'
      '1101691503=                 G.NOMENCLATUR_NUM,'
      '1101691504=                 G.NAME,'
      '1101691505=                 U.SHORT_NAME,'
      '1101691506=                 G.PRICE,'
      '1101691507=                 G.VOLUME_PRICE,'
      '1101691508=                 G.PRICE - GD.SKIDKA_SUM,'
      '1101691509=                 COALESCE(S.AMOUNT, 0),'
      '1101691510=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1101691511=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1101691512=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1101691513=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1101691514=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1101691515=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '1101691516=                  DECODE(:FORMULA_,'
      '1101691517=                         1,'
      
        '1101691518=                         (SELECT CAST(S.price AS MY_N' +
        'UMERIC)'
      '1101691519=                            FROM SKLAD S'
      
        '1101691520=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101691521=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1101691522=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1101691523=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1101691524=                                                     ' +
        'FROM SKLAD DD'
      
        '1101691525=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1101691526=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1101691527=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1101691528=                                                    )'
      '1101691529=                            ORDER BY 1 DESC'
      '1101691530=                            ROWS 1 TO 1'
      '1101691531=                         ),'
      
        '1101691532=                         (SELECT CAST(ROUND(SUM(T.AMO' +
        'UNT * T.PRICE)/SUM(T.AMOUNT), 2) AS MY_NUMERIC)'
      
        '1101691533=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1101691534=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1101691535=                                         SKLAD S'
      
        '1101691536=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1101691537=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1101691538=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1101691539=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1101691540=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1101691541=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '1101691542=                        )), 0) spr,'
      
        '1101691543=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1101691544=                 0'
      '1101691545=                 ,G.NOTE'
      
        '1101691546=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      '1101691547=                 ,G.PLACE'
      '1101691548=                 ,G.BRAND'
      
        '1101691549=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '1101691550=                                                FROM ' +
        'G_DISCOUNT D'
      
        '1101691551=                                                WHERE' +
        ' ((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '1101691552=                                                     ' +
        '   AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '1101691553=                                                     ' +
        '   AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '1101691554=                                                     ' +
        ' )'
      
        '1101691555=                                                     ' +
        ' OR'
      
        '1101691556=                                                     ' +
        ' (D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '1101691557=                                                 AND ' +
        '((:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '1101691558=                                                     ' +
        'OR'
      
        '1101691559=                                                     ' +
        '(D.G_TOCHKA IS NULL))'
      
        '1101691560=                                              ) GD ON' +
        ' G.G_PRODUCT = GD.G_PRODUCT'
      
        '1101691561=                             LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1101691562=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101691563=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1101691564=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101691565=             AND G.IS_CATEGORY = 0'
      '1101691566=             AND G.is_active = 1'
      '1101691567=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101691568=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101691569=                  OR'
      
        '1101691570=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1101691571=                  or'
      
        '1101691572=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1101691573=                 )'
      '1101691574=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101691575=             AND ((EXISTS (SELECT 1'
      '1101691576=                           FROM SKLAD S'
      
        '1101691577=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1101691578=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101691579=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101691580=                  OR'
      '1101691581=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1101691582=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '1101691583=      END'
      '1101691584=  END'
      '1101691585='
      
        '1101691586=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1101691587='
      
        '1101691588=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, VOLUME_PRI' +
        'CE, SKIDKA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOU' +
        'NT*PRICE_SELF, IS_CATEGORY,'
      '1101691589=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '1101691590=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1101691591=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, :CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRI' +
        'CE, :VOLUME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUM' +
        'M, :PRICE_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '1101691592=  DO BEGIN'
      '1101691593=    I = I + 1;'
      '1101691594=    SUSPEND;'
      '1101691595=  END'
      '1101691596='
      '1101691597=     /*'
      '1101691598=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '1101691599='
      '1101691600=     SELECT :I,'
      
        '1101691601=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045 +
        #1044#1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      
        '1101691602=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058 +
        #1054
      '1101691603=             U.SHORT_NAME UNIT_NAME,'
      '1101691604=             SS.PRICE,'
      '1101691605=             SS.VOLUME_PRICE,'
      '1101691606=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '1101691607=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE' +
        '(S.AMOUNT, 0)),'
      '1101691608=             SS.IS_CATEGORY'
      '1101691609=        FROM (WITH RECURSIVE TREE'
      '1101691610=              AS (SELECT T.G_PRODUCT,'
      '1101691611=                       T.NAME AS ARTICUL,'
      
        '1101691612=                       CAST(NULL AS VARCHAR(500)) NAM' +
        'E,'
      
        '1101691613=                       CAST(NULL AS NUMERIC(15,2)) PR' +
        'ICE,'
      
        '1101691614=                       CAST(NULL AS NUMERIC(15,2)) VO' +
        'LUME_PRICE,'
      '1101691615=                       T.IS_CATEGORY,'
      '1101691616=                       NULL G_UNIT'
      '1101691617=                  FROM G_PRODUCT T'
      '1101691618=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '1101691619=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T' +
        '.G_PRODUCT||'#39'~'#39
      '1101691620=                UNION ALL'
      '1101691621=                SELECT T.G_PRODUCT,'
      '1101691622=                       DECODE(T. T.ARTICUL,'
      '1101691623=                       T.NAME,'
      '1101691624=                       T.PRICE,'
      '1101691625=                       T.VOLUME_PRICE,'
      '1101691626=                       T.IS_CATEGORY,'
      '1101691627=                       T.G_UNIT'
      
        '1101691628=                  FROM G_PRODUCT T INNER JOIN TREE PR' +
        'IOR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '1101691629=                 WHERE T.IS_ACTIVE = 1'
      '1101691630=                )'
      '1101691631=             SELECT * FROM TREE) SS'
      
        '1101691632=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS' +
        '.G_PRODUCT = S.G_PRODUCT'
      
        '1101691633=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = ' +
        'U.G_UNIT'
      
        '1101691634=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PR' +
        'ODUCT = GD.G_PRODUCT'
      '1101691635=    INTO :ROW_NUM,'
      '1101691636=        :ARTICUL,'
      '1101691637=        :NAME,'
      '1101691638=        :UNIT_NAME,'
      '1101691639=        :PRICE,'
      '1101691640=        :VOLUME_PRICE,'
      '1101691641=        :SKIDKA_PRICE,'
      '1101691642=        :AMOUNT,'
      '1101691643=        :IS_CATEGORY'
      '1101691644=    DO BEGIN'
      '1101691645=      I = I + 1;'
      '1101691646=      SUSPEND;'
      '1101691647=    END  */'
      '1101691648=WHEN ANY DO BEGIN'
      '1101691649=    Err_code = -20500;'
      
        '1101691650=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101691651=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101691652=  END'
      '1101691653=end'
      '1101691654=;'
