        '>= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102493948=                  UPDATE SKLAD SK'
      '1102493949=                     SET SK.IS_LAST = 0'
      '1102493950=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102493951=                     AND SK.IS_LAST = 1'
      '1102493952=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102493953='
      '1102493954=                  UPDATE SKLAD SK'
      '1102493955=                     SET SK.IS_LAST = 1'
      '1102493956=                   WHERE SK.SKLAD = :SKLAD_;'
      '1102493957=                END*/'
      '1102493958='
      
        '1102493959=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102493960=            END ELSE BEGIN'
      '1102493961=                UPDATE SKLAD S'
      '1102493962=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1102493963=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1102493964=                       S.PRICE    = :PRICE_,'
      '1102493965=                       S.SUMM     = :SUMMM_,'
      '1102493966=                       S.OSNOVANIE = :OSNOVANIE_,'
      '1102493967=                       S.NOTE      = :NOTE_'
      '1102493968=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1102493969='
      
        '1102493970=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102493971=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102493972=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102493973=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_),'
      
        '1102493974=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102493975=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102493976=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1102493977=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1102493978=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102493979=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_),'
      
        '1102493980=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102493981=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102493982=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102493983='
      
        '1102493984=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1102493985=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102493986=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102493987=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102493988=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_),'
      
        '1102493989=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1102493990=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1102493991=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1102493992='
      
        '1102493993=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1102493994=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102493995=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_),'
      
        '1102493996=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1102493997=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1102493998=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1102493999='
      
        '1102494000=                -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' ' +
        #1057#1050#1051#1040#1044', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1102494001=                END ELSE IF (IS_EXPECTED_OLD_ = 1 AND' +
        ' NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102494002=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102494003=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_,'
      
        '1102494004=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102494005=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102494006=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102494007='
      '1102494008=                    IF (ROW_COUNT = 0) THEN'
      
        '1102494009=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102494010=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_AP' +
        'P_);'
      '1102494011=                END'
      
        '1102494012=                -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042 +
        #1040' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1102494013=                ELSE IF (IS_EXPECTED_OLD_ = 0 AND NOT' +
        '_MINUS_OSTATOK_ = 1) THEN BEGIN'
      '1102494014=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102494015=                       SET L.AMOUNT = L.AMOUNT - (:AM' +
        'OUNT_OLD_ - :Z_AMOUNT_) - :Z_AMOUNT_,'
      
        '1102494016=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102494017=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102494018=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102494019=                END'
      '1102494020='
      
        '1102494021=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1102494022=                /*IF ((Z_DATE_ > DATE_RECEIPT_OLD_) A' +
        'ND (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1102494023=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1102494024=                      FROM SKLAD SK'
      '1102494025=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102494026=                       AND SK.IS_LAST = 1'
      '1102494027=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1102494028=                      INTO :DATE_LAST_;'
      '1102494029='
      
        '1102494030=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102494031=                      UPDATE SKLAD SK'
      '1102494032=                         SET SK.IS_LAST = 0'
      
        '1102494033=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1102494034=                         AND SK.IS_LAST = 1'
      
        '1102494035=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1102494036='
      '1102494037=                      UPDATE SKLAD SK'
      '1102494038=                         SET SK.IS_LAST = 1'
      
        '1102494039=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1102494040=                    END'
      '1102494041=                END'
      '1102494042='
      
        '1102494043=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1102494044=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1102494045=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1102494046=                      FROM SKLAD SK'
      '1102494047=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102494048=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1102494049=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1102494050=                       AND SK.is_vozvrat IN (0,3,4)'
      '1102494051=                      INTO :DATE_LAST_;'
      '1102494052='
      
        '1102494053=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102494054=                      UPDATE SKLAD SK'
      '1102494055=                         SET SK.IS_LAST = 0'
      
        '1102494056=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1102494057='
      '1102494058=                       UPDATE SKLAD SK'
      '1102494059=                         SET SK.IS_LAST = 1'
      
        '1102494060=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1102494061=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1102494062=                                           FROM SKLAD' +
        ' SS'
      
        '1102494063=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1102494064=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1102494065=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1102494066=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1102494067=                    END'
      '1102494068=                END*/'
      '1102494069=            END'
      '1102494070=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1102494071=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1102494072='
      '1102494073=      UPDATE SKLAD_PARENT'
      '1102494074=      SET'
      
        '1102494075=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1102494076=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1102494077=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102494078=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102494079=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102494080=       SUMM      = :SUMM_,'
      '1102494081=       SUMM_FACT = :SUMM_FACT_,'
      '1102494082=       IS_EXPECTED = :NOT_MINUS_OSTATOK_'
      '1102494083=      WHERE SKLAD  = :ZAKAZ_;'
      '1102494084=  END'
      '1102494085='
      '1102494086=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102494087='
      '1102494088=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102494089=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 2, :SUMM_, :LOG_BODY_, 0);'
      '1102494090='
      '1102494091=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102494092=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
