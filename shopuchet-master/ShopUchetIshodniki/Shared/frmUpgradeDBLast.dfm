      '11053862=  DATE_BEGIN_ DATE,'
      '11053863=  DATE_END_ DATE,'
      
        '11053864=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ INTE' +
        'GER,'
