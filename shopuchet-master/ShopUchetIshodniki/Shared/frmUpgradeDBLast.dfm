      '11096710=                INTO :ZAKAZ_DETAILS_,'
      '11096711=                     :G_PRODUCT_,'
      '11096712=                     :Z_AMOUNT_,'
      '11096713=                     :PRICE_,'
      '11096714=                     :SUMMM_,'
      '11096715=                     :SKLAD_OLD_,'
      '11096716=                     :AMOUNT_OLD_,'
      '11096717=                     :IS_THIS_LAST_,'
      '11096718=                     :DATE_RECEIPT_OLD_'
      '11096719=          DO BEGIN'
      
        '11096720=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051 +
        #1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11096721=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '11096722=                INSERT INTO SKLAD (SKLAD, SKLAD_PARENT,' +
        ' DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYME' +
        'NT_TYPE, NDS, NDS_SUMM,'
      
        '11096723=                                  IS_LAST, NOTE, OSNOVA' +
        'NIE, IS_VOZVRAT, G_TOCHKA)'
      
        '11096724=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :ZA' +
        'KAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, :S' +
        'UMMM_, 1, 0, 0,'
      
        '11096725=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048 +
        #1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '11096726=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_CLI' +
        'ENT_'
      '11096727=                       )'
      '11096728=                RETURNING'
      '11096729=                  SKLAD'
      '11096730=                INTO'
      '11096731=                  :SKLAD_;'
      '11096732='
      
        '11096733=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054 +
        #1057#1058#1040#1042#1065#1048#1050#1045
      '11096734=                UPDATE LT_SKLAD_PRODUCT L'
