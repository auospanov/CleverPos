      '1101681607='
      
        '1101681608=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101681609=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101681610=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101681611=              UPDATE G_PRODUCT G'
      '1101681612=                 SET G.NAME = :NAME_,'
      '1101681613=                     G.G_UNIT = :G_UNIT_,'
      '1101681614=                     G.PRICE  = :PRICE_,'
      '1101681615=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101681616=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101681617=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101681618=                     G.PLACE = :PLACE_,'
      
        '1101681619=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101681620=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101681621=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101681622=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101681623=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101681624=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101681625='
      
        '1101681626=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1101681627=            END ELSE'
      
        '1101681628=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101681629=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1101681630=        END'
      '1101681631=    end'
      '1101681632='
      
        '1101681633=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1101681634=    PNT_ = '#39'02b'#39';'
      
        '1101681635=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1101681636=        SELECT G.G_PRODUCT,'
      '1101681637=               G.NAME'
      '1101681638=          FROM G_PRODUCT G'
      '1101681639=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1101681640=           AND TRIM(G.BARCODE) <> '#39#39
      '1101681641=           AND G.IS_ACTIVE = 1'
      '1101681642=          INTO :G_PRODUCT_,'
      '1101681643=               :G_PRODUCT_NAME_;'
      '1101681644='
      '1101681645=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1101681646=          SELECT G.G_PRODUCT,'
      '1101681647=                 G.NAME'
      '1101681648=            FROM G_PRODUCT G, LT_BARCODE L'
      '1101681649=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101681650=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1101681651=             AND TRIM(L.BARCODE) <> '#39#39
      '1101681652=            INTO :G_PRODUCT_,'
      '1101681653=                 :G_PRODUCT_NAME_;'
      '1101681654='
      
        '1101681655=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101681656=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101681657=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101681658=              UPDATE G_PRODUCT G'
      '1101681659=                 SET G.NAME = :NAME_,'
      '1101681660=                     G.G_UNIT = :G_UNIT_,'
      '1101681661=                     G.PRICE  = :PRICE_,'
      '1101681662=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101681663=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101681664=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101681665=                     G.PLACE = :PLACE_,'
      
        '1101681666=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101681667=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101681668=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101681669=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101681670=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101681671=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101681672='
      
        '1101681673=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101681674=            END ELSE'
      
        '1101681675=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101681676=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1101681677=        END'
      
        '1101681678=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1101681679=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1101681680='
      
        '1101681681=    --===============================================' +
        '=========='
      '1101681682=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '1101681683=    --===============================================' +
        '=========='
      '1101681684=    PNT_ = '#39'02b'#39';'
      '1101681685=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '1101681686='
      
        '1101681687=        ---------------------------------------------' +
        '---------------------'
      
        '1101681688=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048 +
        ' '#1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '1101681689=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082 +
        #1080'~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '1101681690=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '1101681691=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054',' +
        ' '#1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '1101681692=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BE' +
        'GIN'
      '1101681693=            G_PRODUCT_PAR_ = NULL;'
      
        '1101681694=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAM' +
        'E_);'
      '1101681695=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '1101681696=              STR_ = CATEGORY_NAME_;'
      '1101681697=              CATEGORY_NAME_ = '#39#39';'
      '1101681698=            END ELSE'
      
        '1101681699=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1101681700='
      '1101681701=            SELECT G_PRODUCT'
      '1101681702=              FROM G_PRODUCT G'
      '1101681703=             WHERE G.NAME = :STR_'
      '1101681704=               AND G.IS_CATEGORY = 1'
      
        '1101681705=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1101681706=                   OR'
      '1101681707=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '1101681708=              INTO G_PRODUCT_PAR_;'
      '1101681709=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1101681710=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1101681711=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1101681712=                RETURNING G_PRODUCT'
      '1101681713=                INTO :G_PRODUCT_PAR_;'
      '1101681714='
      '1101681715=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1101681716=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1101681717=        END'
      
        '1101681718=        ---------------------------------------------' +
        '---------------------'
      '1101681719='
      
        '1101681720=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1101681721=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '1101681722=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1101681723=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '1101681724=        RETURNING G_PRODUCT'
      '1101681725=        INTO :G_PRODUCT_;'
      '1101681726='
      
        '1101681727=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101681728=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_);'
      '1101681729=    end'
      '1101681730='
      
        '1101681731=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101681732=    PNT_ = '#39'03'#39';'
      '1101681733=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1101681734=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1101681735=                                       :AMOUNT_,'
      '1101681736=                                       :SELF_PRICE_,'
      
        '1101681737=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1101681738=                                       0, --nds_,'
      '1101681739=                                       0 --nds_summ_,'
      
        '1101681740=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1101681741=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1101681742=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1101681743=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1101681744=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1101681745=          EXIT;'
      '1101681746=        END'
      '1101681747=    END'
      '1101681748='
      
        '1101681749=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1101681750=    PNT_ = '#39'04'#39';'
      '1101681751=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1101681752=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1101681753=        FROM SKLAD_TMP T'
      '1101681754=        INTO :CNT_;'
      '1101681755='
      '1101681756=      if (CNT_ > 0) then BEGIN'
      '1101681757=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1101681758=          FROM SKLAD_TMP T'
      '1101681759=          INTO :SUMM_, :SUMM_UE_;'
      '1101681760='
      '1101681761=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101681762=                                DATE_RECEIPT,'
      '1101681763=                                TIME_RECEIPT,'
      '1101681764=                                G_CLIENT,'
      '1101681765=                                G_PAYMENT_TYPE,'
      '1101681766=                                OSNOVANIE,'
      '1101681767=                                NOTE,'
      '1101681768=                                SUMM,'
      '1101681769=                                SUMM_FACT,'
      '1101681770=                                SUMM_CURRENCY,'
      '1101681771=                                IS_PAYED_ALL,'
      '1101681772=                                IS_VOZVRAT,'
      '1101681773=                                G_TOCHKA)'
      '1101681774=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101681775=                CURRENT_DATE,'
      '1101681776=                CURRENT_TIME,'
      '1101681777=                :G_CLIENT_,'
      '1101681778=                1,'
      '1101681779=                NULL,  --:OSNOVANIE_,'
      '1101681780=                NULL,  -- :NOTE_,'
      '1101681781=                :SUMM_,'
      '1101681782=                :SUMM_,'
      '1101681783=                :SUMM_UE_,'
      
        '1101681784=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1101681785=                0,'
      '1101681786=                :G_TOCHKA_)'
      '1101681787=        RETURNING'
      '1101681788=          SKLAD'
      '1101681789=        INTO'
      '1101681790=          :SKLAD_PARENT_;'
      '1101681791='
      '1101681792=        PNT_ = '#39'05'#39';'
      '1101681793=        FOR SELECT SKLAD,'
      '1101681794=                   G_PRODUCT,'
      '1101681795=                   AMOUNT,'
      '1101681796=                   PRICE,'
      '1101681797=                   SUMM'
      '1101681798=                   ,PRICE_CURRENCY'
      '1101681799=                   ,SUMM_CURRENCY'
      '1101681800=              FROM SKLAD_TMP'
      '1101681801=             ORDER BY 1'
      '1101681802=              INTO :SKLAD_TMP_,'
      '1101681803=                   :RG_PRODUCT_,'
      '1101681804=                   :RAMOUNT_,'
      '1101681805=                   :RPRICE_,'
      '1101681806=                   :RSUMM_'
      '1101681807=                   ,:RPRICE_UE_'
      '1101681808=                   ,:RSUMM_UE_'
      '1101681809=        DO BEGIN'
      '1101681810='
      '1101681811=            UPDATE SKLAD SK'
      '1101681812=               SET SK.IS_LAST = 0'
      '1101681813=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101681814=               AND SK.IS_LAST = 1;'
      '1101681815='
      '1101681816=            INSERT INTO SKLAD'
      '1101681817=            ('
      '1101681818=             SKLAD,'
      '1101681819=             SKLAD_PARENT,'
      '1101681820=             DATE_RECEIPT,'
      '1101681821=             G_CLIENT,'
      '1101681822=             G_PRODUCT,'
      '1101681823=             AMOUNT,'
      '1101681824=             PRICE,'
      '1101681825=             SUMM,'
      '1101681826=             G_PAYMENT_TYPE,'
      '1101681827=             OSNOVANIE,'
      '1101681828=             NOTE,'
      '1101681829=             NDS,'
      '1101681830=             NDS_SUMM,'
      '1101681831=             IS_LAST,'
      '1101681832=             IS_VOZVRAT,'
      '1101681833=             G_TOCHKA'
      '1101681834=             ,PRICE_CURRENCY'
      '1101681835=             ,SUMM_CURRENCY'
      '1101681836=            ) VALUES ('
      '1101681837=             :SKLAD_TMP_,'
      '1101681838=             :SKLAD_PARENT_,'
      '1101681839=             CURRENT_DATE,'
      '1101681840=             :G_CLIENT_,'
      '1101681841=             :RG_PRODUCT_,'
      '1101681842=             :RAMOUNT_,'
      '1101681843=             :RPRICE_,'
      '1101681844=             :RSUMM_,'
      '1101681845=             1,       --:G_PAYMENT_TYPE_,'
      '1101681846=             NULL,    --:OSNOVANIE_,'
      '1101681847=             NULL,    --:NOTE_,'
      '1101681848=             0,       --:RNDS_,'
      '1101681849=             0,       --:RNDS_SUMM_,'
      '1101681850=             1,       --IS_LAST_'
      '1101681851=             0,        --:IS_VOZVRAT_'
      '1101681852=             :G_TOCHKA_'
      '1101681853=             ,:RPRICE_UE_'
      '1101681854=             ,:RSUMM_UE_'
      '1101681855=            );'
      '1101681856='
      
        '1101681857=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101681858=            PNT_ = '#39'06'#39';'
      '1101681859=            UPDATE LT_SKLAD_PRODUCT L'
      '1101681860=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1101681861=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101681862=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101681863='
      '1101681864=            PNT_ = '#39'06a'#39';'
      '1101681865=            IF (ROW_COUNT = 0) THEN'
      
        '1101681866=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101681867=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '1101681868=        END'
      '1101681869='
      '1101681870=        PNT_ = '#39'07'#39';'
      
        '1101681871=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101681872=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1101681873=                                :SUMM_,'
      '1101681874=                                CURRENT_DATE,'
      
        '1101681875=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1101681876=                                NULL,   --ZAKAZ_'
      '1101681877=                                :SKLAD_PARENT_,'
      '1101681878=                                1,'
      
        '1101681879=                                :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101681880=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101681881=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101681882=          EXIT;'
      '1101681883=        END'
      '1101681884='
      '1101681885=        DELETE FROM SKLAD_TMP;'
      '1101681886=      END'
      '1101681887=    END'
      '1101681888='
      
        '1101681889=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1101681890=    if (ERR_MSG_ IS NOT NULL) then'
      '1101681891=      ERR_MSG = ERR_MSG_;'
      '1101681892='
      '1101681893=WHEN ANY DO BEGIN'
      '1101681894=    Err_code = gdscode;'
      
        '1101681895=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1101681896=  END'
      '1101681897=END'
      '1101681898=;'
      '1101681899='
      '1101681900=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '1101681901=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101681902=  ARTICUL_ VARCHAR(30),'
      '1101681903=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101681904=  BARCODE_ VARCHAR(30),'
      '1101681905=  NAME_ VARCHAR(500),'
      '1101681906=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101681907=  PRICE_ NUMERIC(15,2),'
      '1101681908=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101681909=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101681910=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101681911=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101681912=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101681913=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101681914=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101681915=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101681916=  IS_CATEGORY_ INTEGER,'
      '1101681917=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101681918=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101681919=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101681920=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101681921=  IS_MARKED_ INTEGER,'
      
        '1101681922=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101681923=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101681924=RETURNS ('
      '1101681925=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101681926=  ERR_CODE INTEGER,'
      '1101681927=  ERR_MSG VARCHAR(1024))'
      '1101681928=AS'
      
        '1101681929=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PROD' +
        'UCT'#39';'
      '1101681930=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1101681931=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101681932=begin'
      
        '1101681933=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101681934=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1101681935=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101681936=                      FROM G_PRODUCT G'
      
        '1101681937=                     WHERE UPPER(G.ARTICUL) = UPPER(T' +
        'RIM(:ARTICUL_))'
      '1101681938=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '1101681939=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101681940=          ERR_CODE = -20500;'
      
        '1101681941=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1101681942=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101681943=          EXIT;'
      '1101681944=        END'
      '1101681945=    end'
      '1101681946='
      
        '1101681947=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      
        '1101681948=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) the' +
        'n begin'
      '1101681949=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101681950=                     FROM G_PRODUCT G'
      
        '1101681951=                    WHERE UPPER(G.NOMENCLATUR_NUM) = ' +
        'UPPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '1101681952=                      AND TRIM(G.NOMENCLATUR_NUM) <> ' +
        #39#39
      
        '1101681953=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101681954=          ERR_CODE = -20500;'
      
        '1101681955=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1101681956=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101681957=          EXIT;'
      '1101681958=        END'
      '1101681959=    end'
      '1101681960='
      '1101681961=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101681962=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101681963=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '1101681964=                      FROM G_PRODUCT G'
      
        '1101681965=                     WHERE UPPER(G.BARCODE) = UPPER(T' +
        'RIM(:BARCODE_))'
      '1101681966=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '1101681967=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101681968=          ERR_CODE = -20500;'
      
        '1101681969=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101681970=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101681971=          EXIT;'
      '1101681972=        END'
      '1101681973='
      '1101681974=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101681975=                     FROM G_PRODUCT G, LT_BARCODE L'
      '1101681976=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101681977=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '1101681978=                      AND TRIM(L.BARCODE) <> '#39#39
      
        '1101681979=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101681980=          ERR_CODE = -20500;'
      
        '1101681981=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101681982=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101681983=          EXIT;'
      '1101681984=        END'
      '1101681985=    end'
      '1101681986='
      
        '1101681987=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_P' +
        'RICE,'
      
        '1101681988=                           IS_CATEGORY, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_CO' +
        'MM, KOD_TNVD,'
      
        '1101681989=                           FAST_TOVAR, DO_NOT_CHARGE_' +
        'BONUS, IS_MARKED)'
      
        '1101681990=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PR' +
        'ICE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1101681991=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CRO' +
        'SSCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNV' +
        'D_,'
      
        '1101681992=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_' +
        'MARKED_)'
      '1101681993=    RETURNING G_PRODUCT'
      '1101681994=    INTO :G_PRODUCT_;'
      '1101681995='
      '1101681996=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1101681997=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1101681998=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101681999=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1101682000='
      '1101682001=        INSERT INTO LT_BARCODE'
      
        '1101682002=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101682003='
      
        '1101682004=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089 +
        #1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '1101682005=        INSERT into G_PRODUCT_IMAGE'
      
        '1101682006=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TY' +
        'PE from G_PRODUCT_IMAGE_TMP;'
      '1101682007='
      
        '1101682008=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074 +
        #1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '1101682009=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076 +
        #1091#1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '1101682010=        IF (is_kit_ > 0) THEN begin'
      '1101682011=            INSERT INTO G_PRODUCT_KIT'
      
        '1101682012=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP;'
      '1101682013='
      '1101682014=            if (is_kit_ = 1) then begin'
      
        '1101682015=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101682016=                  FROM G_PRODUCT_KIT K,'
      '1101682017=                       LT_SKLAD_PRODUCT L'
      '1101682018=                 WHERE K.g_product = :G_PRODUCT_'
      '1101682019=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101682020=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101682021=                 GROUP BY K.G_PRODUCT'
      '1101682022=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101682023='
      '1101682024=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101682025=                   SET L.AMOUNT = COALESCE(:G_PRODUCT' +
        '_SOSTAV_AMOUNT_, 0)'
      '1101682026=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101682027=            end'
      '1101682028=        END'
      '1101682029=    END'
      '1101682030='
      '1101682031=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101682032=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '1101682033=end'
      '1101682034=;'
      '1101682035='
      '1101682036=ALTER PROCEDURE G_READ_G_PRODUCT_LIST('
      
        '1101682037=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101682038=  IS_ACTIVE_ INTEGER = 1)'
      '1101682039=RETURNS ('
      '1101682040=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101682041=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '1101682042=  ARTICUL VARCHAR(30),'
      '1101682043=  NOMENCLATUR_NUM VARCHAR(30),'
      '1101682044=  BARCODE VARCHAR(1000),'
      '1101682045=  NAME VARCHAR(500),'
      '1101682046=  G_UNIT VARCHAR(150),'
      '1101682047=  PRICE NUMERIC(15,2),'
      '1101682048=  VOLUME_PRICE NUMERIC(15,2),'
      '1101682049=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101682050=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101682051=  IS_CATEGORY INTEGER,'
      '1101682052=  IS_ACTIVE INTEGER,'
      '1101682053=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1101682054=  AMOUNT_NA_REAL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1101682055=  SKIDKA_PROC NUMERIC(15,2),'
      '1101682056=  SKIDKA_SUM NUMERIC(15,2))'
      '1101682057=AS'
      '1101682058=begin'
      '1101682059=    FOR SELECT'
      '1101682060=        T.G_PRODUCT,'
      '1101682061=        T.G_PRODUCT_PAR,'
      '1101682062=        T.ARTICUL,'
      '1101682063=        T.NOMENCLATUR_NUM,'
      
        '1101682064=        T.BARCODE||COALESCE('#39', '#39'||SUBSTRING((SELECT L' +
        'IST(L.BARCODE, '#39', '#39')'
      
        '1101682065=                                        FROM LT_BARCO' +
        'DE L'
      
        '1101682066=                                        WHERE L.G_PRO' +
        'DUCT = T.G_PRODUCT) FROM 1 FOR 999), '#39#39'),'
      '1101682067=        T.NAME,'
      '1101682068=        GU.NAME AS G_UNIT,'
      '1101682069=        T.PRICE,'
      '1101682070=        T.VOLUME_PRICE,'
      '1101682071=        T.PACK_AMOUNT,'
      '1101682072=        T.MF_COUNTRY,'
      '1101682073=        T.IS_CATEGORY,'
      '1101682074=        T.IS_ACTIVE,'
      '1101682075=        COALESCE(P.AMOUNT, 0),'
      
        '1101682076=        COALESCE((SELECT SUM(Z.AMOUNT_ALL - Z.AMOUNT_' +
        'PAYED - COALESCE(Z.AMOUNT_RETURNED, 0))'
      
        '1101682077=                    FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_' +
        'PARENT ZP'
      
        '1101682078=                   WHERE Z.G_PRODUCT = T.G_PRODUCT AN' +
        'D Z.IS_PAYED_ALL = 0'
      
        '1101682079=                     AND ZP.ZAKAZ_REAL_PARENT = Z.ZAK' +
        'AZ_REAL_PARENT'
      
        '1101682080=                     AND ZP.G_TOCHKA = (SELECT ID FRO' +
        'M CUR_PARAMS WHERE CUR_PARAMS = 2)), 0) AMOUNT_NA_REAL,'
      '1101682081=        PP.SKIDKA_PROC,'
      '1101682082=        PP.SKIDKA_SUM'
      
        '1101682083=    FROM G_PRODUCT T LEFT OUTER JOIN (SELECT * FROM L' +
        'T_SKLAD_PRODUCT WHERE G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2))  P ON T.G_PRODUCT = P.G_PRODUCT'
      
        '1101682084=         LEFT OUTER JOIN (SELECT G_PRODUCT, D.SKIDKA_' +
        'PROC, D.SKIDKA_SUM'
      '1101682085=                            FROM G_DISCOUNT D'
      
        '1101682086=                            WHERE (D.DATE_BEGIN <= CU' +
        'RRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '1101682087=                                    AND D.DATE_END >=' +
        ' CURRENT_TIMESTAMP'
      
        '1101682088=                                    AND D.DATE_BEGIN ' +
        'IS NOT NULL AND D.DATE_END IS NOT NULL'
      '1101682089=                                  )'
      '1101682090=                                  OR'
      
        '1101682091=                                  (D.DATE_BEGIN IS NU' +
        'LL AND D.DATE_END IS NULL)'
      
        '1101682092=                         ) PP ON T.G_PRODUCT = PP.G_P' +
        'RODUCT,'
      '1101682093=         G_UNIT GU'
      
        '1101682094=    WHERE T.G_PRODUCT_PAR = DECODE(:G_PRODUCT_PAR_, -' +
        '1, T.G_PRODUCT_PAR, :G_PRODUCT_PAR_)  -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067' ' +
        #1048#1051#1048' '#1057#1058#1056#1054#1043#1054' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '1101682095=    AND T.IS_CATEGORY = 0'
      '1101682096=    AND T.IS_ACTIVE = :IS_ACTIVE_'
      '1101682097=    AND T.G_UNIT = GU.G_UNIT'
      '1101682098=    ORDER BY T.NAME'
      '1101682099=    INTO'
      '1101682100=        :G_PRODUCT,'
      '1101682101=        :G_PRODUCT_PAR,'
      '1101682102=        :ARTICUL,'
      '1101682103=        :NOMENCLATUR_NUM,'
      '1101682104=        :BARCODE,'
      '1101682105=        :NAME,'
      '1101682106=        :G_UNIT,'
      '1101682107=        :PRICE,'
      '1101682108=        :VOLUME_PRICE,'
      '1101682109=        :PACK_AMOUNT,'
      '1101682110=        :MF_COUNTRY,'
      '1101682111=        :IS_CATEGORY,'
      '1101682112=        :IS_ACTIVE,'
      '1101682113=        :AMOUNT,'
      '1101682114=        :AMOUNT_NA_REAL,'
      '1101682115=        :SKIDKA_PROC,'
      '1101682116=        :SKIDKA_SUM'
      '1101682117=  DO'
      '1101682118=    suspend;'
      '1101682119=end'
      '1101682120=;'
      '1101682121='
      '1101682122=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1101682123=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101682124=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101682125=  ARTICUL_ VARCHAR(30),'
      '1101682126=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101682127=  BARCODE_ VARCHAR(30),'
      '1101682128=  NAME_ VARCHAR(500),'
      '1101682129=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101682130=  PRICE_ NUMERIC(15,2),'
      '1101682131=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101682132=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101682133=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101682134=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101682135=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101682136=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101682137=  IS_CATEGORY_ INTEGER,'
      '1101682138=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101682139=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101682140=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101682141=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101682142=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101682143=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101682144=  IS_MARKED_ INTEGER,'
      
        '1101682145=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101682146=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101682147=RETURNS ('
      '1101682148=  ERR_CODE INTEGER,'
      '1101682149=  ERR_MSG VARCHAR(1024))'
      '1101682150=AS'
      
        '1101682151=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      
        '1101682152=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101682153=begin'
      
        '1101682154=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101682155=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '1101682156=                  FROM G_PRODUCT G'
      
        '1101682157=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(' +
        ':ARTICUL_))'
      '1101682158=                   AND TRIM(G.ARTICUL) <> '#39#39
      '1101682159=                   AND TRIM(:ARTICUL_) <> '#39#39
      '1101682160=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101682161=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101682162=      ERR_CODE = -20500;'
      
        '1101682163=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '1101682164=      EXIT;'
      '1101682165=    END'
      '1101682166='
      
        '1101682167=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1101682168=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101682169=                  FROM G_PRODUCT G'
      
        '1101682170=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPP' +
        'ER(TRIM(:NOMENCLATUR_NUM_))'
      '1101682171=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1101682172=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1101682173=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101682174=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101682175=      ERR_CODE = -20500;'
      
        '1101682176=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101682177=      EXIT;'
      '1101682178=    END'
      '1101682179='
      '1101682180=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101682181=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101682182=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101682183=                  FROM G_PRODUCT G'
      
        '1101682184=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(' +
        ':BARCODE_))'
      '1101682185=                   AND TRIM(G.BARCODE) <> '#39#39
      '1101682186=                   AND TRIM(:BARCODE_) <> '#39#39
      '1101682187=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101682188=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101682189=          ERR_CODE = -20500;'
      
        '1101682190=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101682191=          EXIT;'
      '1101682192=        END'
      '1101682193='
      '1101682194=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101682195=                    FROM G_PRODUCT G, LT_BARCODE L'
      '1101682196=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101682197=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '1101682198=                     AND TRIM(L.BARCODE) <> '#39#39
      '1101682199=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101682200=          ERR_CODE = -20500;'
      
        '1101682201=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101682202=          EXIT;'
      '1101682203=        END'
      '1101682204=    END'
      '1101682205='
      '1101682206=    update G_PRODUCT'
      '1101682207=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1101682208=        ARTICUL = :ARTICUL_,'
      '1101682209=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1101682210=        BARCODE = :BARCODE_,'
      '1101682211=        NAME = :NAME_,'
      '1101682212=        G_UNIT = :G_UNIT_,'
      '1101682213=        PRICE = :PRICE_,'
      '1101682214=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101682215=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1101682216=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1101682217=        NOTE         = :NOTE_,'
      '1101682218=        CROSSCODE    = :CROSSCODE_,'
      '1101682219=        IS_KIT       = :IS_KIT_,'
      '1101682220=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1101682221=        PLACE        = :PLACE_,'
      '1101682222=        SALES_COMM   = :SALES_COMM_,'
      '1101682223=        KOD_TNVD     = :KOD_TNVD_,'
      '1101682224=        FAST_TOVAR   = :FAST_TOVAR_,'
      '1101682225=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '1101682226=        IS_MARKED    = :IS_MARKED_'
      '1101682227=    where (G_PRODUCT = :G_PRODUCT_);'
      '1101682228='
      '1101682229=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1101682230=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1101682231='
      '1101682232=        INSERT INTO LT_BARCODE'
      
        '1101682233=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101682234='
      '1101682235=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1101682236=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1101682237=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1101682238='
      
        '1101682239=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1101682240=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101682241='
      '1101682242=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1101682243=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1101682244=            /*INSERT INTO G_PRODUCT_KIT'
      
        '1101682245=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1101682246=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1101682247=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1101682248=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1101682249='
      
        '1101682250=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1101682251=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101682252='
      '1101682253=            UPDATE G_PRODUCT_KIT G'
      
        '1101682254=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1101682255=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1101682256=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1101682257=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1101682258='
      
        '1101682259=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' ' +
        #1074#1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '1101682260=            */'
      
        '1101682261=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PRO' +
        'DUCT = :G_PRODUCT_;'
      '1101682262=            INSERT INTO G_PRODUCT_KIT'
      
        '1101682263=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '1101682264=            FROM G_PRODUCT_KIT_TMP T;'
      '1101682265='
      
        '1101682266=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1101682267=            if (is_kit_ = 1) then begin'
      
        '1101682268=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101682269=                  FROM G_PRODUCT_KIT K,'
      '1101682270=                       LT_SKLAD_PRODUCT L'
      '1101682271=                 WHERE K.g_product = :G_PRODUCT_'
      '1101682272=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101682273=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101682274=                 GROUP BY K.G_PRODUCT'
      '1101682275=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101682276='
      '1101682277=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101682278=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1101682279=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101682280=            end'
      '1101682281=        END'
      '1101682282=    END'
      '1101682283='
      '1101682284=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101682285=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1101682286=end'
      '1101682287=;'
      '1101682288='
      '1101682289=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1101682290=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101682291=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101682292=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101682293=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101682294=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101682295=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101682296=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101682297=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101682298=RETURNS ('
      '1101682299=  ERR_CODE INTEGER,'
      '1101682300=  ERR_MSG VARCHAR(1024))'
      '1101682301=AS'
      '1101682302=/*'
      
        '1101682303='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1101682304='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1101682305='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1101682306=*/'
      
        '1101682307=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1101682308=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101682309=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1101682310=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1101682311=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1101682312=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1101682313=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1101682314=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1101682315=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1101682316=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101682317=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1101682318=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1101682319=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1101682320=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101682321=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101682322=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101682323=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101682324=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101682325=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1101682326=BEGIN'
      '1101682327='
      '1101682328=  PNT_ = '#39'00'#39';'
      '1101682329=  CLRF = ascii_char( 10 );'
      '1101682330='
      '1101682331=  SELECT S.S_VALUE'
      '1101682332=    FROM SYSTEM_SETUP S'
      '1101682333=   WHERE S.SYSTEM_SETUP = 2'
      '1101682334=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1101682335='
      '1101682336=  PNT_ = '#39'01'#39';'
      '1101682337=  SELECT G.nds_value'
      '1101682338=    FROM G_FIRM_REKVIZIT G'
      '1101682339=   WHERE G.is_default = 1'
      '1101682340=    INTO :NDS_;'
      '1101682341='
      '1101682342=  PNT_ = '#39'02'#39';'
      
        '1101682343=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1101682344=        FROM IMPORT_TBL_TMP'
      
        '1101682345=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1101682346=  DO BEGIN'
      '1101682347=    SELECT G_PRODUCT,'
      '1101682348=           PRICE'
      '1101682349=      FROM ('
      '1101682350=            SELECT P.G_PRODUCT, P.price'
      '1101682351=              FROM G_PRODUCT P'
      
        '1101682352=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1101682353=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1101682354=            UNION'
      '1101682355=            SELECT LT.G_PRODUCT, P.PRICE'
      '1101682356=              FROM LT_BARCODE LT, g_product P'
      
        '1101682357=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1101682358=               AND LT.g_product = P.g_product'
      '1101682359=           )'
      '1101682360=      INTO :G_PRODUCT_,'
      '1101682361=           :PRICE_OUR_;'
      '1101682362='
      '1101682363=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1101682364=      ERR_CODE = -20500;'
      
        '1101682365=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1101682366=      Exit;'
      '1101682367=    END'
      '1101682368='
      '1101682369=    PNT_ = '#39'03'#39';'
      
        '1101682370=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1101682371=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1101682372=      RETURNING_VALUES :COST_PRICE_;'
      '1101682373='
      '1101682374=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1101682375=    IF (price_ IS NULL) THEN'
      '1101682376=      PRICE_ = PRICE_OUR_;'
      '1101682377='
      '1101682378=    PNT_ = '#39'04'#39';'
      
        '1101682379=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1101682380=                                              :AMOUNT' +
        '_,'
      
        '1101682381=                                              :PRICE_' +
        ','
      
        '1101682382=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1101682383=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1101682384=                                              :DISCOU' +
        'NT_,'
      
        '1101682385=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1101682386=                                              :NDS_,'
      
        '1101682387=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1101682388=                                              :COST_P' +
        'RICE_,'
      
        '1101682389=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1101682390=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1101682391=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1101682392=                                              0     -' +
        '-MODE_'
      
        '1101682393=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1101682394=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101682395=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101682396=      EXIT;'
      '1101682397=    END'
      '1101682398='
      '1101682399=    G_PRODUCT_ = NULL;'
      '1101682400=  END'
      '1101682401='
      '1101682402=  PNT_ = '#39'05'#39';'
      '1101682403=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1101682404=    SELECT SUM(T.summ)'
      '1101682405=      FROM ZAKAZ_DETAILS_TMP T'
      '1101682406=      INTO :SUMM_;'
      '1101682407=    SUMM_FACT_ = SUMM_;'
      '1101682408=  END'
      '1101682409='
      '1101682410=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1101682411=  if (G_PAYMENT_TYPE_ = 1) then'
      '1101682412=    SUMM_CASH_ = summ_fact_;'
      '1101682413=  ELSE'
      '1101682414=    SUMM_NONCASH_ = summ_fact_;'
      '1101682415='
      '1101682416=  PNT_ = '#39'06'#39';'
      '1101682417=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1101682418=    G_CLIENT_ = 10;'
      '1101682419='
      '1101682420=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101682421=                              :Z_DATE_,'
      '1101682422=                              :Z_TIME_,'
      '1101682423=                              :G_CLIENT_,'
      '1101682424=                              :G_PAYMENT_TYPE_,'
      '1101682425=                              '#39#39', --:OSNOVANIE_,'
      '1101682426=                              0,  -- IS_SPISANIE'
      
        '1101682427=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1101682428=                              :SUMM_,'
      '1101682429=                              :SUMM_FACT_,'
      '1101682430=                              :SUMM_CASH_,'
      '1101682431=                              :SUMM_NONCASH_,'
      
        '1101682432=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1101682433=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1101682434=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1101682435=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1101682436=                              0,    -- :BY_RECIPE__,'
      '1101682437=                              0,    -- IS_RESERVE__'
      '1101682438=                              NULL -- :PAYMENTS__'
      '1101682439=                              )'
      
        '1101682440=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101682441=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101682442=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101682443=    EXIT;'
      '1101682444=  END'
      '1101682445='
      '1101682446=  DELETE FROM import_tbl_tmp;'
      '1101682447='
      '1101682448=WHEN ANY DO BEGIN'
      '1101682449=    ERR_CODE = gdscode;'
      
        '1101682450=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1101682451=  END'
      '1101682452=end'
      '1101682453=;'
      '1101682454='
      '1101682455=ALTER PROCEDURE LT_BARCODE_TMP_INS('
      '1101682456=  G_PRODUCT_ TYPE OF COLUMN LT_BARCODE.G_PRODUCT,'
      '1101682457=  BARCODE_ TYPE OF COLUMN LT_BARCODE.BARCODE)'
      '1101682458=RETURNS ('
      '1101682459=  LT_BARCODE_ TYPE OF COLUMN LT_BARCODE.G_PRODUCT,'
      '1101682460=  ERR_CODE INTEGER,'
      '1101682461=  ERR_MSG VARCHAR(1024))'
      '1101682462=AS'
      '1101682463=declare variable CNT_ INTEGER;'
      '1101682464=BEGIN'
      '1101682465=  SELECT COUNT(*)'
      '1101682466=    FROM G_PRODUCT G'
      '1101682467=   WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1101682468=     AND TRIM(G.BARCODE) <> '#39#39
      '1101682469=    INTO :CNT_;'
      '1101682470='
      '1101682471=  if (CNT_ = 0) then'
      '1101682472=    SELECT COUNT(*)'
      '1101682473=      FROM G_PRODUCT G, LT_BARCODE L'
      '1101682474=     WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101682475=       AND L.BARCODE = TRIM(:BARCODE_)'
      '1101682476=       AND TRIM(L.BARCODE) <> '#39#39
      '1101682477=      INTO :CNT_;'
      '1101682478='
      '1101682479=  IF (CNT_ > 0) THEN BEGIN'
      '1101682480=    ERR_CODE = -20500;'
      
        '1101682481=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089#1086 +
        ' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1101682482=    EXIT;'
      '1101682483=  END'
      '1101682484='
      '1101682485=  INSERT INTO LT_BARCODE_TMP ('
      '1101682486=    LT_BARCODE,'
      '1101682487=    G_PRODUCT,'
      '1101682488=    BARCODE)'
      '1101682489=  VALUES ('
      '1101682490=    GEN_ID(GEN_LT_BARCODE, 1),'
      '1101682491=    :G_PRODUCT_,'
      '1101682492=    :BARCODE_)'
      '1101682493=  RETURNING'
      '1101682494=    LT_BARCODE'
      '1101682495=  INTO'
      '1101682496=    :LT_BARCODE_;'
      '1101682497=END'
      '1101682498=;'
      '1101682499='
      '1101682500=ALTER PROCEDURE LT_BARCODE_TMP_READ'
      '1101682501=RETURNS ('
      '1101682502=  LT_BARCODE TYPE OF COLUMN LT_BARCODE.LT_BARCODE,'
      '1101682503=  G_PRODUCT TYPE OF COLUMN LT_BARCODE.G_PRODUCT,'
      '1101682504=  BARCODE TYPE OF COLUMN LT_BARCODE.BARCODE)'
      '1101682505=AS'
      '1101682506=BEGIN'
      '1101682507=  FOR SELECT LT_BARCODE,'
      '1101682508=             G_PRODUCT,'
      '1101682509=             BARCODE'
      '1101682510=      FROM LT_BARCODE_TMP'
      '1101682511=      INTO :LT_BARCODE,'
      '1101682512=           :G_PRODUCT,'
      '1101682513=           :BARCODE'
      '1101682514=  DO'
      '1101682515=  BEGIN'
      '1101682516=    SUSPEND;'
      '1101682517=  END'
      '1101682518=END'
      '1101682519=;'
      '1101682520='
      '1101682521=ALTER PROCEDURE P_REP_DOC('
      '1101682522=  DOC_ TYPE OF COLUMN DOCS.DOCS,'
      '1101682523=  CURRENCY_ INTEGER,'
      '1101682524=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101682525=  DOC_TYPE_ INTEGER)'
      '1101682526=RETURNS ('
      '1101682527=  NUM_ VARCHAR(50),'
      '1101682528=  DOCS_DATE_ VARCHAR(20),'
      '1101682529=  G_FIRM_ VARCHAR(1000),'
      '1101682530=  G_FIRM_ADDRESS_ VARCHAR(1000),'
      '1101682531=  G_FIRM_ACCOUNT_ VARCHAR(1000),'
      '1101682532=  G_FIRM_BANK_ VARCHAR(1000),'
      '1101682533=  G_FIRM_AND_ADDRESS_ VARCHAR(1000),'
      '1101682534=  G_FIRM_OKPO_ TYPE OF COLUMN G_FIRM_REKVIZIT.OKPO,'
      '1101682535=  G_FIRM_BIN_ TYPE OF COLUMN G_FIRM_REKVIZIT.IDN,'
      '1101682536=  G_CLIENT_ VARCHAR(1000),'
      '1101682537=  G_CLIENT_ADDRESS_ VARCHAR(1000),'
      '1101682538=  G_CLIENT_ACCOUNT_ VARCHAR(1000),'
      '1101682539=  G_CLIENT_AND_ADDRESS_ VARCHAR(1000),'
      '1101682540=  G_CLIENT_BIN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '1101682541=  G_OFFICIAL_ VARCHAR(1000),'
      '1101682542=  G_OFFICIAL_ID_KIND_ VARCHAR(1000),'
      '1101682543=  G_OFFICIAL_ID_NUM_ VARCHAR(1000),'
      '1101682544=  G_OFFICIAL_ID_DATE_ VARCHAR(1000),'
      '1101682545=  G_OFFICIAL_ID_ISSUER_ VARCHAR(1000),'
      '1101682546=  APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '1101682547=  RUKOVODITEL_ VARCHAR(1000),'
      '1101682548=  GLAVBUH_ VARCHAR(1000),'
      '1101682549=  NOTE_ TYPE OF COLUMN DOCS.NOTE,'
      '1101682550=  PARAM1_ TYPE OF COLUMN DOCS.PARAM1,'
      '1101682551=  PARAM2_ TYPE OF COLUMN DOCS.PARAM2,'
      '1101682552=  PARAM3_ TYPE OF COLUMN DOCS.PARAM3,'
      '1101682553=  PARAM4_ TYPE OF COLUMN DOCS.PARAM4,'
      '1101682554=  PARAM5_ TYPE OF COLUMN DOCS.PARAM5,'
      '1101682555=  SUMM_ VARCHAR(1000),'
      '1101682556=  SUMM_STR_ VARCHAR(1000),'
      '1101682557=  AMOUNT_ MY_NUMERIC_5,'
      '1101682558=  ROW_NUM VARCHAR(10),'
      '1101682559=  NAME VARCHAR(1000),'
      '1101682560=  UNIT_NAME VARCHAR(1000),'
      '1101682561=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101682562=  ZDATE VARCHAR(20),'
      '1101682563=  AMOUNT MY_NUMERIC_5,'
      '1101682564=  PRICE VARCHAR(500),'
      '1101682565=  SUMM VARCHAR(500),'
      '1101682566=  ERR_CODE INTEGER,'
      '1101682567=  ERR_MSG VARCHAR(1024))'
      '1101682568=AS'
      '1101682569=/*'
      '1101682570=DOC_:'
      '1101682571=- 0 '#1069#1058#1054' '#1055#1050#1054';'
      '1101682572=- 1 '#1069#1058#1054' '#1040#1050#1058' '#1042#1067#1055#1054#1051#1053#1045#1053#1053#1067#1061' '#1056#1040#1041#1054#1058
      '1101682573=- 2 '#1069#1058#1054' '#1044#1054#1042#1045#1056#1050#1040';'
      '1101682574=- 3 '#1069#1058#1054' '#1044#1045#1060#1045#1050#1058#1054#1042#1054#1063#1053#1067#1049' '#1040#1050#1058
      '1101682575='
      '1101682576='#1042#1067#1061#1054#1044#1053#1067#1045' '#1055#1040#1056#1040#1052#1045#1058#1056#1067':'
      
        '1101682577='#1055#1050#1054', '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1063#1045#1058' '#1044#1045#1041#1045#1058', '#1055#1040#1056#1040#1052#1045#1058#1056' 2 - '#1057#1063#1045#1058' '#1050#1056#1045#1044#1048 +
        #1058
      '1101682578='#1040#1050#1058'  '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1074#1077#1076#1077#1085#1080#1103' '#1086#1073' '#1080#1089#1087#1086#1083#1100#1079#1086#1074#1072#1085#1080#1080' '#1079#1072#1087#1072#1089#1086#1074
      
        '1101682579='#1044#1054#1042#1045#1056#1045#1053#1053#1054#1057#1058#1068' '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1056#1054#1050' '#1044#1045#1049#1057#1058#1042#1048#1071' '#1044#1054#1042#1045#1056#1050#1048', '#1055#1040#1056#1040 +
        #1052#1045#1058#1056' 2 - '#1057#1063#1045#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1050#1054#1058#1054#1056#1054#1043#1054' '#1044#1045#1051#1040#1051#1048
      '1101682580=*/'
      '1101682581=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_DOC'#39';'
      '1101682582=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101682583=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NOL_VMESTO_BEZ;'
      '1101682584=DECLARE VARIABLE I INTEGER = 1;'
      '1101682585=DECLARE VARIABLE BL_ TYPE OF COLUMN DOCS.PARAM6;'
      '1101682586=DECLARE VARIABLE STR_ VARCHAR(500);'
      
        '1101682587=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101682588=DECLARE VARIABLE AMOUNT_ITOG_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0;'
      '1101682589=DECLARE VARIABLE STR_NAME_ VARCHAR(500);'
      '1101682590=DECLARE VARIABLE STR_AMOUNT_ VARCHAR(500);'
      '1101682591=DECLARE VARIABLE STR_UNIT_ VARCHAR(500);'
      '1101682592=DECLARE VARIABLE POS_ INTEGER;'
      '1101682593=DECLARE VARIABLE POS2_ INTEGER;'
      '1101682594=BEGIN'
      '1101682595='
      '1101682596=  select D.num,'
      
        '1101682597=         lpad(EXTRACT(DAY FROM D.DOCS_DATE), 2, '#39'0'#39')|' +
        '|'#39'.'#39'||lpad(EXTRACT(MONTH FROM D.DOCS_DATE), 2, 0)||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM D.DOCS_DATE),'
      '1101682598=         F.name,'
      '1101682599=         FD.address,'
      '1101682600=         FA.account,'
      '1101682601=         FA.BANK_NAME,'
      '1101682602=         F.OKPO,'
      '1101682603=         F.IDN,'
      
        '1101682604=         COALESCE(F.NAME, '#39#39')||DECODE(D.doc_type, 3, ' +
        'COALESCE('#39', '#1048#1048#1053'/'#1041#1048#1053#39'||F.idn, '#39#39'), '#39#39')||COALESCE('#39', '#39'||FD.ADDRESS' +
        ', '#39#39'),'
      
        '1101682605=         DECODE(COALESCE(c.name_FULL, '#39#39'), '#39#39', C.NAME' +
        ', c.name_FULL),'
      '1101682606=         GD.address,'
      '1101682607=         GA.account,'
      '1101682608=         C.IDN,'
      
        '1101682609=         DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')' +
        '), 0, C.NAME, c.name_FULL)||DECODE(D.doc_type, 3, COALESCE('#39', '#1048#1048 +
        #1053'/'#1041#1048#1053#39'||C.idn, '#39#39'), '#39#39')||COALESCE('#39', '#39'||GD.ADDRESS, '#39#39'),'
      
        '1101682610=         DECODE(D.doc_type, 2, O.APP_NAME||'#39' '#39', '#39#39')||' +
        'O.fio_doc,'
      '1101682611=         O.G_ID_KIND,'
      '1101682612=         O.ID_NUM,'
      
        '1101682613=         lpad(EXTRACT(DAY FROM O.ID_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM O.ID_DATE), 2, 0)||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM O.ID_DATE),'
      '1101682614=         '#39#1074#1099#1076#1072#1085' '#39'||O.ID_ISSUER,'
      '1101682615=         O.APP_NAME,'
      '1101682616=         O1.FIO_DOC,'
      '1101682617=         COALESCE(O2.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '1101682618=         D.note,'
      '1101682619=         D.param1,'
      '1101682620=         D.param2,'
      '1101682621=         D.param3,'
      '1101682622=         D.param4,'
      '1101682623=         D.param5,'
      '1101682624=         D.PARAM6'
      '1101682625=  FROM docs D'
      
        '1101682626=       LEFT OUTER JOIN G_FIRM_ADDRESS FD ON FD.g_addr' +
        'ess = D.g_firm_address'
      
        '1101682627=       LEFT outer JOIN (SELECT GG.G_ACCOUNT, GG.accou' +
        'nt, GB.name||'#39', '#1041#1048#1050' '#39'||GB.BIK BANK_NAME FROM G_FIRM_ACCOUNT GG, ' +
        'G_BANK GB WHERE GG.g_bank = GB.g_bank) FA ON FA.g_account = D.g_' +
        'firm_account'
      
        '1101682628=       LEFT outer JOIN G_ADDRESS GD ON GD.g_address =' +
        ' D.g_client_address'
      
        '1101682629=       LEFT outer JOIN G_ACCOUNT GA ON GA.g_account =' +
        ' D.g_client_account'
      
        '1101682630=       LEFT outer JOIN (SELECT OO.G_OFFICIAL, OO.FIO_' +
        'DOC, OO.G_ID_KIND, OO.ID_NUM, OO.ID_DATE, OO.ID_ISSUER, APP.NAME' +
        ' APP_NAME FROM G_OFFICIAL OO, G_APPOINTMENT APP WHERE OO.G_APPOI' +
        'NTMENT = APP.G_APPOINTMENT) O ON O.g_official = D.g_official'
      
        '1101682631=       LEFT outer JOIN G_OFFICIAL O1 ON O1.g_official' +
        ' = D.G_OFFICIAL_RUKOVOD'
      
        '1101682632=       LEFT outer JOIN G_OFFICIAL O2 ON O2.g_official' +
        ' = D.GLAVBUH,'
      '1101682633=       G_FIRM_REKVIZIT F,'
      '1101682634=       g_client C'
      '1101682635= WHERE D.DOCS = :DOC_'
      '1101682636=   AND D.g_firm = F.g_firm_rekvizit'
      '1101682637=   AND D.G_CLIENT = C.g_client'
      '1101682638=  into :num_,'
      '1101682639=       :DOCS_DATE_,'
      '1101682640=       :g_firm_,'
      '1101682641=       :g_firm_address_,'
      '1101682642=       :g_firm_account_,'
      '1101682643=       :G_FIRM_BANK_,'
      '1101682644=       :G_FIRM_OKPO_,'
      '1101682645=       :G_FIRM_BIN_,'
      '1101682646=       :g_firm_AND_ADDRESS_,'
      '1101682647=       :g_client_,'
      '1101682648=       :g_client_address_,'
      '1101682649=       :g_client_account_,'
      '1101682650=       :G_CLIENT_BIN_,'
      '1101682651=       :G_CLIENT_AND_ADDRESS_,'
      '1101682652=       :g_official_,'
      '1101682653=       :G_OFFICIAL_ID_KIND_,'
      '1101682654=       :G_OFFICIAL_ID_NUM_,'
      '1101682655=       :G_OFFICIAL_ID_DATE_,'
      '1101682656=       :G_OFFICIAL_ID_ISSUER_,'
      '1101682657=       :APPOINTMENT_,'
      '1101682658=       :RUKOVODITEL_,'
      '1101682659=       :GLAVBUH_,'
      '1101682660=       :note_,'
      '1101682661=       :param1_,'
      '1101682662=       :param2_,'
      '1101682663=       :param3_,'
      '1101682664=       :param4_,'
      '1101682665=       :param5_,'
      '1101682666=       :BL_;'
      '1101682667='
      '1101682668=  IF (DOC_TYPE_ <> 2) THEN BEGIN'
      
        '1101682669=      -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088 +
        #1086#1074' ('#1088#1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083 +
        #1080#1079#1072#1094#1080#1080'"'
      
        '1101682670=      -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054 +
        #1052#1059' '#1063#1058#1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063 +
        #1048#1058#1040#1045#1058#1057#1071
      
        '1101682671=      SELECT REPLACE(CAST(SUM(ZD.SUMM) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39'),'
      '1101682672=             SUM(ZD.AMOUNT),'
      
        '1101682673=             (SELECT CURR_STR from CURRENCYSTR(SUM(ZD' +
        '.SUMM), :CURRENCY_))'
      '1101682674=        FROM ZAKAZ Z,'
      '1101682675=             ZAKAZ_DETAILS ZD'
      '1101682676=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101682677=         AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101682678=        INTO :SUMM_,'
      '1101682679=             :AMOUNT_,'
      '1101682680=             :SUMM_STR_;'
      '1101682681='
      '1101682682=      FOR'
      '1101682683=        SELECT :I,'
      '1101682684=               G.NAME||DECODE(G.articul,'
      '1101682685=                              NULL, '#39#39','
      '1101682686=                              '#39#39', '#39#39','
      '1101682687=                              '#39', '#1072#1088#1090'. '#39'||G.articul),'
      '1101682688=               U.SHORT_NAME,'
      '1101682689=               G.barcode,'
      '1101682690=               CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '1101682691=               REPLACE(CAST((ZD.PRICE - COALESCE(ZD.D' +
        'ISCOUNT_TENGE, 0)) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1101682692=               REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101682693=               lpad(EXTRACT(DAY FROM Z.z_date), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.z_date), 2, 0)||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM Z.z_date)'
      '1101682694=          FROM ZAKAZ Z,'
      '1101682695=               ZAKAZ_DETAILS ZD,'
      '1101682696=               G_PRODUCT G,'
      '1101682697=               G_UNIT U'
      '1101682698=         WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101682699=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101682700=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101682701=           AND G.G_UNIT = U.G_UNIT'
      '1101682702=        INTO :ROW_NUM,'
      '1101682703=            :NAME,'
      '1101682704=            :UNIT_NAME,'
      '1101682705=            :BARCODE,'
      '1101682706=            :AMOUNT,'
      '1101682707=            :PRICE,'
      '1101682708=            :SUMM,'
      '1101682709=            :ZDATE'
      '1101682710=      DO BEGIN'
      '1101682711=        I = I + 1;'
      '1101682712=        SUSPEND;'
      '1101682713=      END'
      '1101682714=  END'
      '1101682715='
      '1101682716=  -- '#1044#1054#1042#1045#1056#1050#1040
      '1101682717=  ELSE BEGIN'
      
        '1101682718=          -- '#1057#1053#1040#1063#1040#1051#1040' '#1059#1047#1053#1040#1070' '#1048#1058#1054#1043#1054#1042#1059#1070' '#1057#1059#1052#1052#1059', '#1063#1058#1054#1041#1067' '#1042#1067#1042#1045 +
        #1057#1058#1048' '#1045#1045' '#1057#1056#1040#1047#1059' '#1042' SUSPEND'
      
        '1101682719=          POS_ = POSITION('#39'<amount_itog_val>'#39' IN BL_)' +
        ';       --'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1101682720=          POS2_ = POSITION('#39'</amount_itog_val>'#39' IN BL' +
        '_);     --'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1101682721=          STR_  = SUBSTRING(BL_ FROM POS_+17 FOR POS2' +
        '_ - POS_-17);'
      
        '1101682722=          SUMM_STR_ = STR_||'#39' ('#39'||(SELECT CURR_STR fr' +
        'om CURRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39')'#39'; -- -1 - ' +
        #1053#1045' '#1055#1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '1101682723='
      '1101682724=          WHILE (I > 0) DO BEGIN'
      '1101682725=            ROW_NUM = I;'
      
        '1101682726=            POS_ = POSITION('#39'<id>'#39' IN BL_);     --'#1055#1056#1054 +
        #1055#1059#1057#1050#1040#1070' '#1042#1057#1045', '#1048' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1061#1054#1046#1059' '#1050' ID'
      
        '1101682727=            POS2_ = POSITION('#39'</id>'#39' IN BL_);     --'#1047 +
        #1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1101682728=            STR_ = SUBSTRING(BL_ FROM POS_+4 FOR POS2' +
        '_ - POS_-4);'
      '1101682729=            g_product_ = CAST(STR_ AS DM_BIGINT);'
      '1101682730='
      
        '1101682731=            POS_ = POSITION('#39'<name>'#39' IN BL_);       -' +
        '-'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1101682732=            POS2_ = POSITION('#39'</name>'#39' IN BL_);     -' +
        '-'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1101682733=            NAME = SUBSTRING(BL_ FROM POS_+6 FOR POS2' +
        '_ - POS_-6);'
      '1101682734='
      
        '1101682735=            POS_ = POSITION('#39'<amount>'#39' IN BL_);      ' +
        ' --'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1101682736=            POS2_ = POSITION('#39'</amount>'#39' IN BL_);    ' +
        ' --'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '1101682737=            STR_  = SUBSTRING(BL_ FROM POS_+8 FOR POS' +
        '2_ - POS_-8);'
      
        '1101682738=            SUMM = STR_||'#39' ('#39'||(SELECT CURR_STR from ' +
        'CURRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39')'#39'; -- -1 - '#1053#1045' ' +
        #1055#1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '1101682739='
      '1101682740=            SELECT U.short_name'
      '1101682741=              FROM G_PRODUCT G, G_UNIT U'
      '1101682742=             WHERE G.g_unit = U.g_unit'
      '1101682743=               AND G.g_product = :G_PRODUCT_'
      '1101682744=              INTO :UNIT_NAME;'
      '1101682745='
      
        '1101682746=            --'#1085#1072#1093#1086#1078#1091' '#1090#1077#1075', '#1079#1072#1082#1088#1099#1074#1072#1102#1097#1080#1081' '#1090#1077#1075' '#1090#1086#1074#1072#1088#1072', '#1080' '#1091 +
        #1076#1072#1083#1103#1102' '#1101#1090#1086#1090' '#1090#1086#1074#1072#1088' '#1080#1079' '#1089#1087#1080#1089#1082#1072
      '1101682747=            I = I + 1;'
      '1101682748=            POS_ = POSITION('#39'</tovar>'#39' IN BL_);'
      
        '1101682749=            BL_ = SUBSTRING(BL_ FROM POS_ + 8 FOR cha' +
        'r_length(BL_)-POS_);'
      '1101682750=            IF (POSITION('#39'<tovar>'#39' IN BL_) = 0) THEN'
      '1101682751=              I = -1;'
      '1101682752='
      '1101682753=            SUSPEND;'
      '1101682754=          END'
      '1101682755=  END'
      '1101682756='
      '1101682757=WHEN ANY DO BEGIN'
      '1101682758=    Err_code = -20500;'
      
        '1101682759=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101682760=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101682761=  END'
      '1101682762=end'
      '1101682763=;'
      '1101682764='
      '1101682765=ALTER PROCEDURE P_REP_INVOICE('
      '1101682766=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '1101682767=  CURRENCY_ INTEGER)'
      '1101682768=RETURNS ('
      '1101682769=  NUM_ VARCHAR(50),'
      '1101682770=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '1101682771=  POSTAVSHIK_IDN_ADDRESS_ VARCHAR(1000),'
      '1101682772=  ACCOUNT_ VARCHAR(500),'
      '1101682773=  AGREEMENT_ VARCHAR(500),'
      '1101682774=  G_PAYMENT_TYPE_ VARCHAR(1000),'
      '1101682775=  PUNKT_ VARCHAR(1000),'
      '1101682776=  DOVERKA_ VARCHAR(1000),'
      '1101682777=  SPOSOB_OTPRAVKI_ VARCHAR(1000),'
      '1101682778=  NAKLADNAYA_ VARCHAR(1000),'
      '1101682779=  GRUZOOTPRAVITEL_ VARCHAR(1000),'
      '1101682780=  GRUZOPOLUCHATEL_ VARCHAR(1000),'
      '1101682781=  POLUCHATEL_ VARCHAR(1000),'
      '1101682782=  POLUCHATEL_ADDRESS_ VARCHAR(1000),'
      '1101682783=  POLUCHATEL_IIK_ VARCHAR(1000),'
      '1101682784=  RUKOVODITEL_ VARCHAR(1000),'
      '1101682785=  GLAVBUH_ VARCHAR(1000),'
      '1101682786=  ISPOLNITEL_APP_ VARCHAR(1000),'
      '1101682787=  ISPOLNITEL_ VARCHAR(1000),'
      '1101682788=  NUM_W_ VARCHAR(20),'
      '1101682789=  DATE_ VARCHAR(20),'
      '1101682790=  IDN_KPP_POST_ VARCHAR(30),'
      '1101682791=  IDN_KPP_POLUCH_ VARCHAR(30),'
      '1101682792=  CURR_STR_ VARCHAR(15),'
      '1101682793=  ROW_NUM VARCHAR(10),'
      '1101682794=  NAME VARCHAR(1000),'
      '1101682795=  SHORT_NAME VARCHAR(1000),'
      '1101682796=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101682797=  KOD_TNVD TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101682798=  AMOUNT MY_NUMERIC_5,'
      '1101682799=  PRICE VARCHAR(500),'
      '1101682800=  WITHOUT_NDS VARCHAR(500),'
      '1101682801=  NDS VARCHAR(500),'
      '1101682802=  NDS_SUMM VARCHAR(500),'
      '1101682803=  SUMM VARCHAR(500),'
      '1101682804=  STOIM_TOVAROV_ VARCHAR(500),'
      '1101682805=  SUMM_NDS_ VARCHAR(500),'
      '1101682806=  SUMM_VSEGO_ VARCHAR(500),'
      '1101682807=  ERR_CODE INTEGER,'
      '1101682808=  ERR_MSG VARCHAR(1024))'
      '1101682809=AS'
      
        '1101682810=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_INVOIC' +
        'E'#39';'
      '1101682811=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101682812=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101682813=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NOL_VMESTO_BEZ;'
      
        '1101682814=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REK' +
        'VIZIT.NDS_VALUE;'
      '1101682815=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101682816=DECLARE VARIABLE ZSUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      '1101682817=BEGIN'
      '1101682818='
      '1101682819=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      
        '1101682820=  SELECT DECODE(:CURRENCY_, 0, '#39#1055#1086#1089#1090#1072#1074#1097#1080#1082': '#39', '#39#39')||I.' +
        'POSTAVSHIK,'
      '1101682821=         DECODE(:CURRENCY_,'
      
        '1101682822=                0, DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39 +
        #1041#1048#1053#39')||'#39' '#1080' '#1077#1075#1086' '#1072#1076#1088#1077#1089': '#39'||DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')' +
        '||'#39': '#39'||G.IDN||'#39', '#39','
      '1101682823=                '#39#39')||I.POSTAVSHIK||'#39', '#39'||FD.ADDRESS||'
      
        '1101682824=                DECODE(G.is_nds, 1, '#39'. '#1057#1074#1080#1076#1077#1090#1077#1083#1100#1089#1090#1074#1086' ' +
        #1086' '#1087#1086#1089#1090#1072#1085#1086#1074#1082#1077' '#1085#1072' '#1088#1077#1075#1080#1089#1090#1088#1072#1094#1080#1086#1085#1085#1099#1081' '#1091#1095#1077#1090' '#1087#1086' '#1053#1044#1057': '#1057#1077#1088#1080#1103' '#39'||G.nds_seri' +
        'al'
      
        '1101682825=                       ||'#39', '#8470#39'||G.nds_num||'#39' '#1086#1090' '#39'||EX' +
        'TRACT(DAY from g.nds_date)||'#39'.'#39'||EXTRACT(MONTH from g.nds_date)|' +
        '|'#39'.'#39'||EXTRACT(YEAR from g.nds_date), '#39#39'),'
      
        '1101682826=         '#39#1048#1048#1050' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1072': '#39'||FC.ACCOUNT||'#39' '#1074' '#39'||FB.NA' +
        'ME||'#39', '#1041#1048#1050': '#39'||FB.BIK,'
      
        '1101682827=         '#39#1044#1086#1075#1086#1074#1086#1088' ('#1082#1086#1085#1090#1088#1072#1082#1090') '#1085#1072' '#1087#1086#1089#1090#1072#1074#1082#1091' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073 +
        #1086#1090', '#1091#1089#1083#1091#1075'): '#39'||COALESCE(TRIM(I.AGREEMENT), '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39'),'
      
        '1101682828=         '#39#1059#1089#1083#1086#1074#1080#1103' '#1086#1087#1083#1072#1090#1099' '#1087#1086' '#1076#1086#1075#1086#1074#1086#1088#1091' ('#1082#1086#1085#1090#1088#1072#1082#1090#1091'): '#39'||' +
        'GP.NAME,'
      
        '1101682829=         '#39#1055#1091#1085#1082#1090' '#1085#1072#1079#1085#1072#1095#1077#1085#1080#1103' '#1087#1086#1089#1090#1072#1074#1083#1103#1077#1084#1099#1093' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086 +
        #1090', '#1091#1089#1083#1091#1075'): '#39'||I.PUNKT_NAZNACHENIYA,'
      
        '1101682830=         '#39#1055#1086#1089#1090#1072#1074#1082#1072' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086#1090','#1091#1089#1083#1091#1075') '#1086#1089#1091#1097#1077#1089#1090#1074#1083#1077#1085#1072 +
        ' '#1087#1086' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080': '#39'||I.DOVERENNOST,'
      '1101682831=         '#39#1057#1087#1086#1089#1086#1073' '#1086#1090#1087#1088#1072#1074#1083#1077#1085#1080#1103': '#39'||I.SPOSOB_OTPRAVKI,'
      
        '1101682832=         '#39#1058#1086#1074#1072#1088#1085#1086'-'#1090#1088#1072#1085#1089#1087#1086#1088#1090#1085#1072#1103' '#1085#1072#1082#1083#1072#1076#1085#1072#1103': '#39'||I.NAKLAD' +
        'NAYA,'
      
        '1101682833=         DECODE(:CURRENCY_, 0, '#39#1043#1088#1091#1079#1086#1086#1090#1087#1088#1072#1074#1080#1090#1077#1083#1100': '#39', ' +
        #39#39')||I.GRUZOOTPRAVITEL,'
      
        '1101682834=         DECODE(:CURRENCY_, 0, '#39#1043#1088#1091#1079#1086#1087#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39', '#39 +
        #39')||I.GRUZOPOLUCHATEL,'
      
        '1101682835=         DECODE(:CURRENCY_, 0, '#39#1055#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39', '#39#39')||I' +
        '.CLIENT_NAME,'
      '1101682836=         DECODE(:CURRENCY_,'
      
        '1101682837=                0, '#39#1048#1048#1053'/'#1041#1048#1053' '#1080' '#1072#1076#1088#1077#1089' '#1084#1077#1089#1090#1086#1085#1072#1093#1086#1078#1076#1077#1085#1080#1103' '#1087 +
        #1086#1083#1091#1095#1072#1090#1077#1083#1103': '#39'||COALESCE(I.IDN_CLIENT, '#39#39'),'
      '1101682838=                '#39#39')||COALESCE('#39', '#39'||AD.ADDRESS, '#39#39'),'
      
        '1101682839=         '#39#1048#1048#1050' '#1087#1086#1083#1091#1095#1072#1090#1077#1083#1103': '#39'||COALESCE(CC.ACCOUNT||'#39' '#1074 +
        ' '#39'||CC.NAME||'#39', '#1041#1048#1050': '#39'||CC.BIK, '#39#39'),'
      '1101682840=         RO.FIO_DOC,'
      '1101682841=         COALESCE(GO.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '1101682842=         AP.NAME,'
      '1101682843=         IO.FIO_DOC,'
      
        '1101682844=         '#39#1057#1095#1077#1090'-'#1092#1072#1082#1090#1091#1088#1072' '#8470#39'||I.NUM||'#39' '#1086#1090' '#39'||EXTRACT(DAY' +
        ' FROM I.INIT_DATE)||'#39' '#39'||'
      
        '1101682845=           (SELECT * FROM GET_RUSSIAN_MONTH(EXTRACT(M' +
        'ONTH FROM I.INIT_DATE), 1))||'#39' '#39'||EXTRACT(YEAR FROM I.INIT_DATE)' +
        '||'#39' '#1075'.'#39','
      '1101682846=         I.ZAKAZ,'
      '1101682847=         -- '#1044#1051#1071' '#1056#1054#1057#1057#1048#1049#1057#1050#1054#1049' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1067
      '1101682848=         I.NUM,'
      
        '1101682849=         EXTRACT(DAY FROM I.INIT_DATE)||'#39' '#39'||(SELECT ' +
        '* FROM GET_RUSSIAN_MONTH(EXTRACT(MONTH FROM I.INIT_DATE), 1))||'#39 +
        ' '#39'||EXTRACT(YEAR FROM I.INIT_DATE)||'#39' '#1075'.'#39','
      '1101682850=         G.IDN||'#39'/'#39'||G.KPP,'
      '1101682851=         G.nol_vmesto_bez,'
      '1101682852=         G.NDS_VALUE,'
      '1101682853=         I.IDN_CLIENT,'
      
        '1101682854=         DECODE(:CURRENCY_, 1, '#39#1056#1091#1073#1083#1100', 643'#39', 2, '#39#1043#1088#1080#1074 +
        #1085#1072', 980'#39')'
      '1101682855=    FROM INVOICE I'
      
        '1101682856=           LEFT OUTER JOIN G_OFFICIAL RO ON I.G_OFFIC' +
        'IAL_RUKOVOD = RO.G_OFFICIAL'
      
        '1101682857=           LEFT OUTER JOIN G_OFFICIAL GO ON I.G_OFFIC' +
        'IAL_GB = GO.G_OFFICIAL'
      
        '1101682858=           LEFT OUTER JOIN G_ADDRESS  AD ON I.ADDRESS' +
        '_POKUPATEL = AD.G_ADDRESS'
      
        '1101682859=           LEFT OUTER JOIN (SELECT GA.g_account, GA.a' +
        'ccount, CB.name, CB.BIK'
      
        '1101682860=                            FROM g_account GA, g_bank' +
        ' CB WHERE GA.g_bank = CB.g_bank) CC ON I.IIK_CLIENT = CC.G_ACCOU' +
        'NT,'
      '1101682861=         G_FIRM_REKVIZIT G,'
      '1101682862=         G_FIRM_ACCOUNT  FC,'
      '1101682863=         G_FIRM_ADDRESS  FD,'
      '1101682864=         G_BANK          FB,'
      '1101682865=         ---'
      '1101682866=         G_PAYMENT_TYPE  GP,'
      '1101682867=         G_OFFICIAL      IO,'
      '1101682868=         G_APPOINTMENT   AP'
      '1101682869=   WHERE I.INVOICE = :INVOICE_'
      
        '1101682870=     AND ((I.g_firm = G.g_firm_rekvizit AND I.g_firm ' +
        'IS NOT NULL) OR (G.is_default = 1 AND I.g_firm IS NULL))  -- '#1044#1054' ' +
        '02.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '1101682871=     AND I.ADDRESS = FD.G_ADDRESS'
      '1101682872=     AND I.IIK = FC.G_ACCOUNT'
      '1101682873=     AND FC.G_BANK = FB.G_BANK'
      '1101682874=     AND I.G_PAYMENT_TYPE = GP.G_PAYMENT_TYPE'
      '1101682875=     AND I.G_OFFICIAL = IO.G_OFFICIAL'
      '1101682876=     AND IO.G_APPOINTMENT = AP.G_APPOINTMENT'
      '1101682877=   INTO  :POSTAVSHIK_NAME_,'
      '1101682878=         :POSTAVSHIK_IDN_ADDRESS_,'
      '1101682879=         :ACCOUNT_,'
      '1101682880=         :AGREEMENT_,'
      '1101682881=         :G_PAYMENT_TYPE_,'
      '1101682882=         :PUNKT_,'
      '1101682883=         :DOVERKA_,'
      '1101682884=         :SPOSOB_OTPRAVKI_,'
      '1101682885=         :NAKLADNAYA_,'
      '1101682886=         :GRUZOOTPRAVITEL_,'
      '1101682887=         :GRUZOPOLUCHATEL_,'
      '1101682888=         :POLUCHATEL_,'
      '1101682889=         :POLUCHATEL_ADDRESS_,'
      '1101682890=         :POLUCHATEL_IIK_,'
      '1101682891=         :RUKOVODITEL_,'
      '1101682892=         :GLAVBUH_,'
      '1101682893=         :ISPOLNITEL_APP_,'
      '1101682894=         :ISPOLNITEL_,'
      '1101682895=         :NUM_,'
      '1101682896=         :ZAKAZ_,'
      '1101682897=         :NUM_W_,'
      '1101682898=         :DATE_,'
      '1101682899=         :IDN_KPP_POST_,'
      '1101682900=         :BEZ_NDS_,'
      '1101682901=         :NDS_VALUE_,'
      '1101682902=         :IDN_KPP_POLUCH_,'
      '1101682903=         :CURR_STR_;'
      '1101682904='
      '1101682905=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '1101682906=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' (' +
        #1088#1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080#1079#1072#1094 +
        #1080#1080'"'
      
        '1101682907=  -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052#1059' '#1063 +
        #1058#1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048#1058#1040#1045 +
        #1058#1057#1071
      '1101682908=  SELECT Z.SUMM'
      '1101682909=    FROM ZAKAZ Z'
      '1101682910=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101682911=    INTO :ZSUMM_;'
      '1101682912='
      
        '1101682913=  STOIM_TOVAROV_ = REPLACE(CAST(ROUND(ZSUMM_/(1 + :ND' +
        'S_VALUE_/100), 2) AS VARCHAR(10)), '#39'.'#39', '#39','#39');'
      '1101682914=  IF (ZSUMM_ <> 0) then'
      
        '1101682915=    SUMM_NDS_    = REPLACE(CAST(CAST(ROUND(ZSUMM_ * N' +
        'DS_VALUE_/(100 + NDS_VALUE_), 2) AS NUMERIC(15,2)) AS VARCHAR(10' +
        ')), '#39'.'#39', '#39','#39');'
      '1101682916=  ELSE'
      '1101682917=    SUMM_NDS_    = '#39#39';'
      
        '1101682918=  SUMM_VSEGO_    = REPLACE(CAST(ZSUMM_ AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39');'
      '1101682919='
      '1101682920=  FOR'
      '1101682921=    SELECT :I,'
      '1101682922=           G.NAME||DECODE(G.articul,'
      '1101682923=                          NULL, '#39#39','
      '1101682924=                          '#39#39', '#39#39','
      '1101682925=                          '#39', '#1072#1088#1090'. '#39'||G.articul),'
      '1101682926=           U.SHORT_NAME,'
      '1101682927=           G.barcode,'
      '1101682928=           G.KOD_TNVD,'
      '1101682929=           CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '1101682930=           REPLACE(CAST(ROUND((ZD.PRICE - COALESCE(ZD' +
        '.DISCOUNT_TENGE, 0))/(1 + :NDS_VALUE_/100), 2) AS VARCHAR(10)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101682931=           REPLACE(CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE' +
        '_/100), 2) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      '1101682932=           DECODE(:NDS_VALUE_,'
      
        '1101682933=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1101682934=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1101682935=                             '#39'0,00'#39'),'
      
        '1101682936=                   REPLACE(CAST(:NDS_VALUE_ AS VARCHA' +
        'R(10)), '#39'.'#39', '#39','#39')),'
      
        '1101682937=           REPLACE(CAST(DECODE(ZD.SUMM, 0, NULL, ZD.S' +
        'UMM - CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15' +
        ',2))) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1101682938=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39'.'#39',' +
        ' '#39','#39')'
      '1101682939=      FROM ZAKAZ Z,'
      '1101682940=           ZAKAZ_DETAILS ZD,'
      '1101682941=           G_PRODUCT G,'
      '1101682942=           G_UNIT U'
      '1101682943=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101682944=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101682945=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101682946=       AND G.G_UNIT = U.G_UNIT'
      '1101682947=    INTO :ROW_NUM,'
      '1101682948=        :NAME,'
      '1101682949=        :SHORT_NAME,'
      '1101682950=        :BARCODE,'
      '1101682951=        :KOD_TNVD,'
      '1101682952=        :AMOUNT,'
      '1101682953=        :PRICE,'
      '1101682954=        :WITHOUT_NDS,'
      '1101682955=        :NDS,'
      '1101682956=        :NDS_SUMM,'
      '1101682957=        :SUMM'
      '1101682958=  DO BEGIN'
      '1101682959=    I = I + 1;'
      '1101682960=    SUSPEND;'
      '1101682961=  END'
      '1101682962='
      '1101682963=WHEN ANY DO BEGIN'
      '1101682964=    Err_code = -20500;'
      
        '1101682965=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101682966=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101682967=  END'
      '1101682968=end'
      '1101682969=;'
      '1101682970='
      '1101682971=ALTER PROCEDURE P_REP_KASSIR('
      '1101682972=  DATE_BEGIN_ DATE,'
      '1101682973=  DATE_END_ DATE,'
      '1101682974=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101682975=RETURNS ('
      '1101682976=  PERIOD_ VARCHAR(40),'
      '1101682977=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '1101682978=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '1101682979=  ROWCOL INTEGER,'
      '1101682980=  Z_DATE VARCHAR(40),'
      '1101682981=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101682982=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101682983=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101682984=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101682985=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '1101682986=AS'
      '1101682987=/*'
      
        '1101682988='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071 +
        ', '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '1101682989=*/'
      '1101682990=DECLARE VARIABLE SORT_COL INTEGER;'
      '1101682991=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '1101682992=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '1101682993=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '1101682994=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1101682995=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1101682996=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '1101682997=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      '1101682998=BEGIN'
      
        '1101682999=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1101683000=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1101683001='
      '1101683002=  SELECT S."INPUT"'
      '1101683003=    FROM kassa_state S'
      '1101683004=   WHERE S.k_date = :DATE_BEGIN_'
      '1101683005=     AND S.g_tochka = :G_TOCHKA_'
      '1101683006=    INTO :IN_SUMM_;'
      '1101683007='
      '1101683008=  IF (ROW_COUNT = 0) THEN'
      '1101683009=    SELECT S."OUTPUT"'
      '1101683010=      FROM kassa_state S'
      '1101683011=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1101683012=                         FROM KASSA_STATE ST'
      
        '1101683013=                        WHERE ST.k_date < :DATE_BEGIN' +
        '_'
      
        '1101683014=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1101683015=      AND S.g_tochka = :G_TOCHKA_'
      '1101683016=      INTO :IN_SUMM_;'
      '1101683017='
      '1101683018=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '1101683019='
      '1101683020=  SELECT S."OUTPUT"'
      '1101683021=    FROM kassa_state S'
      '1101683022=   WHERE S.k_date = :DATE_END_'
      '1101683023=     AND S.g_tochka = :G_TOCHKA_'
      '1101683024=    INTO :OUT_SUMM_;'
      '1101683025='
      '1101683026=  IF (ROW_COUNT = 0) THEN'
      '1101683027=    SELECT S."OUTPUT"'
      '1101683028=      FROM kassa_state S'
      '1101683029=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1101683030=                         FROM KASSA_STATE ST'
      '1101683031=                        WHERE ST.k_date < :DATE_END_'
      
        '1101683032=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1101683033=      AND S.g_tochka = :G_TOCHKA_'
      '1101683034=      INTO :OUT_SUMM_;'
      '1101683035='
      '1101683036=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '1101683037='
      '1101683038=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '1101683039=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')' +
        '||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_STR'
      '1101683040=           ,Z.Z_DATE'
      '1101683041=           ,GP.ARTICUL'
      '1101683042=           ,GP.BARCODE'
      '1101683043=           ,GP.NAME'
      '1101683044=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '1101683045=           ,SUM(ZD.summ)    SUMM'
      '1101683046=      FROM ZAKAZ Z'
