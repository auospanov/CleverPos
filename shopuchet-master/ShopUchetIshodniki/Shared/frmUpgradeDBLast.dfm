      '11067368=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11067369=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11067370=            EXIT;'
      '11067371=          END'
      '11067372=      END'
      '11067373=      UPDATE KASSA'
      '11067374=         SET ACTION = :ACTION_,'
      '11067375=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '11067376=             SUMM = :SUMM_,'
      '11067377=             ACTION_DATE = :ACTION_DATE_,'
      '11067378=             NOTE = COALESCE(:NOTE_, NOTE)'
      '11067379=      WHERE KASSA = :KASSA_;'
      '11067380=  END'
      
        '11067381=  -----------------------------------------------------' +
        '-----------------'
      '11067382=  --*************************************************'
      
        '11067383=  -----------------------------------------------------' +
        '-----------------'
      
        '11067384=  -----------------------------------------------------' +
        '-----------------'
      '11067385=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '11067386=  ELSE BEGIN'
      '11067387=      PNT_ = '#39'01A'#39';'
      
        '11067388=      -- '#1045#1057#1051#1048' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040', '#1058#1054' '#1059#1044#1040#1051#1071#1070' '#1057#1058#1040#1056#1059#1070' '#1047#1040#1055#1048#1057#1068' ' +
        #1048' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1047#1040' '#1053#1054#1042#1059#1070' '#1044#1040#1058#1059
      '11067389=      SELECT L.ACTION_DATE,'
      '11067390=             L.SUMM,'
      '11067391=             L.G_TOCHKA'
      '11067392=        FROM KASSA_BEZNAL L'
      '11067393=       WHERE L.KASSA_BEZNAL = :KASSA_'
      '11067394=        INTO :ACTION_DATE_OLD_,'
      '11067395=             :SUMM_OLD_,'
      '11067396=             :G_TOCHKA_;'
      '11067397='
      
        '11067398=      IF ((SUMM_OLD_ <> SUMM_) or (ACTION_DATE_OLD_ <> ' +
        'ACTION_DATE_)) THEN BEGIN'
      
        '11067399=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_PAY' +
        'MENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11067400=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11067401=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11067402=            EXIT;'
      '11067403=          END'
      '11067404='
      '11067405=          PNT_ = '#39'02A'#39';'
      '11067406=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '11067407=                                        :G_PRIHOD_RASHO' +
        'D_,'
      '11067408=                                        :SUMM_,'
      '11067409=                                        :ACTION_DATE_,'
      '11067410=                                        :NOTE_,'
      '11067411=                                        :ZAKAZ_,'
      '11067412=                                        :SKLAD_,'
      
        '11067413=                                        :G_PAYMENT_TYPE' +
        '_,'
      '11067414=                                        :G_TOCHKA_,'
      
        '11067415=                                        :G_OFFICIAL_) R' +
        'ETURNING_VALUES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '11067416=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11067417=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11067418=            EXIT;'
      '11067419=          END'
      '11067420='
      
        '11067421=          -- '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1053#1045' '#1041#1067#1051#1054' '#1055#1056#1054#1041#1051#1045#1052' '#1042' '#1042#1067 +
        #1047#1067#1042#1040#1070#1065#1045#1049' '#1055#1056#1054#1062#1045#1044#1059#1056#1045', '#1048#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1052#1045#1053#1071#1070' '#1053#1054#1042#1067#1049' ID '#1050#1040#1057#1057#1067' '#1053#1040' '#1057#1058#1040 +
        #1056#1067#1049','
      
        '11067422=          -- '#1042#1045#1044#1068' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1042#1067#1047#1067#1042#1040#1051#1057#1071' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1056#1040#1047#1059#1052#1045#1042#1040 +
        #1045#1058#1057#1071' '#1063#1058#1054' ID '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071
      '11067423=          UPDATE KASSA_BEZNAL SS'
      '11067424=             SET SS.KASSA_BEZNAL = :KASSA_'
      '11067425=           WHERE SS.KASSA_BEZNAL = :KASSA_NEW_;'
      '11067426='
      
        '11067427=          EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTI' +
        'ON_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '11067428=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11067429=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11067430=            EXIT;'
      '11067431=          END'
      '11067432=      END'
      '11067433=      UPDATE KASSA_BEZNAL'
      '11067434=         SET ACTION = :ACTION_,'
      '11067435=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '11067436=             SUMM = :SUMM_,'
      '11067437=             ACTION_DATE = :ACTION_DATE_,'
      '11067438=             NOTE = COALESCE(:NOTE_, NOTE)'
      '11067439=      WHERE KASSA_BEZNAL = :KASSA_;'
      '11067440=  END'
      '11067441=end'
      '11067442=;'
      '11067443='
      '11067444=ALTER PROCEDURE PARSE_TO_ARRAY('
      '11067445=  ID_ DM_BIGINT,'
      '11067446=  SKLAD_OR_ZAKAZ_ INTEGER)'
      '11067447=RETURNS ('
      '11067448=  STR_ BLOB SUB_TYPE 1)'
      '11067449=AS'
      '11067450=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '11067451=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '11067452=DECLARE VARIABLE DATE_ TYPE OF COLUMN KASSA.ACTION_DATE' +
        ';'
      
        '11067453=DECLARE VARIABLE PAYMENT_ TYPE OF COLUMN G_PAYMENT_TYPE' +
        '.G_PAYMENT_TYPE;'
      '11067454=BEGIN'
      '11067455=    STR_ = '#39#39';'
      '11067456=    FOR SELECT K.KASSA,'
      '11067457=               K.SUMM,'
      '11067458=               K.ACTION_DATE,'
      '11067459=               1              -- '#1058#1048#1055' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1040#1051#1048#1063#1053#1067#1049
      '11067460=          FROM KASSA K'
      
        '11067461=         WHERE ((K.SKLAD = :ID_ AND :SKLAD_OR_ZAKAZ_ = ' +
        '0) OR (K.ZAKAZ = :ID_ AND :SKLAD_OR_ZAKAZ_ = 1))'
      '11067462=           AND K.g_prihod_rashod IN (1,2,3, -5)'
      '11067463=         UNION ALL'
      '11067464=        SELECT K.KASSA_BEZNAL KASSA,'
      '11067465=               K.SUMM,'
      '11067466=               K.ACTION_DATE,'
      '11067467=               2              -- '#1058#1048#1055' '#1056#1040#1057#1063#1045#1058#1040' '#1041#1045#1047#1051#1048#1063#1053#1067#1049
      '11067468=          FROM KASSA_BEZNAL K'
      
        '11067469=         WHERE ((K.SKLAD = :ID_ AND :SKLAD_OR_ZAKAZ_ = ' +
        '0) OR (K.ZAKAZ = :ID_ AND :SKLAD_OR_ZAKAZ_ = 1))'
      '11067470=           AND K.g_prihod_rashod IN (1,2,3, -5)'
      '11067471=         ORDER BY 3'
      '11067472=          INTO :KASSA_,'
      '11067473=               :SUMM_,'
      '11067474=               :DATE_,'
      '11067475=               :PAYMENT_'
      '11067476=    DO BEGIN'
      
        '11067477=        STR_ = STR_ || KASSA_ || '#39'-'#39' || LPAD(CAST(EXTRA' +
        'CT(DAY FROM DATE_) AS VARCHAR(10)), 2, '#39'0'#39') ||'#39'.'#39'||'
      
        '11067478=                LPAD(CAST(EXTRACT(MONTH FROM DATE_) AS ' +
        'VARCHAR(10)), 2, '#39'0'#39') ||'#39'.'#39'|| EXTRACT(YEAR FROM DATE_) ||'
      
        '11067479=                '#39'-'#39' || REPLACE(CAST(SUMM_ AS VARCHAR(50' +
        ')), '#39','#39', '#39'.'#39') || '#39'-'#39' || PAYMENT_ || '#39'~'#39';'
      '11067480=    END'
      '11067481=END'
      '11067482=;'
      '11067483='
      '11067484=ALTER PROCEDURE R_IMPORT_REVISION('
      '11067485=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11067486=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11067487=  AMOUNT_ TYPE OF COLUMN REVISION.AMOUNT_REAL)'
      '11067488=RETURNS ('
      '11067489=  ERR_CODE INTEGER,'
      '11067490=  ERR_MSG VARCHAR(1024))'
      '11067491=AS'
      
        '11067492=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN LT_SKLAD_PRO' +
        'DUCT.G_PRODUCT = NULL;'
      '11067493=BEGIN'
      '11067494=  SELECT G_PRODUCT'
      '11067495=    FROM G_PRODUCT G'
      '11067496=   WHERE G.BARCODE = :BARCODE_'
      '11067497=    INTO :G_PRODUCT_;'
      '11067498='
      '11067499=  IF (G_PRODUCT_ IS NOT NULL) THEN BEGIN'
      '11067500=      IF (G_TOCHKA_ IS NULL) THEN'
      '11067501=        SELECT ID'
      '11067502=          FROM CUR_PARAMS'
      '11067503=         WHERE CUR_PARAMS = 2'
      '11067504=          INTO :G_TOCHKA_;'
      '11067505='
      '11067506=      UPDATE REVISION R'
      '11067507=         SET R.AMOUNT_REAL = :AMOUNT_'
      '11067508=       WHERE R.G_PRODUCT = :G_PRODUCT_;'
      '11067509='
      '11067510=      IF (ROW_COUNT = 0) THEN'
      
        '11067511=        INSERT INTO REVISION (REVISION, G_PRODUCT, AMOU' +
        'NT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '11067512=        VALUES ((SELECT MAX(REVISION) FROM REVISION) + ' +
        '1,'
      '11067513=                :G_PRODUCT_,'
      '11067514=                (SELECT AMOUNT'
      '11067515=                   FROM LT_SKLAD_PRODUCT'
      
        '11067516=                  WHERE G_TOCHKA = :G_TOCHKA_ AND G_PRO' +
        'DUCT = :G_PRODUCT_),'
      '11067517=                :AMOUNT_,'
      '11067518=                0,'
      '11067519=                :G_TOCHKA_);'
      '11067520=  END ELSE BEGIN'
      '11067521=    ERR_CODE = -20500;'
      
        '11067522=    ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085 +
        #1072#1081#1076#1077#1085'.'#39';'
      '11067523=  END'
      '11067524=END'
      '11067525=;'
      '11067526=ALTER PROCEDURE G_DEL_G_PRIHOD_RASHOD('
      
        '11067527=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRI' +
        'HOD_RASHOD)'
      '11067528=RETURNS ('
      '11067529=  ERR_CODE INTEGER,'
      '11067530=  ERR_MSG VARCHAR(1024))'
      '11067531=AS'
      '11067532=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '11067533=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11067534=begin'
      '11067535=  PROCNAME = '#39'G_DEL_G_PRIHOD_RASHOD'#39';'
      '11067536='
      
        '11067537=  if (G_PRIHOD_RASHOD_ in (-5, -1, 0, 1, 2, 3, 4)) then' +
        ' begin'
      '11067538=    ERR_CODE = -20500;'
      
        '11067539=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1079#1072#1087 +
        #1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '11067540=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11067541=    EXIT;'
      '11067542=  end'
      '11067543='
      '11067544=  delete from G_PRIHOD_RASHOD g'
      '11067545=    where g.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_;'
      '11067546='
      '11067547=when sqlcode -530 DO'
      '11067548=  begin'
      '11067549=    ERR_CODE = -20500;'
      
        '11067550=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' '#1089 +
