      '1102281627='
      '1102281628=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102281629=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1102281630=      (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIH' +
        'OD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SP' +
        'ISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '1102281631=       AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHO' +
        'D_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1102281632=    VALUES'
      
        '1102281633=      (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :' +
        'AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_, :AMOU' +
        'NT_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVRAT_,'
      
        '1102281634=       :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :AMOUN' +
        'T_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '1102281635='
      '1102281636=    -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '1102281637=    AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + AMOUNT_' +
        'PRIHOD_;'
      
        '1102281638=    SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUMM_PRIH' +
        'OD_;'
      
        '1102281639=    AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMOUNT_UH' +
        'OD_;'
      '1102281640=    SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_UHOD_;'
      
        '1102281641=    AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ + AMOUN' +
        'T_SPISANO_;'
      
        '1102281642=    SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + SUMM_SP' +
        'ISANO_;'
      
        '1102281643=    AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ + AMOUN' +
        'T_VOZVRAT_;'
      
        '1102281644=    SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + SUMM_VO' +
        'ZVRAT_;'
      
        '1102281645=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ +' +
        ' AMOUNT_PRIHOD_SKL_;'
      
        '1102281646=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + S' +
        'UMM_PRIHOD_SKL_;'
      
        '1102281647=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + A' +
        'MOUNT_UHOD_SKL_;'
      
        '1102281648=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUM' +
        'M_UHOD_SKL_;'
      '1102281649='
      '1102281650=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '1102281651=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1102281652=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHO' +
        'D_SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1102281653=    VALUES'
      
        '1102281654=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AM' +
        'OUNT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UH' +
        'OD_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVR' +
        'AT_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIH' +
        'OD_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '1102281655='
      
        '1102281656=    STR_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102281657=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102281658='
      '1102281659=  FOR'
      '1102281660=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '1102281661=           DECODE(T.IS_HEAD,'
      '1102281662=                  0, T.NAME,'
      '1102281663=                  1, T.NAME,'
      '1102281664=                  2, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39','
      '1102281665=                  3, '#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39'),'
      '1102281666=           G.ARTICUL,'
      '1102281667=           G.BARCODE,'
      '1102281668=           G.PRICE,'
      '1102281669=           T.AMOUNT_IN,'
      '1102281670=           T.AMOUNT_PRIHOD,'
      '1102281671=           T.SUMM_PRIHOD,'
      '1102281672=           T.AMOUNT_UHOD,'
      '1102281673=           T.SUMM_UHOD,'
      '1102281674=           T.AMOUNT_SPISANO,'
      '1102281675=           T.SUMM_SPISANO,'
      '1102281676=           T.AMOUNT_VOZVRAT,'
      '1102281677=           T.SUMM_VOZVRAT,'
      '1102281678=           T.AMOUNT_PRIHOD_SKL,'
      '1102281679=           T.SUMM_PRIHOD_SKL,'
      '1102281680=           T.AMOUNT_UHOD_SKL,'
      '1102281681=           T.SUMM_UHOD_SKL,'
      '1102281682=           T.AMOUNT_OUT,'
      '1102281683=           T.LAST_SUPPLIER,'
      '1102281684=           T.IS_HEAD'
      
        '1102281685=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1102281686=     ORDER BY 1'
      '1102281687=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1102281688=       :NAME,'
      '1102281689=       :ARTICUL,'
      '1102281690=       :BARCODE,'
      '1102281691=       :PRICE,'
      '1102281692=       :AMOUNT_IN,'
      '1102281693=       :AMOUNT_PRIHOD,'
      '1102281694=       :SUMM_PRIHOD,'
      '1102281695=       :AMOUNT_UHOD,'
      '1102281696=       :SUMM_UHOD,'
      '1102281697=       :AMOUNT_SPISANO,'
      '1102281698=       :SUMM_SPISANO,'
      '1102281699=       :AMOUNT_VOZVRAT,'
      '1102281700=       :SUMM_VOZVRAT,'
      '1102281701=       :AMOUNT_PRIHOD_SKL,'
      '1102281702=       :SUMM_PRIHOD_SKL,'
      '1102281703=       :AMOUNT_UHOD_SKL,'
      '1102281704=       :SUMM_UHOD_SKL,'
      '1102281705=       :AMOUNT_OUT,'
      '1102281706=       :LAST_SUPPLIER,'
      '1102281707=       :IS_HEAD'
      '1102281708=  DO SUSPEND;'
      '1102281709='
      '1102281710=WHEN ANY DO BEGIN'
      '1102281711=    Err_code = -20500;'
      
        '1102281712=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102281713=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102281714=  END'
      '1102281715=end'
      '1102281716=;'
      '1102281717='
      '1102281718=ALTER PROCEDURE SYNC_DOWNLOAD('
      '1102281719=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102281720=RETURNS ('
      '1102281721=  ERR_CODE INTEGER,'
      '1102281722=  ERR_MSG VARCHAR(1024),'
      '1102281723=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '1102281724=AS'
      '1102281725=/*'
      '1102281726='#1060#1048#1053#1040#1051' 07.02.2019'
      '1102281727=*/'
      '1102281728=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '1102281729=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
      '1102281730=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '1102281731=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '1102281732=DECLARE VARIABLE POS_ INTEGER = 0;'
      '1102281733=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '1102281734=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '1102281735=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '1102281736=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGM' +
        'ENT SIZE 80 = '#39#39';'
      
        '1102281737=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102281738=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102281739=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      
        '1102281740=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PROD' +
        'UCT.AMOUNT;'
      
        '1102281741=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT_RESERVE;'
      
        '1102281742=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '1102281743=DECLARE VARIABLE ACTION_DATE_MIN_ TYPE OF COLUMN KASS' +
        'A.ACTION_DATE = CURRENT_DATE;'
      
        '1102281744=DECLARE VARIABLE ACTION_DATE_MIN_OLD_ TYPE OF COLUMN ' +
        'KASSA.ACTION_DATE = CURRENT_DATE;'
      
        '1102281745=DECLARE VARIABLE CREDIT_ TYPE OF COLUMN KASSA_STATE.C' +
        'REDIT;'
      
        '1102281746=DECLARE VARIABLE DEBET_ TYPE OF COLUMN KASSA_STATE.DE' +
        'BET;'
      '1102281747=DECLARE VARIABLE RECALC_STR_ VARCHAR(1024) = '#39#39';'
      '1102281748=DECLARE VARIABLE STR_ VARCHAR(1024);'
      '1102281749=DECLARE VARIABLE TABLE_ TYPE OF COLUMN LOGS.TTABLE;'
      '1102281750=DECLARE VARIABLE TABLE_INT_ INTEGER;'
      '1102281751=DECLARE VARIABLE OPER_ INTEGER;'
      '1102281752=BEGIN'
      '1102281753=  ERR_CODE = 0;'
      '1102281754=  ERR_MSG = '#39#39';'
      '1102281755=  ERR_BODY = '#39#39';'
      '1102281756='
      '1102281757=  FOR SELECT L.ID,'
      '1102281758=             L.SQLSTMT,'
      '1102281759=             L.TTABLE'
      '1102281760=        FROM LOGS L'
      '1102281761=       WHERE L.USR = '#39'REPLICAT'#39
      '1102281762=         AND L.DAT IS NULL'
      '1102281763=         AND L.IS_TRANSFERED = 0'
      
        '1102281764=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTM' +
        'T) = 0'
      '1102281765=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) = 0'
      
        '1102281766=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) =' +
        ' 0'
      
        '1102281767=         AND POSITION('#39'EXECUTE PROCEDURE K_RECALC_KAS' +
        'SA'#39' IN L.SQLSTMT) = 0'
      '1102281768=        ORDER BY L.ID_ORIGINAL'
      '1102281769=        INTO :LOGS_ID_,'
      '1102281770=             :SQL_,'
      '1102281771=             :TABLE_'
      '1102281772=  DO BEGIN'
      '1102281773=    BEGIN'
      '1102281774=        SQLCODE_ = 0;'
      '1102281775='
      '1102281776=        EXECUTE STATEMENT SQL_;'
      '1102281777='
      
        '1102281778=        /*IF (UPLOAD_TO_EXT_APP_ = 1 AND TABLE_ IN ('#39 +
        'G_PRODUCT'#39', '#39'ZAKAZ'#39', '#39'SKLAD_PARENT'#39', '#39'G_TOCHKA'#39')) THEN BEGIN'
      '1102281779=           IF (TABLE_ = '#39'ZAKAZ'#39') THEN'
      '1102281780=             TABLE_INT_ = 1;'
      '1102281781=           ELSE IF (TABLE_ = '#39'SKLAD_PARENT'#39') THEN'
      '1102281782=             TABLE_INT_ = 2;'
      '1102281783=           ELSE IF (TABLE_ = '#39'G_TOCHKA'#39') THEN'
      '1102281784=             TABLE_INT_ = 3;'
      '1102281785=           ELSE IF (TABLE_ = '#39'G_PRODUCT'#39') THEN'
      '1102281786=             TABLE_INT_ = 4;'
      '1102281787='
      '1102281788=           IF (POSITION('#39'INSERT'#39' IN SQL_) > 0) THEN'
      '1102281789=             OPER_ = 1;'
      
        '1102281790=           ELSE IF (POSITION('#39'UPDATE'#39' IN SQL_) > 0) T' +
        'HEN'
      '1102281791=             OPER_ = 2;'
      
        '1102281792=           ELSE IF (POSITION('#39'DELETE'#39' IN SQL_) > 0) T' +
        'HEN'
      '1102281793=             OPER_ = 3;'
      '1102281794='
      
        '1102281795=           INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '1102281796=             VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), :TA' +
        'BLE_INT_, 111, :OPER_);'
      '1102281797=        END*/'
      '1102281798='
      '1102281799=    WHEN ANY DO'
      '1102281800=        BEGIN'
      '1102281801=            SQLCODE_ = GDSCODE;'
      '1102281802=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102281803=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102281804=            ERR_BODY = ERR_BODY ||'#39
      '1102281805='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102281806=        END'
      '1102281807=    END'
      '1102281808='
      
        '1102281809=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102281810=    UPDATE LOGS L'
      
        '1102281811=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102281812=           L.ERR_CODE = :SQLCODE_'
      '1102281813=     WHERE L.ID = :LOGS_ID_;'
      '1102281814=  END'
      '1102281815='
      '1102281816=  POS_ = 0;'
      '1102281817=  FOR SELECT L.ID,'
      '1102281818=             L.SQLSTMT,'
      '1102281819=             L.DAT,'
      '1102281820=             L.RR'
      '1102281821=        FROM LOGS L'
      '1102281822=       WHERE L.USR = '#39'REPLICAT'#39
      '1102281823=         AND L.DAT IS NOT NULL'
      '1102281824=         AND L.IS_TRANSFERED = 0'
      '1102281825=        ORDER BY L.ID_ORIGINAL'
      '1102281826=        INTO :LOGS_ID_,'
      '1102281827=             :SQL_,'
      '1102281828=             :DAT_,'
      '1102281829=             :IDX_'
      '1102281830=  DO BEGIN'
      '1102281831=    POS_ = POSITION('#39'.'#39', SQL_);'
      '1102281832=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '1102281833=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR P' +
        'OS_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_' +
        ' - 1)||'#39' = :DAT_'#39'||'
      
        '1102281834=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ +' +
        ' 1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '1102281835='
      '1102281836=    BEGIN'
      '1102281837=        SQLCODE_ = 0;'
      '1102281838=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '1102281839=    WHEN ANY DO'
      '1102281840=        BEGIN'
      '1102281841=            SQLCODE_ = GDSCODE;'
      '1102281842=            ERR_BODY = ERR_BODY ||'#39
      '1102281843='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102281844=        END'
      '1102281845=    END'
      '1102281846='
      
        '1102281847=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102281848='
