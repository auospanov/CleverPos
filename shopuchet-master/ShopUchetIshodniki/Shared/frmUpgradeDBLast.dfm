        '1101461655=                        EXECUTE PROCEDURE K_DEL_KASSA' +
        '(:KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_' +
        'MSG);'
      
        '1101461656=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1101461657=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101461658=                          EXIT;'
      '1101461659=                        END'
      '1101461660='
      '1101461661=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '1101461662=                           EXECUTE PROCEDURE K_INS_KA' +
        'SSA(0,     -- ACTION_ => :ACTION_'
      
        '1101461663=                                                     ' +
        '     1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101461664=                                                     ' +
