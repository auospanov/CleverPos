      '1101825926=                       S.NOTE      = :NOTE_'
      '1101825927=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1101825928='
      
        '1101825929=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101825930=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101825931=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101825932=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_),'
      
        '1101825933=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1101825934=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101825935=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1101825936=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1101825937=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101825938=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_),'
      
        '1101825939=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1101825940=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101825941=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101825942='
      
        '1101825943=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101825944=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101825945=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101825946=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101825947=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_),'
      
        '1101825948=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1101825949=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101825950=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101825951='
      
        '1101825952=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1101825953=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101825954=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_),'
      
        '1101825955=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1101825956=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101825957=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101825958='
      
        '1101825959=                -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' ' +
        #1057#1050#1051#1040#1044', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1101825960=                END ELSE IF (IS_EXPECTED_OLD_ = 1 AND' +
        ' NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101825961=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101825962=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_,'
      
        '1101825963=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1101825964=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101825965=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101825966='
      '1101825967=                    IF (ROW_COUNT = 0) THEN'
      
        '1101825968=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101825969=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_AP' +
        'P_);'
      '1101825970=                END'
      
        '1101825971=                -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042 +
        #1040' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1101825972=                ELSE IF (IS_EXPECTED_OLD_ = 0 AND NOT' +
        '_MINUS_OSTATOK_ = 1) THEN BEGIN'
      '1101825973=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101825974=                       SET L.AMOUNT = L.AMOUNT - (:AM' +
        'OUNT_OLD_ - :Z_AMOUNT_) - :Z_AMOUNT_,'
      
        '1101825975=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1101825976=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101825977=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101825978=                END'
      '1101825979='
      
        '1101825980=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1101825981=                /*IF ((Z_DATE_ > DATE_RECEIPT_OLD_) A' +
        'ND (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1101825982=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101825983=                      FROM SKLAD SK'
      '1101825984=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101825985=                       AND SK.IS_LAST = 1'
      '1101825986=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101825987=                      INTO :DATE_LAST_;'
      '1101825988='
      
        '1101825989=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101825990=                      UPDATE SKLAD SK'
      '1101825991=                         SET SK.IS_LAST = 0'
      
        '1101825992=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1101825993=                         AND SK.IS_LAST = 1'
      
        '1101825994=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1101825995='
      '1101825996=                      UPDATE SKLAD SK'
      '1101825997=                         SET SK.IS_LAST = 1'
      
        '1101825998=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101825999=                    END'
      '1101826000=                END'
      '1101826001='
      
        '1101826002=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1101826003=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1101826004=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101826005=                      FROM SKLAD SK'
      '1101826006=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101826007=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1101826008=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101826009=                       AND SK.is_vozvrat IN (0,3,4)'
      '1101826010=                      INTO :DATE_LAST_;'
      '1101826011='
      
        '1101826012=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101826013=                      UPDATE SKLAD SK'
      '1101826014=                         SET SK.IS_LAST = 0'
      
        '1101826015=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101826016='
      '1101826017=                       UPDATE SKLAD SK'
      '1101826018=                         SET SK.IS_LAST = 1'
      
        '1101826019=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1101826020=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1101826021=                                           FROM SKLAD' +
        ' SS'
      
        '1101826022=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1101826023=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1101826024=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1101826025=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1101826026=                    END'
      '1101826027=                END*/'
      '1101826028=            END'
      '1101826029=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1101826030=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1101826031='
      '1101826032=      UPDATE SKLAD_PARENT'
      '1101826033=      SET'
      
        '1101826034=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1101826035=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1101826036=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101826037=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101826038=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101826039=       SUMM      = :SUMM_,'
      '1101826040=       SUMM_FACT = :SUMM_FACT_,'
      '1101826041=       IS_EXPECTED = :NOT_MINUS_OSTATOK_'
      '1101826042=      WHERE SKLAD  = :ZAKAZ_;'
      '1101826043=  END'
      '1101826044='
      '1101826045=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101826046='
      '1101826047=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101826048=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 2, :SUMM_, :LOG_BODY_, 0);'
      '1101826049='
      '1101826050=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1101826051=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1101826052=END'
      '1101826053=;'
      '1101826054='
      '1101826055=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL_REAL('
      '1101826056=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101826057=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101826058=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101826059=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101826060=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101826061=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101826062=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101826063=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101826064=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101826065=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101826066=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101826067=RETURNS ('
      '1101826068=  ERR_CODE INTEGER,'
      '1101826069=  ERR_MSG VARCHAR(1024))'
      '1101826070=AS'
      '1101826071=/*'
      
        '1101826072='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'-'#1054#1055#1051#1040#1058#1059' '#1047 +
        #1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051
      '1101826073='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1060#1054#1056#1052#1045' TOplataTovaraRealNForm'
      '1101826074='
      
        '1101826075=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1040#1055#1044#1045#1049#1058' '#1042#1054#1047#1042#1056#1040#1058#1040' ' +
        #1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101826076=*/'
      
        '1101826077=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL_REAL'#39';'
      '1101826078=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101826079=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101826080=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101826081=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1101826082=DECLARE VARIABLE Z_G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.G_PRODUCT;'
      
        '1101826083=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1101826084=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '1101826085=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      '1101826086=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101826087=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101826088=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      
        '1101826089=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1101826090=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101826091=BEGIN'
      
        '1101826092=  --*************************************************' +
        '*************************************************'
      
        '1101826093=  --*************************************************' +
        '*************************************************'
      '1101826094=  --  '#1040#1055#1044#1045#1049#1058' '#1054#1041#1067#1063#1053#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1047#1040' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101826095=  --*************************************************' +
        '*************************************************'
      
        '1101826096=  --*************************************************' +
        '*************************************************'
      '1101826097=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101826098=      SELECT Z.G_PAYMENT_TYPE'
      '1101826099=        FROM ZAKAZ Z'
      '1101826100=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101826101=        INTO :G_PAYMENT_TYPE_OLD_;'
      '1101826102='
      '1101826103=      PNT_ = '#39'01a'#39';'
      '1101826104=      UPDATE zakaz'
      '1101826105=      SET'
      '1101826106=       Z_DATE = :Z_DATE_,'
      '1101826107=       Z_TIME = :Z_TIME_,'
      '1101826108=       G_CLIENT = :G_CLIENT_,'
      '1101826109=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101826110=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101826111=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1101826112=       SUMM = :SUMM_,'
      '1101826113=       SUMM_FACT = :SUMM_FACT_,'
      
        '1101826114=       SUMM_CASH = DECODE(:G_PAYMENT_TYPE_, 1, :SUMM_' +
        'FACT_, 0),'
      
        '1101826115=       SUMM_NONCASH = DECODE(:G_PAYMENT_TYPE_, 2, :SU' +
        'MM_FACT_, 0)'
      '1101826116=      WHERE'
      '1101826117=        zakaz = :zakaz_;'
      '1101826118='
      '1101826119=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101826120=      PNT_ = '#39'02a'#39';'
      
        '1101826121=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101826122=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101826123=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101826124=        EXIT;'
      '1101826125=      END'
      '1101826126='
      '1101826127=      PNT_ = '#39'03a'#39';'
      '1101826128=      DELETE from zakaz_DETAILS z'
      '1101826129=      WHERE z.zakaz = :zakaz_;'
      '1101826130=      FOR SELECT G_PRODUCT,'
      '1101826131=                 AMOUNT,'
      '1101826132=                 SUMM,'
      '1101826133=                 ZAKAZ_NA_REAL,'
      '1101826134=                 ZAKAZ_DETAILS'
      '1101826135=            FROM ZAKAZ_DETAILS_TMP_REAL'
      '1101826136=      INTO :Z_G_PRODUCT_,'
      '1101826137=           :Z_AMOUNT_,'
      '1101826138=           :Z_SUMM_,'
      '1101826139=           :ZAKAZ_NA_REAL_,'
      '1101826140=           :ZAKAZ_DETAILS_'
      '1101826141=      DO BEGIN'
      '1101826142=        PNT_ = '#39'04a'#39';'
      
        '1101826143=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E, DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '1101826144=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, ' +
        'NDS, NDS_SUMM, COST_PRICE'
      '1101826145=          FROM ZAKAZ_DETAILS_TMP_REAL Z'
      '1101826146=         WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      
        '1101826147=           AND Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;   -' +
        '-'#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1054#1043#1059#1058' '#1055#1054#1042#1058#1054#1056#1071#1058#1068#1057#1071' :ZAKAZ_NA_REAL_, '#1058#1054' '#1045#1057#1058#1068' '#1055#1054' '#1054#1044#1053#1054#1052#1059 +
        ' :ZAKAZ_NA_REAL_ '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' :ZAKAZ_DETAILS_'
      '1101826148='
      '1101826149=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101826150=        PNT_ = '#39'05a'#39';'
      '1101826151=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101826152=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :Z_A' +
        'MOUNT_,'
      
        '1101826153=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1101826154=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'ZR.AMOUNT_PAYED + :Z_AMOUNT_, 1, 0)'
      '1101826155=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101826156='
      
        '1101826157=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL, '#1053#1054' '#1058'.'#1050'. ZAKAZ_DETAILS '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1057 +
        ' ID ZAKAZ_REAL ('#1042#1067#1064#1045' '#1047#1040#1055#1054#1051#1053#1071#1045#1058#1057#1071' ZAKAZ_DETAILS_TMP),'
      
        '1101826158=        -- '#1058#1054' '#1058#1059#1058' '#1054#1041#1045' '#1050#1054#1051#1054#1053#1050#1048' '#1041#1059#1044#1059#1058' '#1055#1054#1061#1054#1046#1048' '#1044#1056#1059#1043' '#1053#1040' '#1044#1056 +
        #1059#1043#1040
      '1101826159=        PNT_ = '#39'06a'#39';'
      
        '1101826160=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1101826161=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1101826162=      END'
      '1101826163='
      '1101826164=      ----------------------------------------'
      
        '1101826165=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101826166=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1101826167=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1101826168=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101826169=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101826170=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1101826171=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101826172=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101826173=      if (G_PAYMENT_TYPE_OLD_ = 1) then'
      '1101826174=          SELECT S.KASSA,'
      '1101826175=                 S.G_TOCHKA'
      '1101826176=            FROM KASSA S'
      '1101826177=           WHERE S.ZAKAZ = :ZAKAZ_'
      
        '1101826178=             AND S.G_PRIHOD_RASHOD = 1     -- '#1055#1056#1054#1044#1040#1046#1040 +
        ' '#1058#1054#1042#1040#1056#1040
      '1101826179=            INTO :KASSA_,'
      '1101826180=                 :G_TOCHKA_;'
      '1101826181=      ELSE'
      '1101826182=          SELECT S.KASSA_BEZNAL,'
      '1101826183=                 S.G_TOCHKA'
      '1101826184=            FROM KASSA_BEZNAL S'
      '1101826185=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1101826186=             AND S.G_PRIHOD_RASHOD = 1'
      '1101826187=            INTO :KASSA_,'
      '1101826188=                 :G_TOCHKA_;'
      '1101826189='
      
        '1101826190=        -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045 +
        ' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1101826191=        IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) TH' +
        'EN BEGIN'
      '1101826192=          PNT_ = '#39'05'#39';'
      '1101826193=          EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '1101826194=                                        0,     -- ACT' +
        'ION_'
      
        '1101826195=                                        1,     --:G_P' +
        'RIHOD_RASHOD_,'
      '1101826196=                                        :SUMM_FACT_,'
      '1101826197=                                        :Z_DATE_,'
      
        '1101826198=                                        NULL,   --NOT' +
        'E_'
      '1101826199=                                        :ZAKAZ_,'
      '1101826200=                                        NULL,'
      
        '1101826201=                                        :G_PAYMENT_TY' +
        'PE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101826202=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101826203=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101826204=            EXIT;'
      '1101826205=          END'
      '1101826206='
      
        '1101826207=        -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044 +
        #1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101826208=        -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044 +
        #1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101826209=        END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT' +
        '_TYPE_) THEN BEGIN'
      '1101826210=            PNT_ = '#39'07'#39';'
      
        '1101826211=            EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G' +
        '_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101826212=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101826213=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101826214=              EXIT;'
      '1101826215=            END'
      '1101826216='
      
        '1101826217=            EXECUTE PROCEDURE K_INS_KASSA(0,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101826218=                                          1,     -- G' +
        '_PRIHOD_RASHOD_'
      
        '1101826219=                                          :SUMM_FACT_' +
        ','
      '1101826220=                                          :Z_DATE_,'
      
        '1101826221=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1101826222=                                          :ZAKAZ_,   ' +
        '--ZAKAZ_'
      '1101826223=                                          NULL,'
      
        '1101826224=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101826225=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101826226=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101826227=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101826228=              EXIT;'
      '1101826229=            END'
      '1101826230=        END'
      '1101826231=      ----------------------------------------'
      '1101826232=  END'
      '1101826233=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101826234=  --*************************************************' +
        '*************************************************'
      
        '1101826235=  --*************************************************' +
        '*************************************************'
      '1101826236='
      
        '1101826237=  --*************************************************' +
        '*************************************************'
      
        '1101826238=  --*************************************************' +
        '*************************************************'
      '1101826239=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101826240=  --*************************************************' +
        '*************************************************'
      
        '1101826241=  --*************************************************' +
        '*************************************************'
      '1101826242=  ELSE BEGIN'
      '1101826243=      UPDATE SKLAD_PARENT'
      '1101826244=      SET'
      
        '1101826245=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1101826246=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1101826247=       G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_' +
        'PAYMENT_TYPE),'
      '1101826248=       G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1101826249=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101826250=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101826251=       SUMM = :SUMM_,'
      '1101826252=       SUMM_FACT = :SUMM_FACT_'
      '1101826253=      WHERE SKLAD  = :ZAKAZ_'
      '1101826254=      RETURNING G_TOCHKA'
      '1101826255=      INTO :G_TOCHKA_;'
      '1101826256='
      '1101826257=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101826258=      PNT_ = '#39'02'#39';'
      
        '1101826259=      EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, NUL' +
        'L, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101826260=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101826261=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101826262=        EXIT;'
      '1101826263=      END'
      '1101826264='
      '1101826265=      PNT_ = '#39'03'#39';'
      '1101826266=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1101826267=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101826268=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101826269=      FOR SELECT T.AMOUNT,'
      '1101826270=                 T.SUMM,'
      '1101826271=                 T.G_PRODUCT,'
      '1101826272=                 T.ZAKAZ_NA_REAL,'
      '1101826273=                 T.ZAKAZ_DETAILS'
      '1101826274=                 ,T.PRICE'
      '1101826275=                 ,T.NDS'
      '1101826276=                 ,T.NDS_SUMM'
      '1101826277=                 ,T.DISCOUNT_TENGE'
      '1101826278=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101826279=            INTO :Z_AMOUNT_,'
      '1101826280=                 :Z_SUMM_,'
      '1101826281=                 :Z_G_PRODUCT_,'
      '1101826282=                 :ZAKAZ_NA_REAL_,'
      '1101826283=                 :ZAKAZ_DETAILS_'
      '1101826284=                 ,:PRICE_'
      '1101826285=                 ,:NDS_'
      '1101826286=                 ,:NDS_SUMM_'
      '1101826287=                 ,:DISCOUNT_TENGE_'
      '1101826288=      DO BEGIN'
      
        '1101826289=        INSERT INTO SKLAD(SKLAD, G_PRODUCT, DATE_RECE' +
        'IPT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, IS_VOZVRA' +
        'T'
      
        '1101826290=                         ,G_CLIENT, G_PAYMENT_TYPE, O' +
        'SNOVANIE, NOTE, G_TOCHKA)'
      
        '1101826291=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :Z_G_PRODU' +
        'CT_, :Z_DATE_, :Z_AMOUNT_, :PRICE_ - :DISCOUNT_TENGE_, :Z_SUMM_,' +
        ' :NDS_, :NDS_SUMM_, :ZAKAZ_, 2'
      
        '1101826292=                         ,:G_CLIENT_, :G_PAYMENT_TYPE' +
        '_, :OSNOVANIE_, :NOTE_, :G_TOCHKA_);'
      '1101826293='
      
        '1101826294=        UPDATE LT_SKLAD_PRODUCT L       -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101826295=           SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_,'
      '1101826296=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101826297=         WHERE L.G_PRODUCT = :Z_G_PRODUCT_'
      '1101826298=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101826299='
      
        '1101826300=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1101826301=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1101826302='
      '1101826303=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101826304=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :Z_AMOUNT_,'
      
        '1101826305=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1101826306=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :Z_AMOUNT_, 1, 0)'
      '1101826307=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101826308=      END'
      '1101826309=  END'
      '1101826310=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101826311=  --*************************************************' +
        '*************************************************'
      
        '1101826312=  --*************************************************' +
        '*************************************************'
      '1101826313='
      '1101826314=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101826315=END'
      '1101826316=;'
      '1101826317='
      '1101826318=ALTER PROCEDURE ZR_DEL_ZAKAZ_REAL_PARENT('
      
        '1101826319=  ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKAZ_REAL_PARENT' +
        '.ZAKAZ_REAL_PARENT,'
      '1101826320=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101826321=RETURNS ('
      '1101826322=  ERR_CODE INTEGER,'
      '1101826323=  ERR_MSG VARCHAR(1024))'
      '1101826324=AS'
      
        '1101826325=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'ZR_DEL_ZAKAZ' +
        '_REAL_PARENT'#39';'
      '1101826326=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101826327=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101826328=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101826329=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101826330=BEGIN'
      '1101826331='
      
        '1101826332=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040 +
        #1044#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1054#1053' '#1059#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1063#1045#1053
      '1101826333=  FOR SELECT G_PRODUCT,'
      '1101826334=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED,'
      '1101826335=             ZP.G_TOCHKA'
      '1101826336=        FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      
        '1101826337=       WHERE Z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT' +
        '_'
      '1101826338=         AND Z.IS_PAYED_ALL = 0'
      
        '1101826339=         AND ZP.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PAREN' +
        'T_'
      '1101826340=       INTO :G_PRODUCT_,'
      '1101826341=            :AMOUNT_,'
      '1101826342=            :G_TOCHKA_'
      '1101826343=  DO BEGIN'
      '1101826344=    UPDATE LT_SKLAD_PRODUCT LT'
      '1101826345=       SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_,'
      '1101826346=           LT.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101826347=     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1101826348=       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1101826349=  END'
      '1101826350='
      '1101826351=  -- '#1059#1044#1040#1051#1071#1070' '#1058#1054#1042#1040#1056' '#1048#1047' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1101826352=  PNT_ = '#39'03'#39';'
      '1101826353=  DELETE from ZAKAZ_NA_REAL z'
      '1101826354=  WHERE z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_;'
      '1101826355='
      '1101826356=  DELETE FROM ZAKAZ_REAL_PARENT'
      '1101826357=  WHERE ZAKAZ_REAL_PARENT =  :ZAKAZ_REAL_PARENT_;'
      '1101826358=WHEN SQLCODE -530 DO'
      '1101826359=  BEGIN'
      '1101826360=    ERR_CODE = -20500;'
      
        '1101826361=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101826362=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101826363=  END'
      '1101826364=END'
      '1101826365=;'
      '1101826366='
      '1101826367='
      
        '1101826368=/****************************************************' +
        '**************************/'
      
        '1101826369=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101826370=/****************************************************' +
        '**************************/'
      '1101826371=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '1101826372=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT,'
      '1101826373=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101826374=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101826375=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1101826376=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1101826377=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1101826378=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1101826379=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101826380=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101826381=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ','
      '1101826382=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1101826383=  IS_SPISANIE_ INTEGER,'
      '1101826384=  NEW_LINE_SALE_ INTEGER = 0,'
      '1101826385=  MODE_ INTEGER = 0,'
      '1101826386=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '1101826387=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '1101826388=  MARK_CODE_ VARCHAR(100) = '#39#39')'
      '1101826389=RETURNS ('
      
        '1101826390=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1101826391=  ERR_CODE INTEGER,'
      '1101826392=  ERR_MSG VARCHAR(1024))'
      '1101826393=AS'
      '1101826394=/*'
      
        '1101826395=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063 +
        #1048#1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '1101826396=*/'
      
        '1101826397=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39';'
      '1101826398=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '1101826399=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0;'
      
        '1101826400=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0;'
      
        '1101826401=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1101826402=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1101826403=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '1101826404=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      
        '1101826405=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.PRICE;'
      
        '1101826406=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.COST_PRICE;'
      
        '1101826407=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '1101826408=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101826409=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040 +
        #1041#1051#1048#1062#1045' */'
      
        '1101826410=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058 +
        ' '#1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '1101826411=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101826412=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '1101826413=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '1101826414=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUM' +
        'N G_PRODUCT.G_PRODUCT;'
      '1101826415=BEGIN'
      '1101826416=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '1101826417='
      
        '1101826418=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071 +
        #1070#1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '1101826419=  SELECT T.ZAKAZ, T.Z_TYPE'
      '1101826420=    FROM ZAKAZ_DETAILS_TMP T'
      '1101826421=   WHERE T.ZAKAZ IS NOT NULL'
      
        '1101826422=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' ' +
        #1089#1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082 +
        #1072' MULTIPLE ROWS IN SINGLETON SELECT'
      '1101826423=    INTO :ZAKAZ_, :Z_TYPE_;'
      '1101826424='
      
        '1101826425=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045 +
        #1051#1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101826426=           ,G.IS_KIT'
      '1101826427=           ,K.AMOUNT * :AMOUNT_'
      '1101826428=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '1101826429=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PR' +
        'ICE)'
      '1101826430=           ,(CASE'
      
        '1101826431=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANI' +
        'E_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT *' +
        ' FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '1101826432=             ELSE K.PRICE'
      '1101826433=           END) COST_PRICE'
      
        '1101826434=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_' +
        'LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '1101826435=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE' +
        ' G_PRODUCT = :G_PRODUCT_) CNT'
      
        '1101826436=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT ' +
        'K ON G.G_PRODUCT = K.G_PRODUCT'
      '1101826437=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101826438=       AND G.IS_KIT = 1'
      '1101826439=    UNION'
      
        '1101826440=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056 +
        #1054#1044#1040#1046
      '1101826441=           ,G.IS_KIT'
      '1101826442=           ,:AMOUNT_'
      '1101826443=           ,:PRICE_'
      '1101826444=           ,0'
      '1101826445=           ,:COST_PRICE_'
      '1101826446=           ,0'
      '1101826447=      FROM G_PRODUCT G'
      '1101826448=     WHERE G_PRODUCT = :G_PRODUCT_'
      '1101826449=       AND G.IS_KIT <> 1'
      '1101826450=      INTO :G_PRODUCT_'
      '1101826451=           ,:IS_KIT_'
      '1101826452=           ,:AMOUNT_'
      '1101826453=           ,:PRICE__'
      '1101826454=           ,:SOSTAV_PRICE_'
      '1101826455=           ,:COST_PRICE__'
      '1101826456=           ,:SOSTAV_COUNT_'
      '1101826457=  DO BEGIN'
      '1101826458=      ZAKAZ_DTLS_TMP_ = NULL;'
      '1101826459='
      
        '1101826460=      --=============================================' +
        '=============='
      '1101826461=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101826462=      SELECT AMOUNT - AMOUNT_RESERVE'
      '1101826463=        FROM LT_SKLAD_PRODUCT L'
      '1101826464=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '1101826465=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101826466=       INTO :AMOUNT_CUR_;'
      '1101826467='
      
        '1101826468=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1101826469=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1101826470=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1101826471=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1101826472=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101826473=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '1101826474=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1101826475=          SELECT SUM(AMOUNT)'
      '1101826476=            FROM ZAKAZ_DETAILS T'
      '1101826477=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101826478=             AND T.ZAKAZ = :ZAKAZ_'
      '1101826479=            INTO :AMOUNT_OLD_;'
      '1101826480=        ELSE'
      '1101826481=          SELECT SUM(AMOUNT)'
      '1101826482=            FROM SKLAD T'
      '1101826483=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101826484=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1101826485=            INTO :AMOUNT_OLD_;'
      '1101826486=      END'
      '1101826487='
      '1101826488=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1101826489=      SELECT SUM(AMOUNT)'
      '1101826490=        FROM ZAKAZ_DETAILS_TMP T'
      '1101826491=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101826492=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1101826493='
      
        '1101826494=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_,' +
        ' 0) + :AMOUNT_;'
      '1101826495=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '1101826496='
      
        '1101826497=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042 +
        ' '#1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1101826498='
      
        '1101826499=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1101826500=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047 +
        #1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1101826501=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) ' +
        'THEN BEGIN'
      '1101826502=            PNT_ = '#39'01'#39';'
      
        '1101826503=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID F' +
        'ROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101826504=                                         CURRENT_DATE' +
        ','
      '1101826505=                                         :G_PRODUCT_,'
      
        '1101826506=                                         ABS(AMOUNT_C' +
        'UR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOU' +
        'NT_,'
      
        '1101826507=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074 +
        #1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1101826508=                                         )'
      
        '1101826509=                RETURNING_VALUES :SKLAD_, :COST_PRICE' +
        '__, :ERR_CODE, :ERR_MSG;'
      '1101826510=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101826511=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101826512=              EXIT;'
      '1101826513=            END'
      '1101826514=        END'
      
        '1101826515=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_P' +
        'RODUCT_ <> -2) THEN BEGIN'
      '1101826516=            SELECT NAME'
      '1101826517=            FROM G_PRODUCT'
      '1101826518=            WHERE G_PRODUCT = :G_PRODUCT_'
      '1101826519=            INTO :PRODUCT_NAME_;'
      '1101826520='
      '1101826521=            ERR_CODE = -20500;'
      
        '1101826522=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_' +
        'NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1101826523=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1101826524=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1101826525=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1101826526=            EXIT;'
      '1101826527=        END'
      '1101826528=      END'
      '1101826529=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101826530=      --=============================================' +
        '=============='
      '1101826531='
      
        '1101826532=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077 +
        #1090#1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087 +
        #1083#1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '1101826533=      IF (IS_KIT_ = 1) THEN BEGIN'
      '1101826534='
      '1101826535=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '1101826536=        --    PRICE__ = SOSTAV_PRICE_;'
      '1101826537=        --END ELSE BEGIN'
      '1101826538=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '1101826539=              PRICE__ = COST_PRICE__;'
      '1101826540='
      
        '1101826541=            END ELSE IF (Discount_perc_ <> 0) THEN BE' +
        'GIN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '1101826542=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PE' +
        'RC_/100;'
      '1101826543='
      '1101826544='
      
        '1101826545=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THE' +
        'N BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '1101826546=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / S' +
        'OSTAV_PRICE_;'
      
        '1101826547=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE' +
        '_;'
      '1101826548=            END'
      '1101826549='
      
        '1101826550=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUN' +
        'T_;'
      
        '1101826551=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMO' +
        'UNT_;'
      '1101826552=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '1101826553=        --END'
      '1101826554=      END'
      '1101826555='
      
        '1101826556=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' ' +
        #1045#1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '1101826557=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041 +
        #1048#1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '1101826558=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_COD' +
        'E_) = 0) THEN'
      '1101826559=          SELECT ZD.zakaz_details'
      '1101826560=            FROM zakaz_details_tmp ZD'
      '1101826561=           WHERE ZD.G_PRODUCT = :g_product_'
      '1101826562=             AND ZD.PRICE = :PRICE__'
      '1101826563=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '1101826564=            INTO :ZAKAZ_DTLS_TMP_;'
      '1101826565='
      '1101826566='
      '1101826567=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '1101826568=        UPDATE ZAKAZ_DETAILS_TMP P'
      '1101826569=           SET P.amount = P.amount + :amount_'
      
        '1101826570=               ,P.summ = (P.price - P.discount_TENGE)' +
        ' * (P.amount + :AMOUNT_)'
      
        '1101826571=               ,P.discount_summ = P.discount_TENGE * ' +
        '(P.amount + :AMOUNT_)'
      '1101826572=               ,P.NDS = :NDS_'
      '1101826573=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '1101826574=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '1101826575='
      '1101826576=      ELSE BEGIN'
      
        '1101826577=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN' +
        ' BEGIN'
      
        '1101826578=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_' +
        ';'
      '1101826579=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '1101826580=          END'
      '1101826581='
      '1101826582=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '1101826583=          ('
      '1101826584=           ZAKAZ_DETAILS,'
      '1101826585=           ZAKAZ,'
      '1101826586=           G_PRODUCT,'
      '1101826587=           AMOUNT,'
      '1101826588=           PRICE,'
      '1101826589=           SUMM,'
      '1101826590=           DISCOUNT_PERC,'
      '1101826591=           DISCOUNT_TENGE,'
      '1101826592=           DISCOUNT_SUMM,'
      '1101826593=           NDS,'
      '1101826594=           NDS_SUMM,'
      '1101826595=           COST_PRICE,'
      '1101826596=           MARK_CODE,'
      '1101826597=           ORIGINAL_KIT_ID,'
      '1101826598=           ORIGINAL_KIT_PRICE'
      '1101826599=          ) VALUES ('
      '1101826600=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101826601=           :ZAKAZ_,'
      '1101826602=           :G_PRODUCT_,'
      '1101826603=           :AMOUNT_,'
      '1101826604=           :PRICE__,'
      '1101826605=           :SUMM_,'
      '1101826606=           :DISCOUNT_PERC_,'
      '1101826607=           :DISCOUNT_TENGE_,'
      '1101826608=           :DISCOUNT_SUMM_,'
      '1101826609=           :NDS_,'
      '1101826610=           :NDS_SUMM_,'
      '1101826611=           :COST_PRICE__,'
      '1101826612=           :MARK_CODE_,'
      '1101826613=           :ORIGINAL_KIT_ID_,'
      '1101826614=           :ORIGINAL_KIT_PRICE_'
      '1101826615=          )'
      '1101826616=          RETURNING'
      '1101826617=            ZAKAZ_DETAILS'
      '1101826618=          INTO'
      '1101826619=            :ZAKAZ_DETAILS_;'
      '1101826620=      END'
      '1101826621=  END'
      '1101826622=end'
      '1101826623=;'
      '1101826624='
      '1101826625='
      
        '1101826626=UPDATE SYSTEM_SETUP SET S_VALUE = 110182 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101826627=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101826628=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101820='
      '1101821=ALTER PROCEDURE W_GET_WAYBILL('
      '1101822=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1101823=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1101824=  CURRENCY_ INTEGER,'
      '1101825=  MODE_ INTEGER)'
      '1101826=RETURNS ('
      '1101827=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '1101828=  INIT_DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1101829=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '11018210=  POSTAVSHIK_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '11018211=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '11018212=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCHAT' +
        'EL,'
      
