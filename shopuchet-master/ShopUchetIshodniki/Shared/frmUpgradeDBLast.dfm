      '1102111292=                  :NDS_SUMM)'
      '1102111293=          RETURNING ZAKAZ_NA_REAL'
      '1102111294=          INTO :ZAKAZ_;'
      '1102111295=      END'
      '1102111296=  END'
      '1102111297=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102111298=  ----------------------------------------'
      '1102111299=  ----------------------------------------'
      '1102111300=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1102111301=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1102111302=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102111303=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102111304=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1102111305=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102111306=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102111307=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102111308=      RETURNING SKLAD'
      '1102111309=      INTO :ZAKAZ_;'
      '1102111310='
      '1102111311=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102111312=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102111313=          INTO :G_PRODUCT,'
      '1102111314=              :AMOUNT,'
      '1102111315=              :PRICE,'
      '1102111316=              :SUMM'
      '1102111317=      DO BEGIN'
      '1102111318=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102111319=        UPDATE LT_SKLAD_PRODUCT L'
      '1102111320=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1102111321=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102111322=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102111323=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102111324='
      '1102111325=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102111326=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1102111327=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1102111328=        SELECT MAX(SK.DATE_RECEIPT)'
      '1102111329=            FROM SKLAD SK'
      '1102111330=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102111331=             AND SK.IS_LAST = 1'
      '1102111332=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1102111333=            INTO :DATE_LAST_;'
      '1102111334='
      
        '1102111335=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102111336=            UPDATE SKLAD SK'
      '1102111337=               SET SK.IS_LAST = 0'
      '1102111338=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102111339=               AND SK.IS_LAST = 1'
      '1102111340=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102111341='
      '1102111342=            IS_THIS_LAST_ = 1;'
      '1102111343=        END */'
      '1102111344='
      '1102111345='
      '1102111346=        INSERT INTO SKLAD'
      '1102111347=        ('
      '1102111348=         SKLAD,'
      '1102111349=         SKLAD_PARENT,'
      '1102111350=         DATE_RECEIPT,'
      '1102111351=         G_CLIENT,'
      '1102111352=         G_PRODUCT,'
      '1102111353=         AMOUNT,'
      '1102111354=         PRICE,'
      '1102111355=         SUMM,'
      '1102111356=         G_PAYMENT_TYPE,'
      '1102111357=         OSNOVANIE,'
      '1102111358=         NOTE,'
      '1102111359=         NDS,'
      '1102111360=         NDS_SUMM,'
      '1102111361=         IS_LAST,'
      '1102111362=         IS_VOZVRAT,'
      '1102111363=         G_TOCHKA'
      '1102111364=        ) VALUES ('
      '1102111365=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102111366=         :ZAKAZ_,'
      '1102111367=         :Z_DATE_,'
      '1102111368=         :G_TOCHKA_,'
      '1102111369=         :G_PRODUCT,'
      '1102111370=         :AMOUNT,'
      '1102111371=         :PRICE,'
      '1102111372=         :SUMM,'
      '1102111373=         :G_PAYMENT_TYPE_,'
      '1102111374=         :OSNOVANIE_,'
      '1102111375=         :NOTE_,'
      '1102111376=         0,  --:RNDS_,'
      '1102111377=         0,  --:RNDS_SUMM_,'
      
        '1102111378=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102111379=         3,  --:IS_VOZVRAT_,'
      '1102111380=         :G_CLIENT_'
      '1102111381=        );'
      '1102111382='
      
        '1102111383=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102111384=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102111385=        PNT_ = '#39'02'#39';'
      '1102111386=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102111387=            UPDATE LT_SKLAD_PRODUCT L'
      '1102111388=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102111389=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102111390=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102111391=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102111392='
      '1102111393=            IF (ROW_COUNT = 0) THEN'
      
        '1102111394=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102111395=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102111396=        END'
      '1102111397=      END'
      '1102111398=  END'
      '1102111399='
      '1102111400=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102111401='
      
        '1102111402=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102111403=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102111404=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102111405=                                  G_PRIHOD_,'
      '1102111406=                                  :SUMM_PRIHOD_,'
      '1102111407=                                  :Z_DATE_,'
      
        '1102111408=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102111409=                                  :ZAKAZ_,'
      '1102111410=                                  NULL,'
      '1102111411=                                  :G_PAYMENT_TYPE_,'
      '1102111412=                                  :G_TOCHKA_,'
      '1102111413=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102111414=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102111415=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102111416=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102111417=      EXIT;'
      '1102111418=    END'
      '1102111419=  END'
      '1102111420='
      
        '1102111421=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102111422=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102111423=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102111424=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102111425='
      '1102111426=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102111427=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102111428='
      '1102111429=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102111430=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102111431=end'
      '1102111432=;'
      '1102111433='
      '1102111434=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '1102111435=  DATE_BEGIN_ DATE,'
      '1102111436=  DATE_END_ DATE,'
      '1102111437=  IS_SPISANIE_ INTEGER)'
      '1102111438=RETURNS ('
      '1102111439=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102111440=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102111441=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1102111442=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102111443=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102111444=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1102111445=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102111446=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102111447=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102111448=  DETAILS_STR VARCHAR(3000),'
      '1102111449=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102111450=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1102111451=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '1102111452=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '1102111453=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1102111454=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102111455=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102111456=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102111457=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102111458=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1102111459=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '1102111460=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102111461=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102111462=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102111463=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102111464=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      
        '1102111465=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      
        '1102111466=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PA' +
        'Y_TYPE.NAME)'
      '1102111467=AS'
      '1102111468=/*'
      '1102111469=IS_SPISANIE_'
      '1102111470=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102111471=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102111472=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102111473=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102111474=*/'
      '1102111475=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102111476=DECLARE VARIABLE G_OFFICIAL_LOCAL_ TYPE OF COLUMN G_O' +
        'FFICIAL.G_OFFICIAL;'
      
        '1102111477=DECLARE VARIABLE G_OFFICIAL_APPOINT_ TYPE OF COLUMN G' +
        '_OFFICIAL.IS_ISPOLNITEL;'
      '1102111478=BEGIN'
      '1102111479='
      '1102111480=  SELECT G.G_OFFICIAL,'
      '1102111481=         G.IS_ISPOLNITEL'
      '1102111482=    FROM CUR_PARAMS C,'
      '1102111483=         G_OFFICIAL G'
      '1102111484=   WHERE C.ID = G.G_OFFICIAL'
      '1102111485=     AND C.CUR_PARAMS = 1'
      '1102111486=    INTO :G_OFFICIAL_LOCAL_,'
      '1102111487=         :G_OFFICIAL_APPOINT_;'
      '1102111488='
      '1102111489=  G_OFFICIAL_LOCAL_ = COALESCE(G_OFFICIAL_LOCAL_, 0);'
      
        '1102111490=  G_OFFICIAL_APPOINT_ = COALESCE(G_OFFICIAL_APPOINT_,' +
        ' 0);'
      '1102111491='
      '1102111492=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102111493=      SELECT COUNT(*)'
      '1102111494=        FROM ZAKAZ T'
      
        '1102111495=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '1102111496=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1102111497=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '1102111498=        INTO CNT_;'
      '1102111499='
      '1102111500=      if (CNT_ = 0) then'
      '1102111501=        SELECT MAX(T.Z_DATE)'
      '1102111502=          FROM ZAKAZ T'
      '1102111503=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '1102111504=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '1102111505=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102111506=          INTO :DATE_BEGIN_;'
      '1102111507='
      '1102111508=  END ELSE BEGIN'
      '1102111509=      SELECT COUNT(*)'
      '1102111510=        FROM SKLAD_PARENT T'
      
        '1102111511=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1102111512=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1102111513=        INTO CNT_;'
      '1102111514='
      '1102111515=      if (CNT_ = 0) then'
      '1102111516=        SELECT MAX(T.DATE_RECEIPT)'
      '1102111517=          FROM SKLAD_PARENT T'
      '1102111518=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1102111519=           AND T.IS_VOZVRAT = 3'
      
        '1102111520=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102111521=          INTO :DATE_BEGIN_;'
      '1102111522=  END'
      '1102111523='
      '1102111524=  -- '#1055#1056#1054#1044#1040#1046#1048
      '1102111525=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '1102111526=      FOR'
      '1102111527=        SELECT T.ZAKAZ,'
      
        '1102111528=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102111529=               T.G_TOCHKA,'
      '1102111530=               T.Z_DATE,'
      '1102111531=               T.Z_TIME,'
      '1102111532=               T.G_CLIENT,'
      '1102111533=               T.OSNOVANIE,'
      '1102111534=               T.NOTE,'
      '1102111535=               gc.name,'
      
        '1102111536=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AM' +
        'OUNT||'#39')'#39', '#39', '#39')'
      
        '1102111537=                            FROM (SELECT G.name, SUM(' +
        'D.amount) AMOUNT'
      
        '1102111538=                                    FROM ZAKAZ Z, ZAK' +
        'AZ_DETAILS D, G_PRODUCT G'
      
        '1102111539=                                   WHERE D.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1102111540=                                     AND D.ZAKAZ = Z.' +
        'ZAKAZ'
      
        '1102111541=                                     AND Z.ZAKAZ = T.' +
        'ZAKAZ'
      '1102111542=                                   GROUP BY G.name)'
      
        '1102111543=                          ) FROM 1 FOR 1500)*/'#39' '#39' DET' +
        'AILS_STR,'
      '1102111544=               T.IS_SPISANIE,'
      
        '1102111545=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_A' +
        'LL,'
      '1102111546=               IP.INVOICE_PAY,'
      '1102111547=               I.INVOICE,'
      '1102111548=               W.WAYBILL,'
      '1102111549=               T.SUMM,'
      '1102111550=               T.SUMM_FACT,'
      '1102111551=               COALESCE(t.SUMM_BONUS, 0),'
      '1102111552=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '1102111553=               COALESCE(T.BY_RECIPE, 0)'
      '1102111554=               ,IS_RESERVE'
      '1102111555=               ,T.SUMM_CASH'
      '1102111556=               ,T.SUMM_NONCASH'
      '1102111557=               ,O.g_official'
      '1102111558=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '1102111559=               ,T.DELIVERY_ADDRESS'
      '1102111560=               ,GN.G_NONCASH_PAY_TYPE'
      '1102111561=               ,GN.NAME'
      '1102111562=          FROM ZAKAZ T'
      
        '1102111563=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1102111564=                    LEFT OUTER JOIN INVOICE_PAY IP ON' +
        ' T.ZAKAZ = IP.ZAKAZ'
      
        '1102111565=                    LEFT OUTER JOIN INVOICE I ON T.ZA' +
        'KAZ = I.ZAKAZ'
      
        '1102111566=                    LEFT OUTER JOIN WAYBILL W ON T.ZA' +
        'KAZ = W.ZAKAZ'
      
        '1102111567=                    LEFT OUTER JOIN G_OFFICIAL O ON T' +
        '.g_official = O.g_official'
      
        '1102111568=                    LEFT OUTER JOIN G_NONCASH_PAY_TYP' +
        'E GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '1102111569=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102111570=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISA' +
        'NIE_ = 0'
      '1102111571=                 AND'
      
        '1102111572=                 ((:G_OFFICIAL_APPOINT_ = 1 AND T.G_O' +
        'FFICIAL = :G_OFFICIAL_LOCAL_)'
      '1102111573=                   OR'
      '1102111574=                  (:G_OFFICIAL_APPOINT_ = 0 )'
      '1102111575=                 )'
      '1102111576=                )'
      '1102111577=                or'
      
        '1102111578=                (T.IS_SPISANIE = :IS_SPISANIE_ AND :I' +
        'S_SPISANIE_ <> 0)'
      '1102111579=               )'
      
        '1102111580=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102111581=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1102111582=        INTO :ZAKAZ,'
      '1102111583=             :Z_NUM,'
      '1102111584=             :G_TOCHKA,'
      '1102111585=             :Z_DATE,'
      '1102111586=             :Z_TIME,'
      '1102111587=             :G_CLIENT,'
      '1102111588=             :OSNOVANIE,'
      '1102111589=             :NOTE,'
      '1102111590=             :CLIENT_NAME,'
      '1102111591=             :DETAILS_STR,'
      '1102111592=             :IS_SPISANIE,'
      '1102111593=             :IS_PAYED_ALL,'
      '1102111594=             :INVOICE_PAY,'
      '1102111595=             :INVOICE,'
      '1102111596=             :WAYBILL,'
      '1102111597=             :SUM_ZAKAZ,'
      '1102111598=             :SUM_FACT,'
      '1102111599=             :SUMM_PAY_BONUS,'
      '1102111600=             :SUMM_BONUS_GOT,'
      '1102111601=             :BY_RECIPE'
      '1102111602=             ,:IS_RESERVE'
      '1102111603=             ,:summ_cash'
      '1102111604=             ,:SUMM_NONCASH'
      '1102111605=             ,:G_OFFICIAL'
      '1102111606=             ,:G_OFFICIAL_FIO'
      '1102111607=             ,:ADDRESS'
      '1102111608=             ,:G_NONCASH_PAY_TYPE'
      '1102111609=             ,:G_NONCASH_PAY_TYPE_NAME'
      '1102111610=      DO'
      '1102111611=        suspend;'
      '1102111612='
      '1102111613=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '1102111614=  END ELSE IF (IS_SPISANIE_ = 1) THEN BEGIN'
      '1102111615=      FOR'
      '1102111616=        SELECT T.ZAKAZ,'
      
        '1102111617=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102111618=               T.G_TOCHKA,'
      '1102111619=               T.Z_DATE,'
      '1102111620=               T.Z_TIME,'
      '1102111621=               T.G_CLIENT,'
      '1102111622=               T.OSNOVANIE,'
      '1102111623=               T.NOTE,'
      '1102111624=               NULL,'
      '1102111625=               SUBSTRING((SELECT'
      
        '1102111626=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT|' +
        '|'#39')'#39', '#39', '#39')'
      
        '1102111627=                        FROM ZAKAZ_DETAILS D, G_PRODU' +
        'CT G'
      
        '1102111628=                        WHERE D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '1102111629=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '1102111630=                          GROUP BY ZAKAZ) FROM 1 FOR ' +
        '999) DETAILS_STR,'
      '1102111631=               T.IS_SPISANIE,'
      '1102111632=               0,'
      '1102111633=               NULL,'
      '1102111634=               NULL,'
      '1102111635=               NULL,'
      '1102111636=               T.SUMM,'
      '1102111637=               T.SUMM_FACT,'
      '1102111638=               0,'
      '1102111639=               0'
      '1102111640=          FROM ZAKAZ T'
      
        '1102111641=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1102111642=           AND T.IS_SPISANIE  = 1'
      
        '1102111643=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102111644=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1102111645=        INTO :ZAKAZ,'
      '1102111646=             :Z_NUM,'
      '1102111647=             :G_TOCHKA,'
      '1102111648=             :Z_DATE,'
      '1102111649=             :Z_TIME,'
      '1102111650=             :G_CLIENT,'
      '1102111651=             :OSNOVANIE,'
      '1102111652=             :NOTE,'
      '1102111653=             :CLIENT_NAME,'
      '1102111654=             :DETAILS_STR,'
      '1102111655=             :IS_SPISANIE,'
      '1102111656=             :IS_PAYED_ALL,'
      '1102111657=             :INVOICE_PAY,'
      '1102111658=             :INVOICE,'
      '1102111659=             :WAYBILL,'
      '1102111660=             :SUM_ZAKAZ,'
      '1102111661=             :SUM_FACT,'
      '1102111662=             :SUMM_PAY_BONUS,'
      '1102111663=             :SUMM_BONUS_GOT'
      '1102111664=      DO'
      '1102111665=        suspend;'
      '1102111666='
      '1102111667=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102111668=  END ELSE BEGIN'
      '1102111669=      FOR'
      '1102111670=        SELECT T.SKLAD,'
      
        '1102111671=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102111672=               T.G_TOCHKA,'
      '1102111673=               T.DATE_RECEIPT,'
      '1102111674=               T.TIME_RECEIPT,'
      '1102111675=               T.G_CLIENT,'
      '1102111676=               T.OSNOVANIE,'
      '1102111677=               T.NOTE,'
      '1102111678=               gc.name,'
      '1102111679=               /*SUBSTRING((SELECT'
      
        '1102111680=                            LIST(G.NAME||'#39'('#39'||D.AMOUN' +
        'T||'#39')'#39', '#39', '#39')'
      '1102111681=                            FROM SKLAD D, G_PRODUCT G'
      
        '1102111682=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1102111683=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1102111684=                            GROUP BY SKLAD_PARENT) FR' +
        'OM 1 FOR 999)*/ '#39#39' DETAILS_STR,'
      '1102111685=               T.SUMM,'
      '1102111686=               T.IS_VOZVRAT,'
      '1102111687=               W.WAYBILL'
      
        '1102111688=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL' +
        ' W ON T.SKLAD = W.ZAKAZ,'
      '1102111689=               G_TOCHKA GC'
      
        '1102111690=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1102111691=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102111692=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '1102111693=           AND T.IS_VOZVRAT = 3'
      '1102111694=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '1102111695=        INTO :ZAKAZ,'
      '1102111696=             :Z_NUM,'
      '1102111697=             :G_TOCHKA,'
      '1102111698=             :Z_DATE,'
      '1102111699=             :Z_TIME,'
      '1102111700=             :G_CLIENT,'
      '1102111701=             :OSNOVANIE,'
      '1102111702=             :NOTE,'
      '1102111703=             :CLIENT_NAME,'
      '1102111704=             :DETAILS_STR,'
      '1102111705=             :SUM_ZAKAZ,'
      '1102111706=             :IS_SPISANIE,'
      '1102111707=             :WAYBILL'
      '1102111708=      DO'
      '1102111709=        suspend;'
      '1102111710=  END'
      '1102111711=end'
      '1102111712=;'
      '1102111713='
      '1102111714=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1102111715=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102111716=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102111717=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102111718=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102111719=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102111720=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102111721=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102111722=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102111723=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102111724=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102111725=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102111726=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102111727=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102111728=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102111729=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102111730=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102111731=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102111732=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102111733=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102111734=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102111735=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102111736=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      
        '1102111737=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102111738=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102111739=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL)'
      '1102111740=RETURNS ('
      '1102111741=  ERR_CODE INTEGER,'
      '1102111742=  ERR_MSG VARCHAR(1024))'
      '1102111743=AS'
      '1102111744=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1102111745='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1102111746=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1102111747=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1102111748='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1102111749='
      
        '1102111750=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102111751=*/'
      
        '1102111752=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1102111753=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102111754=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102111755=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1102111756=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1102111757=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1102111758=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1102111759=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1102111760=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1102111761=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102111762=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      '1102111763=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1102111764=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102111765=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1102111766=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      
        '1102111767=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102111768=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1102111769=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102111770=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;' +
        ' /* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '1102111771=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '1102111772=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '1102111773=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1102111774=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102111775=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102111776=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1102111777=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1102111778=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102111779=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102111780=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1102111781=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1102111782=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1102111783=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102111784=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1102111785=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1102111786=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102111787=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102111788=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1102111789=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102111790=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1102111791=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1102111792=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1102111793=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1102111794=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102111795=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1102111796=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1102111797=BEGIN'
      '1102111798='
      '1102111799=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102111800=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102111801=      SELECT Z.G_PAYMENT_TYPE,'
      '1102111802=             Z.G_TOCHKA,'
      '1102111803=             Z.SUMM,'
      '1102111804=             Z.SUMM_BONUS,'
      '1102111805=             Z.SUMM_BONUS_GOT,'
      '1102111806=             z.g_client,'
      '1102111807=             Z.G_OFFICIAL,'
      '1102111808=             G.DO_NOT_SALES_COMM,'
      '1102111809=             G.FM||'#39' '#39'||G.NM'
      
        '1102111810=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1102111811=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102111812=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1102111813=             :G_TOCHKA_,'
      '1102111814=             :SUMM_OLD_,'
      '1102111815=             :SUMM_BONUS_OLD_,'
      '1102111816=             :SUMM_BONUS_GOT_OLD_,'
      '1102111817=             :g_client_old_,'
      '1102111818=             :G_OFFICIAL_,'
      '1102111819=             :DO_NOT_SALES_COMM_,'
      '1102111820=             :OFFICIAL_NAME_;'
      '1102111821='
      
        '1102111822=      -- 07.09.2021 '#1055#1054#1050#1040' '#1059#1041#1056#1040#1051' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059', '#1041#1059#1044#1059#1058' '#1054#1058#1063#1045#1058#1067' '#1044#1045#1056#1043#1040#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047
      
        '1102111823=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1102111824=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1102111825=        SELECT SUM(ZD.SALES_COMM)'
      '1102111826=          FROM ZAKAZ_DETAILS ZD'
      '1102111827=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102111828=          INTO :SALES_COMM_OLD_;'
      '1102111829=      */'
      '1102111830='
      '1102111831=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1102111832=      PNT_ = '#39'02'#39';'
      
        '1102111833=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102111834=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102111835=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102111836=        EXIT;'
      '1102111837=      END'
      '1102111838='
      
        '1102111839=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102111840=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102111841=      ELSE'
      '1102111842=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102111843='
      '1102111844=      PNT_ = '#39'01'#39';'
      '1102111845=      UPDATE zakaz'
      '1102111846=      SET'
      '1102111847=       G_TOCHKA = :G_TOCHKA_,'
      '1102111848=       Z_DATE = :Z_DATE_,'
      '1102111849=       Z_TIME = :Z_TIME_,'
      '1102111850=       G_CLIENT = :G_CLIENT_,'
      '1102111851=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102111852=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102111853=       NOTE = COALESCE(:NOTE_, NOTE),'
      
        '1102111854=       DELIVERY_ADDRESS = COALESCE(:ADDRESS_, DELIVER' +
        'Y_ADDRESS),'
      '1102111855=       SUMM = :SUMM_,'
      '1102111856=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1102111857=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102111858=       ,BY_RECIPE = :BY_RECIPE_'
      '1102111859=       ,IS_RESERVE = :IS_RESERVE_'
      '1102111860=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1102111861=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1102111862=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1102111863=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1102111864=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1102111865=       ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102111866=      WHERE'
      '1102111867=        zakaz = :zakaz_;'
      '1102111868='
      
        '1102111869=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1102111870=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1102111871=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1102111872=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1102111873=          UPDATE G_DISCONT_CARD D'
      '1102111874=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1102111875=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1102111876=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1102111877='
      
        '1102111878=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1102111879=          SUMM_OLD_           = 0;'
      '1102111880=      END'
      '1102111881=      UPDATE G_DISCONT_CARD D'
      
        '1102111882=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1102111883=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1102111884=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1102111885='
      '1102111886=      PNT_ = '#39'03'#39';'
      '1102111887=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1102111888=                 T.G_PRODUCT,'
      '1102111889=                 T.AMOUNT,'
      '1102111890=                 T.SUMM,'
      '1102111891=                 G.SALES_COMM'
      '1102111892=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1102111893=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1102111894=      INTO :ZAKAZ_DETAILS_,'
      '1102111895=           :G_PRODUCT_,'
      '1102111896=           :Z_AMOUNT_,'
      '1102111897=           :DETAILS_SUMM_,'
      '1102111898=           :SALES_COMM_'
      '1102111899=      DO BEGIN'
      
        '1102111900=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102111901=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1102111902=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1102111903=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102111904=        END'
      '1102111905='
      
        '1102111906=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102111907=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1102111908=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102111909=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1102111910=          FROM ZAKAZ_DETAILS_TMP Z'
      '1102111911=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1102111912='
      '1102111913=        -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1102111914=        IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1102111915=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' ' +
        #1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1102111916=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN'
      '1102111917=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102111918=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1102111919=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102111920=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102111921=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102111922='
      '1102111923=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102111924=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102111925=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102111926=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :Z_AMOUNT_'
      '1102111927=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102111928=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102111929=        END'
      '1102111930=      END'
      '1102111931='
      '1102111932=      ----------------------------------------'
      
        '1102111933=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102111934=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1102111935=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1102111936=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102111937=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1102111938=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1102111939=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102111940=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102111941=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1102111942=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1102111943=                PNT_ = '#39'04'#39';'
      
        '1102111944=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1102111945=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1102111946=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102111947=                ELSE'
      
        '1102111948=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102111949='
      
        '1102111950=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1102111951=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102111952='
      
        '1102111953=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102111954='
      '1102111955=                PNT_ = '#39'05'#39';'
      
        '1102111956=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN BEGIN'
      
        '1102111957=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1102111958=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1102111959=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1102111960=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1102111961=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1102111962=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1102111963=                                                  NUL' +
        'L,'
      
        '1102111964=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1102111965=                                                  :G_' +
        'TOCHKA_,'
      
        '1102111966=                                                  :UP' +
        'LOAD_TO_EXT_APP_'
      
        '1102111967=                                                  ) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102111968='
      
        '1102111969=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102111970=                END ELSE BEGIN'
      
        '1102111971=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102111972=                    SELECT 1'
      '1102111973=                      FROM KASSA K'
      '1102111974=                     WHERE K.KASSA = :KASSA_'
      '1102111975=                    UNION ALL'
      '1102111976=                    SELECT 2'
      '1102111977=                      FROM KASSA_BEZNAL KB'
      '1102111978=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102111979=                     INTO :PAYMENT_TYPE_OLD_;'
      '1102111980='
      '1102111981=                    PNT_ = '#39'06'#39';'
      
        '1102111982=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
        'YPE_) THEN'
      
        '1102111983=                        EXECUTE PROCEDURE K_UPD_KASSA' +
        '(:KASSA_,'
      
        '1102111984=                                                     ' +
        ' 0,     -- ACTION_'
      
        '1102111985=                                                     ' +
        ' 1,     --:G_PRIHOD_RASHOD_,'
      
        '1102111986=                                                     ' +
        ' :PAYMENT_SUMM_,'
      
        '1102111987=                                                     ' +
        ' :PAYMENT_DATE_,'
      
        '1102111988=                                                     ' +
        ' NULL,   --NOTE_'
      
        '1102111989=                                                     ' +
        ' :ZAKAZ_,'
      
        '1102111990=                                                     ' +
        ' NULL,'
      
        '1102111991=                                                     ' +
        ' :PAYMENT_TYPE_,'
      
        '1102111992=                                                     ' +
        ' :UPLOAD_TO_EXT_APP_'
      
        '1102111993=                                                     ' +
        ' ) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '1102111994=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' ' +
        #1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102111995=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' ' +
        #1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102111996=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1102111997=                        PNT_ = '#39'07'#39';'
      
        '1102111998=                        EXECUTE PROCEDURE K_DEL_KASSA' +
        '(:KASSA_, :PAYMENT_TYPE_OLD_,:UPLOAD_TO_EXT_APP_) RETURNING_VALU' +
        'ES (:ERR_CODE, :ERR_MSG);'
      
        '1102111999=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1102112000=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1102112001=                          EXIT;'
      '1102112002=                        END'
      '1102112003='
      '1102112004=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '1102112005=                           EXECUTE PROCEDURE K_INS_KA' +
        'SSA(0,     -- ACTION_ => :ACTION_'
      
