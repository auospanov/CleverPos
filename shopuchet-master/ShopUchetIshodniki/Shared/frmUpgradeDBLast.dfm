      '110235536=  SUMM_RASHOD_ALL_ = SUMM_RASHOD_ALL_ + SUMM_RASHOD_;'
      '110235537='
      '110235538=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '110235539=  VALUES(27, 1);'
      '110235540='
      
        '110235541=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110235542=  VALUES (28, 1, '#39#1054#1073#1097#1072#1103' '#1089#1091#1084#1084#1072' '#1087#1088#1086#1076#1072#1078#39', :SUMM_SALES_ALL' +
        '_);'
      '110235543='
      
        '110235544=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110235545=  VALUES (29, 1, '#39#1042#1099#1088#1091#1095#1082#1072' ('#1087#1088#1086#1076#1072#1078#1080' '#1089' '#1091#1095#1077#1090#1086#1084' '#1074#1086#1079#1074#1088#1072#1090#1086#1074')' +
        #39', :SUMM_SALES_ALL_ - :SUMM_RETURNS_ALL_);'
      '110235546='
      '110235547=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '110235548=  VALUES(30, 1);'
      '110235549='
      
        '110235550=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110235551=  VALUES (31, 1, '#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' '#1085#1072' '#1089#1091#1084#1084#1091#39',' +
        ' :SUMM_PRIHOD_ALL_);'
      '110235552='
      
        '110235553=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110235554=  VALUES (32, 1, '#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1085#1072' '#1089#1091#1084#1084#1091#39', :SUMM' +
        '_RASHOD_ALL_);'
      '110235555='
      '110235556=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '110235557=  VALUES(33, 1);'
      '110235558='
      
        '110235559=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110235560=  VALUES (34, 1, '#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' ('#1073#1077#1079#1085#1072#1083'.) ' +
        #1085#1072' '#1089#1091#1084#1084#1091#39', :SUMM_PRIHOD_ALL_BEZNAL_);'
      '110235561='
      
        '110235562=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110235563=  VALUES (35, 1, '#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' ('#1073#1077#1079#1085#1072#1083'.) '#1085#1072' '#1089#1091#1084 +
        #1084#1091#39', :SUMM_RASHOD_ALL_BEZNAL_);'
      '110235564='
      
        '110235565=  OUT_SUMM_ = IN_SUMM_ + SUMM_PRIHOD_ALL_ - SUMM_RASHO' +
        'D_ALL_;'
      
        '110235566=  OUT_SUMM_NONCASH_ = IN_SUMM_NONCASH_ + SUMM_PRIHOD_A' +
        'LL_BEZNAL_ - SUMM_RASHOD_ALL_BEZNAL_;'
      '110235567='
      '110235568=  FOR SELECT SORT_COL'
      '110235569=            ,ROW_COL'
      '110235570=            ,Z_DATE'
      '110235571=            ,Z_DATE_STR'
      '110235572=            ,ARTICUL'
      '110235573=            ,BARCODE'
      '110235574=            ,NAME'
      '110235575=            ,AMOUNT'
      '110235576=            ,SUMM'
      '110235577=        FROM P_REP_KASSIR_TABLE'
      '110235578=    ORDER BY 1, 3, 7'
      '110235579=    INTO :SORT_COL,'
      '110235580=        :ROWCOL,'
      '110235581=        :Z_DATE_LOC,'
      '110235582=        :Z_DATE,'
      '110235583=        :ARTICUL,'
      '110235584=        :BARCODE,'
      '110235585=        :NAME,'
      '110235586=        :AMOUNT,'
      '110235587=        :SUMM'
      '110235588=  DO'
      '110235589=    suspend;'
      '110235590=end'
      '110235591=;'
      '110235592='
      '110235593=ALTER PROCEDURE SYNC_DOWNLOAD('
      '110235594=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110235595=RETURNS ('
      '110235596=  ERR_CODE INTEGER,'
      '110235597=  ERR_MSG VARCHAR(1024),'
      '110235598=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '110235599=AS'
      '110235600=/*'
      '110235601='#1060#1048#1053#1040#1051' 07.02.2019'
      '110235602=*/'
      '110235603=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '110235604=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
      '110235605=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '110235606=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '110235607=DECLARE VARIABLE POS_ INTEGER = 0;'
      '110235608=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '110235609=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110235610=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '110235611=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGME' +
        'NT SIZE 80 = '#39#39';'
      
        '110235612=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110235613=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110235614=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      
        '110235615=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT;'
      
        '110235616=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT_RESERVE;'
      
        '110235617=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110235618=DECLARE VARIABLE ACTION_DATE_MIN_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE = CURRENT_DATE;'
      
        '110235619=DECLARE VARIABLE ACTION_DATE_MIN_OLD_ TYPE OF COLUMN K' +
        'ASSA.ACTION_DATE = CURRENT_DATE;'
      
        '110235620=DECLARE VARIABLE CREDIT_ TYPE OF COLUMN KASSA_STATE.CR' +
        'EDIT;'
      
        '110235621=DECLARE VARIABLE DEBET_ TYPE OF COLUMN KASSA_STATE.DEB' +
        'ET;'
      '110235622=DECLARE VARIABLE RECALC_STR_ VARCHAR(1024) = '#39#39';'
      '110235623=DECLARE VARIABLE STR_ VARCHAR(1024);'
      '110235624=DECLARE VARIABLE TABLE_ TYPE OF COLUMN LOGS.TTABLE;'
      '110235625=DECLARE VARIABLE TABLE_INT_ INTEGER;'
      '110235626=DECLARE VARIABLE OPER_ INTEGER;'
      '110235627=DECLARE VARIABLE PNT_ VARCHAR(10);'
      '110235628=BEGIN'
      '110235629=  ERR_CODE = 0;'
      '110235630=  ERR_MSG = '#39#39';'
      '110235631=  ERR_BODY = '#39#39';'
      '110235632='
      '110235633=  FOR SELECT L.ID,'
      '110235634=             L.SQLSTMT,'
      '110235635=             L.TTABLE'
      '110235636=        FROM LOGS L'
      '110235637=       WHERE L.USR = '#39'REPLICAT'#39
      '110235638=         AND L.DAT IS NULL'
      '110235639=         AND L.IS_TRANSFERED = 0'
      
        '110235640=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        ') = 0'
      '110235641=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) = 0'
      
        '110235642=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) = ' +
        '0'
      
        '110235643=         AND POSITION('#39'EXECUTE PROCEDURE K_RECALC_KASS' +
        'A'#39' IN L.SQLSTMT) = 0'
      '110235644=        ORDER BY L.ID_ORIGINAL'
      '110235645=        INTO :LOGS_ID_,'
      '110235646=             :SQL_,'
      '110235647=             :TABLE_'
      '110235648=  DO BEGIN'
      '110235649=    BEGIN'
      '110235650=        SQLCODE_ = 0;'
      '110235651='
      '110235652=        EXECUTE STATEMENT SQL_;'
      '110235653='
      
        '110235654=        /*IF (UPLOAD_TO_EXT_APP_ = 1 AND TABLE_ IN ('#39'G' +
        '_PRODUCT'#39', '#39'ZAKAZ'#39', '#39'SKLAD_PARENT'#39', '#39'G_TOCHKA'#39')) THEN BEGIN'
      '110235655=           IF (TABLE_ = '#39'ZAKAZ'#39') THEN'
      '110235656=             TABLE_INT_ = 1;'
      '110235657=           ELSE IF (TABLE_ = '#39'SKLAD_PARENT'#39') THEN'
      '110235658=             TABLE_INT_ = 2;'
      '110235659=           ELSE IF (TABLE_ = '#39'G_TOCHKA'#39') THEN'
      '110235660=             TABLE_INT_ = 3;'
      '110235661=           ELSE IF (TABLE_ = '#39'G_PRODUCT'#39') THEN'
      '110235662=             TABLE_INT_ = 4;'
      '110235663='
      '110235664=           IF (POSITION('#39'INSERT'#39' IN SQL_) > 0) THEN'
      '110235665=             OPER_ = 1;'
      
        '110235666=           ELSE IF (POSITION('#39'UPDATE'#39' IN SQL_) > 0) TH' +
        'EN'
      '110235667=             OPER_ = 2;'
      
        '110235668=           ELSE IF (POSITION('#39'DELETE'#39' IN SQL_) > 0) TH' +
        'EN'
      '110235669=             OPER_ = 3;'
      '110235670='
      
        '110235671=           INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJ' +
        'ECT_TYPE, ID, OPER)'
      
        '110235672=             VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), :TAB' +
        'LE_INT_, 111, :OPER_);'
      '110235673=        END*/'
      '110235674='
      '110235675=    WHEN ANY DO'
      '110235676=        BEGIN'
      '110235677=            SQLCODE_ = GDSCODE;'
      '110235678=            IF (ERR_BODY = '#39#39') THEN'
      
        '110235679=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085#1080 +
        #1081'.'#39';'
      '110235680=            ERR_BODY = ERR_BODY ||'#39
      '110235681='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110235682=        END'
      '110235683=    END'
      '110235684='
      
        '110235685=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110235686=    UPDATE LOGS L'
      
        '110235687=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110235688=           L.ERR_CODE = :SQLCODE_'
      '110235689=     WHERE L.ID = :LOGS_ID_;'
      '110235690=  END'
      '110235691='
      '110235692=  POS_ = 0;'
      '110235693=  FOR SELECT L.ID,'
      '110235694=             L.SQLSTMT,'
      '110235695=             L.DAT,'
      '110235696=             L.RR'
      '110235697=        FROM LOGS L'
      '110235698=       WHERE L.USR = '#39'REPLICAT'#39
      '110235699=         AND L.DAT IS NOT NULL'
      '110235700=         AND L.IS_TRANSFERED = 0'
      '110235701=        ORDER BY L.ID_ORIGINAL'
      '110235702=        INTO :LOGS_ID_,'
      '110235703=             :SQL_,'
      '110235704=             :DAT_,'
      '110235705=             :IDX_'
      '110235706=  DO BEGIN'
      '110235707=    POS_ = POSITION('#39'.'#39', SQL_);'
      '110235708=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '110235709=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR PO' +
        'S_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_ ' +
        '- 1)||'#39' = :DAT_'#39'||'
      
        '110235710=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ + ' +
        '1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '110235711='
      '110235712=    BEGIN'
      '110235713=        SQLCODE_ = 0;'
      '110235714=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '110235715=    WHEN ANY DO'
      '110235716=        BEGIN'
      '110235717=            SQLCODE_ = GDSCODE;'
      '110235718=            ERR_BODY = ERR_BODY ||'#39
      '110235719='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110235720=        END'
      '110235721=    END'
      '110235722='
      
        '110235723=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110235724='
      '110235725=    UPDATE LOGS L'
      
        '110235726=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110235727=           L.ERR_CODE = :SQLCODE_'
      '110235728=     WHERE L.ID = :LOGS_ID_;'
      '110235729=  END'
      '110235730='
      
        '110235731=  --==================================================' +
        '==================='
      '110235732=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      
        '110235733=  -- '#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054' '#1054#1058#1044#1045#1051 +
        #1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048#1042' '#1057#1054#1041#1048#1056#1040#1058#1068'?'
      
        '110235734=  --==================================================' +
        '==================='
      '110235735=  FOR SELECT MAX(L.ID) ID,'
      '110235736=             L.SQLSTMT'
      '110235737=        FROM LOGS L'
      '110235738=       WHERE L.USR = '#39'REPLICAT'#39
      '110235739=         AND L.DAT IS NULL'
      '110235740=         AND L.IS_TRANSFERED = 0'
      
        '110235741=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        ') > 0'
      '110235742=       GROUP BY L.SQLSTMT'
      '110235743=        INTO :LOGS_ID_,'
      '110235744=             :SQL_'
      '110235745=  DO BEGIN'
      '110235746=    SQLCODE_ = 0;'
      '110235747=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110235748=    POS1_ = POSITION('#39'-'#39' IN SQL_);'
      '110235749='
      
        '110235750=    G_PRODUCT_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR' +
        ' POS1_ - POS_ - 1) AS BIGINT);'
      
        '110235751=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 FOR' +
        ' CHAR_LENGTH(SQL_)) AS BIGINT);'
      '110235752='
      '110235753=    BEGIN'
      '110235754=        select ('
      '110235755=               -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '110235756=               (select COALESCE(sum(s.amount), 0) from' +
        ' sklad s, sklad_parent sp'
      '110235757=                where sp.SKLAD = s.SKLAD_PARENT'
      '110235758=                  and sp.G_TOCHKA = :G_TOCHKA_'
      '110235759=                  and s.g_product = :G_PRODUCT_'
      
        '110235760=                  and sp.IS_EXPECTED = 0)   -- '#1085#1077' '#1073#1077#1088#1091 +
        ' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '110235761='
      '110235762=               -'
      '110235763=               -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110235764=               (select COALESCE(sum(zr.AMOUNT_ALL), 0)' +
        ' from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110235765=                where zr.g_product = :G_PRODUCT_ and Z' +
        'rp.G_TOCHKA = :G_TOCHKA_'
      
        '110235766=                and zr.ZAKAZ_REAL_PARENT = zrp.ZAKAZ_R' +
        'EAL_PARENT)'
      '110235767='
      '110235768=               -'
      '110235769=               -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '110235770=               (select COALESCE(sum(zd.amount), 0) fro' +
        'm zakaz_details zd, zakaz z'
      
        '110235771=                where zd.g_product = :G_PRODUCT_ and Z' +
        '.G_TOCHKA = :G_TOCHKA_'
      '110235772=                and zd.zakaz = z.zakaz'
      
        '110235773=                and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099#1095#1080#1090#1072 +
        #1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076#1077#1090' '#1085 +
        #1080#1078#1077
      
        '110235774=                and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072 +
        #1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095 +
        #1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110235775=                and not (z.IS_SPISANIE = 0 and z.NOT_M' +
        'INUS_OSTATOK = 1)'
      '110235776=               )'
      '110235777='
      '110235778=               -'
      '110235779=               -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '110235780=               (select COALESCE(sum(s.amount), 0) from' +
        ' sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = 3'
      '110235781=                and S.g_client = :G_TOCHKA_)'
      '110235782='
      '110235783=               -'
      '110235784=               -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '110235785=               (select COALESCE(sum(od.amount), 0) fro' +
        'm other_details od, other o'
      
        '110235786=                where od.g_product = :G_PRODUCT_ and o' +
        '.G_TOCHKA = :G_TOCHKA_'
      '110235787=                and od.other = o.other)'
      '110235788=               ) amount,'
      '110235789='
      
        '110235790=               (SELECT COALESCE(sum(ZD.amount), 0) FRO' +
        'M ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '110235791=                 WHERE Z.G_TOCHKA = :G_TOCHKA_ AND Z.I' +
        'S_RESERVE = 1'
      
        '110235792=                   AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G_PRO' +
        'DUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '110235793=        from rdb$database'
      '110235794=        INTO :AMOUNT_,'
      '110235795=             :AMOUNT_RESERVE_;'
      '110235796='
      '110235797=        MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '110235798=        USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G_TOC' +
        'HKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '110235799=        ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_TOCHK' +
        'A = CD.G_TOCHKA)'
      '110235800=        WHEN MATCHED THEN'
      
        '110235801=            UPDATE SET LT.AMOUNT = :AMOUNT_, LT.AMOUNT' +
        '_RESERVE = :AMOUNT_RESERVE_'
      '110235802=        WHEN NOT MATCHED THEN'
      
        '110235803=            INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, AMOUN' +
        'T, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110235804=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,  1), ' +
        ':G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '110235805=    WHEN ANY DO'
      '110235806=        BEGIN'
      '110235807=            SQLCODE_ = GDSCODE;'
      '110235808=            IF (ERR_BODY = '#39#39') THEN'
      
        '110235809=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086#1074 +
        '.'#39';'
      '110235810=            ERR_BODY = ERR_BODY ||'#39
      '110235811=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110235812=        END'
      '110235813=    END'
      '110235814='
      '110235815=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110235816=    UPDATE LOGS L'
      
        '110235817=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110235818=           L.ERR_CODE = :SQLCODE_'
      '110235819=     WHERE L.SQLSTMT = :SQL_'
      '110235820=       AND L.USR = '#39'REPLICAT'#39
      '110235821=       AND L.DAT IS NULL'
      '110235822=       AND L.IS_TRANSFERED = 0;'
      '110235823=  END'
      '110235824='
      
        '110235825=  --==================================================' +
        '==================='
      '110235826=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1050#1040#1057#1057#1067
      
        '110235827=  -- '#1058#1059#1058' '#1053#1045#1052#1053#1054#1043#1054' '#1053#1040#1042#1054#1056#1054#1063#1045#1053#1053#1054' '#1055#1054#1051#1059#1063#1048#1051#1054#1057#1068', '#1052#1040#1057#1057#1048#1042#1054#1042' '#1058#1059#1058' ' +
        #1053#1045#1058', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1057#1053#1054#1042#1040' '#1042#1057#1045' '#1063#1045#1056#1045#1047' G_TOCHKA_OLD '#1044#1045#1051#1040#1058#1068
      
        '110235828=  --==================================================' +
        '==================='
      '110235829=  G_TOCHKA_OLD_ = 0;'
      '110235830=  FOR SELECT L.ID,'
      '110235831=             L.SQLSTMT'
      '110235832=        FROM LOGS L'
      '110235833=       WHERE L.USR = '#39'REPLICAT'#39
      '110235834=         AND L.DAT IS NULL'
      '110235835=         AND L.IS_TRANSFERED = 0'
      '110235836=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) > 0'
      '110235837=     ORDER BY L.SQLSTMT'
      '110235838=        INTO :LOGS_ID_,'
      '110235839=             :SQL_'
      '110235840=  DO BEGIN'
      '110235841=    SQLCODE_ = 0;'
      '110235842=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110235843=    POS1_ = POSITION('#39'~'#39' IN SQL_);'
      '110235844='
      
        '110235845=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR ' +
        'POS1_ - POS_ - 1) AS BIGINT);'
      
        '110235846=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 ' +
        'FOR CHAR_LENGTH(SQL_)) AS DATE);'
      
        '110235847=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACTI' +
        'ON_DATE_);'
      '110235848='
      '110235849=    SELECT SUM(K.SUMM)'
      '110235850=      FROM KASSA K'
      '110235851=     WHERE K."ACTION" = 0'
      '110235852=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110235853=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110235854=      INTO :CREDIT_;'
      '110235855=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '110235856='
      '110235857=    SELECT SUM(K.SUMM)'
      '110235858=      FROM KASSA K'
      '110235859=     WHERE K."ACTION" = 1'
      '110235860=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110235861=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110235862=      INTO :DEBET_;'
      '110235863=    DEBET_ = COALESCE(DEBET_, 0);'
      '110235864='
      '110235865=    PNT_ = '#39'03'#39';'
      '110235866=    BEGIN'
      '110235867=        MERGE INTO KASSA_STATE c'
      
        '110235868=        USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCH' +
        'KA_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE ' +
        'AND C.G_TOCHKA = CD.G_TOCHKA)'
      '110235869=        WHEN MATCHED THEN'
      '110235870=            UPDATE SET'
      '110235871=                C.DEBET  = :DEBET_,'
      '110235872=                C.CREDIT = :CREDIT_,'
      
        '110235873=                C."OUTPUT" = C."INPUT" - :DEBET_ + :CR' +
        'EDIT_'
      '110235874=        WHEN NOT MATCHED THEN'
      
        '110235875=            INSERT (KASSA_STATE, K_DATE, "INPUT", DEBE' +
        'T, CREDIT, "OUTPUT", G_TOCHKA)'
      '110235876=            VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110235877=                    :ACTION_DATE_,'
      
        '110235878=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110235879=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110235880=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0),'
      '110235881=                    :DEBET_,'
      '110235882=                    :CREDIT_,'
      
        '110235883=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110235884=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110235885=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0) - :DEBET_ + :CREDIT_,'
      '110235886=                   :G_TOCHKA_);'
      '110235887='
      '110235888=        PNT_ = '#39'04'#39';'
      
        '110235889=        IF (G_TOCHKA_OLD_ > 0 AND G_TOCHKA_OLD_ <> G_T' +
        'OCHKA_ AND ACTION_DATE_MIN_OLD_ < CURRENT_DATE) THEN BEGIN'
      
        '110235890=           EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DA' +
        'TE_MIN_OLD_, :G_TOCHKA_OLD_, 0)'
      '110235891=             RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110235892=        END'
      '110235893='
      '110235894=        G_TOCHKA_OLD_ = G_TOCHKA_;'
      '110235895=        ACTION_DATE_MIN_OLD_ = ACTION_DATE_MIN_;'
      '110235896=    WHEN ANY DO'
      '110235897=        BEGIN'
      '110235898=            SQLCODE_ = GDSCODE;'
      '110235899=            IF (ERR_BODY = '#39#39') THEN'
      
        '110235900=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1085#1072#1083#1080#1095#1085#1086 +
        #1081' '#1082#1072#1089#1089#1099'.'#39';'
      '110235901=            ERR_BODY = ERR_BODY ||'#39
      
        '110235902=PNT_ '#39'||PNT_||'#39'. ID_ '#39'||LOGS_ID_||'#39'. SQL_ '#39'||SQL_||'#39'. ' +
        #1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||GDSCODE;'
      '110235903=        END'
      '110235904=    END'
      '110235905='
      '110235906=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110235907=    UPDATE LOGS L'
      
        '110235908=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110235909=           L.ERR_CODE = :SQLCODE_'
      '110235910=     WHERE L.ID = :LOGS_ID_'
      '110235911=       AND L.USR = '#39'REPLICAT'#39
      '110235912=       AND L.DAT IS NULL'
      '110235913=       AND L.IS_TRANSFERED = 0;'
      '110235914='
      '110235915='
      '110235916=  END'
      '110235917='
      '110235918=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045#1058
      '110235919=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '110235920=      EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_MI' +
        'N_, :G_TOCHKA_, 0)'
      '110235921=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110235922=  END'
      '110235923='
      
        '110235924=  --==================================================' +
        '==================='
      '110235925=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071
      
        '110235926=  --==================================================' +
        '==================='
      '110235927=  ACTION_DATE_MIN_ = CURRENT_DATE;'
      '110235928=  FOR SELECT L.ID,'
      '110235929=             L.SQLSTMT'
      '110235930=        FROM LOGS L'
      '110235931=       WHERE L.USR = '#39'REPLICAT'#39
      '110235932=         AND L.DAT IS NULL'
      '110235933=         AND L.IS_TRANSFERED = 0'
      
        '110235934=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) > ' +
        '0'
      '110235935=        INTO :LOGS_ID_,'
      '110235936=             :SQL_'
      '110235937=  DO BEGIN'
      '110235938=    SQLCODE_ = 0;'
      '110235939=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110235940='
      
        '110235941=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1) ' +
        'AS DATE);'
      
        '110235942=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACTI' +
        'ON_DATE_);'
      '110235943='
      '110235944=    SELECT SUM(K.SUMM)'
      '110235945=      FROM KASSA_BEZNAL K'
      '110235946=     WHERE K."ACTION" = 0'
      '110235947=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110235948=      INTO :CREDIT_;'
      '110235949=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '110235950='
      '110235951=    SELECT SUM(K.SUMM)'
      '110235952=      FROM KASSA_BEZNAL K'
      '110235953=     WHERE K."ACTION" = 1'
      '110235954=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110235955=      INTO :DEBET_;'
      '110235956=    DEBET_ = COALESCE(DEBET_, 0);'
      '110235957='
      '110235958=    PNT_ = '#39'03'#39';'
      '110235959=    BEGIN'
      '110235960=        MERGE INTO KASSA_BEZNAL_STATE c'
      
        '110235961=        USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCH' +
        'KA_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE)'
      '110235962=        WHEN MATCHED THEN'
      '110235963=            UPDATE SET'
      '110235964=                C.DEBET  = :DEBET_,'
      '110235965=                C.CREDIT = :CREDIT_,'
      
        '110235966=                C."OUTPUT" = C."INPUT" - :DEBET_ + :CR' +
        'EDIT_'
      '110235967=        WHEN NOT MATCHED THEN'
      
        '110235968=            INSERT (KASSA_BEZNAL_STATE, K_DATE, "INPUT' +
        '", DEBET, CREDIT, "OUTPUT")'
      '110235969=            VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110235970=                    :ACTION_DATE_,'
      
        '110235971=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110235972=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110235973=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0),'
      '110235974=                    :DEBET_,'
      '110235975=                    :CREDIT_,'
      
        '110235976=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110235977=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110235978=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0) - :DEBET_ + :CREDIT_);'
      '110235979=    WHEN ANY DO'
      '110235980=        BEGIN'
      '110235981=            SQLCODE_ = GDSCODE;'
      '110235982=            IF (ERR_BODY = '#39#39') THEN'
      
        '110235983=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1073#1077#1079#1085#1072#1083#1080 +
        #1095#1085#1086#1081' '#1082#1072#1089#1089#1099'.'#39';'
      '110235984=            ERR_BODY = ERR_BODY ||'#39
      
        '110235985=PNT_ '#39'||PNT_||'#39'. ID_ '#39'||LOGS_ID_||'#39'. SQL_ '#39'||SQL_||'#39'. ' +
        #1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||GDSCODE;'
      '110235986=        END'
      '110235987=    END'
      '110235988='
      '110235989=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110235990=    UPDATE LOGS L'
      
        '110235991=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110235992=           L.ERR_CODE = :SQLCODE_'
      '110235993=     WHERE L.ID = :LOGS_ID_'
      '110235994=       AND L.USR = '#39'REPLICAT'#39
      '110235995=       AND L.DAT IS NULL'
      '110235996=       AND L.IS_TRANSFERED = 0;'
      '110235997='
      '110235998=  END'
      '110235999='
      
        '1102351000=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045 +
        #1058
      '1102351001=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '1102351002=    EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL(:ACTION_D' +
        'ATE_MIN_)'
      '1102351003=      RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102351004=  END'
      '1102351005='
      '1102351006=  /*'
      '1102351007=  POS_ = 1;'
      '1102351008=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '1102351009=    BEGIN'
      
        '1102351010=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ F' +
        'ROM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '1102351011='
      '1102351012=        WHILE (POS_ > 0) DO BEGIN'
      '1102351013=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '1102351014='
      '1102351015=            IF (POS_ > 0) THEN'
      
        '1102351016=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1' +
        ' FOR POS_ - 1);'
      '1102351017=            ELSE'
      '1102351018=              STR_ = PRODUCT_ID_ARR_;'
      '1102351019='
      
        '1102351020=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 F' +
        'OR POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '1102351021=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSI' +
        'TION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN ST' +
        'R_)) AS BIGINT);'
      '1102351022='
      
        '1102351023=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_' +
        'ARR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '1102351024='
      '1102351025=            select ('
      '1102351026=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102351027=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s, sklad_parent sp'
      '1102351028=                    where sp.SKLAD = s.SKLAD_PARENT'
      '1102351029=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '1102351030=                      and s.g_product = :G_PRODUCT_'
      
        '1102351031=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077 +
        ' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102351032='
      '1102351033=                   -'
      '1102351034=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102351035=                   (select COALESCE(sum(zr.AMOUNT_ALL' +
        '), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102351036=                    where zr.g_product = :G_PRODUCT_ ' +
        'and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102351037=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZA' +
        'KAZ_REAL_PARENT)'
      '1102351038='
      '1102351039=                   -'
      '1102351040=                   -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102351041=                   (select COALESCE(sum(zd.amount), 0' +
        ') from zakaz_details zd, zakaz z'
      
        '1102351042=                    where zd.g_product = :G_PRODUCT_ ' +
        'and Z.G_TOCHKA = :G_TOCHKA_'
      '1102351043=                    and zd.zakaz = z.zakaz'
      
        '1102351044=                    and z.IS_RESERVE = 0      -- '#1085#1077' '#1074 +
        #1099#1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081 +
        #1076#1077#1090' '#1085#1080#1078#1077
      
        '1102351045=                    and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095 +
        #1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' ' +
        #1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102351046=                    and not (z.IS_SPISANIE = 0 and z.' +
        'NOT_MINUS_OSTATOK = 1)'
      '1102351047=                   )'
      '1102351048='
      '1102351049=                   -'
      '1102351050=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102351051=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat =' +
        ' 3'
      '1102351052=                    and S.g_client = :G_TOCHKA_)'
      '1102351053='
      '1102351054=                   -'
      '1102351055=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102351056=                   (select COALESCE(sum(od.amount), 0' +
        ') from other_details od, other o'
      
        '1102351057=                    where od.g_product = :G_PRODUCT_ ' +
        'and o.G_TOCHKA = :G_TOCHKA_'
      '1102351058=                    and od.other = o.other)'
      '1102351059=                   ) amount,'
      '1102351060='
      
        '1102351061=                   (SELECT COALESCE(sum(ZD.amount), 0' +
        ') FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102351062=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AN' +
        'D Z.IS_RESERVE = 1'
      
        '1102351063=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.' +
        'G_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102351064=            from rdb$database'
      '1102351065=            INTO :AMOUNT_,'
      '1102351066=                 :AMOUNT_RESERVE_;'
      '1102351067='
      '1102351068=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102351069=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :' +
        'G_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102351070=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_' +
        'TOCHKA = CD.G_TOCHKA)'
      '1102351071=            WHEN MATCHED THEN'
      
        '1102351072=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.A' +
        'MOUNT_RESERVE = :AMOUNT_RESERVE_'
      '1102351073=            WHEN NOT MATCHED THEN'
      
        '1102351074=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, ' +
        'AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102351075=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, ' +
        ' 1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102351076=        END'
      '1102351077=    WHEN ANY DO'
      '1102351078=        BEGIN'
      '1102351079=            SQLCODE_ = GDSCODE;'
      '1102351080=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102351081=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102351082=            ERR_BODY = ERR_BODY ||'#39
      
        '1102351083=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102351084=        END'
      '1102351085=    END'
      '1102351086=  END'
      '1102351087='
      '1102351088=  */'
      '1102351089=END'
      '1102351090=;'
