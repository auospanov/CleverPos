      '110243582=         IS_TIS_TYPE,'
      '110243583=         POS_TERMINAL_TYPE'
      '110243584=    FROM G_NONCASH_PAY_TYPE'
      '110243585=  WHERE (G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_)'
      '110243586=  INTO :NAME_,'
      '110243587=       :IS_ACTIVE_,'
      '110243588=       :IS_TIS_TYPE_,'
      '110243589=       :POS_TERMINAL_TYPE_;'
