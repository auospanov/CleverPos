      '11013533=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '11013534=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '11013535=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMER' +
        'IC(15,2),'
      
        '11013536=  SUMM_PAY_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */' +
        ' NUMERIC(15,2),'
      
        '11013537=  SUMM_GOT_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GO' +
        'T */ NUMERIC(15,2),'
      
