        '110246302=  VES_GRAMM_PRICE /* TYPE OF COLUMN G_PRODUCT.VES_GRAM' +
        'M_PRICE */ NUMERIC(15,2))'
      '110246303=AS'
      '110246304=BEGIN'
      '110246305=  SUSPEND;'
      '110246306=END'
      '110246307=;'
      '110246308='
      '110246309='
      
        '110246310=/*****************************************************' +
        '*************************/'
      
        '110246311=/****                           Altering tables       ' +
        '                     ****/'
      
        '110246312=/*****************************************************' +
        '*************************/'
      '110246313='
      '110246314=ALTER TABLE SKLAD ALTER COLUMN MARK_CODE'
      '110246315=  TYPE DM_VARCHAR_250;'
      '110246316='
      '110246317=ALTER TABLE SKLAD_TMP ALTER COLUMN MARK_CODE'
      '110246318=  TYPE DM_VARCHAR_250;'
      '110246319='
      '110246320=ALTER TABLE ZAKAZ_DETAILS ALTER COLUMN MARK_CODE'
      '110246321=  TYPE DM_VARCHAR_250;'
      '110246322='
      '110246323=ALTER TABLE ZAKAZ_DETAILS_TMP ALTER COLUMN MARK_CODE'
      '110246324=  TYPE DM_VARCHAR_250;'
      '110246325='
      '110246326='
      
        '110246327=/*****************************************************' +
        '*************************/'
      
        '110246328=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110246329=/*****************************************************' +
        '*************************/'
      '110246330='
      '110246331=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '110246332=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110246333=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110246334=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110246335=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110246336=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110246337=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110246338=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110246339=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110246340=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110246341=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110246342=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110246343=  IS_SPISANIE_ INTEGER,'
      '110246344=  NEW_LINE_SALE_ INTEGER = 0,'
      '110246345=  MODE_ INTEGER = 0,'
      '110246346=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '110246347=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      
        '110246348=  MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE = ' +
        #39#39','
      
        '110246349=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE = 0,'
      '110246350=  NOT_MINUS_OSTATOK_ SMALLINT = 0)'
      '110246351=RETURNS ('
      
        '110246352=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110246353=  ERR_CODE INTEGER,'
      '110246354=  ERR_MSG VARCHAR(1024))'
      '110246355=AS'
      '110246356=/*'
      
        '110246357=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048 +
        #1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '110246358=*/'
      
        '110246359=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39';'
      '110246360=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '110246361=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110246362=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      
        '110246363=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110246364=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110246365=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110246366=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110246367=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110246368=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110246369=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '110246370=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110246371=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' */'
      
        '110246372=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' ' +
        #1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '110246373=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110246374=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '110246375=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '110246376=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUMN' +
        ' G_PRODUCT.G_PRODUCT;'
      '110246377=BEGIN'
      '110246378=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '110246379='
      
        '110246380=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110246381=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110246382=    FROM ZAKAZ_DETAILS_TMP T'
      '110246383=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110246384=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110246385=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110246386='
      
        '110246387=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110246388=           ,G.IS_KIT'
      '110246389=           ,K.AMOUNT * :AMOUNT_'
      '110246390=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110246391=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      '110246392=           ,(CASE'
      
        '110246393=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE' +
        '_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * ' +
        'FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '110246394=             ELSE K.PRICE'
      '110246395=           END) COST_PRICE'
      
        '110246396=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_L' +
        'AST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '110246397=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE ' +
        'G_PRODUCT = :G_PRODUCT_) CNT'
      
        '110246398=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110246399=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110246400=       AND G.IS_KIT = 1'
      '110246401=    UNION'
      
        '110246402=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110246403=           ,G.IS_KIT'
      '110246404=           ,:AMOUNT_'
      '110246405=           ,:PRICE_'
      '110246406=           ,0'
      '110246407=           ,:COST_PRICE_'
      '110246408=           ,0'
      '110246409=      FROM G_PRODUCT G'
      '110246410=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110246411=       AND G.IS_KIT <> 1'
      '110246412=      INTO :G_PRODUCT_'
      '110246413=           ,:IS_KIT_'
      '110246414=           ,:AMOUNT_'
      '110246415=           ,:PRICE__'
      '110246416=           ,:SOSTAV_PRICE_'
      '110246417=           ,:COST_PRICE__'
      '110246418=           ,:SOSTAV_COUNT_'
      '110246419=  DO BEGIN'
      '110246420=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110246421='
      
        '110246422=      --==============================================' +
        '============='
      '110246423=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110246424=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110246425=        FROM LT_SKLAD_PRODUCT L'
      '110246426=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110246427=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110246428=       INTO :AMOUNT_CUR_;'
      '110246429='
      
        '110246430=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110246431=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110246432=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110246433=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051 +
        #1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068 +
        #1050#1054
      
        '110246434=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068 +
        ' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110246435=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110246436=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110246437=          SELECT SUM(AMOUNT)'
      '110246438=            FROM ZAKAZ_DETAILS T'
      '110246439=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110246440=             AND T.ZAKAZ = :ZAKAZ_'
      '110246441=            INTO :AMOUNT_OLD_;'
      '110246442=        ELSE'
      '110246443=          SELECT SUM(AMOUNT)'
      '110246444=            FROM SKLAD T'
      '110246445=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110246446=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110246447=            INTO :AMOUNT_OLD_;'
      '110246448=      END'
      '110246449='
      '110246450=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110246451=      SELECT SUM(AMOUNT)'
      '110246452=        FROM ZAKAZ_DETAILS_TMP T'
      '110246453=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110246454=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110246455='
      
        '110246456=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_, ' +
        '0) + :AMOUNT_;'
      '110246457=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '110246458='
      
        '110246459=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110246460='
      
        '110246461=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '110246462=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042 +
        #1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110246463=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) T' +
        'HEN BEGIN'
      '110246464=            PNT_ = '#39'01'#39';'
      
        '110246465=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FR' +
        'OM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      '110246466=                                         CURRENT_DATE,'
      '110246467=                                         :G_PRODUCT_,'
      
        '110246468=                                         ABS(AMOUNT_CU' +
        'R_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUN' +
        'T_,'
      
        '110246469=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086 +
        ' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110246470=                                         )'
      
        '110246471=                RETURNING_VALUES :SKLAD_, :COST_PRICE_' +
        '_, :ERR_CODE, :ERR_MSG;'
      '110246472=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110246473=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110246474=              EXIT;'
      '110246475=            END'
      '110246476=        END'
      
        '110246477=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_PR' +
        'ODUCT_ <> -2 AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '110246478=            SELECT NAME'
      '110246479=            FROM G_PRODUCT'
      '110246480=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110246481=            INTO :PRODUCT_NAME_;'
      '110246482='
      '110246483=            ERR_CODE = -20500;'
      
        '110246484=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110246485=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110246486=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110246487=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110246488=            EXIT;'
      '110246489=        END'
      '110246490=      END'
      '110246491=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110246492=      --==============================================' +
        '============='
      '110246493='
      
        '110246494=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110246495=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110246496='
      '110246497=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '110246498=        --    PRICE__ = SOSTAV_PRICE_;'
      '110246499=        --END ELSE BEGIN'
      '110246500=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110246501=              PRICE__ = COST_PRICE__;'
      '110246502='
      
        '110246503=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110246504=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110246505='
      '110246506='
      
        '110246507=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110246508=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110246509=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110246510=            END'
      '110246511='
      
        '110246512=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110246513=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110246514=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110246515=        --END'
      '110246516=      END'
      '110246517='
      
        '110246518=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '110246519=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041#1048 +
        #1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '110246520=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_CODE' +
        '_) = 0) THEN'
      '110246521=          SELECT ZD.zakaz_details'
      '110246522=            FROM zakaz_details_tmp ZD'
      '110246523=           WHERE ZD.G_PRODUCT = :g_product_'
      '110246524=             AND ZD.PRICE = :PRICE__'
      '110246525=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110246526=            INTO :ZAKAZ_DTLS_TMP_;'
      '110246527='
      '110246528='
      '110246529=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN BEGIN'
      '110246530=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110246531=           SET P.amount = P.amount + :amount_'
      
        '110246532=               ,P.summ = ROUND((P.price - P.discount_T' +
        'ENGE) * (P.amount + :AMOUNT_), 2)  -- '#1086#1082#1088#1091#1075#1083#1103#1102' '#1076#1086' 2 '#1079#1085#1072#1082#1086#1074', '#1095#1090#1086#1073 +
        #1099' '#1087#1086#1090#1086#1084' '#1085#1077' '#1073#1099#1083#1086' '#1087#1088#1086#1073#1083#1077#1084' '#1087#1088#1080' '#1087#1077#1088#1077#1076#1072#1095#1077' '#1074' '#1060#1056
      
        '110246533=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110246534=               ,P.NDS = :NDS_'
      '110246535=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110246536=               ,P.VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '110246537=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110246538=        ZAKAZ_DETAILS_ = :ZAKAZ_DTLS_TMP_;'
      '110246539='
      '110246540=      END ELSE BEGIN'
      
        '110246541=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN ' +
        'BEGIN'
      '110246542=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_;'
      '110246543=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '110246544=          END'
      '110246545='
      '110246546=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110246547=          ('
      '110246548=           ZAKAZ_DETAILS,'
      '110246549=           ZAKAZ,'
      '110246550=           G_PRODUCT,'
      '110246551=           AMOUNT,'
      '110246552=           PRICE,'
      '110246553=           SUMM,'
      '110246554=           DISCOUNT_PERC,'
      '110246555=           DISCOUNT_TENGE,'
      '110246556=           DISCOUNT_SUMM,'
      '110246557=           NDS,'
      '110246558=           NDS_SUMM,'
      '110246559=           COST_PRICE,'
      '110246560=           MARK_CODE,'
      '110246561=           ORIGINAL_KIT_ID,'
      '110246562=           ORIGINAL_KIT_PRICE,'
      '110246563=           VES_GRAMM_PRICE'
      '110246564=          ) VALUES ('
      '110246565=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110246566=           :ZAKAZ_,'
      '110246567=           :G_PRODUCT_,'
      '110246568=           :AMOUNT_,'
      '110246569=           :PRICE__,'
      '110246570=           :SUMM_,'
      '110246571=           :DISCOUNT_PERC_,'
      '110246572=           :DISCOUNT_TENGE_,'
      '110246573=           :DISCOUNT_SUMM_,'
      '110246574=           :NDS_,'
      '110246575=           :NDS_SUMM_,'
      '110246576=           :COST_PRICE__,'
      '110246577=           :MARK_CODE_,'
      '110246578=           :ORIGINAL_KIT_ID_,'
      '110246579=           :ORIGINAL_KIT_PRICE_,'
      '110246580=           :VES_GRAMM_PRICE_'
      '110246581=          )'
      '110246582=          RETURNING'
      '110246583=            ZAKAZ_DETAILS'
      '110246584=          INTO'
      '110246585=            :ZAKAZ_DETAILS_;'
      '110246586=      END'
      '110246587=  END'
      '110246588=end'
      '110246589=;'
      '110246590='
      '110246591=ALTER PROCEDURE P_REP_BILL('
      '110246592=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110246593=  SUMM_DANO_ NUMERIC(15,2),'
      '110246594=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110246595=  CURRENCY_ INTEGER,'
      '110246596=  MODE_ INTEGER,'
      '110246597=  PRINT_SLOGAN_ VARCHAR(80),'
      '110246598=  DECIMAL_ INTEGER,'
      '110246599=  BONUS_ NUMERIC(15,2),'
      '110246600=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110246601=  BONUS_ALL_ NUMERIC(15,2) = 0)'
      '110246602=RETURNS ('
      '110246603=  FIRM_NAME_ VARCHAR(600),'
      '110246604=  IDN_STR_ VARCHAR(30),'
      '110246605=  FIRM_IDN_ VARCHAR(50),'
      '110246606=  FIRM_ADDRESS_ VARCHAR(550),'
      '110246607=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110246608=  DATE_ VARCHAR(100),'
      '110246609=  PAYMENT_TYPE_ VARCHAR(100),'
      '110246610=  G_CLIENT_NAME_ VARCHAR(300),'
      '110246611=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110246612=  SUMM_VSEGO_ VARCHAR(50),'
      '110246613=  SUMM_VSEGO_WITHOUT_SERVICE_ VARCHAR(50),'
      '110246614=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110246615=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110246616=  SUMM_NDS_ VARCHAR(50),'
      '110246617=  ROW_NUM INTEGER,'
      '110246618=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110246619=  NAME_ART VARCHAR(1000),'
      '110246620=  AMOUNT VARCHAR(50),'
      '110246621=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110246622=  PRICE VARCHAR(50),'
      '110246623=  PRICE_N VARCHAR(50),'
      '110246624=  SUMM VARCHAR(50),'
      '110246625=  SUMM_TXT VARCHAR(300),'
      '110246626=  DISCOUNT VARCHAR(300),'
      '110246627=  SUMM_N VARCHAR(50),'
      '110246628=  SUMM_POLUCH_ VARCHAR(50),'
      '110246629=  SUMM_NONCASH_ VARCHAR(50),'
      '110246630=  SUMM_BONUS_ VARCHAR(50),'
      '110246631=  SUMM_SDACH_ VARCHAR(50),'
      '110246632=  SUMM_STR_ VARCHAR(200),'
      '110246633=  SLOGAN_ VARCHAR(80),'
      '110246634=  SUMM_SKIDKA_ VARCHAR(50),'
      '110246635=  SUMM_SERVICE_ VARCHAR(50),'
