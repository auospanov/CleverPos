        'XT_APP_,'
      '110240823=                                          :G_OFFICIAL_'
      
        '110240824=                                          ) RETURNING_' +
        'VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '110240825=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '110240826=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047#1055 +
