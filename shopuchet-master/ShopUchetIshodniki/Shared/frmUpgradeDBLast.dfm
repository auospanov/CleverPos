        'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751379=        END'
      '110751380=      END'
      '110751381=  END'
      '110751382='
      '110751383=  -- '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1041#1045#1047#1053#1040#1051
      '110751384=  ELSE BEGIN'
