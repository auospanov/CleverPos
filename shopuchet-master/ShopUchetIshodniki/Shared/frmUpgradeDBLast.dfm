        '110215580=  NOTE /* TYPE OF COLUMN SKLAD_PARENT.NOTE */ VARCHAR(' +
        '200),'
      
        '110215581=  SUMM /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(' +
        '15,2),'
      
        '110215582=  SUMM_FACT /* TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT *' +
        '/ NUMERIC(15,2),'
      
        '110215583=  IS_PAYED_ALL /* TYPE OF COLUMN SKLAD_PARENT.IS_PAYED' +
        '_ALL */ INTEGER,'
      
        '110215584=  IS_VOZVRAT /* TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT' +
        ' */ INTEGER,'
      
        '110215585=  G_OFFICIAL /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      
        '110215586=  G_OFFICIAL_FIO /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC ' +
        '*/ VARCHAR(150),'
      
        '110215587=  G_NONCASH_PAY_TYPE /* TYPE OF COLUMN G_NONCASH_PAY_T' +
        'YPE.G_NONCASH_PAY_TYPE */ BIGINT,'
      
        '110215588=  G_NONCASH_PAY_TYPE_NAME /* TYPE OF COLUMN G_NONCASH_' +
        'PAY_TYPE.NAME */ VARCHAR(150))'
      '110215589=AS'
      '110215590=BEGIN'
      '110215591=  SUSPEND;'
      '110215592=END'
      '110215593=;'
      '110215594='
      '110215595='
      
        '110215596=/*****************************************************' +
        '*************************/'
      
        '110215597=/****                   Creating foreign key constrain' +
        'ts                   ****/'
      
        '110215598=/*****************************************************' +
        '*************************/'
      '110215599='
      '110215600=RECONNECT;'
      
        '110215601=UPDATE ZAKAZ Z SET Z.G_NONCASH_PAY_TYPE = NULL WHERE Z' +
        '.G_NONCASH_PAY_TYPE = 0; COMMIT WORK;'
      
        '110215602=ALTER TABLE SKLAD_PARENT ADD CONSTRAINT FK_SKLAD_PAREN' +
        'T_4 FOREIGN KEY (G_NONCASH_PAY_TYPE) REFERENCES G_NONCASH_PAY_TY' +
        'PE (G_NONCASH_PAY_TYPE);'
      '110215603='
      
        '110215604=ALTER TABLE ZAKAZ ADD CONSTRAINT FK_ZAKAZ_2 FOREIGN KE' +
        'Y (G_NONCASH_PAY_TYPE) REFERENCES G_NONCASH_PAY_TYPE (G_NONCASH_' +
        'PAY_TYPE);'
      '110215605='
      '110215606='
      
        '110215607=/*****************************************************' +
        '*************************/'
      
        '110215608=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110215609=/*****************************************************' +
        '*************************/'
      '110215610='
      '110215611=ALTER PROCEDURE INS_SKLAD_BASED_ON_ZAKAZ('
      '110215612=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '110215613=RETURNS ('
      '110215614=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110215615=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      
        '110215616=  G_NON_CASH_PAY_TYPE_ TYPE OF COLUMN ZAKAZ.G_NONCASH_' +
        'PAY_TYPE,'
      '110215617=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD,'
      
        '110215618=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PAY' +
        '_TRANSACTION_ID)'
      '110215619=AS'
      '110215620=BEGIN'
      '110215621='
      '110215622=  SELECT Z.G_PAYMENT_TYPE,'
      '110215623=         Z.G_NONCASH_PAY_TYPE,'
      '110215624=         Z.POS_PAY_METHOD,'
      '110215625=         Z.POS_PAY_TRANSACTION_ID,'
      '110215626=         Z.G_CLIENT'
      '110215627=    FROM ZAKAZ Z'
      '110215628=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110215629=    INTO :G_PAYMENT_TYPE_,'
      '110215630=         :G_NON_CASH_PAY_TYPE_,'
      '110215631=         :POS_PAY_METHOD_,'
      '110215632=         :POS_PAY_TRANSACTION_ID_,'
      '110215633=         :G_CLIENT_;'
      '110215634='
      '110215635=  insert into sklad_tmp'
      '110215636=  select GEN_ID(gen_details_tmp, 1),'
      '110215637=       zd.g_product,'
      '110215638=       zd.amount,'
      '110215639=       zd.price - zd.discount_tenge,'
      '110215640=       zd.summ,'
      '110215641=       zd.NDS, zd.NDS_SUMM, NULL, 0, 0, 0, 0, 0,0,0,'
      '110215642=       zd.mark_code,'
      '110215643=       zd.cost_price'
      '110215644=   from zakaz_details zd'
      '110215645=  where zd.zakaz = :ZAKAZ_;'
      '110215646=END'
      '110215647=;'
      '110215648='
      '110215649=ALTER PROCEDURE INS_ZAKAZ('
      '110215650=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110215651=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110215652=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110215653=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110215654=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110215655=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110215656=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110215657=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110215658=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110215659=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110215660=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110215661=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110215662=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110215663=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110215664=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110215665=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110215666=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110215667=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110215668=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110215669=  IS_MEBEL_ INTEGER = 0,'
      
        '110215670=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110215671=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      
        '110215672=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NUL' +
        'L,'
      '110215673=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '110215674=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110215675=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110215676=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110215677=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110215678=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110215679=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '110215680=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE = NULL,'
      
        '110215681=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD ' +
        '= NULL,'
      
        '110215682=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PAY' +
        '_TRANSACTION_ID = NULL)'
      '110215683=RETURNS ('
      '110215684=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110215685=  ERR_CODE INTEGER,'
      '110215686=  ERR_MSG VARCHAR(1024))'
      '110215687=AS'
      '110215688=/*'
      '110215689=IS_SPISANIE_'
      '110215690=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110215691=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110215692=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110215693=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110215694='
      '110215695='
      
        '110215696=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110215697=*/'
      '110215698=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110215699=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110215700=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110215701=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110215702=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110215703=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110215704=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110215705=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110215706=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110215707=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110215708=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110215709=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110215710=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110215711=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110215712=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '110215713=DECLARE VARIABLE CNT_ INTEGER;'
      '110215714=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110215715=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110215716=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110215717=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110215718=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110215719=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110215720=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110215721=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110215722=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110215723=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110215724=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110215725=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110215726=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110215727=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110215728=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110215729=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110215730=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      
        '110215731=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.MARK_CODE;'
      '110215732=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '110215733=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN L' +
        'OG_OPER.OPERATION;'
      
        '110215734=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '110215735=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110215736=BEGIN'
      '110215737='
      
        '110215738=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110215739=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110215740=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110215741=  IF (CNT_ = 0) THEN BEGIN'
      '110215742=    ERR_CODE = -20500;'
      
        '110215743=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110215744=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110215745=    EXIT;'
      '110215746=  END'
      '110215747='
      '110215748=  IF (G_TOCHKA_ IS NULL) THEN'
      '110215749=    SELECT ID'
      '110215750=      FROM CUR_PARAMS'
      '110215751=     WHERE CUR_PARAMS = 2'
      '110215752=      INTO :G_TOCHKA_;'
      '110215753='
      '110215754=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110215755=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110215756=      PNT_ = '#39'01'#39';'
      
        '110215757=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110215758=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110215759=      ELSE'
      '110215760=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110215761='
      '110215762=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110215763=      SELECT G.G_OFFICIAL,'
      '110215764=             G.DO_NOT_SALES_COMM,'
      '110215765=             G.FM||'#39' '#39'||G.NM'
      '110215766=        FROM G_OFFICIAL G'
      
        '110215767=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110215768=        INTO :G_OFFICIAL_,'
      '110215769=             :DO_NOT_SALES_COMM_,'
      '110215770=             :OFFICIAL_NAME_;'
      '110215771='
      '110215772=      INSERT INTO ZAKAZ'
      '110215773=      ('
      '110215774=       ZAKAZ,'
      '110215775=       G_TOCHKA,'
      '110215776=       Z_DATE,'
      '110215777=       Z_TIME,'
      '110215778=       G_CLIENT,'
      '110215779=       G_PAYMENT_TYPE,'
      '110215780=       OSNOVANIE,'
      '110215781=       IS_SPISANIE,'
      '110215782=       NOTE,'
      '110215783=       SUMM,'
      '110215784=       SUMM_FACT,'
      '110215785=       SUMM_BONUS,'
      '110215786=       IS_PAYED_ALL'
      '110215787=       ,G_OFFICIAL'
      '110215788=       ,BY_RECIPE'
      '110215789=       ,SUMM_BONUS_GOT'
      '110215790=       ,IS_RESERVE'
      '110215791=       ,SUMM_CASH'
      '110215792=       ,SUMM_NONCASH'
      '110215793=       ,NOT_MINUS_OSTATOK'
      '110215794=       ,DELIVERY_ADDRESS'
      '110215795=       ,REC_ID'
      '110215796=       ,G_NONCASH_PAY_TYPE'
      '110215797=       ,POS_PAY_METHOD'
      '110215798=       ,POS_PAY_TRANSACTION_ID'
      '110215799=      ) VALUES ('
      '110215800=       GEN_ID(GEN_ZAKAZ, 1),'
      '110215801=       :G_TOCHKA_,'
      '110215802=       :Z_DATE_,'
      '110215803=       :Z_TIME_,'
      '110215804=       :G_CLIENT_,'
      '110215805=       :G_PAYMENT_TYPE_,'
      '110215806=       :OSNOVANIE_,'
      '110215807=       :IS_SPISANIE_,'
      '110215808=       :NOTE_,'
      '110215809=       :SUMM_,'
      '110215810=       :SUMM_FACT_1_,'
      '110215811=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110215812=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110215813=       ,:G_OFFICIAL_'
      '110215814=       ,:BY_RECIPE_'
      '110215815=       ,:SUMM_BONUS_GOT_'
      '110215816=       ,:IS_RESERVE_'
      '110215817=       ,COALESCE(:SUMM_CASH_, 0)'
      '110215818=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110215819=       ,:NOT_MINUS_OSTATOK_'
      '110215820=       ,:ADDRESS_'
