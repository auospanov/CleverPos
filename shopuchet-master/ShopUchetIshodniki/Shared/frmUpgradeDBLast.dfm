      '110237233='
      '110237234=  -- '#1052#1045#1053#1071#1070' '#1050#1054#1052#1048#1057#1057#1048#1070' '#1055#1056#1054#1044#1040#1042#1062#1040
      '110237235=  IF (CHANGE_SALES_COMM_ = 1) THEN BEGIN'
      
        '110237236=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_) > 0) THEN'
      '110237237=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110237238='
      
        '110237239=    SQL_STR_ = SQL_STR_ ||'#39'P.SALES_COMM = '#39'||:NEW_SALE' +
        'S_COMM_;'
      '110237240=  END'
      '110237241='
      
        '110237242=  -- '#1052#1045#1053#1071#1070' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040' - '#1057' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1053#1040' '#1055#1056#1054#1044#1059#1050#1058' '#1048#1051#1048' '#1053 +
        #1040#1054#1041#1054#1056#1054#1058
      '110237243=  IF (CHANGE_KIT_TYPE_ > 1) THEN BEGIN'
      
        '110237244=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_ + CHANGE_SALES_COMM_) > 0) THEN'
      '110237245=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110237246='
      
        '110237247=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KIT = '#39'||:CHANGE_KIT_T' +
        'YPE_;'
      '110237248='
      
        '110237249=    -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1058#1048#1055' '#1058#1054#1042#1040#1056#1040' '#1057' "'#1057#1054#1057#1058#1040#1042#1053#1054#1049'" '#1053#1040' "'#1055#1056#1054#1044 +
        #1059#1050#1058'", '#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1053#1059#1051#1048#1058#1068' '#1042#1057#1045' '#1054#1057#1058#1040#1058#1050#1048' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042
      '110237250=    IF (CHANGE_KIT_TYPE_ = 2) THEN'
      '110237251=      UPDATE LT_SKLAD_PRODUCT P'
      '110237252=         SET P.AMOUNT = 0,'
      '110237253=             P.NEED_TO_EXPORT = 1'
      '110237254=       WHERE EXISTS (SELECT 1'
      '110237255=                       FROM G_PRODUCT GP'
      '110237256=                      WHERE GP.G_PRODUCT = P.G_PRODUCT'
      '110237257=                        AND GP.IS_KIT = 1'
      
        '110237258=                        AND ((:G_PRODUCT_ CONTAINING '#39 +
        '~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110237259=                             OR'
      
        '110237260=                             (GP.G_PRODUCT = GP.G_PROD' +
        'UCT AND :G_PRODUCT_ IS NULL)'
      '110237261=                            )'
      '110237262=                        AND ('
      
        '110237263=                             ((GP.G_PRODUCT_PAR IN (SE' +
