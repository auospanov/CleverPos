      '11024523=  SUMM_VSEGO_WITHOUT_SERVICE_ VARCHAR(50),'
      '11024524=  SUMM_VSEGO_N_ VARCHAR(50),'
      '11024525=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11024526=  SUMM_NDS_ VARCHAR(50),'
      '11024527=  ROW_NUM INTEGER,'
      '11024528=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11024529=  NAME_ART VARCHAR(1000),'
      '11024530=  AMOUNT VARCHAR(50),'
      '11024531=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11024532=  PRICE VARCHAR(50),'
      '11024533=  PRICE_N VARCHAR(50),'
      '11024534=  SUMM VARCHAR(50),'
      '11024535=  SUMM_TXT VARCHAR(300),'
      '11024536=  DISCOUNT VARCHAR(300),'
      '11024537=  SUMM_N VARCHAR(50),'
      '11024538=  SUMM_POLUCH_ VARCHAR(50),'
      '11024539=  SUMM_NONCASH_ VARCHAR(50),'
      '11024540=  SUMM_BONUS_ VARCHAR(50),'
      '11024541=  SUMM_SDACH_ VARCHAR(50),'
      '11024542=  SUMM_STR_ VARCHAR(200),'
      '11024543=  SLOGAN_ VARCHAR(80),'
      '11024544=  SUMM_SKIDKA_ VARCHAR(50),'
      '11024545=  SUMM_SERVICE_ VARCHAR(50),'
      '11024546=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11024547=  BONUS_STR_ VARCHAR(100),'
      '11024548=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '11024549=  ERR_CODE NUMERIC(15,2),'
      '11024550=  ERR_MSG VARCHAR(1024),'
      '11024551=  NAME_MARKER VARCHAR(1000),'
      '11024552=  BONUSALL_STR_ VARCHAR(100))'
      '11024553=AS'
      '11024554=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045
      '11024555='
      '11024556=26.09.2022'
      
        '11024557='#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1054#1041#1065#1040#1071' '#1057#1050#1048#1044#1050#1040' '#1042' '#1050#1054#1053#1062#1045' '#1063#1045#1050#1040', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053 +
        #1045#1059#1044#1054#1041#1053#1054', '#1053#1045#1055#1054#1053#1071#1058#1053#1054' '#1053#1040' '#1050#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1041#1067#1051#1040' '#1057#1050#1048#1044#1050#1040
      
        '11024558='#1058#1045#1055#1045#1056#1068' '#1046#1045' '#1057#1050#1048#1044#1050#1040' '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1055#1054#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1054#1042#1040#1056#1054#1052'. '#1048#1057#1061#1054#1044#1071' ' +
        #1048#1047' '#1069#1058#1054#1043#1054' '#1053#1045#1050#1054#1058#1054#1056#1067#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1067#1045' '#1059#1055#1056#1040#1047#1044#1053#1048#1051#1048#1057#1068
      '11024559='
      
        '11024560='#1058#1045#1055#1045#1056#1068' '#1057#1058#1056#1054#1050#1040' "'#1057#1059#1052#1052#1040'" '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1041#1067#1051#1054' '#1044#1054#1041#1040#1042 +
        #1051#1045#1053#1054' "'#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%"'
      '11024561='
      
        '11024562=SUMM_VSEGO_ - '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054#1050',' +
        ' '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '11024563=SUMM_VSEGO_WITHOUT_SERVICE_ - '#1058#1045#1055#1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053 +
        #1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '11024564='
      '11024565='
      
        '11024566=SUMM_POLUCH_  - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1054 +
        #1058' '#1050#1051#1048#1045#1053#1058#1040' '#1053#1040#1051#1048#1063#1053#1067#1052#1048' = SUMM_DANO_, '#1055#1056#1048#1061#1054#1044#1048#1058' '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040
      
        '11024567=SUMM_NONCASH_ - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1055 +
        #1054' '#1041#1045#1047#1053#1040#1051#1059
      '11024568=SUMM_BONUS_   - '#1057#1050#1054#1051#1068#1050#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1041#1054#1053#1059#1057#1040#1052#1048
      '11024569='
      
        '11024570=PAYMENT_TYPE_ - '#1059#1055#1056#1040#1047#1044#1053#1045#1053#1040', '#1058'.'#1050'. '#1057#1058#1056#1054#1050#1040' "'#1057#1055#1054#1057#1054#1041' '#1054#1055#1051#1040#1058#1067'"' +
        ' '#1059#1041#1056#1040#1053#1040', '#1058#1045#1055#1045#1056#1068' '#1042#1053#1048#1047#1059' '#1041#1059#1044#1045#1058' '#1044#1042#1045' '#1057#1058#1056#1054#1050#1048':'
      '11024571="'#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '11024572="'#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '11024573=*/'
      '11024574=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '11024575=DECLARE VARIABLE PNT_ VARCHAR(5) = '#39'00'#39';'
      '11024576=DECLARE VARIABLE I INTEGER = 1;'
      
        '11024577=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11024578=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11024579=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.AMOUNT;'
      
        '11024580=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.SUMM;'
      '11024581=BEGIN'
      '11024582=  SLOGAN_ = PRINT_SLOGAN_;'
      '11024583=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '11024584=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      '11024585=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_;'
      '11024586=  END'
      '11024587='
      '11024588=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '11024589=  SELECT z.ZAKAZ'
      '11024590=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '11024591=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR ' +
        'FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')|' +
        '|'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '11024592=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '11024593=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COALE' +
        'SCE(O.NM, '#39#39')'
      '11024594=         ,Z.NOTE'
      
        '11024595=         ,CAST(ROUND(Z.summ_noncash, 2) AS VARCHAR(100)' +
        ')'
      '11024596=         ,CAST(ROUND(:SUMM_DANO_, 2) AS VARCHAR(100))'
      '11024597=         ,CAST(ROUND(:SUMM_SDACHA_, 2) AS VARCHAR(100))'
      '11024598=         ,CAST(ROUND(Z.SUMM_BONUS, 2) AS VARCHAR(100))'
      
        '11024599=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_OF' +
        'FICIAL = O.G_OFFICIAL,'
      '110245100=         G_CLIENT G,'
      '110245101=         G_PAYMENT_TYPE P'
      '110245102=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110245103=     AND Z.G_CLIENT = G.G_CLIENT'
      '110245104=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110245105=    INTO :NUM_'
      '110245106=        ,:PAYMENT_TYPE_'
      '110245107=        ,:DATE_'
      '110245108=        ,:G_CLIENT_NAME_'
      '110245109=        ,:G_OFFICIAL_FM_'
      '110245110=        ,:NOTE_'
      '110245111=        ,:SUMM_NONCASH_'
      '110245112=        ,:SUMM_POLUCH_'
      '110245113=        ,:SUMM_SDACH_'
      '110245114=        ,:SUMM_BONUS_'
      '110245115=        ;'
      '110245116='
      '110245117=  --'#1041#1054#1053#1059#1057#1067' '#1042' '#1063#1045#1050#1045
      '110245118=  IF (BONUS_ > 0) THEN'
      '110245119=  BEGIN'
      
        '110245120=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_, 2) AS VARCHAR(100));'
      '110245121=  END'
      '110245122='
      '110245123=  if (BONUS_ALL_ > 0) then'
      '110245124=  BEGIN'
      
        '110245125=    BONUSALL_STR_ = '#39#1042#1089#1077#1075#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(BO' +
        'NUS_ALL_, 2) AS VARCHAR(100));'
      '110245126=  END'
      '110245127='
      '110245128=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110245129=  --IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110245130=  --  PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110245131='
      '110245132=  SELECT R.G_FIRM_REKVIZIT,'
      '110245133=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110245134=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110245135=    FROM G_FIRM_REKVIZIT R'
      '110245136=   WHERE R.is_default = 1'
      '110245137=    INTO :G_FIRM_REKVIZIT_,'
      '110245138=         :FIRM_NAME_,'
      '110245139=         :FIRM_IDN_;'
      '110245140='
      '110245141=  SELECT ZD.SUMM'
      '110245142=    FROM ZAKAZ_DETAILS ZD'
      '110245143=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110245144=    AND ZD.G_PRODUCT = -2'
      '110245145=    INTO :SERVICE_SUMM_;'
      '110245146=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110245147='
      '110245148=  SELECT SUM(ZD.AMOUNT),'
      
        '110245149=         CAST(ROUND(SUM((CASE WHEN ZD.DISCOUNT_SUMM>0 ' +
        'THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)),'
      
        '110245150=         CAST(ROUND(SUM(ZD.SUMM + (CASE WHEN ZD.DISCOU' +
        'NT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50))' +
        ','
      '110245151=         CAST(SUM(ZD.SUMM) AS VARCHAR(50)),'
      
        '110245152=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110245153=         CAST(:SERVICE_SUMM_  AS VARCHAR(50)),'
      '110245154=         CAST(SUM(ZD.NDS_SUMM) AS VARCHAR(50))'
      '110245155=  FROM ZAKAZ_DETAILS ZD'
      '110245156=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110245157=    AND ZD.G_PRODUCT <> -2'
      '110245158=  INTO :AMOUNT_VSEGO_NUM_,'
      '110245159=       :SUMM_SKIDKA_,'
      
        '110245160=       :SUMM_VSEGO_,     -- 26.09.2022 '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040 +
        #1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054#1050', '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042#1057 +
        #1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '110245161=       :SUMM_VSEGO_WITHOUT_SERVICE_, -- 26.09.2022 '#1058#1045#1055 +
        #1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '110245162=       :SUMM_VSEGO_N_,'
      '110245163=       :SUMM_SERVICE_,'
      '110245164=       :SUMM_NDS_;'
      '110245165='
      '110245166=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110245167=    FROM G_FIRM_ADDRESS R'
      '110245168=   WHERE R.IS_DEFAULT = 1'
      '110245169=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110245170=    INTO :FIRM_ADDRESS_;'
      '110245171='
      
        '110245172=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110245173=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110245174=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110245175=    IF (CURRENCY_ = 0) THEN'
      '110245176=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110245177=    ELSE'
      '110245178=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110245179=  END'
      '110245180='
      '110245181=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110245182='
      '110245183=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110245184=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110245185=  INTO :SUMM_STR_;'
      '110245186='
      '110245187=  FOR'
      '110245188=    SELECT :I || '#39'. '#39' || G.NAME,'
      
        '110245189=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.MA' +
        'RK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||Z' +
        'D.MARK_CODE END),'
      
        '110245190=           (CASE WHEN (G.ARTICUL is null) or (G.ARTICU' +
        'L = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '110245191=           ZD.AMOUNT,'
      
        '110245192=           CAST(ROUND(ZD.PRICE - (CASE WHEN ZD.DISCOUN' +
        'T_SUMM<0 THEN ZD.DISCOUNT_SUMM else 0 END)/ZD.AMOUNT, 2) AS VARC' +
        'HAR(100)),'
      
        '110245193=           CAST(ROUND(ZD.SUMM + (CASE WHEN ZD.DISCOUNT' +
        '_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END) , 2) AS VARCHAR(100))'
      '110245194=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110245195=           ,CAST(ZD.PRICE AS VARCHAR(100))--CAST(ZD.PR' +
        'ICE - ZD.DISCOUNT_TENGE AS VARCHAR(100))'
      '110245196=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110245197=           ,CAST(ZD.DISCOUNT_SUMM AS VARCHAR(100))'
      '110245198=      FROM ZAKAZ Z,'
      '110245199=           ZAKAZ_DETAILS ZD,'
      '110245200=           G_PRODUCT G,'
      '110245201=           G_UNIT U'
      '110245202=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110245203=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110245204=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110245205=       AND G.G_UNIT = U.G_UNIT'
      '110245206=       AND G.G_PRODUCT <> -2'
      '110245207=     ORDER BY ZD.zakaz_details'
      '110245208=    INTO :NAME,'
      '110245209=        :NAME_MARKER,'
      '110245210=        :NAME_ART,'
      '110245211=        :AMOUNT_NUM_,'
      '110245212=        :PRICE,'
      '110245213=        :SUMM'
      '110245214=        ,:SHORT_NAME'
      '110245215=        ,:PRICE_N'
      '110245216=        ,:SUMM_N'
      '110245217=        ,:DISCOUNT'
      '110245218='
      '110245219=  DO BEGIN'
      '110245220=    I = I + 1;'
      '110245221='
      
        '110245222=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110245223=    /*if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110245224=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110245225=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110245226=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110245227=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110245228=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110245229=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110245230=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110245231=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110245232=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110245233=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110245234=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110245235=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110245236=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110245237=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110245238=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110245239=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110245240=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110245241=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110245242=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110245243=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110245244=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);*/'
      '110245245='
      '110245246=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110245247=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110245248=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110245249=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110245250=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110245251=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110245252=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110245253=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110245254=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110245255=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110245256=    END ELSE BEGIN'
      '110245257=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110245258=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110245259=    END'
      '110245260='
      
        '110245261=    --if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMO' +
        'UNT) > 0) then'
      
        '110245262=    --  AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR P' +
        'OSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110245263='
      
        '110245264=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110245265=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110245266='
      
        '110245267=    SUMM_TXT = AMOUNT || '#39' x '#39' || PRICE_N || '#39' = '#39' || ' +
        'SUMM;--SUMM_N;'
      '110245268='
      '110245269=    SUSPEND;'
      '110245270=  END'
      '110245271=WHEN ANY DO BEGIN'
      '110245272=    Err_code = -20500;'
      
        '110245273=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110245274=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110245275=  END'
      '110245276=end'
      '110245277=;'
      '110245278='
      
        '110245279=UPDATE SYSTEM_SETUP SET S_VALUE = 110245 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110245280=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110245281=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102460=SET AUTODDL ON;'
      '1102461='
      
        '1102462=/*******************************************************' +
        '***********************/'
      
        '1102463=/****                 Deactivating dependencies of objec' +
        'ts                 ****/'
      
        '1102464=/*******************************************************' +
        '***********************/'
      '1102465='
      '1102466=ALTER PROCEDURE GET_SKLAD('
      '1102467=  SKLAD_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */ BIGINT,'
      '1102468=  MODE_ INTEGER)'
      '1102469=RETURNS ('
      
        '11024610=  G_PROD_NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '11024611=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_REC' +
        'EIPT */ DATE,'
      
        '11024612=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_REC' +
        'EIPT */ TIME,'
      
        '11024613=  G_CLIENT_ /* TYPE OF COLUMN SKLAD_PARENT.G_CLIENT */ ' +
        'BIGINT,'
      
        '11024614=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN SKLAD_PARENT.G_PAYM' +
        'ENT_TYPE */ BIGINT,'
      
        '11024615=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE *' +
        '/ VARCHAR(150),'
      
        '11024616=  NOTE_ /* TYPE OF COLUMN SKLAD_PARENT.NOTE */ VARCHAR(' +
        '200),'
      
        '11024617=  SUMM_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11024618=  SUMM_FACT_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT *' +
        '/ NUMERIC(15,2),'
      
        '11024619=  SUMM_CURRENCY_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_CU' +
        'RRENCY */ NUMERIC(15,2),'
      
        '11024620=  IS_PAYED_ALL_ /* TYPE OF COLUMN SKLAD_PARENT.IS_PAYED' +
        '_ALL */ INTEGER,'
      '11024621=  CNT_T_ INTEGER,'
      
        '11024622=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ BIGINT,'
      
        '11024623=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      '11024624=  HAVERIGHT_ INTEGER,'
      '11024625=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11024626=  IS_EXPECTED_ /* TYPE OF COLUMN SKLAD_PARENT.IS_EXPECT' +
        'ED */ INTEGER,'
      
        '11024627=  G_NONCASH_PAY_TYPE_ /* TYPE OF COLUMN G_NONCASH_PAY_T' +
        'YPE.G_NONCASH_PAY_TYPE */ BIGINT,'
      
        '11024628=  ZAKAZ_ /* TYPE OF COLUMN SKLAD_PARENT.ZAKAZ */ BIGINT' +
        ','
      '11024629=  ERR_CODE INTEGER,'
      '11024630=  ERR_MSG VARCHAR(1024))'
      '11024631=AS'
      '11024632=BEGIN'
      '11024633=  SUSPEND;'
      '11024634=END'
      '11024635=;'
      '11024636='
      '11024637=ALTER PROCEDURE INS_SKLAD('
      
        '11024638=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT,'
      
        '11024639=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_REC' +
        'EIPT */ DATE,'
      
        '11024640=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_REC' +
        'EIPT */ TIME,'
      '11024641=  G_CLIENT_ /* TYPE OF COLUMN SKLAD.G_CLIENT */ BIGINT,'
      
