      '11060102=ALTER PROCEDURE DEL_ZAKAZ_NA_REAL('
      
        '11060103=  ZAKAZ_NA_REAL_ /* TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_' +
        'NA_REAL */ INTEGER)'
      '11060104=RETURNS ('
