        'UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11068924=            END ELSE'
      
        '11068925=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11068926=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||U' +
        'PPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME_' +
        '||'#39'.'#39';'
      '11068927=        END'
