      '1102122000=        SELECT 6 COL,'
      '1102122001=               '#39'  '#1042#1053#1045#1057#1045#1053#1048#1045#39' STR,'
      '1102122002=               '#39'*'#39'||:VNESENIE_AMOUNT_ AMOUNT,'
      '1102122003=               '#39'='#39'||:VNESENIE_SUMM_ SUMM'
      '1102122004=          FROM RDB$DATABASE'
