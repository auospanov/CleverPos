      '1102015243=    DO BEGIN'
      '1102015244=      IF (PATH_OLD_ <> PATH_) THEN BEGIN'
      
        '1102015245=        IF (PATH_OLD_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102015246=            -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102015247=            INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1102015248=              (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMO' +
