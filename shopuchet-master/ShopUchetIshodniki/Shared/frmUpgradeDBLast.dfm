      '11018721=  STR_OT2_ VARCHAR(500),'
      '11018722=  DEBET_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11018723=  DEBET_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11018724=  CREDIT_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11018725=  CREDIT_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11018726=  DEBET_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11018727=  CREDIT_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11018728=  FIRM_NAME_OUT_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '11018729=  CLIENT_NAME_OUT_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11018730=  STR_TEXT VARCHAR(100),'
      '11018731=  OPER_DATE TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '11018732=  SUMM_DEBET TYPE OF COLUMN SKLAD.SUMM,'
      '11018733=  SUMM_CREDIT TYPE OF COLUMN SKLAD.SUMM,'
      '11018734=  SUMM_DEBET_CONTR TYPE OF COLUMN SKLAD.SUMM,'
      '11018735=  SUMM_CREDIT_CONTR TYPE OF COLUMN SKLAD.SUMM)'
      '11018736=AS'
      
        '11018737=DECLARE VARIABLE IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.I' +
        'S_SUPPLIER;'
      '11018738=DECLARE VARIABLE ID TYPE OF COLUMN CUR_PARAMS.ID;'
      '11018739=DECLARE VARIABLE ROW INTEGER;'
      '11018740=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '11018741=DECLARE VARIABLE SUMM_IN_DEBET_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SUMM;'
      
        '11018742=DECLARE VARIABLE SUMM_IN_CREDIT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM;'
      
        '11018743=DECLARE VARIABLE SUMM_IN_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM;'
      
        '11018744=DECLARE VARIABLE SUMM_OUT_DEBET_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM;'
      
        '11018745=DECLARE VARIABLE SUMM_OUT_CREDIT_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '11018746=DECLARE VARIABLE SUMM_OUT_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM;'
      
        '11018747=DECLARE VARIABLE SUMM_OUT_1 TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '11018748=DECLARE VARIABLE SUMM_OUT_2 TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      '11018749=DECLARE VARIABLE CURR_STR_ VARCHAR(5);'
      '11018750=DECLARE VARIABLE SORT_ROW DATE;'
      '11018751=BEGIN'
      '11018752=  CLRF = ascii_char( 10 );'
      '11018753='
      '11018754=  if (CURRENCY_ = 0) then'
      '11018755=    CURR_STR_ = '#39' KZT'#39';'
      '11018756=  else if (CURRENCY_ = 1) then'
      '11018757=    CURR_STR_ = '#39' '#1088#1091#1073'.'#39';'
      '11018758=  else if (CURRENCY_ = 2) then'
      '11018759=    CURR_STR_ = '#39' '#1075#1088#1085'.'#39';'
      '11018760=  else if (CURRENCY_ = 3) then'
      '11018761=    CURR_STR_ = '#39' '#1089#1091#1084#39';'
      '11018762=  else if (CURRENCY_ = 4) then'
      '11018763=    CURR_STR_ = '#39' '#1089#1086#1084#39';'
      '11018764=  else if (CURRENCY_ = 5) then'
      '11018765=    CURR_STR_ = '#39' '#1076#1088#1072#1084#39';'
      '11018766='
      '11018767=  if (G_OFFICIAL_NAME_ IS NULL) then BEGIN'
      '11018768=      SELECT J.FIO_DOC'
      '11018769=        FROM G_OFFICIAL J'
      '11018770=       WHERE J.IS_RUKOVODITEL = 1'
      '11018771=        INTO G_OFFICIAL_NAME_;'
      '11018772='
      '11018773=      if (G_OFFICIAL_NAME_ IS NULL) then'
      '11018774=        SELECT J.FIO_DOC'
      '11018775=          FROM G_OFFICIAL J'
      
        '11018776=         WHERE J.G_OFFICIAL = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 1)'
      '11018777=         INTO G_OFFICIAL_NAME_;'
      '11018778=  END'
      '11018779='
      '11018780=  CLIENT_NAME_OUT_  = CLIENT_NAME_IN_;'
      '11018781=  FIRM_NAME_OUT_    = FIRM_NAME_IN_;'
      '11018782='
      
        '11018783=  if (TRIM(G_OFFICIAL_NAME_) IS NULL or TRIM(G_OFFICIAL' +
        '_NAME_) = '#39#39') then'
      '11018784=    G_OFFICIAL_NAME_ = '#39'________________'#39';'
      '11018785='
      
        '11018786=  if (TRIM(CLIENT_DIR_NAME_IN_) IS NULL or TRIM(CLIENT_' +
        'DIR_NAME_IN_) = '#39#39') then'
      '11018787=    CLIENT_DIR_NAME_IN_ = '#39'________________'#39';'
      '11018788='
      
        '11018789=  STR1_ = '#39#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1079#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRAC' +
        'T(DAY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM D' +
        'ATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'
      
        '11018790=          '#39' '#1087#1086' '#39'||lpad(EXTRACT(DAY FROM DATE_END_), 2, ' +
        #39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXT' +
        'RACT(YEAR FROM DATE_END_)||clrf||'
      '11018791=          '#39' '#1084#1077#1078#1076#1091' '#39'||FIRM_NAME_OUT_||clrf||'
      '11018792=          '#39' '#1080' '#39'||CLIENT_NAME_OUT_;'
      '11018793='
      
        '11018794=  STR2_ = '#39#1052#1099', '#1085#1080#1078#1077#1087#1086#1076#1087#1080#1089#1072#1074#1096#1080#1077#1089#1103', ________________ '#39'||F' +
        'IRM_NAME_OUT_||'#39' '#39'||G_OFFICIAL_NAME_||'#39', '#1089' '#1086#1076#1085#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '11018795=          '#39#1080' ________________ '#39'||CLIENT_NAME_OUT_||'#39' '#39'|' +
        '|CLIENT_DIR_NAME_IN_||'#39', '#1089' '#1076#1088#1091#1075#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '11018796=          '#39#1089#1086#1089#1090#1072#1074#1080#1083#1080' '#1085#1072#1089#1090#1086#1103#1097#1080#1081' '#1072#1082#1090' '#1089#1074#1077#1088#1082#1080' '#1074' '#1090#1086#1084', '#1095#1090#1086' '#1089#1086 +
        #1089#1090#1086#1103#1085#1080#1077' '#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1087#1086' '#1076#1072#1085#1085#1099#1084' '#1091#1095#1077#1090#1072' '#1089#1083#1077#1076#1091#1102#1097#1077#1077':'#39';'
      '11018797='
      '11018798=  STR3_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_||'#39','#39'||CURR_STR_;'
      '11018799=  STR3_DOWN_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_;'
      
        '110187100=  STR4_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||CLIENT_NAME_OUT_||'#39','#39'||CURR_ST' +
        'R_;'
      '110187101='
      
        '110187102=  STR_SALDO_IN_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1085#1072#1095#1072#1083#1086' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110187103=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_BEGIN_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DAT' +
        'E_BEGIN_)||'#39' '#1075'.'#39';'
      '110187104='
      
        '110187105=  STR_SALDO_OUT_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1082#1086#1085#1077#1094' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_END_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110187106=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_END_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DATE_' +
        'END_)||'#39' '#1075'.'#39';'
      '110187107='
      '110187108=  STR_OT1_ = '#39#1054#1090' '#39'||FIRM_NAME_OUT_;'
      '110187109=  STR_OT2_ = '#39#1054#1090' '#39'||CLIENT_NAME_OUT_;'
      '110187110='
      '110187111=  SELECT IS_SUPPLIER'
      '110187112=    FROM G_CLIENT G'
      '110187113=   WHERE G.G_CLIENT = :G_CLIENT_'
      '110187114=    INTO :IS_SUPPLIER_;'
      '110187115='
      '110187116=  DEBET_IN_   = 0;'
      '110187117=  DEBET_OUT_  = 0;'
      '110187118=  CREDIT_IN_  = 0;'
      '110187119=  CREDIT_OUT_ = 0;'
      '110187120='
      
        '110187121=  STR5_ = '#39#1085#1072' '#39'||LPAD(EXTRACT(DAY FROM CURRENT_DATE), ' +
        '2, '#39'0'#39')||'#39'.'#39'||LPAD(EXTRACT(MONTH FROM CURRENT_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110187122='
      
        '110187123=  --**************************************************' +
        '*****************'
      '110187124=  -- '#1055#1054#1057#1058#1040#1042#1065#1048#1050
      
        '110187125=  --**************************************************' +
        '*****************'
      '110187126=  IF (IS_SUPPLIER_ = 1) THEN BEGIN'
      '110187127=    ----------------------'
      '110187128=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110187129=    SELECT SUM(S.SUMM)'
      '110187130=      FROM SKLAD_PARENT S'
      '110187131=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187132=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110187133=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187134=    GROUP BY S.G_CLIENT'
      '110187135=      INTO :SUMM_IN_DEBET_;'
      '110187136='
      '110187137=    SELECT SUM(K.SUMM)'
      '110187138=      FROM SKLAD_PARENT S,'
      
        '110187139=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187140=             from KASSA'
      
        '110187141=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187142=              AND ZAKAZ IS NULL'
      '110187143=           union all'
      
        '110187144=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187145=             from kassa_beznal'
      
        '110187146=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187147=              AND ZAKAZ IS NULL) K'
      '110187148=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187149=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187150=       AND K.SKLAD = S.SKLAD'
      '110187151=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110187152=       AND K.G_PRIHOD_RASHOD = 2'
      '110187153=    GROUP BY S.G_CLIENT'
      '110187154=      INTO :SUMM_IN_CREDIT_;'
      '110187155='
      
        '110187156=    SELECT :SUMM_IN_DEBET_ + SUM(S.SUMM)              ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110187157=      FROM ZAKAZ S'
      '110187158=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187159=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110187160=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187161=    GROUP BY S.G_CLIENT'
      '110187162=      INTO :SUMM_IN_DEBET_;'
      '110187163='
      
        '110187164=    SELECT :SUMM_IN_CREDIT_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110187165=      FROM ZAKAZ S,'
      '110187166=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110187167=             from KASSA'
      
        '110187168=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187169=              AND SKLAD IS NULL'
      '110187170=           union all'
      '110187171=           select ZAKAZ, SUMM, ACTION_DATE'
      '110187172=             from kassa_beznal'
      
        '110187173=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187174=              AND SKLAD IS NULL) K'
      '110187175=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187176=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187177=       AND K.zakaz = S.ZAKAZ'
      '110187178=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110187179=    GROUP BY S.G_CLIENT'
      '110187180=      INTO :SUMM_IN_CREDIT_;'
      '110187181='
      '110187182=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110187183='
      '110187184=    ----------------------'
      '110187185=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110187186=    SELECT SUM(S.SUMM)'
      '110187187=      FROM SKLAD_PARENT S'
      '110187188=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187189=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110187190=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187191=    GROUP BY S.G_CLIENT'
      '110187192=      INTO :SUMM_OUT_DEBET_;'
      '110187193='
      '110187194=    SELECT SUM(K.SUMM)'
      '110187195=      FROM SKLAD_PARENT S,'
      
        '110187196=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187197=             from KASSA'
      
        '110187198=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187199=              AND ZAKAZ IS NULL'
      '110187200=           union all'
      
        '110187201=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187202=             from kassa_beznal'
      
        '110187203=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187204=              AND ZAKAZ IS NULL) K'
      '110187205=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187206=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187207=       AND K.SKLAD = S.SKLAD'
      '110187208=       AND K.ACTION_DATE <= :DATE_END_'
      '110187209=       AND K.G_PRIHOD_RASHOD = 2'
      '110187210=    GROUP BY S.G_CLIENT'
      '110187211=      INTO :SUMM_OUT_CREDIT_;'
      '110187212='
      
        '110187213=    SELECT :SUMM_OUT_CREDIT_ +SUM(S.SUMM)             ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110187214=      FROM ZAKAZ S'
      '110187215=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187216=       AND S.Z_DATE <= :DATE_END_'
      
        '110187217=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187218=    GROUP BY S.G_CLIENT'
      '110187219=      INTO :SUMM_OUT_CREDIT_;'
      '110187220='
      
        '110187221=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110187222=      FROM ZAKAZ S,'
      '110187223=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110187224=             from KASSA'
      
        '110187225=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187226=              AND SKLAD IS NULL'
      '110187227=           union all'
      '110187228=           select ZAKAZ, SUMM, ACTION_DATE'
      '110187229=             from kassa_beznal'
      
        '110187230=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187231=              AND SKLAD IS NULL) K'
      '110187232=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187233=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187234=       AND K.zakaz = S.ZAKAZ'
      '110187235=       AND K.ACTION_DATE <= :DATE_END_'
      '110187236=    GROUP BY S.G_CLIENT'
      '110187237=      INTO :SUMM_OUT_DEBET_;'
      '110187238='
      '110187239=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110187240=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110187241=    -------------------------'
      '110187242='
      '110187243=    if (COALESCE(SUMM_IN_, 0) < 0) then'
      '110187244=      DEBET_IN_ = SUMM_IN_;'
      '110187245=    ELSE'
      '110187246=      CREDIT_IN_ = SUMM_IN_;'
      '110187247='
      '110187248=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110187249=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110187250='
      '110187251=    if (COALESCE(SUMM_OUT_, 0) < 0) then'
      '110187252=      DEBET_OUT_ = ABS(SUMM_OUT_);'
      '110187253=    ELSE'
      '110187254=      CREDIT_OUT_ = SUMM_OUT_;'
      '110187255='
      '110187256=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110187257=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110187258='
      '110187259=        if (DEBET_OUT_ > 0) then'
      
        '110187260=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110187261=        else'
      
        '110187262=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110187263=    end else'
      '110187264=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110187265='
      '110187266=    FOR SELECT 1 ROW,'
      
        '110187267=               '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1058#1052#1047' '#39'||S.SKLAD||'#39' '#1086#1090' '#39'||S.' +
        'DATE_RECEIPT str,'
      '110187268=               S.SKLAD ID,'
      '110187269=               S.DATE_RECEIPT OPER_DATE,'
      '110187270=               NULL SUMM_DEBET,'
      '110187271=               S.SUMM SUMM_CREDIT,'
      '110187272=               S.DATE_RECEIPT SORT_ROW'
      '110187273=          FROM SKLAD_PARENT S'
      '110187274=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187275=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110187276=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110187277=        UNION ALL'
      '110187278=        SELECT 2 ROW,'
      
        '110187279=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' '#1086#1090' '#39'||SP' +
        'P.DATE_RECEIPT STR,'
      '110187280=               K.SKLAD ID,'
      '110187281=               K.ACTION_DATE OPER_DATE,'
      '110187282=               K.SUMM SUMM_DEBET,'
      '110187283=               NULL SUMM_CREDIT,'
      '110187284=               K.ACTION_DATE SORT_ROW'
      
        '110187285=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110187286=                  from KASSA'
      
        '110187287=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110187288=                union all'
      
        '110187289=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110187290=                  from kassa_beznal'
      
        '110187291=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110187292=               SKLAD_PARENT SPP'
      '110187293=         WHERE K.ZAKAZ IS NULL'
      '110187294=           AND K.SKLAD = SPP.SKLAD'
      
        '110187295=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110187296=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110187297=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110187298=           AND K.G_PRIHOD_RASHOD = 2'
      '110187299=        UNION ALL'
      '110187300=        SELECT 3 ROW,'
      
        '110187301=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#39'||Z.ZAKAZ||'#39' '#1086 +
        #1090' '#39'||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT' +
        '(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE)' +
        ' str,'
      '110187302=               Z.ZAKAZ ID,'
      '110187303=               Z.Z_DATE OPER_DATE,'
      '110187304=               Z.SUMM SUMM_DEBET,'
      '110187305=               NULL SUMM_CREDIT,'
      '110187306=               Z.Z_DATE SORT_ROW'
      '110187307=          FROM ZAKAZ Z'
      '110187308=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110187309=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110187310=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110187311=        UNION ALL'
      '110187312=        SELECT 4 ROW,'
      
        '110187313=               '#39#1054#1087#1083#1072#1090#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' '#39 +
        '||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(M' +
        'ONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE)' +
        ' STR,'
      '110187314=               K.ZAKAZ ID,'
      '110187315=               K.ACTION_DATE OPER_DATE,'
      '110187316=               NULL SUMM_DEBET,'
      '110187317=               K.SUMM SUMM_CREDIT,'
      '110187318=               K.ACTION_DATE SORT_ROW'
      
        '110187319=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA'
      '110187320=                  from KASSA'
      
        '110187321=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110187322=                union all'
      
        '110187323=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA'
      '110187324=                  from kassa_beznal'
      
        '110187325=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '110187326=               zakaz zz'
      '110187327=         WHERE K.sklad IS NULL'
      '110187328=           AND K.zakaz = zz.ZAKAZ'
      
        '110187329=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110187330=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110187331=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110187332=        UNION ALL'
      '110187333=        SELECT 5 ROW,'
      '110187334=               NULL STR,'
      '110187335=               NULL ID,'
      '110187336=               NULL OPER_DATE,'
      '110187337=               NULL SUMM_DEBET,'
      '110187338=               NULL SUMM_CREDIT,'
      
        '110187339=               '#39'31.12.2199'#39' SORT_ROW    -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072 +
        #1103' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110187340=          FROM RDB$DATABASE'
      '110187341=        ORDER BY 7, 3, 1'
      '110187342=        INTO :ROW,'
      '110187343=             :STR_TEXT,'
      '110187344=             :ID,'
      '110187345=             :OPER_DATE,'
      '110187346=             :SUMM_DEBET,'
      '110187347=             :SUMM_CREDIT,'
      '110187348=             :SORT_ROW'
      '110187349=    DO BEGIN'
      '110187350=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110187351=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110187352=      SUSPEND;'
      '110187353=    END'
      '110187354=  END'
      '110187355='
      
        '110187356=  --**************************************************' +
        '*************'
      '110187357=  -- '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068
      
        '110187358=  --**************************************************' +
        '*************'
      '110187359=  ELSE BEGIN'
      '110187360=    ----------------------'
      '110187361=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110187362=    SELECT SUM(S.SUMM)'
      '110187363=      FROM ZAKAZ S'
      '110187364=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187365=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110187366=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187367=       AND S.is_spisanie <> 1'
      '110187368=    GROUP BY S.G_CLIENT'
      '110187369=      INTO :SUMM_IN_DEBET_;'
      '110187370='
      '110187371=    SELECT SUM(K.SUMM)'
      '110187372=      FROM ZAKAZ S,'
      
        '110187373=          (select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187374=             from KASSA'
      
        '110187375=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187376=              AND SKLAD IS NULL'
      '110187377=           union all'
      
        '110187378=           select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187379=             from kassa_beznal'
      
        '110187380=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187381=              AND SKLAD IS NULL'
      '110187382=           union all'
      
        '110187383=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110187384=             from zakaz Z'
      
        '110187385=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187386=              AND Z.summ_bonus > 0) K'
      '110187387=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187388=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187389=       AND K.zakaz = S.ZAKAZ'
      '110187390=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110187391=       AND S.is_spisanie <> 1'
      '110187392=       AND K.G_PRIHOD_RASHOD = 1'
      '110187393=    GROUP BY S.G_CLIENT'
      '110187394=      INTO :SUMM_IN_CREDIT_;'
      '110187395='
      
        '110187396=    SELECT :SUMM_IN_DEBET_ + SUM(K.SUMM)              ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110187397=      FROM SKLAD_PARENT S,'
      
        '110187398=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187399=             from KASSA'
      
        '110187400=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187401=              AND ZAKAZ IS NULL'
      '110187402=           union all'
      
        '110187403=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110187404=             from kassa_beznal'
      
        '110187405=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187406=              AND ZAKAZ IS NULL) K'
      '110187407=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187408=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187409=       AND K.SKLAD = S.SKLAD'
      '110187410=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110187411=       AND K.G_PRIHOD_RASHOD = 3'
      '110187412=    GROUP BY S.G_CLIENT'
      '110187413=      INTO :SUMM_IN_DEBET_;'
      '110187414='
      
        '110187415=    SELECT :SUMM_IN_CREDIT_ + SUM(S.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110187416=      FROM SKLAD_PARENT S'
      '110187417=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187418=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110187419=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187420=    GROUP BY S.G_CLIENT'
      '110187421=      INTO :SUMM_IN_CREDIT_;'
      '110187422='
      '110187423=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110187424='
      '110187425=    ----------------------'
      '110187426=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110187427=    SELECT SUM(S.SUMM)'
      '110187428=      FROM ZAKAZ S'
      '110187429=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187430=       AND S.Z_DATE <= :DATE_END_'
      
        '110187431=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187432=       AND S.is_spisanie <> 1'
      '110187433=    GROUP BY S.G_CLIENT'
      '110187434=      INTO :SUMM_OUT_DEBET_;'
      '110187435='
      '110187436=    SELECT SUM(K.SUMM)'
      '110187437=      FROM ZAKAZ S,'
      
        '110187438=          (select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110187439=             from KASSA'
      
        '110187440=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187441=              AND SKLAD IS NULL'
      '110187442=           union all'
      
        '110187443=           select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110187444=             from kassa_beznal'
      
        '110187445=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187446=              AND SKLAD IS NULL'
      '110187447=           union all'
      
        '110187448=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110187449=             from zakaz Z'
      
        '110187450=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187451=              AND Z.summ_bonus > 0) K'
      '110187452=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187453=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187454=       AND K.zakaz = S.ZAKAZ'
      '110187455=       AND K.ACTION_DATE <= :DATE_END_'
      '110187456=       AND K.G_PRIHOD_RASHOD in (1, -5)'
      '110187457=    GROUP BY S.G_CLIENT'
      '110187458=      INTO :SUMM_OUT_CREDIT_;'
      '110187459='
      
        '110187460=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110187461=      FROM SKLAD_PARENT S,'
      
        '110187462=          (select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110187463=             from KASSA'
      
        '110187464=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187465=              AND ZAKAZ IS NULL'
      '110187466=           union all'
      
        '110187467=           select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110187468=             from kassa_beznal'
      
        '110187469=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110187470=              AND ZAKAZ IS NULL) K'
      '110187471=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187472=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187473=       AND K.SKLAD = S.SKLAD'
      '110187474=       AND K.ACTION_DATE <= :DATE_END_'
      '110187475=       AND K.G_PRIHOD_RASHOD = 3'
      '110187476=    GROUP BY S.G_CLIENT'
      '110187477=      INTO :SUMM_OUT_DEBET_;'
      '110187478='
      
        '110187479=    SELECT :SUMM_OUT_CREDIT_ + SUM(S.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110187480=      FROM SKLAD_PARENT S'
      '110187481=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110187482=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110187483=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110187484=    GROUP BY S.G_CLIENT'
      '110187485=      INTO :SUMM_OUT_CREDIT_;'
      '110187486='
      '110187487=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110187488=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110187489=    -------------------------'
      '110187490='
      '110187491=    IF (COALESCE(SUMM_IN_, 0) > 0) then'
      '110187492=      DEBET_IN_ = SUMM_IN_;'
      '110187493=    ELSE'
      '110187494=      CREDIT_IN_ = SUMM_IN_;'
      '110187495='
      '110187496=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110187497=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110187498='
      '110187499=    if (COALESCE(SUMM_OUT_, 0) > 0) then'
      '110187500=      DEBET_OUT_ = SUMM_OUT_;'
      '110187501=    ELSE'
      '110187502=      CREDIT_OUT_ = ABS(SUMM_OUT_);'
      '110187503='
      '110187504=    --------------------'
      '110187505=    -- '#1047#1040#1044#1054#1051#1046#1045#1053#1053#1054#1057#1058#1068
      '110187506=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110187507=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110187508='
      '110187509=        if (DEBET_OUT_ > 0) then'
      
        '110187510=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110187511=        else'
      
        '110187512=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110187513=    end else'
      '110187514=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110187515='
      '110187516=    FOR SELECT 1 ROW,'
      
        '110187517=               '#39#1055#1088#1086#1076#1072#1078#1072', '#1085#1072#1082#1083#1072#1076#1085#1072#1103' '#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39'|' +
        '|lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MON' +
        'TH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE) str' +
        ','
      '110187518=               Z.ZAKAZ ID,'
      '110187519=               Z.Z_DATE OPER_DATE,'
      '110187520=               Z.SUMM SUMM_DEBET,'
      '110187521=               NULL SUMM_CREDIT,'
      '110187522=               Z.Z_DATE SORT_ROW'
      '110187523=          FROM ZAKAZ Z'
      '110187524=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110187525=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110187526=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110187527=        UNION ALL'
      '110187528=        SELECT 2 ROW,'
      
        '110187529=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1085#1072#1082#1083#1072#1076#1085#1091#1102' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(' +
        'MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE' +
        ') STR,'
      '110187530=               K.ZAKAZ ID,'
      '110187531=               K.ACTION_DATE OPER_DATE,'
      '110187532=               NULL SUMM_DEBET,'
      '110187533=               K.SUMM SUMM_CREDIT,'
      '110187534=               K.ACTION_DATE SORT_ROW'
      
        '110187535=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA, G_PRIHOD_RASHOD'
      '110187536=                  from KASSA'
      
        '110187537=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110187538=                union all'
      
        '110187539=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA, G_PRIHOD_RASHOD'
      '110187540=                  from kassa_beznal'
      
        '110187541=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110187542=                union all'
      
        '110187543=                select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z' +
        '_date ACTION_DATE, NULL SKLAD, NULL KASSA, 1 G_PRIHOD_RASHOD'
      '110187544=                  from zakaz Z'
      
        '110187545=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110187546=                   AND Z.summ_bonus > 0) K,'
      '110187547=               zakaz zz'
      '110187548=         WHERE K.sklad IS NULL'
      '110187549=           AND K.zakaz = zz.ZAKAZ'
      
        '110187550=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110187551=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110187552=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110187553=           AND K.G_PRIHOD_RASHOD in (1, -5)'
      '110187554=        UNION ALL'
      '110187555=        SELECT 3 ROW,'
      
        '110187556=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1082#1083#1080#1077#1085#1090#1086#1084' '#39'||S.SKLAD||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXT' +
        'RACT(MONTH FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM' +
        ' S.DATE_RECEIPT) str,'
      '110187557=               S.SKLAD ID,'
      '110187558=               S.DATE_RECEIPT OPER_DATE,'
      '110187559=               NULL SUMM_DEBET,'
      '110187560=               S.SUMM SUMM_CREDIT,'
      '110187561=               S.DATE_RECEIPT SORT_ROW'
      '110187562=          FROM SKLAD_PARENT S'
      '110187563=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110187564=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110187565=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110187566=        UNION ALL'
      '110187567=        SELECT 4 ROW,'
      
        '110187568=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' ' +
        #1086#1090' '#39'||lpad(EXTRACT(DAY FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpa' +
        'd(EXTRACT(MONTH FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM SPP.DATE_RECEIPT) STR,'
      '110187569=               K.SKLAD ID,'
      '110187570=               K.ACTION_DATE OPER_DATE,'
      '110187571=               K.SUMM SUMM_DEBET,'
      '110187572=               NULL SUMM_CREDIT,'
      '110187573=               K.ACTION_DATE SORT_ROW'
      
        '110187574=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110187575=                  from KASSA'
      
        '110187576=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110187577=                union all'
      
        '110187578=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110187579=                  from kassa_beznal'
      
        '110187580=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110187581=               SKLAD_PARENT SPP'
      '110187582=         WHERE K.ZAKAZ IS NULL'
      '110187583=           AND K.SKLAD = SPP.SKLAD'
      
        '110187584=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110187585=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110187586=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110187587=           AND K.G_PRIHOD_RASHOD = 3'
      '110187588=        UNION ALL'
      '110187589=        SELECT 5 ROW,'
      '110187590=               NULL STR,'
      '110187591=               NULL ID,'
      '110187592=               NULL OPER_DATE,'
      '110187593=               NULL SUMM_DEBET,'
      '110187594=               NULL SUMM_CREDIT,'
      
        '110187595=               '#39'31.12.2199'#39' SORT_ROW  -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072#1103' ' +
        #1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110187596=          FROM RDB$DATABASE'
      '110187597=        ORDER BY 7, 3, 1'
      '110187598=        INTO :ROW,'
      '110187599=             :STR_TEXT,'
      '110187600=             :ID,'
      '110187601=             :OPER_DATE,'
      '110187602=             :SUMM_DEBET,'
      '110187603=             :SUMM_CREDIT,'
      '110187604=             :SORT_ROW'
      '110187605=    DO BEGIN'
      '110187606=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110187607=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110187608='
      '110187609=      SUSPEND;'
      '110187610=    END'
      '110187611=  END'
      '110187612='
      '110187613=END'
      '110187614=;'
      '110187615='
      '110187616='
      
        '110187617=UPDATE SYSTEM_SETUP SET S_VALUE = 110187 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110187618=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110187619=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101880='
      '1101881=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      
        '1101882=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      
        '1101883=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT */ BIGINT,'
      
        '1101884=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT,'
      '1101885=  DATE_BEGIN_ DATE,'
      '1101886=  DATE_END_ DATE,'
      '1101887=  TIME_BEGIN_ TIME,'
      '1101888=  TIME_END_ TIME,'
      '1101889=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11018810=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11018811=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '11018812=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BI' +
        'GINT = 0)'
      '11018813=RETURNS ('
      
        '11018814=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUME' +
        'RIC(18,5),'
      
        '11018815=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERI' +
        'C(15,2),'
      
        '11018816=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11018817=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOU' +
        'NT_TENGE */ NUMERIC(15,2),'
      
        '11018818=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11018819=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHA' +
        'R(250),'
      
        '11018820=  PAYMENT_NAME /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME */' +
        ' VARCHAR(256),'
      
        '11018821=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      
        '11018822=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11018823=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11018824=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      '11018825=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '11018826=  Z_DATE BLOB SUB_TYPE 1,'
      '11018827=  ROW INTEGER,'
      '11018828=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '11018829=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      
        '11018830=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMERI' +
        'C(15,2),'
      
        '11018831=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */ ' +
        'NUMERIC(15,2),'
      
        '11018832=  OFFICIAL_NAME /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */' +
        ' VARCHAR(150),'
      '11018833=  ERR_CODE INTEGER,'
      '11018834=  ERR_MSG VARCHAR(1024))'
      '11018835=AS'
      '11018836=BEGIN'
      '11018837=  SUSPEND;'
      '11018838=END'
      '11018839=;'
      '11018840='
      '11018841=ALTER PROCEDURE P_REP_ZAKAZI_LIST_CATEGORY('
      
        '11018842=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      
        '11018843=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT */ BIGINT,'
      
        '11018844=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      '11018845=  DATE_BEGIN_ DATE,'
      '11018846=  DATE_END_ DATE,'
      '11018847=  TIME_BEGIN_ TIME,'
      '11018848=  TIME_END_ TIME,'
      '11018849=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11018850=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '11018851=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BI' +
        'GINT = 0)'
      '11018852=RETURNS ('
      '11018853=  PERIOD_ VARCHAR(40),'
      
        '11018854=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11018855=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11018856=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      '11018857=  ERR_CODE INTEGER,'
      '11018858=  ERR_MSG VARCHAR(1024))'
      '11018859=AS'
      '11018860=BEGIN'
      '11018861=  SUSPEND;'
      '11018862=END'
      '11018863=;'
      '11018864='
      '11018865=ALTER PROCEDURE P_REP_ZAKAZI_LIST_TOVARY('
      
        '11018866=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      
        '11018867=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT */ BIGINT,'
      
        '11018868=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      '11018869=  DATE_BEGIN_ DATE,'
      '11018870=  DATE_END_ DATE,'
      '11018871=  TIME_BEGIN_ TIME,'
      '11018872=  TIME_END_ TIME,'
      '11018873=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11018874=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11018875=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '11018876=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BI' +
        'GINT = 0)'
      '11018877=RETURNS ('
      '11018878=  PERIOD_ VARCHAR(40),'
      
        '11018879=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUME' +
        'RIC(18,5),'
      
        '11018880=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERI' +
        'C(15,2),'
      
        '11018881=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11018882=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11018883=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      
        '11018884=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11018885=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      '11018886=  Z_DATE /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '11018887=  PATH BLOB SUB_TYPE 1,'
      '11018888=  ROW INTEGER,'
      '11018889=  ERR_CODE INTEGER,'
      '11018890=  ERR_MSG VARCHAR(1024))'
      '11018891=AS'
      '11018892=BEGIN'
      '11018893=  SUSPEND;'
      '11018894=END'
      '11018895=;'
      '11018896='
      '11018897='
      
        '11018898=/******************************************************' +
        '************************/'
      
        '11018899=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '110188100=/*****************************************************' +
        '*************************/'
      '110188101=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '110188102=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110188103=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110188104=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110188105=  DATE_BEGIN_ DATE,'
      '110188106=  DATE_END_ DATE,'
      '110188107=  TIME_BEGIN_ TIME,'
      '110188108=  TIME_END_ TIME,'
      '110188109=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110188110=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110188111=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110188112=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '110188113=RETURNS ('
      '110188114=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110188115=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110188116=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110188117=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_TENGE,'
      
        '110188118=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110188119=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110188120=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '110188121=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110188122=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110188123=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110188124=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110188125=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110188126=  Z_DATE BLOB SUB_TYPE 1,'
      '110188127=  ROW INTEGER,'
      '110188128=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '110188129=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110188130=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110188131=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110188132=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110188133=  ERR_CODE INTEGER,'
      '110188134=  ERR_MSG VARCHAR(1024))'
      '110188135=AS'
      
        '110188136=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_' +
        'LIST'#39';'
      '110188137=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110188138=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '110188139=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80;'
      
        '110188140=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ART' +
        'ICUL;'
      
        '110188141=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BAR' +
        'CODE;'
      
        '110188142=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRO' +
        'DUCT.BARCODE;'
      
        '110188143=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110188144=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110188145=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.NAME;'
      
        '110188146=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      
        '110188147=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110188148=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM = 0;'
      
        '110188149=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110188150=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '110188151=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110188152=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM = 0;'
      
        '110188153=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110188154=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '110188155=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '110188156=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.' +
        'PATH = '#39#39';'
      '110188157=DECLARE VARIABLE I INTEGER = 1;'
      '110188158=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      
        '110188159=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAME' +
        ';'
      
        '110188160=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      
        '110188161=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110188162=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FIO_DOC;'
      '110188163=BEGIN'
      '110188164=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '110188165=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '110188166='
      
        '110188167=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') ||' +
        ' '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extra' +
        'ct(year from Z.Z_DATE),'
      '110188168=             Z.Z_TIME,'
      '110188169=             GP.ARTICUL,'
      '110188170=             GP.BARCODE,'
      '110188171=             GP.NOMENCLATUR_NUM,'
      '110188172=             GP.NAME,'
      '110188173=             ZD.AMOUNT,'
      '110188174=             ZD.PRICE,'
      '110188175=             ZD.DISCOUNT_TENGE,'
      '110188176=             ZD.SUMM,'
      '110188177=             ZD.DISCOUNT_SUMM,'
      '110188178=             GC.NAME,'
      '110188179=             P.NAME,'
      '110188180=             TR.PATH,'
      '110188181=             Z.NOTE,'
      '110188182=             U.SHORT_NAME,'
      '110188183=             Z.SUMM_CASH,'
      '110188184=             Z.SUMM_NONCASH,'
      
        '110188185=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, '#39 +
        #39')'
      
        '110188186=      FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G' +
        '_OFFICIAL = O.G_OFFICIAL,'
      '110188187=           ZAKAZ_DETAILS ZD,'
      '110188188=           G_CLIENT GC,'
      '110188189=           G_PAYMENT_TYPE P,'
      '110188190=           G_PRODUCT GP,'
      '110188191=           G_UNIT U,'
      '110188192=           P_REP_TREE TR'
      
        '110188193=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110188194=       AND Z.IS_SPISANIE IN (0,2)'
      '110188195=       AND Z.IS_RESERVE = 0'
      '110188196=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110188197=       AND Z.G_CLIENT = GC.G_CLIENT'
      '110188198=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110188199=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110188200=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110188201=       AND GP.G_UNIT = U.G_UNIT'
      '110188202=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110188203=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'Z.G_CLIENT, 1))'
      
        '110188204=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, GC.G_CLIENT_PARENT)'
      
        '110188205=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '110188206=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_ AND :TIME_BEGIN_ IS NULL)'
      '110188207=            OR'
      
        '110188208=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGI' +
        'N_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN' +
        '_ IS NOT NULL)'
      '110188209=           )/*'
      
        '110188210=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_E' +
        'ND_ AND :TIME_BEGIN_ IS NOT NULL)'
      '110188211=            OR'
      '110188212=            :TIME_BEGIN_ IS NULL)*/'
      
        '110188213=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT' +
        '||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110188214=             OR'
      '110188215=             (:G_CATEGORY_ IS NULL)'
      '110188216=           )'
      
        '110188217=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110188218=             OR'
      '110188219=            (:G_PRODUCT_ IS NULL)'
      '110188220=           )'
      '110188221=       AND ((EXISTS (SELECT 1'
      '110188222=                       FROM SKLAD S'
      '110188223=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110188224=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110188225=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110188226=              OR'
      '110188227=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110188228='
      '110188229=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '110188230=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :N' +
        'OMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '110188231=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, :' +
        'CLIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_,'
      '110188232=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME_'
      '110188233=  DO BEGIN'
      '110188234=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '110188235=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110188236=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110188237=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "' +
        'DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '110188238=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_' +
        ', :DISCOUNT_SUMM_ROLL_, 1);'
      '110188239='
      '110188240=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110188241=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110188242=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + ' +
        'DISCOUNT_SUMM_ROLL_;'
      '110188243=            SUMM_ROLL_ = 0;'
      '110188244=            DISCOUNT_SUMM_ROLL_ = 0;'
      '110188245=            I = I + 1;'
      '110188246=        END'
      '110188247='
      '110188248=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110188249=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE' +
        '", ROW)'
      '110188250=        VALUES (:I, :PATH_, 1);'
      '110188251=        I = I + 1;'
      '110188252=    END'
      '110188253='
      
        '110188254=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "' +
        'TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, D' +
        'ISCOUNT, SUMM,'
      
        '110188255=                                         DISCOUNT_SUMM' +
        ', CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME,'
      
        '110188256=                                         SUMM_CASH, SU' +
        'MM_NONCASH, OFFICIAL_NAME)'
      
        '110188257=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCOD' +
        'E_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUN' +
        'T_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '110188258=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0, ' +
        ':UNIT_NAME_,'
      
        '110188259=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAM' +
        'E_);'
      '110188260='
      '110188261=    I = I + 1;'
      '110188262=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '110188263=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOU' +
        'NT_SUMM_;'
      '110188264=    LAST_PATH_ = PATH_;'
      '110188265=  END'
      '110188266='
      '110188267=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110188268=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUM' +
        'M, DISCOUNT_SUMM, ROW)'
      
        '110188269=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOUN' +
        'T_SUMM_ROLL_, 1);'
      '110188270='
      '110188271=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110188272=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110188273=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_S' +
        'UMM_ROLL_;'
      '110188274='
      
        '110188275=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUM' +
        'M, DISCOUNT_SUMM, ROW)'
      
        '110188276=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL_' +
        ', 2);'
      '110188277='
      
        '110188278=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCL' +
        'ATUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CL' +
        'IENT_NAME,'
      
        '110188279=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME, SUMM_' +
        'CASH, SUMM_NONCASH, OFFICIAL_NAME'
      '110188280=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '110188281=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOME' +
        'NCLATUR_NUM, :TOVAR_NAME,'
      
        '110188282=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :D' +
        'ISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      
        '110188283=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCAS' +
        'H, :OFFICIAL_NAME'
      '110188284=  do suspend;'
      '110188285='
      '110188286=WHEN ANY DO BEGIN'
      '110188287=    Err_code = -20500;'
      
        '110188288=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110188289=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110188290=  END'
      '110188291=end'
      '110188292=;'
      '110188293='
      '110188294=ALTER PROCEDURE P_REP_ZAKAZI_LIST_CATEGORY('
      '110188295=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110188296=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110188297=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110188298=  DATE_BEGIN_ DATE,'
      '110188299=  DATE_END_ DATE,'
      '110188300=  TIME_BEGIN_ TIME,'
      '110188301=  TIME_END_ TIME,'
      '110188302=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110188303=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110188304=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '110188305=RETURNS ('
      '110188306=  PERIOD_ VARCHAR(40),'
      '110188307=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110188308=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110188309=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110188310=  ERR_CODE INTEGER,'
      '110188311=  ERR_MSG VARCHAR(1024))'
      '110188312=AS'
      
        '110188313=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_' +
        'LIST'#39';'
      '110188314=BEGIN'
      '110188315=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '110188316=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '110188317='
      
        '110188318=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110188319=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110188320='
      '110188321=  FOR SELECT SUM(ZD.SUMM)'
      '110188322=           ,SUM(ZD.DISCOUNT_SUMM)'
      '110188323=           ,TR.PATH'
      '110188324=      FROM ZAKAZ Z,'
      '110188325=           ZAKAZ_DETAILS ZD,'
      '110188326=           G_PRODUCT GP,'
      '110188327=           P_REP_TREE TR,'
      '110188328=           G_CLIENT GC'
      
        '110188329=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110188330=       AND Z.IS_SPISANIE IN (0,2)'
      '110188331=       AND Z.IS_RESERVE = 0'
      '110188332=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110188333=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110188334=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110188335=       AND Z.G_CLIENT = GC.G_CLIENT'
      '110188336=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110188337=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'Z.G_CLIENT, 1))'
      
        '110188338=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, GC.G_CLIENT_PARENT)'
      
        '110188339=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '110188340=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_ AND :TIME_BEGIN_ IS NULL)'
      '110188341=            OR'
      
        '110188342=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGI' +
        'N_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN' +
        '_ IS NOT NULL)'
      '110188343=           )'
      
        '110188344=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT' +
        '||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110188345=             OR'
      '110188346=             (:G_CATEGORY_ IS NULL)'
      '110188347=           )'
      '110188348=       AND ((EXISTS (SELECT 1'
      '110188349=                       FROM SKLAD S'
      '110188350=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110188351=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110188352=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110188353=              OR'
      '110188354=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110188355=     GROUP BY TR.PATH'
      '110188356=     ORDER BY TR.PATH'
      '110188357=     INTO :SUMM, :DISCOUNT_SUMM, :TOVAR_NAME'
      '110188358=  DO suspend;'
      '110188359='
      '110188360=WHEN ANY DO BEGIN'
      '110188361=    Err_code = -20500;'
      
        '110188362=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110188363=  END'
      '110188364=end'
      '110188365=;'
      '110188366='
      '110188367=ALTER PROCEDURE P_REP_ZAKAZI_LIST_TOVARY('
      '110188368=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110188369=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110188370=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110188371=  DATE_BEGIN_ DATE,'
      '110188372=  DATE_END_ DATE,'
      '110188373=  TIME_BEGIN_ TIME,'
      '110188374=  TIME_END_ TIME,'
      '110188375=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110188376=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110188377=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110188378=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '110188379=RETURNS ('
      '110188380=  PERIOD_ VARCHAR(40),'
      '110188381=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110188382=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110188383=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110188384=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110188385=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110188386=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110188387=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110188388=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110188389=  PATH BLOB SUB_TYPE 1,'
      '110188390=  ROW INTEGER,'
      '110188391=  ERR_CODE INTEGER,'
      '110188392=  ERR_MSG VARCHAR(1024))'
      '110188393=AS'
      
        '110188394=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_' +
        'LIST_TOVARY'#39';'
      '110188395=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110188396=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '110188397=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80;'
      
        '110188398=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ART' +
        'ICUL;'
      
        '110188399=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BAR' +
        'CODE;'
      
        '110188400=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110188401=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110188402=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.NAME;'
      
        '110188403=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      
        '110188404=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110188405=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM = 0;'
      
        '110188406=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110188407=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '110188408=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110188409=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM = 0;'
      
        '110188410=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110188411=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '110188412=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '110188413=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.' +
        'PATH = '#39#39';'
      '110188414=DECLARE VARIABLE I INTEGER = 1;'
      '110188415=BEGIN'
      '110188416=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '110188417=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '110188418='
      
        '110188419=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110188420=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110188421='
      '110188422=  FOR SELECT GP.ARTICUL'
      '110188423=             ,GP.BARCODE'
      '110188424=             ,GP.NAME'
      '110188425=             ,SUM(ZD.AMOUNT)'
      '110188426=             ,MIN(ZD.PRICE)'
      '110188427=             ,SUM(ZD.SUMM)'
      '110188428=             ,SUM(ZD.DISCOUNT_SUMM)'
      '110188429=             ,MIN(TR.PATH)'
      '110188430=      FROM ZAKAZ Z'
      '110188431=           ,ZAKAZ_DETAILS ZD'
      '110188432=           ,G_PRODUCT GP'
      '110188433=           ,P_REP_TREE TR'
      '110188434=           ,G_CLIENT GC'
      
        '110188435=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110188436=       AND Z.IS_SPISANIE IN (0,2)'
      '110188437=       AND Z.IS_RESERVE = 0'
      '110188438=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110188439=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110188440=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110188441=       AND Z.G_CLIENT = GC.G_CLIENT'
      '110188442=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110188443=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'Z.G_CLIENT, 1))'
      
        '110188444=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, GC.G_CLIENT_PARENT)'
      
        '110188445=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '110188446=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_ AND :TIME_BEGIN_ IS NULL)'
      '110188447=            OR'
      
        '110188448=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGI' +
        'N_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN' +
        '_ IS NOT NULL)'
      '110188449=           )'
      
        '110188450=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT' +
        '||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110188451=             OR'
      '110188452=             (:G_CATEGORY_ IS NULL)'
      '110188453=           )'
      
        '110188454=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110188455=             OR'
      '110188456=            (:G_PRODUCT_ IS NULL)'
      '110188457=           )'
      '110188458=       AND ((EXISTS (SELECT 1'
      '110188459=                       FROM SKLAD S'
      '110188460=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110188461=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110188462=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110188463=              OR'
      '110188464=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110188465=     GROUP BY GP.articul, GP.barcode, GP.NAME'
      '110188466=     ORDER BY MIN(TR.PATH), GP.NAME'
      
        '110188467=     INTO :ARTICUL, :BARCODE, :TOVAR_NAME, :AMOUNT, :P' +
        'RICE, :SUMM, :DISCOUNT_SUMM, :PATH'
      '110188468=  DO /*BEGIN'
      '110188469=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '110188470=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110188471=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110188472=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "' +
        'DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
