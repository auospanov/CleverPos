      '11063107=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063108=      VALUES (26, '#39#1087#1083#1072#1089#1090'.'#39', '#39#1087#1083#1072#1089#1090'.'#39');'
      '11063109=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063110=      VALUES (27, '#39#1082#1086#1088'.'#39', '#39#1082#1086#1088'.'#39');'
      '11063111=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063112=      VALUES (28, '#39#1087#1072#1082#39', '#39#1087#1072#1082#39');'
      '11063113=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063114=      VALUES (29, '#39#1090#1091#1073#1072#39', '#39#1090#1091#1073#1072#39');'
      '11063115=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063116=      VALUES (30, '#39#1087#1072#1088#39', '#39#1087#1072#1088#39');'
      '11063117=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063118=      VALUES (31, '#39#1090#1085#1075#39', '#39#1090#1085#1075#39');'
      '11063119=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063120=      VALUES (32, '#39#1089#1072#1083#1092#1077#1090'.'#39', '#39#1089#1072#1083#1092#1077#1090'.'#39');'
      '11063121=  END'
      '11063122='
      '11063123=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_UNIT TO 35'#39';'
      '11063124='
      '11063125=  IF (PRODUCTY_ = 1) THEN'
      '11063126=    INSERT INTO G_PRODUCT'
      '11063127=    SELECT *'
      '11063128=      FROM G_PRODUCT_FILL T'
      '11063129=     WHERE T.G_PRODUCT BETWEEN 22080 AND 36644'
      '11063130=    ORDER BY 1;'
      '11063131='
      '11063132=  IF (HIM_ = 1) THEN'
      '11063133=    INSERT INTO G_PRODUCT'
      '11063134=    SELECT *'
      '11063135=      FROM G_PRODUCT_FILL T'
      '11063136=     WHERE T.G_PRODUCT BETWEEN 36645 AND 39663'
      '11063137=    ORDER BY 1;'
      '11063138='
      '11063139=  IF (APTEKA_ = 1) THEN'
      '11063140=    INSERT INTO G_PRODUCT'
      '11063141=    SELECT *'
      '11063142=      FROM G_PRODUCT_FILL T'
      '11063143=     WHERE T.G_PRODUCT BETWEEN 53051 AND 64823'
      '11063144=    ORDER BY 1;'
      '11063145='
      
        '11063146=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_PRODUCT TO 649' +
        '00'#39';'
      
        '11063147=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_ARTICUL TO 29045' +
        #39';'
      '11063148=END'
      '11063149=;'
      '11063150='
      '11063151=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '11063152=RETURNS ('
      
        '11063153=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ_' +
        'DETAILS,'
      '11063154=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      '11063155=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT,'
      '11063156=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11063157=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11063158=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '11063159=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_PERC,'
      
        '11063160=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_SUMM,'
      '11063161=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '11063162=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '11063163=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11063164=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11063165=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11063166=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PRIC' +
        'E)'
      '11063167=AS'
      '11063168=begin'
      '11063169='
      '11063170=  FOR'
      '11063171=    SELECT T.ZAKAZ_DETAILS,'
      '11063172=           T.ZAKAZ,'
      '11063173=           T.G_PRODUCT,'
      '11063174=           T.AMOUNT,'
      '11063175=           T.PRICE,'
      '11063176=           T.SUMM,'
      '11063177=           T.DISCOUNT_PERC,'
      '11063178=           T.DISCOUNT_SUMM,'
      '11063179=           T.NDS,'
      '11063180=           T.NDS_SUMM,'
      '11063181=           P.NAME PRODUCT_NAME'
      '11063182=           ,P.BARCODE'
      '11063183=           ,P.ARTICUL'
      '11063184=           ,T.COST_PRICE'
      '11063185=      FROM ZAKAZ_DETAILS_TMP T,'
      '11063186=           G_PRODUCT P'
      '11063187=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11063188=    ORDER BY t.ZAKAZ_DETAILS'
      '11063189=    INTO :ZAKAZ_DETAILS,'
      '11063190=          :ZAKAZ,'
      '11063191=          :G_PRODUCT,'
      '11063192=          :AMOUNT,'
      '11063193=          :PRICE,'
      '11063194=          :SUMM,'
      '11063195=          :DISCOUNT_PERC,'
      '11063196=          :DISCOUNT_SUMM,'
      '11063197=          :NDS,'
      '11063198=          :NDS_SUMM,'
      '11063199=          :PRODUCT_NAME'
      '11063200=          ,:BARCODE'
      '11063201=          ,:ARTICUL'
      '11063202=          ,:COST_PRICE'
      '11063203=  DO'
      '11063204=    suspend;'
      '11063205=end'
      '11063206=;'
      
        '11063207=UPDATE SYSTEM_SETUP SET S_VALUE = 11063 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11063208=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11063209=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110640=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '110641=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110642=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110643=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110644=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110645=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110646=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110647=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110648=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110649=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1106410=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1106411=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1106412=RETURNS ('
      '1106413=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106414=  ERR_CODE INTEGER,'
      '1106415=  ERR_MSG VARCHAR(1024))'
      '1106416=AS'
      
        '1106417=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062#1045#1049' ' +
        #1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1106418=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045#1057#1058#1042 +
        #1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1106419=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040#1042#1051#1070 +
        ' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1106420=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' ' +
        #1057#1055#1048#1064#1045#1058#1057#1071
      '1106421='
      
        '1106422=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044 +
        #1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1106423=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1106424=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA_RE' +
        'AL'#39';'
      '1106425=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106426=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLA' +
        'D;'
      
        '1106427=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '1106428=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL.AM' +
        'OUNT_ALL;'
      
        '1106429=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SU' +
        'MM_PAYED;'
      
        '1106430=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_' +
        'REAL.ZAKAZ_NA_REAL;'
      
        '1106431=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1106432=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1106433=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1106434=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM' +
        ';'
      '1106435=BEGIN'
      '1106436='
      '1106437=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106438=    SELECT ID'
      '1106439=      FROM CUR_PARAMS'
      '1106440=     WHERE CUR_PARAMS = 2'
      '1106441=      INTO :G_TOCHKA_;'
      '1106442='
      
        '1106443=  --****************************************************' +
        '**********************************************'
      
        '1106444=  --****************************************************' +
        '**********************************************'
      '1106445=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106446=  --****************************************************' +
        '**********************************************'
      
        '1106447=  --****************************************************' +
        '**********************************************'
      '1106448=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1106449=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1055#1054#1058 +
        #1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1106450=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1106451=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1106452=            INTO :AMOUNT_,'
      '1106453=                 :G_PRODUCT_'
      '1106454=      DO BEGIN'
      '1106455=          UPDATE LT_SKLAD_PRODUCT L'
      '1106456=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1106457=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1106458=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106459=      END'
      '1106460='
      '1106461=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1106462=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAKAZ' +
        ', G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1106463=                                     DISCOUNT_SUMM, NDS,' +
        ' NDS_SUMM, COST_PRICE)'
      
        '1106464=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, PR' +
        'ICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1106465=             NDS_SUMM, COST_PRICE'
      '1106466=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1106467='
      '1106468=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1106469=                                  :Z_DATE_,'
      '1106470=                                  :Z_TIME_,'
      '1106471=                                  :G_CLIENT_,'
      '1106472=                                  :G_PAYMENT_TYPE_,'
      '1106473=                                  :OSNOVANIE_,'
      
        '1106474=                                  :IS_SPISANIE_,   -- :I' +
        'S_SPISANIE_'
      '1106475=                                  :NOTE_,'
      
        '1106476=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040
      
        '1106477=                                  :SUMM_FACT_,  -- '#1048' '#1057#1059#1052 +
        #1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1106478=                                  DECODE(G_PAYMENT_TYPE_' +
        ', 1, SUMM_FACT_, 0),'
      
        '1106479=                                  DECODE(G_PAYMENT_TYPE_' +
        ', 2, SUMM_FACT_, 0),'
      '1106480=                                  0, --SUMM_BONUS_'
      '1106481=                                  0, --SUMM_BONUS_GOT_'
      
        '1106482=                                  null,         -- '#1057#1058#1040#1058#1068 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1106483=                                  0,            -- '#1057#1059#1052#1052#1040 +
        ' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1106484=                                  0,    --BY_RECIPE'
      '1106485=                                  0     --IS_RESERVE'
      '1106486=                                  ,NULL  -- PAYMENTS_'
      '1106487=                                  ,0     --IS_MEBEL_'
      '1106488=                                  ,NULL  --DOSTAVSHIK_'
      '1106489=                                  ,NULL  --DELIVERY_DATE'
      '1106490=                                  ,NULL  --ADDRESS_'
      '1106491=                                  ,NULL  --PRICE_'
      '1106492=                                  ,UPLOAD_TO_EXT_APP_'
      '1106493=                                  )'
      '1106494=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1106495='
      '1106496=      if (ERR_CODE <> 0) then BEGIN'
      '1106497=        ERR_CODE = -20500;'
      '1106498=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1106499=        Exit;'
      '11064100=      END'
      '11064101='
      
        '11064102=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' '#1040#1055 +
        #1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' '#1055 +
        #1054#1044' '#1056#1045#1040#1051
      
        '11064103=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044#1040' ' +
        #1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '11064104=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054#1055#1051 +
        #1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042#1045#1044 +
        #1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '11064105=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063 +
        #1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '11064106=      UPDATE ZAKAZ'
      '11064107=         SET IS_SPISANIE = 2'
      '11064108=       WHERE ZAKAZ = :ZAKAZ_;'
      '11064109='
      
        '11064110=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '11064111=      FOR SELECT T.AMOUNT,'
      '11064112=                 T.SUMM,'
      '11064113=                 T.G_PRODUCT,'
      '11064114=                 T.ZAKAZ_NA_REAL,'
      '11064115=                 T.ZAKAZ_DETAILS'
      '11064116=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '11064117=            INTO :AMOUNT_,'
      '11064118=                 :Z_SUMM_,'
      '11064119=                 :G_PRODUCT_,'
      '11064120=                 :ZAKAZ_NA_REAL_,'
      '11064121=                 :ZAKAZ_DETAILS_'
      '11064122=      DO BEGIN'
      '11064123=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '11064124=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOUN' +
        'T_,'
      
        '11064125=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM_' +
        ','
      
        '11064126=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, CO' +
        'ALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + :' +
        'AMOUNT_, 1, 0)'
      '11064127=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '11064128='
      
        '11064129=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '11064130=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKAZ' +
        '_NA_REAL, ZAKAZ_DETAILS)'
      
        '11064131=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_NA' +
        '_REAL_, :ZAKAZ_DETAILS_);'
      '11064132=      END'
      '11064133=  END'
      '11064134=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11064135=  --***************************************************' +
        '***********************************************'
      
        '11064136=  --***************************************************' +
        '***********************************************'
      '11064137='
      
        '11064138=  --***************************************************' +
        '***********************************************'
      
        '11064139=  --***************************************************' +
        '***********************************************'
      '11064140=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11064141=  --***************************************************' +
        '***********************************************'
      
        '11064142=  --***************************************************' +
        '***********************************************'
      '11064143=  ELSE BEGIN'
      '11064144=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '11064145=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ZAK' +
        'AZ_DETAILS - ZAKAZ_REAL'
      
        '11064146=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '11064147=      FOR SELECT T.AMOUNT,'
      '11064148=                 T.SUMM,'
      '11064149=                 T.G_PRODUCT,'
      '11064150=                 T.ZAKAZ_NA_REAL,'
      '11064151=                 T.ZAKAZ_DETAILS'
      '11064152=                 ,T.PRICE'
      '11064153=                 ,T.NDS'
      '11064154=                 ,T.NDS_SUMM'
      '11064155=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '11064156=            INTO :AMOUNT_,'
      '11064157=                 :Z_SUMM_,'
      '11064158=                 :G_PRODUCT_,'
      '11064159=                 :ZAKAZ_NA_REAL_,'
      '11064160=                 :ZAKAZ_DETAILS_'
      '11064161=                 ,:PRICE_'
      '11064162=                 ,:NDS_'
      '11064163=                 ,:NDS_SUMM_'
      '11064164=      DO BEGIN'
      
        '11064165=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '11064166=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '11064167='
      
        '11064168=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKAZ' +
        '_NA_REAL, SKLAD)'
      
        '11064169=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_NA' +
        '_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '11064170='
      '11064171=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '11064172=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_RE' +
        'TURNED, 0) + :AMOUNT_,'
      
        '11064173=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RETU' +
        'RNED, 0) + :Z_SUMM_,'
      
        '11064174=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, CO' +
        'ALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + :' +
        'AMOUNT_, 1, 0)'
      '11064175=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '11064176=      END'
      '11064177='
      '11064178=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '11064179=                                  :Z_DATE_,'
      '11064180=                                  :Z_TIME_,'
      '11064181=                                  :G_CLIENT_,'
      '11064182=                                  :G_PAYMENT_TYPE_,'
      '11064183=                                  :OSNOVANIE_,'
      '11064184=                                  :NOTE_,'
      
        '11064185=                                  2,        --:IS_VOZVR' +
        'AT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-'#1050 +
        #1059
      '11064186=                                  :SUMM_,'
      '11064187=                                  :SUMM_FACT_,'
      
        '11064188=                                  NULL,     --:G_PRIHOD' +
        '_,'
      
        '11064189=                                  NULL      --:SUMM_PRI' +
        'HOD_'
      '11064190=                                  ,NULL     -- PAYMENTS'
      
        '11064191=                                  ) RETURNING_VALUES :S' +
        'KLAD_, :ERR_CODE, :ERR_MSG;'
      '11064192='
      '11064193=      if (ERR_CODE <> 0) then BEGIN'
      '11064194=        ERR_CODE = -20500;'
      '11064195=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '11064196=        Exit;'
      '11064197=      END'
      '11064198=  END'
      '11064199=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11064200=  --***************************************************' +
        '***********************************************'
      
        '11064201=  --***************************************************' +
        '***********************************************'
      '11064202='
      '11064203=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '11064204=END'
      '11064205=;'
      
        '11064206=UPDATE SYSTEM_SETUP SET S_VALUE = 11064 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11064207=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11064208=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110650=CREATE PROCEDURE UPDATE_ZDETAILS_TMP_CHANGE_CL('
      
        '110651=  CLIENT_SKIDKA_ /* TYPE OF COLUMN G_CLIENT.SKIDKA */ NUM' +
        'ERIC(15,2),'
      
        '110652=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGINT' +
        ')'
      '110653=AS'
      '110654=BEGIN'
      '110655=  EXIT;'
      '110656=END'
      '110657=;'
      '110658='
      '110659='
      
        '1106510=/*******************************************************' +
        '***********************/'
      
        '1106511=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1106512=/*******************************************************' +
        '***********************/'
      '1106513=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '1106514=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106515=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106516=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '1106517=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106518=  PREFIX_ VARCHAR(2))'
      '1106519=RETURNS ('
      '1106520=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1106521=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT' +
        '_PAR,'
      '1106522=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1106523=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1106524=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106525=  ERR_CODE INTEGER,'
      '1106526=  ERR_MSG VARCHAR(1024))'
      '1106527=AS'
      
        '1106528=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PRODUCT' +
        '_BY_BARCODE'#39';'
      '1106529=BEGIN'
      '1106530='
      '1106531=  IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '1106532=    ERR_CODE = -20500;'
      
        '1106533=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093#1082#1086#1076' '#1087#1091 +
        #1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1106534=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106535=    EXIT;'
      '1106536=  END'
      '1106537='
      
        '1106538=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) THEN' +
        ' BEGIN'
      '1106539=        SELECT T.G_PRODUCT_PAR,'
      '1106540=               T.G_PRODUCT,'
      '1106541=               T.PRICE,'
      '1106542=               T.VOLUME_PRICE'
      '1106543=          FROM G_PRODUCT T'
      
        '1106544=          WHERE SUBSTRING(T.BARCODE FROM 3 FOR 5) = SUBS' +
        'TRING(:BARCODE_ FROM 3 FOR 5)'
      '1106545=            AND T.IS_ACTIVE = 1'
      '1106546=          INTO :G_PRODUCT_CATEGORY_,'
      '1106547=               :G_PRODUCT_,'
      '1106548=               :PRICE_,'
      '1106549=               :VOLUME_PRICE_;'
      '1106550='
      
        '1106551=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM 8 F' +
        'OR 5) AS NUMERIC)/1000.00, 2);'
      '1106552=    END ELSE'
      '1106553=        SELECT T.G_PRODUCT_PAR,'
      '1106554=               T.G_PRODUCT,'
      '1106555=               T.PRICE,'
      '1106556=               T.VOLUME_PRICE'
      '1106557=          FROM G_PRODUCT T'
      '1106558=          WHERE T.BARCODE = :BARCODE_'
      '1106559=            AND T.IS_ACTIVE = 1'
      '1106560=          INTO :G_PRODUCT_CATEGORY_,'
      '1106561=               :G_PRODUCT_,'
      '1106562=               :PRICE_,'
      '1106563=               :VOLUME_PRICE_;'
      '1106564='
      '1106565=    if (ROW_COUNT = 0) then BEGIN'
      
        '1106566=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' '#1044#1054#1055 +
        #1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '1106567=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) TH' +
        'EN'
      '1106568=          SELECT T.G_PRODUCT_PAR,'
      '1106569=                 T.G_PRODUCT,'
      '1106570=                 T.PRICE,'
      '1106571=                 T.VOLUME_PRICE'
      '1106572=            FROM G_PRODUCT T, LT_BARCODE D'
      '1106573=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1106574=              AND T.IS_ACTIVE = 1'
      
        '1106575=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) = SU' +
        'BSTRING(:BARCODE_ FROM 3 FOR 5)'
      '1106576=            INTO'
      '1106577=                :G_PRODUCT_CATEGORY_,'
      '1106578=                :G_PRODUCT_,'
      '1106579=                :PRICE_,'
      '1106580=                :VOLUME_PRICE_;'
      '1106581=      ELSE'
      '1106582=          SELECT T.G_PRODUCT_PAR,'
      '1106583=                 T.G_PRODUCT,'
      '1106584=                 T.PRICE,'
      '1106585=                 T.VOLUME_PRICE'
      '1106586=            FROM G_PRODUCT T, LT_BARCODE D'
      '1106587=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1106588=              AND T.IS_ACTIVE = 1'
      '1106589=              AND D.BARCODE = :BARCODE_'
      '1106590=            INTO'
      '1106591=                :G_PRODUCT_CATEGORY_,'
      '1106592=                :G_PRODUCT_,'
      '1106593=                :PRICE_,'
      '1106594=                :VOLUME_PRICE_;'
      '1106595='
      '1106596=      if (ROW_COUNT = 0) then BEGIN'
      '1106597=          ERR_CODE = -20500;'
      
        '1106598=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088 +
        ' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:ER' +
        'R_MSG);'
      '1106599=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11065100=          EXIT;'
      '11065101=      END'
      '11065102=    END'
      '11065103='
      
        '11065104=  /*END ELSE if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then' +
        ' BEGIN'
      '11065105=    SELECT T.G_PRODUCT_PAR,'
      '11065106=        T.G_PRODUCT,'
      '11065107=        T.PRICE,'
      '11065108=        T.VOLUME_PRICE'
      '11065109=    FROM G_PRODUCT T'
      '11065110=    WHERE T.ARTICUL = :ARTICUL_'
      '11065111=    INTO'
      '11065112=        G_PRODUCT_CATEGORY_,'
      '11065113=        :G_PRODUCT_,'
      '11065114=        :PRICE_,'
      '11065115=        :VOLUME_PRICE_;'
      '11065116='
      '11065117=    if (ROW_COUNT = 0) then BEGIN'
      '11065118=      ERR_CODE = -20500;'
      
        '11065119=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      '11065120=      ERR_MSG = PROCNAME||ERR_MSG;'
      '11065121=      EXIT;'
      '11065122=    END'
      '11065123='
      
        '11065124=  END ELSE if (CHAR_LENGTH(TRIM(:NOMER_)) > 0) then BEG' +
        'IN'
      '11065125=    SELECT T.G_PRODUCT_PAR,'
      '11065126=        T.G_PRODUCT,'
      '11065127=        T.PRICE,'
      '11065128=        T.VOLUME_PRICE'
      '11065129=    FROM G_PRODUCT T'
      '11065130=    WHERE T.NOMENCLATUR_NUM = :NOMER_'
      '11065131=    INTO'
      '11065132=        G_PRODUCT_CATEGORY_,'
      '11065133=        :G_PRODUCT_,'
      '11065134=        :PRICE_,'
      '11065135=        :VOLUME_PRICE_;'
      '11065136='
      '11065137=    if (ROW_COUNT = 0) then BEGIN'
      '11065138=      ERR_CODE = -20500;'
      
        '11065139=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1085#1086#1084#1077#1085#1082#1083#1072#1090#1091#1088#1085#1099#1084' '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMER_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '11065140=      ERR_MSG = PROCNAME||ERR_MSG;'
      '11065141=      EXIT;'
      '11065142=    END'
      '11065143='
      
        '11065144=  END ELSE if (CHAR_LENGTH(TRIM(:NAME_)) > 0) then BEGI' +
        'N'
      
        '11065145=      --'#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MAX '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042#1044#1056#1059#1043' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1057' '#1058#1040#1050#1048#1052' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1052
      '11065146=      EXECUTE STATEMENT'
      
        '11065147=      '#39'SELECT G_PRODUCT, G_PRODUCT_PAR, PRICE FROM G_PR' +
        'ODUCT '#39'||'
      '11065148=      '#39' WHERE G_PRODUCT = '#39'||'
      
        '11065149=                  '#39'(SELECT MAX(G_PRODUCT) FROM G_PRODUC' +
        'T '#39'||'
      
        '11065150=                  '#39' WHERE UPPER(NAME) LIKE '#39#39'%'#39'||:NAME_' +
        '||'#39'%'#39#39')'#39
      '11065151=      INTO :G_PRODUCT_, :G_PRODUCT_CATEGORY_, :PRICE_ ;'
      '11065152=      if (G_PRODUCT_ = 0) then BEGIN'
      '11065153=          ERR_CODE = -20500;'
      
        '11065154=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1077#1084' "'#39'||NAME_||'#39'" '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '11065155=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11065156=          EXIT;'
      '11065157=      END'
      '11065158=  END  */'
      '11065159=end'
      '11065160=;'
      '11065161='
      '11065162=ALTER PROCEDURE G_INS_G_DISCOUNT('
      
        '11065163=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11065164=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '11065165=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11065166=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11065167=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11065168=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11065169=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11065170=  G_TOCHKA_ BLOB SUB_TYPE 1)'
      '11065171=RETURNS ('
      '11065172=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11065173=  ERR_CODE INTEGER,'
      '11065174=  ERR_MSG VARCHAR(1024))'
      '11065175=AS'
      '11065176=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11065177=DECLARE VARIABLE G_PRODUCT_REC_ TYPE OF COLUMN G_DISCOU' +
        'NT.G_PRODUCT;'
      
        '11065178=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_DISCOUNT.G' +
        '_PRODUCT;'
      
        '11065179=DECLARE VARIABLE SKIDKA_PROC_R_ TYPE OF COLUMN G_DISCOU' +
        'NT.SKIDKA_PROC; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      
        '11065180=DECLARE VARIABLE SKIDKA_SUM_R_ TYPE OF COLUMN G_DISCOUN' +
        'T.SKIDKA_SUM; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      
        '11065181=DECLARE VARIABLE G_TOCHKA_ID_ TYPE OF COLUMN G_TOCHKA.G' +
        '_TOCHKA;'
      '11065182=BEGIN'
      '11065183='
      '11065184=    FOR SELECT NULL G_TOCHKA'
      '11065185=          FROM RDB$DATABASE'
      '11065186=         WHERE :G_TOCHKA_ IS NULL'
      '11065187=        UNION ALL'
      '11065188=        SELECT G.G_TOCHKA'
      '11065189=          FROM G_TOCHKA G'
      
        '11065190=         WHERE :G_TOCHKA_ CONTAINING '#39'~'#39'||G.G_TOCHKA||'#39 +
        '~'#39
      '11065191=        ORDER BY 1'
      '11065192=          INTO :G_TOCHKA_ID_'
      '11065193=    DO BEGIN'
      '11065194=            FOR SELECT G.G_PRODUCT,'
      '11065195=                       G.PRICE'
      '11065196=                  FROM G_PRODUCT G'
      
        '11065197=                 WHERE G.G_PRODUCT_PAR = DECODE(:G_PROD' +
        'UCT_PAR_, -1, G.G_PRODUCT_PAR, :G_PRODUCT_PAR_)'
      
        '11065198=                   AND G.G_PRODUCT = COALESCE(:G_PRODUC' +
        'T_, G.G_PRODUCT)'
      '11065199=                   AND G.IS_ACTIVE = 1'
      '11065200=                   AND G.IS_CATEGORY = 0'
      '11065201=                   AND G.PRICE > 0'
      '11065202=                  INTO :G_PRODUCT_REC_,'
      '11065203=                       :PRICE_REC_'
      '11065204=            DO BEGIN'
      
        '11065205=                -- '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1045#1050#1059#1065#1040#1071' '#1057#1050#1048#1044#1050#1040' '#1048' '#1048#1044#1045#1058' '#1043#1056#1059#1055 +
        #1055#1054#1042#1054#1045' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1045' '#1057#1050#1048#1044#1050#1048', '#1058#1054' '#1040#1042#1058#1054#1052#1040#1058#1054#1052' '#1059#1041#1048#1056#1040#1070' '#1057#1050#1048#1044#1050#1059', '#1048' '#1047#1040#1052#1045#1053#1071#1070' '#1053 +
        #1054#1042#1054#1049
      
        '11065206=                -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1054#1044#1048#1053#1054#1063#1053#1054#1045' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1045', '#1058'.'#1045'.' +
        ' '#1055#1054' '#1050#1054#1053#1050#1056#1045#1058#1053#1054#1052#1059' '#1058#1054#1042#1040#1056#1059', '#1058#1054' '#1054#1064#1048#1041#1050#1040
      '11065207=                if (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11065208=                  DELETE FROM G_DISCOUNT'
      
        '11065209=                   WHERE COALESCE(DATE_BEGIN, CURRENT_D' +
        'ATE) <= CURRENT_DATE AND COALESCE(DATE_END, CURRENT_DATE) >= CUR' +
        'RENT_DATE'
      '11065210=                     AND G_PRODUCT = :G_PRODUCT_REC_'
      '11065211=                     AND G_TOCHKA = :G_TOCHKA_ID_;'
      '11065212=                ELSE BEGIN'
      '11065213=                    SELECT COUNT(*)'
      '11065214=                      FROM G_DISCOUNT'
      '11065215=                     WHERE G_PRODUCT = :G_PRODUCT_REC_'
      
        '11065216=                       AND COALESCE(DATE_BEGIN, CURRENT' +
        '_DATE) <= CURRENT_DATE'
      
        '11065217=                       AND COALESCE(DATE_END, CURRENT_D' +
        'ATE) >= CURRENT_DATE'
      
        '11065218=                       AND ((G_TOCHKA = COALESCE(:G_TOC' +
        'HKA_ID_, 0))'
      '11065219=                            OR'
      
        '11065220=                            (G_TOCHKA IS NOT NULL AND :' +
        'G_TOCHKA_ID_ IS NULL)'
      '11065221=                            OR'
      '11065222=                            (G_TOCHKA IS NULL)'
      '11065223=                           )'
      '11065224=                      INTO CNT_;'
      '11065225='
      '11065226=                    IF (CNT_ <> 0) THEN BEGIN'
      '11065227=                      ERR_CODE = -20500;'
      
        '11065228=                      EXECUTE PROCEDURE GET_ERR_MSG(ERR' +
        '_CODE, '#39#1053#1072' '#1076#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39') RETURNING' +
        '_VALUES (:ERR_MSG);'
      '11065229=                      EXIT;'
      '11065230=                    END'
      '11065231=                END'
      '11065232='
      
        '11065233=                -- '#1055#1056#1048' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1071' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' '#1055 +
        #1054#1051#1059#1063#1040#1045#1058#1057#1071' '#1063#1058#1054' '#1054#1044#1053#1054' '#1048#1047' '#1055#1054#1051#1045#1049' - '#1055#1059#1057#1058#1054#1045
      '11065234=                SKIDKA_PROC_R_ = SKIDKA_PROC_;'
      '11065235=                SKIDKA_SUM_R_  = SKIDKA_SUM_;'
      '11065236=                IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '11065237=                  IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '11065238=                    SKIDKA_PROC_R_ = ROUND(SKIDKA_SUM_ ' +
        '* 100 / PRICE_REC_ , 2);'
      '11065239=                  IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '11065240=                    SKIDKA_SUM_R_ = ROUND(PRICE_REC_ * ' +
        'SKIDKA_PROC_ / 100 , 2);'
      '11065241=                END'
      '11065242='
      
        '11065243=                INSERT INTO G_DISCOUNT (G_DISCOUNT, G_P' +
        'RODUCT, DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA_S' +
        'UM, G_TOCHKA)'
      
        '11065244=                VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G_P' +
        'RODUCT_REC_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :SKI' +
        'DKA_PROC_R_, :SKIDKA_SUM_R_'
      '11065245=                        ,:G_TOCHKA_ID_)'
      '11065246=                RETURNING G_DISCOUNT'
      '11065247=                INTO :G_DISCOUNT_;'
      '11065248=            END'
      '11065249=    END'
      '11065250=end'
      '11065251=;'
      '11065252='
      '11065253=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '11065254=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11065255=  ARTICUL_ VARCHAR(30),'
      '11065256=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11065257=  BARCODE_ VARCHAR(30),'
      '11065258=  NAME_ VARCHAR(500),'
      '11065259=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11065260=  PRICE_ NUMERIC(15,2),'
      '11065261=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11065262=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11065263=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11065264=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11065265=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11065266=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11065267=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11065268=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11065269=  IS_CATEGORY_ INTEGER,'
      '11065270=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '11065271=RETURNS ('
      '11065272=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11065273=  ERR_CODE INTEGER,'
      '11065274=  ERR_MSG VARCHAR(1024))'
      '11065275=AS'
      
        '11065276=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODUC' +
        'T'#39';'
      '11065277=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11065278=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11065279=begin'
      
        '11065280=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11065281=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '11065282=        SELECT COUNT(*)'
      '11065283=          FROM G_PRODUCT G'
      
        '11065284=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11065285=           AND TRIM(G.ARTICUL) <> '#39#39
      '11065286=           AND G.IS_ACTIVE = 1'
      '11065287=          INTO :CNT_;'
      '11065288='
      '11065289=        IF (CNT_ > 0) THEN BEGIN'
      '11065290=          ERR_CODE = -20500;'
      
        '11065291=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '11065292=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11065293=          EXIT;'
      '11065294=        END'
      '11065295=    end'
      '11065296='
      '11065297=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '11065298=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then ' +
        'begin'
      '11065299=        SELECT COUNT(*)'
      '11065300=          FROM G_PRODUCT G'
      
        '11065301=         WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:N' +
        'OMENCLATUR_NUM_))'
      '11065302=           AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11065303=           AND G.IS_ACTIVE = 1'
      '11065304=        INTO :CNT_;'
      '11065305=        IF (CNT_ > 0) THEN BEGIN'
      '11065306=          ERR_CODE = -20500;'
      
        '11065307=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RE' +
        'TURNING_VALUES (:ERR_MSG);'
      '11065308=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11065309=          EXIT;'
      '11065310=        END'
      '11065311=    end'
      '11065312='
      '11065313=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11065314=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11065315=        SELECT COUNT(*)'
      '11065316=          FROM G_PRODUCT G'
      
        '11065317=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_)' +
        ')'
      '11065318=           AND TRIM(G.BARCODE) <> '#39#39
      '11065319=           AND G.IS_ACTIVE = 1'
      '11065320=          INTO :CNT_;'
      '11065321='
      '11065322=        IF (CNT_ = 0) then'
      '11065323=          SELECT COUNT(*)'
      '11065324=            FROM G_PRODUCT G, LT_BARCODE L'
      '11065325=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11065326=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11065327=             AND TRIM(L.BARCODE) <> '#39#39
      '11065328=             AND G.IS_ACTIVE = 1'
      '11065329=            INTO :CNT_;'
      '11065330='
      '11065331=        IF (CNT_ > 0) THEN BEGIN'
      '11065332=          ERR_CODE = -20500;'
      
        '11065333=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11065334=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11065335=          EXIT;'
      '11065336=        END'
      '11065337=    end'
      '11065338='
      
        '11065339=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PRI' +
        'CE,'
      
        '11065340=                           IS_CATEGORY, PACK_AMOUNT, MF' +
        '_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM' +
        ')'
      
        '11065341=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_, ' +
        ':ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRIC' +
        'E_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '11065342=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROSS' +
        'CODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_)'
      '11065343=    RETURNING G_PRODUCT'
      '11065344=    INTO :G_PRODUCT_;'
      '11065345='
      '11065346=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '11065347=    if (:IS_CATEGORY_ = 0) then begin'
      
        '11065348=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11065349=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '11065350='
      '11065351=        INSERT INTO LT_BARCODE'
      
        '11065352=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT' +
        '_BARCODE_TMP;'
      '11065353='
      
        '11065354=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086 +
        #1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '11065355=        INSERT into G_PRODUCT_IMAGE'
      
        '11065356=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYPE' +
        ' from G_PRODUCT_IMAGE_TMP;'
      '11065357='
      
        '11065358=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089#1090 +
        #1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '11065359=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091#1082 +
        #1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '11065360=        IF (is_kit_ > 0) THEN begin'
      '11065361=            INSERT INTO G_PRODUCT_KIT'
      
        '11065362=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP;'
      '11065363='
      '11065364=            if (is_kit_ = 1) then begin'
      
        '11065365=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE' +
        ')/K.amount)'
      '11065366=                  FROM G_PRODUCT_KIT K,'
      '11065367=                       LT_SKLAD_PRODUCT L'
      '11065368=                 WHERE K.g_product = :G_PRODUCT_'
      '11065369=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11065370=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11065371=                 GROUP BY K.G_PRODUCT'
      '11065372=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11065373='
      '11065374=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11065375=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_S' +
        'OSTAV_AMOUNT_, 0)'
      '11065376=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11065377=            end'
      '11065378=        END'
      '11065379=    END'
      '11065380=end'
      '11065381=;'
      '11065382='
      '11065383=ALTER PROCEDURE G_UPD_G_DISCOUNT('
      '11065384=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11065385=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      
        '11065386=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11065387=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11065388=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11065389=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11065390=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '11065391=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11065392=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11065393=  G_TOCHKA_ BLOB SUB_TYPE 1)'
      '11065394=RETURNS ('
      '11065395=  ERR_CODE INTEGER,'
      '11065396=  ERR_MSG VARCHAR(1024))'
      '11065397=AS'
      '11065398=/*'
      
        '11065399='#1059#1044#1040#1051#1071#1070' '#1058#1045#1050#1059#1065#1059#1070' '#1040#1050#1062#1048#1070' '#1048' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1067#1045', '#1045#1057#1051#1048' '#1044#1054' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042 +
        #1040#1053#1048#1071':'
      
        '11065400=1) '#1040#1050#1062#1048#1071' '#1056#1040#1057#1055#1056#1054#1057#1058#1056#1040#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1054#1044#1053#1059' '#1058#1054#1063#1050#1059', '#1040' '#1055#1054#1057#1051#1045' '#1057#1058#1040#1051#1040' ' +
        #1053#1040' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      
        '11065401=2) '#1040#1050#1062#1048#1071' '#1056#1040#1057#1055#1056#1054#1057#1058#1056#1040#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1042#1057#1045' '#1058#1054#1063#1050#1048' ('#1058'.'#1045'. '#1041#1067#1051#1040' '#1054#1044#1053#1040' ' +
        #1047#1040#1055#1048#1057#1068' '#1057' G_TOCHKA = NULL), '#1040' '#1047#1040#1058#1045#1052' '#1057#1058#1040#1051#1040' '#1053#1045' '#1053#1040' '#1042#1057#1045' '#1058#1054#1063#1050#1048
      '11065402=*/'
      '11065403=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11065404=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_PRODUCT.PR' +
        'ICE;'
      
        '11065405=DECLARE VARIABLE G_TOCHKA_ID_ TYPE OF COLUMN G_TOCHKA.G' +
        '_TOCHKA;'
      '11065406=DECLARE VARIABLE POSITION_ INTEGER;'
      '11065407=BEGIN'
      
        '11065408=    -- '#1058#1040#1050#1048#1052' '#1054#1041#1056#1040#1047#1054#1052' '#1071' '#1059#1047#1053#1040#1070' '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1063#1045#1050' '#1055#1056#1048#1057#1051#1040#1051#1048' '#1057' '#1045 +
        #1050#1047#1045#1064#1053#1048#1050#1040
      
        '11065409=    SELECT POSITION('#39'~'#39', :G_TOCHKA_, POSITION('#39'~'#39', :G_T' +
        'OCHKA_, POSITION('#39'~'#39', :G_TOCHKA_)+1)+1)'
      '11065410=      FROM rdb$DATABASE'
      '11065411=      INTO :POSITION_;'
      '11065412='
      '11065413=    IF (POSITION_ > 0 OR G_TOCHKA_ IS NULL) THEN'
      
        '11065414=      DELETE FROM G_DISCOUNT G WHERE G.G_DISCOUNT = :G_' +
        'DISCOUNT_;'
      '11065415='
      '11065416=    FOR SELECT NULL G_TOCHKA'
      '11065417=          FROM RDB$DATABASE'
      '11065418=         WHERE :G_TOCHKA_ IS NULL'
      '11065419=        UNION ALL'
      '11065420=        SELECT G.G_TOCHKA'
      '11065421=          FROM G_TOCHKA G'
      
        '11065422=         WHERE :G_TOCHKA_ CONTAINING '#39'~'#39'||G.G_TOCHKA||'#39 +
        '~'#39
      '11065423=        ORDER BY 1'
      '11065424=          INTO :G_TOCHKA_ID_'
      '11065425=    DO BEGIN'
      '11065426=        SELECT COUNT(*)'
      '11065427=          FROM G_DISCOUNT'
      '11065428=         WHERE G_PRODUCT = :G_PRODUCT_'
      
        '11065429=           AND COALESCE(DATE_BEGIN, CURRENT_DATE) <= CU' +
        'RRENT_DATE'
      
        '11065430=           AND COALESCE(DATE_END, CURRENT_DATE) >= CURR' +
        'ENT_DATE'
      '11065431=           AND G_DISCOUNT <> :G_DISCOUNT_'
      '11065432=           AND ((G_TOCHKA = COALESCE(:G_TOCHKA_ID_, 0))'
      '11065433=                OR'
      
        '11065434=                (G_TOCHKA IS NOT NULL AND :G_TOCHKA_ID_' +
        ' IS NULL)'
      '11065435=                OR'
      '11065436=                (G_TOCHKA IS NULL)'
      '11065437=               )'
      '11065438=          INTO CNT_;'
      '11065439='
      '11065440=        IF (CNT_ <> 0) THEN BEGIN'
      '11065441=          ERR_CODE = -20500;'
      
        '11065442=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1072' '#1076 +
        #1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072' '#1085#1072' '#1076#1072#1085#1085#1086#1081' '#1090#1086#1088#1075#1086#1074#1086#1081' '#1090#1086#1095#1082#1077 +
        '!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11065443=          EXIT;'
      '11065444=        END'
      '11065445='
      '11065446=        PRICE_REC_ = PRICE_;'
      
        '11065447=        IF (SKIDKA_PROC_ IS NULL OR SKIDKA_SUM_ IS NULL' +
        ') THEN BEGIN'
      '11065448=          SELECT G.PRICE'
      '11065449=            FROM G_PRODUCT G'
      '11065450=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11065451=            INTO :PRICE_REC_;'
      '11065452='
      '11065453=          IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '11065454=            SKIDKA_PROC_ = ROUND(SKIDKA_SUM_ * 100 / PR' +
        'ICE_REC_ , 2);'
      '11065455=          IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '11065456=            SKIDKA_SUM_ = ROUND(PRICE_REC_ * SKIDKA_PRO' +
        'C_ / 100 , 2);'
      '11065457=        END'
      '11065458='
      
        '11065459=        -- '#1045#1057#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1058#1056#1054#1050' '#1053#1045' '#1055#1054#1052#1045#1053#1071#1051#1054#1057#1068' '#1044#1054' '#1048' '#1055#1054#1057 +
        #1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071
      '11065460=        IF (POSITION_ = 0) THEN'
      '11065461=            UPDATE G_DISCOUNT'
      '11065462=            SET G_PRODUCT = :G_PRODUCT_,'
      '11065463=                DATE_BEGIN = :DATE_BEGIN_,'
      '11065464=                DATE_END = :DATE_END_,'
      '11065465=                NAME = :NAME_,'
      '11065466=                PRICE = :PRICE_REC_,'
      '11065467=                SKIDKA_PROC = :SKIDKA_PROC_,'
      '11065468=                SKIDKA_SUM = :SKIDKA_SUM_,'
      '11065469=                G_TOCHKA = :G_TOCHKA_ID_'
      '11065470=            WHERE (G_DISCOUNT = :G_DISCOUNT_);'
      '11065471='
      
        '11065472=        -- '#1045#1057#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1058#1056#1054#1050' '#1055#1054#1052#1045#1053#1071#1051#1054#1057#1068' '#1044#1054' '#1048' '#1055#1054#1057#1051#1045' ' +
        #1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071
      '11065473=        ELSE'
      
        '11065474=            INSERT INTO G_DISCOUNT (G_DISCOUNT, G_PRODU' +
        'CT, DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA_SUM, ' +
        'G_TOCHKA)'
      
        '11065475=            VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G_PRODU' +
        'CT_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :SKIDKA_PROC' +
        '_, :SKIDKA_SUM_'
      '11065476=                    ,:G_TOCHKA_ID_);'
      '11065477=    END'
      '11065478=END'
      '11065479=;'
      '11065480='
      '11065481=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '11065482=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '11065483=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11065484=  ARTICUL_ VARCHAR(30),'
      '11065485=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11065486=  BARCODE_ VARCHAR(30),'
      '11065487=  NAME_ VARCHAR(500),'
      '11065488=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11065489=  PRICE_ NUMERIC(15,2),'
      '11065490=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11065491=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11065492=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11065493=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11065494=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11065495=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11065496=  IS_CATEGORY_ INTEGER,'
      '11065497=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11065498=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11065499=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '11065500=RETURNS ('
      '11065501=  ERR_CODE INTEGER,'
      '11065502=  ERR_MSG VARCHAR(1024))'
      '11065503=AS'
      
        '11065504=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODUC' +
        'T'#39';'
      '11065505=DECLARE VARIABLE N_CURR_ INTEGER;'
      '11065506=DECLARE VARIABLE N INTEGER;'
      '11065507=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11065508=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11065509=begin'
      
        '11065510=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11065511=    SELECT COUNT(*)'
      '11065512=      FROM G_PRODUCT G'
      '11065513=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '11065514=       AND TRIM(G.ARTICUL) <> '#39#39
      '11065515=       AND TRIM(:ARTICUL_) <> '#39#39
      '11065516=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '11065517=       AND G.IS_ACTIVE = 1'
      '11065518=      INTO :CNT_;'
      '11065519='
      '11065520=    IF (CNT_ > 0) THEN BEGIN'
      '11065521=      ERR_CODE = -20500;'
      
        '11065522=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' ' +
        #1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '11065523=      EXIT;'
      '11065524=    END'
      '11065525='
      '11065526=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11065527=    SELECT COUNT(*)'
      '11065528=      FROM G_PRODUCT G'
      
        '11065529=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOMEN' +
        'CLATUR_NUM_))'
      '11065530=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11065531=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '11065532=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '11065533=       AND G.IS_ACTIVE = 1'
      '11065534=    INTO :CNT_;'
      '11065535=    IF (CNT_ > 0) THEN BEGIN'
      '11065536=      ERR_CODE = -20500;'
      
        '11065537=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLAT' +
        'UR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '11065538=      EXIT;'
      '11065539=    END'
      '11065540='
      '11065541=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11065542=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11065543=        SELECT COUNT(*)'
      '11065544=          FROM G_PRODUCT G'
      
        '11065545=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_)' +
        ')'
      '11065546=           AND TRIM(G.BARCODE) <> '#39#39
      '11065547=           AND TRIM(:BARCODE_) <> '#39#39
      '11065548=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '11065549=           AND G.IS_ACTIVE = 1'
      '11065550=          INTO :CNT_;'
      '11065551='
      '11065552=        IF (CNT_ = 0) then'
      '11065553=          SELECT COUNT(*)'
      '11065554=            FROM G_PRODUCT G, LT_BARCODE L'
      '11065555=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11065556=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11065557=             AND TRIM(L.BARCODE) <> '#39#39
      '11065558=             AND G.IS_ACTIVE = 1'
      '11065559=            INTO :CNT_;'
      '11065560='
      '11065561=        IF (CNT_ > 0) THEN BEGIN'
      '11065562=          ERR_CODE = -20500;'
      
        '11065563=          ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_|' +
        '|'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '11065564=          EXIT;'
      '11065565=        END'
      '11065566=    END'
      '11065567='
      '11065568=    update G_PRODUCT'
      '11065569=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '11065570=        ARTICUL = :ARTICUL_,'
      '11065571=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '11065572=        BARCODE = :BARCODE_,'
      '11065573=        NAME = :NAME_,'
      '11065574=        G_UNIT = :G_UNIT_,'
      '11065575=        PRICE = :PRICE_,'
      '11065576=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '11065577=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '11065578=        MF_COUNTRY   = :MF_COUNTRY_,'
      '11065579=        NOTE         = :NOTE_,'
      '11065580=        CROSSCODE    = :CROSSCODE_,'
      '11065581=        IS_KIT       = :IS_KIT_,'
      '11065582=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '11065583=        PLACE        = :PLACE_,'
      '11065584=        SALES_COMM   = :SALES_COMM_'
      '11065585=    where (G_PRODUCT = :G_PRODUCT_);'
      '11065586='
      '11065587=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '11065588=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '11065589='
      '11065590=        INSERT INTO LT_BARCODE'
      
        '11065591=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT' +
        '_BARCODE_TMP;'
      '11065592='
      '11065593=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '11065594=        INSERT INTO G_PRODUCT_IMAGE'
      
        '11065595=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT E' +
        'XISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.G' +
        '_PRODUCT_IMAGE);'
      '11065596='
      
        '11065597=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS ' +
        '(SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_P' +
        'RODUCT_IMAGE)'
      '11065598=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '11065599='
      '11065600=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '11065601=        IF (IS_KIT_ > 0) THEN BEGIN'
      '11065602=            INSERT INTO G_PRODUCT_KIT'
      
        '11065603=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP T'
      
        '11065604=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_K' +
        'IT'
      
        '11065605=                               WHERE G_PRODUCT_ITEM = T' +
        '.G_PRODUCT_ITEM'
      
        '11065606=                                 AND G_PRODUCT = T.g_pr' +
        'oduct);'
      '11065607='
      
        '11065608=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_PR' +
        'ODUCT_ITEM)'
      '11065609=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '11065610='
      '11065611=            UPDATE G_PRODUCT_KIT G'
      
        '11065612=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '11065613=                   G.PRICE  = (SELECT PRICE FROM G_PROD' +
        'UCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '11065614=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT_' +
        'TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AMO' +
        'UNT or PRICE <> G.PRICE))'
      '11065615=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '11065616='
      
        '11065617=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090 +
        #1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '11065618=            if (is_kit_ = 1) then begin'
      '11065619=                SELECT MIN(L.AMOUNT)'
      '11065620=                  FROM G_PRODUCT_KIT K,'
      '11065621=                       LT_SKLAD_PRODUCT L'
      '11065622=                 WHERE K.g_product = :G_PRODUCT_'
      '11065623=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11065624=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11065625=                 GROUP BY K.G_PRODUCT'
      '11065626=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11065627='
      '11065628=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11065629=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMO' +
        'UNT_'
      '11065630=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11065631=            end'
      '11065632=        END'
      '11065633=    END'
      '11065634=end'
      '11065635=;'
      '11065636='
      '11065637=ALTER PROCEDURE UPDATE_ZDETAILS_TMP_CHANGE_CL('
      '11065638=  CLIENT_SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '11065639=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11065640=AS'
      '11065641=/*'
      
        '11065642='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1057#1056#1040#1041#1040#1058#1067#1042#1040#1045#1058' '#1055#1056#1048' '#1055#1045#1056#1045#1050#1051#1070#1063#1045#1053#1048#1048' '#1050#1051#1048#1045#1053#1058#1040' '#1048' '#1055#1045#1056#1045#1057#1063 +
        #1048#1058#1067#1042#1040#1045#1058' '#1062#1045#1053#1067', '#1057' '#1059#1063#1045#1058#1054#1052' '#1057#1050#1048#1044#1050#1048' '#1050#1051#1048#1045#1053#1058#1040
      '11065643=*/'
      
        '11065644=DECLARE VARIABLE SKIDKA_        TYPE OF COLUMN G_DISCOU' +
        'NT.SKIDKA_PROC;'
      
        '11065645=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_  TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '11065646=BEGIN'
      
        '11065647=  FOR SELECT MAXVALUE(COALESCE(SK.SKIDKA_PROC, 0), :CLI' +
        'ENT_SKIDKA_) SKIDKA,'
      '11065648=           Z.ZAKAZ_DETAILS'
      
        '11065649=      FROM ZAKAZ_DETAILS_TMP Z LEFT OUTER JOIN (SELECT ' +
        'D.SKIDKA_PROC, D.G_PRODUCT'
      
        '11065650=                                                  FROM ' +
        'G_DISCOUNT D'
      
        '11065651=                                                 WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP'
      
        '11065652=                                                       ' +
        ' AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '11065653=                                                       ' +
        ' AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '11065654=                                                       ' +
        ' )'
      
        '11065655=                                                       ' +
        ' OR'
      
        '11065656=                                                       ' +
        ' (D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL)'
      
        '11065657=                                                       ' +
        ')'
      
        '11065658=                                                   AND ' +
        'COALESCE(D.G_TOCHKA, :G_TOCHKA_) = :G_TOCHKA_) SK ON Z.G_PRODUCT' +
        ' = SK.G_PRODUCT'
      '11065659=      INTO :SKIDKA_,'
      '11065660=           :ZAKAZ_DETAILS_TMP_'
      '11065661=  DO BEGIN'
      '11065662=    UPDATE ZAKAZ_DETAILS_TMP T'
      '11065663=       SET T.DISCOUNT_PERC  = :SKIDKA_,'
      '11065664=           T.DISCOUNT_TENGE = T.PRICE * :SKIDKA_ / 100,'
      
        '11065665=           T.DISCOUNT_SUMM  = T.AMOUNT * T.PRICE * :SKI' +
        'DKA_ / 100,'
      
        '11065666=           T.SUMM           = T.PRICE * T.AMOUNT - T.AM' +
        'OUNT * T.PRICE * :SKIDKA_ / 100'
      '11065667=     WHERE T.ZAKAZ_DETAILS  = :ZAKAZ_DETAILS_TMP_;'
      '11065668=  END'
      '11065669=END'
      '11065670=;'
      
        '11065671=UPDATE SYSTEM_SETUP SET S_VALUE = 11065 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11065672=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11065673=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110660=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '110661=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '110662=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '110663=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT,'
      
        '110664=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE ' +
        '*/ BIGINT,'
      '110665=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '110666=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '110667=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERIC' +
        '(15,2),'
      
        '110668=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGINT' +
        ')'
      '110669=RETURNS ('
      '1106610=  ERR_CODE INTEGER,'
      '1106611=  ERR_MSG VARCHAR(1024))'
      '1106612=AS'
      '1106613=BEGIN'
      '1106614=  SUSPEND;'
      '1106615=END'
      '1106616=;'
      '1106617='
      '1106618=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      
        '1106619=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T,'
      '1106620=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '1106621=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '1106622=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT,'
      
        '1106623=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ' */ BIGINT,'
      
        '1106624=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCHA' +
        'R(150),'
      
        '1106625=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ IN' +
        'TEGER,'
      '1106626=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '1106627=  SUMM_ /* TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED */ NU' +
        'MERIC(15,2),'
      
        '1106628=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED ' +
        '*/ NUMERIC(15,2),'
      '1106629=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1106630=RETURNS ('
      '1106631=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1106632=  ERR_CODE INTEGER,'
      '1106633=  ERR_MSG VARCHAR(1024))'
      '1106634=AS'
      '1106635=BEGIN'
      '1106636=  SUSPEND;'
      '1106637=END'
      '1106638=;'
      '1106639='
      '1106640=ALTER PROCEDURE R_UNIFICATION('
      '1106641=  MODE_ INTEGER)'
      '1106642=RETURNS ('
      '1106643=  COUNT_SPIS_ INTEGER,'
      '1106644=  COUNT_PRIH_ INTEGER,'
      '1106645=  ERR_CODE INTEGER,'
      '1106646=  ERR_MSG VARCHAR(1024))'
      '1106647=AS'
      '1106648=BEGIN'
      '1106649=  SUSPEND;'
      '1106650=END'
      '1106651=;'
      '1106652='
      '1106653='
      
        '1106654=/*******************************************************' +
        '***********************/'
      
        '1106655=/****            Altering stored procedures (with empty ' +
        'bodies)            ****/'
      
        '1106656=/*******************************************************' +
        '***********************/'
      '1106657=ALTER PROCEDURE INS_ZAKAZ('
      
        '1106658=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T,'
      '1106659=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '1106660=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '1106661=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT,'
      
        '1106662=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ' */ BIGINT,'
      
        '1106663=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCHA' +
        'R(150),'
      
        '1106664=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ IN' +
        'TEGER,'
      '1106665=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '1106666=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '1106667=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERI' +
        'C(15,2),'
      
        '1106668=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMERI' +
        'C(15,2),'
      
        '1106669=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */ ' +
        'NUMERIC(15,2),'
      
        '1106670=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NUME' +
        'RIC(15,2),'
      
        '1106671=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ' */ NUMERIC(15,2),'
      
        '1106672=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD */ BIGINT,'
      
        '1106673=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(1' +
        '5,2),'
      
        '1106674=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTEGE' +
        'R,'
      
        '1106675=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ INTE' +
        'GER,'
      '1106676=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1106677=  IS_MEBEL_ INTEGER = 0,'
      
        '1106678=  DOSTAVSHIK_ /* TYPE OF COLUMN DELIVERY.DOSTAVSHIK */ B' +
        'IGINT = NULL,'
      
        '1106679=  DELIVERY_DATE_ /* TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E */ DATE = NULL,'
      
        '1106680=  ADDRESS_ /* TYPE OF COLUMN DELIVERY.ADDRESS */ VARCHAR' +
        '(250) = NULL,'
      
        '1106681=  PRICE_ /* TYPE OF COLUMN DELIVERY.PRICE */ NUMERIC(15,' +
        '2) = NULL,'
      '1106682=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1106683=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT = NULL)'
      '1106684=RETURNS ('
      '1106685=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1106686=  ERR_CODE INTEGER,'
      '1106687=  ERR_MSG VARCHAR(1024))'
      '1106688=AS'
      '1106689=BEGIN'
      '1106690=  SUSPEND;'
      '1106691=END'
      '1106692=;'
      '1106693='
      '1106694='
      
        '1106695=/*******************************************************' +
        '***********************/'
      
        '1106696=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1106697=/*******************************************************' +
        '***********************/'
      '1106698=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '1106699=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11066100=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11066101=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '11066102=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11066103=  PREFIX_ VARCHAR(2))'
      '11066104=RETURNS ('
      '11066105=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '11066106=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUC' +
        'T_PAR,'
      '11066107=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11066108=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11066109=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11066110=  ERR_CODE INTEGER,'
      '11066111=  ERR_MSG VARCHAR(1024))'
      '11066112=AS'
      
        '11066113=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PRODUC' +
        'T_BY_BARCODE'#39';'
      '11066114=BEGIN'
      '11066115='
      '11066116=  IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '11066117=    ERR_CODE = -20500;'
      
        '11066118=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093#1082#1086#1076' '#1087 +
        #1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '11066119=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11066120=    EXIT;'
      '11066121=  END'
      '11066122='
      
        '11066123=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) THE' +
        'N BEGIN'
      '11066124=        SELECT T.G_PRODUCT_PAR,'
      '11066125=               T.G_PRODUCT,'
      '11066126=               T.PRICE,'
      '11066127=               T.VOLUME_PRICE'
      '11066128=          FROM G_PRODUCT T'
      
        '11066129=          WHERE SUBSTRING(T.BARCODE FROM 3 FOR 5) = SUB' +
        'STRING(:BARCODE_ FROM 3 FOR 5)'
      '11066130=            AND T.IS_ACTIVE = 1'
      '11066131=          INTO :G_PRODUCT_CATEGORY_,'
      '11066132=               :G_PRODUCT_,'
      '11066133=               :PRICE_,'
      '11066134=               :VOLUME_PRICE_;'
      '11066135='
      
        '11066136=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM 8 ' +
        'FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '11066137=    END ELSE'
      '11066138=        SELECT T.G_PRODUCT_PAR,'
      '11066139=               T.G_PRODUCT,'
      '11066140=               T.PRICE,'
      '11066141=               T.VOLUME_PRICE'
      '11066142=          FROM G_PRODUCT T'
      '11066143=          WHERE T.BARCODE = :BARCODE_'
      '11066144=            AND T.IS_ACTIVE = 1'
      '11066145=          INTO :G_PRODUCT_CATEGORY_,'
      '11066146=               :G_PRODUCT_,'
      '11066147=               :PRICE_,'
      '11066148=               :VOLUME_PRICE_;'
      '11066149='
      '11066150=    if (ROW_COUNT = 0) then BEGIN'
      
        '11066151=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' '#1044#1054 +
        #1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '11066152=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) T' +
        'HEN'
      '11066153=          SELECT T.G_PRODUCT_PAR,'
      '11066154=                 T.G_PRODUCT,'
      '11066155=                 T.PRICE,'
      '11066156=                 T.VOLUME_PRICE'
      '11066157=            FROM G_PRODUCT T, LT_BARCODE D'
      '11066158=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '11066159=              AND T.IS_ACTIVE = 1'
      
        '11066160=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) = S' +
        'UBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '11066161=            INTO'
      '11066162=                :G_PRODUCT_CATEGORY_,'
      '11066163=                :G_PRODUCT_,'
      '11066164=                :PRICE_,'
      '11066165=                :VOLUME_PRICE_;'
      '11066166=      ELSE'
      '11066167=          SELECT T.G_PRODUCT_PAR,'
      '11066168=                 T.G_PRODUCT,'
      '11066169=                 T.PRICE,'
      '11066170=                 T.VOLUME_PRICE'
      '11066171=            FROM G_PRODUCT T, LT_BARCODE D'
      '11066172=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '11066173=              AND T.IS_ACTIVE = 1'
      '11066174=              AND D.BARCODE = :BARCODE_'
      '11066175=            INTO'
      '11066176=                :G_PRODUCT_CATEGORY_,'
      '11066177=                :G_PRODUCT_,'
      '11066178=                :PRICE_,'
      '11066179=                :VOLUME_PRICE_;'
      '11066180='
      '11066181=      if (ROW_COUNT = 0) then BEGIN'
      '11066182=          ERR_CODE = -20500;'
      
        '11066183=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      '11066184=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11066185=          EXIT;'
      '11066186=      END'
      '11066187=    END'
      '11066188='
      
        '11066189=  /*END ELSE if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then' +
        ' BEGIN'
      '11066190=    SELECT T.G_PRODUCT_PAR,'
      '11066191=        T.G_PRODUCT,'
      '11066192=        T.PRICE,'
      '11066193=        T.VOLUME_PRICE'
      '11066194=    FROM G_PRODUCT T'
      '11066195=    WHERE T.ARTICUL = :ARTICUL_'
      '11066196=    INTO'
      '11066197=        G_PRODUCT_CATEGORY_,'
      '11066198=        :G_PRODUCT_,'
      '11066199=        :PRICE_,'
      '11066200=        :VOLUME_PRICE_;'
      '11066201='
      '11066202=    if (ROW_COUNT = 0) then BEGIN'
      '11066203=      ERR_CODE = -20500;'
      
        '11066204=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      '11066205=      ERR_MSG = PROCNAME||ERR_MSG;'
      '11066206=      EXIT;'
      '11066207=    END'
      '11066208='
      
        '11066209=  END ELSE if (CHAR_LENGTH(TRIM(:NOMER_)) > 0) then BEG' +
        'IN'
      '11066210=    SELECT T.G_PRODUCT_PAR,'
      '11066211=        T.G_PRODUCT,'
      '11066212=        T.PRICE,'
      '11066213=        T.VOLUME_PRICE'
      '11066214=    FROM G_PRODUCT T'
      '11066215=    WHERE T.NOMENCLATUR_NUM = :NOMER_'
      '11066216=    INTO'
      '11066217=        G_PRODUCT_CATEGORY_,'
      '11066218=        :G_PRODUCT_,'
      '11066219=        :PRICE_,'
      '11066220=        :VOLUME_PRICE_;'
      '11066221='
      '11066222=    if (ROW_COUNT = 0) then BEGIN'
      '11066223=      ERR_CODE = -20500;'
      
        '11066224=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1085#1086#1084#1077#1085#1082#1083#1072#1090#1091#1088#1085#1099#1084' '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMER_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '11066225=      ERR_MSG = PROCNAME||ERR_MSG;'
      '11066226=      EXIT;'
      '11066227=    END'
      '11066228='
      
        '11066229=  END ELSE if (CHAR_LENGTH(TRIM(:NAME_)) > 0) then BEGI' +
        'N'
      
        '11066230=      --'#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MAX '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042#1044#1056#1059#1043' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1057' '#1058#1040#1050#1048#1052' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1052
      '11066231=      EXECUTE STATEMENT'
      
        '11066232=      '#39'SELECT G_PRODUCT, G_PRODUCT_PAR, PRICE FROM G_PR' +
        'ODUCT '#39'||'
      '11066233=      '#39' WHERE G_PRODUCT = '#39'||'
      
        '11066234=                  '#39'(SELECT MAX(G_PRODUCT) FROM G_PRODUC' +
        'T '#39'||'
      
        '11066235=                  '#39' WHERE UPPER(NAME) LIKE '#39#39'%'#39'||:NAME_' +
        '||'#39'%'#39#39')'#39
      '11066236=      INTO :G_PRODUCT_, :G_PRODUCT_CATEGORY_, :PRICE_ ;'
      '11066237=      if (G_PRODUCT_ = 0) then BEGIN'
      '11066238=          ERR_CODE = -20500;'
      
        '11066239=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1077#1084' "'#39'||NAME_||'#39'" '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '11066240=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11066241=          EXIT;'
      '11066242=      END'
      '11066243=  END  */'
      '11066244=end'
      '11066245=;'
      '11066246='
      '11066247=ALTER PROCEDURE G_UPD_G_OFFICIAL('
      '11066248=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11066249=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '11066250=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '11066251=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '11066252=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11066253=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '11066254=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '11066255=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '11066256=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '11066257=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '11066258=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '11066259=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '11066260=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTMEN' +
        'T,'
      
        '11066261=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVODI' +
        'TEL,'
      '11066262=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '11066263=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNITE' +
        'L,'
      '11066264=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '11066265=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11066266=  RIGHTS_ARR_ VARCHAR(500),'
      
        '11066267=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.G_OFFICI' +
        'AL)'
      '11066268=RETURNS ('
      '11066269=  ERR_CODE INTEGER,'
      '11066270=  ERR_MSG VARCHAR(1024))'
      '11066271=AS'
      
        '11066272=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_ITE' +
        'M.RIGHTS_ITEM;'
      
        '11066273=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHTS' +
        '_ITEM;'
      '11066274=BEGIN'
      
        '11066275=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1' +
        ', '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '11066276=      UPDATE G_OFFICIAL G'
      '11066277=         SET G.IS_ISPOLNITEL = 0;'
      '11066278='
      
        '11066279=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '11066280=      UPDATE G_OFFICIAL G'
      '11066281=         SET G.IS_RUKOVODITEL = 0;'
      '11066282='
      
        '11066283=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058 +
        #1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '11066284=      UPDATE G_OFFICIAL G'
      '11066285=         SET G.IS_GLAVBUH = 0;'
      '11066286='
      '11066287=    update G_OFFICIAL'
      '11066288=    set FM = :FM_,'
      '11066289=        NM = :NM_,'
      '11066290=        FT = :FT_,'
      '11066291=        FIO_DOC = :FIO_DOC_,'
      '11066292=        RNN = :RNN_,'
      '11066293=        IDN = :IDN_,'
      '11066294=        DT = :DT_,'
      '11066295=        G_ID_KIND = :G_ID_KIND_,'
      '11066296=        ID_NUM = :ID_NUM_,'
      '11066297=        ID_DATE = :ID_DATE_,'
      '11066298=        ID_ISSUER = :ID_ISSUER_,'
      '11066299=        G_APPOINTMENT = :G_APPOINTMENT_,'
      '11066300=        IS_RUKOVODITEL = :IS_RUKOVODITEL_,'
      '11066301=        IS_GLAVBUH = :IS_GLAVBUH_,'
      '11066302=        IS_ISPOLNITEL = :IS_ISPOLNITEL_,'
      '11066303=        PASS = :PASSWORD_,'
      '11066304=        G_TOCHKA = :G_TOCHKA_,'
      '11066305=        DO_NOT_SALES_COMM = :DO_NOT_SALES_COMM_'
      '11066306=    where (G_OFFICIAL = :G_OFFICIAL_);'
      '11066307='
      
        '11066308=    DELETE FROM G_OFFICIAL_RIGHT WHERE G_OFFICIAL = :G_' +
        'OFFICIAL_;'
      '11066309=    FOR SELECT T.RIGHTS_ITEM'
      '11066310=        FROM RIGHTS_ITEM T'
      '11066311=       WHERE T.IS_CATEGORY = 0'
      
        '11066312=         AND :RIGHTS_ARR_ CONTAINING '#39'-'#39'||T.RIGHTS_ITEM' +
        '||'#39'-'#39
      '11066313=        INTO :RIGHTS_ITEM_'
      '11066314=    DO BEGIN'
      
        '11066315=        INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT,' +
        ' RIGHTS_ITEM, G_OFFICIAL)'
      
        '11066316=        VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGHT' +
        'S_ITEM_, :G_OFFICIAL_);'
      '11066317=    END'
      '11066318='
      
        '11066319=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048',' +
        ' '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '11066320=    SELECT COUNT(G.G_OFFICIAL)'
      '11066321=      FROM G_OFFICIAL G'
      '11066322=     WHERE EXISTS (SELECT 1'
      '11066323=                     FROM G_OFFICIAL_RIGHT R'
      '11066324=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '11066325=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) = ' +
        '(SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '11066326=    INTO :CNT_;'
      '11066327='
      '11066328=    IF (:CNT_ = 0) THEN BEGIN'
      '11066329=      ERR_CODE = -20500;'
      
        '11066330=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1086#1073#1093#1086#1076#1080 +
        #1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087#1088#1072 +
        #1074#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11066331=      EXIT;'
      '11066332=    END'
      '11066333=end'
      '11066334=;'
      '11066335='
      '11066336=ALTER PROCEDURE INS_ZAKAZ('
      '11066337=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11066338=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11066339=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11066340=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11066341=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11066342=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11066343=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11066344=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11066345=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11066346=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11066347=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11066348=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11066349=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11066350=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '11066351=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11066352=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11066353=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11066354=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11066355=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11066356=  IS_MEBEL_ INTEGER = 0,'
      
        '11066357=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NULL' +
        ','
      
        '11066358=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE ' +
        '= NULL,'
      '11066359=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '11066360=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '11066361=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '11066362=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NU' +
        'LL)'
      '11066363=RETURNS ('
      '11066364=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11066365=  ERR_CODE INTEGER,'
      '11066366=  ERR_MSG VARCHAR(1024))'
      '11066367=AS'
      '11066368=/*'
      '11066369=IS_SPISANIE_'
      '11066370=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11066371=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11066372=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11066373=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11066374='
      '11066375='
      
        '11066376=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '11066377=*/'
      '11066378=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '11066379=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11066380=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11066381=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '11066382=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '11066383=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '11066384=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ';'
      
        '11066385=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      
        '11066386=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '11066387=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM;'
      '11066388=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11066389=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS_SUMM;'
      
        '11066390=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      
        '11066391=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11066392=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '11066393=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKA' +
        'Z_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '11066394=DECLARE VARIABLE CNT_ INTEGER;'
      '11066395=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11066396=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '11066397=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11066398=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11066399=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11066400=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11066401=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11066402=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11066403=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.S' +
        'ALES_COMM;'
      
        '11066404=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11066405=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11066406=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11066407=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '11066408=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM = 0;'
      
        '11066409=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      '11066410=BEGIN'
      '11066411='
      
        '11066412=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057#1048 +
        #1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055#1054 +
        #1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '11066413=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '11066414=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '11066415=  IF (CNT_ = 0) THEN BEGIN'
      '11066416=    ERR_CODE = -20500;'
      
        '11066417=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088#1086 +
        #1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090#1077 +
        ' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11066418=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '11066419=    EXIT;'
      '11066420=  END'
      '11066421='
      '11066422=  IF (G_TOCHKA_ IS NULL) THEN'
      '11066423=    SELECT ID'
      '11066424=      FROM CUR_PARAMS'
      '11066425=     WHERE CUR_PARAMS = 2'
      '11066426=      INTO :G_TOCHKA_;'
      '11066427='
      '11066428=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11066429=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '11066430=      PNT_ = '#39'01'#39';'
      
        '11066431=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11066432=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11066433=      ELSE'
      '11066434=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11066435='
      '11066436=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11066437=      SELECT G.G_OFFICIAL,'
      '11066438=             G.DO_NOT_SALES_COMM,'
      '11066439=             G.FM||'#39' '#39'||G.NM'
      '11066440=        FROM G_OFFICIAL G'
      
        '11066441=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SEL' +
        'ECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '11066442=        INTO :G_OFFICIAL_,'
      '11066443=             :DO_NOT_SALES_COMM_,'
      '11066444=             :OFFICIAL_NAME_;'
      '11066445='
      '11066446=      INSERT INTO ZAKAZ'
      '11066447=      ('
      '11066448=       ZAKAZ,'
      '11066449=       G_TOCHKA,'
      '11066450=       Z_DATE,'
      '11066451=       Z_TIME,'
      '11066452=       G_CLIENT,'
      '11066453=       G_PAYMENT_TYPE,'
      '11066454=       OSNOVANIE,'
      '11066455=       IS_SPISANIE,'
      '11066456=       NOTE,'
      '11066457=       SUMM,'
      '11066458=       SUMM_FACT,'
      '11066459=       SUMM_BONUS,'
      '11066460=       IS_PAYED_ALL'
      '11066461=       ,G_OFFICIAL'
      '11066462=       ,BY_RECIPE'
      '11066463=       ,SUMM_BONUS_GOT'
      '11066464=       ,IS_RESERVE'
      '11066465=       ,SUMM_CASH'
      '11066466=       ,SUMM_NONCASH'
      '11066467=      ) VALUES ('
      '11066468=       GEN_ID(GEN_ZAKAZ, 1),'
      '11066469=       :G_TOCHKA_,'
      '11066470=       :Z_DATE_,'
      '11066471=       :Z_TIME_,'
      '11066472=       :G_CLIENT_,'
      '11066473=       :G_PAYMENT_TYPE_,'
      '11066474=       :OSNOVANIE_,'
      '11066475=       :IS_SPISANIE_,'
      '11066476=       :NOTE_,'
      '11066477=       :SUMM_,'
      '11066478=       :SUMM_FACT_1_,'
      '11066479=       COALESCE(:SUMM_BONUS_, 0),'
      
        '11066480=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_B' +
        'ONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052 +
        #1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11066481=       ,:G_OFFICIAL_'
      '11066482=       ,:BY_RECIPE_'
      '11066483=       ,:SUMM_BONUS_GOT_'
      '11066484=       ,:IS_RESERVE_'
      '11066485=       ,COALESCE(:SUMM_CASH_, 0)'
      '11066486=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '11066487=      )'
      '11066488=      RETURNING'
      '11066489=        ZAKAZ'
      '11066490=      INTO'
      '11066491=        :ZAKAZ_;'
      '11066492='
      '11066493=      PNT_ = '#39'02'#39';'
      
        '11066494=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUNT' +
        ', Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUNT' +
        '_SUMM,'
      
        '11066495=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SAL' +
        'ES_COMM'
      '11066496=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '11066497=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '11066498=          INTO :ZAKAZ_DETAILS_TMP_,'
      '11066499=              :G_PRODUCT,'
      '11066500=              :AMOUNT,'
      '11066501=              :PRICE,'
      '11066502=              :SUMM,'
      '11066503=              :DISCOUNT_PERC,'
      '11066504=              :DISCOUNT_TENGE,'
      '11066505=              :DISCOUNT_SUMM,'
      '11066506=              :NDS,'
      '11066507=              :NDS_SUMM,'
      '11066508=              :COST_PRICE,'
      '11066509=              :SALES_COMM_'
      '11066510=      DO BEGIN'
      
        '11066511=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056 +
        #1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040 +
        #1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '11066512=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '11066513=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/10' +
        '0;'
      
        '11066514=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_ ' +
        '+ SALES_COMM_SUMM_ITER_;'
      '11066515=        END'
      '11066516='
      '11066517=        INSERT INTO ZAKAZ_DETAILS'
      '11066518=        VALUES('
      '11066519=          :ZAKAZ_DETAILS_TMP_,'
      '11066520=          :ZAKAZ_,'
      '11066521=          :G_PRODUCT,'
      '11066522=          :AMOUNT,'
      '11066523=          :PRICE,'
      '11066524=          :SUMM,'
      '11066525=          :DISCOUNT_PERC,'
      '11066526=          :DISCOUNT_TENGE,'
      '11066527=          :DISCOUNT_SUMM,'
      '11066528=          :NDS,'
      '11066529=          :NDS_SUMM,'
      '11066530=          :COST_PRICE,'
      '11066531=          :SALES_COMM_SUMM_ITER_'
      '11066532=        );'
      '11066533='
      '11066534=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11066535=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '11066536=            UPDATE LT_SKLAD_PRODUCT L'
      '11066537=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11066538=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11066539=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11066540='
      '11066541=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '11066542=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11066543=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '11066544=            PNT_ = '#39'04'#39';'
      
        '11066545=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11066546=              Err_Code = -20500;'
      
        '11066547=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11066548=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11066549=              EXIT;'
      '11066550=            END ELSE if (ROW_COUNT = 0) then'
      
        '11066551=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11066552=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11066553=        END'
      '11066554='
      '11066555=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '11066556=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '11066557=            UPDATE LT_SKLAD_PRODUCT L'
      
        '11066558=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE ' +
        '+ :AMOUNT'
      '11066559=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11066560=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11066561=      END'
      '11066562='
      '11066563=      ----------------------------------------'
      
        '11066564=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053 +
        #1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '11066565=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '11066566=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '11066567='
      
        '11066568=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '11066569=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '11066570=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '11066571=                PNT_ = '#39'05'#39';'
      
        '11066572=                EXECUTE PROCEDURE K_INS_KASSA(0,     --' +
        ' ACTION_ => :ACTION_'
      
        '11066573=                                              1,     --' +
        ' G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '11066574=                                              :SUMM_FAC' +
        'T_1_,'
      '11066575=                                              :Z_DATE_,'
      
        '11066576=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11066577=                                              ZAKAZ_,  ' +
        ' --ZAKAZ_'
      '11066578=                                              NULL,'
      
        '11066579=                                              :G_PAYMEN' +
        'T_TYPE_,'
      
        '11066580=                                              :G_TOCHKA' +
        '_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11066581=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11066582=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_' +
        '||'#39' '#39'||ERR_MSG;'
      '11066583=                  EXIT;'
      '11066584=                END'
      '11066585=            END'
      '11066586='
      '11066587=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '11066588=        END ELSE BEGIN'
      '11066589=            PNT_ = '#39'06'#39';'
      '11066590=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      
        '11066591=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_)' +
        ';'
      
        '11066592=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA' +
        '_) THEN'
      
        '11066593=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' POS_TILDA_ - 1);'
      '11066594=                ELSE'
      
        '11066595=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' CHAR_LENGTH(PAYMENTS_) - 1);'
      '11066596='
      
        '11066597=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR' +
        '_)'
      
        '11066598=                    RETURNING_VALUES :PAYMENT_ID_, :PAY' +
        'MENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11066599='
      
        '11066600=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM ' +
        '(POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '11066601='
      '11066602=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11066603=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11066604=                                                  1,   ' +
        '  --:G_PRIHOD_RASHOD_,'
      
        '11066605=                                                  :PAYM' +
        'ENT_SUMM_,'
      
        '11066606=                                                  :PAYM' +
        'ENT_DATE_,'
      
        '11066607=                                                  NULL,' +
        '   --NOTE_ => :NOTE_,'
      
        '11066608=                                                  :ZAKA' +
        'Z_,'
      
        '11066609=                                                  NULL,' +
        '     --:SKLAD_,'
      
        '11066610=                                                  :PAYM' +
        'ENT_TYPE_,'
      
        '11066611=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11066612=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11066613=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '11066614=                      EXIT;'
      '11066615=                    END'
      '11066616=                END'
      '11066617=            END'
      '11066618=        END'
      '11066619=      END'
      '11066620='
      
        '11066621=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '11066622=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041#1054 +
        #1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '11066623=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052' ' +
        #1057#1051#1059#1063#1040#1045
      '11066624=      UPDATE G_DISCONT_CARD D'
      
        '11066625=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0) +' +
        ' :SUMM_BONUS_GOT_,'
      '11066626=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '11066627=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '11066628='
      '11066629=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '11066630=      PNT_ = '#39'07'#39';'
      
        '11066631=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COMM' +
        '_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN BE' +
        'GIN'
      '11066632=        SELECT S.S_VALUE'
      '11066633=          FROM SYSTEM_SETUP S'
      '11066634=         WHERE S.SYSTEM_SETUP = 4'
      '11066635=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '11066636='
      '11066637=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11066638=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11066639=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11066640='
      
        '11066641=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' '#1041 +
        #1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11066642=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11066643=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE(' +
        'EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM C' +
        'URRENT_DATE)));'
      '11066644='
      '11066645=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11066646=        ELSE'
      
        '11066647=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DAY' +
        ' FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32);'
      '11066648='
      '11066649=        KASSA_ = NULL;'
      '11066650=        SELECT K.KASSA, K.SUMM'
      '11066651=        FROM KASSA K'
      '11066652=        WHERE K.G_PRIHOD_RASHOD = -1'
      '11066653=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '11066654=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '11066655=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '11066656='
      '11066657=        IF (KASSA_ IS NULL) THEN'
      
        '11066658=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11066659=                                          -1,     --:G_' +
        'PRIHOD_RASHOD_,'
      
        '11066660=                                          :SALES_COMM_S' +
        'UMM_ALL_,'
      
        '11066661=                                          :ACTION_DATE_' +
        'ZP_,'
      
        '11066662=                                          :OFFICIAL_NAM' +
        'E_,'
      
        '11066663=                                          NULL,     --:' +
        'ZAKAZ_,'
      
        '11066664=                                          NULL,     --:' +
        'SKLAD_,'
      '11066665=                                          1,'
      '11066666=                                          :G_TOCHKA_,'
      '11066667=                                          :G_OFFICIAL_'
      
        '11066668=                                          ) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11066669=        ELSE'
      '11066670=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '11066671=                                          1,     -- ACT' +
        'ION_'
      
        '11066672=                                          -1,     --:G_' +
        'PRIHOD_RASHOD_,'
      
        '11066673=                                          :SALES_COMM_S' +
        'UMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '11066674=                                          :ACTION_DATE_' +
        'ZP_,'
      
        '11066675=                                          :OFFICIAL_NAM' +
        'E_,   --NOTE_'
      '11066676=                                          NULL,'
      '11066677=                                          NULL,'
      
        '11066678=                                          :PAYMENT_TYPE' +
        '_,'
      '11066679=                                          :G_OFFICIAL_'
      
        '11066680=                                          ) RETURNING_V' +
        'ALUES :ERR_CODE, :ERR_MSG;'
      '11066681='
      '11066682=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11066683=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11066684=          EXIT;'
      '11066685=        END'
      '11066686=      END'
      '11066687='
      '11066688=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '11066689=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      
        '11066690=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_' +
        'TYPE, ID, OPER)'
      
        '11066691=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ_' +
        ', 1);'
      '11066692=  END'
      '11066693=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11066694=  ----------------------------------------'
      '11066695=  ----------------------------------------'
      '11066696=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11066697=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '11066698=      PNT_ = '#39'25'#39';'
      
        '11066699=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT,' +
        ' G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHKA' +
        ')'
      
        '11066700=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLIE' +
        'NT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA_' +
        ')'
      '11066701=      RETURNING ZAKAZ_REAL_PARENT'
      '11066702=      INTO :ZAKAZ_REAL_PARENT_;'
      '11066703='
      
        '11066704=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOU' +
        'NT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '11066705=            FROM ZAKAZ_DETAILS_TMP Z'
      '11066706=          INTO :G_PRODUCT,'
      '11066707=              :AMOUNT,'
      '11066708=              :PRICE,'
      '11066709=              :SUMM,'
      '11066710=              :DISCOUNT_PERC,'
      '11066711=              :DISCOUNT_TENGE,'
      '11066712=              :DISCOUNT_SUMM,'
      '11066713=              :NDS,'
      '11066714=              :NDS_SUMM'
      '11066715=      DO BEGIN'
      '11066716=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11066717=          UPDATE LT_SKLAD_PRODUCT L'
      '11066718=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11066719=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '11066720=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '11066721='
      
        '11066722=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053#1054' ' +
        #1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045' '#1047 +
        #1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11066723=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048#1057 +
        #1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '11066724=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FROM' +
        ' SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11066725=            Err_Code = -20500;'
      
        '11066726=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1055#1086 +
        ' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUCT ' +
        '= :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088 +
        #1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11066727=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '11066728=            EXIT;'
      '11066729=          END ELSE if (ROW_COUNT = 0) then'
      
        '11066730=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11066731=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11066732='
      
        '11066733=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZAK' +
        'AZ_REAL_PARENT,'
      '11066734=                                     G_PRODUCT,'
      '11066735=                                     PRICE,'
      
        '11066736=                                     AMOUNT_ALL, SUMM_A' +
        'LL,'
      
        '11066737=                                     AMOUNT_PAYED, SUMM' +
        '_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SU' +
        'MM, NDS,'
      '11066738=                                     NDS_SUMM)'
      
        '11066739=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ_' +
        'REAL_PARENT_,'
      '11066740=                  :G_PRODUCT,'
      
        '11066741=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040#1070 +
        ' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '11066742=                  :AMOUNT, :SUMM,'
      '11066743=                  0, --AMOUNT_PAYED,'
      '11066744=                  0, --SUMM_PAYED,'
      '11066745=                  0, --IS_PAYED_ALL,'
      '11066746=                  :DISCOUNT_PERC,'
      '11066747=                  :DISCOUNT_TENGE,'
      '11066748=                  :DISCOUNT_SUMM,'
      '11066749=                  :NDS,'
      '11066750=                  :NDS_SUMM)'
      '11066751=          RETURNING ZAKAZ_NA_REAL'
      '11066752=          INTO :ZAKAZ_;'
      '11066753=      END'
      '11066754=  END'
      '11066755=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11066756=  ----------------------------------------'
      '11066757=  ----------------------------------------'
      '11066758=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '11066759=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046#1040 +
        #1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '11066760=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', '#1040 +
        ' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11066761=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '11066762=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, TI' +
        'ME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SUM' +
        'M_FACT,'
      
        '11066763=                                IS_PAYED_ALL, IS_VOZVRA' +
        'T, G_TOCHKA)'
      
        '11066764=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_,' +
        ' :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SUM' +
        'M_FACT_,'
      '11066765=              1, 3, :G_CLIENT_)'
      '11066766=      RETURNING SKLAD'
      '11066767=      INTO :SKLAD_;'
      '11066768='
      '11066769=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '11066770=            FROM ZAKAZ_DETAILS_TMP Z'
      '11066771=          INTO :G_PRODUCT,'
      '11066772=              :AMOUNT,'
      '11066773=              :PRICE,'
      '11066774=              :SUMM'
      '11066775=      DO BEGIN'
      '11066776=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11066777=        UPDATE LT_SKLAD_PRODUCT L'
      '11066778=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11066779=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11066780=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '11066781='
      '11066782=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '11066783=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1053#1045#1058
      
        '11066784=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045#1064#1048 +
        #1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' '#1062#1045 +
        #1053#1059
      '11066785=        SELECT MAX(SK.DATE_RECEIPT)'
      '11066786=            FROM SKLAD SK'
      '11066787=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11066788=             AND SK.IS_LAST = 1'
      '11066789=             AND SK.G_TOCHKA = :G_CLIENT_'
      '11066790=            INTO :DATE_LAST_;'
      '11066791='
      
        '11066792=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048 +
        ' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11066793=            UPDATE SKLAD SK'
      '11066794=               SET SK.IS_LAST = 0'
      '11066795=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11066796=               AND SK.IS_LAST = 1'
      '11066797=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '11066798='
      '11066799=            IS_THIS_LAST_ = 1;'
      '11066800=        END */'
      '11066801='
      '11066802='
      '11066803=        INSERT INTO SKLAD'
      '11066804=        ('
      '11066805=         SKLAD,'
      '11066806=         SKLAD_PARENT,'
      '11066807=         DATE_RECEIPT,'
      '11066808=         G_CLIENT,'
      '11066809=         G_PRODUCT,'
      '11066810=         AMOUNT,'
      '11066811=         PRICE,'
      '11066812=         SUMM,'
      '11066813=         G_PAYMENT_TYPE,'
      '11066814=         OSNOVANIE,'
      '11066815=         NOTE,'
      '11066816=         NDS,'
      '11066817=         NDS_SUMM,'
      '11066818=         IS_LAST,'
      '11066819=         IS_VOZVRAT,'
      '11066820=         G_TOCHKA'
      '11066821=        ) VALUES ('
      '11066822=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '11066823=         :SKLAD_,'
      '11066824=         :Z_DATE_,'
      '11066825=         :G_TOCHKA_,'
      '11066826=         :G_PRODUCT,'
      '11066827=         :AMOUNT,'
      '11066828=         :PRICE,'
      '11066829=         :SUMM,'
      '11066830=         :G_PAYMENT_TYPE_,'
      '11066831=         :OSNOVANIE_,'
      '11066832=         :NOTE_,'
      '11066833=         0,  --:RNDS_,'
      '11066834=         0,  --:RNDS_SUMM_,'
      
        '11066835=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' ' +
        #1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' ' +
        #1041#1059#1044#1045#1058' 0'
      '11066836=         3,  --:IS_VOZVRAT_,'
      '11066837=         :G_CLIENT_'
      '11066838=        );'
      '11066839='
      
        '11066840=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' '#1045 +
        #1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '11066841=        PNT_ = '#39'02'#39';'
      '11066842=        UPDATE LT_SKLAD_PRODUCT L'
      '11066843=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '11066844=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11066845=           AND L.G_TOCHKA = :G_CLIENT_;'
      '11066846='
      '11066847=        IF (ROW_COUNT = 0) THEN'
      
        '11066848=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PROD' +
        'UCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '11066849=      END'
      '11066850=  END'
      '11066851='
      '11066852=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '11066853='
      
        '11066854=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054 +
        #1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '11066855=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11066856=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ => ' +
        ':ACTION_'
      '11066857=                                  G_PRIHOD_,'
      '11066858=                                  :SUMM_PRIHOD_,'
      '11066859=                                  :Z_DATE_,'
      
        '11066860=                                  NULL,   --NOTE_ => :N' +
        'OTE_,'
      '11066861=                                  :ZAKAZ_,'
      '11066862=                                  NULL,'
      '11066863=                                  :G_PAYMENT_TYPE_,'
      
        '11066864=                                  :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11066865=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11066866=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '11066867=      EXIT;'
      '11066868=    END'
      '11066869=  END'
      '11066870='
      
        '11066871=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057#1058 +
        #1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '11066872=  IF (IS_MEBEL_ = 1) THEN'
      
        '11066873=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS,' +
        ' ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '11066874=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, :' +
        'ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '11066875=end'
      '11066876=;'
      '11066877='
      '11066878='
      
        '11066879=/******************************************************' +
        '************************/'
      
        '11066880=/****                   Restoring deactivated procedure' +
        's                   ****/'
      
        '11066881=/******************************************************' +
        '************************/'
      '11066882=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '11066883=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11066884=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11066885=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11066886=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11066887=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11066888=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11066889=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11066890=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11066891=RETURNS ('
      '11066892=  ERR_CODE INTEGER,'
      '11066893=  ERR_MSG VARCHAR(1024))'
      '11066894=AS'
      '11066895=/*'
      
        '11066896='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059' '#1044 +
        #1040#1053#1053#1067#1061
      
        '11066897='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054' '#1055 +
        #1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '11066898='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '11066899=*/'
      
        '11066900=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNLOA' +
        'D'#39';'
      '11066901=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11066902=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.BARCODE;'
      
        '11066903=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.ARTICUL;'
      
        '11066904=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TMP.' +
        'AMOUNT;'
      
        '11066905=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP.P' +
        'RICE;'
      
        '11066906=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.PRICE;'
      
        '11066907=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.DISCOUNT;'
      '11066908=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '11066909=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11066910=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2)' +
        ';'
      
        '11066911=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      '11066912=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11066913=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.ZAKAZ_DETAILS;'
      
        '11066914=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      '11066915=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11066916=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      
        '11066917=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11066918=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NONCA' +
        'SH;'
      '11066919=BEGIN'
      '11066920='
      '11066921=  PNT_ = '#39'00'#39';'
      '11066922=  CLRF = ascii_char( 10 );'
      '11066923='
      '11066924=  SELECT S.S_VALUE'
      '11066925=    FROM SYSTEM_SETUP S'
      '11066926=   WHERE S.SYSTEM_SETUP = 2'
      '11066927=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11066928='
      '11066929=  PNT_ = '#39'01'#39';'
      '11066930=  SELECT G.nds_value'
      '11066931=    FROM G_FIRM_REKVIZIT G'
      '11066932=   WHERE G.is_default = 1'
      '11066933=    INTO :NDS_;'
      '11066934='
      '11066935=  PNT_ = '#39'02'#39';'
      
        '11066936=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AMOU' +
        'NT, PRICE, DISCOUNT'
      '11066937=        FROM IMPORT_TBL_TMP'
      
        '11066938=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_, :' +
        'DISCOUNT_'
      '11066939=  DO BEGIN'
      '11066940=    SELECT G_PRODUCT,'
      '11066941=           PRICE'
      '11066942=      FROM ('
      '11066943=            SELECT P.G_PRODUCT, P.price'
      '11066944=              FROM G_PRODUCT P'
      
        '11066945=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(COAL' +
        'ESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '11066946=                OR (P.ARTICUL = :ARTICUL_ and TRIM(COAL' +
        'ESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '11066947=            UNION'
      '11066948=            SELECT LT.G_PRODUCT, P.PRICE'
      '11066949=              FROM LT_BARCODE LT, g_product P'
      
        '11066950=             WHERE LT.BARCODE = :BARCODE_ and TRIM(COAL' +
        'ESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '11066951=               AND LT.g_product = P.g_product'
      '11066952=           )'
      '11066953=      INTO :G_PRODUCT_,'
      '11066954=           :PRICE_OUR_;'
      '11066955='
      '11066956=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '11066957=      ERR_CODE = -20500;'
      
        '11066958=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39'||' +
        'BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '11066959=      Exit;'
      '11066960=    END'
      '11066961='
      '11066962=    PNT_ = '#39'03'#39';'
      
        '11066963=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / PR' +
        'ICE_;'
      
        '11066964=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, ' +
        ':G_TOCHKA_, 1)'
      '11066965=      RETURNING_VALUES :COST_PRICE_;'
      '11066966='
      '11066967=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '11066968=    IF (price_ IS NULL) THEN'
      '11066969=      PRICE_ = PRICE_OUR_;'
      '11066970='
      '11066971=    PNT_ = '#39'04'#39';'
      
        '11066972=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PRODUC' +
        'T_,'
      '11066973=                                              :AMOUNT_,'
      '11066974=                                              :PRICE_,'
      
        '11066975=                                              :AMOUNT_ ' +
        '* (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '11066976=                                              :DISCOUNT' +
        '_PERC_,'
      
        '11066977=                                              :DISCOUNT' +
        '_,'
      
        '11066978=                                              :AMOUNT_ ' +
        '* :DISCOUNT_,'
      '11066979=                                              :NDS_,'
      
        '11066980=                                              SUMM_ * N' +
        'DS_ / (100 + NDS_),'
      
        '11066981=                                              :COST_PRI' +
        'CE_,'
      
        '11066982=                                              :ALLOW_SE' +
        'LL_ABSENT_GOODS_,'
      
        '11066983=                                              0,     --' +
        'IS_SPISANIE_'
      
        '11066984=                                              1,     --' +
        ' NEW_LINE_SALE_'
      
        '11066985=                                              0     --M' +
        'ODE_'
      
        '11066986=                                              ) RETURNI' +
        'NG_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '11066987=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11066988=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE =' +
        ' '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_M' +
        'SG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11066989=      EXIT;'
      '11066990=    END'
      '11066991='
      '11066992=    G_PRODUCT_ = NULL;'
      '11066993=  END'
      '11066994='
      '11066995=  PNT_ = '#39'05'#39';'
      '11066996=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '11066997=    SELECT SUM(T.summ)'
      '11066998=      FROM ZAKAZ_DETAILS_TMP T'
      '11066999=      INTO :SUMM_;'
      '110661000=    SUMM_FACT_ = SUMM_;'
      '110661001=  END'
      '110661002='
      '110661003=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '110661004=  if (G_PAYMENT_TYPE_ = 1) then'
      '110661005=    SUMM_CASH_ = summ_fact_;'
      '110661006=  ELSE'
      '110661007=    SUMM_NONCASH_ = summ_fact_;'
      '110661008='
      '110661009=  PNT_ = '#39'06'#39';'
      '110661010=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '110661011=    G_CLIENT_ = 10;'
      '110661012='
      '110661013=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110661014=                              :Z_DATE_,'
      '110661015=                              :Z_TIME_,'
      '110661016=                              :G_CLIENT_,'
      '110661017=                              :G_PAYMENT_TYPE_,'
      '110661018=                              '#39#39', --:OSNOVANIE_,'
      '110661019=                              0,  -- IS_SPISANIE'
      
        '110661020=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOTE' +
        '_,'
      '110661021=                              :SUMM_,'
      '110661022=                              :SUMM_FACT_,'
      '110661023=                              :SUMM_CASH_,'
      '110661024=                              :SUMM_NONCASH_,'
      
        '110661025=                              0,    --:SUMM_PAY_BONUS_' +
        '_,'
      
        '110661026=                              0,    --:SUMM_BONUS_GOT_' +
        '_,'
      
        '110661027=                              NULL,        --:G_PRIHOD' +
        '_,'
      
        '110661028=                              NULL,        --:SUMM_PRI' +
        'HOD_'
      '110661029=                              0,    -- :BY_RECIPE__,'
      '110661030=                              0,    -- IS_RESERVE__'
      '110661031=                              NULL -- :PAYMENTS__'
      '110661032=                              )'
      
        '110661033=                              RETURNING_VALUES :ZAKAZ_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110661034=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110661035=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE =' +
        ' '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_M' +
        'SG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '110661036=    EXIT;'
      '110661037=  END'
      '110661038='
      '110661039=  DELETE FROM import_tbl_tmp;'
      '110661040='
      '110661041=WHEN ANY DO BEGIN'
      '110661042=    ERR_CODE = gdscode;'
      
        '110661043=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdscod' +
        'e;'
      '110661044=  END'
      '110661045=end'
      '110661046=;'
      '110661047='
      '110661048=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '110661049=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110661050=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110661051=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110661052=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110661053=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110661054=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110661055=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110661056=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110661057=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '110661058=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '110661059=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110661060=RETURNS ('
      '110661061=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110661062=  ERR_CODE INTEGER,'
      '110661063=  ERR_MSG VARCHAR(1024))'
      '110661064=AS'
      
        '110661065=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062#1045 +
        #1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '110661066=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045#1057 +
        #1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '110661067=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040#1042 +
        #1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '110661068=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042#1053 +
        #1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '110661069='
      
        '110661070=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042 +
        #1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110661071=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '110661072=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA_' +
        'REAL'#39';'
      '110661073=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110661074=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110661075=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110661076=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'AMOUNT_ALL;'
      
        '110661077=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'SUMM_PAYED;'
      
        '110661078=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110661079=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '110661080=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110661081=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110661082=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      '110661083=BEGIN'
      '110661084='
      '110661085=  IF (G_TOCHKA_ IS NULL) THEN'
      '110661086=    SELECT ID'
      '110661087=      FROM CUR_PARAMS'
      '110661088=     WHERE CUR_PARAMS = 2'
      '110661089=      INTO :G_TOCHKA_;'
      '110661090='
      
        '110661091=  --**************************************************' +
        '************************************************'
      
        '110661092=  --**************************************************' +
        '************************************************'
      '110661093=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110661094=  --**************************************************' +
        '************************************************'
      
        '110661095=  --**************************************************' +
        '************************************************'
      '110661096=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '110661097=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1055 +
        #1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '110661098=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '110661099=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110661100=            INTO :AMOUNT_,'
      '110661101=                 :G_PRODUCT_'
      '110661102=      DO BEGIN'
      '110661103=          UPDATE LT_SKLAD_PRODUCT L'
      '110661104=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110661105=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110661106=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110661107=      END'
      '110661108='
      '110661109=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '110661110=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E,'
      
        '110661111=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE)'
      
        '110661112=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '110661113=             NDS_SUMM, COST_PRICE'
      '110661114=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110661115='
      '110661116=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110661117=                                  :Z_DATE_,'
      '110661118=                                  :Z_TIME_,'
      '110661119=                                  :G_CLIENT_,'
      '110661120=                                  :G_PAYMENT_TYPE_,'
      '110661121=                                  :OSNOVANIE_,'
      
        '110661122=                                  :IS_SPISANIE_,   -- ' +
        ':IS_SPISANIE_'
      '110661123=                                  :NOTE_,'
      
        '110661124=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040 +
        #1050#1040#1047#1040
      
        '110661125=                                  :SUMM_FACT_,  -- '#1048' '#1057 +
        #1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '110661126=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 1, SUMM_FACT_, 0),'
      
        '110661127=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 2, SUMM_FACT_, 0),'
      '110661128=                                  0, --SUMM_BONUS_'
      '110661129=                                  0, --SUMM_BONUS_GOT_'
      
        '110661130=                                  null,         -- '#1057#1058#1040 +
        #1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '110661131=                                  0,            -- '#1057#1059#1052 +
        #1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '110661132=                                  0,    --BY_RECIPE'
      '110661133=                                  0     --IS_RESERVE'
      '110661134=                                  ,NULL  -- PAYMENTS_'
      '110661135=                                  ,0     --IS_MEBEL_'
      '110661136=                                  ,NULL  --DOSTAVSHIK_'
      
        '110661137=                                  ,NULL  --DELIVERY_DA' +
        'TE'
      '110661138=                                  ,NULL  --ADDRESS_'
      '110661139=                                  ,NULL  --PRICE_'
      '110661140=                                  ,UPLOAD_TO_EXT_APP_'
      '110661141=                                  )'
      '110661142=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110661143='
      '110661144=      if (ERR_CODE <> 0) then BEGIN'
      '110661145=        ERR_CODE = -20500;'
      '110661146=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '110661147=        Exit;'
      '110661148=      END'
      '110661149='
      
        '110661150=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' '#1040 +
        #1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' ' +
        #1055#1054#1044' '#1056#1045#1040#1051
      
        '110661151=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044#1040 +
        ' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '110661152=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054#1055 +
        #1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042#1045 +
        #1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '110661153=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059 +
        #1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '110661154=      UPDATE ZAKAZ'
      '110661155=         SET IS_SPISANIE = 2'
      '110661156=       WHERE ZAKAZ = :ZAKAZ_;'
      '110661157='
      
        '110661158=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110661159=      FOR SELECT T.AMOUNT,'
      '110661160=                 T.SUMM,'
      '110661161=                 T.G_PRODUCT,'
      '110661162=                 T.ZAKAZ_NA_REAL,'
      '110661163=                 T.ZAKAZ_DETAILS'
      '110661164=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110661165=            INTO :AMOUNT_,'
      '110661166=                 :Z_SUMM_,'
      '110661167=                 :G_PRODUCT_,'
      '110661168=                 :ZAKAZ_NA_REAL_,'
      '110661169=                 :ZAKAZ_DETAILS_'
      '110661170=      DO BEGIN'
      '110661171=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110661172=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOU' +
        'NT_,'
      
        '110661173=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110661174=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110661175=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110661176='
      
        '110661177=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ' +
        'ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '110661178=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110661179=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110661180=      END'
      '110661181=  END'
      '110661182=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110661183=  --**************************************************' +
        '************************************************'
      
        '110661184=  --**************************************************' +
        '************************************************'
      '110661185='
      
        '110661186=  --**************************************************' +
        '************************************************'
      
        '110661187=  --**************************************************' +
        '************************************************'
      '110661188=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110661189=  --**************************************************' +
        '************************************************'
      
        '110661190=  --**************************************************' +
        '************************************************'
      '110661191=  ELSE BEGIN'
      '110661192=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '110661193=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ZA' +
        'KAZ_DETAILS - ZAKAZ_REAL'
      
        '110661194=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110661195=      FOR SELECT T.AMOUNT,'
      '110661196=                 T.SUMM,'
      '110661197=                 T.G_PRODUCT,'
      '110661198=                 T.ZAKAZ_NA_REAL,'
      '110661199=                 T.ZAKAZ_DETAILS'
      '110661200=                 ,T.PRICE'
      '110661201=                 ,T.NDS'
      '110661202=                 ,T.NDS_SUMM'
      '110661203=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110661204=            INTO :AMOUNT_,'
      '110661205=                 :Z_SUMM_,'
      '110661206=                 :G_PRODUCT_,'
      '110661207=                 :ZAKAZ_NA_REAL_,'
      '110661208=                 :ZAKAZ_DETAILS_'
      '110661209=                 ,:PRICE_'
      '110661210=                 ,:NDS_'
      '110661211=                 ,:NDS_SUMM_'
      '110661212=      DO BEGIN'
      
        '110661213=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUN' +
        'T, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110661214=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '110661215='
      
        '110661216=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110661217=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110661218='
      '110661219=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110661220=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :AMOUNT_,'
      
        '110661221=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110661222=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110661223=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110661224=      END'
      '110661225='
      '110661226=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110661227=                                  :Z_DATE_,'
      '110661228=                                  :Z_TIME_,'
      '110661229=                                  :G_CLIENT_,'
      '110661230=                                  :G_PAYMENT_TYPE_,'
      '110661231=                                  :OSNOVANIE_,'
      '110661232=                                  :NOTE_,'
      
        '110661233=                                  2,        --:IS_VOZV' +
        'RAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-' +
        #1050#1059
      '110661234=                                  :SUMM_,'
      '110661235=                                  :SUMM_FACT_,'
      
        '110661236=                                  NULL,     --:G_PRIHO' +
        'D_,'
      
        '110661237=                                  NULL      --:SUMM_PR' +
        'IHOD_'
      
        '110661238=                                  ,NULL     -- PAYMENT' +
        'S'
      
        '110661239=                                  ) RETURNING_VALUES :' +
        'SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110661240='
      '110661241=      if (ERR_CODE <> 0) then BEGIN'
      '110661242=        ERR_CODE = -20500;'
      '110661243=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '110661244=        Exit;'
      '110661245=      END'
      '110661246=  END'
      '110661247=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110661248=  --**************************************************' +
        '************************************************'
      
        '110661249=  --**************************************************' +
        '************************************************'
      '110661250='
      '110661251=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110661252=END'
      '110661253=;'
      '110661254='
      '110661255=ALTER PROCEDURE R_UNIFICATION('
      '110661256=  MODE_ INTEGER)'
      '110661257=RETURNS ('
      '110661258=  COUNT_SPIS_ INTEGER,'
      '110661259=  COUNT_PRIH_ INTEGER,'
      '110661260=  ERR_CODE INTEGER,'
      '110661261=  ERR_MSG VARCHAR(1024))'
      '110661262=AS'
      
        '110661263=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATION' +
        #39';'
      '110661264=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110661265=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REV' +
        'ISION;'
      
        '110661266=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_' +
        'PRODUCT;'
      
        '110661267=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AM' +
        'OUNT_BD;'
      
        '110661268=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.' +
        'AMOUNT_REAL;'
      
        '110661269=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      '110661270=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110661271=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110661272=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110661273=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110661274=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      '110661275=BEGIN'
      '110661276='
      '110661277=  COUNT_SPIS_ = 0;'
      '110661278=  COUNT_PRIH_ = 0;'
      '110661279='
      '110661280=  SELECT ID'
      '110661281=    FROM CUR_PARAMS'
      '110661282=   WHERE CUR_PARAMS = 2'
      '110661283=    INTO :G_TOCHKA_;'
      '110661284='
      
        '110661285=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_RE' +
        'AL'
      '110661286=      FROM REVISION'
      
        '110661287=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOU' +
        'NT_REAL_'
      '110661288=  DO BEGIN'
      
        '110661289=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2' +
        '))) THEN BEGIN'
      
        '110661290=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1)'
      '110661291=        RETURNING_VALUES :COST_PRICE_;'
      '110661292='
      
        '110661293=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_' +
        'PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110661294=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM)'
      
        '110661295=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMO' +
        'UNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '110661296='
      '110661297=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '110661298=    END'
      '110661299='
      
        '110661300=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1' +
        '))) then BEGIN'
      '110661301=      SELECT S.PRICE'
      '110661302=        FROM SKLAD S'
      '110661303=       WHERE S.IS_LAST = 1'
      '110661304=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110661305=         AND S.G_TOCHKA = :G_TOCHKA_'
      '110661306=        INTO :PRICE_LAST_;'
      '110661307='
      
        '110661308=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056 +
        #1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '110661309='
      
        '110661310=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110661311=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AM' +
        'OUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '110661312='
      '110661313=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '110661314=    END'
      '110661315='
      '110661316=    UPDATE REVISION R'
      '110661317=       SET R.IS_UNIFIED = 1'
      '110661318=     WHERE R.REVISION = :REVISION_;'
      '110661319=  END'
      '110661320='
      '110661321=  PNT_ = '#39'01'#39';'
      '110661322=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '110661323=    SELECT SUM(S.SUMM)'
      '110661324=      FROM ZAKAZ_DETAILS_TMP S'
      '110661325=      INTO :SUMM_;'
      '110661326='
      '110661327=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110661328=                                CURRENT_DATE, --:Z_DAT' +
        'E_,'
      
        '110661329=                                CURRENT_TIME, --:Z_TIM' +
        'E'
      
        '110661330=                                10,          --:G_CLIE' +
        'NT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '110661331=                                1,            --:G_PAY' +
        'MENT_TYPE_,'
      
        '110661332=                                NULL,         --:OSNOV' +
        'ANIE_,'
      
        '110661333=                                1,              --:IS_' +
        'SPISANIE_,'
      
        '110661334=                                NULL,           --:NOT' +
        'E_,'
      
        '110661335=                                :SUMM_,              -' +
        '-:SUMM_,'
      
        '110661336=                                :SUMM_,              -' +
        '-:SUMM_FACT_,'
      
        '110661337=                                0,              --SUMM' +
        '_BONUS_'
      
        '110661338=                                0,              --SUMM' +
        '_BONUS_GOT'
      
        '110661339=                                NULL,           --:G_P' +
        'RIHOD_,'
      '110661340=                                NULL,'
      '110661341=                                0,        -- BY_RECIPE'
      
        '110661342=                                0         -- IS_RESERV' +
        'E'
      '110661343=                                ,NULL  -- PAYMENTS_'
      '110661344=                                ,0     -- SUMM_CASH'
      '110661345=                                ,0     -- SUMM_NONCASH'
      
        '110661346=                                ) RETURNING_VALUES :ZA' +
        'KAZ_, :ERR_CODE, :ERR_MSG;'
      '110661347=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110661348=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110661349=      EXIT;'
      '110661350=    END'
      '110661351=  END'
      '110661352='
      '110661353=  PNT_ = '#39'02'#39';'
      '110661354=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '110661355=    SELECT SUM(S.SUMM)'
      '110661356=      FROM SKLAD_TMP S'
      '110661357=      INTO :SUMM_;'
      '110661358='
      '110661359=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110661360=                                CURRENT_DATE,   --:DAT' +
        'E_RECEIPT_,'
      '110661361=                                CURRENT_TIME,'
      
        '110661362=                                NULL,           --:G_C' +
        'LIENT_,'
      
        '110661363=                                1,              --:G_P' +
        'AYMENT_TYPE_,'
      
        '110661364=                                NULL,           --:OSN' +
        'OVANIE_,'
      
        '110661365=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',   ' +
        '        --:NOTE_,'
      
        '110661366=                                5,              --:IS_' +
        'VOZVRAT_,'
      '110661367=                                :SUMM_,'
      '110661368=                                :SUMM_,'
      
        '110661369=                                NULL,           --:G_P' +
        'RIHOD_,'
      
        '110661370=                                NULL            --:SUM' +
        'M_PRIHOD_'
      '110661371=                                ,NULL  --PAYMENTS'
      '110661372=                                )'
      '110661373=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110661374=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110661375=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110661376=      EXIT;'
      '110661377=    END'
      '110661378=  END'
      '110661379=END'
      '110661380=;'
      
        '110661381=UPDATE SYSTEM_SETUP SET S_VALUE = 11066 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '110661382=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110661383=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110670=CREATE PROCEDURE K_PAY_DOLG('
      '110671=  ACTION_ /* TYPE OF COLUMN KASSA.ACTION */ INTEGER,'
      
        '110672=  G_PRIHOD_RASHOD_ /* TYPE OF COLUMN KASSA.G_PRIHOD_RASHO' +
        'D */ BIGINT,'
      '110673=  SUMM_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(15,2),'
      
        '110674=  ACTION_DATE_ /* TYPE OF COLUMN KASSA.ACTION_DATE */ DAT' +
        'E,'
      '110675=  NOTE_ /* TYPE OF COLUMN KASSA.NOTE */ VARCHAR(200),'
      '110676=  ZAKAZ_ /* TYPE OF COLUMN KASSA.ZAKAZ */ BIGINT,'
      '110677=  SKLAD_ /* TYPE OF COLUMN KASSA.SKLAD */ BIGINT,'
      
        '110678=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE ' +
        '*/ BIGINT,'
      
        '110679=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGINT' +
        ','
      '1106710=  ZAKAZ_ARR_ BLOB SUB_TYPE 1)'
      '1106711=RETURNS ('
      '1106712=  KASSA_ /* TYPE OF COLUMN KASSA.KASSA */ BIGINT,'
      '1106713=  ERR_CODE INTEGER,'
      '1106714=  ERR_MSG VARCHAR(1024))'
      '1106715=AS'
      '1106716=BEGIN'
      '1106717=  SUSPEND;'
      '1106718=END'
      '1106719=;'
      '1106720='
      '1106721=CREATE PROCEDURE R_IMPORT_REVISION('
      
        '1106722=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T,'
      
        '1106723=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '1106724=  AMOUNT_ /* TYPE OF COLUMN REVISION.AMOUNT_REAL */ NUME' +
        'RIC(18,5))'
      '1106725=RETURNS ('
      '1106726=  ERR_CODE INTEGER,'
      '1106727=  ERR_MSG VARCHAR(1024))'
      '1106728=AS'
      '1106729=BEGIN'
      '1106730=  SUSPEND;'
      '1106731=END'
      '1106732=;'
      '1106733='
      '1106734='
      
        '1106735=/*******************************************************' +
        '***********************/'
      
        '1106736=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1106737=/*******************************************************' +
        '***********************/'
      '1106738=ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '1106739=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106740=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '1106741=RETURNS ('
      '1106742=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1106743=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106744=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106745=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1106746=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '1106747=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106748=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106749=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106750=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106751=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1106752=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '1106753=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1106754=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1106755=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1106756=  CNT_Z_ INTEGER,'
      
        '1106757=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RASH' +
        'OD,'
      '1106758=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106759=  HAVERIGHT_ INTEGER,'
      '1106760=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1106761=  ERR_CODE INTEGER,'
      '1106762=  ERR_MSG VARCHAR(1024))'
      '1106763=AS'
      '1106764=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      
        '1106765=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFICI' +
        'AL.G_OFFICIAL;'
      '1106766=begin'
      '1106767='
      '1106768=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1086#1076#1072#1078', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '1106769=  /*CNT_Z_ = 0;'
      '1106770=  SELECT COUNT(*)'
      '1106771=    FROM (SELECT Z.ZAKAZ'
      '1106772=            FROM ZAKAZ Z ROWS 1 TO 100)'
      '1106773=    INTO :CNT_Z_;*/'
      '1106774='
      
        '1106775=  --****************************************************' +
        '************'
      '1106776=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1106777=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1106778=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '1106779=          SELECT'
      '1106780=            T.G_TOCHKA,'
      '1106781=            T.Z_DATE,'
      '1106782=            T.Z_TIME,'
      '1106783=            T.G_CLIENT,'
      '1106784=            T.G_PAYMENT_TYPE,'
      '1106785=            T.OSNOVANIE,'
      '1106786=            T.NOTE,'
      '1106787=            T.SUMM,'
      '1106788=            T.SUMM_FACT,'
      '1106789=            T.SUMM_BONUS,'
      '1106790=            T.summ_bonus_got,'
      '1106791=            T.IS_PAYED_ALL,'
      '1106792=            COALESCE(T.BY_RECIPE, 0)'
      '1106793=            ,IS_RESERVE'
      '1106794=          FROM ZAKAZ T'
      '1106795=          WHERE T.ZAKAZ = :ZAKAZ_'
      '1106796=          INTO'
      '1106797=            :G_TOCHKA_,'
      '1106798=            :Z_DATE_,'
      '1106799=            :Z_TIME_,'
      '11067100=            :G_CLIENT_,'
      '11067101=            :G_PAYMENT_TYPE_,'
      '11067102=            :OSNOVANIE_,'
      '11067103=            :NOTE_,'
      '11067104=            :SUMM_,'
      '11067105=            :SUMM_FACT_,'
      '11067106=            :SUMM_PAY_BONUS_,'
      '11067107=            :SUMM_GOT_BONUS_,'
      '11067108=            :IS_PAYED_ALL_,'
      '11067109=            :BY_RECIPE_,'
      '11067110=            :IS_RESERVE_;'
      '11067111='
      '11067112=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '11067113=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ' +
        'ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_T' +
        'ENGE,'
      
        '11067114=                                        DISCOUNT_SUMM, ' +
        'NDS, NDS_SUMM, COST_PRICE)'
      
        '11067115=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '11067116=                   DISCOUNT_SUMM, NDS, NDS_SUMM, COST_P' +
        'RICE'
      '11067117=              FROM ZAKAZ_DETAILS'
      '11067118=             WHERE ZAKAZ = :ZAKAZ_'
      '11067119=             ORDER BY 1;'
      '11067120='
      '11067121=          -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '11067122=          SELECT K.G_PRIHOD_RASHOD,'
      '11067123=                 K.SUMM'
      
        '11067124=            FROM (SELECT * FROM KASSA UNION SELECT * FR' +
        'OM KASSA_BEZNAL) K'
      '11067125=           WHERE K.ZAKAZ = :ZAKAZ_'
      '11067126=             AND K.G_PRIHOD_RASHOD NOT IN (1, -5)'
      '11067127=            INTO :G_PRIHOD_,'
      '11067128=                 :SUMM_PRIHOD_;'
      '11067129=      END'
      '11067130='
      
        '11067131=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RETU' +
        'RNING_VALUES :PAYMENTS_;'
      '11067132=  END'
      '11067133=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11067134=  --*************************************************'
      '11067135=  --*************************************************'
      '11067136=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11067137=  ELSE BEGIN'
      '11067138=    SELECT'
      '11067139=        T.G_CLIENT,'
      '11067140=        T.DATE_RECEIPT,'
      '11067141=        T.TIME_RECEIPT,'
      '11067142=        T.G_TOCHKA,'
      '11067143=        T.G_PAYMENT_TYPE,'
      '11067144=        T.OSNOVANIE,'
      '11067145=        T.NOTE,'
      '11067146=        T.SUMM,'
      '11067147=        T.SUMM_FACT,'
      '11067148=        0,'
      '11067149=        0,'
      '11067150=        0'
      '11067151=      FROM SKLAD_PARENT T'
      '11067152=      WHERE T.SKLAD = :ZAKAZ_'
      '11067153=      INTO'
      '11067154=        :G_TOCHKA_,'
      '11067155=        :Z_DATE_,'
      '11067156=        :Z_TIME_,'
      '11067157=        :G_CLIENT_,'
      '11067158=        :G_PAYMENT_TYPE_,'
      '11067159=        :OSNOVANIE_,'
      '11067160=        :NOTE_,'
      '11067161=        :SUMM_,'
      '11067162=        :SUMM_FACT_,'
      '11067163=        :SUMM_PAY_BONUS_,'
      '11067164=        :IS_PAYED_ALL_,'
      '11067165=        :BY_RECIPE_;'
      '11067166='
      '11067167=      -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '11067168=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E,'
      
        '11067169=                                     DISCOUNT_SUMM, NDS' +
        ', NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '11067170=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE, ' +
        'SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047#1040#1055 +
        #1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '11067171=        FROM SKLAD'
      '11067172=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '11067173=      ORDER BY 1;'
      '11067174=  END'
      '11067175='
      
        '11067176=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' '#1045 +
        #1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044 +
        #1040#1058#1067
      
        '11067177=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044#1059 +
        ' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053#1040 +
        ' 0, '#1058#1054' '#1061#1045#1056
      '11067178=  HaveRight_ = 1;'
      '11067179=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '11067180=    SELECT ID'
      '11067181=      FROM CUR_PARAMS'
      '11067182=     WHERE CUR_PARAMS = 1'
      '11067183=      INTO :G_OFFICIAL_CUR_;'
      '11067184='
      
        '11067185=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080#1094 +
        #1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' '#1074 +
        #1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '11067186=      HaveRight_ = 1;'
      '11067187=    else'
      
        '11067188=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICIA' +
        'L_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '11067189='
      '11067190=    /* '#1040#1053#1040#1051#1048#1047' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045
      '11067191=    if (HaveRight_ = 0) then begin'
      
        '11067192=      ERR_CODE = -20500; // '#1053#1077' '#1076#1086#1089#1090#1072#1090#1086#1095#1085#1086' '#1087#1088#1072#1074' '#1076#1083#1103' '#1074#1099#1087#1086 +
        #1083#1085#1077#1085#1080#1103' '#1086#1087#1077#1088#1072#1094#1080#1080
      
        '11067193=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' '#1085#1077' '#1086#1073 +
        #1083#1072#1076#1072#1077#1090#1077' '#1087#1088#1072#1074#1086#1084' '#1076#1083#1103' '#1088#1077#1076#1072#1082#1090#1080#1088#1086#1074#1072#1085#1080#1103' '#1085#1072#1082#1083#1072#1076#1085#1099#1093#39'||ascii_char(10)||'#39#1079 +
        #1072' '#1087#1088#1086#1096#1083#1099#1077' '#1076#1072#1090#1099'.'#39') RETURNING_VALUES(:ERR_MSG);'
      '11067194=      EXIT;'
      '11067195=    end*/'
      '11067196=  END'
      '11067197=end'
      '11067198=;'
      '11067199='
      '11067200=ALTER PROCEDURE K_PAY_DOLG('
      '11067201=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '11067202=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASHOD' +
        ','
      '11067203=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '11067204=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '11067205=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '11067206=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '11067207=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '11067208=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11067209=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11067210=  ZAKAZ_ARR_ BLOB SUB_TYPE 1)'
      '11067211=RETURNS ('
      '11067212=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '11067213=  ERR_CODE INTEGER,'
      '11067214=  ERR_MSG VARCHAR(1024))'
      '11067215=AS'
      '11067216=/*'
      
        '11067217=ZAKAZ_ARR_ - '#1052#1040#1057#1057#1048#1042' '#1055#1056#1054#1044#1040#1046', '#1055#1054' '#1050#1054#1058#1054#1056#1067#1052' '#1050#1051#1048#1045#1053#1058' '#1043#1040#1057#1048#1058' '#1044#1054#1051 +
        #1043#1048
      '11067218='
      
        '11067219='#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1055#1051#1040#1058#1040' '#1044#1054#1051#1043#1040' '#1048' '#1054#1058' '#1042#1053#1054#1057#1048#1052#1054#1049' '#1057#1059#1052#1052#1067' '#1063#1058#1054'-'#1058#1054' '#1054#1057#1058#1040#1051#1054 +
        #1057#1068', '#1047#1053#1040#1063#1048#1058' '#1063#1058#1054'-'#1058#1054' '#1053#1045' '#1058#1054','
      
        '11067220='#1042#1054#1047#1052#1054#1046#1053#1054' '#1044#1056#1059#1043#1054#1049' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1046#1045' '#1054#1060#1054#1056#1052#1048#1051' '#1054#1055#1051#1040#1058#1059' '#1044#1054#1051#1043#1040' '#1048 +
        ' '#1042#1048#1047#1048#1058#1067' '#1054#1055#1051#1040#1063#1045#1053#1067', '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1051#1059#1063#1064#1045' '#1042#1067#1044#1040#1052' '#1054#1064#1048#1041#1050#1059
      
        '11067221='#1055#1056#1048#1063#1045#1052' '#1069#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1063#1045#1056 +
        #1045#1047' '#1050#1040#1057#1057#1040' - '#1055#1056#1048#1061#1054#1044', '#1048#1051#1048' '#1055#1054' '#1050#1053#1054#1055#1050#1045' '#1042
      
        '11067222='#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048'. '#1045#1057#1051#1048' '#1046#1045' '#1055#1054#1058#1054#1052' '#1069#1058#1054#1058' '#1055#1051#1040#1058#1045#1046' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070 +
        #1058' '#1063#1045#1056#1045#1047' "'#1057#1055#1048#1057#1054#1050' '#1055#1051#1040#1058#1045#1046#1045#1049'" - '#1058#1054' '#1069#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      '11067223=*/'
      '11067224=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_PAY_DOLG'#39';'
      '11067225=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11067226=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '11067227=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '11067228=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      
        '11067229=DECLARE VARIABLE OSTATOK_ TYPE OF COLUMN ZAKAZ.SUMM_FAC' +
        'T;'
      
        '11067230=DECLARE VARIABLE SUMM_TMP_ TYPE OF COLUMN ZAKAZ.SUMM_FA' +
        'CT;'
      '11067231=begin'
      '11067232=  ERR_CODE = 0;'
      '11067233=  ERR_MSG = '#39#39';'
      '11067234='
      '11067235=  PNT_ = '#39'00'#39';'
      '11067236=  IF (G_TOCHKA_ IS NULL) THEN'
      '11067237=    SELECT ID'
      '11067238=      FROM CUR_PARAMS'
      '11067239=     WHERE CUR_PARAMS = 2'
      '11067240=      INTO :G_TOCHKA_;'
      '11067241='
      
        '11067242=  -- '#1069#1058#1054' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1054#1055#1051#1040#1058#1040' '#1044#1054#1051#1043#1040' '#1050#1051#1048#1045#1053#1058#1054#1052', '#1040' '#1058#1040#1052' '#1052#1054#1046#1045#1058' ' +
        #1041#1067#1058#1068' '#1052#1040#1057#1057#1048#1042' '#1055#1056#1054#1044#1040#1046
      
        '11067243=  -- '#1040' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1048' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1057 +
        #1053#1054#1042#1040' '#1056#1045#1064#1040#1058#1068' '#1063#1045#1056#1045#1047' UNION'
      
        '11067244=  -- '#1042' K_UPD_KASSA '#1053#1048#1063#1045#1043#1054' '#1058#1040#1050#1054#1043#1054' '#1044#1045#1051#1040#1058#1068' '#1053#1045' '#1041#1059#1044#1059', '#1055#1054#1058#1054#1052#1059 +
        ' '#1063#1058#1054' '#1048#1047#1052#1045#1053#1048#1058#1068' '#1054#1055#1051#1040#1058#1059' '#1044#1054#1051#1043#1040' '#1041#1059#1044#1045#1058' '#1053#1045#1042#1054#1047#1052#1054#1046#1053#1054
      '11067245=  -- '#1055#1059#1057#1058#1068' '#1059#1044#1040#1051#1071#1070#1058' '#1048' '#1047#1040#1053#1054#1042#1054' '#1047#1040#1042#1054#1044#1071#1058
      '11067246=  SUMM_TMP_ = SUMM_;'
      '11067247=  FOR SELECT Z.ZAKAZ,'
      
        '11067248=             Z.SUMM - Z.SUMM_FACT - Z.SUMM_BONUS OSTATO' +
        'K'
      '11067249=        FROM ZAKAZ Z'
      '11067250=       WHERE :ZAKAZ_ARR_ CONTAINING '#39'~'#39'||Z.ZAKAZ||'#39'~'#39
      '11067251=         AND :G_PRIHOD_RASHOD_ = -5'
      '11067252=         AND Z.IS_PAYED_ALL = 0'
      '11067253=        INTO :ZAKAZ_,'
      '11067254=             :OSTATOK_'
      '11067255=  DO BEGIN'
      '11067256=      IF (G_PRIHOD_RASHOD_ = -5) THEN BEGIN'
      '11067257=        SUMM_ = MINVALUE(OSTATOK_, SUMM_TMP_);'
      '11067258=        SUMM_TMP_ = SUMM_TMP_ - SUMM_;'
      '11067259=      END'
      '11067260='
      '11067261=      EXECUTE PROCEDURE K_INS_KASSA(0,  --:ACTION_,'
      
        '11067262=                                    -5, --:G_PRIHOD_RAS' +
        'HOD_,'
      '11067263=                                    :SUMM_,'
      '11067264=                                    :ACTION_DATE_,'
      '11067265=                                    :NOTE_,'
      '11067266=                                    :ZAKAZ_,'
      '11067267=                                    NULL,   --:SKLAD_,'
      '11067268=                                    :G_PAYMENT_TYPE_,'
      
        '11067269=                                    :G_TOCHKA_) RETURNI' +
        'NG_VALUES :KASSA_, :ERR_CODE, :ERR_MSG;'
      '11067270='
      '11067271=      UPDATE ZAKAZ Z'
      
        '11067272=         SET Z.IS_PAYED_ALL = DECODE(:OSTATOK_, :SUMM_,' +
        ' 1, 0),'
      
        '11067273=             Z.SUMM_CASH    = DECODE(:G_PAYMENT_TYPE_, ' +
        '1, Z.SUMM_CASH + :SUMM_, Z.SUMM_CASH),'
      
        '11067274=             Z.SUMM_NONCASH = DECODE(:G_PAYMENT_TYPE_, ' +
        '2, Z.SUMM_NONCASH + :SUMM_, Z.SUMM_NONCASH),'
      '11067275=             Z.SUMM_FACT    = Z.SUMM_FACT + :SUMM_'
      '11067276=       WHERE Z.ZAKAZ = :ZAKAZ_;'
      '11067277='
      '11067278=      IF (SUMM_TMP_ = 0) THEN'
      '11067279=        BREAK;'
      '11067280=  END'
      '11067281='
      
        '11067282=  IF (G_PRIHOD_RASHOD_ = -5 AND SUMM_TMP_ > 0) THEN BEG' +
        'IN'
      '11067283=    ERR_CODE = -20500;'
      
        '11067284=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057#1091#1084#1084#1072' '#1086#1087#1083#1072 +
        #1090#1099' '#1076#1086#1083#1075#1072' '#1086#1082#1072#1079#1072#1083#1072#1089#1100' '#1073#1086#1083#1100#1096#1077' '#1089#1091#1084#1084#1099' '#1074#1099#1073#1088#1072#1085#1085#1099#1093' '#1076#1086#1083#1075#1086#1074' '#1085#1072' '#39'||SUMM_TMP_' +
        '||'#39'. '#1042#1086#1079#1084#1086#1078#1085#1086' '#1086#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1073#1099#1083#1072' '#1091#1078#1077' '#39'||'
      
        '11067285=    '#39#1086#1092#1086#1088#1084#1083#1077#1085#1072' '#1076#1088#1091#1075#1080#1084' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1084'!'#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      
        '11067286=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11067287=    EXIT;'
      '11067288=  END'
      '11067289=END'
      '11067290=;'
      '11067291='
      '11067292=ALTER PROCEDURE K_UPD_KASSA('
      '11067293=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '11067294=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '11067295=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASHOD' +
        ','
      '11067296=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '11067297=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '11067298=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '11067299=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '11067300=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '11067301=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11067302=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL)'
      '11067303=RETURNS ('
      '11067304=  ERR_CODE INTEGER,'
      '11067305=  ERR_MSG VARCHAR(1024))'
      '11067306=AS'
      '11067307=/*'
      
        '11067308='#1050#1054#1056#1054#1063#1045' '#1063#1058#1054#1041#1067' '#1053#1045' '#1055#1040#1056#1048#1058#1068#1057#1071' '#1057' '#1058#1071#1046#1045#1051#1067#1052' '#1040#1051#1043#1054#1056#1048#1058#1052#1054#1052' '#1048' '#1053#1040#1042#1054#1056#1040#1063 +
        #1048#1042#1040#1058#1068' '#1055#1056#1054#1062#1045#1044#1059#1056#1059', '#1056#1045#1064#1048#1051' '#1055#1056#1054#1057#1058#1054' '#1059#1044#1040#1051#1071#1058#1068' '#1050#1040#1057#1057#1059' '#1048' '#1047#1040#1053#1054#1042#1054' '#1057#1054#1047#1044#1040#1042#1040#1058#1068' '#1045 +
        #1045', '#1045#1057#1051#1048
      
        '11067309='#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040' '#1042' '#1047#1040#1055#1048#1057#1048' '#1050#1040#1057#1057#1067'. '#1042#1045#1044#1068' '#1058#1040#1052' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048 +
        #1058#1067#1042#1040#1058#1068' '#1044#1045#1041#1045#1058' '#1048' '#1050#1056#1045#1044#1048#1058' '#1047#1040' '#1053#1054#1042#1059#1070' '#1044#1040#1058#1059' '#1048' '#1058#1044' '#1048' '#1058#1055'.'
      '11067310='
      
        '11067311='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053#1040#1051 +
        #1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065#1059#1070 +
        ' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '11067312=*/'
      '11067313=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_UPD_KASSA'#39';'
      '11067314=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11067315=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
