      '110606571=;'
      '110606572='
      '110606573=ALTER PROCEDURE G_INS_G_CLIENT('
      '110606574=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110606575=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT,'
      '110606576=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110606577=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '110606578=  IDN_ VARCHAR(12),'
      '110606579=  KBE_ VARCHAR(5),'
      '110606580=  SKIDKA_ NUMERIC(15,2),'
      '110606581=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '110606582=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110606583=  BY_DEFAULT_ INTEGER,'
      '110606584=  IS_SUPPLIER_ INTEGER,'
      '110606585=  IS_CATEGORY_ INTEGER,'
      '110606586=  IS_BEZNAL_ INTEGER,'
      '110606587=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110606588=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110606589=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110606590=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110606591=  NOTIFY_SKIDKA_ INTEGER,'
      '110606592=  NOTIFY_DR_ INTEGER,'
      '110606593=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '110606594=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '110606595=RETURNS ('
      '110606596=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110606597=  ERR_CODE INTEGER,'
      '110606598=  ERR_MSG VARCHAR(1024))'
      '110606599=AS'
      '110606600=DECLARE VARIABLE CNT_ INTEGER;'
      '110606601=begin'
      
        '110606602=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = ' +
        '1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '110606603=    if (BY_DEFAULT_ = 1) then'
      '110606604=      UPDATE g_client'
      '110606605=         SET BY_DEFAULT = 0'
      '110606606=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '110606607='
      
        '110606608=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G' +
        '_CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '110606609=                          IS_CATEGORY, IS_BEZNAL, PHON' +
        'E, NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR)'
      
        '110606610=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_' +
        ', :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_,' +
        ' :BY_DEFAULT_,'
      
        '110606611=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE' +
        '_, :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR' +
        '_)'
      '110606612=    returning G_CLIENT'
      '110606613=    into :G_CLIENT_;'
      '110606614='
      '110606615=    if (IS_CATEGORY_ = 0) then BEGIN'
      '110606616=        IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '110606617=            SELECT COUNT(*)'
      '110606618=              FROM G_DISCONT_CARD'
      '110606619=             WHERE BARCODE = :BARCODE_'
      
        '110606620=             AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053 +
        #1040#1049#1058#1048' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '110606621=             INTO :CNT_;'
      '110606622='
      '110606623=            IF (CNT_ > 0) THEN BEGIN'
      '110606624=              ERR_CODE = -20500;'
      
        '110606625=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '110606626=              EXIT;'
      '110606627=            END'
      '110606628=        END'
      '110606629='
      
        '110606630=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_' +
        'CLIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '110606631=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIE' +
        'NT_, :BARCODE_, :N_PERCENT_, 0, 0);'
      '110606632=    END'
      '110606633=end'
      '110606634=;'
      '110606635='
      '110606636=ALTER PROCEDURE G_INS_G_CLIENT_CAT('
      '110606637=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110606638=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110606639=  IS_SUPPLIER_ INTEGER)'
      '110606640=RETURNS ('
      '110606641=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110606642=  ERR_CODE INTEGER,'
      '110606643=  ERR_MSG VARCHAR(1024))'
      '110606644=AS'
      '110606645=begin'
      
        '110606646=    INSERT INTO G_CLIENT (G_CLIENT, G_CLIENT_PARENT, N' +
        'AME, IS_SUPPLIER, IS_CATEGORY)'
      
        '110606647=    VALUES (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_' +
        ', :NAME_, :IS_SUPPLIER_, 1)'
      '110606648=    RETURNING'
      '110606649=      G_CLIENT'
      '110606650=    INTO'
      '110606651=      :G_CLIENT_;'
      '110606652=end'
      '110606653=;'
      '110606654='
      '110606655=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '110606656=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110606657=  ARTICUL_ VARCHAR(30),'
      '110606658=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110606659=  BARCODE_ VARCHAR(30),'
      '110606660=  NAME_ VARCHAR(500),'
      '110606661=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110606662=  PRICE_ NUMERIC(15,2),'
      '110606663=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110606664=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110606665=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110606666=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110606667=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110606668=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110606669=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110606670=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110606671=  IS_CATEGORY_ INTEGER,'
      '110606672=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '110606673=RETURNS ('
      '110606674=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110606675=  ERR_CODE INTEGER,'
      '110606676=  ERR_MSG VARCHAR(1024))'
      '110606677=AS'
      
        '110606678=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODU' +
        'CT'#39';'
      '110606679=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110606680=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110606681=begin'
      
        '110606682=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110606683=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '110606684=        SELECT COUNT(*)'
      '110606685=          FROM G_PRODUCT G'
      
        '110606686=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110606687=           AND TRIM(G.ARTICUL) <> '#39#39
      '110606688=          INTO :CNT_;'
      '110606689='
      '110606690=        IF (CNT_ > 0) THEN BEGIN'
      '110606691=          ERR_CODE = -20500;'
      
        '110606692=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '110606693=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110606694=          EXIT;'
      '110606695=        END'
      '110606696=    end'
      '110606697='
      '110606698=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '110606699=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then' +
        ' begin'
      '110606700=        SELECT COUNT(*)'
      '110606701=          FROM G_PRODUCT G'
      
        '110606702=         WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:' +
        'NOMENCLATUR_NUM_))'
      '110606703=           AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110606704=        INTO :CNT_;'
      '110606705=        IF (CNT_ > 0) THEN BEGIN'
      '110606706=          ERR_CODE = -20500;'
      
        '110606707=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '110606708=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110606709=          EXIT;'
      '110606710=        END'
      '110606711=    end'
      '110606712='
      '110606713=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110606714=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110606715=        SELECT COUNT(*)'
      '110606716=          FROM G_PRODUCT G'
      
        '110606717=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110606718=           AND TRIM(G.BARCODE) <> '#39#39
      '110606719=          INTO :CNT_;'
      '110606720='
      '110606721=        IF (CNT_ = 0) then'
      '110606722=          SELECT COUNT(*)'
      '110606723=            FROM G_PRODUCT G, LT_BARCODE L'
      '110606724=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110606725=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110606726=             AND TRIM(L.BARCODE) <> '#39#39
      '110606727=            INTO :CNT_;'
      '110606728='
      '110606729=        IF (CNT_ > 0) THEN BEGIN'
      '110606730=          ERR_CODE = -20500;'
      
        '110606731=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110606732=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110606733=          EXIT;'
      '110606734=        END'
      '110606735=    end'
      '110606736='
      
        '110606737=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PR' +
        'ICE,'
      
        '110606738=                           IS_CATEGORY, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COM' +
        'M)'
      
        '110606739=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRI' +
        'CE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '110606740=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROS' +
        'SCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_)'
      '110606741=    RETURNING G_PRODUCT'
      '110606742=    INTO :G_PRODUCT_;'
      '110606743='
      '110606744=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '110606745=    if (:IS_CATEGORY_ = 0) then begin'
      
        '110606746=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110606747=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '110606748='
      '110606749=        INSERT INTO LT_BARCODE'
      
        '110606750=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110606751='
      
        '110606752=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090 +
        #1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '110606753=        INSERT into G_PRODUCT_IMAGE'
      
        '110606754=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYP' +
        'E from G_PRODUCT_IMAGE_TMP;'
      '110606755='
      
        '110606756=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089 +
        #1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '110606757=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091 +
        #1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '110606758=        IF (is_kit_ > 0) THEN begin'
      '110606759=            INSERT INTO G_PRODUCT_KIT'
      
        '110606760=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP;'
      '110606761='
      '110606762=            if (is_kit_ = 1) then begin'
      
        '110606763=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110606764=                  FROM G_PRODUCT_KIT K,'
      '110606765=                       LT_SKLAD_PRODUCT L'
      '110606766=                 WHERE K.g_product = :G_PRODUCT_'
      '110606767=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110606768=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110606769=                 GROUP BY K.G_PRODUCT'
      '110606770=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110606771='
      '110606772=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110606773=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_' +
        'SOSTAV_AMOUNT_, 0)'
      '110606774=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110606775=            end'
      '110606776=        END'
      '110606777=    END'
      '110606778=end'
      '110606779=;'
      '110606780='
      '110606781=ALTER PROCEDURE G_INS_G_PRODUCT_CAT('
      
        '110606782=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110606783=  NAME_ VARCHAR(500),'
      '110606784=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110606785=  IS_CATEGORY_ INTEGER)'
      '110606786=RETURNS ('
      '110606787=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110606788=  ERR_CODE INTEGER,'
      '110606789=  ERR_MSG VARCHAR(1024))'
      '110606790=AS'
      '110606791=begin'
      
        '110606792=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, N' +
        'AME, IS_CATEGORY, IS_KIT)'
      
        '110606793=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :NAME_, :IS_CATEGORY_, :IS_KIT_)'
      '110606794=    RETURNING G_PRODUCT'
      '110606795=    INTO :G_PRODUCT_;'
      '110606796=end'
      '110606797=;'
      '110606798='
      '110606799=ALTER PROCEDURE G_PRODUCT_SET_NEW_PRICES('
      '110606800=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110606801=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110606802=  CHANGE_PRICE_ INTEGER,'
      '110606803=  MODE_ INTEGER,'
      '110606804=  WHAT_PRICE_ INTEGER,'
      '110606805=  NEW_VAL_ NUMERIC(15,2),'
      '110606806=  COURSE_OLD_ NUMERIC(15,2),'
      '110606807=  COURSE_NEW_ NUMERIC(15,2),'
      '110606808=  ROUND_MODE_ INTEGER,'
      '110606809=  CHANGE_CATEGORY_ INTEGER,'
      '110606810=  NEW_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110606811=  CHANGE_MIN_AMOUNT_ INTEGER,'
      '110606812=  NEW_MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110606813=  CHANGE_SALES_COMM_ INTEGER,'
      '110606814=  NEW_SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '110606815=RETURNS ('
      '110606816=  ERR_CODE INTEGER,'
      '110606817=  ERR_MSG VARCHAR(1000))'
      '110606818=AS'
      
        '110606819=/*ROUND_MODE_ 0 - '#1076#1077#1089#1103#1090#1099#1077', 1 - '#1094#1077#1083#1099#1077', 2 '#1076#1077#1089#1103#1090#1082#1080', 3 '#1089#1086#1090 +
        #1085#1080', 4 '#1090#1099#1089#1103#1095#1080' */'
      
        '110606820=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '110606821=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE' +
        ';'
      
        '110606822=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.V' +
        'OLUME_PRICE;'
      '110606823=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '110606824=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '110606825=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110606826=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '110606827=BEGIN'
      '110606828='
      '110606829=  SQL_STR_ = '#39'UPDATE G_PRODUCT P'#39'||'
      '110606830=               '#39' SET '#39';'
      '110606831='
      '110606832=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110606833='
      '110606834=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '110606835=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '110606836=      IF (ROUND_MODE_ = 0) THEN'
      '110606837=          ROUND_ = 1;'
      '110606838=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '110606839=          ROUND_ = 0;'
      '110606840=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '110606841=          ROUND_ = -1;'
      '110606842=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '110606843=          ROUND_ = -2;'
      '110606844=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '110606845=          ROUND_ = -3;'
      '110606846='
      '110606847=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' %'
      '110606848=      IF (MODE_ = 0) THEN'
      
        '110606849=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '110606850=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '110606851='
      '110606852=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '110606853=      ELSE IF (MODE_ = 1) THEN'
      
        '110606854=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110606855=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110606856='
      '110606857=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' %'
      '110606858=      ELSE IF (MODE_ = 2) THEN'
      
        '110606859=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' * (1 - '#39'||:NEW_VAL_||'#39'/100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '110606860=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE * (1 - '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '110606861='
      '110606862=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '110606863=      ELSE IF (MODE_ = 3) THEN'
      
        '110606864=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110606865=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110606866='
      '110606867=      --'#1048#1047#1052#1045#1053#1048#1058#1068' '#1055#1054' '#1042#1040#1051#1070#1058#1045
      '110606868=      ELSE IF (MODE_ = 4) THEN'
      
        '110606869=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        '/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110606870=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110606871='
      '110606872=      ELSE BEGIN'
      '110606873=        SELECT ID'
      '110606874=          FROM CUR_PARAMS'
      '110606875=         WHERE CUR_PARAMS = 2'
      '110606876=          INTO :G_TOCHKA_;'
      '110606877='
      '110606878=        IF (WHAT_PRICE_ = 0) THEN'
      
        '110606879=          SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND((SELE' +
        'CT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_||'#39', 0))' +
        ' * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '110606880=        ELSE'
      
        '110606881=          SQL_STR_ = SQL_STR_ ||'#39'P.VOLUME_PRICE = ROUN' +
        'D((SELECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_|' +
        '|'#39', 0)) * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '110606882=      END'
      '110606883=  END'
      '110606884='
      '110606885=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '110606886=  IF (CHANGE_CATEGORY_ = 1) THEN BEGIN'
      '110606887=    IF (CHANGE_PRICE_ = 1) THEN'
      '110606888=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110606889='
      
        '110606890=    SQL_STR_ = SQL_STR_ ||'#39'P.G_PRODUCT_PAR = '#39'||:NEW_C' +
        'ATEGORY_;'
      '110606891=  END'
      '110606892='
      '110606893=  -- '#1052#1045#1053#1071#1070' '#1052#1048#1053' '#1054#1057#1058#1040#1058#1054#1050
      '110606894=  IF (CHANGE_MIN_AMOUNT_ = 1) THEN BEGIN'
      '110606895=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_) > 0) THEN'
      '110606896=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110606897='
      
        '110606898=    SQL_STR_ = SQL_STR_ ||'#39'P.MIN_AMOUNT = '#39'||:NEW_MIN_' +
        'AMOUNT_;'
      '110606899=  END'
      '110606900='
      '110606901=  -- '#1052#1045#1053#1071#1070' '#1050#1054#1052#1048#1057#1057#1048#1070' '#1055#1056#1054#1044#1040#1042#1062#1040
      '110606902=  IF (CHANGE_SALES_COMM_ = 1) THEN BEGIN'
      
        '110606903=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_) > 0) THEN'
      '110606904=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110606905='
      
        '110606906=    SQL_STR_ = SQL_STR_ ||'#39'P.SALES_COMM = '#39'||:NEW_SALE' +
        'S_COMM_;'
      '110606907=  END'
      '110606908='
      '110606909=  SQL_STR_ = SQL_STR_ ||'#39' WHERE P.IS_ACTIVE = 1'#39'||'
      '110606910=                       '#39' AND P.IS_KIT <> 1'#39'||'
      '110606911=                       '#39' AND P.IS_CATEGORY = 0'#39';'
      '110606912='
      '110606913=  IF (g_category_ IS NOT NULL) THEN'
      
        '110606914=    SQL_STR_ = SQL_STR_ ||'#39' AND P.G_PRODUCT_PAR IN (SE' +
        'LECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE '#39#39#39'||G_CATEGORY_||'#39#39#39 +
        ' CONTAINING '#39#39'~'#39#39'||PT.G_PRODUCT||'#39#39'~'#39#39')'#39';'
      '110606915='
      '110606916='
      '110606917=  IF (G_PRODUCT_ IS NOT NULL) THEN'
      
        '110606918=    SQL_STR_ = SQL_STR_ ||'#39' AND '#39#39#39'||G_PRODUCT_||'#39#39#39' C' +
        'ONTAINING '#39#39'~'#39#39'||P.G_PRODUCT||'#39#39'~'#39#39#39';'
      '110606919='
      '110606920=  EXECUTE STATEMENT :SQL_STR_;'
      '110606921=END'
      '110606922=;'
      '110606923='
      '110606924=ALTER PROCEDURE G_READ_G_CLIENT_BANK('
      '110606925=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '110606926=RETURNS ('
      '110606927=  G_BANK TYPE OF COLUMN G_BANK.G_BANK,'
      '110606928=  BIK TYPE OF COLUMN G_BANK.BIK,'
      '110606929=  NAME TYPE OF COLUMN G_BANK.NAME,'
      '110606930=  SHORT_NAME TYPE OF COLUMN G_BANK.SHORT_NAME,'
      '110606931=  G_ACCOUNT TYPE OF COLUMN G_ACCOUNT.G_ACCOUNT,'
      '110606932=  ACCOUNT TYPE OF COLUMN G_ACCOUNT.ACCOUNT,'
      '110606933=  IS_DEFAULT TYPE OF COLUMN G_ACCOUNT.IS_DEFAULT,'
      '110606934=  ACC_BIK VARCHAR(500))'
      '110606935=AS'
      '110606936=begin'
      '110606937=  FOR'
      '110606938=    select GB.G_BANK, GB.BIK, GB.NAME, GB.SHORT_NAME,'
      '110606939=           GA.G_ACCOUNT,'
      '110606940=           GA.ACCOUNT,'
      '110606941=           GA.IS_DEFAULT,'
      
        '110606942=           GA.ACCOUNT||'#39' '#1074' '#39'||GB.NAME||'#39', '#1041#1048#1050': '#39'||GB.B' +
        'IK ACC_BIK'
      '110606943=    from G_CLIENT T, G_ACCOUNT GA, G_BANK GB'
      '110606944=    WHERE T.G_CLIENT = :G_CLIENT_'
      '110606945=     AND T.G_CLIENT = GA.G_CLIENT'
      '110606946=     AND GA.G_BANK = GB.G_BANK'
      '110606947=    into :G_BANK, :BIK, :NAME, :SHORT_NAME,'
      '110606948=         :G_ACCOUNT,'
      '110606949=         :ACCOUNT,'
      '110606950=         :IS_DEFAULT,'
      '110606951=         :ACC_BIK'
      '110606952=  DO'
      '110606953=    suspend;'
      '110606954=end'
      '110606955=;'
      '110606956='
      '110606957=ALTER PROCEDURE G_READ_G_CLIENT_CONTACT('
      '110606958=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '110606959=RETURNS ('
      '110606960=  G_ADDRESS TYPE OF COLUMN G_ADDRESS.G_ADDRESS,'
      
        '110606961=  G_ADDRESS_TYPE TYPE OF COLUMN G_ADDRESS.G_ADDRESS_TY' +
        'PE,'
      '110606962=  G_CLIENT TYPE OF COLUMN G_ADDRESS.G_CLIENT,'
      '110606963=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110606964=  PHONE TYPE OF COLUMN G_ADDRESS.PHONE,'
      '110606965=  FAX TYPE OF COLUMN G_ADDRESS.FAX,'
      '110606966=  EMAIL TYPE OF COLUMN G_ADDRESS.EMAIL,'
      '110606967=  WEBSITE TYPE OF COLUMN G_ADDRESS.WEBSITE,'
      '110606968=  IS_DEFAULT TYPE OF COLUMN G_ADDRESS.IS_DEFAULT,'
      '110606969=  ADDRESS_TYPE_STR TYPE OF COLUMN G_ADDRESS_TYPE.NAME)'
      '110606970=AS'
      '110606971=begin'
      '110606972=  FOR'
      
        '110606973=    select T.G_ADDRESS, T.G_ADDRESS_TYPE, T.G_CLIENT, ' +
        'T.ADDRESS, T.PHONE, T.FAX, T.EMAIL, T.WEBSITE, T.IS_DEFAULT, GAT' +
        '.NAME'
      '110606974=    from G_ADDRESS T, G_ADDRESS_TYPE GAT'
      '110606975=    WHERE T.G_CLIENT = :G_CLIENT_'
      '110606976=     AND t.G_ADDRESS_TYPE = GAT.G_ADDRESS_TYPE'
      
        '110606977=    into :G_ADDRESS, :G_ADDRESS_TYPE, :G_CLIENT, :ADDR' +
        'ESS, :PHONE, :FAX, :EMAIL, :WEBSITE, :IS_DEFAULT, :ADDRESS_TYPE_' +
        'STR'
      '110606978=  DO'
      '110606979=    suspend;'
      '110606980=end'
      '110606981=;'
      '110606982='
      '110606983=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '110606984=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      '110606985=  IS_SUPPLIER_ INTEGER = NULL)'
      '110606986=RETURNS ('
      '110606987=  G_CLIENT TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110606988=  G_CLIENT_PARENT TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      
        '110606989=  G_CONTRAGENT TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGEN' +
        'T,'
      '110606990=  NAME VARCHAR(500),'
      '110606991=  RNN VARCHAR(12),'
      '110606992=  IDN VARCHAR(12),'
      '110606993=  KBE VARCHAR(5),'
      '110606994=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '110606995=  SKIDKA NUMERIC(15,2),'
      '110606996=  IS_SUPPLIER INTEGER,'
      '110606997=  BY_DEFAULT INTEGER,'
      '110606998=  IS_BEZNAL INTEGER,'
      '110606999=  IS_SUPPLIER_STR VARCHAR(50),'
      
        '110607000=  SUPPL_AGENT_NAME TYPE OF COLUMN G_CONTRAGENT.SHORT_N' +
        'AME,'
      
        '110607001=  G_DISCONT_CARD TYPE OF COLUMN G_DISCONT_CARD.G_DISCO' +
        'NT_CARD,'
      '110607002=  BARCODE TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110607003=  N_PERCENT TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110607004=  SUMM TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110607005=  SUMM_ALL TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110607006=  NOTE TYPE OF COLUMN G_CLIENT.NOTE,'
      '110607007=  SUMM_DOLG TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110607008=  G_PROMOTION_STR TYPE OF COLUMN G_PROMOTION.NAME)'
      '110607009=AS'
      '110607010=begin'
      '110607011=  FOR'
      '110607012=    SELECT T.g_client,'
      '110607013=           T.g_client_parent,'
      '110607014=           T.g_contragent,'
      '110607015=           T.name,'
      '110607016=           T.rnn,'
      '110607017=           T.idn,'
      '110607018=           T.KBE,'
      '110607019=           T.PHONE,'
      '110607020=           T.SKIDKA,'
      '110607021=           T.is_supplier,'
      '110607022=           T.BY_DEFAULT,'
      '110607023=           T.IS_BEZNAL,'
      '110607024=           CASE T.is_supplier'
      '110607025=             WHEN 0 THEN '#39#1050#1083#1080#1077#1085#1090#39
      '110607026=             WHEN 1 THEN '#39#1055#1086#1089#1090#1072#1074#1097#1080#1082#39
      '110607027=           END IS_SUPPLIER_STR,'
      '110607028=           GC.SHORT_NAME,'
      '110607029=           COALESCE(D.G_DISCONT_CARD, 0),'
      '110607030=           D.BARCODE,'
      '110607031=           D.N_PERCENT,'
      '110607032=           D.SUMM,'
      '110607033=           D.SUMM_ALL,'
      '110607034=           T.NOTE'
      '110607035=           ,COALESCE(Z.SUMM_DOLG, 0)'
      '110607036=           ,P.NAME NAME_PROMO'
      
        '110607037=    FROM g_client t LEFT OUTER JOIN G_DISCONT_CARD D O' +
        'N T.G_CLIENT = D.G_CLIENT'
      
        '110607038=                    LEFT OUTER JOIN (SELECT SUM(SUMM -' +
        ' SUMM_FACT) SUMM_DOLG ,G_CLIENT FROM ZAKAZ WHERE IS_PAYED_ALL = ' +
        '0 GROUP BY G_CLIENT) Z ON T.G_CLIENT = Z.G_CLIENT'
      
        '110607039=                    LEFT OUTER JOIN G_PROMOTION P ON T' +
        '.g_promotion = P.g_promotion'
      '110607040=         ,G_CONTRAGENT GC'
      
        '110607041=   WHERE T.G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT' +
        '_, T.G_CLIENT_PARENT)  -- '#1048#1053#1054#1043#1044#1040' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      '110607042=     AND T.IS_CATEGORY = 0'
      '110607043=     AND T.G_CONTRAGENT = GC.G_CONTRAGENT'
      
        '110607044=     AND T.is_supplier = COALESCE(:IS_SUPPLIER_, T.IS_' +
        'SUPPLIER)'
      
        '110607045=     AND COALESCE(:G_CLIENT_PARENT_, 0) <> -1000      ' +
        '         -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110607046=   UNION ALL'
      '110607047=    SELECT T.G_TOCHKA g_client,'
      '110607048=           0 g_client_parent,'
      '110607049=           0 g_contragent,'
      '110607050=           T.name,'
      '110607051=           '#39#39' rnn,'
      '110607052=           '#39#39' idn,'
      '110607053=           '#39#39' KBE,'
      '110607054=           '#39#39' PHONE,'
      '110607055=           0 SKIDKA,'
      '110607056=           0 is_supplier,'
      '110607057=           0 BY_DEFAULT,'
      '110607058=           0 IS_BEZNAL,'
      '110607059=           '#39#1057#1082#1083#1072#1076#39' IS_SUPPLIER_STR,'
      '110607060=           '#39#39' SHORT_NAME,'
      '110607061=           0,'
      '110607062=           '#39#39' BARCODE,'
      '110607063=           0 N_PERCENT,'
      '110607064=           0 SUMM,'
      '110607065=           0 SUMM_ALL,'
      '110607066=           '#39#39' NOTE'
      '110607067=           ,0 SUMM_DOLG'
      '110607068=           ,'#39#39' NAME_PROMO'
      '110607069=    FROM G_TOCHKA T'
      
        '110607070=   WHERE T.G_TOCHKA <> (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      
        '110607071=     AND COALESCE(:G_CLIENT_PARENT_, 0) = -1000       ' +
        '        -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110607072=   ORDER BY 4'
      
        '110607073=    into :G_CLIENT, :G_CLIENT_PARENT, :G_CONTRAGENT, :' +
        'NAME, :RNN, :IDN, :KBE, :PHONE, :SKIDKA, :IS_SUPPLIER, :BY_DEFAU' +
        'LT,'
      
        '110607074=         :IS_BEZNAL, :IS_SUPPLIER_STR, :SUPPL_AGENT_NA' +
        'ME,'
      '110607075=         :G_DISCONT_CARD,'
      '110607076=         :BARCODE,'
      '110607077=         :N_PERCENT,'
      '110607078=         :SUMM,'
      '110607079=         :SUMM_ALL, :NOTE'
      '110607080=         ,:SUMM_DOLG'
      '110607081=         ,:G_PROMOTION_STR'
      '110607082=  DO'
      '110607083=    suspend;'
      '110607084=end'
      '110607085=;'
      '110607086='
      '110607087=ALTER PROCEDURE G_READ_G_CLIENTCAT_LIST('
      '110607088=  IS_SUPPLIER_ INTEGER)'
      '110607089=RETURNS ('
      '110607090=  G_CLIENT TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110607091=  G_CLIENT_PARENT TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      '110607092=  NAME VARCHAR(500))'
      '110607093=AS'
      '110607094=DECLARE VARIABLE ROW INTEGER;'
      '110607095=begin'
      '110607096=  FOR'
      '110607097=    SELECT 1 row, -1, null, '#39#1042#1089#1077#39
      '110607098=      from rdb$database'
      '110607099=    union all'
      '110607100=    select 2 row, G_CLIENT, G_CLIENT_PARENT, NAME'
      '110607101=           IS_BEZNAL'
      '110607102=    from G_CLIENT t'
      '110607103=    where T.IS_CATEGORY = 1'
      
        '110607104=      AND T.IS_SUPPLIER = coalesce(:IS_SUPPLIER_, T.IS' +
        '_SUPPLIER)'
      '110607105=    into :ROW, :G_CLIENT, :G_CLIENT_PARENT, :NAME'
      '110607106=  DO'
      '110607107=    suspend;'
      '110607108=end'
      '110607109=;'
      '110607110='
      '110607111=ALTER PROCEDURE G_READ_G_CONTRAGENT_LIST'
      '110607112=RETURNS ('
      
        '110607113=  G_CONTRAGENT TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGEN' +
        'T,'
      '110607114=  NAME VARCHAR(500),'
      '110607115=  SHORT_NAME VARCHAR(250))'
      '110607116=AS'
      '110607117=begin'
      '110607118=  FOR'
      '110607119=    select G_CONTRAGENT, NAME, SHORT_NAME'
      '110607120=    from G_CONTRAGENT'
      '110607121=    into :G_CONTRAGENT, :NAME, :SHORT_NAME'
      '110607122=  DO'
      '110607123=    suspend;'
      '110607124=end'
      '110607125=;'
      '110607126='
      '110607127=ALTER PROCEDURE G_READ_G_DISCOUNT_LIST('
      '110607128=  IS_ALL_ INTEGER)'
      '110607129=RETURNS ('
      '110607130=  G_DISCOUNT TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '110607131=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110607132=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110607133=  G_PRODUCT_PAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110607134=  DATE_BEGIN DATE,'
      '110607135=  DATE_END DATE,'
      '110607136=  NAME VARCHAR(1024),'
      '110607137=  PRICE NUMERIC(15,2),'
      '110607138=  SKIDKA_PROC NUMERIC(15,2),'
      '110607139=  SKIDKA_SUM NUMERIC(15,2),'
      '110607140=  IS_CONST INTEGER,'
      '110607141=  TOCHKA_NAME TYPE OF COLUMN G_TOCHKA.NAME)'
      '110607142=AS'
      '110607143=begin'
      '110607144=    FOR'
      '110607145=      SELECT GD.G_DISCOUNT, GD.G_PRODUCT, GP.NAME,'
      '110607146=             GD.DATE_BEGIN,'
      '110607147=             GD.DATE_END,'
      
        '110607148=             CASE WHEN GD.DATE_END IS NULL THEN 1 ELSE' +
        ' 0 END IS_CONST,'
      
        '110607149=             GD.NAME, GD.PRICE, GD.SKIDKA_PROC, GD.SKI' +
        'DKA_SUM,'
      
        '110607150=             CASE WHEN GD.G_TOCHKA IS NULL THEN '#39#1042#1089#1077' '#1090 +
        #1086#1095#1082#1080#39' ELSE T.NAME END'
      '110607151=             ,PAR.NAME'
      
        '110607152=      FROM G_DISCOUNT GD LEFT OUTER JOIN G_TOCHKA T ON' +
        ' GD.G_TOCHKA = T.G_TOCHKA,'
      '110607153=           G_PRODUCT GP,'
      '110607154=           G_PRODUCT PAR'
      '110607155=      WHERE GD.G_PRODUCT = GP.G_PRODUCT'
      '110607156=        AND GP.G_PRODUCT_PAR = PAR.G_PRODUCT'
      '110607157=        AND ('
      '110607158=             (('
      '110607159=                ('
      
        '110607160=                  GD.DATE_BEGIN <= CURRENT_DATE       ' +
        '-- '#1042#1067#1043#1056#1059#1046#1040#1070#1058#1057#1071' '#1057' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1052' '#1055#1045#1056#1048#1054#1044#1054#1052
      '110607161=                  AND'
      '110607162=                  GD.DATE_END >= CURRENT_DATE'
      '110607163=                  AND GD.DATE_BEGIN IS NOT NULL'
      '110607164=                  AND GD.DATE_END IS NOT NULL'
      '110607165=                )'
      '110607166=              OR'
      '110607167=                ('
      
        '110607168=                 GD.DATE_BEGIN IS NULL AND GD.DATE_END' +
        ' IS NULL  -- '#1040' '#1058#1040#1050#1046#1045' '#1055#1054#1057#1058#1054#1071#1053#1053#1067#1045' '#1057#1050#1048#1044#1050#1048
      '110607169=                )'
      '110607170=              )'
      '110607171=              AND :IS_ALL_ = 1)'
      '110607172=             OR'
      
        '110607173=             (:IS_ALL_ = 0)                           ' +
        '          -- '#1051#1048#1041#1054' '#1042#1057#1045
      '110607174=            )'
      
        '110607175=      INTO :G_DISCOUNT, :G_PRODUCT, :G_PRODUCT_NAME, :' +
        'DATE_BEGIN, :DATE_END, :IS_CONST, :NAME, :PRICE, :SKIDKA_PROC, :' +
        'SKIDKA_SUM,'
      '110607176=           :TOCHKA_NAME'
      '110607177=           ,:G_PRODUCT_PAR_NAME'
      '110607178=    DO'
      '110607179=      SUSPEND;'
      '110607180=end'
      '110607181=;'
      '110607182='
      '110607183=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110607184=  TYPE_ INTEGER = 0)'
      '110607185=RETURNS ('
      '110607186=  SORT_COL INTEGER,'
      '110607187=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110607188=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '110607189=  ARTICUL VARCHAR(30),'
      '110607190=  NOMENCLATUR_NUM VARCHAR(30),'
      '110607191=  BARCODE VARCHAR(30),'
      '110607192=  NAME VARCHAR(500),'
      '110607193=  G_UNIT TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110607194=  PRICE NUMERIC(15,2),'
      '110607195=  VOLUME_PRICE NUMERIC(15,2),'
      '110607196=  IS_CATEGORY INTEGER)'
      '110607197=AS'
      '110607198=begin'
      '110607199=    FOR'
      '110607200=    SELECT'
      
        '110607201=        DECODE(T.G_PRODUCT, -1, T.g_product, 0) SORT_C' +
        'OL,'
      '110607202=        T.G_PRODUCT,'
      '110607203=        T.G_PRODUCT_PAR,'
      '110607204=        T.ARTICUL,'
      '110607205=        T.NOMENCLATUR_NUM,'
      '110607206=        T.BARCODE,'
      '110607207=        T.NAME,'
      '110607208=        T.G_UNIT,'
      '110607209=        T.PRICE,'
      '110607210=        T.VOLUME_PRICE,'
      '110607211=        T.IS_CATEGORY'
      '110607212=    FROM G_PRODUCT T'
      '110607213=    WHERE T.IS_CATEGORY = 1'
      '110607214=    ORDER BY 1, 7, 2'
      '110607215=    INTO'
      '110607216=        :SORT_COL,'
      '110607217=        :G_PRODUCT,'
      '110607218=        :G_PRODUCT_PAR,'
      '110607219=        :ARTICUL,'
      '110607220=        :NOMENCLATUR_NUM,'
      '110607221=        :BARCODE,'
      '110607222=        :NAME,'
      '110607223=        :G_UNIT,'
      '110607224=        :PRICE,'
      '110607225=        :VOLUME_PRICE,'
      '110607226=        :IS_CATEGORY'
      '110607227=  DO'
      '110607228=    suspend;'
      '110607229=end'
      '110607230=;'
      '110607231='
      '110607232=ALTER PROCEDURE G_READ_G_PRODUCT_LIST('
      
        '110607233=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110607234=  IS_ACTIVE_ INTEGER = 1)'
      '110607235=RETURNS ('
      '110607236=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110607237=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '110607238=  ARTICUL VARCHAR(30),'
      '110607239=  NOMENCLATUR_NUM VARCHAR(30),'
      '110607240=  BARCODE VARCHAR(1000),'
      '110607241=  NAME VARCHAR(500),'
      '110607242=  G_UNIT VARCHAR(150),'
      '110607243=  PRICE NUMERIC(15,2),'
      '110607244=  VOLUME_PRICE NUMERIC(15,2),'
      '110607245=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110607246=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110607247=  IS_CATEGORY INTEGER,'
      '110607248=  IS_ACTIVE INTEGER,'
      '110607249=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110607250=  AMOUNT_NA_REAL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '110607251=  SKIDKA_PROC NUMERIC(15,2),'
      '110607252=  SKIDKA_SUM NUMERIC(15,2))'
      '110607253=AS'
      '110607254=begin'
      '110607255=    FOR SELECT'
      '110607256=        T.G_PRODUCT,'
      '110607257=        T.G_PRODUCT_PAR,'
      '110607258=        T.ARTICUL,'
      '110607259=        T.NOMENCLATUR_NUM,'
      
        '110607260=        T.BARCODE||COALESCE('#39', '#39'||SUBSTRING((SELECT LI' +
        'ST(L.BARCODE, '#39', '#39')'
      
        '110607261=                                        FROM LT_BARCOD' +
        'E L'
      
        '110607262=                                        WHERE L.G_PROD' +
        'UCT = T.G_PRODUCT) FROM 1 FOR 999), '#39#39'),'
      '110607263=        T.NAME,'
      '110607264=        GU.NAME AS G_UNIT,'
      '110607265=        T.PRICE,'
      '110607266=        T.VOLUME_PRICE,'
      '110607267=        T.PACK_AMOUNT,'
      '110607268=        T.MF_COUNTRY,'
      '110607269=        T.IS_CATEGORY,'
      '110607270=        T.IS_ACTIVE,'
      '110607271=        COALESCE(P.AMOUNT, 0),'
      
        '110607272=        COALESCE((SELECT SUM(Z.AMOUNT_ALL - Z.AMOUNT_P' +
        'AYED - COALESCE(Z.AMOUNT_RETURNED, 0))'
      
        '110607273=                    FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_P' +
        'ARENT ZP'
      
        '110607274=                   WHERE Z.G_PRODUCT = T.G_PRODUCT AND' +
        ' Z.IS_PAYED_ALL = 0'
      
        '110607275=                     AND ZP.ZAKAZ_REAL_PARENT = Z.ZAKA' +
        'Z_REAL_PARENT'
      
        '110607276=                     AND ZP.G_TOCHKA = (SELECT ID FROM' +
        ' CUR_PARAMS WHERE CUR_PARAMS = 2)), 0) AMOUNT_NA_REAL,'
      '110607277=        PP.SKIDKA_PROC,'
      '110607278=        PP.SKIDKA_SUM'
      
        '110607279=    FROM G_PRODUCT T LEFT OUTER JOIN (SELECT * FROM LT' +
        '_SKLAD_PRODUCT WHERE G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHERE' +
        ' CUR_PARAMS = 2))  P ON T.G_PRODUCT = P.G_PRODUCT'
      
        '110607280=         LEFT OUTER JOIN (SELECT G_PRODUCT, D.SKIDKA_P' +
        'ROC, D.SKIDKA_SUM'
      '110607281=                            FROM G_DISCOUNT D'
      
        '110607282=                            WHERE (D.DATE_BEGIN <= CUR' +
        'RENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110607283=                                    AND D.DATE_END >= ' +
        'CURRENT_TIMESTAMP'
      
        '110607284=                                    AND D.DATE_BEGIN I' +
        'S NOT NULL AND D.DATE_END IS NOT NULL'
      '110607285=                                  )'
      '110607286=                                  OR'
      
        '110607287=                                  (D.DATE_BEGIN IS NUL' +
        'L AND D.DATE_END IS NULL)'
      
        '110607288=                         ) PP ON T.G_PRODUCT = PP.G_PR' +
        'ODUCT,'
      '110607289=         G_UNIT GU'
      
        '110607290=    WHERE T.G_PRODUCT_PAR = DECODE(:G_PRODUCT_PAR_, -1' +
        ', T.G_PRODUCT_PAR, :G_PRODUCT_PAR_)  -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067' '#1048 +
        #1051#1048' '#1057#1058#1056#1054#1043#1054' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '110607291=    AND T.IS_CATEGORY = 0'
      '110607292=    AND T.IS_ACTIVE = :IS_ACTIVE_'
      '110607293=    AND T.G_UNIT = GU.G_UNIT'
      '110607294=    ORDER BY T.NAME'
      '110607295=    INTO'
      '110607296=        :G_PRODUCT,'
      '110607297=        :G_PRODUCT_PAR,'
      '110607298=        :ARTICUL,'
      '110607299=        :NOMENCLATUR_NUM,'
      '110607300=        :BARCODE,'
      '110607301=        :NAME,'
      '110607302=        :G_UNIT,'
      '110607303=        :PRICE,'
      '110607304=        :VOLUME_PRICE,'
      '110607305=        :PACK_AMOUNT,'
      '110607306=        :MF_COUNTRY,'
      '110607307=        :IS_CATEGORY,'
      '110607308=        :IS_ACTIVE,'
      '110607309=        :AMOUNT,'
      '110607310=        :AMOUNT_NA_REAL,'
      '110607311=        :SKIDKA_PROC,'
      '110607312=        :SKIDKA_SUM'
      '110607313=  DO'
      '110607314=    suspend;'
      '110607315=end'
      '110607316=;'
      '110607317='
      '110607318=ALTER PROCEDURE G_READ_G_UNIT_LIST'
      '110607319=RETURNS ('
      '110607320=  G_UNIT TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110607321=  NAME VARCHAR(500),'
      '110607322=  SHORT_NAME VARCHAR(200))'
      '110607323=AS'
      '110607324=begin'
      '110607325=    FOR SELECT'
      '110607326=        T.G_UNIT,'
      '110607327=        T.NAME,'
      '110607328=        T.SHORT_NAME'
      '110607329=    FROM G_UNIT T'
      '110607330=    ORDER BY T.NAME'
      '110607331=    INTO'
      '110607332=        :G_UNIT,'
      '110607333=        :NAME,'
      '110607334=        :SHORT_NAME'
      '110607335=  DO'
      '110607336=    suspend;'
      '110607337=end'
      '110607338=;'
      '110607339='
      '110607340=ALTER PROCEDURE G_SET_G_PRODUCT_NOT_ACTIVE('
      '110607341=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110607342=  IS_ACTIVE_ INTEGER)'
      '110607343=RETURNS ('
      '110607344=  ERR_CODE INTEGER,'
      '110607345=  ERR_MSG VARCHAR(1024))'
      '110607346=AS'
      '110607347=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '110607348=begin'
      '110607349=  PROCNAME = '#39'G_SET_G_PRODUCT_NOT_ACTIVE'#39';'
      '110607350='
      '110607351=  delete from G_PRODUCT g'
      '110607352=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110607353='
      '110607354=  ERR_CODE = -20500;'
      
        '110607355=  EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086#1074#1072 +
        #1088' '#1085#1077' '#1091#1095#1072#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1076#1072#1078#1072#1093'/'#1087#1088#1080#1093#1086#1076#1072#1093'! '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1077#1075#1086' '#1087#1088#1086#1089#1090#1086' '#1091#1076#1072#1083#1080#1090 +
        #1100'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110607356=  ERR_MSG = PROCNAME||ERR_MSG;'
      '110607357=  EXIT;'
      '110607358='
      '110607359=when sqlcode -530 DO'
      '110607360=  begin'
      '110607361=    UPDATE G_PRODUCT g'
      '110607362=       SET G.IS_ACTIVE = :IS_ACTIVE_'
      '110607363=     where g.G_PRODUCT = :G_PRODUCT_;'
      '110607364=  end'
      '110607365=end'
      '110607366=;'
      '110607367='
      '110607368=ALTER PROCEDURE G_UPD_G_CLIENT_CAT('
      '110607369=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110607370=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      '110607371=  IS_SUPPLIER_ INTEGER,'
      '110607372=  NAME_ TYPE OF COLUMN G_CLIENT.NAME)'
      '110607373=RETURNS ('
      '110607374=  ERR_CODE INTEGER,'
      '110607375=  ERR_MSG VARCHAR(1024))'
      '110607376=AS'
      '110607377=begin'
      '110607378=    UPDATE G_CLIENT C'
      '110607379=       SET C.name = :NAME_,'
      '110607380=           C.g_client_parent = :g_client_parent_'
      '110607381=     WHERE C.g_client = :G_CLIENT_;'
      '110607382=end'
      '110607383=;'
      '110607384='
      '110607385=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110607386=  G_PRODUCT_ INTEGER,'
      '110607387=  G_PRODUCT_PAR_ INTEGER,'
      '110607388=  ARTICUL_ VARCHAR(30),'
      '110607389=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110607390=  BARCODE_ VARCHAR(30),'
      '110607391=  NAME_ VARCHAR(500),'
      '110607392=  G_UNIT_ INTEGER,'
      '110607393=  PRICE_ NUMERIC(15,2),'
      '110607394=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110607395=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110607396=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110607397=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110607398=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110607399=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110607400=  IS_CATEGORY_ INTEGER,'
      '110607401=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110607402=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110607403=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '110607404=RETURNS ('
      '110607405=  ERR_CODE INTEGER,'
      '110607406=  ERR_MSG VARCHAR(1024))'
      '110607407=AS'
      
        '110607408=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODU' +
        'CT'#39';'
      '110607409=DECLARE VARIABLE N_CURR_ INTEGER;'
      '110607410=DECLARE VARIABLE N INTEGER;'
      '110607411=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110607412=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110607413=begin'
      
        '110607414=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110607415=    SELECT COUNT(*)'
      '110607416=      FROM G_PRODUCT G'
      '110607417=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '110607418=       AND TRIM(G.ARTICUL) <> '#39#39
      '110607419=       AND TRIM(:ARTICUL_) <> '#39#39
      '110607420=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110607421=      INTO :CNT_;'
      '110607422='
      '110607423=    IF (CNT_ > 0) THEN BEGIN'
      '110607424=      ERR_CODE = -20500;'
      
        '110607425=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077 +
        ' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '110607426=      EXIT;'
      '110607427=    END'
      '110607428='
      '110607429=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110607430=    SELECT COUNT(*)'
      '110607431=      FROM G_PRODUCT G'
      
        '110607432=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOME' +
        'NCLATUR_NUM_))'
      '110607433=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110607434=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '110607435=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110607436=    INTO :CNT_;'
      '110607437=    IF (CNT_ > 0) THEN BEGIN'
      '110607438=      ERR_CODE = -20500;'
      
        '110607439=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLA' +
        'TUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '110607440=      EXIT;'
      '110607441=    END'
      '110607442='
      '110607443=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110607444=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110607445=        SELECT COUNT(*)'
      '110607446=          FROM G_PRODUCT G'
      
        '110607447=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110607448=           AND TRIM(G.BARCODE) <> '#39#39
      '110607449=           AND TRIM(:BARCODE_) <> '#39#39
      '110607450=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '110607451=          INTO :CNT_;'
      '110607452='
      '110607453=        IF (CNT_ = 0) then'
      '110607454=          SELECT COUNT(*)'
      '110607455=            FROM G_PRODUCT G, LT_BARCODE L'
      '110607456=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110607457=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110607458=             AND TRIM(L.BARCODE) <> '#39#39
      '110607459=            INTO :CNT_;'
      '110607460='
      '110607461=        IF (CNT_ > 0) THEN BEGIN'
      '110607462=          ERR_CODE = -20500;'
      
        '110607463=          ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_' +
        '||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '110607464=          EXIT;'
      '110607465=        END'
      '110607466=    END'
      '110607467='
      '110607468=    update G_PRODUCT'
      '110607469=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110607470=        ARTICUL = :ARTICUL_,'
      '110607471=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110607472=        BARCODE = :BARCODE_,'
      '110607473=        NAME = :NAME_,'
      '110607474=        G_UNIT = :G_UNIT_,'
      '110607475=        PRICE = :PRICE_,'
      '110607476=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110607477=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110607478=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110607479=        NOTE         = :NOTE_,'
      '110607480=        CROSSCODE    = :CROSSCODE_,'
      '110607481=        IS_KIT       = :IS_KIT_,'
      '110607482=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110607483=        PLACE        = :PLACE_,'
      '110607484=        SALES_COMM   = :SALES_COMM_'
      '110607485=    where (G_PRODUCT = :G_PRODUCT_);'
      '110607486='
      '110607487=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110607488=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110607489='
      '110607490=        INSERT INTO LT_BARCODE'
      
        '110607491=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110607492='
      '110607493=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110607494=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110607495=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110607496='
      
        '110607497=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110607498=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110607499='
      '110607500=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110607501=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110607502=            INSERT INTO G_PRODUCT_KIT'
      
        '110607503=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110607504=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110607505=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110607506=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110607507='
      
        '110607508=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110607509=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110607510='
      '110607511=            UPDATE G_PRODUCT_KIT G'
      
        '110607512=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110607513=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110607514=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110607515=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110607516='
      
        '110607517=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110607518=            if (is_kit_ = 1) then begin'
      '110607519=                SELECT MIN(L.AMOUNT)'
      '110607520=                  FROM G_PRODUCT_KIT K,'
      '110607521=                       LT_SKLAD_PRODUCT L'
      '110607522=                 WHERE K.g_product = :G_PRODUCT_'
      '110607523=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110607524=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110607525=                 GROUP BY K.G_PRODUCT'
      '110607526=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110607527='
      '110607528=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110607529=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110607530=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110607531=            end'
      '110607532=        END'
      '110607533=    END'
      '110607534=end'
      '110607535=;'
      '110607536='
      '110607537=ALTER PROCEDURE G_UPD_G_PRODUCT_CAT('
      '110607538=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110607539=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110607540=  NAME_ VARCHAR(500),'
      '110607541=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110607542=  IS_CATEGORY_ INTEGER)'
      '110607543=RETURNS ('
      '110607544=  ERR_CODE INTEGER,'
      '110607545=  ERR_MSG VARCHAR(1024))'
      '110607546=AS'
      '110607547=begin'
      '110607548=    UPDATE G_PRODUCT G'
      '110607549=       SET G.g_product_par = :G_PRODUCT_PAR_'
      '110607550=           ,G.name = :name_'
      '110607551=     WHERE G.g_product = :G_PRODUCT_;'
      '110607552=end'
      '110607553=;'
      '110607554='
      '110607555=ALTER PROCEDURE GET_OFFIC_HAVE_RIGHT('
      '110607556=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110607557=  RIGHTS_ITEM_ INTEGER)'
      '110607558=RETURNS ('
      '110607559=  HAVE_RIGHT_ INTEGER)'
      '110607560=AS'
      '110607561=DECLARE VARIABLE CNT INTEGER;'
      '110607562=BEGIN'
      '110607563='
      '110607564=  SELECT COUNT(*)'
      '110607565=  FROM G_OFFICIAL_RIGHT'
      '110607566=  WHERE'
      '110607567=    G_Official = :G_Official_'
      '110607568=    AND Rights_Item = :Rights_Item_'
      '110607569=  INTO :Have_Right_;'
      '110607570='
      '110607571=  if (Have_Right_ IS NULL) then'
      '110607572=    Have_Right_ = 0;'
      '110607573=END'
      '110607574=;'
      '110607575='
      '110607576=ALTER PROCEDURE GET_ZAKAZ('
      '110607577=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '110607578=RETURNS ('
      '110607579=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110607580=  Z_DATE_ DATE,'
      '110607581=  Z_TIME_ TIME,'
      '110607582=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110607583=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110607584=  OSNOVANIE_ VARCHAR(500),'
      '110607585=  IS_SPISANIE_ INTEGER,'
      '110607586=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110607587=  ERR_CODE INTEGER,'
      '110607588=  ERR_MSG VARCHAR(1024))'
      '110607589=AS'
      '110607590=begin'
      
        '110607591=    SELECT G_TOCHKA, Z_DATE, Z_TIME, G_CLIENT, G_PAYME' +
        'NT_TYPE, OSNOVANIE, IS_SPISANIE, NOTE'
      '110607592=    FROM ZAKAZ'
      '110607593=    WHERE ZAKAZ = :ZAKAZ_'
      
        '110607594=    INTO :G_TOCHKA_, :Z_DATE_, :Z_TIME_, :G_CLIENT_, :' +
        'G_PAYMENT_TYPE_, :OSNOVANIE_, :IS_SPISANIE_, :NOTE_;'
      '110607595=end'
      '110607596=;'
      '110607597='
      '110607598=ALTER PROCEDURE GET_ZAKAZ_DETAILS_TMP('
      
        '110607599=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS)'
      '110607600=RETURNS ('
      
        '110607601=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110607602=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110607603=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110607604=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110607605=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '110607606=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '110607607=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '110607608=  NDS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '110607609=  NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '110607610=  TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110607611=  ROZN_PRICE_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110607612=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110607613=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110607614=  OSTATOK_ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110607615=  CNT_Z_ INTEGER,'
      '110607616=  ERR_CODE INTEGER,'
      '110607617=  ERR_MSG VARCHAR(1024))'
      '110607618=AS'
      '110607619=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      '110607620=BEGIN'
      '110607621=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110607622=  /*CNT_Z_ = 0;'
      '110607623=  SELECT COUNT(*)'
      '110607624=    FROM (SELECT *'
      '110607625=           FROM ZAKAZ Z ROWS 1 TO 100)'
      '110607626=    INTO :CNT_Z_;*/'
      '110607627='
      '110607628=  SELECT'
      '110607629=    t.G_PRODUCT,'
      '110607630=    t.AMOUNT,'
      '110607631=    t.PRICE,'
      '110607632=    t.SUMM,'
      '110607633=    t.DISCOUNT_PERC,'
      '110607634=    T.DISCOUNT_TENGE,'
      '110607635=    T.DISCOUNT_SUMM,'
      '110607636=    T.NDS,'
      '110607637=    T.NDS_SUMM,'
      '110607638=    G.NAME,'
      '110607639=    G.price,'
      '110607640=    G.VOLUME_PRICE,'
      '110607641=    G.PACK_AMOUNT,'
      '110607642=    LT.AMOUNT'
      '110607643=  FROM ZAKAZ_DETAILS_TMP t,'
      
        '110607644=       G_PRODUCT G LEFT OUTER JOIN LT_SKLAD_PRODUCT LT' +
        ' ON G.G_PRODUCT = LT.G_PRODUCT AND LT.G_TOCHKA = (SELECT ID FROM' +
        ' CUR_PARAMS WHERE CUR_PARAMS = 2)'
      '110607645=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '110607646=    AND T.G_PRODUCT = G.G_PRODUCT'
      '110607647=  INTO'
      '110607648=    :G_PRODUCT_,'
      '110607649=    :AMOUNT_,'
      '110607650=    :PRICE_,'
      '110607651=    :SUMM_,'
      '110607652=    :DISCOUNT_PERC_,'
      '110607653=    :DISCOUNT_TENGE_,'
      '110607654=    :DISCOUNT_SUMM_,'
      '110607655=    :NDS_,'
      '110607656=    :NDS_SUMM_,'
      '110607657=    :TOVAR_NAME_,'
      '110607658=    :ROZN_PRICE_,'
      '110607659=    :VOLUME_PRICE_,'
      '110607660=    :PACK_AMOUNT_,'
      '110607661=    :OSTATOK_;'
      '110607662=end'
      '110607663=;'
      '110607664='
      '110607665=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '110607666=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110607667=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110607668=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110607669=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110607670=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110607671=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110607672=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110607673=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110607674=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110607675=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110607676=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110607677=  IS_SPISANIE_ INTEGER,'
      '110607678=  NEW_LINE_SALE_ INTEGER = 0,'
      '110607679=  MODE_ INTEGER = 0,'
      '110607680=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1)'
      '110607681=RETURNS ('
      
        '110607682=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110607683=  ERR_CODE INTEGER,'
      '110607684=  ERR_MSG VARCHAR(1024))'
      '110607685=AS'
      '110607686=/*'
      
        '110607687=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048 +
        #1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '110607688=*/'
      
        '110607689=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39';'
      
        '110607690=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110607691=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      
        '110607692=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110607693=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110607694=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110607695=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110607696=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110607697=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110607698=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '110607699=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110607700=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' */'
      '110607701=BEGIN'
      '110607702='
      
        '110607703=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110607704=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110607705=    FROM ZAKAZ_DETAILS_TMP T'
      '110607706=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110607707=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110607708=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110607709='
      
        '110607710=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110607711=           ,G.IS_KIT'
      '110607712=           ,K.AMOUNT * :AMOUNT_'
      '110607713=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110607714=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      
        '110607715=           ,DECODE(:USE_SELF_PRICE_ONTRANSFER_, 1, K.P' +
        'RICE, (SELECT * FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL,' +
        ' 1))) COST_PRICE'
      
        '110607716=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110607717=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110607718=       AND IS_KIT = 1'
      '110607719=    UNION'
      
        '110607720=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110607721=           ,G.IS_KIT'
      '110607722=           ,:AMOUNT_'
      '110607723=           ,:PRICE_'
      '110607724=           ,0'
      '110607725=           ,:COST_PRICE_'
      '110607726=      FROM G_PRODUCT G'
      '110607727=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110607728=       AND IS_KIT <> 1'
      '110607729=      INTO :G_PRODUCT_'
      '110607730=           ,:IS_KIT_'
      '110607731=           ,:AMOUNT_'
      '110607732=           ,:PRICE__'
      '110607733=           ,:SOSTAV_PRICE_'
      '110607734=           ,:COST_PRICE__'
      '110607735=  DO BEGIN'
      '110607736=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110607737='
      
        '110607738=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110607739=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110607740=        IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110607741=          PRICE__ = COST_PRICE__;'
      '110607742='
      
        '110607743=        END ELSE IF (Discount_perc_ <> 0) THEN BEGIN  ' +
        '    -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110607744=          DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PERC_/1' +
        '00;'
      '110607745='
      '110607746='
      
        '110607747=        END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN BEG' +
        'IN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110607748=          DISCOUNT_PERC_ = PRICE_ * 100 / SOSTAV_PRICE' +
        '_;'
      '110607749=          DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_;'
      '110607750=        END'
      '110607751='
      '110607752=        DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT_;'
      '110607753=        SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOUNT_;'
      '110607754=        NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110607755=      END'
      '110607756='
      
        '110607757=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '110607758=      IF (NEW_LINE_SALE_ = 0) THEN'
      '110607759=          SELECT ZD.zakaz_details'
      '110607760=            FROM zakaz_details_tmp ZD'
      '110607761=           WHERE ZD.G_PRODUCT = :g_product_'
      '110607762=             AND ZD.PRICE = :PRICE__'
      '110607763=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110607764=            INTO :ZAKAZ_DTLS_TMP_;'
      '110607765='
      '110607766='
      '110607767=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110607768=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110607769=           SET P.amount = P.amount + :amount_'
      
        '110607770=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110607771=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110607772=               ,P.NDS = :NDS_'
      '110607773=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110607774=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110607775='
      '110607776=      ELSE BEGIN'
      '110607777=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110607778=          ('
      '110607779=           ZAKAZ_DETAILS,'
      '110607780=           ZAKAZ,'
      '110607781=           G_PRODUCT,'
      '110607782=           AMOUNT,'
      '110607783=           PRICE,'
      '110607784=           SUMM,'
      '110607785=           DISCOUNT_PERC,'
      '110607786=           DISCOUNT_TENGE,'
      '110607787=           DISCOUNT_SUMM,'
      '110607788=           NDS,'
      '110607789=           NDS_SUMM,'
      '110607790=           COST_PRICE'
      '110607791=          ) VALUES ('
      '110607792=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110607793=           :ZAKAZ_,'
      '110607794=           :G_PRODUCT_,'
      '110607795=           :AMOUNT_,'
      '110607796=           :PRICE__,'
      '110607797=           :SUMM_,'
      '110607798=           :DISCOUNT_PERC_,'
      '110607799=           :DISCOUNT_TENGE_,'
      '110607800=           :DISCOUNT_SUMM_,'
      '110607801=           :NDS_,'
      '110607802=           :NDS_SUMM_,'
      '110607803=           :COST_PRICE__'
      '110607804=          )'
      '110607805=          RETURNING'
      '110607806=            ZAKAZ_DETAILS'
      '110607807=          INTO'
      '110607808=            :ZAKAZ_DETAILS_;'
      '110607809=      END'
      '110607810='
      '110607811=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110607812=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110607813=        FROM LT_SKLAD_PRODUCT L'
      '110607814=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110607815=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110607816=       INTO :AMOUNT_CUR_;'
      '110607817='
      
        '110607818=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110607819=      if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      
        '110607820=          -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110607821=          -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', ' +
        #1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110607822=          -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' ' +
        #1050#1054#1051#1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110607823=          -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' '#1041#1067#1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057 +
        #1050#1054#1051#1068#1050#1054
      
        '110607824=          -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054 +
        #1042#1040#1058#1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110607825=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110607826=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110607827=              SELECT SUM(AMOUNT)'
      '110607828=                FROM ZAKAZ_DETAILS T'
      '110607829=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110607830=                 AND T.ZAKAZ = :ZAKAZ_'
      '110607831=                INTO :AMOUNT_OLD_;'
      '110607832=            ELSE'
      '110607833=              SELECT SUM(AMOUNT)'
      '110607834=                FROM SKLAD T'
      '110607835=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110607836=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '110607837=                INTO :AMOUNT_OLD_;'
      '110607838=          END'
      '110607839='
      '110607840=          -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110607841=          SELECT SUM(AMOUNT)'
      '110607842=            FROM ZAKAZ_DETAILS_TMP T'
      '110607843=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110607844=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '110607845='
      
        '110607846=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKA' +
        'Z_, 0);'
      
        '110607847=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0)' +
        ';'
      '110607848='
      
        '110607849=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COA' +
        'LESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110607850=            SELECT NAME'
      '110607851=            FROM G_PRODUCT'
      '110607852=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110607853=            INTO :PRODUCT_NAME_;'
      '110607854='
      '110607855=            ERR_CODE = -20500;'
      
        '110607856=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110607857=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110607858=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110607859=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110607860=            EXIT;'
      '110607861=          END'
      '110607862=      END'
      '110607863=  END'
      '110607864=end'
      '110607865=;'
      '110607866='
      '110607867=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP_REAL('
      
        '110607868=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
