      '1102491070=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1102491071=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1102491072=                PNT_ = '#39'05'#39';'
      
        '1102491073=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1102491074=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
