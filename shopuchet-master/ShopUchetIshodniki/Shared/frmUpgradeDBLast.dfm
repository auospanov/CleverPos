      '110182146=    FROM G_OFFICIAL O'
      '110182147=    WHERE O.IS_GLAVBUH = 1'
      '110182148=    INTO :GLAVBUH_;'
      '110182149='
      
        '110182150=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1053#1040#1050#1051#1040#1044#1053#1054#1049', '#1057#1053#1040#1063#1040#1051#1040' '#1057#1044#1045#1051#1040#1051 +
        ' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '110182151=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(M' +
        'AX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMERI' +
