        '1102014464=  FOR SELECT TRIM(RDB$RELATION_FIELDS.RDB$RELATION_NA' +
        'ME),'
      '1102014465=             TRIM(RDB$RELATION_FIELDS.RDB$FIELD_NAME)'
      
        '1102014466=        FROM RDB$RELATION_FIELDS JOIN RDB$FIELDS ON R' +
        'DB$RELATION_FIELDS.RDB$FIELD_SOURCE=RDB$FIELDS.RDB$FIELD_NAME'
      
        '1102014467=       WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T CONTAINING '#39'$'#39
      '1102014468=         AND RDB$FIELDS.RDB$FIELD_TYPE = 261'
      '1102014469=         AND RDB$FIELDS.RDB$FIELD_SUB_TYPE = 0'
      
        '1102014470=         AND RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T IN ('#39'CUR_PARAMS'#39', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_' +
        'SIZES'#39','
      
        '1102014471=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1102014472=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1102014473=                                         '#39'P_REP_PROFI' +
