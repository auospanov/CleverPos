        '1102016383=                                              :SKLAD_' +
        'PARENT_,'
      
        '1102016384=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1102016385=                                              :G_TOCH' +
        'KA_,'
      
        '1102016386=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102016387=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102016388='
      
        '1102016389=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102016390=            ELSE BEGIN'
      
        '1102016391=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102016392=                SELECT 1'
      '1102016393=                  FROM KASSA K'
      '1102016394=                 WHERE K.KASSA = :KASSA_'
      '1102016395=                UNION ALL'
      '1102016396=                SELECT 2'
      '1102016397=                  FROM KASSA_BEZNAL KB'
      '1102016398=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102016399=                 INTO :PAYMENT_TYPE_OLD_;'
      '1102016400='
      
        '1102016401=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102016402=                      PNT_ = '#39'010'#39';'
      
        '1102016403=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1102016404=                                                    1' +
        ',     -- ACTION_'
      
        '1102016405=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1102016406=                                                    :' +
