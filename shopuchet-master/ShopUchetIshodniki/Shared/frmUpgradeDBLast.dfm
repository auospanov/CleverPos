        'TOCHKA), 0) - (C.DEBET + '#39'||DEBET_||'#39') + (C.CREDIT + '#39'||CREDIT_|' +
        '|'#39') '#39'||'
      '110202456=                       '#39'WHEN NOT MATCHED THEN '#39'||'
      
