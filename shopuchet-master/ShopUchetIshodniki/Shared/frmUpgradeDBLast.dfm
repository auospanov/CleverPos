        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1091#1093#1086#1076#1072' ('#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110197832='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        #39'||'#39
      
        '110197833='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110197834=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110197835=    EXIT;'
      '110197836=  END'
      '110197837='
      
        '110197838=  SELECT SP.sklad||'#39' '#1086#1090' '#39'||lpad(extract(day from SP.da' +
        'te_receipt),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from SP.date_rec' +
        'eipt),2,'#39'0'#39') || '#39'.'#39' || extract(year from SP.date_receipt)'
      '110197839=    FROM sklad_parent SP'
      '110197840=   WHERE SP.sklad = ( SELECT MIN(S.sklad_parent)'
      '110197841=                        FROM sklad s'
      
        '110197842=                       WHERE s.G_PRODUCT = :G_PRODUCT_' +
        ')'
      '110197843=    INTO :NAKL_PROD_;'
      '110197844=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110197845=    ERR_CODE = -20500;'
      
        '110197846=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1087#1088#1080#1093#1086#1076#1072' ('#1086#1087#1088#1080#1093#1086#1076#1086#1074#1072#1085#1080#1077'/'#1074#1086#1079#1074#1088#1072#1090'/'#1087#1077#1088#1077#1084 +
        #1077#1097#1077#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110197847='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        ' '#39'||'#39
      
        '110197848='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110197849=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110197850=    EXIT;'
      '110197851=  END'
      '110197852='
      
        '110197853=  SELECT lpad(extract(day from MIN(za.op_date)),2,'#39'0'#39')' +
        ' || '#39'.'#39' || lpad(extract(month from MIN(za.op_date)),2,'#39'0'#39') || '#39'.' +
        #39' || extract(year from MIN(za.op_date))'
      '110197854=    FROM OTHER ZA, OTHER_DETAILS Z'
      '110197855=   WHERE ZA.OTHER = Z.other'
      '110197856=     AND Z.G_PRODUCT = :G_PRODUCT_'
      '110197857=  INTO :NAKL_PROD_;'
      '110197858=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110197859=    ERR_CODE = -20500;'
      
        '110197860=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072' '#1086#1090' '#39'||NAKL_PROD_||'#39' '#1095#1080#1089#1083#1072'.' +
        ' '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110197861=                                  '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090 +
        #1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080 +
        #1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110197862=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110197863=    EXIT;'
      '110197864=  END'
      '110197865=  */'
      '110197866='
      '110197867=  SELECT G.NAME'
      '110197868=    FROM G_PRODUCT G'
      '110197869=   WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110197870=    INTO :NAME_;'
      '110197871='
      '110197872=  delete from revision g'
      '110197873=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110197874='
      '110197875=  delete from g_product_image g'
      '110197876=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110197877='
      '110197878=  delete from G_DISCOUNT g'
      '110197879=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110197880='
      '110197881=  SELECT ('
      
        '110197882=          (SELECT COUNT(*) FROM ZAKAZ_DETAILS ZD WHERE' +
        ' ZD.G_PRODUCT = :G_PRODUCT_)'
      '110197883=          +'
      
        '110197884=          (SELECT COUNT(*) FROM SKLAD SD WHERE SD.G_PR' +
        'ODUCT = :G_PRODUCT_)'
      '110197885=          +'
      
        '110197886=          (SELECT COUNT(*) FROM OTHER_DETAILS OD WHERE' +
        ' OD.G_PRODUCT = :G_PRODUCT_)'
      '110197887=          +'
      
        '110197888=          (SELECT COUNT(*) FROM ZAKAZ_NA_REAL RD WHERE' +
        ' RD.G_PRODUCT = :G_PRODUCT_)'
      '110197889=         )'
      '110197890=    FROM RDB$DATABASE'
      '110197891=    INTO :CNT_;'
      '110197892='
      
        '110197893=  -- 18.05.2021 '#1057' '#1058#1048#1052#1054#1049' '#1056#1045#1064#1048#1051#1048', '#1045#1057#1051#1048' '#1060#1048#1047#1048#1063#1045#1057#1050#1048' '#1059' '#1052#1045#1053#1071' ' +
        #1058#1054#1042#1040#1056' '#1053#1045' '#1059#1044#1040#1051#1071#1045#1058#1057#1071', '#1058#1054' '#1045#1052#1059' '#1071' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1042#1067#1057#1067#1051#1040#1070', '#1055#1059#1057#1058#1068' '#1041#1054#1051#1058#1040#1045#1058#1057#1071',' +
        ' '#1055#1054#1050#1040' '#1041#1045#1047' '#1055#1056#1048#1047#1053#1040#1050#1040' '#1058#1040#1052' '#1054#1041#1054#1049#1044#1045#1052#1057#1071
      
        '110197894=  -- '#1053#1054' '#1055#1056#1048' '#1069#1058#1054#1052' '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1040#1055#1044#1045#1049#1058' G_PRODUCT_PAR, '#1063#1058#1054 +
        #1041#1067' '#1045#1057#1051#1048' '#1063#1058#1054' '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1040' '#1052#1054#1043#1051#1040' '#1059#1044#1040#1051#1048#1058#1057#1071
      '110197895=  IF (CNT_ = 0) THEN BEGIN'
      '110197896=    delete from LT_SKLAD_PRODUCT g'
      '110197897=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110197898='
      '110197899=    delete from lt_barcode g'
      '110197900=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110197901='
      '110197902=    delete from g_product_KIT g'
      '110197903=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110197904='
      
        '110197905=    delete from G_PRODUCT g where g.G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '110197906='
      
        '110197907=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110197908=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110197909=      UPDATE SYNC_EXT_APP AP'
      '110197910=         SET AP.OPER = 3'
      '110197911=       WHERE AP.OBJECT_TYPE = 4'
      '110197912=         AND AP.ID = :G_PRODUCT_'
      '110197913=         AND AP.IS_LOADING = 0;'
      '110197914='
      '110197915=      IF (ROW_COUNT = 0) THEN'
      
        '110197916=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110197917=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 3);'
      '110197918=    END'
      '110197919=  END ELSE BEGIN'
      '110197920=    UPDATE G_PRODUCT G'
      '110197921=       SET G.IS_ACTIVE = 0,'
      '110197922=           G.G_PRODUCT_PAR = -1'
      '110197923=     WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110197924='
      
        '110197925=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER)'
      
        '110197926=      SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRODUC' +
        'T_, 2'
      '110197927=        FROM RDB$DATABASE'
      
        '110197928=       WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP' +
        ' WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_LOAD' +
        'ING = 0);'
      '110197929=  END'
      '110197930='
      '110197931=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110197932=  EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_PRO' +
        'DUCT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '110197933='
      '110197934=when sqlcode -530 DO'
      '110197935=  begin'
      '110197936=    SELECT G.IS_CATEGORY'
      '110197937=      FROM G_PRODUCT G'
      '110197938=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110197939=      INTO :IS_CATEGORY_;'
      '110197940='
      '110197941=    ERR_CODE = -20500;'
      '110197942=    if (IS_CATEGORY_ = 0) then'
      
        '110197943=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '110197944=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076 +
        #1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081 +
        #1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110197945=    ELSE'
      
        '110197946=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110197947=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110197948=  end'
      '110197949=end'
      '110197950=;'
      '110197951='
      '110197952=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110197953=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110197954=  MODE_ INTEGER = 0)'
      '110197955=RETURNS ('
      
        '110197956=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110197957=  ARTICUL_ VARCHAR(30),'
      '110197958=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110197959=  BARCODE_ VARCHAR(30),'
      '110197960=  NAME_ VARCHAR(500),'
      '110197961=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110197962=  PRICE_ NUMERIC(15,2),'
      '110197963=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110197964=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110197965=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110197966=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110197967=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110197968=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110197969=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110197970=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110197971=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110197972=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110197973=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110197974=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      
        '110197975=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110197976=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110197977=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110197978=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110197979=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '110197980=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '110197981=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE,'
      '110197982=  ERR_CODE INTEGER,'
      '110197983=  ERR_MSG VARCHAR(1024))'
      '110197984=AS'
      '110197985=begin'
      '110197986=    SELECT'
      '110197987=        G_PRODUCT_PAR,'
      '110197988=        ARTICUL,'
      '110197989=        NOMENCLATUR_NUM,'
      '110197990=        BARCODE,'
      '110197991=        NAME,'
      '110197992=        G_UNIT,'
      '110197993=        PRICE,'
      '110197994=        VOLUME_PRICE,'
      '110197995=        PACK_AMOUNT,'
      '110197996=        MF_COUNTRY,'
      '110197997=        NOTE,'
      '110197998=        CROSSCODE,'
      '110197999=        IS_KIT,'
      '1101971000=        MIN_AMOUNT,'
      '1101971001=        PLACE,'
      '1101971002=        SALES_COMM,'
      '1101971003=        KOD_TNVD,'
      '1101971004=        FAST_TOVAR,'
      '1101971005=        DO_NOT_SHOW_RMK,'
      '1101971006=        DO_NOT_CHARGE_BONUS,'
      '1101971007=        IS_MARKED,'
      '1101971008=        BRAND,'
      
        '1101971009=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1)),'
      '1101971010=        IS_WEIGHT,'
      '1101971011=        VES_GRAMM,'
      '1101971012=        VES_GRAMM_PRICE'
      '1101971013=    FROM G_PRODUCT T'
      '1101971014=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101971015=    INTO'
      '1101971016=        :G_PRODUCT_PAR_,'
      '1101971017=        :ARTICUL_,'
      '1101971018=        :NOMENCLATUR_NUM_,'
      '1101971019=        :BARCODE_,'
      '1101971020=        :NAME_,'
      '1101971021=        :G_UNIT_,'
      '1101971022=        :PRICE_,'
      '1101971023=        :VOLUME_PRICE_,'
      '1101971024=        :PACK_AMOUNT_,'
      '1101971025=        :MF_COUNTRY_,'
      '1101971026=        :NOTE_,'
      '1101971027=        :CROSSCODE_,'
      '1101971028=        :IS_KIT_,'
      '1101971029=        :MIN_AMOUNT_,'
      '1101971030=        :PLACE_,'
      '1101971031=        :SALES_COMM_,'
      '1101971032=        :KOD_TNVD_,'
      '1101971033=        :FAST_TOVAR_,'
      '1101971034=        :DO_NOT_SHOW_RMK_,'
      '1101971035=        :DO_NOT_CHARGE_BONUS_,'
      '1101971036=        :IS_MARKED_,'
      '1101971037=        :BRAND_,'
      '1101971038=        :LAST_PRICE_,'
      '1101971039=        :IS_WEIGHT_,'
      '1101971040=        :VES_GRAMM_,'
      '1101971041=        :VES_GRAMM_PRICE_;'
      '1101971042='
      '1101971043=    INSERT INTO LT_BARCODE_TMP'
      
        '1101971044=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BAR' +
        'CODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '1101971045='
      '1101971046=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '1101971047=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :' +
        'G_PRODUCT_;'
      '1101971048='
      
        '1101971049=    INSERT INTO G_PRODUCT_KIT_TMP (G_PRODUCT_KIT, G_P' +
        'RODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3)'
      
        '1101971050=    SELECT DECODE(:MODE_, 0, G_PRODUCT_KIT, GEN_ID(GE' +
        'N_G_PRODUCT_KIT, 1)), G_PRODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, ' +
        'PRICE1, PRICE2, PRICE3'
      '1101971051=    FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRODUCT_;'
      '1101971052=end'
      '1101971053=;'
      '1101971054='
      '1101971055=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '1101971056=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101971057=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101971058=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '1101971059=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101971060=  PREFIX_ VARCHAR(2))'
      '1101971061=RETURNS ('
      '1101971062=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101971063=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT_PAR,'
      '1101971064=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101971065=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101971066=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101971067=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101971068=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '1101971069=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      
        '1101971070=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE,'
      '1101971071=  ERR_CODE INTEGER,'
      '1101971072=  ERR_MSG VARCHAR(1024))'
      '1101971073=AS'
      '1101971074=/*'
      '1101971075='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '1101971076=*/'
      
        '1101971077=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PROD' +
        'UCT_BY_BARCODE'#39';'
      '1101971078=BEGIN'
      '1101971079='
      '1101971080=    IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '1101971081=        ERR_CODE = -20500;'
      
        '1101971082=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080 +
        #1093#1082#1086#1076' '#1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101971083=        ERR_MSG = PROCNAME||ERR_MSG;'
      '1101971084=        EXIT;'
      '1101971085=    END'
      '1101971086='
      
        '1101971087=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) T' +
        'HEN BEGIN'
      '1101971088=        SELECT T.G_PRODUCT_PAR,'
      '1101971089=               T.G_PRODUCT,'
      '1101971090=               T.PRICE,'
      '1101971091=               T.VOLUME_PRICE,'
      '1101971092=               T.IS_KIT,'
      '1101971093=               T.IS_MARKED,'
      '1101971094=               T.IS_WEIGHT,'
      '1101971095=               T.VES_GRAMM_PRICE'
      '1101971096=          FROM G_PRODUCT T'
      
        '1101971097=          WHERE SUBSTRING(T.BARCODE FROM 1 FOR 7) = S' +
        'UBSTRING(:BARCODE_ FROM 1 FOR 7)'
      '1101971098=            AND T.IS_ACTIVE = 1'
      '1101971099=          INTO :G_PRODUCT_CATEGORY_,'
      '1101971100=               :G_PRODUCT_,'
      '1101971101=               :PRICE_,'
      '1101971102=               :VOLUME_PRICE_,'
      '1101971103=               :IS_KIT_,'
      '1101971104=               :IS_MARKED_,'
      '1101971105=               :IS_WEIGHT_,'
      '1101971106=               :VES_GRAMM_PRICE_;'
      '1101971107='
      
        '1101971108=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM ' +
        '8 FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '1101971109=    END ELSE'
      '1101971110=        SELECT T.G_PRODUCT_PAR,'
      '1101971111=               T.G_PRODUCT,'
      '1101971112=               T.PRICE,'
      '1101971113=               T.VOLUME_PRICE,'
      '1101971114=               T.IS_KIT,'
      '1101971115=               T.IS_MARKED,'
      '1101971116=               T.IS_WEIGHT,'
      '1101971117=               T.VES_GRAMM_PRICE'
      '1101971118=          FROM G_PRODUCT T'
      '1101971119=          WHERE T.BARCODE = :BARCODE_'
      '1101971120=            AND T.IS_ACTIVE = 1'
      '1101971121=          INTO :G_PRODUCT_CATEGORY_,'
      '1101971122=               :G_PRODUCT_,'
      '1101971123=               :PRICE_,'
      '1101971124=               :VOLUME_PRICE_,'
      '1101971125=               :IS_KIT_,'
      '1101971126=               :IS_MARKED_,'
      '1101971127=               :IS_WEIGHT_,'
      '1101971128=               :VES_GRAMM_PRICE_;'
      '1101971129='
      '1101971130=    IF (ROW_COUNT = 0) THEN BEGIN'
      
        '1101971131=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' ' +
        #1044#1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '1101971132=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_)' +
        ' THEN'
      '1101971133=          SELECT T.G_PRODUCT_PAR,'
      '1101971134=                 T.G_PRODUCT,'
      '1101971135=                 T.PRICE,'
      '1101971136=                 T.VOLUME_PRICE,'
      '1101971137=                 T.IS_KIT,'
      '1101971138=                 T.IS_MARKED,'
      '1101971139=                 T.IS_WEIGHT,'
      '1101971140=                 T.VES_GRAMM_PRICE'
      '1101971141=            FROM G_PRODUCT T, LT_BARCODE D'
      '1101971142=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1101971143=              AND T.IS_ACTIVE = 1'
      
        '1101971144=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) =' +
        ' SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '1101971145=            INTO'
      '1101971146=                :G_PRODUCT_CATEGORY_,'
      '1101971147=                :G_PRODUCT_,'
      '1101971148=                :PRICE_,'
      '1101971149=                :VOLUME_PRICE_,'
      '1101971150=                :IS_KIT_,'
      '1101971151=                :IS_MARKED_,'
      '1101971152=                :IS_WEIGHT_,'
      '1101971153=                :VES_GRAMM_PRICE_;'
      '1101971154=      ELSE'
      '1101971155=          SELECT T.G_PRODUCT_PAR,'
      '1101971156=                 T.G_PRODUCT,'
      '1101971157=                 T.PRICE,'
      '1101971158=                 T.VOLUME_PRICE,'
      '1101971159=                 T.IS_KIT,'
      '1101971160=                 T.IS_MARKED,'
      '1101971161=                 T.IS_WEIGHT,'
      '1101971162=                 T.VES_GRAMM_PRICE'
      '1101971163=            FROM G_PRODUCT T, LT_BARCODE D'
      '1101971164=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1101971165=              AND T.IS_ACTIVE = 1'
      '1101971166=              AND D.BARCODE = :BARCODE_'
      '1101971167=            INTO'
      '1101971168=                :G_PRODUCT_CATEGORY_,'
      '1101971169=                :G_PRODUCT_,'
      '1101971170=                :PRICE_,'
      '1101971171=                :VOLUME_PRICE_,'
      '1101971172=                :IS_KIT_,'
      '1101971173=                :IS_MARKED_,'
      '1101971174=                :IS_WEIGHT_,'
      '1101971175=                :VES_GRAMM_PRICE_;'
      '1101971176='
      '1101971177=      IF (ROW_COUNT = 0) THEN BEGIN'
      '1101971178=          ERR_CODE = -20500;'
      
        '1101971179=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1101971180=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101971181=          EXIT;'
      '1101971182=      END'
      '1101971183=    END'
      '1101971184='
      
        '1101971185=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) <> PREFIX_) ' +
        'THEN'
      
        '1101971186=        SELECT CASE WHEN LT.AMOUNT < 1 AND LT.AMOUNT ' +
        '> 0 AND ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = ' +
        '2) = 0) THEN LT.AMOUNT ELSE 1 END'
      '1101971187=          FROM LT_SKLAD_PRODUCT LT'
      '1101971188=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      
        '1101971189=           AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '1101971190=          INTO :AMOUNT_;'
      '1101971191=END'
      '1101971192=;'
      '1101971193='
      '1101971194=ALTER PROCEDURE G_GET_G_PRODUCT_SALEMODE('
      '1101971195=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101971196=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101971197=RETURNS ('
      '1101971198=  NAME_ VARCHAR(500),'
      '1101971199=  PRICE_ NUMERIC(15,2),'
      '1101971200=  ROZN_PRICE_ NUMERIC(15,2),'
      '1101971201=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101971202=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1101971203=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE,'
      '1101971204=  AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101971205=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101971206=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1101971207=  SKIDKA_SUMM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1101971208=  ERR_CODE INTEGER,'
      '1101971209=  ERR_MSG VARCHAR(1024))'
      '1101971210=AS'
      '1101971211=BEGIN'
      '1101971212=    SELECT'
      '1101971213=        t.NAME,'
      '1101971214=        t.PRICE,'
      '1101971215=        T.price,'
      '1101971216=        t.VOLUME_PRICE,'
      '1101971217=        t.PACK_AMOUNT,'
      '1101971218=        T.VES_GRAMM,'
      '1101971219=        T.VES_GRAMM_PRICE'
      
        '1101971220=        ,COALESCE(P.AMOUNT, 0) - COALESCE(P.AMOUNT_RE' +
        'SERVE, 0) AMOUNT'
      '1101971221=        ,COALESCE(PP.SKIDKA_PROC, 0)'
      '1101971222=        ,COALESCE(PP.SKIDKA_SUM, 0)'
      '1101971223=    FROM G_PRODUCT T'
      
        '1101971224=         LEFT OUTER JOIN (SELECT G_PRODUCT, AMOUNT, A' +
        'MOUNT_RESERVE FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_)' +
        '  P ON T.G_PRODUCT = P.G_PRODUCT'
      
        '1101971225=         LEFT OUTER JOIN (SELECT G_PRODUCT, D.SKIDKA_' +
        'PROC, D.SKIDKA_SUM'
      
        '1101971226=                                        FROM G_DISCOU' +
        'NT D'
      
        '1101971227=                                        WHERE ((D.DAT' +
        'E_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '1101971228=                                                AND D' +
        '.DATE_END >= CURRENT_TIMESTAMP'
      
        '1101971229=                                                AND D' +
        '.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      '1101971230=                                              )'
      '1101971231=                                              OR'
      
        '1101971232=                                              (D.DATE' +
        '_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '1101971233=                                        AND COALESCE(' +
        'D.G_TOCHKA, :G_TOCHKA_) = :G_TOCHKA_'
      
        '1101971234=                                     ) PP ON T.G_PROD' +
        'UCT = PP.G_PRODUCT'
      '1101971235=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101971236=    INTO'
      '1101971237=        :NAME_,'
      '1101971238=        :PRICE_,'
      '1101971239=        :ROZN_PRICE_,'
      '1101971240=        :VOLUME_PRICE_,'
      '1101971241=        :PACK_AMOUNT_,'
      '1101971242=        :VES_GRAMM_,'
      '1101971243=        :VES_GRAMM_PRICE_,'
      '1101971244=        :AMOUNT_,'
      '1101971245=        :SKIDKA_PROC_,'
      '1101971246=        :SKIDKA_SUMM_;'
      '1101971247=end'
      '1101971248=;'
      '1101971249='
      '1101971250=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '1101971251=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101971252=  ARTICUL_ VARCHAR(30),'
      '1101971253=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101971254=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101971255=  NAME_ VARCHAR(500),'
      '1101971256=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101971257=  PRICE_ NUMERIC(15,2),'
      '1101971258=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101971259=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101971260=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101971261=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101971262=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101971263=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101971264=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101971265=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101971266=  IS_CATEGORY_ INTEGER,'
      '1101971267=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101971268=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101971269=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101971270=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101971271=  IS_MARKED_ INTEGER,'
      '1101971272=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1101971273=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '1101971274=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1101971275=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE,'
      
        '1101971276=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101971277=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1101971278=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101971279=RETURNS ('
      '1101971280=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101971281=  ERR_CODE INTEGER,'
      '1101971282=  ERR_MSG VARCHAR(1024))'
      '1101971283=AS'
      
        '1101971284=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PROD' +
        'UCT'#39';'
      
        '1101971285=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101971286=begin'
      
        '1101971287=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101971288=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1101971289=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101971290=                      FROM G_PRODUCT G'
      
        '1101971291=                     WHERE UPPER(G.ARTICUL) = UPPER(T' +
        'RIM(:ARTICUL_))'
      '1101971292=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '1101971293=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101971294=          ERR_CODE = -20500;'
      
        '1101971295=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1101971296=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101971297=          EXIT;'
      '1101971298=        END'
      '1101971299=    end'
      '1101971300='
      
        '1101971301=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1101971302=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      
        '1101971303=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) the' +
        'n begin'
      '1101971304=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101971305=                     FROM G_PRODUCT G'
      
        '1101971306=                    WHERE UPPER(G.NOMENCLATUR_NUM) = ' +
        'UPPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '1101971307=                      AND TRIM(G.NOMENCLATUR_NUM) <> ' +
        #39#39
      
        '1101971308=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101971309=          ERR_CODE = -20500;'
      
        '1101971310=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1101971311=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101971312=          EXIT;'
      '1101971313=        END'
      '1101971314=    end*/'
      '1101971315='
      '1101971316=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101971317=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101971318=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '1101971319=                      FROM G_PRODUCT G'
      
        '1101971320=                     WHERE UPPER(G.BARCODE) = UPPER(T' +
        'RIM(:BARCODE_))'
      '1101971321=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '1101971322=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101971323=          ERR_CODE = -20500;'
      
        '1101971324=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101971325=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101971326=          EXIT;'
      '1101971327=        END'
      '1101971328='
      '1101971329=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101971330=                     FROM G_PRODUCT G, LT_BARCODE L'
      '1101971331=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101971332=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '1101971333=                      AND TRIM(L.BARCODE) <> '#39#39
      
        '1101971334=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101971335=          ERR_CODE = -20500;'
      
        '1101971336=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101971337=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101971338=          EXIT;'
      '1101971339=        END'
      '1101971340=    end'
      '1101971341='
      
        '1101971342=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_P' +
        'RICE,'
      
        '1101971343=                           IS_CATEGORY, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_CO' +
        'MM, KOD_TNVD,'
      
        '1101971344=                           FAST_TOVAR, DO_NOT_CHARGE_' +
        'BONUS, IS_MARKED, BRAND, IS_WEIGHT, VES_GRAMM, VES_GRAMM_PRICE)'
      
        '1101971345=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PR' +
        'ICE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1101971346=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CRO' +
        'SSCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNV' +
        'D_,'
      
        '1101971347=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_' +
        'MARKED_, :BRAND_, :IS_WEIGHT_, :VES_GRAMM_, :VES_GRAMM_PRICE_)'
      '1101971348=    RETURNING G_PRODUCT'
      '1101971349=    INTO :G_PRODUCT_;'
      '1101971350='
      '1101971351=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1101971352=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1101971353=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101971354=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1101971355='
      '1101971356=        INSERT INTO LT_BARCODE'
      
        '1101971357=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101971358='
      
        '1101971359=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089 +
        #1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '1101971360=        INSERT into G_PRODUCT_IMAGE'
      
        '1101971361=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TY' +
        'PE from G_PRODUCT_IMAGE_TMP;'
      '1101971362='
      
        '1101971363=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074 +
        #1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '1101971364=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076 +
        #1091#1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '1101971365=        IF (is_kit_ > 0) THEN begin'
      '1101971366=            INSERT INTO G_PRODUCT_KIT'
      
        '1101971367=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP;'
      '1101971368='
      '1101971369=            if (is_kit_ = 1) then begin'
      
        '1101971370=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101971371=                  FROM G_PRODUCT_KIT K,'
      '1101971372=                       LT_SKLAD_PRODUCT L'
      '1101971373=                 WHERE K.g_product = :G_PRODUCT_'
      '1101971374=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101971375=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101971376=                 GROUP BY K.G_PRODUCT'
      '1101971377=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101971378='
      '1101971379=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101971380=                   SET L.AMOUNT = COALESCE(:G_PRODUCT' +
        '_SOSTAV_AMOUNT_, 0)'
      '1101971381=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101971382=            end'
      '1101971383=        END'
      '1101971384=    END'
      '1101971385='
      '1101971386=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101971387=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '1101971388='
      '1101971389=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1101971390=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101971391=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101971392=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PR' +
        'ODUCT_, 1);'
      '1101971393=end'
      '1101971394=;'
      '1101971395='
      '1101971396=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1101971397=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101971398=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101971399=  ARTICUL_ VARCHAR(30),'
      '1101971400=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101971401=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101971402=  NAME_ VARCHAR(500),'
      '1101971403=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101971404=  PRICE_ NUMERIC(15,2),'
      '1101971405=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101971406=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101971407=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101971408=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101971409=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101971410=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101971411=  IS_CATEGORY_ INTEGER,'
      '1101971412=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101971413=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101971414=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101971415=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101971416=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101971417=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101971418=  IS_MARKED_ INTEGER,'
      '1101971419=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1101971420=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '1101971421=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1101971422=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE,'
      
        '1101971423=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101971424=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1101971425=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101971426=RETURNS ('
      '1101971427=  ERR_CODE INTEGER,'
      '1101971428=  ERR_MSG VARCHAR(1024))'
      '1101971429=AS'
      
        '1101971430=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      
        '1101971431=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101971432=begin'
      
        '1101971433=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101971434=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '1101971435=                  FROM G_PRODUCT G'
      
        '1101971436=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(' +
        ':ARTICUL_))'
      '1101971437=                   AND TRIM(G.ARTICUL) <> '#39#39
      '1101971438=                   AND TRIM(:ARTICUL_) <> '#39#39
      '1101971439=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101971440=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101971441=      ERR_CODE = -20500;'
      
        '1101971442=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '1101971443=      EXIT;'
      '1101971444=    END'
      '1101971445='
      
        '1101971446=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1101971447=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1101971448=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101971449=                  FROM G_PRODUCT G'
      
        '1101971450=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPP' +
        'ER(TRIM(:NOMENCLATUR_NUM_))'
      '1101971451=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1101971452=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1101971453=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101971454=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101971455=      ERR_CODE = -20500;'
      
        '1101971456=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101971457=      EXIT;'
      '1101971458=    END'
      '1101971459=    */'
      '1101971460='
      '1101971461=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101971462=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101971463=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101971464=                  FROM G_PRODUCT G'
      
        '1101971465=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(' +
        ':BARCODE_))'
      '1101971466=                   AND TRIM(G.BARCODE) <> '#39#39
      '1101971467=                   AND TRIM(:BARCODE_) <> '#39#39
      '1101971468=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101971469=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101971470=          ERR_CODE = -20500;'
      
        '1101971471=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101971472=          EXIT;'
      '1101971473=        END'
      '1101971474='
      '1101971475=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101971476=                    FROM G_PRODUCT G, LT_BARCODE L'
      '1101971477=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101971478=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '1101971479=                     AND TRIM(L.BARCODE) <> '#39#39
      '1101971480=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101971481=          ERR_CODE = -20500;'
      
        '1101971482=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101971483=          EXIT;'
      '1101971484=        END'
      '1101971485=    END'
      '1101971486='
      '1101971487=    update G_PRODUCT'
      '1101971488=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1101971489=        ARTICUL = :ARTICUL_,'
      '1101971490=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1101971491=        BARCODE = :BARCODE_,'
      '1101971492=        NAME = :NAME_,'
      '1101971493=        G_UNIT = :G_UNIT_,'
      '1101971494=        PRICE = :PRICE_,'
      '1101971495=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101971496=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1101971497=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1101971498=        NOTE         = :NOTE_,'
      '1101971499=        CROSSCODE    = :CROSSCODE_,'
      '1101971500=        IS_KIT       = :IS_KIT_,'
      '1101971501=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1101971502=        PLACE        = :PLACE_,'
      '1101971503=        SALES_COMM   = :SALES_COMM_,'
      '1101971504=        KOD_TNVD     = :KOD_TNVD_,'
      '1101971505=        FAST_TOVAR   = :FAST_TOVAR_,'
      '1101971506=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '1101971507=        IS_MARKED    = :IS_MARKED_,'
      '1101971508=        BRAND        = :BRAND_,'
      '1101971509=        IS_WEIGHT    = :IS_WEIGHT_,'
      '1101971510=        VES_GRAMM    = :VES_GRAMM_,'
      '1101971511=        VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '1101971512=    where (G_PRODUCT = :G_PRODUCT_);'
      '1101971513='
      '1101971514=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1101971515=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1101971516='
      '1101971517=        INSERT INTO LT_BARCODE'
      
        '1101971518=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101971519='
      '1101971520=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1101971521=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1101971522=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1101971523='
      
        '1101971524=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1101971525=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101971526='
      '1101971527=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1101971528=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1101971529=            /*INSERT INTO G_PRODUCT_KIT'
      
        '1101971530=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1101971531=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1101971532=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1101971533=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1101971534='
      
        '1101971535=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1101971536=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101971537='
      '1101971538=            UPDATE G_PRODUCT_KIT G'
      
        '1101971539=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1101971540=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1101971541=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1101971542=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1101971543='
      
        '1101971544=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' ' +
        #1074#1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '1101971545=            */'
      
        '1101971546=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PRO' +
        'DUCT = :G_PRODUCT_;'
      '1101971547=            INSERT INTO G_PRODUCT_KIT'
      
        '1101971548=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '1101971549=            FROM G_PRODUCT_KIT_TMP T;'
      '1101971550='
      
        '1101971551=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1101971552=            if (is_kit_ = 1) then begin'
      
        '1101971553=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101971554=                  FROM G_PRODUCT_KIT K,'
      '1101971555=                       LT_SKLAD_PRODUCT L'
      '1101971556=                 WHERE K.g_product = :G_PRODUCT_'
      '1101971557=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101971558=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101971559=                 GROUP BY K.G_PRODUCT'
      '1101971560=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101971561='
      '1101971562=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101971563=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1101971564=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101971565=            end'
      '1101971566=        END'
      '1101971567=    END'
      '1101971568='
      '1101971569=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101971570=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1101971571='
      
        '1101971572=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1101971573=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101971574=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101971575=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 2'
      '1101971576=          FROM RDB$DATABASE'
      
        '1101971577=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP' +
        ' AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_L' +
        'OADING = 0);'
      '1101971578=end'
      '1101971579=;'
      '1101971580='
      '1101971581=ALTER PROCEDURE GET_SKLAD_TMP('
      '1101971582=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '1101971583=RETURNS ('
      '1101971584=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101971585=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101971586=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101971587=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101971588=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      
        '1101971589=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ','
      '1101971590=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1101971591=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101971592=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1101971593=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      '1101971594=  ERR_CODE INTEGER,'
      '1101971595=  ERR_MSG VARCHAR(1024))'
      '1101971596=AS'
      '1101971597=begin'
      '1101971598=  SELECT'
      '1101971599=    T.G_PRODUCT,'
      '1101971600=    T.AMOUNT,'
      '1101971601=    T.PRICE,'
      '1101971602=    T.SUMM,'
      '1101971603=    T.PRICE_CURRENCY,'
      '1101971604=    T.SUMM_CURRENCY,'
      '1101971605=    T.NDS,'
      '1101971606=    T.NDS_SUMM,'
      '1101971607=    P.NAME,'
      '1101971608=    P.VES_GRAMM'
      
        '1101971609=  FROM SKLAD_TMP T LEFT OUTER JOIN G_PRODUCT P ON T.G' +
        '_PRODUCT = P.G_PRODUCT'
      '1101971610=  WHERE T.SKLAD = :SKLAD_'
      '1101971611=  INTO'
      '1101971612=    :G_PRODUCT_,'
      '1101971613=    :AMOUNT_,'
      '1101971614=    :PRICE_,'
      '1101971615=    :SUMM_,'
      '1101971616=    :PRICE_CURRENCY_,'
      '1101971617=    :SUMM_CURRENCY_,'
      '1101971618=    :NDS_,'
      '1101971619=    :NDS_SUMM_,'
      '1101971620=    :G_PROD_NAME_,'
      '1101971621=    :VES_GRAMM_;'
      '1101971622=end'
      '1101971623=;'
      '1101971624='
      '1101971625=ALTER PROCEDURE GET_ZAKAZ_DETAILS_TMP('
      
        '1101971626=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS)'
      '1101971627=RETURNS ('
      
        '1101971628=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT,'
      '1101971629=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101971630=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101971631=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1101971632=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC,'
      
        '1101971633=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE,'
      
        '1101971634=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_SUMM,'
      '1101971635=  NDS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      
        '1101971636=  NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM' +
        ','
      '1101971637=  TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101971638=  ROZN_PRICE_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '1101971639=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101971640=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101971641=  OSTATOK_ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101971642=  CNT_Z_ INTEGER,'
      '1101971643=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1101971644=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE,'
      '1101971645=  ERR_CODE INTEGER,'
      '1101971646=  ERR_MSG VARCHAR(1024))'
      '1101971647=AS'
      '1101971648=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      '1101971649=BEGIN'
      '1101971650=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '1101971651=  /*CNT_Z_ = 0;'
      '1101971652=  SELECT COUNT(*)'
      '1101971653=    FROM (SELECT *'
      '1101971654=           FROM ZAKAZ Z ROWS 1 TO 100)'
      '1101971655=    INTO :CNT_Z_;*/'
      '1101971656='
      '1101971657=  SELECT'
      '1101971658=    t.G_PRODUCT,'
      '1101971659=    t.AMOUNT,'
      '1101971660=    t.PRICE,'
      '1101971661=    t.SUMM,'
      '1101971662=    t.DISCOUNT_PERC,'
      '1101971663=    T.DISCOUNT_TENGE,'
      '1101971664=    T.DISCOUNT_SUMM,'
      '1101971665=    T.NDS,'
      '1101971666=    T.NDS_SUMM,'
      '1101971667=    G.NAME,'
      '1101971668=    G.price,'
      '1101971669=    G.VOLUME_PRICE,'
      '1101971670=    G.PACK_AMOUNT,'
      '1101971671=    LT.AMOUNT,'
      '1101971672=    G.VES_GRAMM,'
      '1101971673=    T.VES_GRAMM_PRICE'
      '1101971674=  FROM ZAKAZ_DETAILS_TMP t,'
      
        '1101971675=       G_PRODUCT G LEFT OUTER JOIN LT_SKLAD_PRODUCT L' +
        'T ON G.G_PRODUCT = LT.G_PRODUCT AND LT.G_TOCHKA = (SELECT ID FRO' +
        'M CUR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101971676=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1101971677=    AND T.G_PRODUCT = G.G_PRODUCT'
      '1101971678=  INTO'
      '1101971679=    :G_PRODUCT_,'
      '1101971680=    :AMOUNT_,'
      '1101971681=    :PRICE_,'
      '1101971682=    :SUMM_,'
      '1101971683=    :DISCOUNT_PERC_,'
      '1101971684=    :DISCOUNT_TENGE_,'
      '1101971685=    :DISCOUNT_SUMM_,'
      '1101971686=    :NDS_,'
      '1101971687=    :NDS_SUMM_,'
      '1101971688=    :TOVAR_NAME_,'
      '1101971689=    :ROZN_PRICE_,'
      '1101971690=    :VOLUME_PRICE_,'
      '1101971691=    :PACK_AMOUNT_,'
      '1101971692=    :OSTATOK_,'
      '1101971693=    :VES_GRAMM_,'
      '1101971694=    :VES_GRAMM_PRICE_;'
      '1101971695=end'
      '1101971696=;'
      '1101971697='
      '1101971698=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '1101971699=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101971700=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1101971701=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT ' +
        '= 0,'
      
        '1101971702=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0)'
      '1101971703=RETURNS ('
      '1101971704=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101971705=  ERR_CODE INTEGER,'
      '1101971706=  ERR_MSG VARCHAR(1024))'
      '1101971707=AS'
      '1101971708=/*'
      '1101971709='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '1101971710=*/'
      
        '1101971711=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_T' +
        'MP'#39';'
      '1101971712=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101971713=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '1101971714=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      '1101971715=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '1101971716=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT' +
        '.PRICE;'
      
        '1101971717=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODU' +
        'CT.VOLUME_PRICE;'
      '1101971718=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '1101971719=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '1101971720=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101971721=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      
        '1101971722=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101971723=DECLARE VARIABLE IS_MARKED_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_MARKED;'
      
        '1101971724=DECLARE VARIABLE IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_WEIGHT;'
      
        '1101971725=DECLARE VARIABLE VES_GRAMM_PRICE_ TYPE OF COLUMN G_PR' +
        'ODUCT.VES_GRAMM_PRICE;'
      '1101971726=BEGIN'
      '1101971727='
      '1101971728=  PNT_ = '#39'01'#39';'
      
        '1101971729=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCO' +
        'DE_, NULL, NULL, NULL, NULL)'
      
        '1101971730=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGO' +
        'RY_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :IS_MARKE' +
        'D_, :IS_WEIGHT_, :VES_GRAMM_PRICE_, :ERR_CODE, :ERR_MSG;'
      '1101971731='
      '1101971732=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101971733=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101971734=    EXIT;'
      '1101971735=  END'
      '1101971736='
      '1101971737=  PNT_ = '#39'02'#39';'
      '1101971738=  IF (IS_VOZVRAT_ = 0) THEN BEGIN'
      
        '1101971739=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, :G_TOCHKA_, 0)'
      '1101971740=          RETURNING_VALUES :PRICE_;'
      '1101971741='
      '1101971742=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101971743=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101971744=        EXIT;'
      '1101971745=      END'
      '1101971746=  END ELSE'
      '1101971747=    PRICE_ = SALE_PRICE_;'
      '1101971748='
      '1101971749=  AMOUNT_ = 1;'
      '1101971750='
      '1101971751=  SELECT T.SKLAD'
      '1101971752=    FROM SKLAD_TMP T'
      '1101971753=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101971754=     AND T.PRICE = :PRICE_'
      '1101971755=    INTO :SKLAD_;'
      '1101971756='
      '1101971757=  IF (SKLAD_ IS NOT NULL) THEN'
      '1101971758=    UPDATE SKLAD_TMP T'
      '1101971759=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1101971760=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1101971761=     WHERE T.SKLAD = :SKLAD_;'
      '1101971762='
      '1101971763=  ELSE'
      
        '1101971764=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PR' +
        'ICE_OPT, CHANGE_SALE_PRICE)'
      
        '1101971765=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_,'
      
        '1101971766=             DECODE(:PRICE_, 0, 0, ROUND((:SALE_PRICE' +
        '_/:PRICE_ - 1)*100, 2)),'
      '1101971767=             :SALE_PRICE_,'
      
        '1101971768=             DECODE(:PRICE_, 0, 0, ROUND((:VOLUME_PRI' +
        'CE_/:PRICE_ - 1)*100, 2)),'
      '1101971769=             :VOLUME_PRICE_,'
      '1101971770=             :CHANGE_SALE_PRICE_)'
      '1101971771=      RETURNING SKLAD'
      '1101971772=      INTO :SKLAD_;'
      '1101971773=end'
      '1101971774=;'
      '1101971775='
      '1101971776=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '1101971777=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT,'
      '1101971778=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101971779=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101971780=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1101971781=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1101971782=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1101971783=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1101971784=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101971785=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101971786=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ','
      '1101971787=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1101971788=  IS_SPISANIE_ INTEGER,'
      '1101971789=  NEW_LINE_SALE_ INTEGER = 0,'
      '1101971790=  MODE_ INTEGER = 0,'
      '1101971791=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '1101971792=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '1101971793=  MARK_CODE_ VARCHAR(100) = '#39#39','
      
        '1101971794=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE = 0)'
      '1101971795=RETURNS ('
      
        '1101971796=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1101971797=  ERR_CODE INTEGER,'
      '1101971798=  ERR_MSG VARCHAR(1024))'
      '1101971799=AS'
      '1101971800=/*'
      
        '1101971801=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063 +
        #1048#1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '1101971802=*/'
      
        '1101971803=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39';'
      '1101971804=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '1101971805=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0;'
      
        '1101971806=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0;'
      
        '1101971807=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1101971808=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1101971809=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '1101971810=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      
        '1101971811=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.PRICE;'
      
        '1101971812=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.COST_PRICE;'
      
        '1101971813=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '1101971814=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101971815=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040 +
        #1041#1051#1048#1062#1045' */'
      
        '1101971816=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058 +
        ' '#1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '1101971817=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101971818=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '1101971819=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '1101971820=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUM' +
        'N G_PRODUCT.G_PRODUCT;'
      '1101971821=BEGIN'
      '1101971822=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '1101971823='
      
        '1101971824=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071 +
        #1070#1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '1101971825=  SELECT T.ZAKAZ, T.Z_TYPE'
      '1101971826=    FROM ZAKAZ_DETAILS_TMP T'
      '1101971827=   WHERE T.ZAKAZ IS NOT NULL'
      
        '1101971828=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' ' +
        #1089#1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082 +
        #1072' MULTIPLE ROWS IN SINGLETON SELECT'
      '1101971829=    INTO :ZAKAZ_, :Z_TYPE_;'
      '1101971830='
      
        '1101971831=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045 +
        #1051#1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101971832=           ,G.IS_KIT'
      '1101971833=           ,K.AMOUNT * :AMOUNT_'
      '1101971834=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '1101971835=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PR' +
        'ICE)'
      '1101971836=           ,(CASE'
      
        '1101971837=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANI' +
        'E_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT *' +
        ' FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '1101971838=             ELSE K.PRICE'
      '1101971839=           END) COST_PRICE'
      
        '1101971840=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_' +
        'LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '1101971841=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE' +
        ' G_PRODUCT = :G_PRODUCT_) CNT'
      
        '1101971842=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT ' +
        'K ON G.G_PRODUCT = K.G_PRODUCT'
      '1101971843=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101971844=       AND G.IS_KIT = 1'
      '1101971845=    UNION'
      
        '1101971846=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056 +
        #1054#1044#1040#1046
      '1101971847=           ,G.IS_KIT'
      '1101971848=           ,:AMOUNT_'
      '1101971849=           ,:PRICE_'
      '1101971850=           ,0'
      '1101971851=           ,:COST_PRICE_'
      '1101971852=           ,0'
      '1101971853=      FROM G_PRODUCT G'
      '1101971854=     WHERE G_PRODUCT = :G_PRODUCT_'
      '1101971855=       AND G.IS_KIT <> 1'
      '1101971856=      INTO :G_PRODUCT_'
      '1101971857=           ,:IS_KIT_'
      '1101971858=           ,:AMOUNT_'
      '1101971859=           ,:PRICE__'
      '1101971860=           ,:SOSTAV_PRICE_'
      '1101971861=           ,:COST_PRICE__'
      '1101971862=           ,:SOSTAV_COUNT_'
      '1101971863=  DO BEGIN'
      '1101971864=      ZAKAZ_DTLS_TMP_ = NULL;'
      '1101971865='
      
        '1101971866=      --=============================================' +
        '=============='
      '1101971867=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101971868=      SELECT AMOUNT - AMOUNT_RESERVE'
      '1101971869=        FROM LT_SKLAD_PRODUCT L'
      '1101971870=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '1101971871=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101971872=       INTO :AMOUNT_CUR_;'
      '1101971873='
      
        '1101971874=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1101971875=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1101971876=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1101971877=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1101971878=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101971879=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '1101971880=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1101971881=          SELECT SUM(AMOUNT)'
      '1101971882=            FROM ZAKAZ_DETAILS T'
      '1101971883=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101971884=             AND T.ZAKAZ = :ZAKAZ_'
      '1101971885=            INTO :AMOUNT_OLD_;'
      '1101971886=        ELSE'
      '1101971887=          SELECT SUM(AMOUNT)'
      '1101971888=            FROM SKLAD T'
      '1101971889=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101971890=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1101971891=            INTO :AMOUNT_OLD_;'
      '1101971892=      END'
      '1101971893='
      '1101971894=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1101971895=      SELECT SUM(AMOUNT)'
      '1101971896=        FROM ZAKAZ_DETAILS_TMP T'
      '1101971897=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101971898=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1101971899='
      
        '1101971900=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_,' +
        ' 0) + :AMOUNT_;'
      '1101971901=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '1101971902='
      
        '1101971903=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042 +
        ' '#1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1101971904='
      
        '1101971905=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1101971906=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047 +
        #1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1101971907=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) ' +
        'THEN BEGIN'
      '1101971908=            PNT_ = '#39'01'#39';'
      
        '1101971909=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID F' +
        'ROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101971910=                                         CURRENT_DATE' +
        ','
      '1101971911=                                         :G_PRODUCT_,'
      
        '1101971912=                                         ABS(AMOUNT_C' +
        'UR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOU' +
        'NT_,'
      
        '1101971913=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074 +
        #1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1101971914=                                         )'
      
        '1101971915=                RETURNING_VALUES :SKLAD_, :COST_PRICE' +
        '__, :ERR_CODE, :ERR_MSG;'
      '1101971916=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101971917=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101971918=              EXIT;'
      '1101971919=            END'
      '1101971920=        END'
      
        '1101971921=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_P' +
        'RODUCT_ <> -2) THEN BEGIN'
      '1101971922=            SELECT NAME'
      '1101971923=            FROM G_PRODUCT'
      '1101971924=            WHERE G_PRODUCT = :G_PRODUCT_'
      '1101971925=            INTO :PRODUCT_NAME_;'
      '1101971926='
      '1101971927=            ERR_CODE = -20500;'
      
        '1101971928=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_' +
        'NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1101971929=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1101971930=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1101971931=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1101971932=            EXIT;'
      '1101971933=        END'
      '1101971934=      END'
      '1101971935=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101971936=      --=============================================' +
        '=============='
      '1101971937='
      
        '1101971938=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077 +
        #1090#1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087 +
        #1083#1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '1101971939=      IF (IS_KIT_ = 1) THEN BEGIN'
      '1101971940='
      '1101971941=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '1101971942=        --    PRICE__ = SOSTAV_PRICE_;'
      '1101971943=        --END ELSE BEGIN'
      '1101971944=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '1101971945=              PRICE__ = COST_PRICE__;'
      '1101971946='
      
        '1101971947=            END ELSE IF (Discount_perc_ <> 0) THEN BE' +
        'GIN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '1101971948=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PE' +
        'RC_/100;'
      '1101971949='
      '1101971950='
      
        '1101971951=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THE' +
        'N BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '1101971952=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / S' +
        'OSTAV_PRICE_;'
      
        '1101971953=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE' +
        '_;'
      '1101971954=            END'
      '1101971955='
      
        '1101971956=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUN' +
        'T_;'
      
        '1101971957=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMO' +
        'UNT_;'
      '1101971958=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '1101971959=        --END'
      '1101971960=      END'
      '1101971961='
      
        '1101971962=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' ' +
        #1045#1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '1101971963=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041 +
        #1048#1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '1101971964=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_COD' +
        'E_) = 0) THEN'
      '1101971965=          SELECT ZD.zakaz_details'
      '1101971966=            FROM zakaz_details_tmp ZD'
      '1101971967=           WHERE ZD.G_PRODUCT = :g_product_'
      '1101971968=             AND ZD.PRICE = :PRICE__'
      '1101971969=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '1101971970=            INTO :ZAKAZ_DTLS_TMP_;'
      '1101971971='
      '1101971972='
      '1101971973=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN BEGIN'
      '1101971974=        UPDATE ZAKAZ_DETAILS_TMP P'
      '1101971975=           SET P.amount = P.amount + :amount_'
      
        '1101971976=               ,P.summ = (P.price - P.discount_TENGE)' +
        ' * (P.amount + :AMOUNT_)'
      
        '1101971977=               ,P.discount_summ = P.discount_TENGE * ' +
        '(P.amount + :AMOUNT_)'
      '1101971978=               ,P.NDS = :NDS_'
      '1101971979=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '1101971980=               ,P.VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '1101971981=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '1101971982=        ZAKAZ_DETAILS_ = :ZAKAZ_DTLS_TMP_;'
      '1101971983='
      '1101971984=      END ELSE BEGIN'
      
        '1101971985=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN' +
        ' BEGIN'
      
        '1101971986=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_' +
        ';'
      '1101971987=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '1101971988=          END'
      '1101971989='
      '1101971990=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '1101971991=          ('
      '1101971992=           ZAKAZ_DETAILS,'
      '1101971993=           ZAKAZ,'
      '1101971994=           G_PRODUCT,'
      '1101971995=           AMOUNT,'
      '1101971996=           PRICE,'
      '1101971997=           SUMM,'
      '1101971998=           DISCOUNT_PERC,'
      '1101971999=           DISCOUNT_TENGE,'
      '1101972000=           DISCOUNT_SUMM,'
      '1101972001=           NDS,'
      '1101972002=           NDS_SUMM,'
      '1101972003=           COST_PRICE,'
      '1101972004=           MARK_CODE,'
      '1101972005=           ORIGINAL_KIT_ID,'
      '1101972006=           ORIGINAL_KIT_PRICE,'
      '1101972007=           VES_GRAMM_PRICE'
      '1101972008=          ) VALUES ('
      '1101972009=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101972010=           :ZAKAZ_,'
      '1101972011=           :G_PRODUCT_,'
      '1101972012=           :AMOUNT_,'
      '1101972013=           :PRICE__,'
      '1101972014=           :SUMM_,'
      '1101972015=           :DISCOUNT_PERC_,'
      '1101972016=           :DISCOUNT_TENGE_,'
      '1101972017=           :DISCOUNT_SUMM_,'
      '1101972018=           :NDS_,'
      '1101972019=           :NDS_SUMM_,'
      '1101972020=           :COST_PRICE__,'
      '1101972021=           :MARK_CODE_,'
      '1101972022=           :ORIGINAL_KIT_ID_,'
      '1101972023=           :ORIGINAL_KIT_PRICE_,'
      '1101972024=           :VES_GRAMM_PRICE_'
      '1101972025=          )'
      '1101972026=          RETURNING'
      '1101972027=            ZAKAZ_DETAILS'
      '1101972028=          INTO'
      '1101972029=            :ZAKAZ_DETAILS_;'
      '1101972030=      END'
      '1101972031=  END'
      '1101972032=end'
      '1101972033=;'
      '1101972034='
      '1101972035=ALTER PROCEDURE R_FILL_REVISION('
      '1101972036=  G_PRODUCT_PAR_ BLOB SUB_TYPE 1,'
      '1101972037=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101972038=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101972039=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101972040=  TYPE_ INTEGER = 0)'
      '1101972041=RETURNS ('
      '1101972042=  ERR_CODE INTEGER,'
      '1101972043=  ERR_MSG VARCHAR(1024))'
      '1101972044=AS'
      
        '1101972045=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT;'
      
        '1101972046=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.G_PRODUCT;'
      '1101972047=DECLARE VARIABLE I INTEGER = 1;'
      '1101972048=BEGIN'
      '1101972049='
      '1101972050=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101972051=    SELECT ID'
      '1101972052=      FROM CUR_PARAMS'
      '1101972053=     WHERE CUR_PARAMS = 2'
      '1101972054=      INTO :G_TOCHKA_;'
      '1101972055='
      '1101972056=  IF (TYPE_ = 0) THEN BEGIN'
      
        '1101972057=          DELETE FROM REVISION R WHERE R.G_TOCHKA = :' +
        'G_TOCHKA_;'
      '1101972058='
      '1101972059=          -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1041#1044
      '1101972060=          IF (COALESCE(SKLAD_, 0) = 0) THEN BEGIN'
      '1101972061=              FOR SELECT G.G_PRODUCT,'
      '1101972062=                         COALESCE(LT.AMOUNT, 0)'
      
        '1101972063=                    FROM G_PRODUCT G LEFT OUTER JOIN ' +
        '(SELECT G_PRODUCT, AMOUNT'
      
        '1101972064=                                                     ' +
        '   FROM LT_SKLAD_PRODUCT'
      
        '1101972065=                                                     ' +
        '  WHERE G_TOCHKA = :G_TOCHKA_) LT ON G.g_product = LT.g_product'
      '1101972066=                   WHERE G.IS_ACTIVE = 1'
      '1101972067=                     AND G.IS_KIT <> 1'
      
        '1101972068=                     AND ((:G_PRODUCT_PAR_ CONTAINING' +
        ' '#39'~'#39'||G.G_PRODUCT_PAR||'#39'~'#39' AND :G_PRODUCT_PAR_ IS NOT NULL)'
      '1101972069=                          OR'
      '1101972070=                          (:G_PRODUCT_PAR_ IS NULL)'
      '1101972071=                         )'
      
        '1101972072=                     AND ((:G_PRODUCT_ CONTAINING '#39'~'#39 +
        '||G.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101972073=                          OR'
      '1101972074=                          (:G_PRODUCT_ IS NULL)'
      '1101972075=                         )'
      '1101972076=                     AND G.IS_CATEGORY = 0'
      '1101972077=                  /*UNION ALL'
      '1101972078=                  SELECT G.G_PRODUCT,'
      '1101972079=                         COALESCE(LT.AMOUNT, 0)'
      '1101972080=                    FROM G_PRODUCT G,'
      '1101972081=                         LT_SKLAD_PRODUCT LT'
      '1101972082=                   WHERE G.G_PRODUCT = LT.G_PRODUCT'
      
        '1101972083=                     AND G.G_PRODUCT_PAR IN (SELECT G' +
        'G.G_PRODUCT'
      
        '1101972084=                                              FROM G_' +
        'PRODUCT GG'
      
        '1101972085=                                             WHERE :G' +
        '_PRODUCT_PAR_ CONTAINING '#39'~'#39'||GG.G_PRODUCT_PAR||'#39'~'#39
      
        '1101972086=                                               AND GG' +
        '.IS_CATEGORY = 1'
      
        '1101972087=                                               and gg' +
        '.G_PRODUCT_PAR is not null)'
      '1101972088=                     AND G.IS_CATEGORY = 0'
      
        '1101972089=                     AND CHAR_LENGTH(:G_PRODUCT_PAR_)' +
        ' > 0'
      '1101972090=                     AND LT.G_TOCHKA = :G_TOCHKA_'
      '1101972091=                  UNION ALL'
      '1101972092=                  SELECT G.G_PRODUCT,'
      '1101972093=                         COALESCE(LT.AMOUNT, 0)'
      '1101972094=                    FROM G_PRODUCT G,'
      '1101972095=                         LT_SKLAD_PRODUCT LT'
      '1101972096=                   WHERE G.G_PRODUCT = LT.G_PRODUCT'
      '1101972097=                     AND G.IS_CATEGORY = 0'
      
        '1101972098=                     AND CHAR_LENGTH(:G_PRODUCT_PAR_)' +
        ' = 0'
      '1101972099=                     AND LT.G_TOCHKA = :G_TOCHKA_'
      
        '1101972100=                  /*UNION ALL              '#1061#1059#1049' '#1047#1053#1040#1045#1058' ' +
        #1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1053#1059#1046#1053#1054'  11.02.2016'
      '1101972101=                  SELECT G.G_PRODUCT,'
      '1101972102=                         COALESCE(LT.AMOUNT, 0)'
      
        '1101972103=                    FROM G_PRODUCT G LEFT OUTER JOIN ' +
        'LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT'
      
        '1101972104=                   WHERE G.G_PRODUCT_PAR IN (SELECT G' +
        'G.G_PRODUCT'
      
        '1101972105=                                              FROM G_' +
        'PRODUCT GG'
      
        '1101972106=                                             WHERE GG' +
        '.IS_CATEGORY = 1'
      
        '1101972107=                                               and gg' +
        '.G_PRODUCT_PAR is not null)'
      '1101972108=                     AND G.IS_CATEGORY = 0'
      
        '1101972109=                     AND CHAR_LENGTH(:G_PRODUCT_PAR_)' +
        ' = 0 */'
      '1101972110=                  ORDER BY 1'
      '1101972111=                  INTO :G_PRODUCT__,'
      '1101972112=                       :AMOUNT_BD_'
      '1101972113=              DO BEGIN'
      '1101972114='
      
        '1101972115=                INSERT INTO REVISION (REVISION, SKLAD' +
        ', G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1101972116=                VALUES (GEN_ID(GEN_REVISION, 1), NULL' +
        ', :G_PRODUCT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      '1101972117='
      '1101972118=                I = I + 1;'
      '1101972119=              END'
      '1101972120='
      '1101972121=          -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101972122=          END ELSE BEGIN'
      '1101972123=              FOR SELECT SS.G_PRODUCT,'
      '1101972124=                         SS.AMOUNT'
      '1101972125=                    FROM SKLAD_PARENT S, SKLAD SS'
      '1101972126=                   WHERE S.SKLAD = :SKLAD_'
      '1101972127=                     AND S.SKLAD = SS.SKLAD_PARENT'
      
        '1101972128=                     AND S.G_TOCHKA = (SELECT ID FROM' +
        ' CUR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101972129=                  ORDER BY 1'
      '1101972130=                  INTO :G_PRODUCT__,'
      '1101972131=                       :AMOUNT_BD_'
      '1101972132=              DO BEGIN'
      '1101972133='
      
        '1101972134=                INSERT INTO REVISION (REVISION, SKLAD' +
        ', G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1101972135=                VALUES (GEN_ID(GEN_REVISION, 1), NULL' +
        ', :G_PRODUCT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      '1101972136='
      '1101972137=                I = I + 1;'
      '1101972138=              END'
      '1101972139=          END'
      '1101972140='
      '1101972141=  END ELSE BEGIN'
      '1101972142=    FOR SELECT G.G_PRODUCT,'
      '1101972143=                 COALESCE(LT.AMOUNT, 0)'
      
        '1101972144=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, AMOUNT'
      
        '1101972145=                                                FROM ' +
        'LT_SKLAD_PRODUCT'
      
        '1101972146=                                               WHERE ' +
        'G_TOCHKA = :G_TOCHKA_) LT ON G.g_product = LT.g_product'
      '1101972147=           WHERE G.IS_ACTIVE = 1'
      '1101972148=             AND G.IS_KIT <> 1'
      
        '1101972149=             AND ((:G_PRODUCT_PAR_ CONTAINING '#39'~'#39'||G.' +
        'G_PRODUCT_PAR||'#39'~'#39' AND :G_PRODUCT_PAR_ IS NOT NULL)'
      '1101972150=                  OR'
      '1101972151=                  (:G_PRODUCT_PAR_ IS NULL)'
      '1101972152=                 )'
      
        '1101972153=             AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||G.G_PR' +
        'ODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101972154=                  OR'
      '1101972155=                  (:G_PRODUCT_ IS NULL)'
      '1101972156=                 )'
      '1101972157=             AND G.IS_CATEGORY = 0'
      '1101972158=          ORDER BY 1'
      '1101972159=          INTO :G_PRODUCT__,'
      '1101972160=               :AMOUNT_BD_'
      '1101972161=      DO BEGIN'
      '1101972162='
      
        '1101972163=        INSERT INTO REVISION_TMP (REVISION, G_PRODUCT' +
        ', AMOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '1101972164=        VALUES (GEN_ID(GEN_REVISION, 1), :G_PRODUCT__' +
        ', :AMOUNT_BD_, 0, CURRENT_TIMESTAMP);'
      '1101972165='
      '1101972166=        I = I + 1;'
      '1101972167=      END'
      '1101972168=  END'
      '1101972169=END'
      '1101972170=;'
      '1101972171='
      '1101972172=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1101972173=RETURNS ('
      '1101972174=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1101972175=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '1101972176=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '1101972177=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '1101972178=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '1101972179=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1101972180=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1101972181=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '1101972182=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '1101972183=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101972184=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101972185=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101972186=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101972187=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC,'
      '1101972188=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101972189=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC,'
      '1101972190=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101972191=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE,'
      '1101972192=  IS_MARKED TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '1101972193=  MARK_CODE TYPE OF COLUMN SKLAD_TMP.MARK_CODE,'
      '1101972194=  VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1101972195=  VES_GRAMM_PRICE TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE)'
      '1101972196=AS'
      '1101972197=BEGIN'
      '1101972198=  FOR'
      
        '1101972199=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T' +
        '.SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '1101972200=           ,PRICE_CURRENCY'
      '1101972201=           ,SUMM_CURRENCY'
      '1101972202=           ,CHARGE_ROZN_PROC'
      '1101972203=           ,PRICE_ROZN'
      '1101972204=           ,CHARGE_OPT_PROC'
      '1101972205=           ,PRICE_OPT'
      '1101972206=           ,CHANGE_SALE_PRICE'
      '1101972207=           ,P.IS_MARKED'
      '1101972208=           ,MARK_CODE'
      '1101972209=           ,P.VES_GRAMM * T.AMOUNT'
      '1101972210=           ,T.SUMM / (P.VES_GRAMM * T.AMOUNT)'
      '1101972211=    FROM SKLAD_TMP T,'
      '1101972212=         G_PRODUCT P'
      '1101972213=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101972214=    ORDER BY T.sklad'
      
        '1101972215=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, ' +
        ':NDS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '1101972216=      ,:PRICE_CURRENCY'
      '1101972217=      ,:SUMM_CURRENCY'
      '1101972218=      ,:CHARGE_ROZN_PROC'
      '1101972219=       ,:PRICE_ROZN'
      '1101972220=       ,:CHARGE_OPT_PROC'
      '1101972221=       ,:PRICE_OPT'
      '1101972222=       ,:CHANGE_SALE_PRICE'
      '1101972223=       ,:IS_MARKED'
      '1101972224=       ,:MARK_CODE'
      '1101972225=       ,:VES_GRAMM'
      '1101972226=       ,:VES_GRAMM_PRICE'
      '1101972227=  DO'
      '1101972228=    suspend;'
      '1101972229=end'
      '1101972230=;'
      '1101972231='
      '1101972232=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1101972233=RETURNS ('
      
        '1101972234=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '1101972235=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '1101972236=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '1101972237=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101972238=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101972239=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1101972240=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '1101972241=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '1101972242=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '1101972243=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1101972244=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1101972245=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101972246=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101972247=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101972248=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101972249=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PR' +
        'ICE,'
      '1101972250=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101972251=  IS_MARKED INTEGER,'
      '1101972252=  MARK_CODE TYPE OF COLUMN ZAKAZ_DETAILS.MARK_CODE,'
      
        '1101972253=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TM' +
        'P.SUMM,'
      
        '1101972254=  ORIGINAL_KIT_ID TYPE OF COLUMN ZAKAZ_DETAILS_TMP.OR' +
        'IGINAL_KIT_ID,'
      
        '1101972255=  ORIGINAL_KIT_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP' +
        '.ORIGINAL_KIT_PRICE,'
      '1101972256=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1101972257=  VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1101972258=  VES_GRAMM_PRICE TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE)'
      '1101972259=AS'
      '1101972260=begin'
      '1101972261='
      '1101972262=  FOR'
      '1101972263=    SELECT T.ZAKAZ_DETAILS,'
      '1101972264=           T.ZAKAZ,'
      '1101972265=           T.G_PRODUCT,'
      '1101972266=           T.AMOUNT,'
      '1101972267=           T.PRICE,'
      '1101972268=           T.SUMM,'
      '1101972269=           T.DISCOUNT_PERC,'
      '1101972270=           T.DISCOUNT_TENGE,'
      '1101972271=           T.DISCOUNT_SUMM,'
      '1101972272=           T.NDS,'
      '1101972273=           T.NDS_SUMM,'
      '1101972274=           P.NAME PRODUCT_NAME'
      '1101972275=           ,P.BARCODE'
      '1101972276=           ,P.ARTICUL'
      '1101972277=           ,P.PRICE'
      '1101972278=           ,P.IS_KIT'
      
        '1101972279=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_T' +
        'MP TM, G_PRODUCT GP'
      
        '1101972280=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.D' +
        'O_NOT_CHARGE_BONUS = 0)'
      '1101972281=           ,T.COST_PRICE'
      '1101972282=           ,P.IS_MARKED'
      '1101972283=           ,T.MARK_CODE'
      '1101972284=           ,T.ORIGINAL_KIT_ID'
      '1101972285=           ,T.ORIGINAL_KIT_PRICE'
      '1101972286=           ,P.BRAND'
      '1101972287=           ,P.VES_GRAMM * T.AMOUNT'
      '1101972288=           ,T.VES_GRAMM_PRICE'
      '1101972289=      FROM ZAKAZ_DETAILS_TMP T,'
      '1101972290=           G_PRODUCT P'
      '1101972291=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101972292=    ORDER BY t.ZAKAZ_DETAILS'
      '1101972293=    INTO :ZAKAZ_DETAILS,'
      '1101972294=          :ZAKAZ,'
      '1101972295=          :G_PRODUCT,'
      '1101972296=          :AMOUNT,'
      '1101972297=          :PRICE,'
      '1101972298=          :SUMM,'
      '1101972299=          :DISCOUNT_PERC,'
      '1101972300=          :DISCOUNT_TENGE,'
      '1101972301=          :DISCOUNT_SUMM,'
      '1101972302=          :NDS,'
      '1101972303=          :NDS_SUMM,'
      '1101972304=          :PRODUCT_NAME'
      '1101972305=          ,:BARCODE'
      '1101972306=          ,:ARTICUL'
      '1101972307=          ,:PRODUCT_PRICE'
      '1101972308=          ,:IS_KIT'
      '1101972309=          ,:SUM_TO_CHARGE_BONUS'
      '1101972310=          ,:COST_PRICE'
      '1101972311=          ,:IS_MARKED'
      '1101972312=          ,:MARK_CODE'
      '1101972313=          ,:ORIGINAL_KIT_ID'
      '1101972314=          ,:ORIGINAL_KIT_PRICE'
      '1101972315=          ,:BRAND'
      '1101972316=          ,:VES_GRAMM'
      '1101972317=          ,:VES_GRAMM_PRICE'
      '1101972318=  DO'
      '1101972319=    suspend;'
      '1101972320=end'
      '1101972321=;'
      '1101972322='
      '1101972323=ALTER PROCEDURE UPD_SKLAD_TMP('
      '1101972324=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101972325=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101972326=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101972327=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101972328=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101972329=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1101972330=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '1101972331=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1101972332=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0)'
      '1101972333=RETURNS ('
      '1101972334=  ERR_CODE INTEGER,'
      '1101972335=  ERR_MSG VARCHAR(1024))'
      '1101972336=AS'
      '1101972337=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101972338=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101972339=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101972340=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1101972341=DECLARE VARIABLE AMOUNT_CUR_SKLAD_ TYPE OF COLUMN SKL' +
        'AD.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' *' +
        '/'
      
        '1101972342=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1055#1056#1048#1061#1054#1044#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045 +
        ' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044' */'
      
        '1101972343=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      '1101972344=begin'
      '1101972345=  PNT_ = '#39'01'#39';'
      '1101972346=  UPDATE sklad_TMP ST'
      '1101972347=  SET'
      '1101972348=    AMOUNT = :AMOUNT_,'
      '1101972349=    PRICE = :PRICE_,'
      '1101972350=    SUMM = :SUMM_,'
      '1101972351=    NDS = :NDS_,'
      '1101972352=    NDS_SUMM = :NDS_SUMM_'
      '1101972353=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '1101972354=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      
        '1101972355=    ,CHARGE_ROZN_PROC = ROUND(((SELECT PRICE FROM G_P' +
        'RODUCT GG WHERE GG.G_PRODUCT = ST.G_PRODUCT)/:PRICE_ - 1)*100, 2' +
        ')'
      '1101972356=  WHERE'
      '1101972357=    sklad = :sklad_'
      '1101972358=  RETURNING'
      '1101972359=    SKLAD_PARENT'
      '1101972360=  INTO'
      '1101972361=    SKLAD_PARENT_;'
      '1101972362='
      
        '1101972363=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054 +
        #1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1053#1054' '#1069#1058#1040' '#1055#1056#1054#1042#1045#1056#1050#1040' '#1053#1059#1046#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058#1057#1071' '#1059 +
        #1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044', '#1054' '#1063#1045#1052' '#1057#1042#1048#1044#1045#1058#1045#1051#1068#1057#1058#1042#1059#1045#1058' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1049' SKLAD_P' +
        'ARENT_'
      
        '1101972364=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SK' +
        'LAD_PARENT_, 0) <> 0)) then BEGIN'
      '1101972365=      SELECT L.G_PRODUCT,'
      '1101972366=             L.AMOUNT'
      '1101972367=        FROM SKLAD S,'
      '1101972368=             LT_SKLAD_PRODUCT L'
      '1101972369=       WHERE S.SKLAD = :SKLAD_'
      '1101972370=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '1101972371=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101972372=        INTO :G_PRODUCT_,'
      '1101972373=             :AMOUNT_CUR_;'
      '1101972374='
      
        '1101972375=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1055#1056#1048#1061#1054#1044', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1101972376=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1055#1056#1048#1061#1054#1044', '#1056#1045 +
        #1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 40, '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068', '#1063#1043#1054#1041#1067' '#1053#1045' '#1059#1064#1051#1054' ' +
        #1042' '#1052#1048#1053#1059#1057
      
        '1101972377=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1045#1057#1051#1048' '#1057#1058#1040#1056#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1041#1054#1051#1068#1064#1045' '#1053#1054#1042#1054#1043#1054' - '#1047#1053#1040#1063#1048#1058' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042 +
        #1040#1056#1040' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1054#1057#1068','
      '1101972378=      -- '#1053#1040#1044#1054' '#1057#1044#1045#1051#1040#1058#1068' '#1063#1058#1054#1041#1067' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1057#1068' '#1053#1045' '#1042' '#1052#1048#1053#1059#1057
      '1101972379=      SELECT SUM(AMOUNT)'
      '1101972380=        FROM SKLAD T'
      '1101972381=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101972382=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101972383=        INTO :AMOUNT_OLD_;'
      '1101972384='
      '1101972385=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045
      '1101972386=      SELECT SUM(AMOUNT)'
      '1101972387=        FROM SKLAD_TMP T'
      '1101972388=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101972389=       INTO :AMOUNT_CUR_SKLAD_;'
      '1101972390='
      
        '1101972391=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD' +
        '_) THEN BEGIN'
      
        '1101972392=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_C' +
        'UR_SKLAD_)) < 0) THEN BEGIN'
      '1101972393=            ERR_CODE = -20500;'
      
        '1101972394=            ERR_MSG = '#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086 +
        #1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39'||ASCII_CHAR(10)||'
      
        '1101972395=                      '#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'.'#39';'
      
        '1101972396=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1101972397=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1101972398=            EXIT;'
      '1101972399=          END'
      '1101972400=      END'
      '1101972401=  END'
      '1101972402=end'
      '1101972403=;'
      '1101972404='
      '1101972405=ALTER PROCEDURE UPD_SKLAD_TMP1('
      '1101972406=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101972407=  OLD_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101972408=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101972409=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101972410=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101972411=  OLD_PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101972412=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101972413=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101972414=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101972415=  CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHARGE_' +
        'ROZN_PROC,'
      
        '1101972416=  OLD_CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHA' +
        'RGE_ROZN_PROC,'
      
        '1101972417=  CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARGE_O' +
        'PT_PROC,'
      
        '1101972418=  OLD_CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHAR' +
        'GE_OPT_PROC,'
      '1101972419=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101972420=  OLD_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN' +
        ','
      '1101972421=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      '1101972422=  OLD_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101972423=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1101972424=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0,'
      
        '1101972425=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0)'
      '1101972426=RETURNS ('
      '1101972427=  ERR_CODE INTEGER,'
      '1101972428=  ERR_MSG VARCHAR(1024))'
      '1101972429=AS'
      '1101972430=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101972431=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101972432=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLA' +
        'D.PRICE;'
      
        '1101972433=DECLARE VARIABLE PRICE_CALC_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1101972434=BEGIN'
      
        '1101972435=  -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1048#1051#1057#1071' '#1058#1054#1042#1040#1056', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040#1049#1058#1048' '#1057#1053#1054#1042#1040' '#1045#1043#1054' '#1047#1040 +
        #1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1062#1045#1053#1059' '#1054#1055#1058
      '1101972436=  PNT_ = '#39'01'#39';'
      '1101972437=  IF (G_PRODUCT_ <> OLD_G_PRODUCT_) THEN BEGIN'
      '1101972438=      /*SELECT S.PRICE'
      '1101972439=        FROM SKLAD S'
      
        '1101972440=       WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101972441=         AND S.IS_LAST = 1'
      '1101972442=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1101972443=        INTO :LAST_SELF_PRICE_;'
      '1101972444='
      '1101972445=      PRICE_ = COALESCE(LAST_SELF_PRICE_, 0);*/'
      
        '1101972446=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2), 0)'
      '1101972447=          RETURNING_VALUES :PRICE_;'
      '1101972448='
      '1101972449=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101972450=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101972451=        EXIT;'
      '1101972452=      END'
      '1101972453=  END'
      '1101972454='
      '1101972455=  IF (PRICE_ = 0) THEN BEGIN'
      '1101972456=    CHARGE_PRICE_ROZN_ = 0;'
      '1101972457=    CHARGE_PRICE_OPT_ = 0;'
      '1101972458=  END'
      '1101972459=  ELSE BEGIN'
      
        '1101972460=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048
      
        '1101972461=      IF (CHARGE_PRICE_ROZN_ <> OLD_CHARGE_PRICE_ROZN' +
        '_ OR (PRICE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 1)) THEN'
      
        '1101972462=        PRICE_ROZN_ = PRICE_ * CHARGE_PRICE_ROZN_/100' +
        ' + PRICE_;'
      '1101972463='
      
        '1101972464=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054 +
        #1062#1045#1053#1058', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101972465=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1053#1054' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1050#1040' '#1053 +
        #1045' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1062#1045#1053#1059' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1055#1056#1054#1062#1045#1053#1058
      
        '1101972466=      ELSE IF (PRICE_ROZN_ <> OLD_PRICE_ROZN_ OR (PRI' +
        'CE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 0) ) THEN'
      
        '1101972467=        CHARGE_PRICE_ROZN_ = ROUND((PRICE_ROZN_/PRICE' +
        '_ - 1)*100, 2);'
      '1101972468='
      
        '1101972469=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040#1062#1045#1053#1050#1040' '#1054#1055#1058' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047 +
        #1040#1050#1059#1055#1050#1048' , '#1047#1053#1040#1063#1048#1058' '#1062#1045#1053#1040' '#1054#1055#1058#1040' '#1053#1045' '#1052#1045#1053#1071#1051#1040#1057#1068', '#1041#1059#1044#1059' '#1045#1045' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101972470=      IF (CHARGE_PRICE_OPT_ <> OLD_CHARGE_PRICE_OPT_ ' +
        'OR (PRICE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 1)) THEN'
      
        '1101972471=        PRICE_OPT_ = PRICE_ * CHARGE_PRICE_OPT_/100 +' +
        ' PRICE_;'
      '1101972472='
      
        '1101972473=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1054#1055#1058#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057 +
        #1071' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1055#1058#1040', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101972474=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1053#1054' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1050#1040' '#1053 +
        #1045' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1062#1045#1053#1059' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1055#1056#1054#1062#1045#1053#1058
      
        '1101972475=      ELSE IF (PRICE_OPT_ <> OLD_PRICE_OPT_ OR (PRICE' +
        '_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 0)) THEN'
      
        '1101972476=        CHARGE_PRICE_OPT_ = ROUND((PRICE_OPT_/PRICE_ ' +
        '- 1)*100, 2);'
      '1101972477=  END'
      '1101972478='
      '1101972479=  UPDATE SKLAD_TMP T'
      '1101972480=  SET'
      '1101972481=    G_PRODUCT = :G_PRODUCT_,'
      '1101972482=    AMOUNT = :AMOUNT_,'
      '1101972483=    PRICE = :PRICE_,'
      '1101972484=    SUMM = :AMOUNT_ * :PRICE_,'
      '1101972485=    NDS = :NDS_,'
      '1101972486=    NDS_SUMM = :NDS_SUMM_'
      '1101972487=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '1101972488=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '1101972489=    ,T.CHARGE_ROZN_PROC = :CHARGE_PRICE_ROZN_'
      '1101972490=    ,T.PRICE_ROZN = :PRICE_ROZN_'
      '1101972491=    ,T.CHARGE_OPT_PROC = :CHARGE_PRICE_OPT_'
      '1101972492=    ,T.PRICE_OPT = :PRICE_OPT_'
      '1101972493=  WHERE'
      '1101972494=    SKLAD = :SKLAD_;'
      '1101972495=END'
      '1101972496=;'
      '1101972497='
      '1101972498=ALTER PROCEDURE UPDATE_ZAKAZ_DETAILS_TMP('
      
        '1101972499=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1101972500=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101972501=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101972502=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1101972503=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC,'
      
        '1101972504=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE,'
      
        '1101972505=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC,'
      '1101972506=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101972507=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1101972508=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '1101972509=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE)'
      '1101972510=RETURNS ('
      '1101972511=  ERR_CODE INTEGER,'
      '1101972512=  ERR_MSG VARCHAR(1024))'
      '1101972513=AS'
      '1101972514=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '1101972515=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL_TMP'#39';'
      '1101972516=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101972517=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101972518=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1101972519=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053 +
        #1054#1052' '#1047#1040#1050#1040#1047#1045' */'
      
        '1101972520=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1101972521=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1101972522=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      '1101972523=BEGIN'
      '1101972524='
      
        '1101972525=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070', '#1040' '#1047#1040#1058#1045#1052' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1040#1053#1040 +
        #1051#1048#1047' '#1055#1054' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1045#1053#1053#1054#1052#1059' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059','
      
        '1101972526=  -- '#1048' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1045#1043#1054' '#1057' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045'. '#1045#1057#1051#1048' '#1063#1058#1054',' +
        ' '#1055#1056#1048' '#1043#1045#1053#1045#1056#1040#1062#1048#1048' '#1054#1064#1048#1041#1050#1048', '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1041#1059#1044#1045#1058' ROLLBACK'
      '1101972527=  PNT_ = '#39'01'#39';'
      '1101972528=  UPDATE ZAKAZ_DETAILS_TMP t'
      '1101972529=     SET t.AMOUNT = :AMOUNT_,'
      '1101972530=        t.PRICE = :PRICE_,'
      '1101972531=        t.SUMM = :SUMM_,'
      '1101972532=        t.DISCOUNT_PERC = :DISCOUNT_PERC_,'
      '1101972533=        t.DISCOUNT_TENGE = :DISCOUNT_TENGE_,'
      '1101972534=        T.DISCOUNT_SUMM = :DISCOUNT_SUMM_,'
      '1101972535=        T.NDS = :NDS_,'
      '1101972536=        T.NDS_SUMM = :NDS_SUMM_,'
      '1101972537=        T.VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '1101972538=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1101972539=  RETURNING'
      '1101972540=    ZAKAZ, Z_TYPE'
      '1101972541=  INTO'
      '1101972542=    :ZAKAZ_, :Z_TYPE_;'
      '1101972543='
      
        '1101972544=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054 +
        #1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1101972545=  PNT_ = '#39'02'#39';'
      '1101972546=  if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '1101972547=      SELECT L.G_PRODUCT,'
      '1101972548=             L.AMOUNT - L.AMOUNT_RESERVE'
      '1101972549=        FROM ZAKAZ_DETAILS_TMP S,'
      '1101972550=             LT_SKLAD_PRODUCT L'
      '1101972551=       WHERE S.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1101972552=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '1101972553=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101972554=        INTO :G_PRODUCT_,'
      '1101972555=             :AMOUNT_CUR_;'
      '1101972556='
      
        '1101972557=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1101972558=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1101972559=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1101972560=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1101972561=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101972562=      PNT_ = '#39'04'#39';'
      '1101972563=      if (COALESCE(Z_TYPE_, 0) <> 3) then'
      '1101972564=          SELECT SUM(AMOUNT)'
      '1101972565=            FROM ZAKAZ_DETAILS T'
      '1101972566=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101972567=             AND T.ZAKAZ = :ZAKAZ_'
      '1101972568=            INTO :AMOUNT_OLD_;'
      '1101972569=      ELSE'
      '1101972570=          SELECT SUM(AMOUNT)'
      '1101972571=            FROM SKLAD T'
      '1101972572=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101972573=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1101972574=            INTO :AMOUNT_OLD_;'
      '1101972575='
      '1101972576=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1101972577=      PNT_ = '#39'05'#39';'
      '1101972578=      SELECT SUM(AMOUNT)'
      '1101972579=        FROM ZAKAZ_DETAILS_TMP T'
      '1101972580=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101972581=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1101972582='
      
        '1101972583=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '1101972584=        ERR_CODE = -20500;'
      
        '1101972585=        ERR_MSG = '#39#1055#1086#1089#1083#1077' '#1076#1072#1085#1085#1086#1081' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090 +
        #1086#1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39'||ASCII_CHAR(10)||'
      
        '1101972586=                  '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082#1086#1084' ' +
        #1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1101972587=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_M' +
        'SG) RETURNING_VALUES (:ERR_MSG);'
      '1101972588=        ERR_MSG = PROCNAME||ERR_MSG;'
      '1101972589=        EXIT;'
      '1101972590=      END'
      '1101972591=  END'
      '1101972592=when sqlcode -811 DO'
      '1101972593=  begin'
      '1101972594=    ERR_CODE = -20500;'
      
        '1101972595=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1052#1085#1086#1078#1077#1089#1090#1074 +
        #1086' '#1089#1090#1088#1086#1082' '#1074' '#1086#1076#1080#1085#1086#1095#1085#1086#1084' SELECT!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101972596=    ERR_MSG = PROCNAME||'#39' ->  PNT_ '#39'||PNT_||'#39'. '#39'||ERR' +
        '_MSG;'
      '1101972597=  end'
      '1101972598=END'
      '1101972599=;'
      '1101972600='
      '1101972601='
      
        '1101972602=/****************************************************' +
        '**************************/'
      
        '1101972603=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101972604=/****************************************************' +
        '**************************/'
      '1101972605=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1101972606=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101972607=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101972608=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101972609=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101972610=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101972611=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101972612=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101972613=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101972614=RETURNS ('
      '1101972615=  ERR_CODE INTEGER,'
      '1101972616=  ERR_MSG VARCHAR(1024))'
      '1101972617=AS'
      '1101972618=/*'
      
        '1101972619='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1101972620='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1101972621='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1101972622=*/'
      
        '1101972623=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1101972624=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101972625=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1101972626=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1101972627=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1101972628=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1101972629=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1101972630=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1101972631=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1101972632=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101972633=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1101972634=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1101972635=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1101972636=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101972637=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101972638=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101972639=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101972640=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101972641=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1101972642=BEGIN'
      '1101972643='
      '1101972644=  PNT_ = '#39'00'#39';'
      '1101972645=  CLRF = ascii_char( 10 );'
      '1101972646='
      '1101972647=  SELECT S.S_VALUE'
      '1101972648=    FROM SYSTEM_SETUP S'
      '1101972649=   WHERE S.SYSTEM_SETUP = 2'
      '1101972650=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1101972651='
      '1101972652=  PNT_ = '#39'01'#39';'
      '1101972653=  SELECT G.nds_value'
      '1101972654=    FROM G_FIRM_REKVIZIT G'
      '1101972655=   WHERE G.is_default = 1'
      '1101972656=    INTO :NDS_;'
      '1101972657='
      '1101972658=  PNT_ = '#39'02'#39';'
      
        '1101972659=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1101972660=        FROM IMPORT_TBL_TMP'
      
        '1101972661=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1101972662=  DO BEGIN'
      '1101972663=    SELECT G_PRODUCT,'
      '1101972664=           PRICE'
      '1101972665=      FROM ('
      '1101972666=            SELECT P.G_PRODUCT, P.price'
      '1101972667=              FROM G_PRODUCT P'
      
        '1101972668=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1101972669=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1101972670=            UNION'
      '1101972671=            SELECT LT.G_PRODUCT, P.PRICE'
      '1101972672=              FROM LT_BARCODE LT, g_product P'
      
        '1101972673=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1101972674=               AND LT.g_product = P.g_product'
      '1101972675=           )'
      '1101972676=      INTO :G_PRODUCT_,'
      '1101972677=           :PRICE_OUR_;'
      '1101972678='
      '1101972679=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1101972680=      ERR_CODE = -20500;'
      
        '1101972681=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1101972682=      Exit;'
      '1101972683=    END'
      '1101972684='
      '1101972685=    PNT_ = '#39'03'#39';'
      
        '1101972686=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1101972687=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1101972688=      RETURNING_VALUES :COST_PRICE_;'
      '1101972689='
      '1101972690=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1101972691=    IF (price_ IS NULL) THEN'
      '1101972692=      PRICE_ = PRICE_OUR_;'
      '1101972693='
      '1101972694=    PNT_ = '#39'04'#39';'
      
        '1101972695=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1101972696=                                              :AMOUNT' +
        '_,'
      
        '1101972697=                                              :PRICE_' +
        ','
      
        '1101972698=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1101972699=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1101972700=                                              :DISCOU' +
        'NT_,'
      
        '1101972701=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1101972702=                                              :NDS_,'
      
        '1101972703=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1101972704=                                              :COST_P' +
        'RICE_,'
      
        '1101972705=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1101972706=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1101972707=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1101972708=                                              0     -' +
        '-MODE_'
      
        '1101972709=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1101972710=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101972711=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101972712=      EXIT;'
      '1101972713=    END'
      '1101972714='
      '1101972715=    G_PRODUCT_ = NULL;'
      '1101972716=  END'
      '1101972717='
      '1101972718=  PNT_ = '#39'05'#39';'
      '1101972719=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1101972720=    SELECT SUM(T.summ)'
      '1101972721=      FROM ZAKAZ_DETAILS_TMP T'
      '1101972722=      INTO :SUMM_;'
      '1101972723=    SUMM_FACT_ = SUMM_;'
      '1101972724=  END'
      '1101972725='
      '1101972726=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1101972727=  if (G_PAYMENT_TYPE_ = 1) then'
      '1101972728=    SUMM_CASH_ = summ_fact_;'
      '1101972729=  ELSE'
      '1101972730=    SUMM_NONCASH_ = summ_fact_;'
      '1101972731='
      '1101972732=  PNT_ = '#39'06'#39';'
      '1101972733=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1101972734=    G_CLIENT_ = 10;'
      '1101972735='
      '1101972736=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101972737=                              :Z_DATE_,'
      '1101972738=                              :Z_TIME_,'
      '1101972739=                              :G_CLIENT_,'
      '1101972740=                              :G_PAYMENT_TYPE_,'
      '1101972741=                              '#39#39', --:OSNOVANIE_,'
      '1101972742=                              0,  -- IS_SPISANIE'
      
        '1101972743=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1101972744=                              :SUMM_,'
      '1101972745=                              :SUMM_FACT_,'
      '1101972746=                              :SUMM_CASH_,'
      '1101972747=                              :SUMM_NONCASH_,'
      
        '1101972748=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1101972749=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1101972750=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1101972751=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1101972752=                              0,    -- :BY_RECIPE__,'
      '1101972753=                              0,    -- IS_RESERVE__'
      '1101972754=                              NULL -- :PAYMENTS__'
      '1101972755=                              )'
      
        '1101972756=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101972757=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101972758=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101972759=    EXIT;'
      '1101972760=  END'
      '1101972761='
      '1101972762=  DELETE FROM import_tbl_tmp;'
      '1101972763='
      '1101972764=WHEN ANY DO BEGIN'
      '1101972765=    ERR_CODE = gdscode;'
      
        '1101972766=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1101972767=  END'
      '1101972768=end'
      '1101972769=;'
      '1101972770='
      '1101972771='
      
        '1101972772=UPDATE SYSTEM_SETUP SET S_VALUE = 110197 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101972773=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101972774=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101980='
      '1101981=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1101982=RETURNS ('
      '1101983=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1101984=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '1101985=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '1101986=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '1101987=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '1101988=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1101989=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '11019810=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '11019811=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '11019812=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11019813=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11019814=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11019815=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '11019816=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZN' +
        '_PROC,'
      '11019817=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '11019818=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_P' +
        'ROC,'
      '11019819=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '11019820=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_SAL' +
        'E_PRICE,'
      '11019821=  IS_MARKED TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '11019822=  MARK_CODE TYPE OF COLUMN SKLAD_TMP.MARK_CODE,'
      '11019823=  VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '11019824=  VES_GRAMM_PRICE TYPE OF COLUMN G_PRODUCT.VES_GRAMM_PR' +
        'ICE)'
      '11019825=AS'
      '11019826=BEGIN'
      '11019827=  FOR'
      
        '11019828=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.S' +
        'UMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '11019829=           ,PRICE_CURRENCY'
      '11019830=           ,SUMM_CURRENCY'
      '11019831=           ,CHARGE_ROZN_PROC'
      '11019832=           ,PRICE_ROZN'
      '11019833=           ,CHARGE_OPT_PROC'
      '11019834=           ,PRICE_OPT'
      '11019835=           ,CHANGE_SALE_PRICE'
      '11019836=           ,P.IS_MARKED'
      '11019837=           ,MARK_CODE'
      '11019838=           ,P.VES_GRAMM * T.AMOUNT'
      
        '11019839=           ,COALESCE(P.VES_GRAMM, 0, T.SUMM / (P.VES_GR' +
        'AMM * T.AMOUNT))'
      '11019840=    FROM SKLAD_TMP T,'
      '11019841=         G_PRODUCT P'
      '11019842=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11019843=    ORDER BY T.sklad'
      
        '11019844=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :N' +
        'DS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '11019845=      ,:PRICE_CURRENCY'
      '11019846=      ,:SUMM_CURRENCY'
      '11019847=      ,:CHARGE_ROZN_PROC'
      '11019848=       ,:PRICE_ROZN'
      '11019849=       ,:CHARGE_OPT_PROC'
      '11019850=       ,:PRICE_OPT'
      '11019851=       ,:CHANGE_SALE_PRICE'
      '11019852=       ,:IS_MARKED'
      '11019853=       ,:MARK_CODE'
      '11019854=       ,:VES_GRAMM'
      '11019855=       ,:VES_GRAMM_PRICE'
      '11019856=  DO'
      '11019857=    suspend;'
      '11019858=end'
      '11019859=;'
      '11019860='
      '11019861='
      
        '11019862=UPDATE SYSTEM_SETUP SET S_VALUE = 110198 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '11019863=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11019864=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101990='
      '1101991=ALTER PROCEDURE G_READ_G_OFFICIAL_LIST'
      '1101992=RETURNS ('
      
        '1101993=  G_OFFICIAL /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT,'
      '1101994=  FM /* TYPE OF COLUMN G_OFFICIAL.FM */ VARCHAR(100),'
      '1101995=  NM /* TYPE OF COLUMN G_OFFICIAL.NM */ VARCHAR(100),'
      '1101996=  FT /* TYPE OF COLUMN G_OFFICIAL.FT */ VARCHAR(100),'
      '1101997=  FIO VARCHAR(200),'
      
        '1101998=  FIO_DOC /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */ VARCHA' +
        'R(150),'
      '1101999=  RNN /* TYPE OF COLUMN G_OFFICIAL.RNN */ VARCHAR(12),'
      '11019910=  IDN /* TYPE OF COLUMN G_OFFICIAL.IDN */ VARCHAR(12),'
      '11019911=  DT /* TYPE OF COLUMN G_OFFICIAL.DT */ DATE,'
      
        '11019912=  G_ID_KIND /* TYPE OF COLUMN G_OFFICIAL.G_ID_KIND */ V' +
        'ARCHAR(100),'
      
        '11019913=  ID_NUM /* TYPE OF COLUMN G_OFFICIAL.ID_NUM */ VARCHAR' +
        '(100),'
      '11019914=  ID_DATE /* TYPE OF COLUMN G_OFFICIAL.ID_DATE */ DATE,'
      
        '11019915=  ID_ISSUER /* TYPE OF COLUMN G_OFFICIAL.ID_ISSUER */ V' +
        'ARCHAR(100),'
      
        '11019916=  G_APPOINTMENT /* TYPE OF COLUMN G_OFFICIAL.G_APPOINTM' +
        'ENT */ BIGINT,'
      
        '11019917=  IS_RUKOVODITEL /* TYPE OF COLUMN G_OFFICIAL.IS_RUKOVO' +
        'DITEL */ INTEGER,'
      
        '11019918=  IS_GLAVBUH /* TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH */' +
        ' INTEGER,'
      
        '11019919=  IS_ISPOLNITEL /* TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNI' +
        'TEL */ SMALLINT,'
      
        '11019920=  APP_NAME /* TYPE OF COLUMN G_APPOINTMENT.NAME */ VARC' +
        'HAR(250),'
      
        '11019921=  PASS /* TYPE OF COLUMN G_OFFICIAL.PASS */ VARCHAR(50)' +
        ')'
      '11019922=AS'
      '11019923=BEGIN'
      '11019924=  SUSPEND;'
      '11019925=END'
      '11019926=;'
      '11019927='
      '11019928=ALTER PROCEDURE P_REP_ZAKAZI_LIST_CATEGORY('
      
        '11019929=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      
        '11019930=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT */ BIGINT,'
      
        '11019931=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      '11019932=  DATE_BEGIN_ DATE,'
      '11019933=  DATE_END_ DATE,'
      '11019934=  TIME_BEGIN_ TIME,'
      '11019935=  TIME_END_ TIME,'
      '11019936=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11019937=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '11019938=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BI' +
        'GINT = 0)'
      '11019939=RETURNS ('
      '11019940=  PERIOD_ VARCHAR(40),'
      
        '11019941=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11019942=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11019943=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUME' +
        'RIC(18,5),'
      
        '11019944=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      '11019945=  ERR_CODE INTEGER,'
      '11019946=  ERR_MSG VARCHAR(1024))'
      '11019947=AS'
      '11019948=BEGIN'
      '11019949=  SUSPEND;'
      '11019950=END'
      '11019951=;'
      '11019952='
      '11019953='
      
        '11019954=/******************************************************' +
        '************************/'
      
        '11019955=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11019956=/******************************************************' +
        '************************/'
      '11019957=ALTER PROCEDURE G_READ_G_OFFICIAL_LIST'
      '11019958=RETURNS ('
      '11019959=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11019960=  FM TYPE OF COLUMN G_OFFICIAL.FM,'
      '11019961=  NM TYPE OF COLUMN G_OFFICIAL.NM,'
      '11019962=  FT TYPE OF COLUMN G_OFFICIAL.FT,'
      '11019963=  FIO VARCHAR(200),'
      '11019964=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11019965=  RNN TYPE OF COLUMN G_OFFICIAL.RNN,'
      '11019966=  IDN TYPE OF COLUMN G_OFFICIAL.IDN,'
      '11019967=  DT TYPE OF COLUMN G_OFFICIAL.DT,'
      '11019968=  G_ID_KIND TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '11019969=  ID_NUM TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '11019970=  ID_DATE TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '11019971=  ID_ISSUER TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '11019972=  G_APPOINTMENT TYPE OF COLUMN G_OFFICIAL.G_APPOINTMENT' +
        ','
      
        '11019973=  IS_RUKOVODITEL TYPE OF COLUMN G_OFFICIAL.IS_RUKOVODIT' +
        'EL,'
      '11019974=  IS_GLAVBUH TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '11019975=  IS_ISPOLNITEL TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNITEL' +
        ','
      '11019976=  APP_NAME TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '11019977=  PASS TYPE OF COLUMN G_OFFICIAL.PASS)'
      '11019978=AS'
      '11019979=begin'
      '11019980=    FOR'
      '11019981=    SELECT t.G_OFFICIAL,'
      '11019982=           T.FM,'
      '11019983=           T.NM,'
      '11019984=           T.FT,'
      
        '11019985=           COALESCE(T.FM, '#39#39')||COALESCE('#39' '#39'||T.NM, '#39#39')|' +
        '|COALESCE('#39' '#39'||T.FT,  '#39#39'),'
      
        '11019986=           DECODE(CHAR_LENGTH(T.FIO_DOC), 0, T.FM||'#39' '#39'|' +
        '|T.NM||'#39' '#39'||T.FT, T.FIO_DOC),'
      '11019987=           T.RNN,'
      '11019988=           T.IDN,'
      '11019989=           T.DT,'
      '11019990=           T.G_ID_KIND,'
      '11019991=           T.ID_NUM,'
      '11019992=           T.ID_DATE,'
      '11019993=           T.ID_ISSUER,'
      '11019994=           T.G_APPOINTMENT,'
      '11019995=           T.IS_RUKOVODITEL,'
      '11019996=           T.IS_GLAVBUH,'
      '11019997=           T.IS_ISPOLNITEL,'
      '11019998=           G.NAME APP_NAME'
      '11019999=           ,T.PASS'
      
        '110199100=      FROM g_OFFICIAL t LEFT OUTER JOIN G_APPOINTMENT ' +
        'G ON T.G_APPOINTMENT = G.G_APPOINTMENT'
      '110199101=     WHERE t.IS_ACTIVE = 1'
      '110199102=    ORDER BY T.G_OFFICIAL, T.FM, T.NM, T.FT'
      '110199103=    INTO :G_OFFICIAL,'
      '110199104=        :FM,'
      '110199105=        :NM,'
      '110199106=        :FT,'
      '110199107=        :FIO,'
      '110199108=        :FIO_DOC,'
      '110199109=        :RNN,'
      '110199110=        :IDN,'
      '110199111=        :DT,'
      '110199112=        :G_ID_KIND,'
      '110199113=        :ID_NUM,'
      '110199114=        :ID_DATE,'
      '110199115=        :ID_ISSUER,'
      '110199116=        :G_APPOINTMENT,'
      '110199117=        :IS_RUKOVODITEL,'
      '110199118=        :IS_GLAVBUH,'
      '110199119=        :IS_ISPOLNITEL,'
      '110199120=        :APP_NAME'
      '110199121=        ,:PASS'
      '110199122=    DO'
      '110199123=      SUSPEND;'
      '110199124=end'
      '110199125=;'
      '110199126='
      '110199127=ALTER PROCEDURE G_UPD_G_OFFICIAL('
      '110199128=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110199129=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110199130=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110199131=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110199132=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110199133=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110199134=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110199135=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110199136=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110199137=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110199138=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110199139=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110199140=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110199141=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110199142=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110199143=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110199144=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110199145=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110199146=  RIGHTS_ARR_ VARCHAR(500),'
      
        '110199147=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.G_OFFIC' +
        'IAL,'
      '110199148=  KOD_ TYPE OF COLUMN G_OFFICIAL.KOD)'
      '110199149=RETURNS ('
      '110199150=  ERR_CODE INTEGER,'
      '110199151=  ERR_MSG VARCHAR(1024))'
      '110199152=AS'
      
        '110199153=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110199154=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110199155=BEGIN'
      '110199156=    -- '#1053#1040#1061#1059#1071'??? '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1045#1049' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      
        '110199157=    --IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057 +
        #1071' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110199158=    --  UPDATE G_OFFICIAL G'
      '110199159=    --     SET G.IS_ISPOLNITEL = 0;'
      '110199160='
      
        '110199161=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110199162=      UPDATE G_OFFICIAL G'
      '110199163=         SET G.IS_RUKOVODITEL = 0;'
      '110199164='
      
        '110199165=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110199166=      UPDATE G_OFFICIAL G'
      '110199167=         SET G.IS_GLAVBUH = 0;'
      '110199168='
      '110199169=    update G_OFFICIAL'
      '110199170=    set FM = :FM_,'
      '110199171=        NM = :NM_,'
      '110199172=        FT = :FT_,'
      '110199173=        FIO_DOC = :FIO_DOC_,'
      '110199174=        RNN = :RNN_,'
      '110199175=        IDN = :IDN_,'
      '110199176=        DT = :DT_,'
      '110199177=        G_ID_KIND = :G_ID_KIND_,'
      '110199178=        ID_NUM = :ID_NUM_,'
      '110199179=        ID_DATE = :ID_DATE_,'
      '110199180=        ID_ISSUER = :ID_ISSUER_,'
      '110199181=        G_APPOINTMENT = :G_APPOINTMENT_,'
      '110199182=        IS_RUKOVODITEL = :IS_RUKOVODITEL_,'
      '110199183=        IS_GLAVBUH = :IS_GLAVBUH_,'
      '110199184=        IS_ISPOLNITEL = :IS_ISPOLNITEL_,'
      '110199185=        PASS = :PASSWORD_,'
      '110199186=        G_TOCHKA = :G_TOCHKA_,'
      '110199187=        DO_NOT_SALES_COMM = :DO_NOT_SALES_COMM_,'
      '110199188=        KOD = :KOD_'
      '110199189=    where (G_OFFICIAL = :G_OFFICIAL_);'
      '110199190='
      
        '110199191=    DELETE FROM G_OFFICIAL_RIGHT WHERE G_OFFICIAL = :G' +
        '_OFFICIAL_;'
      '110199192=    FOR SELECT T.RIGHTS_ITEM'
      '110199193=        FROM RIGHTS_ITEM T'
      '110199194=       WHERE T.IS_CATEGORY = 0'
      
        '110199195=         AND :RIGHTS_ARR_ CONTAINING '#39'-'#39'||T.RIGHTS_ITE' +
        'M||'#39'-'#39
      '110199196=        INTO :RIGHTS_ITEM_'
      '110199197=    DO BEGIN'
      
        '110199198=        INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT' +
        ', RIGHTS_ITEM, G_OFFICIAL)'
      
        '110199199=        VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGH' +
        'TS_ITEM_, :G_OFFICIAL_);'
      '110199200=    END'
      '110199201='
      
        '110199202=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110199203=    SELECT COUNT(G.G_OFFICIAL)'
      '110199204=      FROM G_OFFICIAL G'
      '110199205=     WHERE EXISTS (SELECT 1'
      '110199206=                     FROM G_OFFICIAL_RIGHT R'
      '110199207=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110199208=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110199209=    INTO :CNT_;'
      '110199210='
      '110199211=    IF (:CNT_ = 0) THEN BEGIN'
      '110199212=      ERR_CODE = -20500;'
      
        '110199213=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1086#1073#1093#1086#1076 +
        #1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087#1088 +
        #1072#1074#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110199214=      EXIT;'
      '110199215=    END'
      '110199216=end'
      '110199217=;'
      '110199218='
      '110199219=ALTER PROCEDURE P_REP_ZAKAZI_LIST_CATEGORY('
      '110199220=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110199221=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110199222=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110199223=  DATE_BEGIN_ DATE,'
      '110199224=  DATE_END_ DATE,'
      '110199225=  TIME_BEGIN_ TIME,'
      '110199226=  TIME_END_ TIME,'
      '110199227=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110199228=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110199229=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '110199230=RETURNS ('
      '110199231=  PERIOD_ VARCHAR(40),'
      '110199232=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110199233=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110199234=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110199235=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110199236=  ERR_CODE INTEGER,'
      '110199237=  ERR_MSG VARCHAR(1024))'
      '110199238=AS'
      
        '110199239=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_' +
        'LIST'#39';'
      '110199240=BEGIN'
      '110199241=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '110199242=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '110199243='
      
        '110199244=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110199245=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110199246='
      '110199247=  FOR SELECT SUM(ZD.SUMM)'
      '110199248=           ,SUM(ZD.DISCOUNT_SUMM)'
      '110199249=           ,SUM(ZD.AMOUNT)'
      '110199250=           ,TR.PATH'
      '110199251=      FROM ZAKAZ Z,'
      '110199252=           ZAKAZ_DETAILS ZD,'
      '110199253=           G_PRODUCT GP,'
      '110199254=           P_REP_TREE TR,'
      '110199255=           G_CLIENT GC'
      
        '110199256=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110199257=       AND Z.IS_SPISANIE IN (0,2)'
      '110199258=       AND Z.IS_RESERVE = 0'
      '110199259=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110199260=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110199261=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110199262=       AND Z.G_CLIENT = GC.G_CLIENT'
      '110199263=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110199264=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'Z.G_CLIENT, 1))'
      
        '110199265=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, GC.G_CLIENT_PARENT)'
      
        '110199266=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '110199267=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_ AND :TIME_BEGIN_ IS NULL)'
      '110199268=            OR'
      
        '110199269=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGI' +
        'N_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN' +
        '_ IS NOT NULL)'
      '110199270=           )'
      
        '110199271=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT' +
        '||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110199272=             OR'
      '110199273=             (:G_CATEGORY_ IS NULL)'
      '110199274=           )'
      '110199275=       AND ((EXISTS (SELECT 1'
      '110199276=                       FROM SKLAD S'
      '110199277=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110199278=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110199279=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110199280=              OR'
      '110199281=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110199282=     GROUP BY TR.PATH'
      '110199283=     ORDER BY TR.PATH'
      '110199284=     INTO :SUMM, :DISCOUNT_SUMM, :AMOUNT, :TOVAR_NAME'
      '110199285=  DO suspend;'
      '110199286='
      '110199287=WHEN ANY DO BEGIN'
      '110199288=    Err_code = -20500;'
      
        '110199289=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110199290=  END'
      '110199291=end'
      '110199292=;'
      '110199293='
      '110199294=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '110199295=  DATE_BEGIN_ DATE,'
      '110199296=  DATE_END_ DATE,'
      '110199297=  IS_SPISANIE_ INTEGER)'
      '110199298=RETURNS ('
      '110199299=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110199300=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110199301=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110199302=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110199303=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110199304=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110199305=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110199306=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '110199307=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110199308=  DETAILS_STR VARCHAR(3000),'
      '110199309=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110199310=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110199311=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '110199312=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '110199313=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '110199314=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110199315=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110199316=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110199317=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110199318=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110199319=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110199320=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110199321=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110199322=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110199323=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110199324=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS)'
      '110199325=AS'
      '110199326=/*'
      '110199327=IS_SPISANIE_'
      '110199328=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110199329=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110199330=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110199331=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110199332=*/'
      '110199333=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110199334=DECLARE VARIABLE G_OFFICIAL_LOCAL_ TYPE OF COLUMN G_OF' +
        'FICIAL.G_OFFICIAL;'
      
        '110199335=DECLARE VARIABLE G_OFFICIAL_APPOINT_ TYPE OF COLUMN G_' +
        'OFFICIAL.IS_ISPOLNITEL;'
      '110199336=BEGIN'
      '110199337='
      '110199338=  SELECT G.G_OFFICIAL,'
      '110199339=         G.IS_ISPOLNITEL'
      '110199340=    FROM CUR_PARAMS C,'
      '110199341=         G_OFFICIAL G'
      '110199342=   WHERE C.ID = G.G_OFFICIAL'
      '110199343=     AND C.CUR_PARAMS = 1'
      '110199344=    INTO :G_OFFICIAL_LOCAL_,'
      '110199345=         :G_OFFICIAL_APPOINT_;'
      '110199346='
      '110199347=  G_OFFICIAL_LOCAL_ = COALESCE(G_OFFICIAL_LOCAL_, 0);'
      
        '110199348=  G_OFFICIAL_APPOINT_ = COALESCE(G_OFFICIAL_APPOINT_, ' +
        '0);'
      '110199349='
      '110199350=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110199351=      SELECT COUNT(*)'
      '110199352=        FROM ZAKAZ T'
      
        '110199353=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      
        '110199354=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '110199355=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '110199356=        INTO CNT_;'
      '110199357='
      '110199358=      if (CNT_ = 0) then'
      '110199359=        SELECT MAX(T.Z_DATE)'
      '110199360=          FROM ZAKAZ T'
      '110199361=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '110199362=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '110199363=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110199364=          INTO :DATE_BEGIN_;'
      '110199365='
      '110199366=  END ELSE BEGIN'
      '110199367=      SELECT COUNT(*)'
      '110199368=        FROM SKLAD_PARENT T'
      
        '110199369=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110199370=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110199371=        INTO CNT_;'
      '110199372='
      '110199373=      if (CNT_ = 0) then'
      '110199374=        SELECT MAX(T.DATE_RECEIPT)'
      '110199375=          FROM SKLAD_PARENT T'
      '110199376=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '110199377=           AND T.IS_VOZVRAT = 3'
      
        '110199378=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110199379=          INTO :DATE_BEGIN_;'
      '110199380=  END'
      '110199381='
      '110199382=  -- '#1055#1056#1054#1044#1040#1046#1048
      '110199383=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '110199384=      FOR'
      '110199385=        SELECT T.ZAKAZ,'
      
        '110199386=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042 +
        #1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '110199387=               T.G_TOCHKA,'
      '110199388=               T.Z_DATE,'
      '110199389=               T.Z_TIME,'
      '110199390=               T.G_CLIENT,'
      '110199391=               T.OSNOVANIE,'
      '110199392=               T.NOTE,'
      '110199393=               gc.name,'
      
        '110199394=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AMO' +
        'UNT||'#39')'#39', '#39', '#39')'
      
        '110199395=                            FROM (SELECT G.name, SUM(D' +
        '.amount) AMOUNT'
      
        '110199396=                                    FROM ZAKAZ Z, ZAKA' +
        'Z_DETAILS D, G_PRODUCT G'
      
        '110199397=                                   WHERE D.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
