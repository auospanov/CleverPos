      '11013554='
      '11013555=ALTER PROCEDURE INS_ZAKAZ('
      
        '11013556=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT,'
      '11013557=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '11013558=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '11013559=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT,'
      
        '11013560=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYP' +
        'E */ BIGINT,'
      
        '11013561=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCH' +
        'AR(150),'
      
        '11013562=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ I' +
        'NTEGER,'
      '11013563=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
