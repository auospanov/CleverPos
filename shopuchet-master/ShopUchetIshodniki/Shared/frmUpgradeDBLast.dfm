      '110137239=AS'
      '110137240=BEGIN'
      '110137241=  SUSPEND;'
      '110137242=END'
      '110137243=;'
      '110137244='
      '110137245=ALTER PROCEDURE UPD_SKLAD_TMP1('
      
        '110137246=  G_PRODUCT_ /* TYPE OF COLUMN SKLAD.G_PRODUCT */ BIGI' +
        'NT,'
      
        '110137247=  OLD_G_PRODUCT_ /* TYPE OF COLUMN SKLAD.G_PRODUCT */ ' +
        'BIGINT,'
      '110137248=  SKLAD_ /* TYPE OF COLUMN SKLAD.SKLAD */ BIGINT,'
      
        '110137249=  AMOUNT_ /* TYPE OF COLUMN SKLAD.AMOUNT */ NUMERIC(18' +
        ',5),'
      
        '110137250=  PRICE_ /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(15,2' +
        '),'
      
        '110137251=  OLD_PRICE_ /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(' +
        '15,2),'
      '110137252=  SUMM_ /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2),'
      '110137253=  NDS_ /* TYPE OF COLUMN SKLAD.NDS */ NUMERIC(15,2),'
      
        '110137254=  NDS_SUMM_ /* TYPE OF COLUMN SKLAD.NDS_SUMM */ NUMERI' +
        'C(15,2),'
      
        '110137255=  CHARGE_PRICE_ROZN_ /* TYPE OF COLUMN SKLAD_TMP.CHARG' +
        'E_ROZN_PROC */ NUMERIC(15,2),'
      
        '110137256=  OLD_CHARGE_PRICE_ROZN_ /* TYPE OF COLUMN SKLAD_TMP.C' +
        'HARGE_ROZN_PROC */ NUMERIC(15,2),'
      
        '110137257=  CHARGE_PRICE_OPT_ /* TYPE OF COLUMN SKLAD_TMP.CHARGE' +
        '_OPT_PROC */ NUMERIC(15,2),'
      
        '110137258=  OLD_CHARGE_PRICE_OPT_ /* TYPE OF COLUMN SKLAD_TMP.CH' +
        'ARGE_OPT_PROC */ NUMERIC(15,2),'
      
        '110137259=  PRICE_ROZN_ /* TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN *' +
        '/ NUMERIC(15,2),'
      
        '110137260=  OLD_PRICE_ROZN_ /* TYPE OF COLUMN SKLAD_TMP.PRICE_RO' +
        'ZN */ NUMERIC(15,2),'
      
        '110137261=  PRICE_OPT_ /* TYPE OF COLUMN SKLAD_TMP.PRICE_OPT */ ' +
        'NUMERIC(15,2),'
      
        '110137262=  OLD_PRICE_OPT_ /* TYPE OF COLUMN SKLAD_TMP.PRICE_OPT' +
        ' */ NUMERIC(15,2),'
      
        '110137263=  PRICE_CURRENCY_ /* TYPE OF COLUMN SKLAD.PRICE_CURREN' +
        'CY */ NUMERIC(15,2) = 0,'
      
        '110137264=  SUMM_CURRENCY_ /* TYPE OF COLUMN SKLAD.SUMM_CURRENCY' +
        ' */ NUMERIC(15,2) = 0,'
      
        '110137265=  CHANGE_SALE_PRICE_ /* TYPE OF COLUMN SKLAD_TMP.CHANG' +
        'E_SALE_PRICE */ SMALLINT = 0)'
      '110137266=RETURNS ('
      '110137267=  ERR_CODE INTEGER,'
      '110137268=  ERR_MSG VARCHAR(1024))'
      '110137269=AS'
      '110137270=BEGIN'
      '110137271=  SUSPEND;'
      '110137272=END'
      '110137273=;'
      '110137274='
      '110137275='
      
        '110137276=/*****************************************************' +
        '*************************/'
      
        '110137277=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110137278=/*****************************************************' +
        '*************************/'
      '110137279=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '110137280=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110137281=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110137282=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110137283=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110137284=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110137285=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110137286=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110137287=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110137288=  SELF_PRICE_ NUMERIC(15,2),'
      '110137289=  AMOUNT_ MY_NUMERIC_5,'
      '110137290=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110137291=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110137292=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110137293=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110137294=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '110137295=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110137296=  CATEGORY_NAME_ VARCHAR(1000),'
      '110137297=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110137298=  IS_THIS_LAST_ INTEGER,'
      '110137299=  UPDATE_IF_EXIST_ INTEGER)'
      '110137300=RETURNS ('
      '110137301=  ERR_CODE INTEGER,'
      '110137302=  ERR_MSG VARCHAR(1024))'
      '110137303=AS'
      
        '110137304=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PR' +
        'ODUCT'#39';'
      '110137305=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110137306=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110137307=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR;'
      
        '110137308=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110137309=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110137310=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110137311=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110137312=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110137313=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110137314=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM_CURRENCY;'
      '110137315=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110137316=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110137317=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110137318=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110137319=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110137320=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110137321=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '110137322=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110137323=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '110137324=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110137325=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110137326=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110137327=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110137328=BEGIN'
      '110137329=    ERR_MSG = '#39#39';'
      '110137330=    PNT_ = '#39'00'#39';'
      '110137331='
      
        '110137332=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045 +
        #1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '110137333=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS8898' +
        '8~98888~"'
      
        '110137334=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053 +
        #1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '110137335=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '110137336=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~' +
        #39');'
      '110137337=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '110137338=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '110137339=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '110137340=    END ELSE'
      '110137341=        CROSSCODE_ = NULL;'
      '110137342='
      '110137343=    PNT_ = '#39'01'#39';'
      '110137344=    SELECT ID'
      '110137345=      FROM CUR_PARAMS'
      '110137346=    WHERE CUR_PARAMS = 2'
      '110137347=      INTO :G_TOCHKA_;'
      '110137348='
      '110137349=    SELECT G.G_UNIT'
      '110137350=      FROM G_UNIT G'
      
        '110137351=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME' +
        '_G_UNIT_))'
      '110137352=      INTO :G_UNIT_;'
      '110137353=    if (ROW_COUNT = 0) then'
      '110137354=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110137355='
      '110137356=    PNT_ = '#39'02'#39';'
      
        '110137357=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110137358=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '110137359=        SELECT G.G_PRODUCT,'
      '110137360=               G.NAME'
      '110137361=          FROM G_PRODUCT G'
      
        '110137362=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110137363=           AND TRIM(G.ARTICUL) <> '#39#39
      '110137364=           AND G.IS_ACTIVE = 1'
      '110137365=          INTO :G_PRODUCT_,'
      '110137366=               :G_PRODUCT_NAME_;'
      '110137367='
      
        '110137368=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110137369=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110137370=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110137371=              UPDATE G_PRODUCT G'
      '110137372=                 SET G.NAME = :NAME_,'
      '110137373=                     G.G_UNIT = :G_UNIT_,'
      '110137374=                     G.PRICE  = :PRICE_,'
      '110137375=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110137376=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110137377=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110137378=                     G.PLACE = :PLACE_,'
      
        '110137379=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110137380=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110137381=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110137382=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110137383=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110137384=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110137385='
      
        '110137386=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110137387=            END ELSE'
      
        '110137388=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110137389=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110137390=        END'
      '110137391=    END ELSE'
      
        '110137392=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110137393='
      
        '110137394=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110137395=    PNT_ = '#39'02a'#39';'
      
        '110137396=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110137397=        SELECT G.G_PRODUCT,'
      '110137398=               G.NAME'
      '110137399=          FROM G_PRODUCT G'
      
        '110137400=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110137401=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110137402=           AND G.IS_ACTIVE = 1'
      '110137403=          INTO :G_PRODUCT_,'
      '110137404=               :G_PRODUCT_NAME_;'
      '110137405='
      
        '110137406=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110137407=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110137408=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110137409=              UPDATE G_PRODUCT G'
      '110137410=                 SET G.NAME = :NAME_,'
      '110137411=                     G.G_UNIT = :G_UNIT_,'
      '110137412=                     G.PRICE  = :PRICE_,'
      '110137413=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110137414=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110137415=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110137416=                     G.PLACE = :PLACE_,'
      
        '110137417=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110137418=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110137419=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110137420=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110137421=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110137422=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110137423='
      
        '110137424=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110137425=            END ELSE'
      
        '110137426=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110137427=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110137428=        END'
      '110137429=    end'
      '110137430='
      
        '110137431=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110137432=    PNT_ = '#39'02b'#39';'
      
        '110137433=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110137434=        SELECT G.G_PRODUCT,'
      '110137435=               G.NAME'
      '110137436=          FROM G_PRODUCT G'
      '110137437=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110137438=           AND TRIM(G.BARCODE) <> '#39#39
      '110137439=           AND G.IS_ACTIVE = 1'
      '110137440=          INTO :G_PRODUCT_,'
      '110137441=               :G_PRODUCT_NAME_;'
      '110137442='
      '110137443=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110137444=          SELECT G.G_PRODUCT,'
      '110137445=                 G.NAME'
      '110137446=            FROM G_PRODUCT G, LT_BARCODE L'
      '110137447=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110137448=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110137449=             AND TRIM(L.BARCODE) <> '#39#39
      '110137450=            INTO :G_PRODUCT_,'
      '110137451=                 :G_PRODUCT_NAME_;'
      '110137452='
      
        '110137453=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110137454=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110137455=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110137456=              UPDATE G_PRODUCT G'
      '110137457=                 SET G.NAME = :NAME_,'
      '110137458=                     G.G_UNIT = :G_UNIT_,'
      '110137459=                     G.PRICE  = :PRICE_,'
      '110137460=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110137461=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110137462=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110137463=                     G.PLACE = :PLACE_,'
      
        '110137464=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110137465=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110137466=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110137467=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110137468=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110137469=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110137470='
      
        '110137471=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110137472=            END ELSE'
      
        '110137473=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110137474=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110137475=        END'
      
        '110137476=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110137477=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110137478='
      
        '110137479=    --================================================' +
        '========='
      '110137480=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110137481=    --================================================' +
        '========='
      '110137482=    PNT_ = '#39'02b'#39';'
      '110137483=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110137484='
      
        '110137485=        ----------------------------------------------' +
        '--------------------'
      
        '110137486=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' ' +
        #1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '110137487=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080 +
        '~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110137488=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110137489=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', ' +
        #1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '110137490=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110137491=            G_PRODUCT_PAR_ = NULL;'
      
        '110137492=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110137493=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110137494=              STR_ = CATEGORY_NAME_;'
      '110137495=              CATEGORY_NAME_ = '#39#39';'
      '110137496=            END ELSE'
      
        '110137497=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110137498='
      '110137499=            SELECT G_PRODUCT'
      '110137500=              FROM G_PRODUCT G'
      '110137501=             WHERE G.NAME = :STR_'
      '110137502=               AND G.IS_CATEGORY = 1'
      
        '110137503=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110137504=                   OR'
      '110137505=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '110137506=              INTO G_PRODUCT_PAR_;'
      '110137507=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110137508=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110137509=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110137510=                RETURNING G_PRODUCT'
      '110137511=                INTO :G_PRODUCT_PAR_;'
      '110137512='
      '110137513=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110137514=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110137515=        END'
      
        '110137516=        ----------------------------------------------' +
        '--------------------'
      '110137517='
      
        '110137518=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110137519=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '110137520=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110137521=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '110137522=        RETURNING G_PRODUCT'
      '110137523=        INTO :G_PRODUCT_;'
      '110137524='
      
        '110137525=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110137526=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110137527=    end'
      '110137528='
      
        '110137529=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110137530=    PNT_ = '#39'03'#39';'
      '110137531=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110137532=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110137533=                                       :AMOUNT_,'
      '110137534=                                       :SELF_PRICE_,'
      
        '110137535=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110137536=                                       0, --nds_,'
      '110137537=                                       0 --nds_summ_,'
      
        '110137538=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110137539=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110137540=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110137541=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110137542=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110137543=          EXIT;'
      '110137544=        END'
      '110137545=    END'
      '110137546='
      
        '110137547=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110137548=    PNT_ = '#39'04'#39';'
      '110137549=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110137550=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110137551=        FROM SKLAD_TMP T'
      '110137552=        INTO :CNT_;'
      '110137553='
      '110137554=      if (CNT_ > 0) then BEGIN'
      '110137555=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110137556=          FROM SKLAD_TMP T'
      '110137557=          INTO :SUMM_, :SUMM_UE_;'
      '110137558='
      '110137559=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110137560=                                DATE_RECEIPT,'
      '110137561=                                TIME_RECEIPT,'
      '110137562=                                G_CLIENT,'
      '110137563=                                G_PAYMENT_TYPE,'
      '110137564=                                OSNOVANIE,'
      '110137565=                                NOTE,'
      '110137566=                                SUMM,'
      '110137567=                                SUMM_FACT,'
      '110137568=                                SUMM_CURRENCY,'
      '110137569=                                IS_PAYED_ALL,'
      '110137570=                                IS_VOZVRAT,'
      '110137571=                                G_TOCHKA)'
      '110137572=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110137573=                CURRENT_DATE,'
      '110137574=                CURRENT_TIME,'
      '110137575=                :G_CLIENT_,'
      '110137576=                1,'
      '110137577=                NULL,  --:OSNOVANIE_,'
      '110137578=                NULL,  -- :NOTE_,'
      '110137579=                :SUMM_,'
      '110137580=                :SUMM_,'
      '110137581=                :SUMM_UE_,'
      
        '110137582=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110137583=                0,'
      '110137584=                :G_TOCHKA_)'
      '110137585=        RETURNING'
      '110137586=          SKLAD'
      '110137587=        INTO'
      '110137588=          :SKLAD_PARENT_;'
      '110137589='
      '110137590=        PNT_ = '#39'05'#39';'
      '110137591=        FOR SELECT SKLAD,'
      '110137592=                   G_PRODUCT,'
      '110137593=                   AMOUNT,'
      '110137594=                   PRICE,'
      '110137595=                   SUMM'
      '110137596=                   ,PRICE_CURRENCY'
      '110137597=                   ,SUMM_CURRENCY'
      '110137598=              FROM SKLAD_TMP'
      '110137599=             ORDER BY 1'
      '110137600=              INTO :SKLAD_TMP_,'
      '110137601=                   :RG_PRODUCT_,'
      '110137602=                   :RAMOUNT_,'
      '110137603=                   :RPRICE_,'
      '110137604=                   :RSUMM_'
      '110137605=                   ,:RPRICE_UE_'
      '110137606=                   ,:RSUMM_UE_'
      '110137607=        DO BEGIN'
      '110137608='
      '110137609=            UPDATE SKLAD SK'
      '110137610=               SET SK.IS_LAST = 0'
      '110137611=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110137612=               AND SK.IS_LAST = 1;'
      '110137613='
      '110137614=            INSERT INTO SKLAD'
      '110137615=            ('
      '110137616=             SKLAD,'
      '110137617=             SKLAD_PARENT,'
      '110137618=             DATE_RECEIPT,'
      '110137619=             G_CLIENT,'
      '110137620=             G_PRODUCT,'
      '110137621=             AMOUNT,'
      '110137622=             PRICE,'
      '110137623=             SUMM,'
      '110137624=             G_PAYMENT_TYPE,'
      '110137625=             OSNOVANIE,'
      '110137626=             NOTE,'
      '110137627=             NDS,'
      '110137628=             NDS_SUMM,'
      '110137629=             IS_LAST,'
      '110137630=             IS_VOZVRAT,'
      '110137631=             G_TOCHKA'
      '110137632=             ,PRICE_CURRENCY'
      '110137633=             ,SUMM_CURRENCY'
      '110137634=            ) VALUES ('
      '110137635=             :SKLAD_TMP_,'
      '110137636=             :SKLAD_PARENT_,'
      '110137637=             CURRENT_DATE,'
      '110137638=             :G_CLIENT_,'
      '110137639=             :RG_PRODUCT_,'
      '110137640=             :RAMOUNT_,'
      '110137641=             :RPRICE_,'
      '110137642=             :RSUMM_,'
      '110137643=             1,       --:G_PAYMENT_TYPE_,'
      '110137644=             NULL,    --:OSNOVANIE_,'
      '110137645=             NULL,    --:NOTE_,'
      '110137646=             0,       --:RNDS_,'
      '110137647=             0,       --:RNDS_SUMM_,'
      '110137648=             1,       --IS_LAST_'
      '110137649=             0,        --:IS_VOZVRAT_'
      '110137650=             :G_TOCHKA_'
      '110137651=             ,:RPRICE_UE_'
      '110137652=             ,:RSUMM_UE_'
      '110137653=            );'
      '110137654='
      
        '110137655=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110137656=            PNT_ = '#39'06'#39';'
      '110137657=            UPDATE LT_SKLAD_PRODUCT L'
      '110137658=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110137659=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110137660=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110137661='
      '110137662=            PNT_ = '#39'06a'#39';'
      '110137663=            IF (ROW_COUNT = 0) THEN'
      
        '110137664=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110137665=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110137666=        END'
      '110137667='
      '110137668=        PNT_ = '#39'07'#39';'
      
        '110137669=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110137670=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110137671=                                :SUMM_,'
      '110137672=                                CURRENT_DATE,'
      
        '110137673=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110137674=                                NULL,   --ZAKAZ_'
      '110137675=                                :SKLAD_PARENT_,'
      '110137676=                                1,'
      
        '110137677=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110137678=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110137679=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110137680=          EXIT;'
      '110137681=        END'
      '110137682='
      '110137683=        DELETE FROM SKLAD_TMP;'
      '110137684=      END'
      '110137685=    END'
      '110137686='
      
        '110137687=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110137688=    if (ERR_MSG_ IS NOT NULL) then'
      '110137689=      ERR_MSG = ERR_MSG_;'
      '110137690='
      '110137691=WHEN ANY DO BEGIN'
      '110137692=    Err_code = gdscode;'
      
        '110137693=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110137694=  END'
      '110137695=END'
      '110137696=;'
      '110137697='
      '110137698=ALTER PROCEDURE INS_SKLAD_TMP('
      '110137699=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110137700=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110137701=  PRICE_ NUMERIC(15,2),'
      '110137702=  SUMM_ NUMERIC(15,2),'
      '110137703=  NDS_ NUMERIC(15,2),'
      '110137704=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110137705=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110137706=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0,'
      
        '110137707=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC = 0,'
      '110137708=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0,'
      
        '110137709=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC = 0,'
      '110137710=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0,'
      
        '110137711=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE = 0)'
      '110137712=RETURNS ('
      '110137713=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110137714=  ERR_CODE INTEGER,'
      '110137715=  ERR_MSG VARCHAR(1024))'
      '110137716=AS'
      
        '110137717=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110137718=BEGIN'
      '110137719=  SELECT T.SKLAD'
      '110137720=    FROM SKLAD_TMP T'
      '110137721=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110137722=     AND T.PRICE = :PRICE_'
      '110137723=    INTO :SKLAD_;'
      '110137724='
      '110137725=  IF (SKLAD_ IS NOT NULL) THEN'
      '110137726=    UPDATE SKLAD_TMP T'
      '110137727=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110137728=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110137729=     WHERE T.SKLAD = :SKLAD_;'
      '110137730='
      '110137731=  ELSE BEGIN'
      '110137732=      IF (PRICE_ = 0) THEN BEGIN'
      '110137733=        CHARGE_ROZN_PROC_ = 0;'
      '110137734=        CHARGE_OPT_PROC_ = 0;'
      '110137735=      END ELSE BEGIN'
      
        '110137736=        CHARGE_ROZN_PROC_ = ROUND((:PRICE_ROZN_ - :PRI' +
        'CE_) * 100 / :PRICE_, 2);'
      
        '110137737=        CHARGE_OPT_PROC_ = ROUND((:PRICE_OPT_ - :PRICE' +
        '_) * 100 / :PRICE_, 2);'
      '110137738=      END'
      '110137739='
      
        '110137740=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '110137741=                            CHARGE_ROZN_PROC,'
      '110137742=                            PRICE_ROZN,'
      '110137743=                            CHARGE_OPT_PROC,'
      
        '110137744=                            PRICE_OPT, CHANGE_SALE_PRI' +
        'CE)'
      
        '110137745=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110137746=        ,:PRICE_CURRENCY_'
      '110137747=        ,:SUMM_CURRENCY_'
      '110137748=        ,:CHARGE_ROZN_PROC_'
      '110137749=        ,:PRICE_ROZN_'
      '110137750=        ,:CHARGE_OPT_PROC_'
      '110137751=        ,:PRICE_OPT_'
      '110137752=        ,:CHANGE_SALE_PRICE_)'
      '110137753=      RETURNING SKLAD'
      '110137754=      INTO :SKLAD_;'
      '110137755=  END'
      '110137756=end'
      '110137757=;'
      '110137758='
      '110137759=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '110137760=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110137761=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110137762=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT =' +
        ' 0,'
      
        '110137763=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE = 0)'
      '110137764=RETURNS ('
      '110137765=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110137766=  ERR_CODE INTEGER,'
      '110137767=  ERR_MSG VARCHAR(1024))'
      '110137768=AS'
      '110137769=/*'
      '110137770='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '110137771=*/'
      
        '110137772=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110137773=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110137774=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '110137775=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110137776=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '110137777=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT.' +
        'PRICE;'
      
        '110137778=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      '110137779=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110137780=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110137781=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110137782=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110137783=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      '110137784=BEGIN'
      '110137785='
      '110137786=  PNT_ = '#39'01'#39';'
      
        '110137787=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCOD' +
        'E_, NULL, NULL, NULL, NULL)'
      
        '110137788=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGOR' +
        'Y_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :ERR_CODE,' +
        ' :ERR_MSG;'
      '110137789='
      '110137790=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110137791=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110137792=    EXIT;'
      '110137793=  END'
      '110137794='
      '110137795=  PNT_ = '#39'02'#39';'
      '110137796=  IF (IS_VOZVRAT_ = 0) THEN BEGIN'
      
        '110137797=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, :G_TOCHKA_, 0)'
      '110137798=          RETURNING_VALUES :PRICE_;'
      '110137799='
      '110137800=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110137801=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110137802=        EXIT;'
      '110137803=      END'
      '110137804=  END ELSE'
      '110137805=    PRICE_ = SALE_PRICE_;'
      '110137806='
      '110137807=  AMOUNT_ = 1;'
      '110137808='
      '110137809=  SELECT T.SKLAD'
      '110137810=    FROM SKLAD_TMP T'
      '110137811=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110137812=     AND T.PRICE = :PRICE_'
      '110137813=    INTO :SKLAD_;'
      '110137814='
      '110137815=  IF (SKLAD_ IS NOT NULL) THEN'
      '110137816=    UPDATE SKLAD_TMP T'
      '110137817=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110137818=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110137819=     WHERE T.SKLAD = :SKLAD_;'
      '110137820='
      '110137821=  ELSE'
      
        '110137822=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PRI' +
        'CE_OPT, CHANGE_SALE_PRICE)'
      
        '110137823=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_,'
      
        '110137824=             DECODE(:PRICE_, 0, 0, ROUND((:SALE_PRICE_' +
        '/:PRICE_ - 1)*100, 2)),'
      '110137825=             :SALE_PRICE_,'
      
        '110137826=             DECODE(:PRICE_, 0, 0, ROUND((:VOLUME_PRIC' +
        'E_/:PRICE_ - 1)*100, 2)),'
      '110137827=             :VOLUME_PRICE_,'
      '110137828=             :CHANGE_SALE_PRICE_)'
      '110137829=      RETURNING SKLAD'
      '110137830=      INTO :SKLAD_;'
      '110137831=end'
      '110137832=;'
      '110137833='
      '110137834=ALTER PROCEDURE LOG_INIT'
      '110137835=AS'
      '110137836=DECLARE VARIABLE TN VARCHAR(64);'
      '110137837=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110137838=DECLARE VARIABLE FN VARCHAR(64);'
      '110137839=DECLARE VARIABLE TP INTEGER;'
      
        '110137840=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110137841=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110137842=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110137843=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110137844=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110137845=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110137846=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110137847=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000) */'
      '110137848=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110137849=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110137850=DECLARE VARIABLE ANZ INTEGER;'
      '110137851=DECLARE VARIABLE L INTEGER;'
      '110137852=DECLARE VARIABLE P INTEGER;'
      '110137853=DECLARE VARIABLE S INTEGER;'
      '110137854=DECLARE VARIABLE FT CHAR(1);'
      '110137855=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110137856=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110137857=BEGIN'
      '110137858=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110137859='
      '110137860=  TN_ALT='#39#39';'
      '110137861=  TRGI='#39#39';'
      '110137862=  TRGU='#39#39';'
      '110137863=  TRGD='#39#39';'
      '110137864=  TRGIX='#39#39';'
      '110137865=  TRGUX='#39#39';'
      '110137866=  TRGDX='#39#39';'
      '110137867=  SQLF='#39#39';'
      '110137868=  SQLV='#39#39';'
      '110137869=  SQLU='#39#39';'
      '110137870=  FT='#39#39';'
      '110137871='
      '110137872=  FOR SELECT R.RDB$RELATION_NAME,'
      '110137873=            R.RDB$FIELD_NAME,'
      '110137874=            F.RDB$FIELD_TYPE,'
      '110137875=            F.RDB$FIELD_LENGTH,'
      '110137876=            F.RDB$FIELD_PRECISION,'
      '110137877=            F.RDB$FIELD_SCALE'
      '110137878=        FROM RDB$RELATION_FIELDS R,'
      '110137879=             RDB$FIELDS F'
      '110137880=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110137881=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110137882=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110137883=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110137884=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110137885=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110137886=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110137887=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110137888=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110137889=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110137890=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39')'
      '110137891=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110137892=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110137893=              OR'
      
        '110137894=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110137895=             )'
      
        '110137896=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110137897=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110137898=  DO BEGIN'
      '110137899=    TN=TRIM(TN);'
      '110137900=    FN=TRIM(FN);'
      '110137901=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110137902=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110137903=      EXECUTE STATEMENT TRGI;'
      '110137904=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110137905=      EXECUTE STATEMENT TRGU;'
      '110137906=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110137907=      EXECUTE STATEMENT TRGD;'
      '110137908='
      '110137909=      SQLF='#39#39';'
      '110137910=      SQLV='#39#39';'
      '110137911=      SQLU='#39#39';'
      '110137912=    END'
      '110137913=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110137914=      ID_COLUMN = FN;'
      '110137915='
      '110137916=    S=-S;'
      
        '110137917=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110137918=      ft='#39'N'#39';   --numerisch'
      '110137919=    else'
      '110137920=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110137921=        ft='#39'Z'#39';   --zeit'
      '110137922=      else'
      '110137923=        ft='#39'T'#39';'
      '110137924='
      '110137925=    IF (SQLF='#39#39') THEN'
      '110137926=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110137927=    ELSE'
      '110137928=      SQLF=SQLF||'#39','#39'||FN;'
      '110137929='
      '110137930=    if (ft='#39'N'#39') then begin'
      '110137931=      IF (SQLV='#39#39') THEN'
      
        '110137932=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110137933=      ELSE'
      
        '110137934=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110137935='
      '110137936=      IF (SQLU='#39#39') THEN'
      
        '110137937=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110137938=      ELSE'
      
        '110137939=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110137940=    end'
      '110137941=    else'
      '110137942=      if (ft='#39'Z'#39') then begin'
      '110137943=        IF (SQLV='#39#39') THEN'
      
        '110137944=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||re' +
        'place(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        '),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110137945=        ELSE'
      
        '110137946=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||re' +
        'place(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        '),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110137947='
      '110137948=        IF (SQLU='#39#39') THEN'
      
        '110137949=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'U' +
        'PDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM' +
        '(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39 +
        ')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110137950=        ELSE'
      
        '110137951=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39 +
        '||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39 +
        #39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110137952=    end'
      '110137953=    else begin'
      '110137954=      IF (SQLV='#39#39') THEN'
      
        '110137955=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||repl' +
        'ace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRL' +
        'F;'
      '110137956=      ELSE'
      
        '110137957=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||repl' +
        'ace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRL' +
        'F;'
      '110137958='
      '110137959=      IF (SQLU='#39#39') THEN'
      
        '110137960=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
