      '11096387=                END'
      '11096388='
      
        '11096389=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';' +
        '   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '11096390=            END'
      '11096391='
      
        '11096392=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' ' +
        #1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '11096393=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '11096394=                FROM KASSA K'
      '11096395=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '11096396=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.' +
        'KASSA||'#39'~'#39
      '11096397=                UNION'
      '11096398=                SELECT KASSA, 1 PAYMENT_TYPE'
      '11096399=                  FROM KASSA K'
      '11096400=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '11096401=                   AND K.SUMM = 0'
      '11096402=                UNION'
      
        '11096403=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TY' +
        'PE'
      '11096404=                FROM KASSA_BEZNAL K'
      '11096405=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '11096406=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.' +
        'KASSA_BEZNAL||'#39'~'#39
      '11096407=                UNION'
      
        '11096408=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TY' +
        'PE'
      '11096409=                FROM KASSA_BEZNAL K'
      '11096410=                WHERE K.ZAKAZ = :ZAKAZ_'
      '11096411=                 AND K.SUMM = 0'
      '11096412=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '11096413=            DO BEGIN'
      '11096414=                PNT_ = '#39'08'#39';'
      
        '11096415=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, ' +
        ':PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11096416=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11096417=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
