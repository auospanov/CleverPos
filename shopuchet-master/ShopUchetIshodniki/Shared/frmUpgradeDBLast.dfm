      '1102391247='
      '1102391248=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '1102391249=    UPDATE LOGS L'
      
        '1102391250=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
