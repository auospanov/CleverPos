      '11015894=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '11015895=              AND T.IS_ACTIVE = 1'
      '11015896=              AND D.BARCODE = :BARCODE_'
      '11015897=            INTO'
      '11015898=                :G_PRODUCT_CATEGORY_,'
      '11015899=                :G_PRODUCT_,'
      '110158100=                :PRICE_,'
      '110158101=                :VOLUME_PRICE_,'
      '110158102=                :IS_KIT_,'
      '110158103=                :IS_MARKED_;'
      '110158104='
      '110158105=      IF (ROW_COUNT = 0) THEN BEGIN'
      '110158106=          ERR_CODE = -20500;'
      
        '110158107=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110158108=          ERR_MSG = PROCNAME||ERR_MSG;'
