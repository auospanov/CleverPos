      '110248284=                 O.OP_DATE DATE_SORT,'
      '110248285=                 O.OP_DATE DATE_ACT,'
      '110248286=                 '#39#1056#1072#1089#1093#1086#1076' '#1087#1088#1080' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072#39','
      '110248287=                 NULL,'
