      '110228442=        IF (COALESCE(G_PRODUCT_, 0) <> 0) THEN BEGIN'
      '110228443=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110228444=              IF (BARCODE_IS_MAIN_ = 0) THEN BEGIN'
      '110228445=                  UPDATE G_PRODUCT G'
