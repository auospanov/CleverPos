        '.NAME;'
      
        '110189166=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110189167=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110189168=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110189169=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110189170=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110189171=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110189172=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110189173=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110189174=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110189175=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110189176=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110189177=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110189178=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110189179=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110189180=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110189181=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110189182=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110189183=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110189184=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110189185=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110189186=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110189187=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110189188=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110189189=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110189190=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110189191=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110189192=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110189193=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110189194=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110189195=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110189196=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110189197=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110189198=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110189199=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110189200=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110189201=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '110189202=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM_FACT;'
      
        '110189203=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN S' +
        'KLAD_PARENT.SUMM_FACT;'
      '110189204=BEGIN'
      
        '110189205=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110189206=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110189207='
      '110189208=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110189209=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110189210=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110189211='
      '110189212=  FOR SELECT GP.PATH,'
      '110189213=             GP.G_PRODUCT'
      '110189214=       FROM P_REP_TREE GP'
      '110189215=      WHERE EXISTS (SELECT 1'
      
        '110189216=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110189217=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110189218=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110189219=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110189220=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110189221=                       AND Z.IS_SPISANIE = 0'
      '110189222=                       AND Z.is_reserve = 0'
      '110189223=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110189224=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110189225=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110189226=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110189227=                       AND ((EXISTS (SELECT 1'
      
        '110189228=                                       FROM SKLAD S, G' +
        '_PRODUCT G'
      
        '110189229=                                      WHERE S.G_CLIENT' +
        ' = :G_SUPPLIER_'
      
        '110189230=                                        AND S.G_PRODUC' +
        'T = G.G_PRODUCT'
      
        '110189231=                                        AND G.G_PRODUC' +
        'T_PAR = GP.G_PRODUCT'
      
        '110189232=                                        AND :G_TOCHKA_' +
        'ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_,' +
        ' 0) <> 0)'
      '110189233=                              OR'
      
        '110189234=                              COALESCE(:G_SUPPLIER_, 0' +
        ') = 0)'
      '110189235=                       )'
      '110189236=      ORDER BY 1, 2'
      '110189237=  INTO :RECCAT_NAME_,'
      '110189238=       :RECCAT_PRODUCT_'
      '110189239=  DO BEGIN'
      '110189240=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189241=    insert into p_rep_profit_table'
      '110189242=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110189243=    values'
      
        '110189244=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110189245='
      '110189246=    FOR SELECT Z.ZAKAZ,'
      '110189247=               Z.G_TOCHKA,'
      '110189248=               Z.Z_DATE,'
      '110189249=               Z.G_CLIENT,'
      '110189250=               C.NAME CLIENT_NAME,'
      '110189251=               Z.G_PAYMENT_TYPE,'
      '110189252=               P.NAME PAYMENT_NAME,'
      '110189253=               Z.OSNOVANIE,'
      '110189254=               G.G_PRODUCT,'
      '110189255=               G.G_PRODUCT_PAR,'
      '110189256=               G.NAME TOVAR_NAME,'
      '110189257=               ZD.AMOUNT,'
      '110189258=               ZD.PRICE,'
      '110189259=               ZD.SUMM,'
      '110189260=               ZD.DISCOUNT_PERC,'
      '110189261=               ZD.DISCOUNT_SUMM,'
      '110189262=               ZD.NDS,'
      '110189263=               ZD.NDS_SUMM,'
      '110189264=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110189265=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110189266=               ZAKAZ_DETAILS ZD,'
      '110189267=               G_PRODUCT G,'
      '110189268=               G_PAYMENT_TYPE P'
      
        '110189269=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110189270=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110189271=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110189272=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110189273=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110189274=           AND Z.IS_SPISANIE = 0                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '110189275=           AND Z.IS_RESERVE = 0                    -- ' +
        #1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '110189276=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110189277=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110189278=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110189279=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110189280=           AND ((EXISTS (SELECT 1'
      '110189281=                       FROM SKLAD S'
      '110189282=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110189283=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110189284=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110189285=              OR'
      '110189286=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110189287=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110189288=    INTO :REC_ZAKAZ_,'
      '110189289=        :REC_G_TOCHKA_,'
      '110189290=        :REC_Z_DATE_,'
      '110189291=        :REC_G_CLIENT_,'
      '110189292=        :REC_CLIENT_NAME_,'
      '110189293=        :REC_G_PAYMENT_TYPE_,'
      '110189294=        :REC_PAYMENT_NAME_,'
      '110189295=        :REC_OSNOVANIE_,'
      '110189296=        :REC_G_PRODUCT_,'
      '110189297=        :REC_G_PRODUCT_PAR_,'
      '110189298=        :REC_TOVAR_NAME_,'
      '110189299=        :REC_AMOUNT_,'
      '110189300=        :REC_PRICE_,'
      '110189301=        :REC_SUMM_,'
      '110189302=        :REC_DISCOUNT_PERC_,'
      '110189303=        :REC_DISCOUNT_SUMM_,'
      '110189304=        :REC_NDS_,'
      '110189305=        :REC_NDS_SUMM_,'
      '110189306=        :REC_PRICE_SELF_'
      '110189307=    DO BEGIN'
      '110189308=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110189309=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110189310='
      '110189311=      insert into p_rep_profit_table'
      
        '110189312=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110189313=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110189314=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110189315=      values'
      '110189316=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110189317=        :REC_ZAKAZ_,'
      '110189318=        :REC_g_tochka_,'
      
        '110189319=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110189320=         :REC_osnovanie_,'
      '110189321=         :REC_g_product_,'
      '110189322=         :REC_g_product_par_,'
      '110189323=         :REC_tovar_name_,'
      '110189324=         :REC_amount_,'
      '110189325=         :REC_price_,'
      '110189326=         :REC_summ_,'
      '110189327=         :REC_discount_perc_,'
      '110189328=         :REC_discount_summ_,'
      
        '110189329=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110189330='
      
        '110189331=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110189332=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110189333=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110189334=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110189335=    END'
      '110189336='
      '110189337=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189338=    insert into p_rep_profit_table'
      
        '110189339=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110189340=    values'
      
        '110189341=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110189342='
      '110189343=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110189344=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110189345=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110189346=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110189347='
      '110189348=    SUM_ZAKAZ_ = 0;'
      '110189349=    SUM_COST_  = 0;'
      '110189350=    NDS_SUMM_  = 0;'
      '110189351=    PROFIT_    = 0;'
      '110189352=  END'
      '110189353='
      '110189354=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110189355=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110189356=      insert into p_rep_profit_table'
      
        '110189357=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110189358=      values'
      
        '110189359=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110189360='
      
        '110189361=  --**************************************************' +
        '***************************************'
      '110189362=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110189363=  ----------------------------------------------------' +
        '---'
      '110189364=  SELECT COUNT(*)'
      
        '110189365=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110189366=          UNION ALL'
      
        '110189367=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110189368=         G_PRIHOD_RASHOD G'
      
        '110189369=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110189370=    AND K.ACTION = 1'
      
        '110189371=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110189372=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110189373=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053#1045 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110189374=  INTO :CNT_;'
      '110189375='
      '110189376=  IF (CNT_ > 0) THEN BEGIN'
      '110189377=    SUM_COST_  = 0;'
      '110189378=    PROFIT_    = 0;'
      '110189379='
      '110189380=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189381=    INSERT INTO P_REP_PROFIT_TABLE'
      '110189382=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110189383=    VALUES'
      
        '110189384=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', 1' +
        ');'
      '110189385='
      '110189386=    FOR SELECT K.ACTION_DATE,'
      '110189387=               K.SUMM,'
      
        '110189388=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, '#39 +
        ' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '110189389=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '110189390=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39
      '110189391=              UNION ALL'
      
        '110189392=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, ' +
        'SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM kas' +
        'sa_beznal'
      
        '110189393=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39') k,'
      '110189394=              G_PRIHOD_RASHOD G'
      '110189395=        WHERE K.ACTION = 1'
      
        '110189396=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110189397=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110189398=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)   ' +
        ' -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110189399=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110189400=    INTO :ACTION_DATE_,'
      '110189401=         :SUMM_,'
      '110189402=         :ACTION_NAME_'
      '110189403=    DO BEGIN'
      '110189404=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110189405=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110189406=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110189407=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110189408=        VALUES'
      
        '110189409=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, 0,'
      
        '110189410=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALES' +
        'CE(:SUMM_, 0), 0);'
      '110189411='
      '110189412=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110189413=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110189414=    END'
      '110189415='
      '110189416=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110189417=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110189418=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110189419=    insert into p_rep_profit_table'
      
        '110189420=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110189421=    values'
      
        '110189422=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110189423=  END'
      '110189424=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '110189425=  --**************************************************' +
        '***************************************'
      '110189426='
      
        '110189427=  --**************************************************' +
        '***************************************'
      '110189428=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '110189429=  ----------------------------------------------------' +
        '---'
      '110189430=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189431=  SELECT COUNT(*)'
      
        '110189432=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110189433=          UNION ALL'
      
        '110189434=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110189435=         G_PRIHOD_RASHOD G'
      
        '110189436=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110189437=    AND K.ACTION = 0'
      
        '110189438=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110189439=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110189440=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056#1045 +
        #1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110189441=  INTO :CNT_;'
      '110189442='
      '110189443=  IF (CNT_ > 0) THEN BEGIN'
      '110189444=    PRIHOD_ALL_  = 0;'
      '110189445=    PRIHOD_ALL_NAL_  = 0;'
      '110189446=    PRIHOD_ALL_BEZNAL_  = 0;'
      '110189447=    PROFIT_     = 0;'
      '110189448='
      '110189449=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189450=    INSERT INTO P_REP_PROFIT_TABLE'
      '110189451=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110189452=    VALUES'
      
        '110189453=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', 1' +
        ');'
      '110189454='
      '110189455=    FOR SELECT K.ACTION_DATE,'
      '110189456=               K.NAL,'
      '110189457=               K.BEZNAL,'
      '110189458=               G.NAME'
      
        '110189459=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 ' +
        'BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110189460=               UNION ALL'
      
        '110189461=               SELECT kassa_BEZNAL KASSA, ACTION_DATE,' +
        ' 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kass' +
        'a_beznal) K,'
      '110189462=              G_PRIHOD_RASHOD G'
      
        '110189463=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '110189464=          AND K.ACTION = 0'
      
        '110189465=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110189466=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110189467=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110189468=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110189469=    INTO :ACTION_DATE_,'
      '110189470=         :SUMM_NAL_,'
      '110189471=         :SUMM_BEZNAL_,'
      '110189472=         :ACTION_NAME_'
      '110189473=    DO BEGIN'
      '110189474=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110189475=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110189476=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110189477=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110189478=        VALUES'
      
        '110189479=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '110189480=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '110189481='
      '110189482=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110189483=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM' +
        '_BEZNAL_;'
      
        '110189484=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_B' +
        'EZNAL_;'
      
        '110189485=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZ' +
        'NAL_;'
      '110189486=    END'
      '110189487='
      '110189488=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110189489=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110189490=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '110189491=    insert into p_rep_profit_table'
      
        '110189492=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110189493=    values'
      
        '110189494=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110189495=  END'
      '110189496='
      '110189497=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '110189498=  --**************************************************' +
        '***************************************'
      '110189499='
      
        '110189500=  --**************************************************' +
        '***************************************'
      '110189501=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110189502=  --**************************************************' +
        '***************************************'
      '110189503=  SELECT COUNT(*)'
      '110189504=    FROM ZAKAZ Z'
      
        '110189505=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110189506=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110189507=     AND Z.IS_SPISANIE = 1'
      
        '110189508=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110189509=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110189510=  INTO :CNT_;'
      '110189511='
      '110189512=  IF (CNT_ > 0) THEN BEGIN'
      '110189513=      SUM_ZAKAZ_ = 0;'
      '110189514=      SUM_COST_  = 0;'
      '110189515=      PROFIT_    = 0;'
      '110189516='
      '110189517=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189518=      insert into p_rep_profit_table'
      '110189519=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110189520=      values'
      
        '110189521=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39', 1);'
      '110189522='
      '110189523=      FOR SELECT Z.ZAKAZ,'
      '110189524=                 Z.G_TOCHKA,'
      '110189525=                 Z.Z_DATE,'
      '110189526=                 Z.G_CLIENT,'
      '110189527=                 '#39#39' CLIENT_NAME,'
      '110189528=                 Z.G_PAYMENT_TYPE,'
      '110189529=                 '#39#39' PAYMENT_NAME,'
      '110189530=                 Z.OSNOVANIE,'
      '110189531=                 G.G_PRODUCT,'
      '110189532=                 G.G_PRODUCT_PAR,'
      '110189533=                 G.NAME TOVAR_NAME,'
      '110189534=                 ZD.AMOUNT,'
      '110189535=                 ZD.PRICE,'
      '110189536=                 ZD.SUMM,'
      '110189537=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '110189538=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '110189539=                 0 NDS, --ZD.NDS,'
      '110189540=                 0 NDS_SUMM'
      
        '110189541=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT ' +
        'G'
      
        '110189542=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TO' +
        'CHKA||'#39'-'#39
      '110189543=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110189544=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110189545=             AND Z.IS_SPISANIE = 1                    ' +
        '-- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '110189546=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110189547=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '110189548=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G' +
        '_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059 +
        #1057#1058#1067#1052
      
        '110189549=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALE' +
        'SCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110189550=             AND ((EXISTS (SELECT 1'
      '110189551=                           FROM SKLAD S'
      
        '110189552=                          WHERE S.G_CLIENT = :G_SUPPLI' +
        'ER_'
      
        '110189553=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110189554=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110189555=                  OR'
      '110189556=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110189557=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS'
      '110189558=      INTO :REC_ZAKAZ_,'
      '110189559=            :REC_G_TOCHKA_,'
      '110189560=            :REC_Z_DATE_,'
      '110189561=            :REC_G_CLIENT_,'
      '110189562=            :REC_CLIENT_NAME_,'
      '110189563=            :REC_G_PAYMENT_TYPE_,'
      '110189564=            :REC_PAYMENT_NAME_,'
      '110189565=            :REC_OSNOVANIE_,'
      '110189566=            :REC_G_PRODUCT_,'
      '110189567=            :REC_G_PRODUCT_PAR_,'
      '110189568=            :REC_TOVAR_NAME_,'
      '110189569=            :REC_AMOUNT_,'
      '110189570=            :REC_PRICE_,'
      '110189571=            :REC_SUMM_,'
      '110189572=            :REC_DISCOUNT_PERC_,'
      '110189573=            :REC_DISCOUNT_SUMM_,'
      '110189574=            :REC_NDS_,'
      '110189575=            :REC_NDS_SUMM_'
      '110189576=      DO BEGIN'
      '110189577=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110189578=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067 +
        ' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '110189579=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '110189580=        REC_profit_   = -REC_SUMM_;'
      '110189581='
      '110189582=        insert into p_rep_profit_table'
      
        '110189583=          (p_rep_profit_table, zakaz, g_tochka, z_date' +
        ', g_client, client_name, g_payment_type, payment_name,'
      
        '110189584=           osnovanie, g_product, g_product_par, tovar_' +
        'name, amount, price, summ, discount_perc, discount_summ,'
      
        '110189585=           nds, nds_summ, price_self, sum_self, profit' +
        ', is_head)'
      '110189586=        values'
      
        '110189587=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAK' +
        'AZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '110189588=         :REC_osnovanie_, :REC_g_product_, :REC_g_prod' +
        'uct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_pe' +
        'rc_, :REC_discount_summ_,'
      
        '110189589=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_' +
        'SUM_COST_, :REC_profit_, 0);'
      '110189590='
      
        '110189591=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST' +
        '_, 0);'
      
        '110189592=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, ' +
        '0);'
      '110189593=      END'
      '110189594='
      '110189595=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189596=      insert into p_rep_profit_table'
      
        '110189597=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110189598=      values'
      
        '110189599=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0' +
        ', :SUM_COST_, 0, :PROFIT_, 2);'
      '110189600='
      '110189601=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110189602=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110189603=  END'
      '110189604=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110189605=  --**************************************************' +
        '***************************************'
      '110189606='
      
        '110189607=  --**************************************************' +
        '***************************************'
      '110189608=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110189609=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048#1045 +
        #1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '110189610=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053#1054 +
        '", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '110189611=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' '#1055 +
        #1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '110189612='
      
        '110189613=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '110189614=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 45' +
        '00'
      
        '110189615=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056#1048 +
        #1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057#1054 +
        #1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '110189616=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070#1047 +
        #1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054' ' +
        #1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '110189617='
      
        '110189618=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059#1063 +
        #1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '110189619=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058'.' +
        ' - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '110189620=  --**************************************************' +
        '***************************************'
      '110189621=  SELECT COUNT(*)'
      '110189622=    FROM SKLAD S'
      
        '110189623=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      
        '110189624=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110189625=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110189626=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110189627=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110189628=     AND ((EXISTS (SELECT 1'
      '110189629=                   FROM SKLAD SS'
      '110189630=                  WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '110189631=                    AND SS.G_PRODUCT = S.G_PRODUCT'
      
        '110189632=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110189633=          OR'
      '110189634=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110189635=  INTO :CNT_;'
      '110189636='
      '110189637=  IF (CNT_ > 0) THEN BEGIN'
      '110189638=    SUM_ZAKAZ_ = 0;'
      '110189639=    PROFIT_    = 0;'
      '110189640=    SUM_COST_  = 0;'
      '110189641='
      '110189642=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189643=    insert into p_rep_profit_table'
      '110189644=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110189645=    values'
      
        '110189646=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39', 1);'
      '110189647='
      '110189648=    FOR SELECT S.DATE_RECEIPT,'
      '110189649=               S.G_PRODUCT,'
      '110189650=               G.NAME TOVAR_NAME,'
      '110189651=               S.AMOUNT,'
      '110189652=               S.PRICE,'
      '110189653=               S.SUMM,'
      '110189654=               SP.G_TOCHKA'
      '110189655=         FROM SKLAD_PARENT SP,'
      '110189656=              SKLAD S,'
      '110189657=              G_PRODUCT G'
      
        '110189658=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCH' +
        'KA||'#39'-'#39
      
        '110189659=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110189660=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110189661=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110189662=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110189663=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110189664=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110189665=          AND ((EXISTS (SELECT 1'
      '110189666=                           FROM SKLAD SS'
      
        '110189667=                          WHERE SS.G_CLIENT = :G_SUPPL' +
        'IER_'
      
        '110189668=                            AND SS.G_PRODUCT = S.G_PRO' +
        'DUCT'
      
        '110189669=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110189670=                  OR'
      '110189671=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110189672=        ORDER BY 1'
      '110189673=    INTO :V_DATE_RECEIPT_,'
      '110189674=         :V_G_PRODUCT_,'
      '110189675=         :V_TOVAR_NAME_,'
      '110189676=         :V_AMOUNT_,'
      '110189677=         :V_PRICE_,'
      '110189678=         :V_SUMM_,'
      '110189679=         :REC_G_TOCHKA_'
      '110189680=    DO BEGIN'
      '110189681=      --REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110189682=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;   ' +
        ' -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044 +
        #1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059 +
        #1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '110189683='
      '110189684='
      '110189685=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110189686=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110189687=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110189688=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, s' +
        'um_self)'
      '110189689=      VALUES'
      
        '110189690=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, -:' +
        'V_SUMM_,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045 +
        ' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047 +
        #1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '110189691=         0, 0, 0, 0, :REC_profit_, 0, 0, 0);'
      '110189692='
      
        '110189693=      --SUM_COST_  = SUM_COST_  + COALESCE(REC_SUM_COS' +
        'T_, 0);     -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '110189694=      SUM_COST_ = 0;'
      '110189695=      SUM_ZAKAZ_ = SUM_ZAKAZ_ - COALESCE(V_SUMM_, 0);'
      '110189696=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110189697=    END'
      '110189698='
      '110189699='
      
        '110189700=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_; --SU' +
        'M_COST_;'
      '110189701=    --SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '110189702=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110189703='
      '110189704=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189705=    insert into p_rep_profit_table'
      
        '110189706=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110189707=    values'
      
        '110189708=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, 0, 0, :PROFIT_, 2);'
      '110189709=  END'
      '110189710=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110189711=  --**************************************************' +
        '***************************************'
      '110189712='
      
        '110189713=  --**************************************************' +
        '***************************************'
      
        '110189714=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045#1051 +
        #1054' '#1052#1045#1057#1058#1054
      '110189715=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '110189716=  --**************************************************' +
        '***************************************'
      '110189717=  /*SELECT COUNT(*)'
      '110189718=    FROM ZAKAZ Z'
      
        '110189719=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110189720=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110189721=     AND Z.IS_SPISANIE = 4'
      
        '110189722=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110189723=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110189724=  INTO :CNT_;'
      '110189725='
      '110189726=  IF (CNT_ > 0) THEN BEGIN'
      '110189727=      SUM_ZAKAZ_ = 0;'
      '110189728=      SUM_COST_  = 0;'
      '110189729=      PROFIT_    = 0;'
      '110189730=      NDS_SUMM_  = 0;'
      '110189731='
      '110189732=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189733=      insert into p_rep_profit_table'
      '110189734=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110189735=      values'
      
        '110189736=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058 +
        #1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '110189737='
      '110189738=      FOR SELECT Z.ZAKAZ,'
      '110189739=               Z.G_TOCHKA,'
      '110189740=               Z.Z_DATE,'
      '110189741=               Z.G_CLIENT,'
      '110189742=               C.NAME CLIENT_NAME,'
      '110189743=               Z.G_PAYMENT_TYPE,'
      '110189744=               P.NAME PAYMENT_NAME,'
      '110189745=               Z.OSNOVANIE,'
      '110189746=               G.G_PRODUCT,'
      '110189747=               G.G_PRODUCT_PAR,'
      '110189748=               G.NAME TOVAR_NAME,'
      '110189749=               ZD.AMOUNT,'
      '110189750=               ZD.PRICE,'
      '110189751=               ZD.SUMM,'
      '110189752=               ZD.DISCOUNT_PERC,'
      '110189753=               ZD.DISCOUNT_SUMM,'
      '110189754=               ZD.NDS,'
      '110189755=               ZD.NDS_SUMM,'
      '110189756=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110189757=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110189758=               ZAKAZ_DETAILS ZD,'
      '110189759=               G_PRODUCT G,'
      '110189760=               G_PAYMENT_TYPE P'
      
        '110189761=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110189762=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110189763=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110189764=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110189765=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110189766=           AND Z.IS_SPISANIE = 4                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110189767=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110189768=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110189769=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110189770=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110189771=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110189772=    INTO :REC_ZAKAZ_,'
      '110189773=        :REC_G_TOCHKA_,'
      '110189774=        :REC_Z_DATE_,'
      '110189775=        :REC_G_CLIENT_,'
      '110189776=        :REC_CLIENT_NAME_,'
      '110189777=        :REC_G_PAYMENT_TYPE_,'
      '110189778=        :REC_PAYMENT_NAME_,'
      '110189779=        :REC_OSNOVANIE_,'
      '110189780=        :REC_G_PRODUCT_,'
      '110189781=        :REC_G_PRODUCT_PAR_,'
      '110189782=        :REC_TOVAR_NAME_,'
      '110189783=        :REC_AMOUNT_,'
      '110189784=        :REC_PRICE_,'
      '110189785=        :REC_SUMM_,'
      '110189786=        :REC_DISCOUNT_PERC_,'
      '110189787=        :REC_DISCOUNT_SUMM_,'
      '110189788=        :REC_NDS_,'
      '110189789=        :REC_NDS_SUMM_,'
      '110189790=        :REC_PRICE_SELF_'
      '110189791=    DO BEGIN'
      '110189792=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '110189793=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '110189794='
      '110189795=      insert into p_rep_profit_table'
      
        '110189796=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110189797=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110189798=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110189799=      values'
      '110189800=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110189801=        :REC_ZAKAZ_,'
      '110189802=        :REC_g_tochka_,'
      
        '110189803=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110189804=         :REC_osnovanie_,'
      '110189805=         :REC_g_product_,'
      '110189806=         :REC_g_product_par_,'
      '110189807=         :REC_tovar_name_,'
      '110189808=         :REC_amount_,'
      '110189809=         :REC_price_,'
      '110189810=         :REC_summ_,'
      '110189811=         :REC_discount_perc_,'
      '110189812=         :REC_discount_summ_,'
      
        '110189813=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110189814='
      
        '110189815=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110189816=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110189817=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110189818=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110189819=    END'
      '110189820='
      '110189821=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189822=    insert into p_rep_profit_table'
      
        '110189823=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110189824=    values'
      
        '110189825=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110189826='
      '110189827=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110189828=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '110189829=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110189830=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110189831='
      '110189832=    SUM_ZAKAZ_ = 0;'
      '110189833=    SUM_COST_  = 0;'
      '110189834=    NDS_SUMM_  = 0;'
      '110189835=    PROFIT_    = 0;'
      '110189836=  END'
      '110189837=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '110189838=  --**************************************************' +
        '***************************************'
      '110189839='
      
        '110189840=  --**************************************************' +
        '***************************************'
      
        '110189841=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048 +
        #1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110189842=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054 +
        #1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110189843=  --**************************************************' +
        '***************************************'
      '110189844=  SELECT COUNT(*)'
      '110189845=    FROM ZAKAZ S'
      
        '110189846=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110189847=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110189848=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110189849=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110189850=     AND S.IS_SPISANIE = 2'
      '110189851=  INTO :CNT_;'
      '110189852='
      '110189853=  IF (CNT_ > 0) THEN BEGIN'
      '110189854=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189855=      insert into p_rep_profit_table'
      '110189856=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110189857=      values'
      
        '110189858=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '110189859='
      '110189860=      SUM_ZAKAZ_ = 0;'
      '110189861=      SUM_COST_  = 0;'
      '110189862=      NDS_SUMM_  = 0;'
      '110189863=      PROFIT_    = 0;'
      '110189864=      FOR SELECT GP.NAME,'
      '110189865=                 GP.G_PRODUCT'
      '110189866=           FROM G_PRODUCT GP'
      '110189867=          WHERE IS_CATEGORY = 1'
      '110189868=            AND EXISTS (SELECT 1'
      
        '110189869=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110189870=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110189871=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110189872=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110189873=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110189874=                           AND Z.IS_SPISANIE = 2'
      '110189875=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110189876=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110189877=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058 +
        ' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110189878=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110189879=                           AND ((EXISTS (SELECT 1'
      
        '110189880=                                           FROM SKLAD ' +
        'S'
      
        '110189881=                                          WHERE S.G_CL' +
        'IENT = :G_SUPPLIER_'
      
        '110189882=                                            AND S.G_PR' +
        'ODUCT = G.G_PRODUCT'
      
        '110189883=                                            AND :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLI' +
        'ER_, 0) <> 0)'
      '110189884=                                  OR'
      
        '110189885=                                  COALESCE(:G_SUPPLIER' +
        '_, 0) = 0)'
      '110189886=                           )'
      '110189887=          ORDER BY 1'
      '110189888=      INTO :RECCAT_NAME_,'
      '110189889=           :RECCAT_PRODUCT_'
      '110189890=      DO BEGIN'
      '110189891=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189892=        insert into p_rep_profit_table'
      '110189893=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110189894=        values'
      
        '110189895=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110189896='
      '110189897=        FOR SELECT Z.ZAKAZ,'
      '110189898=                   Z.G_TOCHKA,'
      '110189899=                   Z.Z_DATE,'
      '110189900=                   Z.G_CLIENT,'
      '110189901=                   C.NAME CLIENT_NAME,'
      '110189902=                   Z.G_PAYMENT_TYPE,'
      '110189903=                   P.NAME PAYMENT_NAME,'
      '110189904=                   Z.OSNOVANIE,'
      '110189905=                   G.G_PRODUCT,'
      '110189906=                   G.G_PRODUCT_PAR,'
      '110189907=                   G.NAME TOVAR_NAME,'
      '110189908=                   ZD.AMOUNT,'
      '110189909=                   ZD.PRICE,'
      '110189910=                   ZD.SUMM,'
      '110189911=                   ZD.DISCOUNT_PERC,'
      '110189912=                   ZD.DISCOUNT_SUMM,'
      '110189913=                   ZD.NDS,'
      '110189914=                   ZD.NDS_SUMM,'
      '110189915=                   ZD.COST_PRICE'
      
        '110189916=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110189917=                   ZAKAZ_DETAILS ZD,'
      '110189918=                   G_PRODUCT G,'
      '110189919=                   G_PAYMENT_TYPE P'
      
        '110189920=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_' +
        'TOCHKA||'#39'-'#39
      '110189921=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110189922=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110189923=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110189924=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_ ' +
        ' -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110189925=               AND Z.IS_SPISANIE = 2                  ' +
        '  -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '110189926=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110189927=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110189928=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '110189929=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110189930=               AND ((EXISTS (SELECT 1'
      '110189931=                               FROM SKLAD S'
      
        '110189932=                              WHERE S.G_CLIENT = :G_SU' +
        'PPLIER_'
      
        '110189933=                                AND S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '110189934=                                AND :G_TOCHKA_ARR_ CON' +
        'TAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0' +
        ')'
      '110189935=                      OR'
      '110189936=                      COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110189937=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110189938=        INTO :REC_ZAKAZ_,'
      '110189939=            :REC_G_TOCHKA_,'
      '110189940=            :REC_Z_DATE_,'
      '110189941=            :REC_G_CLIENT_,'
      '110189942=            :REC_CLIENT_NAME_,'
      '110189943=            :REC_G_PAYMENT_TYPE_,'
      '110189944=            :REC_PAYMENT_NAME_,'
      '110189945=            :REC_OSNOVANIE_,'
      '110189946=            :REC_G_PRODUCT_,'
      '110189947=            :REC_G_PRODUCT_PAR_,'
      '110189948=            :REC_TOVAR_NAME_,'
      '110189949=            :REC_AMOUNT_,'
      '110189950=            :REC_PRICE_,'
      '110189951=            :REC_SUMM_,'
      '110189952=            :REC_DISCOUNT_PERC_,'
      '110189953=            :REC_DISCOUNT_SUMM_,'
      '110189954=            :REC_NDS_,'
      '110189955=            :REC_NDS_SUMM_,'
      '110189956=            :REC_PRICE_SELF_'
      '110189957=        DO BEGIN'
      
        '110189958=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF' +
        '_;'
      
        '110189959=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - ' +
        'REC_NDS_SUMM_;'
      '110189960='
      '110189961=          insert into p_rep_profit_table'
      
        '110189962=            (p_rep_profit_table, zakaz, g_tochka, z_da' +
        'te, g_client, client_name, g_payment_type, payment_name,'
      
        '110189963=             osnovanie, g_product, g_product_par, tova' +
        'r_name, amount, price, summ, discount_perc, discount_summ,'
      
        '110189964=             nds, nds_summ, price_self, sum_self, prof' +
        'it, is_head)'
      '110189965=          values'
      '110189966=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110189967=            :REC_ZAKAZ_,'
      '110189968=            :REC_g_tochka_,'
      
        '110189969=            :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      '110189970=             :REC_osnovanie_,'
      '110189971=             :REC_g_product_,'
      '110189972=             :REC_g_product_par_,'
      '110189973=             :REC_tovar_name_,'
      '110189974=             :REC_amount_,'
      '110189975=             :REC_price_,'
      '110189976=             :REC_summ_,'
      '110189977=             :REC_discount_perc_,'
      '110189978=             :REC_discount_summ_,'
      
        '110189979=             :REC_nds_, :REC_nds_summ_, :REC_price_sel' +
        'f_, :REC_SUM_COST_, :REC_profit_, 0);'
      '110189980='
      
        '110189981=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_' +
        ', 0);'
      
        '110189982=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_CO' +
        'ST_, 0);'
      
        '110189983=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SU' +
        'MM_, 0);'
      
        '110189984=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_,' +
        ' 0);'
      '110189985=        END'
      '110189986='
      '110189987=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110189988=        insert into p_rep_profit_table'
      
        '110189989=          (p_rep_profit_table, tovar_name, summ, sum_s' +
        'elf, NDS_SUMM, profit, is_head)'
      '110189990=        values'
      
        '110189991=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39',' +
        ' :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110189992='
      
        '110189993=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_' +
        ';'
      '110189994=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '110189995=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '110189996=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '110189997='
      '110189998=        SUM_ZAKAZ_ = 0;'
      '110189999=        SUM_COST_  = 0;'
      '1101891000=        NDS_SUMM_  = 0;'
      '1101891001=        PROFIT_    = 0;'
      '1101891002=      END'
      '1101891003='
      '1101891004=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1101891005=      insert into p_rep_profit_table'
      
        '1101891006=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101891007=      values'
      
        '1101891008=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '1101891009='
      
        '1101891010=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REA' +
        'L_;'
      
        '1101891011=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REA' +
        'L_;'
      
        '1101891012=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_' +
        ';'
      '1101891013=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '1101891014=  END'
      '1101891015=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101891016=  --*************************************************' +
        '****************************************'
      '1101891017=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '1101891018='
      '1101891019=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1101891020=  insert into p_rep_profit_table'
      '1101891021=    (p_rep_profit_table, is_head)'
      '1101891022=  values'
      '1101891023=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1101891024='
      '1101891025=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1101891026=  insert into p_rep_profit_table'
      
        '1101891027=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101891028=  values'
      
        '1101891029=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1101891030='
      '1101891031=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1101891032=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1101891033=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1101891034=         SUM(Z.SUMM_BONUS)'
      '1101891035=    FROM ZAKAZ Z'
      
        '1101891036=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1101891037=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1101891038=     AND Z.IS_RESERVE = 0'
      '1101891039=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101891040=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101891041=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101891042=     AND ((EXISTS (SELECT 1'
      '1101891043=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1101891044=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1101891045=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1101891046=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1101891047=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101891048=          OR'
      '1101891049=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101891050=    INTO :SUMM_CASH_ALL_,'
      '1101891051=         :SUMM_NONCASH_ALL_,'
      '1101891052=         :SUMM_BONUS_ALL_;'
      '1101891053='
      '1101891054=  SELECT SUM(NAL),'
      '1101891055=         SUM(BEZNAL)'
      
        '1101891056=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHE' +
        'RE K.SKLAD = SP.SKLAD) NAL,'
      
        '1101891057=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL' +
        ' KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '1101891058=           FROM SKLAD_PARENT SP'
      
        '1101891059=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '1101891060=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101891061=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '1101891062=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, CO' +
        'ALESCE(SP.G_CLIENT, 0))'
      
        '1101891063=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYME' +
        'NT_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '1101891064=        )'
      '1101891065=  INTO :SUMM_VOZVRAT_NAL_,'
      '1101891066=       :SUMM_VOZVRAT_BEZNAL_;'
      '1101891067='
      
        '1101891068=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COAL' +
        'ESCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '1101891069=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) ' +
        '- COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '1101891070=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1101891071='
      '1101891072=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1101891073='
      
        '1101891074=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1101891075=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1101891076='
      '1101891077=/*  insert into p_rep_profit_table'
      
        '1101891078=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101891079=  values'
      
        '1101891080=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1101891081='
      '1101891082=  insert into p_rep_profit_table'
      '1101891083=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1101891084=  values'
      
        '1101891085=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1101891086='
      '1101891087=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1101891088=    SELECT G.NAME'
      '1101891089=      FROM G_CLIENT G'
      '1101891090=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1101891091=    INTO :CLIENT_NAME_;'
      '1101891092=  ELSE'
      '1101891093=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101891094='
      '1101891095=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1101891096=    SELECT G.NAME'
      '1101891097=      FROM G_PAYMENT_TYPE G'
      '1101891098=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1101891099=    INTO :PAYMENT_NAME_;'
      '1101891100=  ELSE'
      '1101891101=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101891102='
      '1101891103=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1101891104=        P.ZAKAZ,'
      '1101891105=        P.G_TOCHKA,'
      '1101891106=        P.Z_DATE,'
      '1101891107=        P.G_CLIENT,'
      '1101891108=        P.CLIENT_NAME,'
      '1101891109=        P.G_PAYMENT_TYPE,'
      '1101891110=        P.PAYMENT_NAME,'
      '1101891111=        P.OSNOVANIE,'
      '1101891112=        P.G_PRODUCT,'
      '1101891113=        P.G_PRODUCT_PAR,'
      '1101891114=        P.TOVAR_NAME,'
      '1101891115=        G.ARTICUL,'
      '1101891116=        G.NOMENCLATUR_NUM,'
      '1101891117=        P.AMOUNT,'
      
        '1101891118=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1101891119=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101891120=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101891121=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101891122=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101891123=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101891124=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101891125=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101891126=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1101891127=        P.IS_HEAD'
      
        '1101891128=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1101891129=    ORDER BY 1'
      '1101891130=  INTO :P_REP_PROFIT_TABLE,'
      '1101891131=       :ZAKAZ,'
      '1101891132=       :G_TOCHKA,'
      '1101891133=       :Z_DATE,'
      '1101891134=       :G_CLIENT,'
      '1101891135=       :CLIENT_NAME,'
      '1101891136=       :G_PAYMENT_TYPE,'
      '1101891137=       :PAYMENT_NAME,'
      '1101891138=       :OSNOVANIE,'
      '1101891139=       :G_PRODUCT,'
      '1101891140=       :G_PRODUCT_PAR,'
      '1101891141=       :TOVAR_NAME,'
      '1101891142=       :ARTICUL,'
      '1101891143=       :NOMENCLATUR_NUM,'
      '1101891144=       :AMOUNT,'
      '1101891145=       :PRICE,'
      '1101891146=       :SUMM,'
      '1101891147=       :DISCOUNT_PERC,'
      '1101891148=       :DISCOUNT_SUMM,'
      '1101891149=       :NDS,'
      '1101891150=       :NDS_SUMM,'
      '1101891151=       :PRICE_SELF,'
      '1101891152=       :SUM_SELF,'
      '1101891153=       :PROFIT,'
      '1101891154=       :IS_HEAD'
      '1101891155=  DO'
      '1101891156=    suspend;'
      '1101891157='
      '1101891158=WHEN ANY DO BEGIN'
      '1101891159=    Err_code = -20500;'
      
        '1101891160=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101891161=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101891162=  END'
      '1101891163=end'
      '1101891164=;'
      '1101891165='
      '1101891166=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '1101891167=  DATE_BEGIN_ DATE,'
      '1101891168=  DATE_END_ DATE,'
      '1101891169=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101891170=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      '1101891171=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1101891172=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '1101891173=RETURNS ('
      '1101891174=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101891175=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '1101891176=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SU' +
        'MM,'
      '1101891177=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1101891178=  SUMM_ALL_ NUMERIC(15,2),'
      '1101891179=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1101891180=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1101891181=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1101891182=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1101891183=  PROFIT_ALL_ NUMERIC(15,2),'
      '1101891184=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1101891185=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABL' +
        'E.P_REP_PROFIT_TABLE,'
      
        '1101891186=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_' +
        'NAME,'
      '1101891187=  SUMM NUMERIC(15,2),'
      '1101891188=  NDS_SUMM NUMERIC(15,2),'
      '1101891189=  SUM_SELF NUMERIC(15,2),'
      '1101891190=  PROFIT NUMERIC(15,2),'
      '1101891191=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1101891192=  ERR_CODE INTEGER,'
      '1101891193=  ERR_MSG VARCHAR(1024))'
      '1101891194=AS'
      '1101891195=/*'
      '1101891196='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1101891197='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1101891198='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1101891199='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1101891200='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1101891201='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1101891202='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1101891203=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1101891204=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1101891205=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1101891206='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1101891207='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1101891208=*/'
      
        '1101891209=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT' +
        #39';'
      '1101891210=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101891211=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1101891212=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1101891213=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1101891214=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1101891215=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1101891216=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1101891217=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1101891218=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM;'
      
        '1101891219=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.NDS_SUMM;'
      
        '1101891220=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.S' +
        'UMM;'
      '1101891221=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '1101891222=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '1101891223=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1101891224=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059 +
        #1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1101891225=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /' +
        '* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1101891226=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0' +
        '; /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '1101891227=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1101891228=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      '1101891229=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '1101891230=BEGIN'
      
        '1101891231=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_T' +
        'ABLE = P_REP_PROFIT_TABLE;'
      '1101891232=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101891233='
      '1101891234=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '1101891235=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '1101891236=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '1101891237='
      '1101891238=  FOR SELECT SUM(ZD.SUMM)'
      '1101891239=           ,TR.PATH'
      '1101891240=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1101891241=           ,SUM(ZD.nds_summ)'
      '1101891242=      FROM ZAKAZ Z,'
      '1101891243=           ZAKAZ_DETAILS ZD,'
      '1101891244=           G_PRODUCT GP,'
      '1101891245=           P_REP_TREE TR'
      
        '1101891246=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101891247=       AND Z.IS_SPISANIE = 0'
      '1101891248=       AND Z.IS_RESERVE = 0'
      '1101891249=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101891250=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101891251=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101891252=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101891253=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1101891254=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101891255=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101891256=       AND ((EXISTS (SELECT 1'
      '1101891257=                       FROM SKLAD S'
      '1101891258=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1101891259=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1101891260=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101891261=              OR'
      '1101891262=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101891263=     GROUP BY TR.PATH'
      '1101891264=     ORDER BY TR.PATH'
      
        '1101891265=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, ' +
        'NDS_SUMM_'
      '1101891266=  DO BEGIN'
      '1101891267=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '1101891268='
      '1101891269=    insert into p_rep_profit_table'
      
        '1101891270=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1101891271=    values'
      '1101891272=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1101891273=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :S' +
        'UM_COST_, :PROFIT_, 0);'
      '1101891274='
      '1101891275=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101891276=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1101891277=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101891278=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101891279=  END'
      '1101891280='
      '1101891281=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1101891282=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1101891283=      insert into p_rep_profit_table'
      
        '1101891284=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101891285=      values'
      
        '1101891286=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1101891287='
      
        '1101891288=  --*************************************************' +
        '****************************************'
      '1101891289=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1101891290=  ---------------------------------------------------' +
        '----'
      '1101891291=  IS_FIRST_ = 1;'
      '1101891292=  SUM_COST_ = 0;'
      '1101891293=  PROFIT_   = 0;'
      '1101891294='
      '1101891295=  FOR SELECT G.NAME,'
      '1101891296=             SUM(K.SUMM)'
      
        '1101891297=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRI' +
        'HOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101891298=              UNION ALL'
      
        '1101891299=              SELECT ACTION_DATE, SUMM NAL, ACTION, G' +
        '_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1101891300=             G_PRIHOD_RASHOD G'
      
        '1101891301=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1101891302=        AND K.ACTION = 1'
      
        '1101891303=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1101891304=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101891305=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    ' +
        '-- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101891306=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1101891307=        INTO :REC_TOVAR_NAME_'
      '1101891308=             ,:SUMM_'
      '1101891309=  DO BEGIN'
      '1101891310=    IF (IS_FIRST_ = 1) then BEGIN'
      '1101891311=      INSERT INTO P_REP_PROFIT_TABLE'
      '1101891312=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101891313=      VALUES'
      
        '1101891314=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39 +
        ', 1);'
      '1101891315='
      '1101891316=      IS_FIRST_ = 0;'
      '1101891317=    END'
      '1101891318='
      '1101891319=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101891320=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1101891321=    VALUES'
      
        '1101891322=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '1101891323='
      '1101891324=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1101891325=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1101891326=  END'
      '1101891327='
      '1101891328=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1101891329=  IF (SUM_COST_ > 0) then BEGIN'
      '1101891330=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101891331=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101891332=    insert into p_rep_profit_table'
      
        '1101891333=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101891334=    values'
      
        '1101891335=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1101891336=  END'
      '1101891337=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1101891338=  --*************************************************' +
        '****************************************'
      '1101891339='
      
        '1101891340=  --*************************************************' +
        '****************************************'
      '1101891341=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101891342=  ---------------------------------------------------' +
        '----'
      '1101891343=  IS_FIRST_ = 1;'
      '1101891344=  PROFIT_   = 0;'
      '1101891345=  PRIHOD_ALL_  = 0;'
      '1101891346=  PRIHOD_ALL_NAL_  = 0;'
      '1101891347=  PRIHOD_ALL_BEZNAL_  = 0;'
      '1101891348='
      '1101891349=  FOR SELECT G.NAME,'
      '1101891350=             SUM(K.NAL),'
      '1101891351=             SUM(K.BEZNAL)'
      
        '1101891352=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101891353=              UNION ALL'
      
        '1101891354=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1101891355=             G_PRIHOD_RASHOD G'
      
        '1101891356=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1101891357=        AND K.ACTION = 0'
      
        '1101891358=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1101891359=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101891360=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101891361=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1101891362=        INTO :REC_TOVAR_NAME_'
      '1101891363=             ,:SUMM_NAL_'
      '1101891364=             ,:SUMM_BEZNAL_'
      '1101891365=  DO BEGIN'
      '1101891366=    IF (IS_FIRST_ = 1) then BEGIN'
      '1101891367=      INSERT INTO P_REP_PROFIT_TABLE'
      '1101891368=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101891369=      VALUES'
      
        '1101891370=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39 +
        ', 1);'
      '1101891371='
      '1101891372=      IS_FIRST_ = 0;'
      '1101891373=    END'
      '1101891374='
      '1101891375=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101891376=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_' +
        'SUMM, SUMM, PROFIT, IS_HEAD)'
      '1101891377=    VALUES'
      
        '1101891378=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZN' +
        'AL_, 0);'
      '1101891379='
      '1101891380=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '1101891381=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BE' +
        'ZNAL_;'
      
        '1101891382=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      
        '1101891383=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL' +
        '_;'
      '1101891384=  END'
      '1101891385='
      '1101891386=  IF (PROFIT_ > 0) then BEGIN'
      '1101891387=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1101891388=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101891389=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1101891390=    insert into p_rep_profit_table'
      
        '1101891391=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101891392=    values'
      
        '1101891393=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1101891394=  END'
      '1101891395=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1101891396=  --*************************************************' +
        '****************************************'
      '1101891397='
      
        '1101891398=  --*************************************************' +
        '****************************************'
      '1101891399=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101891400=  --*************************************************' +
        '****************************************'
      '1101891401=  IS_FIRST_ = 1;'
      '1101891402=  SUM_COST_ = 0;'
      '1101891403=  PROFIT_   = 0;'
      
        '1101891404=  FOR SELECT SUM(ZD.SUMM)        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040 +
        #1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040 +
        #1044#1054
      '1101891405=           ,TR.PATH'
      '1101891406=      FROM ZAKAZ Z,'
      '1101891407=           ZAKAZ_DETAILS ZD,'
      '1101891408=           G_PRODUCT GP,'
      '1101891409=           P_REP_TREE TR'
      
        '1101891410=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101891411=       AND Z.IS_SPISANIE = 1'
      '1101891412=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101891413=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101891414=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101891415=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101891416=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1101891417=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101891418=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101891419=     GROUP BY TR.PATH'
      '1101891420=     ORDER BY TR.PATH'
      '1101891421=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '1101891422=  DO BEGIN'
      '1101891423='
      '1101891424=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1101891425=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101891426=      insert into p_rep_profit_table'
      '1101891427=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101891428=      values'
      
        '1101891429=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1101891430='
      '1101891431=      IS_FIRST_ = 0;'
      '1101891432=    END'
      '1101891433='
      '1101891434=    insert into p_rep_profit_table'
      
        '1101891435=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1101891436=    values'
      '1101891437=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1101891438=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZA' +
        'KAZ_, 0);'
      '1101891439='
      '1101891440=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '1101891441=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '1101891442=  END'
      '1101891443='
      '1101891444=  if (SUM_COST_ > 0) then BEGIN'
      '1101891445=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101891446=    insert into p_rep_profit_table'
      
        '1101891447=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101891448=    values'
      
        '1101891449=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0,' +
        ' :SUM_COST_, 0, :PROFIT_, 2);'
      '1101891450='
      '1101891451=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101891452=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101891453=  END'
      '1101891454=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101891455=  --*************************************************' +
        '****************************************'
      '1101891456='
      
        '1101891457=  --*************************************************' +
        '****************************************'
      '1101891458=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101891459=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1101891460=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1101891461=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1101891462='
      
        '1101891463=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1101891464=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1101891465=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1101891466=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      
        '1101891467=  --*************************************************' +
        '****************************************'
      '1101891468=  IS_FIRST_  = 1;'
      '1101891469=  SUM_ZAKAZ_ = 0;'
      '1101891470=  PROFIT_    = 0;'
      '1101891471=  FOR SELECT SUM(S.SUMM)'
      '1101891472=             ,TR.PATH'
      '1101891473=     FROM SKLAD_PARENT SP,'
      '1101891474=          SKLAD S,'
      '1101891475=          G_PRODUCT G,'
      '1101891476=          P_REP_TREE TR'
      
        '1101891477=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA|' +
        '|'#39'-'#39
      
        '1101891478=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1101891479=      AND SP.IS_VOZVRAT IN (1,2)'
      '1101891480=      and G.g_product_PAR = TR.g_product'
      
        '1101891481=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(S.G_CLIENT, 0))'
      
        '1101891482=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYP' +
        'E_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101891483=      AND SP.SKLAD = S.SKLAD_PARENT'
      '1101891484=      AND S.G_PRODUCT = G.G_PRODUCT'
      '1101891485=      AND ((EXISTS (SELECT 1'
      '1101891486=                       FROM SKLAD SS'
      
        '1101891487=                      WHERE SS.G_CLIENT = :G_SUPPLIER' +
        '_'
      
        '1101891488=                        AND SS.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '1101891489=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101891490=              OR'
      '1101891491=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101891492=     GROUP BY TR.PATH'
      '1101891493=     ORDER BY TR.PATH'
      '1101891494=     INTO :V_SUMM_,'
      '1101891495=          :REC_TOVAR_NAME_'
      '1101891496=  DO BEGIN'
      '1101891497=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1101891498=      insert into p_rep_profit_table'
      '1101891499=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101891500=      values'
      
        '1101891501=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040#39', 1);'
      '1101891502='
      '1101891503=      IS_FIRST_ = 0;'
      '1101891504=    END'
      '1101891505='
      
        '1101891506=    REC_profit_   = 0 - V_SUMM_;    -- 26.05.2016 '#1055#1054#1057 +
        #1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050 +
        #1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101891507=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101891508=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1101891509=    VALUES'
      
        '1101891510=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :V_SUMM_, :REC_profit_, 0);'
      '1101891511='
      '1101891512=    SUM_COST_ = 0;'
      '1101891513=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '1101891514=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '1101891515=  END'
      '1101891516='
      '1101891517=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1101891518=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1101891519=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101891520='
      '1101891521=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101891522=    insert into p_rep_profit_table'
      
        '1101891523=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101891524=    values'
      
        '1101891525=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '1101891526=  END'
      '1101891527=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101891528=  --*************************************************' +
        '****************************************'
      '1101891529='
      
        '1101891530=  --*************************************************' +
        '****************************************'
      
        '1101891531=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101891532=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101891533=  --*************************************************' +
        '****************************************'
      '1101891534=  IS_FIRST_  = 1;'
      '1101891535=  SUM_ZAKAZ_ = 0;'
      '1101891536=  SUM_COST_  = 0;'
      '1101891537=  PROFIT_    = 0;'
      '1101891538=  NDS_SUMM_  = 0;'
      '1101891539=  FOR SELECT SUM(ZD.SUMM)'
      '1101891540=           ,TR.PATH'
      '1101891541=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1101891542=           ,SUM(ZD.nds_summ)'
      '1101891543=      FROM ZAKAZ Z,'
      '1101891544=           ZAKAZ_DETAILS ZD,'
      '1101891545=           G_PRODUCT GP,'
      '1101891546=           P_REP_TREE TR'
      
        '1101891547=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1101891548=       AND Z.IS_SPISANIE = 2'
      '1101891549=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101891550=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1101891551=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1101891552=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101891553=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1101891554=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101891555=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101891556=       AND ((EXISTS (SELECT 1'
      '1101891557=                       FROM SKLAD S'
      '1101891558=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1101891559=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1101891560=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101891561=              OR'
      '1101891562=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101891563=     GROUP BY TR.PATH'
      '1101891564=     ORDER BY TR.PATH'
      
        '1101891565=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST' +
        '_, REC_NDS_SUMM_'
      '1101891566=  DO BEGIN'
      '1101891567=    IF (IS_FIRST_ = 1) then BEGIN'
      '1101891568=      insert into p_rep_profit_table'
      '1101891569=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101891570=      values'
      
        '1101891571=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1101891572='
      '1101891573=      IS_FIRST_ = 0;'
      '1101891574=    END'
      '1101891575='
      
        '1101891576=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS' +
        '_SUMM_;'
      '1101891577='
      '1101891578=    insert into p_rep_profit_table'
      
        '1101891579=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1101891580=    values'
      '1101891581=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1101891582=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_,' +
        ' :REC_SUM_COST_, :REC_PROFIT_, 0);'
      '1101891583='
      '1101891584=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '1101891585=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '1101891586=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '1101891587=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '1101891588=  END'
      '1101891589='
      '1101891590=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1101891591=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1101891592=    insert into p_rep_profit_table'
      
        '1101891593=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101891594=    values'
      
        '1101891595=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFI' +
        'T_, 2);'
      '1101891596='
      '1101891597=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101891598=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1101891599=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101891600=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '1101891601=  END'
      '1101891602=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101891603=  --*************************************************' +
        '****************************************'
      '1101891604=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1101891605=  insert into p_rep_profit_table'
      '1101891606=    (p_rep_profit_table, is_head)'
      '1101891607=  values'
      '1101891608=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1101891609='
      '1101891610=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1101891611=  insert into p_rep_profit_table'
      
        '1101891612=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101891613=  values'
      
        '1101891614=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1101891615='
      '1101891616=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1101891617=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1101891618=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1101891619=         SUM(Z.SUMM_BONUS)'
      '1101891620=    FROM ZAKAZ Z'
      
        '1101891621=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1101891622=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1101891623=     AND Z.IS_RESERVE = 0'
      '1101891624=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101891625=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101891626=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101891627=     AND ((EXISTS (SELECT 1'
      '1101891628=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1101891629=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1101891630=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1101891631=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1101891632=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101891633=          OR'
      '1101891634=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101891635=    INTO :SUMM_CASH_ALL_,'
      '1101891636=         :SUMM_NONCASH_ALL_,'
      '1101891637=         :SUMM_BONUS_ALL_;'
      '1101891638='
      '1101891639=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '1101891640=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '1101891641=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1101891642='
      '1101891643=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1101891644='
      
        '1101891645=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1101891646=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1101891647='
      '1101891648=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1101891649=    SELECT G.NAME'
      '1101891650=      FROM G_CLIENT G'
      '1101891651=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1101891652=    INTO :CLIENT_NAME_;'
      '1101891653=  ELSE'
      '1101891654=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101891655='
      '1101891656=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1101891657=    SELECT G.NAME'
      '1101891658=      FROM G_PAYMENT_TYPE G'
      '1101891659=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1101891660=    INTO :PAYMENT_NAME_;'
      '1101891661=  ELSE'
      '1101891662=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101891663='
      '1101891664=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1101891665=        P.TOVAR_NAME,'
      
        '1101891666=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101891667=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101891668=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101891669=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1101891670=        P.IS_HEAD'
      
        '1101891671=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1101891672=    ORDER BY 1'
      '1101891673=  INTO :P_REP_PROFIT_TABLE,'
      '1101891674=       :TOVAR_NAME,'
      '1101891675=       :SUMM,'
      '1101891676=       :NDS_SUMM,'
      '1101891677=       :SUM_SELF,'
      '1101891678=       :PROFIT,'
      '1101891679=       :IS_HEAD'
      '1101891680=  DO'
      '1101891681=    suspend;'
      '1101891682='
      '1101891683=WHEN ANY DO BEGIN'
      '1101891684=    Err_code = -20500;'
      
        '1101891685=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101891686=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101891687=  END'
      '1101891688=end'
      '1101891689=;'
      '1101891690='
      '1101891691='
      
        '1101891692=UPDATE SYSTEM_SETUP SET S_VALUE = 110189 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101891693=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101891694=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101900='
      '1101901=ALTER PROCEDURE G_GET_G_PRODUCT('
      
        '1101902=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT,'
      '1101903=  MODE_ INTEGER = 0)'
      '1101904=RETURNS ('
      
        '1101905=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR */ BIGINT,'
      '1101906=  ARTICUL_ VARCHAR(30),'
      '1101907=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101908=  BARCODE_ VARCHAR(30),'
      '1101909=  NAME_ VARCHAR(500),'
      '11019010=  G_UNIT_ /* TYPE OF COLUMN G_UNIT.G_UNIT */ BIGINT,'
      '11019011=  PRICE_ NUMERIC(15,2),'
      '11019012=  VOLUME_PRICE_ NUMERIC(15,2),'
      
