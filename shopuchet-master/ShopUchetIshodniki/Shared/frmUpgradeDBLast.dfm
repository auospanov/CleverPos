      '1101322306=            SUMM_PRIHOD_SKL_   = 0;'
      '1101322307=            AMOUNT_UHOD_SKL_   = 0;'
      '1101322308=            SUMM_UHOD_SKL_     = 0;'
      '1101322309=        END'
      '1101322310='
      '1101322311=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101322312=        INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      '1101322313=          (P_REP_TOVAR_MOVE_TABLE, NAME, IS_HEAD)'
