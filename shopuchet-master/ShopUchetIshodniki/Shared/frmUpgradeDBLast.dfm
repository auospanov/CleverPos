        '11096161=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11096162=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      
        '11096163=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      '11096164=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11096165=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11096166=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044#1051#1071 +
        ' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '11096167=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIENT.' +
        'G_CLIENT;'
      
        '11096168=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.S' +
        'ALES_COMM;'
      
        '11096169=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11096170=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11096171=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11096172=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '11096173=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM = 0;'
      
        '11096174=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRODU' +
        'CT.SALES_COMM;'
      
        '11096175=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '11096176=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.SUMM;'
      
        '11096177=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11096178=BEGIN'
      '11096179='
      '11096180=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11096181=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '11096182=      SELECT Z.G_PAYMENT_TYPE,'
      '11096183=             Z.G_TOCHKA,'
      '11096184=             Z.SUMM,'
      '11096185=             Z.SUMM_BONUS,'
      '11096186=             Z.SUMM_BONUS_GOT,'
      '11096187=             z.g_client,'
      '11096188=             Z.G_OFFICIAL,'
      '11096189=             G.DO_NOT_SALES_COMM,'
      '11096190=             G.FM||'#39' '#39'||G.NM'
      
        '11096191=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z.' +
        'G_OFFICIAL = G.G_OFFICIAL'
      '11096192=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '11096193=        INTO :G_PAYMENT_TYPE_OLD_,'
      '11096194=             :G_TOCHKA_,'
      '11096195=             :SUMM_OLD_,'
      '11096196=             :SUMM_BONUS_OLD_,'
      '11096197=             :SUMM_BONUS_GOT_OLD_,'
      '11096198=             :g_client_old_,'
      '11096199=             :G_OFFICIAL_,'
      '11096200=             :DO_NOT_SALES_COMM_,'
      '11096201=             :OFFICIAL_NAME_;'
      '11096202='
      
        '11096203=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059
      
        '11096204=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COMM' +
        '_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '11096205=        SELECT SUM(ZD.SALES_COMM)'
      '11096206=          FROM ZAKAZ_DETAILS ZD'
      '11096207=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '11096208=          INTO :SALES_COMM_OLD_;'
      '11096209='
      '11096210=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '11096211=      PNT_ = '#39'02'#39';'
      
        '11096212=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETUR' +
        'NING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11096213=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11096214=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11096215=        EXIT;'
      '11096216=      END'
      '11096217='
      
        '11096218=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11096219=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11096220=      ELSE'
      '11096221=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11096222='
      '11096223=      PNT_ = '#39'01'#39';'
      '11096224=      UPDATE zakaz'
      '11096225=      SET'
      '11096226=       G_TOCHKA = :G_TOCHKA_,'
      '11096227=       Z_DATE = :Z_DATE_,'
      '11096228=       Z_TIME = :Z_TIME_,'
      '11096229=       G_CLIENT = :G_CLIENT_,'
      '11096230=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '11096231=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '11096232=       NOTE = COALESCE(:NOTE_, NOTE),'
      '11096233=       SUMM = :SUMM_,'
      '11096234=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '11096235=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ + :' +
        'SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11096236=       ,BY_RECIPE = :BY_RECIPE_'
      '11096237=       ,IS_RESERVE = :IS_RESERVE_'
      '11096238=       ,SUMM_BONUS = :SUMM_BONUS_'
      '11096239=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '11096240=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '11096241=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '11096242=      WHERE'
      '11096243=        zakaz = :zakaz_;'
      '11096244='
      
        '11096245=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059','
      '11096246=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '11096247=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058' '#1053 +
        #1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052#1040#1058 +
        #1068
      '11096248=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '11096249=          UPDATE G_DISCONT_CARD D'
      '11096250=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '11096251=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '11096252=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '11096253='
      
        '11096254=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059' '#1054 +
        #1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '11096255=          SUMM_OLD_           = 0;'
      '11096256=      END'
      '11096257=      UPDATE G_DISCONT_CARD D'
      
        '11096258=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM_B' +
        'ONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '11096259=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :SUM' +
        'M_'
      '11096260=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '11096261='
      '11096262=      PNT_ = '#39'03'#39';'
      '11096263=      FOR SELECT T.ZAKAZ_DETAILS,'
      '11096264=                 T.G_PRODUCT,'
      '11096265=                 T.AMOUNT,'
      '11096266=                 T.SUMM,'
      '11096267=                 G.SALES_COMM'
      '11096268=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '11096269=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '11096270=      INTO :ZAKAZ_DETAILS_,'
      '11096271=           :G_PRODUCT_,'
      '11096272=           :Z_AMOUNT_,'
      '11096273=           :DETAILS_SUMM_,'
      '11096274=           :SALES_COMM_'
      '11096275=      DO BEGIN'
      
        '11096276=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056 +
        #1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040 +
        #1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '11096277=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ') THEN BEGIN'
      
        '11096278=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SALES' +
        '_COMM_/100;'
      
        '11096279=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_ ' +
        '+ SALES_COMM_SUMM_ITER_;'
      '11096280=        END'
      '11096281='
      
        '11096282=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKAZ' +
        ', G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '11096283=                                   DISCOUNT_TENGE, DISC' +
        'OUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '11096284=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOUN' +
        'T, PRICE, SUMM, DISCOUNT_PERC,'
      
        '11096285=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_' +
        'SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '11096286=          FROM ZAKAZ_DETAILS_TMP Z'
      '11096287=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '11096288='
      
        '11096289=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051 +
        #1040#1044#1040
      '11096290=        IF (IS_RESERVE_ = 0) THEN'
      '11096291=            UPDATE LT_SKLAD_PRODUCT L'
      '11096292=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '11096293=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096294=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11096295='
      '11096296=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '11096297=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '11096298=            UPDATE LT_SKLAD_PRODUCT L'
      
        '11096299=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE ' +
        '+ :Z_AMOUNT_'
      '11096300=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11096301=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11096302=      END'
      '11096303='
      '11096304=      ----------------------------------------'
      
        '11096305=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058#1068' ' +
        #1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '11096306=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048' '#1048 +
        #1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '11096307=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057 +
        #1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '11096308=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '11096309=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' ' +
        #1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '11096310=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045 +
        #1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045 +
        #1053#1053#1054')'
      
        '11096311=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044 +
        #1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '11096312=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044 +
        #1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '11096313=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      '11096314=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '11096315=                PNT_ = '#39'04'#39';'
      
        '11096316=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_)' +
        ';'
      
        '11096317=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA' +
        '_) THEN'
      
        '11096318=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' POS_TILDA_ - 1);'
      '11096319=                ELSE'
      
        '11096320=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' CHAR_LENGTH(PAYMENTS_) - 1);'
      '11096321='
      
        '11096322=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR' +
        '_)'
      
        '11096323=                    RETURNING_VALUES :KASSA_, :PAYMENT_' +
        'DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11096324='
      
        '11096325=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM ' +
        '(POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '11096326='
      '11096327=                PNT_ = '#39'05'#39';'
      
        '11096328=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) T' +
        'HEN'
      
        '11096329=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_'
      
        '11096330=                                                  1,   ' +
        '  -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '11096331=                                                  :PAYM' +
        'ENT_SUMM_,'
      
        '11096332=                                                  :PAYM' +
        'ENT_DATE_,'
      
        '11096333=                                                  NULL,' +
        '   --NOTE_ => :NOTE_,'
      
        '11096334=                                                  :ZAKA' +
        'Z_,   --ZAKAZ_'
      '11096335=                                                  NULL,'
      
        '11096336=                                                  :PAYM' +
        'ENT_TYPE_,'
      
        '11096337=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11096338='
      
        '11096339=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063 +
        #1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '11096340=                ELSE BEGIN'
      
        '11096341=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067 +
        #1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '11096342=                    SELECT 1'
      '11096343=                      FROM KASSA K'
      '11096344=                     WHERE K.KASSA = :KASSA_'
      '11096345=                    UNION ALL'
      '11096346=                    SELECT 2'
      '11096347=                      FROM KASSA_BEZNAL KB'
      '11096348=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '11096349=                     INTO :PAYMENT_TYPE_OLD_;'
      '11096350='
      '11096351=                    PNT_ = '#39'06'#39';'
      
        '11096352=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYP' +
        'E_) THEN'
      
        '11096353=                        EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '11096354=                                                      0' +
        ',     -- ACTION_'
      
        '11096355=                                                      1' +
        ',     --:G_PRIHOD_RASHOD_,'
      
        '11096356=                                                      :' +
