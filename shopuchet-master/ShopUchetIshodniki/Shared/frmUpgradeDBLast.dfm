      '110228391=            END ELSE'
      
        '110228392=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110228393='
      '110228394=            SELECT G_PRODUCT'
      '110228395=              FROM G_PRODUCT G'
      '110228396=             WHERE G.NAME = :STR_'
      '110228397=               AND G.IS_CATEGORY = 1'
      
        '110228398=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110228399=                   OR'
      
        '110228400=                   (G.G_PRODUCT_PAR IS NULL AND :G_PRO' +
