        '110225441=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT = NULL,'
      
        '110225442=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SU' +
        'B_TYPE 1 SEGMENT SIZE 16384 = NULL,'
      
        '110225443=  G_NONCASH_PAY_TYPE_ /* TYPE OF COLUMN G_NONCASH_PAY_' +
