      '1102282715=        END'
      '1102282716=  END'
      '1102282717='
      '1102282718=  -- '#1042#1054#1047#1042#1056#1040#1065#1040#1070' '#1041#1054#1053#1059#1057#1067' '#1053#1040' '#1052#1045#1057#1058#1054
      
        '1102282719=  IF (IS_VOZVRAT_ = 1 AND ZAKAZ_ IS NOT NULL) THEN BE' +
        'GIN'
      '1102282720=    SELECT Z.SUMM_BONUS_GOT'
      '1102282721=      FROM ZAKAZ Z'
      '1102282722=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102282723=      INTO :SUMM_BONUS_GOT_;'
      '1102282724='
      '1102282725=    IF (:SUMM_BONUS_GOT_ > 0) THEN BEGIN'
      '1102282726=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '1102282727=              SUM(Z.SUMM)'
      '1102282728=         FROM ZAKAZ Z'
      '1102282729=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '1102282730=         INTO :SUMM_BONUS_GOT_,'
      '1102282731=              :SUMM_ALL_;'
      '1102282732='
      
        '1102282733=       SELECT ROUND( SUM(SP.SUMM * Z.SUMM_BONUS_GOT /' +
        ' Z.SUMM), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040 +
        #1058#1040
      '1102282734=              SUM(SP.SUMM)'
      '1102282735=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '1102282736=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '1102282737=          AND SP.ZAKAZ = Z.ZAKAZ'
      '1102282738=         INTO :BONUS_TO_MINUS_,'
      '1102282739=              :SUMM_TO_MINUS_;'
      '1102282740='
      '1102282741=       UPDATE G_DISCONT_CARD G'
      
        '1102282742=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_M' +
        'INUS_,'
      
        '1102282743=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINU' +
        'S_'
      '1102282744=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '1102282745=    END'
      '1102282746=  END'
      '1102282747='
      
        '1102282748=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
