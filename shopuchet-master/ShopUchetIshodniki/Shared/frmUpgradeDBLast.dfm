        #1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102391387=                    and not (z.IS_SPISANIE = 0 and z.' +
        'NOT_MINUS_OSTATOK = 1)'
      '1102391388=                   )'
      '1102391389='
      '1102391390=                   -'
      '1102391391=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102391392=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat =' +
        ' 3'
      '1102391393=                    and S.g_client = :G_TOCHKA_)'
      '1102391394='
      '1102391395=                   -'
      '1102391396=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102391397=                   (select COALESCE(sum(od.amount), 0' +
        ') from other_details od, other o'
      
        '1102391398=                    where od.g_product = :G_PRODUCT_ ' +
        'and o.G_TOCHKA = :G_TOCHKA_'
      '1102391399=                    and od.other = o.other)'
      '1102391400=                   ) amount,'
      '1102391401='
      
        '1102391402=                   (SELECT COALESCE(sum(ZD.amount), 0' +
        ') FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102391403=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AN' +
        'D Z.IS_RESERVE = 1'
      
        '1102391404=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.' +
        'G_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102391405=            from rdb$database'
      '1102391406=            INTO :AMOUNT_,'
      '1102391407=                 :AMOUNT_RESERVE_;'
      '1102391408='
      '1102391409=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102391410=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :' +
        'G_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102391411=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_' +
        'TOCHKA = CD.G_TOCHKA)'
      '1102391412=            WHEN MATCHED THEN'
      
        '1102391413=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.A' +
        'MOUNT_RESERVE = :AMOUNT_RESERVE_'
      '1102391414=            WHEN NOT MATCHED THEN'
      
        '1102391415=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, ' +
        'AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102391416=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, ' +
        ' 1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102391417=        END'
      '1102391418=    WHEN ANY DO'
      '1102391419=        BEGIN'
      '1102391420=            SQLCODE_ = GDSCODE;'
      '1102391421=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102391422=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102391423=            ERR_BODY = ERR_BODY ||'#39
      
        '1102391424=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102391425=        END'
      '1102391426=    END'
      '1102391427=  END'
      '1102391428='
      '1102391429=  */'
      '1102391430=END'
      '1102391431=;'
      '1102391432='
      '1102391433=ALTER PROCEDURE SYNC_UPLOAD('
      '1102391434=  SYNC_COMPS_ TYPE OF COLUMN SYNC_COMPS.SYNC_COMPS)'
      '1102391435=RETURNS ('
      '1102391436=  ID TYPE OF COLUMN LOGS.ID,'
      '1102391437=  SQLSTMT TYPE OF COLUMN LOGS.SQLSTMT,'
      '1102391438=  TTABLE TYPE OF COLUMN LOGS.TTABLE,'
      '1102391439=  USR TYPE OF COLUMN LOGS.USR,'
      '1102391440=  RR TYPE OF COLUMN LOGS.RR,'
      '1102391441=  DAT TYPE OF COLUMN LOGS.DAT)'
      '1102391442=AS'
      '1102391443=/*'
      '1102391444=*/'
      
        '1102391445=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_UPLOAD'#39 +
        ';'
      '1102391446=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102391447=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '1102391448=BEGIN'
      '1102391449=  FOR SELECT ID, SQLSTMT, TTABLE, USR, RR, DAT'
      '1102391450=      FROM LOGS'
      '1102391451=      WHERE IS_TRANSFERED = 0'
      '1102391452=        AND USR <> '#39'REPLICAT'#39
      '1102391453=      ORDER BY ID'
      '1102391454=      INTO :ID, :SQLSTMT, :TTABLE, :USR, :RR, :DAT'
      '1102391455=  DO BEGIN'
      '1102391456=    UPDATE LOGS L'
      '1102391457=       SET L.IS_TRANSFERED = 1'
      '1102391458=     WHERE L.ID = :ID;'
      '1102391459='
      '1102391460=    SUSPEND;'
      '1102391461=  END'
      '1102391462=end'
      '1102391463=;'
      '1102391464='
      '1102391465='
      '1102391466='
      '1102391467=UPDATE LOGS L SET L.SQLSTMT = L.SQLSTMT1;'
      '1102391468='
      '1102391469=ALTER TABLE LOGS DROP SQLSTMT1;'
      '1102391470='
      '1102391471=ALTER TABLE LOGS ALTER COLUMN ID POSITION 1;'
      '1102391472='
      '1102391473=ALTER TABLE LOGS ALTER COLUMN ID_ORIGINAL POSITION 2;'
      '1102391474='
      '1102391475=ALTER TABLE LOGS ALTER COLUMN SQLSTMT POSITION 3;'
      '1102391476='
      '1102391477=ALTER TABLE LOGS ALTER COLUMN TTABLE POSITION 4;'
      '1102391478='
      '1102391479=ALTER TABLE LOGS ALTER COLUMN USR POSITION 5;'
      '1102391480='
      '1102391481=ALTER TABLE LOGS ALTER COLUMN RR POSITION 6;'
      '1102391482='
      '1102391483=ALTER TABLE LOGS ALTER COLUMN DAT POSITION 7;'
      '1102391484='
      
        '1102391485=ALTER TABLE LOGS ALTER COLUMN IS_TRANSFERED POSITION ' +
        '8;'
      '1102391486='
      '1102391487=ALTER TABLE LOGS ALTER COLUMN SYSDATE POSITION 9;'
      '1102391488=ALTER TABLE LOGS ALTER COLUMN ERR_CODE POSITION 10;'
      '1102391489=COMMIT WORK;'
      
        '1102391490=UPDATE SYSTEM_SETUP SET S_VALUE = 110239 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102391491=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
