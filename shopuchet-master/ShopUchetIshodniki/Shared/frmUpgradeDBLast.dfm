      '110751779=    END'
      '110751780='
      
        '110751781=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110751782=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '110751783=        '#39'AS '#39'||CRLF||'
      '110751784=        '#39'BEGIN '#39'||CRLF||'
      
        '110751785=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      '110751786=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF||'
      
        '110751787=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110751788=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110751789=        '#39'END;'#39';'
      '110751790=    EXECUTE STATEMENT :TRGI;'
      '110751791='
      
        '110751792=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110751793=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '110751794=        '#39'AS '#39'||CRLF||'
      '110751795=        '#39'BEGIN '#39'||CRLF||'
      
        '110751796=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '110751797=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRLF' +
        '||'
      
        '110751798=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110751799=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110751800=        '#39'END;'#39';'
      '110751801=    EXECUTE STATEMENT :TRGI;'
      '110751802='
      '110751803=    TN_ALT = TN;'
      '110751804=  END'
      '110751805='
      '110751806=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '110751807=        FROM RDB$RELATIONS R'
      '110751808=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110751809=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '110751810=       ORDER BY R.RDB$RELATION_NAME'
      '110751811=        INTO :TN'
      '110751812=  DO BEGIN'
      '110751813=    TN=TRIM(TN);'
      '110751814=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '110751815='
