      '1106011773=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106011774=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106011775=             AND Z.G_CLIENT = C.G_CLIENT'
