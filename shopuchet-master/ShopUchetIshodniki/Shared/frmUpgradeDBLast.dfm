        '1101852306=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101852307=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101852308=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101852309=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101852310=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1101852311=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
