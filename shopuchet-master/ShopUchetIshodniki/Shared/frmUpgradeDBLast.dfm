        '1102121951=  VOZVRAT_NONCASH_AMOUNT_   = COALESCE(VOZVRAT_NONCAS' +
        'H_AMOUNT_, 0);'
      
        '1102121952=  VNESENIE_AMOUNT_          = COALESCE(VNESENIE_AMOUN' +
        'T_, 0);'
      
        '1102121953=  VNESENIE_SUMM_            = COALESCE(VNESENIE_SUMM_' +
        ', 0);'
      
        '1102121954=  IZYATIE_AMOUNT_           = COALESCE(IZYATIE_AMOUNT' +
        '_, 0);'
      
        '1102121955=  IZYATIE_SUMM_             = COALESCE(IZYATIE_SUMM_,' +
        ' 0);'
      '1102121956=  OUT_SUMM_                 = COALESCE(OUT_SUMM_, 0);'
      '1102121957='
      '1102121958=  FOR SELECT 0.5 COL,'
      '1102121959=               '#39'******'#39' STR,'
      '1102121960=               '#39'******'#39' AMOUNT,'
      '1102121961=               '#39'******'#39' SUMM'
      '1102121962=          FROM RDB$DATABASE'
      '1102121963=        UNION'
      '1102121964=        SELECT 1 COL,'
      '1102121965=               '#39#1054#1058#1063#1045#1058' Z'#39' STR,'
      '1102121966=               '#39#39' AMOUNT,'
      '1102121967=               '#39#39' SUMM'
      '1102121968=          FROM RDB$DATABASE'
      '1102121969=        UNION'
      '1102121970=        SELECT 1.5 COL,'
      '1102121971=               '#39#1055#1051#1040#1058#1045#1046#1053#1067#1045' '#1057#1056#1045#1044#1057#1058#1042#1040#39' STR,'
      '1102121972=               '#39'******'#39' AMOUNT,'
      '1102121973=               '#39'******'#39' SUMM'
      '1102121974=          FROM RDB$DATABASE'
      '1102121975=        UNION'
      '1102121976=        SELECT 2 COL,'
      '1102121977=               '#39#1053#1040#1051#1048#1063#1053#1067#1045#39' STR,'
      '1102121978=               '#39#39' AMOUNT,'
      '1102121979=               '#39#39' SUMM'
      '1102121980=          FROM RDB$DATABASE'
      '1102121981=        UNION'
      '1102121982=        SELECT 3 COL,'
      '1102121983=               '#39'  '#1053#1040' '#1053#1040#1063#1040#1051#1054' '#1042' '#1050#1040#1057#1057#1045#39' STR,'
      '1102121984=               '#39#39' AMOUNT,'
      '1102121985=               '#39'='#39'||:IN_SUMM_ SUMM'
      '1102121986=          FROM RDB$DATABASE'
