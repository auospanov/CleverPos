      '110206957=                                          :G_OFFICIAL_'
      
        '110206958=                                          ) RETURNING_' +
        'VALUES :ERR_CODE, :ERR_MSG;'
      '110206959='
      '110206960=        END'
      '110206961=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110206962=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110206963=          EXIT;'
      '110206964=        END'
      '110206965=      END */'
      '110206966='
      
        '110206967=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD' +
        '_TO_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058 +
        #1053#1054' '#1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '110206968=      IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '110206969=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER, IS_LOADED_MOB)'
      
        '110206970=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 1, (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END));   ' +
        '-- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' CASE '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' '#1054#1041#1053#1054#1042#1051#1045#1053#1048 +
