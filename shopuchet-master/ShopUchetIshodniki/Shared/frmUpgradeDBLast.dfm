      '1102122006=        SELECT 7 COL,'
      '1102122007=               '#39'  '#1048#1047#1066#1071#1058#1048#1045#39' STR,'
      '1102122008=               '#39'*'#39'||:IZYATIE_AMOUNT_ AMOUNT,'
      '1102122009=               '#39'='#39'||:IZYATIE_SUMM_ SUMM'
      '1102122010=          FROM RDB$DATABASE'
