        '110533842=                           AND D.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110533843=                           AND Z.IS_SPISANIE = 4)) SUM' +
        'M_UHOD_SKL,'
      
        '110533844=               (select (select amount from lt_sklad_pr' +
