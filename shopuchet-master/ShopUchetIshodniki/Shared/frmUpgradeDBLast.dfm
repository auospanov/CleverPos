      '110237192=          ELSE IF (MODE_ = 2) THEN'
      
        '110237193=            SQL_STR_ = SQL_STR_ ||'#39'P.VES_GRAMM_PRICE =' +
        ' ROUND(P.VES_GRAMM_PRICE * (1 - '#39'||:NEW_VAL_||'#39'/100), '#39'||:ROUND_' +
