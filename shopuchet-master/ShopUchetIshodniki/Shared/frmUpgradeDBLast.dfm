      '110241343=                       +'
      
        '110241344=                       (select COALESCE(sum(zd.amount)' +
        ', 0) from zakaz_details zd, zakaz z'
      
        '110241345=                        where zd.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110241346=                        and zd.zakaz = z.zakaz and z.z' +
