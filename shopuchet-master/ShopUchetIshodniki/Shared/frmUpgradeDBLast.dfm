      '110157256=    curr_str = buf || curr_str;'
      '110157257=    /* '#1055#1077#1088#1077#1093#1086#1076#1080#1084' '#1082' '#1089#1083#1077#1076#1091#1102#1097#1077#1081' '#1090#1088#1080#1072#1076#1077' */'
      '110157258=    val_str = left(val_str, char_length(val_str)-3);'
      '110157259=    /* '#1059#1074#1077#1083#1080#1095#1080#1074#1072#1077#1084' '#1089#1095#1105#1090#1095#1080#1082' '#1088#1072#1079#1088#1103#1076#1072' */'
      '110157260=    raz = raz + 1;'
      '110157261=  end'
      '110157262='
      '110157263=  /* '#1055#1088#1080#1087#1099#1089#1099#1074#1072#1077#1084' '#1079#1085#1072#1082' */'
      '110157264=  curr_str = sign_of_val || curr_str;'
      '110157265='
      '110157266=  if (curr_str = '#39#39') THEN'
      '110157267=    curr_str = '#39#1085#1086#1083#1100#39';'
      '110157268='
      '110157269=  /* '#1044#1077#1083#1072#1077#1084' '#1087#1077#1088#1074#1091#1102' '#1073#1091#1082#1074#1091' '#1087#1088#1086#1087#1080#1089#1085#1086#1081' */'
      
        '110157270=  curr_str = upper(substring(curr_str from 1 for 1)) |' +
        '| substring(curr_str from 2);'
      '110157271='
      '110157272=  /* '#1060#1083#1072#1075' "'#1087#1086#1082#1072#1079#1072#1090#1100' '#1085#1072#1079#1074#1072#1085#1080#1077' '#1074#1072#1083#1102#1090#1099'" */'
      '110157273=  if (Currency not in (-1, -2)) then begin'
      '110157274=    if (currency <> 0) then begin'
      '110157275=      --'#1089#1082#1083#1086#1085#1103#1102' '#1074#1072#1083#1102#1090#1091
      
        '110157276=      i = cast(substring(val_str1 from CHAR_LENGTH(val' +
        '_str1) for 1) as int);'
      '110157277=      if (i=1) then begin'
      '110157278=        if (currency = 1) then'
      '110157279=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1100#39';'
      '110157280=        else if (currency = 2) then'
      '110157281=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1072#39';'
      '110157282=        else if (currency = 3) then'
      '110157283=          CURR_STR_ = '#39' '#1089#1091#1084#39';'
      '110157284=        else if (currency = 4) then'
      '110157285=          CURR_STR_ = '#39' '#1089#1086#1084#39';'
      '110157286=        else if (currency = 5) then'
      '110157287=          CURR_STR_ = '#39' '#1076#1088#1072#1084#39';'
      '110157288='
      '110157289=      end ELSE if ((i=2) or (I=3)) then begin'
      '110157290=        if (currency = 1) then'
      '110157291=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1103#39';'
      '110157292=        ELSE if (currency = 2) then'
      '110157293=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1099#39';'
      '110157294=        else if (currency = 3) then'
      '110157295=          CURR_STR_ = '#39' '#1089#1091#1084#1072#39';'
      '110157296=        else if (currency = 4) then'
      '110157297=          CURR_STR_ = '#39' '#1089#1086#1084#1072#39';'
      '110157298=        else if (currency = 5) then'
      '110157299=          CURR_STR_ = '#39' '#1076#1088#1072#1084#1072#39';'
      '110157300='
      '110157301=      END ELSE BEGIN'
      '110157302=        if (currency = 1) then'
      '110157303=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1077#1081#39';'
      '110157304=        ELSE if (currency = 2) then'
      '110157305=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1077#1085#39';'
      '110157306=        else if (currency = 3) then'
      '110157307=          CURR_STR_ = '#39' '#1089#1091#1084#39';'
      '110157308=        else if (currency = 4) then'
      '110157309=          CURR_STR_ = '#39' '#1089#1086#1084#1086#1074#39';'
      '110157310=        else if (currency = 5) then'
      '110157311=          CURR_STR_ = '#39' '#1076#1088#1072#1084#39';'
      '110157312=      end'
      '110157313='
      '110157314=      i = cast(substring(cents from 2 for 1) as int);'
      '110157315='
      '110157316=      if (currency in (1,2)) then begin'
      '110157317=          if (i=1) then'
      '110157318=            CURR_STR_KOP_ = '#39' '#1082#1086#1087#1077#1081#1082#1072#39';'
      '110157319=          ELSE if ((i=2) or (I=3)) then'
      '110157320=            CURR_STR_KOP_ = '#39' '#1082#1086#1087#1077#1081#1082#1080#39';'
      '110157321=          ELSE'
      '110157322=            CURR_STR_KOP_ = '#39' '#1082#1086#1087#1077#1077#1082#39';'
      '110157323=      end'
      '110157324=      else if (currency = 3) then begin'
      '110157325=        if (i=1) then'
      '110157326=          CURR_STR_KOP_ = '#39' '#1090#1080#1081#1080#1085#39';'
