      '1106015801=  DELETE from G_ACCOUNT'
      '1106015802=  WHERE'
      '1106015803=    G_ACCOUNT = :G_ACCOUNT_;'
      '1106015804='
      '1106015805=when sqlcode -530 DO'
      '1106015806=  begin'
      '1106015807=    ERR_CODE = -20500;'
      
        '1106015808=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106015809=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106015810=  end'
      '1106015811=end'
      '1106015812=;'
      '1106015813='
