      '110233557=  IS_FIRST_  = 1;'
      '110233558=  SUM_ZAKAZ_ = 0;'
      '110233559=  PROFIT_    = 0;'
      '110233560=  FOR SELECT -SUM(S.SUMM),'
      '110233561=             SUM(S.COST_PRICE)'
