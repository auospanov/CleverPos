        '110202547=                                                      ' +
        '                                              '#39' ), 0) - '#39'||DEBET' +
        '_||'#39' + '#39'||CREDIT_||'#39');'#39';'
      
        '110202548=            INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR' +
        ', IS_TRANSFERED, SYSDATE, ERR_CODE)'
      
        '110202549=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39 +
        'KASSA_STATE_BEZNAL'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202550=      END'
      '110202551=    END'
      '110202552=    ELSE BEGIN'
      
        '110202553=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048 +
        #1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202554=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
        'STEM_SETUP = 5) > 0) THEN BEGIN'
      
        '110202555=            SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'|' +
        '|'
      
        '110202556=                         '#39'SET K.DEBET = COALESCE(K.DEB' +
        'ET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '110202557=                            '#39'K.CREDIT = COALESCE(K.CRE' +
        'DIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '110202558=                            '#39'K.OUTPUT = COALESCE(K.INP' +
        'UT, 0) - (COALESCE(K.DEBET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39') + (' +
        'COALESCE(K.CREDIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39') '#39'||'
      
        '110202559=                       '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_' +
        'DATE_||'#39#39#39';'#39';'
      
        '110202560=            INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR' +
        ', IS_TRANSFERED, SYSDATE, ERR_CODE)'
      
        '110202561=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39 +
        'KASSA_STATE_BEZNAL'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202562=        END'
