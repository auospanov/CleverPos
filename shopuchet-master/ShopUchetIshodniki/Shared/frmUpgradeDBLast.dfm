      '11015758=RECONNECT;'
      '11015759='
      
        '11015760=ALTER TABLE SMS_HISTORY ADD CONSTRAINT PK_SMS_HISTORY P' +
        'RIMARY KEY (SMS_HISTORY);'
      '11015761='
      '11015762='
      
