        '1102283458=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102283459=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102283460=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102283461='
