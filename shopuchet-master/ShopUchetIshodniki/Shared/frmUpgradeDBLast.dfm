      '11027400=  SUMM_PRIHOD_ALL_ = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD_;'
      '11027401='
      '11027402=  -- '#1056#1040#1057#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1048#1047' '#1050#1040#1057#1057#1067
      '11027403=  FIRST_ITER = 0;'
      '11027404=  SUMM_RASHOD_ = 0;'
      
        '11027405=  FOR SELECT lpad(EXTRACT(DAY FROM K.action_date), 2, '#39 +
        #39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39#39'0'#39#39')|' +
        '|'#39#39'.'#39#39'||EXTRACT(YEAR FROM K.action_date),--CAST(K.action_date AS' +
        ' VARCHAR(10)),'
      '11027406=             K.action_date,'
      '11027407=             G.name'
      '11027408=             ,SUM(K.summ)'
      '11027409=        FROM KASSA k, g_prihod_rashod G'
      
        '11027410=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11027411=         AND K.ACTION = 1'
      
        '11027412=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '11027413=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '11027414=         AND K.g_tochka = :G_TOCHKA_'
      '11027415=        GROUP BY 2, 3'
      '11027416=        UNION ALL'
      '11027417=        SELECT CAST(K.action_date AS VARCHAR(10)),'
      '11027418=             K.action_date,'
      '11027419=             '#39#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1091'/'#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39#39' name'
      '11027420=             ,SUM(K.summ)'
      '11027421=        FROM KASSA k'
      '11027422=        WHERE K.G_PRIHOD_RASHOD in (2,3)'
      
        '11027423=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '11027424=         AND K.action_date <> (SELECT DATE_RECEIPT FROM' +
        ' SKLAD_PARENT WHERE SKLAD = K.sklad)'
      '11027425=         AND K.g_tochka = :G_TOCHKA_'
      '11027426=        GROUP BY 2, 3'
      '11027427=        INTO :date_str,'
      '11027428=           :Z_DATE,'
      '11027429=           :NAME,'
      '11027430=           :SUMM'
      '11027431=  DO BEGIN'
      '11027432=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '11027433=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR)'
      '11027434=      VALUES (24, 1, '#39#39#1056#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1080#1079' '#1082#1072#1089#1089#1099#39#39');'
      '11027435=      FIRST_ITER = 1;'
      '11027436=    END'
      '11027437='
      
        '11027438=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, Z_DATE, NAME, SUMM)'
      '11027439=      VALUES (25, 2, :DATE_STR, :z_date, :NAME, :SUMM);'
      '11027440='
      '11027441=    SUMM_RASHOD_ = SUMM_RASHOD_ + SUMM;'
      '11027442=  END'
      '11027443='
      '11027444=  IF (FIRST_ITER = 1) THEN'
      
        '11027445=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, SUMM)'
      
        '11027446=    VALUES (26, 3, '#39#39#1048#1090#1086#1075#1086' '#1088#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075#39#39', :SUMM_RASHOD' +
        '_);'
      '11027447=  SUMM_RASHOD_ALL_ = SUMM_RASHOD_ALL_ + SUMM_RASHOD_;'
      '11027448='
      '11027449=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '11027450=  VALUES(27, 1);'
      '11027451='
      
        '11027452=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z_' +
        'DATE_STR, SUMM)'
      
        '11027453=  VALUES (28, 1, '#39#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' '#1085#1072' '#1089#1091#1084#1084#1091#39#39 +
        ', :SUMM_PRIHOD_ALL_);'
      '11027454='
      
        '11027455=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z_' +
        'DATE_STR, SUMM)'
      
        '11027456=  VALUES (29, 1, '#39#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1085#1072' '#1089#1091#1084#1084#1091#39#39', :SUM' +
        'M_RASHOD_ALL_);'
      '11027457='
      '11027458=  FOR SELECT SORT_COL'
      '11027459=            ,ROW_COL'
      '11027460=            ,Z_DATE'
      '11027461=            ,Z_DATE_STR'
      '11027462=            ,ARTICUL'
      '11027463=            ,BARCODE'
      '11027464=            ,NAME'
      '11027465=            ,AMOUNT'
      '11027466=            ,SUMM'
      '11027467=        FROM P_REP_KASSIR_TABLE'
      '11027468=    ORDER BY 1, 3, 7'
      '11027469=    INTO :SORT_COL,'
      '11027470=        :ROWCOL,'
      '11027471=        :Z_DATE_LOC,'
      '11027472=        :Z_DATE,'
      '11027473=        :ARTICUL,'
      '11027474=        :BARCODE,'
      '11027475=        :NAME,'
      '11027476=        :AMOUNT,'
      '11027477=        :SUMM'
      '11027478=  DO'
      '11027479=    suspend;'
      '11027480=end'
      '11027481='#39';'
      '11027482=END  --END_EXECUTE_BLOCK'
