        '1102015115=                           AND D.G_PRODUCT = G.G_PROD' +
        'UCT)) AMOUNT_UHOD_SKL,'
      '1102015116=               (SELECT COALESCE(SUM(SUMM), 0)'
      
        '1102015117=                  FROM (SELECT COALESCE(SUM(S.SUMM),0' +
        ') SUMM'
      '1102015118=                          FROM SKLAD S'
      
