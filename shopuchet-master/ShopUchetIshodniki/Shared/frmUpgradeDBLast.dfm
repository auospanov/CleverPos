      '1102493098='
      
        '1102493099=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1102493100=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1102493101=    SELECT K.KASSA'
      '1102493102=      FROM KASSA K'
      '1102493103=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102493104=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102493105=      INTO :KASSA_POP_;'
      '1102493106=  ELSE'
      '1102493107=    SELECT K.KASSA_BEZNAL'
      '1102493108=      FROM KASSA_BEZNAL K'
      '1102493109=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102493110=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102493111=       INTO :KASSA_POP_;'
      '1102493112='
      
        '1102493113=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1102493114=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1102493115=      PNT_ = '#39'012'#39';'
      '1102493116=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1102493117=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1102493118=                                          1,     -- A' +
        'CTION_'
      '1102493119=                                          :G_PRIHOD_,'
      
        '1102493120=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102493121=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102493122=                                          NULL,   --N' +
        'OTE_'
      '1102493123=                                          NULL,'
      
        '1102493124=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102493125=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1102493126=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102493127=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102493128=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1102493129=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102493130=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1102493131=                                          :G_PRIHOD_,'
      
        '1102493132=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102493133=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102493134=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1102493135=                                          NULL,'
      
        '1102493136=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102493137=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102493138=                                          :G_TOCHKA_,'
      
        '1102493139=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102493140=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102493141=      END'
      '1102493142=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102493143=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102493144=        EXIT;'
      '1102493145=      END'
      '1102493146='
      
        '1102493147=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102493148=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102493149=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102493150=        PNT_ = '#39'013'#39';'
      
        '1102493151=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_' +
        'CODE, :ERR_MSG);'
      '1102493152=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102493153=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102493154=          EXIT;'
      '1102493155=        END'
      '1102493156=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102493157=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1102493158=                                          :G_PRIHOD_,'
      
        '1102493159=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102493160=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102493161=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1102493162=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1102493163=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102493164=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102493165=                                          :G_TOCHKA_,'
      
        '1102493166=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102493167=                                         ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102493168=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102493169=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102493170=              EXIT;'
      '1102493171=            END'
      '1102493172=        END'
      '1102493173=  END'
      '1102493174='
      '1102493175=  -- '#1042#1054#1047#1042#1056#1040#1065#1040#1070' '#1041#1054#1053#1059#1057#1067' '#1053#1040' '#1052#1045#1057#1058#1054
      
        '1102493176=  IF (IS_VOZVRAT_ = 1 AND ZAKAZ_ IS NOT NULL) THEN BE' +
        'GIN'
      '1102493177=    SELECT Z.SUMM_BONUS_GOT'
      '1102493178=      FROM ZAKAZ Z'
      '1102493179=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102493180=      INTO :SUMM_BONUS_GOT_;'
      '1102493181='
      '1102493182=    IF (:SUMM_BONUS_GOT_ > 0) THEN BEGIN'
      '1102493183=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '1102493184=              SUM(Z.SUMM)'
      '1102493185=         FROM ZAKAZ Z'
      '1102493186=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '1102493187=         INTO :SUMM_BONUS_GOT_,'
      '1102493188=              :SUMM_ALL_;'
      '1102493189='
      
        '1102493190=       SELECT ROUND( SUM(SP.SUMM * Z.SUMM_BONUS_GOT /' +
        ' Z.SUMM), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040 +
        #1058#1040
      '1102493191=              SUM(SP.SUMM)'
      '1102493192=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '1102493193=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '1102493194=          AND SP.ZAKAZ = Z.ZAKAZ'
      '1102493195=         INTO :BONUS_TO_MINUS_,'
      '1102493196=              :SUMM_TO_MINUS_;'
      '1102493197='
      '1102493198=       UPDATE G_DISCONT_CARD G'
      
        '1102493199=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_M' +
        'INUS_,'
      
        '1102493200=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINU' +
        'S_'
      '1102493201=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '1102493202=    END'
      '1102493203=  END'
      '1102493204='
      
        '1102493205=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102493206=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0,1' +
        ')) THEN'
      
        '1102493207=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      
        '1102493208=    SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PAR' +
        'ENT_, 2, CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END'
      '1102493209=      FROM RDB$DATABASE'
      
        '1102493210=     WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP ' +
        'WHERE AP.OBJECT_TYPE = 2 AND AP.ID = :SKLAD_PARENT_ AND AP.IS_LO' +
        'ADING = 0);'
      '1102493211='
      '1102493212=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102493213=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_PARENT_, :DATE_RECEIPT_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1102493214=end'
      '1102493215=;'
      '1102493216='
      '1102493217=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1102493218=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102493219=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102493220=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102493221=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102493222=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102493223=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102493224=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102493225=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102493226=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102493227=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102493228=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102493229=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102493230=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102493231=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102493232=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102493233=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102493234=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102493235=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102493236=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102493237=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102493238=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102493239=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      
        '1102493240=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102493241=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102493242=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL)'
      '1102493243=RETURNS ('
      '1102493244=  ERR_CODE INTEGER,'
      '1102493245=  ERR_MSG VARCHAR(1024))'
      '1102493246=AS'
      '1102493247=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1102493248='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1102493249=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1102493250=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1102493251='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1102493252='
      
        '1102493253=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102493254=*/'
      
        '1102493255=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1102493256=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102493257=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102493258=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1102493259=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1102493260=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1102493261=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1102493262=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1102493263=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1102493264=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102493265=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      '1102493266=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1102493267=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102493268=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1102493269=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      
        '1102493270=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102493271=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1102493272=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102493273=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;' +
        ' /* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '1102493274=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '1102493275=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '1102493276=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1102493277=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102493278=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102493279=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1102493280=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1102493281=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102493282=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102493283=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1102493284=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1102493285=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1102493286=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102493287=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1102493288=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1102493289=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102493290=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102493291=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1102493292=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102493293=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1102493294=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1102493295=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1102493296=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1102493297=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102493298=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1102493299=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1102493300=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1102493301=BEGIN'
      '1102493302='
      
        '1102493303=  -- '#1050#1040#1050#1048#1052'-'#1058#1054' '#1054#1041#1056#1040#1047#1054#1052' '#1055#1056#1054#1055#1040#1044#1040#1070#1058' '#1044#1045#1058#1040#1051#1048' '#1048#1047' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1045 +
        #1055#1054#1053#1071#1058#1053#1054
      '1102493304=  PNT_ = '#39'00'#39';'
      '1102493305=  SELECT COUNT(*)'
      '1102493306=    FROM ZAKAZ_DETAILS_TMP T'
      '1102493307=    INTO :CNT_;'
      '1102493308=  IF (CNT_ = 0) THEN BEGIN'
      '1102493309=     ERR_CODE = -20500;'
      
        '1102493310=     EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074 +
        #1072#1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'. '#1055#1088#1086#1076#1086#1083#1078#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      
        '1102493311=     ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '1102493312=     EXIT;'
      '1102493313=  END'
      '1102493314='
      '1102493315=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102493316=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102493317=      SELECT Z.G_PAYMENT_TYPE,'
      '1102493318=             Z.G_TOCHKA,'
      '1102493319=             Z.SUMM,'
      '1102493320=             Z.SUMM_BONUS,'
      '1102493321=             Z.SUMM_BONUS_GOT,'
      '1102493322=             z.g_client,'
      '1102493323=             Z.G_OFFICIAL,'
      '1102493324=             G.DO_NOT_SALES_COMM,'
      '1102493325=             G.FM||'#39' '#39'||G.NM'
      
        '1102493326=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1102493327=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102493328=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1102493329=             :G_TOCHKA_,'
      '1102493330=             :SUMM_OLD_,'
      '1102493331=             :SUMM_BONUS_OLD_,'
      '1102493332=             :SUMM_BONUS_GOT_OLD_,'
      '1102493333=             :g_client_old_,'
      '1102493334=             :G_OFFICIAL_,'
      '1102493335=             :DO_NOT_SALES_COMM_,'
      '1102493336=             :OFFICIAL_NAME_;'
      '1102493337='
      
        '1102493338=      -- 07.09.2021 '#1055#1054#1050#1040' '#1059#1041#1056#1040#1051' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059', '#1041#1059#1044#1059#1058' '#1054#1058#1063#1045#1058#1067' '#1044#1045#1056#1043#1040#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047
      
        '1102493339=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1102493340=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1102493341=        SELECT SUM(ZD.SALES_COMM)'
      '1102493342=          FROM ZAKAZ_DETAILS ZD'
      '1102493343=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102493344=          INTO :SALES_COMM_OLD_;'
      '1102493345=      */'
      '1102493346='
      '1102493347=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1102493348=      PNT_ = '#39'01'#39';'
      
        '1102493349=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102493350=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102493351=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102493352=        EXIT;'
      '1102493353=      END'
      '1102493354='
      
        '1102493355=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102493356=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102493357=      ELSE'
      '1102493358=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102493359='
      '1102493360=      PNT_ = '#39'02'#39';'
      '1102493361=      UPDATE zakaz'
      '1102493362=      SET'
      '1102493363=       G_TOCHKA = :G_TOCHKA_,'
      '1102493364=       Z_DATE = :Z_DATE_,'
      '1102493365=       Z_TIME = :Z_TIME_,'
      '1102493366=       G_CLIENT = :G_CLIENT_,'
      '1102493367=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102493368=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102493369=       NOTE = COALESCE(:NOTE_, NOTE),'
      
        '1102493370=       DELIVERY_ADDRESS = COALESCE(:ADDRESS_, DELIVER' +
        'Y_ADDRESS),'
      '1102493371=       SUMM = :SUMM_,'
      '1102493372=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1102493373=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102493374=       ,BY_RECIPE = :BY_RECIPE_'
      '1102493375=       ,IS_RESERVE = :IS_RESERVE_'
      '1102493376=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1102493377=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1102493378=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1102493379=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1102493380=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1102493381=       ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102493382=      WHERE'
      '1102493383=        zakaz = :zakaz_;'
      '1102493384='
      
        '1102493385=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1102493386=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1102493387=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1102493388=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1102493389=          UPDATE G_DISCONT_CARD D'
      '1102493390=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1102493391=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1102493392=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1102493393='
      
        '1102493394=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1102493395=          SUMM_OLD_           = 0;'
      '1102493396=      END'
      '1102493397=      UPDATE G_DISCONT_CARD D'
      
        '1102493398=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1102493399=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1102493400=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1102493401='
      '1102493402=      PNT_ = '#39'03'#39';'
      '1102493403=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1102493404=                 T.G_PRODUCT,'
      '1102493405=                 T.AMOUNT,'
      '1102493406=                 T.SUMM,'
      '1102493407=                 G.SALES_COMM'
      '1102493408=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1102493409=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1102493410=      INTO :ZAKAZ_DETAILS_,'
      '1102493411=           :G_PRODUCT_,'
      '1102493412=           :Z_AMOUNT_,'
      '1102493413=           :DETAILS_SUMM_,'
      '1102493414=           :SALES_COMM_'
      '1102493415=      DO BEGIN'
      
        '1102493416=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102493417=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1102493418=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1102493419=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102493420=        END'
      '1102493421='
      
        '1102493422=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102493423=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1102493424=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102493425=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1102493426=          FROM ZAKAZ_DETAILS_TMP Z'
      '1102493427=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1102493428='
      '1102493429=        -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1102493430=        IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1102493431=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' ' +
        #1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1102493432=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN'
      '1102493433=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102493434=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1102493435=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102493436=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102493437=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102493438='
      '1102493439=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102493440=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102493441=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102493442=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :Z_AMOUNT_'
      '1102493443=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102493444=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102493445=        END'
      '1102493446=      END'
      '1102493447='
      '1102493448=      ----------------------------------------'
      
        '1102493449=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102493450=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1102493451=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1102493452=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102493453=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1102493454=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1102493455=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102493456=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102493457=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1102493458=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1102493459=                PNT_ = '#39'04'#39';'
      
        '1102493460=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1102493461=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1102493462=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102493463=                ELSE'
      
        '1102493464=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102493465='
      
        '1102493466=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1102493467=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102493468='
      
        '1102493469=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102493470='
      '1102493471=                PNT_ = '#39'05'#39';'
      
        '1102493472=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN BEGIN'
      
        '1102493473=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1102493474=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1102493475=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1102493476=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1102493477=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1102493478=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1102493479=                                                  NUL' +
        'L,'
      
        '1102493480=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1102493481=                                                  :G_' +
        'TOCHKA_,'
      
        '1102493482=                                                  :UP' +
        'LOAD_TO_EXT_APP_'
      
        '1102493483=                                                  ) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102493484='
      
        '1102493485=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102493486=                END ELSE BEGIN'
      
        '1102493487=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102493488=                    SELECT 1'
      '1102493489=                      FROM KASSA K'
      '1102493490=                     WHERE K.KASSA = :KASSA_'
      '1102493491=                    UNION ALL'
      '1102493492=                    SELECT 2'
      '1102493493=                      FROM KASSA_BEZNAL KB'
      '1102493494=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102493495=                     INTO :PAYMENT_TYPE_OLD_;'
      '1102493496='
      '1102493497=                    PNT_ = '#39'06'#39';'
      
        '1102493498=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
        'YPE_) THEN'
      
        '1102493499=                        EXECUTE PROCEDURE K_UPD_KASSA' +
        '(:KASSA_,'
      
        '1102493500=                                                     ' +
        ' 0,     -- ACTION_'
      
        '1102493501=                                                     ' +
        ' 1,     --:G_PRIHOD_RASHOD_,'
      
        '1102493502=                                                     ' +
        ' :PAYMENT_SUMM_,'
      
        '1102493503=                                                     ' +
        ' :PAYMENT_DATE_,'
      
        '1102493504=                                                     ' +
        ' NULL,   --NOTE_'
      
        '1102493505=                                                     ' +
        ' :ZAKAZ_,'
      
        '1102493506=                                                     ' +
        ' NULL,'
      
        '1102493507=                                                     ' +
        ' :PAYMENT_TYPE_,'
      
        '1102493508=                                                     ' +
        ' :UPLOAD_TO_EXT_APP_'
      
        '1102493509=                                                     ' +
        ' ) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '1102493510=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' ' +
        #1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102493511=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' ' +
        #1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102493512=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1102493513=                        PNT_ = '#39'07'#39';'
      
        '1102493514=                        EXECUTE PROCEDURE K_DEL_KASSA' +
        '(:KASSA_, :PAYMENT_TYPE_OLD_,:UPLOAD_TO_EXT_APP_) RETURNING_VALU' +
        'ES (:ERR_CODE, :ERR_MSG);'
      
        '1102493515=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1102493516=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1102493517=                          EXIT;'
      '1102493518=                        END'
      '1102493519='
      '1102493520=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '1102493521=                           EXECUTE PROCEDURE K_INS_KA' +
        'SSA(0,     -- ACTION_ => :ACTION_'
      
        '1102493522=                                                     ' +
        '     1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1102493523=                                                     ' +
        '     :PAYMENT_SUMM_,'
      
        '1102493524=                                                     ' +
        '     :PAYMENT_DATE_,'
      
        '1102493525=                                                     ' +
        '     NULL,   --NOTE_ => :NOTE_,'
      
        '1102493526=                                                     ' +
        '     :ZAKAZ_,   --ZAKAZ_'
      
        '1102493527=                                                     ' +
        '     NULL,'
      
        '1102493528=                                                     ' +
        '     :PAYMENT_TYPE_,'
      
        '1102493529=                                                     ' +
        '     :G_TOCHKA_,'
      
        '1102493530=                                                     ' +
        '     :UPLOAD_TO_EXT_APP_'
      
        '1102493531=                                                     ' +
        '     ) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102493532=                    END'
      '1102493533=                END'
      '1102493534=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102493535=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102493536=                  EXIT;'
      '1102493537=                END'
      '1102493538='
      
        '1102493539=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1102493540=            END'
      '1102493541='
      
        '1102493542=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1102493543=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1102493544=                FROM KASSA K'
      '1102493545=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1102493546=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
      '1102493547=                UNION'
      '1102493548=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1102493549=                  FROM KASSA K'
      '1102493550=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1102493551=                   AND K.SUMM = 0'
      '1102493552=                UNION'
      
        '1102493553=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1102493554=                FROM KASSA_BEZNAL K'
      '1102493555=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1102493556=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA_BEZNAL||'#39'~'#39
      '1102493557=                UNION'
      
        '1102493558=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1102493559=                FROM KASSA_BEZNAL K'
      '1102493560=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1102493561=                 AND K.SUMM = 0'
      '1102493562=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1102493563=            DO BEGIN'
      '1102493564=                PNT_ = '#39'08'#39';'
      
        '1102493565=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_' +
        ', :PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ER' +
        'R_CODE, :ERR_MSG);'
      '1102493566=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102493567=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '1102493568=                    EXIT;'
      '1102493569=                END'
      '1102493570=            END'
      '1102493571='
      
        '1102493572=            --=======================================' +
        '=========================='
      '1102493573=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1102493574=            --=======================================' +
        '=========================='
      
        '1102493575=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057 +
