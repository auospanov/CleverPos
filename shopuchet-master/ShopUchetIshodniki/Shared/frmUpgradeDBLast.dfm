      '110481203='
      
        '110481204=EXECUTE STATEMENT '#39'ALTER TABLE REPORT ALTER COLUMN COO' +
        'RD POSITION 6;'#39';'
      '110481205='
      '110481206='
      '110481207='
      '110481208=EXECUTE STATEMENT '#39'ALTER PROCEDURE OTHER_READ('
      '110481209=  DATE_BEGIN_ DATE,'
      '110481210=  DATE_END_ DATE,'
      '110481211=  OP_TYPE_ /* TYPE OF COLUMN OTHER.OP_TYPE */ INTEGER,'
      
        '110481212=  ARRIVAL_TYPE_ /* TYPE OF COLUMN OTHER.ARRIVAL_TYPE *' +
        '/ INTEGER)'
      '110481213=RETURNS ('
      '110481214=  SKLAD /* TYPE OF COLUMN SKLAD.SKLAD */ INTEGER,'
      '110481215=  OP_DATE /* TYPE OF COLUMN OTHER.OP_DATE */ DATE,'
      
        '110481216=  NOTE /* TYPE OF COLUMN OTHER.NOTE */ BLOB SUB_TYPE 1' +
        ','
      '110481217=  STRING_DTLS VARCHAR(1000),'
      '110481218=  OTHER /* TYPE OF COLUMN OTHER.OTHER */ INTEGER,'
      
        '110481219=  AMOUNT /* TYPE OF COLUMN OTHER_DETAILS.AMOUNT */ NUM' +
        'ERIC(18,5))'
      '110481220=AS'
      '110481221=BEGIN'
      '110481222=  SUSPEND;'
      '110481223=END'
      '110481224='#39';'
      '110481225='
      '110481226=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_BILL('
      '110481227=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ INTEGER,'
      '110481228=  SUMM_DANO_ NUMERIC(15,2),'
      '110481229=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110481230=  CURRENCY_ INTEGER,'
      '110481231=  MODE_ INTEGER,'
      '110481232=  PRINT_SLOGAN_ VARCHAR(80),'
      '110481233=  DECIMAL_ INTEGER)'
      '110481234=RETURNS ('
      '110481235=  FIRM_NAME_ VARCHAR(600),'
      '110481236=  IDN_STR_ VARCHAR(30),'
      '110481237=  FIRM_IDN_ VARCHAR(50),'
      '110481238=  FIRM_ADDRESS_ VARCHAR(550),'
      '110481239=  NUM_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ INTEGER,'
      '110481240=  DATE_ VARCHAR(100),'
      '110481241=  PAYMENT_TYPE_ VARCHAR(100),'
      '110481242=  G_CLIENT_NAME_ VARCHAR(300),'
      '110481243=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110481244=  SUMM_VSEGO_ VARCHAR(50),'
      '110481245=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110481246=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110481247=  ROW_NUM INTEGER,'
      
        '110481248=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250' +
        '),'
      '110481249=  AMOUNT VARCHAR(50),'
      
        '110481250=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(' +
        '50),'
      '110481251=  PRICE VARCHAR(50),'
      '110481252=  PRICE_N VARCHAR(50),'
      '110481253=  SUMM VARCHAR(50),'
      '110481254=  SUMM_N VARCHAR(50),'
      '110481255=  SUMM_POLUCH_ VARCHAR(50),'
      '110481256=  SUMM_SDACH_ VARCHAR(50),'
      '110481257=  SUMM_STR_ VARCHAR(200),'
      '110481258=  SLOGAN_ VARCHAR(80),'
      '110481259=  SUMM_SKIDKA_ VARCHAR(50),'
      '110481260=  ERR_CODE NUMERIC(15,2),'
      '110481261=  ERR_MSG VARCHAR(1024))'
      '110481262=AS'
      '110481263=BEGIN'
      '110481264=  SUSPEND;'
      '110481265=END'
      '110481266='#39';'
      '110481267='
      '110481268='
      '110481269=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_TOVS_BY_DATE('
      '110481270=  DATE_ DATE)'
      '110481271=RETURNS ('
      '110481272=  TOVAR_ VARCHAR(1500))'
      '110481273=AS'
      '110481274=/*'
      '110481275='#1090#1086#1074#1072#1088#1099' '#1087#1086' '#1076#1072#1090#1072#1084
      '110481276=*/'
      '110481277=BEGIN'
      '110481278='
      '110481279=  SELECT SUBSTRING((SELECT'
      
        '110481280=                      LIST(G.NAME/*'#39#39'('#39#39'||D.AMOUNT||'#39#39 +
        ')'#39#39', */)'
      
        '110481281=                    FROM ZAKAZ Z, ZAKAZ_DETAILS D, G_P' +
        'RODUCT G'
      '110481282=                    WHERE D.G_PRODUCT = G.G_PRODUCT'
      '110481283=                      AND D.ZAKAZ = Z.ZAKAZ'
      
        '110481284=                      AND Z.z_date = :DATE_) FROM 1 FO' +
        'R 1500)'
      '110481285=    FROM RDB$DATABASE'
      '110481286=    INTO TOVAR_;'
      '110481287='
      '110481288=  SUSPEND;'
      '110481289=end'
      '110481290='#39';'
      '110481291='
      '110481292=EXECUTE STATEMENT '#39'ALTER PROCEDURE OTHER_READ('
      '110481293=  DATE_BEGIN_ DATE,'
      '110481294=  DATE_END_ DATE,'
      '110481295=  OP_TYPE_ TYPE OF COLUMN OTHER.OP_TYPE,'
      '110481296=  ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.ARRIVAL_TYPE)'
      '110481297=RETURNS ('
      '110481298=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '110481299=  OP_DATE TYPE OF COLUMN OTHER.OP_DATE,'
      '110481300=  NOTE TYPE OF COLUMN OTHER.NOTE,'
      '110481301=  STRING_DTLS VARCHAR(1000),'
      '110481302=  OTHER TYPE OF COLUMN OTHER.OTHER,'
      '110481303=  AMOUNT TYPE OF COLUMN OTHER_DETAILS.AMOUNT)'
      '110481304=AS'
      '110481305=DECLARE VARIABLE CNT_ INTEGER;'
      '110481306=BEGIN'
      '110481307=  SELECT COUNT(*)'
      '110481308=    FROM SKLAD T'
      '110481309=   WHERE T.IS_VOZVRAT = 4'
      
        '110481310=    AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '110481311=    AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHERE ' +
        'CUR_PARAMS = 2)'
      '110481312=    INTO CNT_;'
      '110481313='
      '110481314=  if (CNT_ = 0) then'
      '110481315=    SELECT MAX(T.DATE_RECEIPT)'
      '110481316=      FROM SKLAD T'
      '110481317=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '110481318=       AND T.IS_VOZVRAT = 4'
      
        '110481319=       AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHE' +
        'RE CUR_PARAMS = 2)'
      '110481320=      INTO :DATE_BEGIN_;'
      '110481321='
      '110481322=  FOR SELECT S.SKLAD,'
      '110481323=             S.DATE_RECEIPT,'
      '110481324=             S.NOTE,'
      '110481325=             G.NAME||'#39#39', '#1089#1077#1073#1077#1089#1090'-'#1090#1100' '#39#39'||SS.PRICE,'
      '110481326=             SS.AMOUNT,'
      '110481327=             O.OTHER'
      '110481328=      FROM SKLAD_PARENT S,'
      '110481329=           SKLAD SS,'
      '110481330=           OTHER O,'
      '110481331=           G_PRODUCT G'
      
        '110481332=      WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '110481333=        AND S.is_vozvrat = 4'
      
        '110481334=        AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '110481335=        AND S.sklad = O.sklad_parent_id'
      '110481336=        AND S.SKLAD = SS.SKLAD_PARENT'
      '110481337=        AND SS.G_PRODUCT = G.G_PRODUCT'
      '110481338=      INTO :SKLAD,'
      '110481339=           :OP_DATE,'
      '110481340=           :NOTE,'
      '110481341=           :STRING_DTLS'
      '110481342=           ,:AMOUNT'
      '110481343=           ,:OTHER'
      '110481344=  DO'
      '110481345=    SUSPEND;'
      '110481346=END'
      '110481347='#39';'
      '110481348='
      '110481349=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_BILL('
      '110481350=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110481351=  SUMM_DANO_ NUMERIC(15,2),'
      '110481352=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110481353=  CURRENCY_ INTEGER,'
      '110481354=  MODE_ INTEGER,'
      '110481355=  PRINT_SLOGAN_ VARCHAR(80),'
      '110481356=  DECIMAL_ INTEGER)'
      '110481357=RETURNS ('
      '110481358=  FIRM_NAME_ VARCHAR(600),'
      '110481359=  IDN_STR_ VARCHAR(30),'
      '110481360=  FIRM_IDN_ VARCHAR(50),'
      '110481361=  FIRM_ADDRESS_ VARCHAR(550),'
      '110481362=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110481363=  DATE_ VARCHAR(100),'
      '110481364=  PAYMENT_TYPE_ VARCHAR(100),'
      '110481365=  G_CLIENT_NAME_ VARCHAR(300),'
      '110481366=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110481367=  SUMM_VSEGO_ VARCHAR(50),'
      '110481368=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110481369=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110481370=  ROW_NUM INTEGER,'
      '110481371=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110481372=  AMOUNT VARCHAR(50),'
      '110481373=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110481374=  PRICE VARCHAR(50),'
      '110481375=  PRICE_N VARCHAR(50),'
      '110481376=  SUMM VARCHAR(50),'
      '110481377=  SUMM_N VARCHAR(50),'
      '110481378=  SUMM_POLUCH_ VARCHAR(50),'
      '110481379=  SUMM_SDACH_ VARCHAR(50),'
      '110481380=  SUMM_STR_ VARCHAR(200),'
      '110481381=  SLOGAN_ VARCHAR(80),'
      '110481382=  SUMM_SKIDKA_ VARCHAR(50),'
      '110481383=  ERR_CODE NUMERIC(15,2),'
      '110481384=  ERR_MSG VARCHAR(1024))'
      '110481385=AS'
      '110481386=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      
        '110481387=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_BILL'#39#39 +
        ';'
      '110481388=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110481389=DECLARE VARIABLE I INTEGER = 1;'
      
        '110481390=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110481391=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110481392=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.AMOUNT;'
      '110481393=BEGIN'
      '110481394=  SLOGAN_ = PRINT_SLOGAN_;'
      '110481395='
      '110481396=          -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110481397=          SELECT z.ZAKAZ--GEN_ID(GEN_BILL, 1)'
      '110481398=                 --,Z.Z_DATE'
      
        '110481399=                 ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, ' +
        #39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39#39'0'#39#39')||'#39#39'.' +
        #39#39'||EXTRACT(YEAR FROM Z.Z_DATE)||'#39#39'  '#39#39'||EXTRACT(HOUR FROM Z.Z_T' +
        'IME)||'#39#39':'#39#39'||EXTRACT(MINUTE FROM Z.Z_TIME)'
      
        '110481400=                 --,CAST(ROUND(Z.SUMM, 2) AS VARCHAR(1' +
        '00))   09.12.2017'
      '110481401=                 --,CAST(Z.SUMM AS VARCHAR(100))'
      '110481402=                 ,'#39#39#1050#1083#1080#1077#1085#1090': '#39#39'||G.NAME'
      
        '110481403=                 ,'#39#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39#39'||COALESCE(O.FM, '#39#39#39#39 +
        ')||'#39#39' '#39#39'||COALESCE(O.NM, '#39#39#39#39')'
      
        '110481404=                 ,'#39#39#1054#1087#1083#1072#1090#1072': '#39#39' ||CASE WHEN Z.summ_nonc' +
        'ash <> 0 AND Z.summ_cash <> 0 THEN '#39#39#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39#39' ELSE P.NAME ' +
        'END'
      
        '110481405=            FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ' +
        'ON Z.G_OFFICIAL = O.G_OFFICIAL,'
      '110481406=                 G_CLIENT G,'
      '110481407=                 G_PAYMENT_TYPE P'
      '110481408=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110481409=             AND Z.G_CLIENT = G.G_CLIENT'
      '110481410=             AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110481411=            INTO :NUM_,'
      '110481412=                :DATE_,'
      '110481413=                --:SUMM_VSEGO_,      09.12.2017'
      '110481414=                --:SUMM_VSEGO_N_,'
      '110481415=                :G_CLIENT_NAME_,'
      '110481416=                :G_OFFICIAL_FM_,'
      '110481417=                :PAYMENT_TYPE_;'
      '110481418='
      '110481419=          SELECT R.G_FIRM_REKVIZIT,'
      '110481420=                 '#39#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39#39'||r.NAME,'
      
        '110481421=                 DECODE(:CURRENCY_, 0, '#39#39#1048#1048#1053'/'#1041#1048#1053#39#39', '#39#39 +
        #1048#1053#1053#39#39')||'#39#39' '#1086#1088#1075'.: '#39#39'||COALESCE(R.IDN, '#39#39#39#39')'
      '110481422=            FROM G_FIRM_REKVIZIT R'
      '110481423=           WHERE R.is_default = 1'
      '110481424=            INTO :G_FIRM_REKVIZIT_,'
      '110481425=                 :FIRM_NAME_,'
      '110481426=                 :FIRM_IDN_;'
      '110481427='
      '110481428=          SELECT SUM(ZD.AMOUNT),'
      
        '110481429=                 CAST(SUM(ZD.DISCOUNT_SUMM) AS VARCHAR' +
        '(100)),'
      
        '110481430=                 CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_' +
        'SUMM), 2) AS VARCHAR(100)),'
      '110481431=                 CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '110481432=          FROM ZAKAZ_DETAILS ZD'
      '110481433=          WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110481434=          INTO :AMOUNT_VSEGO_NUM_,'
      '110481435=               :SUMM_SKIDKA_,'
      '110481436=               :SUMM_VSEGO_,'
      '110481437=               :SUMM_VSEGO_N_;'
      '110481438='
      '110481439=          SELECT '#39#39#1040#1076#1088#1077#1089': '#39#39'||R.address'
      '110481440=            FROM G_FIRM_ADDRESS R'
      '110481441=           WHERE R.IS_DEFAULT = 1'
      '110481442=             AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110481443=            INTO :FIRM_ADDRESS_;'
      '110481444='
      
        '110481445=          --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058 +
        #1067' '#1052#1040#1043#1040#1047#1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110481446=          FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#39#1054#1088#1075#1072 +
        #1085#1080#1079#1072#1094#1080#1103':'#39#39');'
      '110481447=          IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110481448=            IF (CURRENCY_ = 0) THEN'
      '110481449=              FIRM_IDN_ = '#39#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39#39';'
      '110481450=            ELSE'
      '110481451=              FIRM_IDN_ = '#39#39#1048#1053#1053' '#1086#1088#1075'.:'#39#39';'
      '110481452=          END'
      '110481453='
      
        '110481454=          FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#39#1040 +
        #1076#1088#1077#1089':'#39#39');'
      '110481455='
      
        '110481456=          SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS ' +
        'VARCHAR(100));'
      
        '110481457=          SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) A' +
        'S VARCHAR(100));'
      '110481458='
      '110481459=          SELECT CURR_STR||'#39#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39#39
      
        '110481460=            from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY' +
        '_)'
      '110481461=          INTO :SUMM_STR_;'
      '110481462='
      '110481463=          FOR'
      '110481464=            SELECT :I,'
      '110481465=                   G.NAME,'
      '110481466=                   ZD.AMOUNT,'
      
        '110481467=                   CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(' +
        '100)),'
      
        '110481468=                   CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SU' +
        'MM, 2) AS VARCHAR(100))'
      '110481469=                   ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110481470=                   ,CAST(ZD.PRICE - COALESCE(ZD.DISCOU' +
        'NT_TENGE, 0) AS VARCHAR(100))'
      '110481471=                   ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110481472=              FROM ZAKAZ Z,'
      '110481473=                   ZAKAZ_DETAILS ZD,'
      '110481474=                   G_PRODUCT G,'
      '110481475=                   G_UNIT U'
      '110481476=             WHERE Z.ZAKAZ = :ZAKAZ_'
      '110481477=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110481478=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110481479=               AND G.G_UNIT = U.G_UNIT'
      '110481480=             ORDER BY ZD.zakaz_details'
      '110481481=            INTO :ROW_NUM,'
      '110481482=                :NAME,'
      '110481483=                :AMOUNT_NUM_,'
      '110481484=                :PRICE,'
      '110481485=                :SUMM'
      '110481486=                ,:SHORT_NAME'
      '110481487=                ,:PRICE_N'
      '110481488=                ,:SUMM_N'
      '110481489=          DO BEGIN'
      '110481490=            I = I + 1;'
      '110481491='
      
        '110481492=            -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040 +
        #1071' '#1063#1040#1057#1058#1068' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      
        '110481493=            if (POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_) > 0) ' +
        'then'
      
        '110481494=              SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ F' +
        'ROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_)-1);'
      
        '110481495=            if (POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_N_) > 0' +
        ') then'
      
        '110481496=              SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_' +
        ' FROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_VSEGO_N_)-1);'
      '110481497=            if (POSITION('#39#39'.00'#39#39' IN PRICE) > 0) then'
      
        '110481498=              PRICE          = SUBSTRING(PRICE FROM 1 ' +
        'FOR POSITION('#39#39'.00'#39#39' IN PRICE)-1);'
      '110481499=            if (POSITION('#39#39'.00'#39#39' IN PRICE_N) > 0) then'
      
        '110481500=              PRICE_N        = SUBSTRING(PRICE_N FROM ' +
        '1 FOR POSITION('#39#39'.00'#39#39' IN PRICE_N)-1);'
      '110481501=            if (POSITION('#39#39'.00'#39#39' IN SUMM) > 0) then'
      
        '110481502=              SUMM           = SUBSTRING(SUMM FROM 1 F' +
        'OR POSITION('#39#39'.00'#39#39' IN SUMM)-1);'
      '110481503=            if (POSITION('#39#39'.00'#39#39' IN SUMM_N) > 0) then'
      
        '110481504=              SUMM_N         = SUBSTRING(SUMM_N FROM 1' +
        ' FOR POSITION('#39#39'.00'#39#39' IN SUMM_N)-1);'
      
        '110481505=            if (POSITION('#39#39'.00'#39#39' IN SUMM_POLUCH_) > 0)' +
        ' then'
      
        '110481506=              SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ ' +
        'FROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_POLUCH_)-1);'
      
        '110481507=            if (POSITION('#39#39'.00'#39#39' IN SUMM_SDACH_) > 0) ' +
        'then'
      
        '110481508=              SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ F' +
        'ROM 1 FOR POSITION('#39#39'.00'#39#39' IN SUMM_SDACH_)-1);'
      '110481509='
      '110481510=            -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110481511=            IF (DECIMAL_ = 2) THEN BEGIN'
      
        '110481512=              AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,' +
        '2));'
      
        '110481513=              AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NU' +
        'M_ AS NUMERIC(18,2));'
      '110481514=            END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      
        '110481515=              AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,' +
        '3));'
      
        '110481516=              AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NU' +
        'M_ AS NUMERIC(18,3));'
      '110481517=            END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      
        '110481518=              AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,' +
        '4));'
      
        '110481519=              AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NU' +
        'M_ AS NUMERIC(18,4));'
      '110481520=            END ELSE BEGIN'
      
        '110481521=              AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,' +
        '5));'
      
        '110481522=              AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NU' +
        'M_ AS NUMERIC(18,5));'
      '110481523=            END'
      '110481524='
      
        '110481525=            if (POSITION(RPAD('#39#39'.'#39#39', DECIMAL_ + 1, '#39#39'0' +
        #39#39') IN AMOUNT) > 0) then'
      
        '110481526=              AMOUNT         = SUBSTRING(AMOUNT FROM 1' +
        ' FOR POSITION(RPAD('#39#39'.'#39#39', DECIMAL_ + 1, '#39#39'0'#39#39') IN AMOUNT)-1);'
      '110481527='
      
        '110481528=            if (POSITION(RPAD('#39#39'.'#39#39', DECIMAL_ + 1, '#39#39'0' +
        #39#39') IN AMOUNT_VSEGO_) > 0) then'
      
        '110481529=              AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_' +
        ' FROM 1 FOR POSITION(RPAD('#39#39'.'#39#39', DECIMAL_ + 1, '#39#39'0'#39#39') IN AMOUNT_' +
        'VSEGO_)-1);'
      '110481530='
      '110481531=            SUSPEND;'
      '110481532=          END'
      '110481533=WHEN ANY DO BEGIN'
      '110481534=    Err_code = -20500;'
      
        '110481535=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110481536=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110481537=  END'
      '110481538=end'
      '110481539='#39';'
      '110481540='
      '110481541=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_DOC('
      '110481542=  DOC_ TYPE OF COLUMN DOCS.DOCS,'
      '110481543=  CURRENCY_ INTEGER,'
      '110481544=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110481545=  DOC_TYPE_ INTEGER)'
      '110481546=RETURNS ('
      '110481547=  NUM_ VARCHAR(50),'
      '110481548=  DOCS_DATE_ VARCHAR(20),'
      '110481549=  G_FIRM_ VARCHAR(1000),'
      '110481550=  G_FIRM_ADDRESS_ VARCHAR(1000),'
      '110481551=  G_FIRM_ACCOUNT_ VARCHAR(1000),'
      '110481552=  G_FIRM_BANK_ VARCHAR(1000),'
      '110481553=  G_FIRM_AND_ADDRESS_ VARCHAR(1000),'
      '110481554=  G_FIRM_OKPO_ TYPE OF COLUMN G_FIRM_REKVIZIT.OKPO,'
      '110481555=  G_FIRM_BIN_ TYPE OF COLUMN G_FIRM_REKVIZIT.IDN,'
      '110481556=  G_CLIENT_ VARCHAR(1000),'
      '110481557=  G_CLIENT_ADDRESS_ VARCHAR(1000),'
      '110481558=  G_CLIENT_ACCOUNT_ VARCHAR(1000),'
      '110481559=  G_CLIENT_AND_ADDRESS_ VARCHAR(1000),'
      '110481560=  G_CLIENT_BIN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '110481561=  G_OFFICIAL_ VARCHAR(1000),'
      '110481562=  G_OFFICIAL_ID_KIND_ VARCHAR(1000),'
      '110481563=  G_OFFICIAL_ID_NUM_ VARCHAR(1000),'
      '110481564=  G_OFFICIAL_ID_DATE_ VARCHAR(1000),'
      '110481565=  G_OFFICIAL_ID_ISSUER_ VARCHAR(1000),'
      '110481566=  APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '110481567=  RUKOVODITEL_ VARCHAR(1000),'
      '110481568=  GLAVBUH_ VARCHAR(1000),'
      '110481569=  NOTE_ TYPE OF COLUMN DOCS.NOTE,'
      '110481570=  PARAM1_ TYPE OF COLUMN DOCS.PARAM1,'
      '110481571=  PARAM2_ TYPE OF COLUMN DOCS.PARAM2,'
      '110481572=  PARAM3_ TYPE OF COLUMN DOCS.PARAM3,'
      '110481573=  PARAM4_ TYPE OF COLUMN DOCS.PARAM4,'
      '110481574=  PARAM5_ TYPE OF COLUMN DOCS.PARAM5,'
      '110481575=  SUMM_ VARCHAR(1000),'
      '110481576=  SUMM_STR_ VARCHAR(1000),'
      '110481577=  AMOUNT_ MY_NUMERIC_5,'
      '110481578=  ROW_NUM VARCHAR(10),'
      '110481579=  NAME VARCHAR(1000),'
      '110481580=  UNIT_NAME VARCHAR(1000),'
      '110481581=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110481582=  ZDATE VARCHAR(20),'
      '110481583=  AMOUNT MY_NUMERIC_5,'
      '110481584=  PRICE VARCHAR(500),'
      '110481585=  SUMM VARCHAR(500),'
      '110481586=  ERR_CODE INTEGER,'
      '110481587=  ERR_MSG VARCHAR(1024))'
      '110481588=AS'
      '110481589=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_DOC'#39#39';'
      '110481590=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110481591=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVIZ' +
        'IT.NOL_VMESTO_BEZ;'
      '110481592=DECLARE VARIABLE I INTEGER = 1;'
      '110481593=DECLARE VARIABLE BL_ TYPE OF COLUMN DOCS.PARAM6;'
      '110481594=DECLARE VARIABLE STR_ VARCHAR(500);'
      
        '110481595=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110481596=DECLARE VARIABLE AMOUNT_ITOG_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0;'
      '110481597=DECLARE VARIABLE STR_NAME_ VARCHAR(500);'
      '110481598=DECLARE VARIABLE STR_AMOUNT_ VARCHAR(500);'
      '110481599=DECLARE VARIABLE STR_UNIT_ VARCHAR(500);'
      '110481600=DECLARE VARIABLE POS_ INTEGER;'
      '110481601=DECLARE VARIABLE POS2_ INTEGER;'
      '110481602=BEGIN'
      '110481603='
      '110481604=  select D.num,'
      
        '110481605=         lpad(EXTRACT(DAY FROM D.DOCS_DATE), 2, '#39#39'0'#39#39')' +
        '||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM D.DOCS_DATE), 2, 0)||'#39#39'.'#39#39'||EXT' +
        'RACT(YEAR FROM D.DOCS_DATE),'
      '110481606=         F.name,'
      '110481607=         FD.address,'
      '110481608=         FA.account,'
      '110481609=         FA.BANK_NAME,'
      '110481610=         F.OKPO,'
      '110481611=         F.IDN,'
      
        '110481612=         COALESCE(F.NAME, '#39#39#39#39')||DECODE(D.doc_type, 3,' +
        ' COALESCE('#39#39', '#1048#1048#1053'/'#1041#1048#1053#39#39'||F.idn, '#39#39#39#39'), '#39#39#39#39')||COALESCE('#39#39', '#39#39'||F' +
        'D.ADDRESS, '#39#39#39#39'),'
      
        '110481613=         DECODE(CHAR_LENGTH(c.name_FULL), 0, C.NAME, c' +
        '.name_FULL),'
      '110481614=         GD.address,'
      '110481615=         GA.account,'
      '110481616=         C.IDN,'
      
        '110481617=         DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39#39#39 +
        ')), 0, C.NAME, c.name_FULL)||DECODE(D.doc_type, 3, COALESCE('#39#39', ' +
        #1048#1048#1053'/'#1041#1048#1053#39#39'||C.idn, '#39#39#39#39'), '#39#39#39#39')||COALESCE('#39#39', '#39#39'||GD.ADDRESS, '#39#39#39 +
        #39'),'
      
        '110481618=         DECODE(D.doc_type, 2, O.APP_NAME||'#39#39' '#39#39', '#39#39#39#39 +
        ')||O.fio_doc,'
      '110481619=         O.G_ID_KIND,'
      '110481620=         O.ID_NUM,'
      
        '110481621=         lpad(EXTRACT(DAY FROM O.ID_DATE), 2, '#39#39'0'#39#39')||' +
        #39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM O.ID_DATE), 2, 0)||'#39#39'.'#39#39'||EXTRACT' +
        '(YEAR FROM O.ID_DATE),'
      '110481622=         '#39#39#1074#1099#1076#1072#1085' '#39#39'||O.ID_ISSUER,'
      '110481623=         O.APP_NAME,'
      '110481624=         O1.FIO_DOC,'
      '110481625=         COALESCE(O2.FIO_DOC, '#39#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39#39'),'
      '110481626=         D.note,'
      '110481627=         D.param1,'
      '110481628=         D.param2,'
      '110481629=         D.param3,'
      '110481630=         D.param4,'
      '110481631=         D.param5,'
      '110481632=         D.PARAM6'
      '110481633=  FROM docs D'
      
        '110481634=       LEFT OUTER JOIN G_FIRM_ADDRESS FD ON FD.g_addre' +
        'ss = D.g_firm_address'
      
        '110481635=       LEFT outer JOIN (SELECT GG.G_ACCOUNT, GG.accoun' +
        't, GB.name||'#39#39', '#1041#1048#1050' '#39#39'||GB.BIK BANK_NAME FROM G_FIRM_ACCOUNT GG,' +
        ' G_BANK GB WHERE GG.g_bank = GB.g_bank) FA ON FA.g_account = D.g' +
        '_firm_account'
      
        '110481636=       LEFT outer JOIN G_ADDRESS GD ON GD.g_address = ' +
        'D.g_client_address'
      
        '110481637=       LEFT outer JOIN G_ACCOUNT GA ON GA.g_account = ' +
        'D.g_client_account'
      
        '110481638=       LEFT outer JOIN (SELECT OO.G_OFFICIAL, OO.FIO_D' +
        'OC, OO.G_ID_KIND, OO.ID_NUM, OO.ID_DATE, OO.ID_ISSUER, APP.NAME ' +
        'APP_NAME FROM G_OFFICIAL OO, G_APPOINTMENT APP WHERE OO.G_APPOIN' +
        'TMENT = APP.G_APPOINTMENT) O ON O.g_official = D.g_official'
      
        '110481639=       LEFT outer JOIN G_OFFICIAL O1 ON O1.g_official ' +
        '= D.G_OFFICIAL_RUKOVOD'
      
        '110481640=       LEFT outer JOIN G_OFFICIAL O2 ON O2.g_official ' +
        '= D.GLAVBUH,'
      '110481641=       G_FIRM_REKVIZIT F,'
      '110481642=       g_client C'
      '110481643= WHERE D.DOCS = :DOC_'
      '110481644=   AND D.g_firm = F.g_firm_rekvizit'
      '110481645=   AND D.G_CLIENT = C.g_client'
      '110481646=  into :num_,'
      '110481647=       :DOCS_DATE_,'
      '110481648=       :g_firm_,'
      '110481649=       :g_firm_address_,'
      '110481650=       :g_firm_account_,'
      '110481651=       :G_FIRM_BANK_,'
      '110481652=       :G_FIRM_OKPO_,'
      '110481653=       :G_FIRM_BIN_,'
      '110481654=       :g_firm_AND_ADDRESS_,'
      '110481655=       :g_client_,'
      '110481656=       :g_client_address_,'
      '110481657=       :g_client_account_,'
      '110481658=       :G_CLIENT_BIN_,'
      '110481659=       :G_CLIENT_AND_ADDRESS_,'
      '110481660=       :g_official_,'
      '110481661=       :G_OFFICIAL_ID_KIND_,'
      '110481662=       :G_OFFICIAL_ID_NUM_,'
      '110481663=       :G_OFFICIAL_ID_DATE_,'
      '110481664=       :G_OFFICIAL_ID_ISSUER_,'
      '110481665=       :APPOINTMENT_,'
      '110481666=       :RUKOVODITEL_,'
      '110481667=       :GLAVBUH_,'
      '110481668=       :note_,'
      '110481669=       :param1_,'
      '110481670=       :param2_,'
      '110481671=       :param3_,'
      '110481672=       :param4_,'
      '110481673=       :param5_,'
      '110481674=       :BL_;'
      '110481675='
      '110481676=  IF (DOC_TYPE_ <> 2) THEN BEGIN'
      
        '110481677=      SELECT REPLACE(CAST(SUM(ZD.SUMM) AS VARCHAR(10))' +
        ', '#39#39'.'#39#39', '#39#39','#39#39'),'
      '110481678=             SUM(ZD.AMOUNT),'
      
        '110481679=             (SELECT CURR_STR from CURRENCYSTR(SUM(ZD.' +
        'SUMM), :CURRENCY_))'
      '110481680=        FROM ZAKAZ Z,'
      '110481681=             ZAKAZ_DETAILS ZD'
      '110481682=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110481683=         AND Z.ZAKAZ = ZD.ZAKAZ'
      '110481684=        INTO :SUMM_,'
      '110481685=             :AMOUNT_,'
      '110481686=             :SUMM_STR_;'
      '110481687='
      '110481688=      FOR'
      '110481689=        SELECT :I,'
      '110481690=               G.NAME||DECODE(G.articul,'
      '110481691=                              NULL, '#39#39#39#39','
      '110481692=                              '#39#39#39#39', '#39#39#39#39','
      '110481693=                              '#39#39', '#1072#1088#1090'. '#39#39'||G.articul),'
      '110481694=               U.SHORT_NAME,'
      '110481695=               G.barcode,'
      '110481696=               CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '110481697=               REPLACE(CAST((ZD.PRICE - COALESCE(ZD.DI' +
        'SCOUNT_TENGE, 0)) AS VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '110481698=               REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39 +
        #39'.'#39#39', '#39#39','#39#39'),'
      
        '110481699=               lpad(EXTRACT(DAY FROM Z.z_date), 2, '#39#39'0' +
        #39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM Z.z_date), 2, 0)||'#39#39'.'#39#39'||EXT' +
        'RACT(YEAR FROM Z.z_date)'
      '110481700=          FROM ZAKAZ Z,'
      '110481701=               ZAKAZ_DETAILS ZD,'
      '110481702=               G_PRODUCT G,'
      '110481703=               G_UNIT U'
      '110481704=         WHERE Z.ZAKAZ = :ZAKAZ_'
      '110481705=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110481706=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110481707=           AND G.G_UNIT = U.G_UNIT'
      '110481708=        INTO :ROW_NUM,'
      '110481709=            :NAME,'
      '110481710=            :UNIT_NAME,'
      '110481711=            :BARCODE,'
      '110481712=            :AMOUNT,'
      '110481713=            :PRICE,'
      '110481714=            :SUMM,'
      '110481715=            :ZDATE'
      '110481716=      DO BEGIN'
      '110481717=        I = I + 1;'
      '110481718=        SUSPEND;'
      '110481719=      END'
      '110481720=  END'
      '110481721=  ELSE BEGIN'
      
        '110481722=          POS_ = POSITION('#39#39'<amount_itog_val>'#39#39' IN BL_' +
        ');       --'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110481723=          POS2_ = POSITION('#39#39'</amount_itog_val>'#39#39' IN B' +
        'L_);     --'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110481724=          STR_  = SUBSTRING(BL_ FROM POS_+17 FOR POS2_' +
        ' - POS_-17);'
      
        '110481725=          AMOUNT_ = STR_||'#39#39' ('#39#39'||(SELECT CURR_STR fro' +
        'm CURRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39#39')'#39#39'; -- -1 -' +
        ' '#1053#1045' '#1055#1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '110481726='
      '110481727=          WHILE (I > 0) DO BEGIN'
      '110481728=            ROW_NUM = I;'
      
        '110481729=            POS_ = POSITION('#39#39'<id>'#39#39' IN BL_);     --'#1055#1056 +
        #1054#1055#1059#1057#1050#1040#1070' '#1042#1057#1045', '#1048' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1061#1054#1046#1059' '#1050' ID'
      
        '110481730=            POS2_ = POSITION('#39#39'</id>'#39#39' IN BL_);     --' +
        #1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110481731=            STR_ = SUBSTRING(BL_ FROM POS_+4 FOR POS2_' +
        ' - POS_-4);'
      '110481732=            g_product_ = CAST(STR_ AS INTEGER);'
      '110481733='
      
        '110481734=            POS_ = POSITION('#39#39'<name>'#39#39' IN BL_);       ' +
        '--'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110481735=            POS2_ = POSITION('#39#39'</name>'#39#39' IN BL_);     ' +
        '--'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110481736=            NAME = SUBSTRING(BL_ FROM POS_+6 FOR POS2_' +
        ' - POS_-6);'
      '110481737='
      
        '110481738=            POS_ = POSITION('#39#39'<amount>'#39#39' IN BL_);     ' +
        '  --'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110481739=            POS2_ = POSITION('#39#39'</amount>'#39#39' IN BL_);   ' +
        '  --'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110481740=            STR_  = SUBSTRING(BL_ FROM POS_+8 FOR POS2' +
        '_ - POS_-8);'
      
        '110481741=            AMOUNT = STR_||'#39#39' ('#39#39'||(SELECT CURR_STR fr' +
        'om CURRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39#39')'#39#39'; -- -1 ' +
        '- '#1053#1045' '#1055#1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '110481742='
      '110481743=            SELECT U.short_name'
      '110481744=              FROM G_PRODUCT G, G_UNIT U'
      '110481745=             WHERE G.g_unit = U.g_unit'
      '110481746=               AND G.g_product = :G_PRODUCT_'
      '110481747=              INTO :UNIT_NAME;'
      '110481748='
      
        '110481749=            --'#1085#1072#1093#1086#1078#1091' '#1090#1077#1075', '#1079#1072#1082#1088#1099#1074#1072#1102#1097#1080#1081' '#1090#1077#1075' '#1090#1086#1074#1072#1088#1072', '#1080' '#1091#1076 +
        #1072#1083#1103#1102' '#1101#1090#1086#1090' '#1090#1086#1074#1072#1088' '#1080#1079' '#1089#1087#1080#1089#1082#1072
      '110481750=            I = I + 1;'
      '110481751=            POS_ = POSITION('#39#39'</tovar>'#39#39' IN BL_);'
      
        '110481752=            BL_ = SUBSTRING(BL_ FROM POS_ + 8 FOR char' +
        '_length(BL_)-POS_);'
      '110481753=            IF (POSITION('#39#39'<tovar>'#39#39' IN BL_) = 0) THEN'
      '110481754=              I = -1;'
      '110481755='
      '110481756=            SUSPEND;'
      '110481757=          END'
      '110481758=  END'
      '110481759='
      '110481760=WHEN ANY DO BEGIN'
      '110481761=    Err_code = -20500;'
      
        '110481762=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110481763=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110481764=  END'
      '110481765=end'
      '110481766='#39';'
      '110481767=END  --END_EXECUTE_BLOCK'
      '110481768=EXECUTE BLOCK AS BEGIN'
      '110481769='
      '110481770=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_INVOICE('
      '110481771=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '110481772=  CURRENCY_ INTEGER)'
      '110481773=RETURNS ('
      '110481774=  NUM_ VARCHAR(50),'
      '110481775=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '110481776=  POSTAVSHIK_IDN_ADDRESS_ VARCHAR(1000),'
      '110481777=  ACCOUNT_ VARCHAR(500),'
      '110481778=  AGREEMENT_ VARCHAR(500),'
      '110481779=  G_PAYMENT_TYPE_ VARCHAR(1000),'
      '110481780=  PUNKT_ VARCHAR(1000),'
      '110481781=  DOVERKA_ VARCHAR(1000),'
      '110481782=  SPOSOB_OTPRAVKI_ VARCHAR(1000),'
      '110481783=  NAKLADNAYA_ VARCHAR(1000),'
      '110481784=  GRUZOOTPRAVITEL_ VARCHAR(1000),'
      '110481785=  GRUZOPOLUCHATEL_ VARCHAR(1000),'
      '110481786=  POLUCHATEL_ VARCHAR(1000),'
      '110481787=  POLUCHATEL_ADDRESS_ VARCHAR(1000),'
      '110481788=  POLUCHATEL_IIK_ VARCHAR(1000),'
      '110481789=  RUKOVODITEL_ VARCHAR(1000),'
      '110481790=  GLAVBUH_ VARCHAR(1000),'
      '110481791=  ISPOLNITEL_APP_ VARCHAR(1000),'
      '110481792=  ISPOLNITEL_ VARCHAR(1000),'
      '110481793=  NUM_W_ VARCHAR(20),'
      '110481794=  DATE_ VARCHAR(20),'
      '110481795=  IDN_KPP_POST_ VARCHAR(30),'
      '110481796=  IDN_KPP_POLUCH_ VARCHAR(30),'
      '110481797=  CURR_STR_ VARCHAR(15),'
      '110481798=  ROW_NUM VARCHAR(10),'
      '110481799=  NAME VARCHAR(1000),'
      '110481800=  SHORT_NAME VARCHAR(1000),'
      '110481801=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110481802=  AMOUNT MY_NUMERIC_5,'
      '110481803=  PRICE VARCHAR(500),'
      '110481804=  WITHOUT_NDS VARCHAR(500),'
      '110481805=  NDS VARCHAR(500),'
      '110481806=  NDS_SUMM VARCHAR(500),'
      '110481807=  SUMM VARCHAR(500),'
      '110481808=  STOIM_TOVAROV_ VARCHAR(500),'
      '110481809=  SUMM_NDS_ VARCHAR(500),'
      '110481810=  SUMM_VSEGO_ VARCHAR(500),'
      '110481811=  ERR_CODE INTEGER,'
      '110481812=  ERR_MSG VARCHAR(1024))'
      '110481813=AS'
      
        '110481814=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_INVOIC' +
        'E'#39#39';'
      '110481815=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110481816=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110481817=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVIZ' +
        'IT.NOL_VMESTO_BEZ;'
      
        '110481818=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REKV' +
        'IZIT.NDS_VALUE;'
      '110481819=DECLARE VARIABLE I INTEGER = 1;'
      
        '110481820=DECLARE VARIABLE ZSUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM;'
      '110481821=BEGIN'
      '110481822='
      '110481823=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      
        '110481824=  SELECT DECODE(:CURRENCY_, 0, '#39#39#1055#1086#1089#1090#1072#1074#1097#1080#1082': '#39#39', '#39#39#39#39')|' +
        '|I.POSTAVSHIK,'
      '110481825=         DECODE(:CURRENCY_,'
      
        '110481826=                0, DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, ' +
        #39#39#1041#1048#1053#39#39')||'#39#39' '#1080' '#1077#1075#1086' '#1072#1076#1088#1077#1089': '#39#39'||DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1,' +
        ' '#39#39#1041#1048#1053#39#39')||'#39#39': '#39#39'||G.IDN||'#39#39', '#39#39','
      
        '110481827=                '#39#39#39#39')||I.POSTAVSHIK||'#39#39', '#39#39'||FD.ADDRES' +
        'S||'
      
        '110481828=                DECODE(G.is_nds, 1, '#39#39'. '#1057#1074#1080#1076#1077#1090#1077#1083#1100#1089#1090#1074#1086' ' +
        #1086' '#1087#1086#1089#1090#1072#1085#1086#1074#1082#1077' '#1085#1072' '#1088#1077#1075#1080#1089#1090#1088#1072#1094#1080#1086#1085#1085#1099#1081' '#1091#1095#1077#1090' '#1087#1086' '#1053#1044#1057': '#1057#1077#1088#1080#1103' '#39#39'||G.nds_ser' +
        'ial'
      
        '110481829=                       ||'#39#39', '#8470#39#39'||G.nds_num||'#39#39' '#1086#1090' '#39#39'|' +
        '|EXTRACT(DAY from g.nds_date)||'#39#39'.'#39#39'||EXTRACT(MONTH from g.nds_d' +
        'ate)||'#39#39'.'#39#39'||EXTRACT(YEAR from g.nds_date), '#39#39#39#39'),'
      
        '110481830=         '#39#39#1048#1048#1050' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1072': '#39#39'||FC.ACCOUNT||'#39#39' '#1074' '#39#39'||FB' +
        '.NAME||'#39#39', '#1041#1048#1050': '#39#39'||FB.BIK,'
      
        '110481831=         '#39#39#1044#1086#1075#1086#1074#1086#1088' ('#1082#1086#1085#1090#1088#1072#1082#1090') '#1085#1072' '#1087#1086#1089#1090#1072#1074#1082#1091' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073 +
        #1086#1090', '#1091#1089#1083#1091#1075'): '#39#39'||COALESCE(TRIM(I.AGREEMENT), '#39#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39#39'),'
      
        '110481832=         '#39#39#1059#1089#1083#1086#1074#1080#1103' '#1086#1087#1083#1072#1090#1099' '#1087#1086' '#1076#1086#1075#1086#1074#1086#1088#1091' ('#1082#1086#1085#1090#1088#1072#1082#1090#1091'): '#39#39'|' +
        '|GP.NAME,'
      
        '110481833=         '#39#39#1055#1091#1085#1082#1090' '#1085#1072#1079#1085#1072#1095#1077#1085#1080#1103' '#1087#1086#1089#1090#1072#1074#1083#1103#1077#1084#1099#1093' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086 +
        #1090', '#1091#1089#1083#1091#1075'): '#39#39'||I.PUNKT_NAZNACHENIYA,'
      
        '110481834=         '#39#39#1055#1086#1089#1090#1072#1074#1082#1072' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086#1090','#1091#1089#1083#1091#1075') '#1086#1089#1091#1097#1077#1089#1090#1074#1083#1077#1085#1072 +
        ' '#1087#1086' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080': '#39#39'||I.DOVERENNOST,'
      '110481835=         '#39#39#1057#1087#1086#1089#1086#1073' '#1086#1090#1087#1088#1072#1074#1083#1077#1085#1080#1103': '#39#39'||I.SPOSOB_OTPRAVKI,'
      
        '110481836=         '#39#39#1058#1086#1074#1072#1088#1085#1086'-'#1090#1088#1072#1085#1089#1087#1086#1088#1090#1085#1072#1103' '#1085#1072#1082#1083#1072#1076#1085#1072#1103': '#39#39'||I.NAKLA' +
        'DNAYA,'
      
        '110481837=         DECODE(:CURRENCY_, 0, '#39#39#1043#1088#1091#1079#1086#1086#1090#1087#1088#1072#1074#1080#1090#1077#1083#1100': '#39#39',' +
        ' '#39#39#39#39')||I.GRUZOOTPRAVITEL,'
      
        '110481838=         DECODE(:CURRENCY_, 0, '#39#39#1043#1088#1091#1079#1086#1087#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39#39', ' +
        #39#39#39#39')||I.GRUZOPOLUCHATEL,'
      
        '110481839=         DECODE(:CURRENCY_, 0, '#39#39#1055#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39#39', '#39#39#39#39')' +
        '||I.CLIENT_NAME,'
      '110481840=         DECODE(:CURRENCY_,'
      
        '110481841=                0, '#39#39#1048#1048#1053'/'#1041#1048#1053' '#1080' '#1072#1076#1088#1077#1089' '#1084#1077#1089#1090#1086#1085#1072#1093#1086#1078#1076#1077#1085#1080#1103' '#1087 +
        #1086#1083#1091#1095#1072#1090#1077#1083#1103': '#39#39'||COALESCE(I.IDN_CLIENT, '#39#39#39#39'),'
      
        '110481842=                '#39#39#39#39')||COALESCE('#39#39', '#39#39'||AD.ADDRESS, '#39#39 +
        #39#39'),'
      
        '110481843=         '#39#39#1048#1048#1050' '#1087#1086#1083#1091#1095#1072#1090#1077#1083#1103': '#39#39'||COALESCE(CC.ACCOUNT||'#39#39 +
        ' '#1074' '#39#39'||CC.NAME||'#39#39', '#1041#1048#1050': '#39#39'||CC.BIK, '#39#39#39#39'),'
      '110481844=         RO.FIO_DOC,'
      '110481845=         COALESCE(GO.FIO_DOC, '#39#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39#39'),'
      '110481846=         AP.NAME,'
      '110481847=         IO.FIO_DOC,'
      
        '110481848=         '#39#39#1057#1095#1077#1090'-'#1092#1072#1082#1090#1091#1088#1072' '#8470#39#39'||I.NUM||'#39#39' '#1086#1090' '#39#39'||EXTRACT(' +
        'DAY FROM I.INIT_DATE)||'#39#39' '#39#39'||'
      
        '110481849=           (SELECT * FROM GET_RUSSIAN_MONTH(EXTRACT(MO' +
        'NTH FROM I.INIT_DATE), 1))||'#39#39' '#39#39'||EXTRACT(YEAR FROM I.INIT_DATE' +
        ')||'#39#39' '#1075'.'#39#39','
      '110481850=         I.ZAKAZ,'
      '110481851=         -- '#1044#1051#1071' '#1056#1054#1057#1057#1048#1049#1057#1050#1054#1049' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1067
      '110481852=         I.NUM,'
      
        '110481853=         EXTRACT(DAY FROM I.INIT_DATE)||'#39#39' '#39#39'||(SELECT' +
        ' * FROM GET_RUSSIAN_MONTH(EXTRACT(MONTH FROM I.INIT_DATE), 1))||' +
        #39#39' '#39#39'||EXTRACT(YEAR FROM I.INIT_DATE)||'#39#39' '#1075'.'#39#39','
      '110481854=         G.IDN||'#39#39'/'#39#39'||G.KPP,'
      '110481855=         G.nol_vmesto_bez,'
      '110481856=         G.NDS_VALUE,'
      '110481857=         I.IDN_CLIENT,'
      
        '110481858=         DECODE(:CURRENCY_, 1, '#39#39#1056#1091#1073#1083#1100', 643'#39#39', 2, '#39#39#1043#1088 +
        #1080#1074#1085#1072', 980'#39#39')'
      '110481859=    FROM INVOICE I'
      
        '110481860=           LEFT OUTER JOIN G_OFFICIAL RO ON I.G_OFFICI' +
        'AL_RUKOVOD = RO.G_OFFICIAL'
      
        '110481861=           LEFT OUTER JOIN G_OFFICIAL GO ON I.G_OFFICI' +
        'AL_GB = GO.G_OFFICIAL'
      
        '110481862=           LEFT OUTER JOIN G_ADDRESS  AD ON I.ADDRESS_' +
        'POKUPATEL = AD.G_ADDRESS'
      
        '110481863=           LEFT OUTER JOIN (SELECT GA.g_account, GA.ac' +
        'count, CB.name, CB.BIK'
      
        '110481864=                            FROM g_account GA, g_bank ' +
        'CB WHERE GA.g_bank = CB.g_bank) CC ON I.IIK_CLIENT = CC.G_ACCOUN' +
        'T,'
      '110481865=         G_FIRM_REKVIZIT G,'
      '110481866=         G_FIRM_ACCOUNT  FC,'
      '110481867=         G_FIRM_ADDRESS  FD,'
      '110481868=         G_BANK          FB,'
      '110481869=         ---'
      '110481870=         G_PAYMENT_TYPE  GP,'
      '110481871=         G_OFFICIAL      IO,'
      '110481872=         G_APPOINTMENT   AP'
      '110481873=   WHERE I.INVOICE = :INVOICE_'
      
        '110481874=     AND ((I.g_firm = G.g_firm_rekvizit AND I.g_firm I' +
        'S NOT NULL) OR (G.is_default = 1 AND I.g_firm IS NULL))  -- '#1044#1054' 0' +
        '2.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '110481875=     AND I.ADDRESS = FD.G_ADDRESS'
      '110481876=     AND I.IIK = FC.G_ACCOUNT'
      '110481877=     AND FC.G_BANK = FB.G_BANK'
      '110481878=     AND I.G_PAYMENT_TYPE = GP.G_PAYMENT_TYPE'
      '110481879=     AND I.G_OFFICIAL = IO.G_OFFICIAL'
      '110481880=     AND IO.G_APPOINTMENT = AP.G_APPOINTMENT'
      '110481881=   INTO  :POSTAVSHIK_NAME_,'
      '110481882=         :POSTAVSHIK_IDN_ADDRESS_,'
      '110481883=         :ACCOUNT_,'
      '110481884=         :AGREEMENT_,'
      '110481885=         :G_PAYMENT_TYPE_,'
      '110481886=         :PUNKT_,'
      '110481887=         :DOVERKA_,'
      '110481888=         :SPOSOB_OTPRAVKI_,'
      '110481889=         :NAKLADNAYA_,'
      '110481890=         :GRUZOOTPRAVITEL_,'
      '110481891=         :GRUZOPOLUCHATEL_,'
      '110481892=         :POLUCHATEL_,'
      '110481893=         :POLUCHATEL_ADDRESS_,'
      '110481894=         :POLUCHATEL_IIK_,'
      '110481895=         :RUKOVODITEL_,'
      '110481896=         :GLAVBUH_,'
      '110481897=         :ISPOLNITEL_APP_,'
      '110481898=         :ISPOLNITEL_,'
      '110481899=         :NUM_,'
      '110481900=         :ZAKAZ_,'
      '110481901=         :NUM_W_,'
      '110481902=         :DATE_,'
      '110481903=         :IDN_KPP_POST_,'
      '110481904=         :BEZ_NDS_,'
      '110481905=         :NDS_VALUE_,'
      '110481906=         :IDN_KPP_POLUCH_,'
      '110481907=         :CURR_STR_;'
      '110481908='
      '110481909=  SELECT Z.SUMM'
      '110481910=    FROM ZAKAZ Z'
      '110481911=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110481912=    INTO :ZSUMM_;'
      '110481913='
      
        '110481914=  STOIM_TOVAROV_ = REPLACE(CAST(ROUND(ZSUMM_/(1 + :NDS' +
        '_VALUE_/100), 2) AS VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39');'
      '110481915=  IF (ZSUMM_ <> 0) then'
      
        '110481916=    SUMM_NDS_    = REPLACE(CAST(CAST(ROUND(ZSUMM_ * ND' +
        'S_VALUE_/(100 + NDS_VALUE_), 2) AS NUMERIC(15,2)) AS VARCHAR(10)' +
        '), '#39#39'.'#39#39', '#39#39','#39#39');'
      '110481917=  ELSE'
      '110481918=    SUMM_NDS_    = '#39#39#39#39';'
      
        '110481919=  SUMM_VSEGO_    = REPLACE(CAST(ZSUMM_ AS VARCHAR(10))' +
        ', '#39#39'.'#39#39', '#39#39','#39#39');'
      '110481920='
      '110481921=  FOR'
      '110481922=    SELECT :I,'
      '110481923=           G.NAME||DECODE(G.articul,'
      '110481924=                          NULL, '#39#39#39#39','
      '110481925=                          '#39#39#39#39', '#39#39#39#39','
      '110481926=                          '#39#39', '#1072#1088#1090'. '#39#39'||G.articul),'
      '110481927=           U.SHORT_NAME,'
      '110481928=           G.barcode,'
      '110481929=           CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '110481930=           REPLACE(CAST(ROUND((ZD.PRICE - COALESCE(ZD.' +
        'DISCOUNT_TENGE, 0))/(1 + :NDS_VALUE_/100), 2) AS VARCHAR(10)), '#39 +
        #39'.'#39#39', '#39#39','#39#39'),'
      
        '110481931=           REPLACE(CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE_' +
        '/100), 2) AS VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      '110481932=           DECODE(:NDS_VALUE_,'
      
        '110481933=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053#1045 +
        ' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '110481934=                             0, '#39#39#1041#1077#1079' '#1053#1044#1057#39#39','
      '110481935=                             '#39#39'0,00'#39#39'),'
      
        '110481936=                   REPLACE(CAST(:NDS_VALUE_ AS VARCHAR' +
        '(10)), '#39#39'.'#39#39', '#39#39','#39#39')),'
      
        '110481937=           REPLACE(CAST(DECODE(ZD.SUMM, 0, NULL, ZD.SU' +
        'MM - CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,' +
        '2))) AS VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '110481938=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39#39'.'#39#39 +
        ', '#39#39','#39#39')'
      '110481939=      FROM ZAKAZ Z,'
      '110481940=           ZAKAZ_DETAILS ZD,'
      '110481941=           G_PRODUCT G,'
      '110481942=           G_UNIT U'
      '110481943=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110481944=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110481945=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110481946=       AND G.G_UNIT = U.G_UNIT'
      '110481947=    INTO :ROW_NUM,'
      '110481948=        :NAME,'
      '110481949=        :SHORT_NAME,'
      '110481950=        :BARCODE,'
      '110481951=        :AMOUNT,'
      '110481952=        :PRICE,'
      '110481953=        :WITHOUT_NDS,'
      '110481954=        :NDS,'
      '110481955=        :NDS_SUMM,'
      '110481956=        :SUMM'
      '110481957=  DO BEGIN'
      '110481958=    I = I + 1;'
      '110481959=    SUSPEND;'
      '110481960=  END'
      '110481961='
      '110481962=WHEN ANY DO BEGIN'
      '110481963=    Err_code = -20500;'
      
        '110481964=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110481965=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110481966=  END'
      '110481967=end'
      '110481968='#39';'
      '110481969='
      '110481970=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_INVOICE_PAY('
      '110481971=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '110481972=  CURRENCY_ INTEGER)'
      '110481973=RETURNS ('
      '110481974=  NUM_ VARCHAR(500),'
      '110481975=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '110481976=  POSTAVSHIK_IDN_ VARCHAR(20),'
      '110481977=  POSTAVSHIK_IDN_SELF_ VARCHAR(20),'
      '110481978=  POSTAVSHIK_KPP_ VARCHAR(20),'
      '110481979=  ACCOUNT_ VARCHAR(50),'
      '110481980=  KBE_ VARCHAR(50),'
      '110481981=  BANK_ VARCHAR(1000),'
      '110481982=  BIK_ VARCHAR(20),'
      '110481983=  KNP_ VARCHAR(20),'
      '110481984=  POSTAVSHIK_ VARCHAR(1000),'
      '110481985=  POKUPATEL_ VARCHAR(1000),'
      '110481986=  AGREEMENT_ VARCHAR(500),'
      '110481987=  SUMM_ VARCHAR(100),'
      '110481988=  NDS_ VARCHAR(100),'
      '110481989=  VSEGO_NAIM_ VARCHAR(500),'
      '110481990=  VSEGO_K_OPLATE_ VARCHAR(500),'
      '110481991=  ISPOLNITEL_ VARCHAR(500),'
      '110481992=  ISPOLNITEL_APP_ VARCHAR(500),'
      '110481993=  RUKOVODITEL_ VARCHAR(500),'
      '110481994=  RUKOVODITEL_APP_ VARCHAR(500),'
      '110481995=  ROW_NUM VARCHAR(100),'
      '110481996=  ARTICUL VARCHAR(30),'
      '110481997=  NAME VARCHAR(500),'
      '110481998=  AMOUNT MY_NUMERIC_5,'
      '110481999=  SHORT_NAME VARCHAR(1000),'
      '110482000=  PRICE VARCHAR(500),'
      '110482001=  SUMM VARCHAR(500),'
      '110482002=  ERR_CODE INTEGER,'
      '110482003=  ERR_MSG VARCHAR(1024))'
      '110482004=AS'
      
        '110482005=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_INVOIC' +
        'E_PAY'#39#39';'
      '110482006=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110482007=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110482008=DECLARE VARIABLE IS_PAY_NDS_ TYPE OF COLUMN G_FIRM_REK' +
        'VIZIT.IS_NDS;'
      
        '110482009=DECLARE VARIABLE NOL_VMESTO_NDS_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.NOL_VMESTO_BEZ;'
      
        '110482010=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REKV' +
        'IZIT.NDS_VALUE;'
      '110482011=DECLARE VARIABLE I INTEGER = 1;'
      '110482012=DECLARE VARIABLE VAL_STR_ VARCHAR(20);'
      '110482013=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      '110482014=BEGIN'
      '110482015=  SELECT I.POSTAVSHIK,'
      
        '110482016=         DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, '#39#39#1041#1048#1053#39#39')||' +
        #39#39': '#39#39'||G.IDN,'
      '110482017=         G.IDN,'
      '110482018=         G.KPP,'
      '110482019=         AC.ACCOUNT,'
      '110482020=         I.KBE,'
      '110482021=         I.BANK_NAME,  -- '#1041#1072#1085#1082' '#1073#1077#1085#1077#1092#1080#1094#1080#1072#1088#1072':'
      '110482022=         I.BIK,        -- '#1041#1048#1050
      '110482023=         I.KNP,  -- '#1050#1086#1076' '#1085#1072#1079#1085#1072#1095#1077#1085#1080#1103' '#1087#1083#1072#1090#1077#1078#1072
      
        '110482024=         DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, '#39#39#1041#1048#1053#39#39')||' +
        #39#39': '#39#39'||G.IDN||'#39#39', '#39#39'||I.POSTAVSHIK||'#39#39', '#39#39'||AD.ADDRESS,'
      
        '110482025=         DECODE(char_length(TRIM(I.IDN_CLIENT)), 0, '#39#39 +
        #39#39', '#39#39#1048#1048#1053'/'#1041#1048#1053': '#39#39'||I.IDN_CLIENT||'#39#39', '#39#39')||I.G_CLIENT||COALESCE('#39 +
        #39', '#39#39'||ADC.ADDRESS, '#39#39#39#39'),'
      
        '110482026=         COALESCE(TRIM(I.AGREEMENT), '#39#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39#39')' +
        ','
      '110482027=         I.ZAKAZ,'
      '110482028=         '#39#39'/'#39#39'||O.FIO_DOC||'#39#39'/'#39#39','
      '110482029=         A.NAME,'
      '110482030=         G.IS_NDS,'
      '110482031=         G.NDS_VALUE,'
      '110482032=         G.NOL_VMESTO_BEZ,'
      
        '110482033=         '#39#39#1057#1095#1077#1090' '#1085#1072' '#1086#1087#1083#1072#1090#1091' '#8470#39#39'||I.NUM||'#39#39' '#1086#1090' '#39#39'||EXTRAC' +
        'T(DAY FROM I.INIT_DATE)||'#39#39' '#39#39'||'
      
        '110482034=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM I.INIT_DATE), 1))||'#39#39' '#39#39'||EXTRACT(YEAR FROM I.' +
        'INIT_DATE)||'#39#39' '#1075'.'#39#39
      
        '110482035=    FROM INVOICE_PAY I LEFT OUTER JOIN G_ADDRESS ADC O' +
        'N I.address_pokupatel = ADC.g_address,'
      '110482036=         G_FIRM_REKVIZIT G,'
      '110482037=         (SELECT *'
      '110482038=            FROM G_FIRM_ACCOUNT) AC,'
      '110482039=         (SELECT *'
      '110482040=            FROM G_FIRM_ADDRESS) AD,'
      '110482041=         G_OFFICIAL O,'
      '110482042=         G_APPOINTMENT A'
      '110482043=   WHERE I.INVOICE_PAY = :INVOICE_PAY_'
      
        '110482044=     AND ((I.g_firm = G.g_firm_rekvizit AND I.g_firm I' +
        'S NOT NULL) OR (G.is_default = 1 AND I.g_firm IS NULL))  -- '#1044#1054' 0' +
        '2.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '110482045=     AND I.ADDRESS = AD.G_ADDRESS'
      '110482046=     AND I.IIK = AC.G_ACCOUNT'
      '110482047=     AND I.G_OFFICIAL = O.G_OFFICIAL'
      '110482048=     AND O.G_APPOINTMENT = A.G_APPOINTMENT'
      '110482049=  INTO :POSTAVSHIK_NAME_,'
      '110482050=       :POSTAVSHIK_IDN_,'
      '110482051=       :POSTAVSHIK_IDN_SELF_,'
      '110482052=       :POSTAVSHIK_KPP_,'
      '110482053=         :ACCOUNT_,'
      '110482054=         :KBE_,'
      '110482055=         :BANK_,'
      '110482056=         :BIK_,'
      '110482057=         :KNP_,'
      '110482058=         :POSTAVSHIK_,'
      '110482059=         :POKUPATEL_,'
      '110482060=         :AGREEMENT_,'
      '110482061=         :ZAKAZ_,'
      '110482062=         :ISPOLNITEL_,'
      '110482063=         :ISPOLNITEL_APP_,'
      '110482064=         :IS_PAY_NDS_,'
      '110482065=         :NDS_VALUE_,'
      '110482066=         :NOL_VMESTO_NDS_,'
      '110482067=         :NUM_;'
      '110482068='
      '110482069=  SELECT '#39#39'/'#39#39'||G.FIO_DOC||'#39#39'/'#39#39','
      '110482070=         A.NAME'
      '110482071=    FROM G_OFFICIAL G,'
      '110482072=         G_APPOINTMENT A'
      '110482073=    WHERE G.IS_RUKOVODITEL = 1'
      '110482074=    AND G.G_APPOINTMENT = A.G_APPOINTMENT'
      '110482075=  INTO :RUKOVODITEL_,'
      '110482076=       :RUKOVODITEL_APP_;'
      '110482077='
      '110482078=  -- '#1053#1048#1046#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      '110482079=  SELECT CAST(Z.SUMM AS VARCHAR(20)),'
      
        '110482080=         '#39#39#1042#1089#1077#1075#1086' '#1082' '#1086#1087#1083#1072#1090#1077': '#39#39'||(SELECT CURR_STR from C' +
        'URRENCYSTR(Z.SUMM, :CURRENCY_))'
      '110482081=    FROM ZAKAZ Z'
      '110482082=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110482083=  INTO :SUMM_,'
      '110482084=       :VSEGO_K_OPLATE_;'
      '110482085='
      
        '110482086=  -- '#1042#1054' '#1060#1056#1040#1047#1045' '#1042#1057#1045#1043#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1049' '#1045#1057#1058#1068' '#1042#1040#1051#1070#1058#1040', '#1055#1054#1069#1058#1054#1052#1059' ' +
        #1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1050#1051#1054#1053#1071#1058#1068
      '110482087=  if (CURRENCY_ = 0) then'
      '110482088=    CURR_STR_ = '#39#39' '#1090#1077#1085#1075#1077#39#39';'
      '110482089=  else begin'
      '110482090=      SELECT CAST(TRUNC(SUM(Z.SUMM)) AS VARCHAR(20))'
      '110482091=        FROM ZAKAZ Z'
      '110482092=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110482093=      INTO :VAL_STR_;'
      '110482094='
      
        '110482095=      i = cast(substring(VAL_STR_ from CHAR_LENGTH(VAL' +
        '_STR_) for 1) as int);'
      '110482096='
      '110482097=      if (i=1) then begin'
      '110482098=        if (CURRENCY_ = 1) then'
      '110482099=          CURR_STR_ = '#39#39' '#1088#1091#1073#1083#1100#39#39';'
      '110482100=        else'
      '110482101=          CURR_STR_ = '#39#39' '#1075#1088#1080#1074#1085#1072#39#39';'
      '110482102='
      '110482103=      end ELSE if ((i=2) or (I=3)) then begin'
      '110482104=        if (CURRENCY_ = 1) then'
      '110482105=          CURR_STR_ = '#39#39' '#1088#1091#1073#1083#1103#39#39';'
      '110482106=        ELSE'
      '110482107=          CURR_STR_ = '#39#39' '#1075#1088#1080#1074#1085#1099#39#39';'
      '110482108=      END ELSE BEGIN'
      '110482109=        if (CURRENCY_ = 1) then'
      '110482110=          CURR_STR_ = '#39#39' '#1088#1091#1073#1083#1077#1081#39#39';'
      '110482111=        ELSE'
      '110482112=          CURR_STR_ = '#39#39' '#1075#1088#1080#1074#1077#1085#39#39';'
      '110482113=      end'
      '110482114=  end'
      '110482115='
      
        '110482116=  SELECT '#39#39#1042#1089#1077#1075#1086' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1081' '#39#39'||COUNT(ZD.ZAKAZ_DETAI' +
        'LS)||'#39#39', '#1085#1072' '#1089#1091#1084#1084#1091' '#39#39'||CAST(SUM(ZD.SUMM) AS VARCHAR(20))||:CURR_S' +
        'TR_,'
      '110482117=         DECODE(:IS_PAY_NDS_,'
      
        '110482118=                0, DECODE(:NOL_VMESTO_NDS_, 0, '#39#39#1041#1077#1079' '#1053 +
        #1044#1057#39#39', '#39#39'0,00'#39#39'),  -- '#1055#1048#1057#1040#1058#1068' "0" '#1048#1051#1048' "'#1041#1077#1079' '#1053#1044#1057'"'
      '110482119=                CAST(SUM(ZD.NDS_SUMM) AS VARCHAR(20))'
      '110482120=               )'
      '110482121=    FROM ZAKAZ Z,'
      '110482122=         ZAKAZ_DETAILS ZD'
      '110482123=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110482124=     AND Z.ZAKAZ = ZD.ZAKAZ'
      '110482125=  INTO :VSEGO_NAIM_,'
      '110482126=       :NDS_;'
      '110482127='
      '110482128=  SUMM_ = REPLACE(SUMM_, '#39#39'.'#39#39', '#39#39','#39#39');'
      '110482129=  VSEGO_NAIM_ = REPLACE(VSEGO_NAIM_, '#39#39'.'#39#39', '#39#39','#39#39');'
      '110482130='
      '110482131=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      '110482132=  I = 1;'
      '110482133=  FOR'
      '110482134=    SELECT :I,'
      '110482135=           G.NAME,'
      '110482136=           G.ARTICUL,'
      '110482137=           ZD.AMOUNT,'
      '110482138=           U.SHORT_NAME,'
      
        '110482139=           REPLACE(CAST(ZD.PRICE - ZD.DISCOUNT_TENGE A' +
        'S VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '110482140=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39#39'.'#39#39 +
        ', '#39#39','#39#39')'
      '110482141=      FROM ZAKAZ Z,'
      '110482142=           ZAKAZ_DETAILS ZD,'
      '110482143=           G_PRODUCT G,'
      '110482144=           G_UNIT U'
      '110482145=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110482146=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110482147=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110482148=       AND G.G_UNIT = U.G_UNIT'
      '110482149=   ORDER BY G.NAME, ZD.ZAKAZ_DETAILS'
      '110482150=    INTO :ROW_NUM,'
      '110482151=        :NAME,'
      '110482152=        :ARTICUL,'
      '110482153=        :AMOUNT,'
      '110482154=        :SHORT_NAME,'
      '110482155=        :PRICE,'
      '110482156=        :SUMM'
      '110482157=  DO BEGIN'
      '110482158=    I = I + 1;'
      '110482159=    SUSPEND;'
      '110482160=  END'
      '110482161='
      '110482162=WHEN ANY DO BEGIN'
      '110482163=    Err_code = -20500;'
      
        '110482164=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110482165=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110482166=  END'
      '110482167=end'
      '110482168='#39';'
      '110482169='
      '110482170=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRIHOD('
      '110482171=  DATE_BEGIN_ DATE,'
      '110482172=  DATE_END_ DATE,'
      '110482173=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110482174=RETURNS ('
      '110482175=  PERIOD_ VARCHAR(40),'
      
        '110482176=  P_REP_PRIHOD_TABLE TYPE OF COLUMN P_REP_PRIHOD_TABLE' +
        '.P_REP_PRIHOD_TABLE,'
      
        '110482177=  TOVAR_NAME TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR_N' +
        'AME,'
      '110482178=  AMOUNT TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT,'
      
        '110482179=  POSTAVSHIK TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTAVS' +
        'HIK,'
      
        '110482180=  SELF_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_PR' +
        'ICE,'
      
        '110482181=  SELF_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_SUM' +
        'M,'
      
        '110482182=  SELF_PRICE_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'PRICE_B,'
      
        '110482183=  SELF_SUMM_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_S' +
        'UMM_B,'
      '110482184=  IS_HEAD TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD,'
      '110482185=  ERR_CODE INTEGER,'
      '110482186=  ERR_MSG VARCHAR(1024))'
      '110482187=AS'
      
        '110482188=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRIHOD' +
        #39#39';'
      '110482189=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110482190=DECLARE VARIABLE SUM_NAL_ NUMERIC(15,2) = 0;'
      '110482191=DECLARE VARIABLE SUM_BEZNAL_ NUMERIC(15,2) = 0;'
      '110482192=DECLARE VARIABLE AMOUNT_CATEGORY_ MY_NUMERIC_5 = 0;'
      '110482193=DECLARE VARIABLE SUM_NAL_CATEGORY_ NUMERIC(15,2) = 0;'
      
        '110482194=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ NUMERIC(15,2) = ' +
        '0;'
      '110482195=DECLARE VARIABLE SUM_FACT_NAL_ALL_ NUMERIC(15,2) = 0;'
      
        '110482196=DECLARE VARIABLE SUM_FACT_BEZNAL_ALL_ NUMERIC(15,2) = ' +
        '0;'
      '110482197=DECLARE VARIABLE PRICE_NAL_ NUMERIC(15,2) = 0;'
      '110482198=DECLARE VARIABLE PRICE_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '110482199=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110482200=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      '110482201=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110482202=DECLARE VARIABLE AMOUNT_CATEGORY_ALL_ MY_NUMERIC_5 = 0' +
        ';'
      
        '110482203=DECLARE VARIABLE SUM_NAL_CATEGORY_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '110482204=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ALL_ NUMERIC(15,2' +
        ') = 0;'
      
        '110482205=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110482206=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      '110482207=DECLARE VARIABLE I INTEGER = 1;'
      '110482208=BEGIN'
      
        '110482209=  DELETE FROM P_REP_PRIHOD_TABLE WHERE P_REP_PRIHOD_TA' +
        'BLE = P_REP_PRIHOD_TABLE;'
      '110482210='
      
        '110482211=  FOR SELECT DECODE(GP.g_product, -1, '#39#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39#39', ' +
        'GP.NAME),'
      '110482212=             GP.G_PRODUCT'
      '110482213=       FROM G_PRODUCT GP'
      '110482214=      WHERE IS_CATEGORY = 1'
      '110482215=        AND EXISTS (SELECT 1'
      
        '110482216=                      FROM SKLAD_PARENT Z, SKLAD ZD, G' +
        '_PRODUCT G'
      
        '110482217=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '110482218=                       AND Z.SKLAD =  ZD.SKLAD_PARENT'
      '110482219=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110482220=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110482221=                       AND Z.IS_VOZVRAT = 0'
      '110482222=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110482223=                       AND Z.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_)'
      '110482224=      ORDER BY 1'
      '110482225=  INTO :RECCAT_NAME_,'
      '110482226=       :RECCAT_PRODUCT_'
      '110482227=  DO BEGIN'
      '110482228=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110482229=    insert into P_REP_PRIHOD_TABLE'
      '110482230=      (P_REP_PRIHOD_TABLE, tovar_name, IS_HEAD)'
      '110482231=    values'
      '110482232=      (:I, :RECCAT_NAME_, 1);'
      '110482233='
      '110482234=    I = I + 1;'
      '110482235='
      '110482236=    FOR SELECT G.NAME,'
      '110482237=               SD.AMOUNT,'
      '110482238=               C.NAME CLIENT_NAME,'
      
        '110482239=               DECODE(S.G_PAYMENT_TYPE, 1, SD.PRICE, 0' +
        ') PRICE_NAL,'
      
        '110482240=               DECODE(S.G_PAYMENT_TYPE, 1, SD.SUMM, 0)' +
        ' SUMM_NAL,'
      
        '110482241=               DECODE(S.G_PAYMENT_TYPE, 2, SD.PRICE, 0' +
        ') PRICE_BEZNAL,'
      
        '110482242=               DECODE(S.G_PAYMENT_TYPE, 2, SD.SUMM, 0)' +
        ' SUMM_BEZNAL'
      
        '110482243=          FROM SKLAD_PARENT S LEFT OUTER JOIN G_CLIENT' +
        ' C ON S.G_CLIENT = C.G_CLIENT,'
      '110482244=               SKLAD SD,'
      '110482245=               G_PRODUCT G'
      
        '110482246=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TO' +
        'CHKA||'#39#39'-'#39#39
      '110482247=           AND S.SKLAD = SD.SKLAD_PARENT'
      '110482248=           AND SD.G_PRODUCT = G.G_PRODUCT'
      
        '110482249=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '110482250=           AND S.IS_VOZVRAT = 0'
      '110482251=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110482252=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110482253=        ORDER BY G.G_PRODUCT_PAR, S.DATE_RECEIPT, S.SK' +
        'LAD, SD.SKLAD, G.NAME'
      '110482254=    INTO :TOVAR_NAME_,'
      '110482255=         :AMOUNT_,'
      '110482256=         :CLIENT_NAME_,'
      '110482257=         :PRICE_NAL_,'
      '110482258=         :SUM_NAL_,'
      '110482259=         :PRICE_BEZNAL_,'
      '110482260=         :SUM_BEZNAL_'
      '110482261=    DO BEGIN'
      
        '110482262=      INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TAB' +
        'LE, TOVAR_NAME, AMOUNT, POSTAVSHIK, SELF_PRICE, SELF_SUMM, SELF_' +
        'PRICE_B,'
      
        '110482263=                                      SELF_SUMM_B, IS_' +
        'HEAD)'
      
        '110482264=      VALUES (:I, :TOVAR_NAME_, :AMOUNT_, :CLIENT_NAME' +
        '_, :PRICE_NAL_, :SUM_NAL_, :PRICE_BEZNAL_, :SUM_BEZNAL_, 0);'
      '110482265='
      '110482266=      I = I +1;'
      '110482267='
      
        '110482268=      AMOUNT_CATEGORY_ = AMOUNT_CATEGORY_ + COALESCE(A' +
        'MOUNT_, 0);'
      
        '110482269=      SUM_NAL_CATEGORY_ = SUM_NAL_CATEGORY_ + COALESCE' +
        '(SUM_NAL_, 0);'
      
        '110482270=      SUM_BEZNAL_CATEGORY_ = SUM_BEZNAL_CATEGORY_ + CO' +
        'ALESCE(SUM_BEZNAL_, 0);'
      '110482271=    END'
      '110482272='
      '110482273=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110482274=    INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE' +
        ', TOVAR_NAME, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110482275=    VALUES (:I, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39#39', :AMOUNT_CATEGO' +
        'RY_, :SUM_NAL_CATEGORY_, :SUM_BEZNAL_CATEGORY_, 2);'
      '110482276='
      '110482277='
      
        '110482278=    AMOUNT_CATEGORY_ALL_ = AMOUNT_CATEGORY_ALL_ + AMOU' +
        'NT_CATEGORY_;'
      
        '110482279=    SUM_NAL_CATEGORY_ALL_ = SUM_NAL_CATEGORY_ALL_ + SU' +
        'M_NAL_CATEGORY_;'
      
        '110482280=    SUM_BEZNAL_CATEGORY_ALL_ = SUM_BEZNAL_CATEGORY_ALL' +
        '_ + SUM_BEZNAL_CATEGORY_;'
      '110482281='
      '110482282=    AMOUNT_CATEGORY_ = 0;'
      '110482283=    SUM_NAL_CATEGORY_ = 0;'
      '110482284=    SUM_BEZNAL_CATEGORY_  = 0;'
      '110482285='
      '110482286=    I = I + 1;'
      '110482287=  END'
      '110482288='
      '110482289=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '110482290=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110482291=  VALUES (:I, '#39#39#1048#1090#1086#1075#1086#39#39', :AMOUNT_CATEGORY_ALL_, :SUM_N' +
        'AL_CATEGORY_ALL_, :SUM_BEZNAL_CATEGORY_ALL_, 3);'
      '110482292='
      '110482293=  I = I + 1;'
      '110482294='
      '110482295=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1059#1055#1051#1040#1063#1045#1053#1054
      '110482296=  SELECT COALESCE(SUM(S.SUMM_FACT), 0)'
      '110482297=    FROM SKLAD_PARENT S'
      
        '110482298=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      '110482299=     AND S.G_PAYMENT_TYPE = 1'
      '110482300=     AND S.IS_VOZVRAT = 0'
      
        '110482301=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110482302=    INTO :SUM_FACT_NAL_ALL_;'
      '110482303='
      '110482304=  SELECT COALESCE(SUM(S.SUMM_FACT), 0)'
      '110482305=    FROM SKLAD_PARENT S'
      
        '110482306=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      '110482307=     AND S.G_PAYMENT_TYPE = 2'
      '110482308=     AND S.IS_VOZVRAT = 0'
      
        '110482309=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110482310=    INTO :SUM_FACT_BEZNAL_ALL_;'
      '110482311='
      
        '110482312=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110482313=  VALUES (:I, '#39#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077#1085#1086#39#39', :SUM_FACT_NAL_ALL_' +
        ', :SUM_FACT_BEZNAL_ALL_, 1);'
      '110482314='
      
        '110482315=  PERIOD_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DA' +
        'TE_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN' +
        '_), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '110482316=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||' +
        #39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXT' +
        'RACT(YEAR FROM DATE_END_);'
      '110482317='
      
        '110482318=  FOR SELECT P_REP_PRIHOD_TABLE, TOVAR_NAME, AMOUNT, P' +
        'OSTAVSHIK, SELF_PRICE, SELF_SUMM, SELF_PRICE_B, SELF_SUMM_B,'
      '110482319=             IS_HEAD'
      '110482320=      FROM P_REP_PRIHOD_TABLE'
      
        '110482321=      INTO :P_REP_PRIHOD_TABLE, :TOVAR_NAME, :AMOUNT, ' +
        ':POSTAVSHIK, :SELF_PRICE, :SELF_SUMM, :SELF_PRICE_B, :SELF_SUMM_' +
        'B, :IS_HEAD'
      '110482322=  DO'
      '110482323=    suspend;'
      '110482324='
      '110482325=WHEN ANY DO BEGIN'
      '110482326=    Err_code = -20500;'
      
        '110482327=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110482328=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110482329=  END'
      '110482330=end'
      '110482331='#39';'
      '110482332='
      
        '110482333=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRIHOD_WAYBIL' +
        'L('
      '110482334=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110482335=  CURRENCY_ INTEGER)'
      '110482336=RETURNS ('
      '110482337=  NUMBER_STR_ VARCHAR(200),'
      '110482338=  ROW_NUM INTEGER,'
      '110482339=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110482340=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110482341=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110482342=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110482343=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110482344=  AMOUNT MY_NUMERIC_5,'
      '110482345=  PRICE_N VARCHAR(50),'
      '110482346=  SUMM_N VARCHAR(50),'
      '110482347=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '110482348=  SUMM_VSEGO_ VARCHAR(50),'
      '110482349=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110482350=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110482351=  SUMM_STR_ VARCHAR(500),'
      '110482352=  ERR_CODE NUMERIC(15,2),'
      '110482353=  ERR_MSG VARCHAR(1024))'
      '110482354=AS'
      '110482355=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '110482356=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRIHOD' +
        '_WAYBILL'#39#39';'
      '110482357=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110482358=DECLARE VARIABLE I INTEGER = 1;'
      
        '110482359=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110482360=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      '110482361=BEGIN'
      '110482362='
      
        '110482363=  SELECT '#39#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39#39'||P.sklad||'#39#39' '#1086#1090' '#39#39'||lpad(EXTR' +
        'ACT(DAY FROM P.date_receipt), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MON' +
        'TH FROM P.date_receipt), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM P.date_' +
        'receipt),'
      '110482364=         G.name,'
      '110482365=         P.IS_VOZVRAT'
      
        '110482366=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON ' +
        'P.g_client = G.G_CLIENT'
      '110482367=   WHERE P.sklad = :sklad_parent_'
      '110482368=    INTO :NUMBER_STR_,'
      '110482369=         :POSTAVSHIK_NAME_,'
      '110482370=         :IS_VOZVRAT_;'
      '110482371='
      
        '110482372=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058#1068 +
        ' '#1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      '110482373=  IF (IS_VOZVRAT_ = 3) THEN'
      '110482374=    SELECT G.NAME'
      '110482375=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '110482376=     WHERE P.SKLAD = :sklad_parent_'
      '110482377=       AND P.G_TOCHKA = G.G_TOCHKA'
      '110482378=      INTO :POSTAVSHIK_NAME_;'
      '110482379='
      
        '110482380=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) A' +
        'S VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39')'
      
        '110482381=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39')'
      
        '110482382=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ' +
        '), :CURRENCY_))'
      '110482383=    FROM SKLAD S'
      '110482384=   WHERE S.sklad_parent = :sklad_parent_'
      '110482385=   GROUP BY S.sklad_parent'
      '110482386=    INTO :AMOUNT_VSEGO_,'
      '110482387=         :SUMM_VSEGO_,'
      '110482388=         :summ_str_;'
      '110482389='
      '110482390=  SELECT NAME'
      '110482391=    FROM CUR_PARAMS'
      '110482392=   WHERE CUR_PARAMS = 1'
      '110482393=    INTO :G_OFFICIAL_FM_;'
      '110482394='
      '110482395=  FOR SELECT :I,'
      '110482396=             G.name,'
      '110482397=             G.ARTICUL,'
      '110482398=             G.BARCODE,'
      '110482399=             G.NOMENCLATUR_NUM,'
      '110482400=             U.short_name,'
      
        '110482401=             S.amount,    --REPLACE(CAST(S.amount AS V' +
        'ARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '110482402=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39'),'
      
        '110482403=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39#39'.'#39 +
        #39', '#39#39','#39#39')'
      '110482404=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '110482405=       WHERE S.sklad_parent = :sklad_parent_'
      '110482406=         AND S.g_product = G.g_product'
      '110482407=         AND G.g_unit = U.g_unit'
      '110482408=        INTO :ROW_NUM,'
      '110482409=            :NAME,'
      '110482410=            :ARTICUL,'
      '110482411=            :BARCODE,'
      '110482412=            :NOMENCLATUR_NUM,'
      '110482413=            :SHORT_NAME,'
      '110482414=            :AMOUNT,'
      '110482415=            :PRICE_N,'
      '110482416=            :SUMM_N'
      '110482417=  DO BEGIN'
      '110482418=    I = I + 1;'
      '110482419=    SUSPEND;'
      '110482420=  END'
      '110482421=WHEN ANY DO BEGIN'
      '110482422=    Err_code = -20500;'
      
        '110482423=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110482424=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110482425=  END'
      '110482426=end'
      '110482427='#39';'
      '110482428='
      
        '110482429=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRODAZHA_WAYB' +
        'ILL('
      '110482430=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110482431=  CURRENCY_ INTEGER)'
      '110482432=RETURNS ('
      '110482433=  NUMBER_STR_ VARCHAR(200),'
      '110482434=  ROW_NUM INTEGER,'
      '110482435=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110482436=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110482437=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110482438=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110482439=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110482440=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110482441=  AMOUNT MY_NUMERIC_5,'
      '110482442=  PRICE_N VARCHAR(50),'
      '110482443=  SUMM_N VARCHAR(50),'
      '110482444=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '110482445=  SUMM_VSEGO_ VARCHAR(50),'
      '110482446=  NDS_SUMM_ VARCHAR(50),'
      '110482447=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110482448=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110482449=  SUMM_STR_ VARCHAR(500),'
      '110482450=  NDS_SUMM_STR_ VARCHAR(500),'
      '110482451=  ERR_CODE NUMERIC(15,2),'
      '110482452=  ERR_MSG VARCHAR(1024))'
      '110482453=AS'
      '110482454=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '110482455=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRODAZ' +
        'HA_WAYBILL'#39#39';'
      '110482456=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110482457=DECLARE VARIABLE I INTEGER = 1;'
      
        '110482458=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110482459=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        '_SUMM;'
      '110482460=BEGIN'
      '110482461='
      
        '110482462=  SELECT decode(P.is_spisanie, 1, '#39#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39#39', '#39#39#1053#1072#1082 +
        #1083#1072#1076#1085#1072#1103' '#8470#39#39'||P.ZAKAZ)||'#39#39' '#1086#1090' '#39#39'||lpad(EXTRACT(DAY FROM P.z_date),' +
        ' 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39#39'.' +
        #39#39'||EXTRACT(YEAR FROM P.z_date),'
      '110482463=         G.name'
      '110482464=    FROM ZAKAZ P,'
      '110482465=         G_CLIENT G'
      '110482466=   WHERE P.ZAKAZ = :ZAKAZ_'
      '110482467=     AND P.g_client = G.G_CLIENT'
      '110482468=    INTO :NUMBER_STR_,'
      '110482469=         :CLIENT_NAME_;'
      '110482470='
      '110482471=  SELECT SUM(S.amount)'
      
        '110482472=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39')'
      
        '110482473=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ' +
        '), :CURRENCY_))'
      
        '110482474=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(10))' +
        ', '#39#39'.'#39#39', '#39#39','#39#39')'
      '110482475=         ,SUM(S.nds_summ)'
      '110482476=    FROM ZAKAZ_DETAILS S'
      '110482477=   WHERE S.ZAKAZ = :ZAKAZ_'
      '110482478=   GROUP BY S.ZAKAZ'
      '110482479=    INTO :AMOUNT_VSEGO_,'
      '110482480=         :SUMM_VSEGO_,'
      '110482481=         :summ_str_,'
      '110482482=         :NDS_SUMM_,'
      '110482483=         :NDS_;'
      '110482484='
      '110482485=  if (NDS_ > 0) then'
      
        '110482486=    SELECT '#39#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39#39'||CURR_STR from CURREN' +
        'CYSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '110482487='
      '110482488=  SELECT NAME'
      '110482489=    FROM CUR_PARAMS'
      '110482490=   WHERE CUR_PARAMS = 1'
      '110482491=    INTO :G_OFFICIAL_FM_;'
      '110482492='
      '110482493=  FOR SELECT :I,'
      '110482494=             C.NAME,'
      '110482495=             G.name,'
      '110482496=             G.ARTICUL,'
      '110482497=             G.BARCODE,'
      '110482498=             G.NOMENCLATUR_NUM,'
      '110482499=             U.short_name,'
      '110482500=             S.amount,'
      
        '110482501=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39'),'
      
        '110482502=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39#39'.'#39 +
        #39', '#39#39','#39#39')'
      
        '110482503=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, G' +
        '_PRODUCT C'
      '110482504=       WHERE S.ZAKAZ = :ZAKAZ_'
      '110482505=         AND S.g_product = G.g_product'
      '110482506=         AND G.g_unit = U.g_unit'
      '110482507=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '110482508=        INTO :ROW_NUM,'
      '110482509=            :CATEGORY_NAME,'
      '110482510=            :NAME,'
      '110482511=            :ARTICUL,'
      '110482512=            :BARCODE,'
      '110482513=            :NOMENCLATUR_NUM,'
      '110482514=            :SHORT_NAME,'
      '110482515=            :AMOUNT,'
      '110482516=            :PRICE_N,'
      '110482517=            :SUMM_N'
      '110482518=  DO BEGIN'
      '110482519=    I = I + 1;'
      '110482520=    SUSPEND;'
      '110482521=  END'
      '110482522=WHEN ANY DO BEGIN'
      '110482523=    Err_code = -20500;'
      
        '110482524=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110482525=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110482526=  END'
      '110482527=end'
      '110482528='#39';'
      '110482529='
      
        '110482530=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRODUCTION_WA' +
        'YBILL('
      '110482531=  OTHER_ TYPE OF COLUMN OTHER.OTHER,'
      '110482532=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110482533=  CURRENCY_ INTEGER)'
      '110482534=RETURNS ('
      '110482535=  NUMBER_STR_ VARCHAR(200),'
      '110482536=  ROW_NUM INTEGER,'
      '110482537=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110482538=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110482539=  AMOUNT TYPE OF COLUMN OTHER_DETAILS.AMOUNT,'
      '110482540=  PRICE_N TYPE OF COLUMN OTHER_DETAILS.COST_PRICE,'
      '110482541=  SUMM_N TYPE OF COLUMN OTHER_DETAILS.COST_PRICE,'
      '110482542=  AMOUNT_VSEGO_ TYPE OF COLUMN OTHER_DETAILS.AMOUNT,'
      '110482543=  SUMM_VSEGO_ NUMERIC(15,2),'
      '110482544=  SUMM_STR_ VARCHAR(500),'
      '110482545=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110482546=  PRODUCT_STR_ VARCHAR(500),'
      '110482547=  ERR_CODE NUMERIC(15,2),'
      '110482548=  ERR_MSG VARCHAR(1024))'
      '110482549=AS'
      '110482550=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1040'*/'
      
        '110482551=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRODUC' +
        'TION_WAYBILL'#39#39';'
      '110482552=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110482553=DECLARE VARIABLE I INTEGER = 1;'
      
        '110482554=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110482555=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        '_SUMM;'
      '110482556=BEGIN'
      '110482557='
      
        '110482558=  SELECT '#39#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39#39'||P.NAME||'#39#39'", '#1074' '#1082#1086#1083 +
        #1080#1095#1077#1089#1090#1074#1077' '#39#39'||S.amount||'#39#39' '#39#39'||U.SHORT_NAME'
      '110482559=    FROM SKLAD_PARENT SP,'
      '110482560=         SKLAD S,'
      '110482561=         G_PRODUCT P,'
      '110482562=         G_UNIT U'
      '110482563=   WHERE SP.sklad = :SKLAD_'
      '110482564=     AND S.sklad_parent = SP.sklad'
      '110482565=     AND S.g_product = P.g_product'
      '110482566=     AND P.G_UNIT = U.g_unit'
      '110482567=    INTO :PRODUCT_STR_;'
      '110482568='
      
        '110482569=  SELECT '#39#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39#39'||P.OTHER||'#39#39' '#1086#1090' '#39#39'||lpad(EXTR' +
        'ACT(DAY FROM P.OP_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FR' +
        'OM P.OP_DATE), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM P.OP_DATE)'
      '110482570=    FROM OTHER P'
      '110482571=   WHERE P.OTHER = :OTHER_'
      '110482572=    INTO :NUMBER_STR_;'
      '110482573='
      '110482574=  SELECT SUM(S.amount)'
      
        '110482575=         ,SUM(CAST(S.amount * S.cost_price AS NUMERIC(' +
        '15,2)))'
      
        '110482576=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.amou' +
        'nt * S.cost_price), :CURRENCY_))'
      '110482577=    FROM OTHER_DETAILS S'
      '110482578=   WHERE S.OTHER = :OTHER_'
      '110482579=   GROUP BY S.OTHER'
      '110482580=    INTO :AMOUNT_VSEGO_,'
      '110482581=         :SUMM_VSEGO_,'
      '110482582=         :summ_str_;'
      '110482583='
      '110482584=  SELECT NAME'
      '110482585=    FROM CUR_PARAMS'
      '110482586=   WHERE CUR_PARAMS = 1'
      '110482587=    INTO :G_OFFICIAL_FM_;'
      '110482588='
      '110482589=  FOR SELECT :I,'
      '110482590=             G.name,'
      '110482591=             U.short_name,'
      '110482592=             S.amount,'
      '110482593=             S.COST_price,'
      
        '110482594=             CAST(S.amount * S.cost_price AS NUMERIC(1' +
        '5,2))'
      '110482595=        FROM OTHER_DETAILS S, G_PRODUCT G, G_UNIT U'
      '110482596=       WHERE S.OTHER = :OTHER_'
      '110482597=         AND S.g_product = G.g_product'
      '110482598=         AND G.g_unit = U.g_unit'
      '110482599=        INTO :ROW_NUM,'
      '110482600=            :NAME,'
      '110482601=            :SHORT_NAME,'
      '110482602=            :AMOUNT,'
      '110482603=            :PRICE_N,'
      '110482604=            :SUMM_N'
      '110482605=  DO BEGIN'
      '110482606=    I = I + 1;'
      '110482607=    SUSPEND;'
      '110482608=  END'
      '110482609=WHEN ANY DO BEGIN'
      '110482610=    Err_code = -20500;'
      
        '110482611=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110482612=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110482613=  END'
      '110482614=end'
      '110482615='#39';'
      '110482616=END  --END_EXECUTE_BLOCK'
      '110482617=EXECUTE BLOCK AS BEGIN'
      '110482618='
      '110482619=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT('
      '110482620=  DATE_BEGIN_ DATE,'
      '110482621=  DATE_END_ DATE,'
      '110482622=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110482623=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110482624=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110482625=RETURNS ('
      '110482626=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110482627=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110482628=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
      '110482629=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110482630=  SUMM_ALL_ NUMERIC(15,2),'
      '110482631=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110482632=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110482633=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110482634=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110482635=  PROFIT_ALL_ NUMERIC(15,2),'
      '110482636=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110482637=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      '110482638=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '110482639=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '110482640=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '110482641=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '110482642=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT' +
        '_NAME,'
      
        '110482643=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_P' +
        'AYMENT_TYPE,'
      
        '110482644=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYME' +
        'NT_NAME,'
      
        '110482645=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANI' +
        'E,'
      
        '110482646=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUC' +
        'T,'
      
        '110482647=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PR' +
        'ODUCT_PAR,'
      
        '110482648=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110482649=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110482650=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110482651=  AMOUNT MY_NUMERIC_5,'
      '110482652=  PRICE NUMERIC(15,2),'
      '110482653=  SUMM NUMERIC(15,2),'
      '110482654=  DISCOUNT_PERC NUMERIC(15,2),'
      '110482655=  DISCOUNT_SUMM NUMERIC(15,2),'
      '110482656=  NDS NUMERIC(15,2),'
      '110482657=  NDS_SUMM NUMERIC(15,2),'
      '110482658=  PRICE_SELF NUMERIC(15,2),'
      '110482659=  SUM_SELF NUMERIC(15,2),'
      '110482660=  PROFIT NUMERIC(15,2),'
      '110482661=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110482662=  ERR_CODE INTEGER,'
      '110482663=  ERR_MSG VARCHAR(1024))'
      '110482664=AS'
      
        '110482665=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT' +
        #39#39';'
      '110482666=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110482667=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110482668=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110482669=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110482670=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110482671=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110482672=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '110482673=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '110482674=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '110482675=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '110482676=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110482677=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110482678=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110482679=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110482680=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110482681=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110482682=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110482683=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110482684=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110482685=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110482686=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110482687=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110482688=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110482689=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110482690=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110482691=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110482692=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110482693=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110482694=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110482695=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110482696=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110482697=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110482698=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110482699=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110482700=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110482701=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110482702=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110482703=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110482704=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110482705=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110482706=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110482707=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110482708=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110482709=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      '110482710=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0;'
      '110482711=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;'
      '110482712=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110482713=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      '110482714=BEGIN'
      
        '110482715=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110482716=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110482717='
      '110482718=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110482719=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110482720=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110482721='
      '110482722=  FOR SELECT GP.PATH,'
      '110482723=             GP.G_PRODUCT'
      '110482724=       FROM P_REP_TREE GP'
      '110482725=      WHERE EXISTS (SELECT 1'
      
        '110482726=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110482727=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '110482728=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110482729=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110482730=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110482731=                       AND Z.IS_SPISANIE = 0'
      '110482732=                       AND Z.is_reserve = 0'
      
        '110482733=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110482734=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110482735=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110482736=                       )'
      '110482737=      ORDER BY 1, 2'
      '110482738=  INTO :RECCAT_NAME_,'
      '110482739=       :RECCAT_PRODUCT_'
      '110482740=  DO BEGIN'
      '110482741=    insert into p_rep_profit_table'
      '110482742=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110482743=    values'
      
        '110482744=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110482745='
      '110482746=    FOR SELECT Z.ZAKAZ,'
      '110482747=               Z.G_TOCHKA,'
      '110482748=               Z.Z_DATE,'
      '110482749=               Z.G_CLIENT,'
      '110482750=               C.NAME CLIENT_NAME,'
      '110482751=               Z.G_PAYMENT_TYPE,'
      '110482752=               P.NAME PAYMENT_NAME,'
      '110482753=               Z.OSNOVANIE,'
      '110482754=               G.G_PRODUCT,'
      '110482755=               G.G_PRODUCT_PAR,'
      '110482756=               G.NAME TOVAR_NAME,'
      '110482757=               ZD.AMOUNT,'
      '110482758=               ZD.PRICE,'
      '110482759=               ZD.SUMM,'
      '110482760=               ZD.DISCOUNT_PERC,'
      '110482761=               ZD.DISCOUNT_SUMM,'
      '110482762=               ZD.NDS,'
      '110482763=               ZD.NDS_SUMM,'
      '110482764=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110482765=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110482766=               ZAKAZ_DETAILS ZD,'
      '110482767=               G_PRODUCT G,'
      '110482768=               G_PAYMENT_TYPE P'
      
        '110482769=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TO' +
        'CHKA||'#39#39'-'#39#39
      '110482770=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110482771=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110482772=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110482773=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_'
      '110482774=           AND Z.IS_SPISANIE = 0'
      '110482775=           AND Z.IS_RESERVE = 0'
      
        '110482776=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110482777=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110482778=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110482779=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110482780=    INTO :REC_ZAKAZ_,'
      '110482781=        :REC_G_TOCHKA_,'
      '110482782=        :REC_Z_DATE_,'
      '110482783=        :REC_G_CLIENT_,'
      '110482784=        :REC_CLIENT_NAME_,'
      '110482785=        :REC_G_PAYMENT_TYPE_,'
      '110482786=        :REC_PAYMENT_NAME_,'
      '110482787=        :REC_OSNOVANIE_,'
      '110482788=        :REC_G_PRODUCT_,'
      '110482789=        :REC_G_PRODUCT_PAR_,'
      '110482790=        :REC_TOVAR_NAME_,'
      '110482791=        :REC_AMOUNT_,'
      '110482792=        :REC_PRICE_,'
      '110482793=        :REC_SUMM_,'
      '110482794=        :REC_DISCOUNT_PERC_,'
      '110482795=        :REC_DISCOUNT_SUMM_,'
      '110482796=        :REC_NDS_,'
      '110482797=        :REC_NDS_SUMM_,'
      '110482798=        :REC_PRICE_SELF_'
      '110482799=    DO BEGIN'
      '110482800=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110482801=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110482802='
      '110482803=      insert into p_rep_profit_table'
      
        '110482804=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110482805=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110482806=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110482807=      values'
      '110482808=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110482809=        :REC_ZAKAZ_,'
      '110482810=        :REC_g_tochka_,'
      
        '110482811=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110482812=         :REC_osnovanie_,'
      '110482813=         :REC_g_product_,'
      '110482814=         :REC_g_product_par_,'
      '110482815=         :REC_tovar_name_,'
      '110482816=         :REC_amount_,'
      '110482817=         :REC_price_,'
      '110482818=         :REC_summ_,'
      '110482819=         :REC_discount_perc_,'
      '110482820=         :REC_discount_summ_,'
      
        '110482821=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110482822='
      
        '110482823=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110482824=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110482825=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110482826=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110482827=    END'
      '110482828='
      '110482829=    insert into p_rep_profit_table'
      
        '110482830=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110482831=    values'
      
        '110482832=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :' +
        'SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110482833='
      '110482834=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110482835=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110482836=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110482837=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110482838='
      '110482839=    SUM_ZAKAZ_ = 0;'
      '110482840=    SUM_COST_  = 0;'
      '110482841=    NDS_SUMM_  = 0;'
      '110482842=    PROFIT_    = 0;'
      '110482843=  END'
      '110482844='
      
        '110482845=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110482846=      insert into p_rep_profit_table'
      
        '110482847=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110482848=      values'
      
        '110482849=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :P' +
        'ROFIT_ALL_, 3);'
      '110482850='
      '110482851=  SELECT COUNT(*)'
      
        '110482852=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110482853=          UNION ALL'
      
        '110482854=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110482855=         G_PRIHOD_RASHOD G'
      
        '110482856=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||' +
        #39#39'-'#39#39
      '110482857=    AND K.ACTION = 1'
      
        '110482858=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110482859=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110482860=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '110482861=  INTO :CNT_;'
      '110482862='
      '110482863=  IF (CNT_ > 0) THEN BEGIN'
      '110482864=    SUM_COST_  = 0;'
      '110482865=    PROFIT_    = 0;'
      '110482866='
      '110482867=    INSERT INTO P_REP_PROFIT_TABLE'
      '110482868=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110482869=    VALUES'
      
        '110482870=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39#39',' +
        ' 1);'
      '110482871='
      '110482872=    FOR SELECT K.ACTION_DATE,'
      '110482873=               K.SUMM,'
      '110482874=               G.NAME'
      
        '110482875=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      
        '110482876=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||' +
        'G_TOCHKA||'#39#39'-'#39#39
      '110482877=              UNION ALL'
      
        '110482878=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, ' +
        'SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa_bez' +
        'nal'
      
        '110482879=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||' +
        'G_TOCHKA||'#39#39'-'#39#39') k,'
      '110482880=              G_PRIHOD_RASHOD G'
      '110482881=        WHERE K.ACTION = 1'
      
        '110482882=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110482883=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110482884=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '110482885=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110482886=    INTO :ACTION_DATE_,'
      '110482887=         :SUMM_,'
      '110482888=         :ACTION_NAME_'
      '110482889=    DO BEGIN'
      '110482890=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110482891=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110482892=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110482893=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110482894=        VALUES'
      
        '110482895=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, 0,'
      
        '110482896=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALES' +
        'CE(:SUMM_, 0), 0);'
      '110482897='
      '110482898=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110482899=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110482900=    END'
      '110482901='
      '110482902=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110482903=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110482904=    insert into p_rep_profit_table'
      
        '110482905=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110482906=    values'
      
        '110482907=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110482908=  END'
      '110482909='
      '110482910=  SELECT COUNT(*)'
      
        '110482911=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110482912=          UNION ALL'
      
        '110482913=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110482914=         G_PRIHOD_RASHOD G'
      
        '110482915=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||' +
        #39#39'-'#39#39
      '110482916=    AND K.ACTION = 0'
      
        '110482917=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110482918=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110482919=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '110482920=  INTO :CNT_;'
      '110482921='
      '110482922=  IF (CNT_ > 0) THEN BEGIN'
      '110482923=    PRIHOD_ALL_  = 0;'
      '110482924=    PRIHOD_ALL_NAL_  = 0;'
      '110482925=    PRIHOD_ALL_BEZNAL_  = 0;'
      '110482926=    PROFIT_     = 0;'
      '110482927='
      '110482928=    INSERT INTO P_REP_PROFIT_TABLE'
      '110482929=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110482930=    VALUES'
      
        '110482931=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39#39',' +
        ' 1);'
      '110482932='
      '110482933=    FOR SELECT K.ACTION_DATE,'
      '110482934=               K.NAL,'
      '110482935=               K.BEZNAL,'
      '110482936=               G.NAME'
      
        '110482937=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 ' +
        'BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110482938=               UNION ALL'
      
        '110482939=               SELECT kassa_BEZNAL KASSA, ACTION_DATE,' +
        ' 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kass' +
        'a_beznal) K,'
      '110482940=              G_PRIHOD_RASHOD G'
      
        '110482941=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOC' +
        'HKA||'#39#39'-'#39#39
      '110482942=          AND K.ACTION = 0'
      
        '110482943=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110482944=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110482945=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '110482946=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110482947=    INTO :ACTION_DATE_,'
      '110482948=         :SUMM_NAL_,'
      '110482949=         :SUMM_BEZNAL_,'
      '110482950=         :ACTION_NAME_'
      '110482951=    DO BEGIN'
      '110482952=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110482953=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110482954=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110482955=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110482956=        VALUES'
      
        '110482957=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '110482958=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '110482959='
      '110482960=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110482961=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM' +
        '_BEZNAL_;'
      
        '110482962=        PRIHOD_ALL_ = PRIHOD_ALL_ + PRIHOD_ALL_NAL_ + ' +
        'PRIHOD_ALL_BEZNAL_;'
      
        '110482963=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZ' +
        'NAL_;'
      '110482964=    END'
      '110482965='
      '110482966=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110482967=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110482968='
      '110482969=    insert into p_rep_profit_table'
      
        '110482970=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110482971=    values'
      
        '110482972=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110482973=  END'
      '110482974='
      '110482975=  SELECT COUNT(*)'
      '110482976=    FROM ZAKAZ Z'
      
        '110482977=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      '110482978=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110482979=     AND Z.IS_SPISANIE = 1'
      
        '110482980=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110482981=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110482982=  INTO :CNT_;'
      '110482983='
      '110482984=  IF (CNT_ > 0) THEN BEGIN'
      '110482985=      SUM_ZAKAZ_ = 0;'
      '110482986=      SUM_COST_  = 0;'
      '110482987=      PROFIT_    = 0;'
      '110482988='
      '110482989=      insert into p_rep_profit_table'
      '110482990=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110482991=      values'
      
        '110482992=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39#39', 1);'
      '110482993='
      '110482994=      FOR SELECT Z.ZAKAZ,'
      '110482995=                 Z.G_TOCHKA,'
      '110482996=                 Z.Z_DATE,'
      '110482997=                 Z.G_CLIENT,'
      '110482998=                 '#39#39#39#39' CLIENT_NAME,'
      '110482999=                 Z.G_PAYMENT_TYPE,'
      '110483000=                 '#39#39#39#39' PAYMENT_NAME,'
      '110483001=                 Z.OSNOVANIE,'
      '110483002=                 G.G_PRODUCT,'
      '110483003=                 G.G_PRODUCT_PAR,'
      '110483004=                 G.NAME TOVAR_NAME,'
      '110483005=                 ZD.AMOUNT,'
      '110483006=                 ZD.PRICE,'
      '110483007=                 ZD.SUMM,'
      '110483008=                 0 DISCOUNT_PERC,'
      '110483009=                 0 DISCOUNT_SUMM,'
      '110483010=                 0 NDS,'
      '110483011=                 0 NDS_SUMM'
      
        '110483012=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT ' +
        'G'
      
        '110483013=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_' +
        'TOCHKA||'#39#39'-'#39#39
      '110483014=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110483015=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110483016=             AND Z.IS_SPISANIE = 1'
      
        '110483017=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '110483018=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G' +
        '_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110483019=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALE' +
        'SCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110483020=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS'
      '110483021=      INTO :REC_ZAKAZ_,'
      '110483022=            :REC_G_TOCHKA_,'
      '110483023=            :REC_Z_DATE_,'
      '110483024=            :REC_G_CLIENT_,'
      '110483025=            :REC_CLIENT_NAME_,'
      '110483026=            :REC_G_PAYMENT_TYPE_,'
      '110483027=            :REC_PAYMENT_NAME_,'
      '110483028=            :REC_OSNOVANIE_,'
      '110483029=            :REC_G_PRODUCT_,'
      '110483030=            :REC_G_PRODUCT_PAR_,'
      '110483031=            :REC_TOVAR_NAME_,'
      '110483032=            :REC_AMOUNT_,'
      '110483033=            :REC_PRICE_,'
      '110483034=            :REC_SUMM_,'
      '110483035=            :REC_DISCOUNT_PERC_,'
      '110483036=            :REC_DISCOUNT_SUMM_,'
      '110483037=            :REC_NDS_,'
      '110483038=            :REC_NDS_SUMM_'
      '110483039=      DO BEGIN'
      '110483040=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '110483041=        REC_profit_   = -REC_SUMM_;'
      '110483042='
      '110483043=        insert into p_rep_profit_table'
      
        '110483044=          (p_rep_profit_table, zakaz, g_tochka, z_date' +
        ', g_client, client_name, g_payment_type, payment_name,'
      
        '110483045=           osnovanie, g_product, g_product_par, tovar_' +
        'name, amount, price, summ, discount_perc, discount_summ,'
      
        '110483046=           nds, nds_summ, price_self, sum_self, profit' +
        ', is_head)'
      '110483047=        values'
      
        '110483048=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAK' +
        'AZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '110483049=         :REC_osnovanie_, :REC_g_product_, :REC_g_prod' +
        'uct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_pe' +
        'rc_, :REC_discount_summ_,'
      
        '110483050=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_' +
        'SUM_COST_, :REC_profit_, 0);'
      '110483051='
      
        '110483052=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST' +
        '_, 0);'
      
        '110483053=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, ' +
        '0);'
      '110483054=      END'
      '110483055='
      '110483056=      insert into p_rep_profit_table'
      
        '110483057=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110483058=      values'
      
        '110483059=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39',' +
        ' 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110483060='
      '110483061=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110483062=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110483063=  END'
      '110483064=  SELECT COUNT(*)'
      '110483065=    FROM SKLAD S'
      
        '110483066=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      
        '110483067=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110483068=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110483069=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110483070=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110483071=  INTO :CNT_;'
      '110483072='
      '110483073=  IF (CNT_ > 0) THEN BEGIN'
      '110483074=    SUM_ZAKAZ_ = 0;'
      '110483075=    PROFIT_    = 0;'
      '110483076=    SUM_COST_  = 0;'
      '110483077='
      '110483078=    insert into p_rep_profit_table'
      '110483079=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110483080=    values'
      
        '110483081=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054 +
        #1042#1040#1056#1040#39#39', 1);'
      '110483082='
      '110483083=    FOR SELECT S.DATE_RECEIPT,'
      '110483084=               S.G_PRODUCT,'
      '110483085=               G.NAME TOVAR_NAME,'
      '110483086=               S.AMOUNT,'
      '110483087=               S.PRICE,'
      '110483088=               S.SUMM,'
      '110483089=               SP.G_TOCHKA'
      '110483090=         FROM SKLAD_PARENT SP,'
      '110483091=              SKLAD S,'
      '110483092=              G_PRODUCT G'
      
        '110483093=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TO' +
        'CHKA||'#39#39'-'#39#39
      
        '110483094=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110483095=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110483096=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110483097=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110483098=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110483099=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110483100=        ORDER BY 1'
      '110483101=    INTO :V_DATE_RECEIPT_,'
      '110483102=         :V_G_PRODUCT_,'
      '110483103=         :V_TOVAR_NAME_,'
      '110483104=         :V_AMOUNT_,'
      '110483105=         :V_PRICE_,'
      '110483106=         :V_SUMM_,'
      '110483107=         :REC_G_TOCHKA_'
      '110483108=    DO BEGIN'
      '110483109=      REC_profit_   = 0 - V_SUMM_;'
      '110483110=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110483111=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110483112=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110483113=         NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT, ' +
        'IS_HEAD)'
      '110483114=      VALUES'
      
        '110483115=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, 0, 0,'
      
        '110483116=         0, 0, 0, 0, :V_PRICE_, :V_SUMM_, :REC_profit_' +
        ', 0);'
      '110483117=      SUM_COST_ = 0;'
      '110483118=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '110483119=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110483120=    END'
      '110483121='
      '110483122='
      '110483123=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_COST_;'
      '110483124=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '110483125=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110483126='
      '110483127=    insert into p_rep_profit_table'
      
        '110483128=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110483129=    values'
      
        '110483130=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :' +
        'SUM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '110483131=  END'
      '110483132='
      '110483133=  SELECT COUNT(*)'
      '110483134=    FROM ZAKAZ S'
      
        '110483135=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      '110483136=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110483137=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))'
      
        '110483138=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110483139=     AND S.IS_SPISANIE = 2'
      '110483140=  INTO :CNT_;'
      '110483141='
      '110483142=  IF (CNT_ > 0) THEN BEGIN'
      '110483143=      insert into p_rep_profit_table'
      '110483144=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110483145=      values'
      
        '110483146=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '110483147='
      '110483148=      SUM_ZAKAZ_ = 0;'
      '110483149=      SUM_COST_  = 0;'
      '110483150=      NDS_SUMM_  = 0;'
      '110483151=      PROFIT_    = 0;'
      '110483152=      FOR SELECT GP.NAME,'
      '110483153=                 GP.G_PRODUCT'
      '110483154=           FROM G_PRODUCT GP'
      '110483155=          WHERE IS_CATEGORY = 1'
      '110483156=            AND EXISTS (SELECT 1'
      
        '110483157=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110483158=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '110483159=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110483160=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110483161=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110483162=                           AND Z.IS_SPISANIE = 2'
      
        '110483163=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110483164=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110483165=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110483166=                           )'
      '110483167=          ORDER BY 1'
      '110483168=      INTO :RECCAT_NAME_,'
      '110483169=           :RECCAT_PRODUCT_'
      '110483170=      DO BEGIN'
      '110483171=        insert into p_rep_profit_table'
      '110483172=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110483173=        values'
      
        '110483174=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110483175='
      '110483176=        FOR SELECT Z.ZAKAZ,'
      '110483177=                   Z.G_TOCHKA,'
      '110483178=                   Z.Z_DATE,'
      '110483179=                   Z.G_CLIENT,'
      '110483180=                   C.NAME CLIENT_NAME,'
      '110483181=                   Z.G_PAYMENT_TYPE,'
      '110483182=                   P.NAME PAYMENT_NAME,'
      '110483183=                   Z.OSNOVANIE,'
      '110483184=                   G.G_PRODUCT,'
      '110483185=                   G.G_PRODUCT_PAR,'
      '110483186=                   G.NAME TOVAR_NAME,'
      '110483187=                   ZD.AMOUNT,'
      '110483188=                   ZD.PRICE,'
      '110483189=                   ZD.SUMM,'
      '110483190=                   ZD.DISCOUNT_PERC,'
      '110483191=                   ZD.DISCOUNT_SUMM,'
      '110483192=                   ZD.NDS,'
      '110483193=                   ZD.NDS_SUMM,'
      '110483194=                   ZD.COST_PRICE'
      
        '110483195=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110483196=                   ZAKAZ_DETAILS ZD,'
      '110483197=                   G_PRODUCT G,'
      '110483198=                   G_PAYMENT_TYPE P'
      
        '110483199=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.' +
        'G_TOCHKA||'#39#39'-'#39#39
      '110483200=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110483201=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110483202=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110483203=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_'
      '110483204=               AND Z.IS_SPISANIE = 2'
      
        '110483205=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110483206=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '110483207=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110483208=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110483209=        INTO :REC_ZAKAZ_,'
      '110483210=            :REC_G_TOCHKA_,'
      '110483211=            :REC_Z_DATE_,'
      '110483212=            :REC_G_CLIENT_,'
      '110483213=            :REC_CLIENT_NAME_,'
      '110483214=            :REC_G_PAYMENT_TYPE_,'
      '110483215=            :REC_PAYMENT_NAME_,'
      '110483216=            :REC_OSNOVANIE_,'
      '110483217=            :REC_G_PRODUCT_,'
      '110483218=            :REC_G_PRODUCT_PAR_,'
      '110483219=            :REC_TOVAR_NAME_,'
      '110483220=            :REC_AMOUNT_,'
      '110483221=            :REC_PRICE_,'
      '110483222=            :REC_SUMM_,'
      '110483223=            :REC_DISCOUNT_PERC_,'
      '110483224=            :REC_DISCOUNT_SUMM_,'
      '110483225=            :REC_NDS_,'
      '110483226=            :REC_NDS_SUMM_,'
      '110483227=            :REC_PRICE_SELF_'
      '110483228=        DO BEGIN'
      
        '110483229=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF' +
        '_;'
      
        '110483230=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - ' +
        'REC_NDS_SUMM_;'
      '110483231='
      '110483232=          insert into p_rep_profit_table'
      
        '110483233=            (p_rep_profit_table, zakaz, g_tochka, z_da' +
        'te, g_client, client_name, g_payment_type, payment_name,'
      
        '110483234=             osnovanie, g_product, g_product_par, tova' +
        'r_name, amount, price, summ, discount_perc, discount_summ,'
      
        '110483235=             nds, nds_summ, price_self, sum_self, prof' +
        'it, is_head)'
      '110483236=          values'
      '110483237=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110483238=            :REC_ZAKAZ_,'
      '110483239=            :REC_g_tochka_,'
      
        '110483240=            :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      '110483241=             :REC_osnovanie_,'
      '110483242=             :REC_g_product_,'
      '110483243=             :REC_g_product_par_,'
      '110483244=             :REC_tovar_name_,'
      '110483245=             :REC_amount_,'
      '110483246=             :REC_price_,'
      '110483247=             :REC_summ_,'
      '110483248=             :REC_discount_perc_,'
      '110483249=             :REC_discount_summ_,'
      
        '110483250=             :REC_nds_, :REC_nds_summ_, :REC_price_sel' +
        'f_, :REC_SUM_COST_, :REC_profit_, 0);'
      '110483251='
      
        '110483252=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_' +
        ', 0);'
      
        '110483253=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_CO' +
        'ST_, 0);'
      
        '110483254=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SU' +
        'MM_, 0);'
      
        '110483255=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_,' +
        ' 0);'
      '110483256=        END'
      '110483257='
      '110483258=        insert into p_rep_profit_table'
      
        '110483259=          (p_rep_profit_table, tovar_name, summ, sum_s' +
        'elf, NDS_SUMM, profit, is_head)'
      '110483260=        values'
      
        '110483261=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39 +
        #39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110483262='
      
        '110483263=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_' +
        ';'
      '110483264=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '110483265=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '110483266=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '110483267='
      '110483268=        SUM_ZAKAZ_ = 0;'
      '110483269=        SUM_COST_  = 0;'
      '110483270=        NDS_SUMM_  = 0;'
      '110483271=        PROFIT_    = 0;'
      '110483272=      END'
      '110483273='
      '110483274=      insert into p_rep_profit_table'
      
        '110483275=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110483276=      values'
      
        '110483277=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_S' +
        'UMM_REAL_, :PROFIT_REAL_, 2);'
      '110483278='
      
        '110483279=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL' +
        '_;'
      
        '110483280=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL' +
        '_;'
      '110483281=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '110483282=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '110483283=  END'
      '110483284=  insert into p_rep_profit_table'
      '110483285=    (p_rep_profit_table, is_head)'
      '110483286=  values'
      '110483287=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110483288='
      '110483289=  insert into p_rep_profit_table'
      
        '110483290=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110483291=  values'
      
        '110483292=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFI' +
        'T_ALL_, 1);'
      '110483293='
      '110483294=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110483295=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110483296=         SUM(Z.SUMM_BONUS)'
      '110483297=    FROM ZAKAZ Z'
      
        '110483298=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      '110483299=     AND Z.IS_SPISANIE not in (1, 4)'
      '110483300=     AND Z.IS_RESERVE = 0'
      '110483301=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110483302=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110483303=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110483304=    INTO :SUMM_CASH_ALL_,'
      '110483305=         :SUMM_NONCASH_ALL_,'
      '110483306=         :SUMM_BONUS_ALL_;'
      '110483307='
      '110483308=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '110483309=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '110483310=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110483311='
      '110483312=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110483313='
      
        '110483314=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '110483315=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110483316='
      '110483317=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110483318=    SELECT G.NAME'
      '110483319=      FROM G_CLIENT G'
      '110483320=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110483321=    INTO :CLIENT_NAME_;'
      '110483322=  ELSE'
      '110483323=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110483324='
      '110483325=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110483326=    SELECT G.NAME'
      '110483327=      FROM G_PAYMENT_TYPE G'
      '110483328=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110483329=    INTO :PAYMENT_NAME_;'
      '110483330=  ELSE'
      '110483331=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110483332='
      '110483333=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110483334=        P.ZAKAZ,'
      '110483335=        P.G_TOCHKA,'
      '110483336=        P.Z_DATE,'
      '110483337=        P.G_CLIENT,'
      '110483338=        P.CLIENT_NAME,'
      '110483339=        P.G_PAYMENT_TYPE,'
      '110483340=        P.PAYMENT_NAME,'
      '110483341=        P.OSNOVANIE,'
      '110483342=        P.G_PRODUCT,'
      '110483343=        P.G_PRODUCT_PAR,'
      '110483344=        P.TOVAR_NAME,'
      '110483345=        G.ARTICUL,'
      '110483346=        G.NOMENCLATUR_NUM,'
      '110483347=        P.AMOUNT,'
      '110483348=        P.PRICE,'
      '110483349=        P.SUMM,'
      '110483350=        P.DISCOUNT_PERC,'
      '110483351=        P.DISCOUNT_SUMM,'
      '110483352=        P.NDS,'
      '110483353=        P.NDS_SUMM,'
      '110483354=        P.PRICE_SELF,'
      '110483355=        P.SUM_SELF,'
      '110483356=        P.PROFIT,'
      '110483357=        P.IS_HEAD'
      
        '110483358=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110483359=    ORDER BY 1'
      '110483360=  INTO :P_REP_PROFIT_TABLE,'
      '110483361=       :ZAKAZ,'
      '110483362=       :G_TOCHKA,'
      '110483363=       :Z_DATE,'
      '110483364=       :G_CLIENT,'
      '110483365=       :CLIENT_NAME,'
      '110483366=       :G_PAYMENT_TYPE,'
      '110483367=       :PAYMENT_NAME,'
      '110483368=       :OSNOVANIE,'
      '110483369=       :G_PRODUCT,'
      '110483370=       :G_PRODUCT_PAR,'
      '110483371=       :TOVAR_NAME,'
      '110483372=       :ARTICUL,'
      '110483373=       :NOMENCLATUR_NUM,'
      '110483374=       :AMOUNT,'
      '110483375=       :PRICE,'
      '110483376=       :SUMM,'
      '110483377=       :DISCOUNT_PERC,'
      '110483378=       :DISCOUNT_SUMM,'
      '110483379=       :NDS,'
      '110483380=       :NDS_SUMM,'
      '110483381=       :PRICE_SELF,'
      '110483382=       :SUM_SELF,'
      '110483383=       :PROFIT,'
      '110483384=       :IS_HEAD'
      '110483385=  DO'
      '110483386=    suspend;'
      '110483387='
      '110483388=WHEN ANY DO BEGIN'
      '110483389=    Err_code = -20500;'
      
        '110483390=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110483391=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110483392=  END'
      '110483393=end'
      '110483394='#39';'
      '110483395='
      
        '110483396=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_HISTORY' +
        '('
      '110483397=  G_PRODUCT_ARR_ VARCHAR(1000),'
      '110483398=  DATE_BEGIN_ DATE,'
      '110483399=  DATE_END_ DATE,'
      '110483400=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110483401=RETURNS ('
      '110483402=  ROW INTEGER,'
      '110483403=  DATE_ACT DATE,'
      '110483404=  OPER VARCHAR(500),'
      '110483405=  PRICE_PRIHOD NUMERIC(15,2),'
      '110483406=  AMOUNT_PRIHOD MY_NUMERIC_5,'
      '110483407=  SUMM_PRIHOD NUMERIC(15,2),'
      '110483408=  PRICE_UHOD NUMERIC(15,2),'
      '110483409=  AMOUNT_UHOD MY_NUMERIC_5,'
      '110483410=  SUMM_UHOD NUMERIC(15,2),'
      '110483411=  ERR_CODE INTEGER,'
      '110483412=  ERR_MSG VARCHAR(1024))'
      '110483413=AS'
      
        '110483414=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_TOVAR_' +
        'MOVE'#39#39';'
      '110483415=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110483416=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '110483417=DECLARE VARIABLE DATE_SORT DATE;'
      '110483418=BEGIN'
      '110483419='
      '110483420=  FOR SELECT F.G_PRODUCT'
      '110483421=        FROM G_PRODUCT F'
      
