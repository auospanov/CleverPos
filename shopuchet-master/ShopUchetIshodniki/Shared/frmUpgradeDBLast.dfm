      '11042830=               AND SK.IS_LAST = 1'
      '11042831=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '11042832='
      '11042833=            IS_THIS_LAST_ = 1;'
      '11042834=        END */'
      '11042835='
      '11042836='
      '11042837=        INSERT INTO SKLAD'
      '11042838=        ('
