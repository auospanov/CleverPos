      '11068951=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11068952=                     G.PLACE = :PLACE_,'
      
        '11068953=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11068954=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11068955=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
