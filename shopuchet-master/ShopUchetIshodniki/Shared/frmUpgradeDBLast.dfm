      '1101241258=        END'
      '1101241259=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101241260=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1101241261=                                          :G_PRIHOD_,'
      
