      '11044113=  SUMM_N VARCHAR(50),'
      '11044114=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11044115=  SUMM_VSEGO_ VARCHAR(50),'
      '11044116=  NDS_SUMM_ VARCHAR(50),'
      
        '11044117=  G_OFFICIAL_FM_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC *' +
        '/ VARCHAR(150),'
      
        '11044118=  CLIENT_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCH' +
        'AR(250),'
      '11044119=  SUMM_STR_ VARCHAR(500),'
      '11044120=  NDS_SUMM_STR_ VARCHAR(500),'
