      '110233564=          SKLAD S,'
      '110233565=          G_PRODUCT G,'
      '110233566=          P_REP_TREE TR'
      
        '110233567=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||' +
        #39'-'#39
      
