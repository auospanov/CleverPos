        ' -100, :AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD' +
        '_, :AMOUNT_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZ' +
        'VRAT_,'
      
        '1101322281=              :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_,' +
        ' :AMOUNT_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '1101322282='
      '1101322283=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '1101322284=            AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ +' +
        ' AMOUNT_PRIHOD_;'
      
        '1101322285=            SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + S' +
        'UMM_PRIHOD_;'
      
        '1101322286=            AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + A' +
        'MOUNT_UHOD_;'
      
        '1101322287=            SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUM' +
        'M_UHOD_;'
      
