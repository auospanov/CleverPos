        '1101461776=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101461777=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461778=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101461779=                      EXIT;'
      '1101461780=                    END'
      '1101461781=                END'
      '1101461782=            END'
      
        '1101461783=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      
        '1101461784=            --=======================================' +
        '=========================='
      '1101461785='
      
        '1101461786=            --=======================================' +
        '=========================='
      '1101461787=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101461788=            --=======================================' +
        '=========================='
      '1101461789=            PNT_ = '#39'12'#39';'
      
        '1101461790=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1101461791=                KASSA_ = NULL;'
      '1101461792='
      '1101461793=                SELECT S.S_VALUE'
      '1101461794=                  FROM SYSTEM_SETUP S'
      '1101461795=                 WHERE S.SYSTEM_SETUP = 4'
      '1101461796=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101461797='
      '1101461798=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101461799=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101461800=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101461801='
      
        '1101461802=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101461803=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1101461804=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1101461805='
      '1101461806=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101461807=                ELSE'
      
        '1101461808=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1101461809='
      '1101461810=                SELECT K.KASSA, K.SUMM'
      '1101461811=                FROM KASSA K'
      '1101461812=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1101461813=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101461814=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101461815=                 AND K.G_TOCHKA = :G_TOCHKA_'
      
        '1101461816=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_' +
        ';'
      '1101461817='
      '1101461818=                IF (KASSA_ IS NULL) THEN'
      
        '1101461819=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101461820=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101461821=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101461822=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101461823=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1101461824=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1101461825=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1101461826=                                                  1,'
      
        '1101461827=                                                  :G_' +
        'TOCHKA_,'
      
        '1101461828=                                                  :G_' +
        'OFFICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101461829=                ELSE BEGIN'
      
        '1101461830=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_,'
      
        '1101461831=                                                  1, ' +
        '    -- ACTION_'
      
        '1101461832=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101461833=                                                  :SA' +
        'LES_COMM_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_ - :SALES_COMM_OLD_,'
      
        '1101461834=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101461835=                                                  :OF' +
        'FICIAL_NAME_,   --NOTE_'
      
        '1101461836=                                                  NUL' +
        'L,'
      
        '1101461837=                                                  NUL' +
        'L,'
      
        '1101461838=                                                  1, ' +
        '  --:PAYMENT_TYPE_,'
      
        '1101461839=                                                  :G_' +
        'OFFICIAL_'
      
        '1101461840=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101461841=                END'
      '1101461842=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461843=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101461844=                  EXIT;'
      '1101461845=                END'
      '1101461846=            END'
      
        '1101461847=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1101461848=            --=======================================' +
        '=========================='
      '1101461849='
      '1101461850=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1101461851='
      '1101461852=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101461853=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101461854=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101461855=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 2);'
      '1101461856=  END'
      '1101461857=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1101461858=  ---------------------------------------------------' +
        '------------'
      
        '1101461859=  --*************************************************' +
        '************'
      
        '1101461860=  ---------------------------------------------------' +
        '------------'
      '1101461861=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101461862=  ELSE BEGIN'
      '1101461863=      PNT_ = '#39'020'#39';'
      '1101461864=      SELECT SP.G_TOCHKA,'
      '1101461865=             SP.G_CLIENT,'
      '1101461866=             SP.IS_EXPECTED'
      '1101461867=        FROM SKLAD_PARENT SP'
      '1101461868=       WHERE SP.SKLAD = :ZAKAZ_'
      '1101461869=        INTO :G_TOCHKA_OLD_,'
      '1101461870=             :G_TOCHKA_,'
      '1101461871=             :IS_EXPECTED_OLD_;'
      '1101461872='
      
        '1101461873=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101461874=      PNT_ = '#39'021'#39';'
      '1101461875=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '1101461876=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101461877=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461878=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101461879=            EXIT;'
      '1101461880=          END'
      '1101461881='
      '1101461882=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101461883=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101461884=                FROM ZAKAZ_DETAILS_TMP Z'
      '1101461885=              INTO :G_PRODUCT_,'
      '1101461886=                  :Z_AMOUNT_,'
      '1101461887=                  :PRICE_,'
      '1101461888=                  :SUMMM_'
      '1101461889=          DO BEGIN'
      '1101461890=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101461891=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1101461892=            IS_THIS_LAST_ = 0;'
      '1101461893=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101461894=                FROM SKLAD SK'
      '1101461895=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101461896=                 AND SK.IS_LAST = 1'
      '1101461897=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1101461898=                INTO :DATE_LAST_;'
      '1101461899='
      
        '1101461900=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101461901=                UPDATE SKLAD SK'
      '1101461902=                   SET SK.IS_LAST = 0'
      '1101461903=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101461904=                   AND SK.IS_LAST = 1'
      '1101461905=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101461906='
      '1101461907=                IS_THIS_LAST_ = 1;'
      '1101461908=            END'
      '1101461909='
      '1101461910='
      '1101461911=            INSERT INTO SKLAD'
      '1101461912=            ('
      '1101461913=             SKLAD,'
      '1101461914=             SKLAD_PARENT,'
      '1101461915=             DATE_RECEIPT,'
      '1101461916=             G_CLIENT,'
      '1101461917=             G_PRODUCT,'
      '1101461918=             AMOUNT,'
      '1101461919=             PRICE,'
      '1101461920=             SUMM,'
      '1101461921=             G_PAYMENT_TYPE,'
      '1101461922=             OSNOVANIE,'
      '1101461923=             NOTE,'
      '1101461924=             NDS,'
      '1101461925=             NDS_SUMM,'
      '1101461926=             IS_LAST,'
      '1101461927=             IS_VOZVRAT,'
      '1101461928=             G_TOCHKA'
      '1101461929=            ) VALUES ('
      '1101461930=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101461931=             :ZAKAZ_,'
      '1101461932=             :Z_DATE_,'
      '1101461933=             :G_TOCHKA_,'
      '1101461934=             :G_PRODUCT_,'
      '1101461935=             :Z_AMOUNT_,'
      '1101461936=             :PRICE_,'
      '1101461937=             :SUMMM_,'
      '1101461938=             :G_PAYMENT_TYPE_,'
      '1101461939=             :OSNOVANIE_,'
      '1101461940=             :NOTE_,'
      '1101461941=             0,  --:RNDS_,'
      '1101461942=             0,  --:RNDS_SUMM_,'
      
        '1101461943=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1101461944=             3,  --:IS_VOZVRAT_,'
      '1101461945=             :G_CLIENT_'
      '1101461946=            );'
      '1101461947='
      
        '1101461948=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1101461949=            UPDATE LT_SKLAD_PRODUCT L'
      '1101461950=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '1101461951=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101461952=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101461953='
      
        '1101461954=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101461955=            PNT_ = '#39'023'#39';'
      '1101461956=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101461957=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101461958=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_'
      '1101461959=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101461960=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1101461961='
      '1101461962=                IF (ROW_COUNT = 0) THEN'
      
        '1101461963=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_' +
        'SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101461964=            END'
      '1101461965=          END'
      '1101461966=      END'
      '1101461967=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1101461968=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1101461969=      ELSE BEGIN'
      
        '1101461970=          -------------------------------------------' +
        '------------------'
      
        '1101461971=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1101461972=          PNT_ = '#39'025'#39';'
      '1101461973=          FOR SELECT SKLAD,'
      '1101461974=                     AMOUNT,'
      '1101461975=                     G_PRODUCT'
      '1101461976=                FROM SKLAD S'
      '1101461977=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1101461978=                 AND NOT EXISTS (SELECT 1'
      
        '1101461979=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1101461980=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1101461981=          INTO :SKLAD_,'
      '1101461982=               :Z_AMOUNT_,'
      '1101461983=               :G_PRODUCT_'
      '1101461984=          DO BEGIN'
      
        '1101461985=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101461986=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461987=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101461988=              EXIT;'
      '1101461989=            END'
      '1101461990=          END'
      '1101461991='
      '1101461992=          PNT_ = '#39'030'#39';'
      '1101461993=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1101461994=                     S.G_PRODUCT,'
      '1101461995=                     S.AMOUNT,'
      '1101461996=                     S.PRICE,'
      '1101461997=                     S.SUMM,'
      '1101461998=                     T.SKLAD,'
      '1101461999=                     T.AMOUNT,'
      '1101462000=                     T.IS_LAST,'
      '1101462001=                     T.DATE_RECEIPT'
      
        '1101462002=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1101462003=                INTO :ZAKAZ_DETAILS_,'
      '1101462004=                     :G_PRODUCT_,'
      '1101462005=                     :Z_AMOUNT_,'
      '1101462006=                     :PRICE_,'
      '1101462007=                     :SUMMM_,'
      '1101462008=                     :SKLAD_OLD_,'
      '1101462009=                     :AMOUNT_OLD_,'
      '1101462010=                     :IS_THIS_LAST_,'
      '1101462011=                     :DATE_RECEIPT_OLD_'
      '1101462012=          DO BEGIN'
      
        '1101462013=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101462014=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1101462015=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
