        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110206832='
      '110206833=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110206834=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
