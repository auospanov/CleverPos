      '1102251835=                   AND Z.summ_bonus > 0) K,'
      '1102251836=               zakaz zz,'
      '1102251837=               INVOICE I'
      '1102251838=         WHERE K.sklad IS NULL'
      '1102251839=           AND K.zakaz = zz.ZAKAZ'
      
        '1102251840=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
