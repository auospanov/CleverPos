        '1101322290=            AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_' +
        ' + AMOUNT_VOZVRAT_;'
      
        '1101322291=            SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ +' +
        ' SUMM_VOZVRAT_;'
      
        '1101322292=            AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SK' +
        'L_ALL_ + AMOUNT_PRIHOD_SKL_;'
      
        '1101322293=            SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_' +
        'ALL_ + SUMM_PRIHOD_SKL_;'
      
        '1101322294=            AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_' +
        'ALL_ + AMOUNT_UHOD_SKL_;'
      
