        '1102252991=                                                    :' +
        'UPLOAD_TO_EXT_APP_'
      
        '1102252992=                                                    )' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102252993=                END'
      '1102252994=            END'
      '1102252995=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102252996=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102252997=              EXIT;'
      '1102252998=            END'
      '1102252999='
      
        '1102253000=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1102253001=      END'
      '1102253002='
      
        '1102253003=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1102253004=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1102253005=            FROM KASSA K'
      '1102253006=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102253007=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1102253008=           UNION'
      '1102253009=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1102253010=            FROM KASSA K'
      '1102253011=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102253012=             AND K.SUMM = 0'
      '1102253013=          UNION'
      '1102253014=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102253015=            FROM KASSA_BEZNAL K'
      '1102253016=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102253017=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1102253018=          UNION'
      '1102253019=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102253020=            FROM KASSA_BEZNAL K'
      '1102253021=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102253022=             AND K.SUMM = 0'
      '1102253023=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1102253024=      DO BEGIN'
      '1102253025=        PNT_ = '#39'011A'#39';'
      
        '1102253026=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, ' +
        ':ERR_MSG);'
      '1102253027=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102253028=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102253029=          EXIT;'
      '1102253030=        END'
      '1102253031=      END'
      '1102253032=  END'
      '1102253033='
      
        '1102253034=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1102253035=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1102253036=    SELECT K.KASSA'
      '1102253037=      FROM KASSA K'
      '1102253038=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102253039=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102253040=      INTO :KASSA_POP_;'
      '1102253041=  ELSE'
      '1102253042=    SELECT K.KASSA_BEZNAL'
      '1102253043=      FROM KASSA_BEZNAL K'
      '1102253044=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102253045=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102253046=       INTO :KASSA_POP_;'
      '1102253047='
      
        '1102253048=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1102253049=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1102253050=      PNT_ = '#39'012'#39';'
      '1102253051=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1102253052=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1102253053=                                          1,     -- A' +
        'CTION_'
      '1102253054=                                          :G_PRIHOD_,'
      
        '1102253055=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102253056=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102253057=                                          NULL,   --N' +
        'OTE_'
      '1102253058=                                          NULL,'
      
        '1102253059=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102253060=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1102253061=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102253062=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102253063=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1102253064=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102253065=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1102253066=                                          :G_PRIHOD_,'
      
        '1102253067=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102253068=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102253069=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1102253070=                                          NULL,'
      
        '1102253071=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102253072=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102253073=                                          :G_TOCHKA_,'
      
        '1102253074=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102253075=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102253076=      END'
      '1102253077=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102253078=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102253079=        EXIT;'
      '1102253080=      END'
      '1102253081='
      
        '1102253082=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102253083=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102253084=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102253085=        PNT_ = '#39'013'#39';'
      
        '1102253086=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_' +
        'CODE, :ERR_MSG);'
      '1102253087=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102253088=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102253089=          EXIT;'
      '1102253090=        END'
      '1102253091=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102253092=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1102253093=                                          :G_PRIHOD_,'
      
        '1102253094=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102253095=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102253096=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1102253097=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1102253098=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102253099=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102253100=                                          :G_TOCHKA_,'
      
        '1102253101=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102253102=                                         ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102253103=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102253104=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102253105=              EXIT;'
      '1102253106=            END'
      '1102253107=        END'
      '1102253108=  END'
      '1102253109='
      '1102253110=  -- '#1042#1054#1047#1042#1056#1040#1065#1040#1070' '#1041#1054#1053#1059#1057#1067' '#1053#1040' '#1052#1045#1057#1058#1054
      
        '1102253111=  IF (IS_VOZVRAT_ = 1 AND ZAKAZ_ IS NOT NULL) THEN BE' +
        'GIN'
      '1102253112=    SELECT Z.SUMM_BONUS_GOT'
      '1102253113=      FROM ZAKAZ Z'
      '1102253114=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102253115=      INTO :SUMM_BONUS_GOT_;'
      '1102253116='
      '1102253117=    IF (:SUMM_BONUS_GOT_ > 0) THEN BEGIN'
      '1102253118=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '1102253119=              SUM(Z.SUMM)'
      '1102253120=         FROM ZAKAZ Z'
      '1102253121=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '1102253122=         INTO :SUMM_BONUS_GOT_,'
      '1102253123=              :SUMM_ALL_;'
      '1102253124='
      
        '1102253125=       SELECT ROUND( SUM(SP.SUMM * Z.SUMM_BONUS_GOT /' +
        ' Z.SUMM), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040 +
        #1058#1040
      '1102253126=              SUM(SP.SUMM)'
      '1102253127=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '1102253128=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '1102253129=          AND SP.ZAKAZ = Z.ZAKAZ'
      '1102253130=         INTO :BONUS_TO_MINUS_,'
      '1102253131=              :SUMM_TO_MINUS_;'
      '1102253132='
      '1102253133=       UPDATE G_DISCONT_CARD G'
      
        '1102253134=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_M' +
        'INUS_,'
      
        '1102253135=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINU' +
        'S_'
      '1102253136=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '1102253137=    END'
      '1102253138=  END'
      '1102253139='
      
        '1102253140=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102253141=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0,1' +
        ')) THEN'
      
        '1102253142=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      
        '1102253143=    SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PAR' +
        'ENT_, 2, CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END'
      '1102253144=      FROM RDB$DATABASE'
      
        '1102253145=     WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP ' +
        'WHERE AP.OBJECT_TYPE = 2 AND AP.ID = :SKLAD_PARENT_ AND AP.IS_LO' +
        'ADING = 0);'
      '1102253146='
      '1102253147=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102253148=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_PARENT_, :DATE_RECEIPT_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1102253149=end'
      '1102253150=;'
      '1102253151='
      '1102253152='
      
        '1102253153=/****************************************************' +
        '**************************/'
      
        '1102253154=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102253155=/****************************************************' +
        '**************************/'
      '1102253156=ALTER PROCEDURE DO_PRODUCT('
      '1102253157=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102253158=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1102253159=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102253160=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102253161=  NOTE_ TYPE OF COLUMN OTHER.NOTE,'
      
        '1102253162=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102253163=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102253164=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102253165=RETURNS ('
      '1102253166=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1102253167=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1102253168=  ERR_CODE INTEGER,'
      '1102253169=  ERR_MSG VARCHAR(1024))'
      '1102253170=AS'
      '1102253171=/*'
      
        '1102253172='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1102253173='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1102253174=*/'
      
        '1102253175=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1102253176=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102253177=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1102253178=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1102253179=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1102253180=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1102253181=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1102253182=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1102253183=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1102253184=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '1102253185=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102253186=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102253187=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1102253188=DECLARE VARIABLE POS_ INTEGER;'
      '1102253189=DECLARE VARIABLE STR_ VARCHAR(300);'
      '1102253190=BEGIN'
      '1102253191=  PNT_ = '#39'00'#39';'
      '1102253192=  COST_PRICE_ = 0;'
      '1102253193='
      '1102253194=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102253195=    SELECT ID'
      '1102253196=      FROM CUR_PARAMS'
      '1102253197=     WHERE CUR_PARAMS = 2'
      '1102253198=      INTO :G_TOCHKA_;'
      '1102253199='
      '1102253200=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1102253201=  SELECT P.S_VALUE'
      '1102253202=    FROM SYSTEM_SETUP P'
      '1102253203=   WHERE P.SYSTEM_SETUP = 2'
      '1102253204=    INTO :CAN_SELL_;'
      '1102253205='
      '1102253206=  IF (LOG_BODY_ IS NOT NULL) THEN'
      '1102253207=    LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM 3);'
      '1102253208='
      '1102253209=  FOR SELECT :G_PRODUCT_IN_,'
      '1102253210=             :AMOUNT_IN_'
      '1102253211=        FROM RDB$DATABASE'
      '1102253212=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '1102253213=      UNION ALL'
      '1102253214=      SELECT G_PRODUCT,'
      '1102253215=             AMOUNT'
      '1102253216=        FROM ZAKAZ_DETAILS_TMP'
      '1102253217=       WHERE :G_PRODUCT_IN_ IS NULL'
      '1102253218=        INTO :G_PRODUCT_,'
      '1102253219=             :AMOUNT_'
      '1102253220=  DO BEGIN'
      '1102253221=      SELECT MAX(G.NAME)'
      '1102253222=        FROM G_PRODUCT G,'
      '1102253223=             G_PRODUCT_KIT K'
      '1102253224=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1102253225=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1102253226=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_' +
        'PRODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TO' +
        'CHKA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1102253227=        INTO :NAME_;'
      '1102253228='
      
        '1102253229=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN B' +
        'EGIN'
      '1102253230=        ERR_CODE = -20500;'
      
        '1102253231=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087 +
        #1088#1086#1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102253232=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102253233=        EXIT;'
      '1102253234=      END'
      '1102253235='
      '1102253236=      PNT_ = '#39'01'#39';'
      
        '1102253237=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TIME, OP_' +
        'TYPE, ARRIVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '1102253238=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_,' +
        ' CURRENT_TIME, 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '1102253239=      RETURNING OTHER'
      '1102253240=      INTO :OTHER_;'
      '1102253241='
      '1102253242=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1102253243=      COST_PRICE_ = 0;'
      '1102253244=      FOR SELECT K.G_PRODUCT_ITEM'
      '1102253245=                ,K.AMOUNT*:AMOUNT_'
      '1102253246=                ,K.amount'
      '1102253247=                ,G.G_PRODUCT'
      '1102253248=            FROM G_PRODUCT_KIT K'
      '1102253249=                ,G_PRODUCT G'
      '1102253250=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1102253251=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1102253252=            INTO :ITEM_'
      '1102253253=                ,:AMOUNT_NEED_'
      '1102253254=                ,:AMOUNT_NEED_ONE_'
      '1102253255=                ,:G_PRODUCT_KIT_'
      '1102253256=      DO BEGIN'
      
        '1102253257=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_KIT_, NULL, 1)'
      '1102253258=          RETURNING_VALUES :SELF_PRICE_;'
      '1102253259='
      '1102253260=        UPDATE LT_SKLAD_PRODUCT L'
      '1102253261=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_,'
      '1102253262=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102253263=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1102253264=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102253265='
      '1102253266=        IF (ROW_COUNT = 0) THEN'
      
        '1102253267=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :' +
        'G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102253268='
      
        '1102253269=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTH' +
        'ER, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1102253270=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_' +
        ', :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1102253271='
      
        '1102253272=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*' +
        'SELF_PRICE_;'
      '1102253273=      END'
      '1102253274='
      
        '1102253275=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1102253276=      PNT_ = '#39'02'#39';'
      
        '1102253277=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102253278=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1102253279='
      '1102253280=      SUMM_ = AMOUNT_*COST_PRICE_;'
      '1102253281='
      '1102253282=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102253283=                              :DATE_,'
      '1102253284=                              CURRENT_TIME,'
      '1102253285=                              NULL, --:G_CLIENT__,'
      
        '1102253286=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1102253287=                              NULL, --:OSNOVANIE__,'
      '1102253288=                              :NOTE_,'
      '1102253289=                              4, --:IS_VOZVRAT_,'
      '1102253290=                              :SUMM_,'
      '1102253291=                              :SUMM_,'
      '1102253292=                              0, --:G_PRIHOD_,'
      '1102253293=                              0 --:SUMM_PRIHOD_)'
      '1102253294=                              ,NULL     --PAYMENTS_'
      
        '1102253295=                              ,0        --SUMM_CURREN' +
        'CY_'
      
        '1102253296=                              ,0        --IS_EXPECTED' +
        '_'
      '1102253297=                              ,:UPLOAD_TO_EXT_APP_'
      
        '1102253298=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102253299=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102253300=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102253301=          EXIT;'
      '1102253302=      END'
      '1102253303='
      '1102253304=      UPDATE OTHER O'
      '1102253305=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1102253306=      WHERE O.OTHER = :OTHER_;'
      '1102253307='
      '1102253308=      -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102253309=      -- '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1042' '#1058#1040#1050#1054#1052' '#1042#1048#1044#1045' "~*'#1041#1051#1040'-'#1041#1051 +
        #1040' '#1058#1040#1050#1054#1049'-'#1058#1054' '#1058#1054#1042#1040#1056'~*'#1041#1051#1040'-'#1041#1051#1040' '#1042#1058#1054#1056#1054#1049' '#1058#1054#1042#1040#1056'~*"'
      
        '1102253310=      -- '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1042#1067#1056#1045#1047#1040#1058#1068'. '#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1058#1040#1050' '#1044#1045#1051#1040#1058#1068 +
        ' '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1040' '#1058#1059#1058' '#1057#1054#1047#1044#1040#1045#1058#1057#1071
      '1102253311=      -- '#1056#1040#1047#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048'-'#1047#1040#1055#1048#1057#1071#1052#1048
      '1102253312=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1102253313=        POS_ = POSITION('#39'~*'#39' IN LOG_BODY_);'
      
        '1102253314=        IF (CHAR_LENGTH(LOG_BODY_) <> (POS_ + 1)) THE' +
        'N'
      
        '1102253315=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR POS_ ' +
        '- 1);'
      '1102253316=        ELSE'
      
        '1102253317=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR CHAR_' +
        'LENGTH(LOG_BODY_) - 3);'
      '1102253318='
      '1102253319=        --ERR_CODE = -20500;'
      '1102253320=        --ERR_MSG = STR_; EXIT;'
      '1102253321='
      
        '1102253322=        EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, ' +
        ':OTHER_, :DATE_, 1, :SUMM_, :STR_, 1);'
      '1102253323='
      
        '1102253324=        LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM (POSIT' +
        'ION('#39'~*'#39' IN LOG_BODY_)) + 2);'
      '1102253325=      END'
      '1102253326=  END'
      '1102253327=END'
      '1102253328=;'
      '1102253329='
      '1102253330=ALTER PROCEDURE P_REP_ZAYAVKA_POSTAVSHIK('
      '1102253331=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102253332=  BEGIN_DATE_ DATE,'
      '1102253333=  END_DATE_ DATE,'
      '1102253334=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102253335=  DO_SKLAD_ INTEGER,'
      '1102253336=  MODE_ INTEGER,'
      '1102253337=  MODE_VYBOR_ INTEGER,'
      '1102253338=  MODE_VAL_ INTEGER,'
      '1102253339=  NEW_VAL_ MY_NUMERIC_5,'
      '1102253340=  ROUND_MODE_ INTEGER)'
      '1102253341=RETURNS ('
      '1102253342=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102253343=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '1102253344=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102253345=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102253346=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1102253347=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1102253348=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1102253349=  ERR_CODE INTEGER,'
      '1102253350=  ERR_MSG VARCHAR(1024))'
      '1102253351=AS'
      '1102253352=/*'
      
        '1102253353='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057 +
        #1056#1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '1102253354='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055 +
        #1054#1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '1102253355=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055 +
        #1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '1102253356=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 -' +
        ' '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '1102253357=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058 +
        #1054#1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045 +
        ' '#1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102253358=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '1102253359=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067 +
        #1042#1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      
        '1102253360=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' *' +
        '/'
      '1102253361=DECLARE VARIABLE ROUND_ INTEGER;'
      '1102253362=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '1102253363=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      
        '1102253364=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PA' +
        'RENT;'
      '1102253365=BEGIN'
      '1102253366=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102253367='
      '1102253368=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102253369=    SELECT ID'
      '1102253370=      FROM CUR_PARAMS'
      '1102253371=     WHERE CUR_PARAMS = 2'
      '1102253372=      INTO :G_TOCHKA_;'
      '1102253373='
      '1102253374=  IF (ROUND_MODE_ = 0) THEN'
      '1102253375=      ROUND_ = 0;'
      '1102253376=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '1102253377=      ROUND_ = -1;'
      '1102253378=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '1102253379=      ROUND_ = -2;'
      '1102253380=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '1102253381=      ROUND_ = -3;'
      '1102253382=  ELSE IF (ROUND_MODE_ = -1) THEN'
      '1102253383=      ROUND_ = 5;'
      '1102253384='
      
        '1102253385=  SQL_STR_ = '#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39';'
      '1102253386='
      
        '1102253387=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040 +
        ' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102253388=  IF (MODE_ = 0) THEN BEGIN'
      
        '1102253389=    SQL_STR_ = SQL_STR_ || '#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39';'
      '1102253390=    IF (MODE_VAL_ = 0) THEN'
      '1102253391=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1102253392=    ELSE'
      
        '1102253393=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1102253394='
      '1102253395=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1102253396=  END'
      '1102253397=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '1102253398=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '1102253399=    SQL_STR_ = SQL_STR_ || '#39'ROUND(ABS(LT.AMOUNT)'#39';'
      '1102253400=    IF (MODE_VAL_ = 0) THEN'
      '1102253401=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1102253402=    ELSE'
      
        '1102253403=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1102253404='
      '1102253405=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1102253406=  END'
      '1102253407='
      
        '1102253408=  SQL_STR_ = SQL_STR_ || '#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39'||'
      
        '1102253409=            '#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39';'
      '1102253410='
      '1102253411=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '1102253412=    SQL_STR_ = SQL_STR_ ||'#39'AND EXISTS (SELECT 1'#39'||'
      
        '1102253413=                                        '#39' FROM SKLAD ' +
        'S'#39'||'
      
        '1102253414=                                        '#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39'||'
      
        '1102253415=                                        '#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39'||'
      
        '1102253416=                                        '#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39';'
      '1102253417=    IF (MODE_VYBOR_ = 2) THEN'
      
        '1102253418=      SQL_STR_ = SQL_STR_ ||'#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39';'
      '1102253419=    ELSE'
      
        '1102253420=      SQL_STR_ = SQL_STR_ ||'#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053 +
        #1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042#1057 +
        #1045#1043#1044#1040
      '1102253421=    SQL_STR_ = SQL_STR_ ||'#39') '#39';'
      '1102253422=  END ELSE BEGIN'
      
        '1102253423=    SQL_STR_ = SQL_STR_ ||'#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39';  --' +
        ' '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '1102253424=  END'
      '1102253425='
      '1102253426=  IF (MODE_ = 0) THEN'
      
        '1102253427=    SQL_STR_ = SQL_STR_ || '#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39';'
      '1102253428=  ELSE IF (MODE_ = 1) THEN'
      '1102253429=    SQL_STR_ = SQL_STR_ || '#39' AND LT.AMOUNT < 0'#39';'
      
        '1102253430=  SQL_STR_ = SQL_STR_ || '#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39';'
      '1102253431='
      '1102253432=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '1102253433=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '1102253434=      FOR EXECUTE STATEMENT'
      
        '1102253435=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1102253436=          INTO :G_PRODUCT,'
      '1102253437=               :CATEGORY_NAME,'
      '1102253438=               :NAME,'
      '1102253439=               :ARTICUL,'
      '1102253440=               :AMOUNT_CUR,'
      '1102253441=               :MIN_AMOUNT,'
      '1102253442=               :AMOUNT_TO_ZAKAZ'
      '1102253443=        DO BEGIN'
      
        '1102253444=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_' +
        'PRODUCT, :G_TOCHKA_, 0)'
      '1102253445=              RETURNING_VALUES :COST_PRICE_;'
      '1102253446='
      
        '1102253447=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, ' +
        'AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102253448=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_' +
        'PRODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO' +
        '_ZAKAZ, 0, 0);'
      '1102253449=        END'
      '1102253450='
      '1102253451=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102253452=                                      CURRENT_DATE,'
      '1102253453=                                      CURRENT_TIME,'
      '1102253454=                                      :G_CLIENT_,'
      '1102253455=                                      1,'
      
        '1102253456=                                      NULL, --:OSNOVA' +
        'NIE__,'
      
        '1102253457=                                      NULL, --:NOTE__' +
        ','
      
        '1102253458=                                      0, --:IS_VOZVRA' +
        'T_,'
      
        '1102253459=                                      (SELECT SUM(S.S' +
        'UMM) FROM SKLAD_TMP S),'
      
        '1102253460=                                      0, -- :SUMM_FAC' +
        'T_'
      
        '1102253461=                                      0, --:G_PRIHOD_' +
        ','
      
        '1102253462=                                      0 --:SUMM_PRIHO' +
        'D_)'
      
        '1102253463=                                      ,NULL --PAYMENT' +
        'S'
      
        '1102253464=                                     )RETURNING_VALUE' +
        'S :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102253465=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102253466=          ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39'||ERR_MSG;'
      '1102253467=          EXIT;'
      '1102253468=        END'
      '1102253469=  END'
      '1102253470=  ELSE BEGIN'
      '1102253471=      FOR EXECUTE STATEMENT'
      
        '1102253472=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1102253473=      INTO :G_PRODUCT,'
      '1102253474=           :CATEGORY_NAME,'
      '1102253475=           :NAME,'
      '1102253476=           :ARTICUL,'
      '1102253477=           :AMOUNT_CUR,'
      '1102253478=           :MIN_AMOUNT,'
      '1102253479=           :AMOUNT_TO_ZAKAZ'
      '1102253480=      DO SUSPEND;'
      '1102253481=  END'
      '1102253482=END'
      '1102253483=;'
      '1102253484='
      '1102253485=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1102253486=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102253487=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102253488=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102253489=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102253490=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102253491=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102253492=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102253493=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102253494=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102253495=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102253496=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102253497=RETURNS ('
      '1102253498=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102253499=  ERR_CODE INTEGER,'
      '1102253500=  ERR_MSG VARCHAR(1024))'
      '1102253501=AS'
      
        '1102253502=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1102253503=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1102253504=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102253505=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1102253506='
      
        '1102253507=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102253508=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1102253509=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1102253510=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102253511=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102253512=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102253513=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1102253514=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1102253515=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1102253516=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1102253517=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102253518=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1102253519=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1102253520=BEGIN'
      '1102253521='
      '1102253522=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102253523=    SELECT ID'
      '1102253524=      FROM CUR_PARAMS'
      '1102253525=     WHERE CUR_PARAMS = 2'
      '1102253526=      INTO :G_TOCHKA_;'
      '1102253527='
      
        '1102253528=  --*************************************************' +
        '*************************************************'
      
        '1102253529=  --*************************************************' +
        '*************************************************'
      '1102253530=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102253531=  --*************************************************' +
        '*************************************************'
      
        '1102253532=  --*************************************************' +
        '*************************************************'
      '1102253533=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1102253534=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1102253535=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1102253536=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102253537=            INTO :AMOUNT_,'
      '1102253538=                 :G_PRODUCT_'
      '1102253539=      DO BEGIN'
      '1102253540=          UPDATE LT_SKLAD_PRODUCT L'
      
        '1102253541=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_      ' +
        '-- 03.03.2021 '#1057#1070#1044#1040' '#1053#1045' '#1057#1058#1040#1051' '#1057#1058#1040#1042#1048#1058#1068' NEED_TO_REPLACE '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1047#1040 +
        #1063#1045#1052
      '1102253542=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102253543=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102253544=      END'
      '1102253545='
      '1102253546=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1102253547=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1102253548=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1102253549=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1102253550=             NDS_SUMM, COST_PRICE'
      '1102253551=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102253552='
      '1102253553=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102253554=                                  :Z_DATE_,'
      '1102253555=                                  :Z_TIME_,'
      '1102253556=                                  :G_CLIENT_,'
      '1102253557=                                  :G_PAYMENT_TYPE_,'
      '1102253558=                                  :OSNOVANIE_,'
      
        '1102253559=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1102253560=                                  :NOTE_,'
      
        '1102253561=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1102253562=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1102253563=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1102253564=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1102253565=                                  0, --SUMM_BONUS_'
      
        '1102253566=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1102253567=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102253568=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1102253569=                                  0,    --BY_RECIPE'
      '1102253570=                                  0     --IS_RESERVE'
      '1102253571=                                  ,NULL  -- PAYMENTS_'
      '1102253572=                                  ,0     --IS_MEBEL_'
      
        '1102253573=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1102253574=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1102253575=                                  ,NULL  --ADDRESS_'
      '1102253576=                                  ,NULL  --PRICE_'
      
        '1102253577=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      '1102253578=                                  )'
      '1102253579=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102253580='
      '1102253581=      if (ERR_CODE <> 0) then BEGIN'
      '1102253582=        ERR_CODE = -20500;'
      '1102253583=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102253584=        Exit;'
      '1102253585=      END'
      '1102253586='
      
        '1102253587=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102253588=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1102253589=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1102253590=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1102253591=      UPDATE ZAKAZ'
      '1102253592=         SET IS_SPISANIE = 2'
      '1102253593=       WHERE ZAKAZ = :ZAKAZ_;'
      '1102253594='
      
        '1102253595=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102253596=      FOR SELECT T.AMOUNT,'
      '1102253597=                 T.SUMM,'
      '1102253598=                 T.G_PRODUCT,'
      '1102253599=                 T.ZAKAZ_NA_REAL,'
      '1102253600=                 T.ZAKAZ_DETAILS'
      '1102253601=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102253602=            INTO :AMOUNT_,'
      '1102253603=                 :Z_SUMM_,'
      '1102253604=                 :G_PRODUCT_,'
      '1102253605=                 :ZAKAZ_NA_REAL_,'
      '1102253606=                 :ZAKAZ_DETAILS_'
      '1102253607=      DO BEGIN'
      '1102253608=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102253609=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1102253610=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1102253611=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102253612=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102253613='
      
        '1102253614=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102253615=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1102253616=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1102253617=      END'
      '1102253618=  END'
      '1102253619=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102253620=  --*************************************************' +
        '*************************************************'
      
        '1102253621=  --*************************************************' +
        '*************************************************'
      '1102253622='
      
        '1102253623=  --*************************************************' +
        '*************************************************'
      
        '1102253624=  --*************************************************' +
        '*************************************************'
      '1102253625=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102253626=  --*************************************************' +
        '*************************************************'
      
        '1102253627=  --*************************************************' +
        '*************************************************'
      '1102253628=  ELSE BEGIN'
      '1102253629=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1102253630=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102253631=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102253632=      FOR SELECT T.AMOUNT,'
      '1102253633=                 T.SUMM,'
      '1102253634=                 T.G_PRODUCT,'
      '1102253635=                 T.ZAKAZ_NA_REAL,'
      '1102253636=                 T.ZAKAZ_DETAILS'
      '1102253637=                 ,T.PRICE'
      '1102253638=                 ,T.NDS'
      '1102253639=                 ,T.NDS_SUMM'
      '1102253640=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102253641=            INTO :AMOUNT_,'
      '1102253642=                 :Z_SUMM_,'
      '1102253643=                 :G_PRODUCT_,'
      '1102253644=                 :ZAKAZ_NA_REAL_,'
      '1102253645=                 :ZAKAZ_DETAILS_'
      '1102253646=                 ,:PRICE_'
      '1102253647=                 ,:NDS_'
      '1102253648=                 ,:NDS_SUMM_'
      '1102253649=      DO BEGIN'
      
        '1102253650=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102253651=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1102253652='
      
        '1102253653=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1102253654=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1102253655='
      '1102253656=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102253657=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1102253658=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1102253659=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102253660=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102253661=      END'
      '1102253662='
      '1102253663=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102253664=                                  :Z_DATE_,'
      '1102253665=                                  :Z_TIME_,'
      '1102253666=                                  :G_CLIENT_,'
      '1102253667=                                  :G_PAYMENT_TYPE_,'
      '1102253668=                                  :OSNOVANIE_,'
      '1102253669=                                  :NOTE_,'
      
        '1102253670=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1102253671=                                  :SUMM_,'
      '1102253672=                                  :SUMM_FACT_,'
      
        '1102253673=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1102253674=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1102253675=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1102253676=                                  ,0        --SUMM_CU' +
        'RRENCY_'
      
        '1102253677=                                  ,0        --IS_EXPE' +
        'CTED_'
      
        '1102253678=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      
        '1102253679=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102253680='
      '1102253681=      if (ERR_CODE <> 0) then BEGIN'
      '1102253682=        ERR_CODE = -20500;'
      '1102253683=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102253684=        Exit;'
      '1102253685=      END'
      '1102253686=  END'
      '1102253687=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102253688=  --*************************************************' +
        '*************************************************'
      
        '1102253689=  --*************************************************' +
        '*************************************************'
      '1102253690='
      '1102253691=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102253692=END'
      '1102253693=;'
      '1102253694='
      '1102253695=ALTER PROCEDURE R_MADE_REVISION('
      
        '1102253696=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102253697=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102253698=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102253699=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102253700=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102253701=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '1102253702=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102253703=RETURNS ('
      '1102253704=  COUNT_SPIS_ INTEGER,'
      '1102253705=  COUNT_PRIH_ INTEGER,'
      
        '1102253706=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT' +
        '.REVISION_PARENT,'
      '1102253707=  ERR_CODE INTEGER,'
      '1102253708=  ERR_MSG VARCHAR(1024))'
      '1102253709=AS'
      
        '1102253710=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVIS' +
        'ION'#39';'
      '1102253711=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102253712=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102253713=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102253714=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102253715=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102253716=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102253717=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102253718=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102253719=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102253720=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      
        '1102253721=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REV' +
        'ISION.DATETIME_CREATED;'
      
        '1102253722=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.AMOUNT;'
      '1102253723=BEGIN'
      '1102253724='
      '1102253725=  COUNT_SPIS_ = 0;'
      '1102253726=  COUNT_PRIH_ = 0;'
      '1102253727='
      '1102253728=  PNT_ = '#39'00'#39';'
      '1102253729=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '1102253730=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGI' +
        'N_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '1102253731=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102253732='
      '1102253733=     IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102253734=       ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '1102253735=       EXIT;'
      '1102253736=     END'
      '1102253737=  END'
      '1102253738='
      '1102253739=  PNT_ = '#39'01'#39';'
      
        '1102253740=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL, DATETIME_CREATED'
      '1102253741=      FROM REVISION_TMP'
      '1102253742=      --WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102253743=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_, :DATETIME_CREATED_'
      '1102253744=  DO BEGIN'
      '1102253745=    /*SELECT SUM(ZD.AMOUNT)'
      '1102253746=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102253747=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ A' +
        'S DATE) AND CURRENT_DATE'
      
        '1102253748=       AND Z.Z_TIME >= CAST(:DATETIME_CREATED_ AS TIM' +
        'E)'
      '1102253749=       AND Z.Z_TIME <= CURRENT_TIME'
      '1102253750=       AND Z.IS_SPISANIE IN (0, 1)'
      '1102253751=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102253752=      INTO :AMOUNT_SALED_;*/'
      '1102253753='
      '1102253754=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '1102253755=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102253756=        RETURNING_VALUES :COST_PRICE_;'
      '1102253757='
      
        '1102253758=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102253759=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102253760=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/, :COST_PRICE_' +
        ', :COST_PRICE_ * (:AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_' +
        '*/), 0, 0, 0, 0, 0);'
      '1102253761='
      '1102253762=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102253763=    END'
      '1102253764='
      '1102253765=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      '1102253766=      SELECT S.price'
      '1102253767=        FROM SKLAD S'
      '1102253768=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102253769=         AND S.g_product = :G_PRODUCT_'
      '1102253770=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102253771=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102253772=                                 FROM SKLAD DD'
      
        '1102253773=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102253774=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102253775=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102253776=                                )'
      '1102253777=        ORDER BY s.sklad DESC'
      '1102253778=        ROWS 1 TO 1'
      '1102253779=        INTO :PRICE_LAST_;'
      '1102253780='
      
        '1102253781=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102253782='
      
        '1102253783=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102253784=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/, :PRICE_LAST_' +
        ', (:AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/) * :PRICE_LA' +
        'ST_, 0, 0);'
      '1102253785='
      '1102253786=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102253787=    END'
      '1102253788=  END'
      '1102253789='
      '1102253790=  PNT_ = '#39'01A'#39';'
      '1102253791=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102253792=    SELECT SUM(S.SUMM)'
      '1102253793=      FROM ZAKAZ_DETAILS_TMP S'
      '1102253794=      INTO :SUMM_;'
      '1102253795='
      '1102253796=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102253797=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102253798=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102253799=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102253800=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102253801=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102253802=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102253803=                                NULL,           --:NO' +
        'TE_,'
      
        '1102253804=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102253805=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102253806=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102253807=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102253808=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102253809=                                NULL,'
      
        '1102253810=                                0,        -- BY_RECIP' +
        'E'
      
        '1102253811=                                0         -- IS_RESER' +
        'VE'
      '1102253812=                                ,NULL  -- PAYMENTS_'
      '1102253813=                                ,0     -- SUMM_CASH'
      
        '1102253814=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102253815=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102253816=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102253817=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102253818=      EXIT;'
      '1102253819=    END'
      '1102253820=  END'
      '1102253821='
      '1102253822=  PNT_ = '#39'02'#39';'
      '1102253823=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102253824=    SELECT SUM(S.SUMM)'
      '1102253825=      FROM SKLAD_TMP S'
      '1102253826=      INTO :SUMM_;'
      '1102253827='
      '1102253828=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102253829=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102253830=                                CURRENT_TIME,'
      
        '1102253831=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102253832=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102253833=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102253834=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102253835=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102253836=                                :SUMM_,'
      '1102253837=                                :SUMM_,'
      
        '1102253838=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102253839=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102253840=                                ,NULL  --PAYMENTS'
      '1102253841=                                )'
      
        '1102253842=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102253843=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102253844=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102253845=      EXIT;'
      '1102253846=    END'
      '1102253847=  END'
      '1102253848='
      '1102253849=  UPDATE REVISION_PARENT RP'
      '1102253850=     SET RP.IS_MADE = 1,'
      '1102253851=         RP.DATE_END = :DATE_END_,'
      '1102253852=         RP.TIME_END = :TIME_END_'
      '1102253853=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '1102253854='
      '1102253855=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '1102253856=END'
      '1102253857=;'
      '1102253858='
      '1102253859=ALTER PROCEDURE R_UNIFICATION('
      '1102253860=  MODE_ INTEGER)'
      '1102253861=RETURNS ('
      '1102253862=  COUNT_SPIS_ INTEGER,'
      '1102253863=  COUNT_PRIH_ INTEGER,'
      '1102253864=  ERR_CODE INTEGER,'
      '1102253865=  ERR_MSG VARCHAR(1024))'
      '1102253866=AS'
      
        '1102253867=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1102253868=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102253869=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102253870=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102253871=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102253872=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102253873=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102253874=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102253875=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102253876=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102253877=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102253878=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102253879=BEGIN'
      '1102253880='
      '1102253881=  COUNT_SPIS_ = 0;'
      '1102253882=  COUNT_PRIH_ = 0;'
      '1102253883='
      '1102253884=  SELECT ID'
      '1102253885=    FROM CUR_PARAMS'
      '1102253886=   WHERE CUR_PARAMS = 2'
      '1102253887=    INTO :G_TOCHKA_;'
      '1102253888='
      
        '1102253889=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1102253890=      FROM REVISION'
      '1102253891=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1102253892=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1102253893=  DO BEGIN'
      
        '1102253894=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1102253895=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102253896=        RETURNING_VALUES :COST_PRICE_;'
      '1102253897='
      
        '1102253898=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102253899=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102253900=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1102253901='
      '1102253902=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102253903=    END'
      '1102253904='
      
        '1102253905=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1102253906=      SELECT S.price'
      '1102253907=        FROM SKLAD S'
      '1102253908=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102253909=         AND S.g_product = :G_PRODUCT_'
      '1102253910=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102253911=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102253912=                                 FROM SKLAD DD'
      
        '1102253913=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102253914=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102253915=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102253916=                                )'
      '1102253917=        ORDER BY s.sklad DESC'
      '1102253918=        ROWS 1 TO 1'
      '1102253919=        INTO :PRICE_LAST_;'
      '1102253920='
      '1102253921=    /* SELECT S.PRICE'
      '1102253922=        FROM SKLAD S'
      '1102253923=       WHERE S.IS_LAST = 1'
      '1102253924=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1102253925=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1102253926=        INTO :PRICE_LAST_; */'
      '1102253927='
      
        '1102253928=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102253929='
      
        '1102253930=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102253931=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1102253932='
      '1102253933=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102253934=    END'
      '1102253935='
      '1102253936=    UPDATE REVISION R'
      '1102253937=       SET R.IS_UNIFIED = 1'
      '1102253938=     WHERE R.REVISION = :REVISION_;'
      '1102253939=  END'
      '1102253940='
      '1102253941=  PNT_ = '#39'01'#39';'
      '1102253942=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102253943=    SELECT SUM(S.SUMM)'
      '1102253944=      FROM ZAKAZ_DETAILS_TMP S'
      '1102253945=      INTO :SUMM_;'
      '1102253946='
      '1102253947=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102253948=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102253949=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102253950=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102253951=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102253952=                                NULL,         --:OSNO' +
        'VANIE_,'
      
