        'KA_,'
      
        '1102201372=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102201373=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102201374='
      
        '1102201375=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102201376=            ELSE BEGIN'
      
        '1102201377=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102201378=                SELECT 1'
      '1102201379=                  FROM KASSA K'
      '1102201380=                 WHERE K.KASSA = :KASSA_'
      '1102201381=                UNION ALL'
      '1102201382=                SELECT 2'
      '1102201383=                  FROM KASSA_BEZNAL KB'
      '1102201384=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102201385=                 INTO :PAYMENT_TYPE_OLD_;'
      '1102201386='
      
        '1102201387=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102201388=                      PNT_ = '#39'010'#39';'
      
        '1102201389=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1102201390=                                                    1' +
        ',     -- ACTION_'
      
        '1102201391=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1102201392=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1102201393=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1102201394=                                                    N' +
