        ' '#1055#1059#1057#1058#1067#1052
      
        '110237567=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110237568=     GROUP BY TR.PATH'
      '110237569=     ORDER BY TR.PATH'
      '110237570=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '110237571=  DO BEGIN'
      '110237572='
      '110237573=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '110237574=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110237575=      insert into p_rep_profit_table'
      '110237576=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110237577=      values'
      
        '110237578=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39', 1);'
      '110237579='
      '110237580=      IS_FIRST_ = 0;'
      '110237581=    END'
      '110237582='
      '110237583=    insert into p_rep_profit_table'
      
        '110237584=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110237585=    values'
      '110237586=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110237587=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZAK' +
        'AZ_, 0);'
      '110237588='
      '110237589=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '110237590=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '110237591=  END'
      '110237592='
      '110237593=  if (SUM_COST_ > 0) then BEGIN'
      '110237594=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110237595=    insert into p_rep_profit_table'
      
        '110237596=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110237597=    values'
      
        '110237598=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0, ' +
        ':SUM_COST_, 0, :PROFIT_, 2);'
      '110237599='
      '110237600=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110237601=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110237602=  END'
      '110237603=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110237604=  --**************************************************' +
        '***************************************'
      '110237605='
      
        '110237606=  --**************************************************' +
        '***************************************'
      '110237607=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110237608=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048#1045 +
        #1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '110237609=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053#1054 +
        '", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '110237610=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' '#1055 +
        #1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '110237611='
      
        '110237612=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '110237613=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 45' +
        '00'
      
        '110237614=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056#1048 +
        #1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057#1054 +
        #1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '110237615=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070#1047 +
        #1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054' ' +
        #1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      
        '110237616=  --**************************************************' +
        '***************************************'
      '110237617=  IS_FIRST_  = 1;'
      '110237618=  SUM_ZAKAZ_ = 0;'
      '110237619=  PROFIT_    = 0;'
      '110237620=  FOR SELECT -SUM(S.SUMM),'
      '110237621=             SUM(S.COST_PRICE)'
      '110237622=             ,TR.PATH'
      '110237623=     FROM SKLAD_PARENT SP,'
      '110237624=          SKLAD S,'
      '110237625=          G_PRODUCT G,'
      '110237626=          P_REP_TREE TR'
      
        '110237627=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||' +
        #39'-'#39
      
        '110237628=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110237629=      AND SP.IS_VOZVRAT IN (1,2)'
      '110237630=      and G.g_product_PAR = TR.g_product'
      
        '110237631=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'S.G_CLIENT, 0))'
      
        '110237632=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE' +
        '_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110237633=      AND SP.SKLAD = S.SKLAD_PARENT'
      '110237634=      AND S.G_PRODUCT = G.G_PRODUCT'
      '110237635=      AND ((EXISTS (SELECT 1'
      '110237636=                       FROM SKLAD SS'
      '110237637=                      WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '110237638=                        AND SS.G_PRODUCT = G.G_PRODUCT'
      
        '110237639=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110237640=              OR'
      '110237641=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110237642=     GROUP BY TR.PATH'
      '110237643=     ORDER BY TR.PATH'
      '110237644=     INTO :V_SUMM_,'
      '110237645=          :REC_SUM_COST_,'
      '110237646=          :REC_TOVAR_NAME_'
      '110237647=  DO BEGIN'
      '110237648=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '110237649=      insert into p_rep_profit_table'
      '110237650=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110237651=      values'
      
        '110237652=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058 +
        #1054#1042#1040#1056#1040#39', 1);'
      '110237653='
      '110237654=      IS_FIRST_ = 0;'
      '110237655=    END'
      '110237656='
      '110237657=    REC_profit_   = REC_SUM_COST_ + V_SUMM_;'
      '110237658=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110237659=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM,' +
        ' SUM_SELF, PROFIT, IS_HEAD)'
      '110237660=    VALUES'
      
        '110237661=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, :V_SUMM_, 0, :REC_SUM_COST_, :REC_profit_, 0);'
      '110237662='
      '110237663=    SUM_COST_ = SUM_COST_  + REC_SUM_COST_;'
      '110237664=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '110237665=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110237666=  END'
      '110237667='
      '110237668=  IF (SUM_ZAKAZ_ <> 0) then BEGIN'
      '110237669=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110237670=    SUMM_COST_All_ = SUMM_COST_All_ - SUM_COST_;'
      '110237671=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110237672='
      '110237673=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110237674=    insert into p_rep_profit_table'
      
        '110237675=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110237676=    values'
      
        '110237677=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, 0, :PROFIT_, 2);'
      '110237678=  END'
      '110237679=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110237680=  --**************************************************' +
        '***************************************'
      '110237681='
      
        '110237682=  --**************************************************' +
        '***************************************'
      
        '110237683=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048 +
        #1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110237684=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054 +
        #1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110237685=  --**************************************************' +
        '***************************************'
      '110237686=  IS_FIRST_  = 1;'
      '110237687=  SUM_ZAKAZ_ = 0;'
      '110237688=  SUM_COST_  = 0;'
      '110237689=  PROFIT_    = 0;'
      '110237690=  NDS_SUMM_  = 0;'
      '110237691=  FOR SELECT SUM(ZD.SUMM)'
      '110237692=           ,TR.PATH'
      '110237693=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '110237694=           ,SUM(ZD.nds_summ)'
      '110237695=      FROM ZAKAZ Z,'
      '110237696=           ZAKAZ_DETAILS ZD,'
      '110237697=           G_PRODUCT GP,'
      '110237698=           P_REP_TREE TR'
      
        '110237699=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110237700=       AND Z.IS_SPISANIE = 2'
      '110237701=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110237702=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110237703=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110237704=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110237705=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110237706=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110237707=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '110237708=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110237709=       AND ((EXISTS (SELECT 1'
      '110237710=                       FROM SKLAD S'
      '110237711=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110237712=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110237713=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110237714=              OR'
      '110237715=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110237716=     GROUP BY TR.PATH'
      '110237717=     ORDER BY TR.PATH'
      
        '110237718=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST_' +
        ', REC_NDS_SUMM_'
      '110237719=  DO BEGIN'
      '110237720=    IF (IS_FIRST_ = 1) then BEGIN'
      '110237721=      insert into p_rep_profit_table'
      '110237722=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110237723=      values'
      
        '110237724=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '110237725='
      '110237726=      IS_FIRST_ = 0;'
      '110237727=    END'
      '110237728='
      
        '110237729=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS_' +
        'SUMM_;'
      '110237730='
      '110237731=    insert into p_rep_profit_table'
      
        '110237732=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110237733=    values'
      '110237734=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110237735=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_, ' +
        ':REC_SUM_COST_, :REC_PROFIT_, 0);'
      '110237736='
      '110237737=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '110237738=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, 0' +
        ');'
      
        '110237739=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, 0' +
        ');'
      '110237740=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110237741=  END'
      '110237742='
      '110237743=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '110237744=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110237745=    insert into p_rep_profit_table'
      
        '110237746=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110237747=    values'
      
        '110237748=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090#1086 +
        #1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT' +
        '_, 2);'
      '110237749='
      '110237750=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110237751=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110237752=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110237753=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '110237754=  END'
      '110237755=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110237756=  --**************************************************' +
        '***************************************'
      '110237757=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '110237758=  insert into p_rep_profit_table'
      '110237759=    (p_rep_profit_table, is_head)'
      '110237760=  values'
      '110237761=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110237762='
      '110237763=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '110237764=  insert into p_rep_profit_table'
      
        '110237765=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110237766=  values'
      
        '110237767=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072#1079 +
        #1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT_' +
        'ALL_, 1);'
      '110237768='
      '110237769=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '110237770=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110237771=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110237772=         SUM(Z.SUMM_BONUS)'
      '110237773=    FROM ZAKAZ Z'
      
        '110237774=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      
        '110237775=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1089 +
        #1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '110237776=     AND Z.IS_RESERVE = 0'
      '110237777=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110237778=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110237779=     AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFFIC' +
        'IAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '110237780=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110237781=     AND ((EXISTS (SELECT 1'
      '110237782=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '110237783=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '110237784=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '110237785=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '110237786=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110237787=          OR'
      '110237788=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110237789=    INTO :SUMM_CASH_ALL_,'
      '110237790=         :SUMM_NONCASH_ALL_,'
      '110237791=         :SUMM_BONUS_ALL_;'
      '110237792='
      
        '110237793=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052', '#1058#1059#1058' '#1053#1045' '#1055#1054 +
        #1051#1059#1063#1040#1045#1058#1057#1071' '#1059#1063#1048#1058#1067#1042#1040#1058#1068' '#1041#1054#1053#1059#1057#1067', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1042#1054#1047#1042#1056#1040#1058#1040#1061' '#1054#1053#1048' '#1053#1045' '#1061#1056#1040#1053#1071#1058#1057 +
        #1071
      
        '110237794=  SELECT SUM((SELECT K.SUMM FROM KASSA K WHERE K.SKLAD' +
        ' = SP.SKLAD)),'
      
        '110237795=         SUM((SELECT K1.SUMM FROM KASSA_BEZNAL K1 WHER' +
        'E K1.SKLAD = SP.SKLAD))'
      '110237796=     FROM SKLAD_PARENT SP'
      
        '110237797=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||' +
        #39'-'#39
      
        '110237798=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110237799=      AND SP.IS_VOZVRAT IN (1,2)'
      
        '110237800=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'SP.G_CLIENT, 0))'
      
        '110237801=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE' +
        '_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '110237802=      AND ((EXISTS (SELECT 1'
      '110237803=                       FROM SKLAD S, SKLAD SS'
      '110237804=                      WHERE S.SKLAD_PARENT = SP.SKLAD'
      '110237805=                        AND S.G_PRODUCT = SS.G_PRODUCT'
      '110237806=                        AND SS.G_CLIENT = :G_SUPPLIER_'
      '110237807=                        AND SS.IS_VOZVRAT = 0'
      
        '110237808=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110237809=              OR'
      '110237810=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110237811=    INTO :SUMM_CASH_RETURN_,'
      '110237812=         :SUMM_NONCASH_RETURN_;'
      '110237813='
      
        '110237814=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COALE' +
        'SCE(SUMM_CASH_RETURN_, 0);'
      
        '110237815=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) -' +
        ' COALESCE(SUMM_NONCASH_RETURN_, 0);'
      '110237816=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110237817='
      '110237818=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110237819='
      
        '110237820=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '110237821=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110237822='
      '110237823=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110237824=    SELECT G.NAME'
      '110237825=      FROM G_CLIENT G'
      '110237826=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110237827=    INTO :CLIENT_NAME_;'
      '110237828=  ELSE'
      '110237829=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '110237830='
      '110237831=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110237832=    SELECT G.NAME'
      '110237833=      FROM G_PAYMENT_TYPE G'
      '110237834=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110237835=    INTO :PAYMENT_NAME_;'
      '110237836=  ELSE'
      '110237837=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '110237838='
      '110237839=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110237840=        P.TOVAR_NAME,'
      
        '110237841=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), '#39 +
        '.'#39', '#39','#39'),'
      
        '110237842=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR(' +
        '100)), '#39'.'#39', '#39','#39'),'
      
        '110237843=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR(' +
        '100)), '#39'.'#39', '#39','#39'),'
      
        '110237844=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100)' +
        '), '#39'.'#39', '#39','#39'),'
      '110237845=        P.IS_HEAD'
      
        '110237846=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110237847=    ORDER BY 1'
      '110237848=  INTO :P_REP_PROFIT_TABLE,'
      '110237849=       :TOVAR_NAME,'
      '110237850=       :SUMM,'
      '110237851=       :NDS_SUMM,'
      '110237852=       :SUM_SELF,'
      '110237853=       :PROFIT,'
      '110237854=       :IS_HEAD'
      '110237855=  DO'
      '110237856=    suspend;'
      '110237857='
      '110237858=WHEN ANY DO BEGIN'
      '110237859=    Err_code = -20500;'
      
        '110237860=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110237861=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110237862=  END'
      '110237863=end;'
      '110237864='
      '110237865=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '110237866=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '110237867=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '110237868=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT' +
        ','
      
        '110237869=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TY' +
        'PE */ BIGINT,'
      '110237870=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '110237871=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '110237872=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUME' +
        'RIC(15,2),'
      
        '110237873=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIG' +
