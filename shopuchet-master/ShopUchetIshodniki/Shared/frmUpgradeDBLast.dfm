        '11019426=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN G_PAYMENT_TYPE.G_PA' +
        'YMENT_TYPE */ BIGINT,'
      '11019427=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      
        '11019428=  G_SUPPLIER_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BI' +
