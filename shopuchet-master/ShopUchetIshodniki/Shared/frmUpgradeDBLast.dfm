      '1106017950='
      '1106017951=ALTER PROCEDURE G_UPD_G_CLIENT('
      '1106017952=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1106017953=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT,'
      '1106017954=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '1106017955=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1106017956=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '1106017957=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '1106017958=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '1106017959=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '1106017960=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '1106017961=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '1106017962=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '1106017963=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '1106017964=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '1106017965=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '1106017966=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '1106017967=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '1106017968=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      
        '1106017969=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ','
      '1106017970=  NOTIFY_SKIDKA_ INTEGER,'
      '1106017971=  NOTIFY_DR_ INTEGER,'
      '1106017972=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '1106017973=  G_CLIENT_PROMO_ INTEGER)'
      '1106017974=RETURNS ('
      '1106017975=  ERR_CODE INTEGER,'
      '1106017976=  ERR_MSG VARCHAR(1024))'
      '1106017977=AS'
      '1106017978=DECLARE VARIABLE CNT_ INTEGER;'
      '1106017979=BEGIN'
      
        '1106017980=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1' +
        ', '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '1106017981=  if (BY_DEFAULT_ = 1) then'
      '1106017982=    UPDATE g_client'
      '1106017983=       SET BY_DEFAULT = 0'
      '1106017984=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '1106017985='
      '1106017986=  UPDATE g_client'
      '1106017987=  SET'
      
        '1106017988=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CL' +
        'IENT_PARENT),'
      
        '1106017989=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTR' +
        'AGENT),'
      '1106017990=   NAME = COALESCE(:NAME_, NAME),'
      '1106017991=   IDN  = COALESCE(:IDN_, IDN),'
      '1106017992=   KBE  = COALESCE(:KBE_, KBE),'
      '1106017993=   PHONE = COALESCE(:PHONE_, PHONE),'
      '1106017994=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '1106017995=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      
        '1106017996=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER)' +
        ','
      '1106017997=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '1106017998=   ,DT    = COALESCE(:DT_, DT)'
      '1106017999=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '1106018000=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '1106018001=   ,G_PROMOTION = :G_PROMOTION_'
      '1106018002=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '1106018003=   ,NOTIFY_DR = :NOTIFY_DR_'
      '1106018004=  WHERE'
      '1106018005=    g_client = :g_client_;'
      '1106018006='
      '1106018007=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '1106018008=    IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '1106018009=        SELECT COUNT(*)'
      '1106018010=          FROM G_DISCONT_CARD'
      '1106018011=         WHERE BARCODE = :BARCODE_'
      
        '1106018012=         AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040#1049#1058 +
        #1048' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '1106018013=         INTO :CNT_;'
      '1106018014='
      '1106018015=        IF (CNT_ > 0) THEN BEGIN'
      '1106018016=          ERR_CODE = -20500;'
      
        '1106018017=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1050#1072 +
        #1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '1106018018=          EXIT;'
      '1106018019=        END'
      '1106018020=    END'
      '1106018021='
      '1106018022=    UPDATE G_DISCONT_CARD G'
      '1106018023=    SET G.BARCODE = :BARCODE_,'
      '1106018024=        G.N_PERCENT = :N_PERCENT_,'
      '1106018025=        G.summ = COALESCE(G.summ, 0),'
      '1106018026=        G.summ_all = COALESCE(G.summ_all, 0)'
      '1106018027=    WHERE G.G_CLIENT = :g_client_;'
      '1106018028='
      '1106018029=    if (ROW_COUNT = 0) then'
      
        '1106018030=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '1106018031=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, 0, (select Coalesce(sum(SUMM_FACT), ' +
        '0) from zakaz where g_client = :g_client_));'
      '1106018032=  END'
      '1106018033=end'
      '1106018034=;'
      '1106018035='
      '1106018036=ALTER PROCEDURE G_UPD_G_CONTRAGENT('
      
        '1106018037=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAG' +
        'ENT,'
      '1106018038=  NAME_ TYPE OF COLUMN G_CONTRAGENT.NAME,'
      '1106018039=  SHORT_NAME_ TYPE OF COLUMN G_CONTRAGENT.SHORT_NAME)'
      '1106018040=RETURNS ('
      '1106018041=  ERR_CODE INTEGER,'
      '1106018042=  ERR_MSG VARCHAR(1024))'
      '1106018043=AS'
      '1106018044=begin'
      '1106018045=  UPDATE g_contragent'
      '1106018046=  SET'
      '1106018047=   NAME = :NAME_,'
      '1106018048=   SHORT_NAME = :SHORT_NAME_'
      '1106018049=  WHERE'
      '1106018050=    g_contragent = :g_contragent_;'
      '1106018051=end'
      '1106018052=;'
      '1106018053='
      '1106018054=ALTER PROCEDURE G_UPD_G_DISCOUNT('
      '1106018055=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '1106018056=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      
        '1106018057=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1106018058=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '1106018059=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '1106018060=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '1106018061=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '1106018062=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1106018063=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1106018064=  G_TOCHKA_ TYPE OF COLUMN G_DISCOUNT.G_TOCHKA)'
      '1106018065=RETURNS ('
      '1106018066=  ERR_CODE INTEGER,'
      '1106018067=  ERR_MSG VARCHAR(1024))'
      '1106018068=AS'
      '1106018069=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1106018070=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_PRODUCT.' +
        'PRICE;'
      '1106018071=BEGIN'
      '1106018072=    SELECT COUNT(*)'
      '1106018073=      FROM G_DISCOUNT'
      '1106018074=     WHERE G_PRODUCT = :G_PRODUCT_'
      
        '1106018075=       AND COALESCE(DATE_BEGIN, CURRENT_DATE) <= CURR' +
        'ENT_DATE'
      
        '1106018076=       AND COALESCE(DATE_END, CURRENT_DATE) >= CURREN' +
        'T_DATE'
      '1106018077=       AND G_DISCOUNT <> :G_DISCOUNT_'
      '1106018078=       AND ((G_TOCHKA = COALESCE(:G_TOCHKA_, 0))'
      '1106018079=            OR'
      
        '1106018080=            (G_TOCHKA IS NOT NULL AND :G_TOCHKA_ IS N' +
        'ULL)'
      '1106018081=            OR'
      '1106018082=            (G_TOCHKA IS NULL)'
      '1106018083=           )'
      '1106018084=      INTO CNT_;'
      '1106018085='
      '1106018086=    IF (CNT_ <> 0) THEN BEGIN'
      '1106018087=      ERR_CODE = -20500;'
      
        '1106018088=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1072' '#1076#1072#1085 +
        #1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39') RETURNING_VALUES (:ERR_' +
        'MSG);'
      '1106018089=      EXIT;'
      '1106018090=    END'
      '1106018091='
      '1106018092=    PRICE_REC_ = PRICE_;'
      
        '1106018093=    IF (SKIDKA_PROC_ IS NULL OR SKIDKA_SUM_ IS NULL) ' +
        'THEN BEGIN'
      '1106018094=      SELECT G.PRICE'
      '1106018095=        FROM G_PRODUCT G'
      '1106018096=       WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1106018097=        INTO :PRICE_REC_;'
      '1106018098='
      '1106018099=      IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '1106018100=        SKIDKA_PROC_ = ROUND(SKIDKA_SUM_ * 100 / PRIC' +
        'E_REC_ , 2);'
      '1106018101=      IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '1106018102=        SKIDKA_SUM_ = ROUND(PRICE_REC_ * SKIDKA_PROC_' +
        ' / 100 , 2);'
      '1106018103=    END'
      '1106018104='
      '1106018105=    UPDATE G_DISCOUNT'
      '1106018106=    SET G_PRODUCT = :G_PRODUCT_,'
      '1106018107=        DATE_BEGIN = :DATE_BEGIN_,'
      '1106018108=        DATE_END = :DATE_END_,'
      '1106018109=        NAME = :NAME_,'
      '1106018110=        PRICE = :PRICE_REC_,'
      '1106018111=        SKIDKA_PROC = :SKIDKA_PROC_,'
      '1106018112=        SKIDKA_SUM = :SKIDKA_SUM_,'
      '1106018113=        G_TOCHKA = :G_TOCHKA_'
      '1106018114=    WHERE (G_DISCOUNT = :G_DISCOUNT_);'
      '1106018115=end'
      '1106018116=;'
      '1106018117='
      '1106018118=ALTER PROCEDURE G_UPD_G_FIRM_ACCOUNT('
      '1106018119=  G_ACCOUNT_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_ACCOUNT,'
      '1106018120=  ACCOUNT_ TYPE OF COLUMN G_FIRM_ACCOUNT.ACCOUNT,'
      
        '1106018121=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_FI' +
        'RM_REKVIZIT,'
      '1106018122=  G_BANK_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_BANK,'
      
        '1106018123=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_ACCOUNT.IS_DEFAUL' +
        'T)'
      '1106018124=RETURNS ('
      '1106018125=  ERR_CODE INTEGER,'
      '1106018126=  ERR_MSG VARCHAR(1024))'
      '1106018127=AS'
      '1106018128=begin'
      
        '1106018129=    -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048 +
        #1057#1045#1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106018130=    IF (:IS_DEFAULT_ = 1) THEN'
      '1106018131=      UPDATE g_firm_account G'
      '1106018132=         SET G.IS_DEFAULT = 0'
      '1106018133=       WHERE G.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_;'
      '1106018134='
      '1106018135=    UPDATE g_firm_account'
      '1106018136=    SET'
      '1106018137=     ACCOUNT = :ACCOUNT_,'
      '1106018138=     G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_,'
      '1106018139=     G_BANK = :G_BANK_,'
      '1106018140=     IS_DEFAULT = :IS_DEFAULT_'
      '1106018141=    WHERE'
      '1106018142=      g_account = (:G_ACCOUNT_);'
      '1106018143=end'
      '1106018144=;'
      '1106018145='
      '1106018146=ALTER PROCEDURE G_UPD_G_FIRM_ADDRESS('
      '1106018147=  G_ADDRESS_ TYPE OF COLUMN G_FIRM_ADDRESS.G_ADDRESS,'
      
        '1106018148=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_FIRM_ADDRESS.G_ADD' +
        'RESS_TYPE,'
      
        '1106018149=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_ADDRESS.G_FI' +
        'RM_REKVIZIT,'
      '1106018150=  ADDRESS_ TYPE OF COLUMN G_FIRM_ADDRESS.ADDRESS,'
      '1106018151=  PHONE_ TYPE OF COLUMN G_FIRM_ADDRESS.PHONE,'
      '1106018152=  FAX_ TYPE OF COLUMN G_FIRM_ADDRESS.FAX,'
      
        '1106018153=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_ADDRESS.IS_DEFAUL' +
        'T)'
      '1106018154=RETURNS ('
      '1106018155=  ERR_CODE INTEGER,'
      '1106018156=  ERR_MSG VARCHAR(1024))'
      '1106018157=AS'
      '1106018158=begin'
      
        '1106018159=    -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048 +
        #1057#1045#1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106018160=    IF (:IS_DEFAULT_ = 1) THEN'
      '1106018161=      UPDATE g_firm_address G'
      '1106018162=         SET G.IS_DEFAULT = 0;'
      '1106018163='
      '1106018164=    update G_FIRM_ADDRESS'
      '1106018165=    set G_ADDRESS_TYPE = :G_ADDRESS_TYPE_,'
      '1106018166=        G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_,'
      '1106018167=        ADDRESS = :ADDRESS_,'
      '1106018168=        PHONE = :PHONE_,'
      '1106018169=        FAX = :FAX_,'
      '1106018170=        IS_DEFAULT = :IS_DEFAULT_'
      '1106018171=    where (G_ADDRESS = :G_ADDRESS_);'
      '1106018172=end'
      '1106018173=;'
      '1106018174='
      '1106018175=ALTER PROCEDURE G_UPD_G_FIRM_REKVIZIT('
      
        '1106018176=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_F' +
        'IRM_REKVIZIT,'
      '1106018177=  NAME_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      
        '1106018178=  SHORT_NAME_ TYPE OF COLUMN G_FIRM_REKVIZIT.SHORT_NA' +
        'ME,'
      '1106018179=  RNN_ TYPE OF COLUMN G_FIRM_REKVIZIT.RNN,'
      '1106018180=  IDN_ TYPE OF COLUMN G_FIRM_REKVIZIT.IDN,'
      '1106018181=  KPP_ TYPE OF COLUMN G_FIRM_REKVIZIT.KPP,'
      '1106018182=  OGRN_ TYPE OF COLUMN G_FIRM_REKVIZIT.OGRN,'
      '1106018183=  KBE_ TYPE OF COLUMN G_FIRM_REKVIZIT.KBE,'
      '1106018184=  OKPO_ TYPE OF COLUMN G_FIRM_REKVIZIT.OKPO,'
      '1106018185=  IS_NDS_ TYPE OF COLUMN G_FIRM_REKVIZIT.IS_NDS,'
      
        '1106018186=  NDS_SERIAL_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_SERI' +
        'AL,'
      '1106018187=  NDS_NUM_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_NUM,'
      '1106018188=  NDS_DATE_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_DATE,'
      
        '1106018189=  NDS_ORGAN_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_ORGAN' +
        ','
      
        '1106018190=  NDS_VALUE_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_VALUE' +
        ','
      
        '1106018191=  NOL_VMESTO_BEZ_ TYPE OF COLUMN G_FIRM_REKVIZIT.NOL_' +
        'VMESTO_BEZ,'
      '1106018192=  HEAD_ TYPE OF COLUMN G_FIRM_REKVIZIT.HEAD,'
      
        '1106018193=  MAIN_CHIEF_ TYPE OF COLUMN G_FIRM_REKVIZIT.MAIN_CHI' +
        'EF,'
      '1106018194=  EMAIL_ TYPE OF COLUMN G_FIRM_REKVIZIT.EMAIL,'
      '1106018195=  WEBSITE_ TYPE OF COLUMN G_FIRM_REKVIZIT.WEBSITE,'
      
        '1106018196=  IP_OR_JUR_ TYPE OF COLUMN G_FIRM_REKVIZIT.IP_OR_JUR' +
        ','
      
        '1106018197=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_FIRM_R' +
        'EKVIZIT)'
      '1106018198=RETURNS ('
      
        '1106018199=  G_FIRM_REKVIZIT__ TYPE OF COLUMN G_FIRM_REKVIZIT.G_' +
        'FIRM_REKVIZIT,'
      '1106018200=  ERR_CODE INTEGER,'
      '1106018201=  ERR_MSG VARCHAR(1024))'
      '1106018202=AS'
      '1106018203=BEGIN'
      '1106018204=    IF (G_FIRM_REKVIZIT_ > 0) THEN BEGIN'
      '1106018205=        IF (IS_DEFAULT_ = 1) THEN BEGIN'
      '1106018206=          UPDATE G_FIRM_REKVIZIT R'
      '1106018207=             SET IS_DEFAULT = 0;'
      '1106018208=        END'
      '1106018209='
      '1106018210=        update G_FIRM_REKVIZIT'
      '1106018211=        set NAME = :NAME_,'
      '1106018212=            SHORT_NAME = :SHORT_NAME_,'
      '1106018213=            RNN = :RNN_,'
      '1106018214=            IDN = :IDN_,'
      '1106018215=            KPP = :KPP_,'
      '1106018216=            OGRN = :OGRN_,'
      '1106018217=            KBE = :KBE_,'
      '1106018218=            OKPO = :OKPO_,'
      '1106018219=            IS_NDS = :IS_NDS_,'
      '1106018220=            NDS_SERIAL = :NDS_SERIAL_,'
      '1106018221=            NDS_NUM = :NDS_NUM_,'
      '1106018222=            NDS_DATE = :NDS_DATE_,'
      '1106018223=            NDS_ORGAN = :NDS_ORGAN_,'
      '1106018224=            NDS_VALUE = :NDS_VALUE_,'
      '1106018225=            NOL_VMESTO_BEZ = :NOL_VMESTO_BEZ_,'
      '1106018226=            HEAD = :HEAD_,'
      '1106018227=            MAIN_CHIEF = :MAIN_CHIEF_,'
      '1106018228=            EMAIL = :EMAIL_,'
      '1106018229=            WEBSITE = :WEBSITE_,'
      '1106018230=            IP_OR_JUR = :IP_OR_JUR_,'
      '1106018231=            IS_DEFAULT = :IS_DEFAULT_'
      '1106018232=        WHERE G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_;'
      '1106018233=    END'
      '1106018234=    ELSE BEGIN'
      
        '1106018235=      SELECT DECODE(COUNT(*), 0, 1, 0)   -- '#1045#1057#1051#1048' '#1053#1054#1051#1068 +
        ' '#1047#1040#1055#1048#1057#1045#1049' , '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1054#1042#1054#1049' '#1047#1040#1055#1048#1057#1048' '#1044#1045#1060#1054#1051#1058' = 1, '#1048#1053#1040#1063#1045' 0'
      '1106018236=        FROM G_FIRM_REKVIZIT R'
      '1106018237=        INTO :IS_DEFAULT_;'
      '1106018238='
      
        '1106018239=      insert into G_FIRM_REKVIZIT (G_FIRM_REKVIZIT, N' +
        'AME, SHORT_NAME, RNN, IDN, KBE, KPP, OGRN, OKPO, IS_NDS, NDS_SER' +
        'IAL, NDS_NUM,'
      
        '1106018240=                                   NDS_DATE, NDS_ORGA' +
        'N, NDS_VALUE, NOL_VMESTO_BEZ, HEAD, MAIN_CHIEF, EMAIL, WEBSITE, ' +
        'IP_OR_JUR, IS_DEFAULT)'
      
        '1106018241=      values (GEN_ID(GEN_G_FIRM_REKVIZIT, 1), :NAME_,' +
        ' :SHORT_NAME_, :RNN_, :IDN_, :KBE_, :KPP_, :OGRN_, :OKPO_, :IS_N' +
        'DS_, :NDS_SERIAL_, :NDS_NUM_, :NDS_DATE_,'
      
        '1106018242=              :NDS_ORGAN_, :NDS_VALUE_, :NOL_VMESTO_B' +
        'EZ_, :HEAD_, :MAIN_CHIEF_, :EMAIL_, :WEBSITE_, :IP_OR_JUR_, :IS_' +
        'DEFAULT_)'
      '1106018243=      returning'
      '1106018244=        G_FIRM_REKVIZIT'
      '1106018245=      into'
      '1106018246=        :G_FIRM_REKVIZIT__;'
      '1106018247=    END'
      '1106018248=end'
      '1106018249=;'
      '1106018250='
      '1106018251=ALTER PROCEDURE G_UPD_G_OFFICIAL('
      '1106018252=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106018253=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '1106018254=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '1106018255=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '1106018256=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106018257=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '1106018258=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '1106018259=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '1106018260=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '1106018261=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '1106018262=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '1106018263=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '1106018264=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTM' +
        'ENT,'
      
        '1106018265=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVO' +
        'DITEL,'
      '1106018266=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '1106018267=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNI' +
        'TEL,'
      '1106018268=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '1106018269=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106018270=  RIGHTS_ARR_ VARCHAR(500),'
      
        '1106018271=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.G_OFFI' +
        'CIAL)'
      '1106018272=RETURNS ('
      '1106018273=  ERR_CODE INTEGER,'
      '1106018274=  ERR_MSG VARCHAR(1024))'
      '1106018275=AS'
      
        '1106018276=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_I' +
        'TEM.RIGHTS_ITEM;'
      
        '1106018277=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGH' +
        'TS_ITEM;'
      '1106018278=begin'
      
        '1106018279=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '1106018280=      UPDATE G_OFFICIAL G'
      '1106018281=         SET G.IS_ISPOLNITEL = 0;'
      '1106018282='
      
        '1106018283=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057 +
        #1071' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '1106018284=      UPDATE G_OFFICIAL G'
      '1106018285=         SET G.IS_RUKOVODITEL = 0;'
      '1106018286='
      
        '1106018287=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1,' +
        ' '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '1106018288=      UPDATE G_OFFICIAL G'
      '1106018289=         SET G.IS_GLAVBUH = 0;'
      '1106018290='
      '1106018291=    update G_OFFICIAL'
      '1106018292=    set FM = :FM_,'
      '1106018293=        NM = :NM_,'
      '1106018294=        FT = :FT_,'
      '1106018295=        FIO_DOC = :FIO_DOC_,'
      '1106018296=        RNN = :RNN_,'
      '1106018297=        IDN = :IDN_,'
      '1106018298=        DT = :DT_,'
      '1106018299=        G_ID_KIND = :G_ID_KIND_,'
      '1106018300=        ID_NUM = :ID_NUM_,'
      '1106018301=        ID_DATE = :ID_DATE_,'
      '1106018302=        ID_ISSUER = :ID_ISSUER_,'
      '1106018303=        G_APPOINTMENT = :G_APPOINTMENT_,'
      '1106018304=        IS_RUKOVODITEL = :IS_RUKOVODITEL_,'
      '1106018305=        IS_GLAVBUH = :IS_GLAVBUH_,'
      '1106018306=        IS_ISPOLNITEL = :IS_ISPOLNITEL_,'
      '1106018307=        PASS = :PASSWORD_,'
      '1106018308=        G_TOCHKA = :G_TOCHKA_,'
      '1106018309=        DO_NOT_SALES_COMM = :DO_NOT_SALES_COMM_'
      '1106018310=    where (G_OFFICIAL = :G_OFFICIAL_);'
      '1106018311='
      
        '1106018312=    DELETE FROM G_OFFICIAL_RIGHT WHERE G_OFFICIAL = :' +
        'G_OFFICIAL_;'
      '1106018313=    FOR SELECT T.RIGHTS_ITEM'
      '1106018314=        FROM RIGHTS_ITEM T'
      '1106018315=       WHERE T.IS_CATEGORY = 0'
      
        '1106018316=         AND :RIGHTS_ARR_ CONTAINING '#39'-'#39'||T.RIGHTS_IT' +
        'EM||'#39'-'#39
      '1106018317=        INTO :RIGHTS_ITEM_'
      '1106018318=    DO BEGIN'
      
        '1106018319=        INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGH' +
        'T, RIGHTS_ITEM, G_OFFICIAL)'
      
        '1106018320=        VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIG' +
        'HTS_ITEM_, :G_OFFICIAL_);'
      '1106018321=    END'
      '1106018322='
      
        '1106018323=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052 +
        #1048', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '1106018324=    SELECT COUNT(G.G_OFFICIAL)'
      '1106018325=      FROM G_OFFICIAL G'
      '1106018326=     WHERE EXISTS (SELECT 1'
      '1106018327=                     FROM G_OFFICIAL_RIGHT R'
      '1106018328=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '1106018329=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) ' +
        '= (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '1106018330=    INTO :CNT_;'
      '1106018331='
      '1106018332=    IF (:CNT_ = 0) THEN BEGIN'
      '1106018333=      ERR_CODE = -20500;'
      
        '1106018334=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1086#1073#1093#1086 +
        #1076#1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087 +
        #1088#1072#1074#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1106018335=      EXIT;'
      '1106018336=    END'
      '1106018337=end'
      '1106018338=;'
      '1106018339='
      '1106018340=ALTER PROCEDURE G_UPD_G_PRIHOD_RASHOD('
      
        '1106018341=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_P' +
        'RIHOD_RASHOD,'
      '1106018342=  ACTION_ TYPE OF COLUMN G_PRIHOD_RASHOD.DO_ACTION,'
      '1106018343=  NAME_ TYPE OF COLUMN G_PRIHOD_RASHOD.NAME)'
      '1106018344=RETURNS ('
      '1106018345=  ERR_CODE INTEGER,'
      '1106018346=  ERR_MSG VARCHAR(1024))'
      '1106018347=AS'
      '1106018348=begin'
      '1106018349=  if (G_PRIHOD_RASHOD_ in (0)) then begin'
      '1106018350=    ERR_CODE = -20500;'
      
        '1106018351=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1079 +
        #1072#1087#1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1048#1079#1084#1077#1085#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '1106018352=    EXIT;'
      '1106018353=  end'
      '1106018354='
      '1106018355=  UPDATE G_PRIHOD_RASHOD'
      '1106018356=  SET'
      '1106018357=   DO_ACTION = :ACTION_,'
      '1106018358=   NAME = :NAME_'
      '1106018359=  WHERE'
      '1106018360=    G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_;'
      '1106018361=end'
      '1106018362=;'
      '1106018363='
      '1106018364=ALTER PROCEDURE G_UPD_G_UNIT('
      '1106018365=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1106018366=  NAME_ TYPE OF COLUMN G_UNIT.NAME,'
      '1106018367=  SHORT_NAME_ TYPE OF COLUMN G_UNIT.SHORT_NAME)'
      '1106018368=RETURNS ('
      '1106018369=  ERR_CODE INTEGER,'
      '1106018370=  ERR_MSG VARCHAR(1024))'
      '1106018371=AS'
      '1106018372=begin'
      '1106018373=    UPDATE G_UNIT'
      '1106018374=    SET NAME = :NAME_,'
      '1106018375=        SHORT_NAME = :SHORT_NAME_'
      '1106018376=    WHERE G_UNIT = :G_UNIT_;'
      '1106018377=end'
      '1106018378=;'
      '1106018379='
      '1106018380=ALTER PROCEDURE GET_CNT_ZAKAZ_SKLAD'
      '1106018381=RETURNS ('
      '1106018382=  IS_CANNOT_ INTEGER,'
      '1106018383=  ERR_CODE INTEGER,'
      '1106018384=  ERR_MSG VARCHAR(1024))'
      '1106018385=AS'
      '1106018386=/*'
      
        '1106018387=1 - '#1045#1057#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055#1056#1045#1042#1067#1057#1048#1051#1054' 100, 0 - '#1045#1057#1051#1048' '#1045#1065#1045' '#1053#1045' '#1055#1056 +
        #1045#1042#1067#1057#1048#1051
      '1106018388=*/'
      '1106018389=declare variable CNT_T_   INTEGER;'
      '1106018390=declare variable CNT_Z_   INTEGER;'
      '1106018391=begin'
      '1106018392='
      '1106018393=  CNT_T_ = 0;'
      '1106018394=  SELECT COUNT(*)'
      '1106018395=    FROM (SELECT S.SKLAD'
      '1106018396=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '1106018397=    INTO :CNT_T_;'
      '1106018398='
      '1106018399=  CNT_Z_ = 0;'
      '1106018400=  SELECT COUNT(*)'
      '1106018401=    FROM (SELECT Z.ZAKAZ'
      '1106018402=            FROM ZAKAZ Z ROWS 1 TO 100)'
      '1106018403=    INTO :CNT_Z_;'
      '1106018404='
      '1106018405=  if (CNT_T_ = 100 or CNT_Z_ = 100) then'
      '1106018406=    IS_CANNOT_ = 1;'
      '1106018407=  ELSE'
      '1106018408=    IS_CANNOT_ = 0;'
      '1106018409=end'
      '1106018410=;'
      '1106018411='
      '1106018412=ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '1106018413=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1106018414=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106018415=  MODE_ INTEGER)'
      '1106018416=RETURNS ('
      '1106018417=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '1106018418=AS'
      
        '1106018419=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE;'
      '1106018420=BEGIN'
      '1106018421=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106018422=    SELECT ID'
      '1106018423=      FROM CUR_PARAMS'
      '1106018424=     WHERE CUR_PARAMS = 2'
      '1106018425=      INTO :G_TOCHKA_;'
      '1106018426='
      '1106018427=  if (COALESCE(MODE_, 0) = 0) then'
      '1106018428=      SELECT S.PRICE'
      '1106018429=        FROM SKLAD S'
      '1106018430=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1106018431=         AND S.IS_LAST = 1'
      '1106018432=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1106018433=        INTO :PRICE_;'
      '1106018434='
      
        '1106018435=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' ' +
        #1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '1106018436=  ELSE BEGIN'
      '1106018437=    SELECT S.S_VALUE'
      '1106018438=      FROM SYSTEM_SETUP S'
      '1106018439=     WHERE S.SYSTEM_SETUP = 1'
      '1106018440=      INTO :FORMULA_;'
      '1106018441='
      '1106018442=    IF (FORMULA_ = 1) THEN BEGIN'
      '1106018443=      SELECT S.PRICE'
      '1106018444=        FROM SKLAD S'
      '1106018445=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1106018446=         AND S.IS_LAST = 1'
      '1106018447=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1106018448=        INTO :PRICE_;'
      '1106018449='
      
        '1106018450=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056 +
        #1045#1058' '#1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040 +
        #1052#1048'" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '1106018451=      IF (ROW_COUNT = 0) THEN'
      '1106018452=        SELECT S.PRICE'
      '1106018453=          FROM SKLAD S'
      '1106018454=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1106018455=                            FROM SKLAD SS'
      
        '1106018456=                           WHERE /*SS.G_TOCHKA = :G_T' +
        'OCHKA_'
      
        '1106018457=                             AND */SS.G_PRODUCT = :G_' +
        'PRODUCT_'
      
        '1106018458=                             AND SS.DATE_RECEIPT = (S' +
        'ELECT MAX(SSS.DATE_RECEIPT)'
      
        '1106018459=                                                     ' +
        ' FROM SKLAD SSS'
      
        '1106018460=                                                     ' +
        'WHERE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '1106018461=                                                     ' +
        '  AND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '1106018462=                                                     ' +
        '  AND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '1106018463=                                                   )'
      
        '1106018464=                             AND SS.IS_VOZVRAT IN (0,' +
        ' 4) --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '1106018465=                         )'
      '1106018466=          INTO :PRICE_;'
      '1106018467=    END ELSE BEGIN'
      
        '1106018468=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOU' +
        'NT), 2)'
      '1106018469=        FROM (SELECT S.AMOUNT, S.PRICE'
      '1106018470=                FROM SKLAD_PARENT SP,'
      '1106018471=                     SKLAD S'
      '1106018472=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '1106018473=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '1106018474=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '1106018475=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '1106018476=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP' +
        '.IS_VOZVRAT IN (0, 3, 4)'
      
        '1106018477=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 T' +
        'O 5) T'
      '1106018478=        INTO :PRICE_;'
      '1106018479='
      
        '1106018480=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056 +
        #1045#1058' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048 +
        '" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '1106018481=      IF (PRICE_ IS NULL) THEN'
      
        '1106018482=        SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AM' +
        'OUNT), 2)'
      '1106018483=        FROM (SELECT S.AMOUNT, S.PRICE'
      '1106018484=                FROM SKLAD_PARENT SP,'
      '1106018485=                     SKLAD S'
      '1106018486=               WHERE SP.DATE_RECEIPT <= CURRENT_DATE'
      '1106018487=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '1106018488=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '1106018489=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP' +
        '.IS_VOZVRAT IN (0, 3, 4)'
      
        '1106018490=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 T' +
        'O 5) T'
      '1106018491=          INTO :PRICE_;'
      '1106018492=    END'
      '1106018493=  END'
      '1106018494='
      '1106018495=  PRICE_ = COALESCE(:PRICE_, 0);'
      '1106018496=  SUSPEND;'
      '1106018497=END'
      '1106018498=;'
      '1106018499='
      '1106018500=ALTER PROCEDURE GET_SELF_PRICE_STR('
      
        '1106018501=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_D' +
        'ETAILS)'
      '1106018502=RETURNS ('
      '1106018503=  STR_ VARCHAR(1000))'
      '1106018504=AS'
      
        '1106018505=-- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1045#1058' '#1056#1040#1047#1053#1067#1045' '#1062#1045#1053#1067' '#1055#1054' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059' '#1042' '#1054#1058#1063#1045#1058#1045 +
        ' '#1054' '#1055#1056#1048#1041#1067#1051#1048
      
        '1106018506=-- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1047#1040' '#1052#1045#1057#1071#1062' '#1041#1067#1051#1054' 3 '#1055#1054#1057#1058#1040#1042#1050#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054' '#1062#1045#1053#1040#1052 +
        ' 150, 200, 120 '#1058#1045#1053#1043#1045', '#1042' '#1050#1054#1053#1062#1045' '#1052#1045#1057#1071#1062#1040' '#1041#1067#1051' '#1047#1040#1050#1040#1047' '#1053#1040' '#1055#1054#1051#1053#1054#1045' '#1050#1054#1051#1048#1063#1045#1057 +
        #1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1106018507=-- '#1058#1054#1043#1044#1040' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1042' '#1050#1054#1051#1054#1053#1050#1045' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' ' +
        #1041#1059#1044#1045#1058' '#1057#1058#1054#1071#1058#1068': 150, 200, 120'
      
        '1106018508=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      '1106018509=BEGIN'
      '1106018510='
      '1106018511=  FOR SELECT 0--L.PRICE'
      '1106018512=        FROM ZAKAZ_DETAILS Z/*,'
      '1106018513=             LT_POSTAVKA_PRODAZHA L */'
      '1106018514=       WHERE ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1106018515=         --AND Z.ZAKAZ_DETAILS = L.ZAKAZ_DETAIL'
      '1106018516=      ORDER BY 1'
      '1106018517=  INTO :PRICE_'
      '1106018518=  DO BEGIN'
      '1106018519=    IF (STR_ IS NULL) THEN'
      '1106018520=      STR_ = :PRICE_;'
      '1106018521=    ELSE'
      '1106018522=      STR_ = STR_||'#39', '#39'||:PRICE_;'
      '1106018523='
      '1106018524=    SUSPEND;'
      '1106018525=  END'
      '1106018526='
      '1106018527=end'
      '1106018528=;'
      '1106018529='
      '1106018530=ALTER PROCEDURE GET_SKLAD('
      '1106018531=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106018532=  MODE_ INTEGER)'
      '1106018533=RETURNS ('
      '1106018534=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '1106018535=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1106018536=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1106018537=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '1106018538=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYME' +
        'NT_TYPE,'
      '1106018539=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '1106018540=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '1106018541=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1106018542=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1106018543=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY,'
      
        '1106018544=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_' +
        'ALL,'
      '1106018545=  CNT_T_ INTEGER,'
      
        '1106018546=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1106018547=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106018548=  HAVERIGHT_ INTEGER,'
      '1106018549=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1106018550=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D,'
      '1106018551=  ERR_CODE INTEGER,'
      '1106018552=  ERR_MSG VARCHAR(1024))'
      '1106018553=AS'
      '1106018554=/*'
      
        '1106018555=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074 +
        #1083#1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '1106018556=*/'
      
        '1106018557=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFF' +
        'ICIAL.G_OFFICIAL;'
      '1106018558=begin'
      
        '1106018559=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088 +
        #1080' INS '#1080' '#1087#1088#1080' UPD'
      '1106018560=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '1106018561=  CNT_T_ = 0;'
      '1106018562=  SELECT COUNT(*)'
      '1106018563=    FROM (SELECT S.SKLAD'
      '1106018564=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '1106018565=    INTO :CNT_T_;'
      '1106018566='
      '1106018567=  SELECT'
      '1106018568=    T.DATE_RECEIPT,'
      '1106018569=    T.TIME_RECEIPT,'
      '1106018570=    T.G_CLIENT,'
      '1106018571=    T.G_PAYMENT_TYPE,'
      '1106018572=    T.OSNOVANIE,'
      '1106018573=    T.NOTE,'
      '1106018574=    T.SUMM,'
      '1106018575=    T.SUMM_FACT,'
      '1106018576=    T.IS_PAYED_ALL'
      '1106018577=    ,T.SUMM_CURRENCY'
      '1106018578=    ,T.is_expected'
      '1106018579=  FROM SKLAD_PARENT T'
      '1106018580=  WHERE T.SKLAD = :SKLAD_'
      '1106018581=  INTO'
      '1106018582=    :DATE_RECEIPT_,'
      '1106018583=    :TIME_RECEIPT_,'
      '1106018584=    :G_CLIENT_,'
      '1106018585=    :G_PAYMENT_TYPE_,'
      '1106018586=    :OSNOVANIE_,'
      '1106018587=    :NOTE_,'
      '1106018588=    :SUMM_,'
      '1106018589=    :SUMM_FACT_,'
      '1106018590=    :IS_PAYED_ALL_'
      '1106018591=    ,:SUMM_CURRENCY_'
      '1106018592=    ,:IS_EXPECTED_;'
      '1106018593='
      '1106018594=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '1106018595=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PR' +
        'ICE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CUR' +
        'RENCY)'
      
        '1106018596=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_' +
        'TMP, 1)), G_PRODUCT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, :SKLAD_' +
        ', PRICE_CURRENCY, SUMM_CURRENCY'
      '1106018597=    FROM SKLAD'
      '1106018598=   WHERE SKLAD_PARENT = :SKLAD_'
      '1106018599=   ORDER BY SKLAD;'
      '1106018600='
      '1106018601=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '1106018602=  SELECT K.G_PRIHOD_RASHOD,'
      '1106018603=         K.SUMM'
      
        '1106018604=    FROM (select * from KASSA union all select * from' +
        ' kassa_beznal) K'
      '1106018605=   WHERE K.SKLAD = :SKLAD_'
      '1106018606=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1106018607=    INTO :G_PRIHOD_,'
      '1106018608=         :SUMM_PRIHOD_;'
      '1106018609='
      
        '1106018610=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURN' +
        'ING_VALUES :PAYMENTS_;'
      '1106018611='
      
        '1106018612=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070 +
        ' '#1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045 +
        ' '#1044#1040#1058#1067
      
        '1106018613=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059 +
        #1044#1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054 +
        #1053#1040' 0, '#1058#1054' '#1061#1045#1056
      '1106018614=  HaveRight_ = 1;'
      '1106018615=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '1106018616=    SELECT ID'
      '1106018617=      FROM CUR_PARAMS'
      '1106018618=     WHERE CUR_PARAMS = 1'
      '1106018619=      INTO :G_OFFICIAL_CUR_;'
      '1106018620='
      
        '1106018621=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083 +
        #1080#1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086 +
        ' '#1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '1106018622=      HaveRight_ = 1;'
      '1106018623=    else'
      
        '1106018624=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFIC' +
        'IAL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '1106018625=  END'
      '1106018626=end'
      '1106018627=;'
      '1106018628='
      '1106018629=ALTER PROCEDURE GET_SKLAD_TMP('
      '1106018630=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '1106018631=RETURNS ('
      '1106018632=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106018633=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1106018634=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1106018635=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1106018636=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      
        '1106018637=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ','
      '1106018638=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1106018639=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1106018640=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1106018641=  ERR_CODE INTEGER,'
      '1106018642=  ERR_MSG VARCHAR(1024))'
      '1106018643=AS'
      '1106018644=begin'
      '1106018645=  SELECT'
      '1106018646=    T.G_PRODUCT,'
      '1106018647=    T.AMOUNT,'
      '1106018648=    T.PRICE,'
      '1106018649=    T.SUMM,'
      '1106018650=    T.PRICE_CURRENCY,'
      '1106018651=    T.SUMM_CURRENCY,'
      '1106018652=    T.NDS,'
      '1106018653=    T.NDS_SUMM,'
      '1106018654=    P.NAME'
      
        '1106018655=  FROM SKLAD_TMP T LEFT OUTER JOIN G_PRODUCT P ON T.G' +
        '_PRODUCT = P.G_PRODUCT'
      '1106018656=  WHERE T.SKLAD = :SKLAD_'
      '1106018657=  INTO'
      '1106018658=    :G_PRODUCT_,'
      '1106018659=    :AMOUNT_,'
      '1106018660=    :PRICE_,'
      '1106018661=    :SUMM_,'
      '1106018662=    :PRICE_CURRENCY_,'
      '1106018663=    :SUMM_CURRENCY_,'
      '1106018664=    :NDS_,'
      '1106018665=    :NDS_SUMM_,'
      '1106018666=    :G_PROD_NAME_;'
      '1106018667=end'
      '1106018668=;'
      '1106018669='
      '1106018670=ALTER PROCEDURE GET_SYS_PARAM_COUNT('
      '1106018671=  MODE_ INTEGER,'
      '1106018672=  PARAM1_ INTEGER)'
      '1106018673=RETURNS ('
      '1106018674=  PARAM1_OUT_ INTEGER,'
      '1106018675=  PARAM2_OUT_ INTEGER,'
      '1106018676=  PARAM1_STR_OUT_ VARCHAR(50),'
      '1106018677=  PARAM2_STR_OUT_ VARCHAR(50))'
      '1106018678=AS'
      '1106018679=/*'
      '1106018680='#1045#1057#1051#1048' MODE_ = 0'
      
        '1106018681='#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1055#1056#1048' '#1047#1040#1055#1059#1057#1050#1045' '#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071', '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051 +
        #1045#1049' '#1041#1054#1051#1068#1064#1045' '#1054#1044#1053#1054#1043#1054','
      
        '1106018682='#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043#1054' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054#1043#1044#1040' '#1042#1067 +
        #1044#1040#1042#1040#1058#1068' '#1054#1050#1053#1054' '#1057' '#1042#1067#1041#1054#1056#1054#1052' '#1051#1054#1043#1048#1053#1040'/'#1055#1040#1056#1054#1051#1071'.'
      
        '1106018683='#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045#1049' '#1053#1045#1058', '#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043 +
        #1054' '#1053#1045' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054' '#1054#1050#1053#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      '1106018684='
      '1106018685='#1045#1057#1051#1048' MODE_ = 1'
      
        '1106018686='#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1050#1051#1040#1044#1054#1042' '#1048' '#1042#1067#1044#1040#1045#1058#1057#1071' '#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052 +
        #1054#1051#1063#1040#1053#1048#1070'.'
      
        '1106018687='#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1048#1065#1059' '#1055#1054' '#1070#1047#1045#1056#1059', '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1046#1059', '#1058#1054' '#1057 +
        #1058#1040#1042#1051#1070' '#1057#1050#1051#1040#1044' 1'
      '1106018688=*/'
      '1106018689=BEGIN'
      '1106018690='
      '1106018691=  IF (MODE_ = 0) THEN BEGIN'
      '1106018692=      SELECT COUNT(*)'
      '1106018693=        FROM G_OFFICIAL G'
      '1106018694=        INTO :PARAM1_OUT_;'
      '1106018695='
      '1106018696=      if (PARAM1_OUT_ = 1) then'
      '1106018697=        SELECT G.PASS'
      '1106018698=          FROM G_OFFICIAL G'
      '1106018699=          INTO :PARAM1_STR_OUT_;'
      '1106018700='
      '1106018701=  END ELSE BEGIN'
      '1106018702=    SELECT COUNT(*)'
      '1106018703=      FROM G_TOCHKA G'
      '1106018704=      INTO :PARAM1_OUT_;'
      '1106018705='
      '1106018706=    IF (PARAM1_OUT_ > 1) THEN BEGIN'
      '1106018707=      SELECT G.G_TOCHKA'
      '1106018708=        FROM G_OFFICIAL G'
      
        '1106018709=       WHERE G.G_OFFICIAL = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 1)'
      '1106018710=        INTO :PARAM2_OUT_;'
      '1106018711='
      '1106018712=      if (COALESCE(PARAM2_OUT_, 0)  = 0) then'
      '1106018713=        PARAM2_OUT_ = 1;'
      '1106018714=    END'
      '1106018715=  END'
      '1106018716=END'
      '1106018717=;'
      '1106018718='
      '1106018719=ALTER PROCEDURE GET_TOVS_BY_DATE('
      '1106018720=  DATE_ DATE)'
      '1106018721=RETURNS ('
      '1106018722=  TOVAR_ VARCHAR(1500))'
      '1106018723=AS'
      '1106018724=/*'
      '1106018725='#1090#1086#1074#1072#1088#1099' '#1087#1086' '#1076#1072#1090#1072#1084
      '1106018726=*/'
      '1106018727=BEGIN'
      '1106018728='
      '1106018729=  SELECT SUBSTRING((SELECT'
      
        '1106018730=                      LIST(G.NAME/*'#39'('#39'||D.AMOUNT||'#39')'#39 +
        ', */)'
      
        '1106018731=                    FROM ZAKAZ Z, ZAKAZ_DETAILS D, G_' +
        'PRODUCT G'
      '1106018732=                    WHERE D.G_PRODUCT = G.G_PRODUCT'
      '1106018733=                      AND D.ZAKAZ = Z.ZAKAZ'
      
        '1106018734=                      AND Z.z_date = :DATE_) FROM 1 F' +
        'OR 1500)'
      '1106018735=    FROM RDB$DATABASE'
      '1106018736=    INTO TOVAR_;'
      '1106018737='
      '1106018738=  SUSPEND;'
      '1106018739=end'
      '1106018740=;'
      '1106018741='
      '1106018742=ALTER PROCEDURE GET_TOVS_BY_ZAKAZ('
      '1106018743=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '1106018744=RETURNS ('
      '1106018745=  TOVAR_ VARCHAR(1500))'
      '1106018746=AS'
      '1106018747=BEGIN'
      '1106018748='
      '1106018749=  SELECT SUBSTRING((SELECT'
      
        '1106018750=                      LIST(G.NAME||'#39'('#39'||D.AMOUNT||'#39')'#39 +
        ', '#39', '#39')'
      
        '1106018751=                    FROM ZAKAZ Z, ZAKAZ_DETAILS D, G_' +
        'PRODUCT G'
      '1106018752=                    WHERE D.G_PRODUCT = G.G_PRODUCT'
      '1106018753=                      AND D.ZAKAZ = Z.ZAKAZ'
      
        '1106018754=                      AND Z.ZAKAZ = :ZAKAZ_) FROM 1 F' +
        'OR 1500)'
      '1106018755=    FROM RDB$DATABASE'
      '1106018756=    INTO TOVAR_;'
      '1106018757='
      '1106018758=  SUSPEND;'
      '1106018759=end'
      '1106018760=;'
      '1106018761='
      '1106018762=ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '1106018763=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106018764=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '1106018765=RETURNS ('
      '1106018766=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1106018767=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106018768=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106018769=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1106018770=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106018771=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106018772=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106018773=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106018774=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106018775=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1106018776=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      '1106018777=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1106018778=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1106018779=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1106018780=  CNT_Z_ INTEGER,'
      
        '1106018781=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1106018782=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106018783=  HAVERIGHT_ INTEGER,'
      '1106018784=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1106018785=  ERR_CODE INTEGER,'
      '1106018786=  ERR_MSG VARCHAR(1024))'
      '1106018787=AS'
      '1106018788=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      
        '1106018789=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFF' +
        'ICIAL.G_OFFICIAL;'
      '1106018790=begin'
      '1106018791='
      '1106018792=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1086#1076#1072#1078', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '1106018793=  /*CNT_Z_ = 0;'
      '1106018794=  SELECT COUNT(*)'
      '1106018795=    FROM (SELECT Z.ZAKAZ'
      '1106018796=            FROM ZAKAZ Z ROWS 1 TO 100)'
      '1106018797=    INTO :CNT_Z_;*/'
      '1106018798='
      
        '1106018799=  --*************************************************' +
        '***************'
      '1106018800=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1106018801=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1106018802=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '1106018803=          SELECT'
      '1106018804=            T.G_TOCHKA,'
      '1106018805=            T.Z_DATE,'
      '1106018806=            T.Z_TIME,'
      '1106018807=            T.G_CLIENT,'
      '1106018808=            T.G_PAYMENT_TYPE,'
      '1106018809=            T.OSNOVANIE,'
      '1106018810=            T.NOTE,'
      '1106018811=            T.SUMM,'
      '1106018812=            T.SUMM_FACT,'
      '1106018813=            T.SUMM_BONUS,'
      '1106018814=            T.summ_bonus_got,'
      '1106018815=            T.IS_PAYED_ALL,'
      '1106018816=            COALESCE(T.BY_RECIPE, 0)'
      '1106018817=            ,IS_RESERVE'
      '1106018818=          FROM ZAKAZ T'
      '1106018819=          WHERE T.ZAKAZ = :ZAKAZ_'
      '1106018820=          INTO'
      '1106018821=            :G_TOCHKA_,'
      '1106018822=            :Z_DATE_,'
      '1106018823=            :Z_TIME_,'
      '1106018824=            :G_CLIENT_,'
      '1106018825=            :G_PAYMENT_TYPE_,'
      '1106018826=            :OSNOVANIE_,'
      '1106018827=            :NOTE_,'
      '1106018828=            :SUMM_,'
      '1106018829=            :SUMM_FACT_,'
      '1106018830=            :SUMM_PAY_BONUS_,'
      '1106018831=            :SUMM_GOT_BONUS_,'
      '1106018832=            :IS_PAYED_ALL_,'
      '1106018833=            :BY_RECIPE_,'
      '1106018834=            :IS_RESERVE_;'
      '1106018835='
      '1106018836=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '1106018837=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS' +
        ', ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT' +
        '_TENGE,'
      
        '1106018838=                                        DISCOUNT_SUMM' +
        ', NDS, NDS_SUMM, COST_PRICE)'
      
        '1106018839=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, A' +
        'MOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1106018840=                   DISCOUNT_SUMM, NDS, NDS_SUMM, COST' +
        '_PRICE'
      '1106018841=              FROM ZAKAZ_DETAILS'
      '1106018842=             WHERE ZAKAZ = :ZAKAZ_'
      '1106018843=             ORDER BY 1;'
      '1106018844='
      '1106018845=          -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '1106018846=          SELECT K.G_PRIHOD_RASHOD,'
      '1106018847=                 K.SUMM'
      
        '1106018848=            FROM (SELECT * FROM KASSA UNION SELECT * ' +
        'FROM KASSA_BEZNAL) K'
      '1106018849=           WHERE K.ZAKAZ = :ZAKAZ_'
      '1106018850=             AND K.G_PRIHOD_RASHOD <> 1'
      '1106018851=            INTO :G_PRIHOD_,'
      '1106018852=                 :SUMM_PRIHOD_;'
      '1106018853=      END'
      '1106018854='
      
        '1106018855=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RE' +
        'TURNING_VALUES :PAYMENTS_;'
      '1106018856=  END'
      '1106018857=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1106018858=  --*************************************************'
      '1106018859=  --*************************************************'
      '1106018860=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1106018861=  ELSE BEGIN'
      '1106018862=    SELECT'
      '1106018863=        T.G_CLIENT,'
      '1106018864=        T.DATE_RECEIPT,'
      '1106018865=        T.TIME_RECEIPT,'
      '1106018866=        T.G_TOCHKA,'
      '1106018867=        T.G_PAYMENT_TYPE,'
      '1106018868=        T.OSNOVANIE,'
      '1106018869=        T.NOTE,'
      '1106018870=        T.SUMM,'
      '1106018871=        T.SUMM_FACT,'
      '1106018872=        0,'
      '1106018873=        0,'
      '1106018874=        0'
      '1106018875=      FROM SKLAD_PARENT T'
      '1106018876=      WHERE T.SKLAD = :ZAKAZ_'
      '1106018877=      INTO'
      '1106018878=        :G_TOCHKA_,'
      '1106018879=        :Z_DATE_,'
      '1106018880=        :Z_TIME_,'
      '1106018881=        :G_CLIENT_,'
      '1106018882=        :G_PAYMENT_TYPE_,'
      '1106018883=        :OSNOVANIE_,'
      '1106018884=        :NOTE_,'
      '1106018885=        :SUMM_,'
      '1106018886=        :SUMM_FACT_,'
      '1106018887=        :SUMM_PAY_BONUS_,'
      '1106018888=        :IS_PAYED_ALL_,'
      '1106018889=        :BY_RECIPE_;'
      '1106018890='
      '1106018891=      -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '1106018892=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, Z' +
        'AKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TE' +
        'NGE,'
      
        '1106018893=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '1106018894=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE' +
        ', SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047 +
        #1040#1055#1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '1106018895=        FROM SKLAD'
      '1106018896=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '1106018897=      ORDER BY 1;'
      '1106018898=  END'
      '1106018899='
      
        '1106018900=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070 +
        ' '#1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045 +
        ' '#1044#1040#1058#1067
      
        '1106018901=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059 +
        #1044#1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054 +
        #1053#1040' 0, '#1058#1054' '#1061#1045#1056
      '1106018902=  HaveRight_ = 1;'
      '1106018903=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '1106018904=    SELECT ID'
      '1106018905=      FROM CUR_PARAMS'
      '1106018906=     WHERE CUR_PARAMS = 1'
      '1106018907=      INTO :G_OFFICIAL_CUR_;'
      '1106018908='
      
        '1106018909=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083 +
        #1080#1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086 +
        ' '#1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '1106018910=      HaveRight_ = 1;'
      '1106018911=    else'
      
        '1106018912=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFIC' +
        'IAL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '1106018913='
      '1106018914=    /* '#1040#1053#1040#1051#1048#1047' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045
      '1106018915=    if (HaveRight_ = 0) then begin'
      
        '1106018916=      ERR_CODE = -20500; // '#1053#1077' '#1076#1086#1089#1090#1072#1090#1086#1095#1085#1086' '#1087#1088#1072#1074' '#1076#1083#1103' '#1074#1099 +
        #1087#1086#1083#1085#1077#1085#1080#1103' '#1086#1087#1077#1088#1072#1094#1080#1080
      
        '1106018917=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' '#1085#1077' ' +
        #1086#1073#1083#1072#1076#1072#1077#1090#1077' '#1087#1088#1072#1074#1086#1084' '#1076#1083#1103' '#1088#1077#1076#1072#1082#1090#1080#1088#1086#1074#1072#1085#1080#1103' '#1085#1072#1082#1083#1072#1076#1085#1099#1093#39'||ascii_char(10)||' +
        #39#1079#1072' '#1087#1088#1086#1096#1083#1099#1077' '#1076#1072#1090#1099'.'#39') RETURNING_VALUES(:ERR_MSG);'
      '1106018918=      EXIT;'
      '1106018919=    end*/'
      '1106018920=  END'
      '1106018921=end'
      '1106018922=;'
      '1106018923='
      '1106018924=ALTER PROCEDURE GET_ZAKAZ_DETAILS_REAL('
      '1106018925=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106018926=  IS_VOZVRAT_ INTEGER)'
      '1106018927=RETURNS ('
      '1106018928=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1106018929=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106018930=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106018931=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1106018932=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106018933=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106018934=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106018935=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106018936=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106018937=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1106018938=  CNT_Z_ INTEGER,'
      
        '1106018939=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1106018940=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106018941=  ERR_CODE INTEGER,'
      '1106018942=  ERR_MSG VARCHAR(1024))'
      '1106018943=AS'
      
        '1106018944=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'-'#1054 +
        #1055#1051#1040#1058#1067' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051
      '1106018945='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1060#1054#1056#1052#1045' TOplataTovaraRealNForm*/'
      '1106018946=begin'
      '1106018947=      SELECT'
      '1106018948=        T.G_TOCHKA,'
      '1106018949=        T.Z_DATE,'
      '1106018950=        T.Z_TIME,'
      '1106018951=        T.G_CLIENT,'
      '1106018952=        T.G_PAYMENT_TYPE,'
      '1106018953=        T.OSNOVANIE,'
      '1106018954=        T.NOTE,'
      '1106018955=        T.SUMM,'
      '1106018956=        T.SUMM_FACT,'
      '1106018957=        T.IS_PAYED_ALL'
      '1106018958=      FROM ZAKAZ T'
      '1106018959=      WHERE T.ZAKAZ = :ZAKAZ_'
      '1106018960=        AND :IS_VOZVRAT_ = 0'
      '1106018961=      UNION ALL'
      '1106018962=      SELECT'
      '1106018963=        0 G_TOCHKA,'
      '1106018964=        T.DATE_RECEIPT,'
      '1106018965=        T.TIME_RECEIPT,'
      '1106018966=        T.G_CLIENT,'
      '1106018967=        T.G_PAYMENT_TYPE,'
      '1106018968=        T.OSNOVANIE,'
      '1106018969=        T.NOTE,'
      '1106018970=        T.SUMM,'
      '1106018971=        T.SUMM_FACT,'
      '1106018972=        T.IS_PAYED_ALL'
      '1106018973=      FROM SKLAD_PARENT T'
      '1106018974=      WHERE T.SKLAD = :ZAKAZ_'
      '1106018975=        AND :IS_VOZVRAT_ = 1'
      '1106018976=      INTO'
      '1106018977=        :G_TOCHKA_,'
      '1106018978=        :Z_DATE_,'
      '1106018979=        :Z_TIME_,'
      '1106018980=        :G_CLIENT_,'
      '1106018981=        :G_PAYMENT_TYPE_,'
      '1106018982=        :OSNOVANIE_,'
      '1106018983=        :NOTE_,'
      '1106018984=        :SUMM_,'
      '1106018985=        :SUMM_FACT_,'
      '1106018986=        :IS_PAYED_ALL_;'
      '1106018987='
      '1106018988=      -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '1106018989=      INSERT INTO ZAKAZ_DETAILS_TMP_REAL(ZAKAZ_DETAIL' +
        'S, ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM,'
      
        '1106018990=                                         DISCOUNT_PER' +
        'C, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM, IS_ADDED_FOR_UP' +
        'DATE, ZAKAZ_NA_REAL, COST_PRICE)'
      
        '1106018991=        SELECT Z.ZAKAZ_DETAILS, Z.ZAKAZ, Z.G_PRODUCT,' +
        ' Z.AMOUNT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z' +
        '.DISCOUNT_SUMM, Z.NDS, Z.NDS_SUMM, 1, L.ZAKAZ_NA_REAL, Z.cost_pr' +
        'ice'
      '1106018992=          FROM ZAKAZ_DETAILS Z, LT_ZAKAZ_REAL L'
      '1106018993=         WHERE ZAKAZ = :ZAKAZ_'
      '1106018994=           AND Z.ZAKAZ_DETAILS = L.ZAKAZ_DETAILS'
      '1106018995=           AND :IS_VOZVRAT_ = 0'
      '1106018996=        UNION ALL'
      
        '1106018997=        SELECT S.SKLAD ZAKAZ_DETAILS, S.SKLAD_PARENT ' +
        'ZAKAZ, S.G_PRODUCT, S.AMOUNT, S.PRICE, S.SUMM, 0 DISCOUNT_PERC, ' +
        '0 DISCOUNT_TENGE, 0 DISCOUNT_SUMM, S.NDS, S.NDS_SUMM, 1, L.ZAKAZ' +
        '_NA_REAL, 0 COST_PRICE'
      '1106018998=          FROM SKLAD S, LT_ZAKAZ_REAL L'
      '1106018999=         WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1106019000=           AND S.SKLAD = L.SKLAD'
      '1106019001=           AND :IS_VOZVRAT_ = 1'
      '1106019002=        ORDER BY 1;'
      '1106019003=end'
      '1106019004=;'
      '1106019005='
      '1106019006=ALTER PROCEDURE GET_ZAKAZ_NA_REAL('
      
        '1106019007=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_N' +
        'A_REAL)'
      '1106019008=RETURNS ('
      '1106019009=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '1106019010=  PRODUCT_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106019011=  PRICE_ TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      
        '1106019012=  AMOUNT_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL' +
        ','
      '1106019013=  SUMM_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      
        '1106019014=  AMOUNT_PAYED_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_P' +
        'AYED,'
      
        '1106019015=  SUMM_PAYED_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED' +
        ','
      
        '1106019016=  AMOUNT_RETURNED_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUN' +
        'T_RETURNED,'
      
        '1106019017=  SUMM_RETURNED_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_RE' +
        'TURNED,'
      
        '1106019018=  AMOUNT_LEFT_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PA' +
        'YED,'
      '1106019019=  SUMM_LEFT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '1106019020=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.IS_PAYED' +
        '_ALL,'
      '1106019021=  ERR_CODE INTEGER,'
      '1106019022=  ERR_MSG VARCHAR(1024))'
      '1106019023=AS'
      '1106019024=begin'
      '1106019025=  SELECT Z.G_PRODUCT,'
      '1106019026=         P.NAME,'
      '1106019027=         Z.PRICE,'
      '1106019028=         Z.AMOUNT_ALL,'
      '1106019029=         Z.SUMM_ALL,'
      '1106019030=         Z.AMOUNT_PAYED,'
      '1106019031=         Z.SUMM_PAYED,'
      '1106019032=         Z.AMOUNT_RETURNED,'
      '1106019033=         Z.SUMM_RETURNED,'
      
        '1106019034=         Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE(Z.A' +
        'MOUNT_RETURNED, 0),'
      
        '1106019035=         Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.SUMM_' +
        'RETURNED, 0),'
      '1106019036=         Z.IS_PAYED_ALL'
      '1106019037=    FROM ZAKAZ_NA_REAL Z, G_PRODUCT P'
      '1106019038=   WHERE Z.G_PRODUCT = P.G_PRODUCT'
      '1106019039=     AND Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '1106019040=  INTO :G_PRODUCT_,'
      '1106019041=       :PRODUCT_NAME_,'
      '1106019042=       :PRICE_,'
      '1106019043=       :AMOUNT_ALL_,'
      '1106019044=       :SUMM_ALL_,'
      '1106019045=       :AMOUNT_PAYED_,'
      '1106019046=       :SUMM_PAYED_,'
      '1106019047=       :AMOUNT_RETURNED_,'
      '1106019048=       :SUMM_RETURNED_,'
      '1106019049=       :AMOUNT_LEFT_,'
      '1106019050=       :SUMM_LEFT_,'
      '1106019051=       :IS_PAYED_ALL_;'
      '1106019052=end'
      '1106019053=;'
      '1106019054='
      '1106019055=ALTER PROCEDURE GET_ZAKAZ_TOVAR_STR('
      '1106019056=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '1106019057=RETURNS ('
      '1106019058=  STR_ VARCHAR(1000))'
      '1106019059=AS'
      '1106019060=-- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1045#1058' '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1048#1047' '#1044#1045#1058#1040#1051#1045#1049' '#1047#1040#1050#1040#1047#1040
      '1106019061=DECLARE VARIABLE NAME TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1106019062=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      '1106019063=begin'
      '1106019064=  FOR SELECT L.NAME,'
      '1106019065=         Z.AMOUNT'
      '1106019066=    FROM ZAKAZ_DETAILS Z,'
      '1106019067=         G_PRODUCT L'
      '1106019068=   WHERE ZAKAZ = :ZAKAZ_'
      '1106019069=     AND Z.G_PRODUCT = L.G_PRODUCT'
      '1106019070=  ORDER BY 1'
      '1106019071=  INTO :NAME,'
      '1106019072=       :AMOUNT'
      '1106019073=  DO BEGIN'
      '1106019074=    IF (:AMOUNT > 1) THEN BEGIN'
      '1106019075=      IF (:STR_ IS NULL) THEN'
      
        '1106019076=        STR_ = :NAME||'#39'('#39'||CAST(:AMOUNT AS CHARACTER)' +
        '||'#39')'#39';'
      '1106019077=      ELSE'
      
        '1106019078=        STR_ = STR_||'#39', '#39'||:NAME||'#39'('#39'||CAST(:AMOUNT A' +
        'S CHARACTER)||'#39')'#39';'
      '1106019079=    END ELSE BEGIN'
      '1106019080=      IF (:STR_ IS NULL) THEN'
      '1106019081=        STR_ = :NAME;'
      '1106019082=      ELSE'
      '1106019083=        STR_ = STR_||'#39', '#39'||:NAME;'
      '1106019084=    END'
      '1106019085='
      '1106019086=    SUSPEND;'
      '1106019087=  END'
      '1106019088=end'
      '1106019089=;'
      '1106019090='
      '1106019091=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1106019092=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106019093=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106019094=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1106019095=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106019096=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106019097=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106019098=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106019099=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1106019100=RETURNS ('
      '1106019101=  ERR_CODE INTEGER,'
      '1106019102=  ERR_MSG VARCHAR(1024))'
      '1106019103=AS'
      '1106019104=/*'
      
        '1106019105='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1106019106='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1106019107='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1106019108=*/'
      
        '1106019109=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1106019110=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106019111=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1106019112=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1106019113=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1106019114=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1106019115=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1106019116=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1106019117=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1106019118=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106019119=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1106019120=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1106019121=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1106019122=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1106019123=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1106019124=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1106019125=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1106019126=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1106019127=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1106019128=BEGIN'
      '1106019129='
      '1106019130=  PNT_ = '#39'00'#39';'
      '1106019131=  CLRF = ascii_char( 10 );'
      '1106019132='
      '1106019133=  SELECT S.S_VALUE'
      '1106019134=    FROM SYSTEM_SETUP S'
      '1106019135=   WHERE S.SYSTEM_SETUP = 2'
      '1106019136=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1106019137='
      '1106019138=  PNT_ = '#39'01'#39';'
      '1106019139=  SELECT G.nds_value'
      '1106019140=    FROM G_FIRM_REKVIZIT G'
      '1106019141=   WHERE G.is_default = 1'
      '1106019142=    INTO :NDS_;'
      '1106019143='
      '1106019144=  PNT_ = '#39'02'#39';'
      
        '1106019145=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1106019146=        FROM IMPORT_TBL_TMP'
      
        '1106019147=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1106019148=  DO BEGIN'
      '1106019149=    SELECT G_PRODUCT,'
      '1106019150=           PRICE'
      '1106019151=      FROM ('
      '1106019152=            SELECT P.G_PRODUCT, P.price'
      '1106019153=              FROM G_PRODUCT P'
      
        '1106019154=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1106019155=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1106019156=            UNION'
      '1106019157=            SELECT LT.G_PRODUCT, P.PRICE'
      '1106019158=              FROM LT_BARCODE LT, g_product P'
      
        '1106019159=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1106019160=               AND LT.g_product = P.g_product'
      '1106019161=           )'
      '1106019162=      INTO :G_PRODUCT_,'
      '1106019163=           :PRICE_OUR_;'
      '1106019164='
      '1106019165=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1106019166=      ERR_CODE = -20500;'
      
        '1106019167=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1106019168=      Exit;'
      '1106019169=    END'
      '1106019170='
      '1106019171=    PNT_ = '#39'03'#39';'
      
        '1106019172=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1106019173=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1106019174=      RETURNING_VALUES :COST_PRICE_;'
      '1106019175='
      '1106019176=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1106019177=    IF (price_ IS NULL) THEN'
      '1106019178=      PRICE_ = PRICE_OUR_;'
      '1106019179='
      '1106019180=    PNT_ = '#39'04'#39';'
      
        '1106019181=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1106019182=                                              :AMOUNT' +
        '_,'
      
        '1106019183=                                              :PRICE_' +
        ','
      
        '1106019184=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1106019185=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1106019186=                                              :DISCOU' +
        'NT_,'
      
        '1106019187=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1106019188=                                              :NDS_,'
      
        '1106019189=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1106019190=                                              :COST_P' +
        'RICE_,'
      
        '1106019191=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1106019192=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1106019193=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1106019194=                                              0     -' +
        '-MODE_'
      
        '1106019195=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1106019196=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1106019197=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1106019198=      EXIT;'
      '1106019199=    END'
      '1106019200='
      '1106019201=    G_PRODUCT_ = NULL;'
      '1106019202=  END'
      '1106019203='
      '1106019204=  PNT_ = '#39'05'#39';'
      '1106019205=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1106019206=    SELECT SUM(T.summ)'
      '1106019207=      FROM ZAKAZ_DETAILS_TMP T'
      '1106019208=      INTO :SUMM_;'
      '1106019209=    SUMM_FACT_ = SUMM_;'
      '1106019210=  END'
      '1106019211='
      '1106019212=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1106019213=  if (G_PAYMENT_TYPE_ = 1) then'
      '1106019214=    SUMM_CASH_ = summ_fact_;'
      '1106019215=  ELSE'
      '1106019216=    SUMM_NONCASH_ = summ_fact_;'
      '1106019217='
      '1106019218=  PNT_ = '#39'06'#39';'
      '1106019219=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1106019220=    G_CLIENT_ = 10;'
      '1106019221='
      '1106019222=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1106019223=                              :Z_DATE_,'
      '1106019224=                              :Z_TIME_,'
      '1106019225=                              :G_CLIENT_,'
      '1106019226=                              :G_PAYMENT_TYPE_,'
      '1106019227=                              '#39#39', --:OSNOVANIE_,'
      '1106019228=                              0,  -- IS_SPISANIE'
      
        '1106019229=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1106019230=                              :SUMM_,'
      '1106019231=                              :SUMM_FACT_,'
      '1106019232=                              :SUMM_CASH_,'
      '1106019233=                              :SUMM_NONCASH_,'
      
        '1106019234=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1106019235=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1106019236=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1106019237=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1106019238=                              0,    -- :BY_RECIPE__,'
      '1106019239=                              0,    -- IS_RESERVE__'
      '1106019240=                              NULL -- :PAYMENTS__'
      '1106019241=                              )'
      
        '1106019242=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1106019243=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1106019244=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1106019245=    EXIT;'
      '1106019246=  END'
      '1106019247='
      '1106019248=  DELETE FROM import_tbl_tmp;'
      '1106019249='
      '1106019250=WHEN ANY DO BEGIN'
      '1106019251=    ERR_CODE = gdscode;'
      
        '1106019252=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1106019253=  END'
      '1106019254=end'
      '1106019255=;'
      '1106019256='
      '1106019257=ALTER PROCEDURE INS_SKLAD('
      '1106019258=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1106019259=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1106019260=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1106019261=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1106019262=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1106019263=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1106019264=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1106019265=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1106019266=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1106019267=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1106019268=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1106019269=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106019270=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1106019271=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1106019272=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0)'
      '1106019273=RETURNS ('
      '1106019274=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106019275=  ERR_CODE INTEGER,'
      '1106019276=  ERR_MSG VARCHAR(1024))'
      '1106019277=AS'
      '1106019278=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '1106019279=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054 +
        #1042#1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '1106019280=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '1106019281=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '1106019282=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059 +
        #1055#1050#1048
      
        '1106019283=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '1106019284=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053 +
        #1050#1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054 +
        #1047#1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '1106019285=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041 +
        #1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUM' +
        'M '#1041#1059#1044#1059
      '1106019286=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1106019287=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048 +
        #1047#1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053 +
        #1048' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '1106019288=--'
      
        '1106019289=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1106019290=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1106019291=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '1106019292=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106019293=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1106019294=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1106019295=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1106019296=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1106019297=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '1106019298=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_' +
        'SUMM = 0;'
      
        '1106019299=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      '1106019300=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106019301=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PR' +
        'IHOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '1106019302=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1106019303=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1106019304=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1106019305=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1106019306=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1106019307=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1106019308=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1106019309=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1106019310=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1106019311=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1106019312=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      '1106019313=BEGIN'
      '1106019314='
      '1106019315=  PNT_ = '#39'00'#39';'
      '1106019316=  IS_THIS_LAST_ = 0;'
      '1106019317='
      '1106019318=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106019319=    SELECT ID'
      '1106019320=      FROM CUR_PARAMS'
      '1106019321=     WHERE CUR_PARAMS = 2'
      '1106019322=      INTO :G_TOCHKA_;'
      '1106019323='
      '1106019324=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1106019325=  SELECT ID'
      '1106019326=    FROM CUR_PARAMS'
      '1106019327=   WHERE CUR_PARAMS = 1'
      '1106019328=    INTO :G_OFFICIAL_;'
      '1106019329='
      '1106019330=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '1106019331=                            DATE_RECEIPT,'
      '1106019332=                            TIME_RECEIPT,'
      '1106019333=                            G_CLIENT,'
      '1106019334=                            G_PAYMENT_TYPE,'
      '1106019335=                            OSNOVANIE,'
      '1106019336=                            NOTE,'
      '1106019337=                            SUMM,'
      '1106019338=                            SUMM_FACT,'
      '1106019339=                            SUMM_CURRENCY,'
      '1106019340=                            IS_PAYED_ALL,'
      '1106019341=                            IS_VOZVRAT,'
      '1106019342=                            G_TOCHKA'
      '1106019343=                            ,G_OFFICIAL'
      '1106019344=                            ,IS_EXPECTED)'
      '1106019345=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1106019346=          :DATE_RECEIPT_,'
      '1106019347=          :TIME_RECEIPT_,'
      '1106019348=          :G_CLIENT_,'
      '1106019349=          :G_PAYMENT_TYPE_,'
      '1106019350=          :OSNOVANIE_,'
      '1106019351=          :NOTE_,'
      '1106019352=          :SUMM_,'
      '1106019353=          :SUMM_FACT_,'
      '1106019354=          :SUMM_CURRENCY_,'
      
        '1106019355=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_P' +
        'AYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' ' +
        '"'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1106019356=          :IS_VOZVRAT_,'
      '1106019357=          :G_TOCHKA_'
      '1106019358=          ,:G_OFFICIAL_'
      '1106019359=          ,:IS_EXPECTED_)'
      '1106019360=  RETURNING'
      '1106019361=    SKLAD'
      '1106019362=  INTO'
      '1106019363=    :SKLAD_;'
      '1106019364='
      '1106019365=  PNT_ = '#39'01'#39';'
      '1106019366=  FOR SELECT SKLAD,'
      '1106019367=             G_PRODUCT,'
      '1106019368=             AMOUNT,'
      '1106019369=             PRICE,'
      '1106019370=             SUMM,'
      '1106019371=             NDS,'
      '1106019372=             NDS_SUMM'
      '1106019373=             ,PRICE_CURRENCY'
      '1106019374=             ,SUMM_CURRENCY'
      '1106019375=        FROM SKLAD_TMP'
      '1106019376=      ORDER BY 1'
      '1106019377=      INTO :SKLAD_TMP_,'
      '1106019378=           :RG_PRODUCT_,'
      '1106019379=           :RAMOUNT_,'
      '1106019380=           :RPRICE_,'
      '1106019381=           :RSUMM_,'
      '1106019382=           :RNDS_,'
      '1106019383=           :RNDS_SUMM_'
      '1106019384=           ,:PRICE_CURRENCY_'
      '1106019385=           ,:SUMM_CURRENCY_TMP_'
      '1106019386=  DO BEGIN'
      '1106019387=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '1106019388=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST,' +
        ' '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1106019389=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051 +
        #1068#1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '1106019390=      IS_THIS_LAST_ = 0;'
      '1106019391=      SELECT MAX(SK.DATE_RECEIPT)'
      '1106019392=        FROM SKLAD SK'
      '1106019393=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1106019394=         AND SK.IS_LAST = 1'
      '1106019395=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '1106019396=        INTO :DATE_LAST_;'
      '1106019397='
      
        '1106019398=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106019399=        UPDATE SKLAD SK'
      '1106019400=           SET SK.IS_LAST = 0'
      '1106019401=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1106019402=           AND SK.IS_LAST = 1'
      '1106019403=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1106019404='
      '1106019405=        IS_THIS_LAST_ = 1;'
      '1106019406=      END'
      '1106019407=    END'
      '1106019408='
      '1106019409=    INSERT INTO SKLAD'
      '1106019410=    ('
      '1106019411=     SKLAD,'
      '1106019412=     SKLAD_PARENT,'
      '1106019413=     DATE_RECEIPT,'
      '1106019414=     G_CLIENT,'
      '1106019415=     G_PRODUCT,'
      '1106019416=     AMOUNT,'
      '1106019417=     PRICE,'
      '1106019418=     SUMM,'
      '1106019419=     G_PAYMENT_TYPE,'
      '1106019420=     OSNOVANIE,'
      '1106019421=     NOTE,'
      '1106019422=     NDS,'
      '1106019423=     NDS_SUMM,'
      '1106019424=     IS_LAST,'
      '1106019425=     IS_VOZVRAT,'
      '1106019426=     G_TOCHKA'
      '1106019427=     ,PRICE_CURRENCY'
      '1106019428=     ,SUMM_CURRENCY'
      '1106019429=    ) VALUES ('
      '1106019430=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1106019431=     :SKLAD_,'
      '1106019432=     :DATE_RECEIPT_,'
      '1106019433=     :G_CLIENT_,'
      '1106019434=     :RG_PRODUCT_,'
      '1106019435=     :RAMOUNT_,'
      '1106019436=     :RPRICE_,'
      '1106019437=     :RSUMM_,'
      '1106019438=     :G_PAYMENT_TYPE_,'
      '1106019439=     :OSNOVANIE_,'
      '1106019440=     :NOTE_,'
      '1106019441=     :RNDS_,'
      '1106019442=     :RNDS_SUMM_,'
      
        '1106019443=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056 +
        #1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059 +
        #1044#1045#1058' 0'
      '1106019444=     :IS_VOZVRAT_,'
      '1106019445=     :G_TOCHKA_'
      '1106019446=     ,:PRICE_CURRENCY_'
      '1106019447=     ,:SUMM_CURRENCY_TMP_'
      '1106019448=    );'
      '1106019449='
      
        '1106019450=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1106019451=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1106019452=        PNT_ = '#39'02'#39';'
      '1106019453=        UPDATE LT_SKLAD_PRODUCT L'
      '1106019454=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1106019455=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1106019456=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106019457='
      '1106019458=        IF (ROW_COUNT = 0) THEN'
      
        '1106019459=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA' +
        '_);'
      '1106019460=    END'
      '1106019461=  END'
      '1106019462=  ----------------------------------------'
      '1106019463='
      
        '1106019464=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1106019465=  PNT_ = '#39'05'#39';'
      
        '1106019466=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1106019467=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1106019468=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106019469=      ELSE'
      '1106019470=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1106019471='
      
        '1106019472=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1106019473=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1106019474=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106019475=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1106019476=                                        :SUMM_FACT_,'
      
        '1106019477=                                        :DATE_RECEIPT' +
        '_,'
      
        '1106019478=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1106019479=                                        NULL,   --ZAK' +
        'AZ_'
      '1106019480=                                        :SKLAD_,'
      
        '1106019481=                                        :G_PAYMENT_TY' +
        'PE_,'
      
        '1106019482=                                        :G_TOCHKA_) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106019483=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106019484=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106019485=            EXIT;'
      '1106019486=          END'
      '1106019487=      END ELSE BEGIN'
      '1106019488=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1106019489=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1106019490=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1106019491=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1106019492=            ELSE'
      
        '1106019493=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1106019494='
      '1106019495=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1106019496=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1106019497='
      
        '1106019498=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1106019499='
      '1106019500=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1106019501=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106019502=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1106019503=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1106019504=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1106019505=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1106019506=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1106019507=                                              :SKLAD_' +
        ','
      
        '1106019508=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1106019509=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106019510=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106019511=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1106019512=                  EXIT;'
      '1106019513=                END'
      '1106019514=            END'
      '1106019515=          END'
      '1106019516=      END'
      '1106019517=  END'
      '1106019518='
      '1106019519=  DELETE FROM SKLAD_TMP;'
      '1106019520='
      
        '1106019521=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1106019522=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1106019523=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1106019524=                                  G_PRIHOD_,'
      '1106019525=                                  :SUMM_PRIHOD_,'
      '1106019526=                                  :DATE_RECEIPT_,'
      
        '1106019527=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1106019528=                                  NULL,   --:ZAKAZ_,'
      '1106019529=                                  :SKLAD_,'
      '1106019530=                                  :G_PAYMENT_TYPE_,'
      
        '1106019531=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106019532=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106019533=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106019534=      EXIT;'
      '1106019535=    END'
      '1106019536=  END'
      '1106019537=end'
      '1106019538=;'
      '1106019539='
      '1106019540=ALTER PROCEDURE INS_SKLAD_TMP('
      '1106019541=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1106019542=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1106019543=  PRICE_ NUMERIC(15,2),'
      '1106019544=  SUMM_ NUMERIC(15,2),'
      '1106019545=  NDS_ NUMERIC(15,2),'
      '1106019546=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1106019547=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1106019548=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0)'
      '1106019549=RETURNS ('
      '1106019550=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1106019551=  ERR_CODE INTEGER,'
      '1106019552=  ERR_MSG VARCHAR(1024))'
      '1106019553=AS'
      
        '1106019554=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_T' +
        'MP'#39';'
      '1106019555=BEGIN'
      '1106019556=  SELECT T.SKLAD'
      '1106019557=    FROM SKLAD_TMP T'
      '1106019558=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1106019559=     AND T.PRICE = :PRICE_'
      '1106019560=    INTO :SKLAD_;'
      '1106019561='
      '1106019562=  IF (SKLAD_ IS NOT NULL) THEN'
      '1106019563=    UPDATE SKLAD_TMP T'
      '1106019564=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '1106019565=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '1106019566=     WHERE T.SKLAD = :SKLAD_;'
      '1106019567='
      '1106019568=  ELSE'
      
        '1106019569=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY)'
      
        '1106019570=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '1106019571=        ,:PRICE_CURRENCY_'
      '1106019572=        ,:SUMM_CURRENCY_)'
      '1106019573=      RETURNING SKLAD'
      '1106019574=      INTO :SKLAD_;'
      '1106019575=end'
      '1106019576=;'
      '1106019577='
      '1106019578=ALTER PROCEDURE INS_ZAKAZ('
      '1106019579=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106019580=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106019581=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106019582=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1106019583=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106019584=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106019585=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1106019586=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106019587=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106019588=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106019589=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1106019590=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1106019591=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1106019592=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1106019593=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1106019594=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1106019595=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1106019596=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1106019597=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1106019598=  IS_MEBEL_ INTEGER = 0,'
      
        '1106019599=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1106019600=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      '1106019601=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '1106019602=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL)'
      '1106019603=RETURNS ('
      '1106019604=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106019605=  ERR_CODE INTEGER,'
      '1106019606=  ERR_MSG VARCHAR(1024))'
      '1106019607=AS'
      '1106019608=/*'
      '1106019609=IS_SPISANIE_'
      '1106019610=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1106019611=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1106019612=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1106019613=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1106019614=*/'
      '1106019615=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1106019616=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106019617=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106019618=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1106019619=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1106019620=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1106019621=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1106019622=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1106019623=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1106019624=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1106019625=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1106019626=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1106019627=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1106019628=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1106019629=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1106019630=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      
        '1106019631=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      '1106019632=DECLARE VARIABLE CNT_ INTEGER;'
      '1106019633=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1106019634=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1106019635=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1106019636=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1106019637=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1106019638=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1106019639=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1106019640=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1106019641=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1106019642=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1106019643=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1106019644=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1106019645=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1106019646=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1106019647=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      '1106019648=BEGIN'
      '1106019649='
      
        '1106019650=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1106019651=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1106019652=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1106019653=  IF (CNT_ = 0) THEN BEGIN'
      '1106019654=    ERR_CODE = -20500;'
      
        '1106019655=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1106019656=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1106019657=    EXIT;'
      '1106019658=  END'
      '1106019659='
      '1106019660=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106019661=    SELECT ID'
      '1106019662=      FROM CUR_PARAMS'
      '1106019663=     WHERE CUR_PARAMS = 2'
      '1106019664=      INTO :G_TOCHKA_;'
      '1106019665='
      '1106019666=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1106019667=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1106019668=      PNT_ = '#39'01'#39';'
      
        '1106019669=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1106019670=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1106019671=      ELSE'
      '1106019672=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1106019673='
      '1106019674=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1106019675=      SELECT ID,'
      '1106019676=             G.DO_NOT_SALES_COMM,'
      '1106019677=             G.FM||'#39' '#39'||G.NM'
      '1106019678=        FROM CUR_PARAMS, G_OFFICIAL G'
      '1106019679=       WHERE CUR_PARAMS = 1'
      '1106019680=         AND ID = G.G_OFFICIAL'
      '1106019681=        INTO :G_OFFICIAL_,'
      '1106019682=             :DO_NOT_SALES_COMM_,'
      '1106019683=             :OFFICIAL_NAME_;'
      '1106019684='
      '1106019685=      INSERT INTO ZAKAZ'
      '1106019686=      ('
      '1106019687=       ZAKAZ,'
      '1106019688=       G_TOCHKA,'
      '1106019689=       Z_DATE,'
      '1106019690=       Z_TIME,'
      '1106019691=       G_CLIENT,'
      '1106019692=       G_PAYMENT_TYPE,'
      '1106019693=       OSNOVANIE,'
      '1106019694=       IS_SPISANIE,'
      '1106019695=       NOTE,'
      '1106019696=       SUMM,'
      '1106019697=       SUMM_FACT,'
      '1106019698=       SUMM_BONUS,'
      '1106019699=       IS_PAYED_ALL'
      '1106019700=       ,G_OFFICIAL'
      '1106019701=       ,BY_RECIPE'
      '1106019702=       ,SUMM_BONUS_GOT'
      '1106019703=       ,IS_RESERVE'
      '1106019704=       ,SUMM_CASH'
      '1106019705=       ,SUMM_NONCASH'
      '1106019706=      ) VALUES ('
      '1106019707=       GEN_ID(GEN_ZAKAZ, 1),'
      '1106019708=       :G_TOCHKA_,'
      '1106019709=       :Z_DATE_,'
      '1106019710=       :Z_TIME_,'
      '1106019711=       :G_CLIENT_,'
      '1106019712=       :G_PAYMENT_TYPE_,'
      '1106019713=       :OSNOVANIE_,'
      '1106019714=       :IS_SPISANIE_,'
      '1106019715=       :NOTE_,'
      '1106019716=       :SUMM_,'
      '1106019717=       :SUMM_FACT_1_,'
      '1106019718=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1106019719=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1106019720=       ,:G_OFFICIAL_'
      '1106019721=       ,:BY_RECIPE_'
      '1106019722=       ,:SUMM_BONUS_GOT_'
      '1106019723=       ,:IS_RESERVE_'
      '1106019724=       ,COALESCE(:SUMM_CASH_, 0)'
      '1106019725=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1106019726=      )'
      '1106019727=      RETURNING'
      '1106019728=        ZAKAZ'
      '1106019729=      INTO'
      '1106019730=        :ZAKAZ_;'
      '1106019731='
      '1106019732=      PNT_ = '#39'02'#39';'
      
        '1106019733=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1106019734=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM'
      '1106019735=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1106019736=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1106019737=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1106019738=              :G_PRODUCT,'
      '1106019739=              :AMOUNT,'
      '1106019740=              :PRICE,'
      '1106019741=              :SUMM,'
      '1106019742=              :DISCOUNT_PERC,'
      '1106019743=              :DISCOUNT_TENGE,'
      '1106019744=              :DISCOUNT_SUMM,'
      '1106019745=              :NDS,'
      '1106019746=              :NDS_SUMM,'
      '1106019747=              :COST_PRICE,'
      '1106019748=              :SALES_COMM_'
      '1106019749=      DO BEGIN'
      
        '1106019750=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1106019751=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1106019752=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1106019753=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1106019754=        END'
      '1106019755='
      '1106019756=        INSERT INTO ZAKAZ_DETAILS'
      '1106019757=        VALUES('
      '1106019758=          :ZAKAZ_DETAILS_TMP_,'
      '1106019759=          :ZAKAZ_,'
      '1106019760=          :G_PRODUCT,'
      '1106019761=          :AMOUNT,'
      '1106019762=          :PRICE,'
      '1106019763=          :SUMM,'
      '1106019764=          :DISCOUNT_PERC,'
      '1106019765=          :DISCOUNT_TENGE,'
      '1106019766=          :DISCOUNT_SUMM,'
      '1106019767=          :NDS,'
      '1106019768=          :NDS_SUMM,'
      '1106019769=          :COST_PRICE,'
      '1106019770=          :SALES_COMM_SUMM_ITER_'
      '1106019771=        );'
      '1106019772='
      '1106019773=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1106019774=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '1106019775=            UPDATE LT_SKLAD_PRODUCT L'
      '1106019776=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1106019777=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1106019778=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106019779='
      '1106019780=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1106019781=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040',' +
        ' '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' ' +
        #1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1106019782=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047 +
        #1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '1106019783=            PNT_ = '#39'04'#39';'
      
        '1106019784=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE ' +
        'FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1106019785=              Err_Code = -20500;'
      
        '1106019786=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE,' +
        ' '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PROD' +
        'UCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087 +
        #1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106019787=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106019788=              EXIT;'
      '1106019789=            END ELSE if (ROW_COUNT = 0) then'
      
        '1106019790=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1106019791=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1106019792=        END'
      '1106019793='
      '1106019794=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1106019795=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '1106019796=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1106019797=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERV' +
        'E + :AMOUNT'
      '1106019798=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1106019799=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106019800=      END'
      '1106019801='
      '1106019802=      ----------------------------------------'
      
        '1106019803=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1106019804=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1106019805=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1106019806='
      
        '1106019807=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1106019808=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1106019809=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1106019810=                PNT_ = '#39'05'#39';'
      
        '1106019811=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1106019812=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1106019813=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1106019814=                                              :Z_DATE' +
        '_,'
      
        '1106019815=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1106019816=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1106019817=                                              NULL,'
      
        '1106019818=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1106019819=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106019820=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106019821=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1106019822=                  EXIT;'
      '1106019823=                END'
      '1106019824=            END'
      '1106019825='
      '1106019826=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1106019827=        END ELSE BEGIN'
      '1106019828=            PNT_ = '#39'06'#39';'
      
        '1106019829=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1106019830=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1106019831=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1106019832=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1106019833=                ELSE'
      
        '1106019834=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1106019835='
      
        '1106019836=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1106019837=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1106019838='
      
        '1106019839=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1106019840='
      '1106019841=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1106019842=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106019843=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1106019844=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1106019845=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1106019846=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1106019847=                                                  :ZA' +
        'KAZ_,'
      
        '1106019848=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1106019849=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1106019850=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106019851=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106019852=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1106019853=                      EXIT;'
      '1106019854=                    END'
      '1106019855=                END'
      '1106019856=            END'
      '1106019857=        END'
      '1106019858=      END'
      '1106019859='
      
        '1106019860=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1106019861=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1106019862=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      '1106019863=      UPDATE G_DISCONT_CARD D'
      
        '1106019864=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0)' +
        ' + :SUMM_BONUS_GOT_,'
      '1106019865=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1106019866=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1106019867='
      '1106019868=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1106019869=      PNT_ = '#39'07'#39';'
      
        '1106019870=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN ' +
        'BEGIN'
      '1106019871=        SELECT S.S_VALUE'
      '1106019872=          FROM SYSTEM_SETUP S'
      '1106019873=         WHERE S.SYSTEM_SETUP = 4'
      '1106019874=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1106019875='
      '1106019876=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1106019877=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1106019878=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1106019879='
      
        '1106019880=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1106019881=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1106019882=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1106019883='
      '1106019884=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1106019885=        ELSE'
      
        '1106019886=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1106019887='
      '1106019888=        KASSA_ = NULL;'
      '1106019889=        SELECT K.KASSA, K.SUMM'
      '1106019890=        FROM KASSA K'
      '1106019891=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1106019892=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1106019893=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1106019894=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1106019895='
      '1106019896=        IF (KASSA_ IS NULL) THEN'
      
        '1106019897=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106019898=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1106019899=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1106019900=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1106019901=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1106019902=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1106019903=                                          NULL,     -' +
        '-:SKLAD_,'
      '1106019904=                                          1,'
      '1106019905=                                          :G_TOCHKA_,'
      
        '1106019906=                                          :G_OFFICIAL' +
        '_'
      
        '1106019907=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106019908=        ELSE'
      '1106019909=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '1106019910=                                          1,     -- A' +
        'CTION_'
      
        '1106019911=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1106019912=                                          :SALES_COMM' +
        '_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '1106019913=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1106019914=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      '1106019915=                                          NULL,'
      '1106019916=                                          NULL,'
      
        '1106019917=                                          :PAYMENT_TY' +
        'PE_,'
      
        '1106019918=                                          :G_OFFICIAL' +
        '_'
      
        '1106019919=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1106019920='
      '1106019921=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106019922=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1106019923=          EXIT;'
      '1106019924=        END'
      '1106019925=      END'
      '1106019926=  END'
      '1106019927=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1106019928=  ----------------------------------------'
      '1106019929=  ----------------------------------------'
      '1106019930=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1106019931=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '1106019932=      PNT_ = '#39'25'#39';'
      
        '1106019933=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1106019934=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1106019935=      RETURNING ZAKAZ_REAL_PARENT'
      '1106019936=      INTO :ZAKAZ_REAL_PARENT_;'
      '1106019937='
      
        '1106019938=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1106019939=            FROM ZAKAZ_DETAILS_TMP Z'
      '1106019940=          INTO :G_PRODUCT,'
      '1106019941=              :AMOUNT,'
      '1106019942=              :PRICE,'
      '1106019943=              :SUMM,'
      '1106019944=              :DISCOUNT_PERC,'
      '1106019945=              :DISCOUNT_TENGE,'
      '1106019946=              :DISCOUNT_SUMM,'
      '1106019947=              :NDS,'
      '1106019948=              :NDS_SUMM'
      '1106019949=      DO BEGIN'
      '1106019950=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1106019951=          UPDATE LT_SKLAD_PRODUCT L'
      '1106019952=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1106019953=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1106019954=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106019955='
      
        '1106019956=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1106019957=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1106019958=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1106019959=            Err_Code = -20500;'
      
        '1106019960=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106019961=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106019962=            EXIT;'
      '1106019963=          END ELSE if (ROW_COUNT = 0) then'
      
        '1106019964=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1106019965=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1106019966='
      
        '1106019967=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1106019968=                                     G_PRODUCT,'
      '1106019969=                                     PRICE,'
      
        '1106019970=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1106019971=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1106019972=                                     NDS_SUMM)'
      
        '1106019973=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1106019974=                  :G_PRODUCT,'
      
        '1106019975=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1106019976=                  :AMOUNT, :SUMM,'
      '1106019977=                  0, --AMOUNT_PAYED,'
      '1106019978=                  0, --SUMM_PAYED,'
      '1106019979=                  0, --IS_PAYED_ALL,'
      '1106019980=                  :DISCOUNT_PERC,'
      '1106019981=                  :DISCOUNT_TENGE,'
      '1106019982=                  :DISCOUNT_SUMM,'
      '1106019983=                  :NDS,'
      '1106019984=                  :NDS_SUMM)'
      '1106019985=          RETURNING ZAKAZ_NA_REAL'
      '1106019986=          INTO :ZAKAZ_;'
      '1106019987=      END'
      '1106019988=  END'
      '1106019989=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1106019990=  ----------------------------------------'
      '1106019991=  ----------------------------------------'
      '1106019992=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1106019993=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1106019994=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1106019995=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1106019996=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1106019997=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA)'
      
        '1106019998=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1106019999=              1, 3, :G_CLIENT_)'
      '1106020000=      RETURNING SKLAD'
      '1106020001=      INTO :SKLAD_;'
      '1106020002='
      '1106020003=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1106020004=            FROM ZAKAZ_DETAILS_TMP Z'
      '1106020005=          INTO :G_PRODUCT,'
      '1106020006=              :AMOUNT,'
      '1106020007=              :PRICE,'
      '1106020008=              :SUMM'
      '1106020009=      DO BEGIN'
      '1106020010=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1106020011=        UPDATE LT_SKLAD_PRODUCT L'
      '1106020012=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1106020013=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1106020014=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106020015='
      '1106020016=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1106020017=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1106020018=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1106020019=        SELECT MAX(SK.DATE_RECEIPT)'
      '1106020020=            FROM SKLAD SK'
      '1106020021=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1106020022=             AND SK.IS_LAST = 1'
      '1106020023=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1106020024=            INTO :DATE_LAST_;'
      '1106020025='
      
        '1106020026=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1106020027=            UPDATE SKLAD SK'
      '1106020028=               SET SK.IS_LAST = 0'
      '1106020029=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1106020030=               AND SK.IS_LAST = 1'
      '1106020031=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1106020032='
      '1106020033=            IS_THIS_LAST_ = 1;'
      '1106020034=        END */'
      '1106020035='
      '1106020036='
      '1106020037=        INSERT INTO SKLAD'
      '1106020038=        ('
      '1106020039=         SKLAD,'
      '1106020040=         SKLAD_PARENT,'
      '1106020041=         DATE_RECEIPT,'
      '1106020042=         G_CLIENT,'
      '1106020043=         G_PRODUCT,'
      '1106020044=         AMOUNT,'
      '1106020045=         PRICE,'
      '1106020046=         SUMM,'
      '1106020047=         G_PAYMENT_TYPE,'
      '1106020048=         OSNOVANIE,'
      '1106020049=         NOTE,'
      '1106020050=         NDS,'
      '1106020051=         NDS_SUMM,'
      '1106020052=         IS_LAST,'
      '1106020053=         IS_VOZVRAT,'
      '1106020054=         G_TOCHKA'
      '1106020055=        ) VALUES ('
      '1106020056=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1106020057=         :SKLAD_,'
      '1106020058=         :Z_DATE_,'
      '1106020059=         :G_TOCHKA_,'
      '1106020060=         :G_PRODUCT,'
      '1106020061=         :AMOUNT,'
      '1106020062=         :PRICE,'
      '1106020063=         :SUMM,'
      '1106020064=         :G_PAYMENT_TYPE_,'
      '1106020065=         :OSNOVANIE_,'
      '1106020066=         :NOTE_,'
      '1106020067=         0,  --:RNDS_,'
      '1106020068=         0,  --:RNDS_SUMM_,'
      
        '1106020069=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1106020070=         3,  --:IS_VOZVRAT_,'
      '1106020071=         :G_CLIENT_'
      '1106020072=        );'
      '1106020073='
      
        '1106020074=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1106020075=        PNT_ = '#39'02'#39';'
      '1106020076=        UPDATE LT_SKLAD_PRODUCT L'
      '1106020077=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '1106020078=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1106020079=           AND L.G_TOCHKA = :G_CLIENT_;'
      '1106020080='
      '1106020081=        IF (ROW_COUNT = 0) THEN'
      
        '1106020082=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PR' +
        'ODUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '1106020083=      END'
      '1106020084=  END'
      '1106020085='
      '1106020086=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1106020087='
      
        '1106020088=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1106020089=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1106020090=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1106020091=                                  G_PRIHOD_,'
      '1106020092=                                  :SUMM_PRIHOD_,'
      '1106020093=                                  :Z_DATE_,'
      
        '1106020094=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1106020095=                                  :ZAKAZ_,'
      '1106020096=                                  NULL,'
      '1106020097=                                  :G_PAYMENT_TYPE_,'
      
        '1106020098=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106020099=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106020100=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1106020101=      EXIT;'
      '1106020102=    END'
      '1106020103=  END'
      '1106020104='
      
        '1106020105=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1106020106=  IF (IS_MEBEL_ = 1) THEN'
      
        '1106020107=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1106020108=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1106020109=end'
      '1106020110=;'
      '1106020111='
      '1106020112=ALTER PROCEDURE INV_DEL_INVOICE('
      '1106020113=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE)'
      '1106020114=RETURNS ('
      '1106020115=  ERR_CODE INTEGER,'
      '1106020116=  ERR_MSG VARCHAR(1024))'
      '1106020117=AS'
      
        '1106020118=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INV_DEL_INVO' +
        'ICE'#39';'
      '1106020119=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106020120=begin'
      '1106020121=  DELETE FROM invoice'
      '1106020122=  WHERE'
      '1106020123=    invoice = :invoice_;'
      '1106020124='
      '1106020125=when sqlcode -530 DO'
      '1106020126=  begin'
      '1106020127=    ERR_CODE = -20500;'
      
        '1106020128=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106020129=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106020130=  end'
      '1106020131=end'
      '1106020132=;'
      '1106020133='
      '1106020134=ALTER PROCEDURE INV_DEL_INVOICE_PAY('
      
        '1106020135=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY' +
        ')'
      '1106020136=RETURNS ('
