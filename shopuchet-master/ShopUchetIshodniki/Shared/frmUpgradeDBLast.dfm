        '11097126=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      
        '11097127=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMERI' +
        'C(15,2),'
      
        '11097128=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */ ' +
        'NUMERIC(15,2),'
      
        '11097129=  OFFICIAL_NAME /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */' +
        ' VARCHAR(150),'
      '11097130=  ERR_CODE INTEGER,'
      '11097131=  ERR_MSG VARCHAR(1024))'
      '11097132=AS'
      '11097133=BEGIN'
      '11097134=  SUSPEND;'
      '11097135=END'
      '11097136=;'
      '11097137='
      '11097138=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '11097139=RETURNS ('
      
        '11097140=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS */ BIGINT,'
      
        '11097141=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ BI' +
        'GINT,'
      
        '11097142=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT */ BIGINT,'
      
        '11097143=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '11097144=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11097145=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUME' +
        'RIC(15,2),'
      
        '11097146=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC */ NUMERIC(15,2),'
      
        '11097147=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_SUMM */ NUMERIC(15,2),'
      
        '11097148=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMERI' +
        'C(15,2),'
      
        '11097149=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM' +
        ' */ NUMERIC(15,2),'
      
        '11097150=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '11097151=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11097152=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11097153=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11097154=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_P' +
        'RICE */ NUMERIC(15,2))'
      '11097155=AS'
      '11097156=BEGIN'
      '11097157=  SUSPEND;'
      '11097158=END'
      '11097159=;'
      '11097160='
      '11097161='
      
        '11097162=/******************************************************' +
        '************************/'
      
        '11097163=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11097164=/******************************************************' +
        '************************/'
      '11097165=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '11097166=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11097167=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARENT' +
        ','
      '11097168=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11097169=  DATE_BEGIN_ DATE,'
      '11097170=  DATE_END_ DATE,'
      '11097171=  TIME_BEGIN_ TIME,'
      '11097172=  TIME_END_ TIME,'
      '11097173=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11097174=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11097175=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11097176=RETURNS ('
      '11097177=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11097178=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11097179=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '11097180=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'TENGE,'
      
        '11097181=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_S' +
        'UMM,'
      '11097182=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11097183=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '11097184=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11097185=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11097186=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11097187=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11097188=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11097189=  Z_DATE BLOB SUB_TYPE 1,'
      '11097190=  ROW INTEGER,'
      '11097191=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '11097192=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11097193=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11097194=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11097195=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11097196=  ERR_CODE INTEGER,'
      '11097197=  ERR_MSG VARCHAR(1024))'
      '11097198=AS'
      
        '11097199=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_L' +
        'IST'#39';'
      '11097200=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11097201=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '11097202=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE 8' +
        '0;'
      
        '11097203=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTI' +
        'CUL;'
      
        '11097204=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BARC' +
        'ODE;'
      
        '11097205=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PROD' +
        'UCT.BARCODE;'
      
        '11097206=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '11097207=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11097208=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.NAME;'
      
        '11097209=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.N' +
        'AME;'
      
        '11097210=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '11097211=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M = 0;'
      
        '11097212=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11097213=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '11097214=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11097215=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM = 0;'
      
        '11097216=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11097217=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '11097218=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '11097219=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.P' +
        'ATH = '#39#39';'
      '11097220=DECLARE VARIABLE I INTEGER = 1;'
      '11097221=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      '11097222=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAME;'
      
        '11097223=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      
        '11097224=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11097225=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FIO_DOC;'
      '11097226=BEGIN'
      '11097227=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '11097228=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '11097229='
      
        '11097230=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') || ' +
        #39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extrac' +
        't(year from Z.Z_DATE),'
      '11097231=             Z.Z_TIME,'
      '11097232=             GP.ARTICUL,'
      '11097233=             GP.BARCODE,'
      '11097234=             GP.NOMENCLATUR_NUM,'
      '11097235=             GP.NAME,'
      '11097236=             ZD.AMOUNT,'
      '11097237=             ZD.PRICE,'
      '11097238=             ZD.DISCOUNT_TENGE,'
      '11097239=             ZD.SUMM,'
      '11097240=             ZD.DISCOUNT_SUMM,'
      '11097241=             GC.NAME,'
      '11097242=             P.NAME,'
      '11097243=             TR.PATH,'
      '11097244=             Z.NOTE,'
      '11097245=             U.SHORT_NAME,'
      '11097246=             Z.SUMM_CASH,'
      '11097247=             Z.SUMM_NONCASH,'
      
        '11097248=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, '#39#39 +
        ')'
      '11097249=      FROM ZAKAZ Z,'
      '11097250=           ZAKAZ_DETAILS ZD,'
      '11097251=           G_CLIENT GC,'
      '11097252=           G_PAYMENT_TYPE P,'
      '11097253=           G_PRODUCT GP,'
      '11097254=           G_UNIT U,'
      '11097255=           G_OFFICIAL O,'
      '11097256=           P_REP_TREE TR'
      
        '11097257=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '11097258=       AND Z.IS_SPISANIE IN (0,2)'
      '11097259=       AND Z.IS_RESERVE = 0'
      '11097260=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11097261=       AND Z.G_CLIENT = GC.G_CLIENT'
      '11097262=       AND Z.G_OFFICIAL = O.G_OFFICIAL'
      '11097263=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11097264=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11097265=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '11097266=       AND GP.G_UNIT = U.G_UNIT'
      '11097267=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11097268=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(Z' +
        '.G_CLIENT, 1))'
      
        '11097269=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT_' +
        ', GC.G_CLIENT_PARENT)'
      
        '11097270=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '11097271=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_ AND :TIME_BEGIN_ IS NULL)'
      '11097272=            OR'
      
        '11097273=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGIN' +
        '_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN_' +
        ' IS NOT NULL)'
      '11097274=           )/*'
      
        '11097275=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_EN' +
        'D_ AND :TIME_BEGIN_ IS NOT NULL)'
      '11097276=            OR'
      '11097277=            :TIME_BEGIN_ IS NULL)*/'
      
        '11097278=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11097279=             OR'
      '11097280=             (:G_CATEGORY_ IS NULL)'
      '11097281=           )'
      
        '11097282=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT||' +
        #39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11097283=             OR'
      '11097284=            (:G_PRODUCT_ IS NULL)'
      '11097285=           )'
      '11097286=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '11097287=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :NO' +
        'MENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '11097288=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, :C' +
        'LIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_,'
      '11097289=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME_'
      '11097290=  DO BEGIN'
      '11097291=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '11097292=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11097293=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11097294=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "D' +
        'ATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '11097295=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_,' +
        ' :DISCOUNT_SUMM_ROLL_, 1);'
      '11097296='
      '11097297=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11097298=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11097299=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + D' +
        'ISCOUNT_SUMM_ROLL_;'
      '11097300=            SUMM_ROLL_ = 0;'
      '11097301=            DISCOUNT_SUMM_ROLL_ = 0;'
      '11097302=            I = I + 1;'
      '11097303=        END'
      '11097304='
      '11097305=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11097306=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE"' +
        ', ROW)'
      '11097307=        VALUES (:I, :PATH_, 1);'
      '11097308=        I = I + 1;'
      '11097309=    END'
      '11097310='
      
        '11097311=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "T' +
        'IME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, DI' +
        'SCOUNT, SUMM,'
      
        '11097312=                                         DISCOUNT_SUMM,' +
        ' CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME,'
      
        '11097313=                                         SUMM_CASH, SUM' +
        'M_NONCASH, OFFICIAL_NAME)'
      
        '11097314=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE' +
        '_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT' +
        '_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '11097315=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0, :' +
        'UNIT_NAME_,'
      
        '11097316=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME' +
        '_);'
      '11097317='
      '11097318=    I = I + 1;'
      '11097319=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '11097320=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOUN' +
        'T_SUMM_;'
      '11097321=    LAST_PATH_ = PATH_;'
      '11097322=  END'
      '11097323='
      '11097324=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11097325=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11097326=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOUNT' +
        '_SUMM_ROLL_, 1);'
      '11097327='
      '11097328=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11097329=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11097330=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_SU' +
        'MM_ROLL_;'
      '11097331='
      
        '11097332=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11097333=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL_,' +
        ' 2);'
      '11097334='
      
        '11097335=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCLA' +
        'TUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CLI' +
        'ENT_NAME,'
      
        '11097336=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME, SUMM_C' +
        'ASH, SUMM_NONCASH, OFFICIAL_NAME'
      '11097337=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '11097338=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOMEN' +
        'CLATUR_NUM, :TOVAR_NAME,'
      
        '11097339=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :DI' +
        'SCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      
        '11097340=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCASH' +
        ', :OFFICIAL_NAME'
      '11097341=  do suspend;'
      '11097342='
      '11097343=WHEN ANY DO BEGIN'
      '11097344=    Err_code = -20500;'
      
        '11097345=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11097346=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11097347=  END'
      '11097348=end'
      '11097349=;'
      '11097350='
      '11097351=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '11097352=RETURNS ('
      
        '11097353=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ_' +
        'DETAILS,'
      '11097354=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      '11097355=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT,'
      '11097356=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11097357=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11097358=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '11097359=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_PERC,'
      
        '11097360=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_SUMM,'
      '11097361=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '11097362=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '11097363=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11097364=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11097365=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11097366=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '11097367=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PRIC' +
        'E)'
      '11097368=AS'
      '11097369=begin'
      '11097370='
      '11097371=  FOR'
      '11097372=    SELECT T.ZAKAZ_DETAILS,'
      '11097373=           T.ZAKAZ,'
      '11097374=           T.G_PRODUCT,'
      '11097375=           T.AMOUNT,'
      '11097376=           T.PRICE,'
      '11097377=           T.SUMM,'
      '11097378=           T.DISCOUNT_PERC,'
      '11097379=           T.DISCOUNT_SUMM,'
      '11097380=           T.NDS,'
      '11097381=           T.NDS_SUMM,'
      '11097382=           P.NAME PRODUCT_NAME'
      '11097383=           ,P.BARCODE'
      '11097384=           ,P.ARTICUL'
      '11097385=           ,P.PRICE'
      '11097386=           ,T.COST_PRICE'
      '11097387=      FROM ZAKAZ_DETAILS_TMP T,'
      '11097388=           G_PRODUCT P'
      '11097389=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11097390=    ORDER BY t.ZAKAZ_DETAILS'
      '11097391=    INTO :ZAKAZ_DETAILS,'
      '11097392=          :ZAKAZ,'
      '11097393=          :G_PRODUCT,'
      '11097394=          :AMOUNT,'
      '11097395=          :PRICE,'
      '11097396=          :SUMM,'
      '11097397=          :DISCOUNT_PERC,'
      '11097398=          :DISCOUNT_SUMM,'
      '11097399=          :NDS,'
      '11097400=          :NDS_SUMM,'
      '11097401=          :PRODUCT_NAME'
      '11097402=          ,:BARCODE'
      '11097403=          ,:ARTICUL'
      '11097404=          ,:PRODUCT_PRICE'
      '11097405=          ,:COST_PRICE'
      '11097406=  DO'
      '11097407=    suspend;'
      '11097408=end'
      '11097409=;'
      
        '11097410=UPDATE SYSTEM_SETUP SET S_VALUE = 11097 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11097411=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11097412=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110980=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110981=  TYPE_ INTEGER = 0,'
      
        '110982=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR =' +
        ' NULL)'
      '110983=RETURNS ('
      '110984=  SORT_COL DM_BIGINT,'
      '110985=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110986=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '110987=  NAME VARCHAR(500))'
      '110988=AS'
      '110989=DECLARE VARIABLE LVL_ INTEGER;'
      '1109810=BEGIN'
      '1109811='
      '1109812=  IF (COALESCE(TYPE_, 0) = 0) THEN'
      '1109813=      FOR'
      '1109814=        SELECT'
      '1109815=            DECODE(T.G_PRODUCT, -1, 0, 1) SORT_COL,'
      '1109816=            T.G_PRODUCT,'
      '1109817=            T.G_PRODUCT_PAR,'
      '1109818=            T.NAME,'
      '1109819=            0'
      '1109820=        FROM G_PRODUCT T'
      '1109821=        WHERE T.IS_CATEGORY = 1'
      '1109822=        ORDER BY 1, T.NAME'
      '1109823=        INTO'
      '1109824=            :SORT_COL,'
      '1109825=            :G_PRODUCT,'
      '1109826=            :G_PRODUCT_PAR,'
      '1109827=            :NAME,'
      '1109828=            :LVL_'
      '1109829=      DO'
      '1109830=        suspend;'
      '1109831='
      
        '1109832=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059#1063#1040 +
        #1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '1109833=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054#1044#1048 +
        #1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '1109834=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1056#1054 +
        #1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '1109835=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048#1046#1045 +
        ' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '1109836=  ELSE'
      '1109837=    FOR WITH RECURSIVE TREE AS ('
      
        '1109838=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109839=               T.G_PRODUCT,'
      '1109840=               T.G_PRODUCT_PAR,'
      '1109841=               T.NAME,'
      '1109842=               1 LVL'
      '1109843=          FROM G_PRODUCT T'
      
        '1109844=         WHERE ((T.G_PRODUCT_PAR IS NULL or T.g_product ' +
        '= -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '1109845=               OR'
      '1109846=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_)'
      '1109847=        UNION ALL'
      
        '1109848=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109849=               T.G_PRODUCT,'
      '1109850=               T.G_PRODUCT_PAR,'
      '1109851=               T.NAME,'
      '1109852=               GG.LVL + 1 LVL'
      
        '1109853=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_PR' +
        'ODUCT = T.G_PRODUCT_PAR'
      '1109854=         WHERE T.IS_CATEGORY = 1'
      '1109855=        )'
      '1109856=        SELECT * FROM TREE ORDER BY 1, 5, 4'
      '1109857=        INTO :SORT_COL,'
      '1109858=            :G_PRODUCT,'
      '1109859=            :G_PRODUCT_PAR,'
      '1109860=            :NAME,'
      '1109861=            :LVL_'
      '1109862=    DO'
      '1109863=        suspend;'
      '1109864='
      '1109865=    /*'
      
        '1109866=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT, -' +
        '1, T.G_PRODUCT, 0) SORTT,'
      '1109867=                               T.G_PRODUCT,'
      '1109868=                               T.G_PRODUCT_PAR,'
      
        '1109869=                               DECODE(T.G_PRODUCT, -1, '#39 +
        #1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '1109870=                               T.NAME PATH,       --'#1076#1083#1103' ' +
        #1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '1109871=                               1 LVL'
      '1109872=                          FROM G_PRODUCT T'
      
        '1109873=                         WHERE (T.G_PRODUCT_PAR IS NULL ' +
        'or T.g_product = -1)'
      '1109874=                        UNION ALL'
      
        '1109875=                        SELECT DECODE(T.G_PRODUCT, -1, T' +
        '.G_PRODUCT, 0) SORTT,'
      '1109876=                               T.G_PRODUCT,'
      '1109877=                               T.G_PRODUCT_PAR,'
      '1109878=                               GG.LVL||T.NAME NAME,'
      
        '1109879=                               GG.PATH||'#39' - '#39'||T.NAME,  ' +
        '   --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '1109880=                               GG.LVL + 1 LVL'
      
        '1109881=                          FROM G_PRODUCT T INNER JOIN TR' +
        'EE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '1109882=                         WHERE T.IS_CATEGORY = 1'
      '1109883=                        )'
      '1109884=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '1109885=    */'
      '1109886=END'
      '1109887=;'
      
        '1109888=UPDATE SYSTEM_SETUP SET S_VALUE = 11098 WHERE SYSTEM_SET' +
        'UP = 3;'
      
        '1109889=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1109890=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110990=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '110991=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110992=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARENT,'
      '110993=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110994=  DATE_BEGIN_ DATE,'
      '110995=  DATE_END_ DATE,'
      '110996=  TIME_BEGIN_ TIME,'
      '110997=  TIME_END_ TIME,'
      '110998=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110999=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1109910=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1109911=RETURNS ('
      '1109912=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1109913=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1109914=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1109915=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_T' +
        'ENGE,'
      
        '1109916=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_SU' +
        'MM,'
      '1109917=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1109918=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1109919=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1109920=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1109921=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1109922=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_N' +
        'UM,'
      '1109923=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1109924=  Z_DATE BLOB SUB_TYPE 1,'
      '1109925=  ROW INTEGER,'
      '1109926=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1109927=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1109928=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1109929=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1109930=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1109931=  ERR_CODE INTEGER,'
      '1109932=  ERR_MSG VARCHAR(1024))'
      '1109933=AS'
      
        '1109934=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_LI' +
        'ST'#39';'
      '1109935=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1109936=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1109937=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      
        '1109938=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTIC' +
        'UL;'
      
        '1109939=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCO' +
        'DE;'
      
        '1109940=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODU' +
        'CT.BARCODE;'
      
        '1109941=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '1109942=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '1109943=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_' +
        'TYPE.NAME;'
      
        '1109944=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NA' +
        'ME;'
      
        '1109945=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '1109946=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ' = 0;'
      
        '1109947=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1109948=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1109949=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '1109950=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM = 0;'
      
        '1109951=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1109952=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '1109953=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '1109954=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.PA' +
        'TH = '#39#39';'
      '1109955=DECLARE VARIABLE I INTEGER = 1;'
      '1109956=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      '1109957=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAME;'
      
        '1109958=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CA' +
        'SH;'
      
        '1109959=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_NONCASH;'
      
        '1109960=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICIA' +
        'L.FIO_DOC;'
      '1109961=BEGIN'
      '1109962=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1109963=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1109964='
      
        '1109965=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') || '#39 +
        '.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extract' +
        '(year from Z.Z_DATE),'
      '1109966=             Z.Z_TIME,'
      '1109967=             GP.ARTICUL,'
      '1109968=             GP.BARCODE,'
      '1109969=             GP.NOMENCLATUR_NUM,'
      '1109970=             GP.NAME,'
      '1109971=             ZD.AMOUNT,'
      '1109972=             ZD.PRICE,'
      '1109973=             ZD.DISCOUNT_TENGE,'
      '1109974=             ZD.SUMM,'
      '1109975=             ZD.DISCOUNT_SUMM,'
      '1109976=             GC.NAME,'
      '1109977=             P.NAME,'
      '1109978=             TR.PATH,'
      '1109979=             Z.NOTE,'
      '1109980=             U.SHORT_NAME,'
      '1109981=             Z.SUMM_CASH,'
      '1109982=             Z.SUMM_NONCASH,'
      '1109983=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, '#39#39')'
      
        '1109984=      FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '1109985=           ZAKAZ_DETAILS ZD,'
      '1109986=           G_CLIENT GC,'
      '1109987=           G_PAYMENT_TYPE P,'
      '1109988=           G_PRODUCT GP,'
      '1109989=           G_UNIT U,'
      '1109990=           P_REP_TREE TR'
      
        '1109991=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '1109992=       AND Z.IS_SPISANIE IN (0,2)'
      '1109993=       AND Z.IS_RESERVE = 0'
      '1109994=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1109995=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1109996=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1109997=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1109998=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1109999=       AND GP.G_UNIT = U.G_UNIT'
      '11099100=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11099101=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(Z' +
        '.G_CLIENT, 1))'
      
        '11099102=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT_' +
        ', GC.G_CLIENT_PARENT)'
      
        '11099103=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '11099104=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_ AND :TIME_BEGIN_ IS NULL)'
      '11099105=            OR'
      
        '11099106=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGIN' +
        '_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN_' +
        ' IS NOT NULL)'
      '11099107=           )/*'
      
        '11099108=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_EN' +
        'D_ AND :TIME_BEGIN_ IS NOT NULL)'
      '11099109=            OR'
      '11099110=            :TIME_BEGIN_ IS NULL)*/'
      
        '11099111=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11099112=             OR'
      '11099113=             (:G_CATEGORY_ IS NULL)'
      '11099114=           )'
      
        '11099115=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT||' +
        #39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11099116=             OR'
      '11099117=            (:G_PRODUCT_ IS NULL)'
      '11099118=           )'
      '11099119=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '11099120=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :NO' +
        'MENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '11099121=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, :C' +
        'LIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_,'
      '11099122=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME_'
      '11099123=  DO BEGIN'
      '11099124=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '11099125=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11099126=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11099127=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "D' +
        'ATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '11099128=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_,' +
        ' :DISCOUNT_SUMM_ROLL_, 1);'
      '11099129='
      '11099130=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11099131=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11099132=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + D' +
        'ISCOUNT_SUMM_ROLL_;'
      '11099133=            SUMM_ROLL_ = 0;'
      '11099134=            DISCOUNT_SUMM_ROLL_ = 0;'
      '11099135=            I = I + 1;'
      '11099136=        END'
      '11099137='
      '11099138=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11099139=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE"' +
        ', ROW)'
      '11099140=        VALUES (:I, :PATH_, 1);'
      '11099141=        I = I + 1;'
      '11099142=    END'
      '11099143='
      
        '11099144=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "T' +
        'IME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, DI' +
        'SCOUNT, SUMM,'
      
        '11099145=                                         DISCOUNT_SUMM,' +
        ' CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME,'
      
        '11099146=                                         SUMM_CASH, SUM' +
        'M_NONCASH, OFFICIAL_NAME)'
      
        '11099147=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE' +
        '_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT' +
        '_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '11099148=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0, :' +
        'UNIT_NAME_,'
      
        '11099149=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME' +
        '_);'
      '11099150='
      '11099151=    I = I + 1;'
      '11099152=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '11099153=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOUN' +
        'T_SUMM_;'
      '11099154=    LAST_PATH_ = PATH_;'
      '11099155=  END'
      '11099156='
      '11099157=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11099158=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11099159=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOUNT' +
        '_SUMM_ROLL_, 1);'
      '11099160='
      '11099161=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11099162=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11099163=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_SU' +
        'MM_ROLL_;'
      '11099164='
      
        '11099165=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11099166=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL_,' +
        ' 2);'
      '11099167='
      
        '11099168=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCLA' +
        'TUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CLI' +
        'ENT_NAME,'
      
        '11099169=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME, SUMM_C' +
        'ASH, SUMM_NONCASH, OFFICIAL_NAME'
      '11099170=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '11099171=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOMEN' +
        'CLATUR_NUM, :TOVAR_NAME,'
      
        '11099172=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :DI' +
        'SCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      
        '11099173=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCASH' +
        ', :OFFICIAL_NAME'
      '11099174=  do suspend;'
      '11099175='
      '11099176=WHEN ANY DO BEGIN'
      '11099177=    Err_code = -20500;'
      
        '11099178=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11099179=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11099180=  END'
      '11099181=end'
      '11099182=;'
      
        '11099183=UPDATE SYSTEM_SETUP SET S_VALUE = 11099 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11099184=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11099185=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101000=CREATE PROCEDURE P_REP_Z('
      '1101001=  DATE_ DATE,'
      
        '1101002=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T)'
      '1101003=RETURNS ('
      '1101004=  STR VARCHAR(100),'
      '1101005=  AMOUNT VARCHAR(100),'
      '1101006=  SUMM VARCHAR(100))'
      '1101007=AS'
      '1101008=BEGIN'
      '1101009=  SUSPEND;'
      '11010010=END'
      '11010011=;'
      '11010012='
      '11010013=CREATE PROCEDURE UPD_ZAKAZ_DETAILS_DSCNT_ALL('
      
        '11010014=  DISCOUNT_ /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_PE' +
        'RC */ NUMERIC(15,2))'
      '11010015=RETURNS ('
      '11010016=  ERR_CODE INTEGER,'
      '11010017=  ERR_MSG VARCHAR(1024))'
      '11010018=AS'
      '11010019=BEGIN'
      '11010020=  SUSPEND;'
      '11010021=END'
      '11010022=;'
      '11010023='
      '11010024='
      
        '11010025=/******************************************************' +
        '************************/'
      
        '11010026=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11010027=/******************************************************' +
        '************************/'
      '11010028=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '11010029=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '11010030=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11010031=  ARTICUL_ VARCHAR(30),'
      '11010032=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11010033=  BARCODE_ VARCHAR(30),'
      '11010034=  NAME_ VARCHAR(500),'
      '11010035=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11010036=  PRICE_ NUMERIC(15,2),'
      '11010037=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11010038=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11010039=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11010040=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11010041=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11010042=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11010043=  IS_CATEGORY_ INTEGER,'
      '11010044=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11010045=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11010046=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11010047=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11010048=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR)'
      '11010049=RETURNS ('
      '11010050=  ERR_CODE INTEGER,'
      '11010051=  ERR_MSG VARCHAR(1024))'
      '11010052=AS'
      
        '11010053=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODUC' +
        'T'#39';'
      
        '11010054=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11010055=begin'
      
        '11010056=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11010057=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '11010058=                  FROM G_PRODUCT G'
      
        '11010059=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:A' +
        'RTICUL_))'
      '11010060=                   AND TRIM(G.ARTICUL) <> '#39#39
      '11010061=                   AND TRIM(:ARTICUL_) <> '#39#39
      '11010062=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11010063=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11010064=      ERR_CODE = -20500;'
      
        '11010065=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:ER' +
        'R_MSG);'
      '11010066=      EXIT;'
      '11010067=    END'
      '11010068='
      '11010069=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11010070=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11010071=                  FROM G_PRODUCT G'
      
        '11010072=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER' +
        '(TRIM(:NOMENCLATUR_NUM_))'
      '11010073=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11010074=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '11010075=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11010076=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11010077=      ERR_CODE = -20500;'
      
        '11010078=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURN' +
        'ING_VALUES (:ERR_MSG);'
      '11010079=      EXIT;'
      '11010080=    END'
      '11010081='
      '11010082=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11010083=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11010084=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11010085=                  FROM G_PRODUCT G'
      
        '11010086=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(:B' +
        'ARCODE_))'
      '11010087=                   AND TRIM(G.BARCODE) <> '#39#39
      '11010088=                   AND TRIM(:BARCODE_) <> '#39#39
      '11010089=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11010090=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11010091=          ERR_CODE = -20500;'
      
        '11010092=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '11010093=          EXIT;'
      '11010094=        END'
      '11010095='
      '11010096=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '11010097=                    FROM G_PRODUCT G, LT_BARCODE L'
      '11010098=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11010099=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '110100100=                     AND TRIM(L.BARCODE) <> '#39#39
      '110100101=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110100102=          ERR_CODE = -20500;'
      
        '110100103=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110100104=          EXIT;'
      '110100105=        END'
      '110100106=    END'
      '110100107='
      '110100108=    update G_PRODUCT'
      '110100109=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110100110=        ARTICUL = :ARTICUL_,'
      '110100111=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110100112=        BARCODE = :BARCODE_,'
      '110100113=        NAME = :NAME_,'
      '110100114=        G_UNIT = :G_UNIT_,'
      '110100115=        PRICE = :PRICE_,'
      '110100116=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110100117=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110100118=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110100119=        NOTE         = :NOTE_,'
      '110100120=        CROSSCODE    = :CROSSCODE_,'
      '110100121=        IS_KIT       = :IS_KIT_,'
      '110100122=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110100123=        PLACE        = :PLACE_,'
      '110100124=        SALES_COMM   = :SALES_COMM_,'
      '110100125=        KOD_TNVD     = :KOD_TNVD_,'
      '110100126=        FAST_TOVAR   = :FAST_TOVAR_'
      '110100127=    where (G_PRODUCT = :G_PRODUCT_);'
      '110100128='
      '110100129=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110100130=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110100131='
      '110100132=        INSERT INTO LT_BARCODE'
      
        '110100133=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110100134='
      '110100135=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110100136=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110100137=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110100138='
      
        '110100139=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110100140=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110100141='
      '110100142=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110100143=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110100144=            INSERT INTO G_PRODUCT_KIT'
      
        '110100145=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110100146=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110100147=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110100148=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110100149='
      
        '110100150=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110100151=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110100152='
      '110100153=            UPDATE G_PRODUCT_KIT G'
      
        '110100154=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110100155=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110100156=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110100157=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110100158='
      
        '110100159=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110100160=            if (is_kit_ = 1) then begin'
      
        '110100161=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110100162=                  FROM G_PRODUCT_KIT K,'
      '110100163=                       LT_SKLAD_PRODUCT L'
      '110100164=                 WHERE K.g_product = :G_PRODUCT_'
      '110100165=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110100166=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110100167=                 GROUP BY K.G_PRODUCT'
      '110100168=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110100169='
      '110100170=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110100171=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110100172=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110100173=            end'
      '110100174=        END'
      '110100175=    END'
      '110100176=end'
      '110100177=;'
      '110100178='
      '110100179=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '110100180=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110100181=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110100182=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110100183=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110100184=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110100185=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110100186=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110100187=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110100188=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110100189=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110100190=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110100191=  IS_SPISANIE_ INTEGER,'
      '110100192=  NEW_LINE_SALE_ INTEGER = 0,'
      '110100193=  MODE_ INTEGER = 0,'
      '110100194=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1)'
      '110100195=RETURNS ('
      
        '110100196=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110100197=  ERR_CODE INTEGER,'
      '110100198=  ERR_MSG VARCHAR(1024))'
      '110100199=AS'
      '110100200=/*'
      
        '110100201=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048 +
        #1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '110100202=*/'
      
        '110100203=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39';'
      
        '110100204=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110100205=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      
        '110100206=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110100207=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110100208=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110100209=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110100210=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110100211=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110100212=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '110100213=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110100214=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' */'
      
        '110100215=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' ' +
        #1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      '110100216=BEGIN'
      '110100217='
      
        '110100218=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110100219=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110100220=    FROM ZAKAZ_DETAILS_TMP T'
      '110100221=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110100222=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110100223=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110100224='
      
        '110100225=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110100226=           ,G.IS_KIT'
      '110100227=           ,K.AMOUNT * :AMOUNT_'
      '110100228=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110100229=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      '110100230=           ,(CASE'
      
        '110100231=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE' +
        '_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * ' +
        'FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '110100232=             ELSE K.PRICE'
      '110100233=           END) COST_PRICE'
      
        '110100234=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_L' +
        'AST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '110100235=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE ' +
        'G_PRODUCT = :G_PRODUCT_) CNT'
      
        '110100236=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110100237=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110100238=       AND G.IS_KIT = 1'
      '110100239=    UNION'
      
        '110100240=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110100241=           ,G.IS_KIT'
      '110100242=           ,:AMOUNT_'
      '110100243=           ,:PRICE_'
      '110100244=           ,0'
      '110100245=           ,:COST_PRICE_'
      '110100246=           ,0'
      '110100247=      FROM G_PRODUCT G'
      '110100248=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110100249=       AND G.IS_KIT <> 1'
      '110100250=      INTO :G_PRODUCT_'
      '110100251=           ,:IS_KIT_'
      '110100252=           ,:AMOUNT_'
      '110100253=           ,:PRICE__'
      '110100254=           ,:SOSTAV_PRICE_'
      '110100255=           ,:COST_PRICE__'
      '110100256=           ,:SOSTAV_COUNT_'
      '110100257=  DO BEGIN'
      '110100258=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110100259='
      
        '110100260=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110100261=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110100262=        IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '110100263=            PRICE__ = SOSTAV_PRICE_;'
      '110100264=        END ELSE BEGIN'
      '110100265=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110100266=              PRICE__ = COST_PRICE__;'
      '110100267='
      
        '110100268=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110100269=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110100270='
      '110100271='
      
        '110100272=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110100273=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110100274=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110100275=            END'
      '110100276='
      
        '110100277=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110100278=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110100279=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110100280=        END'
      '110100281=      END'
      '110100282='
      
        '110100283=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '110100284=      IF (NEW_LINE_SALE_ = 0) THEN'
      '110100285=          SELECT ZD.zakaz_details'
      '110100286=            FROM zakaz_details_tmp ZD'
      '110100287=           WHERE ZD.G_PRODUCT = :g_product_'
      '110100288=             AND ZD.PRICE = :PRICE__'
      '110100289=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110100290=            INTO :ZAKAZ_DTLS_TMP_;'
      '110100291='
      '110100292='
      '110100293=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110100294=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110100295=           SET P.amount = P.amount + :amount_'
      
        '110100296=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110100297=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110100298=               ,P.NDS = :NDS_'
      '110100299=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110100300=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110100301='
      '110100302=      ELSE BEGIN'
      '110100303=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110100304=          ('
      '110100305=           ZAKAZ_DETAILS,'
      '110100306=           ZAKAZ,'
      '110100307=           G_PRODUCT,'
      '110100308=           AMOUNT,'
      '110100309=           PRICE,'
      '110100310=           SUMM,'
      '110100311=           DISCOUNT_PERC,'
      '110100312=           DISCOUNT_TENGE,'
      '110100313=           DISCOUNT_SUMM,'
      '110100314=           NDS,'
      '110100315=           NDS_SUMM,'
      '110100316=           COST_PRICE'
      '110100317=          ) VALUES ('
      '110100318=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110100319=           :ZAKAZ_,'
      '110100320=           :G_PRODUCT_,'
      '110100321=           :AMOUNT_,'
      '110100322=           :PRICE__,'
      '110100323=           :SUMM_,'
      '110100324=           :DISCOUNT_PERC_,'
      '110100325=           :DISCOUNT_TENGE_,'
      '110100326=           :DISCOUNT_SUMM_,'
      '110100327=           :NDS_,'
      '110100328=           :NDS_SUMM_,'
      '110100329=           :COST_PRICE__'
      '110100330=          )'
      '110100331=          RETURNING'
      '110100332=            ZAKAZ_DETAILS'
      '110100333=          INTO'
      '110100334=            :ZAKAZ_DETAILS_;'
      '110100335=      END'
      '110100336='
      '110100337=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110100338=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110100339=        FROM LT_SKLAD_PRODUCT L'
      '110100340=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110100341=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110100342=       INTO :AMOUNT_CUR_;'
      '110100343='
      
        '110100344=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110100345=      if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      
        '110100346=          -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110100347=          -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', ' +
        #1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110100348=          -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' ' +
        #1050#1054#1051#1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110100349=          -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' '#1041#1067#1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057 +
        #1050#1054#1051#1068#1050#1054
      
        '110100350=          -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054 +
        #1042#1040#1058#1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110100351=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110100352=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110100353=              SELECT SUM(AMOUNT)'
      '110100354=                FROM ZAKAZ_DETAILS T'
      '110100355=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110100356=                 AND T.ZAKAZ = :ZAKAZ_'
      '110100357=                INTO :AMOUNT_OLD_;'
      '110100358=            ELSE'
      '110100359=              SELECT SUM(AMOUNT)'
      '110100360=                FROM SKLAD T'
      '110100361=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110100362=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '110100363=                INTO :AMOUNT_OLD_;'
      '110100364=          END'
      '110100365='
      '110100366=          -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110100367=          SELECT SUM(AMOUNT)'
      '110100368=            FROM ZAKAZ_DETAILS_TMP T'
      '110100369=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110100370=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '110100371='
      
        '110100372=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKA' +
        'Z_, 0);'
      
        '110100373=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0)' +
        ';'
      '110100374='
      
        '110100375=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COA' +
        'LESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110100376=            SELECT NAME'
      '110100377=            FROM G_PRODUCT'
      '110100378=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110100379=            INTO :PRODUCT_NAME_;'
      '110100380='
      '110100381=            ERR_CODE = -20500;'
      
        '110100382=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110100383=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110100384=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110100385=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110100386=            EXIT;'
      '110100387=          END'
      '110100388=      END'
      '110100389=  END'
      '110100390=end'
      '110100391=;'
      '110100392='
      '110100393=ALTER PROCEDURE P_REP_Z('
      '110100394=  DATE_ DATE,'
      '110100395=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110100396=RETURNS ('
      '110100397=  STR VARCHAR(100),'
      '110100398=  AMOUNT VARCHAR(100),'
      '110100399=  SUMM VARCHAR(100))'
      '110100400=AS'
      '110100401=/*'
      
        '110100402=Z-'#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048 +
        #1071', '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '110100403='#1053#1054' '#1057#1054#1050#1056#1040#1065#1045#1053#1053#1054', '#1058#1048#1055#1040':'
      '110100404='#1054#1057#1058#1040#1058#1054#1050' '#1053#1040' '#1053#1040#1063#1040#1051#1054' 5000'
      '110100405='#1055#1056#1054#1044#1040#1046#1040'   *4    = 48990'
      '110100406='#1042#1054#1047#1042#1056#1040#1058'   *0    = 0'
      '110100407='#1042#1053#1045#1057#1045#1053#1048#1045'  *0    = 0'
      '110100408='#1048#1047#1066#1071#1058#1048#1045'   *0    = 0'
      '110100409='#1057#1059#1052#1052#1040' '#1042' '#1050#1040#1057#1057#1045'   = 538990'
      '110100410=*/'
      '110100411=DECLARE VARIABLE COL INTEGER;'
      '110100412=DECLARE VARIABLE IN_SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110100413=DECLARE VARIABLE PRODAZHI_CASH_SUMM_ TYPE OF COLUMN KA' +
        'SSA.SUMM;'
      
        '110100414=DECLARE VARIABLE PRODAZHI_CASH_AMOUNT_ TYPE OF COLUMN ' +
        'KASSA.SUMM;'
      
        '110100415=DECLARE VARIABLE PRODAZHI_NONCASH_SUMM_ TYPE OF COLUMN' +
        ' KASSA.SUMM;'
      
        '110100416=DECLARE VARIABLE PRODAZHI_NONCASH_AMOUNT_ TYPE OF COLU' +
        'MN KASSA.SUMM;'
      
        '110100417=DECLARE VARIABLE VOZVRAT_CASH_SUMM_ TYPE OF COLUMN KAS' +
        'SA.SUMM;'
      
        '110100418=DECLARE VARIABLE VOZVRAT_CASH_AMOUNT_ TYPE OF COLUMN K' +
        'ASSA.SUMM;'
      
        '110100419=DECLARE VARIABLE VOZVRAT_NONCASH_SUMM_ TYPE OF COLUMN ' +
        'KASSA.SUMM;'
      
        '110100420=DECLARE VARIABLE VOZVRAT_NONCASH_AMOUNT_ TYPE OF COLUM' +
        'N KASSA.SUMM;'
      
        '110100421=DECLARE VARIABLE VNESENIE_AMOUNT_ TYPE OF COLUMN KASSA' +
        '.SUMM;'
      
        '110100422=DECLARE VARIABLE VNESENIE_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '110100423=DECLARE VARIABLE IZYATIE_AMOUNT_ TYPE OF COLUMN KASSA.' +
        'SUMM;'
      
        '110100424=DECLARE VARIABLE IZYATIE_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      '110100425=DECLARE VARIABLE OUT_SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '110100426=BEGIN'
      '110100427='
      '110100428=  IF (DATE_ IS NULL) THEN'
      '110100429=    DATE_ = CURRENT_DATE;'
      '110100430='
      '110100431=  IF (G_TOCHKA_ IS NULL) THEN'
      '110100432=    SELECT ID'
      '110100433=      FROM CUR_PARAMS'
      '110100434=     WHERE CUR_PARAMS = 2'
      '110100435=      INTO :G_TOCHKA_;'
      '110100436='
      '110100437=  SELECT S."INPUT"'
      '110100438=    FROM kassa_state S'
      '110100439=   WHERE S.k_date = :DATE_'
      '110100440=     AND S.g_tochka = :G_TOCHKA_'
      '110100441=    INTO :IN_SUMM_;'
      '110100442='
      '110100443=  IF (ROW_COUNT = 0) THEN'
      '110100444=    SELECT S."OUTPUT"'
      '110100445=      FROM kassa_state S'
      '110100446=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '110100447=                         FROM KASSA_STATE ST'
      '110100448=                        WHERE ST.k_date < :DATE_'
      '110100449=                         AND ST.g_tochka = :G_TOCHKA_)'
      '110100450=      AND S.g_tochka = :G_TOCHKA_'
      '110100451=      INTO :IN_SUMM_;'
      '110100452='
      '110100453=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '110100454='
      '110100455=  SELECT S."OUTPUT"'
      '110100456=    FROM kassa_state S'
      '110100457=   WHERE S.k_date = :DATE_'
      '110100458=     AND S.g_tochka = :G_TOCHKA_'
      '110100459=    INTO :OUT_SUMM_;'
      '110100460='
      '110100461=  IF (ROW_COUNT = 0) THEN'
      '110100462=    SELECT S."OUTPUT"'
      '110100463=      FROM kassa_state S'
      '110100464=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '110100465=                         FROM KASSA_STATE ST'
      '110100466=                        WHERE ST.k_date < :DATE_'
      '110100467=                         AND ST.g_tochka = :G_TOCHKA_)'
      '110100468=      AND S.g_tochka = :G_TOCHKA_'
      '110100469=      INTO :OUT_SUMM_;'
      '110100470='
      '110100471=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '110100472='
      '110100473=  -- '#1055#1056#1054#1044#1040#1046#1040' '#1053#1040#1051
      '110100474=  SELECT COUNT(Z.ZAKAZ),'
      '110100475=         SUM(K.SUMM)'
      '110100476=    FROM ZAKAZ Z,'
      '110100477=         KASSA K'
      '110100478=   WHERE Z.is_spisanie in (0, 2)'
      '110100479=     AND Z.Z_DATE = :DATE_'
      '110100480=     AND Z.G_TOCHKA = :G_TOCHKA_'
      '110100481=     AND K.ZAKAZ = Z.ZAKAZ'
      '110100482=    INTO :PRODAZHI_CASH_AMOUNT_,'
      '110100483=         :PRODAZHI_CASH_SUMM_;'
      '110100484='
      '110100485=  -- '#1055#1056#1054#1044#1040#1046#1040' '#1041#1045#1047#1053#1040#1051
      '110100486=  SELECT COUNT(Z.ZAKAZ),'
      '110100487=         SUM(K.SUMM)'
      '110100488=    FROM ZAKAZ Z,'
      '110100489=         KASSA_BEZNAL K'
      '110100490=   WHERE Z.is_spisanie in (0, 2)'
      '110100491=     AND Z.Z_DATE = :DATE_'
      '110100492=     AND Z.G_TOCHKA = :G_TOCHKA_'
      '110100493=     AND K.ZAKAZ = Z.ZAKAZ'
      '110100494=    INTO :PRODAZHI_NONCASH_AMOUNT_,'
      '110100495=         :PRODAZHI_NONCASH_SUMM_;'
      '110100496='
      '110100497=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1053#1040#1051
      '110100498=  SELECT COUNT(SP.SKLAD),'
      '110100499=         SUM(K.SUMM)'
      '110100500=    FROM SKLAD_PARENT SP,'
      '110100501=         KASSA K'
      '110100502=   WHERE SP.IS_VOZVRAT = 1'
      '110100503=     AND SP.DATE_RECEIPT = :DATE_'
      '110100504=     AND SP.G_TOCHKA = :G_TOCHKA_'
      '110100505=     AND K.SKLAD = SP.SKLAD'
      '110100506=    INTO :VOZVRAT_CASH_AMOUNT_,'
      '110100507=         :VOZVRAT_CASH_SUMM_;'
      '110100508='
      '110100509=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1041#1045#1047#1053#1040#1051
      '110100510=  SELECT COUNT(SP.SKLAD),'
      '110100511=         SUM(K.SUMM)'
      '110100512=    FROM SKLAD_PARENT SP,'
      '110100513=         KASSA_BEZNAL K'
      '110100514=   WHERE SP.IS_VOZVRAT = 1'
      '110100515=     AND SP.DATE_RECEIPT = :DATE_'
      '110100516=     AND SP.G_TOCHKA = :G_TOCHKA_'
      '110100517=     AND K.SKLAD = SP.SKLAD'
      '110100518=    INTO :VOZVRAT_NONCASH_AMOUNT_,'
      '110100519=         :VOZVRAT_NONCASH_SUMM_;'
      '110100520='
      '110100521=  -- '#1042#1053#1045#1057#1045#1053#1048#1045
      '110100522=  SELECT COUNT(S.KASSA),'
      '110100523=         SUM(S.SUMM)'
      '110100524=    FROM KASSA S,'
      '110100525=         G_PRIHOD_RASHOD D'
      '110100526=   WHERE S.ACTION_DATE = :DATE_'
      '110100527=     AND S.G_PRIHOD_RASHOD = D.G_PRIHOD_RASHOD'
      '110100528=     AND D.DO_ACTION = 0'
      '110100529=     AND D.G_PRIHOD_RASHOD <> 1'
      '110100530=    INTO :VNESENIE_AMOUNT_,'
      '110100531=         :VNESENIE_SUMM_;'
      '110100532='
      '110100533=  -- '#1048#1047#1066#1071#1058#1048#1045
      '110100534=  SELECT COUNT(S.KASSA),'
      '110100535=         SUM(S.SUMM)'
      '110100536=    FROM KASSA S,'
      '110100537=         G_PRIHOD_RASHOD D'
      '110100538=   WHERE S.ACTION_DATE = :DATE_'
      '110100539=     AND S.G_PRIHOD_RASHOD = D.G_PRIHOD_RASHOD'
      '110100540=     AND D.DO_ACTION = 1'
      '110100541=     AND D.G_PRIHOD_RASHOD NOT IN (2,3)'
      '110100542=    INTO :IZYATIE_AMOUNT_,'
      '110100543=         :IZYATIE_SUMM_;'
      '110100544='
      '110100545=  IN_SUMM_                  = COALESCE(IN_SUMM_, 0);'
      
        '110100546=  PRODAZHI_CASH_SUMM_       = COALESCE(PRODAZHI_CASH_S' +
        'UMM_, 0);'
      
        '110100547=  PRODAZHI_CASH_AMOUNT_     = COALESCE(PRODAZHI_CASH_A' +
        'MOUNT_, 0);'
      
        '110100548=  PRODAZHI_NONCASH_SUMM_    = COALESCE(PRODAZHI_NONCAS' +
        'H_SUMM_, 0);'
      
        '110100549=  PRODAZHI_NONCASH_AMOUNT_  = COALESCE(PRODAZHI_NONCAS' +
        'H_AMOUNT_, 0);'
      
        '110100550=  VOZVRAT_CASH_SUMM_        = COALESCE(VOZVRAT_CASH_SU' +
        'MM_, 0);'
      
        '110100551=  VOZVRAT_CASH_AMOUNT_      = COALESCE(VOZVRAT_CASH_AM' +
        'OUNT_, 0);'
      
        '110100552=  VOZVRAT_NONCASH_SUMM_     = COALESCE(VOZVRAT_NONCASH' +
        '_SUMM_, 0);'
      
        '110100553=  VOZVRAT_NONCASH_AMOUNT_   = COALESCE(VOZVRAT_NONCASH' +
        '_AMOUNT_, 0);'
      
        '110100554=  VNESENIE_AMOUNT_          = COALESCE(VNESENIE_AMOUNT' +
        '_, 0);'
      
        '110100555=  VNESENIE_SUMM_            = COALESCE(VNESENIE_SUMM_,' +
        ' 0);'
      
        '110100556=  IZYATIE_AMOUNT_           = COALESCE(IZYATIE_AMOUNT_' +
        ', 0);'
      
        '110100557=  IZYATIE_SUMM_             = COALESCE(IZYATIE_SUMM_, ' +
        '0);'
      '110100558=  OUT_SUMM_                 = COALESCE(OUT_SUMM_, 0);'
      '110100559='
      '110100560=  FOR SELECT 0.5 COL,'
      '110100561=               '#39'******'#39' STR,'
      '110100562=               '#39'******'#39' AMOUNT,'
      '110100563=               '#39'******'#39' SUMM'
      '110100564=          FROM RDB$DATABASE'
      '110100565=        UNION'
      '110100566=        SELECT 1 COL,'
      '110100567=               '#39#1054#1058#1063#1045#1058' Z'#39' STR,'
      '110100568=               '#39#39' AMOUNT,'
      '110100569=               '#39#39' SUMM'
      '110100570=          FROM RDB$DATABASE'
      '110100571=        UNION'
      '110100572=        SELECT 1.5 COL,'
      '110100573=               '#39#1055#1051#1040#1058#1045#1046#1053#1067#1045' '#1057#1056#1045#1044#1057#1058#1042#1040#39' STR,'
      '110100574=               '#39'******'#39' AMOUNT,'
      '110100575=               '#39'******'#39' SUMM'
      '110100576=          FROM RDB$DATABASE'
      '110100577=        UNION'
      '110100578=        SELECT 2 COL,'
      '110100579=               '#39#1053#1040#1051#1048#1063#1053#1067#1045#39' STR,'
      '110100580=               '#39#39' AMOUNT,'
      '110100581=               '#39#39' SUMM'
      '110100582=          FROM RDB$DATABASE'
      '110100583=        UNION'
      '110100584=        SELECT 3 COL,'
      '110100585=               '#39'  '#1053#1040' '#1053#1040#1063#1040#1051#1054' '#1042' '#1050#1040#1057#1057#1045#39' STR,'
      '110100586=               '#39#39' AMOUNT,'
      '110100587=               '#39'='#39'||:IN_SUMM_ SUMM'
      '110100588=          FROM RDB$DATABASE'
      '110100589=        UNION'
      '110100590=        SELECT 4 COL,'
      '110100591=               '#39'  '#1055#1056#1054#1044#1040#1046#1040#39' STR,'
      '110100592=               '#39'*'#39'||:PRODAZHI_CASH_AMOUNT_ AMOUNT,'
      '110100593=               '#39'='#39'||:PRODAZHI_CASH_SUMM_ SUMM'
      '110100594=          FROM RDB$DATABASE'
      '110100595=        UNION'
      '110100596=        SELECT 5 COL,'
      '110100597=               '#39'  '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      '110100598=               '#39'*'#39'||:VOZVRAT_CASH_AMOUNT_ AMOUNT,'
      '110100599=               '#39'='#39'||:VOZVRAT_CASH_SUMM_ SUMM'
      '110100600=          FROM RDB$DATABASE'
      '110100601=        UNION'
      '110100602=        SELECT 6 COL,'
      '110100603=               '#39'  '#1042#1053#1045#1057#1045#1053#1048#1045#39' STR,'
      '110100604=               '#39'*'#39'||:VNESENIE_AMOUNT_ AMOUNT,'
      '110100605=               '#39'='#39'||:VNESENIE_SUMM_ SUMM'
      '110100606=          FROM RDB$DATABASE'
      '110100607=        UNION'
      '110100608=        SELECT 7 COL,'
      '110100609=               '#39'  '#1048#1047#1066#1071#1058#1048#1045#39' STR,'
      '110100610=               '#39'*'#39'||:IZYATIE_AMOUNT_ AMOUNT,'
      '110100611=               '#39'='#39'||:IZYATIE_SUMM_ SUMM'
      '110100612=          FROM RDB$DATABASE'
      '110100613=        UNION'
      '110100614=        SELECT 8 COL,'
      '110100615=               '#39'  '#1057#1059#1052#1052#1040' '#1042' '#1050#1040#1057#1057#1045#39' STR,'
      '110100616=               '#39#39' AMOUNT,'
      '110100617=               '#39'='#39'||:OUT_SUMM_ SUMM'
      '110100618=          FROM RDB$DATABASE'
      '110100619=        UNION'
      '110100620=        SELECT 9 COL,'
      '110100621=               '#39#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1045#39' STR,'
      '110100622=               '#39#39' AMOUNT,'
      '110100623=               '#39#39' SUMM'
      '110100624=          FROM RDB$DATABASE'
      '110100625=        UNION'
      '110100626=        SELECT 10 COL,'
      '110100627=               '#39'  '#1055#1056#1054#1044#1040#1046#1040#39' STR,'
      '110100628=               '#39'*'#39'||:PRODAZHI_NONCASH_AMOUNT_ AMOUNT,'
      '110100629=               '#39'='#39'||:PRODAZHI_NONCASH_SUMM_ SUMM'
      '110100630=          FROM RDB$DATABASE'
      '110100631=        UNION'
      '110100632=        SELECT 11 COL,'
      '110100633=               '#39'  '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      '110100634=               '#39'*'#39'||:VOZVRAT_NONCASH_AMOUNT_ AMOUNT,'
      '110100635=               '#39'='#39'||:VOZVRAT_NONCASH_SUMM_ SUMM'
      '110100636=          FROM RDB$DATABASE'
      '110100637=        UNION'
      '110100638=        SELECT 12 COL,'
      '110100639=               '#39#1048#1058#1054#1043#1054' '#1055#1056#1054#1044#1040#1046#1040#39' STR,'
      
        '110100640=               '#39'*'#39'||(:PRODAZHI_CASH_AMOUNT_ + :PRODAZH' +
        'I_NONCASH_AMOUNT_) AMOUNT,'
      
        '110100641=               '#39'='#39'||(:PRODAZHI_CASH_SUMM_ + :PRODAZHI_' +
        'NONCASH_SUMM_) SUMM'
      '110100642=          FROM RDB$DATABASE'
      '110100643=        UNION'
      '110100644=        SELECT 13 COL,'
      '110100645=               '#39#1048#1058#1054#1043#1054' '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      
        '110100646=               '#39'*'#39'||(:VOZVRAT_CASH_AMOUNT_ + :VOZVRAT_' +
        'NONCASH_AMOUNT_) AMOUNT,'
      
        '110100647=               '#39'='#39'||(:VOZVRAT_CASH_SUMM_ + :VOZVRAT_NO' +
        'NCASH_SUMM_) SUMM'
      '110100648=          FROM RDB$DATABASE'
      '110100649=        UNION'
      '110100650=        SELECT 14 COL,'
      '110100651=               '#39#39' STR,'
      '110100652=               '#39#39' AMOUNT,'
      '110100653=               '#39#39' SUMM'
      '110100654=          FROM RDB$DATABASE'
      '110100655=        UNION'
      '110100656=        SELECT 15 COL,'
      '110100657=               '#39#1054#1060#1054#1056#1052#1051#1045#1053#1053#1067#1045' '#1063#1045#1050#1048#39' STR,'
      '110100658=               '#39'******'#39' AMOUNT,'
      '110100659=               '#39'******'#39' SUMM'
      '110100660=          FROM RDB$DATABASE'
      '110100661=        UNION'
      '110100662=        SELECT 16 COL,'
      '110100663=               '#39'  '#1055#1056#1054#1044#1040#1046#1040#39' STR,'
      
        '110100664=               '#39'*'#39'||(:PRODAZHI_CASH_AMOUNT_ + :PRODAZH' +
        'I_NONCASH_AMOUNT_) AMOUNT,'
      
        '110100665=               '#39'='#39'||(:PRODAZHI_CASH_SUMM_ + :PRODAZHI_' +
        'NONCASH_SUMM_) SUMM'
      '110100666=          FROM RDB$DATABASE'
      '110100667=        UNION'
      '110100668=        SELECT 17 COL,'
      '110100669=               '#39'  '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      
        '110100670=               '#39'*'#39'||(:VOZVRAT_CASH_AMOUNT_ + :VOZVRAT_' +
        'NONCASH_AMOUNT_) AMOUNT,'
      
        '110100671=               '#39'='#39'||(:VOZVRAT_CASH_SUMM_ + :VOZVRAT_NO' +
        'NCASH_SUMM_) SUMM'
      '110100672=          FROM RDB$DATABASE'
      '110100673=        UNION'
      '110100674=        SELECT 18 COL,'
      '110100675=               '#39'  '#1042#1053#1045#1057#1045#1053#1048#1045#39' STR,'
      '110100676=               '#39'*'#39'||:VNESENIE_AMOUNT_ AMOUNT,'
      '110100677=               '#39'='#39'||:VNESENIE_SUMM_ SUMM'
      '110100678=          FROM RDB$DATABASE'
      '110100679=        UNION'
      '110100680=        SELECT 19 COL,'
      '110100681=               '#39'  '#1048#1047#1066#1071#1058#1048#1045#39' STR,'
      '110100682=               '#39'*'#39'||:IZYATIE_AMOUNT_ AMOUNT,'
      '110100683=               '#39'='#39'||:IZYATIE_SUMM_ SUMM'
      '110100684=          FROM RDB$DATABASE'
      '110100685=        UNION'
      '110100686=        SELECT 20 COL,'
      '110100687=               '#39#39' STR,'
      '110100688=               '#39#39' AMOUNT,'
      '110100689=               '#39#39' SUMM'
      '110100690=          FROM RDB$DATABASE'
      '110100691=        UNION'
      '110100692=        SELECT 21 COL,'
      
        '110100693=               lpad(EXTRACT(DAY FROM :DATE_), 2, '#39'0'#39')|' +
        '|'#39'.'#39'||lpad(EXTRACT(MONTH FROM :DATE_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM :DATE_)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM CURRENT_TIMESTAMP),' +
        ' 2, '#39'0'#39')||'#39':'#39'||lpad(EXTRACT(MINUTE FROM CURRENT_TIMESTAMP), 2, '#39 +
        '0'#39') STR,'
      '110100694=               '#39#39' AMOUNT,'
      '110100695=               '#39#39' SUMM'
      '110100696=          FROM RDB$DATABASE'
      '110100697=        UNION'
      '110100698=        SELECT 22 COL,'
      '110100699=               '#39'******'#39' STR,'
      '110100700=               '#39'******'#39' AMOUNT,'
      '110100701=               '#39'******'#39' SUMM'
      '110100702=          FROM RDB$DATABASE'
      '110100703=        ORDER BY 1'
      '110100704=    INTO :COL,'
      '110100705=        :STR,'
      '110100706=        :AMOUNT,'
      '110100707=        :SUMM'
      '110100708=  DO'
      '110100709=    suspend;'
      '110100710=end'
      '110100711=;'
      '110100712='
      '110100713=ALTER PROCEDURE UPD_ZAKAZ_DETAILS_DSCNT_ALL('
      
        '110100714=  DISCOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_PERC' +
        ')'
      '110100715=RETURNS ('
      '110100716=  ERR_CODE INTEGER,'
      '110100717=  ERR_MSG VARCHAR(1024))'
      '110100718=AS'
      '110100719=/*'
      
        '110100720='#1055#1056#1048#1052#1045#1053#1071#1045#1058' '#1057#1050#1048#1044#1050#1059' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1042#1067 +
        #1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1056#1040#1041#1054#1063#1045#1052' '#1052#1045#1057#1058#1045' '#1050#1040#1057#1057#1048#1056#1040
      '110100721=*/'
      
        '110100722=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_ZAKAZ_DE' +
        'TAILS_DSCNT_All'#39';'
      '110100723=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110100724=BEGIN'
      '110100725='
      '110100726=  UPDATE ZAKAZ_DETAILS_TMP T'
      '110100727=     SET T.DISCOUNT_PERC  = :DISCOUNT_,'
      '110100728=         T.DISCOUNT_TENGE = T.PRICE * :DISCOUNT_/100,'
      
        '110100729=         T.DISCOUNT_SUMM  = T.AMOUNT * T.PRICE * :DISC' +
        'OUNT_/100,'
      
        '110100730=         T.SUMM           = T.AMOUNT * T.PRICE * (1 - ' +
        ':DISCOUNT_/100);'
      '110100731=END'
      '110100732=;'
      
