        '1101522021=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101522022=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101522023=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101522024=                      EXIT;'
      '1101522025=                    END'
      '1101522026=                END'
      '1101522027=            END'
      '1101522028=        END'
      '1101522029=      END'
      '1101522030='
      
        '1101522031=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1101522032=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1101522033=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1101522034=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1101522035=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1101522036=          UPDATE G_DISCONT_CARD D'
      
        '1101522037=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1101522038=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1101522039=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1101522040=          RETURNING'
      '1101522041=            D.SUMM_ALL'
      '1101522042=          INTO'
      '1101522043=            :CLIENT_SUMM_ALL_;'
      '1101522044='
      '1101522045=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1101522046=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1101522047=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1101522048=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1101522049=          ORDER BY G.SUMM_FROM'
      '1101522050=          ROWS 1 TO 1'
      '1101522051=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1101522052='
      '1101522053=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1101522054=            UPDATE G_CLIENT G'
      '1101522055=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1101522056=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1101522057=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1101522058='
      '1101522059=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1101522060=            UPDATE G_DISCONT_CARD D'
      '1101522061=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1101522062=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1101522063=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1101522064=      END'
      '1101522065='
      '1101522066=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1101522067=      PNT_ = '#39'07'#39';'
      
        '1101522068=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN ' +
        'BEGIN'
      '1101522069=        SELECT S.S_VALUE'
      '1101522070=          FROM SYSTEM_SETUP S'
      '1101522071=         WHERE S.SYSTEM_SETUP = 4'
      '1101522072=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101522073='
      '1101522074=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101522075=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101522076=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101522077='
      
        '1101522078=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1101522079=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1101522080=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1101522081='
      '1101522082=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101522083=        ELSE'
      
        '1101522084=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1101522085='
      '1101522086=        KASSA_ = NULL;'
      '1101522087=        SELECT K.KASSA, K.SUMM'
      '1101522088=        FROM KASSA K'
      '1101522089=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1101522090=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101522091=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101522092=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1101522093=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1101522094='
      '1101522095=        IF (KASSA_ IS NULL) THEN'
      
        '1101522096=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101522097=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101522098=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101522099=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101522100=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1101522101=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1101522102=                                          NULL,     -' +
        '-:SKLAD_,'
      '1101522103=                                          1,'
      '1101522104=                                          :G_TOCHKA_,'
      
        '1101522105=                                          :G_OFFICIAL' +
        '_'
      
        '1101522106=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101522107=        ELSE'
      '1101522108=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '1101522109=                                          1,     -- A' +
        'CTION_'
      
        '1101522110=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101522111=                                          :SALES_COMM' +
        '_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '1101522112=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101522113=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      '1101522114=                                          NULL,'
      '1101522115=                                          NULL,'
      
        '1101522116=                                          :PAYMENT_TY' +
        'PE_,'
      
        '1101522117=                                          :G_OFFICIAL' +
        '_'
      
        '1101522118=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1101522119='
      '1101522120=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101522121=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101522122=          EXIT;'
      '1101522123=        END'
      '1101522124=      END'
      '1101522125='
      '1101522126=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101522127=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101522128=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101522129=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1);'
      '1101522130=  END'
      '1101522131=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101522132=  ----------------------------------------'
      '1101522133=  ----------------------------------------'
      '1101522134=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101522135=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '1101522136=      PNT_ = '#39'25'#39';'
      
        '1101522137=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1101522138=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1101522139=      RETURNING ZAKAZ_REAL_PARENT'
      '1101522140=      INTO :ZAKAZ_REAL_PARENT_;'
      '1101522141='
      
        '1101522142=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1101522143=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101522144=          INTO :G_PRODUCT,'
