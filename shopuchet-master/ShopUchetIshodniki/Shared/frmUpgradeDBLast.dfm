      '110621370=             NOTE,'
      '110621371=             NDS,'
      '110621372=             NDS_SUMM,'
      '110621373=             IS_LAST,'
      '110621374=             IS_VOZVRAT,'
      '110621375=             G_TOCHKA'
      '110621376=            ) VALUES ('
      '110621377=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '110621378=             :ZAKAZ_,'
      '110621379=             :Z_DATE_,'
      '110621380=             :G_TOCHKA_,'
      '110621381=             :G_PRODUCT_,'
      '110621382=             :Z_AMOUNT_,'
      '110621383=             :PRICE_,'
      '110621384=             :SUMMM_,'
      '110621385=             :G_PAYMENT_TYPE_,'
      '110621386=             :OSNOVANIE_,'
      '110621387=             :NOTE_,'
      '110621388=             0,  --:RNDS_,'
      '110621389=             0,  --:RNDS_SUMM_,'
      
        '110621390=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048 +
        ' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050 +
        #1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057 +
        #1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '110621391=             3,  --:IS_VOZVRAT_,'
      '110621392=             :G_CLIENT_'
      '110621393=            );'
      '110621394='
      
        '110621395=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110621396=            PNT_ = '#39'023'#39';'
      '110621397=            UPDATE LT_SKLAD_PRODUCT L'
      '110621398=               SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '110621399=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621400=               AND L.G_TOCHKA = :G_CLIENT_;'
      '110621401='
      '110621402=            IF (ROW_COUNT = 0) THEN'
      
        '110621403=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD' +
        '_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110621404=          END'
      '110621405=      END'
      '110621406=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '110621407=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '110621408=      ELSE BEGIN'
      
        '110621409=          --------------------------------------------' +
        '-----------------'
      
        '110621410=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071 +
        ' '#1055#1056#1048#1061#1054#1044#1040
      '110621411=          PNT_ = '#39'025'#39';'
      '110621412=          FOR SELECT SKLAD,'
      '110621413=                     AMOUNT,'
      '110621414=                     G_PRODUCT'
      '110621415=                FROM SKLAD S'
      '110621416=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '110621417=                 AND NOT EXISTS (SELECT 1'
      
        '110621418=                                   FROM ZAKAZ_DETAILS_' +
        'TMP T'
      
        '110621419=                                  WHERE T.ZAKAZ_DETAIL' +
        'S = S.SKLAD)'
      '110621420=          INTO :SKLAD_,'
      '110621421=               :Z_AMOUNT_,'
      '110621422=               :G_PRODUCT_'
      '110621423=          DO BEGIN'
      
        '110621424=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110621425=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621426=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110621427=              EXIT;'
      '110621428=            END'
      '110621429=          END'
      '110621430='
      '110621431=          PNT_ = '#39'030'#39';'
      '110621432=          FOR SELECT S.ZAKAZ_DETAILS,'
      '110621433=                     S.G_PRODUCT,'
      '110621434=                     S.AMOUNT,'
      '110621435=                     S.PRICE,'
      '110621436=                     S.SUMM,'
      '110621437=                     T.SKLAD,'
      '110621438=                     T.AMOUNT,'
      '110621439=                     T.IS_LAST,'
      '110621440=                     T.DATE_RECEIPT'
      
        '110621441=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER JO' +
        'IN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE' +
        ' SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '110621442=                INTO :ZAKAZ_DETAILS_,'
      '110621443=                     :G_PRODUCT_,'
      '110621444=                     :Z_AMOUNT_,'
      '110621445=                     :PRICE_,'
      '110621446=                     :SUMMM_,'
      '110621447=                     :SKLAD_OLD_,'
      '110621448=                     :AMOUNT_OLD_,'
      '110621449=                     :IS_THIS_LAST_,'
      '110621450=                     :DATE_RECEIPT_OLD_'
      '110621451=          DO BEGIN'
      
        '110621452=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067 +
        #1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110621453=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '110621454=                INSERT INTO SKLAD (SKLAD, SKLAD_PARENT' +
        ', DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYM' +
        'ENT_TYPE, NDS, NDS_SUMM,'
      
        '110621455=                                  IS_LAST, NOTE, OSNOV' +
        'ANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '110621456=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :Z' +
        'AKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, :' +
        'SUMMM_, 1, 0, 0,'
      
        '110621457=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047 +
        #1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '110621458=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_CL' +
        'IENT_'
      '110621459=                       )'
      '110621460=                RETURNING'
      '110621461=                  SKLAD'
      '110621462=                INTO'
      '110621463=                  :SKLAD_;'
      '110621464='
      
        '110621465=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055 +
        #1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110621466=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110621467=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT' +
        '_'
      '110621468=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621469=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110621470='
      
        '110621471=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055 +
        #1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110621472=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110621473=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT' +
        '_'
      '110621474=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621475=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '110621476='
      '110621477=                IF (ROW_COUNT = 0) THEN'
      
        '110621478=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_S' +
        'KLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110621479='
      
        '110621480=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054#1053 +
        ' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049 +
        #1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110621481=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053 +
        #1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051 +
        #1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '110621482=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SK' +
        'LAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '110621483=                SELECT MAX(SK.DATE_RECEIPT)'
      '110621484=                  FROM SKLAD SK'
      '110621485=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110621486=                   AND SK.IS_LAST = 1'
      '110621487=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '110621488=                  INTO :DATE_LAST_;'
      '110621489='
      
        '110621490=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ >' +
        '= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058 +
        #1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110621491=                  UPDATE SKLAD SK'
      '110621492=                     SET SK.IS_LAST = 0'
      '110621493=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110621494=                     AND SK.IS_LAST = 1'
      '110621495=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '110621496='
      '110621497=                  UPDATE SKLAD SK'
      '110621498=                     SET SK.IS_LAST = 1'
      '110621499=                   WHERE SK.SKLAD = :SKLAD_;'
      '110621500=                END'
      '110621501='
      
        '110621502=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041 +
        #1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110621503=            END ELSE BEGIN'
      '110621504=                UPDATE SKLAD S'
      '110621505=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '110621506=                       S.AMOUNT   = :Z_AMOUNT_,'
      '110621507=                       S.PRICE    = :PRICE_,'
      '110621508=                       S.SUMM     = :SUMMM_,'
      '110621509=                       S.OSNOVANIE = :OSNOVANIE_,'
      '110621510=                       S.NOTE      = :NOTE_'
      '110621511=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '110621512='
      '110621513='
      
        '110621514=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN BEGI' +
        'N'
      
        '110621515=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110621516=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110621517=                     SET L.AMOUNT = L.AMOUNT + (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110621518=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621519=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110621520='
      
        '110621521=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110621522=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110621523=                     SET L.AMOUNT = L.AMOUNT - (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110621524=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621525=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110621526='
      
        '110621527=                END ELSE if (Z_AMOUNT_ > AMOUNT_OLD_) ' +
        'THEN BEGIN'
      
        '110621528=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110621529=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110621530=                     SET L.AMOUNT = L.AMOUNT - (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110621531=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621532=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110621533='
      
        '110621534=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110621535=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110621536=                     SET L.AMOUNT = L.AMOUNT + (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110621537=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110621538=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110621539=                END'
      '110621540='
      
        '110621541=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059 +
        ' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054 +
        ' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '110621542=                IF ((Z_DATE_ > DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0)) THEN BEGIN'
      '110621543=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110621544=                      FROM SKLAD SK'
      '110621545=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110621546=                       AND SK.IS_LAST = 1'
      '110621547=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110621548=                      INTO :DATE_LAST_;'
      '110621549='
      
        '110621550=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044 +
        #1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110621551=                      UPDATE SKLAD SK'
      '110621552=                         SET SK.IS_LAST = 0'
      
        '110621553=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      '110621554=                         AND SK.IS_LAST = 1'
      '110621555=                         AND SK.G_TOCHKA = :G_CLIENT_;'
      '110621556='
      '110621557=                      UPDATE SKLAD SK'
      '110621558=                         SET SK.IS_LAST = 1'
      
        '110621559=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110621560=                    END'
      '110621561=                END'
      '110621562='
      
        '110621563=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059 +
        ' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055 +
        #1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '110621564=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 1)) THEN BEGIN'
      '110621565=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110621566=                      FROM SKLAD SK'
      '110621567=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110621568=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '110621569=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110621570=                       AND SK.is_vozvrat IN (0,3,4)'
      '110621571=                      INTO :DATE_LAST_;'
      '110621572='
      
        '110621573=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110621574=                      UPDATE SKLAD SK'
      '110621575=                         SET SK.IS_LAST = 0'
      
        '110621576=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110621577='
      '110621578=                       UPDATE SKLAD SK'
      '110621579=                         SET SK.IS_LAST = 1'
      
        '110621580=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      
        '110621581=                         AND SK.SKLAD = (SELECT MAX(SS' +
        '.SKLAD)'
      
        '110621582=                                           FROM SKLAD ' +
        'SS'
      
        '110621583=                                          WHERE SS.G_P' +
        'RODUCT = SK.G_PRODUCT'
      
        '110621584=                                            AND SS.DAT' +
        'E_RECEIPT = :DATE_LAST_'
      
        '110621585=                                            AND SS.G_T' +
        'OCHKA = :G_CLIENT_'
      
        '110621586=                                            AND SS.is_' +
        'vozvrat IN (0,3,4));'
      '110621587=                    END'
      '110621588=                END'
      '110621589=            END'
      '110621590=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '110621591=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '110621592='
      '110621593=      UPDATE SKLAD_PARENT'
      '110621594=      SET'
      
        '110621595=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110621596=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      
        '110621597=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),    ' +
        '   -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110621598=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110621599=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110621600=       SUMM      = :SUMM_,'
      '110621601=       SUMM_FACT = :SUMM_FACT_'
      '110621602=      WHERE SKLAD  = :ZAKAZ_;'
      '110621603=  END'
      '110621604='
      '110621605=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110621606=END'
      '110621607=;'
      
        '110621608=UPDATE SYSTEM_SETUP SET S_VALUE = 11062 WHERE SYSTEM_S' +
