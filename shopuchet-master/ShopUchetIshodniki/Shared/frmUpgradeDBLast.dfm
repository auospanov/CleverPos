      '1102122012=        SELECT 8 COL,'
      '1102122013=               '#39'  '#1057#1059#1052#1052#1040' '#1042' '#1050#1040#1057#1057#1045#39' STR,'
      '1102122014=               '#39#39' AMOUNT,'
      '1102122015=               '#39'='#39'||:OUT_SUMM_ SUMM'
      '1102122016=          FROM RDB$DATABASE'
      '1102122017=        UNION'
      '1102122018=        SELECT 9 COL,'
      '1102122019=               '#39#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1045#39' STR,'
      '1102122020=               '#39#39' AMOUNT,'
      '1102122021=               '#39#39' SUMM'
      '1102122022=          FROM RDB$DATABASE'
      '1102122023=        UNION'
      '1102122024=        SELECT 10 COL,'
      '1102122025=               '#39'  '#1055#1056#1054#1044#1040#1046#1040#39' STR,'
      '1102122026=               '#39'*'#39'||:PRODAZHI_NONCASH_AMOUNT_ AMOUNT,'
      '1102122027=               '#39'='#39'||:PRODAZHI_NONCASH_SUMM_ SUMM'
      '1102122028=          FROM RDB$DATABASE'
      '1102122029=        UNION'
      '1102122030=        SELECT 11 COL,'
      '1102122031=               '#39'  '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      '1102122032=               '#39'*'#39'||:VOZVRAT_NONCASH_AMOUNT_ AMOUNT,'
      '1102122033=               '#39'='#39'||:VOZVRAT_NONCASH_SUMM_ SUMM'
      '1102122034=          FROM RDB$DATABASE'
      '1102122035=        UNION'
      '1102122036=        SELECT 12 COL,'
      '1102122037=               '#39#1048#1058#1054#1043#1054' '#1055#1056#1054#1044#1040#1046#1040#39' STR,'
      
        '1102122038=               '#39'*'#39'||(:PRODAZHI_CASH_AMOUNT_ + :PRODAZ' +
        'HI_NONCASH_AMOUNT_) AMOUNT,'
      
        '1102122039=               '#39'='#39'||(:PRODAZHI_CASH_SUMM_ + :PRODAZHI' +
        '_NONCASH_SUMM_) SUMM'
      '1102122040=          FROM RDB$DATABASE'
      '1102122041=        UNION'
