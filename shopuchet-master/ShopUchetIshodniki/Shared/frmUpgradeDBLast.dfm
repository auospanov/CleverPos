        ' = '#39#39'SYSDBA'#39#39' AND L.DAT IS NULL AND L.IS_TRANSFERED = 0);'#39'||CRLF' +
        '||'
      
        '110209813=          '#39'  IF (NEW.ACTION_DATE <> OLD.ACTION_DATE) T' +
        'HEN'#39'||CRLF||'
      
        '110209814=          '#39'    INSERT INTO LOGS(ID,SQLSTMT,TTABLE,USR)' +
        #39'||CRLF||'
      
        '110209815=          '#39'    SELECT GEN_ID(GEN_LOGS,1), '#39#39'KASSA_BEZN' +
        'AL:'#39#39'||OLD.ACTION_DATE, '#39#39'KASSA_BEZNAL'#39#39', '#39#39'SYSDBA'#39#39#39'||CRLF||'
      
        '110209816=          '#39'    FROM RDB$DATABASE WHERE NOT EXISTS (SEL' +
        'ECT 1 FROM LOGS L WHERE L.SQLSTMT = '#39#39'KASSA_BEZNAL:'#39#39'||OLD.ACTIO' +
        'N_DATE AND'#39'||CRLF||'
      
        '110209817=          '#39'                                        L.U' +
        'SR = '#39#39'SYSDBA'#39#39' AND L.DAT IS NULL AND L.IS_TRANSFERED = 0);'#39'||CR' +
        'LF;'
      '110209818='
      '110209819=    TRGU = TRGU||'#39'END'#39';'
      '110209820='
      '110209821=    SELECT COUNT(*)'
      '110209822=      FROM RDB$TRIGGERS'
      '110209823=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGD'#39
      '110209824=      INTO :ANZ;'
      '110209825=    IF (ANZ>0) THEN'
      '110209826=      TRGDX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGD'#39';'
      '110209827=    ELSE'
      '110209828=      TRGDX='#39#39';'
      
        '110209829=    TRGD='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGD FOR '#39'||TN||'#39' AC' +
        'TIVE AFTER DELETE POSITION 255 AS '#39'||CRLF||'
      
        '110209830=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEG' +
        'MENT SIZE 80;'#39'||CRLF||'
      '110209831=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '110209832=         '#39'BEGIN'#39'||CRLF||'
      
        '110209833=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '110209834=         '#39'  SQLSTMT='#39#39'DELETE FROM '#39'||TN||'#39' WHERE '#39'||ID' +
        '_COLUMN||'#39'='#39#39'||OLD.'#39'||ID_COLUMN||'#39'||'#39#39';'#39#39';'#39'||CRLF||'
      '110209835=         '#39'  ID=GEN_ID(GEN_LOGS,1);'#39'||CRLF||'
      
        '110209836=         '#39'  INSERT INTO LOGS(ID,SQLSTMT,TTABLE,USR) VA' +
        'LUES (:ID, :SQLSTMT, '#39#39#39'||TN||'#39#39#39', '#39#39'SYSDBA'#39#39');'#39'||CRLF;'
      '110209837='
      '110209838=    IF (TN = '#39'KASSA'#39') THEN'
      
        '110209839=        TRGD = TRGD||CRLF||'#39'  INSERT INTO LOGS(ID,SQLS' +
        'TMT,TTABLE,USR)'#39'||CRLF||'
      
        '110209840=          '#39'  SELECT GEN_ID(GEN_LOGS,1), '#39#39'KASSA:'#39#39'||OL' +
        'D.G_TOCHKA||'#39#39'~'#39#39'||OLD.ACTION_DATE, '#39#39'KASSA'#39#39', '#39#39'SYSDBA'#39#39#39'||CRLF' +
        '||'
      
        '110209841=          '#39'  FROM RDB$DATABASE WHERE NOT EXISTS (SELEC' +
        'T 1 FROM LOGS L WHERE L.SQLSTMT = '#39#39'KASSA:'#39#39'||OLD.G_TOCHKA||'#39#39'~'#39 +
        #39'||OLD.ACTION_DATE AND'#39'||CRLF||'
      
        '110209842=          '#39'                                      L.USR' +
        ' = '#39#39'SYSDBA'#39#39' AND L.DAT IS NULL AND L.IS_TRANSFERED = 0);'#39'||CRLF' +
        ';'
      '110209843='
      '110209844=    ELSE IF (TN = '#39'KASSA_BEZNAL'#39') THEN'
      
        '110209845=        TRGD = TRGD||CRLF||'#39'  INSERT INTO LOGS(ID,SQLS' +
        'TMT,TTABLE,USR)'#39'||CRLF||'
      
        '110209846=          '#39'  SELECT GEN_ID(GEN_LOGS,1), '#39#39'KASSA_BEZNAL' +
        ':'#39#39'||OLD.ACTION_DATE, '#39#39'KASSA_BEZNAL'#39#39', '#39#39'SYSDBA'#39#39#39'||CRLF||'
      
        '110209847=          '#39'  FROM RDB$DATABASE WHERE NOT EXISTS (SELEC' +
        'T 1 FROM LOGS L WHERE L.SQLSTMT = '#39#39'KASSA_BEZNAL:'#39#39'||OLD.ACTION_' +
        'DATE AND'#39'||CRLF||'
      
        '110209848=          '#39'                                      L.USR' +
        ' = '#39#39'SYSDBA'#39#39' AND L.DAT IS NULL AND L.IS_TRANSFERED = 0);'#39'||CRLF' +
        ';'
      '110209849='
      '110209850=    TRGD = TRGD||'#39'END'#39';'
      '110209851='
      '110209852=    TN_ALT=TN;'
      '110209853=  END'
      '110209854=  IF (TRGIX<>'#39#39') THEN'
      '110209855=    EXECUTE STATEMENT TRGIX;'
      '110209856='
      '110209857=  EXECUTE STATEMENT TRGI;'
      '110209858=  IF (TRGUX<>'#39#39') THEN'
      '110209859=    EXECUTE STATEMENT TRGUX;'
      '110209860='
      '110209861=  EXECUTE STATEMENT TRGU;'
      '110209862='
      '110209863=  IF (TRGDX<>'#39#39') THEN'
      '110209864=    EXECUTE STATEMENT TRGDX;'
      '110209865=  EXECUTE STATEMENT TRGD;'
      '110209866='
      '110209867=  -- BLOB-'#1055#1054#1051#1071' '#1054#1058#1044#1045#1051#1068#1053#1067#1045' '#1058#1056#1048#1043#1043#1045#1056#1067
      '110209868=  TN_ALT    = '#39#39';'
      '110209869=  ID_COLUMN = '#39#39';'
      
        '110209870=  FOR SELECT TRIM(RDB$RELATION_FIELDS.RDB$RELATION_NAM' +
        'E),'
      '110209871=             TRIM(RDB$RELATION_FIELDS.RDB$FIELD_NAME)'
      
        '110209872=        FROM RDB$RELATION_FIELDS JOIN RDB$FIELDS ON RD' +
        'B$RELATION_FIELDS.RDB$FIELD_SOURCE=RDB$FIELDS.RDB$FIELD_NAME'
      
        '110209873=       WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME NOT' +
        ' CONTAINING '#39'$'#39
      '110209874=         AND RDB$FIELDS.RDB$FIELD_TYPE = 261'
      '110209875=         AND RDB$FIELDS.RDB$FIELD_SUB_TYPE = 0'
      
        '110209876=         AND RDB$RELATION_FIELDS.RDB$RELATION_NAME NOT' +
        ' IN ('#39'CUR_PARAMS'#39', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_S' +
        'IZES'#39','
      
        '110209877=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110209878=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110209879=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110209880=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110209881=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110209882=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_TOCH' +
        'KA'#39', '#39'G_PRODUCT_FILL'#39','
      
        '110209883=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39')'
      '110209884=        INTO :TN,'
      '110209885=             :FN'
      '110209886=  DO BEGIN'
      '110209887=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN BEGIN'
      '110209888=      SELECT TRIM(F.RDB$FIELD_NAME)'
      '110209889=        FROM RDB$RELATION_FIELDS F'
      '110209890=       WHERE F.RDB$RELATION_NAME = :TN'
      '110209891=         AND F.RDB$FIELD_POSITION = 0'
      '110209892=        INTO :ID_COLUMN;'
      '110209893=    END'
      '110209894='
      
        '110209895=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110209896=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '110209897=        '#39'AS '#39'||CRLF||'
      '110209898=        '#39'BEGIN '#39'||CRLF||'
      
        '110209899=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      '110209900=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF||'
      
        '110209901=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110209902=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110209903=        '#39'END;'#39';'
      '110209904=    EXECUTE STATEMENT :TRGI;'
      '110209905='
      
        '110209906=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110209907=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '110209908=        '#39'AS '#39'||CRLF||'
      '110209909=        '#39'BEGIN '#39'||CRLF||'
      
        '110209910=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '110209911=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRLF' +
        '||'
      
        '110209912=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110209913=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110209914=        '#39'END;'#39';'
      '110209915=    EXECUTE STATEMENT :TRGI;'
      '110209916='
      '110209917=    TN_ALT = TN;'
      '110209918=  END'
      '110209919=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '110209920=        FROM RDB$RELATIONS R'
      '110209921=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110209922=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '110209923=       ORDER BY R.RDB$RELATION_NAME'
      '110209924=        INTO :TN'
      '110209925=  DO BEGIN'
      '110209926=    TN=TRIM(TN);'
      '110209927=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '110209928='
      '110209929=    EXECUTE STATEMENT :SQLSTMT;'
      '110209930=  END'
      '110209931=END'
      '110209932=;'
      '110209933='
      '110209934=ALTER PROCEDURE SYNC_DOWNLOAD'
      '110209935=RETURNS ('
      '110209936=  ERR_CODE INTEGER,'
      '110209937=  ERR_MSG VARCHAR(1024),'
      '110209938=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '110209939=AS'
      '110209940=/*'
      '110209941='#1060#1048#1053#1040#1051' 07.02.2019'
      '110209942=*/'
      '110209943=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '110209944=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
      '110209945=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '110209946=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '110209947=DECLARE VARIABLE POS_ INTEGER = 0;'
      '110209948=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '110209949=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110209950=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '110209951=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGME' +
        'NT SIZE 80 = '#39#39';'
      
        '110209952=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110209953=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110209954=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      
        '110209955=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT;'
      
        '110209956=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT_RESERVE;'
      
        '110209957=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110209958=DECLARE VARIABLE ACTION_DATE_MIN_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE = CURRENT_DATE;'
      
        '110209959=DECLARE VARIABLE ACTION_DATE_MIN_OLD_ TYPE OF COLUMN K' +
        'ASSA.ACTION_DATE = CURRENT_DATE;'
      
        '110209960=DECLARE VARIABLE CREDIT_ TYPE OF COLUMN KASSA_STATE.CR' +
        'EDIT;'
      
        '110209961=DECLARE VARIABLE DEBET_ TYPE OF COLUMN KASSA_STATE.DEB' +
        'ET;'
      '110209962=DECLARE VARIABLE RECALC_STR_ VARCHAR(1024) = '#39#39';'
      '110209963=DECLARE VARIABLE STR_ VARCHAR(1024);'
      '110209964=BEGIN'
      '110209965=  ERR_CODE = 0;'
      '110209966=  ERR_MSG = '#39#39';'
      '110209967=  ERR_BODY = '#39#39';'
      '110209968='
      '110209969=  FOR SELECT L.ID,'
      '110209970=             L.SQLSTMT'
      '110209971=        FROM LOGS L'
      '110209972=       WHERE L.USR = '#39'REPLICAT'#39
      '110209973=         AND L.DAT IS NULL'
      '110209974=         AND L.IS_TRANSFERED = 0'
      
        '110209975=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        ') = 0'
      '110209976=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) = 0'
      
        '110209977=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) = ' +
        '0'
      
        '110209978=         AND POSITION('#39'EXECUTE PROCEDURE K_RECALC_KASS' +
        'A'#39' IN L.SQLSTMT) = 0'
      '110209979=        ORDER BY L.ID_ORIGINAL'
      '110209980=        INTO :LOGS_ID_,'
      '110209981=             :SQL_'
      '110209982=  DO BEGIN'
      '110209983=    BEGIN'
      '110209984=        SQLCODE_ = 0;'
      '110209985='
      
        '110209986=        --'#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054' ' +
        #1053#1048#1046#1045' '#1054#1058#1044#1045#1051#1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048#1042 +
        ' '#1057#1054#1041#1048#1056#1040#1058#1068'?'
      '110209987=        /*'
      
        '110209988=        -- '#1057#1054#1041#1048#1056#1040#1070' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057 +
        #1063#1048#1058#1067#1042#1040#1058#1068
      
        '110209989=        IF (POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN SQL_) > 0)' +
        ' THEN BEGIN'
      
        '110209990=          ID_STR_ = SUBSTRING(SQL_ FROM 18 FOR CHAR_LE' +
        'NGTH(SQL_) - 17);'
      '110209991='
      
        '110209992=          IF (POSITION(ID_STR_ IN PRODUCT_ID_ARR_) = 0' +
        ') THEN'
      
        '110209993=            PRODUCT_ID_ARR_ = PRODUCT_ID_ARR_ || '#39'~'#39' |' +
        '| ID_STR_;'
      '110209994=        END'
      '110209995=        ELSE BEGIN'
      '110209996=            EXECUTE STATEMENT SQL_;'
      '110209997='
      
        '110209998=            IF (POSITION('#39'EXECUTE PROCEDURE K_RECALC_K' +
        'ASSA'#39' IN SQL_) > 0) THEN BEGIN'
      '110209999=              IF (ERR_CODE <> 0) THEN BEGIN'
      '1102091000=                SQLCODE_ = ERR_CODE;'
      '1102091001=                IF (ERR_BODY = '#39#39') THEN'
      
        '1102091002=                  ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084 +
        #1077#1085#1077#1085#1080#1081'.'#39';'
      '1102091003=                ERR_BODY = ERR_BODY ||'#39
      
        '1102091004=                '#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||ERR_CODE||'#39'. '#1044 +
        #1077#1090#1072#1083#1080': '#39'||ERR_MSG;'
      '1102091005='
      '1102091006=                ERR_CODE = 0;'
      '1102091007=                ERR_MSG = '#39#39';'
      '1102091008=              END'
      '1102091009=            END'
      '1102091010=        END*/'
      '1102091011=        EXECUTE STATEMENT SQL_;'
      '1102091012='
      
        '1102091013=        /* 22.10.2021 - '#1069#1058#1054' '#1058#1045#1055#1045#1056#1068' '#1058#1054#1046#1045' '#1054#1058#1044#1045#1051#1068#1053#1067#1052' '#1062#1048#1050 +
        #1051#1054#1052' '#1053#1048#1046#1045
      
        '1102091014=        IF (POSITION('#39'EXECUTE PROCEDURE K_RECALC_KASS' +
        'A'#39' IN SQL_) > 0) THEN BEGIN'
      '1102091015=          IF (ERR_CODE <> 0) THEN BEGIN'
      '1102091016=            SQLCODE_ = ERR_CODE;'
      '1102091017=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102091018=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102091019=            ERR_BODY = ERR_BODY ||'#39
      
        '1102091020=            '#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||ERR_CODE||'#39'. '#1044#1077#1090#1072#1083 +
        #1080': '#39'||ERR_MSG;'
      '1102091021='
      '1102091022=            ERR_CODE = 0;'
      '1102091023=            ERR_MSG = '#39#39';'
      '1102091024=          END'
      '1102091025=        END'
      '1102091026=        */'
      '1102091027='
      '1102091028=    WHEN ANY DO'
      '1102091029=        BEGIN'
      '1102091030=            SQLCODE_ = GDSCODE;'
      '1102091031=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102091032=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102091033=            ERR_BODY = ERR_BODY ||'#39
      '1102091034='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102091035=        END'
      '1102091036=    END'
      '1102091037='
      
        '1102091038=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102091039=    UPDATE LOGS L'
      
        '1102091040=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102091041=           L.ERR_CODE = :SQLCODE_'
      '1102091042=     WHERE L.ID = :LOGS_ID_;'
      '1102091043=  END'
      '1102091044='
      '1102091045=  POS_ = 0;'
      '1102091046=  FOR SELECT L.ID,'
      '1102091047=             L.SQLSTMT,'
      '1102091048=             L.DAT,'
      '1102091049=             L.RR'
      '1102091050=        FROM LOGS L'
      '1102091051=       WHERE L.USR = '#39'REPLICAT'#39
      '1102091052=         AND L.DAT IS NOT NULL'
      '1102091053=         AND L.IS_TRANSFERED = 0'
      '1102091054=        ORDER BY L.ID_ORIGINAL'
      '1102091055=        INTO :LOGS_ID_,'
      '1102091056=             :SQL_,'
      '1102091057=             :DAT_,'
      '1102091058=             :IDX_'
      '1102091059=  DO BEGIN'
      '1102091060=    POS_ = POSITION('#39'.'#39', SQL_);'
      '1102091061=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '1102091062=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR P' +
        'OS_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_' +
        ' - 1)||'#39' = :DAT_'#39'||'
      
        '1102091063=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ +' +
        ' 1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '1102091064='
      '1102091065=    BEGIN'
      '1102091066=        SQLCODE_ = 0;'
      '1102091067=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '1102091068=    WHEN ANY DO'
      '1102091069=        BEGIN'
      '1102091070=            SQLCODE_ = GDSCODE;'
      '1102091071=            ERR_BODY = ERR_BODY ||'#39
      '1102091072='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102091073=        END'
      '1102091074=    END'
      '1102091075='
      
        '1102091076=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102091077='
      '1102091078=    UPDATE LOGS L'
      
        '1102091079=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102091080=           L.ERR_CODE = :SQLCODE_'
      '1102091081=     WHERE L.ID = :LOGS_ID_;'
      '1102091082=  END'
      '1102091083='
      
        '1102091084=  --=================================================' +
        '===================='
      '1102091085=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      
        '1102091086=  -- '#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054' '#1054#1058#1044#1045 +
        #1051#1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048#1042' '#1057#1054#1041#1048#1056#1040#1058#1068 +
        '?'
      
        '1102091087=  --=================================================' +
        '===================='
      '1102091088=  FOR SELECT MAX(L.ID) ID,'
      '1102091089=             L.SQLSTMT'
      '1102091090=        FROM LOGS L'
      '1102091091=       WHERE L.USR = '#39'REPLICAT'#39
      '1102091092=         AND L.DAT IS NULL'
      '1102091093=         AND L.IS_TRANSFERED = 0'
      
        '1102091094=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTM' +
        'T) > 0'
      '1102091095=       GROUP BY L.SQLSTMT'
      '1102091096=        INTO :LOGS_ID_,'
      '1102091097=             :SQL_'
      '1102091098=  DO BEGIN'
      '1102091099=    SQLCODE_ = 0;'
      '1102091100=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '1102091101=    POS1_ = POSITION('#39'-'#39' IN SQL_);'
      '1102091102='
      
        '1102091103=    G_PRODUCT_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FO' +
        'R POS1_ - POS_ - 1) AS BIGINT);'
      
        '1102091104=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 FO' +
        'R CHAR_LENGTH(SQL_)) AS BIGINT);'
      '1102091105='
      '1102091106=    BEGIN'
      '1102091107=        select ('
      '1102091108=               -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102091109=               (select COALESCE(sum(s.amount), 0) fro' +
        'm sklad s, sklad_parent sp'
      '1102091110=                where sp.SKLAD = s.SKLAD_PARENT'
      '1102091111=                  and sp.G_TOCHKA = :G_TOCHKA_'
      '1102091112=                  and s.g_product = :G_PRODUCT_'
      
        '1102091113=                  and sp.IS_EXPECTED = 0)   -- '#1085#1077' '#1073#1077#1088 +
        #1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102091114='
      '1102091115=               -'
      '1102091116=               -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102091117=               (select COALESCE(sum(zr.AMOUNT_ALL), 0' +
        ') from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102091118=                where zr.g_product = :G_PRODUCT_ and ' +
        'Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102091119=                and zr.ZAKAZ_REAL_PARENT = zrp.ZAKAZ_' +
        'REAL_PARENT)'
      '1102091120='
      '1102091121=               -'
      '1102091122=               -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102091123=               (select COALESCE(sum(zd.amount), 0) fr' +
        'om zakaz_details zd, zakaz z'
      
        '1102091124=                where zd.g_product = :G_PRODUCT_ and ' +
        'Z.G_TOCHKA = :G_TOCHKA_'
      '1102091125=                and zd.zakaz = z.zakaz'
      
        '1102091126=                and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099#1095#1080#1090 +
        #1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076#1077#1090' ' +
        #1085#1080#1078#1077
      
        '1102091127=                and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074 +
        #1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072 +
        #1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102091128=                and not (z.IS_SPISANIE = 0 and z.NOT_' +
        'MINUS_OSTATOK = 1)'
      '1102091129=               )'
      '1102091130='
      '1102091131=               -'
      '1102091132=               -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102091133=               (select COALESCE(sum(s.amount), 0) fro' +
        'm sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = 3'
      '1102091134=                and S.g_client = :G_TOCHKA_)'
      '1102091135='
      '1102091136=               -'
      '1102091137=               -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102091138=               (select COALESCE(sum(od.amount), 0) fr' +
        'om other_details od, other o'
      
        '1102091139=                where od.g_product = :G_PRODUCT_ and ' +
        'o.G_TOCHKA = :G_TOCHKA_'
      '1102091140=                and od.other = o.other)'
      '1102091141=               ) amount,'
      '1102091142='
      
        '1102091143=               (SELECT COALESCE(sum(ZD.amount), 0) FR' +
        'OM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102091144=                 WHERE Z.G_TOCHKA = :G_TOCHKA_ AND Z.' +
        'IS_RESERVE = 1'
      
        '1102091145=                   AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G_PR' +
        'ODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102091146=        from rdb$database'
      '1102091147=        INTO :AMOUNT_,'
      '1102091148=             :AMOUNT_RESERVE_;'
      '1102091149='
      '1102091150=        MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102091151=        USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G_TO' +
        'CHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102091152=        ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_TOCH' +
        'KA = CD.G_TOCHKA)'
      '1102091153=        WHEN MATCHED THEN'
      
        '1102091154=            UPDATE SET LT.AMOUNT = :AMOUNT_, LT.AMOUN' +
        'T_RESERVE = :AMOUNT_RESERVE_'
      '1102091155=        WHEN NOT MATCHED THEN'
      
        '1102091156=            INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, AMOU' +
        'NT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102091157=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,  1),' +
        ' :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102091158=    WHEN ANY DO'
      '1102091159=        BEGIN'
      '1102091160=            SQLCODE_ = GDSCODE;'
      '1102091161=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102091162=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102091163=            ERR_BODY = ERR_BODY ||'#39
      
        '1102091164=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102091165=        END'
      '1102091166=    END'
      '1102091167='
      '1102091168=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '1102091169=    UPDATE LOGS L'
      
        '1102091170=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102091171=           L.ERR_CODE = :SQLCODE_'
      '1102091172=     WHERE L.SQLSTMT = :SQL_'
      '1102091173=       AND L.USR = '#39'REPLICAT'#39
      '1102091174=       AND L.DAT IS NULL'
      '1102091175=       AND L.IS_TRANSFERED = 0;'
      '1102091176=  END'
      '1102091177='
      
        '1102091178=  --=================================================' +
        '===================='
      '1102091179=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1050#1040#1057#1057#1067
      
        '1102091180=  -- '#1058#1059#1058' '#1053#1045#1052#1053#1054#1043#1054' '#1053#1040#1042#1054#1056#1054#1063#1045#1053#1053#1054' '#1055#1054#1051#1059#1063#1048#1051#1054#1057#1068', '#1052#1040#1057#1057#1048#1042#1054#1042' '#1058#1059#1058 +
        ' '#1053#1045#1058', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1057#1053#1054#1042#1040' '#1042#1057#1045' '#1063#1045#1056#1045#1047' G_TOCHKA_OLD '#1044#1045#1051#1040#1058#1068
      
        '1102091181=  --=================================================' +
        '===================='
      '1102091182=  G_TOCHKA_OLD_ = 0;'
      '1102091183=  FOR SELECT L.ID,'
      '1102091184=             L.SQLSTMT'
      '1102091185=        FROM LOGS L'
      '1102091186=       WHERE L.USR = '#39'REPLICAT'#39
      '1102091187=         AND L.DAT IS NULL'
      '1102091188=         AND L.IS_TRANSFERED = 0'
      '1102091189=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) > 0'
      '1102091190=     ORDER BY L.SQLSTMT'
      '1102091191=        INTO :LOGS_ID_,'
      '1102091192=             :SQL_'
      '1102091193=  DO BEGIN'
      '1102091194=    SQLCODE_ = 0;'
      '1102091195=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '1102091196=    POS1_ = POSITION('#39'~'#39' IN SQL_);'
      '1102091197='
      
        '1102091198=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR' +
        ' POS1_ - POS_ - 1) AS BIGINT);'
      
        '1102091199=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1' +
        ' FOR CHAR_LENGTH(SQL_)) AS DATE);'
      
        '1102091200=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACT' +
        'ION_DATE_);'
      '1102091201='
      '1102091202=    SELECT SUM(K.SUMM)'
      '1102091203=      FROM KASSA K'
      '1102091204=     WHERE K."ACTION" = 0'
      '1102091205=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102091206=       AND K.G_TOCHKA = :G_TOCHKA_'
      '1102091207=      INTO :CREDIT_;'
      '1102091208=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '1102091209='
      '1102091210=    SELECT SUM(K.SUMM)'
      '1102091211=      FROM KASSA K'
      '1102091212=     WHERE K."ACTION" = 1'
      '1102091213=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102091214=       AND K.G_TOCHKA = :G_TOCHKA_'
      '1102091215=      INTO :DEBET_;'
      '1102091216=    DEBET_ = COALESCE(DEBET_, 0);'
      '1102091217='
      '1102091218=    MERGE INTO KASSA_STATE c'
      
        '1102091219=    USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCHKA_' +
        ' AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE AND' +
        ' C.G_TOCHKA = CD.G_TOCHKA)'
      '1102091220=    WHEN MATCHED THEN'
      '1102091221=        UPDATE SET'
      '1102091222=            C.DEBET  = :DEBET_,'
      '1102091223=            C.CREDIT = :CREDIT_,'
      
        '1102091224=            C."OUTPUT" = C."INPUT" - :DEBET_ + :CREDI' +
        'T_'
      '1102091225=    WHEN NOT MATCHED THEN'
      
        '1102091226=        INSERT (KASSA_STATE, K_DATE, "INPUT", DEBET, ' +
        'CREDIT, "OUTPUT", G_TOCHKA)'
      '1102091227=        VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '1102091228=                :ACTION_DATE_,'
      
        '1102091229=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102091230=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102091231=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0),'
      '1102091232=                :DEBET_,'
      '1102091233=                :CREDIT_,'
      
        '1102091234=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102091235=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102091236=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0) - :DEBET_ + :CREDIT_,'
      '1102091237=               :G_TOCHKA_);'
      '1102091238='
      
        '1102091239=    IF (G_TOCHKA_OLD_ > 0 AND G_TOCHKA_OLD_ <> G_TOCH' +
        'KA_ AND ACTION_DATE_MIN_OLD_ < CURRENT_DATE) THEN BEGIN'
      
        '1102091240=       EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_' +
        'MIN_OLD_, :G_TOCHKA_OLD_, 0)'
      '1102091241=         RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102091242=    END'
      '1102091243='
      '1102091244=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '1102091245=    UPDATE LOGS L'
      
        '1102091246=       SET L.IS_TRANSFERED = DECODE(:ERR_CODE, 0, 1, ' +
        '-1),'
      '1102091247=           L.ERR_CODE = :ERR_CODE'
      '1102091248=     WHERE L.ID = :LOGS_ID_'
      '1102091249=       AND L.USR = '#39'REPLICAT'#39
      '1102091250=       AND L.DAT IS NULL'
      '1102091251=       AND L.IS_TRANSFERED = 0;'
      '1102091252='
      '1102091253=    G_TOCHKA_OLD_ = G_TOCHKA_;'
      '1102091254=    ACTION_DATE_MIN_OLD_ = ACTION_DATE_MIN_;'
      '1102091255=  END'
      '1102091256='
      
        '1102091257=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045 +
        #1058
      '1102091258=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '1102091259=      EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_M' +
        'IN_, :G_TOCHKA_, 0)'
      '1102091260=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102091261=  END'
      '1102091262='
      
        '1102091263=  --=================================================' +
        '===================='
      '1102091264=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071
      
        '1102091265=  --=================================================' +
        '===================='
      '1102091266=  ACTION_DATE_MIN_ = CURRENT_DATE;'
      '1102091267=  FOR SELECT L.ID,'
      '1102091268=             L.SQLSTMT'
      '1102091269=        FROM LOGS L'
      '1102091270=       WHERE L.USR = '#39'REPLICAT'#39
      '1102091271=         AND L.DAT IS NULL'
      '1102091272=         AND L.IS_TRANSFERED = 0'
      
        '1102091273=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) >' +
        ' 0'
      '1102091274=        INTO :LOGS_ID_,'
      '1102091275=             :SQL_'
      '1102091276=  DO BEGIN'
      '1102091277=    SQLCODE_ = 0;'
      '1102091278=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '1102091279='
      
        '1102091280=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1)' +
        ' AS DATE);'
      
        '1102091281=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACT' +
        'ION_DATE_);'
      '1102091282='
      '1102091283=    SELECT SUM(K.SUMM)'
      '1102091284=      FROM KASSA_BEZNAL K'
      '1102091285=     WHERE K."ACTION" = 0'
      '1102091286=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102091287=      INTO :CREDIT_;'
      '1102091288=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '1102091289='
      '1102091290=    SELECT SUM(K.SUMM)'
      '1102091291=      FROM KASSA_BEZNAL K'
      '1102091292=     WHERE K."ACTION" = 1'
      '1102091293=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102091294=      INTO :DEBET_;'
      '1102091295=    DEBET_ = COALESCE(DEBET_, 0);'
      '1102091296='
      '1102091297=    MERGE INTO KASSA_BEZNAL_STATE c'
      
        '1102091298=    USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCHKA_' +
        ' AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE)'
      '1102091299=    WHEN MATCHED THEN'
      '1102091300=        UPDATE SET'
      '1102091301=            C.DEBET  = :DEBET_,'
      '1102091302=            C.CREDIT = :CREDIT_,'
      
        '1102091303=            C."OUTPUT" = C."INPUT" - :DEBET_ + :CREDI' +
        'T_'
      '1102091304=    WHEN NOT MATCHED THEN'
      
        '1102091305=        INSERT (KASSA_BEZNAL_STATE, K_DATE, "INPUT", ' +
        'DEBET, CREDIT, "OUTPUT")'
      '1102091306=        VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '1102091307=                :ACTION_DATE_,'
      
        '1102091308=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102091309=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102091310=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0),'
      '1102091311=                :DEBET_,'
      '1102091312=                :CREDIT_,'
      
        '1102091313=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102091314=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102091315=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0) - :DEBET_ + :CREDIT_);'
      '1102091316='
      '1102091317=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '1102091318=    UPDATE LOGS L'
      
        '1102091319=       SET L.IS_TRANSFERED = DECODE(:ERR_CODE, 0, 1, ' +
        '-1),'
      '1102091320=           L.ERR_CODE = :ERR_CODE'
      '1102091321=     WHERE L.ID = :LOGS_ID_'
      '1102091322=       AND L.USR = '#39'REPLICAT'#39
      '1102091323=       AND L.DAT IS NULL'
      '1102091324=       AND L.IS_TRANSFERED = 0;'
      '1102091325='
      '1102091326=  END'
      '1102091327='
      
        '1102091328=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045 +
        #1058
      '1102091329=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '1102091330=    EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL(:ACTION_D' +
        'ATE_MIN_)'
      '1102091331=      RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102091332=  END'
      '1102091333='
      '1102091334=  /*'
      '1102091335=  POS_ = 1;'
      '1102091336=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '1102091337=    BEGIN'
      
        '1102091338=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ F' +
        'ROM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '1102091339='
      '1102091340=        WHILE (POS_ > 0) DO BEGIN'
      '1102091341=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '1102091342='
      '1102091343=            IF (POS_ > 0) THEN'
      
        '1102091344=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1' +
        ' FOR POS_ - 1);'
      '1102091345=            ELSE'
      '1102091346=              STR_ = PRODUCT_ID_ARR_;'
      '1102091347='
      
        '1102091348=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 F' +
        'OR POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '1102091349=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSI' +
        'TION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN ST' +
        'R_)) AS BIGINT);'
      '1102091350='
      
        '1102091351=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_' +
        'ARR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '1102091352='
      '1102091353=            select ('
      '1102091354=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102091355=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s, sklad_parent sp'
      '1102091356=                    where sp.SKLAD = s.SKLAD_PARENT'
      '1102091357=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '1102091358=                      and s.g_product = :G_PRODUCT_'
      
        '1102091359=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077 +
        ' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102091360='
      '1102091361=                   -'
      '1102091362=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102091363=                   (select COALESCE(sum(zr.AMOUNT_ALL' +
        '), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102091364=                    where zr.g_product = :G_PRODUCT_ ' +
        'and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102091365=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZA' +
        'KAZ_REAL_PARENT)'
      '1102091366='
      '1102091367=                   -'
      '1102091368=                   -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102091369=                   (select COALESCE(sum(zd.amount), 0' +
        ') from zakaz_details zd, zakaz z'
      
        '1102091370=                    where zd.g_product = :G_PRODUCT_ ' +
        'and Z.G_TOCHKA = :G_TOCHKA_'
      '1102091371=                    and zd.zakaz = z.zakaz'
      
        '1102091372=                    and z.IS_RESERVE = 0      -- '#1085#1077' '#1074 +
        #1099#1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081 +
        #1076#1077#1090' '#1085#1080#1078#1077
      
        '1102091373=                    and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095 +
        #1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' ' +
        #1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102091374=                    and not (z.IS_SPISANIE = 0 and z.' +
        'NOT_MINUS_OSTATOK = 1)'
      '1102091375=                   )'
      '1102091376='
      '1102091377=                   -'
      '1102091378=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102091379=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat =' +
        ' 3'
      '1102091380=                    and S.g_client = :G_TOCHKA_)'
      '1102091381='
      '1102091382=                   -'
      '1102091383=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102091384=                   (select COALESCE(sum(od.amount), 0' +
        ') from other_details od, other o'
      
        '1102091385=                    where od.g_product = :G_PRODUCT_ ' +
        'and o.G_TOCHKA = :G_TOCHKA_'
      '1102091386=                    and od.other = o.other)'
      '1102091387=                   ) amount,'
      '1102091388='
      
        '1102091389=                   (SELECT COALESCE(sum(ZD.amount), 0' +
        ') FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102091390=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AN' +
        'D Z.IS_RESERVE = 1'
      
        '1102091391=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.' +
        'G_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102091392=            from rdb$database'
      '1102091393=            INTO :AMOUNT_,'
      '1102091394=                 :AMOUNT_RESERVE_;'
      '1102091395='
      '1102091396=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102091397=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :' +
        'G_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102091398=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_' +
        'TOCHKA = CD.G_TOCHKA)'
      '1102091399=            WHEN MATCHED THEN'
      
        '1102091400=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.A' +
        'MOUNT_RESERVE = :AMOUNT_RESERVE_'
      '1102091401=            WHEN NOT MATCHED THEN'
      
        '1102091402=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, ' +
        'AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102091403=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, ' +
        ' 1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102091404=        END'
      '1102091405=    WHEN ANY DO'
      '1102091406=        BEGIN'
      '1102091407=            SQLCODE_ = GDSCODE;'
      '1102091408=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102091409=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102091410=            ERR_BODY = ERR_BODY ||'#39
      
        '1102091411=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102091412=        END'
      '1102091413=    END'
      '1102091414=  END'
      '1102091415='
      '1102091416=  */'
      '1102091417=END'
      '1102091418=;'
      '1102091419='
      '1102091420='
      
        '1102091421=UPDATE SYSTEM_SETUP SET S_VALUE = 110209 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102091422=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
