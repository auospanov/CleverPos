      '1102282781=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102282782=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      
