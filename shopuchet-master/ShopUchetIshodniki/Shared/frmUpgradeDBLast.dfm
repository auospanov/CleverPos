      '11024010='
      '11024011=UPDATE RDB$RELATION_FIELDS SET RDB$NULL_FLAG = 1'
      
        '11024012=WHERE (RDB$FIELD_NAME = '#39'G_TOCHKA'#39') AND (RDB$RELATION_N' +
        'AME = '#39'ZAKAZ'#39');'
