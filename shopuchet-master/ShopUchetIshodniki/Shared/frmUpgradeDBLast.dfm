      '1102121990=               '#39'*'#39'||:PRODAZHI_CASH_AMOUNT_ AMOUNT,'
      '1102121991=               '#39'='#39'||:PRODAZHI_CASH_SUMM_ SUMM'
      '1102121992=          FROM RDB$DATABASE'
      '1102121993=        UNION'
