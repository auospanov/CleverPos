      '1101825916=                END*/'
      '1101825917='
      
        '1101825918=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101825919=            END ELSE BEGIN'
      '1101825920=                UPDATE SKLAD S'
      '1101825921=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1101825922=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1101825923=                       S.PRICE    = :PRICE_,'
      '1101825924=                       S.SUMM     = :SUMMM_,'
