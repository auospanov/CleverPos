        '1102282664=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102282665=                                          NULL,   --N' +
        'OTE_'
      '1102282666=                                          NULL,'
      
        '1102282667=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102282668=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1102282669=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102282670=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102282671=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1102282672=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102282673=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1102282674=                                          :G_PRIHOD_,'
      
        '1102282675=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102282676=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102282677=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1102282678=                                          NULL,'
      
        '1102282679=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102282680=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102282681=                                          :G_TOCHKA_,'
      
        '1102282682=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102282683=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102282684=      END'
      '1102282685=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102282686=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102282687=        EXIT;'
      '1102282688=      END'
      '1102282689='
      
        '1102282690=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102282691=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102282692=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102282693=        PNT_ = '#39'013'#39';'
      
        '1102282694=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_' +
        'CODE, :ERR_MSG);'
      '1102282695=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
