        '1102493061=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102493062=              EXIT;'
      '1102493063=            END'
      '1102493064='
      
        '1102493065=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1102493066=      END'
      '1102493067='
      
        '1102493068=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1102493069=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1102493070=            FROM KASSA K'
      '1102493071=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102493072=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1102493073=           UNION'
      '1102493074=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1102493075=            FROM KASSA K'
      '1102493076=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102493077=             AND K.SUMM = 0'
      '1102493078=          UNION'
      '1102493079=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102493080=            FROM KASSA_BEZNAL K'
      '1102493081=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102493082=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1102493083=          UNION'
      '1102493084=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102493085=            FROM KASSA_BEZNAL K'
      '1102493086=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102493087=             AND K.SUMM = 0'
      '1102493088=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1102493089=      DO BEGIN'
      '1102493090=        PNT_ = '#39'011A'#39';'
      
        '1102493091=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, ' +
        ':ERR_MSG);'
      '1102493092=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102493093=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
