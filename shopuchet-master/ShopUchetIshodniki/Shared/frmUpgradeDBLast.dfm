        '110217189=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110217190=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110217191=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110217192=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110217193=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110217194=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110217195=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110217196=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110217197=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110217198=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110217199=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110217200=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110217201=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110217202=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110217203=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110217204=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110217205=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110217206=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '110217207=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM_FACT;'
      
        '110217208=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN S' +
        'KLAD_PARENT.SUMM_FACT;'
      '110217209=BEGIN'
      
        '110217210=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110217211=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110217212='
      '110217213=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110217214=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110217215=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110217216='
      '110217217=  FOR SELECT GP.PATH,'
      '110217218=             GP.G_PRODUCT'
      '110217219=       FROM P_REP_TREE GP'
      '110217220=      WHERE EXISTS (SELECT 1'
      
        '110217221=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110217222=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110217223=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110217224=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110217225=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110217226=                       AND Z.IS_SPISANIE = 0'
      '110217227=                       AND Z.is_reserve = 0'
      '110217228=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110217229=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110217230=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217231=                       AND COALESCE(Z.G_OFFICIAL, 0) =' +
        ' COALESCE(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056 +
        #1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217232=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110217233=                       AND ((EXISTS (SELECT 1'
      
        '110217234=                                       FROM SKLAD S, G' +
        '_PRODUCT G'
      
        '110217235=                                      WHERE S.G_CLIENT' +
        ' = :G_SUPPLIER_'
      
        '110217236=                                        AND S.G_PRODUC' +
        'T = G.G_PRODUCT'
      
        '110217237=                                        AND G.G_PRODUC' +
        'T_PAR = GP.G_PRODUCT'
      
        '110217238=                                        AND :G_TOCHKA_' +
        'ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_,' +
        ' 0) <> 0)'
      '110217239=                              OR'
      
        '110217240=                              COALESCE(:G_SUPPLIER_, 0' +
        ') = 0)'
      '110217241=                       )'
      '110217242=      ORDER BY 1, 2'
      '110217243=  INTO :RECCAT_NAME_,'
      '110217244=       :RECCAT_PRODUCT_'
      '110217245=  DO BEGIN'
      '110217246=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217247=    insert into p_rep_profit_table'
      '110217248=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110217249=    values'
      
        '110217250=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110217251='
      '110217252=    FOR SELECT Z.ZAKAZ,'
      '110217253=               Z.G_TOCHKA,'
      '110217254=               Z.Z_DATE,'
      '110217255=               Z.G_CLIENT,'
      '110217256=               C.NAME CLIENT_NAME,'
      '110217257=               Z.G_PAYMENT_TYPE,'
      '110217258=               P.NAME PAYMENT_NAME,'
      '110217259=               Z.OSNOVANIE,'
      '110217260=               G.G_PRODUCT,'
      '110217261=               G.G_PRODUCT_PAR,'
      '110217262=               G.NAME TOVAR_NAME,'
      '110217263=               ZD.AMOUNT,'
      '110217264=               ZD.PRICE,'
      '110217265=               ZD.SUMM,'
      '110217266=               ZD.DISCOUNT_PERC,'
      '110217267=               ZD.DISCOUNT_SUMM,'
      '110217268=               ZD.NDS,'
      '110217269=               ZD.NDS_SUMM,'
      '110217270=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110217271=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110217272=               ZAKAZ_DETAILS ZD,'
      '110217273=               G_PRODUCT G,'
      '110217274=               G_PAYMENT_TYPE P'
      
        '110217275=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110217276=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110217277=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110217278=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110217279=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110217280=           AND Z.IS_SPISANIE = 0                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '110217281=           AND Z.IS_RESERVE = 0                    -- ' +
        #1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '110217282=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110217283=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110217284=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110217285=           AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G' +
        '_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' ' +
        #1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217286=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110217287=           AND ((EXISTS (SELECT 1'
      '110217288=                           FROM SKLAD S'
      
        '110217289=                          WHERE S.G_CLIENT = :G_SUPPLI' +
        'ER_'
      
        '110217290=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110217291=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110217292=                OR'
      '110217293=                COALESCE(:G_SUPPLIER_, 0) = 0'
      '110217294=               )'
      
        '110217295=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110217296=    INTO :REC_ZAKAZ_,'
      '110217297=        :REC_G_TOCHKA_,'
      '110217298=        :REC_Z_DATE_,'
      '110217299=        :REC_G_CLIENT_,'
      '110217300=        :REC_CLIENT_NAME_,'
      '110217301=        :REC_G_PAYMENT_TYPE_,'
      '110217302=        :REC_PAYMENT_NAME_,'
      '110217303=        :REC_OSNOVANIE_,'
      '110217304=        :REC_G_PRODUCT_,'
      '110217305=        :REC_G_PRODUCT_PAR_,'
      '110217306=        :REC_TOVAR_NAME_,'
      '110217307=        :REC_AMOUNT_,'
      '110217308=        :REC_PRICE_,'
      '110217309=        :REC_SUMM_,'
      '110217310=        :REC_DISCOUNT_PERC_,'
      '110217311=        :REC_DISCOUNT_SUMM_,'
      '110217312=        :REC_NDS_,'
      '110217313=        :REC_NDS_SUMM_,'
      '110217314=        :REC_PRICE_SELF_'
      '110217315=    DO BEGIN'
      '110217316=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110217317=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_S' +
        'UM_COST_;'
      '110217318='
      '110217319=      insert into p_rep_profit_table'
      
        '110217320=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110217321=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110217322=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110217323=      values'
      '110217324=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110217325=        :REC_ZAKAZ_,'
      '110217326=        :REC_g_tochka_,'
      
        '110217327=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110217328=         :REC_osnovanie_,'
      '110217329=         :REC_g_product_,'
      '110217330=         :REC_g_product_par_,'
      '110217331=         :REC_tovar_name_,'
      '110217332=         :REC_amount_,'
      '110217333=         :REC_price_,'
      '110217334=         :REC_summ_,'
      '110217335=         :REC_discount_perc_,'
      '110217336=         :REC_discount_summ_,'
      
        '110217337=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110217338='
      
        '110217339=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110217340=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110217341=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110217342=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110217343=    END'
      '110217344='
      '110217345=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217346=    insert into p_rep_profit_table'
      
        '110217347=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110217348=    values'
      
        '110217349=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110217350='
      '110217351=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110217352=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110217353=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110217354=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110217355='
      '110217356=    SUM_ZAKAZ_ = 0;'
      '110217357=    SUM_COST_  = 0;'
      '110217358=    NDS_SUMM_  = 0;'
      '110217359=    PROFIT_    = 0;'
      '110217360=  END'
      '110217361='
      '110217362=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110217363=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110217364=      insert into p_rep_profit_table'
      
        '110217365=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110217366=      values'
      
        '110217367=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110217368='
      
        '110217369=  --**************************************************' +
        '***************************************'
      '110217370=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110217371=  ----------------------------------------------------' +
        '---'
      '110217372=  SELECT COUNT(*)'
      
        '110217373=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110217374=          UNION ALL'
      
        '110217375=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110217376=         G_PRIHOD_RASHOD G'
      
        '110217377=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110217378=    AND K.ACTION = 1'
      
        '110217379=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110217380=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110217381=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053#1045 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110217382=  INTO :CNT_;'
      '110217383='
      '110217384=  IF (CNT_ > 0) THEN BEGIN'
      '110217385=    SUM_COST_  = 0;'
      '110217386=    PROFIT_    = 0;'
      '110217387='
      '110217388=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217389=    INSERT INTO P_REP_PROFIT_TABLE'
      '110217390=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110217391=    VALUES'
      
        '110217392=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', 1' +
        ');'
      '110217393='
      '110217394=    FOR SELECT K.ACTION_DATE,'
      '110217395=               K.SUMM,'
      
        '110217396=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, '#39 +
        ' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '110217397=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '110217398=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39
      '110217399=              UNION ALL'
      
        '110217400=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, ' +
        'SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM kas' +
        'sa_beznal'
      
        '110217401=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_' +
        'TOCHKA||'#39'-'#39') k,'
      '110217402=              G_PRIHOD_RASHOD G'
      '110217403=        WHERE K.ACTION = 1'
      
        '110217404=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110217405=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110217406=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)   ' +
        ' -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110217407=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110217408=    INTO :ACTION_DATE_,'
      '110217409=         :SUMM_,'
      '110217410=         :ACTION_NAME_'
      '110217411=    DO BEGIN'
      '110217412=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110217413=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110217414=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110217415=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110217416=        VALUES'
      
        '110217417=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, 0,'
      
        '110217418=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALES' +
        'CE(:SUMM_, 0), 0);'
      '110217419='
      '110217420=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110217421=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110217422=    END'
      '110217423='
      '110217424=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110217425=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110217426=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110217427=    insert into p_rep_profit_table'
      
        '110217428=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110217429=    values'
      
        '110217430=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110217431=  END'
      '110217432=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '110217433=  --**************************************************' +
        '***************************************'
      '110217434='
      
        '110217435=  --**************************************************' +
        '***************************************'
      '110217436=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '110217437=  ----------------------------------------------------' +
        '---'
      '110217438=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217439=  SELECT COUNT(*)'
      
        '110217440=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110217441=          UNION ALL'
      
        '110217442=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM' +
        ' NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZ' +
        'NAL) K,'
      '110217443=         G_PRIHOD_RASHOD G'
      
        '110217444=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39'-' +
        #39
      '110217445=    AND K.ACTION = 0'
      
        '110217446=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      '110217447=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110217448=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056#1045 +
        #1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110217449=  INTO :CNT_;'
      '110217450='
      '110217451=  IF (CNT_ > 0) THEN BEGIN'
      '110217452=    PRIHOD_ALL_  = 0;'
      '110217453=    PRIHOD_ALL_NAL_  = 0;'
      '110217454=    PRIHOD_ALL_BEZNAL_  = 0;'
      '110217455=    PROFIT_     = 0;'
      '110217456='
      '110217457=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217458=    INSERT INTO P_REP_PROFIT_TABLE'
      '110217459=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110217460=    VALUES'
      
        '110217461=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', 1' +
        ');'
      '110217462='
      '110217463=    FOR SELECT K.ACTION_DATE,'
      '110217464=               K.NAL,'
      '110217465=               K.BEZNAL,'
      '110217466=               G.NAME'
      
        '110217467=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 ' +
        'BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110217468=               UNION ALL'
      
        '110217469=               SELECT kassa_BEZNAL KASSA, ACTION_DATE,' +
        ' 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kass' +
        'a_beznal) K,'
      '110217470=              G_PRIHOD_RASHOD G'
      
        '110217471=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '110217472=          AND K.ACTION = 0'
      
        '110217473=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110217474=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110217475=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110217476=        ORDER BY K.ACTION_DATE, K.KASSA'
      '110217477=    INTO :ACTION_DATE_,'
      '110217478=         :SUMM_NAL_,'
      '110217479=         :SUMM_BEZNAL_,'
      '110217480=         :ACTION_NAME_'
      '110217481=    DO BEGIN'
      '110217482=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '110217483=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUM' +
        'M,'
      '110217484=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110217485=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT' +
        ', IS_HEAD)'
      '110217486=        VALUES'
      
        '110217487=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_' +
        'DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '110217488=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '110217489='
      '110217490=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110217491=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM' +
        '_BEZNAL_;'
      
        '110217492=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_B' +
        'EZNAL_;'
      
        '110217493=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZ' +
        'NAL_;'
      '110217494=    END'
      '110217495='
      '110217496=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110217497=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110217498=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '110217499=    insert into p_rep_profit_table'
      
        '110217500=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110217501=    values'
      
        '110217502=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110217503=  END'
      '110217504='
      '110217505=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '110217506=  --**************************************************' +
        '***************************************'
      '110217507='
      
        '110217508=  --**************************************************' +
        '***************************************'
      '110217509=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110217510=  --**************************************************' +
        '***************************************'
      '110217511=  SELECT COUNT(*)'
      '110217512=    FROM ZAKAZ Z'
      
        '110217513=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110217514=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110217515=     AND Z.IS_SPISANIE = 1'
      
        '110217516=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110217517=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110217518=  INTO :CNT_;'
      '110217519='
      '110217520=  IF (CNT_ > 0) THEN BEGIN'
      '110217521=      SUM_ZAKAZ_ = 0;'
      '110217522=      SUM_COST_  = 0;'
      '110217523=      PROFIT_    = 0;'
      '110217524='
      '110217525=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217526=      insert into p_rep_profit_table'
      '110217527=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110217528=      values'
      
        '110217529=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39', 1);'
      '110217530='
      '110217531=      FOR SELECT Z.ZAKAZ,'
      '110217532=                 Z.G_TOCHKA,'
      '110217533=                 Z.Z_DATE,'
      '110217534=                 Z.G_CLIENT,'
      '110217535=                 '#39#39' CLIENT_NAME,'
      '110217536=                 Z.G_PAYMENT_TYPE,'
      '110217537=                 '#39#39' PAYMENT_NAME,'
      '110217538=                 Z.OSNOVANIE,'
      '110217539=                 G.G_PRODUCT,'
      '110217540=                 G.G_PRODUCT_PAR,'
      '110217541=                 G.NAME TOVAR_NAME,'
      '110217542=                 ZD.AMOUNT,'
      '110217543=                 ZD.PRICE,'
      '110217544=                 ZD.SUMM,'
      '110217545=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '110217546=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '110217547=                 0 NDS, --ZD.NDS,'
      '110217548=                 0 NDS_SUMM'
      
        '110217549=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT ' +
        'G'
      
        '110217550=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TO' +
        'CHKA||'#39'-'#39
      '110217551=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110217552=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110217553=             AND Z.IS_SPISANIE = 1                    ' +
        '-- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '110217554=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110217555=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      
        '110217556=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G' +
        '_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059 +
        #1057#1058#1067#1052
      
        '110217557=             AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(' +
        ':G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045 +
        #1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217558=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALE' +
        'SCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110217559=             AND ((EXISTS (SELECT 1'
      '110217560=                           FROM SKLAD S'
      
        '110217561=                          WHERE S.G_CLIENT = :G_SUPPLI' +
        'ER_'
      
        '110217562=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110217563=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110217564=                  OR'
      '110217565=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110217566=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS'
      '110217567=      INTO :REC_ZAKAZ_,'
      '110217568=            :REC_G_TOCHKA_,'
      '110217569=            :REC_Z_DATE_,'
      '110217570=            :REC_G_CLIENT_,'
      '110217571=            :REC_CLIENT_NAME_,'
      '110217572=            :REC_G_PAYMENT_TYPE_,'
      '110217573=            :REC_PAYMENT_NAME_,'
      '110217574=            :REC_OSNOVANIE_,'
      '110217575=            :REC_G_PRODUCT_,'
      '110217576=            :REC_G_PRODUCT_PAR_,'
      '110217577=            :REC_TOVAR_NAME_,'
      '110217578=            :REC_AMOUNT_,'
      '110217579=            :REC_PRICE_,'
      '110217580=            :REC_SUMM_,'
      '110217581=            :REC_DISCOUNT_PERC_,'
      '110217582=            :REC_DISCOUNT_SUMM_,'
      '110217583=            :REC_NDS_,'
      '110217584=            :REC_NDS_SUMM_'
      '110217585=      DO BEGIN'
      '110217586=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110217587=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067 +
        ' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '110217588=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '110217589=        REC_profit_   = -REC_SUMM_;'
      '110217590='
      '110217591=        insert into p_rep_profit_table'
      
        '110217592=          (p_rep_profit_table, zakaz, g_tochka, z_date' +
        ', g_client, client_name, g_payment_type, payment_name,'
      
        '110217593=           osnovanie, g_product, g_product_par, tovar_' +
        'name, amount, price, summ, discount_perc, discount_summ,'
      
        '110217594=           nds, nds_summ, price_self, sum_self, profit' +
        ', is_head)'
      '110217595=        values'
      
        '110217596=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAK' +
        'AZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '110217597=         :REC_osnovanie_, :REC_g_product_, :REC_g_prod' +
        'uct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_pe' +
        'rc_, :REC_discount_summ_,'
      
        '110217598=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_' +
        'SUM_COST_, :REC_profit_, 0);'
      '110217599='
      
        '110217600=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST' +
        '_, 0);'
      
        '110217601=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, ' +
        '0);'
      '110217602=      END'
      '110217603='
      '110217604=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217605=      insert into p_rep_profit_table'
      
        '110217606=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110217607=      values'
      
        '110217608=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0' +
        ', :SUM_COST_, 0, :PROFIT_, 2);'
      '110217609='
      '110217610=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110217611=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110217612=  END'
      '110217613=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110217614=  --**************************************************' +
        '***************************************'
      '110217615='
      
        '110217616=  --**************************************************' +
        '***************************************'
      '110217617=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110217618=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048#1045 +
        #1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '110217619=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053#1054 +
        '", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '110217620=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' '#1055 +
        #1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '110217621='
      
        '110217622=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053 +
        #1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000,' +
        ' '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '110217623=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 45' +
        '00'
      
        '110217624=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056#1048 +
        #1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057#1054 +
        #1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '110217625=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070#1047 +
        #1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054' ' +
        #1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '110217626='
      
        '110217627=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059#1063 +
        #1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '110217628=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058'.' +
        ' - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '110217629=  --**************************************************' +
        '***************************************'
      '110217630=  SELECT COUNT(*)'
      '110217631=    FROM SKLAD S'
      
        '110217632=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      
        '110217633=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110217634=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110217635=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110217636=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110217637=     AND ((EXISTS (SELECT 1'
      '110217638=                   FROM SKLAD SS'
      '110217639=                  WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '110217640=                    AND SS.G_PRODUCT = S.G_PRODUCT'
      
        '110217641=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110217642=          OR'
      '110217643=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110217644=  INTO :CNT_;'
      '110217645='
      '110217646=  IF (CNT_ > 0) THEN BEGIN'
      '110217647=    SUM_ZAKAZ_ = 0;'
      '110217648=    PROFIT_    = 0;'
      '110217649=    SUM_COST_  = 0;'
      '110217650=    NDS_SUMM_  = 0;'
      '110217651='
      '110217652=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217653=    insert into p_rep_profit_table'
      '110217654=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110217655=    values'
      
        '110217656=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39', 1);'
      '110217657='
      '110217658=    FOR SELECT S.DATE_RECEIPT,'
      '110217659=               S.G_PRODUCT,'
      '110217660=               G.NAME TOVAR_NAME,'
      '110217661=               S.AMOUNT,'
      '110217662=               -S.PRICE,'
      '110217663=               -S.SUMM,'
      '110217664=               SP.G_TOCHKA,'
      '110217665=               S.COST_PRICE,'
      '110217666=               S.NDS,'
      '110217667=               S.NDS_SUMM'
      '110217668=         FROM SKLAD_PARENT SP,'
      '110217669=              SKLAD S,'
      '110217670=              G_PRODUCT G'
      
        '110217671=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCH' +
        'KA||'#39'-'#39
      
        '110217672=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110217673=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110217674=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110217675=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110217676=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110217677=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110217678=          AND ((EXISTS (SELECT 1'
      '110217679=                           FROM SKLAD SS'
      
        '110217680=                          WHERE SS.G_CLIENT = :G_SUPPL' +
        'IER_'
      
        '110217681=                            AND SS.G_PRODUCT = S.G_PRO' +
        'DUCT'
      
        '110217682=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110217683=                  OR'
      '110217684=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110217685=        ORDER BY 1'
      '110217686=    INTO :V_DATE_RECEIPT_,'
      '110217687=         :V_G_PRODUCT_,'
      '110217688=         :V_TOVAR_NAME_,'
      '110217689=         :V_AMOUNT_,'
      '110217690=         :V_PRICE_,'
      '110217691=         :V_SUMM_,'
      '110217692=         :REC_G_TOCHKA_,'
      '110217693=         :REC_PRICE_SELF_,'
      '110217694=         :REC_NDS_,'
      '110217695=         :REC_NDS_SUMM_'
      '110217696=    DO BEGIN'
      '110217697=      REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '110217698=      REC_profit_   = V_SUMM_ + REC_SUM_COST_ + REC_ND' +
        'S_SUMM_;'
      '110217699='
      '110217700=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110217701=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110217702=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110217703=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, s' +
        'um_self)'
      '110217704=      VALUES'
      
        '110217705=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, :V' +
        '_SUMM_,'
      
        '110217706=         0, 0, :REC_NDS_, :REC_NDS_SUMM_, :REC_profit_' +
        ', 0, :REC_PRICE_SELF_, :REC_SUM_COST_);'
      '110217707='
      '110217708=      SUM_COST_  = SUM_COST_  + REC_SUM_COST_;'
      '110217709=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      
        '110217710=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110217711=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110217712=    END'
      '110217713='
      '110217714='
      '110217715=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110217716=    SUMM_COST_All_ = SUMM_COST_All_ - SUM_COST_;'
      '110217717=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ - NDS_SUMM_;'
      '110217718=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110217719='
      '110217720=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217721=    insert into p_rep_profit_table'
      
        '110217722=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110217723=    values'
      
        '110217724=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110217725='
      '110217726=    SUM_COST_  = 0;'
      '110217727=    SUM_ZAKAZ_ = 0;'
      '110217728=    NDS_SUMM_  = 0;'
      '110217729=    PROFIT_    = 0;'
      '110217730=  END'
      '110217731=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '110217732=  --**************************************************' +
        '***************************************'
      '110217733='
      
        '110217734=  --**************************************************' +
        '***************************************'
      
        '110217735=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045#1051 +
        #1054' '#1052#1045#1057#1058#1054
      '110217736=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '110217737=  --**************************************************' +
        '***************************************'
      '110217738=  /*SELECT COUNT(*)'
      '110217739=    FROM ZAKAZ Z'
      
        '110217740=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110217741=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110217742=     AND Z.IS_SPISANIE = 4'
      
        '110217743=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110217744=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110217745=  INTO :CNT_;'
      '110217746='
      '110217747=  IF (CNT_ > 0) THEN BEGIN'
      '110217748=      SUM_ZAKAZ_ = 0;'
      '110217749=      SUM_COST_  = 0;'
      '110217750=      PROFIT_    = 0;'
      '110217751=      NDS_SUMM_  = 0;'
      '110217752='
      '110217753=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217754=      insert into p_rep_profit_table'
      '110217755=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110217756=      values'
      
        '110217757=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058 +
        #1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '110217758='
      '110217759=      FOR SELECT Z.ZAKAZ,'
      '110217760=               Z.G_TOCHKA,'
      '110217761=               Z.Z_DATE,'
      '110217762=               Z.G_CLIENT,'
      '110217763=               C.NAME CLIENT_NAME,'
      '110217764=               Z.G_PAYMENT_TYPE,'
      '110217765=               P.NAME PAYMENT_NAME,'
      '110217766=               Z.OSNOVANIE,'
      '110217767=               G.G_PRODUCT,'
      '110217768=               G.G_PRODUCT_PAR,'
      '110217769=               G.NAME TOVAR_NAME,'
      '110217770=               ZD.AMOUNT,'
      '110217771=               ZD.PRICE,'
      '110217772=               ZD.SUMM,'
      '110217773=               ZD.DISCOUNT_PERC,'
      '110217774=               ZD.DISCOUNT_SUMM,'
      '110217775=               ZD.NDS,'
      '110217776=               ZD.NDS_SUMM,'
      '110217777=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110217778=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110217779=               ZAKAZ_DETAILS ZD,'
      '110217780=               G_PRODUCT G,'
      '110217781=               G_PAYMENT_TYPE P'
      
        '110217782=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110217783=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110217784=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110217785=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110217786=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110217787=           AND Z.IS_SPISANIE = 4                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110217788=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110217789=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110217790=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110217791=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110217792=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110217793=    INTO :REC_ZAKAZ_,'
      '110217794=        :REC_G_TOCHKA_,'
      '110217795=        :REC_Z_DATE_,'
      '110217796=        :REC_G_CLIENT_,'
      '110217797=        :REC_CLIENT_NAME_,'
      '110217798=        :REC_G_PAYMENT_TYPE_,'
      '110217799=        :REC_PAYMENT_NAME_,'
      '110217800=        :REC_OSNOVANIE_,'
      '110217801=        :REC_G_PRODUCT_,'
      '110217802=        :REC_G_PRODUCT_PAR_,'
      '110217803=        :REC_TOVAR_NAME_,'
      '110217804=        :REC_AMOUNT_,'
      '110217805=        :REC_PRICE_,'
      '110217806=        :REC_SUMM_,'
      '110217807=        :REC_DISCOUNT_PERC_,'
      '110217808=        :REC_DISCOUNT_SUMM_,'
      '110217809=        :REC_NDS_,'
      '110217810=        :REC_NDS_SUMM_,'
      '110217811=        :REC_PRICE_SELF_'
      '110217812=    DO BEGIN'
      '110217813=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '110217814=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '110217815='
      '110217816=      insert into p_rep_profit_table'
      
        '110217817=        (p_rep_profit_table, zakaz, g_tochka, z_date, ' +
        'g_client, client_name, g_payment_type, payment_name,'
      
        '110217818=         osnovanie, g_product, g_product_par, tovar_na' +
        'me, amount, price, summ, discount_perc, discount_summ,'
      
        '110217819=         nds, nds_summ, price_self, sum_self, profit, ' +
        'is_head)'
      '110217820=      values'
      '110217821=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110217822=        :REC_ZAKAZ_,'
      '110217823=        :REC_g_tochka_,'
      
        '110217824=        :REC_z_date_, :REC_g_client_, :REC_client_name' +
        '_, :REC_g_payment_type_, :REC_payment_name_,'
      '110217825=         :REC_osnovanie_,'
      '110217826=         :REC_g_product_,'
      '110217827=         :REC_g_product_par_,'
      '110217828=         :REC_tovar_name_,'
      '110217829=         :REC_amount_,'
      '110217830=         :REC_price_,'
      '110217831=         :REC_summ_,'
      '110217832=         :REC_discount_perc_,'
      '110217833=         :REC_discount_summ_,'
      
        '110217834=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, ' +
        ':REC_SUM_COST_, :REC_profit_, 0);'
      '110217835='
      
        '110217836=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0)' +
        ';'
      
        '110217837=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_,' +
        ' 0);'
      
        '110217838=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_,' +
        ' 0);'
      '110217839=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110217840=    END'
      '110217841='
      '110217842=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217843=    insert into p_rep_profit_table'
      
        '110217844=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110217845=    values'
      
        '110217846=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :SU' +
        'M_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110217847='
      '110217848=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110217849=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '110217850=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110217851=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110217852='
      '110217853=    SUM_ZAKAZ_ = 0;'
      '110217854=    SUM_COST_  = 0;'
      '110217855=    NDS_SUMM_  = 0;'
      '110217856=    PROFIT_    = 0;'
      '110217857=  END'
      '110217858=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '110217859=  --**************************************************' +
        '***************************************'
      '110217860='
      
        '110217861=  --**************************************************' +
        '***************************************'
      
        '110217862=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048 +
        #1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110217863=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054 +
        #1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110217864=  --**************************************************' +
        '***************************************'
      '110217865=  SELECT COUNT(*)'
      '110217866=    FROM ZAKAZ S'
      
        '110217867=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110217868=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110217869=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217870=     AND COALESCE(S.G_OFFICIAL, 0) = COALESCE(:G_OFFIC' +
        'IAL_, COALESCE(S.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '110217871=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110217872=     AND S.IS_SPISANIE = 2'
      '110217873=  INTO :CNT_;'
      '110217874='
      '110217875=  IF (CNT_ > 0) THEN BEGIN'
      '110217876=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217877=      insert into p_rep_profit_table'
      '110217878=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110217879=      values'
      
        '110217880=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '110217881='
      '110217882=      SUM_ZAKAZ_ = 0;'
      '110217883=      SUM_COST_  = 0;'
      '110217884=      NDS_SUMM_  = 0;'
      '110217885=      PROFIT_    = 0;'
      '110217886=      FOR SELECT GP.NAME,'
      '110217887=                 GP.G_PRODUCT'
      '110217888=           FROM G_PRODUCT GP'
      '110217889=          WHERE IS_CATEGORY = 1'
      '110217890=            AND EXISTS (SELECT 1'
      
        '110217891=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110217892=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110217893=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110217894=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110217895=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110217896=                           AND Z.IS_SPISANIE = 2'
      '110217897=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110217898=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110217899=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058 +
        ' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217900=                           AND COALESCE(Z.G_OFFICIAL, ' +
        '0) = COALESCE(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' ' +
        #1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217901=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110217902=                           AND ((EXISTS (SELECT 1'
      
        '110217903=                                           FROM SKLAD ' +
        'S'
      
        '110217904=                                          WHERE S.G_CL' +
        'IENT = :G_SUPPLIER_'
      
        '110217905=                                            AND S.G_PR' +
        'ODUCT = G.G_PRODUCT'
      
        '110217906=                                            AND :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLI' +
        'ER_, 0) <> 0)'
      '110217907=                                  OR'
      
        '110217908=                                  COALESCE(:G_SUPPLIER' +
        '_, 0) = 0)'
      '110217909=                           )'
      '110217910=          ORDER BY 1'
      '110217911=      INTO :RECCAT_NAME_,'
      '110217912=           :RECCAT_PRODUCT_'
      '110217913=      DO BEGIN'
      '110217914=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110217915=        insert into p_rep_profit_table'
      '110217916=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110217917=        values'
      
        '110217918=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110217919='
      '110217920=        FOR SELECT Z.ZAKAZ,'
      '110217921=                   Z.G_TOCHKA,'
      '110217922=                   Z.Z_DATE,'
      '110217923=                   Z.G_CLIENT,'
      '110217924=                   C.NAME CLIENT_NAME,'
      '110217925=                   Z.G_PAYMENT_TYPE,'
      '110217926=                   P.NAME PAYMENT_NAME,'
      '110217927=                   Z.OSNOVANIE,'
      '110217928=                   G.G_PRODUCT,'
      '110217929=                   G.G_PRODUCT_PAR,'
      '110217930=                   G.NAME TOVAR_NAME,'
      '110217931=                   ZD.AMOUNT,'
      '110217932=                   ZD.PRICE,'
      '110217933=                   ZD.SUMM,'
      '110217934=                   ZD.DISCOUNT_PERC,'
      '110217935=                   ZD.DISCOUNT_SUMM,'
      '110217936=                   ZD.NDS,'
      '110217937=                   ZD.NDS_SUMM,'
      '110217938=                   ZD.COST_PRICE'
      
        '110217939=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110217940=                   ZAKAZ_DETAILS ZD,'
      '110217941=                   G_PRODUCT G,'
      '110217942=                   G_PAYMENT_TYPE P'
      
        '110217943=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_' +
        'TOCHKA||'#39'-'#39
      '110217944=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110217945=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110217946=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110217947=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_ ' +
        ' -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110217948=               AND Z.IS_SPISANIE = 2                  ' +
        '  -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '110217949=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110217950=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110217951=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '110217952=               AND COALESCE(Z.G_OFFICIAL, 0) = COALESC' +
        'E(:G_OFFICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054 +
        #1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110217953=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110217954=               AND ((EXISTS (SELECT 1'
      '110217955=                               FROM SKLAD S'
      
        '110217956=                              WHERE S.G_CLIENT = :G_SU' +
        'PPLIER_'
      
        '110217957=                                AND S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '110217958=                                AND :G_TOCHKA_ARR_ CON' +
        'TAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0' +
        ')'
      '110217959=                      OR'
      '110217960=                      COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '110217961=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110217962=        INTO :REC_ZAKAZ_,'
      '110217963=            :REC_G_TOCHKA_,'
      '110217964=            :REC_Z_DATE_,'
      '110217965=            :REC_G_CLIENT_,'
      '110217966=            :REC_CLIENT_NAME_,'
      '110217967=            :REC_G_PAYMENT_TYPE_,'
      '110217968=            :REC_PAYMENT_NAME_,'
      '110217969=            :REC_OSNOVANIE_,'
      '110217970=            :REC_G_PRODUCT_,'
      '110217971=            :REC_G_PRODUCT_PAR_,'
      '110217972=            :REC_TOVAR_NAME_,'
      '110217973=            :REC_AMOUNT_,'
      '110217974=            :REC_PRICE_,'
      '110217975=            :REC_SUMM_,'
      '110217976=            :REC_DISCOUNT_PERC_,'
      '110217977=            :REC_DISCOUNT_SUMM_,'
      '110217978=            :REC_NDS_,'
      '110217979=            :REC_NDS_SUMM_,'
      '110217980=            :REC_PRICE_SELF_'
      '110217981=        DO BEGIN'
      
        '110217982=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF' +
        '_;'
      
        '110217983=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - ' +
        'REC_NDS_SUMM_;'
      '110217984='
      '110217985=          insert into p_rep_profit_table'
      
        '110217986=            (p_rep_profit_table, zakaz, g_tochka, z_da' +
        'te, g_client, client_name, g_payment_type, payment_name,'
      
        '110217987=             osnovanie, g_product, g_product_par, tova' +
        'r_name, amount, price, summ, discount_perc, discount_summ,'
      
        '110217988=             nds, nds_summ, price_self, sum_self, prof' +
        'it, is_head)'
      '110217989=          values'
      '110217990=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110217991=            :REC_ZAKAZ_,'
      '110217992=            :REC_g_tochka_,'
      
        '110217993=            :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      '110217994=             :REC_osnovanie_,'
      '110217995=             :REC_g_product_,'
      '110217996=             :REC_g_product_par_,'
      '110217997=             :REC_tovar_name_,'
      '110217998=             :REC_amount_,'
      '110217999=             :REC_price_,'
      '1102171000=             :REC_summ_,'
      '1102171001=             :REC_discount_perc_,'
      '1102171002=             :REC_discount_summ_,'
      
        '1102171003=             :REC_nds_, :REC_nds_summ_, :REC_price_se' +
        'lf_, :REC_SUM_COST_, :REC_profit_, 0);'
      '1102171004='
      
        '1102171005=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM' +
        '_, 0);'
      
        '1102171006=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_C' +
        'OST_, 0);'
      
        '1102171007=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_S' +
        'UMM_, 0);'
      
        '1102171008=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_' +
        ', 0);'
      '1102171009=        END'
      '1102171010='
      '1102171011=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102171012=        insert into p_rep_profit_table'
      
        '1102171013=          (p_rep_profit_table, tovar_name, summ, sum_' +
        'self, NDS_SUMM, profit, is_head)'
      '1102171014=        values'
      
        '1102171015=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1102171016='
      
        '1102171017=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ' +
        '_;'
      '1102171018=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '1102171019=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '1102171020=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '1102171021='
      '1102171022=        SUM_ZAKAZ_ = 0;'
      '1102171023=        SUM_COST_  = 0;'
      '1102171024=        NDS_SUMM_  = 0;'
      '1102171025=        PROFIT_    = 0;'
      '1102171026=      END'
      '1102171027='
      '1102171028=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1102171029=      insert into p_rep_profit_table'
      
        '1102171030=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1102171031=      values'
      
        '1102171032=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '1102171033='
      
        '1102171034=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REA' +
        'L_;'
      
        '1102171035=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REA' +
        'L_;'
      
        '1102171036=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_' +
        ';'
      '1102171037=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '1102171038=  END'
      '1102171039=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102171040=  --*************************************************' +
        '****************************************'
      '1102171041=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '1102171042='
      '1102171043=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1102171044=  insert into p_rep_profit_table'
      '1102171045=    (p_rep_profit_table, is_head)'
      '1102171046=  values'
      '1102171047=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1102171048='
      '1102171049=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1102171050=  insert into p_rep_profit_table'
      
        '1102171051=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102171052=  values'
      
        '1102171053=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1102171054='
      '1102171055=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1102171056=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1102171057=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1102171058=         SUM(Z.SUMM_BONUS)'
      '1102171059=    FROM ZAKAZ Z'
      
        '1102171060=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1102171061=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1102171062=     AND Z.IS_RESERVE = 0'
      '1102171063=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102171064=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171065=     AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '1102171066=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102171067=     AND ((EXISTS (SELECT 1'
      '1102171068=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1102171069=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1102171070=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1102171071=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1102171072=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102171073=          OR'
      '1102171074=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102171075=    INTO :SUMM_CASH_ALL_,'
      '1102171076=         :SUMM_NONCASH_ALL_,'
      '1102171077=         :SUMM_BONUS_ALL_;'
      '1102171078='
      '1102171079=  SELECT SUM(NAL),'
      '1102171080=         SUM(BEZNAL)'
      
        '1102171081=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHE' +
        'RE K.SKLAD = SP.SKLAD) NAL,'
      
        '1102171082=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL' +
        ' KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '1102171083=           FROM SKLAD_PARENT SP'
      
        '1102171084=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '1102171085=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102171086=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '1102171087=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, CO' +
        'ALESCE(SP.G_CLIENT, 0))'
      
        '1102171088=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYME' +
        'NT_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '1102171089=        )'
      '1102171090=  INTO :SUMM_VOZVRAT_NAL_,'
      '1102171091=       :SUMM_VOZVRAT_BEZNAL_;'
      '1102171092='
      
        '1102171093=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COAL' +
        'ESCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '1102171094=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) ' +
        '- COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '1102171095=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1102171096='
      '1102171097=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1102171098='
      
        '1102171099=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1102171100=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1102171101='
      '1102171102=/*  insert into p_rep_profit_table'
      
        '1102171103=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102171104=  values'
      
        '1102171105=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1102171106='
      '1102171107=  insert into p_rep_profit_table'
      '1102171108=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1102171109=  values'
      
        '1102171110=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1102171111='
      '1102171112=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1102171113=    SELECT G.NAME'
      '1102171114=      FROM G_CLIENT G'
      '1102171115=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102171116=    INTO :CLIENT_NAME_;'
      '1102171117=  ELSE'
      '1102171118=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102171119='
      '1102171120=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1102171121=    SELECT G.NAME'
      '1102171122=      FROM G_PAYMENT_TYPE G'
      '1102171123=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1102171124=    INTO :PAYMENT_NAME_;'
      '1102171125=  ELSE'
      '1102171126=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102171127='
      '1102171128=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1102171129=        P.ZAKAZ,'
      '1102171130=        P.G_TOCHKA,'
      '1102171131=        P.Z_DATE,'
      '1102171132=        P.G_CLIENT,'
      '1102171133=        P.CLIENT_NAME,'
      '1102171134=        P.G_PAYMENT_TYPE,'
      '1102171135=        P.PAYMENT_NAME,'
      '1102171136=        P.OSNOVANIE,'
      '1102171137=        P.G_PRODUCT,'
      '1102171138=        P.G_PRODUCT_PAR,'
      '1102171139=        P.TOVAR_NAME,'
      '1102171140=        G.ARTICUL,'
      '1102171141=        G.NOMENCLATUR_NUM,'
      '1102171142=        G.BARCODE,'
      '1102171143=        P.AMOUNT,'
      
        '1102171144=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1102171145=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1102171146=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102171147=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102171148=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1102171149=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102171150=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102171151=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102171152=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1102171153=        P.IS_HEAD'
      
        '1102171154=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1102171155=    ORDER BY 1'
      '1102171156=  INTO :P_REP_PROFIT_TABLE,'
      '1102171157=       :ZAKAZ,'
      '1102171158=       :G_TOCHKA,'
      '1102171159=       :Z_DATE,'
      '1102171160=       :G_CLIENT,'
      '1102171161=       :CLIENT_NAME,'
      '1102171162=       :G_PAYMENT_TYPE,'
      '1102171163=       :PAYMENT_NAME,'
      '1102171164=       :OSNOVANIE,'
      '1102171165=       :G_PRODUCT,'
      '1102171166=       :G_PRODUCT_PAR,'
      '1102171167=       :TOVAR_NAME,'
      '1102171168=       :ARTICUL,'
      '1102171169=       :NOMENCLATUR_NUM,'
      '1102171170=       :BARCODE,'
      '1102171171=       :AMOUNT,'
      '1102171172=       :PRICE,'
      '1102171173=       :SUMM,'
      '1102171174=       :DISCOUNT_PERC,'
      '1102171175=       :DISCOUNT_SUMM,'
      '1102171176=       :NDS,'
      '1102171177=       :NDS_SUMM,'
      '1102171178=       :PRICE_SELF,'
      '1102171179=       :SUM_SELF,'
      '1102171180=       :PROFIT,'
      '1102171181=       :IS_HEAD'
      '1102171182=  DO'
      '1102171183=    suspend;'
      '1102171184='
      '1102171185=WHEN ANY DO BEGIN'
      '1102171186=    Err_code = -20500;'
      
        '1102171187=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102171188=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102171189=  END'
      '1102171190=end'
      '1102171191=;'
      '1102171192='
      '1102171193=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '1102171194=  DATE_BEGIN_ DATE,'
      '1102171195=  DATE_END_ DATE,'
      '1102171196=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1102171197=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      '1102171198=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1102171199=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0,'
      
        '1102171200=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL)'
      '1102171201=RETURNS ('
      '1102171202=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1102171203=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '1102171204=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SU' +
        'MM,'
      '1102171205=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1102171206=  SUMM_ALL_ NUMERIC(15,2),'
      '1102171207=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1102171208=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1102171209=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1102171210=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1102171211=  PROFIT_ALL_ NUMERIC(15,2),'
      '1102171212=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1102171213=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABL' +
        'E.P_REP_PROFIT_TABLE,'
      
        '1102171214=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_' +
        'NAME,'
      '1102171215=  SUMM NUMERIC(15,2),'
      '1102171216=  NDS_SUMM NUMERIC(15,2),'
      '1102171217=  SUM_SELF NUMERIC(15,2),'
      '1102171218=  PROFIT NUMERIC(15,2),'
      '1102171219=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1102171220=  ERR_CODE INTEGER,'
      '1102171221=  ERR_MSG VARCHAR(1024))'
      '1102171222=AS'
      '1102171223=/*'
      '1102171224='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1102171225='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1102171226='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1102171227='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1102171228='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1102171229='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1102171230='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1102171231=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1102171232=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1102171233=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1102171234='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1102171235='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1102171236=*/'
      
        '1102171237=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT' +
        #39';'
      '1102171238=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102171239=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1102171240=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1102171241=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1102171242=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1102171243=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1102171244=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1102171245=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1102171246=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM;'
      
        '1102171247=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.NDS_SUMM;'
      
        '1102171248=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.S' +
        'UMM;'
      '1102171249=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '1102171250=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '1102171251=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1102171252=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059 +
        #1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1102171253=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /' +
        '* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1102171254=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0' +
        '; /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '1102171255=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1102171256=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      '1102171257=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '1102171258=BEGIN'
      
        '1102171259=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_T' +
        'ABLE = P_REP_PROFIT_TABLE;'
      '1102171260=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102171261='
      '1102171262=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '1102171263=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '1102171264=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '1102171265='
      '1102171266=  FOR SELECT SUM(ZD.SUMM)'
      '1102171267=           ,TR.PATH'
      '1102171268=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1102171269=           ,SUM(ZD.nds_summ)'
      '1102171270=      FROM ZAKAZ Z,'
      '1102171271=           ZAKAZ_DETAILS ZD,'
      '1102171272=           G_PRODUCT GP,'
      '1102171273=           P_REP_TREE TR'
      
        '1102171274=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102171275=       AND Z.IS_SPISANIE = 0'
      '1102171276=       AND Z.IS_RESERVE = 0'
      '1102171277=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102171278=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102171279=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102171280=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102171281=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102171282=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171283=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058 +
        #1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171284=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102171285=       AND ((EXISTS (SELECT 1'
      '1102171286=                       FROM SKLAD S'
      '1102171287=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1102171288=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1102171289=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102171290=              OR'
      '1102171291=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102171292=     GROUP BY TR.PATH'
      '1102171293=     ORDER BY TR.PATH'
      
        '1102171294=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, ' +
        'NDS_SUMM_'
      '1102171295=  DO BEGIN'
      '1102171296=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '1102171297='
      '1102171298=    insert into p_rep_profit_table'
      
        '1102171299=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1102171300=    values'
      '1102171301=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1102171302=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :S' +
        'UM_COST_, :PROFIT_, 0);'
      '1102171303='
      '1102171304=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1102171305=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1102171306=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1102171307=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102171308=  END'
      '1102171309='
      '1102171310=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1102171311=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1102171312=      insert into p_rep_profit_table'
      
        '1102171313=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1102171314=      values'
      
        '1102171315=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1102171316='
      
        '1102171317=  --*************************************************' +
        '****************************************'
      '1102171318=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1102171319=  ---------------------------------------------------' +
        '----'
      '1102171320=  IS_FIRST_ = 1;'
      '1102171321=  SUM_COST_ = 0;'
      '1102171322=  PROFIT_   = 0;'
      '1102171323='
      '1102171324=  FOR SELECT G.NAME,'
      '1102171325=             SUM(K.SUMM)'
      
        '1102171326=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRI' +
        'HOD_RASHOD, G_TOCHKA FROM KASSA'
      '1102171327=              UNION ALL'
      
        '1102171328=              SELECT ACTION_DATE, SUMM NAL, ACTION, G' +
        '_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1102171329=             G_PRIHOD_RASHOD G'
      
        '1102171330=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1102171331=        AND K.ACTION = 1'
      
        '1102171332=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102171333=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1102171334=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    ' +
        '-- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102171335=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1102171336=        INTO :REC_TOVAR_NAME_'
      '1102171337=             ,:SUMM_'
      '1102171338=  DO BEGIN'
      '1102171339=    IF (IS_FIRST_ = 1) then BEGIN'
      '1102171340=      INSERT INTO P_REP_PROFIT_TABLE'
      '1102171341=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1102171342=      VALUES'
      
        '1102171343=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39 +
        ', 1);'
      '1102171344='
      '1102171345=      IS_FIRST_ = 0;'
      '1102171346=    END'
      '1102171347='
      '1102171348=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102171349=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1102171350=    VALUES'
      
        '1102171351=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '1102171352='
      '1102171353=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1102171354=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1102171355=  END'
      '1102171356='
      '1102171357=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1102171358=  IF (SUM_COST_ > 0) then BEGIN'
      '1102171359=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1102171360=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102171361=    insert into p_rep_profit_table'
      
        '1102171362=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102171363=    values'
      
        '1102171364=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1102171365=  END'
      '1102171366=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1102171367=  --*************************************************' +
        '****************************************'
      '1102171368='
      
        '1102171369=  --*************************************************' +
        '****************************************'
      '1102171370=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102171371=  ---------------------------------------------------' +
        '----'
      '1102171372=  IS_FIRST_ = 1;'
      '1102171373=  PROFIT_   = 0;'
      '1102171374=  PRIHOD_ALL_  = 0;'
      '1102171375=  PRIHOD_ALL_NAL_  = 0;'
      '1102171376=  PRIHOD_ALL_BEZNAL_  = 0;'
      '1102171377='
      '1102171378=  FOR SELECT G.NAME,'
      '1102171379=             SUM(K.NAL),'
      '1102171380=             SUM(K.BEZNAL)'
      
        '1102171381=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1102171382=              UNION ALL'
      
        '1102171383=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1102171384=             G_PRIHOD_RASHOD G'
      
        '1102171385=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1102171386=        AND K.ACTION = 0'
      
        '1102171387=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102171388=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1102171389=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102171390=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1102171391=        INTO :REC_TOVAR_NAME_'
      '1102171392=             ,:SUMM_NAL_'
      '1102171393=             ,:SUMM_BEZNAL_'
      '1102171394=  DO BEGIN'
      '1102171395=    IF (IS_FIRST_ = 1) then BEGIN'
      '1102171396=      INSERT INTO P_REP_PROFIT_TABLE'
      '1102171397=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1102171398=      VALUES'
      
        '1102171399=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39 +
        ', 1);'
      '1102171400='
      '1102171401=      IS_FIRST_ = 0;'
      '1102171402=    END'
      '1102171403='
      '1102171404=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102171405=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_' +
        'SUMM, SUMM, PROFIT, IS_HEAD)'
      '1102171406=    VALUES'
      
        '1102171407=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZN' +
        'AL_, 0);'
      '1102171408='
      '1102171409=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '1102171410=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BE' +
        'ZNAL_;'
      
        '1102171411=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      
        '1102171412=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL' +
        '_;'
      '1102171413=  END'
      '1102171414='
      '1102171415=  IF (PROFIT_ > 0) then BEGIN'
      '1102171416=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1102171417=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102171418=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1102171419=    insert into p_rep_profit_table'
      
        '1102171420=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102171421=    values'
      
        '1102171422=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1102171423=  END'
      '1102171424=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1102171425=  --*************************************************' +
        '****************************************'
      '1102171426='
      
        '1102171427=  --*************************************************' +
        '****************************************'
      '1102171428=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102171429=  --*************************************************' +
        '****************************************'
      '1102171430=  IS_FIRST_ = 1;'
      '1102171431=  SUM_COST_ = 0;'
      '1102171432=  PROFIT_   = 0;'
      
        '1102171433=  FOR SELECT SUM(ZD.SUMM)        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040 +
        #1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040 +
        #1044#1054
      '1102171434=           ,TR.PATH'
      '1102171435=      FROM ZAKAZ Z,'
      '1102171436=           ZAKAZ_DETAILS ZD,'
      '1102171437=           G_PRODUCT GP,'
      '1102171438=           P_REP_TREE TR'
      
        '1102171439=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102171440=       AND Z.IS_SPISANIE = 1'
      '1102171441=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102171442=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102171443=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102171444=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102171445=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102171446=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171447=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058 +
        #1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171448=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102171449=     GROUP BY TR.PATH'
      '1102171450=     ORDER BY TR.PATH'
      '1102171451=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '1102171452=  DO BEGIN'
      '1102171453='
      '1102171454=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1102171455=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102171456=      insert into p_rep_profit_table'
      '1102171457=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102171458=      values'
      
        '1102171459=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1102171460='
      '1102171461=      IS_FIRST_ = 0;'
      '1102171462=    END'
      '1102171463='
      '1102171464=    insert into p_rep_profit_table'
      
        '1102171465=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1102171466=    values'
      '1102171467=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1102171468=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZA' +
        'KAZ_, 0);'
      '1102171469='
      '1102171470=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '1102171471=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '1102171472=  END'
      '1102171473='
      '1102171474=  if (SUM_COST_ > 0) then BEGIN'
      '1102171475=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102171476=    insert into p_rep_profit_table'
      
        '1102171477=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102171478=    values'
      
        '1102171479=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0,' +
        ' :SUM_COST_, 0, :PROFIT_, 2);'
      '1102171480='
      '1102171481=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1102171482=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1102171483=  END'
      '1102171484=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1102171485=  --*************************************************' +
        '****************************************'
      '1102171486='
      
        '1102171487=  --*************************************************' +
        '****************************************'
      '1102171488=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102171489=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1102171490=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1102171491=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1102171492='
      
        '1102171493=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1102171494=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1102171495=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1102171496=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      
        '1102171497=  --*************************************************' +
        '****************************************'
      '1102171498=  IS_FIRST_  = 1;'
      '1102171499=  SUM_ZAKAZ_ = 0;'
      '1102171500=  PROFIT_    = 0;'
      '1102171501=  FOR SELECT SUM(S.SUMM)'
      '1102171502=             ,TR.PATH'
      '1102171503=     FROM SKLAD_PARENT SP,'
      '1102171504=          SKLAD S,'
      '1102171505=          G_PRODUCT G,'
      '1102171506=          P_REP_TREE TR'
      
        '1102171507=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA|' +
        '|'#39'-'#39
      
        '1102171508=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1102171509=      AND SP.IS_VOZVRAT IN (1,2)'
      '1102171510=      and G.g_product_PAR = TR.g_product'
      
        '1102171511=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(S.G_CLIENT, 0))'
      
        '1102171512=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYP' +
        'E_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1102171513=      AND SP.SKLAD = S.SKLAD_PARENT'
      '1102171514=      AND S.G_PRODUCT = G.G_PRODUCT'
      '1102171515=      AND ((EXISTS (SELECT 1'
      '1102171516=                       FROM SKLAD SS'
      
        '1102171517=                      WHERE SS.G_CLIENT = :G_SUPPLIER' +
        '_'
      
        '1102171518=                        AND SS.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '1102171519=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102171520=              OR'
      '1102171521=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102171522=     GROUP BY TR.PATH'
      '1102171523=     ORDER BY TR.PATH'
      '1102171524=     INTO :V_SUMM_,'
      '1102171525=          :REC_TOVAR_NAME_'
      '1102171526=  DO BEGIN'
      '1102171527=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1102171528=      insert into p_rep_profit_table'
      '1102171529=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102171530=      values'
      
        '1102171531=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040#39', 1);'
      '1102171532='
      '1102171533=      IS_FIRST_ = 0;'
      '1102171534=    END'
      '1102171535='
      
        '1102171536=    REC_profit_   = 0 - V_SUMM_;    -- 26.05.2016 '#1055#1054#1057 +
        #1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050 +
        #1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1102171537=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102171538=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1102171539=    VALUES'
      
        '1102171540=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :V_SUMM_, :REC_profit_, 0);'
      '1102171541='
      '1102171542=    SUM_COST_ = 0;'
      '1102171543=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '1102171544=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '1102171545=  END'
      '1102171546='
      '1102171547=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1102171548=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1102171549=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1102171550='
      '1102171551=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102171552=    insert into p_rep_profit_table'
      
        '1102171553=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102171554=    values'
      
        '1102171555=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '1102171556=  END'
      '1102171557=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1102171558=  --*************************************************' +
        '****************************************'
      '1102171559='
      
        '1102171560=  --*************************************************' +
        '****************************************'
      
        '1102171561=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102171562=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102171563=  --*************************************************' +
        '****************************************'
      '1102171564=  IS_FIRST_  = 1;'
      '1102171565=  SUM_ZAKAZ_ = 0;'
      '1102171566=  SUM_COST_  = 0;'
      '1102171567=  PROFIT_    = 0;'
      '1102171568=  NDS_SUMM_  = 0;'
      '1102171569=  FOR SELECT SUM(ZD.SUMM)'
      '1102171570=           ,TR.PATH'
      '1102171571=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1102171572=           ,SUM(ZD.nds_summ)'
      '1102171573=      FROM ZAKAZ Z,'
      '1102171574=           ZAKAZ_DETAILS ZD,'
      '1102171575=           G_PRODUCT GP,'
      '1102171576=           P_REP_TREE TR'
      
        '1102171577=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102171578=       AND Z.IS_SPISANIE = 2'
      '1102171579=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102171580=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102171581=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102171582=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102171583=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1102171584=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171585=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058 +
        #1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171586=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102171587=       AND ((EXISTS (SELECT 1'
      '1102171588=                       FROM SKLAD S'
      '1102171589=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1102171590=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1102171591=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102171592=              OR'
      '1102171593=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102171594=     GROUP BY TR.PATH'
      '1102171595=     ORDER BY TR.PATH'
      
        '1102171596=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST' +
        '_, REC_NDS_SUMM_'
      '1102171597=  DO BEGIN'
      '1102171598=    IF (IS_FIRST_ = 1) then BEGIN'
      '1102171599=      insert into p_rep_profit_table'
      '1102171600=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102171601=      values'
      
        '1102171602=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1102171603='
      '1102171604=      IS_FIRST_ = 0;'
      '1102171605=    END'
      '1102171606='
      
        '1102171607=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS' +
        '_SUMM_;'
      '1102171608='
      '1102171609=    insert into p_rep_profit_table'
      
        '1102171610=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1102171611=    values'
      '1102171612=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1102171613=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_,' +
        ' :REC_SUM_COST_, :REC_PROFIT_, 0);'
      '1102171614='
      '1102171615=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '1102171616=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '1102171617=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '1102171618=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '1102171619=  END'
      '1102171620='
      '1102171621=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1102171622=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1102171623=    insert into p_rep_profit_table'
      
        '1102171624=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102171625=    values'
      
        '1102171626=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFI' +
        'T_, 2);'
      '1102171627='
      '1102171628=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1102171629=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1102171630=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1102171631=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '1102171632=  END'
      '1102171633=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102171634=  --*************************************************' +
        '****************************************'
      '1102171635=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1102171636=  insert into p_rep_profit_table'
      '1102171637=    (p_rep_profit_table, is_head)'
      '1102171638=  values'
      '1102171639=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1102171640='
      '1102171641=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1102171642=  insert into p_rep_profit_table'
      
        '1102171643=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102171644=  values'
      
        '1102171645=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1102171646='
      '1102171647=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1102171648=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1102171649=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1102171650=         SUM(Z.SUMM_BONUS)'
      '1102171651=    FROM ZAKAZ Z'
      
        '1102171652=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1102171653=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1102171654=     AND Z.IS_RESERVE = 0'
      '1102171655=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102171656=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102171657=     AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '1102171658=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102171659=     AND ((EXISTS (SELECT 1'
      '1102171660=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1102171661=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1102171662=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1102171663=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1102171664=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102171665=          OR'
      '1102171666=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102171667=    INTO :SUMM_CASH_ALL_,'
      '1102171668=         :SUMM_NONCASH_ALL_,'
      '1102171669=         :SUMM_BONUS_ALL_;'
      '1102171670='
      '1102171671=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '1102171672=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '1102171673=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1102171674='
      '1102171675=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1102171676='
      
        '1102171677=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1102171678=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1102171679='
      '1102171680=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1102171681=    SELECT G.NAME'
      '1102171682=      FROM G_CLIENT G'
      '1102171683=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102171684=    INTO :CLIENT_NAME_;'
      '1102171685=  ELSE'
      '1102171686=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102171687='
      '1102171688=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1102171689=    SELECT G.NAME'
      '1102171690=      FROM G_PAYMENT_TYPE G'
      '1102171691=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1102171692=    INTO :PAYMENT_NAME_;'
      '1102171693=  ELSE'
      '1102171694=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102171695='
      '1102171696=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1102171697=        P.TOVAR_NAME,'
      
        '1102171698=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1102171699=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102171700=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102171701=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1102171702=        P.IS_HEAD'
      
        '1102171703=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1102171704=    ORDER BY 1'
      '1102171705=  INTO :P_REP_PROFIT_TABLE,'
      '1102171706=       :TOVAR_NAME,'
      '1102171707=       :SUMM,'
      '1102171708=       :NDS_SUMM,'
      '1102171709=       :SUM_SELF,'
      '1102171710=       :PROFIT,'
      '1102171711=       :IS_HEAD'
      '1102171712=  DO'
      '1102171713=    suspend;'
      '1102171714='
      '1102171715=WHEN ANY DO BEGIN'
      '1102171716=    Err_code = -20500;'
      
        '1102171717=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102171718=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102171719=  END'
      '1102171720=end'
      '1102171721=;'
      '1102171722='
      '1102171723=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1102171724=RETURNS ('
      '1102171725=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1102171726=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '1102171727=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '1102171728=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '1102171729=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '1102171730=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1102171731=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1102171732=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '1102171733=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '1102171734=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102171735=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102171736=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1102171737=  NOMENCLATUR TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NU' +
        'M,'
      '1102171738=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102171739=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1102171740=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC,'
      '1102171741=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1102171742=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC,'
      '1102171743=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1102171744=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE,'
      '1102171745=  IS_MARKED TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '1102171746=  MARK_CODE TYPE OF COLUMN SKLAD_TMP.MARK_CODE,'
      '1102171747=  VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1102171748=  VES_GRAMM_PRICE TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE)'
      '1102171749=AS'
      '1102171750=BEGIN'
      '1102171751=  FOR'
      
        '1102171752=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T' +
        '.SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.NOMENC' +
        'LATUR_NUM, P.BRAND, P.PRICE'
      '1102171753=           ,PRICE_CURRENCY'
      '1102171754=           ,SUMM_CURRENCY'
      '1102171755=           ,CHARGE_ROZN_PROC'
      '1102171756=           ,PRICE_ROZN'
      '1102171757=           ,CHARGE_OPT_PROC'
      '1102171758=           ,PRICE_OPT'
      '1102171759=           ,CHANGE_SALE_PRICE'
      '1102171760=           ,P.IS_MARKED'
      '1102171761=           ,MARK_CODE'
      '1102171762=           ,P.VES_GRAMM * T.AMOUNT'
      
        '1102171763=           ,DECODE(P.VES_GRAMM, 0, 0, T.SUMM / (P.VES' +
        '_GRAMM * T.AMOUNT))'
      '1102171764=    FROM SKLAD_TMP T,'
      '1102171765=         G_PRODUCT P'
      '1102171766=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1102171767=    ORDER BY T.sklad'
      
        '1102171768=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, ' +
        ':NDS, :NDS_SUMM, :PRODUCT_NAME, :BARCODE, :ARTICUL, :NOMENCLATUR' +
        ', :BRAND, :SALE_PRICE'
      '1102171769=      ,:PRICE_CURRENCY'
      '1102171770=      ,:SUMM_CURRENCY'
      '1102171771=      ,:CHARGE_ROZN_PROC'
      '1102171772=       ,:PRICE_ROZN'
      '1102171773=       ,:CHARGE_OPT_PROC'
      '1102171774=       ,:PRICE_OPT'
      '1102171775=       ,:CHANGE_SALE_PRICE'
      '1102171776=       ,:IS_MARKED'
      '1102171777=       ,:MARK_CODE'
      '1102171778=       ,:VES_GRAMM'
      '1102171779=       ,:VES_GRAMM_PRICE'
      '1102171780=  DO'
      '1102171781=    suspend;'
      '1102171782=end'
      '1102171783=;'
      '1102171784='
      '1102171785='
      
        '1102171786=UPDATE SYSTEM_SETUP SET S_VALUE = 110217 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102171787=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102171788=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102180='
      '1102181=ALTER PROCEDURE UPDATE_ZAKAZ_DETAILS_TMP('
      
        '1102182=  ZAKAZ_DETAILS_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS */ BIGINT,'
      
        '1102183=  AMOUNT_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '1102184=  PRICE_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NU' +
        'MERIC(15,2),'
      
        '1102185=  SUMM_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUME' +
        'RIC(15,2),'
      
        '1102186=  DISCOUNT_PERC_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC */ NUMERIC(15,2),'
      
        '1102187=  DISCOUNT_TENGE_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE */ NUMERIC(15,2),'
      
        '1102188=  DISCOUNT_SUMM_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC */ NUMERIC(15,2),'
      '1102189=  NDS_ /* TYPE OF COLUMN SKLAD.NDS */ NUMERIC(15,2),'
      
        '11021810=  NDS_SUMM_ /* TYPE OF COLUMN SKLAD.NDS_SUMM */ NUMERIC' +
        '(15,2),'
      '11021811=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '11021812=  VES_GRAMM_PRICE_ /* TYPE OF COLUMN G_PRODUCT.VES_GRAM' +
        'M_PRICE */ NUMERIC(15,2),'
      '11021813=  DO_PRODUCT_IN_SALE_ INTEGER = 0)'
      '11021814=RETURNS ('
      '11021815=  ERR_CODE INTEGER,'
      '11021816=  ERR_MSG VARCHAR(1024))'
      '11021817=AS'
      '11021818=BEGIN'
      '11021819=  SUSPEND;'
      '11021820=END'
      '11021821=;'
      '11021822='
      '11021823='
      
        '11021824=/******************************************************' +
        '************************/'
      
        '11021825=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11021826=/******************************************************' +
        '************************/'
      '11021827=ALTER PROCEDURE UPDATE_ZAKAZ_DETAILS_TMP('
      
        '11021828=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '11021829=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11021830=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11021831=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '11021832=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_PERC,'
      
        '11021833=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_TENGE,'
      
        '11021834=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_PERC,'
      '11021835=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '11021836=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '11021837=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '11021838=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM_P' +
        'RICE,'
      '11021839=  DO_PRODUCT_IN_SALE_ INTEGER = 0)'
      '11021840=RETURNS ('
      '11021841=  ERR_CODE INTEGER,'
      '11021842=  ERR_MSG VARCHAR(1024))'
      '11021843=AS'
      '11021844=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '11021845=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ_D' +
        'ETAIL_TMP'#39';'
      '11021846=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11021847=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11021848=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '11021849=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054#1052 +
        ' '#1047#1040#1050#1040#1047#1045' */'
      
        '11021850=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0;' +
        ' /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047#1040 +
        #1050#1040#1047' */'
      
        '11021851=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' */'
      
        '11021852=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.Z_TYPE = 0;'
      
        '11021853=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KI' +
        'T;'
      
        '11021854=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKL' +
        'AD;'
      
        '11021855=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.COST_PRICE;'
      '11021856=BEGIN'
      '11021857='
      '11021858=  SELECT G.IS_KIT'
      '11021859=    FROM G_PRODUCT G, ZAKAZ_DETAILS_TMP T'
      '11021860=   WHERE T.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '11021861=     AND G.G_PRODUCT = T.G_PRODUCT'
      '11021862=    INTO :IS_KIT_;'
      '11021863='
      
        '11021864=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070', '#1040' '#1047#1040#1058#1045#1052' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1040#1053#1040#1051#1048 +
        #1047' '#1055#1054' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1045#1053#1053#1054#1052#1059' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059','
      
        '11021865=  -- '#1048' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1045#1043#1054' '#1057' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045'. '#1045#1057#1051#1048' '#1063#1058#1054', '#1055 +
        #1056#1048' '#1043#1045#1053#1045#1056#1040#1062#1048#1048' '#1054#1064#1048#1041#1050#1048', '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1041#1059#1044#1045#1058' ROLLBACK'
      '11021866=  PNT_ = '#39'01'#39';'
      '11021867=  UPDATE ZAKAZ_DETAILS_TMP t'
      '11021868=     SET t.AMOUNT = :AMOUNT_,'
      '11021869=        t.PRICE = :PRICE_,'
      '11021870=        t.SUMM = :SUMM_,'
      '11021871=        t.DISCOUNT_PERC = :DISCOUNT_PERC_,'
      '11021872=        t.DISCOUNT_TENGE = :DISCOUNT_TENGE_,'
      '11021873=        T.DISCOUNT_SUMM = :DISCOUNT_SUMM_,'
      '11021874=        T.NDS = :NDS_,'
      '11021875=        T.NDS_SUMM = :NDS_SUMM_,'
      '11021876=        T.VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '11021877=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '11021878=  RETURNING'
      '11021879=    ZAKAZ, Z_TYPE'
      '11021880=  INTO'
      '11021881=    :ZAKAZ_, :Z_TYPE_;'
      '11021882='
      
        '11021883=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054#1043#1045 +
        ' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '11021884=  PNT_ = '#39'02'#39';'
      '11021885=  SELECT L.G_PRODUCT,'
      '11021886=         L.AMOUNT - L.AMOUNT_RESERVE'
      '11021887=    FROM ZAKAZ_DETAILS_TMP S,'
      '11021888=         LT_SKLAD_PRODUCT L'
      '11021889=   WHERE S.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '11021890=     AND S.G_PRODUCT = L.G_PRODUCT'
      
        '11021891=     AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHERE ' +
        'CUR_PARAMS = 2)'
      '11021892=    INTO :G_PRODUCT_,'
      '11021893=         :AMOUNT_CUR_;'
      '11021894='
      
        '11021895=  -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1058 +
        #1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '11021896=  -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040#1050#1058#1048#1056#1059 +
        #1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '11021897=  -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048#1063#1045#1057#1058#1042 +
        #1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '11021898=  -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051#1054', '#1047#1040 +
        #1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068#1050#1054
      
        '11021899=  -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068' '#1055#1056#1048#1041 +
        #1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110218100=  PNT_ = '#39'04'#39';'
      '110218101=  IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110218102=      SELECT SUM(AMOUNT)'
      '110218103=        FROM ZAKAZ_DETAILS T'
      '110218104=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110218105=         AND T.ZAKAZ = :ZAKAZ_'
      '110218106=        INTO :AMOUNT_OLD_;'
      '110218107=  ELSE'
      '110218108=      SELECT SUM(AMOUNT)'
      '110218109=        FROM SKLAD T'
      '110218110=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110218111=         AND T.SKLAD_PARENT = :ZAKAZ_'
      '110218112=        INTO :AMOUNT_OLD_;'
      '110218113='
      '110218114=  -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110218115=  PNT_ = '#39'05'#39';'
      '110218116=  SELECT SUM(AMOUNT)'
      '110218117=    FROM ZAKAZ_DETAILS_TMP T'
      '110218118=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110218119=   INTO :AMOUNT_CUR_ZAKAZ_;'
      '110218120='
      
        '110218121=  IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:A' +
        'MOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '110218122=    -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058 +
        #1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110218123=    IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) THEN ' +
        'BEGIN'
      '110218124=        PNT_ = '#39'01'#39';'
      
        '110218125=        EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2),'
      '110218126=                                     CURRENT_DATE,'
      '110218127=                                     :G_PRODUCT_,'
      
        '110218128=                                     ABS(AMOUNT_CUR_ -' +
        ' (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUNT_,'
      
        '110218129=                                     '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086' '#1087#1088#1080 +
        ' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110218130=                                     )'
      
        '110218131=            RETURNING_VALUES :SKLAD_, :COST_PRICE__, :' +
        'ERR_CODE, :ERR_MSG;'
      '110218132=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110218133=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110218134=          EXIT;'
      '110218135=        END'
      '110218136=    END'
      '110218137=    ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '110218138=        ERR_CODE = -20500;'
      
        '110218139=        ERR_MSG = '#39#1055#1086#1089#1083#1077' '#1076#1072#1085#1085#1086#1081' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086 +
        #1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39'||ASCII_CHAR(10)||'
      
        '110218140=                  '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082#1086#1084' '#1079 +
        #1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110218141=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_MS' +
        'G) RETURNING_VALUES (:ERR_MSG);'
      '110218142=        ERR_MSG = PROCNAME||ERR_MSG;'
      '110218143=        EXIT;'
      '110218144=    END'
      '110218145=  END'
      '110218146=when sqlcode -811 DO'
      '110218147=  begin'
      '110218148=    ERR_CODE = -20500;'
      
        '110218149=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1052#1085#1086#1078#1077#1089#1090#1074#1086 +
        ' '#1089#1090#1088#1086#1082' '#1074' '#1086#1076#1080#1085#1086#1095#1085#1086#1084' SELECT!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110218150=    ERR_MSG = PROCNAME||'#39' ->  PNT_ '#39'||PNT_||'#39'. '#39'||ERR_' +
        'MSG;'
      '110218151=  end'
      '110218152=END'
      '110218153=;'
      '110218154='
      '110218155='
      
        '110218156=UPDATE SYSTEM_SETUP SET S_VALUE = 110218 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110218157=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110218158=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102190='
      '1102191=ALTER PROCEDURE UPD_SKLAD_TMP('
      '1102192=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1102193=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1102194=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1102195=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1102196=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1102197=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1102198=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '1102199=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY = ' +
        '0,'
      
        '11021910=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = 0' +
        ')'
      '11021911=RETURNS ('
      '11021912=  ERR_CODE INTEGER,'
      '11021913=  ERR_MSG VARCHAR(1024))'
      '11021914=AS'
      '11021915=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '11021916=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11021917=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11021918=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN SKLAD.AMOUN' +
        'T = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '11021919=DECLARE VARIABLE AMOUNT_CUR_SKLAD_ TYPE OF COLUMN SKLAD' +
        '.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      
        '11021920=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1055#1056#1048#1061#1054#1044#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057 +
        #1054#1047#1044#1040#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044' */'
      
        '11021921=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOUN' +
        'T = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      '11021922=begin'
      '11021923=  PNT_ = '#39'01'#39';'
      '11021924=  UPDATE sklad_TMP ST'
      '11021925=  SET'
      '11021926=    AMOUNT = :AMOUNT_,'
      '11021927=    PRICE = :PRICE_,'
      '11021928=    SUMM = :SUMM_,'
      '11021929=    NDS = :NDS_,'
      '11021930=    NDS_SUMM = :NDS_SUMM_'
      '11021931=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '11021932=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      
        '11021933=    ,CHARGE_ROZN_PROC = (CASE WHEN :PRICE_ > 0 THEN ROU' +
        'ND(((SELECT PRICE FROM G_PRODUCT GG WHERE GG.G_PRODUCT = ST.G_PR' +
        'ODUCT)/:PRICE_ - 1)*100, 2) ELSE 0 END)'
      '11021934=  WHERE'
      '11021935=    sklad = :sklad_'
      '11021936=  RETURNING'
      '11021937=    SKLAD_PARENT'
      '11021938=  INTO'
      '11021939=    SKLAD_PARENT_;'
      '11021940='
      
        '11021941=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054#1043#1045 +
        ' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1053#1054' '#1069#1058#1040' '#1055#1056#1054#1042#1045#1056#1050#1040' '#1053#1059#1046#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058#1057#1071' '#1059#1046#1045 +
        ' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044', '#1054' '#1063#1045#1052' '#1057#1042#1048#1044#1045#1058#1045#1051#1068#1057#1058#1042#1059#1045#1058' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1049' SKLAD_PAR' +
        'ENT_'
      
        '11021942=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SKLA' +
        'D_PARENT_, 0) <> 0)) then BEGIN'
      '11021943=      SELECT L.G_PRODUCT,'
      '11021944=             L.AMOUNT'
      '11021945=        FROM SKLAD S,'
      '11021946=             LT_SKLAD_PRODUCT L'
      '11021947=       WHERE S.SKLAD = :SKLAD_'
      '11021948=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '11021949=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11021950=        INTO :G_PRODUCT_,'
      '11021951=             :AMOUNT_CUR_;'
      '11021952='
      
        '11021953=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056 +
        #1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1055#1056#1048#1061#1054#1044', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '11021954=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1055#1056#1048#1061#1054#1044', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 40, '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068', '#1063#1043#1054#1041#1067' '#1053#1045' '#1059#1064#1051#1054' '#1042' ' +
        #1052#1048#1053#1059#1057
      
        '11021955=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051#1054 +
        ', '#1047#1040#1058#1045#1052' '#1045#1057#1051#1048' '#1057#1058#1040#1056#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1041#1054#1051#1068#1064#1045' '#1053#1054#1042#1054#1043#1054' - '#1047#1053#1040#1063#1048#1058' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056 +
        #1040' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1054#1057#1068','
      '11021956=      -- '#1053#1040#1044#1054' '#1057#1044#1045#1051#1040#1058#1068' '#1063#1058#1054#1041#1067' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1057#1068' '#1053#1045' '#1042' '#1052#1048#1053#1059#1057
      '11021957=      SELECT SUM(AMOUNT)'
      '11021958=        FROM SKLAD T'
      '11021959=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11021960=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '11021961=        INTO :AMOUNT_OLD_;'
      '11021962='
      '11021963=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045
      '11021964=      SELECT SUM(AMOUNT)'
      '11021965=        FROM SKLAD_TMP T'
      '11021966=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11021967=       INTO :AMOUNT_CUR_SKLAD_;'
      '11021968='
      
        '11021969=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD_)' +
        ' THEN BEGIN'
      
        '11021970=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_CUR' +
        '_SKLAD_)) < 0) THEN BEGIN'
      '11021971=            ERR_CODE = -20500;'
      
        '11021972=            ERR_MSG = '#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072 +
        #1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39'||ASCII_CHAR(10)||'
      
        '11021973=                      '#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072 +
        #1084#1084#1099'.'#39';'
      
        '11021974=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR' +
        '_MSG) RETURNING_VALUES (:ERR_MSG);'
      '11021975=            ERR_MSG = PROCNAME||ERR_MSG;'
      '11021976=            EXIT;'
      '11021977=          END'
      '11021978=      END'
      '11021979=  END'
      '11021980=end'
      '11021981=;'
      '11021982='
      '11021983='
      
        '11021984=UPDATE SYSTEM_SETUP SET S_VALUE = 110219 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '11021985=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11021986=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102200='
      '1102201=ALTER PROCEDURE DO_PRODUCT('
      
        '1102202=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T,'
      
        '1102203=  DATE_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT */ D' +
        'ATE,'
      
        '1102204=  G_PRODUCT_IN_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */' +
        ' BIGINT,'
      
        '1102205=  AMOUNT_IN_ /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ N' +
        'UMERIC(18,5),'
      '1102206=  NOTE_ /* TYPE OF COLUMN OTHER.NOTE */ BLOB SUB_TYPE 1,'
      
        '1102207=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ BI' +
        'GINT = NULL,'
      
        '1102208=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SUB_' +
        'TYPE 1 SEGMENT SIZE 16384 = NULL,'
      '1102209=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '11022010=RETURNS ('
      '11022011=  SKLAD_ /* TYPE OF COLUMN OTHER.OTHER */ BIGINT,'
      
        '11022012=  COST_PRICE_ /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(1' +
        '5,2),'
      '11022013=  ERR_CODE INTEGER,'
      '11022014=  ERR_MSG VARCHAR(1024))'
      '11022015=AS'
