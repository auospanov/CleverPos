        'M_RASHOD_ALL_);'
      '1102401693='
      '1102401694=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '1102401695=  VALUES(39, 1);'
      '1102401696='
      
