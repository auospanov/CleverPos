      '11019458=  SUMM NUMERIC(15,2),'
      '11019459=  DISCOUNT_PERC NUMERIC(15,2),'
      '11019460=  DISCOUNT_SUMM NUMERIC(15,2),'
      '11019461=  NDS NUMERIC(15,2),'
      '11019462=  NDS_SUMM NUMERIC(15,2),'
      '11019463=  PRICE_SELF NUMERIC(15,2),'
      '11019464=  SUM_SELF NUMERIC(15,2),'
      '11019465=  PROFIT NUMERIC(15,2),'
      
        '11019466=  IS_HEAD /* TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD ' +
        '*/ INTEGER,'
      '11019467=  ERR_CODE INTEGER,'
      '11019468=  ERR_MSG VARCHAR(1024))'
      '11019469=AS'
      '11019470=BEGIN'
      '11019471=  SUSPEND;'
      '11019472=END'
      '11019473=;'
      '11019474='
      '11019475='
      
        '11019476=/******************************************************' +
        '************************/'
      
        '11019477=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11019478=/******************************************************' +
        '************************/'
      '11019479=ALTER PROCEDURE G_DEL_G_CLIENT('
      '11019480=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11019481=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '11019482=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '11019483=RETURNS ('
      '11019484=  ERR_CODE INTEGER,'
      '11019485=  ERR_MSG VARCHAR(1024))'
      '11019486=AS'
      '11019487=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '11019488=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11019489=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_CLIENT.NAME;'
      '11019490=DECLARE VARIABLE CNT_ INTEGER;'
      '11019491=BEGIN'
      '11019492=  PROCNAME = '#39'G_DEL_G_CLIENT'#39';'
      '11019493='
      '11019494=  if (G_CLIENT_ in (9, 10)) then begin'
      '11019495=    ERR_CODE = -20500;'
      
        '11019496=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1079#1072#1087 +
        #1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '11019497=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '11019498=    EXIT;'
      '11019499=  end'
      '110194100='
      '110194101=  SELECT NAME'
      '110194102=    FROM G_CLIENT G'
      '110194103=   WHERE G.G_CLIENT = :G_CLIENT_'
      '110194104=     INTO :NAME_;'
      '110194105='
      '110194106=  SELECT COUNT(*)'
      '110194107=    FROM ZAKAZ Z'
      '110194108=   WHERE Z.G_CLIENT = :G_CLIENT_'
      '110194109=    INTO :CNT_;'
      '110194110='
      '110194111=  if (CNT_ > 0) then begin'
      '110194112=    ERR_CODE = -20500;'
      
        '110194113=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, NAME_ || '#39 +
        ' '#1091#1095#1072#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1076#1072#1078#1072#1093'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '110194114=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '110194115=    EXIT;'
      '110194116=  end'
      '110194117='
      '110194118=  SELECT COUNT(*)'
      '110194119=    FROM SKLAD S'
      '110194120=   WHERE S.G_CLIENT = :G_CLIENT_'
      '110194121=    INTO :CNT_;'
      '110194122='
      '110194123=  if (CNT_ > 0) then begin'
      '110194124=    ERR_CODE = -20500;'
      
        '110194125=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, NAME_ || '#39 +
        ' '#1091#1095#1072#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1074#1086#1079#1074#1088#1072#1090#1072'/'#1087#1088#1080#1093#1086#1076#1072'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39')' +
        ' RETURNING_VALUES (:ERR_MSG);'
      '110194126=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '110194127=    EXIT;'
      '110194128=  end'
      '110194129='
      '110194130=  delete from G_discont_card g'
      '110194131=    where g.G_CLIENT = :G_CLIENT_;'
      '110194132='
      '110194133=  update sms_history h'
      '110194134=     set h.G_CLIENT = null'
      '110194135=   where h.G_CLIENT = :G_CLIENT_;'
      '110194136='
      '110194137=  delete from G_client g'
      '110194138=    where g.G_CLIENT = :G_CLIENT_;'
      '110194139='
      '110194140=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110194141=  EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_CLI' +
        'ENT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '110194142='
      '110194143=when sqlcode -530 DO'
      '110194144=  begin'
      '110194145=    ERR_CODE = -20500;'
      
        '110194146=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1082#1072#1090#1077#1075#1086#1088#1080#1080'/'#1082#1083#1080#1077#1085#1090#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RE' +
        'TURNING_VALUES (:ERR_MSG);'
      '110194147=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194148=  end'
      '110194149=end'
      '110194150=;'
      '110194151='
      '110194152=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '110194153=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110194154=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110194155=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110194156=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110194157=RETURNS ('
      '110194158=  ERR_CODE INTEGER,'
      '110194159=  ERR_MSG VARCHAR(1024))'
      '110194160=AS'
      
        '110194161=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODU' +
        'CT'#39';'
      '110194162=DECLARE VARIABLE CNT_ INTEGER;'
      '110194163=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110194164=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110194165=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110194166=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110194167=BEGIN'
      '110194168=  /*IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110194169=                FROM G_PRODUCT'
      
        '110194170=               WHERE G_PRODUCT_PAR = :G_PRODUCT_)) the' +
        'n BEGIN'
      '110194171=    ERR_CODE = -20500;'
      
        '110194172=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076 +
        #1072#1083#1080#1090#1100' '#1076#1072#1085#1085#1091#1102' '#1075#1088#1091#1087#1087#1091', '#1090'.'#1082'. '#1074' '#1085#1077#1081' '#1089#1086#1089#1090#1086#1103#1090' '#1090#1086#1074#1072#1088#1099'/'#1075#1088#1091#1087#1087#1099'. '#1059#1076#1072#1083#1080#1090#1077' '#1074 +
        #1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110194173=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194174=    EXIT;'
      '110194175=  END'
      '110194176=  */'
      '110194177='
      
        '110194178=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', '#39 +
        ')'
      '110194179=                    FROM g_product_kit K, g_product g'
      
        '110194180=                   WHERE K.g_product_item = :G_PRODUCT' +
        '_'
      
        '110194181=                     and k.g_product = g.g_product) FR' +
        'OM 1 FOR 999)'
      '110194182=  FROM RDB$DATABASE'
      '110194183=   INTO :PROD_NAME_;'
      '110194184=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '110194185=    ERR_CODE = -20500;'
      
        '110194186=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083#1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'. '#1059#1076#1072#1083#1080#1090 +
        #1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110194187=                                  '#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090 +
        #1077' '#1077#1075#1086' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1072' '#1090#1086#1074#1072#1088#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110194188=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194189=    EXIT;'
      '110194190=  END'
      '110194191='
      
        '110194192=  /*SELECT ZA.zakaz||'#39' '#1086#1090' '#39'||lpad(extract(day from ZA.' +
        'Z_DATE),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from ZA.Z_DATE),2,'#39'0' +
        #39') || '#39'.'#39' || extract(year from ZA.Z_DATE)'
      '110194193=    FROM ZAKAZ ZA'
      '110194194=   WHERE ZA.zakaz = (SELECT MIN(Z.ZAKAZ)'
      '110194195=                        FROM ZAKAZ_DETAILS Z'
      
        '110194196=                       WHERE Z.G_PRODUCT = :G_PRODUCT_' +
        ')'
      '110194197=  INTO :NAKL_PROD_;'
      '110194198=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110194199=    ERR_CODE = -20500;'
      
        '110194200=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1091#1093#1086#1076#1072' ('#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110194201='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        #39'||'#39
      
        '110194202='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110194203=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194204=    EXIT;'
      '110194205=  END'
      '110194206='
      
        '110194207=  SELECT SP.sklad||'#39' '#1086#1090' '#39'||lpad(extract(day from SP.da' +
        'te_receipt),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from SP.date_rec' +
        'eipt),2,'#39'0'#39') || '#39'.'#39' || extract(year from SP.date_receipt)'
      '110194208=    FROM sklad_parent SP'
      '110194209=   WHERE SP.sklad = ( SELECT MIN(S.sklad_parent)'
      '110194210=                        FROM sklad s'
      
        '110194211=                       WHERE s.G_PRODUCT = :G_PRODUCT_' +
        ')'
      '110194212=    INTO :NAKL_PROD_;'
      '110194213=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110194214=    ERR_CODE = -20500;'
      
        '110194215=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1087#1088#1080#1093#1086#1076#1072' ('#1086#1087#1088#1080#1093#1086#1076#1086#1074#1072#1085#1080#1077'/'#1074#1086#1079#1074#1088#1072#1090'/'#1087#1077#1088#1077#1084 +
        #1077#1097#1077#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110194216='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        ' '#39'||'#39
      
        '110194217='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110194218=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194219=    EXIT;'
      '110194220=  END'
      '110194221='
      
        '110194222=  SELECT lpad(extract(day from MIN(za.op_date)),2,'#39'0'#39')' +
        ' || '#39'.'#39' || lpad(extract(month from MIN(za.op_date)),2,'#39'0'#39') || '#39'.' +
        #39' || extract(year from MIN(za.op_date))'
      '110194223=    FROM OTHER ZA, OTHER_DETAILS Z'
      '110194224=   WHERE ZA.OTHER = Z.other'
      '110194225=     AND Z.G_PRODUCT = :G_PRODUCT_'
      '110194226=  INTO :NAKL_PROD_;'
      '110194227=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110194228=    ERR_CODE = -20500;'
      
        '110194229=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072' '#1086#1090' '#39'||NAKL_PROD_||'#39' '#1095#1080#1089#1083#1072'.' +
        ' '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110194230=                                  '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090 +
        #1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080 +
        #1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110194231=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194232=    EXIT;'
      '110194233=  END'
      '110194234=  */'
      '110194235='
      '110194236=  SELECT G.NAME'
      '110194237=    FROM G_PRODUCT G'
      '110194238=   WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110194239=    INTO :NAME_;'
      '110194240='
      '110194241=  delete from LT_SKLAD_PRODUCT g'
      '110194242=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110194243='
      '110194244=  delete from lt_barcode g'
      '110194245=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110194246='
      '110194247=  delete from revision g'
      '110194248=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110194249='
      '110194250=  delete from g_product_image g'
      '110194251=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110194252='
      '110194253=  delete from g_product_KIT g'
      '110194254=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110194255='
      '110194256=  delete from G_DISCOUNT g'
      '110194257=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110194258='
      '110194259=  SELECT ('
      
        '110194260=          (SELECT COUNT(*) FROM ZAKAZ_DETAILS ZD WHERE' +
        ' ZD.G_PRODUCT = :G_PRODUCT_)'
      '110194261=          +'
      
        '110194262=          (SELECT COUNT(*) FROM SKLAD SD WHERE SD.G_PR' +
        'ODUCT = :G_PRODUCT_)'
      '110194263=          +'
      
        '110194264=          (SELECT COUNT(*) FROM OTHER_DETAILS OD WHERE' +
        ' OD.G_PRODUCT = :G_PRODUCT_)'
      '110194265=          +'
      
        '110194266=          (SELECT COUNT(*) FROM ZAKAZ_NA_REAL RD WHERE' +
        ' RD.G_PRODUCT = :G_PRODUCT_)'
      '110194267=         )'
      '110194268=    FROM RDB$DATABASE'
      '110194269=    INTO :CNT_;'
      '110194270='
      
        '110194271=  -- 18.05.2021 '#1057' '#1058#1048#1052#1054#1049' '#1056#1045#1064#1048#1051#1048', '#1045#1057#1051#1048' '#1060#1048#1047#1048#1063#1045#1057#1050#1048' '#1059' '#1052#1045#1053#1071' ' +
        #1058#1054#1042#1040#1056' '#1053#1045' '#1059#1044#1040#1051#1071#1045#1058#1057#1071', '#1058#1054' '#1045#1052#1059' '#1071' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1042#1067#1057#1067#1051#1040#1070', '#1055#1059#1057#1058#1068' '#1041#1054#1051#1058#1040#1045#1058#1057#1071',' +
        ' '#1055#1054#1050#1040' '#1041#1045#1047' '#1055#1056#1048#1047#1053#1040#1050#1040' '#1058#1040#1052' '#1054#1041#1054#1049#1044#1045#1052#1057#1071
      
        '110194272=  -- '#1053#1054' '#1055#1056#1048' '#1069#1058#1054#1052' '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1040#1055#1044#1045#1049#1058' G_PRODUCT_PAR, '#1063#1058#1054 +
        #1041#1067' '#1045#1057#1051#1048' '#1063#1058#1054' '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1040' '#1052#1054#1043#1051#1040' '#1059#1044#1040#1051#1048#1058#1057#1071
      '110194273=  IF (CNT_ = 0) THEN BEGIN'
      
        '110194274=    delete from G_PRODUCT g where g.G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '110194275='
      
        '110194276=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110194277=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110194278=      UPDATE SYNC_EXT_APP AP'
      '110194279=         SET AP.OPER = 3'
      '110194280=       WHERE AP.OBJECT_TYPE = 4'
      '110194281=         AND AP.ID = :G_PRODUCT_'
      '110194282=         AND AP.IS_LOADING = 0;'
      '110194283='
      '110194284=      IF (ROW_COUNT = 0) THEN'
      
        '110194285=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110194286=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 3);'
      '110194287=    END'
      '110194288=  END ELSE BEGIN'
      '110194289=    UPDATE G_PRODUCT G'
      '110194290=       SET G.IS_ACTIVE = 0,'
      '110194291=           G.G_PRODUCT_PAR = -1'
      '110194292=     WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110194293='
      
        '110194294=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER)'
      
        '110194295=      SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRODUC' +
        'T_, 2'
      '110194296=        FROM RDB$DATABASE'
      
        '110194297=       WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP' +
        ' WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_LOAD' +
        'ING = 0);'
      '110194298=  END'
      '110194299='
      '110194300=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110194301=  EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_PRO' +
        'DUCT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '110194302='
      '110194303=when sqlcode -530 DO'
      '110194304=  begin'
      '110194305=    SELECT G.IS_CATEGORY'
      '110194306=      FROM G_PRODUCT G'
      '110194307=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110194308=      INTO :IS_CATEGORY_;'
      '110194309='
      '110194310=    ERR_CODE = -20500;'
      '110194311=    if (IS_CATEGORY_ = 0) then'
      
        '110194312=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '110194313=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076 +
        #1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081 +
        #1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110194314=    ELSE'
      
        '110194315=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110194316=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194317=  end'
      '110194318=end'
      '110194319=;'
      '110194320='
      '110194321=ALTER PROCEDURE G_DEL_G_PRODUCT_CAT('
      '110194322=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110194323=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110194324=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110194325=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110194326=RETURNS ('
      '110194327=  LOG_ BLOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      '110194328=  SUCCESS_CNT_ INTEGER,'
      '110194329=  FAIL_CNT_ INTEGER,'
      '110194330=  ERR_CODE INTEGER,'
      '110194331=  ERR_MSG VARCHAR(1024))'
      '110194332=AS'
      
        '110194333=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODU' +
        'CT_CAT'#39';'
      '110194334=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110194335=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110194336=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110194337=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110194338=DECLARE VARIABLE G_PRODUCT_CAT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110194339=DECLARE VARIABLE G_PRODUCT_LOC_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      '110194340=DECLARE VARIABLE LVL_ INTEGER;'
      '110194341=DECLARE VARIABLE STR1_ VARCHAR(500);'
      '110194342=DECLARE VARIABLE STR2_ VARCHAR(500);'
      
        '110194343=DECLARE VARIABLE CATEGORY_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      '110194344=DECLARE VARIABLE CRLF VARCHAR(5);'
      '110194345=BEGIN'
      '110194346=  LOG_ = '#39#39';'
      '110194347=  SUCCESS_CNT_ = 0;'
      '110194348=  FAIL_CNT_ = 0;'
      '110194349=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110194350='
      '110194351=  FOR WITH RECURSIVE TREE AS (SELECT T.G_PRODUCT,'
      '110194352=                                   1 LVL,'
      '110194353=                                   T.NAME'
      '110194354=                              FROM G_PRODUCT T'
      '110194355=                             WHERE T.IS_CATEGORY = 1'
      
        '110194356=                               AND T.G_PRODUCT = :G_PR' +
        'ODUCT_'
      '110194357=                            UNION ALL'
      '110194358=                            SELECT T.G_PRODUCT,'
      '110194359=                                   (GG.LVL + 1) LVL,'
      '110194360=                                   T.NAME'
      
        '110194361=                              FROM G_PRODUCT T INNER J' +
        'OIN TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '110194362=                             WHERE T.IS_CATEGORY = 1'
      '110194363=                        )'
      
        '110194364=    SELECT G_PRODUCT, LVL, NAME FROM TREE ORDER BY 2 D' +
        'ESC'
      '110194365=    INTO :G_PRODUCT_CAT_, :LVL_, :CATEGORY_NAME_'
      '110194366=  DO BEGIN'
      '110194367='
      
        '110194368=    -- '#1059#1044#1040#1051#1071#1070' '#1057#1053#1040#1063#1040#1051#1040' '#1058#1045#1061', '#1063#1058#1054' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061'/' +
        #1055#1056#1048#1061#1054#1044#1040#1061
      '110194369=    FOR SELECT P.G_PRODUCT,'
      '110194370=               '#39#1058#1086#1074#1072#1088' '#39'|| P.NAME,'
      
        '110194371=               '#39#1058#1086#1074#1072#1088' '#39'||P.NAME||'#39' (ID'#39' || P.G_PRODUCT' +
        ' || '#39'), '#1072#1088#1090#1080#1082#1091#1083' '#39'||P.ARTICUL'
      '110194372=        FROM G_PRODUCT P'
      '110194373=        WHERE G_PRODUCT_PAR = :G_PRODUCT_CAT_'
      
        '110194374=        AND EXISTS (SELECT 1 FROM ZAKAZ_DETAILS WHERE ' +
        'G_PRODUCT = P.G_PRODUCT'
      '110194375=                  UNION ALL'
      
        '110194376=                  SELECT 1 FROM SKLAD SD WHERE SD.G_PR' +
        'ODUCT = P.G_PRODUCT'
      '110194377=                  UNION ALL'
      
        '110194378=                  SELECT 1 FROM OTHER_DETAILS OD WHERE' +
        ' OD.G_PRODUCT = P.G_PRODUCT'
      '110194379=                  UNION ALL'
      
        '110194380=                  SELECT 1 FROM ZAKAZ_NA_REAL RD WHERE' +
        ' RD.G_PRODUCT = P.G_PRODUCT'
      '110194381=                 )'
      '110194382=        INTO :G_PRODUCT_LOC_,'
      '110194383=             :STR1_,'
      '110194384=             :STR2_'
      '110194385=    DO BEGIN'
      '110194386=      PROD_NAME_ = '#39#39';'
      
        '110194387=      SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', ' +
        #39', '#39')'
      
        '110194388=                        FROM g_product_kit K, g_produc' +
        't g'
      
        '110194389=                       WHERE K.g_product_item = :G_PRO' +
        'DUCT_LOC_'
      
        '110194390=                         and k.g_product = g.g_product' +
        ') FROM 1 FOR 999)'
      '110194391=      FROM RDB$DATABASE'
      '110194392=       INTO :PROD_NAME_;'
      '110194393='
      '110194394=      IF (PROD_NAME_ IS NOT NULL) THEN BEGIN'
      
        '110194395=        LOG_ = LOG_ || STR1_||'#39' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083 +
        #1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'.'#39'||CRLF;'
      '110194396=        FAIL_CNT_ = FAIL_CNT_ + 1;'
      '110194397=        UPDATE G_PRODUCT D'
      '110194398=           SET D.G_PRODUCT_PAR = -1'
      '110194399=         WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194400='
      '110194401=      END ELSE BEGIN'
      '110194402='
      
        '110194403=          -- '#1059#1044#1040#1051#1071#1070' '#1057#1053#1040#1063#1040#1051#1040' '#1058#1045#1061', '#1063#1058#1054' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054 +
        #1044#1040#1046#1040#1061'/'#1055#1056#1048#1061#1054#1044#1040#1061
      
        '110194404=          INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERA' +
        'TION, G_OFFICIAL,'
      '110194405=            ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110194406=          VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIM' +
        'ESTAMP, 3, :USER_ID_, 13, :G_PRODUCT_LOC_, :STR1_, :STR2_);'
      '110194407='
      '110194408=          delete from LT_SKLAD_PRODUCT g'
      '110194409=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194410='
      '110194411=          delete from lt_barcode g'
      '110194412=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194413='
      '110194414=          delete from revision g'
      '110194415=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194416='
      '110194417=          delete from g_product_image g'
      '110194418=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194419='
      '110194420=          delete from g_product_KIT g'
      '110194421=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194422='
      '110194423=          delete from G_DISCOUNT g'
      '110194424=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194425='
      '110194426=          UPDATE G_PRODUCT D'
      '110194427=             SET D.IS_ACTIVE = 0,'
      '110194428=                 D.G_PRODUCT_PAR = -1'
      '110194429=           WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194430='
      
        '110194431=          -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071 +
        #1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      
        '110194432=          -- 18.05.2021 '#1057' '#1058#1048#1052#1054#1049' '#1056#1045#1064#1048#1051#1048', '#1045#1057#1051#1048' '#1060#1048#1047#1048#1063#1045#1057#1050#1048 +
        ' '#1059' '#1052#1045#1053#1071' '#1058#1054#1042#1040#1056' '#1053#1045' '#1059#1044#1040#1051#1071#1045#1058#1057#1071', '#1058#1054' '#1045#1052#1059' '#1071' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1042#1067#1057#1067#1051#1040#1070', '#1055#1059#1057#1058#1068' '#1041#1054 +
        #1051#1058#1040#1045#1058#1057#1071', '#1055#1054#1050#1040' '#1041#1045#1047' '#1055#1056#1048#1047#1053#1040#1050#1040' '#1058#1040#1052' '#1054#1041#1054#1049#1044#1045#1052#1057#1071
      
        '110194433=          -- '#1053#1054' '#1055#1056#1048' '#1069#1058#1054#1052' '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1040#1055#1044#1045#1049#1058' G_PRODUCT_' +
        'PAR, '#1063#1058#1054#1041#1067' '#1045#1057#1051#1048' '#1063#1058#1054' '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1040' '#1052#1054#1043#1051#1040' '#1059#1044#1040#1051#1048#1058#1057#1071
      '110194434=          IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      
        '110194435=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110194436=              SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :' +
        'G_PRODUCT_LOC_, 2'
      '110194437=                FROM RDB$DATABASE'
      
        '110194438=               WHERE NOT EXISTS (SELECT 1 FROM SYNC_EX' +
        'T_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_LOC_ AN' +
        'D AP.IS_LOADING = 0);'
      '110194439=          END'
      '110194440=          /*'
      '110194441=            UPDATE SYNC_EXT_APP AP'
      '110194442=               SET AP.OPER = 3'
      '110194443=             WHERE AP.OBJECT_TYPE = 4'
      '110194444=               AND AP.ID = :G_PRODUCT_LOC_'
      '110194445=               AND AP.IS_LOADING = 0;'
      '110194446='
      '110194447=            IF (ROW_COUNT = 0) THEN'
      
        '110194448=                INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP' +
        ', OBJECT_TYPE, ID, OPER)'
      
        '110194449=                VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4' +
        ', :G_PRODUCT_LOC_, 3);'
      '110194450=          */'
      '110194451='
      '110194452=          SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110194453=      END'
      '110194454=    END'
      '110194455='
      '110194456='
      
        '110194457=    -- '#1058#1045#1055#1045#1056#1068' '#1059#1044#1040#1051#1071#1070' '#1058#1045#1061', '#1063#1058#1054' '#1053#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040 +
        #1061'/'#1055#1056#1048#1061#1054#1044#1040#1061
      '110194458=    FOR SELECT P.G_PRODUCT,'
      '110194459=               '#39#1058#1086#1074#1072#1088' '#39'|| P.NAME,'
      
        '110194460=               '#39#1058#1086#1074#1072#1088' '#39'||P.NAME||'#39' (ID'#39' || P.G_PRODUCT' +
        ' || '#39'), '#1072#1088#1090#1080#1082#1091#1083' '#39'||P.ARTICUL'
      '110194461=        FROM G_PRODUCT P'
      '110194462=        WHERE G_PRODUCT_PAR = :G_PRODUCT_CAT_'
      
        '110194463=        AND NOT EXISTS (SELECT 1 FROM ZAKAZ_DETAILS WH' +
        'ERE G_PRODUCT = P.G_PRODUCT'
      '110194464=                          UNION ALL'
      
        '110194465=                          SELECT 1 FROM SKLAD SD WHERE' +
        ' SD.G_PRODUCT = P.G_PRODUCT'
      '110194466=                          UNION ALL'
      
        '110194467=                          SELECT 1 FROM OTHER_DETAILS ' +
        'OD WHERE OD.G_PRODUCT = P.G_PRODUCT'
      '110194468=                          UNION ALL'
      
        '110194469=                          SELECT 1 FROM ZAKAZ_NA_REAL ' +
        'RD WHERE RD.G_PRODUCT = P.G_PRODUCT'
      '110194470=                         )'
      '110194471=        INTO :G_PRODUCT_LOC_,'
      '110194472=             :STR1_,'
      '110194473=             :STR2_'
      '110194474=    DO BEGIN'
      '110194475=      PROD_NAME_ = '#39#39';'
      
        '110194476=      SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', ' +
        #39', '#39')'
      
        '110194477=                        FROM g_product_kit K, g_produc' +
        't g'
      
        '110194478=                       WHERE K.g_product_item = :G_PRO' +
        'DUCT_LOC_'
      
        '110194479=                         and k.g_product = g.g_product' +
        ') FROM 1 FOR 999)'
      '110194480=      FROM RDB$DATABASE'
      '110194481=       INTO :PROD_NAME_;'
      '110194482='
      '110194483=      IF (PROD_NAME_ IS NOT NULL) THEN BEGIN'
      
        '110194484=        LOG_ = LOG_ || STR1_||'#39' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083 +
        #1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'.'#39'||CRLF;'
      '110194485=        FAIL_CNT_ = FAIL_CNT_ + 1;'
      '110194486=        UPDATE G_PRODUCT D'
      '110194487=           SET D.G_PRODUCT_PAR = -1'
      '110194488=         WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194489='
      '110194490=      END ELSE BEGIN'
      '110194491='
      
        '110194492=          INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERA' +
        'TION, G_OFFICIAL,'
      '110194493=            ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110194494=          VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIM' +
        'ESTAMP, 3, :USER_ID_, 13, :G_PRODUCT_LOC_, :STR1_, :STR2_);'
      '110194495='
      '110194496=          delete from LT_SKLAD_PRODUCT g'
      '110194497=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194498='
      '110194499=          delete from lt_barcode g'
      '110194500=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194501='
      '110194502=          delete from revision g'
      '110194503=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194504='
      '110194505=          delete from g_product_image g'
      '110194506=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194507='
      '110194508=          delete from g_product_KIT g'
      '110194509=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194510='
      '110194511=          delete from G_DISCOUNT g'
      '110194512=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194513='
      '110194514=          DELETE FROM G_PRODUCT C'
      '110194515=           WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110194516='
      
        '110194517=          -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071 +
        #1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110194518=          IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110194519=            UPDATE SYNC_EXT_APP AP'
      '110194520=               SET AP.OPER = 3'
      '110194521=             WHERE AP.OBJECT_TYPE = 4'
      '110194522=               AND AP.ID = :G_PRODUCT_LOC_'
      '110194523=               AND AP.IS_LOADING = 0;'
      '110194524='
      '110194525=            IF (ROW_COUNT = 0) THEN'
      
        '110194526=                INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP' +
        ', OBJECT_TYPE, ID, OPER)'
      
        '110194527=                VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4' +
        ', :G_PRODUCT_LOC_, 3);'
      '110194528=          END'
      '110194529='
      '110194530=          SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110194531=      END'
      '110194532=    END'
      '110194533='
      
        '110194534=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION, ' +
        'G_OFFICIAL,'
      '110194535=      ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110194536=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAMP' +
        ', 3, :USER_ID_, 13, :G_PRODUCT_CAT_,'
      '110194537=        '#39#1043#1088#1091#1087#1087#1072' '#1090#1086#1074#1072#1088#1086#1074' '#39'||:CATEGORY_NAME_,'
      
        '110194538=        '#39#1043#1088#1091#1087#1087#1072' '#1090#1086#1074#1072#1088#1086#1074' '#39'||:CATEGORY_NAME_ || '#39' (ID'#39' |' +
        '| :G_PRODUCT_CAT_ || '#39')'#39');'
      '110194539='
      '110194540=    DELETE FROM G_PRODUCT C'
      '110194541=     WHERE G_PRODUCT = :G_PRODUCT_CAT_;'
      '110194542='
      
        '110194543=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110194544=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110194545=        UPDATE SYNC_EXT_APP AP'
      '110194546=           SET AP.OPER = 3'
      '110194547=         WHERE AP.OBJECT_TYPE = 4'
      '110194548=           AND AP.ID = :G_PRODUCT_CAT_'
      '110194549=           AND AP.IS_LOADING = 0;'
      '110194550='
      '110194551=        IF (ROW_COUNT = 0) THEN'
      
        '110194552=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110194553=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G' +
        '_PRODUCT_CAT_, 3);'
      '110194554=    END'
      '110194555='
      '110194556=    SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110194557=  END'
      '110194558='
      '110194559=  IF (FAIL_CNT_ = 0) THEN'
      
        '110194560=    LOG_ = '#39#1059#1076#1072#1083#1077#1085#1086' '#1091#1089#1087#1077#1096#1085#1086': '#39' || SUCCESS_CNT_ || '#39' '#1079#1072 +
        #1087#1080#1089#1077#1081'(-'#1080').'#39';'
      '110194561=  ELSE'
      
        '110194562=    LOG_ = '#39#1059#1076#1072#1083#1077#1085#1086' '#1091#1089#1087#1077#1096#1085#1086': '#39' || SUCCESS_CNT_ || '#39' '#1079#1072 +
        #1087#1080#1089#1077#1081'(-'#1080').'#39'||CRLF||'
      
        '110194563=        '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080': '#39' || FAIL_CNT_ || '#39' '#1079#1072#1087#1080 +
        #1089#1077#1081'(-'#1080').'#39'||CRLF||CRLF||'
      
        '110194564=        '#39#1057#1083#1077#1076#1091#1102#1097#1080#1077' '#1090#1086#1074#1072#1088#1099' '#1091#1076#1072#1083#1080#1090#1100' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#1054#1085#1080' '#1073#1099#1083#1080 +
        ' '#1087#1077#1088#1077#1085#1077#1089#1077#1085#1099' '#1074' '#1075#1088#1091#1087#1087#1091' "'#1041#1077#1079' '#1075#1088#1091#1087#1087#1099'".'#39'||CRLF||'#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090#1077 +
        ' '#1080#1093' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1086#1074' '#1090#1086#1074#1072#1088#1086#1074'.'#39'||CRLF||'
      '110194565=        '#39'==========================='#39'||CRLF||LOG_;'
      '110194566='
      '110194567=WHEN ANY DO BEGIN'
      '110194568=    ERR_CODE = -20500;'
      
        '110194569=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073#1082#1072' '#1087#1088 +
        #1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1075#1088#1091#1087#1099#1099'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110194570=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110194571=  END'
      '110194572=END'
      '110194573=;'
      '110194574='
      '110194575=ALTER PROCEDURE P_REP_AVERAGE_TOVBILL('
      '110194576=  DATE_BEGIN_ DATE,'
      '110194577=  DATE_END_ DATE,'
      '110194578=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110194579=RETURNS ('
      '110194580=  CNT_BILLS_ INTEGER,'
      '110194581=  CNT_TOVS_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110194582=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '110194583=  ERR_CODE INTEGER,'
      '110194584=  ERR_MSG VARCHAR(1024))'
      '110194585=AS'
      
        '110194586=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_AVERAGE' +
        '_TOVBILL'#39';'
      '110194587=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110194588=BEGIN'
      '110194589=  SUMM_ = 0;'
      '110194590='
      '110194591=  SELECT COUNT(*)'
      '110194592=    FROM ZAKAZ ZZ'
      '110194593=   WHERE ZZ.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110194594=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOCHKA||'#39 +
        '-'#39
      '110194595=    INTO :CNT_BILLS_;'
      '110194596='
      '110194597=  SELECT SUM(ZD.AMOUNT)'
      '110194598=    FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      '110194599=   WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110194600=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110194601=     AND Z.ZAKAZ = ZD.ZAKAZ'
      '110194602=    INTO :CNT_TOVS_;'
      '110194603='
      '110194604=  SUMM_ = ROUND( CNT_TOVS_ / CNT_BILLS_, 2);'
      '110194605='
      '110194606=WHEN ANY DO BEGIN'
      '110194607=    Err_code = -20500;'
      
        '110194608=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' "'#1057#1056#1045#1044#1053#1045#1045' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1063#1045#1050#1045'"!'#39') RETURNIN' +
        'G_VALUES (:ERR_MSG);'
      
        '110194609=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110194610=  END'
      '110194611=end'
      '110194612=;'
      '110194613='
      '110194614=ALTER PROCEDURE P_REP_BILL('
      '110194615=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110194616=  SUMM_DANO_ NUMERIC(15,2),'
      '110194617=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110194618=  CURRENCY_ INTEGER,'
      '110194619=  MODE_ INTEGER,'
      '110194620=  PRINT_SLOGAN_ VARCHAR(80),'
      '110194621=  DECIMAL_ INTEGER,'
      '110194622=  BONUS_ NUMERIC(15,2),'
      '110194623=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS)'
      '110194624=RETURNS ('
      '110194625=  FIRM_NAME_ VARCHAR(600),'
      '110194626=  IDN_STR_ VARCHAR(30),'
      '110194627=  FIRM_IDN_ VARCHAR(50),'
      '110194628=  FIRM_ADDRESS_ VARCHAR(550),'
      '110194629=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110194630=  DATE_ VARCHAR(100),'
      '110194631=  PAYMENT_TYPE_ VARCHAR(100),'
      '110194632=  G_CLIENT_NAME_ VARCHAR(300),'
      '110194633=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110194634=  SUMM_VSEGO_ VARCHAR(50),'
      '110194635=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110194636=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110194637=  ROW_NUM INTEGER,'
      '110194638=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110194639=  NAME_ART VARCHAR(1000),'
      '110194640=  AMOUNT VARCHAR(50),'
      '110194641=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110194642=  PRICE VARCHAR(50),'
      '110194643=  PRICE_N VARCHAR(50),'
      '110194644=  SUMM VARCHAR(50),'
      '110194645=  SUMM_N VARCHAR(50),'
      '110194646=  SUMM_POLUCH_ VARCHAR(50),'
      '110194647=  SUMM_SDACH_ VARCHAR(50),'
      '110194648=  SUMM_STR_ VARCHAR(200),'
      '110194649=  SLOGAN_ VARCHAR(80),'
      '110194650=  SUMM_SKIDKA_ VARCHAR(50),'
      '110194651=  SUMM_SERVICE_ VARCHAR(50),'
      '110194652=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110194653=  BONUS_STR_ VARCHAR(100),'
      '110194654=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '110194655=  ERR_CODE NUMERIC(15,2),'
      '110194656=  ERR_MSG VARCHAR(1024))'
      '110194657=AS'
      '110194658=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '110194659=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '110194660=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110194661=DECLARE VARIABLE I INTEGER = 1;'
      
        '110194662=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110194663=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110194664=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.AMOUNT;'
      
        '110194665=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110194666=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      
        '110194667=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.SUMM;'
      '110194668=BEGIN'
      '110194669=  SLOGAN_ = PRINT_SLOGAN_;'
      '110194670='
      '110194671=  IF (BONUS_ > 0) THEN BEGIN'
      
        '110194672=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_, 2) AS VARCHAR(100));'
      '110194673=  END'
      '110194674='
      '110194675=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '110194676=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_' +
        ';'
      '110194677=  END'
      '110194678='
      '110194679=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110194680=  SELECT z.ZAKAZ'
      '110194681=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '110194682=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')' +
        '||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '110194683=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '110194684=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COAL' +
        'ESCE(O.NM, '#39#39')'
      '110194685=         ,Z.summ_noncash'
      '110194686=         ,Z.summ_cash'
      '110194687=         ,Z.NOTE'
      
        '110194688=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '110194689=         G_CLIENT G,'
      '110194690=         G_PAYMENT_TYPE P'
      '110194691=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110194692=     AND Z.G_CLIENT = G.G_CLIENT'
      '110194693=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110194694=    INTO :NUM_'
      '110194695=        ,:PAYMENT_TYPE_'
      '110194696=        ,:DATE_'
      '110194697=        ,:G_CLIENT_NAME_'
      '110194698=        ,:G_OFFICIAL_FM_'
      '110194699=        ,:SUMM_NONCASH_'
      '110194700=        ,:SUMM_CASH_'
      '110194701=        ,:NOTE_'
      '110194702=        ;'
      '110194703='
      '110194704=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110194705=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110194706='
      '110194707=  SELECT R.G_FIRM_REKVIZIT,'
      '110194708=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110194709=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110194710=    FROM G_FIRM_REKVIZIT R'
      '110194711=   WHERE R.is_default = 1'
      '110194712=    INTO :G_FIRM_REKVIZIT_,'
      '110194713=         :FIRM_NAME_,'
      '110194714=         :FIRM_IDN_;'
      '110194715='
      '110194716=  SELECT ZD.SUMM'
      '110194717=    FROM ZAKAZ_DETAILS ZD'
      '110194718=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110194719=    AND ZD.G_PRODUCT = -2'
      '110194720=    INTO :SERVICE_SUMM_;'
      '110194721=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110194722='
      '110194723=  SELECT SUM(ZD.AMOUNT),'
      
        '110194724=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCH' +
        'AR(50)),'
      
        '110194725=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2' +
        ') AS VARCHAR(50)),'
      
        '110194726=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110194727=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '110194728=  FROM ZAKAZ_DETAILS ZD'
      '110194729=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110194730=    AND ZD.G_PRODUCT <> -2'
      '110194731=  INTO :AMOUNT_VSEGO_NUM_,'
      '110194732=       :SUMM_SKIDKA_,'
      '110194733=       :SUMM_VSEGO_,'
      '110194734=       :SUMM_VSEGO_N_,'
      '110194735=       :SUMM_SERVICE_;'
      '110194736='
      '110194737=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110194738=    FROM G_FIRM_ADDRESS R'
      '110194739=   WHERE R.IS_DEFAULT = 1'
      '110194740=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110194741=    INTO :FIRM_ADDRESS_;'
      '110194742='
      
        '110194743=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110194744=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110194745=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110194746=    IF (CURRENCY_ = 0) THEN'
      '110194747=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110194748=    ELSE'
      '110194749=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110194750=  END'
      '110194751='
      '110194752=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110194753='
      
        '110194754=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110194755=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110194756='
      '110194757=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110194758=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110194759=  INTO :SUMM_STR_;'
      '110194760='
      '110194761=  FOR'
      '110194762=    SELECT :I,'
      '110194763=           G.NAME,'
      
        '110194764=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39', ' +
        #39#39'),'
      '110194765=           ZD.AMOUNT,'
      '110194766=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '110194767=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) A' +
        'S VARCHAR(100))'
      '110194768=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110194769=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE' +
        ', 0) AS VARCHAR(100))'
      '110194770=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110194771=      FROM ZAKAZ Z,'
      '110194772=           ZAKAZ_DETAILS ZD,'
      '110194773=           G_PRODUCT G,'
      '110194774=           G_UNIT U'
      '110194775=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110194776=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110194777=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110194778=       AND G.G_UNIT = U.G_UNIT'
      '110194779=       AND G.G_PRODUCT <> -2'
      '110194780=     ORDER BY ZD.zakaz_details'
      '110194781=    INTO :ROW_NUM,'
      '110194782=        :NAME,'
      '110194783=        :NAME_ART,'
      '110194784=        :AMOUNT_NUM_,'
      '110194785=        :PRICE,'
      '110194786=        :SUMM'
      '110194787=        ,:SHORT_NAME'
      '110194788=        ,:PRICE_N'
      '110194789=        ,:SUMM_N'
      '110194790=  DO BEGIN'
      '110194791=    I = I + 1;'
      '110194792='
      
        '110194793=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110194794=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110194795=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110194796=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110194797=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110194798=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110194799=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110194800=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110194801=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110194802=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110194803=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110194804=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110194805=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110194806=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110194807=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110194808=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110194809=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110194810=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110194811=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110194812=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110194813=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110194814=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110194815=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);'
      '110194816='
      '110194817=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110194818=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110194819=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110194820=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110194821=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110194822=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110194823=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110194824=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110194825=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110194826=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110194827=    END ELSE BEGIN'
      '110194828=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110194829=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110194830=    END'
      '110194831='
      
        '110194832=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110194833=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110194834='
      
        '110194835=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110194836=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110194837='
      '110194838=    SUSPEND;'
      '110194839=  END'
      '110194840=WHEN ANY DO BEGIN'
      '110194841=    Err_code = -20500;'
      
        '110194842=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110194843=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110194844=  END'
      '110194845=end'
      '110194846=;'
      '110194847='
      '110194848=ALTER PROCEDURE P_REP_PROFIT('
      '110194849=  DATE_BEGIN_ DATE,'
      '110194850=  DATE_END_ DATE,'
      '110194851=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110194852=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110194853=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110194854=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '110194855=RETURNS ('
      '110194856=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110194857=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110194858=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
      '110194859=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110194860=  SUMM_ALL_ NUMERIC(15,2),'
      '110194861=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110194862=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110194863=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110194864=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110194865=  PROFIT_ALL_ NUMERIC(15,2),'
      '110194866=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110194867=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      '110194868=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '110194869=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '110194870=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '110194871=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '110194872=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT' +
        '_NAME,'
      
        '110194873=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_P' +
        'AYMENT_TYPE,'
      
        '110194874=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYME' +
        'NT_NAME,'
      
        '110194875=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANI' +
        'E,'
      
        '110194876=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUC' +
        'T,'
      
        '110194877=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PR' +
        'ODUCT_PAR,'
      
        '110194878=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110194879=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110194880=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110194881=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110194882=  AMOUNT MY_NUMERIC_5,'
      '110194883=  PRICE NUMERIC(15,2),'
      '110194884=  SUMM NUMERIC(15,2),'
      '110194885=  DISCOUNT_PERC NUMERIC(15,2),'
      '110194886=  DISCOUNT_SUMM NUMERIC(15,2),'
      '110194887=  NDS NUMERIC(15,2),'
      '110194888=  NDS_SUMM NUMERIC(15,2),'
      '110194889=  PRICE_SELF NUMERIC(15,2),'
      '110194890=  SUM_SELF NUMERIC(15,2),'
      '110194891=  PROFIT NUMERIC(15,2),'
      '110194892=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110194893=  ERR_CODE INTEGER,'
      '110194894=  ERR_MSG VARCHAR(1024))'
      '110194895=AS'
      '110194896=/*'
      '110194897='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110194898='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050 +
        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110194899='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110194900='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110194901='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110194902='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110194903='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110194904=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110194905=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110194906=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110194907='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110194908='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110194909=*'
      '110194910=*/'
      
        '110194911=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39 +
        ';'
      '110194912=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110194913=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110194914=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110194915=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110194916=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110194917=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110194918=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '110194919=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '110194920=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '110194921=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '110194922=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110194923=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110194924=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110194925=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110194926=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110194927=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110194928=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110194929=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110194930=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110194931=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110194932=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110194933=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110194934=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110194935=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110194936=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110194937=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110194938=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110194939=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110194940=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110194941=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110194942=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110194943=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110194944=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110194945=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110194946=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110194947=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110194948=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110194949=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110194950=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110194951=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110194952=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110194953=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110194954=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110194955=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110194956=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110194957=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110194958=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110194959=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '110194960=DECLARE VARIABLE SUMM_VOZVRAT_NAL_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM_FACT;'
      
        '110194961=DECLARE VARIABLE SUMM_VOZVRAT_BEZNAL_ TYPE OF COLUMN S' +
        'KLAD_PARENT.SUMM_FACT;'
      '110194962=BEGIN'
      
        '110194963=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110194964=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110194965='
      '110194966=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110194967=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110194968=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110194969='
      '110194970=  FOR SELECT GP.PATH,'
      '110194971=             GP.G_PRODUCT'
      '110194972=       FROM P_REP_TREE GP'
      '110194973=      WHERE EXISTS (SELECT 1'
      
        '110194974=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110194975=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110194976=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110194977=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110194978=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110194979=                       AND Z.IS_SPISANIE = 0'
      '110194980=                       AND Z.is_reserve = 0'
      '110194981=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110194982=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110194983=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110194984=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110194985=                       AND ((EXISTS (SELECT 1'
      
        '110194986=                                       FROM SKLAD S, G' +
        '_PRODUCT G'
      
        '110194987=                                      WHERE S.G_CLIENT' +
        ' = :G_SUPPLIER_'
      
        '110194988=                                        AND S.G_PRODUC' +
        'T = G.G_PRODUCT'
      
        '110194989=                                        AND G.G_PRODUC' +
        'T_PAR = GP.G_PRODUCT'
      
        '110194990=                                        AND :G_TOCHKA_' +
        'ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_,' +
        ' 0) <> 0)'
      '110194991=                              OR'
      
        '110194992=                              COALESCE(:G_SUPPLIER_, 0' +
        ') = 0)'
      '110194993=                       )'
      '110194994=      ORDER BY 1, 2'
      '110194995=  INTO :RECCAT_NAME_,'
      '110194996=       :RECCAT_PRODUCT_'
      '110194997=  DO BEGIN'
      '110194998=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110194999=    insert into p_rep_profit_table'
      '1101941000=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101941001=    values'
      
        '1101941002=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAM' +
        'E_, 1);'
      '1101941003='
      '1101941004=    FOR SELECT Z.ZAKAZ,'
      '1101941005=               Z.G_TOCHKA,'
      '1101941006=               Z.Z_DATE,'
      '1101941007=               Z.G_CLIENT,'
      '1101941008=               C.NAME CLIENT_NAME,'
      '1101941009=               Z.G_PAYMENT_TYPE,'
      '1101941010=               P.NAME PAYMENT_NAME,'
      '1101941011=               Z.OSNOVANIE,'
      '1101941012=               G.G_PRODUCT,'
      '1101941013=               G.G_PRODUCT_PAR,'
      '1101941014=               G.NAME TOVAR_NAME,'
      '1101941015=               ZD.AMOUNT,'
      '1101941016=               ZD.PRICE,'
      '1101941017=               ZD.SUMM,'
      '1101941018=               ZD.DISCOUNT_PERC,'
      '1101941019=               ZD.DISCOUNT_SUMM,'
      '1101941020=               ZD.NDS,'
      '1101941021=               ZD.NDS_SUMM,'
      '1101941022=               COALESCE(ZD.COST_PRICE, 0)'
      
        '1101941023=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON ' +
        'Z.G_CLIENT = C.G_CLIENT,'
      '1101941024=               ZAKAZ_DETAILS ZD,'
      '1101941025=               G_PRODUCT G,'
      '1101941026=               G_PAYMENT_TYPE P'
      
        '1101941027=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1101941028=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101941029=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101941030=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '1101941031=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1101941032=           AND Z.IS_SPISANIE = 0                   --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '1101941033=           AND Z.IS_RESERVE = 0                    --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '1101941034=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101941035=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101941036=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '1101941037=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101941038=           AND ((EXISTS (SELECT 1'
      '1101941039=                       FROM SKLAD S'
      '1101941040=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '1101941041=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1101941042=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101941043=              OR'
      '1101941044=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1101941045=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ' +
        'ZD.ZAKAZ_DETAILS, G.NAME'
      '1101941046=    INTO :REC_ZAKAZ_,'
      '1101941047=        :REC_G_TOCHKA_,'
      '1101941048=        :REC_Z_DATE_,'
      '1101941049=        :REC_G_CLIENT_,'
      '1101941050=        :REC_CLIENT_NAME_,'
      '1101941051=        :REC_G_PAYMENT_TYPE_,'
      '1101941052=        :REC_PAYMENT_NAME_,'
      '1101941053=        :REC_OSNOVANIE_,'
      '1101941054=        :REC_G_PRODUCT_,'
      '1101941055=        :REC_G_PRODUCT_PAR_,'
      '1101941056=        :REC_TOVAR_NAME_,'
      '1101941057=        :REC_AMOUNT_,'
      '1101941058=        :REC_PRICE_,'
      '1101941059=        :REC_SUMM_,'
      '1101941060=        :REC_DISCOUNT_PERC_,'
      '1101941061=        :REC_DISCOUNT_SUMM_,'
      '1101941062=        :REC_NDS_,'
      '1101941063=        :REC_NDS_SUMM_,'
      '1101941064=        :REC_PRICE_SELF_'
      '1101941065=    DO BEGIN'
      '1101941066=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '1101941067=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_' +
        'SUM_COST_;'
      '1101941068='
      '1101941069=      insert into p_rep_profit_table'
      
        '1101941070=        (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '1101941071=         osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '1101941072=         nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '1101941073=      values'
      '1101941074=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1101941075=        :REC_ZAKAZ_,'
      '1101941076=        :REC_g_tochka_,'
      
        '1101941077=        :REC_z_date_, :REC_g_client_, :REC_client_nam' +
        'e_, :REC_g_payment_type_, :REC_payment_name_,'
      '1101941078=         :REC_osnovanie_,'
      '1101941079=         :REC_g_product_,'
      '1101941080=         :REC_g_product_par_,'
      '1101941081=         :REC_tovar_name_,'
      '1101941082=         :REC_amount_,'
      '1101941083=         :REC_price_,'
      '1101941084=         :REC_summ_,'
      '1101941085=         :REC_discount_perc_,'
      '1101941086=         :REC_discount_summ_,'
      
        '1101941087=         :REC_nds_, :REC_nds_summ_, :REC_price_self_,' +
        ' :REC_SUM_COST_, :REC_profit_, 0);'
      '1101941088='
      
        '1101941089=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0' +
        ');'
      
        '1101941090=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_' +
        ', 0);'
      
        '1101941091=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1101941092=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0)' +
        ';'
      '1101941093=    END'
      '1101941094='
      '1101941095=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941096=    insert into p_rep_profit_table'
      
        '1101941097=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101941098=    values'
      
        '1101941099=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1101941100='
      '1101941101=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101941102=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1101941103=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101941104=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101941105='
      '1101941106=    SUM_ZAKAZ_ = 0;'
      '1101941107=    SUM_COST_  = 0;'
      '1101941108=    NDS_SUMM_  = 0;'
      '1101941109=    PROFIT_    = 0;'
      '1101941110=  END'
      '1101941111='
      '1101941112=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1101941113=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1101941114=      insert into p_rep_profit_table'
      
        '1101941115=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101941116=      values'
      
        '1101941117=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1101941118='
      
        '1101941119=  --*************************************************' +
        '****************************************'
      '1101941120=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1101941121=  ---------------------------------------------------' +
        '----'
      '1101941122=  SELECT COUNT(*)'
      
        '1101941123=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101941124=          UNION ALL'
      
        '1101941125=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUM' +
        'M NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BE' +
        'ZNAL) K,'
      '1101941126=         G_PRIHOD_RASHOD G'
      
        '1101941127=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39 +
        '-'#39
      '1101941128=    AND K.ACTION = 1'
      
        '1101941129=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1101941130=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101941131=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053 +
        #1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101941132=  INTO :CNT_;'
      '1101941133='
      '1101941134=  IF (CNT_ > 0) THEN BEGIN'
      '1101941135=    SUM_COST_  = 0;'
      '1101941136=    PROFIT_    = 0;'
      '1101941137='
      '1101941138=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941139=    INSERT INTO P_REP_PROFIT_TABLE'
      '1101941140=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101941141=    VALUES'
      
        '1101941142=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', ' +
        '1);'
      '1101941143='
      '1101941144=    FOR SELECT K.ACTION_DATE,'
      '1101941145=               K.SUMM,'
      
        '1101941146=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, ' +
        #39' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '1101941147=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZ' +
        'NAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '1101941148=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39
      '1101941149=              UNION ALL'
      
        '1101941150=              SELECT KASSA_BEZNAL kassa, ACTION_DATE,' +
        ' SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM ka' +
        'ssa_beznal'
      
        '1101941151=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39') k,'
      '1101941152=              G_PRIHOD_RASHOD G'
      '1101941153=        WHERE K.ACTION = 1'
      
        '1101941154=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1101941155=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101941156=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)  ' +
        '  -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101941157=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1101941158=    INTO :ACTION_DATE_,'
      '1101941159=         :SUMM_,'
      '1101941160=         :ACTION_NAME_'
      '1101941161=    DO BEGIN'
      '1101941162=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101941163=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1101941164=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1101941165=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1101941166=        VALUES'
      
        '1101941167=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, 0,'
      
        '1101941168=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALE' +
        'SCE(:SUMM_, 0), 0);'
      '1101941169='
      '1101941170=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1101941171=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1101941172=    END'
      '1101941173='
      '1101941174=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101941175=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101941176=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1101941177=    insert into p_rep_profit_table'
      
        '1101941178=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101941179=    values'
      
        '1101941180=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1101941181=  END'
      '1101941182=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1101941183=  --*************************************************' +
        '****************************************'
      '1101941184='
      
        '1101941185=  --*************************************************' +
        '****************************************'
      '1101941186=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101941187=  ---------------------------------------------------' +
        '----'
      '1101941188=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941189=  SELECT COUNT(*)'
      
        '1101941190=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101941191=          UNION ALL'
      
        '1101941192=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUM' +
        'M NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BE' +
        'ZNAL) K,'
      '1101941193=         G_PRIHOD_RASHOD G'
      
        '1101941194=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39 +
        '-'#39
      '1101941195=    AND K.ACTION = 0'
      
        '1101941196=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1101941197=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101941198=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056 +
        #1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101941199=  INTO :CNT_;'
      '1101941200='
      '1101941201=  IF (CNT_ > 0) THEN BEGIN'
      '1101941202=    PRIHOD_ALL_  = 0;'
      '1101941203=    PRIHOD_ALL_NAL_  = 0;'
      '1101941204=    PRIHOD_ALL_BEZNAL_  = 0;'
      '1101941205=    PROFIT_     = 0;'
      '1101941206='
      '1101941207=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941208=    INSERT INTO P_REP_PROFIT_TABLE'
      '1101941209=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1101941210=    VALUES'
      
        '1101941211=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', ' +
        '1);'
      '1101941212='
      '1101941213=    FOR SELECT K.ACTION_DATE,'
      '1101941214=               K.NAL,'
      '1101941215=               K.BEZNAL,'
      '1101941216=               G.NAME'
      
        '1101941217=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0' +
        ' BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1101941218=               UNION ALL'
      
        '1101941219=               SELECT kassa_BEZNAL KASSA, ACTION_DATE' +
        ', 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kas' +
        'sa_beznal) K,'
      '1101941220=              G_PRIHOD_RASHOD G'
      
        '1101941221=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCH' +
        'KA||'#39'-'#39
      '1101941222=          AND K.ACTION = 0'
      
        '1101941223=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1101941224=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1101941225=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101941226=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1101941227=    INTO :ACTION_DATE_,'
      '1101941228=         :SUMM_NAL_,'
      '1101941229=         :SUMM_BEZNAL_,'
      '1101941230=         :ACTION_NAME_'
      '1101941231=    DO BEGIN'
      '1101941232=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101941233=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1101941234=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1101941235=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1101941236=        VALUES'
      
        '1101941237=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '1101941238=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNA' +
        'L_, 0);'
      '1101941239='
      
        '1101941240=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_' +
        ';'
      
        '1101941241=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUM' +
        'M_BEZNAL_;'
      
        '1101941242=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_' +
        'BEZNAL_;'
      
        '1101941243=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BE' +
        'ZNAL_;'
      '1101941244=    END'
      '1101941245='
      '1101941246=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1101941247=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101941248=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1101941249=    insert into p_rep_profit_table'
      
        '1101941250=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101941251=    values'
      
        '1101941252=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1101941253=  END'
      '1101941254='
      '1101941255=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1101941256=  --*************************************************' +
        '****************************************'
      '1101941257='
      
        '1101941258=  --*************************************************' +
        '****************************************'
      '1101941259=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101941260=  --*************************************************' +
        '****************************************'
      '1101941261=  SELECT COUNT(*)'
      '1101941262=    FROM ZAKAZ Z'
      
        '1101941263=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1101941264=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1101941265=     AND Z.IS_SPISANIE = 1'
      
        '1101941266=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1101941267=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101941268=  INTO :CNT_;'
      '1101941269='
      '1101941270=  IF (CNT_ > 0) THEN BEGIN'
      '1101941271=      SUM_ZAKAZ_ = 0;'
      '1101941272=      SUM_COST_  = 0;'
      '1101941273=      PROFIT_    = 0;'
      '1101941274='
      '1101941275=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941276=      insert into p_rep_profit_table'
      '1101941277=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101941278=      values'
      
        '1101941279=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1101941280='
      '1101941281=      FOR SELECT Z.ZAKAZ,'
      '1101941282=                 Z.G_TOCHKA,'
      '1101941283=                 Z.Z_DATE,'
      '1101941284=                 Z.G_CLIENT,'
      '1101941285=                 '#39#39' CLIENT_NAME,'
      '1101941286=                 Z.G_PAYMENT_TYPE,'
      '1101941287=                 '#39#39' PAYMENT_NAME,'
      '1101941288=                 Z.OSNOVANIE,'
      '1101941289=                 G.G_PRODUCT,'
      '1101941290=                 G.G_PRODUCT_PAR,'
      '1101941291=                 G.NAME TOVAR_NAME,'
      '1101941292=                 ZD.AMOUNT,'
      '1101941293=                 ZD.PRICE,'
      '1101941294=                 ZD.SUMM,'
      '1101941295=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '1101941296=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '1101941297=                 0 NDS, --ZD.NDS,'
      '1101941298=                 0 NDS_SUMM'
      
        '1101941299=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT' +
        ' G'
      
        '1101941300=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_T' +
        'OCHKA||'#39'-'#39
      '1101941301=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101941302=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101941303=             AND Z.IS_SPISANIE = 1                   ' +
        ' -- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '1101941304=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101941305=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '1101941306=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:' +
        'G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '1101941307=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COAL' +
        'ESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101941308=             AND ((EXISTS (SELECT 1'
      '1101941309=                           FROM SKLAD S'
      
        '1101941310=                          WHERE S.G_CLIENT = :G_SUPPL' +
        'IER_'
      
        '1101941311=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101941312=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101941313=                  OR'
      '1101941314=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1101941315=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKA' +
        'Z_DETAILS'
      '1101941316=      INTO :REC_ZAKAZ_,'
      '1101941317=            :REC_G_TOCHKA_,'
      '1101941318=            :REC_Z_DATE_,'
      '1101941319=            :REC_G_CLIENT_,'
      '1101941320=            :REC_CLIENT_NAME_,'
      '1101941321=            :REC_G_PAYMENT_TYPE_,'
      '1101941322=            :REC_PAYMENT_NAME_,'
      '1101941323=            :REC_OSNOVANIE_,'
      '1101941324=            :REC_G_PRODUCT_,'
      '1101941325=            :REC_G_PRODUCT_PAR_,'
      '1101941326=            :REC_TOVAR_NAME_,'
      '1101941327=            :REC_AMOUNT_,'
      '1101941328=            :REC_PRICE_,'
      '1101941329=            :REC_SUMM_,'
      '1101941330=            :REC_DISCOUNT_PERC_,'
      '1101941331=            :REC_DISCOUNT_SUMM_,'
      '1101941332=            :REC_NDS_,'
      '1101941333=            :REC_NDS_SUMM_'
      '1101941334=      DO BEGIN'
      '1101941335=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1101941336=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053 +
        #1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '1101941337=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '1101941338=        REC_profit_   = -REC_SUMM_;'
      '1101941339='
      '1101941340=        insert into p_rep_profit_table'
      
        '1101941341=          (p_rep_profit_table, zakaz, g_tochka, z_dat' +
        'e, g_client, client_name, g_payment_type, payment_name,'
      
        '1101941342=           osnovanie, g_product, g_product_par, tovar' +
        '_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1101941343=           nds, nds_summ, price_self, sum_self, profi' +
        't, is_head)'
      '1101941344=        values'
      
        '1101941345=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZA' +
        'KAZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '1101941346=         :REC_osnovanie_, :REC_g_product_, :REC_g_pro' +
        'duct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_p' +
        'erc_, :REC_discount_summ_,'
      
        '1101941347=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC' +
        '_SUM_COST_, :REC_profit_, 0);'
      '1101941348='
      
        '1101941349=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COS' +
        'T_, 0);'
      
        '1101941350=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_,' +
        ' 0);'
      '1101941351=      END'
      '1101941352='
      '1101941353=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941354=      insert into p_rep_profit_table'
      
        '1101941355=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101941356=      values'
      
        '1101941357=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', ' +
        '0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1101941358='
      '1101941359=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1101941360=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101941361=  END'
      '1101941362=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101941363=  --*************************************************' +
        '****************************************'
      '1101941364='
      
        '1101941365=  --*************************************************' +
        '****************************************'
      '1101941366=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101941367=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1101941368=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1101941369=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1101941370='
      
        '1101941371=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1101941372=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1101941373=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1101941374=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '1101941375='
      
        '1101941376=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059 +
        #1063#1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '1101941377=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058 +
        '. - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '1101941378=  --*************************************************' +
        '****************************************'
      '1101941379=  SELECT COUNT(*)'
      '1101941380=    FROM SKLAD S'
      
        '1101941381=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      
        '1101941382=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1101941383=     AND S.IS_VOZVRAT IN (1,2)'
      
        '1101941384=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S' +
        '.G_CLIENT, 0))'
      
        '1101941385=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_' +
        ', COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101941386=     AND ((EXISTS (SELECT 1'
      '1101941387=                   FROM SKLAD SS'
      '1101941388=                  WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '1101941389=                    AND SS.G_PRODUCT = S.G_PRODUCT'
      
        '1101941390=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101941391=          OR'
      '1101941392=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101941393=  INTO :CNT_;'
      '1101941394='
      '1101941395=  IF (CNT_ > 0) THEN BEGIN'
      '1101941396=    SUM_ZAKAZ_ = 0;'
      '1101941397=    PROFIT_    = 0;'
      '1101941398=    SUM_COST_  = 0;'
      '1101941399='
      '1101941400=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941401=    insert into p_rep_profit_table'
      '1101941402=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101941403=    values'
      
        '1101941404=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054 +
        #1042#1040#1056#1040#39', 1);'
      '1101941405='
      '1101941406=    FOR SELECT S.DATE_RECEIPT,'
      '1101941407=               S.G_PRODUCT,'
      '1101941408=               G.NAME TOVAR_NAME,'
      '1101941409=               S.AMOUNT,'
      '1101941410=               S.PRICE,'
      '1101941411=               S.SUMM,'
      '1101941412=               SP.G_TOCHKA'
      '1101941413=         FROM SKLAD_PARENT SP,'
      '1101941414=              SKLAD S,'
      '1101941415=              G_PRODUCT G'
      
        '1101941416=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOC' +
        'HKA||'#39'-'#39
      
        '1101941417=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1101941418=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '1101941419=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COAL' +
        'ESCE(S.G_CLIENT, 0))'
      
        '1101941420=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT' +
        '_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101941421=          AND SP.SKLAD = S.SKLAD_PARENT'
      '1101941422=          AND S.G_PRODUCT = G.G_PRODUCT'
      '1101941423=          AND ((EXISTS (SELECT 1'
      '1101941424=                           FROM SKLAD SS'
      
        '1101941425=                          WHERE SS.G_CLIENT = :G_SUPP' +
        'LIER_'
      
        '1101941426=                            AND SS.G_PRODUCT = S.G_PR' +
        'ODUCT'
      
        '1101941427=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101941428=                  OR'
      '1101941429=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101941430=        ORDER BY 1'
      '1101941431=    INTO :V_DATE_RECEIPT_,'
      '1101941432=         :V_G_PRODUCT_,'
      '1101941433=         :V_TOVAR_NAME_,'
      '1101941434=         :V_AMOUNT_,'
      '1101941435=         :V_PRICE_,'
      '1101941436=         :V_SUMM_,'
      '1101941437=         :REC_G_TOCHKA_'
      '1101941438=    DO BEGIN'
      '1101941439=      --REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '1101941440=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;  ' +
        '  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054 +
        #1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' ' +
        #1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101941441='
      '1101941442='
      '1101941443=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '1101941444=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR' +
        '_NAME, AMOUNT, PRICE, SUMM,'
      '1101941445=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1101941446=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, ' +
        'sum_self)'
      '1101941447=      VALUES'
      
        '1101941448=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_R' +
        'ECEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, -' +
        ':V_SUMM_,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045 +
        #1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, ' +
        #1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101941449=         0, 0, 0, 0, :REC_profit_, 0, 0, 0);'
      '1101941450='
      
        '1101941451=      --SUM_COST_  = SUM_COST_  + COALESCE(REC_SUM_CO' +
        'ST_, 0);     -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1101941452=      SUM_COST_ = 0;'
      '1101941453=      SUM_ZAKAZ_ = SUM_ZAKAZ_ - COALESCE(V_SUMM_, 0);'
      
        '1101941454=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0)' +
        ';'
      '1101941455=    END'
      '1101941456='
      '1101941457='
      
        '1101941458=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_; --S' +
        'UM_COST_;'
      '1101941459=    --SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1101941460=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1101941461='
      '1101941462=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941463=    insert into p_rep_profit_table'
      
        '1101941464=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101941465=    values'
      
        '1101941466=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, 0, 0, :PROFIT_, 2);'
      '1101941467=  END'
      '1101941468=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1101941469=  --*************************************************' +
        '****************************************'
      '1101941470='
      
        '1101941471=  --*************************************************' +
        '****************************************'
      
        '1101941472=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045 +
        #1051#1054' '#1052#1045#1057#1058#1054
      '1101941473=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '1101941474=  --*************************************************' +
        '****************************************'
      '1101941475=  /*SELECT COUNT(*)'
      '1101941476=    FROM ZAKAZ Z'
      
        '1101941477=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1101941478=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1101941479=     AND Z.IS_SPISANIE = 4'
      
        '1101941480=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1101941481=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101941482=  INTO :CNT_;'
      '1101941483='
      '1101941484=  IF (CNT_ > 0) THEN BEGIN'
      '1101941485=      SUM_ZAKAZ_ = 0;'
      '1101941486=      SUM_COST_  = 0;'
      '1101941487=      PROFIT_    = 0;'
      '1101941488=      NDS_SUMM_  = 0;'
      '1101941489='
      '1101941490=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941491=      insert into p_rep_profit_table'
      '1101941492=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101941493=      values'
      
        '1101941494=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '1101941495='
      '1101941496=      FOR SELECT Z.ZAKAZ,'
      '1101941497=               Z.G_TOCHKA,'
      '1101941498=               Z.Z_DATE,'
      '1101941499=               Z.G_CLIENT,'
      '1101941500=               C.NAME CLIENT_NAME,'
      '1101941501=               Z.G_PAYMENT_TYPE,'
      '1101941502=               P.NAME PAYMENT_NAME,'
      '1101941503=               Z.OSNOVANIE,'
      '1101941504=               G.G_PRODUCT,'
      '1101941505=               G.G_PRODUCT_PAR,'
      '1101941506=               G.NAME TOVAR_NAME,'
      '1101941507=               ZD.AMOUNT,'
      '1101941508=               ZD.PRICE,'
      '1101941509=               ZD.SUMM,'
      '1101941510=               ZD.DISCOUNT_PERC,'
      '1101941511=               ZD.DISCOUNT_SUMM,'
      '1101941512=               ZD.NDS,'
      '1101941513=               ZD.NDS_SUMM,'
      '1101941514=               COALESCE(ZD.COST_PRICE, 0)'
      
        '1101941515=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON ' +
        'Z.G_CLIENT = C.G_CLIENT,'
      '1101941516=               ZAKAZ_DETAILS ZD,'
      '1101941517=               G_PRODUCT G,'
      '1101941518=               G_PAYMENT_TYPE P'
      
        '1101941519=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1101941520=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101941521=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101941522=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '1101941523=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1101941524=           AND Z.IS_SPISANIE = 4                   --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101941525=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101941526=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101941527=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '1101941528=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '1101941529=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ' +
        'ZD.ZAKAZ_DETAILS, G.NAME'
      '1101941530=    INTO :REC_ZAKAZ_,'
      '1101941531=        :REC_G_TOCHKA_,'
      '1101941532=        :REC_Z_DATE_,'
      '1101941533=        :REC_G_CLIENT_,'
      '1101941534=        :REC_CLIENT_NAME_,'
      '1101941535=        :REC_G_PAYMENT_TYPE_,'
      '1101941536=        :REC_PAYMENT_NAME_,'
      '1101941537=        :REC_OSNOVANIE_,'
      '1101941538=        :REC_G_PRODUCT_,'
      '1101941539=        :REC_G_PRODUCT_PAR_,'
      '1101941540=        :REC_TOVAR_NAME_,'
      '1101941541=        :REC_AMOUNT_,'
      '1101941542=        :REC_PRICE_,'
      '1101941543=        :REC_SUMM_,'
      '1101941544=        :REC_DISCOUNT_PERC_,'
      '1101941545=        :REC_DISCOUNT_SUMM_,'
      '1101941546=        :REC_NDS_,'
      '1101941547=        :REC_NDS_SUMM_,'
      '1101941548=        :REC_PRICE_SELF_'
      '1101941549=    DO BEGIN'
      '1101941550=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '1101941551=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '1101941552='
      '1101941553=      insert into p_rep_profit_table'
      
        '1101941554=        (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '1101941555=         osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '1101941556=         nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '1101941557=      values'
      '1101941558=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1101941559=        :REC_ZAKAZ_,'
      '1101941560=        :REC_g_tochka_,'
      
        '1101941561=        :REC_z_date_, :REC_g_client_, :REC_client_nam' +
        'e_, :REC_g_payment_type_, :REC_payment_name_,'
      '1101941562=         :REC_osnovanie_,'
      '1101941563=         :REC_g_product_,'
      '1101941564=         :REC_g_product_par_,'
      '1101941565=         :REC_tovar_name_,'
      '1101941566=         :REC_amount_,'
      '1101941567=         :REC_price_,'
      '1101941568=         :REC_summ_,'
      '1101941569=         :REC_discount_perc_,'
      '1101941570=         :REC_discount_summ_,'
      
        '1101941571=         :REC_nds_, :REC_nds_summ_, :REC_price_self_,' +
        ' :REC_SUM_COST_, :REC_profit_, 0);'
      '1101941572='
      
        '1101941573=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0' +
        ');'
      
        '1101941574=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_' +
        ', 0);'
      
        '1101941575=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1101941576=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0)' +
        ';'
      '1101941577=    END'
      '1101941578='
      '1101941579=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941580=    insert into p_rep_profit_table'
      
        '1101941581=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1101941582=    values'
      
        '1101941583=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1101941584='
      '1101941585=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1101941586=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '1101941587=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1101941588=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1101941589='
      '1101941590=    SUM_ZAKAZ_ = 0;'
      '1101941591=    SUM_COST_  = 0;'
      '1101941592=    NDS_SUMM_  = 0;'
      '1101941593=    PROFIT_    = 0;'
      '1101941594=  END'
      '1101941595=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '1101941596=  --*************************************************' +
        '****************************************'
      '1101941597='
      
        '1101941598=  --*************************************************' +
        '****************************************'
      
        '1101941599=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1101941600=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101941601=  --*************************************************' +
        '****************************************'
      '1101941602=  SELECT COUNT(*)'
      '1101941603=    FROM ZAKAZ S'
      
        '1101941604=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      '1101941605=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101941606=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101941607=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1101941608=     AND S.IS_SPISANIE = 2'
      '1101941609=  INTO :CNT_;'
      '1101941610='
      '1101941611=  IF (CNT_ > 0) THEN BEGIN'
      '1101941612=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941613=      insert into p_rep_profit_table'
      '1101941614=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101941615=      values'
      
        '1101941616=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1101941617='
      '1101941618=      SUM_ZAKAZ_ = 0;'
      '1101941619=      SUM_COST_  = 0;'
      '1101941620=      NDS_SUMM_  = 0;'
      '1101941621=      PROFIT_    = 0;'
      '1101941622=      FOR SELECT GP.NAME,'
      '1101941623=                 GP.G_PRODUCT'
      '1101941624=           FROM G_PRODUCT GP'
      '1101941625=          WHERE IS_CATEGORY = 1'
      '1101941626=            AND EXISTS (SELECT 1'
      
        '1101941627=                          FROM ZAKAZ Z, ZAKAZ_DETAILS' +
        ' ZD, G_PRODUCT G'
      
        '1101941628=                         WHERE :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1101941629=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '1101941630=                           AND ZD.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101941631=                           AND G.G_PRODUCT_PAR = GP.G' +
        '_PRODUCT'
      '1101941632=                           AND Z.IS_SPISANIE = 2'
      '1101941633=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101941634=                           AND Z.Z_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '1101941635=                           AND COALESCE(Z.G_CLIENT, 0' +
        ') = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053 +
        #1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101941636=                           AND COALESCE(Z.G_PAYMENT_T' +
        'YPE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0))'
      '1101941637=                           AND ((EXISTS (SELECT 1'
      
        '1101941638=                                           FROM SKLAD' +
        ' S'
      
        '1101941639=                                          WHERE S.G_C' +
        'LIENT = :G_SUPPLIER_'
      
        '1101941640=                                            AND S.G_P' +
        'RODUCT = G.G_PRODUCT'
      
        '1101941641=                                            AND :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPL' +
        'IER_, 0) <> 0)'
      '1101941642=                                  OR'
      
        '1101941643=                                  COALESCE(:G_SUPPLIE' +
        'R_, 0) = 0)'
      '1101941644=                           )'
      '1101941645=          ORDER BY 1'
      '1101941646=      INTO :RECCAT_NAME_,'
      '1101941647=           :RECCAT_PRODUCT_'
      '1101941648=      DO BEGIN'
      '1101941649=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941650=        insert into p_rep_profit_table'
      '1101941651=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1101941652=        values'
      
        '1101941653=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT' +
        '_NAME_, 1);'
      '1101941654='
      '1101941655=        FOR SELECT Z.ZAKAZ,'
      '1101941656=                   Z.G_TOCHKA,'
      '1101941657=                   Z.Z_DATE,'
      '1101941658=                   Z.G_CLIENT,'
      '1101941659=                   C.NAME CLIENT_NAME,'
      '1101941660=                   Z.G_PAYMENT_TYPE,'
      '1101941661=                   P.NAME PAYMENT_NAME,'
      '1101941662=                   Z.OSNOVANIE,'
      '1101941663=                   G.G_PRODUCT,'
      '1101941664=                   G.G_PRODUCT_PAR,'
      '1101941665=                   G.NAME TOVAR_NAME,'
      '1101941666=                   ZD.AMOUNT,'
      '1101941667=                   ZD.PRICE,'
      '1101941668=                   ZD.SUMM,'
      '1101941669=                   ZD.DISCOUNT_PERC,'
      '1101941670=                   ZD.DISCOUNT_SUMM,'
      '1101941671=                   ZD.NDS,'
      '1101941672=                   ZD.NDS_SUMM,'
      '1101941673=                   ZD.COST_PRICE'
      
        '1101941674=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C' +
        ' ON Z.G_CLIENT = C.G_CLIENT,'
      '1101941675=                   ZAKAZ_DETAILS ZD,'
      '1101941676=                   G_PRODUCT G,'
      '1101941677=                   G_PAYMENT_TYPE P'
      
        '1101941678=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G' +
        '_TOCHKA||'#39'-'#39
      '1101941679=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101941680=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101941681=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYP' +
        'E'
      
        '1101941682=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_' +
        '  -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1101941683=               AND Z.IS_SPISANIE = 2                 ' +
        '   -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '1101941684=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101941685=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1101941686=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE' +
        '(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '1101941687=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = CO' +
        'ALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101941688=               AND ((EXISTS (SELECT 1'
      '1101941689=                               FROM SKLAD S'
      
        '1101941690=                              WHERE S.G_CLIENT = :G_S' +
        'UPPLIER_'
      
        '1101941691=                                AND S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '1101941692=                                AND :G_TOCHKA_ARR_ CO' +
        'NTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> ' +
        '0)'
      '1101941693=                      OR'
      '1101941694=                      COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1101941695=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAK' +
        'AZ, ZD.ZAKAZ_DETAILS, G.NAME'
      '1101941696=        INTO :REC_ZAKAZ_,'
      '1101941697=            :REC_G_TOCHKA_,'
      '1101941698=            :REC_Z_DATE_,'
      '1101941699=            :REC_G_CLIENT_,'
      '1101941700=            :REC_CLIENT_NAME_,'
      '1101941701=            :REC_G_PAYMENT_TYPE_,'
      '1101941702=            :REC_PAYMENT_NAME_,'
      '1101941703=            :REC_OSNOVANIE_,'
      '1101941704=            :REC_G_PRODUCT_,'
      '1101941705=            :REC_G_PRODUCT_PAR_,'
      '1101941706=            :REC_TOVAR_NAME_,'
      '1101941707=            :REC_AMOUNT_,'
      '1101941708=            :REC_PRICE_,'
      '1101941709=            :REC_SUMM_,'
      '1101941710=            :REC_DISCOUNT_PERC_,'
      '1101941711=            :REC_DISCOUNT_SUMM_,'
      '1101941712=            :REC_NDS_,'
      '1101941713=            :REC_NDS_SUMM_,'
      '1101941714=            :REC_PRICE_SELF_'
      '1101941715=        DO BEGIN'
      
        '1101941716=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SEL' +
        'F_;'
      
        '1101941717=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ -' +
        ' REC_NDS_SUMM_;'
      '1101941718='
      '1101941719=          insert into p_rep_profit_table'
      
        '1101941720=            (p_rep_profit_table, zakaz, g_tochka, z_d' +
        'ate, g_client, client_name, g_payment_type, payment_name,'
      
        '1101941721=             osnovanie, g_product, g_product_par, tov' +
        'ar_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1101941722=             nds, nds_summ, price_self, sum_self, pro' +
        'fit, is_head)'
      '1101941723=          values'
      '1101941724=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1101941725=            :REC_ZAKAZ_,'
      '1101941726=            :REC_g_tochka_,'
      
        '1101941727=            :REC_z_date_, :REC_g_client_, :REC_client' +
        '_name_, :REC_g_payment_type_, :REC_payment_name_,'
      '1101941728=             :REC_osnovanie_,'
      '1101941729=             :REC_g_product_,'
      '1101941730=             :REC_g_product_par_,'
      '1101941731=             :REC_tovar_name_,'
      '1101941732=             :REC_amount_,'
      '1101941733=             :REC_price_,'
      '1101941734=             :REC_summ_,'
      '1101941735=             :REC_discount_perc_,'
      '1101941736=             :REC_discount_summ_,'
      
        '1101941737=             :REC_nds_, :REC_nds_summ_, :REC_price_se' +
        'lf_, :REC_SUM_COST_, :REC_profit_, 0);'
      '1101941738='
      
        '1101941739=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM' +
        '_, 0);'
      
        '1101941740=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_C' +
        'OST_, 0);'
      
        '1101941741=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_S' +
        'UMM_, 0);'
      
        '1101941742=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_' +
        ', 0);'
      '1101941743=        END'
      '1101941744='
      '1101941745=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101941746=        insert into p_rep_profit_table'
      
        '1101941747=          (p_rep_profit_table, tovar_name, summ, sum_' +
        'self, NDS_SUMM, profit, is_head)'
      '1101941748=        values'
      
        '1101941749=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1101941750='
      
        '1101941751=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ' +
        '_;'
      '1101941752=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '1101941753=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '1101941754=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '1101941755='
      '1101941756=        SUM_ZAKAZ_ = 0;'
      '1101941757=        SUM_COST_  = 0;'
      '1101941758=        NDS_SUMM_  = 0;'
      '1101941759=        PROFIT_    = 0;'
      '1101941760=      END'
      '1101941761='
      '1101941762=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1101941763=      insert into p_rep_profit_table'
      
        '1101941764=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1101941765=      values'
      
        '1101941766=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '1101941767='
      
        '1101941768=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REA' +
        'L_;'
      
        '1101941769=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REA' +
        'L_;'
      
        '1101941770=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_' +
        ';'
      '1101941771=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '1101941772=  END'
      '1101941773=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101941774=  --*************************************************' +
        '****************************************'
      '1101941775=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '1101941776='
      '1101941777=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1101941778=  insert into p_rep_profit_table'
      '1101941779=    (p_rep_profit_table, is_head)'
      '1101941780=  values'
      '1101941781=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1101941782='
      '1101941783=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1101941784=  insert into p_rep_profit_table'
      
        '1101941785=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101941786=  values'
      
        '1101941787=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1101941788='
      '1101941789=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1101941790=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1101941791=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1101941792=         SUM(Z.SUMM_BONUS)'
      '1101941793=    FROM ZAKAZ Z'
      
        '1101941794=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1101941795=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1101941796=     AND Z.IS_RESERVE = 0'
      '1101941797=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101941798=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1101941799=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1101941800=     AND ((EXISTS (SELECT 1'
      '1101941801=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1101941802=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1101941803=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1101941804=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1101941805=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1101941806=          OR'
      '1101941807=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1101941808=    INTO :SUMM_CASH_ALL_,'
      '1101941809=         :SUMM_NONCASH_ALL_,'
      '1101941810=         :SUMM_BONUS_ALL_;'
      '1101941811='
      '1101941812=  SELECT SUM(NAL),'
      '1101941813=         SUM(BEZNAL)'
      
        '1101941814=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHE' +
        'RE K.SKLAD = SP.SKLAD) NAL,'
      
        '1101941815=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL' +
        ' KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '1101941816=           FROM SKLAD_PARENT SP'
      
        '1101941817=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '1101941818=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101941819=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '1101941820=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, CO' +
        'ALESCE(SP.G_CLIENT, 0))'
      
        '1101941821=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYME' +
        'NT_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '1101941822=        )'
      '1101941823=  INTO :SUMM_VOZVRAT_NAL_,'
      '1101941824=       :SUMM_VOZVRAT_BEZNAL_;'
      '1101941825='
      
        '1101941826=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COAL' +
        'ESCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '1101941827=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) ' +
        '- COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '1101941828=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1101941829='
      '1101941830=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1101941831='
      
        '1101941832=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1101941833=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1101941834='
      '1101941835=/*  insert into p_rep_profit_table'
      
        '1101941836=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1101941837=  values'
      
        '1101941838=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1101941839='
      '1101941840=  insert into p_rep_profit_table'
      '1101941841=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1101941842=  values'
      
        '1101941843=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1101941844='
      '1101941845=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1101941846=    SELECT G.NAME'
      '1101941847=      FROM G_CLIENT G'
      '1101941848=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1101941849=    INTO :CLIENT_NAME_;'
      '1101941850=  ELSE'
      '1101941851=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101941852='
      '1101941853=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1101941854=    SELECT G.NAME'
      '1101941855=      FROM G_PAYMENT_TYPE G'
      '1101941856=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1101941857=    INTO :PAYMENT_NAME_;'
      '1101941858=  ELSE'
      '1101941859=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1101941860='
      '1101941861=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1101941862=        P.ZAKAZ,'
      '1101941863=        P.G_TOCHKA,'
      '1101941864=        P.Z_DATE,'
      '1101941865=        P.G_CLIENT,'
      '1101941866=        P.CLIENT_NAME,'
      '1101941867=        P.G_PAYMENT_TYPE,'
      '1101941868=        P.PAYMENT_NAME,'
      '1101941869=        P.OSNOVANIE,'
      '1101941870=        P.G_PRODUCT,'
      '1101941871=        P.G_PRODUCT_PAR,'
      '1101941872=        P.TOVAR_NAME,'
      '1101941873=        G.ARTICUL,'
      '1101941874=        G.NOMENCLATUR_NUM,'
      '1101941875=        G.BARCODE,'
      '1101941876=        P.AMOUNT,'
      
        '1101941877=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1101941878=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1101941879=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101941880=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101941881=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101941882=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101941883=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1101941884=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1101941885=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1101941886=        P.IS_HEAD'
      
        '1101941887=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1101941888=    ORDER BY 1'
      '1101941889=  INTO :P_REP_PROFIT_TABLE,'
      '1101941890=       :ZAKAZ,'
      '1101941891=       :G_TOCHKA,'
      '1101941892=       :Z_DATE,'
      '1101941893=       :G_CLIENT,'
      '1101941894=       :CLIENT_NAME,'
      '1101941895=       :G_PAYMENT_TYPE,'
      '1101941896=       :PAYMENT_NAME,'
      '1101941897=       :OSNOVANIE,'
      '1101941898=       :G_PRODUCT,'
      '1101941899=       :G_PRODUCT_PAR,'
      '1101941900=       :TOVAR_NAME,'
      '1101941901=       :ARTICUL,'
      '1101941902=       :NOMENCLATUR_NUM,'
      '1101941903=       :BARCODE,'
      '1101941904=       :AMOUNT,'
      '1101941905=       :PRICE,'
      '1101941906=       :SUMM,'
      '1101941907=       :DISCOUNT_PERC,'
      '1101941908=       :DISCOUNT_SUMM,'
      '1101941909=       :NDS,'
      '1101941910=       :NDS_SUMM,'
      '1101941911=       :PRICE_SELF,'
      '1101941912=       :SUM_SELF,'
      '1101941913=       :PROFIT,'
      '1101941914=       :IS_HEAD'
      '1101941915=  DO'
      '1101941916=    suspend;'
      '1101941917='
      '1101941918=WHEN ANY DO BEGIN'
      '1101941919=    Err_code = -20500;'
      
        '1101941920=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101941921=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101941922=  END'
      '1101941923=end'
      '1101941924=;'
      '1101941925='
      '1101941926='
      
        '1101941927=UPDATE SYSTEM_SETUP SET S_VALUE = 110194 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101941928=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101941929=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
