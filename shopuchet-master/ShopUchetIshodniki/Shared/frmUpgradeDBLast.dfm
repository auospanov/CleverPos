      '1106016039=ALTER PROCEDURE G_GET_DCARD_BY_CODE('
      
        '1106016040=  G_DISCONT_CARD_ TYPE OF COLUMN G_DISCONT_CARD.G_DIS' +
        'CONT_CARD,'
      '1106016041=  CARD_CODE_ VARCHAR(13))'
      '1106016042=RETURNS ('
      '1106016043=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1106016044=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1106016045=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '1106016046=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '1106016047=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '1106016048=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '1106016049=  ERR_CODE INTEGER,'
      '1106016050=  ERR_MSG VARCHAR(1024))'
      '1106016051=AS'
      
        '1106016052=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_GET_DCARD_' +
        'BY_CODE'#39';'
      '1106016053=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106016054=BEGIN'
      '1106016055=  SELECT'
      '1106016056=    C.G_CLIENT,'
      '1106016057=    C.NAME,'
      '1106016058=    D.BARCODE,'
      '1106016059=    D.N_PERCENT,'
      '1106016060=    D.SUMM,'
      '1106016061=    D.SUMM_ALL'
      '1106016062=  FROM G_DISCONT_CARD D, G_CLIENT C'
      
        '1106016063=  WHERE ((BARCODE = :CARD_CODE_ AND CHAR_LENGTH(:CARD' +
        '_CODE_) > 0)  -- '#1063#1058#1054#1041#1067' '#1057#1058#1056#1054#1050#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1051#1048#1057#1068' '#1055#1054' '#1055#1059#1057#1058#1054#1058#1045
      
        '1106016064=         or (D.G_DISCONT_CARD = COALESCE(:G_DISCONT_C' +
        'ARD_, 0))'
      '1106016065=        )'
      '1106016066=    AND D.G_CLIENT = C.G_CLIENT'
      '1106016067=  INTO'
      '1106016068=    :G_CLIENT_,'
      '1106016069=    :CLIENT_NAME_,'
      '1106016070=    :BARCODE_,'
      '1106016071=    :N_PERCENT_,'
      '1106016072=    :SUMM_,'
      '1106016073=    :SUMM_ALL_;'
      '1106016074=END'
      '1106016075=;'
      '1106016076='
