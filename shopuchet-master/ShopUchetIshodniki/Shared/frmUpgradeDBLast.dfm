        #1072#1087#1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUE' +
