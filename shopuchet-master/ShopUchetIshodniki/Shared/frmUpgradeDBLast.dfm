        '1102017080=  --*************************************************' +
        '************'
      
        '1102017081=  ---------------------------------------------------' +
        '------------'
      '1102017082=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102017083=  ELSE BEGIN'
      '1102017084=      PNT_ = '#39'020'#39';'
      '1102017085=      SELECT SP.G_TOCHKA,'
      '1102017086=             SP.G_CLIENT,'
      '1102017087=             SP.IS_EXPECTED'
      '1102017088=        FROM SKLAD_PARENT SP'
      '1102017089=       WHERE SP.SKLAD = :ZAKAZ_'
      '1102017090=        INTO :G_TOCHKA_OLD_,'
      '1102017091=             :G_TOCHKA_,'
      '1102017092=             :IS_EXPECTED_OLD_;'
      '1102017093='
      
        '1102017094=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102017095=      PNT_ = '#39'021'#39';'
