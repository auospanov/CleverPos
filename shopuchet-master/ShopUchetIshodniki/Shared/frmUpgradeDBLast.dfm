        '), 0) - (C.DEBET + '#39#39'||NEW.DEBET||'#39#39') + (C.CREDIT + '#39#39'||NEW.CRED' +
        'IT||'#39#39') '#39'||'
      '110751659=                           '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110751660=                           '#39' INSERT (KASSA_BEZNAL_STAT' +
        'E, K_DATE, "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
