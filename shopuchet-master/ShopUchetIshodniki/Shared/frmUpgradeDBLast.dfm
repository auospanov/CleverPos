      '1102281854='
      
        '1102281855=  --=================================================' +
        '===================='
      '1102281856=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      
        '1102281857=  -- '#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054' '#1054#1058#1044#1045 +
        #1051#1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048#1042' '#1057#1054#1041#1048#1056#1040#1058#1068 +
        '?'
      
        '1102281858=  --=================================================' +
        '===================='
      '1102281859=  FOR SELECT MAX(L.ID) ID,'
      '1102281860=             L.SQLSTMT'
      '1102281861=        FROM LOGS L'
      '1102281862=       WHERE L.USR = '#39'REPLICAT'#39
      '1102281863=         AND L.DAT IS NULL'
      '1102281864=         AND L.IS_TRANSFERED = 0'
      
        '1102281865=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTM' +
        'T) > 0'
      '1102281866=       GROUP BY L.SQLSTMT'
      '1102281867=        INTO :LOGS_ID_,'
      '1102281868=             :SQL_'
      '1102281869=  DO BEGIN'
      '1102281870=    SQLCODE_ = 0;'
      '1102281871=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '1102281872=    POS1_ = POSITION('#39'-'#39' IN SQL_);'
      '1102281873='
      
        '1102281874=    G_PRODUCT_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FO' +
        'R POS1_ - POS_ - 1) AS BIGINT);'
      
        '1102281875=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 FO' +
        'R CHAR_LENGTH(SQL_)) AS BIGINT);'
      '1102281876='
      '1102281877=    BEGIN'
      '1102281878=        select ('
      '1102281879=               -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102281880=               (select COALESCE(sum(s.amount), 0) fro' +
        'm sklad s, sklad_parent sp'
      '1102281881=                where sp.SKLAD = s.SKLAD_PARENT'
      '1102281882=                  and sp.G_TOCHKA = :G_TOCHKA_'
      '1102281883=                  and s.g_product = :G_PRODUCT_'
      
        '1102281884=                  and sp.IS_EXPECTED = 0)   -- '#1085#1077' '#1073#1077#1088 +
        #1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102281885='
      '1102281886=               -'
      '1102281887=               -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102281888=               (select COALESCE(sum(zr.AMOUNT_ALL), 0' +
        ') from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102281889=                where zr.g_product = :G_PRODUCT_ and ' +
        'Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102281890=                and zr.ZAKAZ_REAL_PARENT = zrp.ZAKAZ_' +
        'REAL_PARENT)'
      '1102281891='
      '1102281892=               -'
      '1102281893=               -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102281894=               (select COALESCE(sum(zd.amount), 0) fr' +
        'om zakaz_details zd, zakaz z'
      
        '1102281895=                where zd.g_product = :G_PRODUCT_ and ' +
        'Z.G_TOCHKA = :G_TOCHKA_'
      '1102281896=                and zd.zakaz = z.zakaz'
      
        '1102281897=                and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099#1095#1080#1090 +
        #1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076#1077#1090' ' +
        #1085#1080#1078#1077
      
        '1102281898=                and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074 +
        #1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072 +
        #1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102281899=                and not (z.IS_SPISANIE = 0 and z.NOT_' +
        'MINUS_OSTATOK = 1)'
      '1102281900=               )'
      '1102281901='
      '1102281902=               -'
      '1102281903=               -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102281904=               (select COALESCE(sum(s.amount), 0) fro' +
        'm sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = 3'
      '1102281905=                and S.g_client = :G_TOCHKA_)'
      '1102281906='
      '1102281907=               -'
      '1102281908=               -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102281909=               (select COALESCE(sum(od.amount), 0) fr' +
        'om other_details od, other o'
      
        '1102281910=                where od.g_product = :G_PRODUCT_ and ' +
        'o.G_TOCHKA = :G_TOCHKA_'
      '1102281911=                and od.other = o.other)'
      '1102281912=               ) amount,'
      '1102281913='
      
        '1102281914=               (SELECT COALESCE(sum(ZD.amount), 0) FR' +
        'OM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102281915=                 WHERE Z.G_TOCHKA = :G_TOCHKA_ AND Z.' +
        'IS_RESERVE = 1'
      
        '1102281916=                   AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G_PR' +
        'ODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102281917=        from rdb$database'
      '1102281918=        INTO :AMOUNT_,'
      '1102281919=             :AMOUNT_RESERVE_;'
      '1102281920='
      '1102281921=        MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102281922=        USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G_TO' +
        'CHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102281923=        ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_TOCH' +
        'KA = CD.G_TOCHKA)'
      '1102281924=        WHEN MATCHED THEN'
      
        '1102281925=            UPDATE SET LT.AMOUNT = :AMOUNT_, LT.AMOUN' +
        'T_RESERVE = :AMOUNT_RESERVE_'
      '1102281926=        WHEN NOT MATCHED THEN'
      
        '1102281927=            INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, AMOU' +
        'NT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102281928=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,  1),' +
        ' :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102281929=    WHEN ANY DO'
      '1102281930=        BEGIN'
      '1102281931=            SQLCODE_ = GDSCODE;'
      '1102281932=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102281933=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102281934=            ERR_BODY = ERR_BODY ||'#39
      
        '1102281935=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102281936=        END'
      '1102281937=    END'
      '1102281938='
      '1102281939=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '1102281940=    UPDATE LOGS L'
      
        '1102281941=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102281942=           L.ERR_CODE = :SQLCODE_'
      '1102281943=     WHERE L.SQLSTMT = :SQL_'
      '1102281944=       AND L.USR = '#39'REPLICAT'#39
      '1102281945=       AND L.DAT IS NULL'
      '1102281946=       AND L.IS_TRANSFERED = 0;'
      '1102281947=  END'
      '1102281948='
      
        '1102281949=  --=================================================' +
        '===================='
      '1102281950=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1050#1040#1057#1057#1067
      
        '1102281951=  -- '#1058#1059#1058' '#1053#1045#1052#1053#1054#1043#1054' '#1053#1040#1042#1054#1056#1054#1063#1045#1053#1053#1054' '#1055#1054#1051#1059#1063#1048#1051#1054#1057#1068', '#1052#1040#1057#1057#1048#1042#1054#1042' '#1058#1059#1058 +
        ' '#1053#1045#1058', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1057#1053#1054#1042#1040' '#1042#1057#1045' '#1063#1045#1056#1045#1047' G_TOCHKA_OLD '#1044#1045#1051#1040#1058#1068
      
        '1102281952=  --=================================================' +
        '===================='
      '1102281953=  G_TOCHKA_OLD_ = 0;'
      '1102281954=  FOR SELECT L.ID,'
      '1102281955=             L.SQLSTMT'
      '1102281956=        FROM LOGS L'
      '1102281957=       WHERE L.USR = '#39'REPLICAT'#39
      '1102281958=         AND L.DAT IS NULL'
      '1102281959=         AND L.IS_TRANSFERED = 0'
      '1102281960=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) > 0'
      '1102281961=     ORDER BY L.SQLSTMT'
      '1102281962=        INTO :LOGS_ID_,'
      '1102281963=             :SQL_'
      '1102281964=  DO BEGIN'
      '1102281965=    SQLCODE_ = 0;'
      '1102281966=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '1102281967=    POS1_ = POSITION('#39'~'#39' IN SQL_);'
      '1102281968='
      
        '1102281969=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR' +
        ' POS1_ - POS_ - 1) AS BIGINT);'
      
        '1102281970=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1' +
        ' FOR CHAR_LENGTH(SQL_)) AS DATE);'
      
        '1102281971=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACT' +
        'ION_DATE_);'
      '1102281972='
      '1102281973=    SELECT SUM(K.SUMM)'
      '1102281974=      FROM KASSA K'
      '1102281975=     WHERE K."ACTION" = 0'
      '1102281976=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102281977=       AND K.G_TOCHKA = :G_TOCHKA_'
      '1102281978=      INTO :CREDIT_;'
      '1102281979=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '1102281980='
      '1102281981=    SELECT SUM(K.SUMM)'
      '1102281982=      FROM KASSA K'
      '1102281983=     WHERE K."ACTION" = 1'
      '1102281984=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102281985=       AND K.G_TOCHKA = :G_TOCHKA_'
      '1102281986=      INTO :DEBET_;'
      '1102281987=    DEBET_ = COALESCE(DEBET_, 0);'
      '1102281988='
      '1102281989=    MERGE INTO KASSA_STATE c'
      
        '1102281990=    USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCHKA_' +
        ' AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE AND' +
        ' C.G_TOCHKA = CD.G_TOCHKA)'
      '1102281991=    WHEN MATCHED THEN'
      '1102281992=        UPDATE SET'
      '1102281993=            C.DEBET  = :DEBET_,'
      '1102281994=            C.CREDIT = :CREDIT_,'
      
        '1102281995=            C."OUTPUT" = C."INPUT" - :DEBET_ + :CREDI' +
        'T_'
      '1102281996=    WHEN NOT MATCHED THEN'
      
        '1102281997=        INSERT (KASSA_STATE, K_DATE, "INPUT", DEBET, ' +
        'CREDIT, "OUTPUT", G_TOCHKA)'
      '1102281998=        VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '1102281999=                :ACTION_DATE_,'
      
        '1102282000=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102282001=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102282002=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0),'
      '1102282003=                :DEBET_,'
      '1102282004=                :CREDIT_,'
      
        '1102282005=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102282006=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102282007=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0) - :DEBET_ + :CREDIT_,'
      '1102282008=               :G_TOCHKA_);'
      '1102282009='
      
        '1102282010=    IF (G_TOCHKA_OLD_ > 0 AND G_TOCHKA_OLD_ <> G_TOCH' +
        'KA_ AND ACTION_DATE_MIN_OLD_ < CURRENT_DATE) THEN BEGIN'
      
        '1102282011=       EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_' +
        'MIN_OLD_, :G_TOCHKA_OLD_, 0)'
      '1102282012=         RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102282013=    END'
      '1102282014='
      '1102282015=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '1102282016=    UPDATE LOGS L'
      
        '1102282017=       SET L.IS_TRANSFERED = DECODE(:ERR_CODE, 0, 1, ' +
        '-1),'
      '1102282018=           L.ERR_CODE = :ERR_CODE'
      '1102282019=     WHERE L.ID = :LOGS_ID_'
      '1102282020=       AND L.USR = '#39'REPLICAT'#39
      '1102282021=       AND L.DAT IS NULL'
      '1102282022=       AND L.IS_TRANSFERED = 0;'
      '1102282023='
      '1102282024=    G_TOCHKA_OLD_ = G_TOCHKA_;'
      '1102282025=    ACTION_DATE_MIN_OLD_ = ACTION_DATE_MIN_;'
      '1102282026=  END'
      '1102282027='
      
        '1102282028=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045 +
        #1058
      '1102282029=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '1102282030=      EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_M' +
        'IN_, :G_TOCHKA_, 0)'
      '1102282031=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102282032=  END'
      '1102282033='
      
        '1102282034=  --=================================================' +
        '===================='
      '1102282035=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071
      
        '1102282036=  --=================================================' +
        '===================='
      '1102282037=  ACTION_DATE_MIN_ = CURRENT_DATE;'
      '1102282038=  FOR SELECT L.ID,'
      '1102282039=             L.SQLSTMT'
      '1102282040=        FROM LOGS L'
      '1102282041=       WHERE L.USR = '#39'REPLICAT'#39
      '1102282042=         AND L.DAT IS NULL'
      '1102282043=         AND L.IS_TRANSFERED = 0'
      
        '1102282044=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) >' +
        ' 0'
      '1102282045=        INTO :LOGS_ID_,'
      '1102282046=             :SQL_'
      '1102282047=  DO BEGIN'
      '1102282048=    SQLCODE_ = 0;'
      '1102282049=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '1102282050='
      
        '1102282051=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1)' +
        ' AS DATE);'
      
        '1102282052=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACT' +
        'ION_DATE_);'
      '1102282053='
      '1102282054=    SELECT SUM(K.SUMM)'
      '1102282055=      FROM KASSA_BEZNAL K'
      '1102282056=     WHERE K."ACTION" = 0'
      '1102282057=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102282058=      INTO :CREDIT_;'
      '1102282059=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '1102282060='
      '1102282061=    SELECT SUM(K.SUMM)'
      '1102282062=      FROM KASSA_BEZNAL K'
      '1102282063=     WHERE K."ACTION" = 1'
      '1102282064=       AND K.ACTION_DATE = :ACTION_DATE_'
      '1102282065=      INTO :DEBET_;'
      '1102282066=    DEBET_ = COALESCE(DEBET_, 0);'
      '1102282067='
      '1102282068=    MERGE INTO KASSA_BEZNAL_STATE c'
      
        '1102282069=    USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCHKA_' +
        ' AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE)'
      '1102282070=    WHEN MATCHED THEN'
      '1102282071=        UPDATE SET'
      '1102282072=            C.DEBET  = :DEBET_,'
      '1102282073=            C.CREDIT = :CREDIT_,'
      
        '1102282074=            C."OUTPUT" = C."INPUT" - :DEBET_ + :CREDI' +
        'T_'
      '1102282075=    WHEN NOT MATCHED THEN'
      
        '1102282076=        INSERT (KASSA_BEZNAL_STATE, K_DATE, "INPUT", ' +
        'DEBET, CREDIT, "OUTPUT")'
      '1102282077=        VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '1102282078=                :ACTION_DATE_,'
      
        '1102282079=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102282080=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102282081=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0),'
      '1102282082=                :DEBET_,'
      '1102282083=                :CREDIT_,'
      
        '1102282084=                COALESCE((SELECT "OUTPUT" FROM KASSA_' +
        'STATE'
      
        '1102282085=                          WHERE K_DATE = (SELECT MAX(' +
        'K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHKA' +
        ' = CD.G_TOCHKA)'
      
        '1102282086=                            AND G_TOCHKA = CD.G_TOCHK' +
        'A), 0) - :DEBET_ + :CREDIT_);'
      '1102282087='
      '1102282088=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '1102282089=    UPDATE LOGS L'
      
        '1102282090=       SET L.IS_TRANSFERED = DECODE(:ERR_CODE, 0, 1, ' +
        '-1),'
      '1102282091=           L.ERR_CODE = :ERR_CODE'
      '1102282092=     WHERE L.ID = :LOGS_ID_'
      '1102282093=       AND L.USR = '#39'REPLICAT'#39
      '1102282094=       AND L.DAT IS NULL'
      '1102282095=       AND L.IS_TRANSFERED = 0;'
      '1102282096='
      '1102282097=  END'
      '1102282098='
      
        '1102282099=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045 +
        #1058
      '1102282100=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '1102282101=    EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL(:ACTION_D' +
        'ATE_MIN_)'
      '1102282102=      RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102282103=  END'
      '1102282104='
      '1102282105=  /*'
      '1102282106=  POS_ = 1;'
      '1102282107=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '1102282108=    BEGIN'
      
        '1102282109=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ F' +
        'ROM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '1102282110='
      '1102282111=        WHILE (POS_ > 0) DO BEGIN'
      '1102282112=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '1102282113='
      '1102282114=            IF (POS_ > 0) THEN'
      
        '1102282115=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1' +
        ' FOR POS_ - 1);'
      '1102282116=            ELSE'
      '1102282117=              STR_ = PRODUCT_ID_ARR_;'
      '1102282118='
      
        '1102282119=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 F' +
        'OR POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '1102282120=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSI' +
        'TION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN ST' +
        'R_)) AS BIGINT);'
      '1102282121='
      
        '1102282122=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_' +
        'ARR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '1102282123='
      '1102282124=            select ('
      '1102282125=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102282126=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s, sklad_parent sp'
      '1102282127=                    where sp.SKLAD = s.SKLAD_PARENT'
      '1102282128=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '1102282129=                      and s.g_product = :G_PRODUCT_'
      
        '1102282130=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077 +
        ' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102282131='
      '1102282132=                   -'
      '1102282133=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102282134=                   (select COALESCE(sum(zr.AMOUNT_ALL' +
        '), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102282135=                    where zr.g_product = :G_PRODUCT_ ' +
        'and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102282136=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZA' +
        'KAZ_REAL_PARENT)'
      '1102282137='
      '1102282138=                   -'
      '1102282139=                   -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102282140=                   (select COALESCE(sum(zd.amount), 0' +
        ') from zakaz_details zd, zakaz z'
      
        '1102282141=                    where zd.g_product = :G_PRODUCT_ ' +
        'and Z.G_TOCHKA = :G_TOCHKA_'
      '1102282142=                    and zd.zakaz = z.zakaz'
      
        '1102282143=                    and z.IS_RESERVE = 0      -- '#1085#1077' '#1074 +
        #1099#1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081 +
        #1076#1077#1090' '#1085#1080#1078#1077
      
        '1102282144=                    and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095 +
        #1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' ' +
        #1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102282145=                    and not (z.IS_SPISANIE = 0 and z.' +
        'NOT_MINUS_OSTATOK = 1)'
      '1102282146=                   )'
      '1102282147='
      '1102282148=                   -'
      '1102282149=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102282150=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat =' +
        ' 3'
      '1102282151=                    and S.g_client = :G_TOCHKA_)'
      '1102282152='
      '1102282153=                   -'
      '1102282154=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102282155=                   (select COALESCE(sum(od.amount), 0' +
        ') from other_details od, other o'
      
        '1102282156=                    where od.g_product = :G_PRODUCT_ ' +
        'and o.G_TOCHKA = :G_TOCHKA_'
      '1102282157=                    and od.other = o.other)'
      '1102282158=                   ) amount,'
      '1102282159='
      
        '1102282160=                   (SELECT COALESCE(sum(ZD.amount), 0' +
        ') FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102282161=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AN' +
        'D Z.IS_RESERVE = 1'
      
        '1102282162=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.' +
        'G_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102282163=            from rdb$database'
      '1102282164=            INTO :AMOUNT_,'
      '1102282165=                 :AMOUNT_RESERVE_;'
      '1102282166='
      '1102282167=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102282168=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :' +
        'G_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102282169=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_' +
        'TOCHKA = CD.G_TOCHKA)'
      '1102282170=            WHEN MATCHED THEN'
      
        '1102282171=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.A' +
        'MOUNT_RESERVE = :AMOUNT_RESERVE_'
      '1102282172=            WHEN NOT MATCHED THEN'
      
        '1102282173=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, ' +
        'AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102282174=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, ' +
        ' 1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102282175=        END'
      '1102282176=    WHEN ANY DO'
      '1102282177=        BEGIN'
      '1102282178=            SQLCODE_ = GDSCODE;'
      '1102282179=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102282180=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102282181=            ERR_BODY = ERR_BODY ||'#39
      
        '1102282182=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102282183=        END'
      '1102282184=    END'
      '1102282185=  END'
      '1102282186='
      '1102282187=  */'
      '1102282188=END'
      '1102282189=;'
      '1102282190='
      '1102282191=ALTER PROCEDURE UPD_SKLAD('
      '1102282192=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102282193=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1102282194=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102282195=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102282196=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102282197=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102282198=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102282199=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102282200=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1102282201=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102282202=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102282203=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102282204=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102282205=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102282206=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102282207=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102282208=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102282209=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL,'
      '1102282210=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = NULL)'
      '1102282211=RETURNS ('
      '1102282212=  ERR_CODE INTEGER,'
      '1102282213=  ERR_MSG VARCHAR(1024))'
      '1102282214=AS'
      
        '1102282215=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1102282216=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      
        '1102282217=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057 +
        #1056#1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102282218=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1102282219=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102282220=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1102282221=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1102282222=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1102282223=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1102282224=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1102282225=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1102282226=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1102282227=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1102282228=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102282229=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1102282230=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102282231=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1102282232=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1102282233=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1102282234=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1102282235=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102282236=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102282237=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102282238=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102282239=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102282240=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102282241=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1102282242=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1102282243=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102282244=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102282245=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1102282246=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1102282247=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1102282248=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1102282249=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1102282250=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1102282251=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM;'
      
        '1102282252=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM;'
      '1102282253=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '1102282254=BEGIN'
      '1102282255='
      '1102282256=  IS_THIS_LAST_ = 0;'
      '1102282257='
      '1102282258=  SELECT S.G_TOCHKA,'
      '1102282259=         S.IS_VOZVRAT,'
      '1102282260=         S.G_PAYMENT_TYPE'
      '1102282261=         ,S.is_expected'
      
        '1102282262=         ,S.ZAKAZ          -- '#1055#1056#1048' '#1040#1055#1044#1045#1049#1058#1045' '#1053#1045' '#1055#1056#1048#1061#1054#1044#1048#1058 +
        ' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040
      '1102282263=    FROM SKLAD_parent S'
      '1102282264=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1102282265=    INTO :G_TOCHKA_,'
      '1102282266=         :IS_VOZVRAT_,'
      '1102282267=         :G_PAYMENT_TYPE_OLD_'
      '1102282268=         ,:IS_EXPECTED_OLD_'
      '1102282269=         ,:ZAKAZ_;'
      '1102282270='
      '1102282271=  PNT_ = '#39'00'#39';'
      '1102282272=  UPDATE SKLAD_PARENT'
      '1102282273=  SET'
      
        '1102282274=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1102282275=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1102282276=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1102282277=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1102282278=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102282279=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102282280=   SUMM      = :SUMM_,'
      '1102282281=   SUMM_FACT = :SUMM_FACT_,'
      '1102282282=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1102282283=   IS_PAYED_ALL  = CASE WHEN :SUMM_ <= :SUMM_FACT_ TH' +
        'EN 1 ELSE 0 END,  --IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, ' +
        '1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050 +
        #1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102282284=   IS_EXPECTED  = :IS_EXPECTED_'
      '1102282285=   ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102282286=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1102282287='
      
        '1102282288=  ---------------------------------------------------' +
        '----------'
      
        '1102282289=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1102282290=  PNT_ = '#39'02'#39';'
      '1102282291=  FOR SELECT SKLAD'
      '1102282292=        FROM SKLAD S'
      '1102282293=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1102282294=         AND NOT EXISTS (SELECT 1'
      '1102282295=                           FROM SKLAD_TMP T'
      '1102282296=                        WHERE T.SKLAD = S.SKLAD)'
      '1102282297=  INTO :SKLAD_'
      '1102282298=  DO BEGIN'
      
        '1102282299=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1102282300=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102282301=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102282302=      EXIT;'
      '1102282303=    END'
      '1102282304=  END'
      '1102282305='
      
        '1102282306=  ---------------------------------------------------' +
        '----------'
      
        '1102282307=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1102282308=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1102282309=  PNT_ = '#39'03'#39';'
      '1102282310=  FOR SELECT S.SKLAD,'
      '1102282311=             S.G_PRODUCT,'
      '1102282312=             S.AMOUNT,'
      '1102282313=             S.PRICE,'
      '1102282314=             S.SUMM,'
      '1102282315=             S.NDS,'
      '1102282316=             S.NDS_SUMM,'
      '1102282317=             T.SKLAD,'
      '1102282318=             T.AMOUNT,'
      '1102282319=             T.IS_LAST,'
      '1102282320=             T.DATE_RECEIPT'
      '1102282321=             ,S.PRICE_CURRENCY'
      '1102282322=             ,S.SUMM_CURRENCY'
      '1102282323=             ,S.PRICE_ROZN'
      
        '1102282324=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1102282325=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1102282326=  INTO :SKLAD_,'
      '1102282327=       :G_PRODUCT_,'
      '1102282328=       :AMOUNT_,'
      '1102282329=       :PRICE_,'
      '1102282330=       :SUMM_ONE_,'
      '1102282331=       :NDS_,'
      '1102282332=       :NDS_SUMM_,'
      '1102282333=       :SKLAD_OLD_,'
      '1102282334=       :AMOUNT_OLD_,'
      '1102282335=       :IS_THIS_LAST_,'
      '1102282336=       :DATE_RECEIPT_OLD_'
      '1102282337=       ,:PRICE_CURRENCY_'
      '1102282338=       ,:SUMM_CURRENCY_TMP_'
      '1102282339=       ,:SALE_PRICE_'
      '1102282340=       ,:SALE_PRICE_CUR_'
      '1102282341=  DO BEGIN'
      
        '1102282342=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102282343=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1102282344=        PNT_ = '#39'04'#39';'
      
        '1102282345=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1102282346=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1102282347=                          ,PRICE_CURRENCY'
      '1102282348=                          ,SUMM_CURRENCY)'
      
        '1102282349=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1102282350=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102282351=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1102282352=               ,:PRICE_CURRENCY_'
      '1102282353=               ,:SUMM_CURRENCY_TMP_'
      '1102282354=               );'
      '1102282355='
      
        '1102282356=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1102282357=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1102282358=            UPDATE LT_SKLAD_PRODUCT L'
      '1102282359=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102282360=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102282361=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102282362=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102282363='
      '1102282364=            IF (ROW_COUNT = 0) THEN'
      
        '1102282365=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102282366=        END'
      '1102282367='
      
        '1102282368=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102282369=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1102282370=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1102282371=        PNT_ = '#39'05'#39';'
      '1102282372=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1102282373=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102282374=              FROM SKLAD SK'
      '1102282375=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102282376=               AND SK.IS_LAST = 1'
      '1102282377=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102282378=              INTO :DATE_LAST_;'
      '1102282379='
      
        '1102282380=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102282381=              UPDATE SKLAD SK'
      '1102282382=                 SET SK.IS_LAST = 0'
      '1102282383=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102282384=                 AND SK.IS_LAST = 1'
      '1102282385=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102282386='
      '1102282387=              UPDATE SKLAD SK'
      '1102282388=                 SET SK.IS_LAST = 1'
      '1102282389=               WHERE SK.SKLAD = :SKLAD_;'
      '1102282390=            END'
      '1102282391=        END'
      
        '1102282392=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102282393=    END ELSE BEGIN'
      '1102282394=        PNT_ = '#39'06'#39';'
      '1102282395=        UPDATE SKLAD S'
      '1102282396=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1102282397=               S.G_CLIENT = :G_CLIENT_,'
      '1102282398=               S.AMOUNT   = :AMOUNT_,'
      '1102282399=               S.PRICE    = :PRICE_,'
      '1102282400=               S.SUMM     = :SUMM_ONE_,'
      '1102282401=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102282402=               S.NDS      = :NDS_,'
      '1102282403=               S.NDS_SUMM = :NDS_SUMM_,'
      '1102282404=               S.OSNOVANIE = :OSNOVANIE_,'
      '1102282405=               S.NOTE      = :NOTE_'
      '1102282406=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1102282407=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1102282408=         WHERE S.SKLAD = :SKLAD_;'
      '1102282409='
      '1102282410=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102282411=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_ AND IS_EX' +
        'PECTED_ = 0) THEN BEGIN'
      '1102282412=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1102282413=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102282414=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_),'
      
        '1102282415=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102282416=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102282417=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102282418='
      '1102282419=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1102282420=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102282421=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_),'
      
        '1102282422=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102282423=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102282424=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102282425=        END'
      
        '1102282426=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1102282427=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1102282428=            UPDATE LT_SKLAD_PRODUCT L'
      '1102282429=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102282430=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102282431=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102282432=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102282433='
      '1102282434=            IF (ROW_COUNT = 0) THEN'
      
        '1102282435=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102282436=        END'
      
        '1102282437=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1102282438=        ELSE IF (IS_EXPECTED_OLD_ = 0 AND IS_EXPECTED' +
        '_ = 1) THEN BEGIN'
      '1102282439=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1102282440=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_,'
      
        '1102282441=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102282442=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102282443=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102282444=        END'
      '1102282445='
      
        '1102282446=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1102282447=        /*PNT_ = '#39'07'#39';'
      
        '1102282448=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102282449=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102282450=              FROM SKLAD SK'
      '1102282451=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102282452=               AND SK.IS_LAST = 1'
      '1102282453=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102282454=              INTO :DATE_LAST_;'
      '1102282455='
      
        '1102282456=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102282457=              UPDATE SKLAD SK'
      '1102282458=                 SET SK.IS_LAST = 0'
      '1102282459=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102282460=                 AND SK.IS_LAST = 1'
      '1102282461=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102282462='
      '1102282463=              UPDATE SKLAD SK'
      '1102282464=                 SET SK.IS_LAST = 1'
      '1102282465=               WHERE SK.SKLAD = :SKLAD_;'
      '1102282466=            END'
      '1102282467=        END*/'
      '1102282468='
      
        '1102282469=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1102282470=        /*PNT_ = '#39'08'#39';'
      
        '1102282471=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102282472=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102282473=              FROM SKLAD SK'
      '1102282474=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102282475=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1102282476=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102282477=               AND SK.is_vozvrat IN (0,4)'
      '1102282478=              INTO :DATE_LAST_;'
      '1102282479='
      
        '1102282480=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102282481=              UPDATE SKLAD SK'
      '1102282482=                 SET SK.IS_LAST = 0'
      '1102282483=               WHERE SK.SKLAD = :SKLAD_;'
      '1102282484='
      '1102282485=               UPDATE SKLAD SK'
      '1102282486=                 SET SK.IS_LAST = 1'
      '1102282487=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102282488=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1102282489=                                   FROM SKLAD SS'
      
        '1102282490=                                  WHERE SS.G_PRODUCT ' +
        '= SK.G_PRODUCT'
      
        '1102282491=                                    AND SS.DATE_RECEI' +
        'PT = :DATE_LAST_'
      
        '1102282492=                                    AND SS.G_TOCHKA =' +
        ' :G_TOCHKA_'
      
        '1102282493=                                    AND SS.is_vozvrat' +
        ' IN (0,4));'
      '1102282494='
      '1102282495=            END'
      
        '1102282496=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054 +
        #1052' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' ' +
        #1053#1048#1052'.'
      
        '1102282497=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059 +
        #1044#1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '1102282498=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THI' +
        'S_LAST_ = 1)) THEN BEGIN'
      '1102282499=              UPDATE SKLAD SK'
      '1102282500=                 SET SK.IS_LAST = 1'
      '1102282501=               WHERE SK.SKLAD = :SKLAD_;'
      '1102282502=            END'
      '1102282503=        END*/'
      '1102282504=    END'
      '1102282505='
      
        '1102282506=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '1102282507=      UPDATE G_PRODUCT G'
      '1102282508=         SET G.PRICE = :SALE_PRICE_'
      '1102282509=       WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102282510=  END'
      '1102282511='
      
        '1102282512=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057 +
        #1057#1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '1102282513=      ----------------------------------------'
      
        '1102282514=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1055#1056#1048#1061#1054#1044#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102282515=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052'  - '#1058#1045#1055#1045#1056#1068' '#1069#1058#1054' '#1044#1045#1051#1040#1045#1058#1057#1071' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' K_UPD_KASSA'
      '1102282516=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102282517=      -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' ' +
        #1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054 +
        #1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1102282518=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057 +
        #1058#1042#1045#1053#1053#1054')'
      
        '1102282519=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102282520=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102282521='
      
        '1102282522=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056 +
        ' '#1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '1102282523=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053 +
        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1102282524=      IF (IS_VOZVRAT_ = 0) THEN'
      '1102282525=        G_PRIHOD_RASHOD_ = 2;'
      '1102282526=      ELSE'
      '1102282527=        G_PRIHOD_RASHOD_ = 3;'
      '1102282528='
      '1102282529=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102282530=            PNT_ = '#39'09'#39';'
      '1102282531=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102282532=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102282533=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102282534=            ELSE'
      
        '1102282535=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102282536='
      '1102282537=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102282538=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102282539='
      
        '1102282540=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1102282541=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1102282542=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102282543=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1102282544=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1102282545=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1102282546=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102282547=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1102282548=                                              :SKLAD_' +
        'PARENT_,'
      
        '1102282549=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1102282550=                                              :G_TOCH' +
        'KA_,'
      
        '1102282551=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102282552=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102282553='
      
        '1102282554=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102282555=            ELSE BEGIN'
      
        '1102282556=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102282557=                SELECT 1'
      '1102282558=                  FROM KASSA K'
      '1102282559=                 WHERE K.KASSA = :KASSA_'
      '1102282560=                UNION ALL'
      '1102282561=                SELECT 2'
      '1102282562=                  FROM KASSA_BEZNAL KB'
      '1102282563=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102282564=                 INTO :PAYMENT_TYPE_OLD_;'
      '1102282565='
      
        '1102282566=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102282567=                      PNT_ = '#39'010'#39';'
      
        '1102282568=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1102282569=                                                    1' +
        ',     -- ACTION_'
      
        '1102282570=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1102282571=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1102282572=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1102282573=                                                    N' +
