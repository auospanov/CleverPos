      '11023971=                                      :SUMM__,'
      '11023972=                                      :SUMM_FACT__,'
      '11023973=                                      :SUMM_CASH__,'
      '11023974=                                      :SUMM_NONCASH__,'
      
        '11023975=                                      :SUMM_PAY_BONUS__' +
        ','
      
        '11023976=                                      :SUMM_BONUS_GOT__' +
        ','
      
        '11023977=                                      NULL,        --:G' +
        '_PRIHOD_,'
      
        '11023978=                                      NULL,        --:S' +
        'UMM_PRIHOD_'
      '11023979=                                      :BY_RECIPE__,'
      '11023980=                                      :IS_RESERVE__'
      '11023981=                                      ,:PAYMENTS__'
      '11023982=                                      )'
      
        '11023983=                                      RETURNING_VALUES ' +
        ':ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '11023984=          IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11023985=            ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' (05)' +
        '. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3 FOR ' +
        'CHAR_LENGTH(ERR_MSG));'
      '11023986=            EXIT;'
      '11023987=          END'
      '11023988='
      '11023989=          UPDATE ZAKAZ Z'
      
        '11023990=          SET Z.G_OFFICIAL = DECODE(:G_OFFICIAL__, 0, N' +
        'ULL, NULL, NULL)'
      '11023991=          WHERE Z.ZAKAZ = :ZAKAZ_;'
      '11023992=      END'
      '11023993='
      '11023994=      -- '#1058#1045#1055#1045#1056#1068' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1070#1058' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '11023995=      FOR SELECT DATE_OPER, NOTE, G_PRODUCT, AMOUNT'
      '11023996=          FROM UPLOAD_TABLE_TMP'
      '11023997=          WHERE MODE = 6'
      '11023998=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '11023999=          INTO :DATE_OPER_, :NOTE_, :G_PRODUCT_, :AMOUN' +
        'T_'
      '11024000=      DO BEGIN'
      '110231001=        EXECUTE PROCEDURE DO_PRODUCT(:G_TOCHKA_,'
      '110231002=                                   :DATE_OPER_,'
      '110231003=                                   :G_PRODUCT_,'
      '110231004=                                   :AMOUNT_,'
      '110231005=                                   :NOTE_)'
      
        '110231006=                                   RETURNING_VALUES :S' +
        'KLAD_, :ERR_CODE, :ERR_MSG;'
      '110231007=      END'
      '110231008='
      
        '110231009=      DELETE FROM UPLOAD_TABLE_TMP WHERE UPLOAD_TABLE_' +
        'TMP = UPLOAD_TABLE_TMP;'
      '110231010=  END'
      '110231011='
      '110231012=WHEN ANY DO BEGIN'
      '110231013=    Err_code = -20500;'
      
        '110231014=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110231015=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110231016=  END'
      '110231017=end'
      '110231018='#39';'
      '110231019=END   --END_EXECUTE_BLOCK'
      '110240=EXECUTE BLOCK AS BEGIN'
      '110241=EXECUTE STATEMENT '#39'ALTER PROCEDURE DO_PRODUCT('
      
        '110242=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTEGE' +
        'R,'
      
        '110243=  DATE_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT */ DA' +
        'TE,'
      
