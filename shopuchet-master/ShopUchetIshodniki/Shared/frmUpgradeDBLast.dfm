      '11024021='
      '11024022=ALTER PROCEDURE INS_SKLAD('
      '11024023=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '11024024=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      
