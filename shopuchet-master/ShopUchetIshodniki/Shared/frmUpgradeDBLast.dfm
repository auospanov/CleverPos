      '110240925=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '110240926=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046 +
        #1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '110240927=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', ' +
        #1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110240928=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '110240929=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, T' +
        'IME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SU' +
        'MM_FACT,'
      
        '110240930=                                IS_PAYED_ALL, IS_VOZVR' +
        'AT, G_TOCHKA, IS_EXPECTED)'
      
        '110240931=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_' +
        ', :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SU' +
        'MM_FACT_,'
      '110240932=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '110240933=      RETURNING SKLAD'
      '110240934=      INTO :ZAKAZ_;'
      '110240935='
      '110240936=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110240937=            FROM ZAKAZ_DETAILS_TMP Z'
      '110240938=          INTO :G_PRODUCT,'
      '110240939=              :AMOUNT,'
      '110240940=              :PRICE,'
      '110240941=              :SUMM'
      '110240942=      DO BEGIN'
      '110240943=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110240944=        UPDATE LT_SKLAD_PRODUCT L'
      '110240945=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '110240946=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110240947=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110240948=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110240949='
      '110240950=        IF (ROW_COUNT = 0) THEN'
      
        '110240951=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110240952=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_' +
        'PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110240953='
      '110240954=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '110240955=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1053#1045#1058
      
        '110240956=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045#1064 +
        #1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' '#1062 +
        #1045#1053#1059
      '110240957=        SELECT MAX(SK.DATE_RECEIPT)'
      '110240958=            FROM SKLAD SK'
      '110240959=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110240960=             AND SK.IS_LAST = 1'
      '110240961=             AND SK.G_TOCHKA = :G_CLIENT_'
      '110240962=            INTO :DATE_LAST_;'
      '110240963='
      
        '110240964=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or' +
        ' (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110240965=            UPDATE SKLAD SK'
      '110240966=               SET SK.IS_LAST = 0'
      '110240967=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110240968=               AND SK.IS_LAST = 1'
      '110240969=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '110240970='
      '110240971=            IS_THIS_LAST_ = 1;'
      '110240972=        END */'
      '110240973='
      '110240974='
      '110240975=        INSERT INTO SKLAD'
      '110240976=        ('
      '110240977=         SKLAD,'
      '110240978=         SKLAD_PARENT,'
      '110240979=         DATE_RECEIPT,'
      '110240980=         G_CLIENT,'
      '110240981=         G_PRODUCT,'
      '110240982=         AMOUNT,'
      '110240983=         PRICE,'
      '110240984=         SUMM,'
      '110240985=         G_PAYMENT_TYPE,'
      '110240986=         OSNOVANIE,'
      '110240987=         NOTE,'
      '110240988=         NDS,'
      '110240989=         NDS_SUMM,'
      '110240990=         IS_LAST,'
      '110240991=         IS_VOZVRAT,'
      '110240992=         G_TOCHKA'
      '110240993=        ) VALUES ('
      '110240994=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '110240995=         :ZAKAZ_,'
      '110240996=         :Z_DATE_,'
      '110240997=         :G_TOCHKA_,'
      '110240998=         :G_PRODUCT,'
      '110240999=         :AMOUNT,'
      '1102401000=         :PRICE,'
      '1102401001=         :SUMM,'
      '1102401002=         :G_PAYMENT_TYPE_,'
      '1102401003=         :OSNOVANIE_,'
      '1102401004=         :NOTE_,'
      '1102401005=         0,  --:RNDS_,'
      '1102401006=         0,  --:RNDS_SUMM_,'
      
        '1102401007=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102401008=         3,  --:IS_VOZVRAT_,'
      '1102401009=         :G_CLIENT_'
      '1102401010=        );'
      '1102401011='
      
        '1102401012=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102401013=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102401014=        PNT_ = '#39'02'#39';'
      '1102401015=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102401016=            UPDATE LT_SKLAD_PRODUCT L'
      '1102401017=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102401018=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102401019=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102401020=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102401021='
      '1102401022=            IF (ROW_COUNT = 0) THEN'
      
        '1102401023=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102401024=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102401025=        END'
      '1102401026=      END'
      '1102401027=  END'
      '1102401028='
      '1102401029=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102401030='
      
        '1102401031=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102401032=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102401033=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102401034=                                  G_PRIHOD_,'
      '1102401035=                                  :SUMM_PRIHOD_,'
      '1102401036=                                  :Z_DATE_,'
      
        '1102401037=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102401038=                                  :ZAKAZ_,'
      '1102401039=                                  NULL,'
      '1102401040=                                  :G_PAYMENT_TYPE_,'
      '1102401041=                                  :G_TOCHKA_,'
      '1102401042=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102401043=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102401044=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102401045=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102401046=      EXIT;'
      '1102401047=    END'
      '1102401048=  END'
      '1102401049='
      
        '1102401050=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102401051=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102401052=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102401053=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102401054='
      '1102401055=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102401056=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102401057='
      '1102401058=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102401059=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102401060=end'
      '1102401061=;'
      '1102401062='
      '1102401063=ALTER PROCEDURE P_REP_KASSIR('
      '1102401064=  DATE_BEGIN_ DATE,'
      '1102401065=  DATE_END_ DATE,'
      '1102401066=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102401067=RETURNS ('
      '1102401068=  PERIOD_ VARCHAR(40),'
      '1102401069=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '1102401070=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '1102401071=  IN_SUMM_NONCASH_ TYPE OF MY_NUMERIC,'
      '1102401072=  OUT_SUMM_NONCASH_ TYPE OF MY_NUMERIC,'
      '1102401073=  ROWCOL INTEGER,'
      '1102401074=  Z_DATE VARCHAR(60),'
      '1102401075=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102401076=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102401077=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102401078=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102401079=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '1102401080=AS'
      '1102401081=/*'
      
        '1102401082='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071 +
        ', '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '1102401083=*/'
      '1102401084=DECLARE VARIABLE SORT_COL INTEGER;'
      '1102401085=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '1102401086=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '1102401087=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '1102401088=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102401089=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1102401090=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '1102401091=DECLARE VARIABLE SUMM_SALES_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      
        '1102401092=DECLARE VARIABLE SUMM_RETURNS_ALL_ TYPE OF NUMERIC_NU' +
        'LL = 0;'
      
        '1102401093=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '1102401094=DECLARE VARIABLE SUMM_PRIHOD_BEZNAL_ TYPE OF NUMERIC_' +
        'NULL = 0;'
      
        '1102401095=DECLARE VARIABLE SUMM_RASHOD_BEZNAL_ TYPE OF NUMERIC_' +
        'NULL = 0;'
      
        '1102401096=DECLARE VARIABLE SUMM_PRIHOD_ALL_BEZNAL_ TYPE OF NUME' +
        'RIC_NULL = 0;'
      
        '1102401097=DECLARE VARIABLE SUMM_RASHOD_ALL_BEZNAL_ TYPE OF NUME' +
        'RIC_NULL = 0;'
      '1102401098=DECLARE VARIABLE IS_NAL SMALLINT = 0;'
      '1102401099=BEGIN'
      
        '1102401100=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1102401101=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1102401102=  /*'#1042#1093#1086#1076#1103#1097#1080#1081' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072#1083'*/'
      '1102401103=  SELECT S."INPUT"'
      '1102401104=    FROM kassa_state S'
      '1102401105=   WHERE S.k_date = :DATE_BEGIN_'
      '1102401106=     AND S.g_tochka = :G_TOCHKA_'
      '1102401107=    INTO :IN_SUMM_;'
      '1102401108='
      '1102401109=  IF (ROW_COUNT = 0) THEN'
      '1102401110=    SELECT S."OUTPUT"'
      '1102401111=      FROM kassa_state S'
      '1102401112=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102401113=                         FROM KASSA_STATE ST'
      
        '1102401114=                        WHERE ST.k_date < :DATE_BEGIN' +
        '_'
      
        '1102401115=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1102401116=      AND S.g_tochka = :G_TOCHKA_'
      '1102401117=      INTO :IN_SUMM_;'
      '1102401118='
      '1102401119=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '1102401120=  /*'#1042#1093#1086#1076#1103#1097#1080#1081' '#1086#1089#1090#1072#1090#1086#1082' '#1073#1077#1079#1085#1072#1083'*/'
      '1102401121=  SELECT S."INPUT"'
      '1102401122=    FROM kassa_beznal_state S'
      '1102401123=   WHERE S.k_date = :DATE_BEGIN_'
      '1102401124=    INTO :IN_SUMM_NONCASH_;'
      '1102401125='
      '1102401126=  IF (ROW_COUNT = 0) THEN'
      '1102401127=    SELECT S."OUTPUT"'
      '1102401128=      FROM kassa_beznal_state S'
      '1102401129=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102401130=                         FROM KASSA_BEZNAL_STATE ST'
      
        '1102401131=                        WHERE ST.k_date < :DATE_BEGIN' +
        '_)'
      '1102401132=      INTO :IN_SUMM_NONCASH_;'
      '1102401133='
      '1102401134=  IN_SUMM_NONCASH_ = COALESCE(IN_SUMM_NONCASH_, 0);'
      '1102401135='
      
        '1102401136=  /* '#1050#1054#1056#1054#1063#1045' '#1048#1047'-'#1047#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048' '#1063#1058#1054'-'#1058#1054' '#1050#1056#1048#1042#1054' '#1057' '#1044#1042#1048#1046#1045#1053 +
        #1048#1045#1052' '#1044#1045#1053#1045#1043', '#1071' '#1061#1059#1049' '#1055#1054#1049#1052#1048' '#1055#1054#1063#1045#1052#1059' '#1048' '#1048#1047'-'#1047#1040' '#1063#1045#1043#1054' '#1047#1040#1045#1041#1040#1051#1054' '#1057#1059#1050#1040
      
        '1102401137=     '#1055#1054#1058#1054#1052#1059' '#1056#1045#1064#1048#1051' '#1055#1056#1054#1057#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1057#1045' '#1054#1055#1045#1056 +
        #1040#1062#1048#1048
      '1102401138=  SELECT S."OUTPUT"'
      '1102401139=    FROM kassa_state S'
      '1102401140=   WHERE S.k_date = :DATE_END_'
      '1102401141=     AND S.g_tochka = :G_TOCHKA_'
      '1102401142=    INTO :OUT_SUMM_;'
      '1102401143='
      '1102401144=  IF (ROW_COUNT = 0) THEN'
      '1102401145=    SELECT S."OUTPUT"'
      '1102401146=      FROM kassa_state S'
      '1102401147=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
