      '1101621712='
      '1101621713=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '1101621714=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101621715=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101621716=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101621717=RETURNS ('
      '1101621718=  ERR_CODE INTEGER,'
      '1101621719=  ERR_MSG VARCHAR(1024))'
      '1101621720=AS'
