      '1102462083=         :G_TOCHKA_,'
      '1102462084=         :G_PRODUCT,'
      '1102462085=         :AMOUNT,'
      '1102462086=         :PRICE,'
      '1102462087=         :SUMM,'
      '1102462088=         :G_PAYMENT_TYPE_,'
