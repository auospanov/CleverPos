        #1057#1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '1102016348=      ----------------------------------------'
      
        '1102016349=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1055#1056#1048#1061#1054#1044#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102016350=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052'  - '#1058#1045#1055#1045#1056#1068' '#1069#1058#1054' '#1044#1045#1051#1040#1045#1058#1057#1071' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' K_UPD_KASSA'
      '1102016351=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102016352=      -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' ' +
        #1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054 +
        #1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1102016353=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057 +
        #1058#1042#1045#1053#1053#1054')'
      
        '1102016354=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102016355=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102016356='
      
        '1102016357=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056 +
        ' '#1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '1102016358=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053 +
        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1102016359=      IF (IS_VOZVRAT_ = 0) THEN'
      '1102016360=        G_PRIHOD_RASHOD_ = 2;'
      '1102016361=      ELSE'
      '1102016362=        G_PRIHOD_RASHOD_ = 3;'
      '1102016363='
      '1102016364=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102016365=            PNT_ = '#39'09'#39';'
      '1102016366=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102016367=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102016368=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102016369=            ELSE'
      
        '1102016370=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102016371='
      '1102016372=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102016373=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102016374='
      
        '1102016375=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1102016376=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1102016377=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102016378=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1102016379=                                              :PAYMEN' +
