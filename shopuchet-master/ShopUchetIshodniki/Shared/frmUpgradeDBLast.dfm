        'TE_RECEIPT = :DATE_LAST_'
      
        '1101462165=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1101462166=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1101462167=                    END'
      '1101462168=                END*/'
      '1101462169=            END'
      '1101462170=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1101462171=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1101462172='
      '1101462173=      UPDATE SKLAD_PARENT'
      '1101462174=      SET'
      
        '1101462175=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
