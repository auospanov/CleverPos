        '1101371135=        FROM RDB$RELATION_FIELDS JOIN RDB$FIELDS ON R' +
        'DB$RELATION_FIELDS.RDB$FIELD_SOURCE=RDB$FIELDS.RDB$FIELD_NAME'
      
        '1101371136=       WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T CONTAINING '#39'$'#39
      '1101371137=         AND RDB$FIELDS.RDB$FIELD_TYPE = 261'
      '1101371138=         AND RDB$FIELDS.RDB$FIELD_SUB_TYPE = 0'
      
        '1101371139=         AND RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T IN ('#39'CUR_PARAMS'#39', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_' +
        'SIZES'#39','
      
        '1101371140=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1101371141=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1101371142=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1101371143=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1101371144=                                         '#39'REVISION'#39', ' +
        #39'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1101371145=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_TOC' +
        'HKA'#39', '#39'G_PRODUCT_FILL'#39','
      
        '1101371146=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39')'
      '1101371147=        INTO :TN,'
      '1101371148=             :FN'
      '1101371149=  DO BEGIN'
      '1101371150=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN BEGIN'
      '1101371151=      SELECT TRIM(F.RDB$FIELD_NAME)'
      '1101371152=        FROM RDB$RELATION_FIELDS F'
      '1101371153=       WHERE F.RDB$RELATION_NAME = :TN'
      '1101371154=         AND F.RDB$FIELD_POSITION = 0'
      '1101371155=        INTO :ID_COLUMN;'
      '1101371156=    END'
      '1101371157='
      
        '1101371158=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1101371159=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '1101371160=        '#39'AS '#39'||CRLF||'
      '1101371161=        '#39'BEGIN '#39'||CRLF||'
      
        '1101371162=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1101371163=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF|' +
        '|'
      
        '1101371164=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1101371165=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1101371166=        '#39'END;'#39';'
      '1101371167=    EXECUTE STATEMENT :TRGI;'
      '1101371168='
      
        '1101371169=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1101371170=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '1101371171=        '#39'AS '#39'||CRLF||'
      '1101371172=        '#39'BEGIN '#39'||CRLF||'
      
        '1101371173=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1101371174=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRL' +
        'F||'
      
        '1101371175=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1101371176=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1101371177=        '#39'END;'#39';'
      '1101371178=    EXECUTE STATEMENT :TRGI;'
      '1101371179='
      '1101371180=    TN_ALT = TN;'
      '1101371181=  END'
      '1101371182=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '1101371183=        FROM RDB$RELATIONS R'
      '1101371184=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1101371185=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '1101371186=       ORDER BY R.RDB$RELATION_NAME'
      '1101371187=        INTO :TN'
      '1101371188=  DO BEGIN'
      '1101371189=    TN=TRIM(TN);'
      '1101371190=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '1101371191='
      '1101371192=    EXECUTE STATEMENT :SQLSTMT;'
      '1101371193=  END'
      '1101371194=END'
      '1101371195=;'
      '1101371196='
      '1101371197=ALTER PROCEDURE P_REP_AVERAGE_BILL('
      '1101371198=  DATE_BEGIN_ DATE,'
      '1101371199=  DATE_END_ DATE,'
      '1101371200=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101371201=RETURNS ('
      '1101371202=  CNT_ INTEGER,'
      '1101371203=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1101371204=  ERR_CODE INTEGER,'
      '1101371205=  ERR_MSG VARCHAR(1024))'
      '1101371206=AS'
      
        '1101371207=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_AVERAG' +
        'E_BILL'#39';'
      '1101371208=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101371209=BEGIN'
      '1101371210=  SUMM_ = 0;'
      '1101371211='
      '1101371212=  SELECT COUNT(*)'
      '1101371213=    FROM ZAKAZ ZZ'
      
        '1101371214=   WHERE ZZ.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '1101371215=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOCHKA||' +
        #39'-'#39
      '1101371216=    INTO :CNT_;'
      '1101371217='
      '1101371218=  SELECT ROUND(SUM(Z.SUMM) / :CNT_, 2)'
      '1101371219=    FROM ZAKAZ Z'
      '1101371220=   WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101371221=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1101371222=    INTO :SUMM_;'
      '1101371223='
      '1101371224=  /*FOR'
      '1101371225=  SELECT :SUMM_'
      '1101371226=    FROM RDB$DATABASE R'
      '1101371227=    INTO :SUMM_'
      '1101371228=  DO'
      '1101371229=    SUSPEND; */'
      '1101371230='
      '1101371231=WHEN ANY DO BEGIN'
      '1101371232=    Err_code = -20500;'
      
        '1101371233=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' "'#1057#1056#1045#1044#1053#1048#1049' '#1063#1045#1050'"!'#39') RETURNING_VALUES (:ERR_M' +
        'SG);'
      
        '1101371234=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101371235=  END'
      '1101371236=end'
      '1101371237=;'
      '1101371238='
      '1101371239=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1101371240=RETURNS ('
      '1101371241=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '1101371242=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '1101371243=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '1101371244=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '1101371245=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '1101371246=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1101371247=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1101371248=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '1101371249=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '1101371250=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101371251=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101371252=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101371253=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101371254=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC,'
      '1101371255=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101371256=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC,'
      '1101371257=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101371258=  CHANGE_SALE_PRICE TYPE OF COLUMN SKLAD_TMP.CHANGE_S' +
        'ALE_PRICE)'
      '1101371259=AS'
      '1101371260=begin'
      '1101371261=  FOR'
      
        '1101371262=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T' +
        '.SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '1101371263=           ,PRICE_CURRENCY'
      '1101371264=           ,SUMM_CURRENCY'
      '1101371265=           ,CHARGE_ROZN_PROC'
      '1101371266=           ,PRICE_ROZN'
      '1101371267=           ,CHARGE_OPT_PROC'
      '1101371268=           ,PRICE_OPT'
      '1101371269=           ,CHANGE_SALE_PRICE'
      '1101371270=    FROM SKLAD_TMP T,'
      '1101371271=         G_PRODUCT P'
      '1101371272=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101371273=    ORDER BY T.sklad'
      
        '1101371274=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, ' +
        ':NDS, :NDS_SUMM, :NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '1101371275=      ,:PRICE_CURRENCY'
      '1101371276=      ,:SUMM_CURRENCY'
      '1101371277=      ,:CHARGE_ROZN_PROC'
      '1101371278=       ,:PRICE_ROZN'
      '1101371279=       ,:CHARGE_OPT_PROC'
      '1101371280=       ,:PRICE_OPT'
      '1101371281=       ,:CHANGE_SALE_PRICE'
      '1101371282=  DO'
      '1101371283=    suspend;'
      '1101371284=end'
      '1101371285=;'
      '1101371286='
      '1101371287=ALTER PROCEDURE UPD_SKLAD_TMP_ALL('
      '1101371288=  ROUND_MODE_ INTEGER,'
      '1101371289=  CHANGE_SALE_PRICE_ INTEGER,'
      
        '1101371290=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC = -1,'
      '1101371291=  MODE_ INTEGER = 0)'
      '1101371292=RETURNS ('
      '1101371293=  ERR_CODE INTEGER,'
      '1101371294=  ERR_MSG VARCHAR(1024))'
      '1101371295=AS'
      '1101371296=/*'
      '1101371297='#1053#1040#1050#1056#1059#1058#1050#1040' '#1053#1040' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', '#1057' '#1054#1050#1056#1059#1043#1051#1045#1053#1048#1045#1052
      '1101371298=*/'
      
        '1101371299=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD_A' +
        'LL'#39';'
      '1101371300=DECLARE VARIABLE ROUND_ INTEGER;'
      '1101371301=BEGIN'
      '1101371302='
      '1101371303=  IF (MODE_= 0) THEN BEGIN'
      '1101371304=      IF (ROUND_MODE_ = 0) THEN'
      '1101371305=          ROUND_ = 1;'
      '1101371306=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '1101371307=          ROUND_ = 0;'
      '1101371308=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '1101371309=          ROUND_ = -1;'
      '1101371310=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '1101371311=          ROUND_ = -2;'
      '1101371312=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '1101371313=          ROUND_ = -3;'
      '1101371314='
      '1101371315=      UPDATE SKLAD_TMP T'
      
        '1101371316=         SET T.CHARGE_ROZN_PROC = DECODE(:CHARGE_ROZN' +
        '_PROC_, -1, T.CHARGE_ROZN_PROC, :CHARGE_ROZN_PROC_),'
      
        '1101371317=             T.PRICE_ROZN = DECODE(:CHARGE_ROZN_PROC_' +
        ','
      
        '1101371318=                                   -1, ROUND( T.PRICE' +
        '_ROZN, :ROUND_),'
      
        '1101371319=                                   ROUND( (T.PRICE + ' +
        'T.PRICE * :CHARGE_ROZN_PROC_ / 100), :ROUND_));'
      '1101371320=  END'
      '1101371321=  ELSE BEGIN'
      '1101371322=    UPDATE SKLAD_TMP T'
      '1101371323=       SET T.CHANGE_SALE_PRICE = :CHANGE_SALE_PRICE_;'
      '1101371324=  END'
      '1101371325=END'
      '1101371326=;'
      '1101371327='
      '1101371328=ALTER PROCEDURE UPD_SKLAD_TMP1('
      '1101371329=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101371330=  OLD_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101371331=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101371332=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101371333=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101371334=  OLD_PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101371335=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101371336=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101371337=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101371338=  CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHARGE_' +
        'ROZN_PROC,'
      
        '1101371339=  OLD_CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHA' +
        'RGE_ROZN_PROC,'
      
        '1101371340=  CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARGE_O' +
        'PT_PROC,'
      
        '1101371341=  OLD_CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHAR' +
        'GE_OPT_PROC,'
      '1101371342=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101371343=  OLD_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN' +
        ','
      '1101371344=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      '1101371345=  OLD_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101371346=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1101371347=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0,'
      
        '1101371348=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_' +
        'SALE_PRICE = 0)'
      '1101371349=RETURNS ('
      '1101371350=  ERR_CODE INTEGER,'
      '1101371351=  ERR_MSG VARCHAR(1024))'
      '1101371352=AS'
      '1101371353=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101371354=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101371355=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLA' +
        'D.PRICE;'
      '1101371356=BEGIN'
      
        '1101371357=  -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1048#1051#1057#1071' '#1058#1054#1042#1040#1056', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040#1049#1058#1048' '#1057#1053#1054#1042#1040' '#1045#1043#1054' '#1047#1040 +
        #1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1062#1045#1053#1059' '#1054#1055#1058
      '1101371358=  PNT_ = '#39'01'#39';'
      '1101371359=  IF (G_PRODUCT_ <> OLD_G_PRODUCT_) THEN BEGIN'
      '1101371360=      /*SELECT S.PRICE'
      '1101371361=        FROM SKLAD S'
      
        '1101371362=       WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101371363=         AND S.IS_LAST = 1'
      '1101371364=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1101371365=        INTO :LAST_SELF_PRICE_;'
      '1101371366='
      '1101371367=      PRICE_ = COALESCE(LAST_SELF_PRICE_, 0);*/'
      
        '1101371368=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2), 0)'
      '1101371369=          RETURNING_VALUES :PRICE_;'
      '1101371370='
      '1101371371=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101371372=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101371373=        EXIT;'
      '1101371374=      END'
      '1101371375=  END'
      '1101371376='
      '1101371377=  IF (PRICE_ = 0) THEN BEGIN'
      '1101371378=    CHARGE_PRICE_ROZN_ = 0;'
      '1101371379=    CHARGE_PRICE_OPT_ = 0;'
      '1101371380=  END'
      '1101371381=  ELSE BEGIN'
      
        '1101371382=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048
      
        '1101371383=      IF (CHARGE_PRICE_ROZN_ <> OLD_CHARGE_PRICE_ROZN' +
        '_ OR (PRICE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 1)) THEN'
      
        '1101371384=        PRICE_ROZN_ = PRICE_ * CHARGE_PRICE_ROZN_/100' +
        ' + PRICE_;'
      '1101371385='
      
        '1101371386=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054 +
        #1062#1045#1053#1058', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101371387=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1053#1054' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1050#1040' '#1053 +
        #1045' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1062#1045#1053#1059' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1055#1056#1054#1062#1045#1053#1058
      
        '1101371388=      ELSE IF (PRICE_ROZN_ <> OLD_PRICE_ROZN_ OR (PRI' +
        'CE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 0) ) THEN'
      
        '1101371389=        CHARGE_PRICE_ROZN_ = ROUND((PRICE_ROZN_/PRICE' +
        '_ - 1)*100, 2);'
      '1101371390='
      
        '1101371391=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040#1062#1045#1053#1050#1040' '#1054#1055#1058' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047 +
        #1040#1050#1059#1055#1050#1048' , '#1047#1053#1040#1063#1048#1058' '#1062#1045#1053#1040' '#1054#1055#1058#1040' '#1053#1045' '#1052#1045#1053#1071#1051#1040#1057#1068', '#1041#1059#1044#1059' '#1045#1045' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101371392=      IF (CHARGE_PRICE_OPT_ <> OLD_CHARGE_PRICE_OPT_ ' +
        'OR (PRICE_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 1)) THEN'
      
        '1101371393=        PRICE_OPT_ = PRICE_ * CHARGE_PRICE_OPT_/100 +' +
        ' PRICE_;'
      '1101371394='
      
        '1101371395=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1054#1055#1058#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057 +
        #1071' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1055#1058#1040', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101371396=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1053#1054' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1050#1040' '#1053 +
        #1045' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1062#1045#1053#1059' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1055#1056#1054#1062#1045#1053#1058
      
        '1101371397=      ELSE IF (PRICE_OPT_ <> OLD_PRICE_OPT_ OR (PRICE' +
        '_ <> OLD_PRICE_ AND CHANGE_SALE_PRICE_ = 0)) THEN'
      
        '1101371398=        CHARGE_PRICE_OPT_ = ROUND((PRICE_OPT_/PRICE_ ' +
        '- 1)*100, 2);'
      '1101371399=  END'
      '1101371400='
      '1101371401=  UPDATE SKLAD_TMP T'
      '1101371402=  SET'
      '1101371403=    G_PRODUCT = :G_PRODUCT_,'
      '1101371404=    AMOUNT = :AMOUNT_,'
      '1101371405=    PRICE = :PRICE_,'
      '1101371406=    SUMM = :AMOUNT_ * :PRICE_,'
      '1101371407=    NDS = :NDS_,'
      '1101371408=    NDS_SUMM = :NDS_SUMM_'
      '1101371409=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '1101371410=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '1101371411=    ,T.CHARGE_ROZN_PROC = :CHARGE_PRICE_ROZN_'
      '1101371412=    ,T.PRICE_ROZN = :PRICE_ROZN_'
      '1101371413=    ,T.CHARGE_OPT_PROC = :CHARGE_PRICE_OPT_'
      '1101371414=    ,T.PRICE_OPT = :PRICE_OPT_'
      '1101371415=  WHERE'
      '1101371416=    SKLAD = :SKLAD_;'
      '1101371417=END'
      '1101371418=;'
      
        '1101371419=UPDATE SYSTEM_SETUP SET S_VALUE = 110137 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101371420=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101371421=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101380=UPDATE SYSTEM_SETUP SET S_VALUE = 110138 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101381=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101382=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101390=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1101391=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101392=  INCLUDE_NOL_ INTEGER,'
      '1101393=  INCLUDE_FEW_ INTEGER,'
      '1101394=  SORT_BY_NAME_ INTEGER,'
      '1101395=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101396=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101397=RETURNS ('
      '1101398=  PERIOD_ VARCHAR(40),'
      '1101399=  ROW_NUM VARCHAR(15),'
      '11013910=  ARTICUL VARCHAR(1000),'
      '11013911=  BARCODE VARCHAR(30),'
      
        '11013912=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11013913=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11013914=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11013915=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11013916=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11013917=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '11013918=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        '_RESERVE,'
      '11013919=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '11013920=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '11013921=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '11013922=  TOVAR_NAME VARCHAR(250),'
      '11013923=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11013924=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11013925=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '11013926=  ERR_CODE INTEGER,'
      '11013927=  ERR_MSG VARCHAR(1024))'
      '11013928=AS'
      
        '11013929=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK_' +
        'TOVAROV'#39';'
      '11013930=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11013931=DECLARE VARIABLE I INTEGER = 1;'
      '11013932=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11013933=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11013934=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11013935=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11013936=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11013937=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11013938=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11013939=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '11013940=BEGIN'
      '11013941='
      
        '11013942=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11013943=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11013944='
      '11013945=  SELECT S.S_VALUE,'
      '11013946=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '11013947=    FROM SYSTEM_SETUP S'
      '11013948=   WHERE S.SYSTEM_SETUP = 1'
      '11013949=    INTO :FORMULA_,'
      '11013950=         :PRIHOD_CNT_;'
      '11013951='
      '11013952=  FOR SELECT GP.PATH,'
      '11013953=             GP.G_PRODUCT'
      '11013954=        FROM P_REP_TREE GP'
      '11013955=       WHERE EXISTS (SELECT 1'
      '11013956=                       FROM G_PRODUCT'
      '11013957=                      WHERE IS_CATEGORY = 0'
      
        '11013958=                        AND G_PRODUCT_PAR = GP.G_PRODUC' +
        'T'
      '11013959=                    )'
      
        '11013960=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11013961=              OR'
      '11013962=              (:G_CATEGORY_ is NULL)'
      '11013963=             )'
      '11013964=       ORDER BY 1, 2'
      '11013965=       INTO :PATH_NAME_,'
      '11013966=            :G_PRODUCT_'
      '11013967=  DO BEGIN'
      
        '11013968=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057 +
        ' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054
      
        '11013969=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068 +
        ' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '11013970=      SELECT COUNT(G.G_PRODUCT)'
      
        '11013971=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL' +
        '.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11013972=                                          WHERE :G_TOCH' +
        'KA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT) ' +
        'L ON G.G_PRODUCT = L.G_PRODUCT'
      '11013973=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11013974=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11013975=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (CO' +
        'ALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11013976=              OR'
      
        '11013977=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_' +
        ', 0) = 1)'
      '11013978=              or'
      
        '11013979=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_' +
        ', 0) = 1))'
      '11013980=             )'
      '11013981=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11013982=         AND ((EXISTS (SELECT 1'
      '11013983=                       FROM SKLAD S'
      '11013984=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '11013985=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '11013986=                        AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11013987=              OR'
      '11013988=              COALESCE(:G_CLIENT_, 0) = 0)'
      '11013989=        INTO :CNT_;'
      '11013990='
      '11013991=      IF (CNT_ > 0) THEN BEGIN'
      
        '11013992=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE' +
        '_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '11013993=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), ' +
        ':PATH_NAME_, 1);'
      '11013994='
      
        '11013995=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE,'
      '11013996=                                              ARTICUL,'
      '11013997=                                              BARCODE,'
      
        '11013998=                                              NOMENCLAT' +
        'UR_NUM,'
      '11013999=                                              NAME,'
      
        '110139100=                                              UNIT_NAM' +
        'E,'
      '110139101=                                              PRICE,'
      
        '110139102=                                              VOLUME_P' +
        'RICE,'
      '110139103=                                              AMOUNT,'
      
        '110139104=                                              AMOUNT_R' +
        'ESERVE,'
      '110139105=                                              SUMM,'
      
        '110139106=                                              PRICE_SE' +
        'LF,'
      
        '110139107=                                              SORT_COL' +
        ','
      
        '110139108=                                              IS_CATEG' +
        'ORY,'
      '110139109=                                              NOTE,'
      
        '110139110=                                              CROSSCOD' +
        'E)'
      
        '110139111=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110139112=                 G.ARTICUL,'
      '110139113=                 G.BARCODE,'
      '110139114=                 G.NOMENCLATUR_NUM,'
      '110139115=                 G.NAME,'
      '110139116=                 U.SHORT_NAME,'
      '110139117=                 G.PRICE,'
      '110139118=                 G.VOLUME_PRICE,'
      '110139119=                 COALESCE(S.AMOUNT, 0),'
      '110139120=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110139121=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110139122=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110139123=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110139124=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110139125=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110139126=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110139127=                  DECODE(:FORMULA_,'
      '110139128=                         1,'
      '110139129=                         (SELECT S.price'
      '110139130=                            FROM SKLAD S'
      
        '110139131=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110139132=                             AND S.g_product = :G_PROD' +
        'UCT_'
      
        '110139133=                             AND S.IS_VOZVRAT IN (0, 4' +
        ')'
      
        '110139134=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110139135=                                                     F' +
        'ROM SKLAD DD'
      
        '110139136=                                                    WH' +
        'ERE DD.g_product = :G_PRODUCT_'
      
        '110139137=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110139138=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 4)'
      '110139139=                                                    )'
      '110139140=                            ORDER BY 1 DESC'
      '110139141=                            ROWS 1 TO 1'
      '110139142=                         ),'
      
        '110139143=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110139144=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110139145=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110139146=                                         SKLAD S'
      
        '110139147=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110139148=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110139149=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110139150=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110139151=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110139152=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110139153=                         )), 0) spr,'
      
        '110139154=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110139155=                 0'
      '110139156=                 ,G.NOTE'
      
        '110139157=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      
        '110139158=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110139159=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110139160=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110139161=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110139162=             AND G.IS_CATEGORY = 0'
      '110139163=             AND G.is_active = 1'
      '110139164=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110139165=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110139166=                  OR'
      
        '110139167=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110139168=                  or'
      
        '110139169=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110139170=                 )'
      '110139171=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110139172=             AND ((EXISTS (SELECT 1'
      '110139173=                           FROM SKLAD S'
      
        '110139174=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110139175=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110139176=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110139177=                  OR'
      '110139178=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110139179=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '110139180=      END'
      '110139181=  END'
      '110139182='
      
        '110139183=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110139184='
      
        '110139185=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AMO' +
        'UNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '110139186=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110139187=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110139188=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE,' +
        ' :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_C' +
        'ATEGORY, :TOVAR_NAME'
      '110139189=  DO BEGIN'
      '110139190=    I = I + 1;'
      '110139191=    SUSPEND;'
      '110139192=  END'
      '110139193=WHEN ANY DO BEGIN'
      '110139194=    Err_code = -20500;'
      
        '110139195=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110139196=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110139197=  END'
      '110139198=end'
      '110139199=;'
      '110139200='
      '110139201=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110139202=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110139203=  INCLUDE_NOL_ INTEGER,'
      '110139204=  INCLUDE_FEW_ INTEGER,'
      '110139205=  SORT_BY_NAME_ INTEGER,'
      '110139206=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110139207=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110139208=RETURNS ('
      '110139209=  PERIOD_ VARCHAR(40),'
      '110139210=  ROW_NUM VARCHAR(15),'
      '110139211=  ARTICUL VARCHAR(1000),'
      '110139212=  BARCODE VARCHAR(30),'
      
        '110139213=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110139214=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110139215=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110139216=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110139217=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110139218=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110139219=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110139220=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110139221=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110139222=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110139223=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110139224=  TOVAR_NAME VARCHAR(250),'
      '110139225=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110139226=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110139227=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110139228=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110139229=  ERR_CODE INTEGER,'
      '110139230=  ERR_MSG VARCHAR(1024))'
      '110139231=AS'
      '110139232=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '110139233=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110139234=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110139235=DECLARE VARIABLE I INTEGER = 1;'
      '110139236=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110139237=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110139238=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110139239=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110139240=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110139241=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110139242=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110139243=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110139244=BEGIN'
      '110139245='
      
        '110139246=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110139247=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110139248='
      '110139249=  SELECT S.S_VALUE,'
      '110139250=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110139251=    FROM SYSTEM_SETUP S'
      '110139252=   WHERE S.SYSTEM_SETUP = 1'
      '110139253=    INTO :FORMULA_,'
      '110139254=         :PRIHOD_CNT_;'
      '110139255='
      '110139256=  FOR SELECT GP.PATH,'
      '110139257=             GP.G_PRODUCT'
      '110139258=        FROM P_REP_TREE GP'
      '110139259=       WHERE EXISTS (SELECT 1'
      '110139260=                       FROM G_PRODUCT'
      '110139261=                      WHERE IS_CATEGORY = 0'
      
        '110139262=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110139263=                    )'
      
        '110139264=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110139265=              OR'
      '110139266=              (:G_CATEGORY_ is NULL)'
      '110139267=             )'
      '110139268=       ORDER BY 1, 2'
      '110139269=       INTO :PATH_NAME_,'
      '110139270=            :G_PRODUCT_'
      '110139271=  DO BEGIN'
      
        '110139272=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110139273=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110139274=      SELECT COUNT(G.G_PRODUCT)'
      
        '110139275=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110139276=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110139277=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110139278=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110139279=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110139280=              OR'
      
        '110139281=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110139282=              or'
      
        '110139283=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110139284=             )'
      '110139285=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110139286=         AND ((EXISTS (SELECT 1'
      '110139287=                       FROM SKLAD S'
      '110139288=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110139289=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110139290=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110139291=              OR'
      '110139292=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110139293=        INTO :CNT_;'
      '110139294='
      '110139295=      IF (CNT_ > 0) THEN BEGIN'
      
        '110139296=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110139297=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110139298='
      
        '110139299=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110139300=                                              ARTICUL,'
      '110139301=                                              BARCODE,'
      
        '110139302=                                              NOMENCLA' +
        'TUR_NUM,'
      '110139303=                                              NAME,'
      
        '110139304=                                              UNIT_NAM' +
        'E,'
      '110139305=                                              PRICE,'
      
        '110139306=                                              VOLUME_P' +
        'RICE,'
      
        '110139307=                                              SKIDKA_P' +
        'RICE,'
      '110139308=                                              AMOUNT,'
      
        '110139309=                                              AMOUNT_R' +
        'ESERVE,'
      '110139310=                                              SUMM,'
      
        '110139311=                                              PRICE_SE' +
        'LF,'
      
        '110139312=                                              SORT_COL' +
        ','
      
        '110139313=                                              IS_CATEG' +
        'ORY,'
      '110139314=                                              NOTE,'
      
        '110139315=                                              CROSSCOD' +
        'E,'
      '110139316=                                              PLACE)'
      
        '110139317=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110139318=                 G.ARTICUL,'
      '110139319=                 G.BARCODE,'
      '110139320=                 G.NOMENCLATUR_NUM,'
      '110139321=                 G.NAME,'
      '110139322=                 U.SHORT_NAME,'
      '110139323=                 G.PRICE,'
      '110139324=                 G.VOLUME_PRICE,'
      '110139325=                 G.PRICE - GD.SKIDKA_SUM,'
      '110139326=                 COALESCE(S.AMOUNT, 0),'
      '110139327=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110139328=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110139329=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110139330=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110139331=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110139332=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110139333=                  DECODE(:FORMULA_,'
      '110139334=                         1,'
      '110139335=                         (SELECT S.price'
      '110139336=                            FROM SKLAD S'
      
        '110139337=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110139338=                             AND S.g_product = :G_PROD' +
        'UCT_'
      
        '110139339=                             AND S.IS_VOZVRAT IN (0, 4' +
        ')'
      
        '110139340=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110139341=                                                     F' +
        'ROM SKLAD DD'
      
        '110139342=                                                    WH' +
        'ERE DD.g_product = :G_PRODUCT_'
      
        '110139343=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110139344=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 4)'
      '110139345=                                                    )'
      '110139346=                            ORDER BY 1 DESC'
      '110139347=                            ROWS 1 TO 1'
      '110139348=                         ),'
      
        '110139349=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110139350=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110139351=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110139352=                                         SKLAD S'
      
        '110139353=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110139354=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110139355=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110139356=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110139357=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110139358=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '110139359=                        )), 0) spr,'
      
        '110139360=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110139361=                 0'
      '110139362=                 ,G.NOTE'
      
        '110139363=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110139364=                 ,G.PLACE'
      
        '110139365=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '110139366=                                                FROM G' +
        '_DISCOUNT D'
      
        '110139367=                                                WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110139368=                                                      ' +
        '  AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '110139369=                                                      ' +
        '  AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '110139370=                                                      ' +
        ')'
      
        '110139371=                                                      ' +
        'OR'
      
        '110139372=                                                      ' +
        '(D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '110139373=                                                 AND (' +
        '(:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '110139374=                                                     O' +
        'R'
      
        '110139375=                                                     (' +
        'D.G_TOCHKA IS NULL))'
      
        '110139376=                                              ) GD ON ' +
        'G.G_PRODUCT = GD.G_PRODUCT'
      
        '110139377=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110139378=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110139379=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110139380=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110139381=             AND G.IS_CATEGORY = 0'
      '110139382=             AND G.is_active = 1'
      '110139383=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110139384=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110139385=                  OR'
      
        '110139386=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110139387=                  or'
      
        '110139388=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110139389=                 )'
      '110139390=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110139391=             AND ((EXISTS (SELECT 1'
      '110139392=                           FROM SKLAD S'
      
        '110139393=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110139394=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110139395=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110139396=                  OR'
      '110139397=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110139398=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '110139399=      END'
      '110139400=  END'
      '110139401='
      
        '110139402=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110139403='
      
        '110139404=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKID' +
        'KA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE' +
        '_SELF, IS_CATEGORY,'
      '110139405=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110139406=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110139407=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLU' +
        'ME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE' +
        '_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110139408=  DO BEGIN'
      '110139409=    I = I + 1;'
      '110139410=    SUSPEND;'
      '110139411=  END'
      '110139412='
      '110139413=     /*'
      '110139414=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110139415='
      '110139416=     SELECT :I,'
      
        '110139417=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110139418=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110139419=             U.SHORT_NAME UNIT_NAME,'
      '110139420=             SS.PRICE,'
      '110139421=             SS.VOLUME_PRICE,'
      '110139422=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110139423=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110139424=             SS.IS_CATEGORY'
      '110139425=        FROM (WITH RECURSIVE TREE'
      '110139426=              AS (SELECT T.G_PRODUCT,'
      '110139427=                       T.NAME AS ARTICUL,'
      
        '110139428=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110139429=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110139430=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110139431=                       T.IS_CATEGORY,'
      '110139432=                       NULL G_UNIT'
      '110139433=                  FROM G_PRODUCT T'
      '110139434=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110139435=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110139436=                UNION ALL'
      '110139437=                SELECT T.G_PRODUCT,'
      '110139438=                       DECODE(T. T.ARTICUL,'
      '110139439=                       T.NAME,'
      '110139440=                       T.PRICE,'
      '110139441=                       T.VOLUME_PRICE,'
      '110139442=                       T.IS_CATEGORY,'
      '110139443=                       T.G_UNIT'
      
        '110139444=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110139445=                 WHERE T.IS_ACTIVE = 1'
      '110139446=                )'
      '110139447=             SELECT * FROM TREE) SS'
      
        '110139448=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110139449=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110139450=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110139451=    INTO :ROW_NUM,'
      '110139452=        :ARTICUL,'
      '110139453=        :NAME,'
      '110139454=        :UNIT_NAME,'
      '110139455=        :PRICE,'
      '110139456=        :VOLUME_PRICE,'
      '110139457=        :SKIDKA_PRICE,'
      '110139458=        :AMOUNT,'
      '110139459=        :IS_CATEGORY'
      '110139460=    DO BEGIN'
      '110139461=      I = I + 1;'
      '110139462=      SUSPEND;'
      '110139463=    END  */'
      '110139464=WHEN ANY DO BEGIN'
      '110139465=    Err_code = -20500;'
      
        '110139466=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110139467=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110139468=  END'
      '110139469=end'
      '110139470=;'
      '110139471='
      '110139472=ALTER PROCEDURE RECALC_SELF_PRICES('
      '110139473=  DATE_ DATE)'
      '110139474=AS'
      '110139475=/*'
      
        '110139476='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048', '#1063#1058#1054#1041#1067' '#1055#1045#1056#1045#1057#1063 +
        #1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1067#1045' '#1062#1045#1053#1067' '#1055#1054' '#1040#1050#1058#1059#1040#1051#1068#1053#1067#1052' '#1047#1053#1040#1063#1045#1053#1048#1071#1052'.'
      
        '110139477='#1069#1058#1054' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1052#1040#1043#1040#1047#1048#1053#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1055#1056#1054#1044#1040#1070#1058' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1047#1040 +
        #1050#1040#1047'. '#1058#1054' '#1045#1057#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1054#1060#1054#1056#1052#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059', '#1040' '#1055#1054#1058#1054#1052' '#1050#1059#1055#1048#1051#1048' '#1058#1054#1042#1040#1056' '#1048' '#1054#1060 +
        #1054#1056#1052#1048#1051#1048' '#1055#1056#1048#1061#1054#1044','
      
        '110139478='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1046#1045' '#1054#1058' '#1069#1058#1054#1043#1054' '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071 +
        ', '#1045#1045' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054'.'
      '110139479='#1055#1056#1048' '#1056#1040#1057#1063#1045#1058#1045' '#1041#1059#1044#1059' '#1054#1058#1058#1040#1051#1050#1048#1042#1040#1058#1068#1057#1071' '#1054#1058' '#1044#1040#1058#1067' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110139480=*/'
      
        '110139481=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE;'
      
        '110139482=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.G_PRODUCT;'
      
        '110139483=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110139484=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.C' +
        'OST_PRICE;'
      '110139485=BEGIN'
      '110139486=  IF (G_TOCHKA_ IS NULL) THEN'
      '110139487=    SELECT ID'
      '110139488=      FROM CUR_PARAMS'
      '110139489=     WHERE CUR_PARAMS = 2'
      '110139490=      INTO :G_TOCHKA_;'
      '110139491='
      '110139492=  /*SELECT S.S_VALUE'
      '110139493=    FROM SYSTEM_SETUP S'
      '110139494=   WHERE S.SYSTEM_SETUP = 1'
      '110139495=    INTO :FORMULA_;*/'
      '110139496='
      '110139497=  FOR SELECT T.G_PRODUCT'
      '110139498=        FROM ZAKAZ_DETAILS_TMP T'
      '110139499=       GROUP BY T.G_PRODUCT'
      '110139500=        INTO :G_PRODUCT_'
      '110139501=  DO BEGIN'
      
        '110139502=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_,' +
        ' :G_TOCHKA_, 1)'
      '110139503=        RETURNING_VALUES :PRICE_;'
      '110139504='
      '110139505=    UPDATE ZAKAZ_DETAILS_TMP M'
      '110139506=       SET M.COST_PRICE = :PRICE_'
      '110139507=     WHERE M.G_PRODUCT = :G_PRODUCT_;'
      '110139508=  END'
      '110139509=END'
      '110139510=;'
      
        '110139511=UPDATE SYSTEM_SETUP SET S_VALUE = 110139 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110139512=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110139513=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101400=ALTER PROCEDURE G_GET_G_PRODUCT('
      
        '1101401=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BI' +
        'GINT,'
      '1101402=  MODE_ INTEGER = 0)'
      '1101403=RETURNS ('
      
        '1101404=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR */ BIGINT,'
      '1101405=  ARTICUL_ VARCHAR(30),'
      '1101406=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101407=  BARCODE_ VARCHAR(30),'
      '1101408=  NAME_ VARCHAR(500),'
      '1101409=  G_UNIT_ /* TYPE OF COLUMN G_UNIT.G_UNIT */ BIGINT,'
      '11014010=  PRICE_ NUMERIC(15,2),'
      '11014011=  VOLUME_PRICE_ NUMERIC(15,2),'
      
        '11014012=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT ' +
        '*/ NUMERIC(15,2),'
      
        '11014013=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */' +
        ' VARCHAR(150),'
      
        '11014014=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300' +
        '),'
      
        '11014015=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ B' +
        'LOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '11014016=  IS_KIT_ /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER' +
        ','
      
        '11014017=  MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT */' +
        ' NUMERIC(15,2),'
      
        '11014018=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      
        '11014019=  SALES_COMM_ /* TYPE OF COLUMN G_PRODUCT.SALES_COMM */' +
        ' NUMERIC(15,2),'
      
        '11014020=  KOD_TNVD_ /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VAR' +
        'CHAR(50),'
      
        '11014021=  FAST_TOVAR_ /* TYPE OF COLUMN G_PRODUCT.FAST_TOVAR */' +
        ' INTEGER,'
      
        '11014022=  DO_NOT_SHOW_RMK_ /* TYPE OF COLUMN G_PRODUCT.DO_NOT_S' +
        'HOW_RMK */ INTEGER,'
      
        '11014023=  DO_NOT_CHARGE_BONUS_ /* TYPE OF COLUMN G_PRODUCT.DO_N' +
        'OT_CHARGE_BONUS */ INTEGER,'
      
        '11014024=  LAST_PRICE_ /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUME' +
        'RIC(15,2),'
      '11014025=  ERR_CODE INTEGER,'
      '11014026=  ERR_MSG VARCHAR(1024))'
      '11014027=AS'
      '11014028=BEGIN'
      '11014029=  SUSPEND;'
      '11014030=END'
      '11014031=;'
      '11014032='
      '11014033='
      
        '11014034=/******************************************************' +
        '************************/'
      
        '11014035=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11014036=/******************************************************' +
        '************************/'
      '11014037=ALTER PROCEDURE G_GET_G_PRODUCT('
      '11014038=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11014039=  MODE_ INTEGER = 0)'
      '11014040=RETURNS ('
      
        '11014041=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11014042=  ARTICUL_ VARCHAR(30),'
      '11014043=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11014044=  BARCODE_ VARCHAR(30),'
      '11014045=  NAME_ VARCHAR(500),'
      '11014046=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11014047=  PRICE_ NUMERIC(15,2),'
      '11014048=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11014049=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11014050=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11014051=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11014052=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11014053=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11014054=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11014055=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11014056=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11014057=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11014058=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '11014059=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHOW' +
        '_RMK,'
      
        '11014060=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT_' +
        'CHARGE_BONUS,'
      '11014061=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11014062=  ERR_CODE INTEGER,'
      '11014063=  ERR_MSG VARCHAR(1024))'
      '11014064=AS'
      '11014065=begin'
      '11014066=    SELECT'
      '11014067=        G_PRODUCT_PAR,'
      '11014068=        ARTICUL,'
      '11014069=        NOMENCLATUR_NUM,'
      '11014070=        BARCODE,'
      '11014071=        NAME,'
      '11014072=        G_UNIT,'
      '11014073=        PRICE,'
      '11014074=        VOLUME_PRICE,'
      '11014075=        PACK_AMOUNT,'
      '11014076=        MF_COUNTRY,'
      '11014077=        NOTE,'
      '11014078=        CROSSCODE,'
      '11014079=        IS_KIT,'
      '11014080=        MIN_AMOUNT,'
      '11014081=        PLACE,'
      '11014082=        SALES_COMM,'
      '11014083=        KOD_TNVD,'
      '11014084=        FAST_TOVAR,'
      '11014085=        DO_NOT_SHOW_RMK,'
      '11014086=        DO_NOT_CHARGE_BONUS,'
      
        '11014087=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT_,' +
        ' NULL, 1))'
      '11014088=    FROM G_PRODUCT T'
      '11014089=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11014090=    INTO'
      '11014091=        :G_PRODUCT_PAR_,'
      '11014092=        :ARTICUL_,'
      '11014093=        :NOMENCLATUR_NUM_,'
      '11014094=        :BARCODE_,'
      '11014095=        :NAME_,'
      '11014096=        :G_UNIT_,'
      '11014097=        :PRICE_,'
      '11014098=        :VOLUME_PRICE_,'
      '11014099=        :PACK_AMOUNT_,'
      '110140100=        :MF_COUNTRY_,'
      '110140101=        :NOTE_,'
      '110140102=        :CROSSCODE_,'
      '110140103=        :IS_KIT_,'
      '110140104=        :MIN_AMOUNT_,'
      '110140105=        :PLACE_,'
      '110140106=        :SALES_COMM_,'
      '110140107=        :KOD_TNVD_,'
      '110140108=        :FAST_TOVAR_,'
      '110140109=        :DO_NOT_SHOW_RMK_,'
      '110140110=        :DO_NOT_CHARGE_BONUS_,'
      '110140111=        :LAST_PRICE_;'
      '110140112='
      '110140113=    INSERT INTO LT_BARCODE_TMP'
      
        '110140114=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110140115='
      '110140116=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110140117=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110140118='
      
        '110140119=    INSERT INTO G_PRODUCT_KIT_TMP (G_PRODUCT_KIT, G_PR' +
        'ODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3)'
      
        '110140120=    SELECT DECODE(:MODE_, 0, G_PRODUCT_KIT, GEN_ID(GEN' +
        '_G_PRODUCT_KIT, 1)), G_PRODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, P' +
        'RICE1, PRICE2, PRICE3'
      '110140121=    FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRODUCT_;'
      '110140122=end'
      '110140123=;'
      
        '110140124=UPDATE SYSTEM_SETUP SET S_VALUE = 110140 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110140125=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110140126=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101410=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1101411=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101412=  INCLUDE_NOL_ INTEGER,'
      '1101413=  INCLUDE_FEW_ INTEGER,'
      '1101414=  SORT_BY_NAME_ INTEGER,'
      '1101415=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101416=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101417=RETURNS ('
      '1101418=  PERIOD_ VARCHAR(40),'
      '1101419=  ROW_NUM VARCHAR(15),'
      '11014110=  ARTICUL VARCHAR(1000),'
      '11014111=  BARCODE VARCHAR(30),'
      
        '11014112=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11014113=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11014114=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11014115=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11014116=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11014117=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '11014118=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        '_RESERVE,'
      '11014119=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '11014120=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '11014121=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '11014122=  TOVAR_NAME VARCHAR(250),'
      '11014123=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11014124=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11014125=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '11014126=  ERR_CODE INTEGER,'
      '11014127=  ERR_MSG VARCHAR(1024))'
      '11014128=AS'
      
        '11014129=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK_' +
        'TOVAROV'#39';'
      '11014130=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11014131=DECLARE VARIABLE I INTEGER = 1;'
      '11014132=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11014133=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11014134=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11014135=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11014136=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11014137=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11014138=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11014139=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '11014140=BEGIN'
      '11014141='
      
        '11014142=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11014143=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11014144='
      '11014145=  SELECT S.S_VALUE,'
      '11014146=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '11014147=    FROM SYSTEM_SETUP S'
      '11014148=   WHERE S.SYSTEM_SETUP = 1'
      '11014149=    INTO :FORMULA_,'
      '11014150=         :PRIHOD_CNT_;'
      '11014151='
      '11014152=  FOR SELECT GP.PATH,'
      '11014153=             GP.G_PRODUCT'
      '11014154=        FROM P_REP_TREE GP'
      '11014155=       WHERE EXISTS (SELECT 1'
      '11014156=                       FROM G_PRODUCT'
      '11014157=                      WHERE IS_CATEGORY = 0'
      
        '11014158=                        AND G_PRODUCT_PAR = GP.G_PRODUC' +
        'T'
      '11014159=                    )'
      
        '11014160=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11014161=              OR'
      '11014162=              (:G_CATEGORY_ is NULL)'
      '11014163=             )'
      '11014164=       ORDER BY 1, 2'
      '11014165=       INTO :PATH_NAME_,'
      '11014166=            :G_PRODUCT_'
      '11014167=  DO BEGIN'
      
        '11014168=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057 +
        ' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054
      
        '11014169=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068 +
        ' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '11014170=      SELECT COUNT(G.G_PRODUCT)'
      
        '11014171=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL' +
        '.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11014172=                                          WHERE :G_TOCH' +
        'KA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT) ' +
        'L ON G.G_PRODUCT = L.G_PRODUCT'
      '11014173=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11014174=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11014175=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (CO' +
        'ALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11014176=              OR'
      
        '11014177=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_' +
        ', 0) = 1)'
      '11014178=              or'
      
        '11014179=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_' +
        ', 0) = 1))'
      '11014180=             )'
      '11014181=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11014182=         AND ((EXISTS (SELECT 1'
      '11014183=                       FROM SKLAD S'
      '11014184=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '11014185=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '11014186=                        AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11014187=              OR'
      '11014188=              COALESCE(:G_CLIENT_, 0) = 0)'
      '11014189=        INTO :CNT_;'
      '11014190='
      '11014191=      IF (CNT_ > 0) THEN BEGIN'
      
        '11014192=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE' +
        '_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '11014193=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), ' +
        ':PATH_NAME_, 1);'
      '11014194='
      
        '11014195=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE,'
      '11014196=                                              ARTICUL,'
      '11014197=                                              BARCODE,'
      
        '11014198=                                              NOMENCLAT' +
        'UR_NUM,'
      '11014199=                                              NAME,'
      
        '110141100=                                              UNIT_NAM' +
        'E,'
      '110141101=                                              PRICE,'
      
        '110141102=                                              VOLUME_P' +
        'RICE,'
      '110141103=                                              AMOUNT,'
      
        '110141104=                                              AMOUNT_R' +
        'ESERVE,'
      '110141105=                                              SUMM,'
      
        '110141106=                                              PRICE_SE' +
        'LF,'
      
        '110141107=                                              SORT_COL' +
        ','
      
        '110141108=                                              IS_CATEG' +
        'ORY,'
      '110141109=                                              NOTE,'
      
        '110141110=                                              CROSSCOD' +
        'E)'
      
        '110141111=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110141112=                 G.ARTICUL,'
      '110141113=                 G.BARCODE,'
      '110141114=                 G.NOMENCLATUR_NUM,'
      '110141115=                 G.NAME,'
      '110141116=                 U.SHORT_NAME,'
      '110141117=                 G.PRICE,'
      '110141118=                 G.VOLUME_PRICE,'
      '110141119=                 COALESCE(S.AMOUNT, 0),'
      '110141120=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110141121=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110141122=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110141123=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110141124=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110141125=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110141126=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110141127=                  DECODE(:FORMULA_,'
      '110141128=                         1,'
      '110141129=                         (SELECT S.price'
      '110141130=                            FROM SKLAD S'
      
        '110141131=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110141132=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110141133=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110141134=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110141135=                                                     F' +
        'ROM SKLAD DD'
      
        '110141136=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110141137=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110141138=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110141139=                                                    )'
      '110141140=                            ORDER BY 1 DESC'
      '110141141=                            ROWS 1 TO 1'
      '110141142=                         ),'
      
        '110141143=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110141144=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110141145=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110141146=                                         SKLAD S'
      
        '110141147=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110141148=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110141149=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110141150=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110141151=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110141152=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110141153=                         )), 0) spr,'
      
        '110141154=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110141155=                 0'
      '110141156=                 ,G.NOTE'
      
        '110141157=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      
        '110141158=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110141159=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110141160=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110141161=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110141162=             AND G.IS_CATEGORY = 0'
      '110141163=             AND G.is_active = 1'
      '110141164=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110141165=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110141166=                  OR'
      
        '110141167=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110141168=                  or'
      
        '110141169=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110141170=                 )'
      '110141171=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110141172=             AND ((EXISTS (SELECT 1'
      '110141173=                           FROM SKLAD S'
      
        '110141174=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110141175=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110141176=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110141177=                  OR'
      '110141178=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110141179=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '110141180=      END'
      '110141181=  END'
      '110141182='
      
        '110141183=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110141184='
      
        '110141185=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AMO' +
        'UNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '110141186=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110141187=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110141188=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE,' +
        ' :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_C' +
        'ATEGORY, :TOVAR_NAME'
      '110141189=  DO BEGIN'
      '110141190=    I = I + 1;'
      '110141191=    SUSPEND;'
      '110141192=  END'
      '110141193=WHEN ANY DO BEGIN'
      '110141194=    Err_code = -20500;'
      
        '110141195=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110141196=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110141197=  END'
      '110141198=end'
      '110141199=;'
      '110141200='
      '110141201=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110141202=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110141203=  INCLUDE_NOL_ INTEGER,'
      '110141204=  INCLUDE_FEW_ INTEGER,'
      '110141205=  SORT_BY_NAME_ INTEGER,'
      '110141206=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110141207=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110141208=RETURNS ('
      '110141209=  PERIOD_ VARCHAR(40),'
      '110141210=  ROW_NUM VARCHAR(15),'
      '110141211=  ARTICUL VARCHAR(1000),'
      '110141212=  BARCODE VARCHAR(30),'
      
        '110141213=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110141214=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110141215=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110141216=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110141217=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110141218=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110141219=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110141220=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110141221=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110141222=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110141223=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110141224=  TOVAR_NAME VARCHAR(250),'
      '110141225=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110141226=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110141227=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110141228=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110141229=  ERR_CODE INTEGER,'
      '110141230=  ERR_MSG VARCHAR(1024))'
      '110141231=AS'
      '110141232=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '110141233=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110141234=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110141235=DECLARE VARIABLE I INTEGER = 1;'
      '110141236=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110141237=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110141238=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110141239=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110141240=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110141241=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110141242=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110141243=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110141244=BEGIN'
      '110141245='
      
        '110141246=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110141247=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110141248='
      '110141249=  SELECT S.S_VALUE,'
      '110141250=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110141251=    FROM SYSTEM_SETUP S'
      '110141252=   WHERE S.SYSTEM_SETUP = 1'
      '110141253=    INTO :FORMULA_,'
      '110141254=         :PRIHOD_CNT_;'
      '110141255='
      '110141256=  FOR SELECT GP.PATH,'
      '110141257=             GP.G_PRODUCT'
      '110141258=        FROM P_REP_TREE GP'
      '110141259=       WHERE EXISTS (SELECT 1'
      '110141260=                       FROM G_PRODUCT'
      '110141261=                      WHERE IS_CATEGORY = 0'
      
        '110141262=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110141263=                    )'
      
        '110141264=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110141265=              OR'
      '110141266=              (:G_CATEGORY_ is NULL)'
      '110141267=             )'
      '110141268=       ORDER BY 1, 2'
      '110141269=       INTO :PATH_NAME_,'
      '110141270=            :G_PRODUCT_'
      '110141271=  DO BEGIN'
      
        '110141272=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110141273=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110141274=      SELECT COUNT(G.G_PRODUCT)'
      
        '110141275=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110141276=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110141277=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110141278=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110141279=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110141280=              OR'
      
        '110141281=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110141282=              or'
      
        '110141283=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110141284=             )'
      '110141285=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110141286=         AND ((EXISTS (SELECT 1'
      '110141287=                       FROM SKLAD S'
      '110141288=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110141289=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110141290=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110141291=              OR'
      '110141292=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110141293=        INTO :CNT_;'
      '110141294='
      '110141295=      IF (CNT_ > 0) THEN BEGIN'
      
        '110141296=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110141297=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110141298='
      
        '110141299=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110141300=                                              ARTICUL,'
      '110141301=                                              BARCODE,'
      
        '110141302=                                              NOMENCLA' +
        'TUR_NUM,'
      '110141303=                                              NAME,'
      
        '110141304=                                              UNIT_NAM' +
        'E,'
      '110141305=                                              PRICE,'
      
        '110141306=                                              VOLUME_P' +
        'RICE,'
      
        '110141307=                                              SKIDKA_P' +
        'RICE,'
      '110141308=                                              AMOUNT,'
      
        '110141309=                                              AMOUNT_R' +
        'ESERVE,'
      '110141310=                                              SUMM,'
      
        '110141311=                                              PRICE_SE' +
        'LF,'
      
        '110141312=                                              SORT_COL' +
        ','
      
        '110141313=                                              IS_CATEG' +
        'ORY,'
      '110141314=                                              NOTE,'
      
        '110141315=                                              CROSSCOD' +
        'E,'
      '110141316=                                              PLACE)'
      
        '110141317=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110141318=                 G.ARTICUL,'
      '110141319=                 G.BARCODE,'
      '110141320=                 G.NOMENCLATUR_NUM,'
      '110141321=                 G.NAME,'
      '110141322=                 U.SHORT_NAME,'
      '110141323=                 G.PRICE,'
      '110141324=                 G.VOLUME_PRICE,'
      '110141325=                 G.PRICE - GD.SKIDKA_SUM,'
      '110141326=                 COALESCE(S.AMOUNT, 0),'
      '110141327=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110141328=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110141329=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110141330=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110141331=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110141332=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110141333=                  DECODE(:FORMULA_,'
      '110141334=                         1,'
      '110141335=                         (SELECT S.price'
      '110141336=                            FROM SKLAD S'
      
        '110141337=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110141338=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110141339=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110141340=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110141341=                                                     F' +
        'ROM SKLAD DD'
      
        '110141342=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110141343=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110141344=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110141345=                                                    )'
      '110141346=                            ORDER BY 1 DESC'
      '110141347=                            ROWS 1 TO 1'
      '110141348=                         ),'
      
        '110141349=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110141350=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110141351=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110141352=                                         SKLAD S'
      
        '110141353=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110141354=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110141355=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110141356=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110141357=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110141358=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '110141359=                        )), 0) spr,'
      
        '110141360=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110141361=                 0'
      '110141362=                 ,G.NOTE'
      
        '110141363=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110141364=                 ,G.PLACE'
      
        '110141365=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '110141366=                                                FROM G' +
        '_DISCOUNT D'
      
        '110141367=                                                WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110141368=                                                      ' +
        '  AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '110141369=                                                      ' +
        '  AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '110141370=                                                      ' +
        ')'
      
        '110141371=                                                      ' +
        'OR'
      
        '110141372=                                                      ' +
        '(D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '110141373=                                                 AND (' +
        '(:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '110141374=                                                     O' +
        'R'
      
        '110141375=                                                     (' +
        'D.G_TOCHKA IS NULL))'
      
        '110141376=                                              ) GD ON ' +
        'G.G_PRODUCT = GD.G_PRODUCT'
      
        '110141377=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110141378=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110141379=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110141380=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110141381=             AND G.IS_CATEGORY = 0'
      '110141382=             AND G.is_active = 1'
      '110141383=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110141384=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110141385=                  OR'
      
        '110141386=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110141387=                  or'
      
        '110141388=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110141389=                 )'
      '110141390=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110141391=             AND ((EXISTS (SELECT 1'
      '110141392=                           FROM SKLAD S'
      
        '110141393=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110141394=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110141395=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110141396=                  OR'
      '110141397=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110141398=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '110141399=      END'
      '110141400=  END'
      '110141401='
      
        '110141402=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110141403='
      
        '110141404=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKID' +
        'KA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE' +
        '_SELF, IS_CATEGORY,'
      '110141405=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110141406=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110141407=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLU' +
        'ME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE' +
        '_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110141408=  DO BEGIN'
      '110141409=    I = I + 1;'
      '110141410=    SUSPEND;'
      '110141411=  END'
      '110141412='
      '110141413=     /*'
      '110141414=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110141415='
      '110141416=     SELECT :I,'
      
        '110141417=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110141418=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110141419=             U.SHORT_NAME UNIT_NAME,'
      '110141420=             SS.PRICE,'
      '110141421=             SS.VOLUME_PRICE,'
      '110141422=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110141423=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110141424=             SS.IS_CATEGORY'
      '110141425=        FROM (WITH RECURSIVE TREE'
      '110141426=              AS (SELECT T.G_PRODUCT,'
      '110141427=                       T.NAME AS ARTICUL,'
      
        '110141428=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110141429=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110141430=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110141431=                       T.IS_CATEGORY,'
      '110141432=                       NULL G_UNIT'
      '110141433=                  FROM G_PRODUCT T'
      '110141434=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110141435=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110141436=                UNION ALL'
      '110141437=                SELECT T.G_PRODUCT,'
      '110141438=                       DECODE(T. T.ARTICUL,'
      '110141439=                       T.NAME,'
      '110141440=                       T.PRICE,'
      '110141441=                       T.VOLUME_PRICE,'
      '110141442=                       T.IS_CATEGORY,'
      '110141443=                       T.G_UNIT'
      
        '110141444=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110141445=                 WHERE T.IS_ACTIVE = 1'
      '110141446=                )'
      '110141447=             SELECT * FROM TREE) SS'
      
        '110141448=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110141449=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110141450=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110141451=    INTO :ROW_NUM,'
      '110141452=        :ARTICUL,'
      '110141453=        :NAME,'
      '110141454=        :UNIT_NAME,'
      '110141455=        :PRICE,'
      '110141456=        :VOLUME_PRICE,'
      '110141457=        :SKIDKA_PRICE,'
      '110141458=        :AMOUNT,'
      '110141459=        :IS_CATEGORY'
      '110141460=    DO BEGIN'
      '110141461=      I = I + 1;'
      '110141462=      SUSPEND;'
      '110141463=    END  */'
      '110141464=WHEN ANY DO BEGIN'
      '110141465=    Err_code = -20500;'
      
        '110141466=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110141467=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110141468=  END'
      '110141469=end'
      '110141470=;'
      
        '110141471=UPDATE SYSTEM_SETUP SET S_VALUE = 110141 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110141472=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110141473=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101420=UPDATE SYSTEM_SETUP SET S_VALUE = 110142 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101421=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101422=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101430='
      '1101431=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1101432=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101433=  INCLUDE_NOL_ INTEGER,'
      '1101434=  INCLUDE_FEW_ INTEGER,'
      '1101435=  SORT_BY_NAME_ INTEGER,'
      '1101436=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101437=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101438=RETURNS ('
      '1101439=  PERIOD_ VARCHAR(40),'
      '11014310=  ROW_NUM VARCHAR(15),'
      '11014311=  ARTICUL VARCHAR(1000),'
      '11014312=  BARCODE VARCHAR(30),'
      
        '11014313=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11014314=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11014315=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11014316=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11014317=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11014318=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '11014319=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        '_RESERVE,'
      '11014320=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '11014321=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '11014322=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '11014323=  TOVAR_NAME VARCHAR(250),'
      '11014324=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11014325=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11014326=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '11014327=  ERR_CODE INTEGER,'
      '11014328=  ERR_MSG VARCHAR(1024))'
      '11014329=AS'
      
        '11014330=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK_' +
        'TOVAROV'#39';'
      '11014331=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11014332=DECLARE VARIABLE I INTEGER = 1;'
      '11014333=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11014334=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11014335=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11014336=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11014337=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11014338=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11014339=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11014340=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '11014341=BEGIN'
      '11014342='
      
        '11014343=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11014344=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11014345='
      '11014346=  SELECT S.S_VALUE,'
      '11014347=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '11014348=    FROM SYSTEM_SETUP S'
      '11014349=   WHERE S.SYSTEM_SETUP = 1'
      '11014350=    INTO :FORMULA_,'
      '11014351=         :PRIHOD_CNT_;'
      '11014352='
      '11014353=  FOR SELECT GP.PATH,'
      '11014354=             GP.G_PRODUCT'
      '11014355=        FROM P_REP_TREE GP'
      '11014356=       WHERE EXISTS (SELECT 1'
      '11014357=                       FROM G_PRODUCT'
      '11014358=                      WHERE IS_CATEGORY = 0'
      
        '11014359=                        AND G_PRODUCT_PAR = GP.G_PRODUC' +
        'T'
      '11014360=                    )'
      
        '11014361=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11014362=              OR'
      '11014363=              (:G_CATEGORY_ is NULL)'
      '11014364=             )'
      '11014365=       ORDER BY 1, 2'
      '11014366=       INTO :PATH_NAME_,'
      '11014367=            :G_PRODUCT_'
      '11014368=  DO BEGIN'
      
        '11014369=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057 +
        ' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054
      
        '11014370=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068 +
        ' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '11014371=      SELECT COUNT(G.G_PRODUCT)'
      
        '11014372=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL' +
        '.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11014373=                                          WHERE :G_TOCH' +
        'KA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT) ' +
        'L ON G.G_PRODUCT = L.G_PRODUCT'
      '11014374=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11014375=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11014376=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (CO' +
        'ALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11014377=              OR'
      
        '11014378=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_' +
        ', 0) = 1)'
      '11014379=              or'
      
        '11014380=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_' +
        ', 0) = 1))'
      '11014381=             )'
      '11014382=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11014383=         AND ((EXISTS (SELECT 1'
      '11014384=                       FROM SKLAD S'
      '11014385=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '11014386=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '11014387=                        AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11014388=              OR'
      '11014389=              COALESCE(:G_CLIENT_, 0) = 0)'
      '11014390=        INTO :CNT_;'
      '11014391='
      '11014392=      IF (CNT_ > 0) THEN BEGIN'
      
        '11014393=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE' +
        '_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '11014394=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), ' +
        ':PATH_NAME_, 1);'
      '11014395='
      
        '11014396=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE,'
      '11014397=                                              ARTICUL,'
      '11014398=                                              BARCODE,'
      
        '11014399=                                              NOMENCLAT' +
        'UR_NUM,'
      '110143100=                                              NAME,'
      
        '110143101=                                              UNIT_NAM' +
        'E,'
      '110143102=                                              PRICE,'
      
        '110143103=                                              VOLUME_P' +
        'RICE,'
      '110143104=                                              AMOUNT,'
      
        '110143105=                                              AMOUNT_R' +
        'ESERVE,'
      '110143106=                                              SUMM,'
      
        '110143107=                                              PRICE_SE' +
        'LF,'
      
        '110143108=                                              SORT_COL' +
        ','
      
        '110143109=                                              IS_CATEG' +
        'ORY,'
      '110143110=                                              NOTE,'
      
        '110143111=                                              CROSSCOD' +
        'E)'
      
        '110143112=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110143113=                 G.ARTICUL,'
      '110143114=                 G.BARCODE,'
      '110143115=                 G.NOMENCLATUR_NUM,'
      '110143116=                 G.NAME,'
      '110143117=                 U.SHORT_NAME,'
      '110143118=                 G.PRICE,'
      '110143119=                 G.VOLUME_PRICE,'
      '110143120=                 COALESCE(S.AMOUNT, 0),'
      '110143121=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110143122=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110143123=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110143124=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110143125=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110143126=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110143127=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110143128=                  DECODE(:FORMULA_,'
      '110143129=                         1,'
      '110143130=                         (SELECT S.price'
      '110143131=                            FROM SKLAD S'
      
        '110143132=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110143133=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110143134=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110143135=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110143136=                                                     F' +
        'ROM SKLAD DD'
      
        '110143137=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110143138=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110143139=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110143140=                                                    )'
      '110143141=                            ORDER BY 1 DESC'
      '110143142=                            ROWS 1 TO 1'
      '110143143=                         ),'
      
        '110143144=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110143145=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110143146=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110143147=                                         SKLAD S'
      
        '110143148=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110143149=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110143150=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110143151=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110143152=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110143153=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110143154=                         )), 0) spr,'
      
        '110143155=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110143156=                 0'
      '110143157=                 ,G.NOTE'
      
        '110143158=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      
        '110143159=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110143160=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110143161=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110143162=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110143163=             AND G.IS_CATEGORY = 0'
      '110143164=             AND G.is_active = 1'
      '110143165=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110143166=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110143167=                  OR'
      
        '110143168=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110143169=                  or'
      
        '110143170=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110143171=                 )'
      '110143172=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110143173=             AND ((EXISTS (SELECT 1'
      '110143174=                           FROM SKLAD S'
      
        '110143175=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110143176=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110143177=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110143178=                  OR'
      '110143179=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110143180=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '110143181=      END'
      '110143182=  END'
      '110143183='
      
        '110143184=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110143185='
      
        '110143186=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AMO' +
        'UNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '110143187=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110143188=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110143189=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE,' +
        ' :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_C' +
        'ATEGORY, :TOVAR_NAME'
      '110143190=  DO BEGIN'
      '110143191=    I = I + 1;'
      '110143192=    SUSPEND;'
      '110143193=  END'
      '110143194=WHEN ANY DO BEGIN'
      '110143195=    Err_code = -20500;'
      
        '110143196=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110143197=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110143198=  END'
      '110143199=end'
      '110143200=;'
      '110143201='
      '110143202=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110143203=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110143204=  INCLUDE_NOL_ INTEGER,'
      '110143205=  INCLUDE_FEW_ INTEGER,'
      '110143206=  SORT_BY_NAME_ INTEGER,'
      '110143207=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110143208=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110143209=RETURNS ('
      '110143210=  PERIOD_ VARCHAR(40),'
      '110143211=  ROW_NUM VARCHAR(15),'
      '110143212=  ARTICUL VARCHAR(1000),'
      '110143213=  BARCODE VARCHAR(30),'
      
        '110143214=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110143215=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110143216=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110143217=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110143218=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110143219=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110143220=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110143221=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110143222=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110143223=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110143224=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110143225=  TOVAR_NAME VARCHAR(250),'
      '110143226=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110143227=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110143228=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110143229=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110143230=  ERR_CODE INTEGER,'
      '110143231=  ERR_MSG VARCHAR(1024))'
      '110143232=AS'
      '110143233=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '110143234=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110143235=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110143236=DECLARE VARIABLE I INTEGER = 1;'
      '110143237=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110143238=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110143239=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110143240=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110143241=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110143242=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110143243=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110143244=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110143245=BEGIN'
      '110143246='
      
        '110143247=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110143248=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110143249='
      '110143250=  SELECT S.S_VALUE,'
      '110143251=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110143252=    FROM SYSTEM_SETUP S'
      '110143253=   WHERE S.SYSTEM_SETUP = 1'
      '110143254=    INTO :FORMULA_,'
      '110143255=         :PRIHOD_CNT_;'
      '110143256='
      '110143257=  FOR SELECT GP.PATH,'
      '110143258=             GP.G_PRODUCT'
      '110143259=        FROM P_REP_TREE GP'
      '110143260=       WHERE EXISTS (SELECT 1'
      '110143261=                       FROM G_PRODUCT'
      '110143262=                      WHERE IS_CATEGORY = 0'
      
        '110143263=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110143264=                    )'
      
        '110143265=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110143266=              OR'
      '110143267=              (:G_CATEGORY_ is NULL)'
      '110143268=             )'
      '110143269=       ORDER BY 1, 2'
      '110143270=       INTO :PATH_NAME_,'
      '110143271=            :G_PRODUCT_'
      '110143272=  DO BEGIN'
      
        '110143273=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110143274=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110143275=      SELECT COUNT(G.G_PRODUCT)'
      
        '110143276=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110143277=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110143278=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110143279=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110143280=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110143281=              OR'
      
        '110143282=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110143283=              or'
      
        '110143284=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110143285=             )'
      '110143286=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110143287=         AND ((EXISTS (SELECT 1'
      '110143288=                       FROM SKLAD S'
      '110143289=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110143290=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110143291=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110143292=              OR'
      '110143293=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110143294=        INTO :CNT_;'
      '110143295='
      '110143296=      IF (CNT_ > 0) THEN BEGIN'
      
        '110143297=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110143298=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110143299='
      
        '110143300=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110143301=                                              ARTICUL,'
      '110143302=                                              BARCODE,'
      
        '110143303=                                              NOMENCLA' +
        'TUR_NUM,'
      '110143304=                                              NAME,'
      
        '110143305=                                              UNIT_NAM' +
        'E,'
      '110143306=                                              PRICE,'
      
        '110143307=                                              VOLUME_P' +
        'RICE,'
      
        '110143308=                                              SKIDKA_P' +
        'RICE,'
      '110143309=                                              AMOUNT,'
      
        '110143310=                                              AMOUNT_R' +
        'ESERVE,'
      '110143311=                                              SUMM,'
      
        '110143312=                                              PRICE_SE' +
        'LF,'
      
        '110143313=                                              SORT_COL' +
        ','
      
        '110143314=                                              IS_CATEG' +
        'ORY,'
      '110143315=                                              NOTE,'
      
        '110143316=                                              CROSSCOD' +
        'E,'
      '110143317=                                              PLACE)'
      
        '110143318=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110143319=                 G.ARTICUL,'
      '110143320=                 G.BARCODE,'
      '110143321=                 G.NOMENCLATUR_NUM,'
      '110143322=                 G.NAME,'
      '110143323=                 U.SHORT_NAME,'
      '110143324=                 G.PRICE,'
      '110143325=                 G.VOLUME_PRICE,'
      '110143326=                 G.PRICE - GD.SKIDKA_SUM,'
      '110143327=                 COALESCE(S.AMOUNT, 0),'
      '110143328=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110143329=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110143330=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110143331=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110143332=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110143333=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110143334=                  DECODE(:FORMULA_,'
      '110143335=                         1,'
      '110143336=                         (SELECT S.price'
      '110143337=                            FROM SKLAD S'
      
        '110143338=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110143339=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110143340=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110143341=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110143342=                                                     F' +
        'ROM SKLAD DD'
      
        '110143343=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110143344=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110143345=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110143346=                                                    )'
      '110143347=                            ORDER BY 1 DESC'
      '110143348=                            ROWS 1 TO 1'
      '110143349=                         ),'
      
        '110143350=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110143351=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110143352=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110143353=                                         SKLAD S'
      
        '110143354=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110143355=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110143356=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110143357=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110143358=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110143359=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '110143360=                        )), 0) spr,'
      
        '110143361=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110143362=                 0'
      '110143363=                 ,G.NOTE'
      
        '110143364=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110143365=                 ,G.PLACE'
      
        '110143366=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '110143367=                                                FROM G' +
        '_DISCOUNT D'
      
        '110143368=                                                WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110143369=                                                      ' +
        '  AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '110143370=                                                      ' +
        '  AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '110143371=                                                      ' +
        ')'
      
        '110143372=                                                      ' +
        'OR'
      
        '110143373=                                                      ' +
        '(D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '110143374=                                                 AND (' +
        '(:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '110143375=                                                     O' +
        'R'
      
        '110143376=                                                     (' +
        'D.G_TOCHKA IS NULL))'
      
        '110143377=                                              ) GD ON ' +
        'G.G_PRODUCT = GD.G_PRODUCT'
      
        '110143378=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110143379=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110143380=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110143381=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110143382=             AND G.IS_CATEGORY = 0'
      '110143383=             AND G.is_active = 1'
      '110143384=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110143385=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110143386=                  OR'
      
        '110143387=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110143388=                  or'
      
        '110143389=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110143390=                 )'
      '110143391=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110143392=             AND ((EXISTS (SELECT 1'
      '110143393=                           FROM SKLAD S'
      
        '110143394=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110143395=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110143396=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110143397=                  OR'
      '110143398=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110143399=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '110143400=      END'
      '110143401=  END'
      '110143402='
      
        '110143403=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110143404='
      
        '110143405=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKID' +
        'KA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE' +
        '_SELF, IS_CATEGORY,'
      '110143406=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110143407=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110143408=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLU' +
        'ME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE' +
        '_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110143409=  DO BEGIN'
      '110143410=    I = I + 1;'
      '110143411=    SUSPEND;'
      '110143412=  END'
      '110143413='
      '110143414=     /*'
      '110143415=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110143416='
      '110143417=     SELECT :I,'
      
        '110143418=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110143419=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110143420=             U.SHORT_NAME UNIT_NAME,'
      '110143421=             SS.PRICE,'
      '110143422=             SS.VOLUME_PRICE,'
      '110143423=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110143424=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110143425=             SS.IS_CATEGORY'
      '110143426=        FROM (WITH RECURSIVE TREE'
      '110143427=              AS (SELECT T.G_PRODUCT,'
      '110143428=                       T.NAME AS ARTICUL,'
      
        '110143429=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110143430=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110143431=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110143432=                       T.IS_CATEGORY,'
      '110143433=                       NULL G_UNIT'
      '110143434=                  FROM G_PRODUCT T'
      '110143435=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110143436=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110143437=                UNION ALL'
      '110143438=                SELECT T.G_PRODUCT,'
      '110143439=                       DECODE(T. T.ARTICUL,'
      '110143440=                       T.NAME,'
      '110143441=                       T.PRICE,'
      '110143442=                       T.VOLUME_PRICE,'
      '110143443=                       T.IS_CATEGORY,'
      '110143444=                       T.G_UNIT'
      
        '110143445=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110143446=                 WHERE T.IS_ACTIVE = 1'
      '110143447=                )'
      '110143448=             SELECT * FROM TREE) SS'
      
        '110143449=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110143450=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110143451=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110143452=    INTO :ROW_NUM,'
      '110143453=        :ARTICUL,'
      '110143454=        :NAME,'
      '110143455=        :UNIT_NAME,'
      '110143456=        :PRICE,'
      '110143457=        :VOLUME_PRICE,'
      '110143458=        :SKIDKA_PRICE,'
      '110143459=        :AMOUNT,'
      '110143460=        :IS_CATEGORY'
      '110143461=    DO BEGIN'
      '110143462=      I = I + 1;'
      '110143463=      SUSPEND;'
      '110143464=    END  */'
      '110143465=WHEN ANY DO BEGIN'
      '110143466=    Err_code = -20500;'
      
        '110143467=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110143468=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110143469=  END'
      '110143470=end'
      '110143471=;'
      
        '110143472=UPDATE SYSTEM_SETUP SET S_VALUE = 110143 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110143473=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110143474=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101440=UPDATE SYSTEM_SETUP SET S_VALUE = 110144 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101441=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101442=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101450=ALTER PROCEDURE DO_PRODUCT('
      '1101451=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101452=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1101453=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101454=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101455=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '1101456=RETURNS ('
      '1101457=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1101458=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101459=  ERR_CODE INTEGER,'
      '11014510=  ERR_MSG VARCHAR(1024))'
      '11014511=AS'
      '11014512=/*'
      
        '11014513='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055#1056 +
        #1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '11014514='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '11014515=*/'
      '11014516=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39';'
      '11014517=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11014518=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042#1040 +
        #1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '11014519=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT;'
      
        '11014520=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '11014521=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067' ' +
        #1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '11014522=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11014523=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      '11014524=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM;'
      '11014525=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '11014526=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11014527=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      '11014528=BEGIN'
      '11014529=  PNT_ = '#39'00'#39';'
      '11014530=  COST_PRICE_ = 0;'
      '11014531='
      '11014532=  IF (G_TOCHKA_ IS NULL) THEN'
      '11014533=    SELECT ID'
      '11014534=      FROM CUR_PARAMS'
      '11014535=     WHERE CUR_PARAMS = 2'
      '11014536=      INTO :G_TOCHKA_;'
      '11014537='
      '11014538=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '11014539=  SELECT P.S_VALUE'
      '11014540=    FROM SYSTEM_SETUP P'
      '11014541=   WHERE P.SYSTEM_SETUP = 2'
      '11014542=    INTO :CAN_SELL_;'
      '11014543='
      '11014544=  FOR SELECT :G_PRODUCT_IN_,'
      '11014545=             :AMOUNT_IN_'
      '11014546=        FROM RDB$DATABASE'
      '11014547=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '11014548=      UNION ALL'
      '11014549=      SELECT G_PRODUCT,'
      '11014550=             AMOUNT'
      '11014551=        FROM ZAKAZ_DETAILS_TMP'
      '11014552=       WHERE :G_PRODUCT_IN_ IS NULL'
      '11014553=        INTO :G_PRODUCT_,'
      '11014554=             :AMOUNT_'
      '11014555=  DO BEGIN'
      '11014556=      SELECT MAX(G.NAME)'
      '11014557=        FROM G_PRODUCT G,'
      '11014558=             G_PRODUCT_KIT K'
      '11014559=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '11014560=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '11014561=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PR' +
        'ODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCH' +
        'KA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '11014562=        INTO :NAME_;'
      '11014563='
      
        '11014564=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEG' +
        'IN'
      '11014565=        ERR_CODE = -20500;'
      
        '11014566=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072#1090#1086 +
        #1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087#1088#1086 +
        #1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11014567=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11014568=        EXIT;'
      '11014569=      END'
      '11014570='
      '11014571=      PNT_ = '#39'01'#39';'
      
        '11014572=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIV' +
        'AL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '11014573=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0' +
        ', 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '11014574=      RETURNING OTHER'
      '11014575=      INTO :OTHER_;'
      '11014576='
      '11014577=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11014578=      FOR SELECT K.G_PRODUCT_ITEM'
      '11014579=                ,K.AMOUNT*:AMOUNT_'
      '11014580=                ,K.amount'
      '11014581=                ,G.G_PRODUCT'
      '11014582=            FROM G_PRODUCT_KIT K'
      '11014583=                ,G_PRODUCT G'
      '11014584=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11014585=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '11014586=            INTO :ITEM_'
      '11014587=                ,:AMOUNT_NEED_'
      '11014588=                ,:AMOUNT_NEED_ONE_'
      '11014589=                ,:G_PRODUCT_KIT_'
      '11014590=      DO BEGIN'
      
        '11014591=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_KIT_, NULL, 1)'
      '11014592=          RETURNING_VALUES :SELF_PRICE_;'
      '11014593='
      '11014594=        UPDATE LT_SKLAD_PRODUCT L'
      '11014595=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '11014596=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '11014597=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '11014598='
      '11014599=        IF (ROW_COUNT = 0) THEN'
      
        '110145100=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G' +
        '_TOCHKA_);'
      '110145101='
      
        '110145102=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHE' +
        'R, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110145103=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_,' +
        ' :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110145104='
      
        '110145105=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*S' +
        'ELF_PRICE_;'
      '110145106=      END'
      '110145107='
      
        '110145108=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063 +
        #1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110145109=      PNT_ = '#39'02'#39';'
      
        '110145110=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110145111=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110145112='
      '110145113=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110145114=                              :DATE_,'
      '110145115=                              CURRENT_TIME,'
      '110145116=                              NULL, --:G_CLIENT__,'
      
        '110145117=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110145118=                              NULL, --:OSNOVANIE__,'
      '110145119=                              :NOTE_,'
      '110145120=                              4, --:IS_VOZVRAT_,'
      '110145121=                              :AMOUNT_*:COST_PRICE_,'
      '110145122=                              :AMOUNT_*:COST_PRICE_,'
      '110145123=                              0, --:G_PRIHOD_,'
      '110145124=                              0 --:SUMM_PRIHOD_)'
      '110145125=                              ,NULL     --PAYMENTS_'
      
        '110145126=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110145127=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110145128=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110145129=          EXIT;'
      '110145130=      END'
      '110145131='
      '110145132=      UPDATE OTHER O'
      '110145133=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110145134=      WHERE O.OTHER = :OTHER_;'
      '110145135='
      '110145136=      COST_PRICE_ = 0;'
      '110145137=  END'
      '110145138=END'
      '110145139=;'
      
        '110145140=UPDATE SYSTEM_SETUP SET S_VALUE = 110145 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110145141=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110145142=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101460='
      '1101461=ALTER PROCEDURE P_REP_BILL('
      '1101462=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1101463=  SUMM_DANO_ NUMERIC(15,2),'
      '1101464=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1101465=  CURRENCY_ INTEGER,'
      '1101466=  MODE_ INTEGER,'
      '1101467=  PRINT_SLOGAN_ VARCHAR(80),'
      '1101468=  DECIMAL_ INTEGER,'
      '1101469=  BONUS_ NUMERIC(15,2))'
      '11014610=RETURNS ('
      '11014611=  FIRM_NAME_ VARCHAR(600),'
      '11014612=  IDN_STR_ VARCHAR(30),'
      '11014613=  FIRM_IDN_ VARCHAR(50),'
      '11014614=  FIRM_ADDRESS_ VARCHAR(550),'
      '11014615=  NUM_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '11014616=  DATE_ VARCHAR(100),'
      '11014617=  PAYMENT_TYPE_ VARCHAR(100),'
      '11014618=  G_CLIENT_NAME_ VARCHAR(300),'
      '11014619=  G_OFFICIAL_FM_ VARCHAR(300),'
      '11014620=  SUMM_VSEGO_ VARCHAR(50),'
      '11014621=  SUMM_VSEGO_N_ VARCHAR(50),'
      '11014622=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11014623=  ROW_NUM INTEGER,'
      
        '11014624=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      '11014625=  NAME_ART VARCHAR(1000),'
      '11014626=  AMOUNT VARCHAR(50),'
      
        '11014627=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(5' +
        '0),'
      '11014628=  PRICE VARCHAR(50),'
      '11014629=  PRICE_N VARCHAR(50),'
      '11014630=  SUMM VARCHAR(50),'
      '11014631=  SUMM_N VARCHAR(50),'
      '11014632=  SUMM_POLUCH_ VARCHAR(50),'
      '11014633=  SUMM_SDACH_ VARCHAR(50),'
      '11014634=  SUMM_STR_ VARCHAR(200),'
      '11014635=  SLOGAN_ VARCHAR(80),'
      '11014636=  SUMM_SKIDKA_ VARCHAR(50),'
      '11014637=  SUMM_SERVICE_ VARCHAR(50),'
      '11014638=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '11014639=  BONUS_STR_ VARCHAR(100),'
      '11014640=  ERR_CODE NUMERIC(15,2),'
      '11014641=  ERR_MSG VARCHAR(1024))'
      '11014642=AS'
      '11014643=BEGIN'
      '11014644=  SUSPEND;'
      '11014645=END'
      '11014646=;'
      '11014647='
      '11014648='
      
        '11014649=/******************************************************' +
        '************************/'
      
        '11014650=/****                          Altering triggers       ' +
        '                    ****/'
      
        '11014651=/******************************************************' +
        '************************/'
      '11014652=ALTER TRIGGER LT_SKLAD_PRODUCT_BU0'
      '11014653=AS'
      
        '11014654=declare variable G_NAME_  TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '11014655=declare variable CNT_     INTEGER;'
      
        '11014656=declare variable T_NAME_  TYPE OF COLUMN G_TOCHKA.NAME ' +
        '= '#39#39';'
      '11014657=begin'
      
        '11014658=  IF (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39') IS N' +
        'OT NULL) THEN EXIT;'
      
        '11014659=  if ((OLD.G_PRODUCT <> -2) AND ((NEW.AMOUNT - NEW.AMOU' +
        'NT_RESERVE) < 0) AND (SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 2) = 0) then BEGIN'
      '11014660=    SELECT G.NAME'
      '11014661=      FROM G_PRODUCT G'
      '11014662=     WHERE G.G_PRODUCT = NEW.G_PRODUCT'
      '11014663=      INTO :G_NAME_;'
      '11014664='
      '11014665=    if ((SELECT COUNT(*) FROM G_TOCHKA) > 1) then'
      '11014666=      SELECT '#39' '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||G.NAME||'#39'"'#39
      '11014667=        FROM G_TOCHKA G'
      '11014668=       WHERE G.G_TOCHKA = NEW.G_TOCHKA'
      '11014669=        INTO :T_NAME_;'
      '11014670='
      
        '11014671=    --'#39'/Q\'#39' - '#1041#1059#1044#1059' '#1042' '#1044#1045#1051#1068#1060#1071#1061' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1050#1040#1050' '#1050#1054#1053#1045#1062' '#1057#1054#1054 +
        #1041#1065#1045#1053#1048#1071', '#1048' '#1042#1057#1045' '#1063#1058#1054' '#1044#1040#1051#1068#1064#1045' - '#1042#1067#1056#1045#1047#1040#1058#1068', '#1040' '#1058#1054' FIREBIRD '#1057#1040#1052' '#1044#1054#1041#1040#1042#1051#1071#1045#1058
      '11014672=    -- '#1055#1054#1058#1054#1052' '#1043#1044#1045' '#1048' '#1042' '#1050#1040#1050#1054#1052' '#1058#1056#1048#1043#1043#1045#1056#1045' '#1055#1056#1054#1048#1047#1054#1064#1051#1040' '#1054#1064#1048#1041#1050#1040
      
        '11014673=    EXCEPTION NOL_EXCEPTION '#39'/R\'#1042' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1086 +
        #1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||G_NAME_||'#39'"'#39'||T_NAME_||'#39' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!' +
        ' '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'./Q\'#39';'
      '11014674=  END'
      '11014675=end'
      '11014676=;'
      '11014677='
      '11014678='
      
        '11014679=/******************************************************' +
        '************************/'
      
        '11014680=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11014681=/******************************************************' +
        '************************/'
      '11014682=ALTER PROCEDURE DEL_ZAKAZ_DETAIL('
      '11014683=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '11014684=RETURNS ('
      '11014685=  ERR_CODE INTEGER,'
      '11014686=  ERR_MSG VARCHAR(1024))'
      '11014687=AS'
      
        '11014688=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ_DETA' +
        'IL'#39';'
      '11014689=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '11014690=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11014691=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '11014692=DECLARE VARIABLE IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_S' +
        'PISANIE;'
      
        '11014693=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RE' +
        'SERVE;'
      
        '11014694=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '11014695=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11014696=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA' +
        '_REAL.ZAKAZ_NA_REAL;'
      
        '11014697=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11014698=DECLARE VARIABLE NOT_MINUS_OSTATOK_ TYPE OF COLUMN ZAKA' +
        'Z.NOT_MINUS_OSTATOK;'
      '11014699=BEGIN'
      '110146100=  PNT_ = '#39'00'#39';'
      
        '110146101=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1040' '#1042#1044#1056#1059#1043' '#1059#1044#1040#1051#1071#1070' '#1054#1055#1051#1040#1058#1059' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051 +
        #1048#1047#1040#1062#1048#1070
      '110146102=  SELECT Z.IS_SPISANIE,'
      '110146103=         Z.G_TOCHKA'
      '110146104=         ,Z.IS_RESERVE'
      '110146105=         ,Z.NOT_MINUS_OSTATOK'
      '110146106=    FROM ZAKAZ Z'
      '110146107=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110146108=    INTO :IS_SPISANIE_,'
      '110146109=         :G_TOCHKA_'
      '110146110=         ,:IS_RESERVE_'
      '110146111=         ,:NOT_MINUS_OSTATOK_;'
      '110146112='
      
        '110146113=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1048#1051#1048' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040'. '#1058#1054' '#1057 +
        #1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110146114=  if (IS_SPISANIE_ <> 2) then BEGIN'
      '110146115=      FOR SELECT G_PRODUCT,'
      '110146116=                 AMOUNT'
      '110146117=            FROM ZAKAZ_DETAILS Z'
      '110146118=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110146119=           INTO :G_PRODUCT_,'
      '110146120=                :AMOUNT_'
      '110146121=      DO BEGIN'
      '110146122=        BEGIN'
      '110146123=            -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '110146124=            IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '110146125=                -- '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1050' '#1054#1057#1053#1054#1042#1053 +
        #1054#1052#1059' '#1054#1057#1058#1040#1058#1050#1059
      
        '110146126=                IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTA' +
        'TOK_ = 0) THEN'
      '110146127=                    UPDATE LT_SKLAD_PRODUCT LT'
      
        '110146128=                       SET LT.AMOUNT = LT.AMOUNT + :AM' +
        'OUNT_'
      '110146129=                     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110146130=                       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110146131='
      
        '110146132=                -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1056#1045#1047#1045#1056#1042', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1054#1058' '#1047#1040#1056#1045 +
        #1047#1045#1056#1042#1048#1056#1054#1042#1040#1053#1053#1054#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040
      '110146133=                ELSE IF (IS_RESERVE_ = 1) THEN'
      '110146134=                    UPDATE LT_SKLAD_PRODUCT LT'
      
        '110146135=                       SET LT.AMOUNT_RESERVE = LT.AMOU' +
        'NT_RESERVE - :AMOUNT_'
      '110146136=                     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110146137=                       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110146138=            END'
      '110146139=        WHEN EXCEPTION NOL_EXCEPTION DO'
      '110146140=          begin'
      '110146141=            ERR_CODE = -20500;'
      
        '110146142=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042 +
        ' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1086#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072 +
        #1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110146143=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110146144=            EXIT;'
      '110146145=          end'
      '110146146=        END'
      '110146147=      END'
      '110146148='
      
        '110146149=  --**************************************************' +
        '*********'
      
        '110146150=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051', '#1058#1054' '#1053#1040#1044#1054' '#1042 +
        #1054#1057#1057#1058#1040#1053#1054#1042#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1045' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      
        '110146151=  -- '#1048#1065#1059' '#1055#1054' '#1044#1040#1053#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1048' '#1055#1056#1048#1041 +
        #1040#1042#1051#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050' '#1053#1045#1052#1059', '#1045#1057#1051#1048' '#1042#1045#1057#1068' '#1058#1054#1042#1040#1056' '#1054#1055#1051#1040#1063#1045#1053', '#1058#1054' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059 +
        #1070' '#1047#1040#1055#1048#1057#1068
      '110146152=  END ELSE BEGIN'
      '110146153=      FOR SELECT ZD.AMOUNT,'
      '110146154=                 ZD.PRICE,'
      '110146155=                 ZD.DISCOUNT_TENGE,'
      '110146156=                 LZ.ZAKAZ_NA_REAL'
      '110146157=            FROM ZAKAZ Z,'
      '110146158=                 ZAKAZ_DETAILS ZD,'
      '110146159=                 LT_ZAKAZ_REAL LZ'
      '110146160=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110146161=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110146162=             AND ZD.ZAKAZ_DETAILS = LZ.ZAKAZ_DETAILS'
      '110146163=           INTO :AMOUNT_,'
      '110146164=                :PRICE_,'
      '110146165=                :DISCOUNT_TENGE_,'
      '110146166=                :ZAKAZ_NA_REAL_'
      '110146167=      DO BEGIN'
      '110146168=          UPDATE ZAKAZ_NA_REAL ZRR'
      
        '110146169=             SET ZRR.AMOUNT_PAYED = ZRR.AMOUNT_PAYED -' +
        ' :AMOUNT_,'
      
        '110146170=                 ZRR.SUMM_PAYED = ZRR.SUMM_PAYED - :AM' +
        'OUNT_ * (:PRICE_ - :DISCOUNT_TENGE_),'
      '110146171=                 ZRR.IS_PAYED_ALL = 0'
      '110146172=           WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110146173=      END'
      '110146174='
      '110146175=      -- '#1059#1044#1040#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067
      
        '110146176=      DELETE FROM LT_ZAKAZ_REAL R WHERE R.ZAKAZ_DETAIL' +
        'S IN (SELECT ZAKAZ_DETAILS FROM ZAKAZ_DETAILS ZD WHERE ZD.ZAKAZ ' +
        '= :ZAKAZ_);'
      '110146177=  END'
      '110146178='
      '110146179=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '110146180=  PNT_ = '#39'03'#39';'
      '110146181=  DELETE from zakaz_DETAILS z'
      '110146182=  WHERE z.zakaz = :zakaz_;'
      '110146183='
      '110146184=when sqlcode -530 DO'
      '110146185=  begin'
      '110146186=    ERR_CODE = -20500;'
      
        '110146187=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      
        '110146188=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110146189=  end'
      '110146190=WHEN ANY DO'
      '110146191=  begin'
      '110146192=    ERR_CODE = sqlcode;'
      '110146193=  end'
      '110146194=end'
      '110146195=;'
      '110146196='
      '110146197=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110146198=  TYPE_ INTEGER = 0,'
      
        '110146199=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R = NULL,'
      '110146200=  IS_RMK_ INTEGER = 0)'
      '110146201=RETURNS ('
      '110146202=  SORT_COL DM_BIGINT,'
      '110146203=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110146204=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '110146205=  NAME VARCHAR(500))'
      '110146206=AS'
      '110146207=DECLARE VARIABLE LVL_ INTEGER;'
      '110146208=BEGIN'
      '110146209='
      '110146210=  IF (COALESCE(TYPE_, 0) = 0) THEN'
      '110146211=      FOR'
      '110146212=        SELECT'
      '110146213=            DECODE(T.G_PRODUCT, -1, 0, 1) SORT_COL,'
      '110146214=            T.G_PRODUCT,'
      '110146215=            T.G_PRODUCT_PAR,'
      '110146216=            T.NAME,'
      '110146217=            0'
      '110146218=        FROM G_PRODUCT T'
      '110146219=        WHERE T.IS_CATEGORY = 1'
      
        '110146220=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110146221=               OR'
      '110146222=               (:IS_RMK_ = 0)'
      '110146223=              )'
      '110146224=        ORDER BY 1, T.NAME'
      '110146225=        INTO'
      '110146226=            :SORT_COL,'
      '110146227=            :G_PRODUCT,'
      '110146228=            :G_PRODUCT_PAR,'
      '110146229=            :NAME,'
      '110146230=            :LVL_'
      '110146231=      DO'
      '110146232=        suspend;'
      '110146233='
      
        '110146234=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059 +
        #1063#1040#1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '110146235=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054 +
        #1044#1048#1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '110146236=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' ' +
        #1056#1054#1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '110146237=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048 +
        #1046#1045' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '110146238=  ELSE'
      
        '110146239=    FOR SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110146240=           T.G_PRODUCT,'
      '110146241=           T.G_PRODUCT_PAR,'
      '110146242=           T.NAME,'
      '110146243=           1 LVL'
      '110146244=      FROM G_PRODUCT T'
      '110146245=     WHERE  T.IS_CATEGORY = 1'
      
        '110146246=      AND ((T.G_PRODUCT_PAR IS NULL AND :G_PRODUCT_PAR' +
        '_ IS NULL AND T.G_PRODUCT <> -1)'
      '110146247=           OR'
      '110146248=           (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_))'
      '110146249=      AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1)'
      '110146250=           OR'
      '110146251=           (:IS_RMK_ = 0)'
      '110146252=          )'
      '110146253=     ORDER BY T.NAME'
      '110146254=    INTO :SORT_COL,'
      '110146255=            :G_PRODUCT,'
      '110146256=            :G_PRODUCT_PAR,'
      '110146257=            :NAME,'
      '110146258=            :LVL_'
      '110146259=    DO'
      '110146260=        suspend;'
      '110146261=    /*'
      
        '110146262=    '#1050#1054#1056#1054#1063#1045' '#1055#1054#1057#1054#1042#1045#1065#1040#1051#1048#1057#1068' '#1058#1040#1050' '#1057' '#1056#1059#1057#1051#1040#1053#1054#1052' '#1048' '#1055#1054#1044#1059#1052#1040#1051#1048', '#1063#1058#1054 +
        ' '#1044#1054#1063#1045#1056#1053#1048#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048' '#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1054#1050#1040#1047#1067#1042#1040#1058#1068', '#1056#1040#1042#1053#1054' '#1050#1040#1050' '#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1070' "' +
        #1042#1057#1045' '#1058#1054#1042#1040#1056#1067'"'
      '110146263=    FOR WITH RECURSIVE TREE AS ('
      
        '110146264=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110146265=               T.G_PRODUCT,'
      '110146266=               T.G_PRODUCT_PAR,'
      '110146267=               T.NAME,'
      '110146268=               1 LVL'
      '110146269=          FROM G_PRODUCT T'
      
        '110146270=         WHERE (((T.G_PRODUCT_PAR IS NULL or T.g_produ' +
        'ct = -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '110146271=               OR'
      '110146272=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_))'
      
        '110146273=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110146274=               OR'
      '110146275=               (:IS_RMK_ = 0)'
      '110146276=              )'
      '110146277=        UNION ALL'
      
        '110146278=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0)' +
        ' SORTT,'
      '110146279=               T.G_PRODUCT,'
      '110146280=               T.G_PRODUCT_PAR,'
      '110146281=               T.NAME,'
      '110146282=               GG.LVL + 1 LVL'
      
        '110146283=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_' +
        'PRODUCT = T.G_PRODUCT_PAR'
      '110146284=         WHERE T.IS_CATEGORY = 1'
      
        '110146285=          AND ((T.DO_NOT_SHOW_RMK = 0 AND :IS_RMK_ = 1' +
        ')'
      '110146286=               OR'
      '110146287=               (:IS_RMK_ = 0)'
      '110146288=              )'
      '110146289=        )'
      '110146290=        SELECT * FROM TREE ORDER BY 1, 5, 4'
      '110146291=        INTO :SORT_COL,'
      '110146292=            :G_PRODUCT,'
      '110146293=            :G_PRODUCT_PAR,'
      '110146294=            :NAME,'
      '110146295=            :LVL_'
      '110146296=    DO'
      '110146297=        suspend;'
      '110146298=    */'
      '110146299='
      '110146300='
      '110146301=    /*'
      
        '110146302=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT,' +
        ' -1, T.G_PRODUCT, 0) SORTT,'
      '110146303=                               T.G_PRODUCT,'
      '110146304=                               T.G_PRODUCT_PAR,'
      
        '110146305=                               DECODE(T.G_PRODUCT, -1,' +
        ' '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '110146306=                               T.NAME PATH,       --'#1076#1083 +
        #1103' '#1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '110146307=                               1 LVL'
      '110146308=                          FROM G_PRODUCT T'
      
        '110146309=                         WHERE (T.G_PRODUCT_PAR IS NUL' +
        'L or T.g_product = -1)'
      '110146310=                        UNION ALL'
      
        '110146311=                        SELECT DECODE(T.G_PRODUCT, -1,' +
        ' T.G_PRODUCT, 0) SORTT,'
      '110146312=                               T.G_PRODUCT,'
      '110146313=                               T.G_PRODUCT_PAR,'
      '110146314=                               GG.LVL||T.NAME NAME,'
      
        '110146315=                               GG.PATH||'#39' - '#39'||T.NAME,' +
        '     --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '110146316=                               GG.LVL + 1 LVL'
      
        '110146317=                          FROM G_PRODUCT T INNER JOIN ' +
        'TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '110146318=                         WHERE T.IS_CATEGORY = 1'
      '110146319=                        )'
      '110146320=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '110146321=    */'
      '110146322=END'
      '110146323=;'
      '110146324='
      '110146325=ALTER PROCEDURE INS_ZAKAZ('
      '110146326=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110146327=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110146328=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110146329=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110146330=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110146331=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110146332=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110146333=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110146334=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110146335=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110146336=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110146337=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110146338=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110146339=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110146340=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110146341=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110146342=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110146343=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110146344=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110146345=  IS_MEBEL_ INTEGER = 0,'
      
        '110146346=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110146347=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      '110146348=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '110146349=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '110146350=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110146351=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110146352=  NOT_MINUS_OSTATOK_ INTEGER = 0)'
      '110146353=RETURNS ('
      '110146354=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110146355=  ERR_CODE INTEGER,'
      '110146356=  ERR_MSG VARCHAR(1024))'
      '110146357=AS'
      '110146358=/*'
      '110146359=IS_SPISANIE_'
      '110146360=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110146361=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110146362=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110146363=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110146364='
      '110146365='
      
        '110146366=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '110146367=*/'
      '110146368=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110146369=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110146370=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110146371=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110146372=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110146373=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110146374=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110146375=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110146376=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110146377=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110146378=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110146379=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110146380=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110146381=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110146382=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '110146383=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110146384=DECLARE VARIABLE CNT_ INTEGER;'
      '110146385=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110146386=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110146387=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110146388=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110146389=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110146390=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110146391=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110146392=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110146393=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110146394=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110146395=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110146396=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110146397=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110146398=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110146399=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110146400=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110146401=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110146402=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      '110146403=BEGIN'
      '110146404='
      
        '110146405=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110146406=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110146407=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110146408=  IF (CNT_ = 0) THEN BEGIN'
      '110146409=    ERR_CODE = -20500;'
      
        '110146410=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110146411=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110146412=    EXIT;'
      '110146413=  END'
      '110146414='
      '110146415=  IF (G_TOCHKA_ IS NULL) THEN'
      '110146416=    SELECT ID'
      '110146417=      FROM CUR_PARAMS'
      '110146418=     WHERE CUR_PARAMS = 2'
      '110146419=      INTO :G_TOCHKA_;'
      '110146420='
      '110146421=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110146422=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110146423=      PNT_ = '#39'01'#39';'
      
        '110146424=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110146425=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110146426=      ELSE'
      '110146427=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110146428='
      '110146429=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110146430=      SELECT G.G_OFFICIAL,'
      '110146431=             G.DO_NOT_SALES_COMM,'
      '110146432=             G.FM||'#39' '#39'||G.NM'
      '110146433=        FROM G_OFFICIAL G'
      
        '110146434=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110146435=        INTO :G_OFFICIAL_,'
      '110146436=             :DO_NOT_SALES_COMM_,'
      '110146437=             :OFFICIAL_NAME_;'
      '110146438='
      '110146439=      INSERT INTO ZAKAZ'
      '110146440=      ('
      '110146441=       ZAKAZ,'
      '110146442=       G_TOCHKA,'
      '110146443=       Z_DATE,'
      '110146444=       Z_TIME,'
      '110146445=       G_CLIENT,'
      '110146446=       G_PAYMENT_TYPE,'
      '110146447=       OSNOVANIE,'
      '110146448=       IS_SPISANIE,'
      '110146449=       NOTE,'
      '110146450=       SUMM,'
      '110146451=       SUMM_FACT,'
      '110146452=       SUMM_BONUS,'
      '110146453=       IS_PAYED_ALL'
      '110146454=       ,G_OFFICIAL'
      '110146455=       ,BY_RECIPE'
      '110146456=       ,SUMM_BONUS_GOT'
      '110146457=       ,IS_RESERVE'
      '110146458=       ,SUMM_CASH'
      '110146459=       ,SUMM_NONCASH'
      '110146460=       ,NOT_MINUS_OSTATOK'
      '110146461=      ) VALUES ('
      '110146462=       GEN_ID(GEN_ZAKAZ, 1),'
      '110146463=       :G_TOCHKA_,'
      '110146464=       :Z_DATE_,'
      '110146465=       :Z_TIME_,'
      '110146466=       :G_CLIENT_,'
      '110146467=       :G_PAYMENT_TYPE_,'
      '110146468=       :OSNOVANIE_,'
      '110146469=       :IS_SPISANIE_,'
      '110146470=       :NOTE_,'
      '110146471=       :SUMM_,'
      '110146472=       :SUMM_FACT_1_,'
      '110146473=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110146474=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110146475=       ,:G_OFFICIAL_'
      '110146476=       ,:BY_RECIPE_'
      '110146477=       ,:SUMM_BONUS_GOT_'
      '110146478=       ,:IS_RESERVE_'
      '110146479=       ,COALESCE(:SUMM_CASH_, 0)'
      '110146480=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110146481=       ,:NOT_MINUS_OSTATOK_'
      '110146482=      )'
      '110146483=      RETURNING'
      '110146484=        ZAKAZ'
      '110146485=      INTO'
      '110146486=        :ZAKAZ_;'
      '110146487='
      '110146488=      PNT_ = '#39'02'#39';'
      
        '110146489=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110146490=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM'
      '110146491=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110146492=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110146493=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110146494=              :G_PRODUCT,'
      '110146495=              :AMOUNT,'
      '110146496=              :PRICE,'
      '110146497=              :SUMM,'
      '110146498=              :DISCOUNT_PERC,'
      '110146499=              :DISCOUNT_TENGE,'
      '110146500=              :DISCOUNT_SUMM,'
      '110146501=              :NDS,'
      '110146502=              :NDS_SUMM,'
      '110146503=              :COST_PRICE,'
      '110146504=              :SALES_COMM_'
      '110146505=      DO BEGIN'
      
        '110146506=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110146507=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '110146508=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/1' +
        '00;'
      
        '110146509=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110146510=        END'
      '110146511='
      '110146512=        INSERT INTO ZAKAZ_DETAILS'
      '110146513=        VALUES('
      '110146514=          :ZAKAZ_DETAILS_TMP_,'
      '110146515=          :ZAKAZ_,'
      '110146516=          :G_PRODUCT,'
      '110146517=          :AMOUNT,'
      '110146518=          :PRICE,'
      '110146519=          :SUMM,'
      '110146520=          :DISCOUNT_PERC,'
      '110146521=          :DISCOUNT_TENGE,'
      '110146522=          :DISCOUNT_SUMM,'
      '110146523=          :NDS,'
      '110146524=          :NDS_SUMM,'
      '110146525=          :COST_PRICE,'
      '110146526=          :SALES_COMM_SUMM_ITER_'
      '110146527=        );'
      '110146528='
      
        '110146529=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045 +
        ' 10%'
      '110146530=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '110146531=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK_' +
        ' = 0) THEN BEGIN'
      '110146532=                UPDATE LT_SKLAD_PRODUCT L'
      '110146533=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110146534=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '110146535=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110146536='
      '110146537=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110146538=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045 +
        #1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048 +
        #1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110146539=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051 +
        #1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '110146540=                PNT_ = '#39'04'#39';'
      
        '110146541=                IF ((ROW_COUNT = 0) AND ((SELECT S_VAL' +
        'UE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110146542=                  Err_Code = -20500;'
      
        '110146543=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_CO' +
        'DE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_P' +
        'RODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084 +
        #1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110146544=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110146545=                  EXIT;'
      '110146546=                END ELSE if (ROW_COUNT = 0) then'
      
        '110146547=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110146548=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,' +
        ' 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110146549=            END'
      '110146550='
      '110146551=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110146552=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '110146553=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110146554=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RES' +
        'ERVE + :AMOUNT'
      '110146555=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '110146556=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110146557=        END'
      '110146558=      END'
      '110146559='
      '110146560=      ----------------------------------------'
      
        '110146561=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063 +
        #1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110146562=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '110146563=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110146564='
      
        '110146565=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048',' +
        ' '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044 +
        #1048#1053' '#1055#1051#1040#1058#1045#1046
      '110146566=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110146567=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110146568=                PNT_ = '#39'05'#39';'
      
        '110146569=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110146570=                                              1,     -' +
        '- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110146571=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110146572=                                              :Z_DATE_' +
        ','
      
        '110146573=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110146574=                                              ZAKAZ_, ' +
        '  --ZAKAZ_'
      '110146575=                                              NULL,'
      
        '110146576=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110146577=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110146578=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110146579=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110146580=                  EXIT;'
      '110146581=                END'
      '110146582=            END'
      '110146583='
      '110146584=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110146585=        END ELSE BEGIN'
      '110146586=            PNT_ = '#39'06'#39';'
      
        '110146587=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110146588=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110146589=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110146590=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110146591=                ELSE'
      
        '110146592=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110146593='
      
        '110146594=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110146595=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110146596='
      
        '110146597=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110146598='
      '110146599=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110146600=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110146601=                                                  1,  ' +
        '   --:G_PRIHOD_RASHOD_,'
      
        '110146602=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110146603=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110146604=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110146605=                                                  :ZAK' +
        'AZ_,'
      
        '110146606=                                                  NULL' +
        ',     --:SKLAD_,'
      
        '110146607=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110146608=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110146609=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110146610=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110146611=                      EXIT;'
      '110146612=                    END'
      '110146613=                END'
      '110146614=            END'
      '110146615=        END'
      '110146616=      END'
      '110146617='
      
        '110146618=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '110146619=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041 +
        #1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '110146620=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052 +
        ' '#1057#1051#1059#1063#1040#1045
      
        '110146621=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054' ' +
        #1051#1048#1062#1040'"'
      '110146622=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '110146623=          UPDATE G_DISCONT_CARD D'
      
        '110146624=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_,' +
        ' 0) + :SUMM_BONUS_GOT_,'
      '110146625=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110146626=          WHERE D.G_CLIENT = :G_CLIENT_'
      '110146627=          RETURNING'
      '110146628=            D.SUMM_ALL'
      '110146629=          INTO'
      '110146630=            :CLIENT_SUMM_ALL_;'
      '110146631='
      '110146632=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '110146633=            FROM G_CLIENT_DISC_VAL_GRID G'
      '110146634=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '110146635=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '110146636=          ORDER BY G.SUMM_FROM'
      '110146637=          ROWS 1 TO 1'
      '110146638=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '110146639='
      '110146640=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '110146641=            UPDATE G_CLIENT G'
      '110146642=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '110146643=             WHERE G.G_CLIENT = :G_CLIENT_'
      '110146644=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '110146645='
      '110146646=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '110146647=            UPDATE G_DISCONT_CARD D'
      '110146648=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '110146649=             WHERE D.G_CLIENT = :G_CLIENT_'
      '110146650=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '110146651=      END'
      '110146652='
      '110146653=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '110146654=      PNT_ = '#39'07'#39';'
      
        '110146655=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COM' +
        'M_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN B' +
        'EGIN'
      '110146656=        SELECT S.S_VALUE'
      '110146657=          FROM SYSTEM_SETUP S'
      '110146658=         WHERE S.SYSTEM_SETUP = 4'
      '110146659=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '110146660='
      '110146661=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '110146662=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110146663=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110146664='
      
        '110146665=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' ' +
        #1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '110146666=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '110146667=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE' +
        '(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM ' +
        'CURRENT_DATE)));'
      '110146668='
      '110146669=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '110146670=        ELSE'
      
        '110146671=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DA' +
        'Y FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTR' +
        'ACT(DAY FROM current_date) + 32);'
      '110146672='
      '110146673=        KASSA_ = NULL;'
      '110146674=        SELECT K.KASSA, K.SUMM'
      '110146675=        FROM KASSA K'
      '110146676=        WHERE K.G_PRIHOD_RASHOD = -1'
      '110146677=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110146678=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110146679=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110146680=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110146681='
      '110146682=        IF (KASSA_ IS NULL) THEN'
      
        '110146683=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110146684=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110146685=                                          :SALES_COMM_' +
        'SUMM_ALL_,'
      
        '110146686=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110146687=                                          :OFFICIAL_NA' +
        'ME_,'
      
        '110146688=                                          NULL,     --' +
        ':ZAKAZ_,'
      
        '110146689=                                          NULL,     --' +
        ':SKLAD_,'
      '110146690=                                          1,'
      '110146691=                                          :G_TOCHKA_,'
      '110146692=                                          :G_OFFICIAL_'
      
        '110146693=                                          ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110146694=        ELSE'
      '110146695=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110146696=                                          1,     -- AC' +
        'TION_'
      
        '110146697=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110146698=                                          :SALES_COMM_' +
        'SUMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '110146699=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110146700=                                          :OFFICIAL_NA' +
        'ME_,   --NOTE_'
      '110146701=                                          NULL,'
      '110146702=                                          NULL,'
      
        '110146703=                                          :PAYMENT_TYP' +
        'E_,'
      '110146704=                                          :G_OFFICIAL_'
      
        '110146705=                                          ) RETURNING_' +
        'VALUES :ERR_CODE, :ERR_MSG;'
      '110146706='
      '110146707=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110146708=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110146709=          EXIT;'
      '110146710=        END'
      '110146711=      END'
      '110146712='
      '110146713=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '110146714=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0)' +
        ' THEN'
      
        '110146715=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110146716=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 1);'
      '110146717=  END'
      '110146718=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110146719=  ----------------------------------------'
      '110146720=  ----------------------------------------'
      '110146721=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110146722=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '110146723=      PNT_ = '#39'25'#39';'
      
        '110146724=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
        'A)'
      
        '110146725=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLI' +
        'ENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA' +
        '_)'
      '110146726=      RETURNING ZAKAZ_REAL_PARENT'
      '110146727=      INTO :ZAKAZ_REAL_PARENT_;'
      '110146728='
      
        '110146729=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCO' +
        'UNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '110146730=            FROM ZAKAZ_DETAILS_TMP Z'
      '110146731=          INTO :G_PRODUCT,'
      '110146732=              :AMOUNT,'
      '110146733=              :PRICE,'
      '110146734=              :SUMM,'
      '110146735=              :DISCOUNT_PERC,'
      '110146736=              :DISCOUNT_TENGE,'
      '110146737=              :DISCOUNT_SUMM,'
      '110146738=              :NDS,'
      '110146739=              :NDS_SUMM'
      '110146740=      DO BEGIN'
      '110146741=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110146742=          UPDATE LT_SKLAD_PRODUCT L'
      '110146743=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110146744=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '110146745=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110146746='
      
        '110146747=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053#1054 +
        ' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045' ' +
        #1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110146748=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048 +
        #1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '110146749=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FRO' +
        'M SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110146750=            Err_Code = -20500;'
      
        '110146751=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1055 +
        #1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUCT' +
        ' = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110146752=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110146753=            EXIT;'
      '110146754=          END ELSE if (ROW_COUNT = 0) then'
      
        '110146755=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRO' +
        'DUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110146756=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :' +
        'G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110146757='
      
        '110146758=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZA' +
        'KAZ_REAL_PARENT,'
      '110146759=                                     G_PRODUCT,'
      '110146760=                                     PRICE,'
      
        '110146761=                                     AMOUNT_ALL, SUMM_' +
        'ALL,'
      
        '110146762=                                     AMOUNT_PAYED, SUM' +
        'M_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_S' +
        'UMM, NDS,'
      '110146763=                                     NDS_SUMM)'
      
        '110146764=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ' +
        '_REAL_PARENT_,'
      '110146765=                  :G_PRODUCT,'
      
        '110146766=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040 +
        #1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '110146767=                  :AMOUNT, :SUMM,'
      '110146768=                  0, --AMOUNT_PAYED,'
      '110146769=                  0, --SUMM_PAYED,'
      '110146770=                  0, --IS_PAYED_ALL,'
      '110146771=                  :DISCOUNT_PERC,'
      '110146772=                  :DISCOUNT_TENGE,'
      '110146773=                  :DISCOUNT_SUMM,'
      '110146774=                  :NDS,'
      '110146775=                  :NDS_SUMM)'
      '110146776=          RETURNING ZAKAZ_NA_REAL'
      '110146777=          INTO :ZAKAZ_;'
      '110146778=      END'
      '110146779=  END'
      '110146780=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110146781=  ----------------------------------------'
      '110146782=  ----------------------------------------'
      '110146783=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '110146784=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046 +
        #1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '110146785=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', ' +
        #1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110146786=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '110146787=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, T' +
        'IME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SU' +
        'MM_FACT,'
      
        '110146788=                                IS_PAYED_ALL, IS_VOZVR' +
        'AT, G_TOCHKA, IS_EXPECTED)'
      
        '110146789=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_' +
        ', :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SU' +
        'MM_FACT_,'
      '110146790=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '110146791=      RETURNING SKLAD'
      '110146792=      INTO :SKLAD_;'
      '110146793='
      '110146794=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110146795=            FROM ZAKAZ_DETAILS_TMP Z'
      '110146796=          INTO :G_PRODUCT,'
      '110146797=              :AMOUNT,'
      '110146798=              :PRICE,'
      '110146799=              :SUMM'
      '110146800=      DO BEGIN'
      '110146801=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110146802=        UPDATE LT_SKLAD_PRODUCT L'
      '110146803=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110146804=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110146805=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110146806='
      '110146807=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '110146808=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1053#1045#1058
      
        '110146809=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045#1064 +
        #1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' '#1062 +
        #1045#1053#1059
      '110146810=        SELECT MAX(SK.DATE_RECEIPT)'
      '110146811=            FROM SKLAD SK'
      '110146812=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110146813=             AND SK.IS_LAST = 1'
      '110146814=             AND SK.G_TOCHKA = :G_CLIENT_'
      '110146815=            INTO :DATE_LAST_;'
      '110146816='
      
        '110146817=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or' +
        ' (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110146818=            UPDATE SKLAD SK'
      '110146819=               SET SK.IS_LAST = 0'
      '110146820=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110146821=               AND SK.IS_LAST = 1'
      '110146822=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '110146823='
      '110146824=            IS_THIS_LAST_ = 1;'
      '110146825=        END */'
      '110146826='
      '110146827='
      '110146828=        INSERT INTO SKLAD'
      '110146829=        ('
      '110146830=         SKLAD,'
      '110146831=         SKLAD_PARENT,'
      '110146832=         DATE_RECEIPT,'
      '110146833=         G_CLIENT,'
      '110146834=         G_PRODUCT,'
      '110146835=         AMOUNT,'
      '110146836=         PRICE,'
      '110146837=         SUMM,'
      '110146838=         G_PAYMENT_TYPE,'
      '110146839=         OSNOVANIE,'
      '110146840=         NOTE,'
      '110146841=         NDS,'
      '110146842=         NDS_SUMM,'
      '110146843=         IS_LAST,'
      '110146844=         IS_VOZVRAT,'
      '110146845=         G_TOCHKA'
      '110146846=        ) VALUES ('
      '110146847=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '110146848=         :SKLAD_,'
      '110146849=         :Z_DATE_,'
      '110146850=         :G_TOCHKA_,'
      '110146851=         :G_PRODUCT,'
      '110146852=         :AMOUNT,'
      '110146853=         :PRICE,'
      '110146854=         :SUMM,'
      '110146855=         :G_PAYMENT_TYPE_,'
      '110146856=         :OSNOVANIE_,'
      '110146857=         :NOTE_,'
      '110146858=         0,  --:RNDS_,'
      '110146859=         0,  --:RNDS_SUMM_,'
      
        '110146860=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040 +
        ' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040 +
        ' '#1041#1059#1044#1045#1058' 0'
      '110146861=         3,  --:IS_VOZVRAT_,'
      '110146862=         :G_CLIENT_'
      '110146863=        );'
      '110146864='
      
        '110146865=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110146866=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110146867=        PNT_ = '#39'02'#39';'
      '110146868=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '110146869=            UPDATE LT_SKLAD_PRODUCT L'
      '110146870=               SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '110146871=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110146872=               AND L.G_TOCHKA = :G_CLIENT_;'
      '110146873='
      '110146874=            IF (ROW_COUNT = 0) THEN'
      
        '110146875=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD' +
        '_PRODUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '110146876=        END'
      '110146877=      END'
      '110146878=  END'
      '110146879='
      '110146880=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110146881='
      
        '110146882=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '110146883=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110146884=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =>' +
        ' :ACTION_'
      '110146885=                                  G_PRIHOD_,'
      '110146886=                                  :SUMM_PRIHOD_,'
      '110146887=                                  :Z_DATE_,'
      
        '110146888=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110146889=                                  :ZAKAZ_,'
      '110146890=                                  NULL,'
      '110146891=                                  :G_PAYMENT_TYPE_,'
      
        '110146892=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110146893=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110146894=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110146895=      EXIT;'
      '110146896=    END'
      '110146897=  END'
      '110146898='
      
        '110146899=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057 +
        #1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '110146900=  IF (IS_MEBEL_ = 1) THEN'
      
        '110146901=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS' +
        ', ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '110146902=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, ' +
        ':ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '110146903=end'
      '110146904=;'
      '110146905='
      '110146906=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '110146907=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110146908=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110146909=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110146910=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110146911=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110146912=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110146913=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110146914=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110146915=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110146916=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110146917=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110146918=  IS_SPISANIE_ INTEGER,'
      '110146919=  NEW_LINE_SALE_ INTEGER = 0,'
      '110146920=  MODE_ INTEGER = 0,'
      '110146921=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '110146922=  DO_PRODUCT_IN_SALE_ INTEGER = 0)'
      '110146923=RETURNS ('
      
        '110146924=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110146925=  ERR_CODE INTEGER,'
      '110146926=  ERR_MSG VARCHAR(1024))'
      '110146927=AS'
      '110146928=/*'
      
        '110146929=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048 +
        #1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '110146930=*/'
      
        '110146931=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39';'
      '110146932=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '110146933=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110146934=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      
        '110146935=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110146936=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110146937=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110146938=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110146939=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110146940=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110146941=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '110146942=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110146943=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' */'
      
        '110146944=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' ' +
        #1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '110146945=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      '110146946=BEGIN'
      '110146947='
      
        '110146948=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110146949=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110146950=    FROM ZAKAZ_DETAILS_TMP T'
      '110146951=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110146952=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110146953=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110146954='
      
        '110146955=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110146956=           ,G.IS_KIT'
      '110146957=           ,K.AMOUNT * :AMOUNT_'
      '110146958=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110146959=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      '110146960=           ,(CASE'
      
        '110146961=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE' +
        '_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * ' +
        'FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '110146962=             ELSE K.PRICE'
      '110146963=           END) COST_PRICE'
      
        '110146964=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_L' +
        'AST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '110146965=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE ' +
        'G_PRODUCT = :G_PRODUCT_) CNT'
      
        '110146966=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110146967=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110146968=       AND G.IS_KIT = 1'
      '110146969=    UNION'
      
        '110146970=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110146971=           ,G.IS_KIT'
      '110146972=           ,:AMOUNT_'
      '110146973=           ,:PRICE_'
      '110146974=           ,0'
      '110146975=           ,:COST_PRICE_'
      '110146976=           ,0'
      '110146977=      FROM G_PRODUCT G'
      '110146978=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110146979=       AND G.IS_KIT <> 1'
      '110146980=      INTO :G_PRODUCT_'
      '110146981=           ,:IS_KIT_'
      '110146982=           ,:AMOUNT_'
      '110146983=           ,:PRICE__'
      '110146984=           ,:SOSTAV_PRICE_'
      '110146985=           ,:COST_PRICE__'
      '110146986=           ,:SOSTAV_COUNT_'
      '110146987=  DO BEGIN'
      '110146988=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110146989='
      
        '110146990=      --==============================================' +
        '============='
      '110146991=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110146992=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110146993=        FROM LT_SKLAD_PRODUCT L'
      '110146994=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110146995=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110146996=       INTO :AMOUNT_CUR_;'
      '110146997='
      
        '110146998=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110146999=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1101461000=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1101461001=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1101461002=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101461003=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '1101461004=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1101461005=          SELECT SUM(AMOUNT)'
      '1101461006=            FROM ZAKAZ_DETAILS T'
      '1101461007=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101461008=             AND T.ZAKAZ = :ZAKAZ_'
      '1101461009=            INTO :AMOUNT_OLD_;'
      '1101461010=        ELSE'
      '1101461011=          SELECT SUM(AMOUNT)'
      '1101461012=            FROM SKLAD T'
      '1101461013=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101461014=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1101461015=            INTO :AMOUNT_OLD_;'
      '1101461016=      END'
      '1101461017='
      '1101461018=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1101461019=      SELECT SUM(AMOUNT)'
      '1101461020=        FROM ZAKAZ_DETAILS_TMP T'
      '1101461021=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101461022=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1101461023='
      
        '1101461024=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_,' +
        ' 0) + :AMOUNT_;'
      '1101461025=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '1101461026='
      
        '1101461027=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042 +
        ' '#1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1101461028='
      
        '1101461029=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1101461030=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047 +
        #1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1101461031=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) ' +
        'THEN BEGIN'
      '1101461032=            PNT_ = '#39'01'#39';'
      
        '1101461033=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID F' +
        'ROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101461034=                                         CURRENT_DATE' +
        ','
      '1101461035=                                         :G_PRODUCT_,'
      
        '1101461036=                                         ABS(AMOUNT_C' +
        'UR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOU' +
        'NT_,'
      
        '1101461037=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074 +
        #1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1101461038=                                         )'
      
        '1101461039=                RETURNING_VALUES :SKLAD_, :COST_PRICE' +
        '__, :ERR_CODE, :ERR_MSG;'
      '1101461040=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461041=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101461042=              EXIT;'
      '1101461043=            END'
      '1101461044=        END'
      
        '1101461045=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_P' +
        'RODUCT_ <> -2) THEN BEGIN'
      '1101461046=            SELECT NAME'
      '1101461047=            FROM G_PRODUCT'
      '1101461048=            WHERE G_PRODUCT = :G_PRODUCT_'
      '1101461049=            INTO :PRODUCT_NAME_;'
      '1101461050='
      '1101461051=            ERR_CODE = -20500;'
      
        '1101461052=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_' +
        'NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1101461053=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1101461054=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1101461055=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1101461056=            EXIT;'
      '1101461057=        END'
      '1101461058=      END'
      '1101461059=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101461060=      --=============================================' +
        '=============='
      '1101461061='
      
        '1101461062=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077 +
        #1090#1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087 +
        #1083#1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '1101461063=      IF (IS_KIT_ = 1) THEN BEGIN'
      '1101461064=        IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '1101461065=            PRICE__ = SOSTAV_PRICE_;'
      '1101461066=        END ELSE BEGIN'
      '1101461067=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '1101461068=              PRICE__ = COST_PRICE__;'
      '1101461069='
      
        '1101461070=            END ELSE IF (Discount_perc_ <> 0) THEN BE' +
        'GIN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '1101461071=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PE' +
        'RC_/100;'
      '1101461072='
      '1101461073='
      
        '1101461074=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THE' +
        'N BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '1101461075=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / S' +
        'OSTAV_PRICE_;'
      
        '1101461076=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE' +
        '_;'
      '1101461077=            END'
      '1101461078='
      
        '1101461079=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUN' +
        'T_;'
      
        '1101461080=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMO' +
        'UNT_;'
      '1101461081=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '1101461082=        END'
      '1101461083=      END'
      '1101461084='
      
        '1101461085=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' ' +
        #1045#1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '1101461086=      IF (NEW_LINE_SALE_ = 0) THEN'
      '1101461087=          SELECT ZD.zakaz_details'
      '1101461088=            FROM zakaz_details_tmp ZD'
      '1101461089=           WHERE ZD.G_PRODUCT = :g_product_'
      '1101461090=             AND ZD.PRICE = :PRICE__'
      '1101461091=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '1101461092=            INTO :ZAKAZ_DTLS_TMP_;'
      '1101461093='
      '1101461094='
      '1101461095=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '1101461096=        UPDATE ZAKAZ_DETAILS_TMP P'
      '1101461097=           SET P.amount = P.amount + :amount_'
      
        '1101461098=               ,P.summ = (P.price - P.discount_TENGE)' +
        ' * (P.amount + :AMOUNT_)'
      
        '1101461099=               ,P.discount_summ = P.discount_TENGE * ' +
        '(P.amount + :AMOUNT_)'
      '1101461100=               ,P.NDS = :NDS_'
      '1101461101=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '1101461102=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '1101461103='
      '1101461104=      ELSE BEGIN'
      '1101461105=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '1101461106=          ('
      '1101461107=           ZAKAZ_DETAILS,'
      '1101461108=           ZAKAZ,'
      '1101461109=           G_PRODUCT,'
      '1101461110=           AMOUNT,'
      '1101461111=           PRICE,'
      '1101461112=           SUMM,'
      '1101461113=           DISCOUNT_PERC,'
      '1101461114=           DISCOUNT_TENGE,'
      '1101461115=           DISCOUNT_SUMM,'
      '1101461116=           NDS,'
      '1101461117=           NDS_SUMM,'
      '1101461118=           COST_PRICE'
      '1101461119=          ) VALUES ('
      '1101461120=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101461121=           :ZAKAZ_,'
      '1101461122=           :G_PRODUCT_,'
      '1101461123=           :AMOUNT_,'
      '1101461124=           :PRICE__,'
      '1101461125=           :SUMM_,'
      '1101461126=           :DISCOUNT_PERC_,'
      '1101461127=           :DISCOUNT_TENGE_,'
      '1101461128=           :DISCOUNT_SUMM_,'
      '1101461129=           :NDS_,'
      '1101461130=           :NDS_SUMM_,'
      '1101461131=           :COST_PRICE__'
      '1101461132=          )'
      '1101461133=          RETURNING'
      '1101461134=            ZAKAZ_DETAILS'
      '1101461135=          INTO'
      '1101461136=            :ZAKAZ_DETAILS_;'
      '1101461137=      END'
      '1101461138=  END'
      '1101461139=end'
      '1101461140=;'
      '1101461141='
      '1101461142=ALTER PROCEDURE P_REP_BILL('
      '1101461143=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101461144=  SUMM_DANO_ NUMERIC(15,2),'
      '1101461145=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1101461146=  CURRENCY_ INTEGER,'
      '1101461147=  MODE_ INTEGER,'
      '1101461148=  PRINT_SLOGAN_ VARCHAR(80),'
      '1101461149=  DECIMAL_ INTEGER,'
      '1101461150=  BONUS_ NUMERIC(15,2))'
      '1101461151=RETURNS ('
      '1101461152=  FIRM_NAME_ VARCHAR(600),'
      '1101461153=  IDN_STR_ VARCHAR(30),'
      '1101461154=  FIRM_IDN_ VARCHAR(50),'
      '1101461155=  FIRM_ADDRESS_ VARCHAR(550),'
      '1101461156=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101461157=  DATE_ VARCHAR(100),'
      '1101461158=  PAYMENT_TYPE_ VARCHAR(100),'
      '1101461159=  G_CLIENT_NAME_ VARCHAR(300),'
      '1101461160=  G_OFFICIAL_FM_ VARCHAR(300),'
      '1101461161=  SUMM_VSEGO_ VARCHAR(50),'
      '1101461162=  SUMM_VSEGO_N_ VARCHAR(50),'
      '1101461163=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1101461164=  ROW_NUM INTEGER,'
      '1101461165=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101461166=  NAME_ART VARCHAR(1000),'
      '1101461167=  AMOUNT VARCHAR(50),'
      '1101461168=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101461169=  PRICE VARCHAR(50),'
      '1101461170=  PRICE_N VARCHAR(50),'
      '1101461171=  SUMM VARCHAR(50),'
      '1101461172=  SUMM_N VARCHAR(50),'
      '1101461173=  SUMM_POLUCH_ VARCHAR(50),'
      '1101461174=  SUMM_SDACH_ VARCHAR(50),'
      '1101461175=  SUMM_STR_ VARCHAR(200),'
      '1101461176=  SLOGAN_ VARCHAR(80),'
      '1101461177=  SUMM_SKIDKA_ VARCHAR(50),'
      '1101461178=  SUMM_SERVICE_ VARCHAR(50),'
      '1101461179=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101461180=  BONUS_STR_ VARCHAR(100),'
      '1101461181=  ERR_CODE NUMERIC(15,2),'
      '1101461182=  ERR_MSG VARCHAR(1024))'
      '1101461183=AS'
      '1101461184=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '1101461185=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '1101461186=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101461187=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101461188=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101461189=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1101461190=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.AMOUNT;'
      
        '1101461191=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101461192=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101461193=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      '1101461194=BEGIN'
      '1101461195=  SLOGAN_ = PRINT_SLOGAN_;'
      '1101461196='
      '1101461197=  IF (BONUS_ > 0) THEN BEGIN'
      
        '1101461198=    BONUS_STR_ = '#39#1057#1091#1084#1084#1072' '#1073#1086#1085#1091#1089#1086#1074' '#1079#1072' '#1087#1086#1082#1091#1087#1082#1091' - '#39' || REP' +
        'LACE(CAST(BONUS_ AS VARCHAR(20)), '#39'.'#39', '#39','#39');'
      '1101461199=  END'
      '1101461200='
      '1101461201=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1101461202=  SELECT z.ZAKAZ'
      '1101461203=         ,P.NAME'
      
        '1101461204=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39 +
        ')||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '1101461205=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '1101461206=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COA' +
        'LESCE(O.NM, '#39#39')'
      '1101461207=         ,Z.summ_noncash'
      '1101461208=         ,Z.summ_cash'
      '1101461209=         ,Z.NOTE'
      
        '1101461210=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_' +
        'OFFICIAL = O.G_OFFICIAL,'
      '1101461211=         G_CLIENT G,'
      '1101461212=         G_PAYMENT_TYPE P'
      '1101461213=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101461214=     AND Z.G_CLIENT = G.G_CLIENT'
      '1101461215=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1101461216=    INTO :NUM_'
      '1101461217=        ,:PAYMENT_TYPE_'
      '1101461218=        ,:DATE_'
      '1101461219=        ,:G_CLIENT_NAME_'
      '1101461220=        ,:G_OFFICIAL_FM_'
      '1101461221=        ,:SUMM_NONCASH_'
      '1101461222=        ,:SUMM_CASH_'
      '1101461223=        ,:NOTE_'
      '1101461224=        ;'
      '1101461225='
      '1101461226=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '1101461227=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '1101461228='
      '1101461229=  SELECT R.G_FIRM_REKVIZIT,'
      '1101461230=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '1101461231=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086 +
        #1088#1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '1101461232=    FROM G_FIRM_REKVIZIT R'
      '1101461233=   WHERE R.is_default = 1'
      '1101461234=    INTO :G_FIRM_REKVIZIT_,'
      '1101461235=         :FIRM_NAME_,'
      '1101461236=         :FIRM_IDN_;'
      '1101461237='
      '1101461238=  SELECT ZD.SUMM'
      '1101461239=    FROM ZAKAZ_DETAILS ZD'
      '1101461240=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101461241=    AND ZD.G_PRODUCT = -2'
      '1101461242=    INTO :SERVICE_SUMM_;'
      '1101461243=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '1101461244='
      '1101461245=  SELECT SUM(ZD.AMOUNT),'
      
        '1101461246=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARC' +
        'HAR(50)),'
      
        '1101461247=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), ' +
        '2) AS VARCHAR(50)),'
      
        '1101461248=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHA' +
        'R(50)),'
      '1101461249=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '1101461250=  FROM ZAKAZ_DETAILS ZD'
      '1101461251=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101461252=    AND ZD.G_PRODUCT <> -2'
      '1101461253=  INTO :AMOUNT_VSEGO_NUM_,'
      '1101461254=       :SUMM_SKIDKA_,'
      '1101461255=       :SUMM_VSEGO_,'
      '1101461256=       :SUMM_VSEGO_N_,'
      '1101461257=       :SUMM_SERVICE_;'
      '1101461258='
      '1101461259=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '1101461260=    FROM G_FIRM_ADDRESS R'
      '1101461261=   WHERE R.IS_DEFAULT = 1'
      '1101461262=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '1101461263=    INTO :FIRM_ADDRESS_;'
      '1101461264='
      
        '1101461265=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047 +
        #1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '1101461266=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':' +
        #39');'
      '1101461267=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '1101461268=    IF (CURRENCY_ = 0) THEN'
      '1101461269=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '1101461270=    ELSE'
      '1101461271=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '1101461272=  END'
      '1101461273='
      '1101461274=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '1101461275='
      
        '1101461276=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR' +
        '(100));'
      
        '1101461277=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCH' +
        'AR(100));'
      '1101461278='
      '1101461279=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '1101461280=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '1101461281=  INTO :SUMM_STR_;'
      '1101461282='
      '1101461283=  FOR'
      '1101461284=    SELECT :I,'
      '1101461285=           G.NAME,'
      
        '1101461286=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39',' +
        ' '#39#39'),'
      '1101461287=           ZD.AMOUNT,'
      '1101461288=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '1101461289=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) ' +
        'AS VARCHAR(100))'
      '1101461290=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '1101461291=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENG' +
        'E, 0) AS VARCHAR(100))'
      '1101461292=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '1101461293=      FROM ZAKAZ Z,'
      '1101461294=           ZAKAZ_DETAILS ZD,'
      '1101461295=           G_PRODUCT G,'
      '1101461296=           G_UNIT U'
      '1101461297=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101461298=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101461299=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101461300=       AND G.G_UNIT = U.G_UNIT'
      '1101461301=       AND G.G_PRODUCT <> -2'
      '1101461302=     ORDER BY ZD.zakaz_details'
      '1101461303=    INTO :ROW_NUM,'
      '1101461304=        :NAME,'
      '1101461305=        :NAME_ART,'
      '1101461306=        :AMOUNT_NUM_,'
      '1101461307=        :PRICE,'
      '1101461308=        :SUMM'
      '1101461309=        ,:SHORT_NAME'
      '1101461310=        ,:PRICE_N'
      '1101461311=        ,:SUMM_N'
      '1101461312=  DO BEGIN'
      '1101461313=    I = I + 1;'
      '1101461314='
      
        '1101461315=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068 +
        ' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '1101461316=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '1101461317=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '1101461318=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '1101461319=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '1101461320=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '1101461321=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE)-1);'
      '1101461322=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '1101461323=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR P' +
        'OSITION('#39'.00'#39' IN PRICE_N)-1);'
      '1101461324=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '1101461325=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM)-1);'
      '1101461326=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '1101461327=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN SUMM_N)-1);'
      '1101461328=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '1101461329=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '1101461330=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '1101461331=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '1101461332=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '1101461333=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '1101461334=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '1101461335=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM' +
        ' 1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '1101461336='
      '1101461337=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1101461338=    IF (DECIMAL_ = 2) THEN BEGIN'
      '1101461339=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '1101461340=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,2));'
      '1101461341=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '1101461342=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '1101461343=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,3));'
      '1101461344=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '1101461345=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '1101461346=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,4));'
      '1101461347=    END ELSE BEGIN'
      '1101461348=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '1101461349=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,5));'
      '1101461350=    END'
      '1101461351='
      
        '1101461352=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT) > 0) then'
      
        '1101461353=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR PO' +
        'SITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '1101461354='
      
        '1101461355=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT_VSEGO_) > 0) then'
      
        '1101461356=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1' +
        ' FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '1101461357='
      '1101461358=    SUSPEND;'
      '1101461359=  END'
      '1101461360=WHEN ANY DO BEGIN'
      '1101461361=    Err_code = -20500;'
      
        '1101461362=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101461363=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101461364=  END'
      '1101461365=end'
      '1101461366=;'
      '1101461367='
      '1101461368=ALTER PROCEDURE UPD_ZAKAZ_DETAILS_DSCNT_ALL('
      
        '1101461369=  DISCOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_PER' +
        'C)'
      '1101461370=RETURNS ('
      '1101461371=  ERR_CODE INTEGER,'
      '1101461372=  ERR_MSG VARCHAR(1024))'
      '1101461373=AS'
      '1101461374=/*'
      
        '1101461375='#1055#1056#1048#1052#1045#1053#1071#1045#1058' '#1057#1050#1048#1044#1050#1059' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1042 +
        #1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1056#1040#1041#1054#1063#1045#1052' '#1052#1045#1057#1058#1045' '#1050#1040#1057#1057#1048#1056#1040
      '1101461376=*/'
      
        '1101461377=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_ZAKAZ_D' +
        'ETAILS_DSCNT_All'#39';'
      '1101461378=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101461379=BEGIN'
      '1101461380='
      '1101461381=  UPDATE ZAKAZ_DETAILS_TMP T'
      '1101461382=     SET T.DISCOUNT_PERC  = :DISCOUNT_,'
      '1101461383=         T.DISCOUNT_TENGE = T.PRICE * :DISCOUNT_/100,'
      
        '1101461384=         T.DISCOUNT_SUMM  = T.AMOUNT * T.PRICE * :DIS' +
        'COUNT_/100,'
      
        '1101461385=         T.SUMM           = T.AMOUNT * T.PRICE * (1 -' +
        ' :DISCOUNT_/100)'
      '1101461386=   WHERE T.G_PRODUCT <> -2;'
      '1101461387=END'
      '1101461388=;'
      '1101461389='
      '1101461390=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1101461391=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101461392=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101461393=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101461394=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101461395=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101461396=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101461397=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101461398=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101461399=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101461400=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101461401=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101461402=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101461403=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101461404=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101461405=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101461406=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101461407=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101461408=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101461409=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101461410=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1101461411=  NOT_MINUS_OSTATOK_ INTEGER = 0)'
      '1101461412=RETURNS ('
      '1101461413=  ERR_CODE INTEGER,'
      '1101461414=  ERR_MSG VARCHAR(1024))'
      '1101461415=AS'
      '1101461416=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1101461417='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1101461418=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1101461419=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1101461420='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1101461421=*/'
      
        '1101461422=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1101461423=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101461424=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101461425=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1101461426=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101461427=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1101461428=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1101461429=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1101461430=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1101461431=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101461432=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      '1101461433=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101461434=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101461435=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101461436=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      
        '1101461437=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101461438=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101461439=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101461440=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;' +
        ' /* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '1101461441=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '1101461442=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '1101461443=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1101461444=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101461445=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101461446=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101461447=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101461448=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101461449=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101461450=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101461451=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1101461452=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1101461453=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101461454=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101461455=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101461456=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1101461457=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1101461458=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1101461459=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101461460=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1101461461=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101461462=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      '1101461463=BEGIN'
      '1101461464='
      '1101461465=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101461466=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101461467=      SELECT Z.G_PAYMENT_TYPE,'
      '1101461468=             Z.G_TOCHKA,'
      '1101461469=             Z.SUMM,'
      '1101461470=             Z.SUMM_BONUS,'
      '1101461471=             Z.SUMM_BONUS_GOT,'
      '1101461472=             z.g_client,'
      '1101461473=             Z.G_OFFICIAL,'
      '1101461474=             G.DO_NOT_SALES_COMM,'
      '1101461475=             G.FM||'#39' '#39'||G.NM'
      
        '1101461476=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101461477=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101461478=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1101461479=             :G_TOCHKA_,'
      '1101461480=             :SUMM_OLD_,'
      '1101461481=             :SUMM_BONUS_OLD_,'
      '1101461482=             :SUMM_BONUS_GOT_OLD_,'
      '1101461483=             :g_client_old_,'
      '1101461484=             :G_OFFICIAL_,'
      '1101461485=             :DO_NOT_SALES_COMM_,'
      '1101461486=             :OFFICIAL_NAME_;'
      '1101461487='
      
        '1101461488=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101461489=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1101461490=        SELECT SUM(ZD.SALES_COMM)'
      '1101461491=          FROM ZAKAZ_DETAILS ZD'
      '1101461492=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101461493=          INTO :SALES_COMM_OLD_;'
      '1101461494='
      '1101461495=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101461496=      PNT_ = '#39'02'#39';'
      
        '1101461497=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101461498=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461499=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101461500=        EXIT;'
      '1101461501=      END'
      '1101461502='
      
        '1101461503=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101461504=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101461505=      ELSE'
      '1101461506=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101461507='
      '1101461508=      PNT_ = '#39'01'#39';'
      '1101461509=      UPDATE zakaz'
      '1101461510=      SET'
      '1101461511=       G_TOCHKA = :G_TOCHKA_,'
      '1101461512=       Z_DATE = :Z_DATE_,'
      '1101461513=       Z_TIME = :Z_TIME_,'
      '1101461514=       G_CLIENT = :G_CLIENT_,'
      '1101461515=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101461516=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101461517=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1101461518=       SUMM = :SUMM_,'
      '1101461519=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1101461520=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101461521=       ,BY_RECIPE = :BY_RECIPE_'
      '1101461522=       ,IS_RESERVE = :IS_RESERVE_'
      '1101461523=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1101461524=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1101461525=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1101461526=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1101461527=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1101461528=      WHERE'
      '1101461529=        zakaz = :zakaz_;'
      '1101461530='
      
        '1101461531=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1101461532=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1101461533=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1101461534=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1101461535=          UPDATE G_DISCONT_CARD D'
      '1101461536=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1101461537=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1101461538=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1101461539='
      
        '1101461540=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1101461541=          SUMM_OLD_           = 0;'
      '1101461542=      END'
      '1101461543=      UPDATE G_DISCONT_CARD D'
      
        '1101461544=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1101461545=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1101461546=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1101461547='
      '1101461548=      PNT_ = '#39'03'#39';'
      '1101461549=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1101461550=                 T.G_PRODUCT,'
      '1101461551=                 T.AMOUNT,'
      '1101461552=                 T.SUMM,'
      '1101461553=                 G.SALES_COMM'
      '1101461554=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1101461555=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1101461556=      INTO :ZAKAZ_DETAILS_,'
      '1101461557=           :G_PRODUCT_,'
      '1101461558=           :Z_AMOUNT_,'
      '1101461559=           :DETAILS_SUMM_,'
      '1101461560=           :SALES_COMM_'
      '1101461561=      DO BEGIN'
      
        '1101461562=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101461563=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1101461564=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1101461565=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101461566=        END'
      '1101461567='
      
        '1101461568=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101461569=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1101461570=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101461571=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1101461572=          FROM ZAKAZ_DETAILS_TMP Z'
      '1101461573=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1101461574='
      '1101461575=        -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1101461576=        IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1101461577=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' ' +
        #1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1101461578=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN'
      '1101461579=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101461580=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_'
      '1101461581=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101461582=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101461583='
      '1101461584=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101461585=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101461586=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101461587=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :Z_AMOUNT_'
      '1101461588=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101461589=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101461590=        END'
      '1101461591=      END'
      '1101461592='
      '1101461593=      ----------------------------------------'
      
        '1101461594=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101461595=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1101461596=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1101461597=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101461598=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101461599=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1101461600=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101461601=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101461602=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1101461603=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1101461604=                PNT_ = '#39'04'#39';'
      
        '1101461605=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101461606=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101461607=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101461608=                ELSE'
      
        '1101461609=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101461610='
      
        '1101461611=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101461612=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101461613='
      
        '1101461614=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101461615='
      '1101461616=                PNT_ = '#39'05'#39';'
      
        '1101461617=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN'
      
        '1101461618=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101461619=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101461620=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101461621=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101461622=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101461623=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1101461624=                                                  NUL' +
        'L,'
      
        '1101461625=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101461626=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101461627='
      
        '1101461628=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101461629=                ELSE BEGIN'
      
        '1101461630=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101461631=                    SELECT 1'
      '1101461632=                      FROM KASSA K'
      '1101461633=                     WHERE K.KASSA = :KASSA_'
      '1101461634=                    UNION ALL'
      '1101461635=                    SELECT 2'
      '1101461636=                      FROM KASSA_BEZNAL KB'
      '1101461637=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101461638=                     INTO :PAYMENT_TYPE_OLD_;'
      '1101461639='
      '1101461640=                    PNT_ = '#39'06'#39';'
      
        '1101461641=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
        'YPE_) THEN'
      
        '1101461642=                        EXECUTE PROCEDURE K_UPD_KASSA' +
        '(:KASSA_,'
      
        '1101461643=                                                     ' +
        ' 0,     -- ACTION_'
      
        '1101461644=                                                     ' +
        ' 1,     --:G_PRIHOD_RASHOD_,'
      
        '1101461645=                                                     ' +
        ' :PAYMENT_SUMM_,'
      
        '1101461646=                                                     ' +
        ' :PAYMENT_DATE_,'
      
        '1101461647=                                                     ' +
        ' NULL,   --NOTE_'
      
        '1101461648=                                                     ' +
        ' :ZAKAZ_,'
      
        '1101461649=                                                     ' +
        ' NULL,'
      
        '1101461650=                                                     ' +
        ' :PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '1101461651=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' ' +
        #1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101461652=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' ' +
        #1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101461653=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
