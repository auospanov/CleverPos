      '1102112253='
      '1102112254=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102112255=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102112256=                FROM ZAKAZ_DETAILS_TMP Z'
      '1102112257=              INTO :G_PRODUCT_,'
      '1102112258=                  :Z_AMOUNT_,'
      '1102112259=                  :PRICE_,'
      '1102112260=                  :SUMMM_'
      '1102112261=          DO BEGIN'
      '1102112262=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102112263=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1102112264=            IS_THIS_LAST_ = 0;'
      '1102112265=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102112266=                FROM SKLAD SK'
      '1102112267=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102112268=                 AND SK.IS_LAST = 1'
      '1102112269=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1102112270=                INTO :DATE_LAST_;'
      '1102112271='
      
        '1102112272=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102112273=                UPDATE SKLAD SK'
      '1102112274=                   SET SK.IS_LAST = 0'
      '1102112275=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102112276=                   AND SK.IS_LAST = 1'
      '1102112277=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102112278='
      '1102112279=                IS_THIS_LAST_ = 1;'
      '1102112280=            END'
      '1102112281='
      '1102112282='
      '1102112283=            INSERT INTO SKLAD'
      '1102112284=            ('
      '1102112285=             SKLAD,'
      '1102112286=             SKLAD_PARENT,'
      '1102112287=             DATE_RECEIPT,'
      '1102112288=             G_CLIENT,'
      '1102112289=             G_PRODUCT,'
      '1102112290=             AMOUNT,'
      '1102112291=             PRICE,'
      '1102112292=             SUMM,'
      '1102112293=             G_PAYMENT_TYPE,'
      '1102112294=             OSNOVANIE,'
      '1102112295=             NOTE,'
      '1102112296=             NDS,'
      '1102112297=             NDS_SUMM,'
      '1102112298=             IS_LAST,'
      '1102112299=             IS_VOZVRAT,'
      '1102112300=             G_TOCHKA'
      '1102112301=            ) VALUES ('
      '1102112302=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102112303=             :ZAKAZ_,'
      '1102112304=             :Z_DATE_,'
      '1102112305=             :G_TOCHKA_,'
      '1102112306=             :G_PRODUCT_,'
      '1102112307=             :Z_AMOUNT_,'
      '1102112308=             :PRICE_,'
      '1102112309=             :SUMMM_,'
      '1102112310=             :G_PAYMENT_TYPE_,'
      '1102112311=             :OSNOVANIE_,'
      '1102112312=             :NOTE_,'
      '1102112313=             0,  --:RNDS_,'
      '1102112314=             0,  --:RNDS_SUMM_,'
      
        '1102112315=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1102112316=             3,  --:IS_VOZVRAT_,'
      '1102112317=             :G_CLIENT_'
      '1102112318=            );'
      '1102112319='
      
        '1102112320=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1102112321=            UPDATE LT_SKLAD_PRODUCT L'
      '1102112322=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_,'
      
