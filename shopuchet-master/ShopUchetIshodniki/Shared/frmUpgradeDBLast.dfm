        '1102491727=        TRGD = TRGD||CRLF||'#39'  INSERT INTO LOGS(ID,SQL' +
        'STMT,TTABLE,USR)'#39'||CRLF||'
      
        '1102491728=          '#39'  SELECT GEN_ID(GEN_LOGS,1), '#39#39'KASSA_BEZNA' +
        'L:'#39#39'||OLD.ACTION_DATE, '#39#39'KASSA_BEZNAL'#39#39', '#39#39'SYSDBA'#39#39#39'||CRLF||'
      
        '1102491729=          '#39'  FROM RDB$DATABASE WHERE NOT EXISTS (SELE' +
        'CT 1 FROM LOGS L WHERE L.SQLSTMT = '#39#39'KASSA_BEZNAL:'#39#39'||OLD.ACTION' +
        '_DATE AND'#39'||CRLF||'
      
        '1102491730=          '#39'                                      L.US' +
        'R = '#39#39'SYSDBA'#39#39' AND L.DAT IS NULL AND L.IS_TRANSFERED = 0);'#39'||CRL' +
        'F;'
      '1102491731='
      '1102491732=    TRGD = TRGD||'#39'END'#39';'
      '1102491733='
      '1102491734=    TN_ALT=TN;'
      '1102491735=  END'
      '1102491736=  IF (TRGIX<>'#39#39') THEN'
      '1102491737=    EXECUTE STATEMENT TRGIX;'
      '1102491738='
      '1102491739=  EXECUTE STATEMENT TRGI;'
      '1102491740=  IF (TRGUX<>'#39#39') THEN'
      '1102491741=    EXECUTE STATEMENT TRGUX;'
      '1102491742='
      '1102491743=  EXECUTE STATEMENT TRGU;'
      '1102491744='
      '1102491745=  IF (TRGDX<>'#39#39') THEN'
      '1102491746=    EXECUTE STATEMENT TRGDX;'
      '1102491747=  EXECUTE STATEMENT TRGD;'
      '1102491748='
      '1102491749=  -- BLOB-'#1055#1054#1051#1071' '#1054#1058#1044#1045#1051#1068#1053#1067#1045' '#1058#1056#1048#1043#1043#1045#1056#1067
      '1102491750=  TN_ALT    = '#39#39';'
      '1102491751=  ID_COLUMN = '#39#39';'
      
        '1102491752=  FOR SELECT TRIM(RDB$RELATION_FIELDS.RDB$RELATION_NA' +
        'ME),'
      '1102491753=             TRIM(RDB$RELATION_FIELDS.RDB$FIELD_NAME)'
      
        '1102491754=        FROM RDB$RELATION_FIELDS JOIN RDB$FIELDS ON R' +
        'DB$RELATION_FIELDS.RDB$FIELD_SOURCE=RDB$FIELDS.RDB$FIELD_NAME'
      
        '1102491755=       WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T CONTAINING '#39'$'#39
      '1102491756=         AND RDB$FIELDS.RDB$FIELD_TYPE = 261'
      '1102491757=         AND RDB$FIELDS.RDB$FIELD_SUB_TYPE = 0'
      
        '1102491758=         AND RDB$RELATION_FIELDS.RDB$RELATION_NAME NO' +
        'T IN ('#39'CUR_PARAMS'#39', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_' +
        'SIZES'#39','
      
        '1102491759=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1102491760=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1102491761=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1102491762=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1102491763=                                         '#39'REVISION'#39', ' +
        #39'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1102491764=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_TOC' +
        'HKA'#39', '#39'G_PRODUCT_FILL'#39','
      
        '1102491765=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39')'
      '1102491766=        INTO :TN,'
      '1102491767=             :FN'
      '1102491768=  DO BEGIN'
      '1102491769=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN BEGIN'
      '1102491770=      SELECT TRIM(F.RDB$FIELD_NAME)'
      '1102491771=        FROM RDB$RELATION_FIELDS F'
      '1102491772=       WHERE F.RDB$RELATION_NAME = :TN'
      '1102491773=         AND F.RDB$FIELD_POSITION = 0'
      '1102491774=        INTO :ID_COLUMN;'
      '1102491775=    END'
      '1102491776='
      
        '1102491777=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1102491778=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '1102491779=        '#39'AS '#39'||CRLF||'
      '1102491780=        '#39'BEGIN '#39'||CRLF||'
      
        '1102491781=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1102491782=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF|' +
        '|'
      
        '1102491783=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1102491784=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1102491785=        '#39'END;'#39';'
      '1102491786=    EXECUTE STATEMENT :TRGI;'
      '1102491787='
      
        '1102491788=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1102491789=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '1102491790=        '#39'AS '#39'||CRLF||'
      '1102491791=        '#39'BEGIN '#39'||CRLF||'
      
        '1102491792=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1102491793=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRL' +
        'F||'
      
        '1102491794=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1102491795=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1102491796=        '#39'END;'#39';'
      '1102491797=    EXECUTE STATEMENT :TRGI;'
      '1102491798='
      '1102491799=    TN_ALT = TN;'
      '1102491800=  END'
      '1102491801=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '1102491802=        FROM RDB$RELATIONS R'
      '1102491803=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1102491804=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '1102491805=       ORDER BY R.RDB$RELATION_NAME'
      '1102491806=        INTO :TN'
      '1102491807=  DO BEGIN'
      '1102491808=    TN=TRIM(TN);'
      '1102491809=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '1102491810='
      '1102491811=    EXECUTE STATEMENT :SQLSTMT;'
      '1102491812=  END'
      '1102491813=END'
      '1102491814=;'
      '1102491815='
      '1102491816=ALTER PROCEDURE P_REP_BILL('
      '1102491817=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102491818=  SUMM_DANO_ NUMERIC(15,2),'
      '1102491819=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1102491820=  CURRENCY_ INTEGER,'
      '1102491821=  MODE_ INTEGER,'
      '1102491822=  PRINT_SLOGAN_ VARCHAR(80),'
      '1102491823=  DECIMAL_ INTEGER,'
      '1102491824=  BONUS_ NUMERIC(15,2),'
      '1102491825=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '1102491826=  BONUS_ALL_ NUMERIC(15,2) = 0)'
      '1102491827=RETURNS ('
      '1102491828=  FIRM_NAME_ VARCHAR(600),'
      '1102491829=  IDN_STR_ VARCHAR(30),'
      '1102491830=  FIRM_IDN_ VARCHAR(50),'
      '1102491831=  FIRM_ADDRESS_ VARCHAR(550),'
      '1102491832=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102491833=  DATE_ VARCHAR(100),'
      '1102491834=  PAYMENT_TYPE_ VARCHAR(100),'
      '1102491835=  G_CLIENT_NAME_ VARCHAR(300),'
      '1102491836=  G_OFFICIAL_FM_ VARCHAR(300),'
      '1102491837=  SUMM_VSEGO_ VARCHAR(50),'
      '1102491838=  SUMM_VSEGO_WITHOUT_SERVICE_ VARCHAR(50),'
      '1102491839=  SUMM_VSEGO_N_ VARCHAR(50),'
      '1102491840=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1102491841=  SUMM_NDS_ VARCHAR(50),'
      '1102491842=  ROW_NUM INTEGER,'
      '1102491843=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102491844=  NAME_ART VARCHAR(1000),'
      '1102491845=  AMOUNT VARCHAR(50),'
      '1102491846=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102491847=  PRICE VARCHAR(50),'
      '1102491848=  PRICE_N VARCHAR(50),'
      '1102491849=  SUMM VARCHAR(50),'
      '1102491850=  SUMM_TXT VARCHAR(300),'
      '1102491851=  DISCOUNT VARCHAR(300),'
      '1102491852=  SUMM_N VARCHAR(50),'
      '1102491853=  SUMM_POLUCH_ VARCHAR(50),'
      '1102491854=  SUMM_NONCASH_ VARCHAR(50),'
      '1102491855=  SUMM_BONUS_ VARCHAR(50),'
      '1102491856=  SUMM_SDACH_ VARCHAR(50),'
      '1102491857=  SUMM_STR_ VARCHAR(200),'
      '1102491858=  SLOGAN_ VARCHAR(80),'
      '1102491859=  SUMM_SKIDKA_ VARCHAR(50),'
      '1102491860=  SUMM_SERVICE_ VARCHAR(50),'
      '1102491861=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102491862=  BONUS_STR_ VARCHAR(100),'
      '1102491863=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '1102491864=  BILL_BARCODE_ TYPE OF COLUMN ZAKAZ.BARCODE,'
      '1102491865=  ERR_CODE NUMERIC(15,2),'
      '1102491866=  ERR_MSG VARCHAR(1024),'
      '1102491867=  NAME_MARKER VARCHAR(1000),'
      '1102491868=  BONUSALL_STR_ VARCHAR(100))'
      '1102491869=AS'
      '1102491870=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045
      '1102491871='
      '1102491872=26.09.2022'
      
        '1102491873='#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1054#1041#1065#1040#1071' '#1057#1050#1048#1044#1050#1040' '#1042' '#1050#1054#1053#1062#1045' '#1063#1045#1050#1040', '#1063#1058#1054' '#1041#1067#1051#1054 +
        ' '#1053#1045#1059#1044#1054#1041#1053#1054', '#1053#1045#1055#1054#1053#1071#1058#1053#1054' '#1053#1040' '#1050#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1041#1067#1051#1040' '#1057#1050#1048#1044#1050#1040
      
        '1102491874='#1058#1045#1055#1045#1056#1068' '#1046#1045' '#1057#1050#1048#1044#1050#1040' '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1055#1054#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1054#1042#1040#1056#1054#1052'. '#1048#1057#1061#1054#1044 +
        #1071' '#1048#1047' '#1069#1058#1054#1043#1054' '#1053#1045#1050#1054#1058#1054#1056#1067#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1067#1045' '#1059#1055#1056#1040#1047#1044#1053#1048#1051#1048#1057#1068
      '1102491875='
      
        '1102491876='#1058#1045#1055#1045#1056#1068' '#1057#1058#1056#1054#1050#1040' "'#1057#1059#1052#1052#1040'" '#1055#1045#1063#1040#1058#1040#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1041#1067#1051#1054' '#1044#1054#1041 +
        #1040#1042#1051#1045#1053#1054' "'#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%"'
      '1102491877='
      
        '1102491878=SUMM_VSEGO_ - '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051#1040#1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054 +
        #1050', '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '1102491879=SUMM_VSEGO_WITHOUT_SERVICE_ - '#1058#1045#1055#1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045 +
        #1053#1053#1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '1102491880='
      '1102491881='
      
        '1102491882=SUMM_POLUCH_  - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1055#1054#1051#1059#1063#1045#1053#1054 +
        ' '#1054#1058' '#1050#1051#1048#1045#1053#1058#1040' '#1053#1040#1051#1048#1063#1053#1067#1052#1048' = SUMM_DANO_, '#1055#1056#1048#1061#1054#1044#1048#1058' '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040
      
        '1102491883=SUMM_NONCASH_ - '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1045#1053#1045#1043' '#1054#1055#1051#1040#1063#1045#1053#1054 +
        ' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059
      '1102491884=SUMM_BONUS_   - '#1057#1050#1054#1051#1068#1050#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1041#1054#1053#1059#1057#1040#1052#1048
      '1102491885='
      
        '1102491886=PAYMENT_TYPE_ - '#1059#1055#1056#1040#1047#1044#1053#1045#1053#1040', '#1058'.'#1050'. '#1057#1058#1056#1054#1050#1040' "'#1057#1055#1054#1057#1054#1041' '#1054#1055#1051#1040#1058 +
        #1067'" '#1059#1041#1056#1040#1053#1040', '#1058#1045#1055#1045#1056#1068' '#1042#1053#1048#1047#1059' '#1041#1059#1044#1045#1058' '#1044#1042#1045' '#1057#1058#1056#1054#1050#1048':'
      '1102491887="'#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '1102491888="'#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1052#1048'"'
      '1102491889='
      '1102491890=----'
      '1102491891=*/'
      '1102491892=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '1102491893=DECLARE VARIABLE PNT_ VARCHAR(5) = '#39'00'#39';'
      '1102491894=DECLARE VARIABLE I INTEGER = 1;'
      
        '1102491895=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1102491896=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1102491897=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.AMOUNT;'
      
        '1102491898=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      '1102491899=BEGIN'
      '1102491900=  SLOGAN_ = PRINT_SLOGAN_;'
      '1102491901=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '1102491902=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '1102491903=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS' +
        '_;'
      '1102491904=  END'
      '1102491905='
      '1102491906=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1102491907=  SELECT z.ZAKAZ'
      '1102491908=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '1102491909=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39 +
        ')||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '1102491910=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '1102491911=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COA' +
        'LESCE(O.NM, '#39#39')'
      '1102491912=         ,Z.NOTE'
      
        '1102491913=         ,CAST(ROUND(Z.summ_noncash, 2) AS VARCHAR(10' +
        '0))'
      '1102491914=         ,CAST(ROUND(:SUMM_DANO_, 2) AS VARCHAR(100))'
      
        '1102491915=         ,CAST(ROUND(:SUMM_SDACHA_, 2) AS VARCHAR(100' +
        '))'
      
        '1102491916=         ,CAST(ROUND(Z.SUMM_BONUS, 2) AS VARCHAR(100)' +
        ')'
      '1102491917=         ,Z.BARCODE'
      
        '1102491918=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_' +
        'OFFICIAL = O.G_OFFICIAL,'
      '1102491919=         G_CLIENT G,'
      '1102491920=         G_PAYMENT_TYPE P'
      '1102491921=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102491922=     AND Z.G_CLIENT = G.G_CLIENT'
      '1102491923=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1102491924=    INTO :NUM_'
      '1102491925=        ,:PAYMENT_TYPE_'
      '1102491926=        ,:DATE_'
      '1102491927=        ,:G_CLIENT_NAME_'
      '1102491928=        ,:G_OFFICIAL_FM_'
      '1102491929=        ,:NOTE_'
      '1102491930=        ,:SUMM_NONCASH_'
      '1102491931=        ,:SUMM_POLUCH_'
      '1102491932=        ,:SUMM_SDACH_'
      '1102491933=        ,:SUMM_BONUS_'
      '1102491934=        ,:BILL_BARCODE_'
      '1102491935=        ;'
      '1102491936='
      '1102491937=  --'#1041#1054#1053#1059#1057#1067' '#1042' '#1063#1045#1050#1045
      '1102491938=  IF (BONUS_ > 0) THEN'
      '1102491939=  BEGIN'
      
        '1102491940=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(' +
        'BONUS_, 2) AS VARCHAR(100));'
      '1102491941=  END'
      '1102491942='
      '1102491943=  if (BONUS_ALL_ > 0) then'
      '1102491944=  BEGIN'
      
        '1102491945=    BONUSALL_STR_ = '#39#1042#1089#1077#1075#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(B' +
        'ONUS_ALL_, 2) AS VARCHAR(100));'
      '1102491946=  END'
      '1102491947='
      '1102491948=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1102491949=  --IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '1102491950=  --  PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '1102491951='
      '1102491952=  SELECT R.G_FIRM_REKVIZIT,'
      '1102491953=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '1102491954=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086 +
        #1088#1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '1102491955=    FROM G_FIRM_REKVIZIT R'
      '1102491956=   WHERE R.is_default = 1'
      '1102491957=    INTO :G_FIRM_REKVIZIT_,'
      '1102491958=         :FIRM_NAME_,'
      '1102491959=         :FIRM_IDN_;'
      '1102491960='
      '1102491961=  SELECT ZD.SUMM'
      '1102491962=    FROM ZAKAZ_DETAILS ZD'
      '1102491963=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102491964=    AND ZD.G_PRODUCT = -2'
      '1102491965=    INTO :SERVICE_SUMM_;'
      '1102491966=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '1102491967='
      '1102491968=  SELECT SUM(ZD.AMOUNT),'
      
        '1102491969=         CAST(ROUND(SUM((CASE WHEN ZD.DISCOUNT_SUMM>0' +
        ' THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)),'
      
        '1102491970=         CAST(ROUND(SUM(ZD.SUMM + (CASE WHEN ZD.DISCO' +
        'UNT_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END)), 2) AS VARCHAR(50)' +
        '),'
      '1102491971=         CAST(SUM(ZD.SUMM) AS VARCHAR(50)),'
      
        '1102491972=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHA' +
        'R(50)),'
      '1102491973=         CAST(:SERVICE_SUMM_  AS VARCHAR(50)),'
      '1102491974=         CAST(SUM(ZD.NDS_SUMM) AS VARCHAR(50))'
      '1102491975=  FROM ZAKAZ_DETAILS ZD'
      '1102491976=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102491977=    AND ZD.G_PRODUCT <> -2'
      '1102491978=  INTO :AMOUNT_VSEGO_NUM_,'
      '1102491979=       :SUMM_SKIDKA_,'
      
        '1102491980=       :SUMM_VSEGO_,     -- 26.09.2022 '#1056#1040#1053#1068#1064#1045' '#1055#1045#1063#1040#1058#1040#1051 +
        #1040#1057#1068' '#1057#1059#1052#1052#1040' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1057#1050#1048#1044#1054#1050', '#1058#1045#1055#1045#1056#1068' '#1054#1053#1040' '#1053#1045' '#1053#1059#1046#1053#1040', '#1053#1054' '#1054#1057#1058#1040#1042#1048#1051' '#1053#1040' '#1042 +
        #1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049
      
        '1102491981=       :SUMM_VSEGO_WITHOUT_SERVICE_, -- 26.09.2022 '#1058#1045 +
        #1055#1045#1056#1068' '#1041#1059#1044#1045#1058' '#1069#1058#1040' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' '#1041#1045#1047' '#1059#1063#1045#1058#1040' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1071' 10%'
      '1102491982=       :SUMM_VSEGO_N_,'
      '1102491983=       :SUMM_SERVICE_,'
      '1102491984=       :SUMM_NDS_;'
      '1102491985='
      '1102491986=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '1102491987=    FROM G_FIRM_ADDRESS R'
      '1102491988=   WHERE R.IS_DEFAULT = 1'
      '1102491989=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '1102491990=    INTO :FIRM_ADDRESS_;'
      '1102491991='
      
        '1102491992=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047 +
        #1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '1102491993=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':' +
        #39');'
      '1102491994=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '1102491995=    IF (CURRENCY_ = 0) THEN'
      '1102491996=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '1102491997=    ELSE'
      '1102491998=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '1102491999=  END'
      '1102492000='
      '1102492001=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '1102492002='
      '1102492003=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '1102492004=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '1102492005=  INTO :SUMM_STR_;'
      '1102492006='
      '1102492007=  FOR'
      '1102492008=    SELECT :I || '#39'. '#39' || G.NAME,'
      
        '1102492009=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.M' +
        'ARK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||' +
        'ZD.MARK_CODE END),'
      
        '1102492010=           (CASE WHEN (G.ARTICUL is null) or (G.ARTIC' +
        'UL = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '1102492011=           ZD.AMOUNT,'
      
        '1102492012=           CAST(ROUND(ZD.PRICE - (CASE WHEN ZD.DISCOU' +
        'NT_SUMM<0 THEN ZD.DISCOUNT_SUMM else 0 END)/ZD.AMOUNT, 2) AS VAR' +
        'CHAR(100)),'
      
        '1102492013=           CAST(ROUND(ZD.SUMM + (CASE WHEN ZD.DISCOUN' +
        'T_SUMM>0 THEN ZD.DISCOUNT_SUMM else 0 END) , 2) AS VARCHAR(100))'
      '1102492014=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '1102492015=           ,CAST(ZD.PRICE AS VARCHAR(100))--CAST(ZD.P' +
        'RICE - ZD.DISCOUNT_TENGE AS VARCHAR(100))'
      '1102492016=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '1102492017=           ,CAST(ZD.DISCOUNT_SUMM AS VARCHAR(100))'
      '1102492018=      FROM ZAKAZ Z,'
      '1102492019=           ZAKAZ_DETAILS ZD,'
      '1102492020=           G_PRODUCT G,'
      '1102492021=           G_UNIT U'
      '1102492022=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102492023=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102492024=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1102492025=       AND G.G_UNIT = U.G_UNIT'
      '1102492026=       AND G.G_PRODUCT <> -2'
      '1102492027=     ORDER BY ZD.zakaz_details'
      '1102492028=    INTO :NAME,'
      '1102492029=        :NAME_MARKER,'
      '1102492030=        :NAME_ART,'
      '1102492031=        :AMOUNT_NUM_,'
      '1102492032=        :PRICE,'
      '1102492033=        :SUMM'
      '1102492034=        ,:SHORT_NAME'
      '1102492035=        ,:PRICE_N'
      '1102492036=        ,:SUMM_N'
      '1102492037=        ,:DISCOUNT'
      '1102492038='
      '1102492039=  DO BEGIN'
      '1102492040=    I = I + 1;'
      '1102492041='
      
        '1102492042=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068 +
        ' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '1102492043=    /*if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '1102492044=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '1102492045=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '1102492046=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '1102492047=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '1102492048=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE)-1);'
      '1102492049=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '1102492050=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR P' +
        'OSITION('#39'.00'#39' IN PRICE_N)-1);'
      '1102492051=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '1102492052=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM)-1);'
      '1102492053=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '1102492054=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN SUMM_N)-1);'
      '1102492055=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '1102492056=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '1102492057=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '1102492058=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '1102492059=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '1102492060=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '1102492061=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '1102492062=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM' +
        ' 1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '1102492063=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '1102492064=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR' +
        ' POSITION('#39'.00'#39' IN BONUS_STR_)-1);*/'
      '1102492065='
      '1102492066=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1102492067=    IF (DECIMAL_ = 2) THEN BEGIN'
      '1102492068=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '1102492069=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,2));'
      '1102492070=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '1102492071=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '1102492072=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,3));'
      '1102492073=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '1102492074=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '1102492075=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,4));'
      '1102492076=    END ELSE BEGIN'
      '1102492077=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '1102492078=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,5));'
      '1102492079=    END'
      '1102492080='
      
        '1102492081=    --if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AM' +
        'OUNT) > 0) then'
      
        '1102492082=    --  AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR ' +
        'POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '1102492083='
      
        '1102492084=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT_VSEGO_) > 0) then'
      
        '1102492085=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1' +
        ' FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '1102492086='
      
        '1102492087=    SUMM_TXT = AMOUNT || '#39' x '#39' || PRICE_N || '#39' = '#39' ||' +
        ' SUMM;--SUMM_N;'
      '1102492088='
      '1102492089=    SUSPEND;'
      '1102492090=  END'
      '1102492091=WHEN ANY DO BEGIN'
      '1102492092=    Err_code = -20500;'
      
        '1102492093=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102492094=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102492095=  END'
      '1102492096=end'
      '1102492097=;'
      '1102492098='
      '1102492099=ALTER PROCEDURE P_REP_TOVAR_OSTATOK_ON_DATE('
      '1102492100=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102492101=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102492102=  DATE_ DATE,'
      '1102492103=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1102492104=RETURNS ('
      '1102492105=  NAME VARCHAR(1024),'
      '1102492106=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102492107=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102492108=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102492109=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1102492110=  SUMM MY_NUMERIC,'
      '1102492111=  ERR_CODE INTEGER,'
      '1102492112=  ERR_MSG VARCHAR(1024))'
      '1102492113=AS'
      
        '1102492114=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'OSTATOK_ON_DATE'#39';'
      '1102492115=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102492116=DECLARE VARIABLE G_PRODUCT_PAR TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR;'
      
        '1102492117=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      '1102492118=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1102492119=BEGIN'
      '1102492120='
      '1102492121=  SELECT S.S_VALUE,'
      '1102492122=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1102492123=    FROM SYSTEM_SETUP S'
      '1102492124=   WHERE S.SYSTEM_SETUP = 1'
      '1102492125=    INTO :FORMULA_,'
      '1102492126=         :PRIHOD_CNT_;'
      '1102492127='
      '1102492128=  FOR WITH OSTATOK_ARR AS (SELECT GP.NAME,'
      '1102492129=                               GP.BARCODE,'
      '1102492130=                               GP.ARTICUL,'
      '1102492131=                               GP.PRICE,'
      '1102492132=                               GP.G_PRODUCT,'
      '1102492133=                               GP.G_PRODUCT_PAR,'
      
        '1102492134=                               (select (select sum(am' +
        'ount) from lt_sklad_product where g_product = GP.G_PRODUCT'
      
        '1102492135=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||g_tochka||'#39'-'#39')'
      
        '1102492136=                                        +  -- '#1090#1086#1074#1072#1088' '#1085 +
        #1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1102492137=                                       (select COALES' +
        'CE(sum(zr.AMOUNT_ALL), 0) from zakaz_na_real zr, zakaz_real_pare' +
        'nt zrp'
      
        '1102492138=                                        where zr.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TO' +
        'CHKA||'#39'-'#39
      
        '1102492139=                                        and zr.ZAKAZ_' +
        'REAL_PARENT = zrp.ZAKAZ_REAL_PARENT'
      
        '1102492140=                                        and zrp.ZAKAZ' +
        '_DATE > :DATE_)'
      '1102492141=                                       +'
      
        '1102492142=                                       (select COALES' +
        'CE(sum(zd.amount), 0) from zakaz_details zd, zakaz z'
      
        '1102492143=                                        where zd.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      
        '1102492144=                                        and zd.zakaz ' +
        '= z.zakaz and z.z_date > :DATE_'
      
        '1102492145=                                        and z.IS_SPIS' +
        'ANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072 +
        #1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102492146=                                        and not (z.IS' +
        '_SPISANIE = 0 and z.NOT_MINUS_OSTATOK = 1))'
      '1102492147=                                       +'
      
        '1102492148=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and s.is_vozvrat = 3'
      
        '1102492149=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt > :DATE' +
        '_)'
      '1102492150=                                       +'
      
        '1102492151=                                       (select COALES' +
        'CE(sum(od.amount), 0) from other_details od, other o'
      
        '1102492152=                                        where od.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCH' +
        'KA||'#39'-'#39
      
        '1102492153=                                        and od.other ' +
        '= o.other and o.op_date > :DATE_)'
      '1102492154=                                       -'
      
        '1102492155=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102492156=                                        and s.is_vozv' +
        'rat <> 3 and s.date_receipt > :DATE_)'
      '1102492157=                                       -'
      
        '1102492158=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and s.is_vozvrat = 3'
      
        '1102492159=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt > :DATE' +
        '_)'
      
        '1102492160=                                  from rdb$database) ' +
        'AMOUNT'
      '1102492161=                          FROM G_PRODUCT GP'
      '1102492162=                         WHERE GP.IS_ACTIVE = 1'
      '1102492163=                           AND GP.IS_CATEGORY = 0'
      
        '1102492164=                           AND ((:G_CATEGORY_ CONTAIN' +
        'ING '#39'~'#39'||GP.G_PRODUCT_PAR||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102492165=                                 OR'
      
        '1102492166=                                 (:G_CATEGORY_ IS NUL' +
        'L)'
      '1102492167=                               )'
      
        '1102492168=                           AND ((:G_PRODUCT_ CONTAINI' +
        'NG '#39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102492169=                                 OR'
      
        '1102492170=                                 (:G_PRODUCT_ IS NULL' +
        ')'
      '1102492171=                               )'
      '1102492172=                           --AND GP.G_PRODUCT = 2874'
      '1102492173=                               )'
      
        '1102492174=    SELECT (SELECT NAME FROM G_PRODUCT GG WHERE GG.G_' +
        'PRODUCT = A.G_PRODUCT_PAR)||'#39' / '#39'||A.NAME,'
      '1102492175=           A.BARCODE,'
      '1102492176=           A.ARTICUL,'
      '1102492177=           COALESCE(A.AMOUNT, 0) * A.PRICE,'
      '1102492178=           A.G_PRODUCT_PAR,'
      '1102492179=           COALESCE(A.AMOUNT, 0) AMOUNT'
      
        '1102492180=           ,COALESCE(CAST(A.AMOUNT AS NUMERIC), 0) * ' +
        'COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1102492181=                                                     ' +
        '         -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058 +
        #1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1102492182=                                                     ' +
        '         -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 '#1047#1040#1050#1059#1055#1054#1050
      
        '1102492183=                                                     ' +
        '         -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '1102492184=                                                     ' +
        '         -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 200 '#1047#1040#1050#1059#1055#1054#1050
      
        '1102492185=                                                     ' +
        '         DECODE(:FORMULA_,'
      
        '1102492186=                                                     ' +
        '                1,'
      
        '1102492187=                                                     ' +
        '                (SELECT S.price'
      
        '1102492188=                                                     ' +
        '                   FROM SKLAD S'
      
        '1102492189=                                                     ' +
        '                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHK' +
        'A||'#39'-'#39
      
        '1102492190=                                                     ' +
        '                    AND S.g_product = A.G_PRODUCT'
      
        '1102492191=                                                     ' +
        '                    AND S.IS_VOZVRAT IN (0, 3, 4)'
      
        '1102492192=                                                     ' +
        '                    AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      
        '1102492193=                                                     ' +
        '                                            FROM SKLAD DD'
      
        '1102492194=                                                     ' +
        '                                           WHERE DD.DATE_RECEIPT' +
        ' <= :DATE_'
      
        '1102492195=                                                     ' +
        '                                             AND DD.g_product = ' +
        'A.G_PRODUCT'
      
        '1102492196=                                                     ' +
        '                                             AND :G_TOCHKA_ARR_ ' +
        'CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1102492197=                                                     ' +
        '                                             AND DD.IS_VOZVRAT I' +
        'N (0, 3, 4)'
      
        '1102492198=                                                     ' +
        '                                           )'
      
        '1102492199=                                                     ' +
        '                   ORDER BY 1 DESC'
      
        '1102492200=                                                     ' +
        '                   ROWS 1 TO 1'
      
        '1102492201=                                                     ' +
        '                ),'
      
        '1102492202=                                                     ' +
        '                (SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOU' +
        'NT), 2)'
      
        '1102492203=                                                     ' +
        '                   FROM (SELECT S.AMOUNT, S.PRICE'
      
        '1102492204=                                                     ' +
        '                           FROM SKLAD_PARENT SP,'
      
        '1102492205=                                                     ' +
        '                                SKLAD S'
      
        '1102492206=                                                     ' +
        '                          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S' +
        'P.G_TOCHKA||'#39'-'#39
      
        '1102492207=                                                     ' +
        '                            AND SP.DATE_RECEIPT <= :DATE_'
      
        '1102492208=                                                     ' +
        '                            AND SP.SKLAD = S.SKLAD_PARENT'
      
        '1102492209=                                                     ' +
        '                            AND S.G_PRODUCT = A.G_PRODUCT'
      
        '1102492210=                                                     ' +
        '                            AND SP.IS_VOZVRAT IN (0, 3, 4)'
      
        '1102492211=                                                     ' +
        '                           ORDER BY S.DATE_RECEIPT DESC, S.SKLAD' +
        ' DESC ROWS 1 TO 5) T)'
      
        '1102492212=                                                     ' +
        '                ))'
      
        '1102492213=                                                     ' +
        '         , 0'
      
        '1102492214=                                                     ' +
        '         )'
      '1102492215=      FROM OSTATOK_ARR A'
      '1102492216=    ORDER BY NAME, G_PRODUCT_PAR'
      '1102492217=    INTO :NAME,'
      '1102492218=         :BARCODE,'
      '1102492219=         :ARTICUL,'
      '1102492220=         :PRICE,'
      '1102492221=         :G_PRODUCT_PAR,'
      '1102492222=         :AMOUNT,'
      '1102492223=         :SUMM'
      '1102492224=  DO'
      '1102492225=    SUSPEND;'
      '1102492226='
      '1102492227=WHEN ANY DO BEGIN'
      '1102492228=    Err_code = -20500;'
      
        '1102492229=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102492230=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102492231=  END'
      '1102492232=end'
      '1102492233=;'
      '1102492234='
      '1102492235=ALTER PROCEDURE R_EDIT_REVISION('
      
        '1102492236=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      '1102492237=  AMOUNT_REAL_ TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '1102492238=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102492239=  DATETIME_ TYPE OF COLUMN REVISION.DATETIME_CREATED,'
      '1102492240=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102492241=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE = '#39#39','
      '1102492242=  PREFIX_ VARCHAR(2) = '#39#39')'
      '1102492243=RETURNS ('
      '1102492244=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '1102492245=  ERR_CODE INTEGER,'
      '1102492246=  ERR_MSG VARCHAR(1024))'
      '1102492247=AS'
      
        '1102492248=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'R_EDIT_REVIS' +
        'ION'#39';'
      '1102492249=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102492250=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT;'
      '1102492251=DECLARE VARIABLE I INTEGER = 1;'
      
        '1102492252=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1102492253=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRIC' +
        'E;'
      
        '1102492254=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODU' +
        'CT.VOLUME_PRICE;'
      
        '1102492255=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102492256=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1102492257=DECLARE VARIABLE IS_MARKED_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_MARKED;'
      
        '1102492258=DECLARE VARIABLE IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.' +
        'IS_WEIGHT;'
      
        '1102492259=DECLARE VARIABLE VES_GRAMM_PRICE_ TYPE OF COLUMN G_PR' +
        'ODUCT.VES_GRAMM_PRICE;'
      '1102492260=BEGIN'
      '1102492261=  PNT_ = '#39'00'#39';'
      '1102492262=  IF (BARCODE_ <> '#39#39') THEN BEGIN'
      
        '1102492263=    EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BAR' +
        'CODE_, '#39#39'/*:ARTICUL_*/, '#39#39'/*:NOMER_*/, '#39#39'/*:NAME_*/, :PREFIX_)'
      
        '1102492264=        RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATE' +
        'GORY_, :PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :IS_MARKED_,'
      
        '1102492265=        :IS_WEIGHT_, :VES_GRAMM_PRICE_, :ERR_CODE, :E' +
        'RR_MSG;'
      '1102492266='
      
        '1102492267=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) T' +
        'HEN'
      '1102492268=      AMOUNT_REAL_ = AMOUNT_;'
      '1102492269='
      '1102492270=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102492271=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102492272='
      '1102492273=      EXIT;'
      '1102492274=    END'
      '1102492275=  END'
      '1102492276='
      
        '1102492277=  -- '#1045#1057#1051#1048' '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1042#1040#1053#1040' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071 +
        #1070' 1 ('#1045#1057#1051#1048' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045')'
      '1102492278=  -- '#1045#1057#1051#1048' '#1053#1045' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1064#1045#1044#1064#1045#1045' '#1050#1054#1051'-'#1042#1054
      '1102492279=  PNT_ = '#39'01'#39';'
      '1102492280=  UPDATE REVISION R'
      
        '1102492281=     SET R.AMOUNT_REAL = DECODE(:BARCODE_, '#39#39', :AMOUN' +
        'T_REAL_, (CASE WHEN SUBSTRING(:BARCODE_ FROM 1 FOR 2) = :PREFIX_' +
        ' THEN R.AMOUNT_REAL + :AMOUNT_REAL_ ELSE R.AMOUNT_REAL + 1 END))'
      '1102492282=   WHERE R.G_PRODUCT = :G_PRODUCT_'
      '1102492283=     AND R.REVISION_PARENT = :REVISION_PARENT_'
      '1102492284=  RETURNING'
      '1102492285=    REVISION'
      '1102492286=  INTO'
      '1102492287=    :REVISION_;'
      '1102492288='
      '1102492289=  PNT_ = '#39'02'#39';'
      '1102492290=  IF (ROW_COUNT = 0) THEN BEGIN'
      '1102492291=      SELECT LT.AMOUNT + LT.AMOUNT_RESERVE'
      '1102492292=        FROM LT_SKLAD_PRODUCT LT'
      '1102492293=       WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1102492294=         AND LT.G_TOCHKA = :G_TOCHKA_'
      '1102492295=        INTO :AMOUNT_BD_;'
      '1102492296='
      '1102492297=      AMOUNT_BD_ = COALESCE(AMOUNT_BD_, 0);'
      '1102492298='
      '1102492299=      PNT_ = '#39'03'#39';'
      
        '1102492300=      INSERT INTO REVISION (REVISION, REVISION_PARENT' +
        ', G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '1102492301=      VALUES (GEN_ID(GEN_REVISION, 1), :REVISION_PARE' +
        'NT_, :G_PRODUCT_, :AMOUNT_BD_, :AMOUNT_REAL_, :DATETIME_)'
      '1102492302=      RETURNING'
      '1102492303=        REVISION'
      '1102492304=      INTO'
      '1102492305=        :REVISION_;'
      '1102492306=  END'
      '1102492307='
      '1102492308=WHEN ANY DO BEGIN'
      '1102492309=    ERR_CODE = -20500;'
      
        '1102492310=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1042 +
        #1057#1058#1040#1042#1050#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102492311=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102492312=  END'
      '1102492313=END'
      '1102492314=;'
      '1102492315='
      '1102492316=ALTER PROCEDURE R_FILL_REVISION('
      
        '1102492317=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      '1102492318=  G_PRODUCT_PAR_ BLOB SUB_TYPE 1,'
      '1102492319=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102492320=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102492321=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102492322=  TYPE_ INTEGER)'
      '1102492323=RETURNS ('
      '1102492324=  ERR_CODE INTEGER,'
      '1102492325=  ERR_MSG VARCHAR(1024))'
      '1102492326=AS'
      
        '1102492327=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT;'
      
        '1102492328=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.G_PRODUCT;'
      '1102492329=BEGIN'
      '1102492330='
      '1102492331=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102492332=    SELECT ID'
      '1102492333=      FROM CUR_PARAMS'
      '1102492334=     WHERE CUR_PARAMS = 2'
      '1102492335=      INTO :G_TOCHKA_;'
      '1102492336='
      '1102492337=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1041#1044
      '1102492338=  IF (COALESCE(SKLAD_, 0) = 0) THEN BEGIN'
      '1102492339=      FOR SELECT G.G_PRODUCT,'
      '1102492340=                 COALESCE(LT.AMOUNT, 0)'
      
        '1102492341=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, (AMOUNT + AMOUNT_RESERVE) AMOUNT'
      
        '1102492342=                                                FROM ' +
        'LT_SKLAD_PRODUCT'
      
        '1102492343=                                               WHERE ' +
        'G_TOCHKA = :G_TOCHKA_) LT ON G.g_product = LT.g_product'
      '1102492344=           WHERE G.IS_ACTIVE = 1'
      '1102492345=             AND G.IS_KIT <> 1'
      
        '1102492346=             AND ((:G_PRODUCT_PAR_ CONTAINING '#39'~'#39'||G.' +
        'G_PRODUCT_PAR||'#39'~'#39' AND :G_PRODUCT_PAR_ IS NOT NULL)'
      '1102492347=                  OR'
      '1102492348=                  (:G_PRODUCT_PAR_ IS NULL)'
      '1102492349=                 )'
      
        '1102492350=             AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||G.G_PR' +
        'ODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102492351=                  OR'
      '1102492352=                  (:G_PRODUCT_ IS NULL)'
      '1102492353=                 )'
      '1102492354=             AND G.IS_CATEGORY = 0'
      
        '1102492355=             AND NOT EXISTS (SELECT 1 FROM REVISION R' +
        'R WHERE RR.G_PRODUCT = G.G_PRODUCT'
      
        '1102492356=                             AND RR.REVISION_PARENT =' +
        ' :REVISION_PARENT_)'
      
        '1102492357=             --AND NOT EXISTS (SELECT 1 FROM REVISION' +
        '_TMP WHERE G_PRODUCT = G.G_PRODUCT)'
      '1102492358=          /*UNION ALL'
      '1102492359=          SELECT G.G_PRODUCT,'
      '1102492360=                 COALESCE(LT.AMOUNT, 0)'
      '1102492361=            FROM G_PRODUCT G,'
      '1102492362=                 LT_SKLAD_PRODUCT LT'
      '1102492363=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      
        '1102492364=             AND G.G_PRODUCT_PAR IN (SELECT GG.G_PROD' +
        'UCT'
      
        '1102492365=                                      FROM G_PRODUCT ' +
        'GG'
      
        '1102492366=                                     WHERE :G_PRODUCT' +
        '_PAR_ CONTAINING '#39'~'#39'||GG.G_PRODUCT_PAR||'#39'~'#39
      
        '1102492367=                                       AND GG.IS_CATE' +
        'GORY = 1'
      
        '1102492368=                                       and gg.G_PRODU' +
        'CT_PAR is not null)'
      '1102492369=             AND G.IS_CATEGORY = 0'
      '1102492370=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) > 0'
      '1102492371=             AND LT.G_TOCHKA = :G_TOCHKA_'
      '1102492372=          UNION ALL'
      '1102492373=          SELECT G.G_PRODUCT,'
      '1102492374=                 COALESCE(LT.AMOUNT, 0)'
      '1102492375=            FROM G_PRODUCT G,'
      '1102492376=                 LT_SKLAD_PRODUCT LT'
      '1102492377=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      '1102492378=             AND G.IS_CATEGORY = 0'
      '1102492379=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0'
      '1102492380=             AND LT.G_TOCHKA = :G_TOCHKA_'
      
        '1102492381=          /*UNION ALL              '#1061#1059#1049' '#1047#1053#1040#1045#1058' '#1047#1040#1063#1045#1052' '#1041#1067 +
        #1051#1054' '#1053#1059#1046#1053#1054'  11.02.2016'
      '1102492382=          SELECT G.G_PRODUCT,'
      '1102492383=                 COALESCE(LT.AMOUNT, 0)'
      
        '1102492384=            FROM G_PRODUCT G LEFT OUTER JOIN LT_SKLAD' +
        '_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT'
      
        '1102492385=           WHERE G.G_PRODUCT_PAR IN (SELECT GG.G_PROD' +
        'UCT'
      
        '1102492386=                                      FROM G_PRODUCT ' +
        'GG'
      
        '1102492387=                                     WHERE GG.IS_CATE' +
        'GORY = 1'
      
        '1102492388=                                       and gg.G_PRODU' +
        'CT_PAR is not null)'
      '1102492389=             AND G.IS_CATEGORY = 0'
      '1102492390=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0 */'
      '1102492391=          ORDER BY 1'
      '1102492392=          INTO :G_PRODUCT__,'
      '1102492393=               :AMOUNT_BD_'
      '1102492394=      DO BEGIN'
      '1102492395='
      
        '1102492396=        --INSERT INTO REVISION (REVISION, SKLAD, G_PR' +
        'ODUCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1102492397=        --VALUES (GEN_ID(GEN_REVISION, 1), NULL, :G_P' +
        'RODUCT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      
        '1102492398=        INSERT INTO REVISION (REVISION, REVISION_PARE' +
        'NT, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '1102492399=        VALUES (GEN_ID(GEN_REVISION, 1), :REVISION_PA' +
        'RENT_, :G_PRODUCT__, :AMOUNT_BD_, 0, CURRENT_TIME);'
      '1102492400='
      '1102492401=        --I = I + 1;'
      '1102492402=      END'
      '1102492403='
      '1102492404=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102492405=  END ELSE BEGIN'
      '1102492406=      FOR SELECT SS.G_PRODUCT,'
      '1102492407=                 SS.AMOUNT'
      '1102492408=            FROM SKLAD_PARENT S, SKLAD SS'
      '1102492409=           WHERE S.SKLAD = :SKLAD_'
      '1102492410=             AND S.SKLAD = SS.SKLAD_PARENT'
      
        '1102492411=             AND S.G_TOCHKA = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 2)'
      '1102492412=          ORDER BY 1'
      '1102492413=          INTO :G_PRODUCT__,'
      '1102492414=               :AMOUNT_BD_'
      '1102492415=      DO BEGIN'
      '1102492416='
      
        '1102492417=        INSERT INTO REVISION (REVISION, REVISION_PARE' +
        'NT, SKLAD, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCH' +
        'KA)'
      
        '1102492418=        VALUES (GEN_ID(GEN_REVISION, 1), :REVISION_PA' +
        'RENT_, NULL, :G_PRODUCT__, :AMOUNT_BD_, 0, 0, :G_TOCHKA_);'
      '1102492419='
      '1102492420=        --I = I + 1;'
      '1102492421=      END'
      '1102492422=  END'
      '1102492423=END'
      '1102492424=;'
      '1102492425='
      '1102492426=ALTER PROCEDURE R_IMPORT_REVISION('
      
        '1102492427=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      '1102492428=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102492429=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102492430=  AMOUNT_ TYPE OF COLUMN REVISION.AMOUNT_REAL)'
      '1102492431=RETURNS ('
      '1102492432=  ERR_CODE INTEGER,'
      '1102492433=  ERR_MSG VARCHAR(1024))'
      '1102492434=AS'
      
        '1102492435=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.G_PRODUCT = NULL;'
      
        '1102492436=DECLARE VARIABLE ID_ TYPE OF COLUMN REVISION.REVISION' +
        ';'
      '1102492437=DECLARE VARIABLE POS_ INTEGER;'
      '1102492438=DECLARE VARIABLE POS2_ INTEGER;'
      '1102492439=DECLARE VARIABLE POS3_ INTEGER;'
      '1102492440=DECLARE VARIABLE STRR VARCHAR(100);'
      '1102492441=BEGIN'
      '1102492442=  SELECT G_PRODUCT'
      '1102492443=    FROM G_PRODUCT G'
      '1102492444=   WHERE G.BARCODE = :BARCODE_'
      '1102492445=     AND G.IS_ACTIVE = 1'
      '1102492446=    INTO :G_PRODUCT_;'
      '1102492447='
      '1102492448=  IF (G_PRODUCT_ IS NOT NULL) THEN BEGIN'
      '1102492449=      UPDATE REVISION R'
      '1102492450=         SET R.AMOUNT_REAL = :AMOUNT_'
      '1102492451=       WHERE R.G_PRODUCT = :G_PRODUCT_'
      '1102492452=         AND R.REVISION_PARENT = :REVISION_PARENT_'
      '1102492453=         AND R.G_TOCHKA = :G_TOCHKA_;'
      '1102492454='
      '1102492455=      IF (ROW_COUNT = 0) THEN BEGIN'
      
        '1102492456=        INSERT INTO REVISION (REVISION, REVISION_PARE' +
        'NT, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1102492457=        VALUES ((SELECT COALESCE(MAX(REVISION), 0) + ' +
        '1 FROM REVISION),'
      '1102492458=                :REVISION_PARENT_,'
      '1102492459=                :G_PRODUCT_,'
      '1102492460=                COALESCE((SELECT AMOUNT'
      '1102492461=                            FROM LT_SKLAD_PRODUCT'
      
        '1102492462=                           WHERE G_TOCHKA = :G_TOCHKA' +
        '_ AND G_PRODUCT = :G_PRODUCT_), 0),'
      '1102492463=                :AMOUNT_,'
      '1102492464=                0,'
      '1102492465=                :G_TOCHKA_);'
      '1102492466=      END'
      '1102492467=  END ELSE BEGIN'
      '1102492468=    ERR_CODE = 0;'
      
        '1102492469=    ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077 +
        ' '#1085#1072#1081#1076#1077#1085'.'#39';'
      '1102492470=  END'
      '1102492471='
      '1102492472=WHEN ANY DO BEGIN'
      '1102492473=    IF (gdscode = 335544652) THEN BEGIN'
      '1102492474=      ERR_CODE = 0;'
      
        '1102492475=      ERR_MSG = '#39#1053#1072#1081#1076#1077#1085#1086' '#1085#1077#1089#1082#1086#1083#1100#1082#1086' '#1090#1086#1074#1072#1088#1086#1074' '#1089' '#1090#1072#1082#1080#1084' '#1096#1090 +
        #1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_;'
      '1102492476=    END ELSE BEGIN'
      '1102492477=      ERR_CODE = 0;'
      
        '1102492478=      ERR_MSG = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1096#1090#1088#1080#1093#1082#1086#1076#1072' '#39'||BAR' +
        'CODE_||'#39'. '#1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||gdscode;'
      '1102492479=    END'
      '1102492480=  END'
      '1102492481=END'
      '1102492482=;'
      '1102492483='
      '1102492484=ALTER PROCEDURE REVISION_PARENT_DEL('
      
        '1102492485=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      '1102492486=  REVISION_ TYPE OF COLUMN REVISION.REVISION)'
      '1102492487=AS'
      '1102492488=BEGIN'
      '1102492489=  IF (REVISION_PARENT_ <> 0) THEN BEGIN'
      '1102492490=      DELETE FROM REVISION R'
      '1102492491=      WHERE R.REVISION_PARENT = :REVISION_PARENT_;'
      '1102492492='
      '1102492493=      DELETE FROM REVISION_PARENT'
      '1102492494=      WHERE (REVISION_PARENT = :REVISION_PARENT_);'
      '1102492495=  END'
      '1102492496=  ELSE BEGIN'
      '1102492497=    --IF (REVISION_ <> 0) THEN'
      
        '1102492498=       DELETE FROM REVISION WHERE REVISION = :REVISIO' +
        'N_;--DELETE FROM REVISION_TMP WHERE REVISION = :REVISION_;'
      '1102492499=    --ELSE'
      '1102492500=    --   DELETE FROM REVISION_TMP;'
      '1102492501=  END'
      '1102492502=END'
      '1102492503=;'
      '1102492504='
      '1102492505=ALTER PROCEDURE REVISION_PARENT_GET('
      
        '1102492506=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102492507=RETURNS ('
      
        '1102492508=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102492509=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102492510=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102492511=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102492512=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102492513=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '1102492514=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE,'
      '1102492515=  SPIS_SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102492516=  SPIS_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102492517=  PRIHOD_SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102492518=  PRIHOD_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT)'
      '1102492519=AS'
      '1102492520=BEGIN'
      
        '1102492521=  SELECT DATE_BEGIN, TIME_BEGIN, DATE_END, TIME_END, ' +
        'NOTE, G_TOCHKA, IS_MADE,'
      
        '1102492522=         COALESCE((SELECT SUM(AMOUNT) FROM ZAKAZ_DETA' +
        'ILS WHERE ZAKAZ = T.ZAKAZ), 0),'
      
        '1102492523=         COALESCE((SELECT SUMM FROM ZAKAZ WHERE ZAKAZ' +
        ' = T.ZAKAZ), 0),'
      
        '1102492524=         COALESCE((SELECT SUM(AMOUNT) FROM SKLAD WHER' +
        'E SKLAD_PARENT = T.SKLAD_PARENT), 0),'
      
        '1102492525=         COALESCE((SELECT S.SUMM FROM SKLAD_PARENT S ' +
        'WHERE S.SKLAD = T.SKLAD_PARENT), 0)'
      '1102492526=  FROM REVISION_PARENT T'
      '1102492527=  WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102492528=  INTO :DATE_BEGIN_, :TIME_BEGIN_, :DATE_END_, :TIME_' +
        'END_, :NOTE_, :G_TOCHKA_, :IS_MADE_, :SPIS_AMOUNT_, :SPIS_SUMM_,'
      '1102492529=       :PRIHOD_AMOUNT_, :PRIHOD_SUMM_;'
      '1102492530='
      
        '1102492531=  /*INSERT INTO REVISION_TMP (REVISION, G_PRODUCT, AM' +
        'OUNT_BD, AMOUNT_REAL, REVISION_PARENT, DATETIME_CREATED)'
      
        '1102492532=  SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL,' +
        ' REVISION_PARENT, DATETIME_CREATED'
      '1102492533=  FROM REVISION'
      '1102492534=  WHERE REVISION_PARENT = :REVISION_PARENT_;*/'
      '1102492535=END'
      '1102492536=;'
      '1102492537='
      '1102492538=ALTER PROCEDURE REVISION_PARENT_INS('
      
        '1102492539=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102492540=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102492541=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102492542=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102492543=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102492544=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '1102492545=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE)'
      '1102492546=RETURNS ('
      
        '1102492547=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      '1102492548=  ERR_CODE INTEGER,'
      '1102492549=  ERR_MSG VARCHAR(1024))'
      '1102492550=AS'
      '1102492551=BEGIN'
      '1102492552=  INSERT INTO REVISION_PARENT ('
      '1102492553=    REVISION_PARENT,'
      '1102492554=    DATE_BEGIN,'
      '1102492555=    TIME_BEGIN,'
      '1102492556=    DATE_END,'
      '1102492557=    TIME_END,'
      '1102492558=    NOTE,'
      '1102492559=    G_TOCHKA,'
      '1102492560=    IS_MADE)'
      '1102492561=  VALUES ('
      '1102492562=    GEN_ID(GEN_REVISION_PARENT, 1),'
      '1102492563=    :DATE_BEGIN_,'
      '1102492564=    :TIME_BEGIN_,'
      '1102492565=    :DATE_END_,'
      '1102492566=    :TIME_END_,'
      '1102492567=    :NOTE_,'
      '1102492568=    :G_TOCHKA_,'
      '1102492569=    :IS_MADE_)'
      '1102492570=  RETURNING REVISION_PARENT'
      '1102492571=  INTO :REVISION_PARENT_;'
      '1102492572='
      '1102492573=  /*'
      
        '1102492574=  04.01.2022 '#1055#1045#1056#1045#1064#1045#1051' '#1053#1040' '#1055#1054#1057#1058#1054#1071#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059', '#1051#1070#1044#1071#1052' '#1053#1045#1059 +
        #1044#1054#1041#1053#1054', '#1053#1045' '#1052#1054#1043#1059#1058' '#1044#1045#1051#1040#1058#1068' '#1056#1045#1042#1048#1047#1048#1070' '#1057' '#1044#1042#1059#1061' '#1050#1054#1052#1055#1068#1070#1058#1045#1056#1054#1042
      
        '1102492575=  INSERT INTO REVISION (REVISION, G_PRODUCT, AMOUNT_B' +
        'D, AMOUNT_REAL, REVISION_PARENT, DATETIME_CREATED)'
      
        '1102492576=  SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_REAL,' +
        ' :REVISION_PARENT_, DATETIME_CREATED'
      '1102492577=  FROM REVISION_TMP;'
      '1102492578='
      '1102492579=  DELETE FROM REVISION_TMP;*/'
      '1102492580=END'
      '1102492581=;'
      '1102492582='
      '1102492583=ALTER PROCEDURE REVISION_PARENT_UPD('
      
        '1102492584=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT,'
      
        '1102492585=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102492586=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
