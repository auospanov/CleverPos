      '1102281589=            AMOUNT_PRIHOD_SKL_ = 0;'
      '1102281590=            SUMM_PRIHOD_SKL_   = 0;'
      '1102281591=            AMOUNT_UHOD_SKL_   = 0;'
      '1102281592=            SUMM_UHOD_SKL_     = 0;'
      '1102281593=        END'
      '1102281594='
      '1102281595=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102281596=        INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      '1102281597=          (P_REP_TOVAR_MOVE_TABLE, NAME, IS_HEAD)'
      '1102281598=        VALUES'
      
        '1102281599=          (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), :PA' +
        'TH_, 1);'
      '1102281600=      END'
      '1102281601='
      '1102281602=      INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1102281603=        (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, NAME, AMO' +
        'UNT_IN, AMOUNT_PRIHOD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOU' +
        'NT_SPISANO, SUMM_SPISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '1102281604=        AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UH' +
        'OD_SKL, SUMM_UHOD_SKL,  AMOUNT_OUT, LAST_SUPPLIER, IS_HEAD)'
      '1102281605=      VALUES'
      
        '1102281606=        (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), :REC_' +
        'G_PRODUCT_, :GNAME_, :REC_AMOUNT_IN_, :REC_AMOUNT_PRIHOD_, :REC_' +
        'SUMM_PRIHOD_, :REC_AMOUNT_UHOD_, :REC_SUMM_UHOD_, :REC_AMOUNT_SP' +
        'ISANO_, :REC_SUMM_SPISANO_, :REC_AMOUNT_VOZVRAT_, :REC_SUMM_VOZV' +
        'RAT_,'
      
