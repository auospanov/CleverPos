      '1106015728=    :G_OFFICIAL_RUKOVOD_,'
      '1106015729=    :GLAVBUH_,'
      '1106015730=    :note_,'
      '1106015731=    :param1_,'
      '1106015732=    :param2_,'
      '1106015733=    :param3_,'
      '1106015734=    :param4_,'
      '1106015735=    :param5_,'
      '1106015736=    :param6_,'
      '1106015737=    :DOC_TYPE_,'
      '1106015738=    :ZAKAZ_)'
      '1106015739=  returning'
      '1106015740=    docs'
      '1106015741=  into'
      '1106015742=    :docs_;'
