      '1101462081=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1101462082=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1101462083=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101462084=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_)'
      '1101462085=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101462086=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101462087='
      
        '1101462088=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101462089=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101462090=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
