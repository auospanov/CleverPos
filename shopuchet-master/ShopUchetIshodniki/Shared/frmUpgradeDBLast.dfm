      '110606350=ALTER PROCEDURE G_GET_G_BANK('
      '110606351=  G_BANK_ TYPE OF COLUMN G_BANK.G_BANK)'
      '110606352=RETURNS ('
      '110606353=  BIK_ TYPE OF COLUMN G_BANK.BIK,'
      '110606354=  NAME_ TYPE OF COLUMN G_BANK.NAME,'
      '110606355=  SHORT_NAME_ TYPE OF COLUMN G_BANK.SHORT_NAME,'
