      '110752607=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110752608=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110752609=                END'
      '110752610='
      
        '110752611=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059 +
        ' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054 +
        ' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '110752612=                IF ((Z_DATE_ > DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0)) THEN BEGIN'
      '110752613=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110752614=                      FROM SKLAD SK'
