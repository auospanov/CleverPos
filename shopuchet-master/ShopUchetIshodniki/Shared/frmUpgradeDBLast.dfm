        ' THEN BEGIN'
      '1102112148=                KASSA_ZP_ID_ = NULL;'
      '1102112149='
      '1102112150=                SELECT S.S_VALUE'
      '1102112151=                  FROM SYSTEM_SETUP S'
      '1102112152=                 WHERE S.SYSTEM_SETUP = 4'
      '1102112153=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102112154='
      '1102112155=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102112156=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102112157=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102112158='
      
        '1102112159=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
