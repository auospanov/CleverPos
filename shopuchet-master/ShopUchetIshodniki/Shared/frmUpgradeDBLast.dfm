      '1102011990=*/'
      '1102011991=BEGIN'
      '1102011992='
      '1102011993=  IF (MODE_ = 0) THEN BEGIN'
      '1102011994=      SELECT COUNT(*)'
      '1102011995=        FROM G_OFFICIAL G'
      '1102011996=       WHERE G.G_OFFICIAL > 0'
      '1102011997=         AND G.IS_ACTIVE = 1'
      '1102011998=        INTO :PARAM1_OUT_;'
      '1102011999='
      '1102012000=      if (PARAM1_OUT_ = 1) then'
      '1102012001=        SELECT G.PASS'
      '1102012002=          FROM G_OFFICIAL G'
      '1102012003=          INTO :PARAM1_STR_OUT_;'
      '1102012004='
      '1102012005=  END ELSE BEGIN'
      '1102012006=    SELECT COUNT(*)'
      '1102012007=      FROM G_TOCHKA G'
      '1102012008=      INTO :PARAM1_OUT_;'
      '1102012009='
      '1102012010=    IF (PARAM1_OUT_ > 1) THEN BEGIN'
      '1102012011=      SELECT G.G_TOCHKA'
      '1102012012=        FROM G_OFFICIAL G'
      
        '1102012013=       WHERE G.G_OFFICIAL = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 1)'
      '1102012014=        INTO :PARAM2_OUT_;'
      '1102012015='
      '1102012016=      if (COALESCE(PARAM2_OUT_, 0)  = 0) then'
      '1102012017=        PARAM2_OUT_ = 1;'
      '1102012018=    END'
      '1102012019=  END'
      '1102012020=END'
      '1102012021=;'
      '1102012022='
