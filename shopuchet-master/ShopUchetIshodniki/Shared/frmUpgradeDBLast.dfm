      '1102112162='
      '1102112163=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102112164=                ELSE'
      
        '1102112165=                   ACTION_DATE_ZP_ = Current_date - E' +
