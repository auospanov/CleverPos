        '_TO_EXT_APP_'
      
        '1102491083=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102491084=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102491085=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102491086=                  EXIT;'
      '1102491087=                END'
      '1102491088=            END'
      '1102491089='
      '1102491090=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1102491091=        END ELSE BEGIN'
      '1102491092=            PNT_ = '#39'06'#39';'
      
        '1102491093=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1102491094=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
