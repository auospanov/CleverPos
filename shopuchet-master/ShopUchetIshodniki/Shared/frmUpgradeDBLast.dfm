      '1102122048=        SELECT 14 COL,'
      '1102122049=               '#39#39' STR,'
      '1102122050=               '#39#39' AMOUNT,'
      '1102122051=               '#39#39' SUMM'
      '1102122052=          FROM RDB$DATABASE'
