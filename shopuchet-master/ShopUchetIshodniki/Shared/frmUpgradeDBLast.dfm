      '110237207=            SELECT ID'
      '110237208=              FROM CUR_PARAMS'
      '110237209=             WHERE CUR_PARAMS = 2'
      '110237210=              INTO :G_TOCHKA_;'
      '110237211='
      
        '110237212=            SQL_STR_ = SQL_STR_ ||'#39'P.VES_GRAMM_PRICE =' +
        ' ROUND((SELECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOC' +
        'HKA_||'#39', 0)) / P.VES_GRAMM * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:RO' +
        'UND_||'#39'),'#39'||'
      
        '110237213=                       '#39' P.PRICE = ROUND((SELECT * FRO' +
