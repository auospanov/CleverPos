        '110241793=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AMO' +
        'UNT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UHO' +
        'D_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVRA' +
        'T_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIHO' +
        'D_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '110241794='
      
        '110241795=    STR_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_' +
        '), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '110241796=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||' +
        #39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXT' +
        'RACT(YEAR FROM DATE_END_);'
      '110241797='
      '110241798=  FOR'
      '110241799=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '110241800=           DECODE(T.IS_HEAD,'
      '110241801=                  0, T.NAME,'
      '110241802=                  1, T.NAME,'
      '110241803=                  2, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39','
      '110241804=                  3, '#39#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39#39'),'
      '110241805=           G.ARTICUL,'
      '110241806=           G.BARCODE,'
      '110241807=           T.AMOUNT_IN,'
      '110241808=           T.AMOUNT_PRIHOD,'
      '110241809=           T.SUMM_PRIHOD,'
      '110241810=           T.AMOUNT_UHOD,'
      '110241811=           T.SUMM_UHOD,'
      '110241812=           T.AMOUNT_SPISANO,'
      '110241813=           T.SUMM_SPISANO,'
      '110241814=           T.AMOUNT_VOZVRAT,'
      '110241815=           T.SUMM_VOZVRAT,'
      '110241816=           T.AMOUNT_PRIHOD_SKL,'
      '110241817=           T.SUMM_PRIHOD_SKL,'
      '110241818=           T.AMOUNT_UHOD_SKL,'
      '110241819=           T.SUMM_UHOD_SKL,'
      '110241820=           T.AMOUNT_OUT,'
      '110241821=           T.IS_HEAD'
      
        '110241822=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G_' +
        'PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '110241823=     ORDER BY 1'
      '110241824=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '110241825=       :NAME,'
      '110241826=       :ARTICUL,'
      '110241827=       :BARCODE,'
      '110241828=       :AMOUNT_IN,'
      '110241829=       :AMOUNT_PRIHOD,'
      '110241830=       :SUMM_PRIHOD,'
      '110241831=       :AMOUNT_UHOD,'
      '110241832=       :SUMM_UHOD,'
      '110241833=       :AMOUNT_SPISANO,'
      '110241834=       :SUMM_SPISANO,'
      '110241835=       :AMOUNT_VOZVRAT,'
      '110241836=       :SUMM_VOZVRAT,'
      '110241837=       :AMOUNT_PRIHOD_SKL,'
      '110241838=       :SUMM_PRIHOD_SKL,'
      '110241839=       :AMOUNT_UHOD_SKL,'
      '110241840=       :SUMM_UHOD_SKL,'
      '110241841=       :AMOUNT_OUT,'
      '110241842=       :IS_HEAD'
      '110241843=  DO SUSPEND;'
      '110241844='
      '110241845=WHEN ANY DO BEGIN'
      '110241846=    Err_code = -20500;'
      
        '110241847=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110241848=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110241849=  END'
      '110241850=end'
      '110241851='#39';'
      '110241852=END  --END_EXECUTE_BLOCK'
      '110241853=EXECUTE BLOCK AS BEGIN'
      '110241854='
      '110241855=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_LIST('
      '110241856=  DATE_BEGIN_ DATE,'
      '110241857=  DATE_END_ DATE,'
      '110241858=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110241859=  IS_VOZVRAT_ INTEGER)'
      '110241860=RETURNS ('
      '110241861=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '110241862=  SKLAD_PARENT TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110241863=  DATE_RECEIPT TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '110241864=  G_PRODUCT TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110241865=  AMOUNT TYPE OF COLUMN SKLAD.AMOUNT,'
      '110241866=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '110241867=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110241868=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110241869=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110241870=  NDS TYPE OF COLUMN SKLAD.NDS,'
      '110241871=  NDS_SUMM TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110241872=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110241873=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110241874=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110241875=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110241876=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110241877=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '110241878=  IS_VOZVRAT TYPE OF COLUMN SKLAD.IS_VOZVRAT)'
      '110241879=AS'
      '110241880=BEGIN'
      '110241881='
      '110241882=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '110241883=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '110241884=      FOR SELECT T.sklad,'
      '110241885=               T.SKLAD_PARENT,'
      '110241886=               T.date_receipt,'
      '110241887=               T.g_product,'
      '110241888=               T.amount,'
      '110241889=               T.PRICE,'
      '110241890=               T.SUMM,'
      '110241891=               T.PRICE_CURRENCY,'
      '110241892=               T.SUMM_CURRENCY,'
      '110241893=               T.nds,'
      '110241894=               T.nds_summ,'
      '110241895=               P.NAME PRODUCT_NAME,'
      '110241896=               C.NAME CLIENT_NAME,'
      '110241897=               PT.NAME PAYMENT_NAME,'
      '110241898=               P.ARTICUL,'
      '110241899=               P.NOMENCLATUR_NUM,'
      '110241900=               P.BARCODE,'
      '110241901=               T.IS_VOZVRAT'
      '110241902=          FROM SKLAD T'
      
        '110241903=               LEFT OUTER JOIN G_CLIENT C ON T.G_CLIEN' +
        'T = C.G_CLIENT'
      
        '110241904=               LEFT OUTER JOIN G_PAYMENT_TYPE PT ON T.' +
        'G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '110241905=               G_PRODUCT P'
      
        '110241906=         WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110241907=           AND T.G_PRODUCT = P.G_PRODUCT'
      
        '110241908=           AND ((T.IS_VOZVRAT = 0 AND :IS_VOZVRAT_ IS ' +
        'NULL)'
      
        '110241909=                OR (T.IS_VOZVRAT IN (0, 5) AND :IS_VOZ' +
        'VRAT_ = 0)'
      
        '110241910=                OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZV' +
        'RAT_ IN (1,2))'
      '110241911=               )'
      '110241912=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '110241913=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND :' +
        'SKLAD_PARENT_ IS NOT NULL)'
      '110241914=                OR'
      
        '110241915=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '110241916=               )'
      '110241917=        ORDER BY T.DATE_RECEIPT DESC'
      '110241918=      INTO :sklad,'
      '110241919=        :SKLAD_PARENT,'
      '110241920=        :date_receipt,'
      '110241921=        :g_product,'
      '110241922=        :amount,'
      '110241923=        :PRICE,'
      '110241924=        :SUMM,'
      '110241925=        :PRICE_CURRENCY,'
      '110241926=        :SUMM_CURRENCY,'
      '110241927=        :nds,'
      '110241928=        :nds_summ,'
      '110241929=        :PRODUCT_NAME,'
      '110241930=        :CLIENT_NAME,'
      '110241931=        :PAYMENT_NAME,'
      '110241932=        :ARTICUL,'
      '110241933=        :NOMENCLATUR_NUM,'
      '110241934=        :BARCODE,'
      '110241935=        :IS_VOZVRAT'
      '110241936=      DO'
      '110241937=        suspend;'
      '110241938='
      '110241939=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040
      '110241940=  END ELSE BEGIN'
      '110241941=    FOR SELECT T.SKLAD_PARENT,'
      '110241942=               T.SKLAD,'
      '110241943=               TR.DATE_RECEIPT,'
      '110241944=               T.g_product,'
      '110241945=               T.amount,'
      '110241946=               T.PRICE,'
      '110241947=               T.SUMM,'
      '110241948=               P.NAME PRODUCT_NAME,'
      '110241949=               G.NAME CLIENT_NAME,'
      '110241950=               P.ARTICUL,'
      '110241951=               P.NOMENCLATUR_NUM,'
      '110241952=               P.BARCODE'
      
        '110241953=          FROM SKLAD_PARENT TR LEFT OUTER JOIN G_TOCHK' +
        'A G ON TR.G_CLIENT = G.G_TOCHKA,'
      '110241954=               SKLAD T,'
      '110241955=               G_PRODUCT P'
      
        '110241956=         WHERE TR.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '110241957=           AND TR.SKLAD = T.SKLAD_PARENT'
      '110241958=           AND T.G_PRODUCT = P.G_PRODUCT'
      '110241959=           AND T.IS_VOZVRAT = 3'
      '110241960=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '110241961=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND :' +
        'SKLAD_PARENT_ IS NOT NULL)'
      '110241962=                OR'
      
        '110241963=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '110241964=               )'
      '110241965=        ORDER BY TR.SKLAD DESC'
      '110241966=      INTO :sklad,'
      '110241967=        :SKLAD_PARENT,'
      '110241968=        :date_receipt,'
      '110241969=        :g_product,'
      '110241970=        :amount,'
      '110241971=        :PRICE,'
      '110241972=        :SUMM,'
      '110241973=        :PRODUCT_NAME,'
      '110241974=        :CLIENT_NAME,'
      '110241975=        :ARTICUL,'
      '110241976=        :NOMENCLATUR_NUM,'
      '110241977=        :BARCODE'
      '110241978=      DO'
      '110241979=        suspend;'
      '110241980=  END'
      '110241981=end'
      '110241982='#39';'
      '110241983='
      '110241984=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110241985=RETURNS ('
      '110241986=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110241987=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '110241988=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '110241989=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '110241990=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '110241991=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110241992=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110241993=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '110241994=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '110241995=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110241996=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110241997=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE)'
      '110241998=AS'
      '110241999=begin'
      '110242000=  FOR'
      
        '110242001=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.' +
        'SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.PRICE'
      '110242002=           ,PRICE_CURRENCY'
      '110242003=           ,SUMM_CURRENCY'
      '110242004=    FROM SKLAD_TMP T,'
      '110242005=         G_PRODUCT P'
      '110242006=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110242007=    ORDER BY T.sklad'
      
        '110242008=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :' +
        'NDS, :NDS_SUMM, :NAME, :BARCODE, :PRODUCT_PRICE'
      '110242009=      ,:PRICE_CURRENCY'
      '110242010=      ,:SUMM_CURRENCY'
      '110242011=  DO'
      '110242012=    suspend;'
      '110242013=end'
      '110242014='#39';'
      '110242015='
      '110242016=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD('
      '110242017=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110242018=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '110242019=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110242020=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110242021=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110242022=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110242023=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110242024=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110242025=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '110242026=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110242027=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110242028=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110242029=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0)'
      '110242030=RETURNS ('
      '110242031=  ERR_CODE INTEGER,'
      '110242032=  ERR_MSG VARCHAR(1024))'
      '110242033=AS'
      
        '110242034=declare variable PROCNAME varchar(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110242035=declare variable PNT_ varchar(5);'
      
        '110242036=declare variable KASSA_POP_ type of column KASSA.KASSA' +
        ';'
      '110242037=declare variable SKLAD_ type of column SKLAD.SKLAD;'
      
        '110242038=declare variable SKLAD_OLD_ type of column SKLAD.SKLAD' +
        ';'
      
        '110242039=declare variable G_PRODUCT_ type of column SKLAD.G_PRO' +
        'DUCT;'
      '110242040=declare variable AMOUNT_ type of column SKLAD.AMOUNT;'
      
        '110242041=declare variable AMOUNT_OLD_ type of column SKLAD.AMOU' +
        'NT;'
      
        '110242042=declare variable DATE_RECEIPT_OLD_ type of column SKLA' +
        'D.DATE_RECEIPT;'
      '110242043=declare variable PRICE_ type of column SKLAD.PRICE;'
      '110242044=declare variable SUMM_ONE_ type of column SKLAD.SUMM;'
      '110242045=declare variable NDS_ type of column SKLAD.PRICE;'
      '110242046=declare variable NDS_SUMM_ type of column SKLAD.SUMM;'
      
        '110242047=declare variable IS_VOZVRAT_ type of column SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110242048=declare variable G_PAYMENT_TYPE_OLD_ type of column SK' +
        'LAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110242049=declare variable G_PRIHOD_RASHOD_ type of column SKLAD' +
        '.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058 +
        ' */'
      
        '110242050=declare variable DATE_LAST_ type of column SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110242051=declare variable IS_THIS_LAST_ integer; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110242052=declare variable G_TOCHKA_ type of column G_TOCHKA.G_T' +
        'OCHKA;'
      '110242053=declare variable KASSA_ type of column KASSA.KASSA;'
      
        '110242054=declare variable PAYMENT_DATE_ type of column KASSA.AC' +
        'TION_DATE;'
      
        '110242055=declare variable PAYMENT_SUMM_ type of column KASSA.SU' +
        'MM;'
      
        '110242056=declare variable PAYMENT_TYPE_ type of column G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110242057=declare variable PAYMENT_TYPE_OLD_ type of column G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110242058=declare variable STR_ varchar(500);'
      '110242059=declare variable POS_TILDA_ integer;'
      
        '110242060=declare variable KASSA_STR_ varchar(3000) = '#39#39'~'#39#39'; /* ' +
        #1044#1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '110242061=declare variable PRICE_CURRENCY_ type of column SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110242062=declare variable SUMM_CURRENCY_TMP_ type of column SKL' +
        'AD.SUMM_CURRENCY;'
      '110242063=BEGIN'
      '110242064='
      '110242065=  IS_THIS_LAST_ = 0;'
      '110242066='
      '110242067=  SELECT S.G_TOCHKA,'
      '110242068=         S.IS_VOZVRAT,'
      '110242069=         S.G_PAYMENT_TYPE'
      '110242070=    FROM SKLAD_parent S'
      '110242071=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '110242072=    INTO :G_TOCHKA_,'
      '110242073=         :IS_VOZVRAT_,'
      '110242074=         :G_PAYMENT_TYPE_OLD_;'
      '110242075='
      '110242076=  PNT_ = '#39#39'00'#39#39';'
      '110242077=  UPDATE SKLAD_PARENT'
      '110242078=  SET'
      
        '110242079=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEIP' +
        'T),'
      
        '110242080=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEIP' +
        'T),'
      
        '110242081=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYME' +
        'NT_TYPE),'
      '110242082=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110242083=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110242084=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '110242085=   SUMM      = :SUMM_,'
      '110242086=   SUMM_FACT = :SUMM_FACT_,'
      '110242087=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '110242088=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0)  ' +
        '-- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' ' +
        #1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110242089=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '110242090='
      
        '110242091=  ----------------------------------------------------' +
        '---------'
      '110242092=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040
      '110242093=  PNT_ = '#39#39'02'#39#39';'
      '110242094=  FOR SELECT SKLAD'
      '110242095=        FROM SKLAD S'
      '110242096=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110242097=         AND NOT EXISTS (SELECT 1'
      '110242098=                           FROM SKLAD_TMP T'
      '110242099=                        WHERE T.SKLAD = S.SKLAD)'
      '110242100=  INTO :SKLAD_'
      '110242101=  DO BEGIN'
      
        '110242102=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL_ONE(:SKLAD_) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110242103=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110242104=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110242105=      EXIT;'
      '110242106=    END'
      '110242107=  END'
      '110242108='
      
        '110242109=  ----------------------------------------------------' +
        '---------'
      
        '110242110=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044#1054 +
        #1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '110242111=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '110242112=  PNT_ = '#39#39'03'#39#39';'
      '110242113=  FOR SELECT S.SKLAD,'
      '110242114=             S.G_PRODUCT,'
      '110242115=             S.AMOUNT,'
      '110242116=             S.PRICE,'
      '110242117=             S.SUMM,'
      '110242118=             S.NDS,'
      '110242119=             S.NDS_SUMM,'
      '110242120=             T.SKLAD,'
      '110242121=             T.AMOUNT,'
      '110242122=             T.IS_LAST,'
      '110242123=             T.DATE_RECEIPT'
      '110242124=             ,S.PRICE_CURRENCY'
      '110242125=             ,S.SUMM_CURRENCY'
      
        '110242126=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLAD' +
        ', AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT = ' +
        ':SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '110242127=  INTO :SKLAD_,'
      '110242128=       :G_PRODUCT_,'
      '110242129=       :AMOUNT_,'
      '110242130=       :PRICE_,'
      '110242131=       :SUMM_ONE_,'
      '110242132=       :NDS_,'
      '110242133=       :NDS_SUMM_,'
      '110242134=       :SKLAD_OLD_,'
      '110242135=       :AMOUNT_OLD_,'
      '110242136=       :IS_THIS_LAST_,'
      '110242137=       :DATE_RECEIPT_OLD_'
      '110242138=       ,:PRICE_CURRENCY_'
      '110242139=       ,:SUMM_CURRENCY_TMP_'
      '110242140=  DO BEGIN'
      
        '110242141=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058#1040 +
        #1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110242142=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '110242143=        PNT_ = '#39#39'04'#39#39';'
      
        '110242144=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_R' +
        'ECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYPE' +
        ', NDS, NDS_SUMM,'
      
        '110242145=                          IS_LAST, NOTE, OSNOVANIE, IS' +
        '_VOZVRAT, G_TOCHKA'
      '110242146=                          ,PRICE_CURRENCY'
      '110242147=                          ,SUMM_CURRENCY)'
      
        '110242148=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIPT' +
        '_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_PA' +
        'YMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '110242149=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '110242150=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :G' +
        '_TOCHKA_'
      '110242151=               ,:PRICE_CURRENCY_'
      '110242152=               ,:SUMM_CURRENCY_TMP_'
      '110242153=               );'
      '110242154='
      '110242155=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110242156=        UPDATE LT_SKLAD_PRODUCT L'
      '110242157=           SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110242158=         WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110242159=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110242160='
      '110242161=        IF (ROW_COUNT = 0) THEN'
      
        '110242162=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCHKA_);'
      '110242163='
      
        '110242164=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050 +
        ' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058 +
        #1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110242165=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045#1052 +
        ' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056#1048 +
        #1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '110242166=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DETA' +
        'IL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '110242167=        PNT_ = '#39#39'05'#39#39';'
      '110242168=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '110242169=            SELECT MAX(SK.DATE_RECEIPT)'
      '110242170=              FROM SKLAD SK'
      '110242171=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242172=               AND SK.IS_LAST = 1'
      '110242173=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110242174=              INTO :DATE_LAST_;'
      '110242175='
      
        '110242176=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110242177=              UPDATE SKLAD SK'
      '110242178=                 SET SK.IS_LAST = 0'
      '110242179=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242180=                 AND SK.IS_LAST = 1'
      '110242181=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110242182='
      '110242183=              UPDATE SKLAD SK'
      '110242184=                 SET SK.IS_LAST = 1'
      '110242185=               WHERE SK.SKLAD = :SKLAD_;'
      '110242186=            END'
      '110242187=        END'
      '110242188='
      
        '110242189=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110242190=    END ELSE BEGIN'
      '110242191=        PNT_ = '#39#39'06'#39#39';'
      '110242192=        UPDATE SKLAD S'
      '110242193=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '110242194=               S.G_CLIENT = :G_CLIENT_,'
      '110242195=               S.AMOUNT   = :AMOUNT_,'
      '110242196=               S.PRICE    = :PRICE_,'
      '110242197=               S.SUMM     = :SUMM_ONE_,'
      '110242198=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110242199=               S.NDS      = :NDS_,'
      '110242200=               S.NDS_SUMM = :NDS_SUMM_,'
      '110242201=               S.OSNOVANIE = :OSNOVANIE_,'
      '110242202=               S.NOTE      = :NOTE_'
      '110242203=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110242204=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP_'
      '110242205=         WHERE S.SKLAD = :SKLAD_;'
      '110242206='
      '110242207=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110242208=        if (AMOUNT_OLD_ > AMOUNT_) then'
      '110242209=          UPDATE LT_SKLAD_PRODUCT L'
      
        '110242210=             SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD_ -' +
        ' :AMOUNT_)'
      '110242211=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110242212=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110242213='
      '110242214=        ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '110242215=          UPDATE LT_SKLAD_PRODUCT L'
      
        '110242216=             SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ - :AM' +
        'OUNT_OLD_)'
      '110242217=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110242218=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110242219='
      
        '110242220=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048' ' +
        #1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048 +
        #1058#1068' IS_LAST = 1'
      '110242221=        PNT_ = '#39#39'07'#39#39';'
      
        '110242222=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110242223=            SELECT MAX(SK.DATE_RECEIPT)'
      '110242224=              FROM SKLAD SK'
      '110242225=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242226=               AND SK.IS_LAST = 1'
      '110242227=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110242228=              INTO :DATE_LAST_;'
      '110242229='
      
        '110242230=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110242231=              UPDATE SKLAD SK'
      '110242232=                 SET SK.IS_LAST = 0'
      '110242233=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242234=                 AND SK.IS_LAST = 1'
      '110242235=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110242236='
      '110242237=              UPDATE SKLAD SK'
      '110242238=                 SET SK.IS_LAST = 1'
      '110242239=               WHERE SK.SKLAD = :SKLAD_;'
      '110242240=            END'
      '110242241=        END'
      '110242242='
      
        '110242243=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048' ' +
        'IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068 +
        ' IS_LAST = 0'
      '110242244=        PNT_ = '#39#39'08'#39#39';'
      
        '110242245=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (I' +
        'S_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110242246=            SELECT MAX(SK.DATE_RECEIPT)'
      '110242247=              FROM SKLAD SK'
      '110242248=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242249=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '110242250=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110242251=               AND SK.is_vozvrat IN (0,3,4)'
      '110242252=              INTO :DATE_LAST_;'
      '110242253='
      
        '110242254=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_REC' +
        'EIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' '#1055 +
        #1054#1057#1051#1045#1044#1053#1071#1071
      '110242255=              UPDATE SKLAD SK'
      '110242256=                 SET SK.IS_LAST = 0'
      '110242257=               WHERE SK.SKLAD = :SKLAD_;'
      '110242258='
      '110242259=               UPDATE SKLAD SK'
      '110242260=                 SET SK.IS_LAST = 1'
      '110242261=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110242262=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110242263=                                   FROM SKLAD SS'
      
        '110242264=                                  WHERE SS.G_PRODUCT =' +
        ' SK.G_PRODUCT'
      
        '110242265=                                    AND SS.DATE_RECEIP' +
        'T = :DATE_LAST_'
      
        '110242266=                                    AND SS.G_TOCHKA = ' +
        ':G_TOCHKA_'
      
        '110242267=                                    AND SS.is_vozvrat ' +
        'IN (0,3,4));'
      '110242268='
      '110242269=            END'
      
        '110242270=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054#1052 +
        ' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1053 +
        #1048#1052'.'
      
        '110242271=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059#1044 +
        #1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '110242272=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THIS' +
        '_LAST_ = 1)) THEN BEGIN'
      '110242273=              UPDATE SKLAD SK'
      '110242274=                 SET SK.IS_LAST = 1'
      '110242275=               WHERE SK.SKLAD = :SKLAD_;'
      '110242276=            END'
      '110242277=        END'
      '110242278=    END'
      '110242279=  END'
      '110242280='
      
        '110242281=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057#1057 +
        #1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '110242282=      ----------------------------------------'
      
        '110242283=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058#1068 +
