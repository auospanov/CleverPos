        #1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '110402651=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055 +
        #1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '110402652=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054 +
        ' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '110402653=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110402654=                SELECT K.KASSA'
      '110402655=                FROM KASSA K'
      '110402656=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110402657=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110402658=                 INTO :KASSA_POP_;'
      '110402659=            ELSE'
      '110402660=                SELECT K.KASSA_BEZNAL'
      '110402661=                FROM KASSA_BEZNAL K'
      '110402662=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110402663=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110402664=                 INTO :KASSA_POP_;'
      '110402665='
      
        '110402666=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110402667=              PNT_ = '#39#39'09'#39#39';'
      
        '110402668=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' '#1054 +
        #1053#1040' '#1045#1057#1058#1068
      '110402669=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '110402670=                    EXECUTE PROCEDURE K_UPD_KASSA(:KAS' +
        'SA_POP_,'
      
        '110402671=                                                  0,  ' +
        '   -- ACTION_'
      
        '110402672=                                                  :G_P' +
        'RIHOD_,'
      
        '110402673=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110402674=                                                  :Z_D' +
        'ATE_,'
      
        '110402675=                                                  NULL' +
        ',   --NOTE_'
      
        '110402676=                                                  :ZAK' +
        'AZ_,'
      
        '110402677=                                                  NULL' +
        ','
      
        '110402678=                                                  :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110402679=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110402680=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '110402681=                    PNT_ = '#39#39'10'#39#39';'
      
        '110402682=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_'
      
        '110402683=                                                  :G_P' +
        'RIHOD_,'
      
        '110402684=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110402685=                                                  :Z_D' +
        'ATE_,'
      
        '110402686=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110402687=                                                  :ZAK' +
        'AZ_,'
      
        '110402688=                                                  NULL' +
        ','
      
