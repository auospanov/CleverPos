      '1101322342='
      '1101322343=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101322344=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
