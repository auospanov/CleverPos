      '110752540='
      
        '110752541=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055 +
        #1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110752542=                UPDATE LT_SKLAD_PRODUCT L'
      
