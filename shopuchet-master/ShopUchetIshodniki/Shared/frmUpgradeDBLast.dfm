      '110202473=            SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '110202474=                         '#39'SET K.DEBET = COALESCE(K.DEB' +
        'ET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39', '#39'||'
      
