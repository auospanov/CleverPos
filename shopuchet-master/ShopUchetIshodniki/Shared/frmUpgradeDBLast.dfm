      '110225458='
      '110225459=RECONNECT;'
      '110225460='
      
        '110225461=ALTER TABLE SKLAD_PARENT ADD CONSTRAINT FK_SKLAD_PAREN' +
        'T_5 FOREIGN KEY (ZAKAZ) REFERENCES ZAKAZ (ZAKAZ);'
      '110225462='
      '110225463='
      
        '110225464=/*****************************************************' +
        '*************************/'
      
        '110225465=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110225466=/*****************************************************' +
        '*************************/'
      '110225467='
      '110225468=ALTER PROCEDURE DEL_SKLAD('
      '110225469=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110225470=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110225471=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110225472=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110225473=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110225474=RETURNS ('
      '110225475=  ERR_CODE INTEGER,'
      '110225476=  ERR_MSG VARCHAR(1024))'
      '110225477=AS'
      '110225478=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD'#39';'
      '110225479=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110225480=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110225481=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '110225482=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110225483=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110225484=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110225485=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110225486=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.A' +
        'MOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071 +
        ') */'
      
        '110225487=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA.' +
        'NAME;'
      
        '110225488=DECLARE VARIABLE DATE_ TYPE OF COLUMN SKLAD_PARENT.DAT' +
        'E_RECEIPT;'
      
        '110225489=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110225490=DECLARE VARIABLE REC_ID_ TYPE OF COLUMN SKLAD_PARENT.R' +
        'EC_ID;'
      
        '110225491=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110225492=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.SUMM;'
      
        '110225493=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM;'
      '110225494=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      
        '110225495=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN SKLAD_PARENT.ZA' +
        'KAZ;'
      
        '110225496=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.G_CLIENT;'
      '110225497=BEGIN'
      '110225498='
      '110225499=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '110225500=    SELECT S_VALUE'
      '110225501=      FROM SYSTEM_SETUP'
      '110225502=     WHERE SYSTEM_SETUP = 2'
      '110225503=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110225504='
      '110225505=  SELECT SP.IS_VOZVRAT,'
      
        '110225506=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TOC' +
        'HKA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '110225507=         ,G.NAME'
      '110225508=         ,SP.DATE_RECEIPT'
      '110225509=         ,SP.SUMM'
      '110225510=         ,SP.REC_ID'
      '110225511=         ,SP.ZAKAZ'
      '110225512=         ,SP.G_CLIENT'
      '110225513=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '110225514=   WHERE SP.SKLAD = :SKLAD_'
      '110225515=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '110225516=    INTO :IS_VOZVRAT_,'
      '110225517=         :G_TOCHKA_'
      '110225518=         ,:TOCHKA_NAME_'
      '110225519=         ,:DATE_'
      '110225520=         ,:SUMM_'
      '110225521=         ,:REC_ID_'
      '110225522=         ,:ZAKAZ_'
      '110225523=         ,:G_CLIENT_;'
      '110225524='
      '110225525=  PNT_ = '#39'02'#39';'
      '110225526=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '110225527=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '110225528=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040#1045 +
        #1058' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      
        '110225529=  -- 13.10.2021 '#1055#1054#1051#1059#1063#1048#1051#1040#1057#1068' '#1057#1048#1058#1059#1040#1062#1048#1071' '#1055#1056#1048' '#1059#1044#1040#1051#1045#1053#1048#1048' '#1043#1056#1059#1055#1055 +
        #1067' '#1058#1054#1042#1040#1056#1054#1042', '#1048#1057#1063#1045#1047#1051#1048' ID-'#1064#1050#1048' '#1048#1047' LT_SKLAD_PRODUCT '#1048' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054
      
        '110225530=  -- '#1053#1040#1063#1040#1051#1040' '#1042#1054#1047#1053#1048#1050#1040#1058#1068' '#1054#1064#1048#1041#1050#1040', '#1063#1058#1054' '#1058#1054#1042#1040#1056#1054#1042' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062 +
        #1040#1058#1045#1051#1068#1053#1054', '#1055#1054#1069#1058#1054#1052#1059' '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056#1040' '#1042' LT_SKLAD_PRODUCT '#1042#1054#1054#1041#1065#1045' '#1053#1045#1058', '#1058#1054' '#1054 +
        #1064#1048#1041#1050#1059' '#1053#1045' '#1042#1054#1047#1041#1059#1046#1044#1040#1070
      '110225531=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '110225532=      FOR SELECT S.G_PRODUCT,'
      '110225533=                 SUM(S.AMOUNT)'
      '110225534=            FROM SKLAD S'
      '110225535=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '110225536=           GROUP BY S.G_PRODUCT'
      '110225537=            INTO :G_PRODUCT_,'
      '110225538=                 :AMOUNT_PRIHOD_'
      '110225539=      DO BEGIN'
      '110225540=          SELECT L.AMOUNT,'
      '110225541=                 G.NAME'
      '110225542=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '110225543=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110225544=             AND L.G_PRODUCT = G.G_PRODUCT'
      '110225545=             AND L.G_TOCHKA = :G_TOCHKA_'
      '110225546=            INTO :AMOUNT_LAST_,'
      '110225547=                 :NAME_;'
      '110225548='
      
        '110225549=          IF (ROW_COUNT > 0 AND ((:AMOUNT_LAST_ - :AMO' +
        'UNT_PRIHOD_) < 0)) THEN BEGIN'
      '110225550=              ERR_CODE = -20500;'
      
        '110225551=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||NAME_||'#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||TOCHKA_NAME_||'#39'" '#1089#1090#1072 +
        #1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURN' +
        'ING_VALUES (:ERR_MSG);'
      
        '110225552=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110225553=              EXIT;'
      '110225554=          END'
      '110225555=      END'
      '110225556=  END'
      '110225557='
      
        '110225558=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL, :U' +
        'PLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110225559=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110225560=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110225561=    EXIT;'
      '110225562=  END'
      '110225563='
      '110225564=  -------------------------------------'
      
        '110225565=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' ' +
        #1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051 +
        #1040#1044#1040
      
        '110225566=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053#1067 +
        #1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1055 +
        #1054#1044#1056#1071#1044
      '110225567=  PNT_ = '#39'05'#39';'
      '110225568=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '110225569=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '110225570=      FOR SELECT S.KASSA'
      '110225571=            FROM KASSA S'
      '110225572=           WHERE S.SKLAD = :SKLAD_'
      '110225573=            INTO :KASSA_'
      '110225574=      DO BEGIN'
      
        '110225575=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1, :U' +
        'PLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110225576=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110225577=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '110225578=             EXIT;'
      '110225579=          END'
      '110225580=      END'
      '110225581='
      '110225582=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '110225583=      FOR SELECT S.KASSA_BEZNAL'
      '110225584=            FROM KASSA_BEZNAL S'
      '110225585=           WHERE S.SKLAD = :SKLAD_'
      '110225586=            INTO :KASSA_'
      '110225587=      DO BEGIN'
      
        '110225588=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110225589=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110225590=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '110225591=             EXIT;'
      '110225592=          END'
      '110225593=      END'
      '110225594=  END'
      '110225595=  -------------------------------------'
      '110225596='
      '110225597=  PNT_ = '#39'06'#39';'
      '110225598=  DELETE FROM sklad_PARENT'
      '110225599=  WHERE sklad = :sklad_;'
      '110225600='
      '110225601=  -- '#1042#1054#1047#1042#1056#1040#1065#1040#1070' '#1041#1054#1053#1059#1057#1067' '#1053#1040' '#1052#1045#1057#1058#1054
      
        '110225602=  IF (IS_VOZVRAT_ = 1 AND ZAKAZ_ IS NOT NULL) THEN BEG' +
        'IN'
      '110225603=    SELECT Z.SUMM_BONUS_GOT'
      '110225604=      FROM ZAKAZ Z'
      '110225605=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110225606=      INTO :SUMM_BONUS_GOT_;'
      '110225607='
      '110225608=    IF (:SUMM_BONUS_GOT_ > 0) THEN BEGIN'
      '110225609=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '110225610=              SUM(Z.SUMM)'
      '110225611=         FROM ZAKAZ Z'
      '110225612=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '110225613=         INTO :SUMM_BONUS_GOT_,'
      '110225614=              :SUMM_ALL_;'
      '110225615='
      
        '110225616=       SELECT ROUND( SUM(SP.SUMM * Z.SUMM_BONUS_GOT / ' +
        'Z.SUMM), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040#1058 +
        #1040
      '110225617=              SUM(SP.SUMM)'
      '110225618=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '110225619=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '110225620=          AND SP.ZAKAZ = Z.ZAKAZ'
      '110225621=         INTO :BONUS_TO_MINUS_,'
      '110225622=              :SUMM_TO_MINUS_;'
      '110225623='
      '110225624=       UPDATE G_DISCONT_CARD G'
      
        '110225625=          SET G.SUMM = :SUMM_BONUS_GOT_ - COALESCE(:BO' +
        'NUS_TO_MINUS_, 0),'
      
        '110225626=              G.SUMM_ALL = :SUMM_ALL_ - COALESCE(:SUMM' +
        '_TO_MINUS_, 0)'
      '110225627=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '110225628=    END'
      '110225629=  END'
      '110225630='
      '110225631=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '110225632=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ IN (0,1,2' +
        ')) THEN BEGIN'
      '110225633=    UPDATE SYNC_EXT_APP AP'
      '110225634=       SET AP.OPER = 3,'
      '110225635=           AP.ID = COALESCE(:REC_ID_, :SKLAD_)'
      '110225636=     WHERE AP.OBJECT_TYPE = 2'
      '110225637=       AND AP.ID = :SKLAD_'
      '110225638=       AND AP.IS_LOADING = 0;'
      '110225639='
      '110225640=    IF (ROW_COUNT = 0) THEN'
      
        '110225641=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110225642=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, COALES' +
        'CE(:REC_ID_, :SKLAD_), 3);'
      '110225643=  END'
      '110225644='
      '110225645=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110225646=  EXECUTE PROCEDURE LOG_OPER_INS(IS_VOZVRAT_, :USER_ID' +
        '_, :SKLAD_, :DATE_, 3, :SUMM_, :LOG_BODY_, 1);'
      '110225647='
      '110225648=WHEN SQLCODE -530 DO'
      '110225649=  begin'
      '110225650=    ERR_CODE = -20500;'
      
        '110225651=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110225652=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110225653=  end'
      '110225654=END'
      '110225655=;'
      '110225656='
      '110225657=ALTER PROCEDURE GET_SKLAD('
      '110225658=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110225659=  MODE_ INTEGER)'
      '110225660=RETURNS ('
      '110225661=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '110225662=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110225663=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110225664=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '110225665=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '110225666=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110225667=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110225668=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110225669=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110225670=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY,'
      
        '110225671=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '110225672=  CNT_T_ INTEGER,'
      
        '110225673=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110225674=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110225675=  HAVERIGHT_ INTEGER,'
      '110225676=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110225677=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ','
      
        '110225678=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      '110225679=  ZAKAZ_ TYPE OF COLUMN SKLAD_PARENT.ZAKAZ,'
      '110225680=  ERR_CODE INTEGER,'
      '110225681=  ERR_MSG VARCHAR(1024))'
      '110225682=AS'
      '110225683=/*'
      
        '110225684=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083 +
        #1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '110225685=*/'
      
        '110225686=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      
        '110225687=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      '110225688=begin'
      
        '110225689=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080 +
        ' INS '#1080' '#1087#1088#1080' UPD'
      '110225690=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110225691=  CNT_T_ = 0;'
      '110225692=  SELECT COUNT(*)'
      '110225693=    FROM (SELECT S.SKLAD'
      '110225694=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '110225695=    INTO :CNT_T_;'
      '110225696='
      '110225697=  SELECT'
      '110225698=    T.DATE_RECEIPT,'
      '110225699=    T.TIME_RECEIPT,'
      '110225700=    T.G_CLIENT,'
      '110225701=    T.G_PAYMENT_TYPE,'
      '110225702=    T.G_NONCASH_PAY_TYPE,'
      '110225703=    T.OSNOVANIE,'
      '110225704=    T.NOTE,'
      '110225705=    T.SUMM,'
      '110225706=    T.SUMM_FACT,'
      '110225707=    T.IS_PAYED_ALL'
      '110225708=    ,T.SUMM_CURRENCY'
      '110225709=    ,T.is_expected'
      '110225710=    ,T.IS_VOZVRAT'
      '110225711=    ,T.ZAKAZ'
      '110225712=  FROM SKLAD_PARENT T'
      '110225713=  WHERE T.SKLAD = :SKLAD_'
      '110225714=  INTO'
      '110225715=    :DATE_RECEIPT_,'
      '110225716=    :TIME_RECEIPT_,'
      '110225717=    :G_CLIENT_,'
      '110225718=    :G_PAYMENT_TYPE_,'
      '110225719=    :G_NONCASH_PAY_TYPE_,'
      '110225720=    :OSNOVANIE_,'
      '110225721=    :NOTE_,'
      '110225722=    :SUMM_,'
      '110225723=    :SUMM_FACT_,'
      '110225724=    :IS_PAYED_ALL_'
      '110225725=    ,:SUMM_CURRENCY_'
      '110225726=    ,:IS_EXPECTED_'
      '110225727=    ,:IS_VOZVRAT_'
      '110225728=    ,:ZAKAZ_;'
      '110225729='
      '110225730=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110225731=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1057#1054#1047#1044#1040#1053#1048#1045' '#1050#1054#1055#1048#1048', '#1048' '#1042' '#1048#1057#1061#1054#1044#1053#1054#1052' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1045#1057 +
        #1058#1068' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' - '#1045#1043#1054' '#1042' '#1050#1054#1055#1048#1070' '#1053#1045' '#1044#1054#1041#1040#1042#1051#1071#1070', '#1055#1059#1057#1058#1068' '#1042#1056#1059#1063#1053#1059#1070' ' +
        #1055#1056#1054#1041#1048#1042#1040#1070#1058
      
        '110225732=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY,'
      
        '110225733=                        charge_ROZN_proc, PRICE_ROZN, ' +
        'charge_opt_proc, PRICE_OPT)'
      
        '110225734=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKL' +
        'AD_,'
      '110225735=         PRICE_CURRENCY, SUMM_CURRENCY,'
      
        '110225736=         DECODE(S.PRICE, 0, 0, ROUND((G.PRICE/S.PRICE ' +
        '- 1)*100, 2)),'
      '110225737=         G.PRICE,'
      
        '110225738=         DECODE(S.PRICE, 0, 0, ROUND((G.volume_price/S' +
        '.PRICE - 1)*100, 2)),'
      '110225739=         G.VOLUME_PRICE'
      '110225740=    FROM SKLAD S, G_PRODUCT G'
      '110225741=   WHERE SKLAD_PARENT = :SKLAD_'
      '110225742=     AND S.G_PRODUCT = G.G_PRODUCT'
      '110225743=     AND ((:MODE_ = 0)'
      '110225744=          OR'
      '110225745=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 0)'
      '110225746=          OR'
      
        '110225747=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 1 AND CHAR_LE' +
        'NGTH(S.MARK_CODE) = 0)'
      '110225748=         )'
      '110225749=   ORDER BY SKLAD;'
      '110225750='
      '110225751=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110225752=  SELECT K.G_PRIHOD_RASHOD,'
      '110225753=         K.SUMM'
      
        '110225754=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110225755=   WHERE K.SKLAD = :SKLAD_'
      '110225756=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110225757=    INTO :G_PRIHOD_,'
      '110225758=         :SUMM_PRIHOD_;'
      '110225759='
      
        '110225760=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110225761='
      
        '110225762=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110225763=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110225764=  HaveRight_ = 1;'
      '110225765=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110225766=    SELECT ID'
      '110225767=      FROM CUR_PARAMS'
      '110225768=     WHERE CUR_PARAMS = 1'
      '110225769=      INTO :G_OFFICIAL_CUR_;'
      '110225770='
      
        '110225771=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110225772=      HaveRight_ = 1;'
      '110225773=    else'
      
        '110225774=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110225775=  END'
      '110225776=end'
      '110225777=;'
      '110225778='
      '110225779=ALTER PROCEDURE INS_SKLAD('
      '110225780=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110225781=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110225782=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110225783=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110225784=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110225785=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110225786=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110225787=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110225788=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110225789=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110225790=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110225791=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110225792=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110225793=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110225794=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0,'
      '110225795=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110225796=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110225797=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '110225798=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110225799=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '110225800=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE = NULL,'
      '110225801=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = NULL)'
      '110225802=RETURNS ('
      '110225803=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110225804=  ERR_CODE INTEGER,'
      '110225805=  ERR_MSG VARCHAR(1024))'
      '110225806=AS'
      '110225807=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110225808=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110225809=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110225810=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110225811=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110225812=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110225813=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110225814=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110225815=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110225816=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110225817=--'
      
        '110225818=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110225819=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110225820='
      
        '110225821=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056 +
        #1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110225822=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110225823=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110225824=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110225825=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110225826=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110225827=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110225828=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110225829=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110225830=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110225831=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110225832=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110225833=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110225834=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110225835=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110225836=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110225837=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110225838=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110225839=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110225840=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110225841=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110225842=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110225843=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110225844=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      
        '110225845=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK_' +
        'CODE;'
      
        '110225846=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COST' +
        '_PRICE;'
      
        '110225847=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110225848=DECLARE VARIABLE SUMM_BONUS_ TYPE OF COLUMN G_DISCONT_' +
        'CARD.SUMM;'
      
        '110225849=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.SUMM;'
      
        '110225850=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM;'
      '110225851=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '110225852=BEGIN'
      '110225853='
      '110225854=  PNT_ = '#39'00'#39';'
      '110225855=  IS_THIS_LAST_ = 0;'
      '110225856='
      '110225857=  IF (G_TOCHKA_ IS NULL) THEN'
      '110225858=    SELECT ID'
      '110225859=      FROM CUR_PARAMS'
      '110225860=     WHERE CUR_PARAMS = 2'
      '110225861=      INTO :G_TOCHKA_;'
      '110225862='
      '110225863=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110225864=  IF (G_OFFICIAL_ IS NULL) THEN'
      '110225865=      SELECT ID'
      '110225866=        FROM CUR_PARAMS'
      '110225867=       WHERE CUR_PARAMS = 1'
      '110225868=        INTO :G_OFFICIAL_;'
      '110225869='
      '110225870=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110225871=                            DATE_RECEIPT,'
      '110225872=                            TIME_RECEIPT,'
      '110225873=                            G_CLIENT,'
      '110225874=                            G_PAYMENT_TYPE,'
      '110225875=                            OSNOVANIE,'
      '110225876=                            NOTE,'
      '110225877=                            SUMM,'
      '110225878=                            SUMM_FACT,'
      '110225879=                            SUMM_CURRENCY,'
      '110225880=                            IS_PAYED_ALL,'
      '110225881=                            IS_VOZVRAT,'
      '110225882=                            G_TOCHKA'
      '110225883=                            ,G_OFFICIAL'
      '110225884=                            ,IS_EXPECTED'
      '110225885=                            ,G_NONCASH_PAY_TYPE'
      '110225886=                            ,REC_ID'
      '110225887=                            ,ZAKAZ)'
      '110225888=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110225889=          :DATE_RECEIPT_,'
      '110225890=          :TIME_RECEIPT_,'
      '110225891=          :G_CLIENT_,'
      '110225892=          :G_PAYMENT_TYPE_,'
      '110225893=          :OSNOVANIE_,'
      '110225894=          :NOTE_,'
      '110225895=          :SUMM_,'
      '110225896=          :SUMM_FACT_,'
      '110225897=          :SUMM_CURRENCY_,'
      
        '110225898=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE ' +
        '0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057 +
        #1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110225899=          :IS_VOZVRAT_,'
      '110225900=          :G_TOCHKA_'
      '110225901=          ,:G_OFFICIAL_'
      '110225902=          ,:IS_EXPECTED_'
      '110225903=          ,:G_NONCASH_PAY_TYPE_'
      '110225904=          ,:REC_ID_'
      '110225905=          ,:ZAKAZ_)'
      '110225906=  RETURNING'
      '110225907=    SKLAD'
      '110225908=  INTO'
      '110225909=    :SKLAD_;'
      '110225910='
      '110225911=  PNT_ = '#39'01'#39';'
      '110225912=  FOR SELECT SKLAD,'
      '110225913=             T.G_PRODUCT,'
      '110225914=             AMOUNT,'
      '110225915=             T.PRICE,'
      '110225916=             SUMM,'
      '110225917=             NDS,'
      '110225918=             NDS_SUMM'
      '110225919=             ,PRICE_CURRENCY'
      '110225920=             ,SUMM_CURRENCY'
      '110225921=             ,PRICE_ROZN'
      '110225922=             ,GG.PRICE'
      '110225923=             ,T.MARK_CODE'
      '110225924=             ,T.COST_PRICE'
      '110225925=        FROM SKLAD_TMP T,'
      '110225926=             G_PRODUCT GG'
      '110225927=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110225928=      ORDER BY 1'
      '110225929=      INTO :SKLAD_TMP_,'
      '110225930=           :RG_PRODUCT_,'
      '110225931=           :RAMOUNT_,'
      '110225932=           :RPRICE_,'
      '110225933=           :RSUMM_,'
      '110225934=           :RNDS_,'
      '110225935=           :RNDS_SUMM_'
      '110225936=           ,:PRICE_CURRENCY_'
      '110225937=           ,:SUMM_CURRENCY_TMP_'
      '110225938=           ,:SALE_PRICE_'
      '110225939=           ,:SALE_PRICE_CUR_'
      '110225940=           ,:MARK_CODE_'
      '110225941=           ,:COST_PRICE_'
      '110225942=  DO BEGIN'
      '110225943=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110225944=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110225945=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110225946=      IS_THIS_LAST_ = 0;'
      '110225947=      SELECT MAX(SK.DATE_RECEIPT)'
      '110225948=        FROM SKLAD SK'
      '110225949=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110225950=         AND SK.IS_LAST = 1'
      '110225951=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110225952=        INTO :DATE_LAST_;'
      '110225953='
      
        '110225954=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110225955=        UPDATE SKLAD SK'
      '110225956=           SET SK.IS_LAST = 0'
      '110225957=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110225958=           AND SK.IS_LAST = 1'
      '110225959=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110225960='
      '110225961=        IS_THIS_LAST_ = 1;'
      '110225962=      END'
      '110225963=    END'
      '110225964='
      '110225965=    INSERT INTO SKLAD'
      '110225966=    ('
      '110225967=     SKLAD,'
      '110225968=     SKLAD_PARENT,'
      '110225969=     DATE_RECEIPT,'
      '110225970=     G_CLIENT,'
      '110225971=     G_PRODUCT,'
      '110225972=     AMOUNT,'
      '110225973=     PRICE,'
      '110225974=     SUMM,'
      '110225975=     G_PAYMENT_TYPE,'
      '110225976=     OSNOVANIE,'
      '110225977=     NOTE,'
      '110225978=     NDS,'
      '110225979=     NDS_SUMM,'
      '110225980=     IS_LAST,'
