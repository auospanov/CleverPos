        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11096156=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM; /' +
        '* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '11096157=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '11096158=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN ZAK' +
        'AZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '11096159=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11096160=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
