        ' i*5+4 for 2) as int));'
      '11015371=          if (buf != '#39#39') then buf = buf || '#39' '#39';'
      '11015372=          buf = buf || buf1;'
      '11015373=      end else'
      '11015374=      /* '#1044#1083#1103' "'#1085#1086#1088#1084#1072#1083#1100#1085#1099#1093'" '#1095#1080#1089#1077#1083' '#1089#1074#1086#1103' '#1086#1073#1088#1072#1073#1086#1090#1082#1072' */'
      '11015375=      begin'
