        'VRAT_;'
      
        '110534019=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ + ' +
        'AMOUNT_PRIHOD_SKL_;'
      
        '110534020=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + SU' +
        'MM_PRIHOD_SKL_;'
      
        '110534021=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + AM' +
        'OUNT_UHOD_SKL_;'
      
        '110534022=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUMM' +
        '_UHOD_SKL_;'
      '110534023='
      '110534024=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '110534025=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '110534026=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD,' +
        ' SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPISA' +
        'NO, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHOD' +
        '_SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '110534027=    VALUES'
      
        '110534028=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AMO' +
        'UNT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UHO' +
        'D_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVRA' +
        'T_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIHO' +
        'D_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '110534029='
      
        '110534030=    STR_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_' +
        '), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '110534031=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||' +
        #39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXT' +
        'RACT(YEAR FROM DATE_END_);'
      '110534032='
      '110534033=  FOR'
      '110534034=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '110534035=           DECODE(T.IS_HEAD,'
      '110534036=                  0, T.NAME,'
      '110534037=                  1, T.NAME,'
      '110534038=                  2, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39','
      '110534039=                  3, '#39#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39#39'),'
      '110534040=           G.ARTICUL,'
      '110534041=           G.BARCODE,'
      '110534042=           G.PRICE,'
      '110534043=           T.AMOUNT_IN,'
      '110534044=           T.AMOUNT_PRIHOD,'
      '110534045=           T.SUMM_PRIHOD,'
      '110534046=           T.AMOUNT_UHOD,'
      '110534047=           T.SUMM_UHOD,'
      '110534048=           T.AMOUNT_SPISANO,'
      '110534049=           T.SUMM_SPISANO,'
      '110534050=           T.AMOUNT_VOZVRAT,'
      '110534051=           T.SUMM_VOZVRAT,'
      '110534052=           T.AMOUNT_PRIHOD_SKL,'
      '110534053=           T.SUMM_PRIHOD_SKL,'
      '110534054=           T.AMOUNT_UHOD_SKL,'
      '110534055=           T.SUMM_UHOD_SKL,'
      '110534056=           T.AMOUNT_OUT,'
      '110534057=           T.IS_HEAD'
      
        '110534058=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G_' +
        'PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '110534059=     ORDER BY 1'
      '110534060=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '110534061=       :NAME,'
      '110534062=       :ARTICUL,'
      '110534063=       :BARCODE,'
      '110534064=       :PRICE,'
      '110534065=       :AMOUNT_IN,'
      '110534066=       :AMOUNT_PRIHOD,'
      '110534067=       :SUMM_PRIHOD,'
      '110534068=       :AMOUNT_UHOD,'
      '110534069=       :SUMM_UHOD,'
      '110534070=       :AMOUNT_SPISANO,'
      '110534071=       :SUMM_SPISANO,'
      '110534072=       :AMOUNT_VOZVRAT,'
      '110534073=       :SUMM_VOZVRAT,'
      '110534074=       :AMOUNT_PRIHOD_SKL,'
      '110534075=       :SUMM_PRIHOD_SKL,'
      '110534076=       :AMOUNT_UHOD_SKL,'
      '110534077=       :SUMM_UHOD_SKL,'
      '110534078=       :AMOUNT_OUT,'
      '110534079=       :IS_HEAD'
      '110534080=  DO SUSPEND;'
      '110534081='
      '110534082=WHEN ANY DO BEGIN'
      '110534083=    Err_code = -20500;'
      
        '110534084=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110534085=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110534086=  END'
      '110534087=end'
      '110534088='#39';'
      '110534089='
      
        '110534090=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        '('
      '110534091=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110534092=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110534093=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110534094=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110534095=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110534096=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110534097=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110534098=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110534099=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110534100=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110534101=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110534102=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110534103=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110534104=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110534105=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110534106=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110534107=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110534108=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110534109=  PAYMENTS_ BLOB SUB_TYPE 1)'
      '110534110=RETURNS ('
      '110534111=  ERR_CODE INTEGER,'
      '110534112=  ERR_MSG VARCHAR(1024))'
      '110534113=AS'
      
        '110534114=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39#39';'
      '110534115=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110534116=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110534117=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '110534118=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110534119=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      
        '110534120=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '110534121=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110534122=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM;'
      
        '110534123=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110534124=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      '110534125=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110534126=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110534127=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110534128=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      '110534129=DECLARE VARIABLE IS_THIS_LAST_ INTEGER;'
      
        '110534130=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110534131=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT;'
      '110534132=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;'
      
        '110534133=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '110534134=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.SUMM_BONUS_GOT;'
      
        '110534135=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110534136=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110534137=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110534138=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110534139=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110534140=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110534141=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110534142=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39';'
      
        '110534143=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIENT' +
        '.G_CLIENT;'
      
        '110534144=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110534145=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110534146=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110534147=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110534148=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110534149=DECLARE VARIABLE SALES_COMM_SUMM_ALL_  TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110534150=DECLARE VARIABLE SALES_COMM_OLD_       TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM;'
      
        '110534151=DECLARE VARIABLE ACTION_DATE_ZP_       TYPE OF COLUMN ' +
        'KASSA.ACTION_DATE;'
      
        '110534152=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.SUMM;'
      
        '110534153=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110534154=BEGIN'
      '110534155='
      '110534156=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110534157=      SELECT Z.G_PAYMENT_TYPE,'
      '110534158=             Z.G_TOCHKA,'
      '110534159=             Z.SUMM,'
      '110534160=             Z.SUMM_BONUS,'
      '110534161=             Z.SUMM_BONUS_GOT,'
      '110534162=             z.g_client,'
      '110534163=             Z.G_OFFICIAL,'
      '110534164=             G.DO_NOT_SALES_COMM,'
      '110534165=             G.FM||'#39#39' '#39#39'||G.NM'
      
        '110534166=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z' +
        '.G_OFFICIAL = G.G_OFFICIAL'
      '110534167=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110534168=        INTO :G_PAYMENT_TYPE_OLD_,'
      '110534169=             :G_TOCHKA_,'
      '110534170=             :SUMM_OLD_,'
      '110534171=             :SUMM_BONUS_OLD_,'
      '110534172=             :SUMM_BONUS_GOT_OLD_,'
      '110534173=             :g_client_old_,'
      '110534174=             :G_OFFICIAL_,'
      '110534175=             :DO_NOT_SALES_COMM_,'
      '110534176=             :OFFICIAL_NAME_;'
      '110534177='
      
        '110534178=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COM' +
        'M_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '110534179=        SELECT SUM(ZD.SALES_COMM)'
      '110534180=          FROM ZAKAZ_DETAILS ZD'
      '110534181=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110534182=          INTO :SALES_COMM_OLD_;'
      '110534183='
      '110534184=      PNT_ = '#39#39'02'#39#39';'
      
        '110534185=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110534186=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534187=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110534188=        EXIT;'
      '110534189=      END'
      '110534190='
      '110534191=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN'
      '110534192=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110534193=      ELSE'
      '110534194=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110534195='
      '110534196=      PNT_ = '#39#39'01'#39#39';'
      '110534197=      UPDATE zakaz'
      '110534198=      SET'
      '110534199=       G_TOCHKA = :G_TOCHKA_,'
      '110534200=       Z_DATE = :Z_DATE_,'
      '110534201=       Z_TIME = :Z_TIME_,'
      '110534202=       G_CLIENT = :G_CLIENT_,'
      '110534203=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110534204=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110534205=       NOTE = COALESCE(:NOTE_, NOTE),'
      '110534206=       SUMM = :SUMM_,'
      '110534207=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '110534208=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ + ' +
        ':SUMM_BONUS_), 1, 0)'
      '110534209=       ,BY_RECIPE = :BY_RECIPE_'
      '110534210=       ,IS_RESERVE = :IS_RESERVE_'
      '110534211=       ,SUMM_BONUS = :SUMM_BONUS_'
      '110534212=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '110534213=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '110534214=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '110534215=      WHERE'
      '110534216=        zakaz = :zakaz_;'
      '110534217='
      '110534218=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '110534219=          UPDATE G_DISCONT_CARD D'
      '110534220=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '110534221=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '110534222=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '110534223='
      '110534224=          SUMM_BONUS_GOT_OLD_ = 0;'
      '110534225=          SUMM_OLD_           = 0;'
      '110534226=      END'
      '110534227=      UPDATE G_DISCONT_CARD D'
      
        '110534228=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM_' +
        'BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '110534229=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :SU' +
        'MM_'
      '110534230=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110534231='
      '110534232=      PNT_ = '#39#39'03'#39#39';'
      '110534233=      FOR SELECT T.ZAKAZ_DETAILS,'
      '110534234=                 T.G_PRODUCT,'
      '110534235=                 T.AMOUNT,'
      '110534236=                 T.SUMM,'
      '110534237=                 G.SALES_COMM'
      '110534238=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '110534239=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '110534240=      INTO :ZAKAZ_DETAILS_,'
      '110534241=           :G_PRODUCT_,'
      '110534242=           :Z_AMOUNT_,'
      '110534243=           :DETAILS_SUMM_,'
      '110534244=           :SALES_COMM_'
      '110534245=      DO BEGIN'
      
        '110534246=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = ' +
        '0) THEN BEGIN'
      
        '110534247=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SALE' +
        'S_COMM_/100;'
      
        '110534248=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110534249=        END'
      '110534250='
      
        '110534251=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110534252=                                   DISCOUNT_TENGE, DIS' +
        'COUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '110534253=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110534254=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS' +
        '_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '110534255=          FROM ZAKAZ_DETAILS_TMP Z'
      '110534256=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '110534257='
      '110534258=        IF (IS_RESERVE_ = 0) THEN'
      '110534259=            UPDATE LT_SKLAD_PRODUCT L'
      '110534260=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '110534261=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534262=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110534263='
      '110534264=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110534265=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110534266=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :Z_AMOUNT_'
      '110534267=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534268=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110534269=      END'
      '110534270='
      '110534271=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '110534272=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      '110534273=                PNT_ = '#39#39'04'#39#39';'
      
        '110534274=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENT' +
        'S_);'
      
        '110534275=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110534276=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110534277=                ELSE'
      
        '110534278=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110534279='
      
        '110534280=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110534281=                    RETURNING_VALUES :KASSA_, :PAYMENT' +
        '_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110534282='
      
        '110534283=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110534284='
      '110534285=                PNT_ = '#39#39'05'#39#39';'
      
        '110534286=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) ' +
        'THEN'
      '110534287=                    EXECUTE PROCEDURE K_INS_KASSA(0,'
      '110534288=                                                  1,'
      
        '110534289=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110534290=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110534291=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110534292=                                                  :ZAK' +
        'AZ_,   --ZAKAZ_'
      
        '110534293=                                                  NULL' +
        ','
      
        '110534294=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110534295=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110534296='
      '110534297=                ELSE BEGIN'
      '110534298=                    SELECT 1'
      '110534299=                      FROM KASSA K'
      '110534300=                     WHERE K.KASSA = :KASSA_'
      '110534301=                    UNION ALL'
      '110534302=                    SELECT 2'
      '110534303=                      FROM KASSA_BEZNAL KB'
      '110534304=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110534305=                     INTO :PAYMENT_TYPE_OLD_;'
      '110534306='
      '110534307=                    PNT_ = '#39#39'06'#39#39';'
      
        '110534308=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_TY' +
        'PE_) THEN'
      
        '110534309=                        EXECUTE PROCEDURE K_UPD_KASSA(' +
        ':KASSA_,'
      
        '110534310=                                                      ' +
        '0,     -- ACTION_'
      
        '110534311=                                                      ' +
        '1,     --:G_PRIHOD_RASHOD_,'
      
        '110534312=                                                      ' +
        ':PAYMENT_SUMM_,'
      
        '110534313=                                                      ' +
        ':PAYMENT_DATE_,'
      
        '110534314=                                                      ' +
        'NULL,   --NOTE_'
      
        '110534315=                                                      ' +
        ':ZAKAZ_,'
      
        '110534316=                                                      ' +
        'NULL,'
      
        '110534317=                                                      ' +
        ':PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '110534318=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110534319=                        PNT_ = '#39#39'07'#39#39';'
      
        '110534320=                        EXECUTE PROCEDURE K_DEL_KASSA(' +
        ':KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_M' +
        'SG);'
      '110534321=                        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534322=                          ERR_MSG = PROCNAME||'#39#39' -> PN' +
        'T_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110534323=                          EXIT;'
      '110534324=                        END'
      '110534325='
      '110534326=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '110534327=                           EXECUTE PROCEDURE K_INS_KAS' +
        'SA(0,     -- ACTION_ => :ACTION_'
      
        '110534328=                                                      ' +
        '    1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110534329=                                                      ' +
        '    :PAYMENT_SUMM_,'
      
        '110534330=                                                      ' +
        '    :PAYMENT_DATE_,'
      
        '110534331=                                                      ' +
        '    NULL,   --NOTE_ => :NOTE_,'
      
        '110534332=                                                      ' +
        '    :ZAKAZ_,   --ZAKAZ_'
      
        '110534333=                                                      ' +
        '    NULL,'
      
        '110534334=                                                      ' +
        '    :PAYMENT_TYPE_,'
      
        '110534335=                                                      ' +
        '    :G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110534336=                    END'
      '110534337=                END'
      '110534338=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534339=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110534340=                  EXIT;'
      '110534341=                END'
      '110534342='
      
        '110534343=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~' +
        #39#39';'
      '110534344=            END'
      '110534345='
      '110534346=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110534347=                FROM KASSA K'
      '110534348=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110534349=                 AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'|' +
        '|K.KASSA||'#39#39'~'#39#39
      '110534350=                UNION'
      '110534351=                SELECT KASSA, 1 PAYMENT_TYPE'
      '110534352=                  FROM KASSA K'
      '110534353=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '110534354=                   AND K.SUMM = 0'
      '110534355=                UNION'
      
        '110534356=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110534357=                FROM KASSA_BEZNAL K'
      '110534358=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110534359=                 AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'|' +
        '|K.KASSA_BEZNAL||'#39#39'~'#39#39
      '110534360=                UNION'
      
        '110534361=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110534362=                FROM KASSA_BEZNAL K'
      '110534363=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110534364=                 AND K.SUMM = 0'
      '110534365=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110534366=            DO BEGIN'
      '110534367=                PNT_ = '#39#39'08'#39#39';'
      
        '110534368=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_,' +
        ' :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110534369=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534370=                    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'|' +
        '|PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110534371=                    EXIT;'
      '110534372=                END'
      '110534373=            END'
      '110534374='
      '110534375=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110534376=                SELECT K.KASSA'
      '110534377=                FROM KASSA K'
      '110534378=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110534379=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110534380=                 INTO :KASSA_POP_;'
      '110534381=            ELSE'
      '110534382=                SELECT K.KASSA_BEZNAL'
      '110534383=                FROM KASSA_BEZNAL K'
      '110534384=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110534385=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110534386=                 INTO :KASSA_POP_;'
      '110534387='
      
        '110534388=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110534389=              PNT_ = '#39#39'09'#39#39';'
      '110534390=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '110534391=                    EXECUTE PROCEDURE K_UPD_KASSA(:KAS' +
        'SA_POP_,'
      
        '110534392=                                                  0,  ' +
        '   -- ACTION_'
      
        '110534393=                                                  :G_P' +
        'RIHOD_,'
      
        '110534394=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110534395=                                                  :Z_D' +
        'ATE_,'
      
        '110534396=                                                  NULL' +
        ',   --NOTE_'
      
        '110534397=                                                  :ZAK' +
        'AZ_,'
      
        '110534398=                                                  NULL' +
        ','
      
        '110534399=                                                  :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110534400=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '110534401=                    PNT_ = '#39#39'10'#39#39';'
      
        '110534402=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_'
      
        '110534403=                                                  :G_P' +
        'RIHOD_,'
      
        '110534404=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110534405=                                                  :Z_D' +
        'ATE_,'
      
        '110534406=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110534407=                                                  :ZAK' +
        'AZ_,'
      
        '110534408=                                                  NULL' +
        ','
      
        '110534409=                                                  :G_P' +
        'AYMENT_TYPE_,'
      
        '110534410=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110534411=              END'
      
        '110534412=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110534413=                PNT_ = '#39#39'11'#39#39';'
      '110534414=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110534415=                    EXECUTE PROCEDURE K_DEL_KASSA(:KAS' +
        'SA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR' +
        '_MSG);'
      '110534416=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534417=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110534418=                      EXIT;'
      '110534419=                    END'
      '110534420='
      '110534421=                    EXECUTE PROCEDURE K_INS_KASSA(0,'
      
        '110534422=                                                  :G_P' +
        'RIHOD_,'
      
        '110534423=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110534424=                                                  :Z_D' +
        'ATE_,'
      
        '110534425=                                                  NULL' +
        ','
      
        '110534426=                                                  :ZAK' +
        'AZ_,'
      
        '110534427=                                                  NULL' +
        ','
      
        '110534428=                                                  :G_P' +
        'AYMENT_TYPE_,'
      
        '110534429=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110534430=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534431=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110534432=                      EXIT;'
      '110534433=                    END'
      '110534434=                END'
      '110534435=            END'
      '110534436=            PNT_ = '#39#39'12'#39#39';'
      
        '110534437=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SAL' +
        'ES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) ' +
        'THEN BEGIN'
      '110534438=                KASSA_ = NULL;'
      '110534439='
      '110534440=                SELECT S.S_VALUE'
      '110534441=                  FROM SYSTEM_SETUP S'
      '110534442=                 WHERE S.SYSTEM_SETUP = 4'
      '110534443=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '110534444='
      '110534445=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110534446=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110534447='
      
        '110534448=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) ' +
        'THEN'
      
        '110534449=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7 ' +
        '- DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKD' +
        'AY FROM CURRENT_DATE)));'
      '110534450='
      '110534451=                ELSE'
      
        '110534452=                   ACTION_DATE_ZP_ = Current_date - EX' +
        'TRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_dat' +
        'e - EXTRACT(DAY FROM current_date) + 32);'
      '110534453='
      '110534454=                SELECT K.KASSA, K.SUMM'
      '110534455=                FROM KASSA K'
      '110534456=                WHERE K.G_PRIHOD_RASHOD = -1'
      '110534457=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110534458=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110534459=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110534460='
      '110534461=                IF (KASSA_ IS NULL) THEN'
      '110534462=                    EXECUTE PROCEDURE K_INS_KASSA(1,'
      '110534463=                                                  -1,'
      
        '110534464=                                                  :SAL' +
        'ES_COMM_SUMM_ALL_,'
      
        '110534465=                                                  :ACT' +
        'ION_DATE_ZP_,'
      
        '110534466=                                                  :OFF' +
        'ICIAL_NAME_,'
      
        '110534467=                                                  NULL' +
        ','
      
        '110534468=                                                  NULL' +
        ','
      '110534469=                                                  1,'
      
        '110534470=                                                  :G_T' +
        'OCHKA_,'
      
        '110534471=                                                  :G_O' +
        'FFICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110534472=                ELSE BEGIN'
      
        '110534473=                    EXECUTE PROCEDURE K_UPD_KASSA(:KAS' +
        'SA_,'
      '110534474=                                                  1,'
      '110534475=                                                  -1,'
      
        '110534476=                                                  :SAL' +
        'ES_COMM_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_ - :SALES_COMM_OLD_,'
      
        '110534477=                                                  :ACT' +
        'ION_DATE_ZP_,'
      
        '110534478=                                                  :OFF' +
        'ICIAL_NAME_,'
      
        '110534479=                                                  NULL' +
        ','
      
        '110534480=                                                  NULL' +
        ','
      '110534481=                                                  1,'
      
        '110534482=                                                  :G_O' +
        'FFICIAL_'
      
        '110534483=                                                  ) RE' +
        'TURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110534484=                END'
      '110534485=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534486=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110534487=                  EXIT;'
      '110534488=                END'
      '110534489=            END'
      '110534490=      END'
      '110534491=  END'
      '110534492=  ELSE BEGIN'
      '110534493=      PNT_ = '#39#39'020'#39#39';'
      '110534494=      SELECT SP.G_TOCHKA,'
      '110534495=             SP.G_CLIENT'
      '110534496=        FROM SKLAD_PARENT SP'
      '110534497=       WHERE SP.SKLAD = :ZAKAZ_'
      '110534498=        INTO :G_TOCHKA_OLD_,'
      '110534499=             :G_TOCHKA_;'
      '110534500='
      '110534501=      PNT_ = '#39#39'021'#39#39';'
      '110534502=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '110534503=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, ' +
        'NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110534504=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534505=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110534506=            EXIT;'
      '110534507=          END'
      '110534508='
      '110534509=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110534510=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110534511=                FROM ZAKAZ_DETAILS_TMP Z'
      '110534512=              INTO :G_PRODUCT_,'
      '110534513=                  :Z_AMOUNT_,'
      '110534514=                  :PRICE_,'
      '110534515=                  :SUMMM_'
      '110534516=          DO BEGIN'
      '110534517=            IS_THIS_LAST_ = 0;'
      '110534518=            SELECT MAX(SK.DATE_RECEIPT)'
      '110534519=                FROM SKLAD SK'
      '110534520=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110534521=                 AND SK.IS_LAST = 1'
      '110534522=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '110534523=                INTO :DATE_LAST_;'
      '110534524='
      
        '110534525=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALESC' +
        'E(DATE_LAST_, CURRENT_DATE))) THEN BEGIN'
      '110534526=                UPDATE SKLAD SK'
      '110534527=                   SET SK.IS_LAST = 0'
      '110534528=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110534529=                   AND SK.IS_LAST = 1'
      '110534530=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '110534531='
      '110534532=                IS_THIS_LAST_ = 1;'
      '110534533=            END'
      '110534534='
      '110534535='
      '110534536=            INSERT INTO SKLAD'
      '110534537=            ('
      '110534538=             SKLAD,'
      '110534539=             SKLAD_PARENT,'
      '110534540=             DATE_RECEIPT,'
      '110534541=             G_CLIENT,'
      '110534542=             G_PRODUCT,'
      '110534543=             AMOUNT,'
      '110534544=             PRICE,'
      '110534545=             SUMM,'
      '110534546=             G_PAYMENT_TYPE,'
      '110534547=             OSNOVANIE,'
      '110534548=             NOTE,'
      '110534549=             NDS,'
      '110534550=             NDS_SUMM,'
      '110534551=             IS_LAST,'
      '110534552=             IS_VOZVRAT,'
      '110534553=             G_TOCHKA'
      '110534554=            ) VALUES ('
      '110534555=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '110534556=             :ZAKAZ_,'
      '110534557=             :Z_DATE_,'
      '110534558=             :G_TOCHKA_,'
      '110534559=             :G_PRODUCT_,'
      '110534560=             :Z_AMOUNT_,'
      '110534561=             :PRICE_,'
      '110534562=             :SUMMM_,'
      '110534563=             :G_PAYMENT_TYPE_,'
      '110534564=             :OSNOVANIE_,'
      '110534565=             :NOTE_,'
      '110534566=             0,  --:RNDS_,'
      '110534567=             0,  --:RNDS_SUMM_,'
      '110534568=             DECODE(:IS_THIS_LAST_, 1, 1, 0),'
      '110534569=             3,  --:IS_VOZVRAT_,'
      '110534570=             :G_CLIENT_'
      '110534571=            );'
      '110534572=            PNT_ = '#39#39'023'#39#39';'
      '110534573=            UPDATE LT_SKLAD_PRODUCT L'
      '110534574=               SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '110534575=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534576=               AND L.G_TOCHKA = :G_CLIENT_;'
      '110534577='
      '110534578=            IF (ROW_COUNT = 0) THEN'
      
        '110534579=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD' +
        '_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110534580=          END'
      '110534581=      END'
      '110534582=      ELSE BEGIN'
      '110534583=          PNT_ = '#39#39'025'#39#39';'
      '110534584=          FOR SELECT SKLAD,'
      '110534585=                     AMOUNT,'
      '110534586=                     G_PRODUCT'
      '110534587=                FROM SKLAD S'
      '110534588=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '110534589=                 AND NOT EXISTS (SELECT 1'
      
        '110534590=                                   FROM ZAKAZ_DETAILS_' +
        'TMP T'
      
        '110534591=                                  WHERE T.ZAKAZ_DETAIL' +
        'S = S.SKLAD)'
      '110534592=          INTO :SKLAD_,'
      '110534593=               :Z_AMOUNT_,'
      '110534594=               :G_PRODUCT_'
      '110534595=          DO BEGIN'
      
        '110534596=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110534597=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110534598=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110534599=              EXIT;'
      '110534600=            END'
      '110534601=          END'
      '110534602='
      '110534603=          PNT_ = '#39#39'030'#39#39';'
      '110534604=          FOR SELECT S.ZAKAZ_DETAILS,'
      '110534605=                     S.G_PRODUCT,'
      '110534606=                     S.AMOUNT,'
      '110534607=                     S.PRICE,'
      '110534608=                     S.SUMM,'
      '110534609=                     T.SKLAD,'
      '110534610=                     T.AMOUNT,'
      '110534611=                     T.IS_LAST,'
      '110534612=                     T.DATE_RECEIPT'
      
        '110534613=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER JO' +
        'IN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE' +
        ' SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '110534614=                INTO :ZAKAZ_DETAILS_,'
      '110534615=                     :G_PRODUCT_,'
      '110534616=                     :Z_AMOUNT_,'
      '110534617=                     :PRICE_,'
      '110534618=                     :SUMMM_,'
      '110534619=                     :SKLAD_OLD_,'
      '110534620=                     :AMOUNT_OLD_,'
      '110534621=                     :IS_THIS_LAST_,'
      '110534622=                     :DATE_RECEIPT_OLD_'
      '110534623=          DO BEGIN'
      '110534624=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '110534625=                INSERT INTO SKLAD (SKLAD, SKLAD_PARENT' +
        ', DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYM' +
        'ENT_TYPE, NDS, NDS_SUMM,'
      
        '110534626=                                  IS_LAST, NOTE, OSNOV' +
        'ANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '110534627=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :Z' +
        'AKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, :' +
        'SUMMM_, 1, 0, 0,'
      
        '110534628=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047 +
        #1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '110534629=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_CL' +
        'IENT_'
      '110534630=                       )'
      '110534631=                RETURNING'
      '110534632=                  SKLAD'
      '110534633=                INTO'
      '110534634=                  :SKLAD_;'
      '110534635='
      
        '110534636=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055 +
        #1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110534637=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110534638=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT' +
        '_'
      '110534639=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534640=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110534641='
      
        '110534642=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055 +
        #1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110534643=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110534644=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT' +
        '_'
      '110534645=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534646=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '110534647='
      '110534648=                IF (ROW_COUNT = 0) THEN'
      
        '110534649=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_S' +
        'KLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110534650='
      '110534651=                SELECT MAX(SK.DATE_RECEIPT)'
      '110534652=                  FROM SKLAD SK'
      '110534653=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110534654=                   AND SK.IS_LAST = 1'
      '110534655=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '110534656=                  INTO :DATE_LAST_;'
      '110534657='
      
        '110534658=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ >' +
        '= DATE_LAST_)) THEN BEGIN'
      '110534659=                  UPDATE SKLAD SK'
      '110534660=                     SET SK.IS_LAST = 0'
      '110534661=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110534662=                     AND SK.IS_LAST = 1'
      '110534663=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '110534664='
      '110534665=                  UPDATE SKLAD SK'
      '110534666=                     SET SK.IS_LAST = 1'
      '110534667=                   WHERE SK.SKLAD = :SKLAD_;'
      '110534668=                END'
      '110534669=            END ELSE BEGIN'
      '110534670=                UPDATE SKLAD S'
      '110534671=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '110534672=                       S.AMOUNT   = :Z_AMOUNT_,'
      '110534673=                       S.PRICE    = :PRICE_,'
      '110534674=                       S.SUMM     = :SUMMM_,'
      '110534675=                       S.OSNOVANIE = :OSNOVANIE_,'
      '110534676=                       S.NOTE      = :NOTE_'
      '110534677=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '110534678='
      '110534679='
      
        '110534680=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN BEGI' +
        'N'
      '110534681=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110534682=                     SET L.AMOUNT = L.AMOUNT + (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110534683=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534684=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110534685='
      '110534686=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110534687=                     SET L.AMOUNT = L.AMOUNT - (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110534688=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534689=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110534690='
      
        '110534691=                END ELSE if (Z_AMOUNT_ > AMOUNT_OLD_) ' +
        'THEN BEGIN'
      '110534692=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110534693=                     SET L.AMOUNT = L.AMOUNT - (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110534694=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534695=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110534696='
      '110534697=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110534698=                     SET L.AMOUNT = L.AMOUNT + (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110534699=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110534700=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110534701=                END'
      '110534702='
      
        '110534703=                IF ((Z_DATE_ > DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0)) THEN BEGIN'
      '110534704=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110534705=                      FROM SKLAD SK'
      '110534706=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110534707=                       AND SK.IS_LAST = 1'
      '110534708=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110534709=                      INTO :DATE_LAST_;'
      '110534710='
      
        '110534711=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ > DATE_LAST_)) THEN BEGIN'
      '110534712=                      UPDATE SKLAD SK'
      '110534713=                         SET SK.IS_LAST = 0'
      
        '110534714=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      '110534715=                         AND SK.IS_LAST = 1'
      '110534716=                         AND SK.G_TOCHKA = :G_CLIENT_;'
      '110534717='
      '110534718=                      UPDATE SKLAD SK'
      '110534719=                         SET SK.IS_LAST = 1'
      
        '110534720=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110534721=                    END'
      '110534722=                END'
      '110534723='
      
        '110534724=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 1)) THEN BEGIN'
      '110534725=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110534726=                      FROM SKLAD SK'
      '110534727=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110534728=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '110534729=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110534730=                       AND SK.is_vozvrat IN (0,3,4)'
      '110534731=                      INTO :DATE_LAST_;'
      '110534732='
      
        '110534733=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110534734=                      UPDATE SKLAD SK'
      '110534735=                         SET SK.IS_LAST = 0'
      
        '110534736=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110534737='
      '110534738=                       UPDATE SKLAD SK'
      '110534739=                         SET SK.IS_LAST = 1'
      
        '110534740=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      
        '110534741=                         AND SK.SKLAD = (SELECT MAX(SS' +
        '.SKLAD)'
      
        '110534742=                                           FROM SKLAD ' +
        'SS'
      
        '110534743=                                          WHERE SS.G_P' +
        'RODUCT = SK.G_PRODUCT'
      
        '110534744=                                            AND SS.DAT' +
        'E_RECEIPT = :DATE_LAST_'
      
        '110534745=                                            AND SS.G_T' +
        'OCHKA = :G_CLIENT_'
      
        '110534746=                                            AND SS.is_' +
        'vozvrat IN (0,3,4));'
      '110534747=                    END'
      '110534748=                END'
      '110534749=            END'
      '110534750=          END'
      '110534751=      END'
      '110534752='
      '110534753=      UPDATE SKLAD_PARENT'
      '110534754=      SET'
      
        '110534755=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110534756=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      '110534757=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),'
      '110534758=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110534759=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110534760=       SUMM      = :SUMM_,'
      '110534761=       SUMM_FACT = :SUMM_FACT_'
      '110534762=      WHERE SKLAD  = :ZAKAZ_;'
      '110534763=  END'
      '110534764='
      '110534765=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110534766=END'
      '110534767='#39';'
      '110534768=END  --END_EXECUTE_BLOCK'
      '110534769=EXECUTE BLOCK AS BEGIN'
      '110534770='
      '110534771=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '110534772=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110534773=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110534774=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110534775=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110534776=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110534777=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110534778=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110534779=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110534780=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110534781=  SELF_PRICE_ NUMERIC(15,2),'
      '110534782=  AMOUNT_ MY_NUMERIC_5,'
      '110534783=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110534784=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110534785=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110534786=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110534787=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '110534788=  IS_THIS_LAST_ INTEGER,'
      '110534789=  UPDATE_IF_EXIST_ INTEGER)'
      '110534790=RETURNS ('
      '110534791=  ERR_CODE INTEGER,'
      '110534792=  ERR_MSG VARCHAR(1024))'
      '110534793=AS'
      
        '110534794=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'G_IMPORT_G_P' +
        'RODUCT'#39#39';'
      '110534795=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110534796=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '110534797=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110534798=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110534799=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110534800=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110534801=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      '110534802=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110534803=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110534804=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110534805=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110534806=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110534807=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110534808=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '110534809=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110534810=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '110534811=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110534812=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110534813=BEGIN'
      '110534814=    ERR_MSG = '#39#39#39#39';'
      '110534815='
      '110534816=    SELECT ID'
      '110534817=      FROM CUR_PARAMS'
      '110534818=    WHERE CUR_PARAMS = 2'
      '110534819=      INTO :G_TOCHKA_;'
      '110534820='
      '110534821=    SELECT G.G_UNIT'
      '110534822=      FROM G_UNIT G'
      
        '110534823=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME' +
        '_G_UNIT_))'
      '110534824=      INTO :G_UNIT_;'
      '110534825=    if (ROW_COUNT = 0) then'
      '110534826=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110534827='
      '110534828=    PNT_ = '#39#39'02'#39#39';'
      
        '110534829=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110534830=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '110534831=        SELECT G.G_PRODUCT,'
      '110534832=               G.NAME'
      '110534833=          FROM G_PRODUCT G'
      
        '110534834=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110534835=           AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '110534836=          INTO :G_PRODUCT_,'
      '110534837=               :G_PRODUCT_NAME_;'
      '110534838='
      
        '110534839=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110534840=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110534841=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110534842=              UPDATE G_PRODUCT G'
      '110534843=                 SET G.NAME = :NAME_,'
      '110534844=                     G.G_UNIT = :G_UNIT_,'
      '110534845=                     G.PRICE  = :PRICE_,'
      '110534846=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110534847=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110534848=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110534849=                     G.PLACE = :PLACE_,'
      
        '110534850=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110534851=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110534852=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '110534853=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110534854='
      
        '110534855=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39 +
        #39'||UPPER(TRIM(:ARTICUL_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '110534856=            END ELSE'
      
        '110534857=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110534858=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODUCT_' +
        'NAME_||'#39#39'.'#39#39';'
      '110534859=        END'
      '110534860=    END ELSE'
      
        '110534861=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110534862='
      
        '110534863=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110534864=    PNT_ = '#39#39'02a'#39#39';'
      
        '110534865=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110534866=        SELECT G.G_PRODUCT,'
      '110534867=               G.NAME'
      '110534868=          FROM G_PRODUCT G'
      
        '110534869=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110534870=           AND TRIM(G.nomenclatur_num) <> '#39#39#39#39
      '110534871=          INTO :G_PRODUCT_,'
      '110534872=               :G_PRODUCT_NAME_;'
      '110534873='
      
        '110534874=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110534875=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110534876=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110534877=              UPDATE G_PRODUCT G'
      '110534878=                 SET G.NAME = :NAME_,'
      '110534879=                     G.G_UNIT = :G_UNIT_,'
      '110534880=                     G.PRICE  = :PRICE_,'
      '110534881=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110534882=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110534883=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110534884=                     G.PLACE = :PLACE_,'
      
        '110534885=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110534886=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110534887=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '110534888=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110534889='
      
        '110534890=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099 +
        '.'#39#39';'
      '110534891=            END ELSE'
      
        '110534892=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110534893=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077 +
        ' - '#39#39'||G_PRODUCT_NAME_||'#39#39'.'#39#39';'
      '110534894=        END'
      '110534895=    end'
      '110534896='
      
        '110534897=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110534898=    PNT_ = '#39#39'02b'#39#39';'
      
        '110534899=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110534900=        SELECT G.G_PRODUCT,'
      '110534901=               G.NAME'
      '110534902=          FROM G_PRODUCT G'
      '110534903=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110534904=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '110534905=          INTO :G_PRODUCT_,'
      '110534906=               :G_PRODUCT_NAME_;'
      '110534907='
      '110534908=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110534909=          SELECT G.G_PRODUCT,'
      '110534910=                 G.NAME'
      '110534911=            FROM G_PRODUCT G, LT_BARCODE L'
      '110534912=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110534913=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110534914=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '110534915=            INTO :G_PRODUCT_,'
      '110534916=                 :G_PRODUCT_NAME_;'
      '110534917='
      
        '110534918=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110534919=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110534920=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110534921=              UPDATE G_PRODUCT G'
      '110534922=                 SET G.NAME = :NAME_,'
      '110534923=                     G.G_UNIT = :G_UNIT_,'
      '110534924=                     G.PRICE  = :PRICE_,'
      '110534925=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110534926=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110534927=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110534928=                     G.PLACE = :PLACE_,'
      
        '110534929=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110534930=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110534931=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '110534932=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110534933='
      
        '110534934=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '110534935=            END ELSE'
      
        '110534936=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110534937=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODU' +
        'CT_NAME_||'#39#39'.'#39#39';'
      '110534938=        END'
      
        '110534939=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110534940=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110534941='
      '110534942=    PNT_ = '#39#39'02b'#39#39';'
      '110534943=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '110534944=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110534945=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE)'
      
        '110534946=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_P' +
        'AR_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, ' +
        ':PRICE_,'
      
        '110534947=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_)'
      '110534948=        returning G_PRODUCT'
      '110534949=        into :G_PRODUCT_;'
      '110534950='
      
        '110534951=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110534952=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110534953=    end'
      '110534954='
      
        '110534955=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110534956=    PNT_ = '#39#39'03'#39#39';'
      '110534957=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110534958=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110534959=                                       :AMOUNT_,'
      '110534960=                                       :SELF_PRICE_,'
      
        '110534961=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110534962=                                       0, --nds_,'
      '110534963=                                       0 --nds_summ_,'
      
        '110534964=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110534965=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110534966=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110534967=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110534968=          ERR_MSG  = '#39#39' PNT_ '#39#39'||PNT_||'#39#39' -> '#39#39'||ERR_M' +
        'SG;'
      '110534969=          EXIT;'
      '110534970=        END'
      '110534971=    END'
      '110534972='
      
        '110534973=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110534974=    PNT_ = '#39#39'04'#39#39';'
      '110534975=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110534976=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110534977=        FROM SKLAD_TMP T'
      '110534978=        INTO :CNT_;'
      '110534979='
      '110534980=      if (CNT_ > 0) then BEGIN'
      '110534981=        SELECT SUM(T.SUMM)'
      '110534982=          FROM SKLAD_TMP T'
      '110534983=          INTO :SUMM_;'
      '110534984='
      '110534985=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110534986=                                DATE_RECEIPT,'
      '110534987=                                TIME_RECEIPT,'
      '110534988=                                G_CLIENT,'
      '110534989=                                G_PAYMENT_TYPE,'
      '110534990=                                OSNOVANIE,'
      '110534991=                                NOTE,'
      '110534992=                                SUMM,'
      '110534993=                                SUMM_FACT,'
      '110534994=                                IS_PAYED_ALL,'
      '110534995=                                IS_VOZVRAT,'
      '110534996=                                G_TOCHKA)'
      '110534997=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110534998=                CURRENT_DATE,'
      '110534999=                CURRENT_TIME,'
      '110535000=                :G_CLIENT_,'
      '110535001=                1,'
      '110535002=                NULL,  --:OSNOVANIE_,'
      '110535003=                NULL,  -- :NOTE_,'
      '110535004=                :SUMM_,'
      '110535005=                :SUMM_,'
      
        '110535006=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110535007=                0,'
      '110535008=                :G_TOCHKA_)'
      '110535009=        RETURNING'
      '110535010=          SKLAD'
      '110535011=        INTO'
      '110535012=          :SKLAD_PARENT_;'
      '110535013='
      '110535014=        PNT_ = '#39#39'05'#39#39';'
      '110535015=        FOR SELECT SKLAD,'
      '110535016=                   G_PRODUCT,'
      '110535017=                   AMOUNT,'
      '110535018=                   PRICE,'
      '110535019=                   SUMM'
      '110535020=                   ,PRICE_CURRENCY'
      '110535021=                   ,SUMM_CURRENCY'
      '110535022=              FROM SKLAD_TMP'
      '110535023=             ORDER BY 1'
      '110535024=              INTO :SKLAD_TMP_,'
      '110535025=                   :RG_PRODUCT_,'
      '110535026=                   :RAMOUNT_,'
      '110535027=                   :RPRICE_,'
      '110535028=                   :RSUMM_'
      '110535029=                   ,:RPRICE_UE_'
      '110535030=                   ,:RSUMM_UE_'
      '110535031=        DO BEGIN'
      '110535032='
      '110535033=            UPDATE SKLAD SK'
      '110535034=               SET SK.IS_LAST = 0'
      '110535035=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110535036=               AND SK.IS_LAST = 1;'
      '110535037='
      '110535038=            INSERT INTO SKLAD'
      '110535039=            ('
      '110535040=             SKLAD,'
      '110535041=             SKLAD_PARENT,'
      '110535042=             DATE_RECEIPT,'
      '110535043=             G_CLIENT,'
      '110535044=             G_PRODUCT,'
      '110535045=             AMOUNT,'
      '110535046=             PRICE,'
      '110535047=             SUMM,'
      '110535048=             G_PAYMENT_TYPE,'
      '110535049=             OSNOVANIE,'
      '110535050=             NOTE,'
      '110535051=             NDS,'
      '110535052=             NDS_SUMM,'
      '110535053=             IS_LAST,'
      '110535054=             IS_VOZVRAT,'
      '110535055=             G_TOCHKA'
      '110535056=             ,PRICE_CURRENCY'
      '110535057=             ,SUMM_CURRENCY'
      '110535058=            ) VALUES ('
      '110535059=             :SKLAD_TMP_,'
      '110535060=             :SKLAD_PARENT_,'
      '110535061=             CURRENT_DATE,'
      '110535062=             :G_CLIENT_,'
      '110535063=             :RG_PRODUCT_,'
      '110535064=             :RAMOUNT_,'
      '110535065=             :RPRICE_,'
      '110535066=             :RSUMM_,'
      '110535067=             1,       --:G_PAYMENT_TYPE_,'
      '110535068=             NULL,    --:OSNOVANIE_,'
      '110535069=             NULL,    --:NOTE_,'
      '110535070=             0,       --:RNDS_,'
      '110535071=             0,       --:RNDS_SUMM_,'
      '110535072=             1,       --IS_LAST_'
      '110535073=             0,        --:IS_VOZVRAT_'
      '110535074=             :G_TOCHKA_'
      '110535075=             ,:RPRICE_UE_'
      '110535076=             ,:RSUMM_UE_'
      '110535077=            );'
      '110535078='
      '110535079=            PNT_ = '#39#39'06'#39#39';'
      '110535080=            UPDATE LT_SKLAD_PRODUCT L'
      '110535081=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110535082=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110535083=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110535084='
      '110535085=            PNT_ = '#39#39'06a'#39#39';'
      '110535086=            IF (ROW_COUNT = 0) THEN'
      
        '110535087=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110535088=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110535089=        END'
      '110535090='
      '110535091=        PNT_ = '#39#39'07'#39#39';'
      
        '110535092=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110535093=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110535094=                                :SUMM_,'
      '110535095=                                CURRENT_DATE,'
      
        '110535096=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110535097=                                NULL,   --ZAKAZ_'
      '110535098=                                :SKLAD_PARENT_,'
      '110535099=                                1,'
      
        '110535100=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535101=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535102=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110535103=          EXIT;'
      '110535104=        END'
      '110535105='
      '110535106=        DELETE FROM SKLAD_TMP;'
      '110535107=      END'
      '110535108=    END'
      '110535109='
      '110535110=    if (ERR_MSG_ IS NOT NULL) then'
      '110535111=      ERR_MSG = ERR_MSG_;'
      '110535112='
      '110535113=WHEN ANY DO BEGIN'
      '110535114=    Err_code = gdscode;'
      
        '110535115=    ERR_MSG = '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39#39'||gdscode||'#39 +
        #39' --> PNT_ '#39#39'||PNT_;'
      '110535116=  END'
      '110535117=END'
      '110535118='#39';'
      '110535119='
      '110535120=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD('
      '110535121=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110535122=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110535123=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110535124=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110535125=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110535126=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110535127=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110535128=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110535129=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110535130=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110535131=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110535132=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110535133=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110535134=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110535135=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110535136=RETURNS ('
      '110535137=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110535138=  ERR_CODE INTEGER,'
      '110535139=  ERR_MSG VARCHAR(1024))'
      '110535140=AS'
      
        '110535141=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD'#39#39 +
        ';'
      '110535142=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110535143=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110535144=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110535145=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110535146=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110535147=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110535148=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110535149=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110535150=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110535151=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110535152=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT;'
      '110535153=DECLARE VARIABLE IS_THIS_LAST_ INTEGER;'
      
        '110535154=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110535155=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110535156=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110535157=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110535158=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110535159=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110535160=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110535161=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110535162=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110535163=BEGIN'
      '110535164='
      '110535165=  PNT_ = '#39#39'00'#39#39';'
      '110535166=  IS_THIS_LAST_ = 0;'
      '110535167='
      '110535168=  IF (G_TOCHKA_ IS NULL) THEN'
      '110535169=    SELECT ID'
      '110535170=      FROM CUR_PARAMS'
      '110535171=     WHERE CUR_PARAMS = 2'
      '110535172=      INTO :G_TOCHKA_;'
      '110535173='
      '110535174=  SELECT ID'
      '110535175=    FROM CUR_PARAMS'
      '110535176=   WHERE CUR_PARAMS = 1'
      '110535177=    INTO :G_OFFICIAL_;'
      '110535178='
      '110535179=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110535180=                            DATE_RECEIPT,'
      '110535181=                            TIME_RECEIPT,'
      '110535182=                            G_CLIENT,'
      '110535183=                            G_PAYMENT_TYPE,'
      '110535184=                            OSNOVANIE,'
      '110535185=                            NOTE,'
      '110535186=                            SUMM,'
      '110535187=                            SUMM_FACT,'
      '110535188=                            SUMM_CURRENCY,'
      '110535189=                            IS_PAYED_ALL,'
      '110535190=                            IS_VOZVRAT,'
      '110535191=                            G_TOCHKA'
      '110535192=                            ,G_OFFICIAL'
      '110535193=                            ,IS_EXPECTED)'
      '110535194=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110535195=          :DATE_RECEIPT_,'
      '110535196=          :TIME_RECEIPT_,'
      '110535197=          :G_CLIENT_,'
      '110535198=          :G_PAYMENT_TYPE_,'
      '110535199=          :OSNOVANIE_,'
      '110535200=          :NOTE_,'
      '110535201=          :SUMM_,'
      '110535202=          :SUMM_FACT_,'
      '110535203=          :SUMM_CURRENCY_,'
      '110535204=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),'
      '110535205=          :IS_VOZVRAT_,'
      '110535206=          :G_TOCHKA_'
      '110535207=          ,:G_OFFICIAL_'
      '110535208=          ,:IS_EXPECTED_)'
      '110535209=  RETURNING'
      '110535210=    SKLAD'
      '110535211=  INTO'
      '110535212=    :SKLAD_;'
      '110535213='
      '110535214=  PNT_ = '#39#39'01'#39#39';'
      '110535215=  FOR SELECT SKLAD,'
      '110535216=             G_PRODUCT,'
      '110535217=             AMOUNT,'
      '110535218=             PRICE,'
      '110535219=             SUMM,'
      '110535220=             NDS,'
      '110535221=             NDS_SUMM'
      '110535222=             ,PRICE_CURRENCY'
      '110535223=             ,SUMM_CURRENCY'
      '110535224=        FROM SKLAD_TMP'
      '110535225=      ORDER BY 1'
      '110535226=      INTO :SKLAD_TMP_,'
      '110535227=           :RG_PRODUCT_,'
      '110535228=           :RAMOUNT_,'
      '110535229=           :RPRICE_,'
      '110535230=           :RSUMM_,'
      '110535231=           :RNDS_,'
      '110535232=           :RNDS_SUMM_'
      '110535233=           ,:PRICE_CURRENCY_'
      '110535234=           ,:SUMM_CURRENCY_TMP_'
      '110535235=  DO BEGIN'
      '110535236=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      '110535237=      IS_THIS_LAST_ = 0;'
      '110535238=      SELECT MAX(SK.DATE_RECEIPT)'
      '110535239=        FROM SKLAD SK'
      '110535240=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110535241=         AND SK.IS_LAST = 1'
      '110535242=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110535243=        INTO :DATE_LAST_;'
      '110535244='
      
        '110535245=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN'
      '110535246=        UPDATE SKLAD SK'
      '110535247=           SET SK.IS_LAST = 0'
      '110535248=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110535249=           AND SK.IS_LAST = 1'
      '110535250=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110535251='
      '110535252=        IS_THIS_LAST_ = 1;'
      '110535253=      END'
      '110535254=    END'
      '110535255='
      '110535256=    INSERT INTO SKLAD'
      '110535257=    ('
      '110535258=     SKLAD,'
      '110535259=     SKLAD_PARENT,'
      '110535260=     DATE_RECEIPT,'
      '110535261=     G_CLIENT,'
      '110535262=     G_PRODUCT,'
      '110535263=     AMOUNT,'
      '110535264=     PRICE,'
      '110535265=     SUMM,'
      '110535266=     G_PAYMENT_TYPE,'
      '110535267=     OSNOVANIE,'
      '110535268=     NOTE,'
      '110535269=     NDS,'
      '110535270=     NDS_SUMM,'
      '110535271=     IS_LAST,'
      '110535272=     IS_VOZVRAT,'
      '110535273=     G_TOCHKA'
      '110535274=     ,PRICE_CURRENCY'
      '110535275=     ,SUMM_CURRENCY'
      '110535276=    ) VALUES ('
      '110535277=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110535278=     :SKLAD_,'
      '110535279=     :DATE_RECEIPT_,'
      '110535280=     :G_CLIENT_,'
      '110535281=     :RG_PRODUCT_,'
      '110535282=     :RAMOUNT_,'
      '110535283=     :RPRICE_,'
      '110535284=     :RSUMM_,'
      '110535285=     :G_PAYMENT_TYPE_,'
      '110535286=     :OSNOVANIE_,'
      '110535287=     :NOTE_,'
      '110535288=     :RNDS_,'
      '110535289=     :RNDS_SUMM_,'
      '110535290=     DECODE(:IS_THIS_LAST_, 1, 1, 0),'
      '110535291=     :IS_VOZVRAT_,'
      '110535292=     :G_TOCHKA_'
      '110535293=     ,:PRICE_CURRENCY_'
      '110535294=     ,:SUMM_CURRENCY_TMP_'
      '110535295=    );'
      '110535296='
      
        '110535297=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '110535298=        PNT_ = '#39#39'02'#39#39';'
      '110535299=        UPDATE LT_SKLAD_PRODUCT L'
      '110535300=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110535301=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110535302=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110535303='
      '110535304=        IF (ROW_COUNT = 0) THEN'
      
        '110535305=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110535306=    END'
      '110535307=  END'
      '110535308=  PNT_ = '#39#39'05'#39#39';'
      
        '110535309=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110535310=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110535311=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110535312=      ELSE'
      '110535313=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110535314='
      '110535315=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110535316=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110535317=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110535318=                                        :SUMM_FACT_,'
      
        '110535319=                                        :DATE_RECEIPT_' +
        ','
      
        '110535320=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110535321=                                        NULL,   --ZAKA' +
        'Z_'
      '110535322=                                        :SKLAD_,'
      
        '110535323=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110535324=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535325=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535326=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110535327=            EXIT;'
      '110535328=          END'
      '110535329=      END ELSE BEGIN'
      '110535330=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110535331=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110535332=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110535333=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110535334=            ELSE'
      
        '110535335=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110535336='
      '110535337=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110535338=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110535339='
      
        '110535340=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110535341='
      '110535342=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110535343=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110535344=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110535345=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110535346=                                              :PAYMENT' +
        '_DATE_,'
      
        '110535347=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110535348=                                              NULL,   ' +
        '--ZAKAZ_'
      '110535349=                                              :SKLAD_,'
      
        '110535350=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110535351=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535352=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535353=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110535354=                  EXIT;'
      '110535355=                END'
      '110535356=            END'
      '110535357=          END'
      '110535358=      END'
      '110535359=  END'
      '110535360='
      '110535361=  DELETE FROM SKLAD_TMP;'
      '110535362='
      '110535363=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110535364=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110535365=                                  G_PRIHOD_,'
      '110535366=                                  :SUMM_PRIHOD_,'
      '110535367=                                  :DATE_RECEIPT_,'
      
        '110535368=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110535369=                                  NULL,   --:ZAKAZ_,'
      '110535370=                                  :SKLAD_,'
      '110535371=                                  :G_PAYMENT_TYPE_,'
      
        '110535372=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535373=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535374=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110535375=      EXIT;'
      '110535376=    END'
      '110535377=  END'
      '110535378=end'
      '110535379='#39';'
      '110535380='
      '110535381=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD('
      '110535382=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110535383=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '110535384=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110535385=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110535386=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110535387=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110535388=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110535389=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110535390=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '110535391=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110535392=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110535393=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110535394=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110535395=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110535396=RETURNS ('
      '110535397=  ERR_CODE INTEGER,'
      '110535398=  ERR_MSG VARCHAR(1024))'
      '110535399=AS'
      
        '110535400=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110535401=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110535402=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      '110535403=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110535404=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110535405=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLAD' +
        '_PARENT.IS_EXPECTED;'
      
        '110535406=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110535407=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110535408=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110535409=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      '110535410=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110535411=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '110535412=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '110535413=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110535414=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110535415=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN SK' +
        'LAD.G_PAYMENT_TYPE;'
      
        '110535416=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLAD' +
        '.G_PAYMENT_TYPE;'
      
        '110535417=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT;'
      '110535418=DECLARE VARIABLE IS_THIS_LAST_ INTEGER;'
      
        '110535419=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110535420=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110535421=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110535422=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110535423=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110535424=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110535425=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110535426=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110535427=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39';'
      
        '110535428=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110535429=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      '110535430=BEGIN'
      '110535431='
      '110535432=  IS_THIS_LAST_ = 0;'
      '110535433='
      '110535434=  SELECT S.G_TOCHKA,'
      '110535435=         S.IS_VOZVRAT,'
      '110535436=         S.G_PAYMENT_TYPE'
      '110535437=         ,S.is_expected'
      '110535438=    FROM SKLAD_parent S'
      '110535439=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '110535440=    INTO :G_TOCHKA_,'
      '110535441=         :IS_VOZVRAT_,'
      '110535442=         :G_PAYMENT_TYPE_OLD_'
      '110535443=         ,:IS_EXPECTED_OLD_;'
      '110535444='
      '110535445=  PNT_ = '#39#39'00'#39#39';'
      '110535446=  UPDATE SKLAD_PARENT'
      '110535447=  SET'
      
        '110535448=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEIP' +
        'T),'
      
        '110535449=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEIP' +
        'T),'
      
        '110535450=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYME' +
        'NT_TYPE),'
      '110535451=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110535452=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110535453=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '110535454=   SUMM      = :SUMM_,'
      '110535455=   SUMM_FACT = :SUMM_FACT_,'
      '110535456=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      '110535457=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0)'
      '110535458=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '110535459=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '110535460='
      '110535461=  PNT_ = '#39#39'02'#39#39';'
      '110535462=  FOR SELECT SKLAD'
      '110535463=        FROM SKLAD S'
      '110535464=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110535465=         AND NOT EXISTS (SELECT 1'
      '110535466=                           FROM SKLAD_TMP T'
      '110535467=                        WHERE T.SKLAD = S.SKLAD)'
      '110535468=  INTO :SKLAD_'
      '110535469=  DO BEGIN'
      
        '110535470=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_,' +
        ' :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110535471=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535472=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110535473=      EXIT;'
      '110535474=    END'
      '110535475=  END'
      '110535476=  PNT_ = '#39#39'03'#39#39';'
      '110535477=  FOR SELECT S.SKLAD,'
      '110535478=             S.G_PRODUCT,'
      '110535479=             S.AMOUNT,'
      '110535480=             S.PRICE,'
      '110535481=             S.SUMM,'
      '110535482=             S.NDS,'
      '110535483=             S.NDS_SUMM,'
      '110535484=             T.SKLAD,'
      '110535485=             T.AMOUNT,'
      '110535486=             T.IS_LAST,'
      '110535487=             T.DATE_RECEIPT'
      '110535488=             ,S.PRICE_CURRENCY'
      '110535489=             ,S.SUMM_CURRENCY'
      
        '110535490=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLAD' +
        ', AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT = ' +
        ':SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '110535491=  INTO :SKLAD_,'
      '110535492=       :G_PRODUCT_,'
      '110535493=       :AMOUNT_,'
      '110535494=       :PRICE_,'
      '110535495=       :SUMM_ONE_,'
      '110535496=       :NDS_,'
      '110535497=       :NDS_SUMM_,'
      '110535498=       :SKLAD_OLD_,'
      '110535499=       :AMOUNT_OLD_,'
      '110535500=       :IS_THIS_LAST_,'
      '110535501=       :DATE_RECEIPT_OLD_'
      '110535502=       ,:PRICE_CURRENCY_'
      '110535503=       ,:SUMM_CURRENCY_TMP_'
      '110535504=  DO BEGIN'
      '110535505=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '110535506=        PNT_ = '#39#39'04'#39#39';'
      
        '110535507=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_R' +
        'ECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYPE' +
        ', NDS, NDS_SUMM,'
      
        '110535508=                          IS_LAST, NOTE, OSNOVANIE, IS' +
        '_VOZVRAT, G_TOCHKA'
      '110535509=                          ,PRICE_CURRENCY'
      '110535510=                          ,SUMM_CURRENCY)'
      
        '110535511=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIPT' +
        '_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_PA' +
        'YMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      '110535512=               0'
      
        '110535513=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :G' +
        '_TOCHKA_'
      '110535514=               ,:PRICE_CURRENCY_'
      '110535515=               ,:SUMM_CURRENCY_TMP_'
      '110535516=               );'
      '110535517='
      '110535518=        IF (IS_EXPECTED_ = 0) THEN BEGIN'
      '110535519=            UPDATE LT_SKLAD_PRODUCT L'
      '110535520=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110535521=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110535522=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110535523='
      '110535524=            IF (ROW_COUNT = 0) THEN'
      
        '110535525=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN' +
        '_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCHK' +
        'A_);'
      '110535526=        END'
      '110535527='
      '110535528=        PNT_ = '#39#39'05'#39#39';'
      '110535529=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '110535530=            SELECT MAX(SK.DATE_RECEIPT)'
      '110535531=              FROM SKLAD SK'
      '110535532=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110535533=               AND SK.IS_LAST = 1'
      '110535534=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110535535=              INTO :DATE_LAST_;'
      '110535536='
      
        '110535537=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' >= DATE_LAST_)) THEN BEGIN'
      '110535538=              UPDATE SKLAD SK'
      '110535539=                 SET SK.IS_LAST = 0'
      '110535540=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110535541=                 AND SK.IS_LAST = 1'
      '110535542=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110535543='
      '110535544=              UPDATE SKLAD SK'
      '110535545=                 SET SK.IS_LAST = 1'
      '110535546=               WHERE SK.SKLAD = :SKLAD_;'
      '110535547=            END'
      '110535548=        END'
      '110535549='
      '110535550=    END ELSE BEGIN'
      '110535551=        PNT_ = '#39#39'06'#39#39';'
      '110535552=        UPDATE SKLAD S'
      '110535553=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '110535554=               S.G_CLIENT = :G_CLIENT_,'
      '110535555=               S.AMOUNT   = :AMOUNT_,'
      '110535556=               S.PRICE    = :PRICE_,'
      '110535557=               S.SUMM     = :SUMM_ONE_,'
      '110535558=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110535559=               S.NDS      = :NDS_,'
      '110535560=               S.NDS_SUMM = :NDS_SUMM_,'
      '110535561=               S.OSNOVANIE = :OSNOVANIE_,'
      '110535562=               S.NOTE      = :NOTE_'
      '110535563=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110535564=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP_'
      '110535565=         WHERE S.SKLAD = :SKLAD_;'
      '110535566='
      '110535567=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '110535568=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_) THEN BEGI' +
        'N'
      '110535569=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '110535570=              UPDATE LT_SKLAD_PRODUCT L'
      
        '110535571=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OL' +
        'D_ - :AMOUNT_)'
      '110535572=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110535573=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '110535574='
      '110535575=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '110535576=              UPDATE LT_SKLAD_PRODUCT L'
      
        '110535577=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ -' +
        ' :AMOUNT_OLD_)'
      '110535578=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110535579=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '110535580=        END'
      
        '110535581=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED_' +
        ' = 0) THEN BEGIN'
      '110535582=            UPDATE LT_SKLAD_PRODUCT L'
      '110535583=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110535584=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110535585=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110535586='
      '110535587=            IF (ROW_COUNT = 0) THEN'
      
        '110535588=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN' +
        '_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCHK' +
        'A_);'
      '110535589=        END'
      '110535590=        ELSE BEGIN'
      '110535591=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110535592=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD_' +
        ' - :AMOUNT_) - :AMOUNT_'
      '110535593=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110535594=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110535595=        END'
      '110535596='
      '110535597=        PNT_ = '#39#39'07'#39#39';'
      
        '110535598=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110535599=            SELECT MAX(SK.DATE_RECEIPT)'
      '110535600=              FROM SKLAD SK'
      '110535601=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110535602=               AND SK.IS_LAST = 1'
      '110535603=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110535604=              INTO :DATE_LAST_;'
      '110535605='
      
        '110535606=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' > DATE_LAST_)) THEN BEGIN'
      '110535607=              UPDATE SKLAD SK'
      '110535608=                 SET SK.IS_LAST = 0'
      '110535609=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110535610=                 AND SK.IS_LAST = 1'
      '110535611=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110535612='
      '110535613=              UPDATE SKLAD SK'
      '110535614=                 SET SK.IS_LAST = 1'
      '110535615=               WHERE SK.SKLAD = :SKLAD_;'
      '110535616=            END'
      '110535617=        END'
      '110535618='
      '110535619=        PNT_ = '#39#39'08'#39#39';'
      
        '110535620=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (I' +
        'S_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110535621=            SELECT MAX(SK.DATE_RECEIPT)'
      '110535622=              FROM SKLAD SK'
      '110535623=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110535624=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '110535625=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110535626=               AND SK.is_vozvrat IN (0,4)'
      '110535627=              INTO :DATE_LAST_;'
      '110535628='
      
        '110535629=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_REC' +
        'EIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' '#1055 +
        #1054#1057#1051#1045#1044#1053#1071#1071
      '110535630=              UPDATE SKLAD SK'
      '110535631=                 SET SK.IS_LAST = 0'
      '110535632=               WHERE SK.SKLAD = :SKLAD_;'
      '110535633='
      '110535634=               UPDATE SKLAD SK'
      '110535635=                 SET SK.IS_LAST = 1'
      '110535636=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110535637=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110535638=                                   FROM SKLAD SS'
      
        '110535639=                                  WHERE SS.G_PRODUCT =' +
        ' SK.G_PRODUCT'
      
        '110535640=                                    AND SS.DATE_RECEIP' +
        'T = :DATE_LAST_'
      
        '110535641=                                    AND SS.G_TOCHKA = ' +
        ':G_TOCHKA_'
      
        '110535642=                                    AND SS.is_vozvrat ' +
        'IN (0,4));'
      '110535643='
      '110535644=            END'
      
        '110535645=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THIS' +
        '_LAST_ = 1)) THEN BEGIN'
      '110535646=              UPDATE SKLAD SK'
      '110535647=                 SET SK.IS_LAST = 1'
      '110535648=               WHERE SK.SKLAD = :SKLAD_;'
      '110535649=            END'
      '110535650=        END'
      '110535651=    END'
      '110535652=  END'
      '110535653='
      '110535654=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN'
      '110535655=      IF (IS_VOZVRAT_ = 0) THEN'
      '110535656=        G_PRIHOD_RASHOD_ = 2;'
      '110535657=      ELSE'
      '110535658=        G_PRIHOD_RASHOD_ = 3;'
      '110535659='
      '110535660=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110535661=            PNT_ = '#39#39'09'#39#39';'
      '110535662=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110535663=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110535664=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110535665=            ELSE'
      
        '110535666=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110535667='
      '110535668=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110535669=                RETURNING_VALUES :KASSA_, :PAYMENT_DAT' +
        'E_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110535670='
      
        '110535671=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110535672=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THEN'
      
        '110535673=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110535674=                                              :G_PRIHO' +
        'D_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110535675=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110535676=                                              :PAYMENT' +
        '_DATE_,'
      
        '110535677=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110535678=                                              NULL,   ' +
        '--ZAKAZ_'
      
        '110535679=                                              :SKLAD_P' +
        'ARENT_,'
      
        '110535680=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110535681=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535682='
      '110535683=            ELSE BEGIN'
      '110535684=                SELECT 1'
      '110535685=                  FROM KASSA K'
      '110535686=                 WHERE K.KASSA = :KASSA_'
      '110535687=                UNION ALL'
      '110535688=                SELECT 2'
      '110535689=                  FROM KASSA_BEZNAL KB'
      '110535690=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110535691=                 INTO :PAYMENT_TYPE_OLD_;'
      '110535692='
      
        '110535693=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110535694=                      PNT_ = '#39#39'010'#39#39';'
      
        '110535695=                      EXECUTE PROCEDURE K_UPD_KASSA(:K' +
        'ASSA_,'
      
        '110535696=                                                    1,' +
        '     -- ACTION_'
      
        '110535697=                                                    :G' +
        '_PRIHOD_RASHOD_,'
      
        '110535698=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110535699=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110535700=                                                    NU' +
        'LL,   --NOTE_'
      
        '110535701=                                                    NU' +
        'LL,  --ZAKAZ'
      
        '110535702=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110535703=                                                    :P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110535704='
      
        '110535705=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110535706=                      PNT_ = '#39#39'011'#39#39';'
      
        '110535707=                      EXECUTE PROCEDURE K_DEL_KASSA(:K' +
        'ASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG' +
        ');'
      '110535708=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535709=                        ERR_MSG = PROCNAME||'#39#39' -> PNT_' +
        ' '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110535710=                        EXIT;'
      '110535711=                      END'
      '110535712='
      
        '110535713=                      EXECUTE PROCEDURE K_INS_KASSA(1,' +
        '     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110535714=                                                    :G' +
        '_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110535715=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110535716=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110535717=                                                    NU' +
        'LL,   --NOTE_ => :NOTE_,'
      
        '110535718=                                                    NU' +
        'LL,   --ZAKAZ_'
      
        '110535719=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110535720=                                                    :P' +
        'AYMENT_TYPE_,'
      
        '110535721=                                                    :G' +
        '_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535722=                END'
      '110535723=            END'
      '110535724=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535725=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110535726=              EXIT;'
      '110535727=            END'
      '110535728='
      '110535729=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~'#39#39';'
      '110535730=      END'
      '110535731='
      '110535732=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110535733=            FROM KASSA K'
      '110535734=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110535735=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA||'#39#39'~'#39#39
      '110535736=           UNION'
      '110535737=          SELECT KASSA, 1 PAYMENT_TYPE'
      '110535738=            FROM KASSA K'
      '110535739=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110535740=             AND K.SUMM = 0'
      '110535741=          UNION'
      '110535742=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110535743=            FROM KASSA_BEZNAL K'
      '110535744=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110535745=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA_BEZNAL||'#39#39'~'#39#39
      '110535746=          UNION'
      '110535747=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110535748=            FROM KASSA_BEZNAL K'
      '110535749=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110535750=             AND K.SUMM = 0'
      '110535751=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110535752=      DO BEGIN'
      '110535753=        PNT_ = '#39#39'011A'#39#39';'
      
        '110535754=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYMEN' +
        'T_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110535755=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535756=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110535757=          EXIT;'
      '110535758=        END'
      '110535759=      END'
      '110535760=  END'
      '110535761='
      '110535762=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110535763=    SELECT K.KASSA'
      '110535764=      FROM KASSA K'
      '110535765=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110535766=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110535767=      INTO :KASSA_POP_;'
      '110535768=  ELSE'
      '110535769=    SELECT K.KASSA_BEZNAL'
      '110535770=      FROM KASSA_BEZNAL K'
      '110535771=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110535772=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110535773=       INTO :KASSA_POP_;'
      '110535774='
      
        '110535775=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEGI' +
        'N'
      '110535776=      PNT_ = '#39#39'012'#39#39';'
      '110535777=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      '110535778=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_,'
      
        '110535779=                                          1,     -- AC' +
        'TION_'
      '110535780=                                          :G_PRIHOD_,'
      
        '110535781=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110535782=                                          :DATE_RECEIP' +
        'T_,'
      
        '110535783=                                          NULL,   --NO' +
        'TE_'
      '110535784=                                          NULL,'
      
        '110535785=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110535786=                                          :G_PAYMENT_T' +
        'YPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110535787=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110535788=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110535789=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_'
      '110535790=                                          :G_PRIHOD_,'
      
        '110535791=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110535792=                                          :DATE_RECEIP' +
        'T_,'
      
        '110535793=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      '110535794=                                          NULL,'
      
        '110535795=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110535796=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110535797=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535798=      END'
      '110535799=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535800=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110535801=        EXIT;'
      '110535802=      END'
      '110535803='
      
        '110535804=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110535805=        PNT_ = '#39#39'013'#39#39';'
      
        '110535806=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110535807=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535808=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110535809=          EXIT;'
      '110535810=        END'
      '110535811=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110535812=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '110535813=                                          :G_PRIHOD_,'
      
        '110535814=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110535815=                                          :DATE_RECEIP' +
        'T_,'
      
        '110535816=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110535817=                                          NULL,   --ZA' +
        'KAZ_'
      
        '110535818=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110535819=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110535820=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535821=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535822=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110535823=              EXIT;'
      '110535824=            END'
      '110535825=        END'
      '110535826=  END'
      '110535827=end'
      '110535828='#39';'
      '110535829=END  --END_EXECUTE_BLOCK'
      '110535830=EXECUTE BLOCK AS BEGIN'
      '110535831='
      
        '110535832=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        '_REAL('
      '110535833=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110535834=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110535835=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110535836=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110535837=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110535838=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110535839=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110535840=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110535841=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110535842=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT)'
      '110535843=RETURNS ('
      '110535844=  ERR_CODE INTEGER,'
      '110535845=  ERR_MSG VARCHAR(1024))'
      '110535846=AS'
      
        '110535847=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL_REAL'#39#39';'
      '110535848=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110535849=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110535850=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110535851=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      
        '110535852=DECLARE VARIABLE Z_G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.G_PRODUCT;'
      
        '110535853=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '110535854=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '110535855=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      '110535856=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110535857=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110535858=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110535859=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110535860=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110535861=BEGIN'
      '110535862=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110535863=      SELECT Z.G_PAYMENT_TYPE'
      '110535864=        FROM ZAKAZ Z'
      '110535865=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110535866=        INTO :G_PAYMENT_TYPE_OLD_;'
      '110535867='
      '110535868=      PNT_ = '#39#39'01a'#39#39';'
      '110535869=      UPDATE zakaz'
      '110535870=      SET'
      '110535871=       Z_DATE = :Z_DATE_,'
      '110535872=       Z_TIME = :Z_TIME_,'
      '110535873=       G_CLIENT = :G_CLIENT_,'
      '110535874=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110535875=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110535876=       NOTE = COALESCE(:NOTE_, NOTE),'
      '110535877=       SUMM = :SUMM_,'
      '110535878=       SUMM_FACT = :SUMM_FACT_'
      '110535879=      WHERE'
      '110535880=        zakaz = :zakaz_;'
      '110535881='
      '110535882=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '110535883=      PNT_ = '#39#39'02a'#39#39';'
      
        '110535884=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110535885=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535886=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110535887=        EXIT;'
      '110535888=      END'
      '110535889='
      '110535890=      PNT_ = '#39#39'03a'#39#39';'
      '110535891=      DELETE from zakaz_DETAILS z'
      '110535892=      WHERE z.zakaz = :zakaz_;'
      '110535893=      FOR SELECT G_PRODUCT,'
      '110535894=                 AMOUNT,'
      '110535895=                 SUMM,'
      '110535896=                 ZAKAZ_NA_REAL,'
      '110535897=                 ZAKAZ_DETAILS'
      '110535898=            FROM ZAKAZ_DETAILS_TMP_REAL'
      '110535899=      INTO :Z_G_PRODUCT_,'
      '110535900=           :Z_AMOUNT_,'
      '110535901=           :Z_SUMM_,'
      '110535902=           :ZAKAZ_NA_REAL_,'
      '110535903=           :ZAKAZ_DETAILS_'
      '110535904=      DO BEGIN'
      '110535905=        PNT_ = '#39#39'04a'#39#39';'
      
        '110535906=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE' +
        ', DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '110535907=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE'
      '110535908=          FROM ZAKAZ_DETAILS_TMP_REAL Z'
      '110535909=         WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      
        '110535910=           AND Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;   --' +
        #1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1054#1043#1059#1058' '#1055#1054#1042#1058#1054#1056#1071#1058#1068#1057#1071' :ZAKAZ_NA_REAL_, '#1058#1054' '#1045#1057#1058#1068' '#1055#1054' '#1054#1044#1053#1054#1052#1059' ' +
        ':ZAKAZ_NA_REAL_ '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' :ZAKAZ_DETAILS_'
      '110535911='
      '110535912=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110535913=        PNT_ = '#39#39'05a'#39#39';'
      '110535914=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110535915=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :Z_AM' +
        'OUNT_,'
      
        '110535916=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110535917=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, Z' +
        'R.AMOUNT_PAYED + :Z_AMOUNT_, 1, 0)'
      '110535918=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110535919='
      '110535920=        PNT_ = '#39#39'06a'#39#39';'
      
        '110535921=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110535922=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110535923=      END'
      '110535924='
      '110535925=      if (G_PAYMENT_TYPE_OLD_ = 1) then'
      '110535926=          SELECT S.KASSA,'
      '110535927=                 S.G_TOCHKA'
      '110535928=            FROM KASSA S'
      '110535929=           WHERE S.ZAKAZ = :ZAKAZ_'
      
        '110535930=             AND S.G_PRIHOD_RASHOD = 1     -- '#1055#1056#1054#1044#1040#1046#1040' ' +
        #1058#1054#1042#1040#1056#1040
      '110535931=            INTO :KASSA_,'
      '110535932=                 :G_TOCHKA_;'
      '110535933=      ELSE'
      '110535934=          SELECT S.KASSA_BEZNAL,'
      '110535935=                 S.G_TOCHKA'
      '110535936=            FROM KASSA_BEZNAL S'
      '110535937=           WHERE S.ZAKAZ = :ZAKAZ_'
      '110535938=             AND S.G_PRIHOD_RASHOD = 1'
      '110535939=            INTO :KASSA_,'
      '110535940=                 :G_TOCHKA_;'
      '110535941='
      
        '110535942=        IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THE' +
        'N BEGIN'
      '110535943=          PNT_ = '#39#39'05'#39#39';'
      '110535944=          EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110535945=                                        0,     -- ACTI' +
        'ON_'
      
        '110535946=                                        1,     --:G_PR' +
        'IHOD_RASHOD_,'
      '110535947=                                        :SUMM_FACT_,'
      '110535948=                                        :Z_DATE_,'
      
        '110535949=                                        NULL,   --NOTE' +
        '_'
      '110535950=                                        :ZAKAZ_,'
      '110535951=                                        NULL,'
      
        '110535952=                                        :G_PAYMENT_TYP' +
        'E_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110535953=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535954=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110535955=            EXIT;'
      '110535956=          END'
      '110535957='
      
        '110535958=        END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_' +
        'TYPE_) THEN BEGIN'
      '110535959=            PNT_ = '#39#39'07'#39#39';'
      
        '110535960=            EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110535961=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535962=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110535963=              EXIT;'
      '110535964=            END'
      '110535965='
      
        '110535966=            EXECUTE PROCEDURE K_INS_KASSA(0,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110535967=                                          1,     -- G_' +
        'PRIHOD_RASHOD_'
      '110535968=                                          :SUMM_FACT_,'
      '110535969=                                          :Z_DATE_,'
      
        '110535970=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110535971=                                          :ZAKAZ_,   -' +
        '-ZAKAZ_'
      '110535972=                                          NULL,'
      
        '110535973=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110535974=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110535975=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110535976=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110535977=              EXIT;'
      '110535978=            END'
      '110535979=        END'
      '110535980=      ----------------------------------------'
      '110535981=  END'
      '110535982=  ELSE BEGIN'
      '110535983=      UPDATE SKLAD_PARENT'
      '110535984=      SET'
      
        '110535985=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110535986=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      
        '110535987=       G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_P' +
        'AYMENT_TYPE),'
      '110535988=       G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110535989=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110535990=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110535991=       SUMM = :SUMM_,'
      '110535992=       SUMM_FACT = :SUMM_FACT_'
      '110535993=      WHERE SKLAD  = :ZAKAZ_'
      '110535994=      RETURNING G_TOCHKA'
      '110535995=      INTO :G_TOCHKA_;'
      '110535996='
      '110535997=      PNT_ = '#39#39'02'#39#39';'
      
        '110535998=      EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, NULL' +
        ') RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110535999=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110536000=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110536001=        EXIT;'
      '110536002=      END'
      '110536003='
      '110536004=      PNT_ = '#39#39'03'#39#39';'
      '110536005=      FOR SELECT T.AMOUNT,'
      '110536006=                 T.SUMM,'
      '110536007=                 T.G_PRODUCT,'
      '110536008=                 T.ZAKAZ_NA_REAL,'
      '110536009=                 T.ZAKAZ_DETAILS'
      '110536010=                 ,T.PRICE'
      '110536011=                 ,T.NDS'
      '110536012=                 ,T.NDS_SUMM'
      '110536013=                 ,T.DISCOUNT_TENGE'
      '110536014=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110536015=            INTO :Z_AMOUNT_,'
      '110536016=                 :Z_SUMM_,'
      '110536017=                 :Z_G_PRODUCT_,'
      '110536018=                 :ZAKAZ_NA_REAL_,'
      '110536019=                 :ZAKAZ_DETAILS_'
      '110536020=                 ,:PRICE_'
      '110536021=                 ,:NDS_'
      '110536022=                 ,:NDS_SUMM_'
      '110536023=                 ,:DISCOUNT_TENGE_'
      '110536024=      DO BEGIN'
      
        '110536025=        INSERT INTO SKLAD(SKLAD, G_PRODUCT, DATE_RECEI' +
        'PT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, IS_VOZVRAT'
      
        '110536026=                         ,G_CLIENT, G_PAYMENT_TYPE, OS' +
        'NOVANIE, NOTE, G_TOCHKA)'
      
        '110536027=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :Z_G_PRODUC' +
        'T_, :Z_DATE_, :Z_AMOUNT_, :PRICE_ - :DISCOUNT_TENGE_, :Z_SUMM_, ' +
        ':NDS_, :NDS_SUMM_, :ZAKAZ_, 2'
      
        '110536028=                         ,:G_CLIENT_, :G_PAYMENT_TYPE_' +
        ', :OSNOVANIE_, :NOTE_, :G_TOCHKA_);'
      '110536029='
      '110536030=        UPDATE LT_SKLAD_PRODUCT L'
      '110536031=           SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '110536032=         WHERE L.G_PRODUCT = :Z_G_PRODUCT_'
      '110536033=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110536034='
      
        '110536035=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110536036=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110536037='
      '110536038=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110536039=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :Z_AMOUNT_,'
      
        '110536040=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110536041=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':Z_AMOUNT_, 1, 0)'
      '110536042=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110536043=      END'
      '110536044=  END'
      '110536045='
      '110536046=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110536047=END'
      '110536048='#39';'
      
        '110536049=UPDATE SYSTEM_SETUP SET S_VALUE = 11053 WHERE SYSTEM_S' +
        'ETUP = 3;'
      '110536050=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110540=EXECUTE BLOCK AS BEGIN'
      
        '110541=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_READ_G_DISCOUNT_LIST' +
        '('
      '110542=  IS_ALL_ INTEGER)'
      '110543=RETURNS ('
      '110544=  G_DISCOUNT INTEGER,'
      '110545=  G_PRODUCT INTEGER,'
      
        '110546=  G_PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '110547=  G_PRODUCT_PAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ ' +
        'VARCHAR(250),'
      '110548=  DATE_BEGIN DATE,'
      '110549=  DATE_END DATE,'
      '1105410=  NAME VARCHAR(1024),'
      '1105411=  PRICE NUMERIC(15,2),'
      '1105412=  SKIDKA_PROC NUMERIC(15,2),'
      '1105413=  SKIDKA_SUM NUMERIC(15,2),'
      '1105414=  IS_CONST INTEGER,'
      
        '1105415=  TOCHKA_NAME /* TYPE OF COLUMN G_TOCHKA.NAME */ VARCHAR' +
        '(250))'
      '1105416=AS'
      '1105417=BEGIN'
      '1105418=  SUSPEND;'
      '1105419=END'
      '1105420='#39';'
      '1105421='
      '1105422='
      
        '1105423=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_DEL_G_PRIHOD_RASHOD' +
        '('
      
        '1105424=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIH' +
        'OD_RASHOD)'
      '1105425=RETURNS ('
      '1105426=  ERR_CODE INTEGER,'
      '1105427=  ERR_MSG VARCHAR(1024))'
      '1105428=AS'
      '1105429=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1105430=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1105431=begin'
      '1105432=  PROCNAME = '#39#39'G_DEL_G_PRIHOD_RASHOD'#39#39';'
      '1105433='
      
        '1105434=  if (G_PRIHOD_RASHOD_ in (-1, 0, 1, 2, 3, 4)) then begi' +
        'n'
      '1105435=    ERR_CODE = -20500;'
      
        '1105436=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1044#1072#1085#1085#1072#1103' '#1079#1072#1087 +
        #1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '1105437=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1105438=    EXIT;'
      '1105439=  end'
      '1105440='
      '1105441=  delete from G_PRIHOD_RASHOD g'
      '1105442=    where g.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_;'
      '1105443='
      '1105444=when sqlcode -530 DO'
      '1105445=  begin'
      '1105446=    ERR_CODE = -20500;'
      
        '1105447=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081' '#1089 +
        #1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '1105448=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1105449=  end'
      '1105450=end'
      '1105451='#39';'
      '1105452='
      
        '1105453=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_READ_G_DISCOUNT_LIS' +
        'T('
      '1105454=  IS_ALL_ INTEGER)'
      '1105455=RETURNS ('
      '1105456=  G_DISCOUNT INTEGER,'
      '1105457=  G_PRODUCT INTEGER,'
      '1105458=  G_PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1105459=  G_PRODUCT_PAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1105460=  DATE_BEGIN DATE,'
      '1105461=  DATE_END DATE,'
      '1105462=  NAME VARCHAR(1024),'
      '1105463=  PRICE NUMERIC(15,2),'
      '1105464=  SKIDKA_PROC NUMERIC(15,2),'
      '1105465=  SKIDKA_SUM NUMERIC(15,2),'
      '1105466=  IS_CONST INTEGER,'
      '1105467=  TOCHKA_NAME TYPE OF COLUMN G_TOCHKA.NAME)'
      '1105468=AS'
      '1105469=begin'
      '1105470=    FOR'
      '1105471=      SELECT GD.G_DISCOUNT, GD.G_PRODUCT, GP.NAME,'
      '1105472=             GD.DATE_BEGIN,'
      '1105473=             GD.DATE_END,'
      
        '1105474=             CASE WHEN GD.DATE_END IS NULL THEN 1 ELSE 0' +
        ' END IS_CONST,'
      
        '1105475=             GD.NAME, GD.PRICE, GD.SKIDKA_PROC, GD.SKIDK' +
        'A_SUM,'
      
        '1105476=             CASE WHEN GD.G_TOCHKA IS NULL THEN '#39#39#1042#1089#1077' '#1090#1086 +
        #1095#1082#1080#39#39' ELSE T.NAME END'
      '1105477=             ,PAR.NAME'
      
        '1105478=      FROM G_DISCOUNT GD LEFT OUTER JOIN G_TOCHKA T ON G' +
        'D.G_TOCHKA = T.G_TOCHKA,'
      '1105479=           G_PRODUCT GP,'
      '1105480=           G_PRODUCT PAR'
      '1105481=      WHERE GD.G_PRODUCT = GP.G_PRODUCT'
      '1105482=        AND GP.G_PRODUCT_PAR = PAR.G_PRODUCT'
      '1105483=        AND ('
      '1105484=             (('
      '1105485=                ('
      
        '1105486=                  GD.DATE_BEGIN <= CURRENT_DATE       --' +
        ' '#1042#1067#1043#1056#1059#1046#1040#1070#1058#1057#1071' '#1057' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1052' '#1055#1045#1056#1048#1054#1044#1054#1052
      '1105487=                  AND'
      '1105488=                  GD.DATE_END >= CURRENT_DATE'
      '1105489=                  AND GD.DATE_BEGIN IS NOT NULL'
      '1105490=                  AND GD.DATE_END IS NOT NULL'
      '1105491=                )'
      '1105492=              OR'
      '1105493=                ('
      
        '1105494=                 GD.DATE_BEGIN IS NULL AND GD.DATE_END I' +
        'S NULL  -- '#1040' '#1058#1040#1050#1046#1045' '#1055#1054#1057#1058#1054#1071#1053#1053#1067#1045' '#1057#1050#1048#1044#1050#1048
      '1105495=                )'
      '1105496=              )'
      '1105497=              AND :IS_ALL_ = 1)'
      '1105498=             OR'
      
        '1105499=             (:IS_ALL_ = 0)                             ' +
        '        -- '#1051#1048#1041#1054' '#1042#1057#1045
      '11054100=            )'
      
        '11054101=      INTO :G_DISCOUNT, :G_PRODUCT, :G_PRODUCT_NAME, :D' +
        'ATE_BEGIN, :DATE_END, :IS_CONST, :NAME, :PRICE, :SKIDKA_PROC, :S' +
        'KIDKA_SUM,'
      '11054102=           :TOCHKA_NAME'
      '11054103=           ,:G_PRODUCT_PAR_NAME'
      '11054104=    DO'
      '11054105=      SUSPEND;'
      '11054106=end'
      '11054107='#39';'
      '11054108='
      '11054109=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_DISCOUNT('
      '11054110=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11054111=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      
        '11054112=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11054113=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11054114=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11054115=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11054116=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '11054117=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11054118=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11054119=  G_TOCHKA_ TYPE OF COLUMN G_DISCOUNT.G_TOCHKA)'
      '11054120=RETURNS ('
      '11054121=  ERR_CODE INTEGER,'
      '11054122=  ERR_MSG VARCHAR(1024))'
      '11054123=AS'
      '11054124=DECLARE VARIABLE CNT_   INTEGER;'
      
        '11054125=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_PRODUCT.PR' +
        'ICE;'
      '11054126=begin'
      '11054127=    SELECT COUNT(*)'
      '11054128=      FROM G_DISCOUNT'
      '11054129=     WHERE G_PRODUCT = :G_PRODUCT_'
      '11054130=       AND DATE_BEGIN <= CURRENT_TIMESTAMP'
      '11054131=       AND DATE_END >= CURRENT_TIMESTAMP'
      '11054132=       AND G_DISCOUNT <> :G_DISCOUNT_'
      '11054133=       AND ((G_TOCHKA = COALESCE(:G_TOCHKA_, 0))'
      '11054134=            OR'
      '11054135=            (G_TOCHKA IS NULL)'
      '11054136=           )'
      '11054137=      INTO CNT_;'
      '11054138='
      '11054139=    IF (CNT_ <> 0) THEN BEGIN'
      '11054140=      ERR_CODE = -20500;'
      
        '11054141=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1072' '#1076#1072#1085#1085 +
        #1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39#39') RETURNING_VALUES (:ERR_' +
        'MSG);'
      '11054142=      EXIT;'
      '11054143=    END'
      '11054144='
      '11054145=    PRICE_REC_ = PRICE_;'
      
        '11054146=    IF (SKIDKA_PROC_ IS NULL OR SKIDKA_SUM_ IS NULL) TH' +
        'EN BEGIN'
      '11054147=      SELECT G.PRICE'
      '11054148=        FROM G_PRODUCT G'
      '11054149=       WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11054150=        INTO :PRICE_REC_;'
      '11054151='
      '11054152=      IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '11054153=        SKIDKA_PROC_ = ROUND(SKIDKA_SUM_ * 100 / PRICE_' +
        'REC_ , 2);'
      '11054154=      IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '11054155=        SKIDKA_SUM_ = ROUND(PRICE_REC_ * SKIDKA_PROC_ /' +
        ' 100 , 2);'
      '11054156=    END'
      '11054157='
      '11054158=    UPDATE G_DISCOUNT'
      '11054159=    SET G_PRODUCT = :G_PRODUCT_,'
      '11054160=        DATE_BEGIN = :DATE_BEGIN_,'
      '11054161=        DATE_END = :DATE_END_,'
      '11054162=        NAME = :NAME_,'
      '11054163=        PRICE = :PRICE_REC_,'
      '11054164=        SKIDKA_PROC = :SKIDKA_PROC_,'
      '11054165=        SKIDKA_SUM = :SKIDKA_SUM_,'
      '11054166=        G_TOCHKA = :G_TOCHKA_'
      '11054167=    WHERE (G_DISCOUNT = :G_DISCOUNT_);'
      '11054168=end'
      '11054169='#39';'
      
        '11054170=UPDATE SYSTEM_SETUP SET S_VALUE = 11054 WHERE SYSTEM_SE' +
        'TUP = 3;'
      '11054171=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110550=EXECUTE BLOCK AS BEGIN'
      
        '110551=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_PRODUCT_SET_NEW_PRIC' +
        'ES('
      '110552=  G_CATEGORY_ VARCHAR(1000),'
      '110553=  G_PRODUCT_ VARCHAR(2000),'
      '110554=  CHANGE_PRICE_ INTEGER,'
      '110555=  MODE_ INTEGER,'
      '110556=  WHAT_PRICE_ INTEGER,'
      '110557=  NEW_VAL_ NUMERIC(15,2),'
      '110558=  COURSE_OLD_ NUMERIC(15,2),'
      '110559=  COURSE_NEW_ NUMERIC(15,2),'
      '1105510=  ROUND_MODE_ INTEGER,'
      '1105511=  CHANGE_CATEGORY_ INTEGER,'
      '1105512=  NEW_CATEGORY_  INTEGER,'
      '1105513=  CHANGE_MIN_AMOUNT_ INTEGER,'
      '1105514=  NEW_MIN_AMOUNT_  NUMERIC(15,2),'
      '1105515=  CHANGE_SALES_COMM_ INTEGER,'
      '1105516=  NEW_SALES_COMM_  NUMERIC(15,2))'
      '1105517=RETURNS ('
      '1105518=  ERR_CODE INTEGER,'
      '1105519=  ERR_MSG VARCHAR(1000))'
      '1105520=AS'
      '1105521=BEGIN'
      '1105522=  SUSPEND;'
      '1105523=END'
      '1105524='#39';'
      '1105525='
      '1105526='
      
        '1105527=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_PRODUCT_SET_NEW_PRI' +
        'CES('
      '1105528=  G_CATEGORY_ VARCHAR(1000),'
      '1105529=  G_PRODUCT_ VARCHAR(2000),'
      '1105530=  CHANGE_PRICE_ INTEGER,'
      '1105531=  MODE_ INTEGER,'
      '1105532=  WHAT_PRICE_ INTEGER,'
      '1105533=  NEW_VAL_ NUMERIC(15,2),'
      '1105534=  COURSE_OLD_ NUMERIC(15,2),'
      '1105535=  COURSE_NEW_ NUMERIC(15,2),'
      '1105536=  ROUND_MODE_ INTEGER,'
      '1105537=  CHANGE_CATEGORY_ INTEGER,'
      '1105538=  NEW_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1105539=  CHANGE_MIN_AMOUNT_ INTEGER,'
      '1105540=  NEW_MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1105541=  CHANGE_SALES_COMM_ INTEGER,'
      '1105542=  NEW_SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '1105543=RETURNS ('
      '1105544=  ERR_CODE INTEGER,'
      '1105545=  ERR_MSG VARCHAR(1000))'
      '1105546=AS'
      
        '1105547=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      '1105548=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE;'
      
        '1105549=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.VOL' +
        'UME_PRICE;'
      '1105550=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '1105551=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '1105552=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOC' +
        'HKA;'
      '1105553=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '1105554=BEGIN'
      '1105555='
      '1105556=  SQL_STR_ = '#39#39'UPDATE G_PRODUCT P'#39#39'||'
      '1105557=               '#39#39' SET '#39#39';'
      '1105558='
      '1105559=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1105560='
      '1105561=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '1105562=      IF (ROUND_MODE_ = 0) THEN'
      '1105563=          ROUND_ = 1;'
      '1105564=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '1105565=          ROUND_ = 0;'
      '1105566=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '1105567=          ROUND_ = -1;'
      '1105568=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '1105569=          ROUND_ = -2;'
      '1105570=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '1105571=          ROUND_ = -3;'
      '1105572='
      '1105573=      IF (MODE_ = 0) THEN'
      
        '1105574=        SQL_STR_ = SQL_STR_ ||'#39#39'P.PRICE = ROUND(P.PRICE ' +
        '* (1 + '#39#39'||:NEW_VAL_||'#39#39'/ 100), '#39#39'||:ROUND_||'#39#39'),'#39#39'||'
      
        '1105575=                   '#39#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE * (1 + '#39#39'||:NEW_VAL_||'#39#39'/ 100), '#39#39'||:ROUND_||'#39#39')'#39#39';'
      '1105576='
      '1105577=      ELSE IF (MODE_ = 1) THEN'
      
        '1105578=        SQL_STR_ = SQL_STR_ ||'#39#39'P.PRICE = ROUND(P.PRICE ' +
        '+ '#39#39'||:NEW_VAL_||'#39#39', '#39#39'||:ROUND_||'#39#39'),'#39#39'||'
      
        '1105579=                   '#39#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE + '#39#39'||:NEW_VAL_||'#39#39', '#39#39'||:ROUND_||'#39#39')'#39#39';'
      '1105580='
      '1105581=      ELSE IF (MODE_ = 2) THEN'
      
        '1105582=        SQL_STR_ = SQL_STR_ ||'#39#39'P.PRICE = ROUND(P.PRICE ' +
        '* (1 - '#39#39'||:NEW_VAL_||'#39#39'/100), '#39#39'||:ROUND_||'#39#39'),'#39#39'||'
      
        '1105583=                   '#39#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE * (1 - '#39#39'||:NEW_VAL_||'#39#39'/ 100), '#39#39'||:ROUND_||'#39#39')'#39#39';'
      '1105584='
      '1105585=      ELSE IF (MODE_ = 3) THEN'
      
        '1105586=        SQL_STR_ = SQL_STR_ ||'#39#39'P.PRICE = ROUND(P.PRICE ' +
        '- '#39#39'||:NEW_VAL_||'#39#39', '#39#39'||:ROUND_||'#39#39'),'#39#39'||'
      
        '1105587=                   '#39#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE - '#39#39'||:NEW_VAL_||'#39#39', '#39#39'||:ROUND_||'#39#39')'#39#39';'
      '1105588='
      '1105589=      ELSE IF (MODE_ = 4) THEN'
      
        '1105590=        SQL_STR_ = SQL_STR_ ||'#39#39'P.PRICE = ROUND(P.PRICE/' +
        #39#39'||:COURSE_OLD_||'#39#39' * '#39#39'||:COURSE_NEW_||'#39#39', '#39#39'||:ROUND_||'#39#39'),'#39#39 +
        '||'
      
        '1105591=                   '#39#39' P.VOLUME_PRICE = ROUND(P.VOLUME_PR' +
        'ICE/'#39#39'||:COURSE_OLD_||'#39#39' * '#39#39'||:COURSE_NEW_||'#39#39', '#39#39'||:ROUND_||'#39#39 +
        ')'#39#39';'
      '1105592='
      '1105593=      ELSE BEGIN'
      '1105594=        SELECT ID'
      '1105595=          FROM CUR_PARAMS'
      '1105596=         WHERE CUR_PARAMS = 2'
      '1105597=          INTO :G_TOCHKA_;'
      '1105598='
      '1105599=        IF (WHAT_PRICE_ = 0) THEN'
      
        '11055100=          SQL_STR_ = SQL_STR_ ||'#39#39'P.PRICE = ROUND((SELE' +
        'CT * FROM get_last_self_price(P.g_product, '#39#39'||:G_TOCHKA_||'#39#39', 0' +
        ')) * (1 + '#39#39'||:NEW_VAL_||'#39#39' / 100), '#39#39'||:ROUND_||'#39#39')'#39#39';'
      '11055101=        ELSE'
      
        '11055102=          SQL_STR_ = SQL_STR_ ||'#39#39'P.VOLUME_PRICE = ROUN' +
        'D((SELECT * FROM get_last_self_price(P.g_product, '#39#39'||:G_TOCHKA_' +
        '||'#39#39', 0)) * (1 + '#39#39'||:NEW_VAL_||'#39#39' / 100), '#39#39'||:ROUND_||'#39#39')'#39#39';'
      '11055103=      END'
      '11055104=  END'
      '11055105='
      '11055106=  IF (CHANGE_CATEGORY_ = 1) THEN BEGIN'
      '11055107=    IF (CHANGE_PRICE_ = 1) THEN'
      '11055108=      SQL_STR_ = SQL_STR_ ||'#39#39','#39#39';'
      '11055109='
      
        '11055110=    SQL_STR_ = SQL_STR_ ||'#39#39'P.G_PRODUCT_PAR = '#39#39'||:NEW_' +
        'CATEGORY_;'
      '11055111=  END'
      '11055112='
      '11055113=  IF (CHANGE_MIN_AMOUNT_ = 1) THEN BEGIN'
      '11055114=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_) > 0) THEN'
      '11055115=      SQL_STR_ = SQL_STR_ ||'#39#39','#39#39';'
      '11055116='
      
        '11055117=    SQL_STR_ = SQL_STR_ ||'#39#39'P.MIN_AMOUNT = '#39#39'||:NEW_MIN' +
        '_AMOUNT_;'
      '11055118=  END'
      '11055119='
      '11055120=  IF (CHANGE_SALES_COMM_ = 1) THEN BEGIN'
      
        '11055121=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN_' +
        'AMOUNT_) > 0) THEN'
      '11055122=      SQL_STR_ = SQL_STR_ ||'#39#39','#39#39';'
      '11055123='
      
        '11055124=    SQL_STR_ = SQL_STR_ ||'#39#39'P.SALES_COMM = '#39#39'||:NEW_SAL' +
        'ES_COMM_;'
      '11055125=  END'
      '11055126='
      '11055127=  SQL_STR_ = SQL_STR_ ||'#39#39' WHERE P.IS_ACTIVE = 1'#39#39'||'
      '11055128=                       '#39#39' AND P.IS_KIT <> 1'#39#39'||'
      '11055129=                       '#39#39' AND P.IS_CATEGORY = 0'#39#39';'
      '11055130='
      '11055131=  IF (g_category_ IS NOT NULL) THEN'
      
        '11055132=    SQL_STR_ = SQL_STR_ ||'#39#39' AND P.G_PRODUCT_PAR IN (SE' +
        'LECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE '#39#39#39#39#39#39'||G_CATEGORY_||' +
        #39#39#39#39#39#39' CONTAINING '#39#39#39#39'~'#39#39#39#39'||PT.G_PRODUCT||'#39#39#39#39'~'#39#39#39#39')'#39#39';'
      '11055133='
      '11055134='
      '11055135=  IF (G_PRODUCT_ IS NOT NULL) THEN'
      
        '11055136=    SQL_STR_ = SQL_STR_ ||'#39#39' AND '#39#39#39#39#39#39'||G_PRODUCT_||'#39#39 +
        #39#39#39#39' CONTAINING '#39#39#39#39'~'#39#39#39#39'||P.G_PRODUCT||'#39#39#39#39'~'#39#39#39#39#39#39';'
      '11055137='
      '11055138=  EXECUTE STATEMENT :SQL_STR_;'
      '11055139=END'
      '11055140='#39';'
      
        '11055141=UPDATE SYSTEM_SETUP SET S_VALUE = 11055 WHERE SYSTEM_SE' +
        'TUP = 3;'
      '11055142=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110560=EXECUTE BLOCK AS BEGIN'
      
        '110561=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIS' +
        'T('
      '110562=  ZAKAZ_  INTEGER,'
      '110563=  IS_SPISANIE_  INTEGER)'
      '110564=RETURNS ('
      '110565=  ZAKAZ  INTEGER,'
      '110566=  ZAKAZ_DETAILS  INTEGER,'
      '110567=  G_PRODUCT  INTEGER,'
      '110568=  AMOUNT  NUMERIC(18,5),'
      '110569=  PRICE  NUMERIC(15,2),'
      '1105610=  SUMM  NUMERIC(15,2),'
      '1105611=  DISCOUNT_PERC  NUMERIC(15,2),'
      '1105612=  DISCOUNT_TENGE  NUMERIC(15,2),'
      '1105613=  DISCOUNT_SUMM  NUMERIC(15,2),'
      '1105614=  ARTICUL  VARCHAR(30),'
      '1105615=  NOMENCLATUR_NUM  VARCHAR(150),'
      '1105616=  BARCODE  VARCHAR(30),'
      '1105617=  TOVAR_NAME  VARCHAR(250),'
      '1105618=  ED_NAME  VARCHAR(50))'
      '1105619=AS'
      '1105620=BEGIN'
      '1105621=  SUSPEND;'
      '1105622=END'
      '1105623='#39';'
      '1105624='
      '1105625='
      '1105626=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_DISCOUNT('
      '1105627=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1105628=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '1105629=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '1105630=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '1105631=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '1105632=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1105633=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1105634=  G_TOCHKA_ VARCHAR(500))'
      '1105635=RETURNS ('
      '1105636=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '1105637=  ERR_CODE INTEGER,'
      '1105638=  ERR_MSG VARCHAR(1024))'
      '1105639=AS'
      '1105640=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1105641=DECLARE VARIABLE G_PRODUCT_REC_ TYPE OF COLUMN G_DISCOUN' +
        'T.G_PRODUCT;'
      
        '1105642=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_DISCOUNT.G_' +
        'PRODUCT;'
      
        '1105643=DECLARE VARIABLE SKIDKA_PROC_R_ TYPE OF COLUMN G_DISCOUN' +
        'T.SKIDKA_PROC;'
      
        '1105644=DECLARE VARIABLE SKIDKA_SUM_R_ TYPE OF COLUMN G_DISCOUNT' +
        '.SKIDKA_SUM;'
      
        '1105645=DECLARE VARIABLE G_TOCHKA_ID_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1105646=BEGIN'
      '1105647='
      '1105648=    FOR SELECT G.G_TOCHKA'
      '1105649=          FROM G_TOCHKA G'
      
        '1105650=         WHERE :G_TOCHKA_ CONTAINING '#39#39'~'#39#39'||G.G_TOCHKA||' +
        #39#39'~'#39#39
      '1105651=            OR :G_TOCHKA_ IS NULL'
      '1105652=        ORDER BY G.G_TOCHKA'
      '1105653=          INTO :G_TOCHKA_ID_'
      '1105654=    DO BEGIN'
      '1105655=            FOR SELECT G.G_PRODUCT,'
      '1105656=                       G.PRICE'
      '1105657=                  FROM G_PRODUCT G'
      
        '1105658=                 WHERE G.G_PRODUCT_PAR = DECODE(:G_PRODU' +
        'CT_PAR_, -1, G.G_PRODUCT_PAR, :G_PRODUCT_PAR_)'
      
        '1105659=                   AND G.G_PRODUCT = COALESCE(:G_PRODUCT' +
        '_, G.G_PRODUCT)'
      '1105660=                   AND G.IS_ACTIVE = 1'
      '1105661=                   AND G.IS_CATEGORY = 0'
      '1105662=                   AND G.PRICE > 0'
      '1105663=                  INTO :G_PRODUCT_REC_,'
      '1105664=                       :PRICE_REC_'
      '1105665=            DO BEGIN'
      '1105666=                if (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1105667=                  DELETE FROM G_DISCOUNT'
      
        '1105668=                   WHERE COALESCE(DATE_BEGIN, CURRENT_DA' +
        'TE) <= CURRENT_DATE AND COALESCE(DATE_END, CURRENT_DATE) >= CURR' +
        'ENT_DATE'
      '1105669=                     AND G_PRODUCT = :G_PRODUCT_REC_'
      '1105670=                     AND G_TOCHKA = :G_TOCHKA_ID_;'
      '1105671=                ELSE BEGIN'
      '1105672=                    SELECT COUNT(*)'
      '1105673=                      FROM G_DISCOUNT'
      '1105674=                     WHERE G_PRODUCT = :G_PRODUCT_REC_'
      
        '1105675=                       AND COALESCE(DATE_BEGIN, CURRENT_' +
        'DATE) <= CURRENT_DATE'
      
        '1105676=                       AND COALESCE(DATE_END, CURRENT_DA' +
        'TE) >= CURRENT_DATE'
      
        '1105677=                       AND ((G_TOCHKA = COALESCE(:G_TOCH' +
        'KA_ID_, 0))'
      '1105678=                            OR'
      '1105679=                            (G_TOCHKA IS NULL)'
      '1105680=                           )'
      '1105681=                      INTO CNT_;'
      '1105682='
      '1105683=                    IF (CNT_ <> 0) THEN BEGIN'
      '1105684=                      ERR_CODE = -20500;'
      
        '1105685=                      EXECUTE PROCEDURE GET_ERR_MSG(ERR_' +
        'CODE, '#39#39#1053#1072' '#1076#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39#39') RETURNIN' +
        'G_VALUES (:ERR_MSG);'
      '1105686=                      EXIT;'
      '1105687=                    END'
      '1105688=                END'
      '1105689='
      '1105690=                SKIDKA_PROC_R_ = SKIDKA_PROC_;'
      '1105691=                SKIDKA_SUM_R_  = SKIDKA_SUM_;'
      '1105692=                IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '1105693=                  IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '1105694=                    SKIDKA_PROC_R_ = ROUND(SKIDKA_SUM_ *' +
        ' 100 / PRICE_REC_ , 2);'
      '1105695=                  IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '1105696=                    SKIDKA_SUM_R_ = ROUND(PRICE_REC_ * S' +
        'KIDKA_PROC_ / 100 , 2);'
      '1105697=                END'
      '1105698='
      
        '1105699=                INSERT INTO G_DISCOUNT (G_DISCOUNT, G_PR' +
        'ODUCT, DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA_SU' +
        'M, G_TOCHKA)'
      
        '11056100=                VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G_P' +
        'RODUCT_REC_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :SKI' +
        'DKA_PROC_R_, :SKIDKA_SUM_R_'
      '11056101=                        ,:G_TOCHKA_ID_)'
      '11056102=                RETURNING G_DISCOUNT'
      '11056103=                INTO :G_DISCOUNT_;'
      '11056104=            END'
      '11056105=    END'
      '11056106=end'
      '11056107='#39';'
      '11056108='
      '11056109=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_DISCOUNT('
      '11056110=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11056111=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      
        '11056112=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11056113=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11056114=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11056115=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11056116=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '11056117=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11056118=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11056119=  G_TOCHKA_ TYPE OF COLUMN G_DISCOUNT.G_TOCHKA)'
      '11056120=RETURNS ('
      '11056121=  ERR_CODE INTEGER,'
      '11056122=  ERR_MSG VARCHAR(1024))'
      '11056123=AS'
      '11056124=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11056125=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_PRODUCT.PR' +
        'ICE;'
      '11056126=BEGIN'
      '11056127=    SELECT COUNT(*)'
      '11056128=      FROM G_DISCOUNT'
      '11056129=     WHERE G_PRODUCT = :G_PRODUCT_'
      
        '11056130=       AND COALESCE(DATE_BEGIN, CURRENT_DATE) <= CURREN' +
        'T_DATE'
      
        '11056131=       AND COALESCE(DATE_END, CURRENT_DATE) >= CURRENT_' +
        'DATE'
      '11056132=       AND G_DISCOUNT <> :G_DISCOUNT_'
      '11056133=       AND ((G_TOCHKA = COALESCE(:G_TOCHKA_, 0))'
      '11056134=            OR'
      
        '11056135=            (G_TOCHKA IS NOT NULL AND :G_TOCHKA_ IS NUL' +
        'L)'
      '11056136=            OR'
      '11056137=            (G_TOCHKA IS NULL)'
      '11056138=           )'
      '11056139=      INTO CNT_;'
      '11056140='
      '11056141=    IF (CNT_ <> 0) THEN BEGIN'
      '11056142=      ERR_CODE = -20500;'
      
        '11056143=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1072' '#1076#1072#1085#1085 +
        #1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39#39') RETURNING_VALUES (:ERR_' +
        'MSG);'
      '11056144=      EXIT;'
      '11056145=    END'
      '11056146='
      '11056147=    PRICE_REC_ = PRICE_;'
      
        '11056148=    IF (SKIDKA_PROC_ IS NULL OR SKIDKA_SUM_ IS NULL) TH' +
        'EN BEGIN'
      '11056149=      SELECT G.PRICE'
      '11056150=        FROM G_PRODUCT G'
      '11056151=       WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11056152=        INTO :PRICE_REC_;'
      '11056153='
      '11056154=      IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '11056155=        SKIDKA_PROC_ = ROUND(SKIDKA_SUM_ * 100 / PRICE_' +
        'REC_ , 2);'
      '11056156=      IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '11056157=        SKIDKA_SUM_ = ROUND(PRICE_REC_ * SKIDKA_PROC_ /' +
        ' 100 , 2);'
      '11056158=    END'
      '11056159='
      '11056160=    UPDATE G_DISCOUNT'
      '11056161=    SET G_PRODUCT = :G_PRODUCT_,'
      '11056162=        DATE_BEGIN = :DATE_BEGIN_,'
      '11056163=        DATE_END = :DATE_END_,'
      '11056164=        NAME = :NAME_,'
      '11056165=        PRICE = :PRICE_REC_,'
      '11056166=        SKIDKA_PROC = :SKIDKA_PROC_,'
      '11056167=        SKIDKA_SUM = :SKIDKA_SUM_,'
      '11056168=        G_TOCHKA = :G_TOCHKA_'
      '11056169=    WHERE (G_DISCOUNT = :G_DISCOUNT_);'
      '11056170=end'
      '11056171='#39';'
      '11056172='
      '11056173=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_HISTORY('
      '11056174=  G_PRODUCT_ARR_ VARCHAR(1000),'
      '11056175=  DATE_BEGIN_ DATE,'
      '11056176=  DATE_END_ DATE,'
      '11056177=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '11056178=RETURNS ('
      '11056179=  ROW INTEGER,'
      '11056180=  DATE_ACT DATE,'
      '11056181=  OPER VARCHAR(500),'
      '11056182=  PRICE_PRIHOD NUMERIC(15,2),'
      '11056183=  AMOUNT_PRIHOD MY_NUMERIC_5,'
      '11056184=  SUMM_PRIHOD NUMERIC(15,2),'
      '11056185=  PRICE_UHOD NUMERIC(15,2),'
      '11056186=  AMOUNT_UHOD MY_NUMERIC_5,'
      '11056187=  SUMM_UHOD NUMERIC(15,2),'
      '11056188=  ERR_CODE INTEGER,'
      '11056189=  ERR_MSG VARCHAR(1024))'
      '11056190=AS'
      
        '11056191=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_TOVAR_M' +
        'OVE'#39#39';'
      '11056192=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11056193=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      '11056194=DECLARE VARIABLE DATE_SORT DATE;'
      '11056195=BEGIN'
      '11056196='
      '11056197=  FOR SELECT F.G_PRODUCT'
      '11056198=        FROM G_PRODUCT F'
      
        '11056199=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39#39'~'#39#39'||F.G_PROD' +
        'UCT||'#39#39'~'#39#39
      '11056200=       AND EXISTS (SELECT 1'
      '11056201=                     FROM SKLAD SS'
      
        '11056202=                    WHERE SS.DATE_RECEIPT BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      '11056203=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '11056204=                      AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-' +
        #39#39'||SS.G_TOCHKA||'#39#39'-'#39#39
      '11056205=                   UNION ALL'
      '11056206=                   SELECT 1'
      '11056207=                     FROM ZAKAZ ZZ,'
      '11056208=                          ZAKAZ_DETAILS ZZD'
      '11056209=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '11056210=                      AND ZZ.IS_RESERVE = 0'
      
        '11056211=                      AND ZZ.Z_DATE BETWEEN :DATE_BEGIN' +
        '_ AND :DATE_END_'
      '11056212=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      '11056213=                      AND ZZ.IS_SPISANIE <> 2'
      
        '11056214=                      AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-' +
        #39#39'||ZZ.G_TOCHKA||'#39#39'-'#39#39
      '11056215=                   UNION ALL'
      '11056216=                   SELECT 1'
      '11056217=                     FROM ZAKAZ_REAL_PARENT Z,'
      '11056218=                          ZAKAZ_NA_REAL D'
      
        '11056219=                    WHERE Z.ZAKAZ_REAL_PARENT = D.ZAKAZ' +
        '_REAL_PARENT'
      
        '11056220=                      AND Z.ZAKAZ_DATE BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '11056221=                      AND D.G_PRODUCT = F.G_PRODUCT'
      
        '11056222=                      AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-' +
        #39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11056223=                   UNION ALL'
      '11056224=                   SELECT 1'
      '11056225=                     FROM OTHER ZZ,'
      '11056226=                          OTHER_DETAILS ZZD'
      '11056227=                    WHERE ZZ.OTHER = ZZD.OTHER'
      
        '11056228=                      AND ZZ.OP_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      '11056229=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      
        '11056230=                      AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-' +
        #39#39'||ZZ.G_TOCHKA||'#39#39'-'#39#39
      '11056231=                   )'
      '11056232=       ORDER BY F.NAME'
      '11056233=       INTO :G_PRODUCT_'
      '11056234=  DO BEGIN'
      '11056235=      FOR SELECT -2,'
      
        '11056236=                 CAST('#39#39'01.01.1985'#39#39' AS DATE) DATE_SORT' +
        ','
      '11056237=                 NULL,'
      '11056238=                 NAME,'
      '11056239=                 NULL,'
      '11056240=                 NULL,'
      '11056241=                 NULL,'
      '11056242=                 NULL,'
      '11056243=                 NULL,'
      '11056244=                 NULL'
      '11056245=            FROM G_PRODUCT G'
      '11056246=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11056247=          UNION ALL'
      '11056248=          SELECT -1,'
      
        '11056249=                 CAST('#39#39'01.01.1990'#39#39' AS DATE) DATE_SORT' +
        ','
      '11056250=                 NULL,'
      '11056251=                 '#39#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1085#1072#1095#1072#1083#1086#39#39','
      '11056252=                 NULL,'
      
        '11056253=                 (select (select amount from lt_sklad_p' +
        'roduct where g_product = G.G_PRODUCT'
      
        '11056254=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '11056255=                       +'
      
        '11056256=                       (select COALESCE(sum(zr.AMOUNT_A' +
        'LL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '11056257=                        where zr.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Zrp.G_TOCHKA||'#39#39'-'#39#39
      
        '11056258=                        and zr.ZAKAZ_REAL_PARENT = zrp.' +
        'ZAKAZ_REAL_PARENT'
      
        '11056259=                        and zrp.ZAKAZ_DATE >= :DATE_BEG' +
        'IN_)'
      '11056260=                       +'
      
        '11056261=                       (select COALESCE(sum(zd.amount),' +
        ' 0) from zakaz_details zd, zakaz z'
      
        '11056262=                        where zd.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056263=                        and zd.zakaz = z.zakaz and z.z_' +
        'date >= :DATE_BEGIN_'
      '11056264=                        and z.IS_SPISANIE <> 2)'
      '11056265=                       +'
      
        '11056266=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056267=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '11056268=                       +'
      
        '11056269=                       (select COALESCE(sum(od.amount),' +
        ' 0) from other_details od, other o'
      
        '11056270=                        where od.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '11056271=                        and od.other = o.other and o.op' +
        '_date >= :DATE_BEGIN_)'
      '11056272=                       -'
      
        '11056273=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_AR' +
        'R_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '11056274=                        and s.is_vozvrat <> 3 and s.dat' +
        'e_receipt >= :DATE_BEGIN_)'
      '11056275=                       -'
      
        '11056276=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056277=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '11056278=                  from rdb$database) PRICE,'
      '11056279=                 NULL,'
      '11056280=                 NULL,'
      '11056281=                 NULL,'
      '11056282=                 NULL'
      '11056283=            FROM G_PRODUCT G'
      '11056284=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11056285=          UNION ALL'
      '11056286=          SELECT SP.IS_VOZVRAT,'
      '11056287=                 SP.DATE_RECEIPT DATE_SORT,'
      '11056288=                 SP.DATE_RECEIPT DATE_ACT,'
      '11056289=                 DECODE(SP.IS_VOZVRAT,'
      
        '11056290=                        0, '#39#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072', '#1087#1086#1089#1090#1072#1074 +
        #1097#1080#1082' '#39#39'||SUBSTRING(COALESCE(c.NAME, '#39#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39#39') FROM 1 FOR 300' +
        '),'
      
        '11056291=                        1, '#39#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39#39'|' +
        '|COALESCE(c.NAME, '#39#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39#39'),'
      
        '11056292=                        2, '#39#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39#39'|' +
        '|COALESCE(c.NAME, '#39#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39#39'),'
      
        '11056293=                        5, '#39#39#1042#1099#1088#1072#1074#1085#1080#1074#1072#1085#1080#1077' '#1086#1089#1090#1072#1090#1082#1086#1074' ('#1088#1077#1074 +
        #1080#1079#1080#1103')'#39#39'),'
      '11056294=                 S.PRICE,'
      '11056295=                 S.AMOUNT,'
      '11056296=                 S.SUMM,'
      '11056297=                 NULL,'
      '11056298=                 NULL,'
      '11056299=                 NULL'
      
        '11056300=            FROM SKLAD_PARENT SP LEFT OUTER JOIN G_CLIE' +
        'NT C ON SP.G_CLIENT = C.G_CLIENT,'
      '11056301=                 SKLAD S,'
      '11056302=                 G_PRODUCT G'
      
        '11056303=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_' +
        'TOCHKA||'#39#39'-'#39#39
      
        '11056304=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '11056305=             AND SP.SKLAD = S.SKLAD_PARENT'
      '11056306=             AND S.G_PRODUCT = G.G_PRODUCT'
      '11056307=             AND G.G_PRODUCT = :G_PRODUCT_'
      '11056308=             AND SP.IS_VOZVRAT NOT IN (2, 3, 4)'
      '11056309=          UNION ALL'
      '11056310=          SELECT SP.IS_VOZVRAT,'
      '11056311=                 SP.DATE_RECEIPT DATE_SORT,'
      '11056312=                 SP.DATE_RECEIPT DATE_ACT,'
      
        '11056313=                 '#39#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072' '#1089#1086' '#1089#1082#1083#1072#1076#1072' "'#39#39'||CO' +
        'ALESCE(c.NAME, '#39#39#1053#1045' '#1059#1057#1058#1040#1053#1054#1042#1051#1045#1053#39#39')||'#39#39'"'#39#39','
      '11056314=                 S.PRICE,'
      '11056315=                 S.AMOUNT,'
      '11056316=                 S.SUMM,'
      '11056317=                 NULL,'
      '11056318=                 NULL,'
      '11056319=                 NULL'
      
        '11056320=            FROM SKLAD_PARENT SP LEFT OUTER JOIN G_TOCH' +
        'KA C ON SP.G_CLIENT = C.G_TOCHKA,'
      '11056321=                 SKLAD S,'
      '11056322=                 G_PRODUCT G'
      
        '11056323=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_' +
        'TOCHKA||'#39#39'-'#39#39
      
        '11056324=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '11056325=             AND SP.SKLAD = S.SKLAD_PARENT'
      '11056326=             AND S.G_PRODUCT = G.G_PRODUCT'
      '11056327=             AND G.G_PRODUCT = :G_PRODUCT_'
      '11056328=             AND SP.IS_VOZVRAT = 3'
      '11056329=          UNION ALL'
      '11056330=          SELECT DECODE(Z.IS_SPISANIE,'
      '11056331=                        0, 4,'
      '11056332=                        1, 5,'
      '11056333=                        2, 6,'
      '11056334=                        4, 7),'
      '11056335=                 Z.Z_DATE DATE_SORT,'
      '11056336=                 Z.Z_DATE DATE_ACT,'
      
        '11056337=                 DECODE(Z.IS_SPISANIE, 1, '#39#39#1057#1087#1080#1089#1072#1085#1080#1077' '#1090#1086 +
        #1074#1072#1088#1072' '#39#39', 0, '#39#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39#39'||SUBSTRING(COALESCE(c.NA' +
        'ME, '#39#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39#39') FROM 1 FOR 300), 4, '#39#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080 +
        #1082#1091' '#39#39'||COALESCE(c.NAME, '#39#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39#39')),'
      '11056338=                 NULL,'
      '11056339=                 NULL,'
      '11056340=                 NULL,'
      '11056341=                 ZD.PRICE - ZD.DISCOUNT_TENGE,'
      '11056342=                 ZD.AMOUNT,'
      '11056343=                 ZD.SUMM'
      '11056344=            FROM ZAKAZ Z,'
      '11056345=                 ZAKAZ_DETAILS ZD,'
      '11056346=                 G_PRODUCT G,'
      '11056347=                 G_CLIENT C'
      
        '11056348=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_T' +
        'OCHKA||'#39#39'-'#39#39
      
        '11056349=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '11056350=             AND Z.IS_RESERVE = 0'
      '11056351=             AND Z.is_spisanie <> 2'
      '11056352=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '11056353=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11056354=             AND Z.G_CLIENT = C.G_CLIENT'
      '11056355=             AND G.G_PRODUCT = :G_PRODUCT_'
      '11056356=          UNION ALL'
      '11056357=          SELECT 8,'
      '11056358=                 SP.DATE_RECEIPT DATE_SORT,'
      '11056359=                 SP.DATE_RECEIPT DATE_ACT,'
      
        '11056360=                 '#39#39#1055#1077#1088#1077#1084#1077#1097#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076' "'#39#39'||c.N' +
        'AME||'#39#39'"'#39#39','
      '11056361=                 NULL,'
      '11056362=                 NULL,'
      '11056363=                 NULL,'
      '11056364=                 S.PRICE,'
      '11056365=                 S.AMOUNT,'
      '11056366=                 S.SUMM'
      '11056367=            FROM SKLAD_PARENT SP,'
      '11056368=                 G_TOCHKA C,'
      '11056369=                 SKLAD S,'
      '11056370=                 G_PRODUCT G'
      
        '11056371=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_' +
        'CLIENT||'#39#39'-'#39#39
      
        '11056372=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '11056373=             AND SP.SKLAD = S.SKLAD_PARENT'
      '11056374=             AND S.G_PRODUCT = G.G_PRODUCT'
      '11056375=             AND G.G_PRODUCT = :G_PRODUCT_'
      '11056376=             AND SP.G_TOCHKA = C.G_TOCHKA'
      '11056377=             AND SP.IS_VOZVRAT = 3'
      '11056378=          UNION ALL'
      '11056379=          SELECT 9,'
      '11056380=                 Z.ZAKAZ_DATE DATE_SORT,'
      '11056381=                 Z.ZAKAZ_DATE DATE_ACT,'
      
        '11056382=                 '#39#39#1042#1099#1076#1072#1095#1072' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1076' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1082#1083#1080#1077#1085#1090 +
        ' '#39#39'||SUBSTRING(COALESCE(c.NAME, '#39#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39#39') FROM 1 FOR 300),'
      '11056383=                 NULL,'
      '11056384=                 NULL,'
      '11056385=                 NULL,'
      '11056386=                 ZD.PRICE - ZD.DISCOUNT_TENGE,'
      '11056387=                 ZD.AMOUNT_ALL,'
      '11056388=                 ZD.SUMM_ALL'
      '11056389=            FROM ZAKAZ_REAL_PARENT Z,'
      '11056390=                 ZAKAZ_NA_REAL ZD,'
      '11056391=                 G_PRODUCT G,'
      '11056392=                 G_CLIENT C'
      
        '11056393=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_T' +
        'OCHKA||'#39#39'-'#39#39
      
        '11056394=             AND Z.ZAKAZ_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '11056395=             AND Z.ZAKAZ_REAL_PARENT = ZD.ZAKAZ_REAL_PA' +
        'RENT'
      '11056396=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11056397=             AND Z.G_CLIENT = C.G_CLIENT'
      '11056398=             AND G.G_PRODUCT = :G_PRODUCT_'
      '11056399=          UNION ALL'
      '11056400=          SELECT 10,'
      '11056401=                 SP.DATE_RECEIPT DATE_SORT,'
      '11056402=                 SP.DATE_RECEIPT DATE_ACT,'
      
        '11056403=                 '#39#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1074#1099#1076#1072#1085#1085#1086#1075#1086' '#1087#1086#1076' '#1088#1077#1072#1083'., ' +
        #1082#1083#1080#1077#1085#1090' '#39#39'||SUBSTRING(COALESCE(c.NAME, '#39#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39#39') FROM 1 FOR ' +
        '300),'
      '11056404=                 S.PRICE,'
      '11056405=                 S.AMOUNT,'
      '11056406=                 S.SUMM,'
      '11056407=                 NULL,'
      '11056408=                 NULL,'
      '11056409=                 NULL'
      
        '11056410=            FROM SKLAD_PARENT SP LEFT OUTER JOIN G_CLIE' +
        'NT C ON SP.G_CLIENT = C.G_CLIENT,'
      '11056411=                 SKLAD S,'
      '11056412=                 G_PRODUCT G'
      
        '11056413=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_' +
        'TOCHKA||'#39#39'-'#39#39
      
        '11056414=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '11056415=             AND SP.SKLAD = S.SKLAD_PARENT'
      '11056416=             AND S.G_PRODUCT = G.G_PRODUCT'
      '11056417=             AND G.G_PRODUCT = :G_PRODUCT_'
      '11056418=             AND SP.IS_VOZVRAT = 2'
      '11056419=          UNION ALL'
      '11056420=          SELECT 11,'
      '11056421=                 SP.DATE_RECEIPT DATE_SORT,'
      '11056422=                 SP.DATE_RECEIPT DATE_ACT,'
      '11056423=                 '#39#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072#39#39','
      '11056424=                 S.PRICE,'
      '11056425=                 S.AMOUNT,'
      '11056426=                 S.SUMM,'
      '11056427=                 NULL,'
      '11056428=                 NULL,'
      '11056429=                 NULL'
      '11056430=            FROM SKLAD_PARENT SP,'
      '11056431=                 G_TOCHKA C,'
      '11056432=                 SKLAD S,'
      '11056433=                 G_PRODUCT G'
      
        '11056434=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_' +
        'TOCHKA||'#39#39'-'#39#39
      
        '11056435=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '11056436=             AND SP.SKLAD = S.SKLAD_PARENT'
      '11056437=             AND S.G_PRODUCT = G.G_PRODUCT'
      '11056438=             AND G.G_PRODUCT = :G_PRODUCT_'
      '11056439=             AND SP.G_TOCHKA = C.G_TOCHKA'
      '11056440=             AND SP.IS_VOZVRAT = 4'
      '11056441=          UNION ALL'
      '11056442=          SELECT 12,'
      '11056443=                 O.OP_DATE DATE_SORT,'
      '11056444=                 O.OP_DATE DATE_ACT,'
      '11056445=                 '#39#39#1056#1072#1089#1093#1086#1076' '#1087#1088#1080' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072#39#39','
      '11056446=                 NULL,'
      '11056447=                 NULL,'
      '11056448=                 NULL,'
      '11056449=                 D.COST_PRICE PRICE,'
      '11056450=                 D.AMOUNT,'
      '11056451=                 D.COST_PRICE * D.AMOUNT SUMM'
      '11056452=            FROM OTHER O,'
      '11056453=                 G_TOCHKA C,'
      '11056454=                 OTHER_DETAILS D,'
      '11056455=                 G_PRODUCT G'
      
        '11056456=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||O.G_T' +
        'OCHKA||'#39#39'-'#39#39
      
        '11056457=             AND O.OP_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '11056458=             AND O.OTHER = D.OTHER'
      '11056459=             AND D.G_PRODUCT = G.G_PRODUCT'
      '11056460=             AND D.G_PRODUCT = :G_PRODUCT_'
      '11056461=             AND O.G_TOCHKA = C.G_TOCHKA'
      '11056462=          UNION ALL'
      '11056463=          SELECT 13,'
      
        '11056464=                 CAST('#39#39'31.12.2099'#39#39' AS DATE) DATE_SORT' +
        ','
      '11056465=                 NULL,'
      '11056466=                 '#39#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1082#1086#1085#1077#1094#39#39','
      '11056467=                 NULL,'
      
        '11056468=                 (select (select amount from lt_sklad_p' +
        'roduct where g_product = G.G_PRODUCT'
      
        '11056469=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '11056470=                       +'
      
        '11056471=                       (select COALESCE(sum(zr.AMOUNT_A' +
        'LL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '11056472=                        where zr.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Zrp.G_TOCHKA||'#39#39'-'#39#39
      
        '11056473=                        and zr.ZAKAZ_REAL_PARENT = zrp.' +
        'ZAKAZ_REAL_PARENT'
      
        '11056474=                        and zrp.ZAKAZ_DATE >= :DATE_END' +
        '_)'
      '11056475=                       +'
      
        '11056476=                       (select COALESCE(sum(zd.amount),' +
        ' 0) from zakaz_details zd, zakaz z'
      
        '11056477=                        where zd.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056478=                        and zd.zakaz = z.zakaz and z.z_' +
        'date > :DATE_END_'
      '11056479=                        and z.IS_SPISANIE <> 2)'
      '11056480=                       +'
      
        '11056481=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056482=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '11056483=                       +'
      
        '11056484=                       (select COALESCE(sum(od.amount),' +
        ' 0) from other_details od, other o'
      
        '11056485=                        where od.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '11056486=                        and od.other = o.other and o.op' +
        '_date > :DATE_END_)'
      '11056487=                       -'
      
        '11056488=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_AR' +
        'R_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '11056489=                        and s.is_vozvrat <> 3 and s.dat' +
        'e_receipt > :DATE_END_)'
      '11056490=                       -'
      
        '11056491=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056492=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '11056493=                  from rdb$database) PRICE,'
      '11056494=                 NULL,'
      '11056495=                 NULL,'
      '11056496=                 NULL,'
      '11056497=                 NULL'
      '11056498=            FROM G_PRODUCT G'
      '11056499=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11056500=         ORDER BY 2, 1, 3'
      '11056501=            INTO :ROW,'
      '11056502=                 :DATE_SORT,'
      '11056503=                 :DATE_ACT,'
      '11056504=                 :OPER,'
      '11056505=                 :PRICE_PRIHOD,'
      '11056506=                 :AMOUNT_PRIHOD,'
      '11056507=                 :SUMM_PRIHOD,'
      '11056508=                 :PRICE_UHOD,'
      '11056509=                 :AMOUNT_UHOD,'
      '11056510=                 :SUMM_UHOD'
      '11056511=      DO BEGIN'
      '11056512=        IF (ROW not in (-2, -1, 13)) THEN BEGIN'
      '11056513=            PRICE_PRIHOD = COALESCE(PRICE_PRIHOD, 0);'
      '11056514=            AMOUNT_PRIHOD = COALESCE(AMOUNT_PRIHOD, 0);'
      '11056515=            SUMM_PRIHOD = COALESCE(SUMM_PRIHOD, 0);'
      '11056516=            PRICE_UHOD = COALESCE(PRICE_UHOD, 0);'
      '11056517=            AMOUNT_UHOD = COALESCE(AMOUNT_UHOD, 0);'
      '11056518=            SUMM_UHOD  = COALESCE(SUMM_UHOD, 0);'
      '11056519=        END'
      '11056520=        SUSPEND;'
      '11056521=      END'
      '11056522=  END'
      '11056523=WHEN ANY DO BEGIN'
      '11056524=    Err_code = -20500;'
      
        '11056525=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1048#1057#1058#1054#1056#1048#1048' '#1058#1054#1042#1040#1056#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11056526=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11056527=  END'
      '11056528=end'
      '11056529='#39';'
      '11056530='
      '11056531=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '11056532=  G_CATEGORY_ VARCHAR(1000),'
      '11056533=  G_PRODUCT_ VARCHAR(1000),'
      '11056534=  DATE_BEGIN_ DATE,'
      '11056535=  DATE_END_ DATE,'
      '11056536=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11056537=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '11056538=RETURNS ('
      '11056539=  DATE_BEGIN_OUT_ DATE,'
      '11056540=  DATE_END_OUT_ DATE,'
      '11056541=  STR_ VARCHAR(500),'
      '11056542=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '11056543=  NAME VARCHAR(1000),'
      '11056544=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11056545=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11056546=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11056547=  AMOUNT_IN MY_NUMERIC_5,'
      '11056548=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '11056549=  SUMM_PRIHOD NUMERIC(15,2),'
      '11056550=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '11056551=  SUMM_UHOD NUMERIC(15,2),'
      
        '11056552=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        ','
      '11056553=  SUMM_SPISANO NUMERIC(15,2),'
      
        '11056554=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        ','
      '11056555=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '11056556=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '11056557=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '11056558=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '11056559=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '11056560=  AMOUNT_OUT MY_NUMERIC_5,'
      '11056561=  IS_HEAD INTEGER,'
      '11056562=  ERR_CODE INTEGER,'
      '11056563=  ERR_MSG VARCHAR(1024))'
      '11056564=AS'
      
        '11056565=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_TOVAR_M' +
        'OVE'#39#39';'
      '11056566=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11056567=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT = 0;'
      '11056568=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '11056569=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT = 0;'
      '11056570=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '11056571=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SKLA' +
        'D_PRODUCT.AMOUNT = 0;'
      '11056572=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '11056573=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SKLA' +
        'D_PRODUCT.AMOUNT = 0;'
      '11056574=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '11056575=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '11056576=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '11056577=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '11056578=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '11056579=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      
        '11056580=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      
        '11056581=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '11056582=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '11056583=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '11056584=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '11056585=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '11056586=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '11056587=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '11056588=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '11056589=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '11056590=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0' +
        ';'
      
        '11056591=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '11056592=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '11056593=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '11056594=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '11056595=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '11056596=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '11056597=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '11056598=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '11056599=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '11056600=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '11056601=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '11056602=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      
        '11056603=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '11056604=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0;'
      '11056605=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '11056606=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39#39#39';'
      '11056607=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11056608=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '11056609=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      '11056610=BEGIN'
      '11056611='
      '11056612=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '11056613=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '11056614='
      '11056615=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      
        '11056616=               (select (select amount from lt_sklad_pro' +
        'duct where g_product = G.G_PRODUCT'
      
        '11056617=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '11056618=                       +'
      
        '11056619=                       (select COALESCE(sum(zr.AMOUNT_A' +
        'LL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '11056620=                        where zr.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Zrp.G_TOCHKA||'#39#39'-'#39#39
      
        '11056621=                        and zr.ZAKAZ_REAL_PARENT = zrp.' +
        'ZAKAZ_REAL_PARENT'
      
        '11056622=                        and zrp.ZAKAZ_DATE >= :DATE_BEG' +
        'IN_)'
      '11056623=                       +'
      
        '11056624=                       (select COALESCE(sum(zd.amount),' +
        ' 0) from zakaz_details zd, zakaz z'
      
        '11056625=                        where zd.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056626=                        and zd.zakaz = z.zakaz and z.z_' +
        'date >= :DATE_BEGIN_'
      '11056627=                        and z.IS_SPISANIE <> 2)'
      '11056628=                       +'
      
        '11056629=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056630=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '11056631=                       +'
      
        '11056632=                       (select COALESCE(sum(od.amount),' +
        ' 0) from other_details od, other o'
      
        '11056633=                        where od.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '11056634=                        and od.other = o.other and o.op' +
        '_date >= :DATE_BEGIN_)'
      '11056635=                       -'
      
        '11056636=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_AR' +
        'R_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '11056637=                        and s.is_vozvrat <> 3 and s.dat' +
        'e_receipt >= :DATE_BEGIN_)'
      '11056638=                       -'
      
        '11056639=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056640=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '11056641=                  from rdb$database) AMOUNT_OUT,'
      '11056642=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '11056643=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '11056644=                   AND S.DATE_RECEIPT BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '11056645=                   AND S.IS_VOZVRAT = 0'
      
        '11056646=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD,'
      '11056647=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '11056648=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '11056649=                   AND S.DATE_RECEIPT BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '11056650=                   AND S.IS_VOZVRAT = 0'
      
        '11056651=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD,'
      '11056652=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '11056653=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE ' +
        'ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11056654=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '11056655=                   AND Z.IS_SPISANIE = 0'
      '11056656=                   AND Z.IS_RESERVE = 0'
      
        '11056657=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_UHOD,'
      '11056658=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '11056659=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE ' +
        'ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11056660=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '11056661=                   AND Z.IS_SPISANIE = 0'
      '11056662=                   AND Z.IS_RESERVE = 0'
      
        '11056663=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_UHOD,'
      '11056664=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '11056665=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE ' +
        'ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11056666=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '11056667=                   AND Z.IS_SPISANIE = 1'
      
        '11056668=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_SPISANO,'
      '11056669=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '11056670=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE ' +
        'ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11056671=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '11056672=                   AND Z.IS_SPISANIE = 1'
      
        '11056673=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_SPISANO,'
      '11056674=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '11056675=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '11056676=                   AND S.DATE_RECEIPT BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '11056677=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '11056678=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_VOZVRAT,'
      '11056679=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '11056680=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G_' +
        'PRODUCT'
      
        '11056681=                   AND S.DATE_RECEIPT BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '11056682=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '11056683=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|S.G_TOCHKA||'#39#39'-'#39#39') SUMM_VOZVRAT,'
      '11056684=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      '11056685=                  FROM SKLAD S'
      '11056686=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '11056687=                   AND S.DATE_RECEIPT BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '11056688=                   AND S.IS_VOZVRAT IN (3, 4, 5)'
      
        '11056689=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD_SKL,'
      '11056690=               (SELECT COALESCE(SUM(S.SUMM),0)'
      '11056691=                  FROM SKLAD S'
      '11056692=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '11056693=                   AND S.DATE_RECEIPT BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '11056694=                   AND S.IS_VOZVRAT IN (3, 4)'
      
        '11056695=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'|' +
        '|S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD_SKL,'
      '11056696=               (SELECT COALESCE(SUM(AMOUNT), 0)'
      
        '11056697=                  FROM (SELECT COALESCE(S.AMOUNT, 0) AM' +
        'OUNT'
      '11056698=                          FROM SKLAD S'
      
        '11056699=                         WHERE S.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '11056700=                           AND S.DATE_RECEIPT BETWEEN :' +
        'DATE_BEGIN_ AND :DATE_END_'
      '11056701=                           AND S.IS_VOZVRAT = 3'
      
        '11056702=                           AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||S.G_CLIENT||'#39#39'-'#39#39
      '11056703=                        UNION ALL'
      
        '11056704=                        SELECT COALESCE(D.AMOUNT, 0) AM' +
        'OUNT'
      '11056705=                          FROM OTHER O, OTHER_DETAILS D'
      '11056706=                         WHERE O.OTHER = D.OTHER'
      
        '11056707=                           AND O.OP_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '11056708=                           AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||O.G_TOCHKA||'#39#39'-'#39#39
      
        '11056709=                           AND D.G_PRODUCT = G.G_PRODUC' +
        'T'
      '11056710=                        UNION ALL'
      
        '11056711=                        SELECT COALESCE(D.AMOUNT, 0) AM' +
        'OUNT'
      '11056712=                          FROM ZAKAZ Z, ZAKAZ_DETAILS D'
      '11056713=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '11056714=                           AND Z.Z_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      
        '11056715=                           AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056716=                           AND D.G_PRODUCT = G.G_PRODUC' +
        'T'
      '11056717=                           AND Z.IS_SPISANIE = 4'
      '11056718=                        UNION ALL'
      
        '11056719=                        SELECT COALESCE(D.AMOUNT_ALL, 0' +
        ') AMOUNT'
      
        '11056720=                          FROM ZAKAZ_REAL_PARENT Z, ZAK' +
        'AZ_NA_REAL D'
      
        '11056721=                         WHERE Z.ZAKAZ_REAL_PARENT = D.' +
        'ZAKAZ_REAL_PARENT'
      
        '11056722=                           AND Z.ZAKAZ_DATE BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      
        '11056723=                           AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056724=                           AND D.G_PRODUCT = G.G_PRODUC' +
        'T)) AMOUNT_UHOD_SKL,'
      '11056725=               (SELECT COALESCE(SUM(SUMM), 0)'
      
        '11056726=                  FROM (SELECT COALESCE(SUM(S.SUMM),0) ' +
        'SUMM'
      '11056727=                          FROM SKLAD S'
      
        '11056728=                         WHERE S.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '11056729=                           AND S.DATE_RECEIPT BETWEEN :' +
        'DATE_BEGIN_ AND :DATE_END_'
      '11056730=                           AND S.IS_VOZVRAT = 3'
      
        '11056731=                           AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||S.G_CLIENT||'#39#39'-'#39#39
      '11056732=                        UNION ALL'
      
        '11056733=                        SELECT D.AMOUNT * D.COST_PRICE ' +
        'SUMM'
      '11056734=                          FROM OTHER O, OTHER_DETAILS D'
      
        '11056735=                        WHERE O.OP_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      
        '11056736=                          AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||O.G_TOCHKA||'#39#39'-'#39#39
      '11056737=                          AND O.OTHER = D.OTHER'
      '11056738=                          AND D.G_PRODUCT = G.G_PRODUCT'
      '11056739=                        UNION ALL'
      
        '11056740=                        SELECT COALESCE(D.SUMM, 0) AMOU' +
        'NT'
      '11056741=                          FROM ZAKAZ Z, ZAKAZ_DETAILS D'
      '11056742=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '11056743=                           AND Z.Z_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      
        '11056744=                           AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056745=                           AND D.G_PRODUCT = G.G_PRODUC' +
        'T'
      '11056746=                           AND Z.IS_SPISANIE = 4'
      '11056747=                        UNION ALL'
      
        '11056748=                        SELECT COALESCE(D.SUMM_ALL, 0) ' +
        'AMOUNT'
      
        '11056749=                          FROM ZAKAZ_REAL_PARENT Z, ZAK' +
        'AZ_NA_REAL D'
      
        '11056750=                         WHERE Z.ZAKAZ_REAL_PARENT = D.' +
        'ZAKAZ_REAL_PARENT'
      
        '11056751=                           AND Z.ZAKAZ_DATE BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      
        '11056752=                           AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056753=                           AND D.G_PRODUCT = G.G_PRODUC' +
        'T)) SUMM_UHOD_SKL,'
      
        '11056754=               (select (select amount from lt_sklad_pro' +
        'duct where g_product = G.G_PRODUCT'
      
        '11056755=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '11056756=                        +'
      
        '11056757=                       (select COALESCE(sum(zr.AMOUNT_A' +
        'LL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '11056758=                        where zr.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Zrp.G_TOCHKA||'#39#39'-'#39#39
      
        '11056759=                        and zr.ZAKAZ_REAL_PARENT = zrp.' +
        'ZAKAZ_REAL_PARENT'
      
        '11056760=                        and zrp.ZAKAZ_DATE >= :DATE_END' +
        '_)'
      '11056761=                       +'
      
        '11056762=                       (select COALESCE(sum(zd.amount),' +
        ' 0) from zakaz_details zd, zakaz z'
      
        '11056763=                        where zd.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11056764=                        and zd.zakaz = z.zakaz and z.z_' +
        'date > :DATE_END_'
      '11056765=                        and z.IS_SPISANIE <> 2)'
      '11056766=                       +'
      
        '11056767=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056768=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '11056769=                       +'
      
        '11056770=                       (select COALESCE(sum(od.amount),' +
        ' 0) from other_details od, other o'
      
        '11056771=                        where od.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '11056772=                        and od.other = o.other and o.op' +
        '_date > :DATE_END_)'
      '11056773=                       -'
      
        '11056774=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_AR' +
        'R_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '11056775=                        and s.is_vozvrat <> 3 and s.dat' +
        'e_receipt > :DATE_END_)'
      '11056776=                       -'
      
        '11056777=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11056778=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '11056779=                  from rdb$database) AMOUNT_OUT'
      '11056780=         FROM P_REP_TREE GP,'
      '11056781=              G_PRODUCT G'
      '11056782=         WHERE G.G_PRODUCT_PAR = GP.G_PRODUCT'
      '11056783=           AND EXISTS (SELECT 1'
      '11056784=                         FROM SKLAD SS'
      
        '11056785=                        WHERE SS.DATE_RECEIPT BETWEEN :' +
        'DATE_BEGIN_ AND :DATE_END_'
      
        '11056786=                          AND SS.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '11056787=                          AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||SS.G_TOCHKA||'#39#39'-'#39#39
      '11056788=                       UNION ALL'
      '11056789=                       SELECT 1'
      '11056790=                         FROM SKLAD SS'
      
        '11056791=                        WHERE SS.DATE_RECEIPT BETWEEN :' +
        'DATE_BEGIN_ AND :DATE_END_'
      
        '11056792=                          AND SS.G_PRODUCT = G.G_PRODUC' +
        'T'
      
        '11056793=                          AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||SS.G_CLIENT||'#39#39'-'#39#39
      '11056794=                       UNION ALL'
      '11056795=                       SELECT 1'
      '11056796=                         FROM ZAKAZ ZZ,'
      '11056797=                              ZAKAZ_DETAILS ZZD'
      '11056798=                        WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '11056799=                          AND ZZ.is_reserve = 0'
      
        '11056800=                          AND ZZ.Z_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      
        '11056801=                          AND ZZD.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11056802=                          AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||ZZ.G_TOCHKA||'#39#39'-'#39#39
      '11056803=                       UNION ALL'
      '11056804=                       SELECT 1'
      '11056805=                         FROM OTHER ZZ,'
      '11056806=                              OTHER_DETAILS ZZD'
      '11056807=                        WHERE ZZ.OTHER = ZZD.OTHER'
      
        '11056808=                          AND ZZ.OP_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '11056809=                          AND ZZD.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11056810=                          AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||ZZ.G_TOCHKA||'#39#39'-'#39#39
      '11056811=                       )'
      
        '11056812=           AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||GP.G_PR' +
        'ODUCT||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11056813=                 OR'
      '11056814=                 (:G_CATEGORY_ IS NULL)'
      '11056815=               )'
      
        '11056816=          AND ((:G_PRODUCT_ CONTAINING '#39#39'~'#39#39'||G.G_PRODU' +
        'CT||'#39#39'~'#39#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11056817=                 OR'
      '11056818=                 (:G_PRODUCT_ IS NULL)'
      '11056819=               )'
      '11056820=          AND ((EXISTS (SELECT 1'
      '11056821=                           FROM SKLAD S'
      '11056822=                          WHERE S.G_CLIENT = :G_CLIENT_'
      
        '11056823=                            AND S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11056824=                            AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '11056825=                            AND S.DATE_RECEIPT BETWEEN ' +
        ':DATE_BEGIN_ AND :DATE_END_) AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11056826=                  OR'
      '11056827=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '11056828=       ORDER BY 2, 3, 1'
      '11056829=    INTO :REC_G_PRODUCT_,'
      '11056830=        :PATH_,'
      '11056831=        :GNAME_,'
      '11056832=        :REC_AMOUNT_IN_,'
      '11056833=        :REC_AMOUNT_PRIHOD_,'
      '11056834=        :REC_SUMM_PRIHOD_,'
      '11056835=        :REC_AMOUNT_UHOD_,'
      '11056836=        :REC_SUMM_UHOD_,'
      '11056837=        :REC_AMOUNT_SPISANO_,'
      '11056838=        :REC_SUMM_SPISANO_,'
      '11056839=        :REC_AMOUNT_VOZVRAT_,'
      '11056840=        :REC_SUMM_VOZVRAT_,'
      '11056841=        :REC_AMOUNT_PRIHOD_SKL_,'
      '11056842=        :REC_SUMM_PRIHOD_SKL_,'
      '11056843=        :REC_AMOUNT_UHOD_SKL_,'
      '11056844=        :REC_SUMM_UHOD_SKL_,'
      '11056845=        :REC_AMOUNT_OUT_'
      '11056846=    DO BEGIN'
      '11056847=      IF (PATH_OLD_ <> PATH_) THEN BEGIN'
      '11056848=        IF (PATH_OLD_ <> '#39#39#39#39') THEN BEGIN'
      '11056849=            INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '11056850=              (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUN' +
        'T_PRIHOD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, S' +
        'UMM_SPISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '11056851=              AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUN' +
        'T_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '11056852=            VALUES'
      
        '11056853=              (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -' +
        '100, :AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_,' +
        ' :AMOUNT_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVR' +
        'AT_,'
      
        '11056854=              :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :' +
        'AMOUNT_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '11056855='
      
        '11056856=            AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + A' +
        'MOUNT_PRIHOD_;'
      
        '11056857=            SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUM' +
        'M_PRIHOD_;'
      
        '11056858=            AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMO' +
        'UNT_UHOD_;'
      
        '11056859=            SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_' +
        'UHOD_;'
      
        '11056860=            AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ +' +
        ' AMOUNT_SPISANO_;'
      
        '11056861=            SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + S' +
        'UMM_SPISANO_;'
      
        '11056862=            AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ +' +
        ' AMOUNT_VOZVRAT_;'
      
        '11056863=            SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + S' +
