        'AMOUNT_OLD_ - :Z_AMOUNT_)'
      
        '1101462093=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101462094=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101462095='
      
        '1101462096=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
