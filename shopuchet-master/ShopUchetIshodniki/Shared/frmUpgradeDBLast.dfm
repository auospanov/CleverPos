      '110402379=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110402380=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110402381=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110402382=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110402383=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110402384=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110402385=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110402386=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110402387=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110402388=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110402389=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110402390=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110402391=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110402392=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110402393=  PAYMENTS_ BLOB SUB_TYPE 1)'
      '110402394=RETURNS ('
      '110402395=  ERR_CODE INTEGER,'
      '110402396=  ERR_MSG VARCHAR(1024))'
      '110402397=AS'
      '110402398=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '110402399=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39#39';'
      '110402400=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110402401=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110402402=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '110402403=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110402404=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      
        '110402405=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '110402406=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110402407=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM;'
      
        '110402408=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110402409=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      '110402410=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110402411=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110402412=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110402413=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      
        '110402414=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110402415=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110402416=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110402417=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM; ' +
        '/* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '110402418=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '110402419=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '110402420=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110402421=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110402422=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110402423=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110402424=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110402425=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110402426=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110402427=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39'; /* ' +
        #1044#1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '110402428=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIENT' +
        '.G_CLIENT;'
      '110402429=BEGIN'
      '110402430='
      '110402431=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110402432=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110402433=      SELECT Z.G_PAYMENT_TYPE,'
      '110402434=             Z.G_TOCHKA,'
      '110402435=             Z.SUMM,'
      '110402436=             Z.SUMM_BONUS,'
      '110402437=             Z.SUMM_BONUS_GOT,'
      '110402438=             z.g_client'
      '110402439=        FROM ZAKAZ Z'
      '110402440=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110402441=        INTO :G_PAYMENT_TYPE_OLD_,'
      '110402442=             :G_TOCHKA_,'
      '110402443=             :SUMM_OLD_,'
      '110402444=             :SUMM_BONUS_OLD_,'
      '110402445=             :SUMM_BONUS_GOT_OLD_,'
      '110402446=             :g_client_old_;'
      '110402447='
      '110402448=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '110402449=      PNT_ = '#39#39'02'#39#39';'
      
        '110402450=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110402451=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402452=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110402453=        EXIT;'
      '110402454=      END'
      '110402455='
      
        '110402456=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110402457=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110402458=      ELSE'
      '110402459=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110402460='
      '110402461=      PNT_ = '#39#39'01'#39#39';'
      '110402462=      UPDATE zakaz'
      '110402463=      SET'
      '110402464=       G_TOCHKA = :G_TOCHKA_,'
      '110402465=       Z_DATE = :Z_DATE_,'
      '110402466=       Z_TIME = :Z_TIME_,'
      '110402467=       G_CLIENT = :G_CLIENT_,'
      '110402468=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110402469=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110402470=       NOTE = COALESCE(:NOTE_, NOTE),'
      '110402471=       SUMM = :SUMM_,'
      '110402472=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '110402473=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ + ' +
        ':SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' ' +
        #1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110402474=       ,BY_RECIPE = :BY_RECIPE_'
      '110402475=       ,IS_RESERVE = :IS_RESERVE_'
      '110402476=       ,SUMM_BONUS = :SUMM_BONUS_'
      '110402477=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '110402478=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '110402479=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '110402480=      WHERE'
      '110402481=        zakaz = :zakaz_;'
      '110402482='
      
        '110402483=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059','
      '110402484=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '110402485=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058' ' +
        #1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052#1040 +
        #1058#1068
      '110402486=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '110402487=          UPDATE G_DISCONT_CARD D'
      '110402488=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '110402489=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '110402490=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '110402491='
      
        '110402492=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059' ' +
        #1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '110402493=          SUMM_OLD_           = 0;'
      '110402494=      END'
      '110402495=      UPDATE G_DISCONT_CARD D'
      
        '110402496=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM_' +
        'BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '110402497=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :SU' +
        'MM_'
      '110402498=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110402499='
      '110402500=      PNT_ = '#39#39'03'#39#39';'
      '110402501=      FOR SELECT ZAKAZ_DETAILS,'
      '110402502=                 G_PRODUCT,'
      '110402503=                 AMOUNT'
      '110402504=            FROM ZAKAZ_DETAILS_TMP'
      '110402505=      INTO :ZAKAZ_DETAILS_,'
      '110402506=           :G_PRODUCT_,'
      '110402507=           :Z_AMOUNT_'
      '110402508=      DO BEGIN'
      
        '110402509=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE' +
        ', DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '110402510=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE'
      '110402511=          FROM ZAKAZ_DETAILS_TMP Z'
      '110402512=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '110402513='
      
        '110402514=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050 +
        #1051#1040#1044#1040
      '110402515=        IF (IS_RESERVE_ = 0) THEN'
      '110402516=            UPDATE LT_SKLAD_PRODUCT L'
      '110402517=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '110402518=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402519=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110402520='
      '110402521=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110402522=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110402523=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110402524=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :Z_AMOUNT_'
      '110402525=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110402526=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110402527=      END'
      '110402528='
      '110402529=      ----------------------------------------'
      
        '110402530=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058#1068 +
        ' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '110402531=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048' ' +
        #1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '110402532=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048 +
        #1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110402533=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '110402534=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047 +
        #1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068 +
        ' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '110402535=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042 +
        #1045#1053#1053#1054')'
      
        '110402536=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110402537=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '110402538=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '110402539=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      '110402540=                PNT_ = '#39#39'04'#39#39';'
      
        '110402541=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENT' +
        'S_);'
      
        '110402542=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110402543=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110402544=                ELSE'
      
        '110402545=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110402546='
      
        '110402547=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110402548=                    RETURNING_VALUES :KASSA_, :PAYMENT' +
        '_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110402549='
      
        '110402550=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110402551='
      '110402552=                PNT_ = '#39#39'05'#39#39';'
      
        '110402553=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) ' +
        'THEN'
      
        '110402554=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_'
      
