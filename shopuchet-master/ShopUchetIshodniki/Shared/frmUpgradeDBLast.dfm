        '11015378=        buf1 = substring(tens from cast(substring(tens_' +
        'idx from i*4+1 for 2) as int) for cast(substring(tens_idx from i' +
        '*4+3 for 2) as int));'
      
        '11015379=        if (buf != '#39#39' and buf1 != '#39#39') then buf = buf ||' +
        ' '#39' '#39';'
      '11015380=        buf = buf || buf1;'
      '11015381='
      '11015382=        /* '#1045#1076#1080#1085#1080#1094#1099' */'
      '11015383=        i = cast(substring(num from 3 for 1) as int);'
      '11015384=        /* '#1057#1084#1086#1090#1088#1080#1084' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1076#1083#1103' '#1085#1091#1078#1085#1086#1075#1086' '#1086#1082#1086#1085#1095#1072#1085#1080#1103' */'
      '11015385=        if (i = 1) then begin'
      
        '11015386=          if (raz = 1) then buf1 = '#39#1086#1076#1085#1072#39'; else buf1 = ' +
