      '110108121=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '110108122=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110108123=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110108124=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '110108125=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110108126=  PREFIX_ VARCHAR(2))'
      '110108127=RETURNS ('
      '110108128=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110108129=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT_PAR,'
      '110108130=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110108131=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110108132=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110108133=  ERR_CODE INTEGER,'
      '110108134=  ERR_MSG VARCHAR(1024))'
      '110108135=AS'
      '110108136=/*'
      '110108137='#1055#1086#1080#1089#1082' '#1090#1086#1074#1072#1088#1072' '#1087#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1091
      '110108138=*/'
      
        '110108139=DECLARE VARIABLE PROCNAME VARCHAR(26) = '#39'G_GET_G_PRODU' +
        'CT_BY_BARCODE'#39';'
      '110108140=BEGIN'
      '110108141='
      '110108142=  IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '110108143=    ERR_CODE = -20500;'
      
        '110108144=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093#1082#1086#1076' ' +
        #1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110108145=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110108146=    EXIT;'
      '110108147=  END'
      '110108148='
      
        '110108149=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) TH' +
        'EN BEGIN'
      '110108150=        SELECT T.G_PRODUCT_PAR,'
      '110108151=               T.G_PRODUCT,'
      '110108152=               T.PRICE,'
      '110108153=               T.VOLUME_PRICE'
      '110108154=          FROM G_PRODUCT T'
      
        '110108155=          WHERE SUBSTRING(T.BARCODE FROM 3 FOR 5) = SU' +
        'BSTRING(:BARCODE_ FROM 3 FOR 5)'
      '110108156=            AND T.IS_ACTIVE = 1'
      '110108157=          INTO :G_PRODUCT_CATEGORY_,'
      '110108158=               :G_PRODUCT_,'
      '110108159=               :PRICE_,'
      '110108160=               :VOLUME_PRICE_;'
      '110108161='
      
        '110108162=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM 8' +
        ' FOR 5) AS MY_NUMERIC_5)/1000.00, 5);'
      '110108163=    END ELSE'
      '110108164=        SELECT T.G_PRODUCT_PAR,'
      '110108165=               T.G_PRODUCT,'
      '110108166=               T.PRICE,'
      '110108167=               T.VOLUME_PRICE'
      '110108168=          FROM G_PRODUCT T'
      '110108169=          WHERE T.BARCODE = :BARCODE_'
      '110108170=            AND T.IS_ACTIVE = 1'
      '110108171=          INTO :G_PRODUCT_CATEGORY_,'
      '110108172=               :G_PRODUCT_,'
      '110108173=               :PRICE_,'
      '110108174=               :VOLUME_PRICE_;'
      '110108175='
      '110108176=    if (ROW_COUNT = 0) then BEGIN'
      
        '110108177=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' '#1044 +
        #1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '110108178=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) ' +
        'THEN'
      '110108179=          SELECT T.G_PRODUCT_PAR,'
      '110108180=                 T.G_PRODUCT,'
      '110108181=                 T.PRICE,'
      '110108182=                 T.VOLUME_PRICE'
      '110108183=            FROM G_PRODUCT T, LT_BARCODE D'
      '110108184=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110108185=              AND T.IS_ACTIVE = 1'
      
        '110108186=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) = ' +
        'SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '110108187=            INTO'
      '110108188=                :G_PRODUCT_CATEGORY_,'
      '110108189=                :G_PRODUCT_,'
      '110108190=                :PRICE_,'
      '110108191=                :VOLUME_PRICE_;'
      '110108192=      ELSE'
      '110108193=          SELECT T.G_PRODUCT_PAR,'
      '110108194=                 T.G_PRODUCT,'
      '110108195=                 T.PRICE,'
      '110108196=                 T.VOLUME_PRICE'
      '110108197=            FROM G_PRODUCT T, LT_BARCODE D'
      '110108198=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '110108199=              AND T.IS_ACTIVE = 1'
      '110108200=              AND D.BARCODE = :BARCODE_'
      '110108201=            INTO'
      '110108202=                :G_PRODUCT_CATEGORY_,'
      '110108203=                :G_PRODUCT_,'
      '110108204=                :PRICE_,'
      '110108205=                :VOLUME_PRICE_;'
      '110108206='
      '110108207=      if (ROW_COUNT = 0) then BEGIN'
      '110108208=          ERR_CODE = -20500;'
      
        '110108209=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110108210=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110108211=          EXIT;'
      '110108212=      END'
      '110108213=    END'
      '110108214='
      
        '110108215=  /*END ELSE if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) the' +
        'n BEGIN'
      '110108216=    SELECT T.G_PRODUCT_PAR,'
      '110108217=        T.G_PRODUCT,'
      '110108218=        T.PRICE,'
      '110108219=        T.VOLUME_PRICE'
      '110108220=    FROM G_PRODUCT T'
      '110108221=    WHERE T.ARTICUL = :ARTICUL_'
      '110108222=    INTO'
      '110108223=        G_PRODUCT_CATEGORY_,'
      '110108224=        :G_PRODUCT_,'
      '110108225=        :PRICE_,'
      '110108226=        :VOLUME_PRICE_;'
      '110108227='
      '110108228=    if (ROW_COUNT = 0) then BEGIN'
      '110108229=      ERR_CODE = -20500;'
      
        '110108230=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:ERR_MS' +
        'G);'
      '110108231=      ERR_MSG = PROCNAME||ERR_MSG;'
      '110108232=      EXIT;'
      '110108233=    END'
      '110108234='
      
        '110108235=  END ELSE if (CHAR_LENGTH(TRIM(:NOMER_)) > 0) then BE' +
        'GIN'
      '110108236=    SELECT T.G_PRODUCT_PAR,'
      '110108237=        T.G_PRODUCT,'
      '110108238=        T.PRICE,'
      '110108239=        T.VOLUME_PRICE'
      '110108240=    FROM G_PRODUCT T'
      '110108241=    WHERE T.NOMENCLATUR_NUM = :NOMER_'
      '110108242=    INTO'
      '110108243=        G_PRODUCT_CATEGORY_,'
      '110108244=        :G_PRODUCT_,'
      '110108245=        :PRICE_,'
      '110108246=        :VOLUME_PRICE_;'
      '110108247='
      '110108248=    if (ROW_COUNT = 0) then BEGIN'
      '110108249=      ERR_CODE = -20500;'
      
        '110108250=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083#1072#1090#1091#1088#1085#1099#1084' '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMER_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '110108251=      ERR_MSG = PROCNAME||ERR_MSG;'
      '110108252=      EXIT;'
      '110108253=    END'
      '110108254='
      
        '110108255=  END ELSE if (CHAR_LENGTH(TRIM(:NAME_)) > 0) then BEG' +
        'IN'
      
        '110108256=      --'#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MAX '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042#1044#1056#1059#1043' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1057' '#1058#1040#1050#1048#1052' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1052
      '110108257=      EXECUTE STATEMENT'
      
        '110108258=      '#39'SELECT G_PRODUCT, G_PRODUCT_PAR, PRICE FROM G_P' +
        'RODUCT '#39'||'
      '110108259=      '#39' WHERE G_PRODUCT = '#39'||'
      
        '110108260=                  '#39'(SELECT MAX(G_PRODUCT) FROM G_PRODU' +
        'CT '#39'||'
      
        '110108261=                  '#39' WHERE UPPER(NAME) LIKE '#39#39'%'#39'||:NAME' +
        '_||'#39'%'#39#39')'#39
      
        '110108262=      INTO :G_PRODUCT_, :G_PRODUCT_CATEGORY_, :PRICE_ ' +
        ';'
      '110108263=      if (G_PRODUCT_ = 0) then BEGIN'
      '110108264=          ERR_CODE = -20500;'
      
        '110108265=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1077#1084' "'#39'||NAME_||'#39'" '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '110108266=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110108267=          EXIT;'
      '110108268=      END'
      '110108269=  END  */'
      '110108270=end'
      '110108271=;'
      '110108272='
      '110108273=ALTER PROCEDURE P_REP_PRIHOD('
      '110108274=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110108275=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110108276=  DATE_BEGIN_ DATE,'
      '110108277=  DATE_END_ DATE,'
      '110108278=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110108279=RETURNS ('
      '110108280=  PERIOD_ VARCHAR(40),'
      
        '110108281=  P_REP_PRIHOD_TABLE TYPE OF COLUMN P_REP_PRIHOD_TABLE' +
        '.P_REP_PRIHOD_TABLE,'
      
        '110108282=  TOVAR_NAME TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR_N' +
        'AME,'
      '110108283=  AMOUNT TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT,'
      
        '110108284=  POSTAVSHIK TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTAVS' +
        'HIK,'
      
        '110108285=  SELF_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_PR' +
        'ICE,'
      
        '110108286=  SELF_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_SUM' +
        'M,'
      
        '110108287=  SELF_PRICE_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'PRICE_B,'
      
        '110108288=  SELF_SUMM_B TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_S' +
        'UMM_B,'
      
        '110108289=  SALE_PRICE TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_PR' +
        'ICE,'
      
        '110108290=  SALE_SUMM TYPE OF COLUMN P_REP_PRIHOD_TABLE.SALE_SUM' +
        'M,'
      '110108291=  IS_HEAD TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD,'
      '110108292=  ERR_CODE INTEGER,'
      '110108293=  ERR_MSG VARCHAR(1024))'
      '110108294=AS'
      '110108295=/*'
      '110108296='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110108297='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050 +
        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110108298='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110108299='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110108300='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110108301='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110108302='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110108303=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110108304=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110108305=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110108306='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110108307='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110108308=*/'
      
        '110108309=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD'#39 +
        ';'
      '110108310=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110108311=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN P_REP_PRIH' +
        'OD_TABLE.SALE_PRICE = 0;'
      
        '110108312=DECLARE VARIABLE SUM_SALE_PRICE_ TYPE OF COLUMN P_REP_' +
        'PRIHOD_TABLE.SALE_PRICE = 0;'
      
        '110108313=DECLARE VARIABLE SUM_SALE_PRICE_ALL_ TYPE OF COLUMN P_' +
        'REP_PRIHOD_TABLE.SALE_PRICE = 0;'
      '110108314=DECLARE VARIABLE SUM_NAL_ NUMERIC(15,2) = 0;'
      '110108315=DECLARE VARIABLE SUM_BEZNAL_ NUMERIC(15,2) = 0;'
      '110108316=DECLARE VARIABLE AMOUNT_CATEGORY_ MY_NUMERIC_5 = 0;'
      '110108317=DECLARE VARIABLE SUM_NAL_CATEGORY_ NUMERIC(15,2) = 0;'
      
        '110108318=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ NUMERIC(15,2) = ' +
        '0;'
      '110108319=DECLARE VARIABLE SUM_FACT_NAL_ALL_ NUMERIC(15,2) = 0;'
      
        '110108320=DECLARE VARIABLE SUM_FACT_BEZNAL_ALL_ NUMERIC(15,2) = ' +
        '0;'
      '110108321=DECLARE VARIABLE SUM_FACT_NAL_ NUMERIC(15,2) = 0;'
      '110108322=DECLARE VARIABLE SUM_FACT_BEZNAL_ NUMERIC(15,2) = 0;'
      '110108323=DECLARE VARIABLE PRICE_NAL_ NUMERIC(15,2) = 0;'
      '110108324=DECLARE VARIABLE PRICE_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '110108325=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110108326=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      '110108327=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110108328=DECLARE VARIABLE AMOUNT_CATEGORY_ALL_ MY_NUMERIC_5 = 0' +
        ';'
      
        '110108329=DECLARE VARIABLE SUM_NAL_CATEGORY_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '110108330=DECLARE VARIABLE SUM_BEZNAL_CATEGORY_ALL_ NUMERIC(15,2' +
        ') = 0;'
      
        '110108331=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110108332=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      '110108333=DECLARE VARIABLE I INTEGER = 1;'
      '110108334=DECLARE VARIABLE K INTEGER = 1;'
      '110108335=BEGIN'
      
        '110108336=  DELETE FROM P_REP_PRIHOD_TABLE WHERE P_REP_PRIHOD_TA' +
        'BLE = P_REP_PRIHOD_TABLE;'
      '110108337='
      '110108338=  DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '110108339=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110108340='
      
        '110108341=  FOR SELECT DECODE(GP.g_product, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', GP' +
        '.NAME),'
      '110108342=             GP.G_PRODUCT'
      '110108343=       FROM G_PRODUCT GP'
      '110108344=      WHERE GP.IS_CATEGORY = 1'
      
        '110108345=        AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110108346=             OR'
      '110108347=             (:G_CATEGORY_ IS NULL)'
      '110108348=            )'
      '110108349=        AND EXISTS (SELECT 1'
      
        '110108350=                      FROM SKLAD_PARENT Z, SKLAD ZD, G' +
        '_PRODUCT G'
      
        '110108351=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110108352=                       AND Z.SKLAD =  ZD.SKLAD_PARENT'
      '110108353=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110108354=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110108355=                       AND Z.IS_VOZVRAT = 0'
      '110108356=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110108357=                       AND Z.DATE_RECEIPT BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      
        '110108358=                       AND ((:G_PRODUCT_ CONTAINING '#39'~' +
        #39'||ZD.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110108359=                             OR'
      '110108360=                             (:G_PRODUCT_ IS NULL)'
      '110108361=                           )'
      '110108362=                   )'
      '110108363=      ORDER BY 1'
      '110108364=  INTO :RECCAT_NAME_,'
      '110108365=       :RECCAT_PRODUCT_'
      '110108366=  DO BEGIN'
      '110108367=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110108368=    insert into P_REP_PRIHOD_TABLE'
      '110108369=      (P_REP_PRIHOD_TABLE, tovar_name, IS_HEAD)'
      '110108370=    values'
      '110108371=      (:I, :RECCAT_NAME_, 1);'
      '110108372='
      '110108373=    I = I + 1;'
      '110108374='
      '110108375=    FOR SELECT G.NAME,'
      '110108376=               G.PRICE,'
      '110108377=               SD.AMOUNT,'
      '110108378=               C.NAME CLIENT_NAME,'
      
        '110108379=               DECODE(S.G_PAYMENT_TYPE, 1, SD.PRICE, 0' +
        ') PRICE_NAL,'
      
        '110108380=               DECODE(S.G_PAYMENT_TYPE, 1, SD.SUMM, 0)' +
        ' SUMM_NAL,'
      
        '110108381=               DECODE(S.G_PAYMENT_TYPE, 2, SD.PRICE, 0' +
        ') PRICE_BEZNAL,'
      
        '110108382=               DECODE(S.G_PAYMENT_TYPE, 2, SD.SUMM, 0)' +
        ' SUMM_BEZNAL,'
      
        '110108383=               DECODE(S.G_PAYMENT_TYPE, 1, S.SUMM_FACT' +
        ', 0) SUMM_FACT_NAL,'
      
        '110108384=               DECODE(S.G_PAYMENT_TYPE, 2, S.SUMM_FACT' +
        ', 0) SUMM_FACT_BEZNAL'
      
        '110108385=          FROM SKLAD_PARENT S LEFT OUTER JOIN G_CLIENT' +
        ' C ON S.G_CLIENT = C.G_CLIENT,'
      '110108386=               SKLAD SD,'
      '110108387=               G_PRODUCT G'
      
        '110108388=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110108389=           AND S.SKLAD = SD.SKLAD_PARENT'
      '110108390=           AND SD.G_PRODUCT = G.G_PRODUCT'
      
        '110108391=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '110108392=           AND S.IS_VOZVRAT = 0'
      '110108393=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110108394=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110108395=           AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.G_PROD' +
        'UCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110108396=                 OR'
      '110108397=                 (:G_PRODUCT_ IS NULL)'
      '110108398=               )'
      
        '110108399=        ORDER BY G.G_PRODUCT_PAR, S.DATE_RECEIPT, S.SK' +
        'LAD, SD.SKLAD, G.NAME'
      '110108400=    INTO :TOVAR_NAME_,'
      '110108401=         :SALE_PRICE_,'
      '110108402=         :AMOUNT_,'
      '110108403=         :CLIENT_NAME_,'
      '110108404=         :PRICE_NAL_,'
      '110108405=         :SUM_NAL_,'
      '110108406=         :PRICE_BEZNAL_,'
      '110108407=         :SUM_BEZNAL_,'
      '110108408=         :SUM_FACT_NAL_,'
      '110108409=         :SUM_FACT_BEZNAL_'
      '110108410=    DO BEGIN'
      
        '110108411=      INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TAB' +
        'LE, TOVAR_NAME, SALE_PRICE, SALE_SUMM, AMOUNT, POSTAVSHIK, SELF_' +
        'PRICE, SELF_SUMM, SELF_PRICE_B,'
      
        '110108412=                                      SELF_SUMM_B, IS_' +
        'HEAD)'
      
        '110108413=      VALUES (:I, :TOVAR_NAME_, :SALE_PRICE_, :SALE_PR' +
        'ICE_ * :AMOUNT_, :AMOUNT_, :CLIENT_NAME_, :PRICE_NAL_, :SUM_NAL_' +
        ', :PRICE_BEZNAL_, :SUM_BEZNAL_, 0);'
      '110108414='
      '110108415=      I = I +1;'
      '110108416='
      
        '110108417=      AMOUNT_CATEGORY_ = AMOUNT_CATEGORY_ + COALESCE(A' +
        'MOUNT_, 0);'
      
        '110108418=      SUM_NAL_CATEGORY_ = SUM_NAL_CATEGORY_ + COALESCE' +
        '(SUM_NAL_, 0);'
      
        '110108419=      SUM_BEZNAL_CATEGORY_ = SUM_BEZNAL_CATEGORY_ + CO' +
        'ALESCE(SUM_BEZNAL_, 0);'
      
        '110108420=      SUM_SALE_PRICE_ = SUM_SALE_PRICE_ + SALE_PRICE_ ' +
        '* AMOUNT_;'
      '110108421='
      '110108422=      IF (K = 1) THEN BEGIN'
      
        '110108423=          SUM_FACT_NAL_ALL_ = SUM_FACT_NAL_ALL_ + SUM_' +
        'FACT_NAL_;'
      
        '110108424=          SUM_FACT_BEZNAL_ALL_ = SUM_FACT_BEZNAL_ALL_ ' +
        '+ SUM_FACT_BEZNAL_;'
      '110108425='
      '110108426=          K = 2;'
      '110108427=      END'
      '110108428=    END'
      '110108429='
      '110108430=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110108431=    INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE' +
        ', TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD' +
        ')'
      
        '110108432=    VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :SUM_SALE_PRICE_' +
        ', :AMOUNT_CATEGORY_, :SUM_NAL_CATEGORY_, :SUM_BEZNAL_CATEGORY_, ' +
        '2);'
      '110108433='
      '110108434='
      
        '110108435=    AMOUNT_CATEGORY_ALL_ = AMOUNT_CATEGORY_ALL_ + AMOU' +
        'NT_CATEGORY_;'
      
        '110108436=    SUM_NAL_CATEGORY_ALL_ = SUM_NAL_CATEGORY_ALL_ + SU' +
        'M_NAL_CATEGORY_;'
      
        '110108437=    SUM_BEZNAL_CATEGORY_ALL_ = SUM_BEZNAL_CATEGORY_ALL' +
        '_ + SUM_BEZNAL_CATEGORY_;'
      
        '110108438=    SUM_SALE_PRICE_ALL_ = SUM_SALE_PRICE_ALL_ + SUM_SA' +
        'LE_PRICE_;'
      '110108439='
      '110108440=    AMOUNT_CATEGORY_ = 0;'
      '110108441=    SUM_NAL_CATEGORY_ = 0;'
      '110108442=    SUM_BEZNAL_CATEGORY_  = 0;'
      '110108443=    SUM_SALE_PRICE_ = 0;'
      '110108444='
      '110108445=    I = I + 1;'
      '110108446=    K = 1;'
      '110108447=  END'
      '110108448='
      '110108449=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '110108450=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, SALE_SUMM, AMOUNT, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110108451=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUM_SALE_PRICE_ALL_, :AMOUNT_C' +
        'ATEGORY_ALL_, :SUM_NAL_CATEGORY_ALL_, :SUM_BEZNAL_CATEGORY_ALL_,' +
        ' 3);'
      '110108452='
      '110108453=  I = I + 1;'
      '110108454='
      '110108455=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1059#1055#1051#1040#1063#1045#1053#1054
      '110108456=  /*SELECT COALESCE(SUM(S.SUMM_FACT), 0)'
      '110108457=    FROM SKLAD_PARENT S, SKLAD SD'
      '110108458=   WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '110108459=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110108460=     AND S.G_PAYMENT_TYPE = 1'
      '110108461=     AND S.IS_VOZVRAT = 0'
      
        '110108462=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110108463=     AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||SD.G_PRODUCT||' +
        #39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110108464=           OR'
      '110108465=           (:G_CATEGORY_ IS NULL)'
      '110108466=         )'
      
        '110108467=     AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.G_PRODUCT||'#39 +
        '~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110108468=           OR'
      '110108469=           (:G_PRODUCT_ IS NULL)'
      '110108470=         )'
      '110108471=    INTO :SUM_FACT_NAL_ALL_;'
      '110108472='
      '110108473=  SELECT COALESCE(SUM(S.SUMM_FACT), 0)'
      '110108474=    FROM SKLAD_PARENT S, SKLAD SD'
      '110108475=   WHERE S.SKLAD = SD.SKLAD_PARENT'
      
        '110108476=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110108477=     AND S.G_PAYMENT_TYPE = 2'
      '110108478=     AND S.IS_VOZVRAT = 0'
      
        '110108479=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110108480=     AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||SD.G_PRODUCT||' +
        #39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110108481=           OR'
      '110108482=           (:G_CATEGORY_ IS NULL)'
      '110108483=         )'
      
        '110108484=     AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||SD.G_PRODUCT||'#39 +
        '~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110108485=           OR'
      '110108486=           (:G_PRODUCT_ IS NULL)'
      '110108487=         )'
      '110108488=    INTO :SUM_FACT_BEZNAL_ALL_;*/'
      '110108489='
      
        '110108490=  INSERT INTO P_REP_PRIHOD_TABLE (P_REP_PRIHOD_TABLE, ' +
        'TOVAR_NAME, SELF_SUMM, SELF_SUMM_B, IS_HEAD)'
      
        '110108491=  VALUES (:I, '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077#1085#1086#39', :SUM_FACT_NAL_ALL_, ' +
        ':SUM_FACT_BEZNAL_ALL_, 1);'
      '110108492='
      
        '110108493=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110108494=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110108495='
      
        '110108496=  FOR SELECT P_REP_PRIHOD_TABLE, TOVAR_NAME, SALE_PRIC' +
        'E, SALE_SUMM, AMOUNT, POSTAVSHIK, SELF_PRICE, SELF_SUMM, SELF_PR' +
        'ICE_B, SELF_SUMM_B,'
      '110108497=             IS_HEAD'
      '110108498=      FROM P_REP_PRIHOD_TABLE'
      
        '110108499=      INTO :P_REP_PRIHOD_TABLE, :TOVAR_NAME, :SALE_PRI' +
        'CE, :SALE_SUMM, :AMOUNT, :POSTAVSHIK, :SELF_PRICE, :SELF_SUMM, :' +
        'SELF_PRICE_B, :SELF_SUMM_B, :IS_HEAD'
      '110108500=  DO'
      '110108501=    suspend;'
      '110108502='
      '110108503=WHEN ANY DO BEGIN'
      '110108504=    Err_code = -20500;'
      
        '110108505=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110108506=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110108507=  END'
      '110108508=end'
      '110108509=;'
      '110108510='
      '110108511=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110108512=RETURNS ('
      '110108513=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110108514=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '110108515=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '110108516=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '110108517=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '110108518=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110108519=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110108520=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '110108521=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '110108522=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110108523=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110108524=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110108525=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110108526=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZ' +
        'N_PROC,'
      '110108527=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '110108528=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_' +
        'PROC,'
      '110108529=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT)'
      '110108530=AS'
      '110108531=begin'
      '110108532=  FOR'
      
        '110108533=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.' +
        'SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '110108534=           ,PRICE_CURRENCY'
      '110108535=           ,SUMM_CURRENCY'
      '110108536=           ,CHARGE_ROZN_PROC'
      '110108537=           ,PRICE_ROZN'
      '110108538=           ,CHARGE_OPT_PROC'
      '110108539=           ,PRICE_OPT'
      '110108540=    FROM SKLAD_TMP T,'
      '110108541=         G_PRODUCT P'
      '110108542=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110108543=    ORDER BY T.sklad'
      
        '110108544=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :' +
        'NDS, :NDS_SUMM, :NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '110108545=      ,:PRICE_CURRENCY'
      '110108546=      ,:SUMM_CURRENCY'
      '110108547=      ,:CHARGE_ROZN_PROC'
      '110108548=       ,:PRICE_ROZN'
      '110108549=       ,:CHARGE_OPT_PROC'
      '110108550=       ,:PRICE_OPT'
      '110108551=  DO'
      '110108552=    suspend;'
      '110108553=end'
      '110108554=;'
      
        '110108555=UPDATE SYSTEM_SETUP SET S_VALUE = 110108 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110108556=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110108557=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101090=CREATE PROCEDURE UPD_SKLAD_TMP_ALL('
      
        '1101091=  CHARGE_ROZN_PROC_ /* TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC */ NUMERIC(15,2),'
      '1101092=  ROUND_MODE_ INTEGER)'
      '1101093=RETURNS ('
      '1101094=  ERR_CODE INTEGER,'
      '1101095=  ERR_MSG VARCHAR(1024))'
      '1101096=AS'
      '1101097=BEGIN'
      '1101098=  SUSPEND;'
      '1101099=END'
      '11010910=;'
      '11010911='
      '11010912='
      
        '11010913=/******************************************************' +
        '************************/'
      
        '11010914=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11010915=/******************************************************' +
        '************************/'
      '11010916=ALTER PROCEDURE INS_SKLAD('
      '11010917=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '11010918=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      
        '11010919=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIP' +
        'T,'
      '11010920=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '11010921=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '11010922=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '11010923=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '11010924=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '11010925=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11010926=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11010927=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11010928=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11010929=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11010930=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY = 0,'
      
        '11010931=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED ' +
        '= 0)'
      '11010932=RETURNS ('
      '11010933=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11010934=  ERR_CODE INTEGER,'
      '11010935=  ERR_MSG VARCHAR(1024))'
      '11010936=AS'
      '11010937=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '11010938=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042#1040 +
        #1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '11010939=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '11010940=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '11010941=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050 +
        #1048
      
        '11010942=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' '#1057 +
        #1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '11010943=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050#1040 +
        #1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047#1044 +
        #1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '11010944=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059#1044 +
        #1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM ' +
        #1041#1059#1044#1059
      '11010945=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '11010946=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047#1053 +
        #1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048' ' +
        #1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '11010947=--'
      
        '11010948=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTED' +
        ' = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '11010949=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056#1054 +
        #1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1059 +
        #1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '11010950=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '11010951=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11010952=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11010953=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11010954=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11010955=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11010956=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '11010957=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM = 0;'
      
        '11010958=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      '11010959=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11010960=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIH' +
        'OD_RASHOD.G_PRIHOD_RASHOD;'
      
        '11010961=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARENT' +
        '.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '11010962=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '11010963=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11010964=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11010965=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11010966=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11010967=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11010968=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11010969=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.P' +
        'RICE_CURRENCY;'
      
        '11010970=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKLA' +
        'D.SUMM_CURRENCY;'
      
        '11010971=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      
        '11010972=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.P' +
        'RICE_ROZN;'
      
        '11010973=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRODU' +
        'CT.PRICE;'
      '11010974=BEGIN'
      '11010975='
      '11010976=  PNT_ = '#39'00'#39';'
      '11010977=  IS_THIS_LAST_ = 0;'
      '11010978='
      '11010979=  IF (G_TOCHKA_ IS NULL) THEN'
      '11010980=    SELECT ID'
      '11010981=      FROM CUR_PARAMS'
      '11010982=     WHERE CUR_PARAMS = 2'
      '11010983=      INTO :G_TOCHKA_;'
      '11010984='
      '11010985=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11010986=  SELECT ID'
      '11010987=    FROM CUR_PARAMS'
      '11010988=   WHERE CUR_PARAMS = 1'
      '11010989=    INTO :G_OFFICIAL_;'
      '11010990='
      '11010991=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '11010992=                            DATE_RECEIPT,'
      '11010993=                            TIME_RECEIPT,'
      '11010994=                            G_CLIENT,'
      '11010995=                            G_PAYMENT_TYPE,'
      '11010996=                            OSNOVANIE,'
      '11010997=                            NOTE,'
      '11010998=                            SUMM,'
      '11010999=                            SUMM_FACT,'
      '110109100=                            SUMM_CURRENCY,'
      '110109101=                            IS_PAYED_ALL,'
      '110109102=                            IS_VOZVRAT,'
      '110109103=                            G_TOCHKA'
      '110109104=                            ,G_OFFICIAL'
      '110109105=                            ,IS_EXPECTED)'
      '110109106=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110109107=          :DATE_RECEIPT_,'
      '110109108=          :TIME_RECEIPT_,'
      '110109109=          :G_CLIENT_,'
      '110109110=          :G_PAYMENT_TYPE_,'
      '110109111=          :OSNOVANIE_,'
      '110109112=          :NOTE_,'
      '110109113=          :SUMM_,'
      '110109114=          :SUMM_FACT_,'
      '110109115=          :SUMM_CURRENCY_,'
      
        '110109116=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PA' +
        'YED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "' +
        #1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110109117=          :IS_VOZVRAT_,'
      '110109118=          :G_TOCHKA_'
      '110109119=          ,:G_OFFICIAL_'
      '110109120=          ,:IS_EXPECTED_)'
      '110109121=  RETURNING'
      '110109122=    SKLAD'
      '110109123=  INTO'
      '110109124=    :SKLAD_;'
      '110109125='
      '110109126=  PNT_ = '#39'01'#39';'
      '110109127=  FOR SELECT SKLAD,'
      '110109128=             T.G_PRODUCT,'
      '110109129=             AMOUNT,'
      '110109130=             T.PRICE,'
      '110109131=             SUMM,'
      '110109132=             NDS,'
      '110109133=             NDS_SUMM'
      '110109134=             ,PRICE_CURRENCY'
      '110109135=             ,SUMM_CURRENCY'
      '110109136=             ,PRICE_ROZN'
      '110109137=             ,GG.PRICE'
      '110109138=        FROM SKLAD_TMP T,'
      '110109139=             G_PRODUCT GG'
      '110109140=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110109141=      ORDER BY 1'
      '110109142=      INTO :SKLAD_TMP_,'
      '110109143=           :RG_PRODUCT_,'
      '110109144=           :RAMOUNT_,'
      '110109145=           :RPRICE_,'
      '110109146=           :RSUMM_,'
      '110109147=           :RNDS_,'
      '110109148=           :RNDS_SUMM_'
      '110109149=           ,:PRICE_CURRENCY_'
      '110109150=           ,:SUMM_CURRENCY_TMP_'
      '110109151=           ,:SALE_PRICE_'
      '110109152=           ,:SALE_PRICE_CUR_'
      '110109153=  DO BEGIN'
      '110109154=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110109155=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110109156=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110109157=      IS_THIS_LAST_ = 0;'
      '110109158=      SELECT MAX(SK.DATE_RECEIPT)'
      '110109159=        FROM SKLAD SK'
      '110109160=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110109161=         AND SK.IS_LAST = 1'
      '110109162=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110109163=        INTO :DATE_LAST_;'
      '110109164='
      
        '110109165=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110109166=        UPDATE SKLAD SK'
      '110109167=           SET SK.IS_LAST = 0'
      '110109168=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110109169=           AND SK.IS_LAST = 1'
      '110109170=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110109171='
      '110109172=        IS_THIS_LAST_ = 1;'
      '110109173=      END'
      '110109174=    END'
      '110109175='
      '110109176=    INSERT INTO SKLAD'
      '110109177=    ('
      '110109178=     SKLAD,'
      '110109179=     SKLAD_PARENT,'
      '110109180=     DATE_RECEIPT,'
      '110109181=     G_CLIENT,'
      '110109182=     G_PRODUCT,'
      '110109183=     AMOUNT,'
      '110109184=     PRICE,'
      '110109185=     SUMM,'
      '110109186=     G_PAYMENT_TYPE,'
      '110109187=     OSNOVANIE,'
      '110109188=     NOTE,'
      '110109189=     NDS,'
      '110109190=     NDS_SUMM,'
      '110109191=     IS_LAST,'
      '110109192=     IS_VOZVRAT,'
      '110109193=     G_TOCHKA'
      '110109194=     ,PRICE_CURRENCY'
      '110109195=     ,SUMM_CURRENCY'
      '110109196=    ) VALUES ('
      '110109197=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110109198=     :SKLAD_,'
      '110109199=     :DATE_RECEIPT_,'
      '110109200=     :G_CLIENT_,'
      '110109201=     :RG_PRODUCT_,'
      '110109202=     :RAMOUNT_,'
      '110109203=     :RPRICE_,'
      '110109204=     :RSUMM_,'
      '110109205=     :G_PAYMENT_TYPE_,'
      '110109206=     :OSNOVANIE_,'
      '110109207=     :NOTE_,'
      '110109208=     :RNDS_,'
      '110109209=     :RNDS_SUMM_,'
      
        '110109210=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110109211=     :IS_VOZVRAT_,'
      '110109212=     :G_TOCHKA_'
      '110109213=     ,:PRICE_CURRENCY_'
      '110109214=     ,:SUMM_CURRENCY_TMP_'
      '110109215=    );'
      '110109216='
      
        '110109217=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110109218=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110109219=        PNT_ = '#39'02'#39';'
      '110109220=        UPDATE LT_SKLAD_PRODUCT L'
      '110109221=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110109222=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110109223=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110109224='
      '110109225=        IF (ROW_COUNT = 0) THEN'
      
        '110109226=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110109227=    END'
      '110109228='
      
        '110109229=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' <> 5) THEN   -- '#1055#1056#1048' '#1056#1045#1042#1048#1047#1048#1048' '#1062#1045#1053#1067' '#1053#1045' '#1052#1045#1053#1071#1070
      '110109230=      UPDATE G_PRODUCT G'
      '110109231=         SET G.PRICE = :SALE_PRICE_'
      '110109232=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110109233=  END'
      '110109234=  ----------------------------------------'
      '110109235='
      
        '110109236=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110109237=  PNT_ = '#39'05'#39';'
      
        '110109238=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110109239=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110109240=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110109241=      ELSE'
      '110109242=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110109243='
      
        '110109244=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110109245=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110109246=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110109247=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110109248=                                        :SUMM_FACT_,'
      
        '110109249=                                        :DATE_RECEIPT_' +
        ','
      
        '110109250=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110109251=                                        NULL,   --ZAKA' +
        'Z_'
      '110109252=                                        :SKLAD_,'
      
        '110109253=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110109254=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110109255=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110109256=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110109257=            EXIT;'
      '110109258=          END'
      '110109259=      END ELSE BEGIN'
      '110109260=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110109261=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110109262=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110109263=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110109264=            ELSE'
      
        '110109265=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110109266='
      '110109267=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110109268=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110109269='
      
        '110109270=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110109271='
      '110109272=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110109273=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110109274=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110109275=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110109276=                                              :PAYMENT' +
        '_DATE_,'
      
        '110109277=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110109278=                                              NULL,   ' +
        '--ZAKAZ_'
      '110109279=                                              :SKLAD_,'
      
        '110109280=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110109281=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110109282=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110109283=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110109284=                  EXIT;'
      '110109285=                END'
      '110109286=            END'
      '110109287=          END'
      '110109288=      END'
      '110109289=  END'
      '110109290='
      '110109291=  DELETE FROM SKLAD_TMP;'
      '110109292='
      
        '110109293=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110109294=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110109295=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110109296=                                  G_PRIHOD_,'
      '110109297=                                  :SUMM_PRIHOD_,'
      '110109298=                                  :DATE_RECEIPT_,'
      
        '110109299=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110109300=                                  NULL,   --:ZAKAZ_,'
      '110109301=                                  :SKLAD_,'
      '110109302=                                  :G_PAYMENT_TYPE_,'
      
        '110109303=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110109304=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110109305=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110109306=      EXIT;'
      '110109307=    END'
      '110109308=  END'
      '110109309=end'
      '110109310=;'
      '110109311='
      '110109312=ALTER PROCEDURE UPD_SKLAD_TMP_ALL('
      
        '110109313=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC,'
      '110109314=  ROUND_MODE_ INTEGER)'
      '110109315=RETURNS ('
      '110109316=  ERR_CODE INTEGER,'
      '110109317=  ERR_MSG VARCHAR(1024))'
      '110109318=AS'
      '110109319=/*'
      '110109320='#1053#1040#1050#1056#1059#1058#1050#1040' '#1053#1040' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', '#1057' '#1054#1050#1056#1059#1043#1051#1045#1053#1048#1045#1052
      '110109321=*/'
      
        '110109322=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD_AL' +
        'L'#39';'
      '110109323=DECLARE VARIABLE ROUND_ INTEGER;'
      '110109324=begin'
      '110109325=  IF (ROUND_MODE_ = 0) THEN'
      '110109326=      ROUND_ = 1;'
      '110109327=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '110109328=      ROUND_ = 0;'
      '110109329=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '110109330=      ROUND_ = -1;'
      '110109331=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '110109332=      ROUND_ = -2;'
      '110109333=  ELSE IF (ROUND_MODE_ = 4) THEN'
      '110109334=      ROUND_ = -3;'
      '110109335='
      '110109336=  UPDATE SKLAD_TMP T'
      '110109337=     SET T.CHARGE_ROZN_PROC = :CHARGE_ROZN_PROC_,'
      
        '110109338=         T.PRICE_ROZN = ROUND( (T.PRICE + T.PRICE * :C' +
        'HARGE_ROZN_PROC_ / 100), :ROUND_);'
      '110109339=end'
      '110109340=;'
      
        '110109341=UPDATE SYSTEM_SETUP SET S_VALUE = 110109 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110109342=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110109343=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101100=ALTER PROCEDURE INS_SKLAD('
      '1101101=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1101102=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT' +
        ','
      
        '1101103=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIPT' +
        ','
      '1101104=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '1101105=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '1101106=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101107=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101108=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1101109=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11011010=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11011011=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11011012=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11011013=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11011014=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY = 0,'
      
        '11011015=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED ' +
        '= 0)'
      '11011016=RETURNS ('
      '11011017=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11011018=  ERR_CODE INTEGER,'
      '11011019=  ERR_MSG VARCHAR(1024))'
      '11011020=AS'
      '11011021=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '11011022=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042#1040 +
        #1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '11011023=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '11011024=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '11011025=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050 +
