      '11011111=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11011112=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11011113=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11011114=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '11011115=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11011116=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11011117=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11011118=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11011119=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11011120=  IS_MEBEL_ INTEGER = 0,'
      
        '11011121=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NULL' +
        ','
      
        '11011122=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE ' +
        '= NULL,'
      '11011123=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '11011124=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '11011125=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '11011126=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NU' +
        'LL)'
      '11011127=RETURNS ('
      '11011128=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11011129=  ERR_CODE INTEGER,'
      '11011130=  ERR_MSG VARCHAR(1024))'
      '11011131=AS'
      '11011132=/*'
      '11011133=IS_SPISANIE_'
      '11011134=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11011135=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11011136=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11011137=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11011138='
      '11011139='
      
        '11011140=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '11011141=*/'
      '11011142=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '11011143=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11011144=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11011145=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '11011146=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '11011147=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '11011148=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ';'
      
        '11011149=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      
        '11011150=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '11011151=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM;'
      '11011152=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11011153=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS_SUMM;'
      
        '11011154=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      
        '11011155=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11011156=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '11011157=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKA' +
        'Z_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '11011158=DECLARE VARIABLE CNT_ INTEGER;'
      '11011159=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11011160=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '11011161=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11011162=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11011163=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11011164=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11011165=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11011166=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11011167=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.S' +
        'ALES_COMM;'
      
        '11011168=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11011169=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11011170=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11011171=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '11011172=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM = 0;'
      
        '11011173=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '11011174=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIEN' +
        'T.SKIDKA;'
      
        '11011175=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCON' +
        'T_CARD.N_PERCENT;'
      
        '11011176=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.SUMM_ALL;'
      '11011177=BEGIN'
      '11011178='
      
        '11011179=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057#1048 +
        #1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055#1054 +
        #1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '11011180=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '11011181=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '11011182=  IF (CNT_ = 0) THEN BEGIN'
      '11011183=    ERR_CODE = -20500;'
      
        '11011184=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088#1086 +
        #1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090#1077 +
        ' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11011185=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '11011186=    EXIT;'
      '11011187=  END'
      '11011188='
      '11011189=  IF (G_TOCHKA_ IS NULL) THEN'
      '11011190=    SELECT ID'
      '11011191=      FROM CUR_PARAMS'
      '11011192=     WHERE CUR_PARAMS = 2'
      '11011193=      INTO :G_TOCHKA_;'
      '11011194='
      '11011195=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11011196=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '11011197=      PNT_ = '#39'01'#39';'
      
        '11011198=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11011199=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110111100=      ELSE'
      '110111101=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110111102='
      '110111103=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110111104=      SELECT G.G_OFFICIAL,'
      '110111105=             G.DO_NOT_SALES_COMM,'
      '110111106=             G.FM||'#39' '#39'||G.NM'
      '110111107=        FROM G_OFFICIAL G'
      
        '110111108=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110111109=        INTO :G_OFFICIAL_,'
      '110111110=             :DO_NOT_SALES_COMM_,'
      '110111111=             :OFFICIAL_NAME_;'
      '110111112='
      '110111113=      INSERT INTO ZAKAZ'
      '110111114=      ('
      '110111115=       ZAKAZ,'
      '110111116=       G_TOCHKA,'
      '110111117=       Z_DATE,'
      '110111118=       Z_TIME,'
      '110111119=       G_CLIENT,'
      '110111120=       G_PAYMENT_TYPE,'
      '110111121=       OSNOVANIE,'
      '110111122=       IS_SPISANIE,'
      '110111123=       NOTE,'
      '110111124=       SUMM,'
      '110111125=       SUMM_FACT,'
      '110111126=       SUMM_BONUS,'
      '110111127=       IS_PAYED_ALL'
      '110111128=       ,G_OFFICIAL'
      '110111129=       ,BY_RECIPE'
      '110111130=       ,SUMM_BONUS_GOT'
      '110111131=       ,IS_RESERVE'
      '110111132=       ,SUMM_CASH'
      '110111133=       ,SUMM_NONCASH'
      '110111134=      ) VALUES ('
      '110111135=       GEN_ID(GEN_ZAKAZ, 1),'
      '110111136=       :G_TOCHKA_,'
      '110111137=       :Z_DATE_,'
      '110111138=       :Z_TIME_,'
      '110111139=       :G_CLIENT_,'
      '110111140=       :G_PAYMENT_TYPE_,'
      '110111141=       :OSNOVANIE_,'
      '110111142=       :IS_SPISANIE_,'
      '110111143=       :NOTE_,'
      '110111144=       :SUMM_,'
      '110111145=       :SUMM_FACT_1_,'
      '110111146=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110111147=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110111148=       ,:G_OFFICIAL_'
      '110111149=       ,:BY_RECIPE_'
      '110111150=       ,:SUMM_BONUS_GOT_'
      '110111151=       ,:IS_RESERVE_'
      '110111152=       ,COALESCE(:SUMM_CASH_, 0)'
      '110111153=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110111154=      )'
      '110111155=      RETURNING'
      '110111156=        ZAKAZ'
      '110111157=      INTO'
      '110111158=        :ZAKAZ_;'
      '110111159='
      '110111160=      PNT_ = '#39'02'#39';'
      
        '110111161=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110111162=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM'
      '110111163=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110111164=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110111165=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110111166=              :G_PRODUCT,'
      '110111167=              :AMOUNT,'
      '110111168=              :PRICE,'
      '110111169=              :SUMM,'
      '110111170=              :DISCOUNT_PERC,'
      '110111171=              :DISCOUNT_TENGE,'
      '110111172=              :DISCOUNT_SUMM,'
      '110111173=              :NDS,'
      '110111174=              :NDS_SUMM,'
      '110111175=              :COST_PRICE,'
      '110111176=              :SALES_COMM_'
      '110111177=      DO BEGIN'
      
        '110111178=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110111179=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '110111180=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/1' +
        '00;'
      
        '110111181=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110111182=        END'
      '110111183='
      '110111184=        INSERT INTO ZAKAZ_DETAILS'
      '110111185=        VALUES('
      '110111186=          :ZAKAZ_DETAILS_TMP_,'
      '110111187=          :ZAKAZ_,'
      '110111188=          :G_PRODUCT,'
      '110111189=          :AMOUNT,'
      '110111190=          :PRICE,'
      '110111191=          :SUMM,'
      '110111192=          :DISCOUNT_PERC,'
      '110111193=          :DISCOUNT_TENGE,'
      '110111194=          :DISCOUNT_SUMM,'
      '110111195=          :NDS,'
      '110111196=          :NDS_SUMM,'
      '110111197=          :COST_PRICE,'
      '110111198=          :SALES_COMM_SUMM_ITER_'
      '110111199=        );'
      '110111200='
      '110111201=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '110111202=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '110111203=            UPDATE LT_SKLAD_PRODUCT L'
      '110111204=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110111205=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110111206=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110111207='
      '110111208=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110111209=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', ' +
        #1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053 +
        #1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110111210=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040 +
        #1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '110111211=            PNT_ = '#39'04'#39';'
      
        '110111212=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE F' +
        'ROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110111213=              Err_Code = -20500;'
      
        '110111214=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODU' +
        'CT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088 +
        #1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110111215=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110111216=              EXIT;'
      '110111217=            END ELSE if (ROW_COUNT = 0) then'
      
        '110111218=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110111219=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110111220=        END'
      '110111221='
      '110111222=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110111223=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110111224=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110111225=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :AMOUNT'
      '110111226=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110111227=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110111228=      END'
      '110111229='
      '110111230=      ----------------------------------------'
      
        '110111231=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063 +
        #1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110111232=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '110111233=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110111234='
      
        '110111235=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048',' +
        ' '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044 +
        #1048#1053' '#1055#1051#1040#1058#1045#1046
      '110111236=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110111237=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110111238=                PNT_ = '#39'05'#39';'
      
        '110111239=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110111240=                                              1,     -' +
        '- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110111241=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110111242=                                              :Z_DATE_' +
        ','
      
        '110111243=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110111244=                                              ZAKAZ_, ' +
        '  --ZAKAZ_'
      '110111245=                                              NULL,'
      
        '110111246=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110111247=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110111248=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110111249=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110111250=                  EXIT;'
      '110111251=                END'
      '110111252=            END'
      '110111253='
      '110111254=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110111255=        END ELSE BEGIN'
      '110111256=            PNT_ = '#39'06'#39';'
      
        '110111257=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110111258=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110111259=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110111260=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110111261=                ELSE'
      
        '110111262=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110111263='
      
        '110111264=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110111265=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110111266='
      
        '110111267=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110111268='
      '110111269=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110111270=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110111271=                                                  1,  ' +
        '   --:G_PRIHOD_RASHOD_,'
      
        '110111272=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110111273=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110111274=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110111275=                                                  :ZAK' +
        'AZ_,'
      
        '110111276=                                                  NULL' +
        ',     --:SKLAD_,'
      
        '110111277=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110111278=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110111279=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110111280=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110111281=                      EXIT;'
      '110111282=                    END'
      '110111283=                END'
      '110111284=            END'
      '110111285=        END'
      '110111286=      END'
      '110111287='
      
        '110111288=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '110111289=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041 +
        #1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '110111290=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052 +
        ' '#1057#1051#1059#1063#1040#1045
      
        '110111291=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054' ' +
        #1051#1048#1062#1040'"'
      '110111292=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '110111293=          UPDATE G_DISCONT_CARD D'
      
        '110111294=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_,' +
        ' 0) + :SUMM_BONUS_GOT_,'
      '110111295=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110111296=          WHERE D.G_CLIENT = :G_CLIENT_'
      '110111297=          RETURNING'
      '110111298=            D.SUMM_ALL'
      '110111299=          INTO'
      '110111300=            :CLIENT_SUMM_ALL_;'
      '110111301='
      '110111302=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '110111303=            FROM G_CLIENT_DISC_VAL_GRID G'
      '110111304=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '110111305=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '110111306=          ORDER BY G.SUMM_FROM'
      '110111307=          ROWS 1 TO 1'
      '110111308=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '110111309='
      '110111310=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '110111311=            UPDATE G_CLIENT G'
      '110111312=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '110111313=             WHERE G.G_CLIENT = :G_CLIENT_'
      '110111314=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '110111315='
      '110111316=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '110111317=            UPDATE G_DISCONT_CARD D'
      '110111318=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '110111319=             WHERE D.G_CLIENT = :G_CLIENT_'
      '110111320=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '110111321=      END'
      '110111322='
      '110111323=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '110111324=      PNT_ = '#39'07'#39';'
      
        '110111325=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COM' +
        'M_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN B' +
        'EGIN'
      '110111326=        SELECT S.S_VALUE'
      '110111327=          FROM SYSTEM_SETUP S'
      '110111328=         WHERE S.SYSTEM_SETUP = 4'
      '110111329=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '110111330='
      '110111331=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '110111332=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110111333=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110111334='
      
        '110111335=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' ' +
        #1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '110111336=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '110111337=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE' +
        '(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM ' +
        'CURRENT_DATE)));'
      '110111338='
      '110111339=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '110111340=        ELSE'
      
        '110111341=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DA' +
        'Y FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTR' +
        'ACT(DAY FROM current_date) + 32);'
      '110111342='
      '110111343=        KASSA_ = NULL;'
      '110111344=        SELECT K.KASSA, K.SUMM'
      '110111345=        FROM KASSA K'
      '110111346=        WHERE K.G_PRIHOD_RASHOD = -1'
      '110111347=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110111348=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110111349=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110111350=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110111351='
      '110111352=        IF (KASSA_ IS NULL) THEN'
      
        '110111353=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110111354=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110111355=                                          :SALES_COMM_' +
        'SUMM_ALL_,'
      
        '110111356=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110111357=                                          :OFFICIAL_NA' +
        'ME_,'
      
        '110111358=                                          NULL,     --' +
        ':ZAKAZ_,'
      
        '110111359=                                          NULL,     --' +
        ':SKLAD_,'
      '110111360=                                          1,'
      '110111361=                                          :G_TOCHKA_,'
      '110111362=                                          :G_OFFICIAL_'
      
        '110111363=                                          ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110111364=        ELSE'
      '110111365=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110111366=                                          1,     -- AC' +
        'TION_'
      
        '110111367=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110111368=                                          :SALES_COMM_' +
        'SUMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '110111369=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110111370=                                          :OFFICIAL_NA' +
        'ME_,   --NOTE_'
      '110111371=                                          NULL,'
      '110111372=                                          NULL,'
      
        '110111373=                                          :PAYMENT_TYP' +
        'E_,'
      '110111374=                                          :G_OFFICIAL_'
      
        '110111375=                                          ) RETURNING_' +
        'VALUES :ERR_CODE, :ERR_MSG;'
      '110111376='
      '110111377=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110111378=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110111379=          EXIT;'
      '110111380=        END'
      '110111381=      END'
      '110111382='
      '110111383=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '110111384=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0)' +
        ' THEN'
      
        '110111385=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110111386=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 1);'
      '110111387=  END'
      '110111388=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110111389=  ----------------------------------------'
      '110111390=  ----------------------------------------'
      '110111391=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110111392=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '110111393=      PNT_ = '#39'25'#39';'
      
        '110111394=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
        'A)'
      
        '110111395=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLI' +
        'ENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA' +
        '_)'
      '110111396=      RETURNING ZAKAZ_REAL_PARENT'
      '110111397=      INTO :ZAKAZ_REAL_PARENT_;'
      '110111398='
      
        '110111399=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCO' +
        'UNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '110111400=            FROM ZAKAZ_DETAILS_TMP Z'
      '110111401=          INTO :G_PRODUCT,'
      '110111402=              :AMOUNT,'
      '110111403=              :PRICE,'
      '110111404=              :SUMM,'
      '110111405=              :DISCOUNT_PERC,'
      '110111406=              :DISCOUNT_TENGE,'
      '110111407=              :DISCOUNT_SUMM,'
      '110111408=              :NDS,'
      '110111409=              :NDS_SUMM'
      '110111410=      DO BEGIN'
      '110111411=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110111412=          UPDATE LT_SKLAD_PRODUCT L'
      '110111413=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110111414=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '110111415=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110111416='
      
        '110111417=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053#1054 +
        ' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045' ' +
        #1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110111418=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048 +
        #1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '110111419=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FRO' +
        'M SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110111420=            Err_Code = -20500;'
      
        '110111421=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1055 +
        #1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUCT' +
        ' = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110111422=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110111423=            EXIT;'
      '110111424=          END ELSE if (ROW_COUNT = 0) then'
      
        '110111425=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRO' +
        'DUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110111426=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :' +
        'G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110111427='
      
        '110111428=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZA' +
        'KAZ_REAL_PARENT,'
      '110111429=                                     G_PRODUCT,'
      '110111430=                                     PRICE,'
      
        '110111431=                                     AMOUNT_ALL, SUMM_' +
        'ALL,'
      
        '110111432=                                     AMOUNT_PAYED, SUM' +
        'M_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_S' +
        'UMM, NDS,'
      '110111433=                                     NDS_SUMM)'
      
        '110111434=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ' +
        '_REAL_PARENT_,'
      '110111435=                  :G_PRODUCT,'
      
        '110111436=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040 +
        #1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '110111437=                  :AMOUNT, :SUMM,'
      '110111438=                  0, --AMOUNT_PAYED,'
      '110111439=                  0, --SUMM_PAYED,'
      '110111440=                  0, --IS_PAYED_ALL,'
      '110111441=                  :DISCOUNT_PERC,'
      '110111442=                  :DISCOUNT_TENGE,'
      '110111443=                  :DISCOUNT_SUMM,'
      '110111444=                  :NDS,'
      '110111445=                  :NDS_SUMM)'
      '110111446=          RETURNING ZAKAZ_NA_REAL'
      '110111447=          INTO :ZAKAZ_;'
      '110111448=      END'
      '110111449=  END'
      '110111450=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110111451=  ----------------------------------------'
      '110111452=  ----------------------------------------'
      '110111453=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '110111454=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046 +
        #1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '110111455=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', ' +
        #1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110111456=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '110111457=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, T' +
        'IME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SU' +
        'MM_FACT,'
      
        '110111458=                                IS_PAYED_ALL, IS_VOZVR' +
        'AT, G_TOCHKA)'
      
        '110111459=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_' +
        ', :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SU' +
        'MM_FACT_,'
      '110111460=              1, 3, :G_CLIENT_)'
      '110111461=      RETURNING SKLAD'
      '110111462=      INTO :SKLAD_;'
      '110111463='
      '110111464=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110111465=            FROM ZAKAZ_DETAILS_TMP Z'
      '110111466=          INTO :G_PRODUCT,'
      '110111467=              :AMOUNT,'
      '110111468=              :PRICE,'
      '110111469=              :SUMM'
      '110111470=      DO BEGIN'
      '110111471=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110111472=        UPDATE LT_SKLAD_PRODUCT L'
      '110111473=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110111474=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110111475=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110111476='
      '110111477=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '110111478=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1053#1045#1058
      
        '110111479=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045#1064 +
        #1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' '#1062 +
        #1045#1053#1059
      '110111480=        SELECT MAX(SK.DATE_RECEIPT)'
      '110111481=            FROM SKLAD SK'
      '110111482=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110111483=             AND SK.IS_LAST = 1'
      '110111484=             AND SK.G_TOCHKA = :G_CLIENT_'
      '110111485=            INTO :DATE_LAST_;'
      '110111486='
      
        '110111487=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or' +
        ' (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110111488=            UPDATE SKLAD SK'
      '110111489=               SET SK.IS_LAST = 0'
      '110111490=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110111491=               AND SK.IS_LAST = 1'
      '110111492=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '110111493='
      '110111494=            IS_THIS_LAST_ = 1;'
      '110111495=        END */'
      '110111496='
      '110111497='
      '110111498=        INSERT INTO SKLAD'
      '110111499=        ('
      '110111500=         SKLAD,'
      '110111501=         SKLAD_PARENT,'
      '110111502=         DATE_RECEIPT,'
      '110111503=         G_CLIENT,'
      '110111504=         G_PRODUCT,'
      '110111505=         AMOUNT,'
      '110111506=         PRICE,'
      '110111507=         SUMM,'
      '110111508=         G_PAYMENT_TYPE,'
      '110111509=         OSNOVANIE,'
      '110111510=         NOTE,'
      '110111511=         NDS,'
      '110111512=         NDS_SUMM,'
      '110111513=         IS_LAST,'
      '110111514=         IS_VOZVRAT,'
      '110111515=         G_TOCHKA'
      '110111516=        ) VALUES ('
      '110111517=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '110111518=         :SKLAD_,'
      '110111519=         :Z_DATE_,'
      '110111520=         :G_TOCHKA_,'
      '110111521=         :G_PRODUCT,'
      '110111522=         :AMOUNT,'
      '110111523=         :PRICE,'
      '110111524=         :SUMM,'
      '110111525=         :G_PAYMENT_TYPE_,'
      '110111526=         :OSNOVANIE_,'
      '110111527=         :NOTE_,'
      '110111528=         0,  --:RNDS_,'
      '110111529=         0,  --:RNDS_SUMM_,'
      
        '110111530=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040 +
        ' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040 +
        ' '#1041#1059#1044#1045#1058' 0'
      '110111531=         3,  --:IS_VOZVRAT_,'
      '110111532=         :G_CLIENT_'
      '110111533=        );'
      '110111534='
      
        '110111535=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110111536=        PNT_ = '#39'02'#39';'
      '110111537=        UPDATE LT_SKLAD_PRODUCT L'
      '110111538=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '110111539=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110111540=           AND L.G_TOCHKA = :G_CLIENT_;'
      '110111541='
      '110111542=        IF (ROW_COUNT = 0) THEN'
      
        '110111543=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '110111544=      END'
      '110111545=  END'
      '110111546='
      '110111547=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110111548='
      
        '110111549=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '110111550=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110111551=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =>' +
        ' :ACTION_'
      '110111552=                                  G_PRIHOD_,'
      '110111553=                                  :SUMM_PRIHOD_,'
      '110111554=                                  :Z_DATE_,'
      
        '110111555=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110111556=                                  :ZAKAZ_,'
      '110111557=                                  NULL,'
      '110111558=                                  :G_PAYMENT_TYPE_,'
      
        '110111559=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110111560=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110111561=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110111562=      EXIT;'
      '110111563=    END'
      '110111564=  END'
      '110111565='
      
        '110111566=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057 +
        #1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '110111567=  IF (IS_MEBEL_ = 1) THEN'
      
        '110111568=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS' +
        ', ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '110111569=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, ' +
        ':ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '110111570=end'
      '110111571=;'
      
        '110111572=UPDATE SYSTEM_SETUP SET S_VALUE = 110111 WHERE SYSTEM_' +
        'SETUP = 3;'
      
