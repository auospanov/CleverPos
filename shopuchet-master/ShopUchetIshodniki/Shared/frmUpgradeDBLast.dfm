        '11012172=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050' ' +
        #1055#1056#1048#1052#1045#1056#1059' '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1057#1058#1040#1050#1040#1053#1040' (5 '#1064#1058') '#1048' '#1050#1056#1067#1064#1050#1048' (4 '#1064#1058'),' +
        ' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '11012173=  -- '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' = 4'
      
        '11012174=  -- '#1053#1040#1042#1045#1057#1048#1051' '#1053#1040' '#1058#1056#1048#1043#1043#1045#1056', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1053#1054#1043#1054' '#1043#1044#1045' '#1053#1040#1044#1054' '#1069#1058#1054' ' +
        #1044#1045#1051#1040#1058#1068' - '#1055#1056#1048#1061#1054#1044', '#1055#1056#1054#1044#1040#1046#1048', '#1056#1045#1044#1040#1050#1058#1048#1056#1042#1054#1040#1053#1048#1045' '#1055#1056#1048#1061#1054#1044#1054#1042'/'#1055#1056#1054#1044#1040#1046
      
        '11012175=DECLARE VARIABLE G_PRODUCT_SOSTAV_  TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT;'
      
        '11012176=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11012177=DECLARE VARIABLE CNT_ INTEGER;'
      '11012178=BEGIN'
      
        '11012179=  IF (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39') IS N' +
        'OT NULL) THEN EXIT;'
      '11012180=  FOR SELECT K.G_PRODUCT'
      '11012181=        FROM G_PRODUCT_KIT K, G_PRODUCT G'
      '11012182=       WHERE K.G_PRODUCT_ITEM = NEW.g_product'
