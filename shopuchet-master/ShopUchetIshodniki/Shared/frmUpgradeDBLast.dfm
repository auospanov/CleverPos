      '11040568=END'
      '11040569='#39';'
      '11040570='
      '11040571=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD('
      
        '11040572=  SKLAD_PARENT_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */' +
        ' INTEGER,'
      
        '11040573=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD.DATE_RECEIPT */' +
        ' DATE,'
      
        '11040574=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_REC' +
        'EIPT */ TIME,'
      
        '11040575=  G_CLIENT_ /* TYPE OF COLUMN SKLAD.G_CLIENT */ INTEGER' +
        ','
      
        '11040576=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN SKLAD.G_PAYMENT_TYP' +
        'E */ INTEGER,'
      
        '11040577=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD.OSNOVANIE */ VARCH' +
        'AR(150),'
      '11040578=  NOTE_ /* TYPE OF COLUMN SKLAD.NOTE */ VARCHAR(200),'
      '11040579=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '11040580=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMER' +
        'IC(15,2),'
      
        '11040581=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ INTEGER,'
      
        '11040582=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      '11040583=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11040584=  SUMM_CURRENCY_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_CU' +
        'RRENCY */ NUMERIC(15,2) = 0,'
      
        '11040585=  IS_EXPECTED_ /* TYPE OF COLUMN SKLAD_PARENT.IS_EXPECT' +
        'ED */ INTEGER = 0)'
      '11040586=RETURNS ('
      '11040587=  ERR_CODE INTEGER,'
      '11040588=  ERR_MSG VARCHAR(1024))'
      '11040589=AS'
      '11040590=BEGIN'
      '11040591=  SUSPEND;'
      '11040592=END'
      '11040593='#39';'
      '11040594='
      '11040595='
      '11040596=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD('
      '11040597=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '11040598=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '11040599=RETURNS ('
      '11040600=  ERR_CODE INTEGER,'
      '11040601=  ERR_MSG VARCHAR(1024))'
      '11040602=AS'
      '11040603=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD'#39#39';'
      '11040604=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11040605=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11040606=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '11040607=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      '11040608=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11040609=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      
        '11040610=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11040611=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071')' +
        ' */'
      '11040612=BEGIN'
      '11040613='
      '11040614=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '11040615=    SELECT S_VALUE'
      '11040616=      FROM SYSTEM_SETUP'
      '11040617=     WHERE SYSTEM_SETUP = 2'
      '11040618=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11040619='
      '11040620=  SELECT IS_VOZVRAT,'
      
        '11040621=         G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TOCHKA ' +
        #1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '11040622=    FROM SKLAD_PARENT'
      '11040623=   WHERE SKLAD = :SKLAD_'
      '11040624=    INTO :IS_VOZVRAT_,'
      '11040625=         :G_TOCHKA_;'
      '11040626='
      '11040627=  PNT_ = '#39#39'01'#39#39';'
      '11040628=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '11040629=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        ' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '11040630=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040#1045#1058 +
        ' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      '11040631=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '11040632=      FOR SELECT S.G_PRODUCT,'
      '11040633=                 SUM(S.AMOUNT)'
      '11040634=            FROM SKLAD S'
      '11040635=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '11040636=           GROUP BY S.G_PRODUCT'
      '11040637=            INTO :G_PRODUCT_,'
      '11040638=                 :AMOUNT_PRIHOD_'
      '11040639=      DO BEGIN'
      '11040640=          SELECT L.AMOUNT,'
      '11040641=                 G.NAME'
      '11040642=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '11040643=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11040644=             AND L.G_PRODUCT = G.G_PRODUCT'
      '11040645=             AND L.G_TOCHKA = :G_TOCHKA_'
      '11040646=            INTO :AMOUNT_LAST_,'
      '11040647=                 :NAME_;'
      '11040648='
      
        '11040649=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) TH' +
        'EN BEGIN'
      '11040650=              ERR_CODE = -20500;'
      
        '11040651=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39#39'||NAME_||'#39#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! ' +
        #1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_M' +
        'SG);'
      
        '11040652=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||' +
        #39#39' '#39#39'||ERR_MSG;'
      '11040653=              EXIT;'
      '11040654=          END'
      '11040655=      END'
      '11040656=  END'
      '11040657='
      
        '11040658=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11040659=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11040660=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11040661=    EXIT;'
      '11040662=  END'
      '11040663='
      '11040664=  -------------------------------------'
      
        '11040665=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069 +
        #1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040 +
        #1044#1040
      
        '11040666=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053#1067#1045 +
        ' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1055#1054 +
        #1044#1056#1071#1044
      '11040667=  PNT_ = '#39#39'05'#39#39';'
      '11040668=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '11040669=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '11040670=      FOR SELECT S.KASSA'
      '11040671=            FROM KASSA S'
      '11040672=           WHERE S.SKLAD = :SKLAD_'
      '11040673=            INTO :KASSA_'
      '11040674=      DO BEGIN'
      
        '11040675=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11040676=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11040677=             ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '11040678=             EXIT;'
      '11040679=          END'
      '11040680=      END'
      '11040681='
      '11040682=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '11040683=      FOR SELECT S.KASSA_BEZNAL'
      '11040684=            FROM KASSA_BEZNAL S'
      '11040685=           WHERE S.SKLAD = :SKLAD_'
      '11040686=            INTO :KASSA_'
      '11040687=      DO BEGIN'
      
        '11040688=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11040689=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11040690=             ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '11040691=             EXIT;'
      '11040692=          END'
      '11040693=      END'
      '11040694=  END'
      '11040695=  -------------------------------------'
      '11040696='
      '11040697=  PNT_ = '#39#39'06'#39#39';'
      '11040698=  DELETE FROM sklad_PARENT'
      '11040699=  WHERE sklad = :sklad_;'
      '11040700='
      '11040701=when sqlcode -530 DO'
      '11040702=  begin'
      '11040703=    ERR_CODE = -20500;'
      
        '11040704=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11040705=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11040706=  end'
      '11040707=end'
      '11040708='#39';'
      '11040709='
      '11040710=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD_DETAIL('
      '11040711=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11040712=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '11040713=RETURNS ('
      '11040714=  ERR_CODE INTEGER,'
      '11040715=  ERR_MSG VARCHAR(1024))'
      '11040716=AS'
      
        '11040717=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD_DET' +
        'AIL'#39#39';'
      '11040718=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '11040719=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      '11040720=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '11040721=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '11040722=DECLARE VARIABLE IS_LAST_ TYPE OF COLUMN SKLAD.IS_LAST;'
      
        '11040723=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      
        '11040724=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA' +
        '_REAL.ZAKAZ_NA_REAL;'
      
        '11040725=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11040726=DECLARE VARIABLE G_PRODUCT_SOSTAV_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT;'
      
        '11040727=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      
        '11040728=DECLARE VARIABLE IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_EXPECTED;'
      
        '11040729=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071')' +
        ' */'
      
        '11040730=DECLARE VARIABLE G_TOCHKA_PROVIDER_ TYPE OF COLUMN G_TO' +
        'CHKA.G_TOCHKA;'
      '11040731=BEGIN'
      '11040732=  PNT_ = '#39#39'01'#39#39';'
      '11040733=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1053#1048#1052#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11040734=  FOR SELECT S.G_PRODUCT,'
      '11040735=             S.AMOUNT,'
      '11040736=             S.IS_LAST'
      '11040737=             ,SP.IS_VOZVRAT'
      '11040738=             ,SP.G_TOCHKA'
      '11040739=             ,SP.IS_EXPECTED'
      '11040740=             ,SP.G_CLIENT'
      '11040741=        FROM SKLAD S, SKLAD_PARENT SP'
      '11040742=       WHERE SP.SKLAD = S.SKLAD_PARENT'
      '11040743=         AND S.SKLAD_PARENT = :SKLAD_PARENT_'
      '11040744=         AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '11040745=       INTO :G_PRODUCT_,'
      '11040746=            :AMOUNT_,'
      '11040747=            :IS_LAST_'
      '11040748=            ,:IS_VOZVRAT_'
      '11040749=            ,:G_TOCHKA_'
      '11040750=            ,:IS_EXPECTED_'
      '11040751=            ,:G_TOCHKA_PROVIDER_'
      '11040752=  DO BEGIN'
      '11040753=    IF (IS_EXPECTED_ = 0) THEN'
      '11040754=        UPDATE LT_SKLAD_PRODUCT LT'
      '11040755=           SET LT.AMOUNT = LT.AMOUNT - :AMOUNT_'
      '11040756=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '11040757=           AND LT.G_TOCHKA = :G_TOCHKA_;'
      '11040758='
      
        '11040759=    IF (IS_LAST_ = 1) then    -- '#1045#1057#1051#1048' '#1057#1058#1054#1048#1058' IS_LAST, '#1058#1054 +
        ' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1045#1043#1054' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048', '#1063#1058#1054#1041#1067' '#1053#1045' '#1058#1045#1056#1071#1058#1068' '#1055#1054#1057#1051#1045#1044#1053#1070#1070 +
        ' '#1055#1054#1057#1058#1040#1042#1050#1059
      '11040760=        UPDATE SKLAD SK'
      '11040761=             SET SK.IS_LAST = 1'
      '11040762=           WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11040763=             AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '11040764=                               FROM SKLAD SS'
      
        '11040765=                              WHERE SS.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '11040766=                                AND SS.G_PRODUCT = SK.G' +
        '_PRODUCT'
      
        '11040767=                                AND SS.SKLAD_PARENT <> ' +
        ':SKLAD_PARENT_'
      
        '11040768=                                AND SS.DATE_RECEIPT = (' +
        'SELECT MAX(SSS.DATE_RECEIPT)'
      
        '11040769=                                                       ' +
        '  FROM SKLAD SSS'
      
        '11040770=                                                       ' +
        ' WHERE SSS.G_PRODUCT = SS.G_PRODUCT'
      
        '11040771=                                                       ' +
        '   AND SSS.IS_VOZVRAT in (0, 3, 4)'
      
        '11040772=                                                       ' +
        '   AND SSS.SKLAD_PARENT <> :SKLAD_PARENT_'
      
        '11040773=                                                       ' +
        '   AND SSS.G_TOCHKA = :G_TOCHKA_));'
      '11040774='
      '11040775=  END'
      '11040776='
      '11040777=  PNT_ = '#39#39'02'#39#39';'
      
        '11040778=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051'. '#1042' '#1069#1058 +
        #1054#1052' '#1057#1051#1059#1063#1040#1045' '#1050#1054#1051'-'#1042#1054' '#1053#1040#1044#1054' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1058#1068' '#1050#1054#1051'-'#1042#1054' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1048' '#1059#1044#1040#1051#1071 +
        #1058#1068' '#1044#1040#1053#1053#1067#1045
      '11040779=  -- '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067' LT_ZAKAZ_REAL'
      '11040780=  IF (IS_VOZVRAT_ = 2) THEN BEGIN'
      '11040781=    FOR SELECT ZD.AMOUNT,'
      '11040782=             ZD.PRICE,'
      '11040783=             LZ.ZAKAZ_NA_REAL'
      '11040784=        FROM SKLAD ZD,'
      '11040785=             LT_ZAKAZ_REAL LZ'
      '11040786=       WHERE ZD.SKLAD_PARENT = :SKLAD_PARENT_'
      '11040787=         AND ZD.SKLAD = COALESCE(:SKLAD_, ZD.SKLAD)'
      '11040788=         AND ZD.SKLAD = LZ.SKLAD'
      '11040789=       INTO :AMOUNT_,'
      '11040790=            :PRICE_,'
      '11040791=            :ZAKAZ_NA_REAL_'
      '11040792=    DO BEGIN'
      '11040793=      UPDATE ZAKAZ_NA_REAL ZRR'
      
        '11040794=         SET ZRR.AMOUNT_RETURNED = ZRR.AMOUNT_RETURNED ' +
        '- :AMOUNT_,'
      
        '11040795=             ZRR.SUMM_RETURNED = ZRR.SUMM_RETURNED - :A' +
        'MOUNT_ * :PRICE_,'
      '11040796=             ZRR.IS_PAYED_ALL = 0'
      '11040797=       WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '11040798=    END'
      '11040799='
      '11040800=    IF (SKLAD_ IS NOT NULL) THEN'
      
        '11040801=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD = :SKLA' +
        'D_;'
      '11040802=    ELSE'
      
        '11040803=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD IN (SEL' +
        'ECT SKLAD FROM SKLAD WHERE SKLAD_PARENT = :SKLAD_PARENT_);'
      '11040804=  END'
      
        '11040805=  -- '#1055#1056#1048#1041#1040#1042#1051#1070' '#1048#1061' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050', '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1058#1056#1040 +
        #1053#1057#1060#1045#1056' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11040806=  ELSE IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '11040807=    FOR SELECT S.G_PRODUCT,'
      '11040808=               S.AMOUNT'
      '11040809=          FROM SKLAD S'
      '11040810=         WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '11040811=           AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '11040812=          INTO :G_PRODUCT_,'
      '11040813=               :AMOUNT_PRIHOD_'
      '11040814=    DO BEGIN'
      '11040815=      UPDATE LT_SKLAD_PRODUCT L'
      '11040816=         SET L.AMOUNT = L.AMOUNT + :AMOUNT_PRIHOD_'
      '11040817=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11040818=         AND L.G_TOCHKA = :G_TOCHKA_PROVIDER_;'
      '11040819=    END'
      '11040820=  END'
      '11040821='
      '11040822=  PNT_ = '#39#39'03'#39#39';'
      
        '11040823=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054 +
        #1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040 +
        ', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '11040824=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050' ' +
        #1055#1056#1048#1052#1045#1056#1059' '#1058#1045#1057#1058#1054' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1052#1059#1050#1048' (5 '#1064#1058') '#1048' '#1057#1040#1061#1040#1056#1040' (4 '#1064#1058'), '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042 +
        #1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1045#1057#1058#1040' = 4'
      '11040825=  /*FOR SELECT K.G_PRODUCT'
      '11040826=        FROM SKLAD ZD,'
      '11040827=             G_PRODUCT_KIT K'
      '11040828=       WHERE ZD.G_PRODUCT = K.G_PRODUCT_ITEM'
      '11040829=         AND ZD.sklad_parent = :SKLAD_PARENT_'
      '11040830=       GROUP BY K.G_PRODUCT'
      '11040831=       INTO :G_PRODUCT_SOSTAV_'
      '11040832=  DO BEGIN'
      '11040833=    SELECT MIN(L.AMOUNT)'
      '11040834=      FROM G_PRODUCT_KIT K,'
      '11040835=           LT_SKLAD_PRODUCT L'
      '11040836=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '11040837=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '11040838=       AND L.G_TOCHKA = :G_TOCHKA_'
      '11040839=     GROUP BY K.G_PRODUCT'
      '11040840=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11040841='
      '11040842=    UPDATE LT_SKLAD_PRODUCT L'
      '11040843=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '11040844=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_;'
      '11040845=  END*/'
      '11040846='
      '11040847=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '11040848=  PNT_ = '#39#39'04'#39#39';'
      '11040849=  DELETE from SKLAD S'
      '11040850=  WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '11040851=    AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD);'
      '11040852='
      '11040853=when sqlcode -530 DO'
      '11040854=  begin'
      '11040855=    ERR_CODE = -20500;'
      
        '11040856=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11040857=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11040858=  end'
      '11040859=end'
      '11040860='#39';'
      '11040861=END  --END_EXECUTE_BLOCK'
      '11040862=EXECUTE BLOCK AS BEGIN'
      '11040863='
      '11040864=EXECUTE STATEMENT '#39'ALTER PROCEDURE DELIVERY_DEL('
      '11040865=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY)'
      '11040866=AS'
      '11040867=BEGIN'
      '11040868=  DELETE FROM DELIVERY'
      '11040869=  WHERE DELIVERY = COALESCE(:DELIVERY_, DELIVERY);'
      '11040870=END'
      '11040871='#39';'
      '11040872='
      '11040873=EXECUTE STATEMENT '#39'ALTER PROCEDURE DELIVERY_GET('
      '11040874=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY)'
      '11040875=RETURNS ('
      '11040876=  G_CLIENT_ TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '11040877=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      '11040878=  DOSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11040879=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE,'
      '11040880=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS,'
      '11040881=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE,'
      '11040882=  NOTE_ TYPE OF COLUMN DELIVERY.NOTE,'
      '11040883=  STATUS_ TYPE OF COLUMN DELIVERY.STATUS,'
      '11040884=  ZAKAZ_ TYPE OF COLUMN DELIVERY.ZAKAZ,'
      '11040885=  SKLAD_ TYPE OF COLUMN DELIVERY.SKLAD,'
      
        '11040886=  TOVAR_DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.TOVAR_DE' +
        'LIVERY_DATE)'
      '11040887=AS'
      '11040888=BEGIN'
      '11040889=  SELECT D.G_CLIENT,'
      '11040890=         DOSTAVSHIK,'
      '11040891=         DELIVERY_DATE,'
      '11040892=         ADDRESS,'
      '11040893=         PRICE,'
      '11040894=         D.NOTE,'
      '11040895=         STATUS,'
      '11040896=         ZAKAZ,'
      '11040897=         SKLAD,'
      '11040898=         TOVAR_DELIVERY_DATE'
      '11040899=         ,C.NAME'
      
        '11040900=  FROM DELIVERY D LEFT OUTER JOIN G_CLIENT C ON D.DOSTA' +
        'VSHIK = C.G_CLIENT'
      '11040901=  WHERE DELIVERY = :DELIVERY_'
      '11040902=  INTO :G_CLIENT_,'
      '11040903=       :DOSTAVSHIK_,'
      '11040904=       :DELIVERY_DATE_,'
      '11040905=       :ADDRESS_,'
      '11040906=       :PRICE_,'
      '11040907=       :NOTE_,'
      '11040908=       :STATUS_,'
      '11040909=       :ZAKAZ_,'
      '11040910=       :SKLAD_,'
      '11040911=       :TOVAR_DELIVERY_DATE_'
      '11040912=       ,:DOSTAVSHIK_NAME_;'
      '11040913=END'
      '11040914='#39';'
      '11040915='
      '11040916=EXECUTE STATEMENT '#39'ALTER PROCEDURE DELIVERY_INS('
      '11040917=  G_CLIENT_ TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '11040918=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      '11040919=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE,'
      '11040920=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS,'
      '11040921=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE,'
      '11040922=  NOTE_ TYPE OF COLUMN DELIVERY.NOTE,'
      '11040923=  STATUS_ TYPE OF COLUMN DELIVERY.STATUS,'
      '11040924=  ZAKAZ_ TYPE OF COLUMN DELIVERY.ZAKAZ,'
      '11040925=  SKLAD_ TYPE OF COLUMN DELIVERY.SKLAD,'
      
        '11040926=  TOVAR_DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.TOVAR_DE' +
        'LIVERY_DATE)'
      '11040927=RETURNS ('
      '11040928=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY)'
      '11040929=AS'
      '11040930=BEGIN'
      '11040931=  INSERT INTO DELIVERY ('
      '11040932=    DELIVERY,'
      '11040933=    G_CLIENT,'
      '11040934=    DOSTAVSHIK,'
      '11040935=    DELIVERY_DATE,'
      '11040936=    ADDRESS,'
      '11040937=    PRICE,'
      '11040938=    NOTE,'
      '11040939=    STATUS,'
      '11040940=    ZAKAZ,'
      '11040941=    SKLAD,'
      '11040942=    TOVAR_DELIVERY_DATE'
      '11040943=    )'
      '11040944=  VALUES ('
      '11040945=    GEN_ID(GEN_DELIVERY, 1),'
      '11040946=    :G_CLIENT_,'
      '11040947=    :DOSTAVSHIK_,'
      '11040948=    :DELIVERY_DATE_,'
      '11040949=    :ADDRESS_,'
      '11040950=    :PRICE_,'
      '11040951=    :NOTE_,'
      '11040952=    :STATUS_,'
      '11040953=    :ZAKAZ_,'
      '11040954=    :SKLAD_,'
      '11040955=    :TOVAR_DELIVERY_DATE_'
      '11040956=    )'
      '11040957=  RETURNING'
      '11040958=    DELIVERY'
      '11040959=  INTO'
      '11040960=    :DELIVERY_;'
      '11040961=END'
      '11040962='#39';'
      '11040963='
      '11040964=EXECUTE STATEMENT '#39'ALTER PROCEDURE DELIVERY_READ('
      '11040965=  DATE_ DATE)'
      '11040966=RETURNS ('
      '11040967=  DELIVERY TYPE OF COLUMN DELIVERY.DELIVERY,'
      '11040968=  G_CLIENT TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '11040969=  DOSTAVSHIK TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      
        '11040970=  TOVAR_DELIVERY_DATE TYPE OF COLUMN DELIVERY.TOVAR_DEL' +
        'IVERY_DATE,'
      '11040971=  DELIVERY_DATE TYPE OF COLUMN DELIVERY.DELIVERY_DATE,'
      '11040972=  ADDRESS TYPE OF COLUMN DELIVERY.ADDRESS,'
      '11040973=  PRICE TYPE OF COLUMN DELIVERY.PRICE,'
      '11040974=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11040975=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '11040976=  DOST_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11040977=  NOTE TYPE OF COLUMN DELIVERY.NOTE,'
      '11040978=  STATUS VARCHAR(50),'
      '11040979=  ZAKAZ VARCHAR(50))'
      '11040980=AS'
      '11040981=BEGIN'
      '11040982=  FOR SELECT DELIVERY,'
      '11040983=             D.G_CLIENT,'
      '11040984=             DOSTAVSHIK,'
      '11040985=             TOVAR_DELIVERY_DATE,'
      '11040986=             DELIVERY_DATE,'
      '11040987=             ADDRESS,'
      '11040988=             PRICE,'
      '11040989=             D.NOTE'
      '11040990=             ,GC.NAME'
      '11040991=             ,GC.PHONE'
      '11040992=             ,DS.NAME'
      
        '11040993=             ,DECODE(STATUS, 0, '#39#39' '#1053#1077' '#1076#1086#1089#1090#1072#1074#1083#1077#1085#1086#39#39', 1, ' +
        #39#39#1044#1086#1089#1090#1072#1074#1083#1077#1085#1086#39#39') status'
      
        '11040994=             ,Z.ZAKAZ ||'#39#39' '#1086#1090' '#39#39'||lpad(extract(day from' +
        ' Z.Z_DATE),2,'#39#39'0'#39#39') ||'
      
        '11040995=               '#39#39'.'#39#39' || lpad(extract(month from Z.Z_DAT' +
        'E),2,'#39#39'0'#39#39') ||'
      '11040996=               '#39#39'.'#39#39' || extract(year from Z.Z_DATE)'
      
        '11040997=      FROM DELIVERY D LEFT OUTER JOIN G_CLIENT DS ON D.' +
        'DOSTAVSHIK = DS.G_CLIENT, G_CLIENT GC'
      
        '11040998=                      LEFT OUTER JOIN ZAKAZ Z ON D.ZAKA' +
        'Z = Z.ZAKAZ'
      '11040999=      WHERE D.G_CLIENT = GC.G_CLIENT'
      '110401000=        AND (D.DELIVERY_DATE IS NULL'
      '110401001=             OR'
      '110401002=             D.DELIVERY_DATE >= :DATE_'
      '110401003=             )'
      '110401004=      INTO :DELIVERY,'
      '110401005=           :G_CLIENT,'
      '110401006=           :DOSTAVSHIK,'
      '110401007=           :TOVAR_DELIVERY_DATE,'
      '110401008=           :DELIVERY_DATE,'
      '110401009=           :ADDRESS,'
      '110401010=           :PRICE,'
      '110401011=           :NOTE'
      '110401012=           ,:CLIENT_NAME'
      '110401013=           ,:PHONE'
      '110401014=           ,:DOST_NAME'
      '110401015=           ,:STATUS'
      '110401016=           ,:ZAKAZ'
      '110401017=  DO'
      '110401018=  BEGIN'
      '110401019=    SUSPEND;'
      '110401020=  END'
      '110401021=END'
      '110401022='#39';'
      '110401023='
      '110401024=EXECUTE STATEMENT '#39'ALTER PROCEDURE DELIVERY_UPD('
      '110401025=  DELIVERY_ TYPE OF COLUMN DELIVERY.DELIVERY,'
      '110401026=  G_CLIENT_ TYPE OF COLUMN DELIVERY.G_CLIENT,'
      '110401027=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK,'
      
        '110401028=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ','
      '110401029=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS,'
      '110401030=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE,'
      '110401031=  NOTE_ TYPE OF COLUMN DELIVERY.NOTE,'
      '110401032=  STATUS_ TYPE OF COLUMN DELIVERY.STATUS,'
      '110401033=  ZAKAZ_ TYPE OF COLUMN DELIVERY.ZAKAZ,'
      '110401034=  SKLAD_ TYPE OF COLUMN DELIVERY.SKLAD,'
      
        '110401035=  TOVAR_DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.TOVAR_D' +
        'ELIVERY_DATE)'
      '110401036=AS'
      '110401037=BEGIN'
      '110401038=  UPDATE DELIVERY'
      '110401039=  SET G_CLIENT = :G_CLIENT_,'
      '110401040=      DOSTAVSHIK = :DOSTAVSHIK_,'
      '110401041=      DELIVERY_DATE = :DELIVERY_DATE_,'
      '110401042=      ADDRESS = :ADDRESS_,'
      '110401043=      PRICE = :PRICE_,'
      '110401044=      NOTE = :NOTE_,'
      '110401045=      STATUS = :STATUS_,'
      '110401046=      ZAKAZ = :ZAKAZ_,'
      '110401047=      SKLAD = :SKLAD_,'
      '110401048=      TOVAR_DELIVERY_DATE = :TOVAR_DELIVERY_DATE_'
      '110401049=  WHERE (DELIVERY = :DELIVERY_);'
      '110401050=END'
      '110401051='#39';'
      '110401052='
      '110401053=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SKLAD('
      '110401054=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110401055=  MODE_ INTEGER)'
      '110401056=RETURNS ('
      '110401057=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '110401058=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110401059=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110401060=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '110401061=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '110401062=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110401063=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110401064=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110401065=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110401066=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY,'
      
        '110401067=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '110401068=  CNT_T_ INTEGER,'
      
        '110401069=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110401070=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110401071=  HAVERIGHT_ INTEGER,'
      '110401072=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110401073=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ','
      '110401074=  ERR_CODE INTEGER,'
      '110401075=  ERR_MSG VARCHAR(1024))'
      '110401076=AS'
      '110401077=/*'
      
        '110401078=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083 +
        #1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '110401079=*/'
      
        '110401080=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110401081=begin'
      
        '110401082=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080 +
        ' INS '#1080' '#1087#1088#1080' UPD'
      '110401083=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110401084=  CNT_T_ = 0;'
      '110401085=  SELECT COUNT(*)'
      '110401086=    FROM (SELECT S.SKLAD'
      '110401087=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '110401088=    INTO :CNT_T_;'
      '110401089='
      '110401090=  SELECT'
      '110401091=    T.DATE_RECEIPT,'
      '110401092=    T.TIME_RECEIPT,'
      '110401093=    T.G_CLIENT,'
      '110401094=    T.G_PAYMENT_TYPE,'
      '110401095=    T.OSNOVANIE,'
      '110401096=    T.NOTE,'
      '110401097=    T.SUMM,'
      '110401098=    T.SUMM_FACT,'
      '110401099=    T.IS_PAYED_ALL'
      '110401100=    ,T.SUMM_CURRENCY'
      '110401101=    ,T.is_expected'
      '110401102=  FROM SKLAD_PARENT T'
      '110401103=  WHERE T.SKLAD = :SKLAD_'
      '110401104=  INTO'
      '110401105=    :DATE_RECEIPT_,'
      '110401106=    :TIME_RECEIPT_,'
      '110401107=    :G_CLIENT_,'
      '110401108=    :G_PAYMENT_TYPE_,'
      '110401109=    :OSNOVANIE_,'
      '110401110=    :NOTE_,'
      '110401111=    :SUMM_,'
      '110401112=    :SUMM_FACT_,'
      '110401113=    :IS_PAYED_ALL_'
      '110401114=    ,:SUMM_CURRENCY_'
      '110401115=    ,:IS_EXPECTED_;'
      '110401116='
      '110401117=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110401118=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY)'
      
        '110401119=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), G_PRODUCT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, :SKLAD_,' +
        ' PRICE_CURRENCY, SUMM_CURRENCY'
      '110401120=    FROM SKLAD'
      '110401121=   WHERE SKLAD_PARENT = :SKLAD_'
      '110401122=   ORDER BY SKLAD;'
      '110401123='
      '110401124=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110401125=  SELECT K.G_PRIHOD_RASHOD,'
      '110401126=         K.SUMM'
      
        '110401127=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110401128=   WHERE K.SKLAD = :SKLAD_'
      '110401129=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110401130=    INTO :G_PRIHOD_,'
      '110401131=         :SUMM_PRIHOD_;'
      '110401132='
      
        '110401133=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110401134='
      
        '110401135=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110401136=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110401137=  HaveRight_ = 1;'
      '110401138=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110401139=    SELECT ID'
      '110401140=      FROM CUR_PARAMS'
      '110401141=     WHERE CUR_PARAMS = 1'
      '110401142=      INTO :G_OFFICIAL_CUR_;'
      '110401143='
      
        '110401144=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110401145=      HaveRight_ = 1;'
      '110401146=    else'
      
        '110401147=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110401148=  END'
      '110401149=end'
      '110401150='#39';'
      '110401151='
      '110401152=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD('
      '110401153=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110401154=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110401155=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110401156=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110401157=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110401158=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110401159=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110401160=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110401161=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110401162=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110401163=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110401164=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110401165=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110401166=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110401167=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110401168=RETURNS ('
      '110401169=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110401170=  ERR_CODE INTEGER,'
      '110401171=  ERR_MSG VARCHAR(1024))'
      '110401172=AS'
      '110401173=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110401174=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110401175=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110401176=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110401177=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110401178=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110401179=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110401180=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110401181=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110401182=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110401183=--'
      
        '110401184=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110401185=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      
        '110401186=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD'#39#39 +
        ';'
      '110401187=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110401188=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110401189=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110401190=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110401191=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110401192=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110401193=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110401194=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110401195=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110401196=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110401197=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110401198=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110401199=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110401200=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110401201=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110401202=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110401203=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110401204=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110401205=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110401206=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110401207=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110401208=BEGIN'
      '110401209='
      '110401210=  PNT_ = '#39#39'00'#39#39';'
      '110401211=  IS_THIS_LAST_ = 0;'
      '110401212='
      '110401213=  IF (G_TOCHKA_ IS NULL) THEN'
      '110401214=    SELECT ID'
      '110401215=      FROM CUR_PARAMS'
      '110401216=     WHERE CUR_PARAMS = 2'
      '110401217=      INTO :G_TOCHKA_;'
      '110401218='
      '110401219=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110401220=  SELECT ID'
      '110401221=    FROM CUR_PARAMS'
      '110401222=   WHERE CUR_PARAMS = 1'
      '110401223=    INTO :G_OFFICIAL_;'
      '110401224='
      '110401225=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110401226=                            DATE_RECEIPT,'
      '110401227=                            TIME_RECEIPT,'
      '110401228=                            G_CLIENT,'
      '110401229=                            G_PAYMENT_TYPE,'
      '110401230=                            OSNOVANIE,'
      '110401231=                            NOTE,'
      '110401232=                            SUMM,'
      '110401233=                            SUMM_FACT,'
      '110401234=                            SUMM_CURRENCY,'
      '110401235=                            IS_PAYED_ALL,'
      '110401236=                            IS_VOZVRAT,'
      '110401237=                            G_TOCHKA'
      '110401238=                            ,G_OFFICIAL'
      '110401239=                            ,IS_EXPECTED)'
      '110401240=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110401241=          :DATE_RECEIPT_,'
      '110401242=          :TIME_RECEIPT_,'
      '110401243=          :G_CLIENT_,'
      '110401244=          :G_PAYMENT_TYPE_,'
      '110401245=          :OSNOVANIE_,'
      '110401246=          :NOTE_,'
      '110401247=          :SUMM_,'
      '110401248=          :SUMM_FACT_,'
      '110401249=          :SUMM_CURRENCY_,'
      
        '110401250=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PA' +
        'YED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "' +
        #1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110401251=          :IS_VOZVRAT_,'
      '110401252=          :G_TOCHKA_'
      '110401253=          ,:G_OFFICIAL_'
      '110401254=          ,:IS_EXPECTED_)'
      '110401255=  RETURNING'
      '110401256=    SKLAD'
      '110401257=  INTO'
      '110401258=    :SKLAD_;'
      '110401259='
      '110401260=  PNT_ = '#39#39'01'#39#39';'
      '110401261=  FOR SELECT SKLAD,'
      '110401262=             G_PRODUCT,'
      '110401263=             AMOUNT,'
      '110401264=             PRICE,'
      '110401265=             SUMM,'
      '110401266=             NDS,'
      '110401267=             NDS_SUMM'
      '110401268=             ,PRICE_CURRENCY'
      '110401269=             ,SUMM_CURRENCY'
      '110401270=        FROM SKLAD_TMP'
      '110401271=      ORDER BY 1'
      '110401272=      INTO :SKLAD_TMP_,'
      '110401273=           :RG_PRODUCT_,'
      '110401274=           :RAMOUNT_,'
      '110401275=           :RPRICE_,'
      '110401276=           :RSUMM_,'
      '110401277=           :RNDS_,'
      '110401278=           :RNDS_SUMM_'
      '110401279=           ,:PRICE_CURRENCY_'
      '110401280=           ,:SUMM_CURRENCY_TMP_'
      '110401281=  DO BEGIN'
      '110401282=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110401283=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110401284=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110401285=      IS_THIS_LAST_ = 0;'
      '110401286=      SELECT MAX(SK.DATE_RECEIPT)'
      '110401287=        FROM SKLAD SK'
      '110401288=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110401289=         AND SK.IS_LAST = 1'
      '110401290=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110401291=        INTO :DATE_LAST_;'
      '110401292='
      
        '110401293=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110401294=        UPDATE SKLAD SK'
      '110401295=           SET SK.IS_LAST = 0'
      '110401296=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110401297=           AND SK.IS_LAST = 1'
      '110401298=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110401299='
      '110401300=        IS_THIS_LAST_ = 1;'
      '110401301=      END'
      '110401302=    END'
      '110401303='
      '110401304=    INSERT INTO SKLAD'
      '110401305=    ('
      '110401306=     SKLAD,'
      '110401307=     SKLAD_PARENT,'
      '110401308=     DATE_RECEIPT,'
      '110401309=     G_CLIENT,'
      '110401310=     G_PRODUCT,'
      '110401311=     AMOUNT,'
      '110401312=     PRICE,'
      '110401313=     SUMM,'
      '110401314=     G_PAYMENT_TYPE,'
      '110401315=     OSNOVANIE,'
      '110401316=     NOTE,'
      '110401317=     NDS,'
      '110401318=     NDS_SUMM,'
      '110401319=     IS_LAST,'
      '110401320=     IS_VOZVRAT,'
      '110401321=     G_TOCHKA'
      '110401322=     ,PRICE_CURRENCY'
      '110401323=     ,SUMM_CURRENCY'
      '110401324=    ) VALUES ('
      '110401325=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110401326=     :SKLAD_,'
      '110401327=     :DATE_RECEIPT_,'
      '110401328=     :G_CLIENT_,'
      '110401329=     :RG_PRODUCT_,'
      '110401330=     :RAMOUNT_,'
      '110401331=     :RPRICE_,'
      '110401332=     :RSUMM_,'
      '110401333=     :G_PAYMENT_TYPE_,'
      '110401334=     :OSNOVANIE_,'
      '110401335=     :NOTE_,'
      '110401336=     :RNDS_,'
      '110401337=     :RNDS_SUMM_,'
      
        '110401338=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110401339=     :IS_VOZVRAT_,'
      '110401340=     :G_TOCHKA_'
      '110401341=     ,:PRICE_CURRENCY_'
      '110401342=     ,:SUMM_CURRENCY_TMP_'
      '110401343=    );'
      '110401344='
      
        '110401345=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110401346=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110401347=        PNT_ = '#39#39'02'#39#39';'
      '110401348=        UPDATE LT_SKLAD_PRODUCT L'
      '110401349=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110401350=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110401351=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110401352='
      '110401353=        IF (ROW_COUNT = 0) THEN'
      
        '110401354=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110401355=    END'
      '110401356=  END'
      '110401357=  ----------------------------------------'
      '110401358='
      
        '110401359=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110401360=  PNT_ = '#39#39'05'#39#39';'
      
        '110401361=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110401362=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110401363=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110401364=      ELSE'
      '110401365=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110401366='
      
        '110401367=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110401368=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110401369=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110401370=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110401371=                                        :SUMM_FACT_,'
      
        '110401372=                                        :DATE_RECEIPT_' +
        ','
      
        '110401373=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110401374=                                        NULL,   --ZAKA' +
        'Z_'
      '110401375=                                        :SKLAD_,'
      
        '110401376=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110401377=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110401378=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110401379=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110401380=            EXIT;'
      '110401381=          END'
      '110401382=      END ELSE BEGIN'
      '110401383=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110401384=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110401385=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110401386=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110401387=            ELSE'
      
        '110401388=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110401389='
      '110401390=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110401391=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110401392='
      
        '110401393=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110401394='
      '110401395=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110401396=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110401397=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110401398=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110401399=                                              :PAYMENT' +
        '_DATE_,'
      
        '110401400=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110401401=                                              NULL,   ' +
        '--ZAKAZ_'
      '110401402=                                              :SKLAD_,'
      
        '110401403=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110401404=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110401405=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110401406=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110401407=                  EXIT;'
      '110401408=                END'
      '110401409=            END'
      '110401410=          END'
      '110401411=      END'
      '110401412=  END'
      '110401413='
      '110401414=  DELETE FROM SKLAD_TMP;'
      '110401415='
      
        '110401416=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110401417=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110401418=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110401419=                                  G_PRIHOD_,'
      '110401420=                                  :SUMM_PRIHOD_,'
      '110401421=                                  :DATE_RECEIPT_,'
      
        '110401422=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110401423=                                  NULL,   --:ZAKAZ_,'
      '110401424=                                  :SKLAD_,'
      '110401425=                                  :G_PAYMENT_TYPE_,'
      
        '110401426=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110401427=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110401428=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110401429=      EXIT;'
      '110401430=    END'
      '110401431=  END'
      '110401432=end'
      '110401433='#39';'
      '110401434='
      '110401435=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ('
      '110401436=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110401437=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110401438=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110401439=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110401440=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110401441=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110401442=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110401443=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110401444=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110401445=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110401446=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110401447=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110401448=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110401449=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110401450=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110401451=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110401452=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110401453=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110401454=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110401455=  IS_MEBEL_ INTEGER = 0)'
      '110401456=RETURNS ('
      '110401457=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110401458=  ERR_CODE INTEGER,'
      '110401459=  ERR_MSG VARCHAR(1024))'
      '110401460=AS'
      '110401461=/*'
      '110401462=IS_SPISANIE_'
      '110401463=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110401464=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110401465=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110401466=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110401467=*/'
      '110401468=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'INS_ZAKAZ'#39#39';'
      '110401469=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110401470=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110401471=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110401472=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110401473=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110401474=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110401475=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110401476=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110401477=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110401478=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110401479=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110401480=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110401481=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110401482=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '110401483=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      
        '110401484=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110401485=DECLARE VARIABLE CNT_ INTEGER;'
      '110401486=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110401487=DECLARE VARIABLE DATE_LAST_ DATE;'
      '110401488=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110401489=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110401490=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110401491=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110401492=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110401493=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110401494=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110401495=BEGIN'
      '110401496='
      
        '110401497=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110401498=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110401499=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110401500=  IF (CNT_ = 0) THEN BEGIN'
      '110401501=    ERR_CODE = -20500;'
      
        '110401502=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '110401503=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ 00 '#39#39'||ERR_MSG;'
      '110401504=    EXIT;'
      '110401505=  END'
      '110401506='
      '110401507=  IF (G_TOCHKA_ IS NULL) THEN'
      '110401508=    SELECT ID'
      '110401509=      FROM CUR_PARAMS'
      '110401510=     WHERE CUR_PARAMS = 2'
      '110401511=      INTO :G_TOCHKA_;'
      '110401512='
      '110401513=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110401514=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110401515=      PNT_ = '#39#39'01'#39#39';'
      
        '110401516=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110401517=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110401518=      ELSE'
      '110401519=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110401520='
      '110401521=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110401522=      SELECT ID'
      '110401523=        FROM CUR_PARAMS'
      '110401524=       WHERE CUR_PARAMS = 1'
      '110401525=        INTO :G_OFFICIAL_;'
      '110401526='
      '110401527=      INSERT INTO ZAKAZ'
      '110401528=      ('
      '110401529=       ZAKAZ,'
      '110401530=       G_TOCHKA,'
      '110401531=       Z_DATE,'
      '110401532=       Z_TIME,'
      '110401533=       G_CLIENT,'
      '110401534=       G_PAYMENT_TYPE,'
      '110401535=       OSNOVANIE,'
      '110401536=       IS_SPISANIE,'
      '110401537=       NOTE,'
      '110401538=       SUMM,'
      '110401539=       SUMM_FACT,'
      '110401540=       SUMM_BONUS,'
      '110401541=       IS_PAYED_ALL'
      '110401542=       ,G_OFFICIAL'
      '110401543=       ,BY_RECIPE'
      '110401544=       ,SUMM_BONUS_GOT'
      '110401545=       ,IS_RESERVE'
      '110401546=       ,SUMM_CASH'
      '110401547=       ,SUMM_NONCASH'
      '110401548=      ) VALUES ('
      '110401549=       GEN_ID(GEN_ZAKAZ, 1),'
      '110401550=       :G_TOCHKA_,'
      '110401551=       :Z_DATE_,'
      '110401552=       :Z_TIME_,'
      '110401553=       :G_CLIENT_,'
      '110401554=       :G_PAYMENT_TYPE_,'
      '110401555=       :OSNOVANIE_,'
      '110401556=       :IS_SPISANIE_,'
      '110401557=       :NOTE_,'
      '110401558=       :SUMM_,'
      '110401559=       :SUMM_FACT_1_,'
      '110401560=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110401561=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110401562=       ,:G_OFFICIAL_'
      '110401563=       ,:BY_RECIPE_'
      '110401564=       ,:SUMM_BONUS_GOT_'
      '110401565=       ,:IS_RESERVE_'
      '110401566=       ,COALESCE(:SUMM_CASH_, 0)'
      '110401567=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110401568=      )'
      '110401569=      RETURNING'
      '110401570=        ZAKAZ'
      '110401571=      INTO'
      '110401572=        :ZAKAZ_;'
      '110401573='
      '110401574=      PNT_ = '#39#39'02'#39#39';'
      
        '110401575=      FOR SELECT ZAKAZ_DETAILS, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS' +
        '_SUMM, COST_PRICE'
      '110401576=            FROM ZAKAZ_DETAILS_TMP Z'
      '110401577=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110401578=              :G_PRODUCT,'
      '110401579=              :AMOUNT,'
      '110401580=              :PRICE,'
      '110401581=              :SUMM,'
      '110401582=              :DISCOUNT_PERC,'
      '110401583=              :DISCOUNT_TENGE,'
      '110401584=              :DISCOUNT_SUMM,'
      '110401585=              :NDS,'
      '110401586=              :NDS_SUMM,'
      '110401587=              :COST_PRICE'
      '110401588=      DO BEGIN'
      '110401589=        INSERT INTO ZAKAZ_DETAILS'
      '110401590=        VALUES('
      '110401591=          :ZAKAZ_DETAILS_TMP_,'
      '110401592=          :ZAKAZ_,'
      '110401593=          :G_PRODUCT,'
      '110401594=          :AMOUNT,'
      '110401595=          :PRICE,'
      '110401596=          :SUMM,'
      '110401597=          :DISCOUNT_PERC,'
      '110401598=          :DISCOUNT_TENGE,'
      '110401599=          :DISCOUNT_SUMM,'
      '110401600=          :NDS,'
      '110401601=          :NDS_SUMM,'
      '110401602=          :COST_PRICE'
      '110401603=        );'
      '110401604='
      '110401605=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '110401606=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '110401607=            UPDATE LT_SKLAD_PRODUCT L'
      '110401608=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110401609=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110401610=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110401611='
      '110401612=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110401613=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', ' +
        #1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053 +
        #1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110401614=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040 +
        #1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '110401615=            PNT_ = '#39#39'04'#39#39';'
      
        '110401616=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE F' +
        'ROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110401617=              Err_Code = -20500;'
      
        '110401618=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRO' +
        'DUCT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080 +
        ' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110401619=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110401620=              EXIT;'
      '110401621=            END ELSE if (ROW_COUNT = 0) then'
      
        '110401622=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110401623=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110401624=        END'
      '110401625='
      '110401626=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110401627=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110401628=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110401629=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :AMOUNT'
      '110401630=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110401631=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110401632=      END'
      '110401633='
      '110401634=      ----------------------------------------'
      
        '110401635=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063 +
