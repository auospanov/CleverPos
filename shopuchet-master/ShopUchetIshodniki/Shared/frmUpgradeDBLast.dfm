      '1102011986='
      '1102011987='#1045#1057#1051#1048' MODE_ = 1'
      
        '1102011988='#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1050#1051#1040#1044#1054#1042' '#1048' '#1042#1067#1044#1040#1045#1058#1057#1071' '#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052 +
