        '11041108=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NUM' +
        'ERIC(15,2),'
      
        '11041109=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GO' +
        'T */ NUMERIC(15,2),'
      
        '11041110=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ INTEGER,'
      
        '11041111=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11041112=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTEG' +
        'ER,'
      
        '11041113=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ INT' +
        'EGER,'
      '11041114=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11041115=  IS_MEBEL_ INTEGER = 0,'
      
        '11041116=  DOSTAVSHIK_ /* TYPE OF COLUMN DELIVERY.DOSTAVSHIK */ ' +
        'INTEGER = NULL,'
      
        '11041117=  DELIVERY_DATE_ /* TYPE OF COLUMN DELIVERY.DELIVERY_DA' +
        'TE */ DATE = NULL,'
      
        '11041118=  ADDRESS_ /* TYPE OF COLUMN DELIVERY.ADDRESS */ VARCHA' +
        'R(250) = NULL,'
      
        '11041119=  PRICE_ /* TYPE OF COLUMN DELIVERY.PRICE */ NUMERIC(15' +
        ',2) = NULL)'
      '11041120=RETURNS ('
      '11041121=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ INTEGER,'
      '11041122=  ERR_CODE INTEGER,'
      '11041123=  ERR_MSG VARCHAR(1024))'
      '11041124=AS'
      '11041125=BEGIN'
      '11041126=  SUSPEND;'
      '11041127=END'
      '11041128='#39';'
      '11041129='
      '11041130='
      '11041131=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ('
      '11041132=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11041133=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11041134=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11041135=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11041136=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11041137=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11041138=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11041139=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11041140=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11041141=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11041142=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11041143=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11041144=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11041145=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '11041146=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11041147=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11041148=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11041149=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11041150=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11041151=  IS_MEBEL_ INTEGER = 0,'
      
        '11041152=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NULL' +
        ','
      
        '11041153=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE ' +
        '= NULL,'
      '11041154=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '11041155=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL)'
      '11041156=RETURNS ('
      '11041157=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11041158=  ERR_CODE INTEGER,'
      '11041159=  ERR_MSG VARCHAR(1024))'
      '11041160=AS'
      '11041161=/*'
      '11041162=IS_SPISANIE_'
      '11041163=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11041164=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11041165=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11041166=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11041167=*/'
      '11041168=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'INS_ZAKAZ'#39#39';'
      '11041169=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11041170=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11041171=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '11041172=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '11041173=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '11041174=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ';'
      
        '11041175=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      
        '11041176=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '11041177=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM;'
      '11041178=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11041179=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS_SUMM;'
      
        '11041180=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      
        '11041181=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11041182=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '11041183=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKA' +
        'Z_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      
        '11041184=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.' +
        'G_OFFICIAL;'
      '11041185=DECLARE VARIABLE CNT_ INTEGER;'
      '11041186=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11041187=DECLARE VARIABLE DATE_LAST_ DATE;'
      '11041188=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '11041189=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11041190=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11041191=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11041192=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11041193=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11041194=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11041195=BEGIN'
      '11041196='
      
        '11041197=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057#1048 +
        #1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055#1054 +
        #1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '11041198=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '11041199=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '11041200=  IF (CNT_ = 0) THEN BEGIN'
      '11041201=    ERR_CODE = -20500;'
      
        '11041202=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '11041203=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ 00 '#39#39'||ERR_MSG;'
      '11041204=    EXIT;'
      '11041205=  END'
      '11041206='
      '11041207=  IF (G_TOCHKA_ IS NULL) THEN'
      '11041208=    SELECT ID'
      '11041209=      FROM CUR_PARAMS'
      '11041210=     WHERE CUR_PARAMS = 2'
      '11041211=      INTO :G_TOCHKA_;'
      '11041212='
      '11041213=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11041214=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '11041215=      PNT_ = '#39#39'01'#39#39';'
      
        '11041216=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11041217=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11041218=      ELSE'
      '11041219=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11041220='
      '11041221=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11041222=      SELECT ID'
      '11041223=        FROM CUR_PARAMS'
      '11041224=       WHERE CUR_PARAMS = 1'
      '11041225=        INTO :G_OFFICIAL_;'
      '11041226='
      '11041227=      INSERT INTO ZAKAZ'
      '11041228=      ('
      '11041229=       ZAKAZ,'
      '11041230=       G_TOCHKA,'
      '11041231=       Z_DATE,'
      '11041232=       Z_TIME,'
      '11041233=       G_CLIENT,'
      '11041234=       G_PAYMENT_TYPE,'
      '11041235=       OSNOVANIE,'
      '11041236=       IS_SPISANIE,'
      '11041237=       NOTE,'
      '11041238=       SUMM,'
      '11041239=       SUMM_FACT,'
      '11041240=       SUMM_BONUS,'
      '11041241=       IS_PAYED_ALL'
      '11041242=       ,G_OFFICIAL'
      '11041243=       ,BY_RECIPE'
      '11041244=       ,SUMM_BONUS_GOT'
      '11041245=       ,IS_RESERVE'
      '11041246=       ,SUMM_CASH'
      '11041247=       ,SUMM_NONCASH'
      '11041248=      ) VALUES ('
      '11041249=       GEN_ID(GEN_ZAKAZ, 1),'
      '11041250=       :G_TOCHKA_,'
      '11041251=       :Z_DATE_,'
      '11041252=       :Z_TIME_,'
      '11041253=       :G_CLIENT_,'
      '11041254=       :G_PAYMENT_TYPE_,'
      '11041255=       :OSNOVANIE_,'
      '11041256=       :IS_SPISANIE_,'
      '11041257=       :NOTE_,'
      '11041258=       :SUMM_,'
      '11041259=       :SUMM_FACT_1_,'
      '11041260=       COALESCE(:SUMM_BONUS_, 0),'
      
        '11041261=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_B' +
        'ONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052 +
        #1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11041262=       ,:G_OFFICIAL_'
      '11041263=       ,:BY_RECIPE_'
      '11041264=       ,:SUMM_BONUS_GOT_'
      '11041265=       ,:IS_RESERVE_'
      '11041266=       ,COALESCE(:SUMM_CASH_, 0)'
      '11041267=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '11041268=      )'
      '11041269=      RETURNING'
      '11041270=        ZAKAZ'
      '11041271=      INTO'
      '11041272=        :ZAKAZ_;'
      '11041273='
      '11041274=      PNT_ = '#39#39'02'#39#39';'
      
        '11041275=      FOR SELECT ZAKAZ_DETAILS, G_PRODUCT, AMOUNT, PRIC' +
        'E, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_' +
        'SUMM, COST_PRICE'
      '11041276=            FROM ZAKAZ_DETAILS_TMP Z'
      '11041277=          INTO :ZAKAZ_DETAILS_TMP_,'
      '11041278=              :G_PRODUCT,'
      '11041279=              :AMOUNT,'
      '11041280=              :PRICE,'
      '11041281=              :SUMM,'
      '11041282=              :DISCOUNT_PERC,'
      '11041283=              :DISCOUNT_TENGE,'
      '11041284=              :DISCOUNT_SUMM,'
      '11041285=              :NDS,'
      '11041286=              :NDS_SUMM,'
      '11041287=              :COST_PRICE'
      '11041288=      DO BEGIN'
      '11041289=        INSERT INTO ZAKAZ_DETAILS'
      '11041290=        VALUES('
      '11041291=          :ZAKAZ_DETAILS_TMP_,'
      '11041292=          :ZAKAZ_,'
      '11041293=          :G_PRODUCT,'
      '11041294=          :AMOUNT,'
      '11041295=          :PRICE,'
      '11041296=          :SUMM,'
      '11041297=          :DISCOUNT_PERC,'
      '11041298=          :DISCOUNT_TENGE,'
      '11041299=          :DISCOUNT_SUMM,'
      '11041300=          :NDS,'
      '11041301=          :NDS_SUMM,'
      '11041302=          :COST_PRICE'
      '11041303=        );'
      '11041304='
      '11041305=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11041306=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '11041307=            UPDATE LT_SKLAD_PRODUCT L'
      '11041308=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11041309=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11041310=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11041311='
      '11041312=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '11041313=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11041314=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '11041315=            PNT_ = '#39#39'04'#39#39';'
      
        '11041316=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11041317=              Err_Code = -20500;'
      
        '11041318=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PROD' +
        'UCT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' ' +
        #1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11041319=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||' +
        #39#39' '#39#39'||ERR_MSG;'
      '11041320=              EXIT;'
      '11041321=            END ELSE if (ROW_COUNT = 0) then'
      
        '11041322=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11041323=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11041324=        END'
      '11041325='
      '11041326=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '11041327=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '11041328=            UPDATE LT_SKLAD_PRODUCT L'
      
        '11041329=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE ' +
        '+ :AMOUNT'
      '11041330=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11041331=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11041332=      END'
      '11041333='
      '11041334=      ----------------------------------------'
      
        '11041335=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053 +
        #1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '11041336=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '11041337=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '11041338='
      
        '11041339=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '11041340=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '11041341=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '11041342=                PNT_ = '#39#39'05'#39#39';'
      
        '11041343=                EXECUTE PROCEDURE K_INS_KASSA(0,     --' +
        ' ACTION_ => :ACTION_'
      
        '11041344=                                              1,     --' +
        ' G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '11041345=                                              :SUMM_FAC' +
        'T_1_,'
      '11041346=                                              :Z_DATE_,'
      
        '11041347=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11041348=                                              ZAKAZ_,  ' +
        ' --ZAKAZ_'
      '11041349=                                              NULL,'
      
        '11041350=                                              :G_PAYMEN' +
        'T_TYPE_,'
      
        '11041351=                                              :G_TOCHKA' +
        '_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11041352=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11041353=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PN' +
        'T_||'#39#39' '#39#39'||ERR_MSG;'
      '11041354=                  EXIT;'
      '11041355=                END'
      '11041356=            END'
      '11041357='
      '11041358=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '11041359=        END ELSE BEGIN'
      '11041360=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      
        '11041361=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS' +
        '_);'
      
        '11041362=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA' +
        '_) THEN'
      
        '11041363=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' POS_TILDA_ - 1);'
      '11041364=                ELSE'
      
        '11041365=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' CHAR_LENGTH(PAYMENTS_) - 1);'
      '11041366='
      
        '11041367=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR' +
        '_)'
      
        '11041368=                    RETURNING_VALUES :PAYMENT_ID_, :PAY' +
        'MENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11041369='
      
        '11041370=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM ' +
        '(POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '11041371='
      '11041372=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11041373=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11041374=                                                  1,   ' +
        '  --:G_PRIHOD_RASHOD_,'
      
        '11041375=                                                  :PAYM' +
        'ENT_SUMM_,'
      
        '11041376=                                                  :PAYM' +
        'ENT_DATE_,'
      
        '11041377=                                                  NULL,' +
        '   --NOTE_ => :NOTE_,'
      
        '11041378=                                                  :ZAKA' +
        'Z_,'
      
        '11041379=                                                  NULL,' +
        '     --:SKLAD_,'
      
        '11041380=                                                  :PAYM' +
        'ENT_TYPE_,'
      
        '11041381=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11041382=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11041383=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39 +
        '||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '11041384=                      EXIT;'
      '11041385=                    END'
      '11041386=                END'
      '11041387=            END'
      '11041388=        END'
      '11041389=      END'
      '11041390='
      
        '11041391=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '11041392=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041#1054 +
        #1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '11041393=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052' ' +
        #1057#1051#1059#1063#1040#1045
      '11041394=      UPDATE G_DISCONT_CARD D'
      
        '11041395=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0) +' +
        ' :SUMM_BONUS_GOT_,'
      '11041396=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '11041397=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '11041398=  END'
      '11041399=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11041400=  ----------------------------------------'
      '11041401=  ----------------------------------------'
      '11041402=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11041403=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '11041404=      PNT_ = '#39#39'25'#39#39';'
      
        '11041405=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT,' +
        ' G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHKA' +
        ')'
      
        '11041406=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLIE' +
        'NT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA_' +
        ')'
      '11041407=      RETURNING ZAKAZ_REAL_PARENT'
      '11041408=      INTO :ZAKAZ_REAL_PARENT_;'
      '11041409='
      
        '11041410=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOU' +
        'NT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '11041411=            FROM ZAKAZ_DETAILS_TMP Z'
      '11041412=          INTO :G_PRODUCT,'
      '11041413=              :AMOUNT,'
      '11041414=              :PRICE,'
      '11041415=              :SUMM,'
      '11041416=              :DISCOUNT_PERC,'
      '11041417=              :DISCOUNT_TENGE,'
      '11041418=              :DISCOUNT_SUMM,'
      '11041419=              :NDS,'
      '11041420=              :NDS_SUMM'
      '11041421=      DO BEGIN'
      '11041422=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11041423=          UPDATE LT_SKLAD_PRODUCT L'
      '11041424=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11041425=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '11041426=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '11041427='
      
        '11041428=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053#1054' ' +
        #1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045' '#1047 +
        #1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11041429=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048#1057 +
        #1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '11041430=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FROM' +
        ' SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11041431=            Err_Code = -20500;'
      
        '11041432=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1055 +
        #1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088 +
        #1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11041433=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11041434=            EXIT;'
      '11041435=          END ELSE if (ROW_COUNT = 0) then'
      
        '11041436=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11041437=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11041438='
      
        '11041439=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZAK' +
        'AZ_REAL_PARENT,'
      '11041440=                                     G_PRODUCT,'
      '11041441=                                     PRICE,'
      
        '11041442=                                     AMOUNT_ALL, SUMM_A' +
        'LL,'
      
        '11041443=                                     AMOUNT_PAYED, SUMM' +
        '_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SU' +
        'MM, NDS,'
      '11041444=                                     NDS_SUMM)'
      
        '11041445=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ_' +
        'REAL_PARENT_,'
      '11041446=                  :G_PRODUCT,'
      
        '11041447=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040#1070 +
        ' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '11041448=                  :AMOUNT, :SUMM,'
      '11041449=                  0, --AMOUNT_PAYED,'
      '11041450=                  0, --SUMM_PAYED,'
      '11041451=                  0, --IS_PAYED_ALL,'
      '11041452=                  :DISCOUNT_PERC,'
      '11041453=                  :DISCOUNT_TENGE,'
      '11041454=                  :DISCOUNT_SUMM,'
      '11041455=                  :NDS,'
      '11041456=                  :NDS_SUMM)'
      '11041457=          RETURNING ZAKAZ_NA_REAL'
      '11041458=          INTO :ZAKAZ_;'
      '11041459=      END'
      '11041460=  END'
      '11041461=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '11041462=  ----------------------------------------'
      '11041463=  ----------------------------------------'
      '11041464=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '11041465=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046#1040 +
        #1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '11041466=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', '#1040 +
        ' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11041467=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '11041468=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, TI' +
        'ME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SUM' +
        'M_FACT,'
      
        '11041469=                                IS_PAYED_ALL, IS_VOZVRA' +
        'T, G_TOCHKA)'
      
        '11041470=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_,' +
        ' :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SUM' +
        'M_FACT_,'
      '11041471=              1, 3, :G_CLIENT_)'
      '11041472=      RETURNING SKLAD'
      '11041473=      INTO :SKLAD_;'
      '11041474='
      '11041475=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '11041476=            FROM ZAKAZ_DETAILS_TMP Z'
      '11041477=          INTO :G_PRODUCT,'
      '11041478=              :AMOUNT,'
      '11041479=              :PRICE,'
      '11041480=              :SUMM'
      '11041481=      DO BEGIN'
      '11041482=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11041483=        UPDATE LT_SKLAD_PRODUCT L'
      '11041484=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11041485=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11041486=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '11041487='
      '11041488=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '11041489=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1053#1045#1058
      '11041490=        IS_THIS_LAST_ = 0;'
      '11041491=        SELECT MAX(SK.DATE_RECEIPT)'
      '11041492=            FROM SKLAD SK'
      '11041493=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11041494=             AND SK.IS_LAST = 1'
      '11041495=             AND SK.G_TOCHKA = :G_CLIENT_'
      '11041496=            INTO :DATE_LAST_;'
      '11041497='
      
        '11041498=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048 +
        ' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11041499=            UPDATE SKLAD SK'
      '11041500=               SET SK.IS_LAST = 0'
      '11041501=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11041502=               AND SK.IS_LAST = 1'
      '11041503=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '11041504='
      '11041505=            IS_THIS_LAST_ = 1;'
      '11041506=        END'
      '11041507='
      '11041508='
      '11041509=        INSERT INTO SKLAD'
      '11041510=        ('
      '11041511=         SKLAD,'
      '11041512=         SKLAD_PARENT,'
      '11041513=         DATE_RECEIPT,'
      '11041514=         G_CLIENT,'
      '11041515=         G_PRODUCT,'
      '11041516=         AMOUNT,'
      '11041517=         PRICE,'
      '11041518=         SUMM,'
      '11041519=         G_PAYMENT_TYPE,'
      '11041520=         OSNOVANIE,'
      '11041521=         NOTE,'
      '11041522=         NDS,'
      '11041523=         NDS_SUMM,'
      '11041524=         IS_LAST,'
      '11041525=         IS_VOZVRAT,'
      '11041526=         G_TOCHKA'
      '11041527=        ) VALUES ('
      '11041528=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '11041529=         :SKLAD_,'
      '11041530=         :Z_DATE_,'
      '11041531=         :G_TOCHKA_,'
      '11041532=         :G_PRODUCT,'
      '11041533=         :AMOUNT,'
      '11041534=         :PRICE,'
      '11041535=         :SUMM,'
      '11041536=         :G_PAYMENT_TYPE_,'
      '11041537=         :OSNOVANIE_,'
      '11041538=         :NOTE_,'
      '11041539=         0,  --:RNDS_,'
      '11041540=         0,  --:RNDS_SUMM_,'
      
        '11041541=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' ' +
        #1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' ' +
        #1041#1059#1044#1045#1058' 0'
      '11041542=         3,  --:IS_VOZVRAT_,'
      '11041543=         :G_CLIENT_'
      '11041544=        );'
      '11041545='
      
        '11041546=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' '#1045 +
        #1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '11041547=        PNT_ = '#39#39'02'#39#39';'
      '11041548=        UPDATE LT_SKLAD_PRODUCT L'
      '11041549=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '11041550=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11041551=           AND L.G_TOCHKA = :G_CLIENT_;'
      '11041552='
      '11041553=        IF (ROW_COUNT = 0) THEN'
      
        '11041554=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PROD' +
        'UCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '11041555=      END'
      '11041556=  END'
      '11041557='
      '11041558=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '11041559='
      
        '11041560=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054 +
        #1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '11041561=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11041562=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ => ' +
        ':ACTION_'
      '11041563=                                  G_PRIHOD_,'
      '11041564=                                  :SUMM_PRIHOD_,'
      '11041565=                                  :Z_DATE_,'
      
        '11041566=                                  NULL,   --NOTE_ => :N' +
        'OTE_,'
      '11041567=                                  :ZAKAZ_,'
      '11041568=                                  NULL,'
      '11041569=                                  :G_PAYMENT_TYPE_,'
      
        '11041570=                                  :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11041571=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11041572=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||E' +
        'RR_MSG;'
      '11041573=      EXIT;'
      '11041574=    END'
      '11041575=  END'
      '11041576='
      
        '11041577=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057#1058 +
        #1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '11041578=  IF (IS_MEBEL_ = 1) THEN'
      
        '11041579=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS,' +
        ' ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '11041580=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, :' +
        'ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '11041581=end'
      '11041582='#39';'
      '11041583='
      '11041584='
      '11041585=EXECUTE STATEMENT '#39'ALTER PROCEDURE IMPORT_DOWNLOAD('
      '11041586=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11041587=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11041588=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11041589=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11041590=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11041591=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11041592=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11041593=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11041594=RETURNS ('
      '11041595=  ERR_CODE INTEGER,'
      '11041596=  ERR_MSG VARCHAR(1024))'
      '11041597=AS'
      '11041598=/*'
      
        '11041599='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059' '#1044 +
        #1040#1053#1053#1067#1061
      
        '11041600='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054' '#1055 +
        #1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '11041601='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '11041602=*/'
      
        '11041603=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'IMPORT_DOWNLO' +
        'AD'#39#39';'
      '11041604=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11041605=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.BARCODE;'
      
        '11041606=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.ARTICUL;'
      
        '11041607=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TMP.' +
        'AMOUNT;'
      
        '11041608=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP.P' +
        'RICE;'
      
        '11041609=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.PRICE;'
      
        '11041610=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.DISCOUNT;'
      '11041611=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '11041612=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11041613=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2)' +
        ';'
      
        '11041614=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      '11041615=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11041616=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.ZAKAZ_DETAILS;'
      
        '11041617=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      '11041618=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11041619=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      
        '11041620=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11041621=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NONCA' +
        'SH;'
      '11041622=BEGIN'
      '11041623='
      '11041624=  PNT_ = '#39#39'00'#39#39';'
      '11041625=  CLRF = ascii_char( 10 );'
      '11041626='
      '11041627=  SELECT S.S_VALUE'
      '11041628=    FROM SYSTEM_SETUP S'
      '11041629=   WHERE S.SYSTEM_SETUP = 2'
      '11041630=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11041631='
      '11041632=  PNT_ = '#39#39'01'#39#39';'
      '11041633=  SELECT G.nds_value'
      '11041634=    FROM G_FIRM_REKVIZIT G'
      '11041635=   WHERE G.is_default = 1'
      '11041636=    INTO :NDS_;'
      '11041637='
      '11041638=  PNT_ = '#39#39'02'#39#39';'
      
        '11041639=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '11041640=        FROM IMPORT_TBL_TMP'
      
        '11041641=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_, :' +
        'DISCOUNT_'
      '11041642=  DO BEGIN'
      '11041643=    SELECT G_PRODUCT,'
      '11041644=           PRICE'
      '11041645=      FROM ('
      '11041646=            SELECT P.G_PRODUCT, P.price'
      '11041647=              FROM G_PRODUCT P'
      
        '11041648=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(COAL' +
        'ESCE(P.BARCODE, '#39#39#39#39')) <> '#39#39#39#39')'
      
        '11041649=                OR (P.ARTICUL = :ARTICUL_ and TRIM(COAL' +
        'ESCE(P.ARTICUL, '#39#39#39#39')) <> '#39#39#39#39')'
      '11041650=            UNION'
      '11041651=            SELECT LT.G_PRODUCT, P.PRICE'
      '11041652=              FROM LT_BARCODE LT, g_product P'
      
        '11041653=             WHERE LT.BARCODE = :BARCODE_ and TRIM(COAL' +
        'ESCE(LT.BARCODE, '#39#39#39#39')) <> '#39#39#39#39
      '11041654=               AND LT.g_product = P.g_product'
      '11041655=           )'
      '11041656=      INTO :G_PRODUCT_,'
      '11041657=           :PRICE_OUR_;'
      '11041658='
      '11041659=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '11041660=      ERR_CODE = -20500;'
      
        '11041661=      ERR_MSG = '#39#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39#39 +
        '||BARCODE_||'#39#39', '#1072#1088#1090#1080#1082#1091#1083' '#39#39'||ARTICUL_;'
      '11041662=      Exit;'
      '11041663=    END'
      '11041664='
      '11041665=    PNT_ = '#39#39'03'#39#39';'
      
        '11041666=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / PR' +
        'ICE_;'
      
        '11041667=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, ' +
        ':G_TOCHKA_, 1)'
      '11041668=      RETURNING_VALUES :COST_PRICE_;'
      '11041669='
      '11041670=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '11041671=    IF (price_ IS NULL) THEN'
      '11041672=      PRICE_ = PRICE_OUR_;'
      '11041673='
      '11041674=    PNT_ = '#39#39'04'#39#39';'
      
        '11041675=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PRODUC' +
        'T_,'
      '11041676=                                              :AMOUNT_,'
      '11041677=                                              :PRICE_,'
      
        '11041678=                                              :AMOUNT_ ' +
        '* (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '11041679=                                              :DISCOUNT' +
        '_PERC_,'
      
        '11041680=                                              :DISCOUNT' +
        '_,'
      
        '11041681=                                              :AMOUNT_ ' +
        '* :DISCOUNT_,'
      '11041682=                                              :NDS_,'
      
        '11041683=                                              SUMM_ * N' +
        'DS_ / (100 + NDS_),'
      
        '11041684=                                              :COST_PRI' +
        'CE_,'
      
        '11041685=                                              :ALLOW_SE' +
        'LL_ABSENT_GOODS_,'
      
        '11041686=                                              0,     --' +
        'IS_SPISANIE_'
      
        '11041687=                                              1,     --' +
        ' NEW_LINE_SALE_'
      
        '11041688=                                              0     --M' +
        'ODE_'
      
        '11041689=                                              ) RETURNI' +
        'NG_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '11041690=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11041691=      ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE ' +
        '= '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39',' +
        ' ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11041692=      EXIT;'
      '11041693=    END'
      '11041694='
      '11041695=    G_PRODUCT_ = NULL;'
      '11041696=  END'
      '11041697='
      '11041698=  PNT_ = '#39#39'05'#39#39';'
      '11041699=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '11041700=    SELECT SUM(T.summ)'
      '11041701=      FROM ZAKAZ_DETAILS_TMP T'
      '11041702=      INTO :SUMM_;'
      '11041703=    SUMM_FACT_ = SUMM_;'
      '11041704=  END'
      '11041705='
      '11041706=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '11041707=  if (G_PAYMENT_TYPE_ = 1) then'
      '11041708=    SUMM_CASH_ = summ_fact_;'
      '11041709=  ELSE'
      '11041710=    SUMM_NONCASH_ = summ_fact_;'
      '11041711='
      '11041712=  PNT_ = '#39#39'06'#39#39';'
      '11041713=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '11041714=    G_CLIENT_ = 10;'
      '11041715='
      '11041716=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '11041717=                              :Z_DATE_,'
      '11041718=                              :Z_TIME_,'
      '11041719=                              :G_CLIENT_,'
      '11041720=                              :G_PAYMENT_TYPE_,'
      '11041721=                              '#39#39#39#39', --:OSNOVANIE_,'
      '11041722=                              0,  -- IS_SPISANIE'
      
        '11041723=                              '#39#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39#39'||:NOT' +
        'E_,'
      '11041724=                              :SUMM_,'
      '11041725=                              :SUMM_FACT_,'
      '11041726=                              :SUMM_CASH_,'
      '11041727=                              :SUMM_NONCASH_,'
      
        '11041728=                              0,    --:SUMM_PAY_BONUS__' +
        ','
      
        '11041729=                              0,    --:SUMM_BONUS_GOT__' +
        ','
      
        '11041730=                              NULL,        --:G_PRIHOD_' +
        ','
      
        '11041731=                              NULL,        --:SUMM_PRIH' +
        'OD_'
      '11041732=                              0,    -- :BY_RECIPE__,'
      '11041733=                              0,    -- IS_RESERVE__'
      '11041734=                              NULL -- :PAYMENTS__'
      '11041735=                              )'
      
        '11041736=                              RETURNING_VALUES :ZAKAZ_,' +
        ' :ERR_CODE, :ERR_MSG;'
      '11041737=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11041738=    ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE =' +
        ' '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ' +
        'ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11041739=    EXIT;'
      '11041740=  END'
      '11041741='
      '11041742=  DELETE FROM import_tbl_tmp;'
      '11041743='
      '11041744=WHEN ANY DO BEGIN'
      '11041745=    ERR_CODE = gdscode;'
      
        '11041746=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||gds' +
        'code;'
      '11041747=  END'
      '11041748=end'
      '11041749='#39';'
      '11041750='
      '11041751=EXECUTE STATEMENT '#39'ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '11041752=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11041753=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11041754=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11041755=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11041756=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11041757=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11041758=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11041759=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11041760=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '11041761=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED)'
      '11041762=RETURNS ('
      '11041763=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11041764=  ERR_CODE INTEGER,'
      '11041765=  ERR_MSG VARCHAR(1024))'
      '11041766=AS'
      
        '11041767=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062#1045#1049 +
        ' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '11041768=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045#1057#1058 +
        #1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '11041769=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040#1042#1051 +
        #1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '11041770=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054 +
        ' '#1057#1055#1048#1064#1045#1058#1057#1071
      '11041771='
      
        '11041772=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067 +
        #1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11041773=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'PAY_ZAKAZ_NA_' +
        'REAL'#39#39';'
      '11041774=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11041775=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKL' +
        'AD;'
      
        '11041776=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11041777=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL.A' +
        'MOUNT_ALL;'
      
